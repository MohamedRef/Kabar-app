      "id": "j2.u06.l02",
      "sha256": "c3c341eb41813e007687cb338ef915a548f9d24318b142d9f021330a5cfe88bc"
    },
    {
      "id": "j2.u06.l03",
      "sha256": "10ec1865eb5b8811f7ecdd56c6ca6e3faed22ed96afd7b8bb694f3afff9e7ab1"
    },
    {
      "id": "j2.u06.l04",
      "sha256": "b7a90b2b657da9768b3e25e1ee1fe77d9c6f3559ccedbd9116b8695c8c50235e"
    }
  ],
  "audio": [
    {
      "key": "002317713667fb56d648fea1558f0e6c475eaaf7fa04db2d27438ec3ab2eee0c",
      "text": "Teh wae. Mau aku wis ngombé kopi.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "00c64791d37d1e4d8e8a774bd7128f86da0eecb717b3f5ed223c1ad7c579260c",
      "text": "Apik tenan! Gedhé banget.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "027d94bd283e197ce1f2c0de000f6fcfac13957780c6ef3ed2bad21de301d6ca",
      "text": "bola-bali",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "070af526dafb5d9f56d22176efa4ff2f79ee10a2a9232e1b8025db2579f6808e",
      "text": "Piyé, Mohamed? Bentengé apik ora?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "077a7f4dcfb9a41d7c24a222ff83f38c858d38b723d02d1898617e2be4dea154",
      "text": "puanas / uenak",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "08f12ba6a60bafcf8e644a5acea35b818300b951a4ce928e582440e676f16518",
      "text": "Aku karo Dimas dolan-dolan neng Ngawi.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca088258b9db6d0701821aff2dd339c87814a2730b9beb9ee95d1ff9c1d4f18",
      "text": "Saiki panas banget, ya.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d059e90305446195ec9955d1211fde7dbe316cd1e89c82d88fbcf486204458b",
      "text": "Bocah-bocah dolanan neng taman.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1389df4223f29344e984d2b96b694cc47a3f76ee59b50a99591cf283efd9f4d6",
      "text": "Sip! Minggu esuk, ya.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1545ce547795a9a9c5d70d81999bb5376bc9f3375fce9632a391b4dcb9b87acd",
      "text": "Bocah telu lagi mangan.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "15d91156a3979d296675ff43bc3d80c2b060def739a5429f77a49448e573cc70",
      "text": "Mohamed, Minggu ayo dolan-dolan neng Ngawi!",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1642d1104cbf9de815d996f8fc361097265c965c6131088acec636a637074596",
      "text": "taman",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1928ee9a9ce8586c0f8f1ec9702913afc8e1fb517233d81480b98312610a99d2",
      "text": "banjur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eef9b75f53141007bb3dc1dce54a1634e0205d3934768350f1494327e9854d4",
      "text": "Mlaku-mlaku neng Benteng Pendem.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d3a99b7bedc4350498cbec789a534be93276e7ae52f1eff1b01fd7c1e9dc36",
      "text": "Regané rada larang.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ce1d34222c50b0e016e331b608134ca15ec82570a2d8247f498bf6afc830c8",
      "text": "sing paling",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dda086bad8f86ab19bf4bdff03520366b859f0fe9592b802755b05f90050f2b",
      "text": "Klambiné apik banget.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "31545fb17379caf7ea47581e95c6e71e2768f5188b07a240c427176fdfe84d22",
      "text": "Aku karo Dimas dolan neng Ngawi.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3608b247510d90171a0c3ad23a7d11f99082371313a12226b712da2c620ee574",
      "text": "Ayo! Neng ngendi?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "36ea168b73b753be2e1085474e869884e336235021bca8bd0e7e4f116ab33111",
      "text": "Benteng Pendem? Apa kuwi?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "375216bcf12f1ac415ae02e7d1a6488f518db59e0eed4bcfc1dd374cea1b71fc",
      "text": "Enak pol!",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3810bc3d17096f262e3eabf0d516a4a77eee1b40eae493f63dfc6fcdff778135",
      "text": "utawa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "45a5ce1494878ba7d9dfb2bd666d116561cd1ad6eefb20a8680b8d0634d43063",
      "text": "Apik ora?",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "46a34dae4c5eb11367045042cc59d06cb2ffa2982bddc683836fe5e0ca8ca34f",
      "text": "nanging / ning",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "4787708437feec50831be4b06740822c860025d96e085a367e7406b51ea4f238",
      "text": "mula",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4933c4adc4e8dccca309032596d408516c603c6a7d8dac24debd3f9100425838",
      "text": "mlaku / mlaku-mlaku",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4982ea9d79bb65a3945bfde09e1731b4bd76eb120dbbc07ae0635cdbfda9fa35",
      "text": "Aku bola-bali neng stasiun.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "51bec640f790da80edb6475b120d6fc0ec3639f1c534ab9b7e930fbea4117167",
      "text": "Aku mangan sik, terus adus.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "58cfce4db32f0b7b62d0e2bc047e47d7341932c1e6c957765a8f117dd0bb1a82",
      "text": "Mohamed, Minggu kowé neng ngendi?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e0b381a36b1bb0ed90ae0b24055d5672d6ef4d90c5e880d287b7f5c1d72eff6",
      "text": "Kopi apa teh?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "602c8331703280592bf349d3691857d7126fb97a10570af7ab7f6e6123883bab",
      "text": "Mohamed, ngombé kopi apa teh?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "653f0cb8756013a7f2bb1a9f6a6d4daece757f896f08d8a36b0a110f887bd7b9",
      "text": "Ayo mlaku-mlaku neng Benteng Pendem.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "65493c6546074536043035c5509ad8321f8cde6a1b07baedd5ab6a238d761031",
      "text": "banget",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "686f66476d0d9b2e9f0e8973c7c03c5b9a062d93e6668aaa98bc07ae8320ce75",
      "text": "dolan / dolan-dolan",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bf82973839ea9c5d6a70df877aad4e814aee7fb64bb71c9fe9da6aad9eb1b76",
      "text": "dolanan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d36e36c555f9b80368bbf8c6cb245341342e0c096bca589b96c3a6d6d45a376",
      "text": "Benteng Landa lawas. Akèh bocah dolanan neng kana.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "8074e3455ec02dd5829f7d1bdd057de58331b24adac2367c32f35bc60f0e319c",
      "text": "merga / amarga",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "811a124a645bb03224a49712e323d2b40c2dcb3e60c6a08611fccdfbdde2c849",
      "text": "Iya. Nek udan, mulih.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8621f5dbf10536f80ddb0184db14fcb58a70d5440d5ec83652d735c14ec32703",
      "text": "Mlaku-mlaku neng Benteng Pendem, terus ngombé es dawet.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "873b158a5ece93f261afe402c7a51f3d13a5f169f65f133e7258bdb7794d5280",
      "text": "Ayo ngombé es dawet. Enak pol!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cd42a5687c5c40bb43f1e1ee0986309e798d893a3a4d0267cc8e462f1818205",
      "text": "bocah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "91eda7da915ed31f5cec78cf0052fb5790e5dffd0bb0302fc23cc76fe3e4edd9",
      "text": "Dolan neng omahku, ya!",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "9650e6d6d437e665f68e58bdee8a995b87aa6d7e8b9b0ab3e2ffcde77c425043",
      "text": "Apik tenan, nanging puanas!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "97dba856d6c5e36c3e7027a6be36d200daee9d6aa2ccd65bb2155fbdceaf8b30",
      "text": "Aku kesel tenan.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2f5a9abbd945c1ffbbe9b3418994571543162d0ed00c80158341e7901fc689",
      "text": "Wingi aku dolan-dolan neng Ngawi karo Dimas.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c7fe17e9d55e2772a9c2a918d92891e9a32ca3307084c952c641e65db2e11ec",
      "text": "dhéwé",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a10105fab9284ebd5c9be0b0bba97c888d1f9cca25de6cd2ddffc5f0c4fe5d15",
      "text": "Wingi aku dolan-dolan neng Ngawi karo Dimas. Seneng banget!",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a49f269d362154c0f8863a6f092c1ebb42c3761379dbf2c945f2851df3f8782c",
      "text": "Panganané enak, nanging rada larang.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a65457d29119e3c9718ef73cbcaea00b468645462e655cb786769932b4085370",
      "text": "Ayo! Aku seneng banget neng Ngawi.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf68b6de9ce9bd4485fc410b1d9d6c20fca36b9d279446dafca171443168da9",
      "text": "Iya. Aku rada kesel.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab8e84950cce6a568e744e4deef5b80d07fef842964a5f6eca8335c8dfed0e68",
      "text": "sedhih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1aa2d052104fb49d584bc3ec2ba5e276039e262665d6cd6dc26c1797262e30a",
      "text": "Wah, kowé wis isa ngomong «puanas»!",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3571e8c5150dedab1a8e4e1670a703eea5d16884ca1b57db85879d1f766c37b",
      "text": "lelungan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf9aa593f7fd6e5466be127116c9508187a3dc69e1e7a64d96e1bea6a2fba8b1",
      "text": "udan",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c813ae38767795bc5f08fb61b65d1d4ddd7a4c2dd4171818af133aa85f83bab9",
      "text": "Oké. Terus ayo mlaku-mlaku neng pinggir kali.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca367f43420328d6cf1198e7936cb680889f6b58ad331f5a2feea3239235d566",
      "text": "wedi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb1b15a102a4e492e0c1f4af683934ef7babd3aae056b3aa4a2312320e10707e",
      "text": "pol",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0db12ac75389c9b502ffc07ccb3f52727da7af571d423f28be6e5f686578104",
      "text": "Aku ora teka merga udan.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d19a426274a2b6e9c201134b7e7af1d3df4b7d5d2aadcc9593f74f99b52309aa",
      "text": "Bentengé apik tenan!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d62bb4cfe89dc38532267e1f0be20471940c8f4b526f6c4ecc864dcddcb3bfcd",
      "text": "Mohamed clingak-clinguk neng stasiun.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a2b1de944691763f8b954cc9ea9b0b4bb77692b09ac6f7ecc7981752bf625b",
      "text": "Es dawet iki enak pol!",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "daa63a4bd8a3ff8b940de3335146154cc52ea7c004064fb35b87615019bd8d6e",
      "text": "Sing iki paling murah.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27f7c0a3ab5cad5725e97a66e48ff849d4f5b1b67942f2b13c69bfae68d8243",
      "text": "Saiki puanas, rek!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5374191d26152071832d12d867236b40ad69c24ae668412b009fd1f600bc7b3",
      "text": "clingak-clinguk",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea5b4e038a0fbab89af02a277a87b3ca99b819898c0843e213ee8eb9a997597b",
      "text": "Ayo! Nanging nek udan, mulih wae, ya.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec302803630301d24d174fee095421611da74daf7a27327a30a87545df045a7f",
      "text": "panganan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "edc99148a499074ea91b8cd82b995f8c2b4bdea56d5307c670288d93eaf5e9fa",
      "text": "Aku kesel, mula aku turu.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef71893ad5f07da751179f55af355083472831145de28311b3cbb8364b8cd5a8",
      "text": "kesel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "feb98fc124527f292610b24419c1f6e7e0ca706ceae6f70ff27b2fa416038266",
      "text": "yen / nek",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff627194c017af904b8964332f7e31b9e8828f4dd8636b211d06962633c95e67",
      "text": "Nek udan, aku neng omah wae.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
