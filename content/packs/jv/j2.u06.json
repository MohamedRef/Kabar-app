{
  "format": 1,
  "id": "jv/j2.u06",
  "language": "jv",
  "unit": "j2.u06",
  "version": 6,
  "content_hash": "86803386d714a691df45f18dcfd928e56da51f1ce7d1bb0b25a67fd9ceb3d64f",
  "lessons": [
    {
      "id": "j2.u06.l01",
      "sha256": "afd010c8d5f870144b1ad4f919783e084eb1795828f3e4f75113230bd43cc489"
    },
    {
      "id": "j2.u06.l02",
      "sha256": "bd79d12926d1883c947f84bdd4deb946b146d1abb9acc0eabdaf4b70c5e609ef"
    },
    {
      "id": "j2.u06.l03",
      "sha256": "662e5a83fcc6fdd2e935c90d213aa432c8f4d3a0a0030f39119ee39ae1f00b3f"
    },
    {
      "id": "j2.u06.l04",
      "sha256": "dead9925b9061dce8d70cc616d2e1847e6cb2bdd0bb7ad322264891c934cdc32"
    },
    {
      "id": "j2.u06.l05",
      "sha256": "8b97b8e4cf2f41caaf206c498850c28af46fd1815ba6f96af944817ce86bce70"
    },
    {
      "id": "j2.u06.l06",
      "sha256": "7f8419e152df15475f3797c61e11035abc07e301ae76011773774e5b5d8b9602"
    }
  ],
  "audio": [
    {
      "key": "027d94bd283e197ce1f2c0de000f6fcfac13957780c6ef3ed2bad21de301d6ca",
      "text": "bola-bali",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "061bc8de5c6aee01d06dc0b053b3501081bd158c8debdaa0a758898e65350514",
      "text": "Mohamed, Setu ayo dolan-dolan neng Ngawi karo bocah-bocah!",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "077a7f4dcfb9a41d7c24a222ff83f38c858d38b723d02d1898617e2be4dea154",
      "text": "puanas / uenak",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "080d03b3663cac3ab52be12b41d5c0db999ea8a3dbb1f6198e4203f846bc5908",
      "text": "Bentenge apik tenan!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "08f12ba6a60bafcf8e644a5acea35b818300b951a4ce928e582440e676f16518",
      "text": "Aku karo Dimas dolan-dolan neng Ngawi.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c7d906b6257e66880942d5cd1a1b850fe205d95e75ea6dbe29ff83ad333485c",
      "text": "Wah, kowe wis isa ngomong «puanas»!",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca088258b9db6d0701821aff2dd339c87814a2730b9beb9ee95d1ff9c1d4f18",
      "text": "Saiki panas banget, ya.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d059e90305446195ec9955d1211fde7dbe316cd1e89c82d88fbcf486204458b",
      "text": "Bocah-bocah dolanan neng taman.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "102e7463b5bfbef0243bef7b0fa3e7f98ee59ead81db53af4c52398eb9e79bef",
      "text": "Sip! Bocah-bocah piye?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1389df4223f29344e984d2b96b694cc47a3f76ee59b50a99591cf283efd9f4d6",
      "text": "Sip! Minggu esuk, ya.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c0ed2a9bd1a3603f1dcc1c4cb074fc767018d16d40df5257fd2b92a001c0d2",
      "text": "Sip! Nek udan, dolan neng omahku wae.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1545ce547795a9a9c5d70d81999bb5376bc9f3375fce9632a391b4dcb9b87acd",
      "text": "Bocah telu lagi mangan.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "15d91156a3979d296675ff43bc3d80c2b060def739a5429f77a49448e573cc70",
      "text": "Mohamed, Minggu ayo dolan-dolan neng Ngawi!",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1642d1104cbf9de815d996f8fc361097265c965c6131088acec636a637074596",
      "text": "taman",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1928ee9a9ce8586c0f8f1ec9702913afc8e1fb517233d81480b98312610a99d2",
      "text": "banjur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bd32f289cd519d596f376639cdc0787a753a3d456ca441b7035dc75896ecc3b",
      "text": "Sari, ayo! Setu aku isa.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c244cf155fea6bc192afd75b8c8847b342aeb07c737f7bcca57fea03f9f2fed",
      "text": "Ayo, Sari! Aku seneng banget.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eef9b75f53141007bb3dc1dce54a1634e0205d3934768350f1494327e9854d4",
      "text": "Mlaku-mlaku neng Benteng Pendem.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ace31e683954352a8f93ef7de55f63549f23d04c9523d6823768f2d424137c9",
      "text": "Awake dhewe mlaku-mlaku, banjur mangan pecel.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b03ba72f391918d866b9bf782a7885ff076bd6a3853322d1e2402a93b4481bd",
      "text": "Nanging neng kana puanas. Aja lali ngombe, ya!",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "313496a5513c6ca0ca4e0d9ad79ab863ea3f02b95369f9fabe470138cc0589c2",
      "text": "Ayo mlaku-mlaku neng taman!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "31545fb17379caf7ea47581e95c6e71e2768f5188b07a240c427176fdfe84d22",
      "text": "Aku karo Dimas dolan neng Ngawi.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3608b247510d90171a0c3ad23a7d11f99082371313a12226b712da2c620ee574",
      "text": "Ayo! Neng ngendi?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "36ea168b73b753be2e1085474e869884e336235021bca8bd0e7e4f116ab33111",
      "text": "Benteng Pendem? Apa kuwi?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "376db4acd7853770d13933517c8f0675276a1b95e88ca5ae982be0a28644829c",
      "text": "Apik! Esuk apa sore?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "3810bc3d17096f262e3eabf0d516a4a77eee1b40eae493f63dfc6fcdff778135",
      "text": "utawa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3abfab4f6caf39d5e1fc1309e877d6d2bc032611586fcff0d86ed80f08305014",
      "text": "Sesuk nek ora udan, ayo mlaku-mlaku neng taman!",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d41c03ad013fc0747b9e72742599803e8841afe26792264a41337feb407d97b",
      "text": "paling / sing paling",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f2d0318a2544c853562883e5e274b6660f066184de27cecf22c9f3426546c1c",
      "text": "Nanging bosen banget!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "45a5ce1494878ba7d9dfb2bd666d116561cd1ad6eefb20a8680b8d0634d43063",
      "text": "Apik ora?",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "46a34dae4c5eb11367045042cc59d06cb2ffa2982bddc683836fe5e0ca8ca34f",
      "text": "nanging / ning",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "4787708437feec50831be4b06740822c860025d96e085a367e7406b51ea4f238",
      "text": "mula",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4933c4adc4e8dccca309032596d408516c603c6a7d8dac24debd3f9100425838",
      "text": "mlaku / mlaku-mlaku",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4982ea9d79bb65a3945bfde09e1731b4bd76eb120dbbc07ae0635cdbfda9fa35",
      "text": "Aku bola-bali neng stasiun.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b2aee160ba84bf6db7d7b3356dda9c048c4925b5d0b4bca333e8a40e3f56afb",
      "text": "Iya! Wingi udan, aku neng omah wae.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "51bec640f790da80edb6475b120d6fc0ec3639f1c534ab9b7e930fbea4117167",
      "text": "Aku mangan sik, terus adus.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "541867dec6811f621f0565284d41fbe961ba9309321208afd1a63d67095531da",
      "text": "puanas",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e0b381a36b1bb0ed90ae0b24055d5672d6ef4d90c5e880d287b7f5c1d72eff6",
      "text": "Kopi apa teh?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fbb5f81f941f3274da8bb3d53668f62729dbecabb0c34ab51763add4ea59bde",
      "text": "Wingi udan, mula aku ora dolan.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "653f0cb8756013a7f2bb1a9f6a6d4daece757f896f08d8a36b0a110f887bd7b9",
      "text": "Ayo mlaku-mlaku neng Benteng Pendem.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "65493c6546074536043035c5509ad8321f8cde6a1b07baedd5ab6a238d761031",
      "text": "banget",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c3f2ac6d0431dba3f30b6b2a78c6c562e16dd6343c34d0797ed63305a6bd1f",
      "text": "Nek udan, aku mangan panganan neng omah utawa neng warung.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "67ab3bd8e5df625aba98addcb8c393c044d772dc6d627fd970eb88b4949c4e96",
      "text": "Benteng Landa lawas. Akeh bocah dolanan neng kana.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "686f66476d0d9b2e9f0e8973c7c03c5b9a062d93e6668aaa98bc07ae8320ce75",
      "text": "dolan / dolan-dolan",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bf82973839ea9c5d6a70df877aad4e814aee7fb64bb71c9fe9da6aad9eb1b76",
      "text": "dolanan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f2c898b0eace44ea8290dbd842ad007b320265a08f0d7533c63656553a90c99",
      "text": "Uenak pol, rek!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ffa6704ce44c9f65494f88820c950b8c3ad0889564fc8a9359fba197daaa45a",
      "text": "Aku sing paling kesel, ora sedhih, ora wedi.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "709ba2d7d9eaecbcb1bfdcfeda1ae5055683d615d99b82d16eeec434b8ce63c0",
      "text": "Ayo! Aku seneng banget.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "72fa0581cdf1144199bdd971a6099a5324b8592bedd50d77495792ac7b8a199e",
      "text": "Sore wae. Esuk aku sinau.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "76b3daf88dbcd4d07c7de2f6c7dca3c12231d134330f650ca84f360abb27ef29",
      "text": "Mohamed clingak-clinguk neng taman.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7770d7b4d08d589c4972966394d77377d095ecade5557cd5cd000ededb6e5935",
      "text": "Ayo ngombe es dawet. Enak pol!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cb0daa5c83dabdb62c2a894c26f539d9fbc9582eda29771b613afef715fccde",
      "text": "Awake dhewe mlaku-mlaku neng pinggir Bengawan Solo, banjur mangan pecel.",
      "voice": "jv_siti",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7b2b8618b2e2daf152a0c017a1eb16521b69b898e6250ce61544e60b4cb313",
      "text": "Mohamed, Minggu kowe neng ngendi?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8074e3455ec02dd5829f7d1bdd057de58331b24adac2367c32f35bc60f0e319c",
      "text": "merga / amarga",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "811a124a645bb03224a49712e323d2b40c2dcb3e60c6a08611fccdfbdde2c849",
      "text": "Iya. Nek udan, mulih.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "81a70ffb7983de2b4e044948628712198477c286250ab8438fffe3ee448f7296",
      "text": "Dimas, aku wis maca statusmu. Bosen tenan, ya?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "86c2fd6344607bb4fe33d853b1d34b8cc56e13260abdfda67c30855107d61fa7",
      "text": "Panganane enak, nanging rada larang.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cd42a5687c5c40bb43f1e1ee0986309e798d893a3a4d0267cc8e462f1818205",
      "text": "bocah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fefbdd6ccbb336958fb3cd3437e37ed5cc5e7d66cc5bbedee416526dfc83468",
      "text": "Mlaku-mlaku neng Benteng Pendem, terus ngombe es dawet.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "91eda7da915ed31f5cec78cf0052fb5790e5dffd0bb0302fc23cc76fe3e4edd9",
      "text": "Dolan neng omahku, ya!",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "9650e6d6d437e665f68e58bdee8a995b87aa6d7e8b9b0ab3e2ffcde77c425043",
      "text": "Apik tenan, nanging puanas!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "97dba856d6c5e36c3e7027a6be36d200daee9d6aa2ccd65bb2155fbdceaf8b30",
      "text": "Aku kesel tenan.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2f5a9abbd945c1ffbbe9b3418994571543162d0ed00c80158341e7901fc689",
      "text": "Wingi aku dolan-dolan neng Ngawi karo Dimas.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0352a2d9dfaad5e02283f0303c796499e8beca1fc9439cec2d14dbbf4a4d6e2",
      "text": "Dolan neng omahku, ya! Ana dolanan akeh.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a10105fab9284ebd5c9be0b0bba97c888d1f9cca25de6cd2ddffc5f0c4fe5d15",
      "text": "Wingi aku dolan-dolan neng Ngawi karo Dimas. Seneng banget!",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a65457d29119e3c9718ef73cbcaea00b468645462e655cb786769932b4085370",
      "text": "Ayo! Aku seneng banget neng Ngawi.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8afe60ef3007b3f99c2256cd3799740b20843d6f7bb8096855f93538010b277",
      "text": "Teh wae. Mau aku wis ngombe kopi.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf68b6de9ce9bd4485fc410b1d9d6c20fca36b9d279446dafca171443168da9",
      "text": "Iya. Aku rada kesel.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab8e84950cce6a568e744e4deef5b80d07fef842964a5f6eca8335c8dfed0e68",
      "text": "sedhih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3571e8c5150dedab1a8e4e1670a703eea5d16884ca1b57db85879d1f766c37b",
      "text": "lelungan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5c8da5b6a67a25387d65f859e6aca8a87e2f747d350dba1322b22befbf56cba",
      "text": "Bayu karo kanca-kancane. Aja lali ngombe, ya! Puanas lho!",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf9aa593f7fd6e5466be127116c9508187a3dc69e1e7a64d96e1bea6a2fba8b1",
      "text": "udan",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c66f833df05b493920aad1e5e2c6b7203c40d581a076af0360d1a9fbdb3ebccb",
      "text": "Piye, Mohamed? Bentenge apik ora?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca367f43420328d6cf1198e7936cb680889f6b58ad331f5a2feea3239235d566",
      "text": "wedi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb1b15a102a4e492e0c1f4af683934ef7babd3aae056b3aa4a2312320e10707e",
      "text": "pol",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0db12ac75389c9b502ffc07ccb3f52727da7af571d423f28be6e5f686578104",
      "text": "Aku ora teka merga udan.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d292d14b03f7ad5b1e14deb0a608f4b0b9e5a8ce8b4272f8bc2fd8a5e0c89749",
      "text": "Udan. ___ aku neng omah wae.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3de61bc88e216205ffd5c4b1d6f34e2d63bbf0a2d5ee740b1b227cbd16c8c65",
      "text": "Apik tenan! Gedhe banget.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d62bb4cfe89dc38532267e1f0be20471940c8f4b526f6c4ecc864dcddcb3bfcd",
      "text": "Mohamed clingak-clinguk neng stasiun.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a2b1de944691763f8b954cc9ea9b0b4bb77692b09ac6f7ecc7981752bf625b",
      "text": "Es dawet iki enak pol!",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "daa63a4bd8a3ff8b940de3335146154cc52ea7c004064fb35b87615019bd8d6e",
      "text": "Sing iki paling murah.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "daa8412a5fc8db6dea7ac30152a2014cc2663ec5479e07914663c099b11c8ef8",
      "text": "Oke. Terus ayo mlaku-mlaku neng pinggir kali.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc32cad484e51eb973844e8c69260f8b339480237d24ad5dec3a2f8d97b4115e",
      "text": "Klambine apik banget.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "e16d60d7e9d9422ea8aef064ba274c0f4ab5fdc2a1fadb5bb1b7f975786051f6",
      "text": "Mohamed, ngombe kopi apa teh?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2688460bbb40ab5b942af0f705efe09f6706b0ef367cd7838f9eb300e6d34bd",
      "text": "dhewe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27f7c0a3ab5cad5725e97a66e48ff849d4f5b1b67942f2b13c69bfae68d8243",
      "text": "Saiki puanas, rek!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5374191d26152071832d12d867236b40ad69c24ae668412b009fd1f600bc7b3",
      "text": "clingak-clinguk",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea5b4e038a0fbab89af02a277a87b3ca99b819898c0843e213ee8eb9a997597b",
      "text": "Ayo! Nanging nek udan, mulih wae, ya.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb32439b8974acc81273a8bcb6c3e2a550660edee6f3b16bea95b0d39a8224f3",
      "text": "Ya wis, jam telu sore. Ketemu neng stasiun, ya.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec302803630301d24d174fee095421611da74daf7a27327a30a87545df045a7f",
      "text": "panganan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef71893ad5f07da751179f55af355083472831145de28311b3cbb8364b8cd5a8",
      "text": "kesel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef86c67ca330d6d12585aae995327ca1cd83fd0cca323e7585666553065581d3",
      "text": "Aku neng omah wae, maca buku. Nanging bosen banget!",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "f44ae425675996799262732085cc1935629135df985f94b0b11b90cdf941228f",
      "text": "Regane rada larang.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "feb98fc124527f292610b24419c1f6e7e0ca706ceae6f70ff27b2fa416038266",
      "text": "yen / nek",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff0d08ad6817826f7b274b442b615092b99e289ee57239f7caf6001120e22c23",
      "text": "Sesuk ayo mlaku-mlaku neng taman, nek ora udan.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff627194c017af904b8964332f7e31b9e8828f4dd8636b211d06962633c95e67",
      "text": "Nek udan, aku neng omah wae.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    }
  ],
