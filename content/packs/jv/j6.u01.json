    },
    {
      "id": "j6.u01.l06",
      "sha256": "39c17584bc52a503bfdcb6be75cb508e215396c2b78d7bf56fcb1de323d5c31b"
    },
    {
      "id": "j6.u01.l07",
      "sha256": "3fbd46df9c6b56bdf3e41e4c86fb7efc0b8c6a8228043db58f2c1f14e1a475f9"
    },
    {
      "id": "j6.u01.l08",
      "sha256": "71d7c0b2ab14e7dcb1fd47f5faa063f2edb0316eb9b8ab3d997ce8bfcb37fbaa"
    },
    {
      "id": "j6.u01.l09",
      "sha256": "ed0ee43751f71f7967bd8f5aa9d0a560948338327e173d79718b0b47fd87bdd4"
    },
    {
      "id": "j6.u01.l10",
      "sha256": "3769f3f5a09aa350d7457ea024bebec55835aa6a48a5342b92eb3813440b77f5"
    }
  ],
  "audio": [
    {
      "key": "005cbc2e3347a91a918a1f05a355e95b32dc7eff73dd93ddda49f86e60362bb4",
      "text": "Maya, Jaka, Raka, Rama, Dana.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "022bd79df58c132f06bbe85d83e18cd014560aa8db86daa0067cc21138028a64",
      "text": "ꦏꦤ (kana)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "02926b774531751ba1264abfdce76954657d5cd032f48b38979cf5c50b361d90",
      "text": "Ra, ka... Raka. Kabeh aksarane diwaca a!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "068183c8e691c39ae580b52f9bf3ff5264ac75321646ea93f21bf97c0f115d18",
      "text": "Iya. Ditulis a, diwaca o.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "08a754fff5c0b9dcf475c1566959280a3ba708190124390b10b8553bf1408d21",
      "text": "sapa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed508856a13d827ef456c80d5ff7aaade532f697bc39357c722a5a2100dd46e",
      "text": "Ma, ya... Maya! Lan iki Jaka.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "15062faf17509e10fb06b3104b60da871e700c33a628d6dd93889d50019ea043",
      "text": "Inggih. Menika hana caraka, crita Aji Saka.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1555ffb6217c7119e438201ae5c8893aab26b023791effce58beb81abffaa73b",
      "text": "ꦥ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "1989b00d014fab2cac0300b7a4bd747b9dce6c09354deacf020ba24062b633a9",
      "text": "Ha na ca ra ka. Hana caraka.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ac331802072944df96004fbc9c5016dbbbbd4e94a707b9ed9a28e6e4d90d0f6",
      "text": "Dana",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1adab9d1d8e0e6cf457098fc5e543b8219662492fb71062f21d2e466a0c075ee",
      "text": "Kacamata sapa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c17de23e6e0611e7d7bbffe331c6c1c2d10def7ef2212407d45fa22a68d0f5b",
      "text": "dhadha",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c20c0d4d46412e617481598ba893685d5bf2d5c65d767c4315928090fc097cf",
      "text": "Jawa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eaff174b1351d10f1c682d2652617564d6c903187660a065a3040445549d1e5",
      "text": "Jaka jaga, Maya maca.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f2955908776a96e68c5cf51b44015b1bc3c63c5c895ababa9a61449fd389e1a",
      "text": "ꦭꦫ (lara)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "20be0d3b24a99c4dcd98d4de9eb4c5fc804982b85f000f4c0c22864b659bb9d9",
      "text": "ꦲ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "214c57aad43a6ef3fa2166ba6f50365705bfaaf65010fa2579979c70192e91c9",
      "text": "Hana caraka, data sawala.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "26854fae8cf9be9151b9bb59bcae3ebb25fb16c9be318bcb9b3a9c91cdeb10d2",
      "text": "Bener! Saiki kowe isa nulis apa lan sapa.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "2903c458466d218d5be9e01e5f86498d6445223308f554e05f0ea47dce0841dd",
      "text": "ꦢꦠꦱꦮꦭ (data sawala)",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a9308ed921930e0e2f028b248c905e7487e6ee3cc7ce05d37d0b6440b86959b",
      "text": "ꦲꦥ (apa)",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bdffe0ae545343a43fcc8956a0b78d0343e49d54f6275163e6e5da010b230a7",
      "text": "Pinter!",
      "voice": "jv_dimas",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f92b7d5985aa8b9125b381b2e56f030271e3df351d9c4eb5ee1741966fe6090",
      "text": "kana",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "303a66fa824a0bbebddbf10c26dc3893cd0364255040a15fae35b77528e7508d",
      "text": "Kacamata sapa? Iki kacamataku!",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "314b1627ea87156affde5cc2e406ed56cd04e7edd83d155c212bb1516e2549ba",
      "text": "ꦪ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "360fa84b922f384f814bd30b5599a8565bc0d6690ea06cbe5919427c0e46b178",
      "text": "Bu, buku menika pinten?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c03a7e62ab0c63f0dea07e728a855b0f2ed8cac02f9997356b61f090401a623",
      "text": "Wah, Mas saged maos aksara Jawa?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "400c3b68d8b36cb859d465ef381dbdc0a2a5a0bd1379ed684fbeb6810b9fdadd",
      "text": "ꦩꦠ (mata)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4076e03320d4b6568012b1836f1022a8b58729ce9b48a15cf871d44285640218",
      "text": "Mas, ing kertu ditulis maca, nanging kowe ngomong moco.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "424e9d1262bfda1f7311874c2e957c27862cb5adc3e7151d423e704b4d84f5d2",
      "text": "Durung, Mas. Aku lagi sinau ha na ca ra ka.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "46eaccb59a14b84659edc12ee7c350a94002e5ca5fa4fffaac0779e55b164fcf",
      "text": "ꦤ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "47d629bc35a765a8a6202ccf1854dcb746b936c989e32dd2ef0bddce7874b4d5",
      "text": "ꦫꦱ (rasa)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "48e51578193f06e41cf50875d3e00304739f657a8c5c00e096747354088bef42",
      "text": "ꦱ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "491da2e67d7e3ee0093bee39b576a526d59a0a75388679ffe786f9008f14d3ff",
      "text": "Maca, Jawa, apa, lara.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4933f7706392b342a3ca4261722da022d730a882dd0e3cef648522784b171154",
      "text": "Wis rong puluh, Mas!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ded8828d808ba77374edcfb41053b6d895847f014f3d6af4910689fcd53dbe0",
      "text": "ꦛ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "504ebdb6644074051d6059d16781260a462f512c07f184e0bbda060384fb1c7a",
      "text": "Sedasa ewu, Mas. Kangge lare ingkang sinau aksara Jawa.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "517478516b22f79b3711302dd5f8ed025891f11b5c4da6c0a174ce48c75a8c57",
      "text": "Kaya apa lan opo ing chat, ya?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "54015726d087e706fb759ce78151314dc805e7b9d0108056ef2892ea4470b88d",
      "text": "Sugeng rawuh, Mas. Menika perak saking Kotagedhe.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "55f9f4d3e5237600f0eb39ffdfc9e9768776a59037de93837afffa556898fef0",
      "text": "ꦚ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "5630d19e226c1efcfac5c8e6d175178584d3fc03e910add571acaba36db3f48d",
      "text": "ꦏ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a481e09e3811689a6c258bf4aa45f5f476dd0963c1598598fc2f6556058a7f8",
      "text": "Med, aku nulis pitakon nganggo aksara Jawa. Wacanen!",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aa3e53bfa8b0caeaef0e671f348c3dc92122e2b1245ecb36f2273bdbefb9215",
      "text": "ꦫꦏ · ꦫꦩ",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ddb78e42ede34dbc84ecd5432d91a0b3d63520888d9b72c36c7ab21a99b0959",
      "text": "Mohamed, kowe isa maca aksara Jawa?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ed8f0f466b7a715028e0e98c1beec65676d6fa06b06dbe4e638c6bd8f553ab0",
      "text": "Oh, aku ngerti. Da lan dha beda.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef8b9d8261db9a1ce4190a30ce4e12508a355ed02eb322f04985f57aad33c57",
      "text": "ꦭ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "610252588206000e83965c7c1b36c8af217739a6d9bcf627b3886428c3b9256b",
      "text": "Ha ha, bener. Lha iki?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "65435898d97e3276ad69a126c9ff7b9738e50c1dd6d3d69201c1e6949b9d0772",
      "text": "Inggih, menika kacamata kula! Kula maos seratan panjenengan.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "6574e5951bfd54cad576a2ce9aa82fc5205a2ec81862b2cecf4e2c35a62c7ab9",
      "text": "ꦝꦝ (dhadha)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6647b30697f04e1694f3c6cfa617676b6f5d8d104b24a5dbed3685304ffe38f6",
      "text": "Maca apa? Aku maca tulisanmu, Mas.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6950ceda23af1c51f6a01f12330c6d309304c78470f0c228597a5c095722bb62",
      "text": "kacamata",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a0eb94c04b2858a450a28e9ac6d450fb9828a4b8bc302555e4c2470b5ed1df2",
      "text": "ꦩꦪ (Maya)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f10315acda26d2c3926b88ff1f1318fe8233b2c9f067e277ae73ce212db7153",
      "text": "ꦗ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f48f6e1451206fd5a7d91a03b8ea4e7cf7003eb77407dfa2e4020a6bcb25ae9",
      "text": "Med, saiki kowe wis ngerti aksara pira?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "726b57afbdeee87ac59c387d5fb67659f9836e44cd3fab26ec8d361b8360ef27",
      "text": "ꦲꦤ (ana)",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c9e44a9803c15893a32834398aa195cf78b3f46684c021779a0440be45b1f92",
      "text": "Iya, nanging diwaca loro. Kaya pira lan piro.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cac9ddee1b354db421f72ab93cea915a4727c056d4e937022cd1fb67155cf7e",
      "text": "Sekedhik, Bu. Matur nuwun sanget!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "81ac61af4f589ba359ef2d2f79ade658d8c073a65ba2b66774bd76835f8e26f6",
      "text": "Jaka",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "83299f36f51880f4977ef282cac85a1e6cf730b983daf96d8bb90985d3a99965",
      "text": "ꦢꦤ",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "866a464298d0b7810ca9680959e7c504c565cc5ed3926e030d2b55a394985c30",
      "text": "ꦗꦏꦗꦒ (Jaka jaga.)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "86f99c9d5013f6556cef7fe10cef922a59f46bc95bd82e3bde9b4fd32ef76ad6",
      "text": "Nuwun sewu, Bu. Kacamata kula ical wonten peken.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a3ef8e3e771df658ade1892a4260c28f1c18a3b26405c11e30993b6d05fb9d9",
      "text": "Kula sampun saged maos kalih dasa aksara, Pak.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d92ffdfeae6b392f37cc3dc66146d7a7b8a1999229e531c6e416a7ce32f147e",
      "text": "ꦱꦥꦩꦕ (Sapa maca?)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d96827ad68cb6783a054875cff45cdf561cfa6f5dc23b06131a9016caaab651",
      "text": "rasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ef18fac9d39a54462ef4c1d65df6ed8a7836d5b8c6d114ebfc7b3be7f2e30d4",
      "text": "ꦫꦏꦭꦫ (Raka lara.)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f626e20fd1322e1ce7f6736b22d3c68e092341deed8b15fecec559c25fce475",
      "text": "lara",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ffcc3d4e18481dbfa507750219303aa229e9bb58861ebdb35aeb371ef2580d0",
      "text": "ꦧ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "914bea1ec3318c7c3315cd470aefb01d57ea8fa67096c7eee99d8fc997b06a98",
      "text": "ꦔ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "92629098c456ffe7951143334be7a8b6217de864efd966024cec950b6caab921",
      "text": "ꦒ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "953af758583899564d0f06ae5d54006ddf9b8df50e41382e628f32ffba97c918",
      "text": "ꦠ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "962b8f06249218d368ae8b4151fbc0dcb28247d35bf320a7cbca1c3246a144ff",
      "text": "Aku isa maca aksara Jawa.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a9d61258e5c2b695f07f842fe4fc37838b2087ff49869a180489993a8277aac",
      "text": "ꦔꦥ (ngapa)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b64db712afc919ffa51d5eb9e37f086337c11e6b9a0d3c436be8848e2ec1e30",
      "text": "Kula tumbas setunggal. Kula nggih saweg sinau.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c4c46e10240dfe91028a27531d726c36bca04bb783c51cc862f5ffedbb1a27a",
      "text": "ꦢ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c7fdc4c62abc34374ed1de490d716be2c550518491e6842e24935170337e153",
      "text": "ꦫ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c8ae4f7020caabe92c7c13787bec13a5354c4f15f878c08932d545527c18f72",
      "text": "ꦥꦝꦗꦪꦚ (padha jayanya)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e0ec479a20634b57d3036d3eb505c2ca583867a503f4878ed278b378fd90882",
      "text": "ꦗꦒ (jaga)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0356615192d18cfe0d0bd2ee81dafd249d75a1923259327c0703937cfc91124",
      "text": "Sapa maca? Lha, aku sing maca!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a35ccf3d131cf304d08b176f223a9b98546827aeb864a1b0ea85a995cbe27a45",
      "text": "Bener. Sing iki?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a43421afc26b3333727b8e4744fc2aa5b0ab1ad918398bc1077872c5b361dec3",
      "text": "Bener! Nanging aksara Jawa mung nulis apa.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b21ec3319aa8d2e5f228b64d2d94e9621a3e29d466b3d670b7cdd14db3539e6a",
      "text": "Wah, sae sanget, Mas!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd206097e1bdcea87894f7273327a0569633bb64b579cabd5579b458f4672a3a",
      "text": "Wonten kacamata ing mriki, Mas. Menika?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "be3b9ae8f7fd4e71935fa6def95a7feffa612df9a5bc2212b059c82f5cb37b26",
      "text": "mata",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3221a0279d8ac5599232066abcac7193e0af6964c98fdf551aead0a78df7fa2",
      "text": "Iya, rasa. Ra lan sa.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c38a8e0754283002171a972ff6938ce6b535f8c8bfc6002fc89782d66292d0f6",
      "text": "Sapa maca?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c50052aac763c0c71a99ef33c5aec00967c64200174f44158d9ced23b3182e15",
      "text": "ꦲꦤꦏꦕꦩꦠ (Ana kacamata.)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7d9531c276f761d1650fc5720ba3896c2428e35a757a15bced4ce0b9148cb1d",
      "text": "ꦕ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "c98ce0cb4221633003feb4853feb84ed63651288836f80c2bed57c0d6dc00654",
      "text": "Mas, tembung iki diwaca rasa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "cab3957997d89f148c6f839df40fff047a91f275d091b52467d59b98a1eeb276",
      "text": "maca",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccbf204aaaef4a1dfc9235c4b389498317f53240f45b84838d63ca984264c3dc",
      "text": "ꦩꦕ (maca)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd35b140c80018be65f1cfa9c78c3ae5f66cd700425a9f269da3e6706a6e6d1f",
      "text": "Dudu. Iku dha, kaya ing dhadha.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0dbbcf0925f30515e1140533c4c002fcac0d82b0627fdcb316e810d316f14af",
      "text": "Hana caraka, data sawala, padha jayanya.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d13d46c5ac74f90874755c0a38587b109969023afb28ce1e7839cb191e8beaeb",
      "text": "Sae sanget, Pak. Wonten aksara Jawanipun!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ed7009d4461da116f96ee5499bf91a13a6731842f0148ccddb249ef612eed5",
      "text": "Hana caraka, data sawala, padha jayanya, maga bathanga.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d28f388341bd45cb1dddc65640e2148bf22e7e6bb1c0aaedab7a5ddfa941c827",
      "text": "Jaka jaga. Maya maca. Raka lara.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d34295d4057bf139f3e61d613db16e25eb56924cbb73037e5a7d49887301f543",
      "text": "ꦩꦪ · ꦗꦏ",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5ab369194199519ed0209440f87b0e216933a5e8f212d409b6d8c6eac3905e3",
      "text": "ꦗꦮ (Jawa)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9032f46daaa4be19fcbc39165d120d1abce3293b7fed499ae07f8fee82ac259",
      "text": "Mas, aksara iki apa? Da?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d90f00f6a08c988ff181f7d7b83cad1acd103dfb353e2c529ed2efea49e65a44",
      "text": "ꦝ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "da14ba29429874d1db2a07a7a490f9bd36ebf105b3bc2cdb2df921fe0d762946",
      "text": "Lha iki? Lara?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "db0d792d1e9b2cb871783dceaa168a6a1636855ea61f181f9128e32518e588c4",
      "text": "ꦲꦤꦲꦥ (Ana apa?)",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "defffd15a50888e676c2b6759d4ff4ec3b42220ceb70a6042267f986b38404dc",
      "text": "ꦱꦏ (saka)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfeba23c3a878ec638c16832ca3ac94d0e6d526aea4ce90b4bf6dbd64bd560fa",
      "text": "Jaka jaga.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0275b832043567cb0229d6940c906998cb94dd2efa4c6fb6dc22e9bab4f0eb5",
      "text": "Wah, apik tenan! Coba wacanen iki.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0ef7c553bdb1cf12521d6683cdcb8aed6934a209af2f5cf93980ad23a6e9c8e",
      "text": "Wah, sae! Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f540dfd494ab8883b90e1cbfc05821f82c25361cffbf43fe96223aaa70a88a",
      "text": "ꦩꦪꦩꦕ (Maya maca.)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2bf957341e94a21f7d6b3b3ae4fb87bfc1183d530cde83cd1d799950ef80930",
      "text": "ꦏꦕꦩꦠꦱꦥ (Kacamata sapa?)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e364ae95785183756daa1b954b8812cc1d3d424d5d0021dd6ca03a82bdb7c726",
      "text": "Kaya huruf Arab nganggo fathah!",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56d360c57adead6d4e6669cd4d71f1aae627e1bdf230eb3755831d79b89c7a2",
      "text": "ꦮ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "e960af07bf1b235156c06ecfac05d2139ff39288980f20c12790e0498040c0f1",
      "text": "ꦲꦤꦕꦫꦏ (hana caraka)",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "e96673a2d63d0397f952bc9a92c9e995a75dfca2ca86f1fe3a567ae26f52f2c3",
      "text": "Med, ing papan tulis ana jeneng-jeneng. Coba wacanen.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9be1a1063a63235195bd5b4eeb27575309da52b8e4953fbe04e0a60f6902b5b",
      "text": "Ma, ta... mata!",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed57eb3c4230e42546b905a11394f9075f7e5c08da2116c0d256fdfafa756a23",
      "text": "ꦱꦥ (sapa)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4942cd1b9017920da86402db09c5b87448dcf333f94dbc4b8461114cb5f69af",
      "text": "Iya. Kowe wis isa maca jeneng!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6f26eab839b4b96331a54bb83b36dc7b45e99b476872a088a2f61326c1759fb",
      "text": "ꦩ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa8b5fecf855147c76b85beabca002c21975b0b29b786241457a2d195df88148",
      "text": "Apik! Aksara iki diwaca ka, dudu k.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa976a6da9222949962ffd6d29ca2a3545687340882f0e99c475654867cded45",
      "text": "ꦩꦕꦲꦥ (Maca apa?)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb95d5dad585dad34663b8305b6e8669d2000fe6bdb3527cd509273f824948ea",
      "text": "ꦩꦒꦧꦛꦔ (maga bathanga)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    }
  ],
