    },
    {
      "id": "j6.u01.l14",
      "sha256": "98dde435699f55a5de1d1c9dbf7c13e4afe810abeef2f57ff5d8297c9c1f574d"
    },
    {
      "id": "j6.u01.l15",
      "sha256": "80f2f5ea0b75297f16fdb93233d8e6124d32915a357130b15e505e0c267865ef"
    }
  ],
  "audio": [
    {
      "key": "005cbc2e3347a91a918a1f05a355e95b32dc7eff73dd93ddda49f86e60362bb4",
      "text": "Maya, Jaka, Raka, Rama, Dana.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "012638212ed2dc74e49e5a7ecc14cbb1aa97c0173af93e405b520dbb920a9b95",
      "text": "Pak Slamet lungguh ing emper, ayem banget.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "022bd79df58c132f06bbe85d83e18cd014560aa8db86daa0067cc21138028a64",
      "text": "ꦏꦤ (kana)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "02926b774531751ba1264abfdce76954657d5cd032f48b38979cf5c50b361d90",
      "text": "Ra, ka... Raka. Kabeh aksarane diwaca a!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b8d06c04cbd930f11f6738b3b1444388f858f13f0c62f7a4e203cc43632e82",
      "text": "Leres. Panembahan Senapati jumeneng raja ing ngriki.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "068183c8e691c39ae580b52f9bf3ff5264ac75321646ea93f21bf97c0f115d18",
      "text": "Iya. Ditulis a, diwaca o.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "070a3ec38232b25edafa925fb6e14b9d43032447573e5f94617653a93a4ca7a2",
      "text": "Sabanjure Dora teka arep njupuk keris...",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "07deda4248b6210f0a2cf4525ba20081c9a4d18ddeb4a7bc06ef9d1dcdb8b5a5",
      "text": "benteng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "08a754fff5c0b9dcf475c1566959280a3ba708190124390b10b8553bf1408d21",
      "text": "sapa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "08bc84774a8a517dd8cd0ce5845fe70267dd731a88f5819582d905a9d2f4b273",
      "text": "Wah, sae lho! Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "092126b2022e0554b0d4ecef9bd5a0efb34c32506d69acab13d22eaada597ff1",
      "text": "sampurna",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "09fba453fd37e62c1220308159366429b21bafd4528ed92db1114d3d13a7148e",
      "text": "Panjere separo, sisane mengko yen wis rampung.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bd577e978ceba5ec0f8e37d628434af9e6c3d76a0475069e525821cb17ce7ed",
      "text": "Payon lan empere omah iki isih apik.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d15a4115b59cb4a73268feb2ded8e5cc5fbd1a8721f4fd3df88bf18129ce27b",
      "text": "Ragade 200 ewu, panjere separo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d4bf47d2718dfd40f2bb32d20a9245adbddd7528a41b8ac1cf1f9640c3c5118",
      "text": "Wong loro tandhing, lan loro-lorone mati. Mula ana baris 'ma ga ba tha nga'.",
      "voice": "jv_dimas",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed508856a13d827ef456c80d5ff7aaade532f697bc39357c722a5a2100dd46e",
      "text": "Ma, ya... Maya! Lan iki Jaka.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "11d3d6dfe5147208eb1b4036c23315b6a02710cdafaf4581d28cb872052aaf8b",
      "text": "kalung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1415c06e187b71a914cf1a1e07881624210fbf4363c238364b26eb510c0d0bc0",
      "text": "Sabanjure, Dora lan Sembada tandhing.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "15062faf17509e10fb06b3104b60da871e700c33a628d6dd93889d50019ea043",
      "text": "Inggih. Menika hana caraka, crita Aji Saka.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "151ec3c6476dcdeae7213a6c768049c95b68d45e034a565f129d6477abc665aa",
      "text": "Iya. Kowe wis isa maca jeneng, lho!",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1555ffb6217c7119e438201ae5c8893aab26b023791effce58beb81abffaa73b",
      "text": "ꦥ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "17ba6afa3bc2b75c882aca85d83076af7babdc7bd133fd34d92974af8cadc5a5",
      "text": "Benteng cepuri iku tembok sing ngubengi kraton.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1989b00d014fab2cac0300b7a4bd747b9dce6c09354deacf020ba24062b633a9",
      "text": "Ha na ca ra ka. Hana caraka.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ac331802072944df96004fbc9c5016dbbbbd4e94a707b9ed9a28e6e4d90d0f6",
      "text": "Dana",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1adab9d1d8e0e6cf457098fc5e543b8219662492fb71062f21d2e466a0c075ee",
      "text": "Kacamata sapa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bad6611fd23ef30ef14ae88c4cdad3e9253293747966a51f513c26fc60a90d5",
      "text": "senapati",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c17de23e6e0611e7d7bbffe331c6c1c2d10def7ef2212407d45fa22a68d0f5b",
      "text": "dhadha",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c20c0d4d46412e617481598ba893685d5bf2d5c65d767c4315928090fc097cf",
      "text": "Jawa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ce3ba016f89252cf110b7df2ab0459db2b0a4e34586d6d37837f04e47f8c54f",
      "text": "Sithik. Aji Saka duwe utusan loro, ta?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eaff174b1351d10f1c682d2652617564d6c903187660a065a3040445549d1e5",
      "text": "Jaka jaga, Maya maca.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f2955908776a96e68c5cf51b44015b1bc3c63c5c895ababa9a61449fd389e1a",
      "text": "ꦭꦫ (lara)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f385ffc9d163b3c935a970b8304bbbaa71d67ce54f89f9a5fe63f8f51f2dadd",
      "text": "ragad",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "20be0d3b24a99c4dcd98d4de9eb4c5fc804982b85f000f4c0c22864b659bb9d9",
      "text": "ꦲ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "214c57aad43a6ef3fa2166ba6f50365705bfaaf65010fa2579979c70192e91c9",
      "text": "Hana caraka, data sawala.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "219433e655bcb1359071b3db42ae6f0fbbfa6373d56bf158abfef28bca246ee2",
      "text": "mertamu",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "219d214ae3976e0ef690fb74b9f2a1d2d032414d81bb99244d67a987237f37e8",
      "text": "Iya. Sembada nglakoni weling: keris aja diwenehake sapa wae.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "232d276f54a4e0254da8c61215cbe5b473753bb816defe1b9b3701f7501ebcdb",
      "text": "jagang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "23ae5c70e92df5f6247473c8b8339e8311b06287896e5afa304d59dbe5ad01e7",
      "text": "Baris ___: 'pa dha ja ya nya'.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "23eba39db3bea0d6463a7867113ee7982669348b955db5be4bd0886a1b32cf56",
      "text": "gelang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "255f7473798360231490666016051716bda62baf3c41fcb276d993f41aff9a03",
      "text": "Raja-raja Mataram disarekake ing ___ Kutha Gedhe.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "27de60260a56eb8616640342eb00b428b149520c0e5adfd4440e826a1f3a8d67",
      "text": "Iku omah Kalang. Payone isih asli, pagere tembok dhuwur.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2903c458466d218d5be9e01e5f86498d6445223308f554e05f0ea47dce0841dd",
      "text": "ꦢꦠꦱꦮꦭ (data sawala)",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a9308ed921930e0e2f028b248c905e7487e6ee3cc7ce05d37d0b6440b86959b",
      "text": "ꦲꦥ (apa)",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ad1766166d5ec310a47ab90eaeb41765f3cef9a854d2238b19c3df7c2c50bd5",
      "text": "Inggih. Tatah kaliyan palu kangge ngukir perak.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b46018574843166f78f22cb4d962ceac911f0fb7c2162d95d221967803041d0",
      "text": "Sapa maca? Lha, aku sing maca, ta!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bdffe0ae545343a43fcc8956a0b78d0343e49d54f6275163e6e5da010b230a7",
      "text": "Pinter!",
      "voice": "jv_dimas",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c090a8d4d166f13a918c51fab3bfcb98c5d0c7487195f01aa1167ab91d6ed9d",
      "text": "Menika, Pak. Tulisanipun kedah jumbuh kaliyan jeneng kula, nggih.",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f92b7d5985aa8b9125b381b2e56f030271e3df351d9c4eb5ee1741966fe6090",
      "text": "kana",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "303a66fa824a0bbebddbf10c26dc3893cd0364255040a15fae35b77528e7508d",
      "text": "Kacamata sapa? Iki kacamataku!",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "314b1627ea87156affde5cc2e406ed56cd04e7edd83d155c212bb1516e2549ba",
      "text": "ꦪ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "31da09235e966d4f4415054d2f0271faa17d671962ec4df14fed9e256e39ed2d",
      "text": "Pak Slamet ngukir jeneng nganggo aksara Jawa.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "32c3af38b3ea0355912d06b4fc909be11c6c42e1a48b502f144eaf10e32beabc",
      "text": "Kalih atus ewu. Panjeripun separo rumiyin.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "32f59794ee29c41e8d9d922311d073e3f67a2b1459c71b1c887e2a8d6cc546f9",
      "text": "Panembahan Senapati disarekake ing pasareyan Kutha Gedhe.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "3346d49663b2a75dae009baeec9e241da94e6232aee8c05b7363a5b7b05eadc9",
      "text": "babad",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "360fa84b922f384f814bd30b5599a8565bc0d6690ea06cbe5919427c0e46b178",
      "text": "Bu, buku menika pinten?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "361b3571c6a123d49b0cc03c75046fad916dcc1b5ded1cb815617f835c503eba",
      "text": "ngukir",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "36aa99db6066cddc5661ac4d4bacfbe2f1a165aa3e6e13652f518ac24823cc51",
      "text": "Kula kok kepengin tumbas ali-ali setunggal.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "36df831a6f68d6d29cc35223189fa6a78b49b554e3c70e49273007d71ae98651",
      "text": "Mohamed, kowe ngerti crita Aji Saka?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b24cb4a20a35fa7ab08a055c5b428faba8cc4312450cce659be6f5d2a72fd0d",
      "text": "Omah Kalang ing Kutha Gedhe payone saka gendheng.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c03a7e62ab0c63f0dea07e728a855b0f2ed8cac02f9997356b61f090401a623",
      "text": "Wah, Mas saged maos aksara Jawa?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c14f92b4e5244ba98f47f4b82b05d8f73df011849daf544cd5650d6f96eea2c",
      "text": "ukiran",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c1e4ec648eaebd9fded3096e0f01f1286dc6054a8c9d2017c34a2e61a63ec0b",
      "text": "kinclong",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c457b5d481a998f0662914e04c64d07a25c02def3548f705065d5281386cfc0",
      "text": "Benteng lan jagang lawas isih katon.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "400c3b68d8b36cb859d465ef381dbdc0a2a5a0bd1379ed684fbeb6810b9fdadd",
      "text": "ꦩꦠ (mata)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4076e03320d4b6568012b1836f1022a8b58729ce9b48a15cf871d44285640218",
      "text": "Mas, ing kertu ditulis maca, nanging kowe ngomong moco.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "40f429826076015ce8ea8b3702199a2d9fed50b125a143ff49b6530a28a4e602",
      "text": "Ing ngarep pasareyan ana wit wringin gedhe.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "41b9e8a49f2b4cc8085b7d48ba217704dbbbe521539dcb8b876935722c8d171d",
      "text": "Iya, nanging diwaca loro. Kaya pira lan piro, ta?",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "421bc368700e76ceed1d81bc84705e9c59b0f157b7a0135726394b62d0a280ec",
      "text": "Pak Slamet ngukir ali-ali nganggo tatah cilik.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "424e9d1262bfda1f7311874c2e957c27862cb5adc3e7151d423e704b4d84f5d2",
      "text": "Durung, Mas. Aku lagi sinau ha na ca ra ka.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "46eaccb59a14b84659edc12ee7c350a94002e5ca5fa4fffaac0779e55b164fcf",
      "text": "ꦤ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "477f33d0cc5bb03017a2a79bb1bccb60f5eb62e840e56965d8e5c838c694e266",
      "text": "Aji Saka duwe utusan loro, yaiku Dora lan Sembada.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "47d629bc35a765a8a6202ccf1854dcb746b936c989e32dd2ef0bddce7874b4d5",
      "text": "ꦫꦱ (rasa)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "489a1ceee36e52816ed09810b2a9f554c7c8e3e870b803ac57125e66e3b4ec7e",
      "text": "Pengrajin perak kudu tliti.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "48e51578193f06e41cf50875d3e00304739f657a8c5c00e096747354088bef42",
      "text": "ꦱ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "491da2e67d7e3ee0093bee39b576a526d59a0a75388679ffe786f9008f14d3ff",
      "text": "Maca, Jawa, apa, lara.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4933f7706392b342a3ca4261722da022d730a882dd0e3cef648522784b171154",
      "text": "Wis rong puluh, Mas!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d2d98b048f60087300bef0c20d9dcce6511813dbbfca311a06b382f1084497a",
      "text": "Mas, empere omah iki jembar tenan, lho.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d7bb19b2a501a44d8b6dd0df2e9a978249983ddf43ce1a550084f9bc0bb9551",
      "text": "pager",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dcaa7ac22271e5f244d1d57c337152d44a8a6c6b5f6527a6066a9b76a5b9c87",
      "text": "Aku sumelang, aku durung isa krama alus.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ded8828d808ba77374edcfb41053b6d895847f014f3d6af4910689fcd53dbe0",
      "text": "ꦛ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "504ebdb6644074051d6059d16781260a462f512c07f184e0bbda060384fb1c7a",
      "text": "Sedasa ewu, Mas. Kangge lare ingkang sinau aksara Jawa.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "5089503c0a3eabceab4d39e5b95166062b77d7182b71c21efc13a205ec7bd583",
      "text": "Pengrajin perak ing Kutha Gedhe kudu tliti.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "520933f0bf1cbda74c56b458c8119d66cdf77e6ac8f974a0e7d38ff54d38b8cc",
      "text": "lunas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "54015726d087e706fb759ce78151314dc805e7b9d0108056ef2892ea4470b88d",
      "text": "Sugeng rawuh, Mas. Menika perak saking Kotagedhe.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "55f9f4d3e5237600f0eb39ffdfc9e9768776a59037de93837afffa556898fef0",
      "text": "ꦚ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "5630d19e226c1efcfac5c8e6d175178584d3fc03e910add571acaba36db3f48d",
      "text": "ꦏ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "567de8e49d6ae10f5ac942b7e2fc2e2985f1f7d2ee5aadb2bb563efe32d0497d",
      "text": "utusan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5768e72e0c4f305ac3a32af50d07105fb497532f7cb0f082df227ce99197499c",
      "text": "payon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5829c6acd589f1227de57bc98d30410d5ce33bdca62d75d5acacbe9275f671c6",
      "text": "Ayem wae. Ngomong alon-alon, mesthi dimangerteni.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a481e09e3811689a6c258bf4aa45f5f476dd0963c1598598fc2f6556058a7f8",
      "text": "Med, aku nulis pitakon nganggo aksara Jawa. Wacanen!",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aa3e53bfa8b0caeaef0e671f348c3dc92122e2b1245ecb36f2273bdbefb9215",
      "text": "ꦫꦏ · ꦫꦩ",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ddb78e42ede34dbc84ecd5432d91a0b3d63520888d9b72c36c7ab21a99b0959",
      "text": "Mohamed, kowe isa maca aksara Jawa?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ed8f0f466b7a715028e0e98c1beec65676d6fa06b06dbe4e638c6bd8f553ab0",
      "text": "Oh, aku ngerti. Da lan dha beda.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef8b9d8261db9a1ce4190a30ce4e12508a355ed02eb322f04985f57aad33c57",
      "text": "ꦭ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "610252588206000e83965c7c1b36c8af217739a6d9bcf627b3886428c3b9256b",
      "text": "Ha ha, bener. Lha iki?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "61a9cb4a1e976a114daaacc9d5bad57a7b62970e0cbe83e0329cf34dbf4da146",
      "text": "Oh, 'padha bathange'! Saiki aku ngerti.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "63c33e7a184d431fdb8dc983c201a777bfbe0deaf60b2f8ad2ecd2766716ad14",
      "text": "separo",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65435898d97e3276ad69a126c9ff7b9738e50c1dd6d3d69201c1e6949b9d0772",
      "text": "Inggih, menika kacamata kula! Kula maos seratan panjenengan.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "6574e5951bfd54cad576a2ce9aa82fc5205a2ec81862b2cecf4e2c35a62c7ab9",
      "text": "ꦝꦝ (dhadha)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6647b30697f04e1694f3c6cfa617676b6f5d8d104b24a5dbed3685304ffe38f6",
      "text": "Maca apa? Aku maca tulisanmu, Mas.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6674b7da6dbc90f6839ec8df623f674c5cc8af20d36b04ed7884d6c63773b269",
      "text": "Sabanjure, Aji Saka nulis aksara.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6831af9706143029727158ee04498852402a79dadb16b5f37308bc53927f0eb5",
      "text": "pasareyan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6950ceda23af1c51f6a01f12330c6d309304c78470f0c228597a5c095722bb62",
      "text": "kacamata",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a0eb94c04b2858a450a28e9ac6d450fb9828a4b8bc302555e4c2470b5ed1df2",
      "text": "ꦩꦪ (Maya)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac62c4ca7e159aac68f539ab26c182f9563c9aee1a03c1dc3f22dac9b73e1e2",
      "text": "ali-ali",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bc37cc873b1165b80a06efaac7de3c24c0005bd71d6d92e8cb1280f21f1be80",
      "text": "kesohor",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f10315acda26d2c3926b88ff1f1318fe8233b2c9f067e277ae73ce212db7153",
      "text": "ꦗ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f48f6e1451206fd5a7d91a03b8ea4e7cf7003eb77407dfa2e4020a6bcb25ae9",
      "text": "Med, saiki kowe wis ngerti aksara pira?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "726b57afbdeee87ac59c387d5fb67659f9836e44cd3fab26ec8d361b8360ef27",
      "text": "ꦲꦤ (ana)",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "72bd2329be25ff47b11d4e9bdc5d0986acc493200b924082add4d5254a2c7964",
      "text": "Pak, kula badhe pesen kalung mawi jeneng kula ing aksara Jawa.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "75c04cfd1957e6e5c3abfd90711f9c98954fca93a336256183dfe1989e2e6cab",
      "text": "Leres. Pungkasanipun, perakipun dipungosok ngantos kinclong.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "79353997a57a89ae2436563d3036a09fa92e2adbc8b36e5bf00b1912d775fa33",
      "text": "cepuri",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c75ddb7e98d74384f04163473a3aebe482f007b660a811ed61e71c181b585a2",
      "text": "tliti",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7caa4f7055441917f707ecde7703615e786a260af1ed5436ebd564c32e4916ee",
      "text": "Pinten ragadipun?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cac9ddee1b354db421f72ab93cea915a4727c056d4e937022cd1fb67155cf7e",
      "text": "Sekedhik, Bu. Matur nuwun sanget!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "81ac61af4f589ba359ef2d2f79ade658d8c073a65ba2b66774bd76835f8e26f6",
      "text": "Jaka",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "83299f36f51880f4977ef282cac85a1e6cf730b983daf96d8bb90985d3a99965",
      "text": "ꦢꦤ",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "866a464298d0b7810ca9680959e7c504c565cc5ed3926e030d2b55a394985c30",
      "text": "ꦗꦏꦗꦒ (Jaka jaga.)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "86f99c9d5013f6556cef7fe10cef922a59f46bc95bd82e3bde9b4fd32ef76ad6",
      "text": "Nuwun sewu, Bu. Kacamata kula ical wonten peken.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "87475f2e80c8df3310ef5a53d71c93107612b23632003ddd4d0b5159a353cdb0",
      "text": "aksara",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "89064ecabc2846379234efe3a21d85875c5541e613a528693f8f974a7c1e811b",
      "text": "Matur nuwun, Pak. Menapa leres Kutha Gedhe menika ibukutha Mataram rumiyin?",
      "voice": "jv_dimas",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a3ef8e3e771df658ade1892a4260c28f1c18a3b26405c11e30993b6d05fb9d9",
      "text": "Kula sampun saged maos kalih dasa aksara, Pak.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8af737fa7639a7b94186d46a7f17594d0e347522bf41726b4259dd14d546b44f",
      "text": "Aji Saka menehi weling marang utusane.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cbc7a0669f052fb60f4c1f11cd19b1e7c98b72693fc38d87ca570b29b1fef85",
      "text": "palu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ce7dcfc771bba4ef8bb45556ad5057022284a73889b9768ef29a011a3fdb9a8",
      "text": "Kaya apa lan opo ing chat, ta?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d92ffdfeae6b392f37cc3dc66146d7a7b8a1999229e531c6e416a7ce32f147e",
      "text": "ꦱꦥꦩꦕ (Sapa maca?)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d96827ad68cb6783a054875cff45cdf561cfa6f5dc23b06131a9016caaab651",
      "text": "rasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ef18fac9d39a54462ef4c1d65df6ed8a7836d5b8c6d114ebfc7b3be7f2e30d4",
      "text": "ꦫꦏꦭꦫ (Raka lara.)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f626e20fd1322e1ce7f6736b22d3c68e092341deed8b15fecec559c25fce475",
      "text": "lara",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fc250322a19bdeb4eb176ee6fcbc51b083abeeea92c1c6c6270120365f7a3f7",
      "text": "Lho, wit wringin menika ageng sanget!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ffcc3d4e18481dbfa507750219303aa229e9bb58861ebdb35aeb371ef2580d0",
      "text": "ꦧ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "914bea1ec3318c7c3315cd470aefb01d57ea8fa67096c7eee99d8fc997b06a98",
      "text": "ꦔ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "92629098c456ffe7951143334be7a8b6217de864efd966024cec950b6caab921",
      "text": "ꦒ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "93f7256dea7c08c164ce3b117f81927c3d9c71241ccb97345245629aa7395eb3",
      "text": "Matur nuwun, Pak. Menapa menika tatah?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "953af758583899564d0f06ae5d54006ddf9b8df50e41382e628f32ffba97c918",
      "text": "ꦠ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "962b8f06249218d368ae8b4151fbc0dcb28247d35bf320a7cbca1c3246a144ff",
      "text": "Aku isa maca aksara Jawa.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "96ef156ea5cec16db7613aaed25381e7d12eaa0ac531e2a7a7b2539dd49865bf",
      "text": "Ali-ali iki kinclong banget.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a9d61258e5c2b695f07f842fe4fc37838b2087ff49869a180489993a8277aac",
      "text": "ꦔꦥ (ngapa)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b64db712afc919ffa51d5eb9e37f086337c11e6b9a0d3c436be8848e2ec1e30",
      "text": "Kula tumbas setunggal. Kula nggih saweg sinau.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bf4578c2cf4a42d7da5b2334f66b50a7551c700da78b9274a3e84b5bfbe10e0",
      "text": "Panembahan Senapati iku raja kesohor.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c4c46e10240dfe91028a27531d726c36bca04bb783c51cc862f5ffedbb1a27a",
      "text": "ꦢ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c7fdc4c62abc34374ed1de490d716be2c550518491e6842e24935170337e153",
      "text": "ꦫ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c8ae4f7020caabe92c7c13787bec13a5354c4f15f878c08932d545527c18f72",
      "text": "ꦥꦝꦗꦪꦚ (padha jayanya)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e0ec479a20634b57d3036d3eb505c2ca583867a503f4878ed278b378fd90882",
      "text": "ꦗꦒ (jaga)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f03bb4b5a9c6bad1a38eea3e640daf2ceb885939b720f7de9c02144e86adbf4",
      "text": "sumelang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fd886e13c168c691237f4d6a3d7b0e986ef9a0a1400e14f97285799131e5d15",
      "text": "Bener! Saiki kowe isa nulis apa lan sapa, lho.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0caedeac6ca1c965f4204fc67ee5dc5ef90e84e3dcc098c06d594b454e68e49",
      "text": "tatah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a13d245a955c12cd5bed53674af46e4b9ec1b7bb04b5d904108e64aff4de3012",
      "text": "Baris kapindho yaiku 'da ta sa wa la'.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a28c43ff3afda5a39ddbed9196b6fc5aad3e21379f950001b5b0adcabe1f551b",
      "text": "Tembok menika menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a35ccf3d131cf304d08b176f223a9b98546827aeb864a1b0ea85a995cbe27a45",
      "text": "Bener. Sing iki?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a43421afc26b3333727b8e4744fc2aa5b0ab1ad918398bc1077872c5b361dec3",
      "text": "Bener! Nanging aksara Jawa mung nulis apa.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f989ce90c53fb7b09e4928c319fd98a2a02cf094ce977dbd166c6277c2ddc6",
      "text": "Cendhelane kok cilik-cilik ta?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5e560e031a725e8e87e8c12584e5111b3f5de3b92a2058d968ef82552d27f3e",
      "text": "emper",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a62a9766d85d99b787cfa6a8c1f8b2418f56a3e66fa5b206574f4496be6d2c7f",
      "text": "Mangga pinarak, Mas Mohamed. Menika bengkel kula.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7dd8b377830104d13480fb0b09c12e14de090cc44d61f32a4b4d48ef54a0fb2",
      "text": "Dina Minggu aku mertamu menyang omahe Pak Slamet.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12e470a10dd2db0d1fc12ea8cf7f96b67147f80849acce2eb4eff1974970ce2",
      "text": "Ora ana kluputane, tulisane ___.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1f105d93b8d1802c47e560141b4c2be8ea3222dcec8f5082266a2618f5f1641",
      "text": "Mesthi. Mangke dados sampurna!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b21ec3319aa8d2e5f228b64d2d94e9621a3e29d466b3d670b7cdd14db3539e6a",
      "text": "Wah, sae sanget, Mas!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24b7ff71cc09b9610eed3408a19dc3040f056b57b08174a4590b9726d3e1723",
      "text": "Ing babad ana crita raja-raja Jawa.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7953a06742ec5e8b13777c1b4b61645bbcdb3f808b36631c8186d0ec6e94be2",
      "text": "kapindho",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba662be07b20cb468e4cd454d1fc9c6e127b744b7225ae512472bf6ee226bab6",
      "text": "Kalung jeneng nganggo aksara Jawa saiki laris.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd206097e1bdcea87894f7273327a0569633bb64b579cabd5579b458f4672a3a",
      "text": "Wonten kacamata ing mriki, Mas. Menika?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "be3b9ae8f7fd4e71935fa6def95a7feffa612df9a5bc2212b059c82f5cb37b26",
      "text": "mata",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfe070f75f15e69a6c4fd2a4952a895410039a5c0e101d8f64689877a9f11c06",
      "text": "panembahan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0d2926babeabee1199a52e9538de295ab6bfe1a092c8c360225baa6a7b5bfc4",
      "text": "Aku mbayar panjer separo dhisik.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c221f8dc7db4d66bc71630a20af24350e0a543aa3aeb366bdb55107c1f2afd49",
      "text": "tandhing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2edfbd9569d70b05da7349b14f84e0c4ce00594291d2ee9bc2680e069da80da",
      "text": "Tulisane wis jumbuh karo jenengmu. Sampurna!",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3184619a15d4d1d5a499db73543ffad867df7b02c9431b3a4dc5de6ff74226f",
      "text": "Bapak ndandani payon, aku ayem.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c31dff7152dd161b84d8c6f00bb28c3ce85efb0a1c7f64d63a5b4da3dae48328",
      "text": "Pagere tembok, cendhelane cilik-cilik.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3221a0279d8ac5599232066abcac7193e0af6964c98fdf551aead0a78df7fa2",
      "text": "Iya, rasa. Ra lan sa.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c38a8e0754283002171a972ff6938ce6b535f8c8bfc6002fc89782d66292d0f6",
      "text": "Sapa maca?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c50052aac763c0c71a99ef33c5aec00967c64200174f44158d9ced23b3182e15",
      "text": "ꦲꦤꦏꦕꦩꦠ (Ana kacamata.)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7d9531c276f761d1650fc5720ba3896c2428e35a757a15bced4ce0b9148cb1d",
      "text": "ꦕ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "c98ce0cb4221633003feb4853feb84ed63651288836f80c2bed57c0d6dc00654",
      "text": "Mas, tembung iki diwaca rasa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca53529564e4855cea06a2157290c6d81f4eeacd8e8bd61ac3d236a0de45b0fe",
      "text": "Menika benteng cepuri. Rumiyin wonten jagangipun.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "cab3957997d89f148c6f839df40fff047a91f275d091b52467d59b98a1eeb276",
      "text": "maca",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb98e0db139c709afd15687fa575e9916ba4c00e9fdd5981544c453c030a267f",
      "text": "cendhela",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccbf204aaaef4a1dfc9235c4b389498317f53240f45b84838d63ca984264c3dc",
      "text": "ꦩꦕ (maca)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd35b140c80018be65f1cfa9c78c3ae5f66cd700425a9f269da3e6706a6e6d1f",
      "text": "Dudu. Iku dha, kaya ing dhadha.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd9ef272454df9e0e3cecf35d5ef1d3d4f1ebddacf417927dcc74ea44236a93c",
      "text": "Omahe dadi adhem. Ayo mertamu sik, sing duwe omah apikan kok.",
      "voice": "jv_dimas",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfe3d1a37ebacaf42df8b90f98abf6bce4aa8058e5c4f6ec8dbef63e492d4bc4",
      "text": "katelu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0dbbcf0925f30515e1140533c4c002fcac0d82b0627fdcb316e810d316f14af",
      "text": "Hana caraka, data sawala, padha jayanya.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d13d46c5ac74f90874755c0a38587b109969023afb28ce1e7839cb191e8beaeb",
      "text": "Sae sanget, Pak. Wonten aksara Jawanipun!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ed7009d4461da116f96ee5499bf91a13a6731842f0148ccddb249ef612eed5",
      "text": "Hana caraka, data sawala, padha jayanya, maga bathanga.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d28f388341bd45cb1dddc65640e2148bf22e7e6bb1c0aaedab7a5ddfa941c827",
      "text": "Jaka jaga. Maya maca. Raka lara.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d31a9cb0b6b8fa35ec649a3487310ca72a95311c16de563e9ea69e986935cbd1",
      "text": "Ukirane alus banget. Pengrajine ___.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d34295d4057bf139f3e61d613db16e25eb56924cbb73037e5a7d49887301f543",
      "text": "ꦩꦪ · ꦗꦏ",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5a37bfee7db0d4b876d901ce4e4d6f09bfc0162ac335db89ae45e8b115d08c2",
      "text": "sabanjure",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5ab369194199519ed0209440f87b0e216933a5e8f212d409b6d8c6eac3905e3",
      "text": "ꦗꦮ (Jawa)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9032f46daaa4be19fcbc39165d120d1abce3293b7fed499ae07f8fee82ac259",
      "text": "Mas, aksara iki apa? Da?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d90f00f6a08c988ff181f7d7b83cad1acd103dfb353e2c529ed2efea49e65a44",
      "text": "ꦝ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "d930efc26113eca18a1bae1d4d328dd84522a3122b2dd05de269de62bc52d443",
      "text": "Aku pengin ali-ali sing kinclong.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e01d80994ee1f507651f81bc8967137406d268b7012f56b79dec4c91297af3",
      "text": "Sawise payone didandani, atiku ___.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "da14ba29429874d1db2a07a7a490f9bd36ebf105b3bc2cdb2df921fe0d762946",
      "text": "Lha iki? Lara?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "db0d792d1e9b2cb871783dceaa168a6a1636855ea61f181f9128e32518e588c4",
      "text": "ꦲꦤꦲꦥ (Ana apa?)",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd6fca183ae1d1d9d348da44f1b94fa70e28072d42886dc4406e3f023896feae",
      "text": "Kutha Gedhe iku kutha kesohor, ibukutha Mataram biyen.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "defffd15a50888e676c2b6759d4ff4ec3b42220ceb70a6042267f986b38404dc",
      "text": "ꦱꦏ (saka)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfeba23c3a878ec638c16832ca3ac94d0e6d526aea4ce90b4bf6dbd64bd560fa",
      "text": "Jaka jaga.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0275b832043567cb0229d6940c906998cb94dd2efa4c6fb6dc22e9bab4f0eb5",
      "text": "Wah, apik tenan! Coba wacanen iki.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f540dfd494ab8883b90e1cbfc05821f82c25361cffbf43fe96223aaa70a88a",
      "text": "ꦩꦪꦩꦕ (Maya maca.)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "e128ca7cffaf05f33b994ddbf1a2c8dcf5ea1cfd2cc5ea00960e47fcbf763ca5",
      "text": "Apik! Aksara iki diwaca ka lho, dudu k.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2bf957341e94a21f7d6b3b3ae4fb87bfc1183d530cde83cd1d799950ef80930",
      "text": "ꦏꦕꦩꦠꦱꦥ (Kacamata sapa?)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e364ae95785183756daa1b954b8812cc1d3d424d5d0021dd6ca03a82bdb7c726",
      "text": "Kaya huruf Arab nganggo fathah!",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56d360c57adead6d4e6669cd4d71f1aae627e1bdf230eb3755831d79b89c7a2",
      "text": "ꦮ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6439d48b673f392d812678ffc9a1222d583132753162b3bef91e4e195714167",
      "text": "ayem",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e64c2a636f27815d9065b2f499c38eb5fa21cd98903a8b2de2dd71e979a1f157",
      "text": "panjer",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e88ffbeca7812503f59dd4d355b0584cd1ff6d4455ebb3d404ae092202bac54a",
      "text": "Sugeng rawuh ing Kutha Gedhe, Mas.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e960af07bf1b235156c06ecfac05d2139ff39288980f20c12790e0498040c0f1",
      "text": "ꦲꦤꦕꦫꦏ (hana caraka)",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "e96673a2d63d0397f952bc9a92c9e995a75dfca2ca86f1fe3a567ae26f52f2c3",
      "text": "Med, ing papan tulis ana jeneng-jeneng. Coba wacanen.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9be1a1063a63235195bd5b4eeb27575309da52b8e4953fbe04e0a60f6902b5b",
      "text": "Ma, ta... mata!",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea6a85095a147c7bc2af21de7b33cd6ecd2aec22b4d8b56de3c7f2871fbc2b62",
      "text": "Sae, Mas. Kalung jeneng menika saweg laris.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed57eb3c4230e42546b905a11394f9075f7e5c08da2116c0d256fdfafa756a23",
      "text": "ꦱꦥ (sapa)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "efda17f93850f15fcc41e7665f425c726bbeafc1cf6f0853703904991a250892",
      "text": "jumbuh",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3bfa0781c1ea72bc019538124d3288aaa049d9dc5fea642998aa3e3f65ceb33",
      "text": "wringin",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6f26eab839b4b96331a54bb83b36dc7b45e99b476872a088a2f61326c1759fb",
      "text": "ꦩ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa976a6da9222949962ffd6d29ca2a3545687340882f0e99c475654867cded45",
      "text": "ꦩꦕꦲꦥ (Maca apa?)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "fac70a070e07840c6c1a3a8940e9ed4fe8a76d1cde07234ef770d0dbaf94aaa2",
      "text": "pengrajin",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fac8e978e4fd3e0f7bdb1a98761db2cd11aedc99d6458a78929c0be500e376ac",
      "text": "Ukiranipun alus sanget. Pengrajin kedah tliti, nggih?",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
