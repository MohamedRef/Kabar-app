      "id": "j4.u04.l04",
      "sha256": "1ab65cca7407312aea062b3eb3f7e156ae6568bfc149408dd5f7ce0521affd2a"
    },
    {
      "id": "j4.u04.l05",
      "sha256": "eda6beaf73252f0f7ca4967fa48fda534fc20d38675829eb20e2715c44d3b863"
    },
    {
      "id": "j4.u04.l06",
      "sha256": "156011f8ff8f3de614ec292a1375f69e0226a9e6957e8d3596d2c1c1832223c4"
    },
    {
      "id": "j4.u04.l07",
      "sha256": "94ad4940a69b3bc69cd889477c74864176fecfb74ea08afa6efab1890aa479ed"
    },
    {
      "id": "j4.u04.l08",
      "sha256": "593ed1166061fcbb065bc5b3bbe29f9ede880eace43903e8d118d134ce990385"
    },
    {
      "id": "j4.u04.l09",
      "sha256": "04e9034aacfed1e5b2207590406f3a71ce8749abfc2adca3ef794b4c54798f75"
    },
    {
      "id": "j4.u04.l10",
      "sha256": "f832e4f1b19b5a67d845d1845770268d0f495868dac28358571c6cfc0b3a4a02"
    },
    {
      "id": "j4.u04.l11",
      "sha256": "e620c01cb26fdaec18ce06272bc36d7a91c75a87febd53a8fbcd8af83026c4c4"
    }
  ],
  "audio": [
    {
      "key": "005b2bce0335348607079d2c8b2d73eb7c7ea47ee50cbccf69dd816d3e154c28",
      "text": "Wah, sae sanget, Bu! Menika rumiyin kagem sinten?",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "02757e83090c559e463b1ea297de2c610fd308f9aefc64418634162cb833c3d1",
      "text": "ngalah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a67c7859f4d0c668a63e2108ae269d817d35e06c955ff5a1ccaab15d95c870d",
      "text": "kurang ajar",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e2d7fe1c9098e18e5007d4a09cf6779450f7d85a90c6b0ff1afb2b02f328073",
      "text": "sila",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fd1ce92381a2807696ada92302e0b7188a8aa9318c5470acbf3205175adf5b9",
      "text": "kasar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "110349bab3191a49def2b44264f87668fffb707dafb7ac036a95866009b02ed7",
      "text": "luhur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "13a793edaf7ba43bb4eccc8a5beed8339e179f83625f9930262e0b0140d469ba",
      "text": "Mohamed, wingi ana turis ing Taman Sari. Dheweke kasar banget.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "13bad71062ec674eba87fbe34ddaa2d46d5a0e8717eef70e1f6fbc84f1709b59",
      "text": "Kula sungkan matur dhateng Bapak.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "13bd396b6a78a788a58df1eff8ea1564d01bf7b202fe7ac6cf98dd21ea42e712",
      "text": "Iya! Lan aku nyuwun pamit jam pitu.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "13f9a042575071a26c8097e613d3cfdcae306333d49117febce65d60dfe5f0bc",
      "text": "Sampun cekap, Bu. Matur nuwun sanget.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "144d067957f636bb65a7f272af972ac91ec1e359d19471658c92bc5c809298a9",
      "text": "mangkel",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b1080d9bdf2c54ea90604f4b770224a12c66b83af427c94afa6f2e6f3ecbef",
      "text": "Nyuwun pangapunten, kula mboten ngertos.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "16593181ffb6943a6ad36eedca4769942a58374c99077049b459559a8e72a741",
      "text": "tepa slira",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1747c094eb9d31a5dd3fc018f9f818d7a9aee0a7e7c4ba8e4438ed5dd3796b78",
      "text": "Kula nyuwun pamit jam pitu. Bu Ningsih ngendika, «Ngatos-atos.»",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "18caa29d35adcbeca1d712d5d7d2d429d5eb631624f475768da24aac3a5896a9",
      "text": "Mas Dimas ngalah, ora padu karo adhine.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "18f50134c561ce59c80a8522591ab0675c2114b366973860b2b72e2054d777b4",
      "text": "ndhingkluk",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "19346acca3e286f0a30084589863989b7f1c47da6e26faf659d542ce7fc0ce1b",
      "text": "Wah, abdi dalem mangkel, ta?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1992b4d15165d726ea5947b91f1a7573638a9c5bd80fe5c0ef007f0aa54d90f4",
      "text": "Basa krama kagem ___ dhateng tiyang sepuh.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cc54c549d276855dfbf46a0c9d5d02e2b57fbce970188b112fda0b583806505",
      "text": "Kula nyuwun pamit rumiyin. Matur nuwun sanget, Bu.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "208c861bd937a19ade8f670d9e47c5ec9b290facf1ada0d824460652a0d7dd75",
      "text": "Pangestunipun, sae, Bu.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2126b351d12008b2c884b209d9ba67ad7c43d89f0bac1d9c747c57c79192f629",
      "text": "Sampun cekap, matur nuwun.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2756883d5410ac23dfb6bb2ac950c5573122374d6ea7ff8b41f90197b1169fa7",
      "text": "saru",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "278608d9b2cacfd34b705d6d46d55962bf1ed8f40b99846d37cad02f985639bf",
      "text": "Mas Dimas alus banget yen ngomong karo Simbah.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "279cb67a90907865be9ddafc62f127a02013d5592fd3eeacb384b6bdccf594f4",
      "text": "Turis iku kasar, ora sopan.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "28b7f77d2ac0d3db404b259c9cbc1f827db2865986804f08f05077e3c5bd6742",
      "text": "Mohamed ___ Simbah: matur nganggo krama.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "298bf10dfc7444f06439de41fb1146e77509fe280b9bee53b6e2ecb138246562",
      "text": "Sugeng rawuh, Mas. Saking pundi?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a271ce6b0ed65e9555dcc44ea549248d1d9299a12b66e70193bd35610e3b57b",
      "text": "Mbungkuk sithik, terus matur «nuwun sewu».",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b7c35e45592a46007b459ab16e3692d1f1098deff79d05518e9199060d8510a",
      "text": "pinarak",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d7184a9a23ae5bbe3bb4963bab28f1c3b0b474fa6945a309db4b6a815b55966",
      "text": "watak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d859ebd1f059e18c28d4c82e75c11a3630473df0d97b5d7a2b469c7979df06d",
      "text": "Mangga, mangga pinarak, Mas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd50ad8a1e1b7ea83fe8afdbbc94e89448d2f97ba42ea38dc72728131a632f6",
      "text": "Iya, Mas. Yen liwat ing ngarepe Simbah?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ff9271584941a111f489f08415833a2f13ebb54aeb490ae331296bc8b4c9815",
      "text": "Sami-sami, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "30facff2c9698dd5f74b02d41c2fee2891003803a49d3f1b391e73a65de0c56b",
      "text": "Matur nuwun sanget, Bu. Tehipun sae sanget.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "31a7a2e321df1003bd2f384d966cd21821aa55ebd4bc8e65b414119581ffd5a7",
      "text": "Kula nuwun! — Mangga!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "32807ddf520ddadbdaeeeadb66b7cc5e669ccf6f5a2fd0de9aef1877157a9ad8",
      "text": "Pak Harsono andhap asor sanget.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "34323e728453daaf8ae556abd7d39c951322ad23e18c07da3548a02e1f12d5d0",
      "text": "Piye, wingi sowan Bu Ningsih?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "375b8831fd20d6fd7aaa7c2280b79d1541a6c268f833b4a4cb1548e9dae4f7a1",
      "text": "Yen nuding, nganggo jempol.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "378c61d3d0f5a5cab562c5963adf1d8b146ed9c1d7ad2c82400df909a539ecdf",
      "text": "Sae, Mas. Unggah-ungguh sampeyan sae sanget.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3da3a057475686682806bc41990fdf9502acd6baf3e4a2f6cf56ff809a6ecfa9",
      "text": "Kula ngajeni tiyang sepuh.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "402afc7355f521d4259d3a6ed9e9366cec0fd12925d7adf1bdf1787a4a06a1de",
      "text": "Budinipun luhur, watakipun andhap asor.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "426044b0b2183701904aa7cac02e767fa39512db67478710e6a37606bb637fad",
      "text": "Mohamed mbungkuk yen liwat ing ngarepe Simbah.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "426e551d9a14314d59a61ae77526c0163c34460a78ad8e8a67a9ea90f4ced700",
      "text": "ora ilok",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "436e3c3b070031582622c40e959855b10dd84a5c0967cc921caf292e25cdf7d2",
      "text": "Turis iku lancang, Simbah mangkel.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bc8917bd10aa61b0ee3ec6b85676cc7c5cf88476a60b8c82f152489120f04d4",
      "text": "Mangga, Mas, mangga.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eda68d058ee7d728405dafe1a7dd1176c50d8eeffa9b0f0a2b70bfafa594a1e",
      "text": "Iya. Simbah ngendika: urip iku kudu tepa slira.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "50b137c669f2f910bd53ff49d57f7f7682c67df8a8c0f95ac69c1937476c9c97",
      "text": "Waduh! Ora ilok, Mohamed. Nganggo jempol wae.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5381b89555b2609444c16067adc6226620a0bc1db6556b0d726be2c13f68e9fa",
      "text": "Mangga pinarak, Mas.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5680067caa27af8d73d37d73f76797622d8b8768f7293b44662aa9967684199a",
      "text": "ngajeni",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "57eba9d9f0b02832983327f8f56dc0e70e60a3af607b69bc3ef93c8587b6d9d3",
      "text": "Nuwun sewu, ndherek langkung.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "580a655b49c8712c90da6a3221677606702ecab8d24cb45fccf22e6d99a9d50c",
      "text": "Aku isih sungkan matur karo Pak Harsono.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "594681da9f8398e8d19d8483c3b9eedb178c7d84868e546d10b684d3ca91fa2d",
      "text": "Aja kurang ajar karo wong tuwa!",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c4b5654f85cedd038ff81c7034c130612192c1716c62d7e940963234e0fd0b3",
      "text": "kiwa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d2e77f6134ecc62a9c3408d6e4e140c3e586b25b66049e1cdc8a0e5c147048a",
      "text": "Ora. Abdi dalem isih alus lan sopan.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ed59f56abe7970e897cd6ce1b42d46e5ff42b1caa096de3cf1a1f4e40520c17",
      "text": "Kasar piye, Mas?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "6352bf43a14ba51c9c64426db7b44bda385b8695547278877630739414a9492b",
      "text": "Yen wis teka, ngomong «Kula nuwun!»",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "66c805325a2bbb5f434a96c4fd6c3fe4e34ecb940b742ceaceb88ec49548610a",
      "text": "Salaman ngangge tangan tengen.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "68dbac3d39d197e0503330d81946e7f501b0dbe745df450be3eb4e11a46e67ef",
      "text": "Inggih, Mas. Ngatos-atos.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a1d46b9a0c38acb036f36923ba57e51df7b814e700f2a0ce92fda8af3fa99cf",
      "text": "Simbah seneng wong sing tepa slira.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b547912154939e1b2e0d94622a7d9926217a1de96323bc332f57d1d11d2ce1a",
      "text": "Lajeng Bu Ningsih damel teh.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b7eaa8f0020ea3b3d194d18f1802acb02c945c8e10a37ba3f54def828ff1817",
      "text": "salaman",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e17c6d62315fb43267354913ded1250676653d6b1f2d02b1c1760a43dc80b5e",
      "text": "Kula nuwun!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "70e103a17c4555c44ab13e359c05365b0defeeee752eb75733e35a3b06f1d242",
      "text": "Sampun ngangge tangan kiwa.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "760493a755ee71682996ae8effe8977fcee3f1b6d5dfa7774d44e348074300b6",
      "text": "Ing Mesir uga padha. Watake luhur tenan.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "761751068ff21d959f82f8ab00261f8aec63e2a3fec8bf3d3ad7caa7b9332f80",
      "text": "Mangga, Mas, mangga.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7809dd6fdd33af13d0b1dcc8b9edf7475e28de99a3b6e84d9fc842bb97b34708",
      "text": "Pripun kabaripun? — Pangestunipun, sae.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7910adfab1229bbc5dfb28c4c121b08e20780f017226f1c8a0a5fc419b554864",
      "text": "Kula ngajeni Pak Harsono.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "79c1ec7566c23ebc4bb541932035ea4e4a90793fa224aab3c665290389d0ad90",
      "text": "Salaman nganggo tangan tengen, aja tangan kiwa.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a89579214d48bc4c23c599c60365344aecc21dc7ed3c6d183c13c78a6cd71af",
      "text": "Saking Mesir, Pak.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e09876a1fa819d6f0082c5a981d7a66ffb74849a9d46bdded22f41a2de5659f",
      "text": "Ora ilok nuding wong tuwa.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ee5a056cf2f94ac7255f933947977da8eb93e1c016591d72535c382efe54a76",
      "text": "Apik, Mas. Bu Ningsih nggawe teh.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "809d9b37b3c4cde4e22ce8d39ec1a86db0234ae834b91c4f5919cc55aa92de6b",
      "text": "Apik tenan, Mohamed!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "824ff5c57602a73b5ddcee4a5ef9ee7190ca9231dd4fe95293ebc7b358f52c95",
      "text": "Nyuwun pangapunten, Pak.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "82bbbd358895c308c3301f5312830c5281dcf425e42024b778a4e6f8d1a68a36",
      "text": "ngurmati",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e1d00dd6880cd77b5117a151a66b02ce66e9de3db84b5be5392768f0594cf8",
      "text": "Sugeng rawuh wonten Taman Sari, Bapak lan Ibu.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "86dac0aa1926cc3ae8e65a7b1768e0feaf71ab2e252272d1dff70495ef80903c",
      "text": "Mas, menika Taman Sari.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "89a55dbd70dd7599b1025e3501d28a35f93eb4846b1e80673d0640c551e514be",
      "text": "Sugeng tindak, Bu. Ngatos-atos.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ace8b2f6b3a2a9f379b6fa384a878b3fe9a6275836b0a1a50464bce6969ae21",
      "text": "Wah, tebih sanget! Mangga, mlampah nengen.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b5d5827a8da7e834d92dec0bfb75b3e1d6436aff8e78e5e0573fd412318cb1d",
      "text": "Lan yen lungguh ing pendhapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ccef56555e2296d3bd48e60eefa9692d4376a378706371d512ed0dee1d4d82c",
      "text": "Apik, Mohamed! Kowe wis ngerti unggah-ungguh.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d5a5442aceb6de3f2c6adc9bc2f401d50f8ab5fc526f69f5b11723c1faa02ad",
      "text": "andhap asor",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9394dc15e3efbf1a27640f1da32314bb2caa58c31b027984aeae8f024c49314f",
      "text": "Bocah iku nyeluk Simbah «kowe». Iku ___.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "93a0f2d009d7701b6e63f9fed99e489ae9ce1b83fd11e7e8893bff40a85666ce",
      "text": "Apik! Yen mulih, ngomong «Kula nyuwun pamit rumiyin».",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "959b0accf73d73abeac48775430ade725c4b048f1d1c698f3efdb3e89fe90b02",
      "text": "Apik tenan. Aku uga arep ngajeni wong kaya ngono.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "95dbb8caaeea459ca4dc7a9963e2db041fa8c83e7404955cbfa622eb426337be",
      "text": "Dheweke bengok-bengok karo abdi dalem. Lancang tenan.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "96c58a476d0b0feab4cef6ab21116da499dc1777e89ee78153027840a88eccab",
      "text": "Sila, kaya ing masjid.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "98fccadeeacfb0a213dba89bf7610f9b89e6b467d589a6d36911876f5dd7d955",
      "text": "Yen Bu Ningsih nggawe teh, ngomong «Sampun repot-repot, Bu.»",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "99b95860ce06ba652d1afedf7aa8a865f562bfbb3a12abde9d17c027cb0152a5",
      "text": "Pak Harsono andhap asor, watakipun luhur.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cc99a38547d5d433ee7f1ffd24a765b892f82df7750c946ebf5762fd210293d",
      "text": "cekap",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d782df795bcb2f4d757863a4ea6a6a91ff180b051b8d6a11c3594925ebd9525",
      "text": "Kagem Sultan lan garwanipun, Mas.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a08f2dace8e2f91bdd7f3035948304cdf9263bdddbfa8a562880ff1c89b3657d",
      "text": "Pak Harsono andhap asor. Dheweke luwih seneng ngalah.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a29e9d33301fc49e38516859ed56d83b954b5951b297f1650148245545bbdc05",
      "text": "pakurmatan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a53bef4b136626ffae981865321f72af6b623e6d0580828d33134f86d98d301e",
      "text": "sungkan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a61a1c84b5788db9ad8311c316bcb87bee062048ea81140c96eb8513ed0ba260",
      "text": "Kula nuwun, Bu!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a62332e6a2ee7f5b27d943275249080d5c5cb735a7e5ac57290a93a234608c3a",
      "text": "Ngatos-atos, Mas.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9423fae8c5600bc8662f73c79ff9ee42b015cf3bd0f036dc22e163cb2f3edc3",
      "text": "Mas, wingi aku nuding Simbah nganggo driji.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1a756ffbc1a15cbe5972b44f5d132b879ca3f68e8b9bb6590b99e31be4e7c9",
      "text": "Kowe ngomong «Sampun repot-repot»?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa348752fc015623c4f7c0e380413b32b1f50f5153311c178e0e13a426723e9e",
      "text": "Mas, kula damelaken teh rumiyin.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa6b8d0b85d53ce50cc60475695f8e0a884b41290c3cf6d936dbb4b669e32548",
      "text": "Pak Harsono ora nesu. ___ Pak Harsono sae sanget.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad4d3961b6c7a5073379178fa529382e4155d09b9b0d3cf1c403af28a59462f0",
      "text": "mbungkuk",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "aeb3248673446252260841f8e269884c4a3a7458a69e2f11426e0b7989466ebd",
      "text": "Wong Jawa seneng ngasoraken dhiri.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "af276bdf311350880eb8c29307835cb9a5e3b4cb4c73bd79ee95a9e24f779225",
      "text": "Pangestunipun, sae, Bu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3cc7dbc3d18e36b876feb497bf1d6525b32092ff14c6d52f92ff7dd86a5458c",
      "text": "sopan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4d302c67013e262465f6201548300a1aa4fb90f54332b053952b737222ea7c9",
      "text": "Bener! Aja tangan kiwa.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5c270ba339e3405c19353400648e909985c337044c6cec64f8d6cbdfc440788",
      "text": "nyuwun pangapunten",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2357120b1f85ad19e7751e51584220fa36890a92e8b7bff9e5a302f9f64ddf",
      "text": "Matur nuwun sanget, Bu. Kula nyuwun pamit rumiyin.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb2bedb474fb974f4222f300b20f0cfdf33f07c5ee8f904a01795108fdda576d",
      "text": "Mohamed ___ yen liwat ing ngarepe Simbah.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc08f13531d9d6dc90dd6666ee0e32c61bf06a3cc43a07d0b3f25b3829265189",
      "text": "tengen",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd0de61b4ce4a243c4b9c9bad0d06f0b112101c3dbe9e3d36038168a73b08c68",
      "text": "ngatos-atos",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd9aeaa3d785ffcec6a8c76dea85a7c447db138e0c77d690135f4c7a8f3aec99",
      "text": "ngapunten",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c03f4f6779dea734c45da8e00da70b9c7d2a1ab25e22e8ab8f84b7dc28da4d0b",
      "text": "Iya, Mas. Suwun!",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3941ee46fd258a82e588c7d255619de0ce7b7ea4a2308acbf754a90adf4a708",
      "text": "Sampun repot-repot, Bu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c426777a6b22f2614d1dda756a2a4389d11e20631cf2f9d80c9dec00835ca2c1",
      "text": "Sampun repot-repot, Bu.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5006d973680c1855453e24db757c24bf0bace912f8c1487836059b415bf8687",
      "text": "Nuwun sewu, Bu, ndherek langkung.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6155a9ad182643070269ec3e0fb148f56d9e6c9c122a8599015dfe4aa5d76e1",
      "text": "Simbah ora sugih, ning tansah ___.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8a75889ad306ab3e664cb6bb05d341a4b3f4a31c9dc61a2a5b63c667946d1c6",
      "text": "Mas, suwun pesene!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c94754f22fa2768717ad80735eeec79e78ae4fdbbc059adb09d80229aa4ab351",
      "text": "Kula nuwun! — Mangga, mangga pinarak.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbf88d1fc7bf9ad09670aad663182558e15d577c7e025a8649c06e799874d97c",
      "text": "alus",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce6310d7477ba32e75b9007b73fec81894a124d6e50f8d2574f1dd58ad9ac2ea",
      "text": "ngasoraken",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d07faba150ff41abd7e909de1bb6f353a0d00709a5776fd7805f41cdbccf7854",
      "text": "Mangga! Oh, Mas Mohamed. Mangga pinarak.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2a253ce337f2dd33f99c4b4442aa688ce1d4825ee83e8f8eb1ab662b17b2b73",
      "text": "Pripun kabaripun, Mas?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d310d512de7443da46fe8456515fe75693d29ba2c7a2c6c171974d1f7f6a1d07",
      "text": "Mangga, Mas. Mangga pinarak.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d490df25128db46422386e00c95f963672142622fb0887ec5379c2c2b2e0aec1",
      "text": "lancang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d496092533e8118e932fabd77721efa8d1f9ad16913f3a8734b46749b3f61d5d",
      "text": "Ngapunten, kula mboten ngertos.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbda9467f1e5f21cfa8af65fd00176d543514bd0e513c692831f7c3be095216c",
      "text": "Taman Sari menika rumiyin kagem Sultan lan garwanipun.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0dba5a7d6b44a8bc73cb611178c3384e4e99444283bc8733024493823221a7a",
      "text": "Iya, Mas. Salaman uga nganggo tangan tengen, ta?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1c0267805d18cfa5b5bfefb62a666cf57f4c8df284e79cd28fd78b6269a491f",
      "text": "Klambi iku saru, ora ilok.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2151eaa03f6a908119136d1fe3617dba0e9f7e212a30bf18f609c2736c8a81d",
      "text": "Mangga mlampah nengen. Ngatos-atos.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26b71946bdd38dc928546d6b2cfac848db91c63882465887c3223b606a6537b",
      "text": "Padha-padha. Wis ngerti?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3b264300bde34d8c8e8ac74ecd561790b7f0b92e6bda18b1860ed8f0ff2b538",
      "text": "Pak Sastro ___ dhiri, ora sombong.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e568f6760dc2124e21bf71e56680d77d7cbcaf30de0646d473237a0b77221bfc",
      "text": "kula nuwun",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6175c3bb086e4c480e2f13b8d7b82b3371e8418f02a8a006a84cc5b3aea85fc",
      "text": "Mangga pinarak, Mbah.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7573e4f65d44bf4a9c2a4341c03f6b6a9561d56b559bbeb68e04459d086151e",
      "text": "Ora apa-apa. Dheweke ngerti kok.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e83121780a1a2d0fc8c8ef814192996df874c7c512d3e97988121f5fdcee0e60",
      "text": "Mas, ngapa Pak Harsono ora nesu? Wong iku lancang.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea07666f7c8aa27608118091de49082f989ba2b93c01f43fef7af86f8f2629e6",
      "text": "Nuwun sewu, Bu, ndherek langkung.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea338d54ae448569b76b61682f866cb17a6b15ce812b43e60ec9bcd3eb2c1e4c",
      "text": "Nuwun sewu, ndherek langkung.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb7ce76e66e471779d6fdae44bdd72d81181f311254795cb59b2329070bef337",
      "text": "nuding",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc0870afa20c1a99fcc30b7283aca7f17b12b90b9a91f5ba14848dd95366b9e",
      "text": "Kula damelaken teh rumiyin.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef1511132d2abce5fab4b2dbdaa32f32c5b15d320c9dedb6c41878110ff978f0",
      "text": "Sae, Mas! Ngatos-atos.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f08e8bd0a5a69f1de309ea2c15f73d81ce2e9335fc6827775eefb1195a368180",
      "text": "ndherek langkung",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1b7e1428bbfe4ff4965f7581c992629cfb0ed42d75fea4d511b916abce9f913",
      "text": "jempol",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f249bfcb9bc03edb025319f0dd982319d07821bc54d607a832356a251b8e2a20",
      "text": "nrima",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f759d9efd9fefe3fc46af18c2f4f8ed9472b26a97a3276477fc6d414f57e2cc3",
      "text": "Sonten kula sowan dhateng dalemipun Bu Ningsih. Kula matur, «Kula nuwun!»",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7cd2a49c3210bb3eb09bcc45f3eadafb084e9551339e78c00149cd51de93531",
      "text": "Bu Ningsih ngendika, «Mangga pinarak, Mas.» Lajeng Bu Ningsih damel teh.",
      "voice": "jv_siti",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
