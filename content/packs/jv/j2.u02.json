      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "abac030db20433fafd168d71c48063c7b21991b436d21b2be2a7403790cd08d4",
      "text": "Matur nuwun, Bu, aku wis wareg.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "afeb6b6e3337ce2baa6df1b5db727882377c6445c93c0dbe9d52deb1e8b5c3ef",
      "text": "Mangan kene apa dibungkus, regane padha.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5651bda8856ba695f261015a848877b2e600e7b1466595c293c52d17a91af01",
