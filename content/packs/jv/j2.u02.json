    },
    {
      "key": "e0761edf5e5f9b00bc535e1f297018eca7527ff1be841a60e8346266b2dc5526",
      "text": "Kabeh telung puluh ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e13c04f10f58c67cca2ec966bd0c8fb4b856b7f50ef074d9067b895eb902285a",
