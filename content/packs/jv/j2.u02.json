    }
  ],
  "audio": [
    {
      "key": "0452066cc6fd72b8e058131bc60ac050c15466adc37920efbe8409827677e359",
      "text": "legi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "067f5a4d9075e21290bea11dbc07c25caea4ccc3310f5b1d3ddc6eda76865b5c",
      "text": "sithik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "083b265784158d4ffff448f694bee10fbac5dfc59ad595d40b78558481f26569",
      "text": "Gula rasané …",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "0932857b3aae874bddf2f0e1802e8aa0010f290e7928ddf1de0f3f28dead7743",
      "text": "Mohamed, kowé lagi ngapa?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a5d3601027fd09195d384c4b185613d2ceacedf106f97e6b9970ba5e85831ee",
      "text": "Piyé, Mas? Pecelé enak ora?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ba51ba14242da964fbec4d03f9b249acf2392604925544b70743d5959bd2646",
      "text": "asin",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e3a050af9934fc2c9e183c64ecbde25e8c576ec1b08b82c42478e7883cfca74",
      "text": "mikir (pikir)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "108719fe84fc1160cc9a7b145519c1b6fc94114f44db3d63927cfa1a9ec0adb5",
      "text": "Aku lagi ngirim layang.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1210e090a1b03724e0b8bddff92ec27445dd5cf2fd0d457775a3d613933fb67e",
      "text": "N- + tulis → ?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b5d7ddb54a87581e685ad9a519e3ccb9c0607eb7ab5c050abcef4c2834764a8",
      "text": "Wah, apik! Mangan kéné apa dibungkus?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba83835523baf99c108ba8de0f29bf6aa8700e928108058fbd98dbf4a70ac44",
      "text": "Sega pecel siji, nganggo endhog, Bu.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1de66150b9461dd44a30eb20ac1eeffe8752c67c6cb8d84e3b078cf41730f2c0",
      "text": "tenan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2152f16d450aee7ef4b13be2f2b2842e55c7fb3e9aaee0b2037ec6490b2d30f1",
      "text": "Aku banyu putih wae, Bu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2219b945eaf4a9c47b3e49ba3b27a4cca892ce1465336e0e421eb494d8ea9d8c",
      "text": "Layangé wis tak tulis.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "27b1b6649f37c20cc0e212208b23c584a628c1a03123fc0bbbce2d70027f5c7a",
      "text": "Kabèh telung puluh ewu, Mas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc3fc1835fea460ff87652b0606a8f75e8938bd4c2293bc3aa8be7e0eef75c4",
      "text": "nulis (tulis)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc6eeec955b247d8f1db2f6a6e5d3e62788093ae64316effd6ca5d48a814b00",
      "text": "Sega pecel siji, nganggo endhog.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "33a5b498f4b300d3e1044465dcfa413b242a4be799b52d4845b497842e3e946a",
      "text": "Pedhes? Tenan?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "34736cf099ce7b4ad36e7d209b2a53e17f1cbef4de5dada2d210bd5e43081dfd",
      "text": "Bukuné wis diwaca.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "388b96f4c98f8db62b5b107889ac675263581fdf236fdc09fee302f24989d21d",
      "text": "Pedhes tenan!",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a6f535d3c4c612df8bbe619107805064b5ba72d97d7418e56354cffe2cfa9c8",
      "text": "Enak tenan!",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ecf691f8da83953e8479c9ff0136d8fe83f5c6b123d95e5bf2cf1d3ef9c9b4d",
      "text": "Kopiné kurang legi.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f62b669fb93b3d0174872d3f03164f1de90752e85e34e210a7d23d29db9acae",
      "text": "Sega pecel siji, nganggo endhog. Pedhes, Bu!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "401e97c38033f0273327b7a9686c7be0850aa40f44ebcd591b6b3cb441bea387",
      "text": "Pesen apa, Mas?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "43f1c89bce3479ee0ed91ba89beecac4342be9e8a4f9ab9f59d1730634202327",
      "text": "pedhes",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "476a5b08e994d5dbaf046b767b00811c55c4e10195c6abbe78cc0564966d226d",
      "text": "ngombé (ombé)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "488a2dee8aabb57c63f5fe9c9cb310b11fb2bffa199474c69cd5a75be34a93e5",
      "text": "Sari lagi nulis layang.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b2a7ee188eebe9e0e8e6138de4f2fd42e17c416bb418e0e3b7d310690eb7901",
      "text": "Simbok lagi nyapu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bb368ecac52c94453ce2c504ad1b8b0b2b026d36bda1c9ba891504f482eb40d",
      "text": "pait",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "500974721d332d2f0db4e231b3f0fb38a31292ea1146e77b7061080b7659787a",
      "text": "sega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "50d0b3990984bdee9df64f26e373856f7ea1d0afb2830d42dabb23b89f2e3736",
      "text": "Rasané piyé?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "52ba5b8b6d3f7355c0c4a6a313ab42593ad5353ef4bf6318ecfe31077f2d3fc9",
      "text": "ngirim (kirim)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "5548cbfc87c52b1b209344bd3008a213da35996b9cb2bffe80dcee740155af0a",
      "text": "Aku lagi mikir.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c5085c242ca1c05cab96ab3fe3dee8f92b442d045204576dea360ec9ed8fde6",
      "text": "Es teh legi wae, Bu.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c6b921ce618870e45d8540f1d741f8eb4fca643d692d2049832c284e2b47576",
      "text": "endhog",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f91136824da9c7b55cd9e679523c22df600a0f913706cdceebd69cfee0dd5b1",
      "text": "Pecelé enak tenan!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "6185fcf9b5ce69e11d02f168675832bf5be5b5e8ac8ea7a4ead697653ddfc41b",
      "text": "Iki pedhes ora?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "61d7ade34bffac8d716c45bc22ac67e0ab3f1bbbdfdb8ba05e1ae8be00522082",
      "text": "N- + pangan → ?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6484dd604fb69f88ceae86a2facb3e05cda715879816fc98c096cbde58b6c7a4",
      "text": "Kabèh telung puluh ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a3329bc736e6d4598391820f57ddfdd76f57076efd1f8f11c5452901b034e4f",
      "text": "Sega pecel loro, Bu.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a68689b5d343c74aeeb4f16c7f0433432fd11e1974b94dcd1d6ef09408ce774",
      "text": "Teh anget siji, Bu.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c74fe5b03457df51926b212d8636e89a729f6421a4f877e121ec795f1da881c",
      "text": "Apik! Ayo ngombé kopi sik.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "6da920ef67790ee23737dcef9d0279de8ff1fedb6c37522e64595a7c95cae76d",
      "text": "Sotoné rada asin.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "6db78681cdfd742ff5c3fd6000172fe08c94fdd044f4e926f74b870eda885653",
      "text": "Mangan kéné apa dibungkus?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "707ec7330256509e48c7489e7a6cf9b4efc512cdbb251a2916c471e53f0c83fb",
      "text": "nganggo",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "717389724fbf470b1506d073427e281fa549b5c247dff9f0ba4ad3ba0b124bc2",
      "text": "Aku lagi nulis layang.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "720f57fa42a17af7a6ab418e28b5dcea8aeb1ef8c73d7fe1d6f86ccd43e193e1",
      "text": "Mohamed, sambelé piyé?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "72ec1e254018889b8265159fe3fbb09efbe836fe7675fb5c1e7909cd071d444f",
      "text": "njupuk (jupuk)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "776f674af48b8ab398215937998704b7a3f9282be977ff737c8f1d9bfb852877",
      "text": "Wah, enak tenan! Kabèh pira, Bu?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e32fbc3fe0e0cb15f85b5f89ef8ba9043994fbf42f50624f909bfc78468c510",
      "text": "Mas Mohamed! Pesen apa?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "802c6bdcf11a3f6a6120a463189d30a3a677942d266bbfe9b2586c9520df5af4",
      "text": "banyu putih",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "87e24a313d3a0949f5d39532934d3688ea1fdf359ebf49025413bf47c2c67d22",
      "text": "anyep",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d96827ad68cb6783a054875cff45cdf561cfa6f5dc23b06131a9016caaab651",
      "text": "rasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8de8d7cb4b14af52c2f91a8c8509c253b4437e92f6d321f72214f5b2eba4aa70",
      "text": "Mangan kéné, Bu. Karo es teh legi.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e110f44ac8d7b0156e489f32b2a5469126589707bfa672ef07f78e453436b6b",
      "text": "kecut",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "911f7dd565949c438d92456eb1ecc83eb0a50dee54e0f245e2a3c71348225024",
      "text": "Iya, Bu. Aku seneng sing pedhes.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "934373cf7481ed9ee542c8e1f8ec81b8ce25876676f1ad97ab622b2283e3ae27",
      "text": "Pedhes apa ora?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "963c8cc311134d30d40abea42f3e760cf452c0581061fe745f96e0f96b2b401a",
      "text": "Tehé legi ora?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "98fec3bc7b1b61599320bd5214dfd1e5aae6bbf073a554c47f83459f7b82aa17",
      "text": "pesen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "992a81a931920dc517eebb6ef605bb6acbdd9ba241d9cca78d5db3e64edb5c58",
      "text": "Ngombé apa, Mas? Teh anget?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e7754fd8907bd53cbaf37bccf022f3f49abdfd2752ee481e58fd49efa29992a",
      "text": "rada",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5dd4c227d0739263becf1ecacda6e7572514c67190434bb07800bbc66de1ccf",
      "text": "Bapak ngombé kopi.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "b937c858918b995f17d8c1c0138c618231abf512a46b4ddca0fbc0619bdedf3d",
      "text": "teh anget",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf70b99f44cf2bc2bbd1e714bc47e33eb1531fe41cfb354239d172d6edf17c13",
      "text": "Bapak ngombé kopi neng warung.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c22bda583b524252861dd01baeb7ec94b80d20130af63f05e3d922f68c2b8d07",
      "text": "Sambelé pedhes.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c47c92d6f44f8ce54da213a67334d9d9e0147a6a25c78fc954ee465d83e996e8",
      "text": "nggawé (gawé)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "c596a2a37d042cb891fa293eaa5b0282b83e271fb6b323017bc4030f7d864104",
      "text": "Tehé legi.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d797368e3105f5285609aaf8d0efdb3433bbcd1d270d34370ea3fae68f247e03",
      "text": "Rada legi. Enak!",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7e2d499d74cdf69a7e4ab782f11e22c4d0497322fb530aa20c4e64398af1efd",
      "text": "nyapu ← ?",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "da7c90a484b19ff483388c46e18daae2286db2b1d58f45cf3e062ccf5602e2b2",
      "text": "dibungkus",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e020e8a8d1644a297821477a33f45e53d6c78f3654e96b9fa0988cea7f004e98",
      "text": "Enak tenan, Bu!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33fe1564bb8358ef1caa723d2dc44b4e52d39a0a82957c56ee0e749b690f157",
      "text": "Sega pecel loro, Bu. Siji nganggo endhog.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35d72426d0515339789b58280b46bc0bef3b17f7862fc7e85c7941704cfd685",
      "text": "seneng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3c0058fd71ca27080fa56b905dc3631a267bb1384d7defe73fd63953da2c8be",
      "text": "Ibuku seneng maca layang.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5c17705f7f46fae07db5a187face990b3cee3be2fb120dd14b0cf7d055f05dc",
      "text": "Aku sing pedhes. Sari ora pedhes, sambelé sithik wae.",
