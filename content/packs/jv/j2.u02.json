    },
    {
      "key": "b9ed51aef1f0b06ebfe25726119f0d79ccf8a99d9f6e281e2f6b632250dc7909",
      "text": "Sega, endhog lan teh anget, Bu.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd61f7798d323412f4b438746907211ecb0c479b3962395a0668d1a628329a8",
      "text": "Brambang gorenge gurih.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0d17bc5087dacab76051d9b6943a2d8d2faef47287c8fef96528b27513e0467",
