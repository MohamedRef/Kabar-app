    },
    {
      "key": "d6b4f44287d7fadb273b4ce791415026d306c0d970ddb59c51622b1797ce1f3d",
      "text": "Iwake mambu, wis bosok.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7739e288efd95257723619e628f3f84a4145832a506ff121bee4c256e1bff94",
      "text": "Mangan kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 26,
