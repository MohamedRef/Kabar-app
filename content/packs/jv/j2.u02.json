      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4e7a1ff862fef0ab259664b0ad12141af7b0e5466daa2a4d24b5bb4daa81de7",
      "text": "Bapak ngombe kopi neng warung.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9225fe2b8e4ef419988ab1e2c7f471c9863502cbe4112e5b19824c82e10fda8",
      "text": "Pecele enak tenan!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95bc4c1c61c3b9b424a367aac1ac3dc7d327999a961b71f694f09ef05975345",
      "text": "Kabeh telung puluh ewu, Mas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbcaff11f604fcb990c3a028a7c5b7e303e0d5ea0dbe038830fc5d613e23d010",
