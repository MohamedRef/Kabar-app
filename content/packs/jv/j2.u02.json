      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d96827ad68cb6783a054875cff45cdf561cfa6f5dc23b06131a9016caaab651",
      "text": "rasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e110f44ac8d7b0156e489f32b2a5469126589707bfa672ef07f78e453436b6b",
      "text": "kecut",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e87252829509daf96734f661a1df01758d06ce31f0cfd71304d6b5a86a12c3d",
      "text": "Iya, Mas. Mangan kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "90430be88c350ead435a4a1f8ed6ae07ace522370de81393420c098f9ce377a8",
      "text": "Sega pecel siji, nganggo endhog. Sambele sithik wae, Bu.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "911f7dd565949c438d92456eb1ecc83eb0a50dee54e0f245e2a3c71348225024",
      "text": "Iya, Bu. Aku seneng sing pedhes.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "91a1629a67624dc64b6e1924da56c126c1e9b20d99249ceb0dab3aa4537c8f8a",
      "text": "Sambel kacang karo peyek, enak tenan!",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "92993924f57da435550db264a1ffbed05fbcaa44267fcfc4cf42d3359bcd5d52",
      "text": "Rasane piye?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "92df864b6e2ac9e359df0d33ff271f1b36e4ffdb5f7d2e468bceb73c94e95f03",
      "text": "Bukune wis diwaca.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "934373cf7481ed9ee542c8e1f8ec81b8ce25876676f1ad97ab622b2283e3ae27",
      "text": "Pedhes apa ora?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "98fec3bc7b1b61599320bd5214dfd1e5aae6bbf073a554c47f83459f7b82aa17",
      "text": "pesen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a0939383c91967b20cc6bc45d19ddc656e6177dd0c5343dce8ffe7423efb9d9",
      "text": "Sega pecel 10.000 · Endhog 5.000 · Peyek 2.000",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a16e880c3d14c753e084754a0e240e7ef88c4949faa669bd121aaeece1ecff3",
      "text": "mambu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9caf35cbc29720fd99a08d736ff6ab05da0fa729b807ca816b03fa723204e443",
      "text": "Sing ora seneng pedhes, sambele sithik wae. Mangan kene apa dibungkus, regane padha.",
      "voice": "jv_siti",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e7754fd8907bd53cbaf37bccf022f3f49abdfd2752ee481e58fd49efa29992a",
      "text": "rada",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f268ca5e4fbaf2c203bd1b77115551757b33c6f85377e73b4f67e9442e98957",
      "text": "godhong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a10a682a8970808796053a2b303a55f7917315eef18662efb4e61b082d5fb260",
      "text": "gurih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a409203fef7919bd26bbfb1e8276d66c41e87b924b59f7e690ce04d31367941d",
      "text": "Es teh, Bu. Lho, iwak iki kok amis?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f5310d86fe1e03afd4cfb8821057799a058b0af36eda695970e5f8d351d84f",
