    {
      "id": "j2.u02.l09",
      "sha256": "887fcb503befec9680e48bda189add8c37c608703d7690fbddd80642b75b2226"
    },
    {
      "id": "j2.u02.l10",
      "sha256": "5aec54e1c06df81ed7dc10902c54d5c623e1024ba45c00ee52dc4faa9a34fea1"
    }
  ],
  "audio": [
    {
      "key": "001d38ad2d5f074f805de941d8fcb3fea9d40907407bcb877ec2d86dcc1ea9a3",
      "text": "Gula kuwi …",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "01f5aefe6c9e02a31d41cca910a48b9e5b115166ab51bb326ea7add874346275",
      "text": "amis",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "033202b099b795a7ca342aecef05a54499eba03067350df3f1240d341da3943d",
      "text": "Aku wis wareg, matur nuwun.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "0452066cc6fd72b8e058131bc60ac050c15466adc37920efbe8409827677e359",
      "text": "legi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b0734628770a12fc615d269f9b7a78059dbdc59dded1dd68bb85fe1a6b0b31",
      "text": "Monggo, Mas. Nyicipi brem dhisik.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "067f5a4d9075e21290bea11dbc07c25caea4ccc3310f5b1d3ddc6eda76865b5c",
      "text": "sithik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "069c2f8998f88a2e1c014f897650e93248e6b548a34be7802cba6906e05719cd",
      "text": "Layange wis tak tulis.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "07e44b8ab6b31945dff7ca2b92fedc4a23e05409297220f0a7c8d9f7a3f4cebf",
      "text": "Tehe rada anyep.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b8ab6f043409b087d5079f35bf62072c9804d90f6b20dfb3626db2a47570dad",
      "text": "gethuk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ba51ba14242da964fbec4d03f9b249acf2392604925544b70743d5959bd2646",
      "text": "asin",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c087081aa209acd9e636db566f92d99432117df504b66b6becfc76ef0921b84",
      "text": "Gethuk iki legi, ana krambile.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb8976055c3e5cb88cc065002a1658428cfe68f66ddac074e2d7e21ba49085d",
      "text": "Sotone rada asin.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e3a050af9934fc2c9e183c64ecbde25e8c576ec1b08b82c42478e7883cfca74",
      "text": "mikir (pikir)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "108719fe84fc1160cc9a7b145519c1b6fc94114f44db3d63927cfa1a9ec0adb5",
      "text": "Aku lagi ngirim layang.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1106e8617cf9cfbe4cca2be6326c6b15119ab1f479664ae49f8c850a15efcd18",
      "text": "Ngombe apa, Mas?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "111e6b9f0747af3cc445a42e02769b2660552337b4fb0590598fd77801909e42",
      "text": "Monggo, Mas, nyicipi pecel Madiun.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "11d8b0f4d67329ba497d4a96b79dc8369cc06196468269e29075851f35dd8f6b",
      "text": "Ngapura, Mas! Kuwi iwak wingi, wis mambu. Tak buang sik.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "1210e090a1b03724e0b8bddff92ec27445dd5cf2fd0d457775a3d613933fb67e",
      "text": "N- + tulis → ?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1222a12e2d1b38a56c5fd559a8a53597339cda07e9ad315b8f06317bad300d87",
      "text": "pecel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "135a22c40d7999fb2e6c098c0ef8c6d0959718d0be1f42895dd6f5ed170bb587",
      "text": "kabeh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1de66150b9461dd44a30eb20ac1eeffe8752c67c6cb8d84e3b078cf41730f2c0",
      "text": "tenan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e8aa03e5a8ca9add5822d45dd75737e854d66087ee73029331e0365346481f3",
      "text": "sedheng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2152f16d450aee7ef4b13be2f2b2842e55c7fb3e9aaee0b2037ec6490b2d30f1",
      "text": "Aku banyu putih wae, Bu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "216fd3bbaa2bfbc5e3d1cc92a08adae88893162273f54ee6dd1badf5a1891050",
      "text": "Iya, Bu. Brambang gorenge sithik wae.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2195967b7f9a812bdb628744f4260c35251202be6d9a67649224f4f2f775412b",
      "text": "Apik! Ayo ngombe kopi sik.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "297759ce099a7c404710171bfcf57951ae63cc02850ad353d0fc4bd46e78790c",
      "text": "Pecel siji karo krupuk, Bu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a3f3833ad2dd56d2238918f22d26734cbe990d37a4065ec75ea4c2ac2bc37d6",
      "text": "Wah, pedhes, enak tenan! Sendhoke ndi, Bu?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2aa569f69620bbd754a92350201cd74e6cbc5b402ed450f2c5ee15e92f205f26",
      "text": "ambu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c50d3c715e1a8021a48814d451b2e0462e91209a5fec5559cefaa3d6d8559eb",
      "text": "Iwak iki amis lan mambu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc3fc1835fea460ff87652b0606a8f75e8938bd4c2293bc3aa8be7e0eef75c4",
      "text": "nulis (tulis)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc6eeec955b247d8f1db2f6a6e5d3e62788093ae64316effd6ca5d48a814b00",
      "text": "Sega pecel siji, nganggo endhog.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f2c332e21e5f23bea680bcb83a9eb9473098bd2aeee56e0215c130e3663d608",
      "text": "Jangan bayem karo tempe goreng. Lengane wis panas.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd1e946b938c46e79fdfd41ee8a8947a673c5a8b0d8564def594964eedd674a",
      "text": "peyek",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "30b80d48649e6fb07ce603431218cb1dd5ee2ffdd8fac7ceffe328294f15ad6d",
      "text": "Sambel kacange pedhes tenan.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3261050a36505fe78ea836ee0d47c6f481c6a35eaf570f762170319430789f11",
      "text": "Pitik goreng, Bu. Sambel kacange pedhes?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "388b96f4c98f8db62b5b107889ac675263581fdf236fdc09fee302f24989d21d",
      "text": "Pedhes tenan!",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "38aaaae6b7d69a233c8149a2aa32190524ab47e6b5ba6fae124b22e92caa80d8",
      "text": "Mas, tambah sega? Isih anget.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a6f535d3c4c612df8bbe619107805064b5ba72d97d7418e56354cffe2cfa9c8",
      "text": "Enak tenan!",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b1721756d5845111e0a75deda4114b3a5996a3ce0ff6951fc9ea21e9b09dbb6",
      "text": "padha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b608f31a41617dd28f8358fc654c26892af1c8326ed2388079f34962c15c1fc",
      "text": "bayem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c6bd34b72517ec82f0806a565cf17db71e4e3c46cfaa7a52b637e16d5c567f7",
      "text": "pitik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e786286e1696365da77e53b4ebcf326dd4e4d92e6e7ca0a86b8060e8eff8651",
      "text": "nggodhog",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e790a8253ab844e8b48cb0b5eac5cc66f55779d1893acc0ccc9af6d2d9d2614",
      "text": "Mohamed, kowe lagi ngapa?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e8f7a2bf914b08818271b04bbe9ac0179cadc4611b37eeccf52fdbf30f9baf1",
      "text": "nggawe (gawe)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ee73edbf2d02a4896a58b41527017feb7a3e4f33114932c6d01cf01e589641d",
      "text": "Pecel siji, Bu. Karo krupuk, nggih.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f62b669fb93b3d0174872d3f03164f1de90752e85e34e210a7d23d29db9acae",
      "text": "Sega pecel siji, nganggo endhog. Pedhes, Bu!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "401e97c38033f0273327b7a9686c7be0850aa40f44ebcd591b6b3cb441bea387",
      "text": "Pesen apa, Mas?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "404194c95bde3e29e06680ac85986b8e37ae1745a19d1893b350e1205982f375",
      "text": "Wah, apik! Mangan kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "43f1c89bce3479ee0ed91ba89beecac4342be9e8a4f9ab9f59d1730634202327",
      "text": "pedhes",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4440d355dbe146fc4433012d2efdf03f47f6758128a1bb303a7c3966df3e5ef9",
      "text": "Mangan kene, Bu. Regane padha, to?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "44a5b05b6b18232b6e4382a774af5741e3e4e819f09c53c50da0a3071b2d48ce",
      "text": "penak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "488a2dee8aabb57c63f5fe9c9cb310b11fb2bffa199474c69cd5a75be34a93e5",
      "text": "Sari lagi nulis layang.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "48f510909f1e3fae321a072b2007e202ecdbd374b66313df0b80eac47318c748",
      "text": "Es teh legi, Bu. Patang ewu, to?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b2a7ee188eebe9e0e8e6138de4f2fd42e17c416bb418e0e3b7d310690eb7901",
      "text": "Simbok lagi nyapu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bb368ecac52c94453ce2c504ad1b8b0b2b026d36bda1c9ba891504f482eb40d",
      "text": "pait",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e0ead0d35238d7295fa308e78bd95fd71d201edc49f732235dc46d6644a79e0",
      "text": "Siap, Bu! Mengko aku nyicipi gethuke, nggih.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "500974721d332d2f0db4e231b3f0fb38a31292ea1146e77b7061080b7659787a",
      "text": "sega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "50a57526da593f00592e68a624c114e50f3bab2af020387ea99c0de1f5f2a429",
      "text": "Ngombe apa, Mas? Teh anget?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5277e43929db311621bb73cd4dfe2a32482831dcb518c153f9b882e6c9a13d54",
      "text": "monggo",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "52ba5b8b6d3f7355c0c4a6a313ab42593ad5353ef4bf6318ecfe31077f2d3fc9",
      "text": "ngirim (kirim)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "53ea841f6fbe6aeef0faa778d46492676473ea2a58ce249b6d4761617bc1baad",
      "text": "Wah, enak tenan! Kabeh pira, Bu?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "54018ea1714fb37aa534303a40e61c17ec9ee8bb2d4ed3d545678069d4769e3b",
      "text": "seger",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5548cbfc87c52b1b209344bd3008a213da35996b9cb2bffe80dcee740155af0a",
      "text": "Aku lagi mikir.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "58433899347647e4faa94228bd8c00e4886d52269d4335fe5055c2527f62a721",
      "text": "Mangan kene, Bu. Karo es teh legi.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ae0cc2340ab47da258b2fcb5321db16790c88f0e726c23017a12b1838993a93",
      "text": "Bapak ngombe kopi.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c5085c242ca1c05cab96ab3fe3dee8f92b442d045204576dea360ec9ed8fde6",
      "text": "Es teh legi wae, Bu.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c6b921ce618870e45d8540f1d741f8eb4fca643d692d2049832c284e2b47576",
      "text": "endhog",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d1abed20c3080fe831bb29402303e4583a6d0bd9c62defceb749da831749e0f",
      "text": "Piye, Mas? Pecele enak ra?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d7357963502f8106840f6a39236ce2fbac85af71b7e1999e905cf668fa0d3dc",
      "text": "Ombenane apa? Es teh seger utawa teh anget?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "6185fcf9b5ce69e11d02f168675832bf5be5b5e8ac8ea7a4ead697653ddfc41b",
      "text": "Iki pedhes ora?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "61bedad4a281453335dfe38ea09fecda3be3dd5fedeeb23691c2c430bdd7ff63",
      "text": "kacang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "61d7ade34bffac8d716c45bc22ac67e0ab3f1bbbdfdb8ba05e1ae8be00522082",
      "text": "N- + pangan → ?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "62caddc3a08449f4e07a501dcee09c267b1df02147140583e18c76d8ead8b00a",
      "text": "Tehe legi ra?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "65f7c5585e0c9b3199ff3d0a736a3d2c22b44282fac98d949f33bf0c778bf100",
      "text": "Sega anget, pedhes sedheng, ombenane teh.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "68776cb137123763dec30673c7f00db8b3a18f7f2eb07e720ebbe809a54de0cb",
      "text": "Peyek kacang iki gurih tenan!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "691101cd6f67a2be8f58b1a29bdfa4465781a4fc8dfeaa335d09a3bd467e69b3",
      "text": "Aku pesen sega pecel, dibungkus.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a3329bc736e6d4598391820f57ddfdd76f57076efd1f8f11c5452901b034e4f",
      "text": "Sega pecel loro, Bu.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a68689b5d343c74aeeb4f16c7f0433432fd11e1974b94dcd1d6ef09408ce774",
      "text": "Teh anget siji, Bu.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d65734a7c8234766130976f5cdbd56e23906a6d0c734047f5686f2562cac176",
      "text": "Kopine kurang legi.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ffc0c39b54c08ee2a4bb5e2c70f1c8268950119fab753918202af409efc5054",
      "text": "Brem iki oleh-oleh saka Madiun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "717389724fbf470b1506d073427e281fa549b5c247dff9f0ba4ad3ba0b124bc2",
      "text": "Aku lagi nulis layang.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "71b4dd9f216a374206a65151453fe6840425126f27d419885328277a09ffd943",
      "text": "Aku seneng nulis layang.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "72ec1e254018889b8265159fe3fbb09efbe836fe7675fb5c1e7909cd071d444f",
      "text": "njupuk (jupuk)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "73190c25c2bc94a5ad5900fc0150467affa93cdc31aa013c5b7e413c42ef7fd7",
      "text": "Aku ora seneng sambel, pedhes.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "732cc55e891d5efc884d386158fae0939dcc479186b62499b8818c74cea40940",
      "text": "Rada pedhes. Nganggo peyek? Gurih lho.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "745ba7a790205bb9bfffd10e70d5afe6bbbddc4c7906680a5a36b20efe1d6767",
      "text": "Teh anget 3.000 · Es teh legi 4.000 · Banyu putih 2.000",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7635e1bfd2a26c61af9b427885d08f0468cec67ff8c1df061162b5fd058433f3",
      "text": "Ambune enak, Bu!",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "796c2c8806a9e459983196302752411fc45d089818de39181f50e2ab8c691054",
      "text": "Aku seneng ngombe kopi. Ibu nggawe sambel, bapak nyapu.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a240e3498dba9dcac0fd81618259bc2b97ee03d7cee38efc0d6938ad5fbb6a9",
      "text": "Pedhes ra, Mas?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a5d5db514c40c1e5b7f0c94eab5fedbad62520e406b4ee0155bbe6d86e6c1e5",
      "text": "Tehe legi.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ab2d14ac79500ae2e353d9f79710e57de0b2d0d8e86ff02cfb4bfeb104c9b9c",
      "text": "sambel",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ad8e236d4f970d00600dcf4ee770303a002d16f1ce871be33f514f6b01d9f69",
      "text": "Aku sing pedhes. Sari ra pedhes, sambele sithik wae.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b748f28acf6d9722168e930da01e19a337aaf1feb1a63d82666a315eb21b9f4",
      "text": "Mohamed, menune iki. Pesen apa?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c153c5f5d8b7ef8ee5a72bbc42da8bd6bd58f7b40add08a09498e2d4a7032fb",
      "text": "Lho, pedhes? Tenan?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e32fbc3fe0e0cb15f85b5f89ef8ba9043994fbf42f50624f909bfc78468c510",
      "text": "Mas Mohamed! Pesen apa?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "802c6bdcf11a3f6a6120a463189d30a3a677942d266bbfe9b2586c9520df5af4",
      "text": "banyu putih",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "82d2b7a1157c2c6657a495f075a3c668ab0a038053a13cf47f40fa34ce73f68d",
      "text": "krambil",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "852d26f2f3261c1fe8aba40379941339f6f23f5dcf01a23d4d3030c88f38b392",
      "text": "Peyeke gurih.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "87e24a313d3a0949f5d39532934d3688ea1fdf359ebf49025413bf47c2c67d22",
      "text": "anyep",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "891be76e5b63970060241fb137bc22972ecd4f92e5798e9b101e56a58291317f",
      "text": "Monggo, Mas. Pecel? Pitik goreng utawa endhog?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a22042e88c15d23d013b36c2696c11b62504c4b8b79d7ffcbc6752d8d06e33d",
      "text": "goreng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d96827ad68cb6783a054875cff45cdf561cfa6f5dc23b06131a9016caaab651",
      "text": "rasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e110f44ac8d7b0156e489f32b2a5469126589707bfa672ef07f78e453436b6b",
      "text": "kecut",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e87252829509daf96734f661a1df01758d06ce31f0cfd71304d6b5a86a12c3d",
      "text": "Iya, Mas. Mangan kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "90430be88c350ead435a4a1f8ed6ae07ace522370de81393420c098f9ce377a8",
      "text": "Sega pecel siji, nganggo endhog. Sambele sithik wae, Bu.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "911f7dd565949c438d92456eb1ecc83eb0a50dee54e0f245e2a3c71348225024",
      "text": "Iya, Bu. Aku seneng sing pedhes.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "91a1629a67624dc64b6e1924da56c126c1e9b20d99249ceb0dab3aa4537c8f8a",
      "text": "Sambel kacang karo peyek, enak tenan!",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "92993924f57da435550db264a1ffbed05fbcaa44267fcfc4cf42d3359bcd5d52",
      "text": "Rasane piye?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "92df864b6e2ac9e359df0d33ff271f1b36e4ffdb5f7d2e468bceb73c94e95f03",
      "text": "Bukune wis diwaca.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "934373cf7481ed9ee542c8e1f8ec81b8ce25876676f1ad97ab622b2283e3ae27",
      "text": "Pedhes apa ora?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "9413caba3e1347e50373205d12a51b04c443d33673031c801e429cfcd457c316",
      "text": "Bu Darmi ngulek sambel, lengane wis panas.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "98fec3bc7b1b61599320bd5214dfd1e5aae6bbf073a554c47f83459f7b82aa17",
      "text": "pesen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a0939383c91967b20cc6bc45d19ddc656e6177dd0c5343dce8ffe7423efb9d9",
      "text": "Sega pecel 10.000 · Endhog 5.000 · Peyek 2.000",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a16e880c3d14c753e084754a0e240e7ef88c4949faa669bd121aaeece1ecff3",
      "text": "mambu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9caf35cbc29720fd99a08d736ff6ab05da0fa729b807ca816b03fa723204e443",
      "text": "Sing ora seneng pedhes, sambele sithik wae. Mangan kene apa dibungkus, regane padha.",
      "voice": "jv_siti",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e7754fd8907bd53cbaf37bccf022f3f49abdfd2752ee481e58fd49efa29992a",
      "text": "rada",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f268ca5e4fbaf2c203bd1b77115551757b33c6f85377e73b4f67e9442e98957",
      "text": "godhong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a10a682a8970808796053a2b303a55f7917315eef18662efb4e61b082d5fb260",
      "text": "gurih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a13582fbc0312607aa15377418e781e066240bccb51d2598dccde8613fa806c4",
      "text": "Iki. Mengko mulih nggawa brem, oleh-olehe Madiun.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a409203fef7919bd26bbfb1e8276d66c41e87b924b59f7e690ce04d31367941d",
      "text": "Es teh, Bu. Lho, iwak iki kok amis?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f5310d86fe1e03afd4cfb8821057799a058b0af36eda695970e5f8d351d84f",
      "text": "brambang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a70378ba5ff2b9e3769723dd9c9229802cf015489b169c8ced9d1dbd226f2c9e",
      "text": "krupuk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a80132d8ed25fab6fda6da51ccc28da4741f3f509eeef05ef54c665f496cad45",
      "text": "wareg",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa8205d2d06d3bd75cdbc58ffc3777f1bb45be8bb81f7cce21f3bc6eeba3f13c",
      "text": "Mohamed, sambele piye?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "abac030db20433fafd168d71c48063c7b21991b436d21b2be2a7403790cd08d4",
      "text": "Matur nuwun, Bu, aku wis wareg.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad7f8193136e7d46cb0a31d6960474def34b75eaa27f81acc268af37a1f455e3",
      "text": "Kasure penak, aku ngantuk.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "afeb6b6e3337ce2baa6df1b5db727882377c6445c93c0dbe9d52deb1e8b5c3ef",
      "text": "Mangan kene apa dibungkus, regane padha.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0658ff8fe22695ddde1ceb465ebcf45a90982ae02a8b602cfc8e4ae4c3e9106",
      "text": "Gethuk iki ana krambile.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5651bda8856ba695f261015a848877b2e600e7b1466595c293c52d17a91af01",
      "text": "bosok",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6bff79a287f45a3a2ca340f02dfd3353114c5ffab04904bfffec84bbeab577f",
      "text": "Sambele pedhes.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b937c858918b995f17d8c1c0138c618231abf512a46b4ddca0fbc0619bdedf3d",
      "text": "teh anget",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9ed51aef1f0b06ebfe25726119f0d79ccf8a99d9f6e281e2f6b632250dc7909",
      "text": "Sega, endhog lan teh anget, Bu.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb41e0c286843637241773a3d43e39c08676e69a62e10ad8b326959502783184",
      "text": "ngulek",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd61f7798d323412f4b438746907211ecb0c479b3962395a0668d1a628329a8",
      "text": "Brambang gorenge gurih.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c070aa881250807ceba75557616d172f660ecc70a24ba3cc6e447cc957351003",
      "text": "Ambune enak, Bu masak bayem?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0d17bc5087dacab76051d9b6943a2d8d2faef47287c8fef96528b27513e0467",
      "text": "anget",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c381a7641e2d6c161f71ea538afae6a69f23ec90493b9ca4105cf38c7bec839c",
      "text": "Kopine rada ___.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4e7a1ff862fef0ab259664b0ad12141af7b0e5466daa2a4d24b5bb4daa81de7",
      "text": "Bapak ngombe kopi neng warung.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c57f8f45f161f589f1655799d2e66e6915cc4b8e1195d36f39b2dfd6d453998e",
      "text": "Bu, ambune enak. Masak apa?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b0f4b38dc3cace546aedde47cb80936a5954ebde7872b364509663bd378cf2",
      "text": "Sambele tak ulek dhewe lho. Nyicipi sik, Mas.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9225fe2b8e4ef419988ab1e2c7f471c9863502cbe4112e5b19824c82e10fda8",
      "text": "Pecele enak tenan!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95bc4c1c61c3b9b424a367aac1ac3dc7d327999a961b71f694f09ef05975345",
      "text": "Kabeh telung puluh ewu, Mas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9ffa29dca52dd587c1fccd851a3c08881e8ae6bbee265b1c084a3e3662e50f4",
      "text": "Sendhoke ndi, Bu? Aku arep mangan pecel.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbcaff11f604fcb990c3a028a7c5b7e303e0d5ea0dbe038830fc5d613e23d010",
      "text": "ombenan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd08096ef03920429426a1fabb0534614e578343390d6cf38891e9ffa084a8a0",
      "text": "Sip. Dibungkus godhong apa dipangan kene?",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce4eaf6a56758eaddd99b5aba9ddeb500bb57e38fcd9fa38aa85924ed0e1593d",
      "text": "Es teh legi karo teh anget, regane padha, Bu?",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "cea65e5edb10c2fb7475498c05e33805bed6d4b68b90fb3668fd7aa4c53fa38d",
      "text": "Monggo, Mas! Pecel Madiun, isih anget.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d038207f41db738da8372779ba9630e60628dd1c31ffc9f8d1d14640dae13458",
      "text": "Layang? Kok ra ngirim WA wae?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d15f62573001ded21866da4ad6b0687b198ae5875e0ca85a71db65ab78c4a6ee",
      "text": "Iwake amis, wis bosok.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1c72a558794ee521acb087a387e607ca38f8391ed8da792073618bb0c632ce7",
      "text": "Enak tenan, Bu! Sambele rada pedhes.",
      "voice": "jv_dimas",
