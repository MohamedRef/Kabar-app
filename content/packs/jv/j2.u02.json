    }
  ],
  "audio": [
    {
      "key": "0452066cc6fd72b8e058131bc60ac050c15466adc37920efbe8409827677e359",
      "text": "legi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "067f5a4d9075e21290bea11dbc07c25caea4ccc3310f5b1d3ddc6eda76865b5c",
      "text": "sithik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "069c2f8998f88a2e1c014f897650e93248e6b548a34be7802cba6906e05719cd",
      "text": "Layange wis tak tulis.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ba51ba14242da964fbec4d03f9b249acf2392604925544b70743d5959bd2646",
      "text": "asin",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb8976055c3e5cb88cc065002a1658428cfe68f66ddac074e2d7e21ba49085d",
      "text": "Sotone rada asin.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e3a050af9934fc2c9e183c64ecbde25e8c576ec1b08b82c42478e7883cfca74",
      "text": "mikir (pikir)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "108719fe84fc1160cc9a7b145519c1b6fc94114f44db3d63927cfa1a9ec0adb5",
      "text": "Aku lagi ngirim layang.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1106e8617cf9cfbe4cca2be6326c6b15119ab1f479664ae49f8c850a15efcd18",
      "text": "Ngombe apa, Mas?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1210e090a1b03724e0b8bddff92ec27445dd5cf2fd0d457775a3d613933fb67e",
      "text": "N- + tulis → ?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba83835523baf99c108ba8de0f29bf6aa8700e928108058fbd98dbf4a70ac44",
      "text": "Sega pecel siji, nganggo endhog, Bu.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1de66150b9461dd44a30eb20ac1eeffe8752c67c6cb8d84e3b078cf41730f2c0",
      "text": "tenan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "20732e7767ed896fb6bdca4c851bf56af4b239506d27cfe52b9e36d6bab84ad7",
      "text": "Piye, Mas? Pecele enak ora?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2152f16d450aee7ef4b13be2f2b2842e55c7fb3e9aaee0b2037ec6490b2d30f1",
      "text": "Aku banyu putih wae, Bu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2195967b7f9a812bdb628744f4260c35251202be6d9a67649224f4f2f775412b",
      "text": "Apik! Ayo ngombe kopi sik.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc3fc1835fea460ff87652b0606a8f75e8938bd4c2293bc3aa8be7e0eef75c4",
      "text": "nulis (tulis)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc6eeec955b247d8f1db2f6a6e5d3e62788093ae64316effd6ca5d48a814b00",
      "text": "Sega pecel siji, nganggo endhog.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "32b79521efa4fcb2c112026ab3c115cee299011e60a8bed6638f857ffede97c1",
      "text": "Aku sing pedhes. Sari ora pedhes, sambele sithik wae.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "33a5b498f4b300d3e1044465dcfa413b242a4be799b52d4845b497842e3e946a",
      "text": "Pedhes? Tenan?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "388b96f4c98f8db62b5b107889ac675263581fdf236fdc09fee302f24989d21d",
      "text": "Pedhes tenan!",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a6f535d3c4c612df8bbe619107805064b5ba72d97d7418e56354cffe2cfa9c8",
      "text": "Enak tenan!",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e790a8253ab844e8b48cb0b5eac5cc66f55779d1893acc0ccc9af6d2d9d2614",
      "text": "Mohamed, kowe lagi ngapa?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e8f7a2bf914b08818271b04bbe9ac0179cadc4611b37eeccf52fdbf30f9baf1",
      "text": "nggawe (gawe)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f62b669fb93b3d0174872d3f03164f1de90752e85e34e210a7d23d29db9acae",
      "text": "Sega pecel siji, nganggo endhog. Pedhes, Bu!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "401e97c38033f0273327b7a9686c7be0850aa40f44ebcd591b6b3cb441bea387",
      "text": "Pesen apa, Mas?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "404194c95bde3e29e06680ac85986b8e37ae1745a19d1893b350e1205982f375",
      "text": "Wah, apik! Mangan kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "43f1c89bce3479ee0ed91ba89beecac4342be9e8a4f9ab9f59d1730634202327",
      "text": "pedhes",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4440d355dbe146fc4433012d2efdf03f47f6758128a1bb303a7c3966df3e5ef9",
      "text": "Mangan kene, Bu. Regane padha, to?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "488a2dee8aabb57c63f5fe9c9cb310b11fb2bffa199474c69cd5a75be34a93e5",
      "text": "Sari lagi nulis layang.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "48f510909f1e3fae321a072b2007e202ecdbd374b66313df0b80eac47318c748",
      "text": "Es teh legi, Bu. Patang ewu, to?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b2a7ee188eebe9e0e8e6138de4f2fd42e17c416bb418e0e3b7d310690eb7901",
      "text": "Simbok lagi nyapu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bb368ecac52c94453ce2c504ad1b8b0b2b026d36bda1c9ba891504f482eb40d",
      "text": "pait",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "500974721d332d2f0db4e231b3f0fb38a31292ea1146e77b7061080b7659787a",
      "text": "sega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "50a57526da593f00592e68a624c114e50f3bab2af020387ea99c0de1f5f2a429",
      "text": "Ngombe apa, Mas? Teh anget?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "52ba5b8b6d3f7355c0c4a6a313ab42593ad5353ef4bf6318ecfe31077f2d3fc9",
      "text": "ngirim (kirim)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "53ea841f6fbe6aeef0faa778d46492676473ea2a58ce249b6d4761617bc1baad",
      "text": "Wah, enak tenan! Kabeh pira, Bu?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5548cbfc87c52b1b209344bd3008a213da35996b9cb2bffe80dcee740155af0a",
      "text": "Aku lagi mikir.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "58433899347647e4faa94228bd8c00e4886d52269d4335fe5055c2527f62a721",
      "text": "Mangan kene, Bu. Karo es teh legi.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ae0cc2340ab47da258b2fcb5321db16790c88f0e726c23017a12b1838993a93",
      "text": "Bapak ngombe kopi.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c5085c242ca1c05cab96ab3fe3dee8f92b442d045204576dea360ec9ed8fde6",
      "text": "Es teh legi wae, Bu.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c6b921ce618870e45d8540f1d741f8eb4fca643d692d2049832c284e2b47576",
      "text": "endhog",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6185fcf9b5ce69e11d02f168675832bf5be5b5e8ac8ea7a4ead697653ddfc41b",
      "text": "Iki pedhes ora?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "61d7ade34bffac8d716c45bc22ac67e0ab3f1bbbdfdb8ba05e1ae8be00522082",
      "text": "N- + pangan → ?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a3329bc736e6d4598391820f57ddfdd76f57076efd1f8f11c5452901b034e4f",
      "text": "Sega pecel loro, Bu.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a68689b5d343c74aeeb4f16c7f0433432fd11e1974b94dcd1d6ef09408ce774",
      "text": "Teh anget siji, Bu.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d65734a7c8234766130976f5cdbd56e23906a6d0c734047f5686f2562cac176",
      "text": "Kopine kurang legi.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "707ec7330256509e48c7489e7a6cf9b4efc512cdbb251a2916c471e53f0c83fb",
      "text": "nganggo",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "717389724fbf470b1506d073427e281fa549b5c247dff9f0ba4ad3ba0b124bc2",
      "text": "Aku lagi nulis layang.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "72ec1e254018889b8265159fe3fbb09efbe836fe7675fb5c1e7909cd071d444f",
      "text": "njupuk (jupuk)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "73654c35429f163ef24a9b3b4dafede7b109378fdb8934bc4aff6269b1b3c3b4",
      "text": "Gula rasane …",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "745ba7a790205bb9bfffd10e70d5afe6bbbddc4c7906680a5a36b20efe1d6767",
      "text": "Teh anget 3.000 · Es teh legi 4.000 · Banyu putih 2.000",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7752e38fd9ce27218d490aba60499ae0bb5cccc8dbed121146aa6f679d2ff242",
      "text": "Tehe legi ora?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a5d5db514c40c1e5b7f0c94eab5fedbad62520e406b4ee0155bbe6d86e6c1e5",
      "text": "Tehe legi.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b748f28acf6d9722168e930da01e19a337aaf1feb1a63d82666a315eb21b9f4",
      "text": "Mohamed, menune iki. Pesen apa?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e32fbc3fe0e0cb15f85b5f89ef8ba9043994fbf42f50624f909bfc78468c510",
      "text": "Mas Mohamed! Pesen apa?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "802c6bdcf11a3f6a6120a463189d30a3a677942d266bbfe9b2586c9520df5af4",
      "text": "banyu putih",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "87e24a313d3a0949f5d39532934d3688ea1fdf359ebf49025413bf47c2c67d22",
      "text": "anyep",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d96827ad68cb6783a054875cff45cdf561cfa6f5dc23b06131a9016caaab651",
      "text": "rasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e110f44ac8d7b0156e489f32b2a5469126589707bfa672ef07f78e453436b6b",
      "text": "kecut",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e87252829509daf96734f661a1df01758d06ce31f0cfd71304d6b5a86a12c3d",
      "text": "Iya, Mas. Mangan kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "90430be88c350ead435a4a1f8ed6ae07ace522370de81393420c098f9ce377a8",
      "text": "Sega pecel siji, nganggo endhog. Sambele sithik wae, Bu.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "911f7dd565949c438d92456eb1ecc83eb0a50dee54e0f245e2a3c71348225024",
      "text": "Iya, Bu. Aku seneng sing pedhes.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "92993924f57da435550db264a1ffbed05fbcaa44267fcfc4cf42d3359bcd5d52",
      "text": "Rasane piye?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "92df864b6e2ac9e359df0d33ff271f1b36e4ffdb5f7d2e468bceb73c94e95f03",
      "text": "Bukune wis diwaca.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "934373cf7481ed9ee542c8e1f8ec81b8ce25876676f1ad97ab622b2283e3ae27",
      "text": "Pedhes apa ora?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "98fec3bc7b1b61599320bd5214dfd1e5aae6bbf073a554c47f83459f7b82aa17",
      "text": "pesen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a0939383c91967b20cc6bc45d19ddc656e6177dd0c5343dce8ffe7423efb9d9",
      "text": "Sega pecel 10.000 · Endhog 5.000 · Peyek 2.000",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9caf35cbc29720fd99a08d736ff6ab05da0fa729b807ca816b03fa723204e443",
      "text": "Sing ora seneng pedhes, sambele sithik wae. Mangan kene apa dibungkus, regane padha.",
      "voice": "jv_siti",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e7754fd8907bd53cbaf37bccf022f3f49abdfd2752ee481e58fd49efa29992a",
      "text": "rada",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa8205d2d06d3bd75cdbc58ffc3777f1bb45be8bb81f7cce21f3bc6eeba3f13c",
      "text": "Mohamed, sambele piye?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "afeb6b6e3337ce2baa6df1b5db727882377c6445c93c0dbe9d52deb1e8b5c3ef",
      "text": "Mangan kene apa dibungkus, regane padha.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6bff79a287f45a3a2ca340f02dfd3353114c5ffab04904bfffec84bbeab577f",
      "text": "Sambele pedhes.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b937c858918b995f17d8c1c0138c618231abf512a46b4ddca0fbc0619bdedf3d",
      "text": "teh anget",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4e7a1ff862fef0ab259664b0ad12141af7b0e5466daa2a4d24b5bb4daa81de7",
      "text": "Bapak ngombe kopi neng warung.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9225fe2b8e4ef419988ab1e2c7f471c9863502cbe4112e5b19824c82e10fda8",
