      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbf745b85f47bcab0f2d3c35c19108e34c39fd033f2f8db9d87757e7b1b6190a",
      "text": "Ora usah. Ngumbah sendhok wae, hehe.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e020e8a8d1644a297821477a33f45e53d6c78f3654e96b9fa0988cea7f004e98",
