      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd08096ef03920429426a1fabb0534614e578343390d6cf38891e9ffa084a8a0",
      "text": "Sip. Dibungkus godhong apa dipangan kene?",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce4eaf6a56758eaddd99b5aba9ddeb500bb57e38fcd9fa38aa85924ed0e1593d",
      "text": "Es teh legi karo teh anget, regane padha, Bu?",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d038207f41db738da8372779ba9630e60628dd1c31ffc9f8d1d14640dae13458",
      "text": "Layang? Kok ra ngirim WA wae?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d15f62573001ded21866da4ad6b0687b198ae5875e0ca85a71db65ab78c4a6ee",
      "text": "Iwake amis, wis bosok.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1c72a558794ee521acb087a387e607ca38f8391ed8da792073618bb0c632ce7",
      "text": "Enak tenan, Bu! Sambele rada pedhes.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6b4f44287d7fadb273b4ce791415026d306c0d970ddb59c51622b1797ce1f3d",
      "text": "Iwake mambu, wis bosok.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7739e288efd95257723619e628f3f84a4145832a506ff121bee4c256e1bff94",
      "text": "Mangan kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d797368e3105f5285609aaf8d0efdb3433bbcd1d270d34370ea3fae68f247e03",
