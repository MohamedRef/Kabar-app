      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0761edf5e5f9b00bc535e1f297018eca7527ff1be841a60e8346266b2dc5526",
      "text": "Kabeh telung puluh ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33fe1564bb8358ef1caa723d2dc44b4e52d39a0a82957c56ee0e749b690f157",
      "text": "Sega pecel loro, Bu. Siji nganggo endhog.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35d72426d0515339789b58280b46bc0bef3b17f7862fc7e85c7941704cfd685",
