      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3bcac9896eba8368e0fec0ac0d984653266586bd3376c0b0d956b9893cf578a",
      "text": "Ombenane apa, Mas?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3c0058fd71ca27080fa56b905dc3631a267bb1384d7defe73fd63953da2c8be",
      "text": "Ibuku seneng maca layang.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6f129d9adb574351f711535bfc8fff79c2e9b04ebe16901c462d83fb0cf3b11",
      "text": "Es teh legi patang ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e85196f77bf913ea1cc3d07c4764499491b8ace76426911a4f9ba97124601f29",
      "text": "Sega pecel siji, nganggo endhog. Kabeh pira, Bu?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea24b175a6933434a2f422dde45f043e5f93e43d153f7b75cc89b81d9d11c290",
      "text": "Aku njaluk pitik goreng karo sega.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed1b1526ba85336d4c86d9e5b8a3b0b5a5193f1a2c167689a3c2f48240b1afa1",
      "text": "Es tehe seger tenan.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f397616ac127c85a5d955f5ad79754abbf8448119f506376f6137a37ce633a7f",
      "text": "Sambel pecel rada pedhes.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbb74348bb85e25a92f535800fa80dc83679782b61c1b19ea39244d1ff75e001",
