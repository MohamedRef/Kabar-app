  "audio": [
    {
      "key": "0329a28cf68e4bd92a71a702d4c2f021499d4fa0338ba2a969a206bd43179cb1",
      "text": "wong ngendi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "03d1f564b10c0260ba170c3c52988d88c6cc06506df9ce30870e4a499d0afdc5",
      "text": "Yudha wong Jogja.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "08a754fff5c0b9dcf475c1566959280a3ba708190124390b10b8553bf1408d21",
      "text": "sapa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "08e1a644883b631885c3c6dcf369c60549c024662e667ab4aafd7c1369eb4210",
      "text": "wangsulan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bb2cece680b720cf9a1aadd07ef6fded0ef1cd06cd39335402543a6200d7e85",
      "text": "Iya, aku bakul.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d8a5240f3829aeed2f5da303a517f120d6014ee296c5f5a4c88521532385f25",
      "text": "Conto ukara: Aku luwe banget.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0df2ecb45a6b7cb01012704cccecf1e3047e5d04ffa7d0a2912d1aa2a0ab29f8",
      "text": "penerjemah",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0df824b1ac973b7c7bc4922be37a84a31c13a991a595441965aa92e22a5de242",
      "text": "sinau",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "105316d76347fb3f1918744cdba8a3b7f8f81ddc07788e159aadc35cbf08f328",
      "text": "Regane pira?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1130eed657e4619f31b69d9d8c4672c75b86b14dd5e8ca9d601d8d14a4afa118",
      "text": "ukara",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1235afce4d1bffbbc170d5903fcdcc50b0d6fdbd8ff98d5e59c5c29d4288e26b",
      "text": "rega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1338e64c220e9798dbb0a6bf648b8bebfa6e50fc2d1d709a98871a0040ff8a30",
      "text": "pira / piro",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "14e43df8aa8a5fc90455c4beea8fa30b8892b77fcdcfa3fdf9c704a9deff1d1f",
      "text": "Sinta. Mas wong ngendi?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b0ac46a74dfa00b8cdb5483611bf6f28bc370fa0ead9db3a2441f4a7c52661",
      "text": "Guruku bocah Jogja asli. Dheweke pinter.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c0b46fc2b6b1797411ff24a5c96b7c14864707b7dab0abba38e28077d35fc6f",
      "text": "Mohamed, aku duwe pitakon. Tembung «isin» apa?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c152ff9c5817cc0f0a3501fc31e8c4cf8fae09ae827b422cb1965d7a83c9c0d",
      "text": "Ora, aku guru basa Arab. Aku sinau basa Jawa.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c996aadc97815c9bb33dd148699a7e01170860940474880c0a0b6d2dcab16cb",
      "text": "Omahe gedhe.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d914b05c9bc69bd02b5946338633cc40516f2403e21388663e2de94081a2e00",
      "text": "ngendi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e9b114b9bd477394bebc3a94f5b95104b2fe9fd1a352d7316c6a1123b4f0dc3",
      "text": "Jenengku Mohamed. Aku saka Kairo. Kowe saka ngendi?",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f94de3a2829c4a763a936077cda765fdd02587ed0862d04ea1c5518f528f233",
      "text": "Sugeng sonten. Piye kabare, Mas?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f9ca2d2a0711a2c5b7d269dfd13dabe3a12bba5a599930d539da09cb638115f",
      "text": "Omahmu endi?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "232cb25cde21eac1a4ed35ee81ea8eef89aa0d574b85eb63e0747872198f6a08",
      "text": "apa / opo",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "252836ac28e3cbe78d8b2ce210209e16863e8f6b9708bfd31281be80fb0a351b",
      "text": "Sugeng enjing, Mbak. Jenengku Mohamed. Jenengmu sapa?",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "254fae1252597dc6a9ebfb049e051455094e11ed1cdffb5946559782f12f7518",
      "text": "Mas Yudha bocah enom saka Jogja.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2591e0a542dfdfcdcdda1f4bcc28cdff1c3610ea9c3d890dc6a4accecc60d695",
      "text": "ngombe",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "261e2f305a50032e42c0a07c41ceb8adcb5a4ac8d8c845b730d2c8435567de6a",
      "text": "Saka Tugu, Mas. Numpak becak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "27dc6248aef46b07eaf98cf5b6d7629fec5e5e57f4a56ef530db71d2653e4f13",
      "text": "Kopine, cah!",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c3521f29a81b502ef884b3d06c2a8cdfdaa02af5318807eb1b3ff1defd73ea7",
      "text": "Kowe mahasiswa?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c63e2b24f21926f24744ae662825bffaeb5e94e6f8ec4e742b6474cebc8958e",
      "text": "Kowe sinau basa Jawa?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc0b6b8e78bd3ee7eae1e2c4c1b7dfec591a50cd497b3eb7bed041aad43ebb3",
      "text": "Ayo, Mas. Aku ngombe kopi joss.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f52fdc64e4d19946e6863bd08324e3221e566788cc94fc99c82a7f61edcd485",
      "text": "Iya. Bapakku tuwa, nanging isih nyambut gawe.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f6b198230bbd22aefbee42cd89f94258124e663b1366b2a0ebec957f1ddab00",
      "text": "Mohamed, ngapa kowe?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "317d0c6518d5b0908aae6c686dd27f62ae0b079538e70de1fe04404b49414320",
      "text": "Wah, padha karo aku!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e9223a8853cfffa1bdb5ba2c92752eeb2076e2bcee77152f71caccaf229d0e",
      "text": "kene",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3329ec2e52125acfb2ad523b932a810451a936058aae61c9081032f9541d0f72",
      "text": "teka",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "33fd0a1d5de3e124c73563133f2224ed237af11e9c96fdb8cee181a49499c515",
      "text": "gawe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "349f586c486ef1a0823ea8a83e001306121ccf0c0aef9e3b3fdc5a7c6e7e725a",
      "text": "Mas, kopi iki kanggo sapa?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f71ef11c3d9e20071fd044447daf4f2947ef5f67286c5f1ad6c967192522aa",
      "text": "Apik! Aku sinau basa Jawa.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "363819ca853eb9573e647c5c4fa47dd20ef6548921fb489391b2921dbe00aee0",
      "text": "enom",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "37a680a527f4234cb043df761af0307b44cf32a3085bd6fa668447605f2e63ee",
      "text": "kapan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3857a2e533d1c88b25a6527090034358ab049b4f0cc437b6f79b5f551bedb764",
      "text": "pinter",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b1721756d5845111e0a75deda4114b3a5996a3ce0ff6951fc9ea21e9b09dbb6",
      "text": "padha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dea6cca855ddbc868e3ea3f5e63d274cfbe2f8125769b57aa8b560208df7014",
      "text": "Aku wong Mesir. Mbak wong Jogja?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ee59ca8f6f675fe70bb9c4d9539628f91c82d3367159f29d89189a2969826c1",
      "text": "Aku sinau basa Jawa. Aku guru basa Arab.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "40ac63639ca28edc09043f19f4dee062e65c70932fbba7e0d1a4e37b0b25de6e",
      "text": "Sugeng sonten, Mas. Kenalan, jenengku Mohamed.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "42a7413904ec2defabcc4b414d9ac682faea56192374d656aa5fe2db50895c78",
      "text": "Mohamed, ayo ngopi neng kene!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "44a18a10d390f1971dcf3ba215d871efa9ca7fc5b8586b570952640d48a5aea0",
      "text": "Aku guru basa Arab.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "47599a425556aa2f9aceb6e87ee10d14b24bdfa23e0816f87f894d203aca76c4",
      "text": "Nggih, Mas. Kuwi kanggo aku, hehe.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b68c22bf53a773165b6da0d18707cfb8a3db0cae27c8e42ed21976521bbb458",
      "text": "Saka Kairo. Omahmu ngendi?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b6c6ea92f065271a65f7bfe032b1ff1be214c5e9e6f875fd3ac64657ea25f42",
      "text": "guru",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cf167c62c6956bfd664aac1f56972c0ea271f57a0fc8476f7eccf5d1e4de02e",
      "text": "Ora, aku saka Malang. Aku mahasiswa.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d37bf54006975db18ae701bef975e34c954a2a6a0dfe9411874b28b0f6acfd8",
      "text": "Kanggo kancaku, Mas. Dheweke isih neng Stasiun Tugu.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5083c93c2a0a37f224dc43ddbc3fb80557983cd0cb751feb1480ba661d16b4a6",
      "text": "Ayo ngopi neng kene, Mas!",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5160df4b257c027d842baad3ae1ea2be7812e30b17de5307ed89170b0a6157e8",
      "text": "Kowe nyambut gawe neng ngendi?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5195f81628a1fd8b94dcf069c24eb03fceb1d8c090da2909ff6e3bffea899ed9",
      "text": "ki",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "540a0ac474b2e689aead1df7dd46f41077e78dffb4825dfb7b7449afb8d65cd7",
      "text": "Mas, sugeng enjing.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5499dd3648cacb1188b38fa4f810a270a4c5c5ffd2f8db68d6e9364dffc1791b",
      "text": "Mas, jenengmu sapa?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5623d0ea4b5095e15fab2b4e59864ab4a1d7012f5aefdb2c312499179ec5b168",
      "text": "gedhe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "586697c7aa428cc688f2af53a99011230a157afca6011b424296dd21f5d41c49",
      "text": "ngopi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "58aa2a60e3900a0da13f850780a9ab697e0042e01d04dd26a771282e0c5b1e31",
      "text": "Mas Heru bocah Jogja asli.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b2b5040d1f3abd2841beffe33f0642dea89980a9ea9830e7afd1a2e9b836d48",
      "text": "Jenengku lan jenengmu padha!",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cdf9282a10781e7cf554708ad11786b530714a8f4e3ec3e366640a7220f9b76",
      "text": "Kopi iki kanggo sapa?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e41de211549859805638d73ff858beba08b7ac45b09e877dee9a8fec9986cd6",
      "text": "Wong Kairo. Dheweke sinau basa Jawa karo aku.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eadee83f9f68fc6d460152d13593a3dcc3b3856be7814320cc0480d658a1c74",
      "text": "ngapa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "620462af8ecdbdb16534e3a3c064401032840675bd49f066310caacdf0f1867b",
      "text": "eling / iling",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6625dde7cc5d2b3326112ee4587e00ba683c61de8f5b0071ccf579b5ff69f326",
      "text": "krungu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "66f89a085026548ca1e01f7ea429432e6bf476a9254d3d0f32cd497c358ce24e",
      "text": "endi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6810c73bdac249657a8a65b0903220ab8539275d379028cb8372537649c60ff7",
      "text": "iya",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "68ed3fb2231e747b6e232490e834eef0738051779b2a8607758750fb1231d8a3",
      "text": "Yudha. Kowe saka ngendi?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ba1eaf4f915fdd6cc9fa1ae4b7531d5eaf4513aa34c5936be28518584f60f46",
      "text": "Apik! Ki apa? Regane pira?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c71b4eeea1f73584e138c19fb4f78e890f6905fbda339fc5c8acd8286c2962b",
      "text": "Apik! Aku krungu, ukaramu bener.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6eec084b37c3254ffc842fedfdba7a6626381a53a4dccd362519ebb6e41d4d1e",
      "text": "tuwa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f6fcc1fe63ad16bd16ba8eda08429fbfffd037ef8e56270d5c1ade5331b857b",
      "text": "conto",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "707ec7330256509e48c7489e7a6cf9b4efc512cdbb251a2916c471e53f0c83fb",
      "text": "nganggo",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "71174784a8af1eaa9d814a08d99383701ca857c0f99bf2bfea9ce93de023c54e",
      "text": "Aku nyoba: «Aku isin ngomong Jawa.»",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "733d9f41386e665783aeff262e3dab78b0936755a390a4f9976dbc583abaca80",
      "text": "kenalan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "734d3baac68f74038c0906e2b19d626d191aa45dae5313ba588740a83b01a466",
      "text": "Kowe ngapa?",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "74a4f067a1654c30352d838b4a3e5bb8e7836fc1b4f434cf5900be7b49c40093",
      "text": "basa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "752c74f99e239f6a908a5fc1dc4b0d51d066720e9c67d7f5392efb5f95904321",
      "text": "Aku sinau basa Jawa.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "788a76f50dee80257ab9f35b7cbb0fea65e6b0d20980ce18328591c765cffcac",
      "text": "Kowe eling tembung «luwe»?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a1cc94098946ca73cb309d8ae03cf3a43c8c69daf84fd782ac6d3b3b698b936",
      "text": "Kowe wong Jogja?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f4c0c4f3b467c01abba6ea632727ab6e73747bf54641d7ed1744ecb2bbca8",
      "text": "Jenengku Mohamed.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c232bad9bd32ba7965f03e5b567e55c0335d80d9fbc1c063b91973124fb4548",
      "text": "Jenengku Mohamed. Jenengmu sapa?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f6901cca0e9afa3ffaeced1d0374c6f636a18ec66df35b55c6884bf762766db",
      "text": "wong",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "87580ba9b8ccd2b6423256048eecd3725b39d0b5343079119603ea59d8f987b8",
      "text": "Aku numpak becak saka Tugu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8823c712b13c2252745440b23602ec0b4b500900c4d627d9200e67fefefd992f",
      "text": "omah",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "88caf713625305960898d96f0b425f3fa90b6a04c27d1932130b7d7b101c3c8e",
      "text": "Aku penerjemah, aku sinau basa Jawa.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "89f53ee595dc8f19c0a493cd2b07512f8a4bd042827780fb9d24ddda7c802c98",
      "text": "Jenengmu sapa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a6570dc9e935983a4de7a28882242045862d089111ec3d2d9ea865fe646be86",
      "text": "Bapakmu dokter, ya?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "8aa63f2ad4ee5d737ef361bc5307aef8b603ef6fb95b349338ca96f3b4df75f7",
      "text": "jeneng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cd42a5687c5c40bb43f1e1ee0986309e798d893a3a4d0267cc8e462f1818205",
      "text": "bocah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ce056b5f45938aabf0c36396528be3d288373f039d955cac96c0d14679dcb4f",
      "text": "Jenengku Yudi, aku wong Jogja. Mas sinau apa?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da23b952b238fdd4ce1a5db3fbfd2e39ae5267e5716fef6254e548fb78e1eeb",
      "text": "karo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f30e8f3eac4b9e1b77487b56dc8831214409a91c96fbbc0d68991ba75c1c69a",
      "text": "Apik. Mas wong ngendi?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8889e7bcfeb1ef9a6eead2e3f06c6bd6e1723999759cf765319a819a17469b",
      "text": "Jenengku Yudi, aku wong Jogja.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "90845afbeb2ddba86faafe043a020862b7893ce15a2325cd11de91ee1e75148c",
      "text": "Aku krungu ukara Jawa.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "94c02a2d8aa63e4abc165e3cb97e19ac283aef2ee31a18457a00ac555d913dc5",
      "text": "bakul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "950aa9032b38785dad0c00d28e047dc317bc0ed31bd16dce3237b04126031d74",
      "text": "Apik! Tak gawekke maneh, ya?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "97fc9710b93cb441c39736ac7159e81bde8363b8b3dddb1057e5b943c2b9b6f4",
      "text": "Mas, kowe saka ngendi? Kowe guru?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "992807a12b9371b1bfbf78783a96e0a7f2a3880ffd2715542685568c2094c94d",
      "text": "ndi",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a921a4a3326064e4cd5039dbc38cc0d53e18ceb770b45eb800f692845526cea",
      "text": "Sate. Murah, Mas!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bddd81e0247d89e13b0251918ffe6311c31eb34193789ec3658c60ba41ee904",
      "text": "Kenalan, jenengku Yudi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d51da39019777ab30c8c3b6342927c6c44b278aeadfd13a89ba468e588e2682",
      "text": "saka",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a10717011f1a3cb9324ec2979759bc0090e0a90dba017dc9243e2cff1748c823",
      "text": "Dheweke guru basa Jawa.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a165e43d1e807e1bb7f34bc47866f521b1d558915b5892e852aff58d9bc5437f",
      "text": "neng",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2b2b4ba418c56c3e81934712c719a3952f29e013047ebb07d49c3a27fafb7ea",
      "text": "Mas Yudha nyambut gawe neng kene, ta?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "a31da80f9c42adf516c27b7ce0fdf4a727b7bc486c2102b1f020b6a121b032e5",
      "text": "Ayo ngopi neng kene!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "a49bd1e87cce8605be25cccf4383a42a9ecd4cc3377e21465a24bc9e756af4a2",
      "text": "nyambut gawe",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a636f88c254e8bc17b2f1e82d4a34cb7876a0bdfad285d2f20045813f1778ffc",
      "text": "Jenengku Mohamed, aku wong Mesir. Omahku ora gedhe.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6cf1d51d68e386e846e8fedecc0f5b4c5f10b8e5d42dcbb5c26e2eb71e44a1e",
      "text": "Ngapa kowe?",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85cf63336b748bbaa9e57cd80592dcccd5460b3643389c6977c88ffe3b68c2a",
      "text": "Mas wong ngendi?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab0f578bc21240a005dd92bea4ae181e07b5541164333e4d62454f0c02a46c45",
      "text": "pitakon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae36dfb3d1ac8afcc34c93fba435b176251bd4136d8152c690f764b987d03b5e",
      "text": "pira",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae4966f529ca85dbe11302ac1d1751426a86fbd4625c1a3b10fed694226edada",
      "text": "Kowe teka saka ngendi? Numpak apa?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b414209b3d46a05876ed371f569d44c7d62f55f1f82170ec5f39edc2c0ae4cc5",
      "text": "Kowe gawe apa? Kanggo sapa?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5b408d3f710667dd6647a216daa542d00718ad0c7dab0506c9dacb5317d1230",
      "text": "Jenengku Mohamed. Aku wong Mesir.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b74a0e0f3a18782e6f4ea167052cae004187b538553f7d6dbe82fdc9a9090df2",
      "text": "Ki apa, Mas?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b787c62c8c743a43ba85acdfe7714ed6af7b3590f3763c64ac8c2dffc26da750",
      "text": "Kowe saka ngendi?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8e6eba310cc588404368a96ba61370e4878dbca6319cbe9d84b3ac4c9724624",
      "text": "Aku saka Kairo.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b97c20d83f9dc72a5d14f2cc682227e1bf234486670e26ada63ab8bf1066b45f",
      "text": "Aku wong Mesir, saka Kairo. Jenengku Mohamed.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb1b45246100f4bb2fe20b1d5cd09d152dd4dccbac7dffe99d052875022760a7",
      "text": "Pitakone apa, Mas?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd357ddd2c384ac7bf0ae4a9742e6d5d4a21f413d39c961aa5dbfa2905105597",
      "text": "Hmm... aku eling! Isin iku malu.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd7ac4386c8cade410f43874b691e62cecbada52a4b9480b4466bbfa7dbfaad7",
      "text": "Wah, pinter! Aku mahasiswa, bocah Jogja asli.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf89db4667e24b864e88cd9f6c7c2d9ddcb5db9a61310439bd84619f30dd5d61",
      "text": "asli",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c050016971c4648909ce874ea9d5caa7f32a2770fc42742f2ff89298acf9aa9f",
      "text": "Regane pira, Mas?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0618a7cd970beb7738548c25c656d4c42084120a8cac23677c22d89c32925a5",
      "text": "Omahmu endi, cah?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2328acde5d1a2caba3e5ad80497756085342c55c1b302d5892fe748bc65bb95",
      "text": "Jenengku Yudha. Aku mahasiswa.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ffc50e7efdf1ca2ed911a78e0d85f413f01b1b148fa58653e7f69ecd8229f9",
      "text": "tembung",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c388d3704a51554b65dfc78999a9856a028a901835a145b684caa1d74c05b09d",
      "text": "liya",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3fa5aaf9a415ef6801a801cb44116ed011dc7d4a5aa678f596ad04d852bf4b3",
      "text": "Ndi wong liya? Ayo neng omah.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c41cce270741b4e58c6a0f74be8df0c17755416417c0a6e7273df616fa9ba35a",
      "text": "Omahmu ngendi?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6e690b215e74f2a354b3e428cf215956fc6deb20602d387429147b74700601d",
      "text": "kanggo",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c765182d64fe95043ae963d453302253571120b9787fa6c94e3f8e4816ac5266",
      "text": "Wangsulanmu bener. Saiki conto ukara?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "caf9f599aa9213bcfb06d3b5823ba223bf59cf34a3b88aa0161efb82aa6f21c4",
      "text": "Iya, saka Kairo.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf96f017077b2c88d95020473828e7a816d4d23d00c42b01ab47afc9f4826aa5",
      "text": "numpak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d33e96f8002a0cb137a0ff20ca1f52f05e7c344282715c93a768fd837be8a1d9",
      "text": "Kancamu wong ngendi?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6e95041fd023192eab4748b6cf218669ef96cd8a5da9871d79462a799fb333e",
      "text": "warung kopi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a6d1baa30c1a972cb645fec48b15415c404a2fe57c8d431c5d8e90ca1d92ee",
      "text": "Kowe mahasiswa? — Ora, aku guru.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7f00f8612f85d6679ecf962c6d76cf3238ae655a8757550cb5cd8400fac9820",
      "text": "Apik! Kowe saka Kairo?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d94cabc85e57e6059f7eed4e6be4ffccaa2696537875e9b7650a9886c2be51eb",
      "text": "Mohamed. Jenengmu sapa?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd6ff931e05c9785a23975a036dd13aba97939afb1ac96eb0d3514f592c2dc31",
      "text": "Aku wong Jogja.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "def21fb953d6a2b88f0d3216d63001be0b96c2f4012fbf8aa7963d003f97af76",
      "text": "ora",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "df0487ab78c345b3c037f11c61c419aa967363534fdf4c1a7b0a893d361c546f",
      "text": "Kancaku nyambut gawe neng Jogja.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4ce5df92fc55999a78f575fc8b3e9a9fe5603fb4bdcd5cb72e8efda281abdda",
      "text": "kuwi / iku",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e52b2dd649b08947f772234a8af9782f3b881ac92fd8e4731009ed6f7fa6a631",
      "text": "Wong kuwi sapa?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6011dcc00b60c0a8b703cc50181adda30f9c31db708d3e890762c0c4ae390bb",
      "text": "Dudu, aku penerjemah saka Mesir.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "eacaa33da59d362f7787e5b8e90da235d3b108871d36399299dcb601662be11f",
      "text": "Aku wong Mesir, saka Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb2d0d5f2fdda6d9ff67bef419e1e2a85d6ad8b751226feed3f2c1b650ea37e4",
      "text": "Mas wong ngendi? — Aku wong Mesir.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee2e73336eb36f221536af4dcd0cf0637a9beeee2fb156b1f820e0b78eab517e",
      "text": "Aku neng omah karo kanca.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb8029f42d079c3513f140a75abaeacc5f382b459e0cf947ae76a20e22792a1",
      "text": "Aku krungu pitakone.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
