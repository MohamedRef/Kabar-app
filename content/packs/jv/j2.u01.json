      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e8f96038f732cf22ef7c0464020129d8297dc877885670fe1e84f05f75532d",
      "text": "Bapak lan ibuku neng Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9cb8deff93cb8878b9cafa558310ab53ed60140ed106af0d1f663e156410c45",
      "text": "Kamarku cedhak jeding.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "db575c0e920ae106e5bd93f7bdcfd5209ed52462115eaa106eac2861c46d0edb",
      "text": "Fotone apik! Kulawargane Pak Budi gedhe!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "de1775dda7ffabab5c6aed0eaad292754494a0ce050903f319a65b12ce127e4e",
