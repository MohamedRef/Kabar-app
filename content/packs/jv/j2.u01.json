      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "abd5b89917b89c319d6c851eb8629ee4123309474156f68d4747f01a21bc0c1e",
      "text": "Apik ora? Iki kulawargaku.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7c5656f93c745f9772a02f1953b529d0f1e0d54423e169d80a4a17fa68eff6",
      "text": "Bayu ragil, Bu?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "addd30075fb3e6546682aaa71069f199fc340048b86b90c1a21d5ee52c8965a3",
      "text": "Iki bojoku.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b157e62e509532d41ac5720951c2b8323f28cb545f8c929f2d439e75b24171e4",
      "text": "Bapakku nyambut gawe, ibuku duwe warung.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b37bc76600e7d7b005d610119be8cf149f0f9b1106e6aaf0de98cdf1ddd6c3f0",
      "text": "Pakdhe karo budhe manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b39aec0c833153f5054b89dc092d9fcd71e1b8fee4688a362de62a9f8d141709",
      "text": "Jenengku Sari, aku saka Madiun. Saiki aku sinau neng Kairo.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b54268a2288606e82cd9282a050b36fdf0f845e268482b1f84fc2232a94d525f",
      "text": "Regane pira, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b58a971a202062e0d880e0a694336c7814c858573712476728d58ea62631f1aa",
