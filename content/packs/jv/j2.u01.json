      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d31b4e5e4a8e5f019f6cd8fbec358a02a78423cf22f1276df8fe165f54f8c6cd",
      "text": "Bapak ngadeg ing sawah, Ibu ing pawon.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d35a6f0df6ac60cb70778044c2703c4e4b06655ac9eb8a78e0308eb75c662544",
      "text": "Iya. Lha iki ponakanku, isih bayi. Lair ing Solo.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59d7c76f079a0a5cd29d0979d6dff75ef8e8b320c20f029792230bf04683034",
