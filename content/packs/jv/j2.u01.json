    },
    {
      "id": "j2.u01.l06",
      "sha256": "6c18f1cec50cc0de34d02c8b2e8c65e339e10e2b6ca0924dea017a553ba2c9da"
    },
    {
      "id": "j2.u01.l07",
      "sha256": "c5eaf4b11cfc5342ef7c2a6ceb232a1bffd98dce53859681c6b4d648bf495d6e"
    },
    {
      "id": "j2.u01.l08",
      "sha256": "7d564e59d022170690dc32f6d1b0b578504512a0a02c637a5628810633be84ba"
    }
  ],
  "audio": [
    {
      "key": "010a4e4cad318d4a64deec6879973422f52ce58b6a3c420bc107b46e62f60ad6",
      "text": "lungguh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "01cf9e8254182407238e6acdfa9de1b866527ce7d42928e34d2e0f9d310bd1df",
      "text": "duweke",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "03024a2be9a46ff3fb883c721b6425640022d8d9d1594b44e4c7330d472c13be",
      "text": "ponakan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0378b76da62a038348c9691746fee1d3849bbcb42289b2cbe4b595af9807898d",
      "text": "Bapak lan ibuku manggon neng Madiun. Bapakku duwe warung.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ab8df7ef0fba0b19843ac7b539bb829a7032bde9149c336c8cf7b91a5de22fc",
      "text": "Kuwi bukune Sari!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0accad787d90feb67f3675f5106f622924ca307d1371474e9845e22688e249a1",
      "text": "Dhik, ayo mangan!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca2a160afb60f0626a09ac3ad266ee3c121a433daa3ae09efe37e10802fd004",
      "text": "piye dhe",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "112a0a1af666f2833e37fc87353e2eb7bd8e58fc29ac422ce04fa3d1a85841c1",
      "text": "kamar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "143cbc733b080343a2dedb9306108c88791b474eee19480b69ee4cf798242a68",
      "text": "Mohamed, kowe duwe adhi?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "15fe4f539151e80f39ed99376f32e495ea9bdb9aed3aabe4959197929673a25c",
      "text": "ilang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "178c51794afeeb5764e569cd669b2764089b328f0ee9ff52c95e829dcc745cc2",
      "text": "Mas Mohamed, iki bukune sapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "18e082bc09f14b9dd2fb24f35249fc2063860d19bd1afd0a696b976e21007c11",
      "text": "rabi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a4daa1b7e4dc6d0bb6605a89f7862436831cd1a0fdb1f108569a9b5891125f6",
      "text": "Bukune Sari? Buku apa?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ab56ffce1dfde1e431156690b2ff3119a83cb249d7a64b7ccae16eae45df4cf",
      "text": "Bapak lan ibumu neng Kairo?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c8cc3c41ff6a9ba9b819072fd2938db7f079a5e02113b42be803875d2c903f1",
      "text": "Duwe. Aku duwe adhi loro.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d0e7c7329256dc56d77ef32d94b077779fd74d64369212056a23cee317f92f1",
      "text": "buku + -e / -ne",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d669352e19e2375439aee685acbdff3bde2ac62e5a0961c29f3a5c3e430bd5b",
      "text": "Iya, Bu. Aku kancane Sari.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "249852196fc61d9c654886cf5becc2d68618238ff77d4395b9d205a7b1a17d41",
      "text": "Mbakyune Ibu rabi karo wong Solo?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "25ab23c3ee604a5dbf39c480a59bb4f7cae66ae434aa3db8e99cf94fb58c7ccf",
      "text": "Omahe Pak Budi adoh.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c223f9c0e9a396fe73e09bfb734c44bdb375e1ca4d44e099c7c94b75cbc3dc",
      "text": "Kuwi mbakyuku, budhene Sari.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f7e6000030057f3340f944cc47f3c3d8fa0dfc093b7a1aeda3c929e958963b",
      "text": "Sari iku anake Pak Budi.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a383d4a8f0dd76a1e568f2cbf73633c469ba21fc30d197b2fc5e8438b9eff6e",
      "text": "Iki bojoku, lan iki anakku.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b72f2956f3cf040fe645d9f403eb7a8771ee550a7a5ec31844d5ba23c7eb57c",
      "text": "Bapakku duwe warung.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "3013d416b1e7b65e4b16dff0c104b6cd9de4f8bd91b68698de4472ef79afbaaf",
      "text": "Ing pawon karo simbah. Bengi iki kowe turu ing kasur anyar, hehe.",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "30c722fa7f1a0ff617b1e22a4b2f4ac6bcbb5a593a691407babc325e110cc91e",
      "text": "Kulawargaku gedhe. Aku duwe mbakyu siji lan adhi loro.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3bf6a5fb1fcf227bac6d4c2af31c3bd65b71fd3b5748a8148c8e49ea33329a",
      "text": "saiki",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e94d3fe81f142fca73c48b03301a8ea68d8f7804880cb8dac568ca5c9feadeb",
      "text": "Iya. Iki aku, iki bojoku.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea9f184f648d6bcf5d01412ef53afddba2afd3d1ceec152e0dd221355a9a7a4",
      "text": "ngadeg",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4098a9202568b6ab18572e794171196a68eb868116a0d193d0e56aea0c170bd1",
      "text": "kasur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e400dd01fb27d01f2ed2e59f5d8deea534474324a5e78781cc166a274827ee",
      "text": "Iya. Bapak lan ibuku neng Kairo. Mbahku neng Aswan.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4831323dee66ce274f3831932ce862a88c6ba881b64a0bdda1c47c42e4535f90",
      "text": "Kulawargamu gedhe! Kulawargaku neng Kairo.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c8f3ecb516b2242ad835cac8eae1d6562085f40eb2909c61df9dd8b22480a15",
      "text": "tangga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d66663ef905e5192cd49dcadbcce9a76df39f6ff4bbd3eea0471df31c690235",
      "text": "Omahmu neng ngendi?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de8158285b5728c65c13955932f525e5ad0a7bf8fe925696b7789a96927735e",
      "text": "ragil",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e834bf4643e61ad1a082d50d63f00f3425c6c134acb4bbb9a1c29bb26e37c3b",
      "text": "putu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f47da0307c1a10384038f29bb0d9e47412d8dfea6da763e279dfcf630da687e",
      "text": "Saiki kowe kulawarga neng kene, Mohamed!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e93967011ef225db87e7cd1593a3f658b5b156e77df016cc31c3b367cc6660",
      "text": "Jenenge sapa?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "532db1ce47e2f5d3d39041a7a7c8d28ab445b83f77cb2c505a81d9165da65fd4",
      "text": "Mohamed, iki bojoku, Bu Rahayu.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "56f6b47bff262b9df03eec45b554ed9d019cdd475843f0440a78a9ea0cf6dd0e",
      "text": "Mas Agus, Bayu lan Mbah putri manggon neng omahe Bapak.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "58afc14345f9afa4a7b6a5fef0da17bb26d783ca172798cdff1f6304efd1d4e0",
      "text": "Sing iki sapa, Pak?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b15d66251f41bbb999693922baa84bb01cd72981e63be568f351383e1bb5fb",
      "text": "Pak, iki fotone kulawargane Pak Budi?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "598a2b1ceb99ee6f9d76d9e2a74e506423f3298be14989527519456d6a3e85af",
      "text": "manggon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a12ebe8652478de2c73d1ae2eaaac69d910f760ad6620eee9020768d3efa457",
      "text": "Saiki aku sinau neng Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bbba65043fbd357fa670b2b51689ad1b0c8594af11848a320c5bb70a0ea034f",
      "text": "Mas Mohamed, iki foto kulawargaku. Sari anak mbarep.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ddbd3695c629dcf6b9e149f220d35d695fb3256bc03978c4ddfb9d3470c69be",
      "text": "Lan sing iki?",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f49b5e09142ba98566869ee941acff9572071ebc9cb93bf18b1e57c47f53643",
      "text": "adoh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "613285e1e501142c519df059fe4cb49ee6e7a9a21400a8acf9e535b3f2a850b6",
      "text": "Lungguh kene. Kamarmu ing ngarep, jedinge ing mburi.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "66fb1d2736e5fa91d28866aee2943132ae41ebd02f369f274ed17495e5ea6389",
      "text": "Warunge Pak Budi neng Madiun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a061ae05715e57111f56f56f8b47f8db4d567a4aa3aa7749bfff5c17de4dcde",
      "text": "Jedinge nang mburi, cedhak pawon.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bd8bfcc74019870872401cdf4ee3a9a8bfffad17de23216c4216b69fbb586b3",
      "text": "Sedulurku manggon ing Madiun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dada9de6e03db3b7a334c02ef7566b238e162d8cc044073d39fe9452615cad7",
      "text": "jeding",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ee6e433c3509691af59b383bb8eb4836a291623506897d480e04f351ec74e59",
      "text": "Pawone cedhak jeding.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a3f4792bfb320b7aedfa68b4012ade4915cfb12842476e7d43e91f2b764fda",
      "text": "Iya, Dhik. Aku duwe adhi loro lan mbakyu siji.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "73d1a1084c98077b8584b64d11db8e3f36826fe425ed32033fb9675a3984b142",
      "text": "Masku nyambut gawe neng Suroboyo.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7448e47de47a7b64b219120ccd5c7a07c8869fff57fa5089bad2b137cfe26253",
      "text": "Ana wit gedhe ing ngarep omah.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "766b6a0a879bb5a9f6bf846f8955cc7da4e598d43122f98bebaca2f2773dd55b",
      "text": "bapak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "77540cf55ab873aca14f161de52ac08f2669a937f79ecd424cb85a93f6433476",
      "text": "Paklikku manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "796bf20173143d42cdcd1eb027d1ba0f97dd5269b8cc0e0e8b0d13bf6a6a3856",
      "text": "ibu",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f4c0c4f3b467c01abba6ea632727ab6e73747bf54641d7ed1744ecb2bbca8",
      "text": "Jenengku Mohamed.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b776b14e1db851398f9276d362e20b6d65083518bc31d1a235aba4df20a4071",
      "text": "Bu Rahayu ngendi, Pak?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c3988ed245cfeda1c55a2d41936fad014b09e889d3622ecce3d3f92b99eb6de",
      "text": "Dudu bukuku, Dhik. Duweke sapa, ya?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dea5a66214bc3d46c5c5d4d8348f38f2a6d1f414d555eaa963747c4993e98d4",
      "text": "Aku duwe mas siji lan adhi loro.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "842c86d5d4d546b7d4828396c3ce81f47953a2535d04775d0aba748b2daaf2b2",
      "text": "mbarep",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "842d106fd181adcb27857909a7bed468c563b3d97be30ad8e30415a0247bee34",
      "text": "anak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8567bf445b95196987958707ddde541ea34ec2314ab15d9ecd933e32a802497f",
      "text": "Ponakanku isih bayi.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "8964197821d50000f890fe95fc22e200b21994979214c35733a43722fe32a680",
      "text": "Simbah duwe putu lima.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8989a2cade00f2e97b83c08d9557592429cd72204458cd0a807e743b72135b92",
      "text": "Apik! Mbah putri manggon neng omahe bapakmu, to?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e854a2de3a7c27e485f5762729e6edbae11060ca366596ae6ce75e3d51ee7d9",
      "text": "Monggo, Mas. Iki omahe simbah ing desa.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b59e1cf5710ba714b7ddfde73f7c955d1fcfd2cd81c1fcb5a957ef2b4e5331",
      "text": "Iya. Kulawargaku neng Kairo.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "93bc2c4050772cbf8e18b1a0b633a1d61de016900edaee11c150d5662e6b5a70",
      "text": "Pakdhe karo budhe manggon neng Madiun.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "93c2afd105068a3202f97b57a989d2579c2af2e9af05e02bd739757b20860520",
      "text": "Iki duweke sapa? — Duweke Dimas.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a08caa4841ed285613889ce29fee6f4c5f922749e1b90a993156c1eedb64869",
      "text": "wit",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c6ee10bab7847f81533e5752602eb39861f8fe85c8b21e92c56fd0791121926",
      "text": "Kuwi Agus, mase Sari. Lan kuwi Bayu, adhine.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d6776cae8aff15a772538b4f86d250903f9443ce6f966038dd3530177f87440",
      "text": "Kulawargane Mas Mohamed neng Kairo?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e3dba60571bb129d38cc511542668711ccfff02f698df6075327542059085bc",
      "text": "sedulur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fed1e071e0e3915148cc45f9f77b2363fea6ba366d4d776c8b1a209f1c78bdb",
