    },
    {
      "id": "j2.u01.l02",
      "sha256": "c6e3bc9224a45edc176ec7d7cebb12c3944aafb3634552873e330d704326618b"
    },
    {
      "id": "j2.u01.l03",
      "sha256": "26e9c88af73cb0e6dbbc1f9f0c2fa1d821fb1e2de94baac7061754f3237389f0"
    },
    {
      "id": "j2.u01.l04",
      "sha256": "78fb4c4d2b6ca9f1af784bb07934b236929a6d78f18eaf387e4288c3753d54f0"
    },
    {
      "id": "j2.u01.l05",
      "sha256": "327d35bd25ed61b1e662a3bb5550af7b5964a110761dfe3a87a218a75c89c6f4"
    }
  ],
  "audio": [
    {
      "key": "0accad787d90feb67f3675f5106f622924ca307d1371474e9845e22688e249a1",
      "text": "Dhik, ayo mangan!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca2a160afb60f0626a09ac3ad266ee3c121a433daa3ae09efe37e10802fd004",
      "text": "piye dhe",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "140e0ef5e6e3d0c0f91e76c3fce1a2d5030fc93eaf177c1ef6e5ca9245749509",
      "text": "Iki Agus, masé Sari. Lan iki Bayu, adhiné.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "15e929467b022789e422768ea1885be6f739e7f1749b181c8b44a752a487e90c",
      "text": "Kulawargané Pak Budi gedhe!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "15fe4f539151e80f39ed99376f32e495ea9bdb9aed3aabe4959197929673a25c",
      "text": "ilang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a74c7d75ae0fd967b44f5ea0eb5a0361611510d888efd492c923bb61f931df0",
      "text": "Bukuné Sari ilang.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ab56ffce1dfde1e431156690b2ff3119a83cb249d7a64b7ccae16eae45df4cf",
      "text": "Bapak lan ibumu neng Kairo?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "239b5db152754b5eec3ad3ddc51759505901f673719c091c00ba45718e6bbf4d",
      "text": "buku + -é / -né",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "25ab23c3ee604a5dbf39c480a59bb4f7cae66ae434aa3db8e99cf94fb58c7ccf",
      "text": "Omahe Pak Budi adoh.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "25e18ab4dc3eff916fef90f4f9afa6b92fccd499c8d8fbedd6b68ce50cc4ef1a",
      "text": "Masku nyambut gawé neng Suroboyo.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "25f0998d81871d89483e2df61fb3a48eb2b6ff668bab888e2a8e0ce282f590b3",
      "text": "duwé",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a383d4a8f0dd76a1e568f2cbf73633c469ba21fc30d197b2fc5e8438b9eff6e",
      "text": "Iki bojoku, lan iki anakku.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "373ce0c28f405a9afc907cdb65e2abbfd5ffccfd6aae404d285c0c7d8ef8cb6a",
      "text": "Iya, Dhik. Aku duwé adhi loro lan mbakyu siji.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3bf6a5fb1fcf227bac6d4c2af31c3bd65b71fd3b5748a8148c8e49ea33329a",
      "text": "saiki",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e94d3fe81f142fca73c48b03301a8ea68d8f7804880cb8dac568ca5c9feadeb",
      "text": "Iya. Iki aku, iki bojoku.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e400dd01fb27d01f2ed2e59f5d8deea534474324a5e78781cc166a274827ee",
      "text": "Iya. Bapak lan ibuku neng Kairo. Mbahku neng Aswan.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d66663ef905e5192cd49dcadbcce9a76df39f6ff4bbd3eea0471df31c690235",
      "text": "Omahmu neng ngendi?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e834bf4643e61ad1a082d50d63f00f3425c6c134acb4bbb9a1c29bb26e37c3b",
      "text": "putu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5077499c0d3870cd9d7135d89d129055fcd85841cffb69b3323f4c297cc8fb8d",
      "text": "-é / -né",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "51142ba8daebbf77ad3e87146d127c8d5b250c925362047a02eb1a0f4091bab5",
      "text": "nyambut gawé",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "513a1d06d33d5e73b90ace7aa56783d4ee449c5c329f3f18161695dc46d81a51",
      "text": "Kuwi bukuné Sari!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "532db1ce47e2f5d3d39041a7a7c8d28ab445b83f77cb2c505a81d9165da65fd4",
      "text": "Mohamed, iki bojoku, Bu Rahayu.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "575c913e9266b435df6c14fa63f0a6016adaf059969593726e4eb00e8f1a12d9",
      "text": "Lan mbah putri?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "58afc14345f9afa4a7b6a5fef0da17bb26d783ca172798cdff1f6304efd1d4e0",
      "text": "Sing iki sapa, Pak?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "598a2b1ceb99ee6f9d76d9e2a74e506423f3298be14989527519456d6a3e85af",
      "text": "manggon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "59a82c186cf8e450cacb7c9dd068339409a1b6b41cd72a3ead8ad79a519426ae",
      "text": "Kuwi Agus, masé Sari.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a15a07a76afdedffcb32424f261e2c324dcd4f37b1b155d08636714fe9f5c15",
      "text": "Aku duwé mas siji lan adhi loro.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f49b5e09142ba98566869ee941acff9572071ebc9cb93bf18b1e57c47f53643",
      "text": "adoh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "615a2f0eccdddfaa9956ab1ddb74e6a0ff25891512541d59b75956c8ad0d288c",
      "text": "duwéké",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6246d0f03e8c5f0548c91463b3dd641738828f556a62d78252d397c967874304",
      "text": "Iki duwéké sapa? — Duwéké Dimas.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b23497a8e52f70fe1da25e87198d7c8f5f3f85fd771dc7d53ebb0815ae9b688",
      "text": "Kulawargané Mas Mohamed neng Kairo?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "74964889292bad2925c60c8ac3e6a19d724a06fe9ef227a1e9574dc9aa05d719",
      "text": "Aku duwé adhi loro.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "766b6a0a879bb5a9f6bf846f8955cc7da4e598d43122f98bebaca2f2773dd55b",
      "text": "bapak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "77540cf55ab873aca14f161de52ac08f2669a937f79ecd424cb85a93f6433476",
      "text": "Paklikku manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "796bf20173143d42cdcd1eb027d1ba0f97dd5269b8cc0e0e8b0d13bf6a6a3856",
      "text": "ibu",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f4c0c4f3b467c01abba6ea632727ab6e73747bf54641d7ed1744ecb2bbca8",
      "text": "Jenengku Mohamed.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f443b51a46256ec9f9101c99a13e5b253e0b9750e1c2f3a0766a5216b234305",
      "text": "Mas Mohamed, iki bukuné sapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "800358c1bb28ef9ecf73518ad58446e510e7713167e8be37ef63acd2f4f1dfc6",
      "text": "Kowé kancané Sari neng Kairo, to?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "842d106fd181adcb27857909a7bed468c563b3d97be30ad8e30415a0247bee34",
      "text": "anak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "87ee3da474164e3e55c9b3edee475b37da4c9f6939a3a3a8149508adaedf8b30",
      "text": "Pak, iki fotoné kulawargané Pak Budi?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "904fb5f795c6c0eb956ea4778ed78db7cff76d96665d432e1ffbba2b6f257742",
      "text": "Bukuné Sari? Buku apa?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b59e1cf5710ba714b7ddfde73f7c955d1fcfd2cd81c1fcb5a957ef2b4e5331",
      "text": "Iya. Kulawargaku neng Kairo.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "93bc2c4050772cbf8e18b1a0b633a1d61de016900edaee11c150d5662e6b5a70",
      "text": "Pakdhe karo budhe manggon neng Madiun.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9768fd8fee05d695b81fdd9898fac3c509d3cf7c8325103d7cd9b1e2deebe2b8",
      "text": "Jenengé sapa?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "9de27ee61ea31f0142c930cdf16b90b1134b3d6a75da52e59cde1fbac09f76da",
      "text": "Kuwi Agus, masé Sari. Lan kuwi Bayu, adhiné.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2b6be19033c3218c578fbc938f3f4cd18223bc6bd7b175d5afa1effc3fb2d1b",
      "text": "Mas Mohamed duwé adhi?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2d7fc93c2017d17375678774621777db2feb9c687a5bfba51c4c6fef4bc1c7a",
      "text": "Regané pira, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4e9f897c20ecb4d87a6a330f2d947058a387db455ea948d85bf89f8b65d7b6e",
      "text": "Mbah putri lagi masak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5e718a9c5f309e372c589d88ed410a47eb956c47f4265a7594218ea3af6c025",
      "text": "mbah kakung",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8ba691f053a1e98712492bb97b4ec01a3b2fa7e51804e12ecf3e64e51a32010",
      "text": "Iya, Bu. Aku kancané Sari.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf376c33e1e256bb6e05ed008a119188ab251cecb055d1d414944592c4284bc",
      "text": "foto",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "addd30075fb3e6546682aaa71069f199fc340048b86b90c1a21d5ee52c8965a3",
      "text": "Iki bojoku.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9ff3da83bef9a4adb526e657efb12e0b7a81ea900d30d548bacaaf412b2690",
      "text": "Mohamed, kowé duwé adhi?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2c16379f7119ec24c3dafee7dd02b59f5b3c715886d071f70062e9e1dc93928",
      "text": "Sari iku anaké Pak Budi.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b37bc76600e7d7b005d610119be8cf149f0f9b1106e6aaf0de98cdf1ddd6c3f0",
      "text": "Pakdhe karo budhe manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b58a971a202062e0d880e0a694336c7814c858573712476728d58ea62631f1aa",
      "text": "bojo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc104c18a6122e06c4e3381b59c5f4a2be136fb071024a484f37850f8406f886",
      "text": "buku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf5782a0d6eb178d7333871010f85a0c44fd6a39ba3cb0640cad3b7dc0680061",
      "text": "Buku basa Arab. Saiki Sari sinau neng Kairo.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3481cba9fac3e33fdfb32b1fc281528b8ab6f375716c3ab921650555d1080ae",
      "text": "Duwé. Aku duwé adhi loro.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c760d9d8d9bd3e8b60b8598c2caf3579d42f1a96bc0a9a70658fa141874229c3",
      "text": "Mbah putri manggon neng kene, karo aku.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7124a3a22f748ee224193969e5afde5bf3fb8eda601431646b444eb6607f831",
      "text": "Warungé Pak Budi neng Madiun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d743909490010f441a1fca4bcb15c139cc2aea94884e13b4620b82ee01c8d2c6",
      "text": "rega + -é / -né",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e8f96038f732cf22ef7c0464020129d8297dc877885670fe1e84f05f75532d",
      "text": "Bapak lan ibuku neng Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "de295224236864513dace22ec2cff23944532ef7ec6ed572eef257bb70fbf2e5",
      "text": "Dudu bukuku, Dhik. Duwéké sapa, ya?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "de6f095c0a3287f0d7318f8a61066fc07543eb2d0c7683c6c711bd41b6c6ad1f",
      "text": "Saiki kowé kulawarga neng kene, Mohamed!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "df9dab61d7013b5eca2ac90b889ae82bfaff1958d03d13e45d31145c97863a3c",
      "text": "mbakyu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9a90ab0e37849c5e8e3e6167ffce84a407926a8c013c5b7a3a8a5aa043bba15",
      "text": "Mbah putri manggon neng kene.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed59c6520aa16bba848e792886518e70c1c5e89ed2b776388ac4b65e8668446b",
      "text": "adhi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeebbf4b52554eac8c0e365fd764b265091b67c6c5c28268b777d35d5e91ba13",
      "text": "paklik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef342de5798af2568d2a2731e1cf45c58997b692b0112d9dda2fc4ce385f8318",
      "text": "bulik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f03f25b47b311d4c99aca0730b14eb5d3d4dee37523c4456a4e879fa94beb40a",
      "text": "mbah putri",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f21c6151aecf06c9504419c38abe5d59d939e6b0f741aaf275d2c1782d1696ee",
      "text": "simbah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5b9b7f0a31ed74ee22c944dea56f5c8c2303d46314a5eb464af049d2a18d289",
      "text": "kulawarga",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
