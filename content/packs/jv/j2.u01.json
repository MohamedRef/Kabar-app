      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63e282831a28094762109465101fc6eaad0f364e9f3966b9ec3ed1b4d000825",
      "text": "-e / -ne",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c698cc5fdb17ef6cff484de950f5c937806b050c049d3106673c2817b32d0c99",
      "text": "Apik tenan, Pak! Wit gedhe, sawahe ijo.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c96ef53b0252931394f2527d95d21dfade1b4c04ca1adbc5cea4a7a42201c62c",
      "text": "Kuwi mbakyuku, budhene Sari. Omahe neng Ponorogo. Mbah putri manggon neng kene, karo aku.",
      "voice": "jv_dimas",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa1764a6945e9f48e0c9200d7806e4b0cb954229b5858e49fae9027fa294cef",
      "text": "Kulawargaku manggon neng Kairo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb8e11d7669a024612ee373e6ec0af283e1219588eb3bff5fbbbb14bf3a7585e",
      "text": "Sari anak mbarep, Bayu anak ragil.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d12ed469ac40d9fa77d07a4181bb5a7ceaa4772bd5bbf9d9a7573a3f3390b53e",
