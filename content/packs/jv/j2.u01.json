      "sha256": "f5b17c28dd927d8ec3de0a2b1d1a15fcd5ee802e4d9206c7b403a7ae732f3f81"
    },
    {
      "id": "j2.u01.l03",
      "sha256": "fee17710396899b32772558c56cb3a89d9f86e7151b988d629dc7dc799e8416e"
    },
    {
      "id": "j2.u01.l04",
      "sha256": "fd9ee6724ebe4fc669d715b1087bfbbe2b4840e78eb139bbd8d5b34a07ecf01d"
    },
    {
      "id": "j2.u01.l05",
      "sha256": "2b27aec2f78869504f0db235b39de62d75eae55dddfc61e61a6be2f022295fd2"
    }
  ],
  "audio": [
    {
      "key": "01cf9e8254182407238e6acdfa9de1b866527ce7d42928e34d2e0f9d310bd1df",
      "text": "duweke",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ab8df7ef0fba0b19843ac7b539bb829a7032bde9149c336c8cf7b91a5de22fc",
      "text": "Kuwi bukune Sari!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0accad787d90feb67f3675f5106f622924ca307d1371474e9845e22688e249a1",
      "text": "Dhik, ayo mangan!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca2a160afb60f0626a09ac3ad266ee3c121a433daa3ae09efe37e10802fd004",
      "text": "piye dhe",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "143cbc733b080343a2dedb9306108c88791b474eee19480b69ee4cf798242a68",
      "text": "Mohamed, kowe duwe adhi?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "15fe4f539151e80f39ed99376f32e495ea9bdb9aed3aabe4959197929673a25c",
      "text": "ilang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "178c51794afeeb5764e569cd669b2764089b328f0ee9ff52c95e829dcc745cc2",
      "text": "Mas Mohamed, iki bukune sapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a4daa1b7e4dc6d0bb6605a89f7862436831cd1a0fdb1f108569a9b5891125f6",
      "text": "Bukune Sari? Buku apa?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ab56ffce1dfde1e431156690b2ff3119a83cb249d7a64b7ccae16eae45df4cf",
      "text": "Bapak lan ibumu neng Kairo?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c8cc3c41ff6a9ba9b819072fd2938db7f079a5e02113b42be803875d2c903f1",
      "text": "Duwe. Aku duwe adhi loro.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d0e7c7329256dc56d77ef32d94b077779fd74d64369212056a23cee317f92f1",
      "text": "buku + -e / -ne",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d669352e19e2375439aee685acbdff3bde2ac62e5a0961c29f3a5c3e430bd5b",
      "text": "Iya, Bu. Aku kancane Sari.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "25ab23c3ee604a5dbf39c480a59bb4f7cae66ae434aa3db8e99cf94fb58c7ccf",
      "text": "Omahe Pak Budi adoh.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c223f9c0e9a396fe73e09bfb734c44bdb375e1ca4d44e099c7c94b75cbc3dc",
      "text": "Kuwi mbakyuku, budhene Sari.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f7e6000030057f3340f944cc47f3c3d8fa0dfc093b7a1aeda3c929e958963b",
      "text": "Sari iku anake Pak Budi.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a383d4a8f0dd76a1e568f2cbf73633c469ba21fc30d197b2fc5e8438b9eff6e",
      "text": "Iki bojoku, lan iki anakku.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3bf6a5fb1fcf227bac6d4c2af31c3bd65b71fd3b5748a8148c8e49ea33329a",
      "text": "saiki",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e94d3fe81f142fca73c48b03301a8ea68d8f7804880cb8dac568ca5c9feadeb",
      "text": "Iya. Iki aku, iki bojoku.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e400dd01fb27d01f2ed2e59f5d8deea534474324a5e78781cc166a274827ee",
      "text": "Iya. Bapak lan ibuku neng Kairo. Mbahku neng Aswan.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d66663ef905e5192cd49dcadbcce9a76df39f6ff4bbd3eea0471df31c690235",
      "text": "Omahmu neng ngendi?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e834bf4643e61ad1a082d50d63f00f3425c6c134acb4bbb9a1c29bb26e37c3b",
      "text": "putu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f47da0307c1a10384038f29bb0d9e47412d8dfea6da763e279dfcf630da687e",
      "text": "Saiki kowe kulawarga neng kene, Mohamed!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e93967011ef225db87e7cd1593a3f658b5b156e77df016cc31c3b367cc6660",
      "text": "Jenenge sapa?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "532db1ce47e2f5d3d39041a7a7c8d28ab445b83f77cb2c505a81d9165da65fd4",
      "text": "Mohamed, iki bojoku, Bu Rahayu.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "575c913e9266b435df6c14fa63f0a6016adaf059969593726e4eb00e8f1a12d9",
      "text": "Lan mbah putri?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "58afc14345f9afa4a7b6a5fef0da17bb26d783ca172798cdff1f6304efd1d4e0",
      "text": "Sing iki sapa, Pak?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b15d66251f41bbb999693922baa84bb01cd72981e63be568f351383e1bb5fb",
      "text": "Pak, iki fotone kulawargane Pak Budi?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "598a2b1ceb99ee6f9d76d9e2a74e506423f3298be14989527519456d6a3e85af",
      "text": "manggon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f49b5e09142ba98566869ee941acff9572071ebc9cb93bf18b1e57c47f53643",
      "text": "adoh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "66fb1d2736e5fa91d28866aee2943132ae41ebd02f369f274ed17495e5ea6389",
      "text": "Warunge Pak Budi neng Madiun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a3f4792bfb320b7aedfa68b4012ade4915cfb12842476e7d43e91f2b764fda",
      "text": "Iya, Dhik. Aku duwe adhi loro lan mbakyu siji.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "73d1a1084c98077b8584b64d11db8e3f36826fe425ed32033fb9675a3984b142",
      "text": "Masku nyambut gawe neng Suroboyo.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "766b6a0a879bb5a9f6bf846f8955cc7da4e598d43122f98bebaca2f2773dd55b",
      "text": "bapak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "77540cf55ab873aca14f161de52ac08f2669a937f79ecd424cb85a93f6433476",
      "text": "Paklikku manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "796bf20173143d42cdcd1eb027d1ba0f97dd5269b8cc0e0e8b0d13bf6a6a3856",
      "text": "ibu",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f4c0c4f3b467c01abba6ea632727ab6e73747bf54641d7ed1744ecb2bbca8",
      "text": "Jenengku Mohamed.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c3988ed245cfeda1c55a2d41936fad014b09e889d3622ecce3d3f92b99eb6de",
      "text": "Dudu bukuku, Dhik. Duweke sapa, ya?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dea5a66214bc3d46c5c5d4d8348f38f2a6d1f414d555eaa963747c4993e98d4",
      "text": "Aku duwe mas siji lan adhi loro.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "842d106fd181adcb27857909a7bed468c563b3d97be30ad8e30415a0247bee34",
      "text": "anak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b59e1cf5710ba714b7ddfde73f7c955d1fcfd2cd81c1fcb5a957ef2b4e5331",
      "text": "Iya. Kulawargaku neng Kairo.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "93bc2c4050772cbf8e18b1a0b633a1d61de016900edaee11c150d5662e6b5a70",
      "text": "Pakdhe karo budhe manggon neng Madiun.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "93c2afd105068a3202f97b57a989d2579c2af2e9af05e02bd739757b20860520",
      "text": "Iki duweke sapa? — Duweke Dimas.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "998df341e84eff89ef87e68b9f37d9e350dd500f9d0984a4d0b02a5d073add7d",
      "text": "Kulawargane Pak Budi gedhe!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c6ee10bab7847f81533e5752602eb39861f8fe85c8b21e92c56fd0791121926",
      "text": "Kuwi Agus, mase Sari. Lan kuwi Bayu, adhine.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d6776cae8aff15a772538b4f86d250903f9443ce6f966038dd3530177f87440",
      "text": "Kulawargane Mas Mohamed neng Kairo?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fed1e071e0e3915148cc45f9f77b2363fea6ba366d4d776c8b1a209f1c78bdb",
      "text": "rega + -e / -ne",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a49bd1e87cce8605be25cccf4383a42a9ecd4cc3377e21465a24bc9e756af4a2",
      "text": "nyambut gawe",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4e9f897c20ecb4d87a6a330f2d947058a387db455ea948d85bf89f8b65d7b6e",
      "text": "Mbah putri lagi masak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5e718a9c5f309e372c589d88ed410a47eb956c47f4265a7594218ea3af6c025",
      "text": "mbah kakung",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf376c33e1e256bb6e05ed008a119188ab251cecb055d1d414944592c4284bc",
      "text": "foto",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "addd30075fb3e6546682aaa71069f199fc340048b86b90c1a21d5ee52c8965a3",
      "text": "Iki bojoku.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b37bc76600e7d7b005d610119be8cf149f0f9b1106e6aaf0de98cdf1ddd6c3f0",
      "text": "Pakdhe karo budhe manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b54268a2288606e82cd9282a050b36fdf0f845e268482b1f84fc2232a94d525f",
      "text": "Regane pira, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b58a971a202062e0d880e0a694336c7814c858573712476728d58ea62631f1aa",
      "text": "bojo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbd6353d609080b89cb06c6e2e48aa1d77f80716726f77542815d735ba11dff0",
      "text": "Aku duwe adhi loro.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc104c18a6122e06c4e3381b59c5f4a2be136fb071024a484f37850f8406f886",
      "text": "buku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf5782a0d6eb178d7333871010f85a0c44fd6a39ba3cb0640cad3b7dc0680061",
      "text": "Buku basa Arab. Saiki Sari sinau neng Kairo.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfa905ede5f33a2505b961b4f71129ff9a39214a9a6e0c2a724e130a44ac1856",
      "text": "duwe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63e282831a28094762109465101fc6eaad0f364e9f3966b9ec3ed1b4d000825",
      "text": "-e / -ne",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c760d9d8d9bd3e8b60b8598c2caf3579d42f1a96bc0a9a70658fa141874229c3",
      "text": "Mbah putri manggon neng kene, karo aku.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d12ed469ac40d9fa77d07a4181bb5a7ceaa4772bd5bbf9d9a7573a3f3390b53e",
      "text": "Kuwi Agus, mase Sari.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59d7c76f079a0a5cd29d0979d6dff75ef8e8b320c20f029792230bf04683034",
      "text": "Iki Agus, mase Sari. Lan iki Bayu, adhine.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e8f96038f732cf22ef7c0464020129d8297dc877885670fe1e84f05f75532d",
      "text": "Bapak lan ibuku neng Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "df9dab61d7013b5eca2ac90b889ae82bfaff1958d03d13e45d31145c97863a3c",
      "text": "mbakyu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e187811326bdd08fccb60dd8e08fa2caebc48b9b9ed2517f6c4c05295a8fa40c",
      "text": "Mas Mohamed duwe adhi?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7b093b3c8c56ab1770367e55d2e9ad39397422f495b1d253fb84aad471862d2",
      "text": "Kowe kancane Sari neng Kairo, to?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9a90ab0e37849c5e8e3e6167ffce84a407926a8c013c5b7a3a8a5aa043bba15",
      "text": "Mbah putri manggon neng kene.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed59c6520aa16bba848e792886518e70c1c5e89ed2b776388ac4b65e8668446b",
      "text": "adhi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeebbf4b52554eac8c0e365fd764b265091b67c6c5c28268b777d35d5e91ba13",
      "text": "paklik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef342de5798af2568d2a2731e1cf45c58997b692b0112d9dda2fc4ce385f8318",
      "text": "bulik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f03f25b47b311d4c99aca0730b14eb5d3d4dee37523c4456a4e879fa94beb40a",
      "text": "mbah putri",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f21c6151aecf06c9504419c38abe5d59d939e6b0f741aaf275d2c1782d1696ee",
      "text": "simbah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5b9b7f0a31ed74ee22c944dea56f5c8c2303d46314a5eb464af049d2a18d289",
      "text": "kulawarga",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa343a8dc0b110ded92cf6f0fe07932beb552ff42f1d15e81d9b91b29bfe9351",
