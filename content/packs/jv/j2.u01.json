      "mime": "audio/mpeg"
    },
    {
      "key": "e8c12e4e84cd5dac64180daadcec60f43c95c1d7a7bad6a304c57c959d666877",
      "text": "Paklik karo bojone manggon neng kene.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e952f533687fa558a34e63e8b106fba3afb1034bb975287509db1e7e0fe3d8a4",
      "text": "Iki fotone kulawargaku.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
