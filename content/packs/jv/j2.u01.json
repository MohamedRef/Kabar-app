      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a45d33a4859263497ae3067c65f657a167aa7ac717ecda9a445f5d28b8337b86",
      "text": "Iki kulawargaku, bapak, ibu lan mbakyuku.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a49bd1e87cce8605be25cccf4383a42a9ecd4cc3377e21465a24bc9e756af4a2",
