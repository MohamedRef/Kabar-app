      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc5932bccbf5066666a5a6d4d16371ae2302922f6289d2b782fc0cbda60e1935",
      "text": "Ponakanku lair ing Kairo.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf5782a0d6eb178d7333871010f85a0c44fd6a39ba3cb0640cad3b7dc0680061",
      "text": "Buku basa Arab. Saiki Sari sinau neng Kairo.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfa905ede5f33a2505b961b4f71129ff9a39214a9a6e0c2a724e130a44ac1856",
