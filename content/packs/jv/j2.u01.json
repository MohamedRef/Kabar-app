  ],
  "audio": [
    {
      "key": "010a4e4cad318d4a64deec6879973422f52ce58b6a3c420bc107b46e62f60ad6",
      "text": "lungguh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "01cf9e8254182407238e6acdfa9de1b866527ce7d42928e34d2e0f9d310bd1df",
      "text": "duweke",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "02f9baac2a994d45cfe235c8b977e95519bac136ef31987b3628ab5f3ab36188",
      "text": "kangmas",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "03024a2be9a46ff3fb883c721b6425640022d8d9d1594b44e4c7330d472c13be",
      "text": "ponakan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0378b76da62a038348c9691746fee1d3849bbcb42289b2cbe4b595af9807898d",
      "text": "Bapak lan ibuku manggon neng Madiun. Bapakku duwe warung.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "066ff766fe50e691bff26897a3ae3ffcfc2fe645cbc711f0803e34624f94017e",
      "text": "Sari, ponakanmu rewel terus. Kowe sing nggendhong, ya.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "087c1aa85577446ae5d983ebefba3ebe577930779f392d4abdda3e8ef39b3cfa",
      "text": "Bu Rahayu neng ngendi, Pak?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "0accad787d90feb67f3675f5106f622924ca307d1371474e9845e22688e249a1",
      "text": "Dhik, ayo mangan!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bbda2ce8ca9520a861cc2946774f89a0ac0f9cae8d0eb0253c770386caf6acf",
      "text": "Bayine rewel, Ibu nggendhong bayine.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca2a160afb60f0626a09ac3ad266ee3c121a433daa3ae09efe37e10802fd004",
      "text": "piye dhe",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "112a0a1af666f2833e37fc87353e2eb7bd8e58fc29ac422ce04fa3d1a85841c1",
      "text": "kamar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1152e7445b583b5d6bd8992aac21b0b7b1b768b0e8ba048c14a08fd528c544a4",
      "text": "Bapak karo ibumu neng Kairo, to?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "138163931a93f1b82edf8fbd38a60ca34259964a85447bb3507036b28a6d04c2",
      "text": "Sing penting kabeh sehat.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "1509431c00109dc6b5bf5e313d3171a16020ff432b6ac13d3270f45baa635e1a",
      "text": "ngopeni",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "15fe4f539151e80f39ed99376f32e495ea9bdb9aed3aabe4959197929673a25c",
      "text": "ilang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "172d22646c604e909e136490d5451e0f5ea4bb103d8a41542394be1c204f14fb",
      "text": "Saiki kowe ya kulawarga neng kene lho, Mohamed!",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "178c51794afeeb5764e569cd669b2764089b328f0ee9ff52c95e829dcc745cc2",
      "text": "Mas Mohamed, iki bukune sapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "18e082bc09f14b9dd2fb24f35249fc2063860d19bd1afd0a696b976e21007c11",
      "text": "rabi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a4daa1b7e4dc6d0bb6605a89f7862436831cd1a0fdb1f108569a9b5891125f6",
      "text": "Bukune Sari? Buku apa?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d0e7c7329256dc56d77ef32d94b077779fd74d64369212056a23cee317f92f1",
      "text": "buku + -e / -ne",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d669352e19e2375439aee685acbdff3bde2ac62e5a0961c29f3a5c3e430bd5b",
      "text": "Iya, Bu. Aku kancane Sari.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "249852196fc61d9c654886cf5becc2d68618238ff77d4395b9d205a7b1a17d41",
      "text": "Mbakyune Ibu rabi karo wong Solo?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "25ab23c3ee604a5dbf39c480a59bb4f7cae66ae434aa3db8e99cf94fb58c7ccf",
      "text": "Omahe Pak Budi adoh.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c223f9c0e9a396fe73e09bfb734c44bdb375e1ca4d44e099c7c94b75cbc3dc",
      "text": "Kuwi mbakyuku, budhene Sari.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a383d4a8f0dd76a1e568f2cbf73633c469ba21fc30d197b2fc5e8438b9eff6e",
      "text": "Iki bojoku, lan iki anakku.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b72f2956f3cf040fe645d9f403eb7a8771ee550a7a5ec31844d5ba23c7eb57c",
      "text": "Bapakku duwe warung.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c437833e40175b468774acab67d8c9bb784da94d6c9d6890663245d7da299c8",
      "text": "Iya. Lha iki ponakanku, isih bayi. Lair neng Solo.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ca13711c9383c9e3f561115d372d0368fa673c911243efdd71939c8cf87b3bb",
      "text": "rewel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc91d18b355803fcbe3be0d36f1161513112e5a780a61cb7a7bb69c7fcaa668",
      "text": "Iya to. Kangmasku malah ra isa, hehe.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "30c722fa7f1a0ff617b1e22a4b2f4ac6bcbb5a593a691407babc325e110cc91e",
      "text": "Kulawargaku gedhe. Aku duwe mbakyu siji lan adhi loro.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a7157bd0b80915847c669c0ac2a433679781163cb14b8fa39a500a4a5095a76",
      "text": "Anak wedok iki pinter momong adhine.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e94d3fe81f142fca73c48b03301a8ea68d8f7804880cb8dac568ca5c9feadeb",
      "text": "Iya. Iki aku, iki bojoku.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea9f184f648d6bcf5d01412ef53afddba2afd3d1ceec152e0dd221355a9a7a4",
      "text": "ngadeg",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4098a9202568b6ab18572e794171196a68eb868116a0d193d0e56aea0c170bd1",
      "text": "kasur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e400dd01fb27d01f2ed2e59f5d8deea534474324a5e78781cc166a274827ee",
      "text": "Iya. Bapak lan ibuku neng Kairo. Mbahku neng Aswan.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "43180fc4798ec0544c4c086c6e365afb1091852e9ab4ee7ac35b2a0a4e7c39b5",
      "text": "Mas Mohamed, tambah sega?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "4831323dee66ce274f3831932ce862a88c6ba881b64a0bdda1c47c42e4535f90",
      "text": "Kulawargamu gedhe! Kulawargaku neng Kairo.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "49d71640f27f84f1cf33e1bbe8a38483532bcd5f325eb9532cc04553506c590b",
      "text": "Aku melu, Mas! Sari uga melu.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c8f3ecb516b2242ad835cac8eae1d6562085f40eb2909c61df9dd8b22480a15",
      "text": "tangga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc6503331bd5e60ab06d59386556afbe7ee78e01834cc06033518b69ff649a1",
      "text": "penting",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d66663ef905e5192cd49dcadbcce9a76df39f6ff4bbd3eea0471df31c690235",
      "text": "Omahmu neng ngendi?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de8158285b5728c65c13955932f525e5ad0a7bf8fe925696b7789a96927735e",
      "text": "ragil",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e834bf4643e61ad1a082d50d63f00f3425c6c134acb4bbb9a1c29bb26e37c3b",
      "text": "putu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ff7386f029112e8a1877874a61bbc7dc73abf988db88970038731f37ebd9294",
      "text": "tambah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "52638f3ae3ebd2614f23e263e13b4b1c1e604972b883b59796d4c1d4d7597335",
      "text": "Wingi aku ngantuk banget, saiki wis apik.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e93967011ef225db87e7cd1593a3f658b5b156e77df016cc31c3b367cc6660",
      "text": "Jenenge sapa?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "532db1ce47e2f5d3d39041a7a7c8d28ab445b83f77cb2c505a81d9165da65fd4",
      "text": "Mohamed, iki bojoku, Bu Rahayu.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "56f6b47bff262b9df03eec45b554ed9d019cdd475843f0440a78a9ea0cf6dd0e",
      "text": "Mas Agus, Bayu lan Mbah putri manggon neng omahe Bapak.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "58afc14345f9afa4a7b6a5fef0da17bb26d783ca172798cdff1f6304efd1d4e0",
      "text": "Sing iki sapa, Pak?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b15d66251f41bbb999693922baa84bb01cd72981e63be568f351383e1bb5fb",
      "text": "Pak, iki fotone kulawargane Pak Budi?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "598a2b1ceb99ee6f9d76d9e2a74e506423f3298be14989527519456d6a3e85af",
      "text": "manggon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a12ebe8652478de2c73d1ae2eaaac69d910f760ad6620eee9020768d3efa457",
      "text": "Saiki aku sinau neng Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a3e9804184f3f22c98c9a0cc1e7a54fec9c269d1b3a3f86008cc2af2b9c2ff9",
      "text": "Jedinge neng mburi, cedhak pawon.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bbba65043fbd357fa670b2b51689ad1b0c8594af11848a320c5bb70a0ea034f",
      "text": "Mas Mohamed, iki foto kulawargaku. Sari anak mbarep.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ddbd3695c629dcf6b9e149f220d35d695fb3256bc03978c4ddfb9d3470c69be",
      "text": "Lan sing iki?",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f279b6b874e658d6d86053b2fb39ec1efa9f57a312a76dd846c038919b03c0e",
      "text": "nggendhong",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "61a14d5de551510079e9a2f580498265eadc10c1db44de6212bcbdd1108da9eb",
      "text": "Iya. Sedulurku akeh neng Solo, tanggane ya sedulur, hehe.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "632dfa7e855b3f9bb120177ab30848773a19d97c276bcf3dbefc20c6df27f015",
      "text": "ngelus",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "64e93854cee4cb367b3e799470dd3a226ee8f18047b985ff833dc837fe8b0e7f",
      "text": "Mas Mohamed duwe adhi ra?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "65a8400d290768a4da022209edee4fdf98c59817817c8fc4c4fc8658ac0131b9",
      "text": "wedok",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "66fb1d2736e5fa91d28866aee2943132ae41ebd02f369f274ed17495e5ea6389",
      "text": "Warunge Pak Budi neng Madiun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a20f9bc95a32b1a8ebb425751ceac71fdad2ba1d843aecf9735b715dae9fba8",
      "text": "Lungguh kene sik. Kamarmu neng ngarep, jedinge neng mburi.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bd8bfcc74019870872401cdf4ee3a9a8bfffad17de23216c4216b69fbb586b3",
      "text": "Sedulurku manggon ing Madiun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d63cf99bbd44a1ceba32f0be82977bb6906d3a10222588324138552c706d616",
      "text": "uga",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dada9de6e03db3b7a334c02ef7566b238e162d8cc044073d39fe9452615cad7",
      "text": "jeding",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ee6e433c3509691af59b383bb8eb4836a291623506897d480e04f351ec74e59",
      "text": "Pawone cedhak jeding.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a3f4792bfb320b7aedfa68b4012ade4915cfb12842476e7d43e91f2b764fda",
      "text": "Iya, Dhik. Aku duwe adhi loro lan mbakyu siji.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "73d1a1084c98077b8584b64d11db8e3f36826fe425ed32033fb9675a3984b142",
      "text": "Masku nyambut gawe neng Suroboyo.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7448e47de47a7b64b219120ccd5c7a07c8869fff57fa5089bad2b137cfe26253",
      "text": "Ana wit gedhe ing ngarep omah.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "766b6a0a879bb5a9f6bf846f8955cc7da4e598d43122f98bebaca2f2773dd55b",
      "text": "bapak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "77540cf55ab873aca14f161de52ac08f2669a937f79ecd424cb85a93f6433476",
      "text": "Paklikku manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "796bf20173143d42cdcd1eb027d1ba0f97dd5269b8cc0e0e8b0d13bf6a6a3856",
      "text": "ibu",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f4c0c4f3b467c01abba6ea632727ab6e73747bf54641d7ed1744ecb2bbca8",
      "text": "Jenengku Mohamed.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b98b6072e55ddd72a40d93ffb8d96f50b8cb0c39056aa6b1eab845926e19ccd",
      "text": "Melu! Bayu uga melu, ta? Mesthi rame.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c3988ed245cfeda1c55a2d41936fad014b09e889d3622ecce3d3f92b99eb6de",
      "text": "Dudu bukuku, Dhik. Duweke sapa, ya?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d50d7aefc9f47e86488ae43cb86dcea35a3715ed719b0694872344475bb70de",
      "text": "melu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dea5a66214bc3d46c5c5d4d8348f38f2a6d1f414d555eaa963747c4993e98d4",
      "text": "Aku duwe mas siji lan adhi loro.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "842c86d5d4d546b7d4828396c3ce81f47953a2535d04775d0aba748b2daaf2b2",
      "text": "mbarep",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "842d106fd181adcb27857909a7bed468c563b3d97be30ad8e30415a0247bee34",
      "text": "anak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8452e4d93ec6b8dadf528ab92d0a43c5cf733c1dc871c0204d406bc396697d56",
      "text": "Sesuk aku neng omahe Simbah. Mas melu?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8567bf445b95196987958707ddde541ea34ec2314ab15d9ecd933e32a802497f",
      "text": "Ponakanku isih bayi.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "87040b6c306b45c22c3cf17fbb6cf9bb157685654d29658d187372db44f308f9",
      "text": "padu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8964197821d50000f890fe95fc22e200b21994979214c35733a43722fe32a680",
      "text": "Simbah duwe putu lima.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8989a2cade00f2e97b83c08d9557592429cd72204458cd0a807e743b72135b92",
      "text": "Apik! Mbah putri manggon neng omahe bapakmu, to?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "90b817c9de96fa87ca40b312bf6aad69b2510ce646893b05bf93fdfd01a40f8c",
      "text": "momong",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9148a69eab910aa25c31d8e41bef190f39d69766afdbcc86bb57f8cd6d7e0633",
      "text": "wingi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b59e1cf5710ba714b7ddfde73f7c955d1fcfd2cd81c1fcb5a957ef2b4e5331",
      "text": "Iya. Kulawargaku neng Kairo.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "93bc2c4050772cbf8e18b1a0b633a1d61de016900edaee11c150d5662e6b5a70",
      "text": "Pakdhe karo budhe manggon neng Madiun.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "93c2afd105068a3202f97b57a989d2579c2af2e9af05e02bd739757b20860520",
      "text": "Iki duweke sapa? — Duweke Dimas.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "95fa19154bcf254406bae0584a81528d9851b92c8eb5c3c7cdf317fdb3ce243c",
      "text": "Lho, kuwi bukune Sari!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "9957e5f42a959f97f121c107436456727719a0fd23925139a511f0554fb3ea07",
      "text": "Sing penting sehat, ya!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "99b50c17fe67d17fd14390bd49234d4ce096776e407d21571649f00bdd31ee6c",
      "text": "Ayo mlebu, Mas. Iki omahe simbah.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a08caa4841ed285613889ce29fee6f4c5f922749e1b90a993156c1eedb64869",
      "text": "wit",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c6ee10bab7847f81533e5752602eb39861f8fe85c8b21e92c56fd0791121926",
      "text": "Kuwi Agus, mase Sari. Lan kuwi Bayu, adhine.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d6776cae8aff15a772538b4f86d250903f9443ce6f966038dd3530177f87440",
      "text": "Kulawargane Mas Mohamed neng Kairo?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e3dba60571bb129d38cc511542668711ccfff02f698df6075327542059085bc",
      "text": "sedulur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e97caa67953e59409dd28b316b52b1601f9bf4104f5a10879c0fe11522af2af",
      "text": "Aja padu, cah!",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f1a100b75bbac500292763bcf60ec181e7008466a46800ec6df370e940dcbe8",
      "text": "Sari lagi momong ponakane.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fed1e071e0e3915148cc45f9f77b2363fea6ba366d4d776c8b1a209f1c78bdb",
      "text": "rega + -e / -ne",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1cfda6dc462888b375940964f1afc9d2d83c8dc3d9d63dc30d922b68c3382ff",
      "text": "lair",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a45d33a4859263497ae3067c65f657a167aa7ac717ecda9a445f5d28b8337b86",
      "text": "Iki kulawargaku, bapak, ibu lan mbakyuku.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4e9f897c20ecb4d87a6a330f2d947058a387db455ea948d85bf89f8b65d7b6e",
      "text": "Mbah putri lagi masak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5874e633ef47d075ad0c7195d551ed7f8c719c8f29690f0ed04a89d092b3f1a",
      "text": "Omahe simbah cedhak sawah.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5e718a9c5f309e372c589d88ed410a47eb956c47f4265a7594218ea3af6c025",
      "text": "mbah kakung",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6d15c32eb4774c8086bc4f322977fda74ac36a83b4e8f24b5b1e5272916d9cd",
      "text": "Saiki bukuku ilang! Iki duweke sapa?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a738eb65d827ea5ea30748cc6fbf75cbbdf0f36126c7e727ba9c45d6822a343c",
      "text": "Wis, aja padu. Kangmasmu sing ngopeni simbah.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7965169507864f1decf59ba1f15df626489d149d72d2158d256f661989ec851",
      "text": "Wingi kowe ngantuk banget, ta? Saiki piye?",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7a7d741760054bcd6f718885c923cf3168d4658356ededd75c22704b27ddbb0",
      "text": "Sari, aku wis maca statusmu.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa92adf5fdf0d1addecb936b594ac8c8426e7434f4071a3ae916fd787bd3fb7c",
      "text": "Mbah putri lagi masak lho. Ayo mangan sik, Mohamed!",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf376c33e1e256bb6e05ed008a119188ab251cecb055d1d414944592c4284bc",
      "text": "foto",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab5eae2acffb4fc0e1a6081b2f23e2c018d1b44c3bfec70c7a6565e779eddc84",
      "text": "Saiki apik, Bu. Sing penting sehat.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7c5656f93c745f9772a02f1953b529d0f1e0d54423e169d80a4a17fa68eff6",
      "text": "Bayu ragil, Bu?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "addd30075fb3e6546682aaa71069f199fc340048b86b90c1a21d5ee52c8965a3",
      "text": "Iki bojoku.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aefeaf324c38551e85ed412efc00e3d0f9f0062787fa684db289c9fd44e0c106",
      "text": "Duwe lho. Aku duwe adhi loro.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "b044876535e545de1d66fd145028116b2c24e53a1161469d9bd394008108dc7f",
      "text": "Bulik kuwi bojone paklik.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "b157e62e509532d41ac5720951c2b8323f28cb545f8c929f2d439e75b24171e4",
      "text": "Bapakku nyambut gawe, ibuku duwe warung.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b37bc76600e7d7b005d610119be8cf149f0f9b1106e6aaf0de98cdf1ddd6c3f0",
      "text": "Pakdhe karo budhe manggon neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b39aec0c833153f5054b89dc092d9fcd71e1b8fee4688a362de62a9f8d141709",
      "text": "Jenengku Sari, aku saka Madiun. Saiki aku sinau neng Kairo.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b54268a2288606e82cd9282a050b36fdf0f845e268482b1f84fc2232a94d525f",
      "text": "Regane pira, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b58a971a202062e0d880e0a694336c7814c858573712476728d58ea62631f1aa",
      "text": "bojo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbd6353d609080b89cb06c6e2e48aa1d77f80716726f77542815d735ba11dff0",
      "text": "Aku duwe adhi loro.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc104c18a6122e06c4e3381b59c5f4a2be136fb071024a484f37850f8406f886",
      "text": "buku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc5932bccbf5066666a5a6d4d16371ae2302922f6289d2b782fc0cbda60e1935",
      "text": "Ponakanku lair ing Kairo.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcaddcbc60d29cc5a5a020833975f845d3216d406f43d3ff2a57b53377d34501",
      "text": "Bayine rewel. Ibu nggendhong bayine.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd5f2d8fe5ce42a29868e23268d8eb6e3ef0f72575bba1017008a6e521b5c53a",
      "text": "Apik ra? Iki kulawargaku.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c230ad2962222e3d4e0254424451fa3f61334588cdc3b0ff25c4a32b3a02dc35",
      "text": "pawon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c46d87ff270a84d9252a3081c23e87f6111b762327071d64445617716902f1ea",
      "text": "Sari pinter momong, ya.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63e282831a28094762109465101fc6eaad0f364e9f3966b9ec3ed1b4d000825",
      "text": "-e / -ne",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c96ef53b0252931394f2527d95d21dfade1b4c04ca1adbc5cea4a7a42201c62c",
      "text": "Kuwi mbakyuku, budhene Sari. Omahe neng Ponorogo. Mbah putri manggon neng kene, karo aku.",
      "voice": "jv_dimas",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa1764a6945e9f48e0c9200d7806e4b0cb954229b5858e49fae9027fa294cef",
      "text": "Kulawargaku manggon neng Kairo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb8e11d7669a024612ee373e6ec0af283e1219588eb3bff5fbbbb14bf3a7585e",
      "text": "Sari anak mbarep, Bayu anak ragil.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce93f2d17f4bf57117f8b943406a48804ed21332ff3ddbccc17a2c4c9d9d78f0",
      "text": "Ibu ngelus bocah sing rewel.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf17f0f9ea2261e33eb3a2055f3e55247774984743599b0f7817165cb1f3e9e9",
      "text": "Simbah ngopeni pitik neng mburi omah.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d12ed469ac40d9fa77d07a4181bb5a7ceaa4772bd5bbf9d9a7573a3f3390b53e",
      "text": "Kuwi Agus, mase Sari.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d31b4e5e4a8e5f019f6cd8fbec358a02a78423cf22f1276df8fe165f54f8c6cd",
      "text": "Bapak ngadeg ing sawah, Ibu ing pawon.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d439543097f38c497f1b6516b030cd092e420097ded46ec931ab625c7bc1f476",
      "text": "Bapak mesthi seneng.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4a1c078e3f83288566ec2b96dd0a2205b3271a7c10bb640ce3434125461a89f",
      "text": "Mohamed, kowe duwe adhi ra?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59d7c76f079a0a5cd29d0979d6dff75ef8e8b320c20f029792230bf04683034",
      "text": "Iki Agus, mase Sari. Lan iki Bayu, adhine.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d651612e95cf8c56083776b99ecc9dc6e612a9d88b9a7d556b0a373511fe37dc",
      "text": "Sari kuwi anake Pak Budi.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7074fcd705d0decd0098aa6ea8f2dbb06ea76c4bc7f49a65c09597c394d354e",
      "text": "Wingi aku neng omahe simbah.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d76fc11bfff9f65045605e0b73b70909a6753a6c1c16fe186550ff449783b35b",
      "text": "Nggih, Bu, matur nuwun.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d824170e7cafb5dfd7a99571cd2c5f13bbe7bbc06031a49564f13b5a3671347b",
      "text": "mesthi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e8f96038f732cf22ef7c0464020129d8297dc877885670fe1e84f05f75532d",
      "text": "Bapak lan ibuku neng Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9cb8deff93cb8878b9cafa558310ab53ed60140ed106af0d1f663e156410c45",
      "text": "Kamarku cedhak jeding.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "db575c0e920ae106e5bd93f7bdcfd5209ed52462115eaa106eac2861c46d0edb",
      "text": "Fotone apik! Kulawargane Pak Budi gedhe!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "de1775dda7ffabab5c6aed0eaad292754494a0ce050903f319a65b12ce127e4e",
      "text": "sawah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "df9dab61d7013b5eca2ac90b889ae82bfaff1958d03d13e45d31145c97863a3c",
      "text": "mbakyu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0dd131ba037656851adcdad22c2fb8e1bad692aba04be03aa2a8435ff0e692b",
      "text": "Mbakyuku wis rabi.",
      "voice": "jv_siti",
      "chars": 18,
