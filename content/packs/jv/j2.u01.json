      "text": "Iya. Sedulurku akeh ing Solo, tanggane uga sedulur, hehe.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed59c6520aa16bba848e792886518e70c1c5e89ed2b776388ac4b65e8668446b",
