  "audio": [
    {
      "key": "010a4e4cad318d4a64deec6879973422f52ce58b6a3c420bc107b46e62f60ad6",
      "text": "lungguh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "034fb5f9405ec8ef6a2e662e9e5dd4c58b31c8562ee9e67d393f9dab85324a95",
      "text": "petilasan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "04638ca993cc898597fc408e73d1fb70ad0e2578297de47e0fe11ecfb771bd1a",
      "text": "ꦲꦏꦸꦩꦔꦤ꧀꧉ (Aku mangan.)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "04e961faa61af20cab7c1d841c59edf4110fb6fbb605fac9c80bad8e0b547a65",
      "text": "Makam. Nganggo pangkon ing mburi, lho!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "06f9c1cbb2cde5af69ff792f6b906def2a1bd68c29a5483e628324cff157a24c",
      "text": "gendheng",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "08be3e61fd896e32ae2786dd485cd44111812f1ff1d529b98eaf4933dd005740",
      "text": "ꦱꦸꦒꦼꦁꦫꦮꦸꦃ꧉ (Sugeng rawuh.)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a4da0b2fb6f970c8bb25991e38739dc8b751d458671b778bafcafd5b2ba1903",
      "text": "relawan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a9b81e2a928e3f5edda55dbfa7fc6bfe8651c4098b7d6507dfb4c0e50a161eb",
      "text": "ꦭꦸꦁꦒꦸꦃ (lungguh)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ac16e5348b613a6a9b6244e75166ebb9479bd005d0f695c394a6f1dfbe42af6",
      "text": "ꦲꦺꦴꦩꦃ (omah)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d32366848df9473c9be7c655a250b892a7ba361480eda943dd2d325ce6c591e",
      "text": "'Ajining dhiri saka lathi' iku ___.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d6a8a40cb649f0e94b17c9020fc302446f1354dfc27067c8a79219ee5ecba13",
      "text": "Wayang iku kabudayan adiluhung.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ecf7d497272bd3315bcb89666ae001dd9cc3d1eb79f2ae563f1339e85cb347e",
      "text": "menyan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f2f1b69d114006efb0ccb38646f8a6c2d57e844d6dca636139a066728c819ff",
      "text": "Dina iki aku menyang makam. Akeh wong nyekar.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "13805a2087a66b7d5227cf8c049603917b2ab84d0e237d258a6e9495ea217d30",
      "text": "ꦧꦺꦴꦕꦃ (bocah)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c19d810f3fd2b44d08b1a19ab5b15b023b29d2bcbe7dd084ea222a09e034ce",
      "text": "Piye, Med? Seneng?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "17dfd96651f5c1968f4786f1bdb4dd63672e55001c009bfa350f5299ee9e3ab0",
      "text": "Relawan teka nulungi, saiki kampung wis pulih.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1819f2ea8b1dfe7d44bfada80668e5f43eece4808ef650ba6560ce1ae5b5e39b",
      "text": "ꦲꦏꦺꦃꦮꦺꦴꦁꦚꦼꦏꦂ꧉ (Akeh wong nyekar.)",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "185527c81280f46541177cc7de0d521228e13163b84063e63d15e58d1fda743c",
      "text": "Kene akeh wong nganggo klambi Jawa.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "18763a72a1c08a78e6a2338263454595229573b3e4088b6baac8c9a9a3dd77ce",
      "text": "Wah, padha ta! Mula basa krama iku penting.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "19a0a4efcf05fdcd3a48f7f344a1db55671a943ab0e1d07b12d20c19baa1d751",
      "text": "makam",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c88aac427795fb781b051f8c4ca50e24a729c684e1a2f4176fbe91431844121",
      "text": "Miturut paribasan iki, wong kudu guyub.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d979793c5b77b01a4b1dc25851c34a686b8d9e8fd9ce5f70b7f608cff94133c",
      "text": "ꦧꦥꦏ꧀ (bapak)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e79609a3c5d61ae4e74f77098c7c46fc0bb3c08f908b93c4fbaae0d364a1cd2",
      "text": "Simbah tirakat ing petilasan.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f1eb13f309600c8f84078a41891215ba657cbbdb19e9ca87ce7096f16328cb7",
      "text": "busana",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "219f30d311e88a9a077bca74570c4fc9fc35319975b7bb1553d7ce95422664ca",
      "text": "tradhisi",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d9ec1a4b1cafac104cb2db08affc903df5deee3e12a5af0d220b189ba6a148",
      "text": "cecak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f52eb2f7f4ad51cce88a8adbd19836d3cd318e9ed12bd4089b4ddc528f06a0",
      "text": "Aku arep nyekar ing makam.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "23381f08e9697ed6e056a9b7a47d8bfdb3ecc49e290709b06241407d7bf5fc56",
      "text": "ꦚꦼꦏꦂ (nyekar)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "239db7d8553bb26f61f71959aef3bb9fff1219eda93d262bb651a2243602f7eb",
      "text": "slametan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "264b9ebf675f31cf6f186a04bf8d694f400593569e2b4b2924c3e207218a05da",
      "text": "ꦲꦤꦉꦒꦲꦤꦫꦸꦥ꧉ (Ana rega ana rupa.)",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ca75cf2afb186c2e0a5b2ae6c5b5b30a2ade9a3924e08e4d1533a85c1c6dfc",
      "text": "Ayo menyang pasar saiki!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "27b90aea2c1279b3bfa7e7f49800bd64a64d4fdb7d1a0218786ecb84e3412c86",
      "text": "'Alon-alon waton kelakon' iku paribasan Jawa.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "28d3c74aa577d9573c714a5a4f7425f3a5b13b4abd8cd7edaa8c8a045ffa57bb",
      "text": "Aku lungguh ing ngisor wit.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2abdc1bf51d68175ab78ddcb430c67b29bd679b10b9b6868c46ece30eb91e4bf",
      "text": "ambruk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dd3ad861a3f673e5a5bd381eb76880c51a67a8db60b1d086ad9ac71d8612191",
      "text": "Mas, iki makam raja-raja Mataram?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "30501bbc80e4ed0da8c2537a0a8ed8a18de0668b6a5a3925741d431c03dbd6eb",
      "text": "Wong Jawa seneng srawung lan guyub. Iku tradhisi.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3205c857e56120f1f3552e5b771c6b82153dc4dce8f0317763be003d9877a11d",
      "text": "Menapa tiyang ugi tirakat wonten ngriki?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "334444ac1a6329b6f0a58c5818a795f8e15fc0f768a4f4cdacc4d0a7ecd6c29d",
      "text": "Bener! Pasar iki rame saben Legi.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3536dbd60ea876d802b045b44b4a29c6541f44f23571c14e9d9e048c425de678",
      "text": "Lho, ing Mesir uga ana unen-unen kaya ngono!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "35e7e70943a8e815eaf595437e183b163203774b4e081373cb93ca6f27d7688f",
      "text": "Mohamed, kowe ngerti paribasan 'alon-alon waton kelakon'?",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "379f4458a9a8fcce9ec36c0ad431a0e758190b989618c85d75caa2621cbe51e0",
      "text": "ꦏꦁꦏꦸꦁꦫꦺꦴꦁꦲꦺꦮꦸ꧉ (Kangkung rong ewu.)",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "38cb65f8d6cca00624d6ecd266cb547dcf03c020353c0ab84096bfa6610022b2",
      "text": "kabudayan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b82bd0a6aac73ed79f8d19b5c273e43130f7e37602d161a03d5347316748d37",
      "text": "Saiki Kutha Gedhe wis pulih maneh.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cbcf816e1b0c9ac9645ca32794c5b1ad32c5b9c29d48922ea148b60eef7b343",
      "text": "adiluhung",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "416974f9cbd6e3c79d9fcd16793aba52138638463a7c9aaffe9e17498b655e30",
      "text": "Sesaji iki kanggo slametan desa.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4371e8113932aa6892e9cf190f55a726243ef6b4f797da26c9340599bccc68cd",
      "text": "Ora usah kesusu, sing penting rampung.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "450006d3bdd6a099378f562399f595dce7d43cc97c4d17ffdcf8c98adca92019",
      "text": "ꦲꦗꦶꦤꦶꦁꦫꦒꦱꦏꦧꦸꦱꦤ꧉ (ajining raga saka busana.)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "486191f111459b251fefe8d2dc6c1908b123dd18e8524c3673927056c39539a3",
      "text": "Inggih, Pak. Kula sampun maos aturanipun.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1ca34d312928ec77f0715935ec8fbe8799dd69c09a8b8b5c44d3dc4f940ec9",
      "text": "lindhu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d4b436fa4c0e3dc5e893266bcaa7867821b3ea80760b700e95f64f8c327dde7",
      "text": "Alhamdulillah! Sesuk aku nulis maneh.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4df6629e4fd4ffd6cfefc0686cb99b29aadf88d57a4259b60024ce9580dc119b",
      "text": "Joglo lawas iku ambruk, nanging wis dibangun maneh.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e1ce213521b1e44c496cf697de5151140a8c938f835530fc03197f196237302",
      "text": "ꦩꦠꦸꦂ (matur)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "50b2512be0a34954485bf84932c321b116b4867db29fdb3c5986cc8c9a3a833a",
      "text": "Leres. Wah, Mas saged maos aksara Jawa!",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "51880e5c96c7db5ad6726e2a2262198b5b522aa682b475b69c3ac6ff535b6230",
      "text": "nisan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "51b85623da088ad5bac09d701d0f47eaab76fc75001473719322e5d359d68368",
      "text": "Ora, kok. Pangkone ana ing mburi, bener kabeh.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "51cd9870819f52a3e685d43ac6e8e6a6287a89b64513281a204c9cd41ae7b24c",
      "text": "lathi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "51feb6b74cc11e391c4f6fb9c0e74b2ad6981c65d08c9d91cd5f27fc36196538",
      "text": "Ing petilasan iki ana watu lawas.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "533027d29d97e3e3f410bbb4cfd61856791a275eeb4525fa503e313eb08ff3e0",
      "text": "ꦩꦔꦤ꧀ (mangan)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "53e57a4b8e66e8c618c7f75d579bfa3ef5d68479304a02cc08748ac56e1379e7",
      "text": "Omah Kalang",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "55220508e6f03c632e5f67a4ff19498507e188135b967dc39fcf3b85affec96f",
      "text": "Relawan saking pundi-pundi. Sapunika sampun pulih.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "55422c4ba7c97befdcb3a12691854017f7f371181cb77716841b949fd763439f",
      "text": "Aku seneng srawung karo wong-wong sing guyub.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c8ef501f9cef1958680ffc658e15672ef18d57cc5b466fa54344eeac4e810b",
      "text": "papan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "56265a442fb8895cd195b83ee66747a952f49a510018c745e93c8df1f4cfd82a",
      "text": "Makam Panembahan Senapati ana ing sangisore cungkup.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "578e269b2dbb2442f3dcd5d35e69b33c7fb2aad5f697cee92f7870b4dc829f07",
      "text": "Tenan? Ana sing salah?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b47233060406ac4b0db70fc272b4447d2939ed3a77e4e5762211425fd72f21",
      "text": "Lan papan iku Omah Kalang.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "59cf6ec6e1677e2db4a54e08af7b08abc7f39803ffad2c599bab53842748c04c",
      "text": "Inggih, Pak. Kula nyewa rumiyin.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b7e84ae15a0f1bb69acdedfa18fb0a56d94fda7dd891a8c30ac74475e408638",
      "text": "Seneng aku! Aku nganggo klambi apa?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bd612ac8ccc01ce417d742ca099b7e84f89203e61d606b38a7f2d0aa51d6bc1",
      "text": "Bengkel panjenengan ugi?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e3c20ee2c75d8722d1f78cf04ad2370b1a71552e9d66c159fb69f50e00c2434",
      "text": "Akeh wong nyekar.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f98656d17df9200e40646c75d1e02adf0f3640b4700f20765dc17e49b3c917c",
      "text": "sesisir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "61acd558f7401d8c6432fa433c61b7e606a23ff587c9775e6b505a25b6e3bc82",
      "text": "Papan iku tulisane aksara Jawa.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6218aeb814ef19f02fec651b7496a90a14251617566655e0eff7226e8a2204ec",
      "text": "Mas, menika cungkup makam raja-raja Mataram.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "64699e7033d700fe90bf1c56e9ff4e3a5d88ff6ee56e60bec057c309702b0fba",
      "text": "Kowe melu?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "647348bb9b0923cb3017439ae24a7d6c5b784ad94ff314f11cafb82a590f585f",
      "text": "Sedasa ewu, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "65e345d94ad661cf61f1112ddf4c1175ee85b87332c99d3bfacc94af9707abe0",
      "text": "Pak, kula mireng wonten lindhu ageng ing taun 2006.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a9f3a6fd8b56476841d4bcb98bddf34b742c004c73ba697e35655a4e5bc6a32",
      "text": "ꦏꦸꦢꦸꦔꦁꦒꦺꦴꦧꦸꦱꦤꦗꦮ꧉ (Kudu nganggo busana Jawa.)",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d418acea78e1fec9373fb2e749ed092071622ab1f5eb57ba1b2d4283d3a7aa",
      "text": "Bawang abang sekilo telung puluh ewu.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "732dda8dc905c1efe51fbe2b0bc3b82ad7f9031c4a1831fcf1c3e38c153421b4",
      "text": "Sawise lindhu, ___ saka ngendi-endi teka nulungi.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7454d9e95bc206eb438499a605494c8e8b9dd1f8137b1742fae7e8cc0e3fa713",
      "text": "panyigeg",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "766b6a0a879bb5a9f6bf846f8955cc7da4e598d43122f98bebaca2f2773dd55b",
      "text": "bapak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c274a55339f7eecce7d50db739257af3d3abc9ee00bc8054a699f591ea58e81",
      "text": "ꦧꦮꦁꦲꦧꦁꦱꦼꦏꦶꦭꦺꦴꦠꦼꦭꦸꦁꦥꦸꦭꦸꦃꦲꦺꦮꦸ꧉ (Bawang abang sekilo telung puluh ewu.)",
      "voice": "jv_siti",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cb5a6258e75cf587c63b6453d19c2a09d0efecb20ce0d575e9317b5d7af7fe4",
      "text": "Bu, gedhang sesisir pinten?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d50d7aefc9f47e86488ae43cb86dcea35a3715ed719b0694872344475bb70de",
      "text": "melu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8145bd3c5c419fe3ab9b9da4b77153a767532bb08718529c16b856f3b6b7dcdf",
      "text": "Med, coba wacanen tulisan iki.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "82d7dca68bf83b8a6bbf91fb8649c0a4ba7fdaf1210e30f45f5179d5ad48f732",
      "text": "Tenan? Tulisane apa?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "846bba92f193c6ae79906dd8f837e1ceb9ac9d1370c366fc07f1a6f258fbb11a",
      "text": "wignyan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "847274e29882fc149353779528d9e930b2f3656e77c2b89e35ca8a80bb20c50d",
      "text": "Aku mangan. Lho, ing mburi ana tandha apa?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "86273c2e956b2a973ffa150db82b24dc4b708e2f5467214ece8f8bc13d4026a2",
      "text": "raga",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "87cd6a8e65096f18f20ab83ccf27cf212c35ee768efce5b9cdcceb6a439ab21a",
      "text": "tirakat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "88187e840480923eeb3fd8aa27725e8c0e211b391074591ff4301f856c47cde2",
      "text": "paribasan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b32937b624cf0c5d1d9e708ec3e6e0acc2ce5ce6dfbe1575e8ffbc475de4ac6",
      "text": "Iku paribasan. Ajining dhiri saka lathi.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b6b4e324a93ecd2a8f480af5fae84d57690f223f5182b4ed1bb22a5425e8855",
      "text": "Iya, aku melu! Tunggu aku ing gapura.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e070ae53e7267f0c5e919cdbbc0efd4c79a3654417c9c5be54aed76c73b9c5a",
      "text": "Taun 2006 ana lindhu gedhe ing Yogya.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e6a16ba1ceb6bb0fc81262f30fea46de0b76b5bb256f2580d811ead14e8314c",
      "text": "ꦢꦶꦤꦲꦶꦏꦶꦲꦏꦸꦩꦼꦚꦁꦩꦏꦩ꧀꧉ (Dina iki aku menyang makam.)",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ff1224c91a4cd02b6044962fe263e230445ed69f8a5a551b18fe98104ea158a",
      "text": "Ganda menyan. Wonten tiyang ingkang nyekar.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ce690c0c6372f9ab609651a0a1c512721abd2d18f6d7f11a8688c5cad32837",
      "text": "ꦥꦱꦂ (pasar)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "95172dd9f6719d8ba92e482cdf8dc450a421506bb7b5edef66b4733f34f834bd",
      "text": "Mas, aku isa maca tulisan ing tembok iki.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "97c89338c8614c9061dc781c750b712fc7c4e8d0bbb374b9cd301221ec935f4d",
      "text": "Wonten. Kathah ingkang dhateng petilasan kangge ngurmati leluhur.",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "98f1a6f77c2a380dfe529369477fe53c40e47e83a1283199a137aa30c10dd9c5",
      "text": "Bener! Ayo ta, wayange meh diwiwiti.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "98f9dfc4f155c3d02aff0018ef3b847efef23af2564f2ac395c82d0f28551f78",
      "text": "ꦲꦗꦫꦩꦺ꧉ (Aja rame.)",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "99134f774c9d65eb24f0a7c56a666578889a38e9199e53309f411ca1fed94b91",
      "text": "Akeh omah joglo ambruk, gendhenge tiba.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e70d35b4fbcd3ef057f2d984ef5d1ac5459965b203960b90c3111b5380be293",
      "text": "Wong desa guyub lan seneng srawung.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e91f54fc6d6f81a7474f41823f45802e51b49fc52bf14f6649a64036cd32830",
      "text": "Sugeng rawuh, Mas. Badhe mlebet?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eacba81480ad47a82e1821b786b2d159c5d708b346a40c68a6d18ec618bd671",
      "text": "pulih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f6499f1006e3507b6cac828f803a7788cb6c602a4f6cb3bb91c316a0e3acf19",
      "text": "Med, cathetanmu apik. Aku maca kabeh.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9faeb2593fe34c08cf5796b0635e99057d4343373d16f974bb7a9ceffa1476e7",
      "text": "Tulisane Pasar Legi. Legi kaya ing weton!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a52567c9d5b753490c902b7b43bd3d677c5954c30ba4108e8fbfa2b6ba79365b",
      "text": "srawung",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a55b76d792b6c0fbafd44472b1ea4be37b79f623c40039bbb4afb70800ff95b4",
      "text": "Ing Mesir uga ana, «لسانك حصانك»!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c22e49276ba9382de8d22fa9664039df03a482949fe4aa9d07a292eec49df7",
      "text": "Gedhang sesisir pira, Bu?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8b2cc3c6be530abc55d9489865b11e07a9daf625e18ce577b35d9473b42eeae",
      "text": "bata",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8ce2242b8dafc96629c443025b374923481badae89eed1be3554928b3b9cc04",
      "text": "sesaji",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa2eda442c1d126df057a2ed7e7a755b45e7e6dd8ee0c97146dcd9d7bb8c3177",
      "text": "Sesuk aku melu kowe menyang pasar.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa488418ba3c3438e37383cac5d5540dc66aa105eb076d7d67c834b49e3a9261",
      "text": "ꦲꦺꦴꦩꦃꦏꦭꦁ (Omah Kalang)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa597569a067a9b35f71153e6661e0f69fd2466c0cd9ede4d4a48d36f92251af",
      "text": "Nisanipun lawas sanget. Ganda menapa menika, Pak?",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa61a6908c8fcf99eb87d1a6ffcb91eca2adbc84f57fcb9890e9bd43e76f97a4",
      "text": "Inggih. Gendhengipun dhawah sedaya, namung cagakipun ingkang taksih ngadeg.",
      "voice": "jv_dimas",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca99a6a8b5b3c7b04368d7a7057bf5dd0637a8e8292507e280996953a28ad40",
      "text": "Med, iki papan apa?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae83b6f702b2cd9876333fa4a759536f92030a0b6a9a52320f42472e0a667484",
      "text": "Wong sing budine ___ iku seneng nulungi lan jujur.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "aedc66aee61ca443ae10b41a5852d578ceba8d40aef98995eb712839bfde7e39",
      "text": "layar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af56b35ba35662b1c1113a55164d1c9835c1cc237d5c138461e846daee8ec048",
      "text": "ꦥꦱꦂꦊꦒꦶ (Pasar Legi)",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "b172139b742efaa230c663e11341c68f35dd6f7aa9c3ff90bff16d9abaa68285",
      "text": "ꦮꦪꦁ (wayang)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2cf955f8cabc2e668ec989ee5ced4e40c509c88a5424b038ac8f796cb75c6a6",
      "text": "ꦏꦺꦴꦮꦺꦩꦼꦭꦸ (Kowe melu?)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b421b435865ec5c1ba41d7dfae5fe2197fa25cdb97378123139b1bbb0759874c",
      "text": "cagak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5b647381b9f955f36b5996be8a481c59d5b5ce217dc3fa11c5a5c0068470e4c",
      "text": "wewarah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b668ab44a47dad29612d4d68553fa328f5f05be0adeae60562c2ab904eb1d2ec",
      "text": "Leres, Mas. Kathah griya ambruk, kalebet joglo-joglo lawas.",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8dc2beccee308e0774ce8de656318f4e58c60fcbc521b2c8193e908ebb02728",
      "text": "ꦩꦺꦢ꧀꧈ꦧꦼꦔꦶꦲꦶꦏꦶꦲꦤꦮꦪꦁ꧉ (Med, bengi iki ana wayang.)",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd167f0d4cb4e8bbb8257cbcb04289c4fe06143a1c0ff088e98f73d9bae7bebc",
      "text": "Isa. Bengi iki ana wayang, lan kowe nunggu ing gapura.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1ff5bfa80b8b57dc1b1462453e1168f0d9e810a3d3b45e40fdbb2ff0b7513b4",
      "text": "Dina iki aku menyang makam.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5e0c9e18a1a6a3f5f7fb70a305cfe93a1d82364244d4d8e08b167a88787c172",
      "text": "Aku mangan, kowe turu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9da089aa3fd439a781fb923f01ce595cd96d835cc0deff87b724da046b0fe40",
      "text": "ꦲꦏꦸꦤꦸꦁꦒꦸꦲꦶꦁꦒꦥꦸꦫ꧉ꦢꦶꦩꦱ꧀ (Aku nunggu ing gapura. Dimas)",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9dece97439da7732697944989734628b29596dbe54b13bbb6d746c3f2c913a0",
      "text": "joglo",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3a5f270aa7f48de5730b50cd855fcc3eab13377ffdffe7a69e1ca378d3428b",
      "text": "aji",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb6b87627cd9a1e397046f6b58a24099592faacf87fb4ab0b9d627af73e5c322",
      "text": "Durung. Apa wewarahe?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce5b980b3fa8be9451c490e857e0f9d31f2c9bddb6d2379bcdeb4b326169cfe6",
      "text": "Iku pada lungsi, kaya titik.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf66c5a39d09d81fb129f25970a2f3fa099eff0a9e5487fa3834d774d5f4db59",
      "text": "Med, sesuk awake dhewe menyang Makam Raja Mataram.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "cff073655b4b2746f3646d290474c14a7ca717be3cdb9eacf8eee3896bb278da",
      "text": "Ana rega ana rupa.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "d077257b99aebde26cac62f50e57bfade1b59bc068f7992e3c1eb9822e387fad",
      "text": "Mas! Aku wis maca layangmu.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1742bd8f62a5b6fed3d9c386e763d9685698d6f4693acd70ad8956cbbd02561",
      "text": "Ing ngarep nisan ana ganda menyan.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1765b9f7616bf519681b9f7368d54ff21adf465cde19eabae308c8937f96752",
      "text": "Tulisane Pasar Legi.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4f9ec63f75e8106b501dc63c23ef5a27b3c45c4194b028f03141d61090d1352",
      "text": "Mangga ngagem busana Jawa rumiyin. Saged nyewa wonten mriki.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d64f0530d8bdab75898bf38262890cb73e259718a6917e87acdc60ac6265b33b",
      "text": "ꦱꦼꦤꦼꦁ (seneng)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d64fb731a318e6501c6c68ac66df80c5a3acacfd4c7a343a38bb12e70dc9d5ef",
      "text": "guyub",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "da7e3a772e30140696fddc0fc820005286390ea6c4b5ec1dad21e67eccf42eff",
      "text": "Iya, iku aturane lho. Ayo lungguh dhisik.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd372c0e778299aa13f591546120e9ac8abe0f823208082dbbc5724498b261ad",
      "text": "Kabudayan sing adiluhung.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "de4d2e82c139b2afa821c6c0357b0ae41328ec48f63e31892d2f22cd07e5a543",
      "text": "Lajeng sinten ingkang mbiyantu?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "de9a8709401865997f8ce23150cdf7bdc1bbee40113eca35978deac84540fd51",
      "text": "ꦲꦏꦸꦩꦔꦤ꧀꧈ꦏꦺꦴꦮꦺꦠꦸꦫꦸ꧉ (Aku mangan, kowe turu.)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "dee0a3a97ca5971469ad8ca5087aa335f7e7b3c580266c920839143e5b1736b7",
      "text": "Seneng banget. Aku maca papan ing gapura.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2a5df2eeab7f167e149c0f8a0b5de11139db9400f122c7a4cdc246825b28536",
      "text": "ꦒꦼꦝꦁꦱꦼꦱꦶꦱꦶꦂꦱꦼꦥꦸꦭꦸꦃꦲꦺꦮꦸ꧉ (Gedhang sesisir sepuluh ewu.)",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35d72426d0515339789b58280b46bc0bef3b17f7862fc7e85c7941704cfd685",
      "text": "seneng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e45f9d8bfcb21fa1e0370f39d5fec96bb9c29d269197b4832ce913a5123dfd43",
      "text": "Kula maos papanipun! Kangkungipun kalih ewu, nggih?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e599df1953251307de79fbab9ed975c6672a568571dbf2709b6fe0510444d776",
      "text": "ꦲꦏꦸꦭꦸꦁꦒꦸꦃꦲꦶꦁꦔꦶꦱꦺꦴꦂꦮꦶꦠ꧀꧉ (Aku lungguh ing ngisor wit.)",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab5f4c3ac8d96d669d630013c33dad1ba92dfe31e65bf3f4de6946a21459975",
      "text": "Wah, kowe wis isa maca papan jeneng, lho!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "eac34feb5485297b6ff547d18359dfd3bccfde012c100e64759063222ef09ef0",
      "text": "nyekar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaf6af601ee0eb2403943f42eb878a1189414f3780cb05595fced4b73ee75fbe",
      "text": "pangkon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebaf8484c8a46cab2536f58dff1347794733493daa064c28f64c25a15abe62f7",
      "text": "pada lungsi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "eca5e49b8e0659c19fdfa19c9e9732bad96f52faae8aa500d0a1218c07e1dd7b",
      "text": "pasar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ece0d0c6b08c6f3010c52b2d32717f16f966c265819bd11b682f9c91026b343b",
      "text": "unen-unen",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1548493f0b5a3e5ec6db9cdfd1a86ab71266ef0427e2e788eaed2e7d4c3b30f",
      "text": "Sugeng rawuh.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1f32ccc69f346cd9dfb1f00c13546fd5b303d71737bdcc496a9fdec68bd1f50",
      "text": "Lan iki pangkon, kaya sukun ing basa Arab.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2ecabf62e4f5f8cbf70298f1cd30b492b485e5e132c5203f144a0c46ad28aaf",
      "text": "Klambi Jawa wae. Ana ing pasar.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f89d40b54d72f92227369c08c33ca0fe2a10cdd90349e536b720a3f95de75fa7",
      "text": "Omahe ambruk nalika lindhu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8cc7aecf41b7e14c62434d2659d9131e7d40847a54286540bd02a98ee84f9c7",
      "text": "Sadurunge mbangun omah, wong Jawa nganakake slametan.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb207a6af4186d78a70c1a031a6adebf7692a84fc9323c54a898c86c96156284",
      "text": "Kula ngertos. Kangge kula, cekap dedonga mawon.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbb38e6bbf65e4525eaf5aa984133032ffe5edff96e76046c38257073aef76f6",
      "text": "ꦲꦗꦶꦤꦶꦁꦝꦶꦫꦶꦱꦏꦭꦛꦶ꧈ (Ajining dhiri saka lathi,)",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefc540a9ad9d66cb1532f38836af43200389f6dfd4d9b9aa7d0c8a54ee2a973",
      "text": "pada lingsa",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff039605848530924b9810b638644d8d0f7c9e684dd1a210cbd4e05462980cf4",
      "text": "cungkup",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff3f8ec3f94854b7c648dafd61bd028aa5a01e25d2f4511ed73fe017bec7c8ab",
      "text": "Apik. Kowe isa maca kabeh?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa1a0fe7293eecba0ad574133ca762fcb3b863da23f3f3e4b3cfe24e4a5be38",
      "text": "Iya. Akeh wong teka mrene kanggo nyekar.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
