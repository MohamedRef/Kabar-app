    }
  ],
  "audio": [
    {
      "key": "010a4e4cad318d4a64deec6879973422f52ce58b6a3c420bc107b46e62f60ad6",
      "text": "lungguh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "04638ca993cc898597fc408e73d1fb70ad0e2578297de47e0fe11ecfb771bd1a",
      "text": "ꦲꦏꦸꦩꦔꦤ꧀꧉ (Aku mangan.)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "08be3e61fd896e32ae2786dd485cd44111812f1ff1d529b98eaf4933dd005740",
      "text": "ꦱꦸꦒꦼꦁꦫꦮꦸꦃ꧉ (Sugeng rawuh.)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a9b81e2a928e3f5edda55dbfa7fc6bfe8651c4098b7d6507dfb4c0e50a161eb",
      "text": "ꦭꦸꦁꦒꦸꦃ (lungguh)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ac16e5348b613a6a9b6244e75166ebb9479bd005d0f695c394a6f1dfbe42af6",
      "text": "ꦲꦺꦴꦩꦃ (omah)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f2f1b69d114006efb0ccb38646f8a6c2d57e844d6dca636139a066728c819ff",
      "text": "Dina iki aku menyang makam. Akeh wong nyekar.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1305bdd783523530034129e9a6cf51f60c90c1572dae880544e7c091e7d284dd",
      "text": "Klambi Jawa. Ana ing pasar.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "13805a2087a66b7d5227cf8c049603917b2ab84d0e237d258a6e9495ea217d30",
      "text": "ꦧꦺꦴꦕꦃ (bocah)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c19d810f3fd2b44d08b1a19ab5b15b023b29d2bcbe7dd084ea222a09e034ce",
      "text": "Piye, Med? Seneng?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1586aaf9be75fb75b11959f0e32981471cac41fee2fc7d2ab8a06ecfe97fa09c",
      "text": "Ora. Pangkone ana ing mburi, bener kabeh.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1819f2ea8b1dfe7d44bfada80668e5f43eece4808ef650ba6560ce1ae5b5e39b",
      "text": "ꦲꦏꦺꦃꦮꦺꦴꦁꦚꦼꦏꦂ꧉ (Akeh wong nyekar.)",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "185527c81280f46541177cc7de0d521228e13163b84063e63d15e58d1fda743c",
      "text": "Kene akeh wong nganggo klambi Jawa.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "19a0a4efcf05fdcd3a48f7f344a1db55671a943ab0e1d07b12d20c19baa1d751",
      "text": "makam",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d979793c5b77b01a4b1dc25851c34a686b8d9e8fd9ce5f70b7f608cff94133c",
      "text": "ꦧꦥꦏ꧀ (bapak)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f1eb13f309600c8f84078a41891215ba657cbbdb19e9ca87ce7096f16328cb7",
      "text": "busana",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d9ec1a4b1cafac104cb2db08affc903df5deee3e12a5af0d220b189ba6a148",
      "text": "cecak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f52eb2f7f4ad51cce88a8adbd19836d3cd318e9ed12bd4089b4ddc528f06a0",
      "text": "Aku arep nyekar ing makam.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "23381f08e9697ed6e056a9b7a47d8bfdb3ecc49e290709b06241407d7bf5fc56",
      "text": "ꦚꦼꦏꦂ (nyekar)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "264b9ebf675f31cf6f186a04bf8d694f400593569e2b4b2924c3e207218a05da",
      "text": "ꦲꦤꦉꦒꦲꦤꦫꦸꦥ꧉ (Ana rega ana rupa.)",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ca75cf2afb186c2e0a5b2ae6c5b5b30a2ade9a3924e08e4d1533a85c1c6dfc",
      "text": "Ayo menyang pasar saiki!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "28d3c74aa577d9573c714a5a4f7425f3a5b13b4abd8cd7edaa8c8a045ffa57bb",
      "text": "Aku lungguh ing ngisor wit.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c58e767aa6e22dec966775aa7686d8f2089ac6771d31a10a544ca3589379ae3",
      "text": "Wah, kowe wis isa maca papan jeneng!",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dd3ad861a3f673e5a5bd381eb76880c51a67a8db60b1d086ad9ac71d8612191",
      "text": "Mas, iki makam raja-raja Mataram?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "334444ac1a6329b6f0a58c5818a795f8e15fc0f768a4f4cdacc4d0a7ecd6c29d",
      "text": "Bener! Pasar iki rame saben Legi.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "357704b118b45dda9f608d66cb124ce7c1864c7f3544c18e013b0dbc22a5a2b6",
      "text": "Iya, iku aturane. Ayo lungguh dhisik.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "379f4458a9a8fcce9ec36c0ad431a0e758190b989618c85d75caa2621cbe51e0",
      "text": "ꦏꦁꦏꦸꦁꦫꦺꦴꦁꦲꦺꦮꦸ꧉ (Kangkung rong ewu.)",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "450006d3bdd6a099378f562399f595dce7d43cc97c4d17ffdcf8c98adca92019",
      "text": "ꦲꦗꦶꦤꦶꦁꦫꦒꦱꦏꦧꦸꦱꦤ꧉ (ajining raga saka busana.)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "486191f111459b251fefe8d2dc6c1908b123dd18e8524c3673927056c39539a3",
      "text": "Inggih, Pak. Kula sampun maos aturanipun.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d4b436fa4c0e3dc5e893266bcaa7867821b3ea80760b700e95f64f8c327dde7",
      "text": "Alhamdulillah! Sesuk aku nulis maneh.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e1ce213521b1e44c496cf697de5151140a8c938f835530fc03197f196237302",
      "text": "ꦩꦠꦸꦂ (matur)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "50b2512be0a34954485bf84932c321b116b4867db29fdb3c5986cc8c9a3a833a",
      "text": "Leres. Wah, Mas saged maos aksara Jawa!",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "51cd9870819f52a3e685d43ac6e8e6a6287a89b64513281a204c9cd41ae7b24c",
      "text": "lathi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "533027d29d97e3e3f410bbb4cfd61856791a275eeb4525fa503e313eb08ff3e0",
      "text": "ꦩꦔꦤ꧀ (mangan)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "53e57a4b8e66e8c618c7f75d579bfa3ef5d68479304a02cc08748ac56e1379e7",
      "text": "Omah Kalang",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c8ef501f9cef1958680ffc658e15672ef18d57cc5b466fa54344eeac4e810b",
      "text": "papan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "578e269b2dbb2442f3dcd5d35e69b33c7fb2aad5f697cee92f7870b4dc829f07",
      "text": "Tenan? Ana sing salah?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b47233060406ac4b0db70fc272b4447d2939ed3a77e4e5762211425fd72f21",
      "text": "Lan papan iku Omah Kalang.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "59cf6ec6e1677e2db4a54e08af7b08abc7f39803ffad2c599bab53842748c04c",
      "text": "Inggih, Pak. Kula nyewa rumiyin.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b7e84ae15a0f1bb69acdedfa18fb0a56d94fda7dd891a8c30ac74475e408638",
      "text": "Seneng aku! Aku nganggo klambi apa?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e3c20ee2c75d8722d1f78cf04ad2370b1a71552e9d66c159fb69f50e00c2434",
      "text": "Akeh wong nyekar.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f98656d17df9200e40646c75d1e02adf0f3640b4700f20765dc17e49b3c917c",
      "text": "sesisir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "61acd558f7401d8c6432fa433c61b7e606a23ff587c9775e6b505a25b6e3bc82",
      "text": "Papan iku tulisane aksara Jawa.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "64699e7033d700fe90bf1c56e9ff4e3a5d88ff6ee56e60bec057c309702b0fba",
      "text": "Kowe melu?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "647348bb9b0923cb3017439ae24a7d6c5b784ad94ff314f11cafb82a590f585f",
      "text": "Sedasa ewu, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "667d84353b9810cb7f5f6fe65d28b6951b5fb21dca04c085cfe253594a7fe204",
      "text": "Makam. Nganggo pangkon ing mburi!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a9f3a6fd8b56476841d4bcb98bddf34b742c004c73ba697e35655a4e5bc6a32",
      "text": "ꦏꦸꦢꦸꦔꦁꦒꦺꦴꦧꦸꦱꦤꦗꦮ꧉ (Kudu nganggo busana Jawa.)",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d418acea78e1fec9373fb2e749ed092071622ab1f5eb57ba1b2d4283d3a7aa",
      "text": "Bawang abang sekilo telung puluh ewu.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7454d9e95bc206eb438499a605494c8e8b9dd1f8137b1742fae7e8cc0e3fa713",
      "text": "panyigeg",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "766b6a0a879bb5a9f6bf846f8955cc7da4e598d43122f98bebaca2f2773dd55b",
      "text": "bapak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c274a55339f7eecce7d50db739257af3d3abc9ee00bc8054a699f591ea58e81",
      "text": "ꦧꦮꦁꦲꦧꦁꦱꦼꦏꦶꦭꦺꦴꦠꦼꦭꦸꦁꦥꦸꦭꦸꦃꦲꦺꦮꦸ꧉ (Bawang abang sekilo telung puluh ewu.)",
      "voice": "jv_siti",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cb5a6258e75cf587c63b6453d19c2a09d0efecb20ce0d575e9317b5d7af7fe4",
      "text": "Bu, gedhang sesisir pinten?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e48a6bd499eaf08a71675f2f3e1ebfac60ecd38add5e6e4bfca9205a5c42922",
      "text": "Wah, padha! Mula basa krama iku penting.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8145bd3c5c419fe3ab9b9da4b77153a767532bb08718529c16b856f3b6b7dcdf",
      "text": "Med, coba wacanen tulisan iki.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "82d7dca68bf83b8a6bbf91fb8649c0a4ba7fdaf1210e30f45f5179d5ad48f732",
      "text": "Tenan? Tulisane apa?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "846bba92f193c6ae79906dd8f837e1ceb9ac9d1370c366fc07f1a6f258fbb11a",
      "text": "wignyan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "847274e29882fc149353779528d9e930b2f3656e77c2b89e35ca8a80bb20c50d",
      "text": "Aku mangan. Lho, ing mburi ana tandha apa?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "86273c2e956b2a973ffa150db82b24dc4b708e2f5467214ece8f8bc13d4026a2",
      "text": "raga",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b32937b624cf0c5d1d9e708ec3e6e0acc2ce5ce6dfbe1575e8ffbc475de4ac6",
      "text": "Iku paribasan. Ajining dhiri saka lathi.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b6b4e324a93ecd2a8f480af5fae84d57690f223f5182b4ed1bb22a5425e8855",
      "text": "Iya, aku melu! Tunggu aku ing gapura.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e6a16ba1ceb6bb0fc81262f30fea46de0b76b5bb256f2580d811ead14e8314c",
      "text": "ꦢꦶꦤꦲꦶꦏꦶꦲꦏꦸꦩꦼꦚꦁꦩꦏꦩ꧀꧉ (Dina iki aku menyang makam.)",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ce690c0c6372f9ab609651a0a1c512721abd2d18f6d7f11a8688c5cad32837",
      "text": "ꦥꦱꦂ (pasar)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "95172dd9f6719d8ba92e482cdf8dc450a421506bb7b5edef66b4733f34f834bd",
      "text": "Mas, aku isa maca tulisan ing tembok iki.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "98f9dfc4f155c3d02aff0018ef3b847efef23af2564f2ac395c82d0f28551f78",
      "text": "ꦲꦗꦫꦩꦺ꧉ (Aja rame.)",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e91f54fc6d6f81a7474f41823f45802e51b49fc52bf14f6649a64036cd32830",
      "text": "Sugeng rawuh, Mas. Badhe mlebet?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f6499f1006e3507b6cac828f803a7788cb6c602a4f6cb3bb91c316a0e3acf19",
      "text": "Med, cathetanmu apik. Aku maca kabeh.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9faeb2593fe34c08cf5796b0635e99057d4343373d16f974bb7a9ceffa1476e7",
      "text": "Tulisane Pasar Legi. Legi kaya ing weton!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a55b76d792b6c0fbafd44472b1ea4be37b79f623c40039bbb4afb70800ff95b4",
      "text": "Ing Mesir uga ana, «لسانك حصانك»!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c22e49276ba9382de8d22fa9664039df03a482949fe4aa9d07a292eec49df7",
      "text": "Gedhang sesisir pira, Bu?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa488418ba3c3438e37383cac5d5540dc66aa105eb076d7d67c834b49e3a9261",
      "text": "ꦲꦺꦴꦩꦃꦏꦭꦁ (Omah Kalang)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca99a6a8b5b3c7b04368d7a7057bf5dd0637a8e8292507e280996953a28ad40",
      "text": "Med, iki papan apa?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "aedc66aee61ca443ae10b41a5852d578ceba8d40aef98995eb712839bfde7e39",
      "text": "layar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af56b35ba35662b1c1113a55164d1c9835c1cc237d5c138461e846daee8ec048",
      "text": "ꦥꦱꦂꦊꦒꦶ (Pasar Legi)",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "b172139b742efaa230c663e11341c68f35dd6f7aa9c3ff90bff16d9abaa68285",
      "text": "ꦮꦪꦁ (wayang)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2cf955f8cabc2e668ec989ee5ced4e40c509c88a5424b038ac8f796cb75c6a6",
      "text": "ꦏꦺꦴꦮꦺꦩꦼꦭꦸ (Kowe melu?)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8dc2beccee308e0774ce8de656318f4e58c60fcbc521b2c8193e908ebb02728",
      "text": "ꦩꦺꦢ꧀꧈ꦧꦼꦔꦶꦲꦶꦏꦶꦲꦤꦮꦪꦁ꧉ (Med, bengi iki ana wayang.)",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd167f0d4cb4e8bbb8257cbcb04289c4fe06143a1c0ff088e98f73d9bae7bebc",
      "text": "Isa. Bengi iki ana wayang, lan kowe nunggu ing gapura.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1ff5bfa80b8b57dc1b1462453e1168f0d9e810a3d3b45e40fdbb2ff0b7513b4",
      "text": "Dina iki aku menyang makam.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5e0c9e18a1a6a3f5f7fb70a305cfe93a1d82364244d4d8e08b167a88787c172",
      "text": "Aku mangan, kowe turu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6740729b0e930c4a2a8efd571163b6c906dddd097796ba606d9f0359ce00590",
      "text": "Bener! Ayo, wayange meh diwiwiti.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9da089aa3fd439a781fb923f01ce595cd96d835cc0deff87b724da046b0fe40",
      "text": "ꦲꦏꦸꦤꦸꦁꦒꦸꦲꦶꦁꦒꦥꦸꦫ꧉ꦢꦶꦩꦱ꧀ (Aku nunggu ing gapura. Dimas)",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3a5f270aa7f48de5730b50cd855fcc3eab13377ffdffe7a69e1ca378d3428b",
      "text": "aji",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce5b980b3fa8be9451c490e857e0f9d31f2c9bddb6d2379bcdeb4b326169cfe6",
      "text": "Iku pada lungsi, kaya titik.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf66c5a39d09d81fb129f25970a2f3fa099eff0a9e5487fa3834d774d5f4db59",
      "text": "Med, sesuk awake dhewe menyang Makam Raja Mataram.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "cff073655b4b2746f3646d290474c14a7ca717be3cdb9eacf8eee3896bb278da",
      "text": "Ana rega ana rupa.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "d077257b99aebde26cac62f50e57bfade1b59bc068f7992e3c1eb9822e387fad",
      "text": "Mas! Aku wis maca layangmu.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1765b9f7616bf519681b9f7368d54ff21adf465cde19eabae308c8937f96752",
      "text": "Tulisane Pasar Legi.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4f9ec63f75e8106b501dc63c23ef5a27b3c45c4194b028f03141d61090d1352",
      "text": "Mangga ngagem busana Jawa rumiyin. Saged nyewa wonten mriki.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d64f0530d8bdab75898bf38262890cb73e259718a6917e87acdc60ac6265b33b",
      "text": "ꦱꦼꦤꦼꦁ (seneng)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "de9a8709401865997f8ce23150cdf7bdc1bbee40113eca35978deac84540fd51",
      "text": "ꦲꦏꦸꦩꦔꦤ꧀꧈ꦏꦺꦴꦮꦺꦠꦸꦫꦸ꧉ (Aku mangan, kowe turu.)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "dee0a3a97ca5971469ad8ca5087aa335f7e7b3c580266c920839143e5b1736b7",
      "text": "Seneng banget. Aku maca papan ing gapura.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2a5df2eeab7f167e149c0f8a0b5de11139db9400f122c7a4cdc246825b28536",
      "text": "ꦒꦼꦝꦁꦱꦼꦱꦶꦱꦶꦂꦱꦼꦥꦸꦭꦸꦃꦲꦺꦮꦸ꧉ (Gedhang sesisir sepuluh ewu.)",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35d72426d0515339789b58280b46bc0bef3b17f7862fc7e85c7941704cfd685",
      "text": "seneng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e45f9d8bfcb21fa1e0370f39d5fec96bb9c29d269197b4832ce913a5123dfd43",
      "text": "Kula maos papanipun! Kangkungipun kalih ewu, nggih?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e599df1953251307de79fbab9ed975c6672a568571dbf2709b6fe0510444d776",
      "text": "ꦲꦏꦸꦭꦸꦁꦒꦸꦃꦲꦶꦁꦔꦶꦱꦺꦴꦂꦮꦶꦠ꧀꧉ (Aku lungguh ing ngisor wit.)",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "eac34feb5485297b6ff547d18359dfd3bccfde012c100e64759063222ef09ef0",
      "text": "nyekar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaf6af601ee0eb2403943f42eb878a1189414f3780cb05595fced4b73ee75fbe",
      "text": "pangkon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebaf8484c8a46cab2536f58dff1347794733493daa064c28f64c25a15abe62f7",
      "text": "pada lungsi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "eca5e49b8e0659c19fdfa19c9e9732bad96f52faae8aa500d0a1218c07e1dd7b",
      "text": "pasar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1548493f0b5a3e5ec6db9cdfd1a86ab71266ef0427e2e788eaed2e7d4c3b30f",
      "text": "Sugeng rawuh.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1f32ccc69f346cd9dfb1f00c13546fd5b303d71737bdcc496a9fdec68bd1f50",
      "text": "Lan iki pangkon, kaya sukun ing basa Arab.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbb38e6bbf65e4525eaf5aa984133032ffe5edff96e76046c38257073aef76f6",
      "text": "ꦲꦗꦶꦤꦶꦁꦝꦶꦫꦶꦱꦏꦭꦛꦶ꧈ (Ajining dhiri saka lathi,)",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefc540a9ad9d66cb1532f38836af43200389f6dfd4d9b9aa7d0c8a54ee2a973",
      "text": "pada lingsa",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff3f8ec3f94854b7c648dafd61bd028aa5a01e25d2f4511ed73fe017bec7c8ab",
      "text": "Apik. Kowe isa maca kabeh?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa1a0fe7293eecba0ad574133ca762fcb3b863da23f3f3e4b3cfe24e4a5be38",
      "text": "Iya. Akeh wong teka mrene kanggo nyekar.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
