  "audio": [
    {
      "key": "010a4e4cad318d4a64deec6879973422f52ce58b6a3c420bc107b46e62f60ad6",
      "text": "lungguh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "04638ca993cc898597fc408e73d1fb70ad0e2578297de47e0fe11ecfb771bd1a",
      "text": "ꦲꦏꦸꦩꦔꦤ꧀꧉ (Aku mangan.)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a9b81e2a928e3f5edda55dbfa7fc6bfe8651c4098b7d6507dfb4c0e50a161eb",
      "text": "ꦭꦸꦁꦒꦸꦃ (lungguh)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ac16e5348b613a6a9b6244e75166ebb9479bd005d0f695c394a6f1dfbe42af6",
      "text": "ꦲꦺꦴꦩꦃ (omah)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1305bdd783523530034129e9a6cf51f60c90c1572dae880544e7c091e7d284dd",
      "text": "Klambi Jawa. Ana ing pasar.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "13805a2087a66b7d5227cf8c049603917b2ab84d0e237d258a6e9495ea217d30",
      "text": "ꦧꦺꦴꦕꦃ (bocah)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c19d810f3fd2b44d08b1a19ab5b15b023b29d2bcbe7dd084ea222a09e034ce",
      "text": "Piye, Med? Seneng?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "185527c81280f46541177cc7de0d521228e13163b84063e63d15e58d1fda743c",
      "text": "Kene akeh wong nganggo klambi Jawa.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "19a0a4efcf05fdcd3a48f7f344a1db55671a943ab0e1d07b12d20c19baa1d751",
      "text": "makam",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d979793c5b77b01a4b1dc25851c34a686b8d9e8fd9ce5f70b7f608cff94133c",
      "text": "ꦧꦥꦏ꧀ (bapak)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d9ec1a4b1cafac104cb2db08affc903df5deee3e12a5af0d220b189ba6a148",
      "text": "cecak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f52eb2f7f4ad51cce88a8adbd19836d3cd318e9ed12bd4089b4ddc528f06a0",
      "text": "Aku arep nyekar ing makam.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "23381f08e9697ed6e056a9b7a47d8bfdb3ecc49e290709b06241407d7bf5fc56",
      "text": "ꦚꦼꦏꦂ (nyekar)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ca75cf2afb186c2e0a5b2ae6c5b5b30a2ade9a3924e08e4d1533a85c1c6dfc",
      "text": "Ayo menyang pasar saiki!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c58e767aa6e22dec966775aa7686d8f2089ac6771d31a10a544ca3589379ae3",
      "text": "Wah, kowe wis isa maca papan jeneng!",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dd3ad861a3f673e5a5bd381eb76880c51a67a8db60b1d086ad9ac71d8612191",
      "text": "Mas, iki makam raja-raja Mataram?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "334444ac1a6329b6f0a58c5818a795f8e15fc0f768a4f4cdacc4d0a7ecd6c29d",
      "text": "Bener! Pasar iki rame saben Legi.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "357704b118b45dda9f608d66cb124ce7c1864c7f3544c18e013b0dbc22a5a2b6",
      "text": "Iya, iku aturane. Ayo lungguh dhisik.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e1ce213521b1e44c496cf697de5151140a8c938f835530fc03197f196237302",
      "text": "ꦩꦠꦸꦂ (matur)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "533027d29d97e3e3f410bbb4cfd61856791a275eeb4525fa503e313eb08ff3e0",
      "text": "ꦩꦔꦤ꧀ (mangan)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "53e57a4b8e66e8c618c7f75d579bfa3ef5d68479304a02cc08748ac56e1379e7",
      "text": "Omah Kalang",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c8ef501f9cef1958680ffc658e15672ef18d57cc5b466fa54344eeac4e810b",
      "text": "papan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b47233060406ac4b0db70fc272b4447d2939ed3a77e4e5762211425fd72f21",
      "text": "Lan papan iku Omah Kalang.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b7e84ae15a0f1bb69acdedfa18fb0a56d94fda7dd891a8c30ac74475e408638",
      "text": "Seneng aku! Aku nganggo klambi apa?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "61acd558f7401d8c6432fa433c61b7e606a23ff587c9775e6b505a25b6e3bc82",
      "text": "Papan iku tulisane aksara Jawa.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "667d84353b9810cb7f5f6fe65d28b6951b5fb21dca04c085cfe253594a7fe204",
      "text": "Makam. Nganggo pangkon ing mburi!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7454d9e95bc206eb438499a605494c8e8b9dd1f8137b1742fae7e8cc0e3fa713",
      "text": "panyigeg",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "766b6a0a879bb5a9f6bf846f8955cc7da4e598d43122f98bebaca2f2773dd55b",
      "text": "bapak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8145bd3c5c419fe3ab9b9da4b77153a767532bb08718529c16b856f3b6b7dcdf",
      "text": "Med, coba wacanen tulisan iki.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "82d7dca68bf83b8a6bbf91fb8649c0a4ba7fdaf1210e30f45f5179d5ad48f732",
      "text": "Tenan? Tulisane apa?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "846bba92f193c6ae79906dd8f837e1ceb9ac9d1370c366fc07f1a6f258fbb11a",
      "text": "wignyan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "847274e29882fc149353779528d9e930b2f3656e77c2b89e35ca8a80bb20c50d",
      "text": "Aku mangan. Lho, ing mburi ana tandha apa?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ce690c0c6372f9ab609651a0a1c512721abd2d18f6d7f11a8688c5cad32837",
      "text": "ꦥꦱꦂ (pasar)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9faeb2593fe34c08cf5796b0635e99057d4343373d16f974bb7a9ceffa1476e7",
      "text": "Tulisane Pasar Legi. Legi kaya ing weton!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa488418ba3c3438e37383cac5d5540dc66aa105eb076d7d67c834b49e3a9261",
      "text": "ꦲꦺꦴꦩꦃꦏꦭꦁ (Omah Kalang)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca99a6a8b5b3c7b04368d7a7057bf5dd0637a8e8292507e280996953a28ad40",
      "text": "Med, iki papan apa?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "aedc66aee61ca443ae10b41a5852d578ceba8d40aef98995eb712839bfde7e39",
      "text": "layar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af56b35ba35662b1c1113a55164d1c9835c1cc237d5c138461e846daee8ec048",
      "text": "ꦥꦱꦂꦊꦒꦶ (Pasar Legi)",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "b172139b742efaa230c663e11341c68f35dd6f7aa9c3ff90bff16d9abaa68285",
      "text": "ꦮꦪꦁ (wayang)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5e0c9e18a1a6a3f5f7fb70a305cfe93a1d82364244d4d8e08b167a88787c172",
      "text": "Aku mangan, kowe turu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce5b980b3fa8be9451c490e857e0f9d31f2c9bddb6d2379bcdeb4b326169cfe6",
      "text": "Iku pada lungsi, kaya titik.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf66c5a39d09d81fb129f25970a2f3fa099eff0a9e5487fa3834d774d5f4db59",
      "text": "Med, sesuk awake dhewe menyang Makam Raja Mataram.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1765b9f7616bf519681b9f7368d54ff21adf465cde19eabae308c8937f96752",
      "text": "Tulisane Pasar Legi.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d64f0530d8bdab75898bf38262890cb73e259718a6917e87acdc60ac6265b33b",
      "text": "ꦱꦼꦤꦼꦁ (seneng)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "da45dad4766db2b6cd2eb26460a2acc114997a63ee74409c9e856259080c5184",
      "text": "tulisan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "de9a8709401865997f8ce23150cdf7bdc1bbee40113eca35978deac84540fd51",
      "text": "ꦲꦏꦸꦩꦔꦤ꧀꧈ꦏꦺꦴꦮꦺꦠꦸꦫꦸ꧉ (Aku mangan, kowe turu.)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "dee0a3a97ca5971469ad8ca5087aa335f7e7b3c580266c920839143e5b1736b7",
      "text": "Seneng banget. Aku maca papan ing gapura.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35d72426d0515339789b58280b46bc0bef3b17f7862fc7e85c7941704cfd685",
      "text": "seneng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eac34feb5485297b6ff547d18359dfd3bccfde012c100e64759063222ef09ef0",
      "text": "nyekar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaf6af601ee0eb2403943f42eb878a1189414f3780cb05595fced4b73ee75fbe",
      "text": "pangkon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebaf8484c8a46cab2536f58dff1347794733493daa064c28f64c25a15abe62f7",
      "text": "pada lungsi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "eca5e49b8e0659c19fdfa19c9e9732bad96f52faae8aa500d0a1218c07e1dd7b",
      "text": "pasar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1f32ccc69f346cd9dfb1f00c13546fd5b303d71737bdcc496a9fdec68bd1f50",
      "text": "Lan iki pangkon, kaya sukun ing basa Arab.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefc540a9ad9d66cb1532f38836af43200389f6dfd4d9b9aa7d0c8a54ee2a973",
      "text": "pada lingsa",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa1a0fe7293eecba0ad574133ca762fcb3b863da23f3f3e4b3cfe24e4a5be38",
      "text": "Iya. Akeh wong teka mrene kanggo nyekar.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
