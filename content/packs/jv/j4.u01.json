    },
    {
      "id": "j4.u01.l10",
      "sha256": "2f267f51c9bca4e40581c72a5e60a7020b9b0fbcc57587def431a9e1b4a93525"
    },
    {
      "id": "j4.u01.l11",
      "sha256": "075b9567f240e1d337c2fc613bef05fa0103f6d8362cca41e03901795afced9d"
    },
    {
      "id": "j4.u01.l05",
      "sha256": "781602d15ab2e951e744926996f1ef753265aa4fe62f3fdcf96dd7dfad745b74"
    }
  ],
  "audio": [
    {
      "key": "0093c5b6c1ee0c3680fed3ddc3ac0ea45b4e23b5bba1e86d2806f9a39a3bb603",
      "text": "Sampun, Bu. Sae sanget!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "0268b22dfe89e1d752a79cf92efe665475df9063361361317c0f8d7c407b8528",
      "text": "Simbah saweg sare, Bu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "088243c41b0395d3d2cea514cb3f1c36d4885e66b2830785277f3b292b446ffd",
      "text": "ningali",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a5cfcef53c6465444cb745a46322a20b33b83b9f0c76e3a56256aa27eeddeb9",
      "text": "Kula sampun nedha. Panjenengan sampun dhahar, Pak?",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1091fda5efc5eb9a2e183bd25aac064e6d89476f45c6a647ef1566c047a86e0b",
      "text": "Sampun, Mas. Simbah saweg mirsani TV.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "123c7a3f7bba8d154920ffdd7c609f1ccd4acb9ba85c5f8cb13f9ce20672df12",
      "text": "Sugeng siang, Mas. Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "18d2dadb763b4d263f76c00cfba5b8c5532b9d217f6e9be5110a9e279b289ca4",
      "text": "rawuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a9c1c5c2ba780ac68f49c0e11df08dd31e036f74cf26abcf9d0236e9d506b25",
      "text": "kondur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d4f2c5ad76de9563908d5c42b80c2a12202ab9410310912d20b689e0c5a4670",
      "text": "Bapak sampun tindak dhateng peken, Mas.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1edb2e2e096b251af25dd68a5e0ba44c48abd19d4c1f85a79dbc3ac981a942d7",
      "text": "Kondur jam pinten, Mas?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f91517e600a5dcbdad2f804ec45f441cb1adf455f29fdb83739748d6d699110",
      "text": "Sampun, Bu. Enjing Simbah siram lajeng dhahar.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "227031e3c8b0a4dcde1f34a56cb04d1ec5d9594ef8e7f2aba9578c9ad9be6baf",
      "text": "saweg",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "24c315e899887a35e3a33d4cc532effb48f268c6d629a1330bf985166af9417a",
      "text": "Sugeng rawuh, Pak. Mangga lenggah. Pak Harsono dereng kondur.",
      "voice": "jv_dimas",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c7048105d0eed954bf4388b64848ff1100487016cee46cfdfa3cf4a7734689",
      "text": "tilem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "27de27208ee8f0201e3fa358bdae0180e33c23433cbf462de82250eb83bf4f36",
      "text": "Bapak sampun kondur?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a8271235f4875406ec8143754a61c8510e06288f2459aa2a342acad0d4c0e1a",
      "text": "Sugeng siang, Mbah.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "38f3f2ae40f423709f504754215240f5aad64306f578e1f74efda799298e8607",
      "text": "Sonten, Pak Harsono kondur, lajeng Simbah sare.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b6315dd94f72dd006d7d531d76ba70c8455e3a5e9afde465f0a8a9a89721b2",
      "text": "Simbah saweg sare. Bapak kondur jam gangsal.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c5015a69aaf008a6682d14ce426605b13f9ca93f30354d2bb8d17c6de467d33",
      "text": "Inggih, purun, Bu. Kula nginum teh kemawon.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f3ba6dd489d8ba58a715674da6a85ead3d53974d3254f9cbe2e15b00bfb99d1",
      "text": "kesah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "43b375ee950eff9b4b4e76deb82de8b86a53af7f14074701541397df01aea454",
      "text": "Sugeng rawuh, Bu. Mangga lenggah.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4421d2cee84aad561a99db1fec5911a9052a8d06e72350a7cddbf9cd55c4defd",
      "text": "gelem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "470447fe6e2ed8f72067951d0ffa920936f4bc749c22a0da21a39488a6d8d87a",
      "text": "sare",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "493543b9fc27e41de2e4cd419917947877d8b9543912a6737cf2a1e6e1688f82",
      "text": "Mbah Putri ndangu, Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4beeb63927ed14574236d0571fb83f0a472a6159f29bf4c5d777ff042d5baffe",
      "text": "Mangga, Pak, diunjuk rumiyin.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d8de3eb57f0c1fc3b926e38a159d5f71e76fac8c555ce6228e976e79bfcb519",
      "text": "purun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "50f0b3241b501158439d1ad86e473842237b8b7f82c8384fa36704222163342b",
      "text": "Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "56ae638d2ab1720a42a9ac6ee23544f63d5d21bce5eb544dd6a068cad5155269",
      "text": "Bapak ngendika, Simbah saweg sare.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b8aba4527bebf3c0688f4a9308120dface76f9b3e8e5ed31f9a669d23c7660",
      "text": "Siang Simbah mirsani TV?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "591cf58ff5a472a119e7b85f649829160d7fec74eecdc4f0cb6b4ba53d4dcaf9",
      "text": "Kula sampun nginum, Bu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a0f84e7715425a8fafd568e762124660a238fce84cd115f1cad3226b7d1deeb",
      "text": "Jam gangsal, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d28edc76957097047c4a86611fb9b5e5460f618ce07c991765568a247daeb5e",
      "text": "Simbah ndangu, Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5edce04e450c6f71933411d95d60dfc5ddfb33eeed0957d6bc14841189721789",
      "text": "Mangga dhahar rumiyin, Mbah. Pak Harsono kondur jam gangsal.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fd1723e978c14f1cc9b2730d30c171c76ea1c18f294cb4fb965ae654dcfb6fe",
      "text": "Menika koshari, saking Mesir. Mangga dhahar, Mbah.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "61923720b691b076da29dea4782f6f96f8f898495ce55387b7bc331ad1aed218",
      "text": "Inggih, purun, Pak. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "62c2aa31aa937763aa1ee1c01299901ea1dfb3f6d5da94b264d522eb176c8ffc",
      "text": "Siang, Simbah mirsani TV. Kula nginum teh kaliyan Simbah.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "651b6bae8c9ff8d22ed4d5fb6ec19878d8acd4e1f94cedfcfb0bc908c5091377",
      "text": "Bapak kersa ngunjuk teh ugi?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6539c1724f951548675fade874e5f82930defd6d617ecfbd21efeec47c219a13",
      "text": "Kula badhe kesah dhateng Tugu.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "661a5e29920062af9b9ec66ecce30f4483df06b6bb3b66eb1dbd138b64cc1947",
      "text": "ngendika",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "66aa15dd2f7e2056b2e89e9f76a40dc4d820930a7c9e92d48b75aa3f71cc0dbe",
      "text": "Pak, panjenengan badhe tindak pundi?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "68328fd7bb4131d855d7acc070e2108c6fea968fabbf1953706d30bcfaccc873",
      "text": "Matur nuwun sampun rawuh, Pak. Sugeng tindak.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "695d0b76c98a262e3cddbc8db5398544aca5f5e4e475eafadba5812e982cbd68",
      "text": "siram",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "698e180259db319755a300e0b985c4629e662970ab5d9fefc65fb8435831f137",
      "text": "Kula badhe kesah dhateng Tugu, Mas.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b05e582c8730946f646e5584dc04bbd60bea446c4fe5b88fe29382c736c98e7",
      "text": "Sugeng rawuh, Mbah. Mangga lenggah.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cb1e24dbd749475ab37556bfa35e675a892ae3f2537eb087296fa947f9d02f9",
      "text": "Inggih, Pak. Sugeng tindak.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d1a3434a7414f1e0d7a2986b0bb6a3240d1f525c3f9eaaba8947f57b6de6236",
      "text": "Sampun, Bu. Simbah sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7072dbcc589e8355ef2f3d3ac2682645c0630afd11198abaa6c62fb6e272cc05",
      "text": "Dereng, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "79a86e6372ec84413e1c1beef37f087933dfa976229b9e5e2dd86f5f66c5d0b1",
      "text": "Mas Mohamed kersa ngunjuk menapa? Teh menapa kopi?",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6061f9809fd2148a9ec9711d7d11c895ea3037104e16b48e13946721218591",
      "text": "Dereng, Mbah. Mangga, panjenengan rumiyin.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d668b6cab15ec745611ce42e9a352ceb3da14bdb80ec35a247d73f4bac6fc8d",
      "text": "Simbah saweg mirsani TV.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f3079c578a832b38c45237fea61283880658d3f4328ff9591277dc5184beb78",
      "text": "Saweg sare, Bu.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f5f0a84d677d0bbc7cd299db4b641f8895eba76982348ff0275009db9606ccc",
      "text": "Sugeng rawuh, Mbah. Mangga lenggah.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "818384d096b5f1c39a9e65100b7e3cdb5f5a7ec7f08dbe1e893c2fb3b2380b8d",
      "text": "Matur nuwun, Mas.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "823b8b62fe1c8c791f152477985dbde2cf98cbfbeb0bbd7b5c932a57768760f3",
      "text": "Bapak saweg siram.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "82d95852b477b2c685c227bdd4f3b2fcc59d87011711765070bfaf16c5b80b4e",
      "text": "Kula wangsul sonten. Mangga dhahar rumiyin, Mas.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "847cffde479fda822ba6d1ed88ea8dcdd5c907c7de328f642168d3b02f26c57e",
      "text": "Simbah wonten pundi, Mas?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "864276a922697e0fa0a0d9d823c679351cd85a912609a51d59e50ebc17723837",
      "text": "Kowe gelem ngombe teh?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a8c0fd2395f892a69e9f5b4205b17aa8fc2f40343a6e3ad87b5522644a6cb46",
      "text": "Inggih. Mangga, Pak, panjenengan rumiyin.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ac1ef2fccc9d27e8048c5fa408093d5a13a5ff4d41c53442808e2ecdd315057",
      "text": "Bapak sampun tindak dhateng peken.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c903cf481b14ee60fb06a0a7aea7727cc1239f15f963aef75d56cffb5c3f7f2",
      "text": "Panjenengan kersa ngunjuk teh, Pak?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "90879ff02184252d77cfe876dbd25ac7227a64b67151eaf413b1035d3e880dc8",
      "text": "ndangu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95aaf5e491cd4e92f7c383e166c7cc1708b66128bcb0a2d1e42025c701fce06b",
      "text": "kersa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "994f540d866ba27820e1c486e1b85b044913e71752defedf81d5e31a3f61f3ae",
      "text": "Wah, taksih dangu. Kula wangsul rumiyin, Mas.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e8664d05935285acc3053f03f06a8ad7f80995ef17e5fee453405da29705b17",
      "text": "Mbah Putri wonten pundi, Bu?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c0f7a5c0f458f2a06fbf139bdbb801403e6055be5c7ced718111d58d7681d0",
      "text": "Inggih, Bu. Kula ugi ningali TV kaliyan Simbah.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a732e7a3fd5cb18dea2a42191f3aed3bc03d3340403ab628efcedb0703a58092",
      "text": "Kula badhe wangsul rumiyin.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a77f85a8960a8afb7549ec1fd6f2e18c5b2aac1a58fb6fec6613b0c793121f05",
      "text": "Enjing, Simbah siram lajeng dhahar.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9a79ac1faa5c244309e5876d15db6072af083927eacc153ffe8aac6f33cd2c8",
      "text": "Mas Mohamed, Bapak sampun tindak dhateng peken.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae79d7bab9afa9e6dc687e74b380e1b85c32358cc661c206c1399aef594770c2",
      "text": "Simbah saweg sare, Bapak dereng kondur.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5e290a64b75be79ff70aba5cb4a8e2fc6389693d350859877b22002f3d42281",
      "text": "mangga diunjuk",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b890b6b85e07327c9dcfba2afee40facc43661be08898190e1603a7ef2d5fd06",
      "text": "sugeng tindak",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba14b92019f8e16eecc5e1f23a53de97856d16bd55792f1e6a3dac08bbfd272c",
      "text": "tindak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba21845506633bf54944cdbc4687530b9df44b67a55fe57aab0d68a43f6960c4",
      "text": "Bapak ngendika, Simbah sampun dhahar.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba90ca03731f665c3b7edb16d4deafff611354cb0c520e05da56da2c9623ac94",
      "text": "Mangga diunjuk rumiyin, Pak.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf855a640f373f7da5504792860ac61192ebd6d7232dbe4a18f19902cd597f28",
      "text": "Inggih. Kula badhe kesah dhateng Tugu rumiyin, Bu.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a995edc7804fb7aef2c2f7fd543eb743b46817c0277bb5864093243d97e406",
      "text": "Mbah Putri saweg sare.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7023c4db8a4b0df573879ef80db9856d9bca918fbeabaef6e679bd7ee892b31",
      "text": "Kula sampun sanjang dhateng Mas Dimas.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c76238e75fee3060a29eca8d4e15b61bfdd925a96072f42f9df80cd3de99d6e0",
      "text": "Mboten, Mas. Simbah saweg sare.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cac8922c07c5bf1a727da37ee39d3d71d1238e647b320c2d9399b6bacd1260fa",
      "text": "ngunjuk",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbbd27e385290944386b944e8064a1a3feb03d50b3d016a3313d4dd6a38e8af7",
      "text": "Kula ugi, Pak. Simbah kersa tindak ugi?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6f2ef52f77d783df0ba0f3ee7f3dbaf5d3de52861a84a4e05562f30e3ffe4e",
      "text": "Mas, Simbah sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d54e64baffbcceafd6eabc9cada8559b4386a29302d86285b90331f8f31bf885",
      "text": "Mangga dhahar rumiyin, Mas.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6466cd0d28f77fada674247458d250d1459eaa7929132630c7db6c433d7743c",
      "text": "Teh kemawon, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8f54054f8a02906d10970bdb497a68b1698c3c6683fb13f2812ffce18a23878",
      "text": "Matur nuwun, Mas. Wah, menika menapa?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e10d3f55564bb96e8297d237a6cd6a4f69cf0604ee623b00142a43f2b70e7f2e",
      "text": "Wah, sae sanget. Matur nuwun, Mas.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3a8964f4c6c0bd4b8cb1e5a498a6160a1d9cbcdde17739fd86735c99f18a639",
      "text": "Inggih. Mangga, Mas, diunjuk.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3e8cee1c8f247d78e5cca5cc5625db88cf847f898657d49260ef1e3e0674ac4",
      "text": "Sugeng rawuh, Pak. Mangga lenggah.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e450b3fc5bda01670c35f4fe50dfa8483fec2b2f7c54fd08b9756cc0d7e32f59",
      "text": "Nyuwun sewu, Mas. Pak Harsono wonten?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e63b8d50f9ebb88407e8e9dca259b486bf84cfe9b0f5b01edae9a6db8455f09d",
      "text": "Sugeng enjing, Bu. Bapak wonten?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec413d245f58b94778fa3d444071fd79c7931c3ef422962750f8cd0bf8057667",
      "text": "Kula badhe wangsul rumiyin. Sugeng tindak, Pak.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed62a8cefe8a66ef5234187a6557a645d83be686b1fb53a9fca8f3fc09cf07f4",
      "text": "Mas Mohamed sampun ningali Tugu?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef6c2b575865a96f3d5b81c6e1d177566fff8ed842bbd5073101dd567a975c65",
      "text": "sanjang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "efc66408af44cab639507a148ad977d8764d57ea60dc7f2af974e37a0507394d",
      "text": "lenggah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "efcedaf31c543d4b26dbbb0b74b1a7aa1a617a04d4b502dafeda3e00507af524",
      "text": "Mangga diunjuk, Mbah.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "eff03734b50dd635d2cec8d37f5e5075b1d47f2f5c548c84bcfb179614e6f8ef",
      "text": "nginum",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0db5594c251edf4f4aa286da31621565d5100e9b39a2555ff38effe2208059a",
      "text": "Nyuwun sewu, Bapak saweg siram.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f13e490e0b9bbd97ef30cd49479ab2366c7f63155b95e362435083d2f87959cd",
      "text": "Panjenengan kersa ngunjuk kopi, Pak?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f14756a829fac780da04210f198454bca02f3701ae15375088bd8c419965e1f5",
      "text": "Dereng, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2413b07521993618f68f84be00811de81a0c21c4f0f72ac796444d79d80217d",
