  "audio": [
    {
      "key": "0093c5b6c1ee0c3680fed3ddc3ac0ea45b4e23b5bba1e86d2806f9a39a3bb603",
      "text": "Sampun, Bu. Sae sanget!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "0268b22dfe89e1d752a79cf92efe665475df9063361361317c0f8d7c407b8528",
      "text": "Simbah saweg sare, Bu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c22ae6ad1109460fbfd30851c385474d8aff7cf07c592455f074055cc1e4d4",
      "text": "Simbah miyos ing Yogyakarta.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "045426f24acaa6cc8c435797bd2c4fb52786be158d151b750cf22532ef8d5094",
      "text": "Kula lair ing Kairo, Mbah.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "06a00a867edb7970d0dd2b442eb090d4ff35fe6c7b2c77f00f04b53747acdc2a",
      "text": "Pak Harsono nitih andhong.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "088243c41b0395d3d2cea514cb3f1c36d4885e66b2830785277f3b292b446ffd",
      "text": "ningali",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a2f2778226b0efd381d1be1268242238e338fc340ee974d22bcd0a3d95e9a27",
      "text": "Kula ngrantos wonten mriki, Bu.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a5cfcef53c6465444cb745a46322a20b33b83b9f0c76e3a56256aa27eeddeb9",
      "text": "Kula sampun nedha. Panjenengan sampun dhahar, Pak?",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1091fda5efc5eb9a2e183bd25aac064e6d89476f45c6a647ef1566c047a86e0b",
      "text": "Sampun, Mas. Simbah saweg mirsani TV.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "119b1bcdd7e390d84a9bcf26f57f407bcf5e65a4f6ef80212bd51e126f4abe3f",
      "text": "Sae, Nak. Alon-alon mawon.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "123c7a3f7bba8d154920ffdd7c609f1ccd4acb9ba85c5f8cb13f9ce20672df12",
      "text": "Sugeng siang, Mas. Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "169ceaa127f85d0d4ce8142fdc50cb0770f41b3c0d508b2e5ccea04a367569a9",
      "text": "Bapak nitih andhong dhateng Malioboro.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "184a41faad19ed2158187146211531bd037c75668e4cf08f1a45d48dbc8c5aca",
      "text": "Mbah, Simbah miyos ing pundi?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "18d2dadb763b4d263f76c00cfba5b8c5532b9d217f6e9be5110a9e279b289ca4",
      "text": "rawuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1911ee77f8ab0915e4514617331b3e69af1ef4eb2d2700e839dedafbce3e756e",
      "text": "Simbah miyos ing Kotagede.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a9c1c5c2ba780ac68f49c0e11df08dd31e036f74cf26abcf9d0236e9d506b25",
      "text": "kondur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d4f2c5ad76de9563908d5c42b80c2a12202ab9410310912d20b689e0c5a4670",
      "text": "Bapak sampun tindak dhateng peken, Mas.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e78db200801e3a7317085ffc30c6edc0a53b00a49bb0489cbcc44c1aa57fe27",
      "text": "Simbah jumeneng, kula inggih ngadeg.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1edb2e2e096b251af25dd68a5e0ba44c48abd19d4c1f85a79dbc3ac981a942d7",
      "text": "Kondur jam pinten, Mas?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f91517e600a5dcbdad2f804ec45f441cb1adf455f29fdb83739748d6d699110",
      "text": "Sampun, Bu. Enjing Simbah siram lajeng dhahar.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "209e8fb32b29e75fec153b6f335303f0742502595b4e9e2ed3f746ad27649e38",
      "text": "Simbah nimbali panjenengan.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "220daa3b7a923e09ebc18d5f6e11f97be56775fa9f7fd55c4d5a1a11663065b0",
      "text": "Mas Mohamed, Simbah nimbali panjenengan.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "22568f617c9406b2959b32b2c3941b69cd2865917ea85cac3a6ff64247346cfe",
      "text": "Kula nyerat pangandikanipun Simbah.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "227031e3c8b0a4dcde1f34a56cb04d1ec5d9594ef8e7f2aba9578c9ad9be6baf",
      "text": "saweg",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22fd7b03a4a427d74d33ff659819eabfb68093cc82bbe401098c76eece4863b2",
      "text": "Bapak nimbali panjenengan, Mas.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "24c315e899887a35e3a33d4cc532effb48f268c6d629a1330bf985166af9417a",
      "text": "Sugeng rawuh, Pak. Mangga lenggah. Pak Harsono dereng kondur.",
      "voice": "jv_dimas",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c7048105d0eed954bf4388b64848ff1100487016cee46cfdfa3cf4a7734689",
      "text": "tilem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "272eadfcfb4f79e098acacdf4be85b836791388792147c95f602775f28365ebf",
      "text": "Bapak kesupen ngasta serat.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "27d6981e386ab3862e9cc16f6f897d91862c61fe10da4f72d2bba4640e51592c",
      "text": "Inggih, Mbah. Kula damelaken rumiyin.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "27de27208ee8f0201e3fa358bdae0180e33c23433cbf462de82250eb83bf4f36",
      "text": "Bapak sampun kondur?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a8271235f4875406ec8143754a61c8510e06288f2459aa2a342acad0d4c0e1a",
      "text": "Sugeng siang, Mbah.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b69246529f3fa6b67e11b03f6e721b42be32365a23c20ded798073785ae6094",
      "text": "ngrungokake",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd1658f6ec5126ad2beb1608a732e76af16c17f888d8040db282d478849903d",
      "text": "Kula enget, Bu. Seratipun sampun kula wangsulaken.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "30d8b63db98ab9d9de2c3a66ba21efb4c0174644b9c43e7e7922c524166ec5d1",
      "text": "penggalih",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3335c361d4c2fef3a293abde64c09c8fe5a65fca9fe4a4846b97040d00a09b99",
      "text": "nimbali",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "352c531a0524a4447322e113d71bc518e2a1c5cbe2e4362ba8281ab86ddfd416",
      "text": "Bapak saweg ___ koran.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "361a8e7e47a76f1b2dba5fdaeabcb97147d5ae1da836a6ff5c1ccc8e746b6b5d",
      "text": "Pangandikanipun Simbah kula serat ing buku.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c606d678315dfee92cae3c78108cf0a0851d2098c20a84d5b3359790cbf004",
      "text": "Nyuwun pangapunten, Pak, kula supe.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "38f3f2ae40f423709f504754215240f5aad64306f578e1f74efda799298e8607",
      "text": "Sonten, Pak Harsono kondur, lajeng Simbah sare.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b6315dd94f72dd006d7d531d76ba70c8455e3a5e9afde465f0a8a9a89721b2",
      "text": "Simbah saweg sare. Bapak kondur jam gangsal.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c5015a69aaf008a6682d14ce426605b13f9ca93f30354d2bb8d17c6de467d33",
      "text": "Inggih, purun, Bu. Kula nginum teh kemawon.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dfad8126549301d0e1ea1a2c323de656498499a4a0505f079c9eadd0d0d540c",
      "text": "Mohamed, ayo ngadeg! Pak Harsono rawuh, lho.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f3ba6dd489d8ba58a715674da6a85ead3d53974d3254f9cbe2e15b00bfb99d1",
      "text": "kesah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ff49da2356f595c181d9dfbc40b271dd3c9230fa106ea738183ba855f9b9214",
      "text": "jumeneng",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "43b375ee950eff9b4b4e76deb82de8b86a53af7f14074701541397df01aea454",
      "text": "Sugeng rawuh, Bu. Mangga lenggah.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4421d2cee84aad561a99db1fec5911a9052a8d06e72350a7cddbf9cd55c4defd",
      "text": "gelem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "470447fe6e2ed8f72067951d0ffa920936f4bc749c22a0da21a39488a6d8d87a",
      "text": "sare",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "48c89e76c3e66798d305bbc86bfc607d34ab53c145b484e912c6cbaa552a1d5d",
      "text": "Mas, Bapak kesupen ngasta serat menika.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "493543b9fc27e41de2e4cd419917947877d8b9543912a6737cf2a1e6e1688f82",
      "text": "Mbah Putri ndangu, Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a336221d1acab8892df3ab6965da1252f3b0402d0140b9d25059e1a38cf004c",
      "text": "Simbah ___ nami kula.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a7e4c2dee20238ae002e1286f506abf0b0d653cda8e59bd9d2e84e1986da1c0",
      "text": "Mangga. Ampun supe, nggih!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b58b6a567bf3354e8a1f89ddeb8eda53ad70615e116f596f70b8426b3668e71",
      "text": "Titihanipun Bapak andhong.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4beeb63927ed14574236d0571fb83f0a472a6159f29bf4c5d777ff042d5baffe",
      "text": "Mangga, Pak, diunjuk rumiyin.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d8de3eb57f0c1fc3b926e38a159d5f71e76fac8c555ce6228e976e79bfcb519",
      "text": "purun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5050aebf8472b798544448c12b08356c33c91ae743cd79ec5da356abd3297637",
      "text": "cangkir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "50f0b3241b501158439d1ad86e473842237b8b7f82c8384fa36704222163342b",
      "text": "Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "52268c0ff7f9b9440f49d8e03c292b8c893f60702f4e11a17511699668db08a8",
      "text": "Pak Harsono ___ lajeng tindak.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "530c755db463fa2e0556951d44a7e0260c184c96e3b46ed0c968668fc939ffc9",
      "text": "ngersakaken",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "54712c4d7bf29a1d041b1fa31e8e000df2fbfb68864d43bc20c8c2710e5b8263",
      "text": "wangsulaken",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "569198358cfdbc82ec5faf0eb8cea2ea11a65b585e0fe84a23418d76aa51be16",
      "text": "Bu, kula nyuwun ngampil payung. Benjang kula wangsulaken.",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "56ae638d2ab1720a42a9ac6ee23544f63d5d21bce5eb544dd6a068cad5155269",
      "text": "Bapak ngendika, Simbah saweg sare.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "577bf058d49b22b97b9150ddb3981be075d6e8595cc5311808578dcbf0957b47",
      "text": "enget",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "58b8aba4527bebf3c0688f4a9308120dface76f9b3e8e5ed31f9a669d23c7660",
      "text": "Siang Simbah mirsani TV?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "591cf58ff5a472a119e7b85f649829160d7fec74eecdc4f0cb6b4ba53d4dcaf9",
      "text": "Kula sampun nginum, Bu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a0f84e7715425a8fafd568e762124660a238fce84cd115f1cad3226b7d1deeb",
      "text": "Jam gangsal, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bc29d7e3c7bffb6548af67b4243cecc956ad32bfaa590eb8fb584e6b923637e",
      "text": "ngampil",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d28edc76957097047c4a86611fb9b5e5460f618ce07c991765568a247daeb5e",
      "text": "Simbah ndangu, Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e33b6ec3efb0d9ff5b388cca65047b4f81df4f02bb90e82c2df75dffd9c64d5",
      "text": "Aku arep ngrungokake radio karo Simbah.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5edce04e450c6f71933411d95d60dfc5ddfb33eeed0957d6bc14841189721789",
      "text": "Mangga dhahar rumiyin, Mbah. Pak Harsono kondur jam gangsal.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa2952b02cfee36a3e8dee46a338c8a79d21f64975ae9f1dfd8e7263ae1fb2e",
      "text": "Matur nuwun, Pak. Kula kepengin numpak andhong ugi.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fd1723e978c14f1cc9b2730d30c171c76ea1c18f294cb4fb965ae654dcfb6fe",
      "text": "Menika koshari, saking Mesir. Mangga dhahar, Mbah.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "61923720b691b076da29dea4782f6f96f8f898495ce55387b7bc331ad1aed218",
      "text": "Inggih, purun, Pak. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "62c2aa31aa937763aa1ee1c01299901ea1dfb3f6d5da94b264d522eb176c8ffc",
      "text": "Siang, Simbah mirsani TV. Kula nginum teh kaliyan Simbah.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "651b6bae8c9ff8d22ed4d5fb6ec19878d8acd4e1f94cedfcfb0bc908c5091377",
      "text": "Bapak kersa ngunjuk teh ugi?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6539c1724f951548675fade874e5f82930defd6d617ecfbd21efeec47c219a13",
      "text": "Kula badhe kesah dhateng Tugu.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "661a5e29920062af9b9ec66ecce30f4483df06b6bb3b66eb1dbd138b64cc1947",
      "text": "ngendika",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "66aa15dd2f7e2056b2e89e9f76a40dc4d820930a7c9e92d48b75aa3f71cc0dbe",
      "text": "Pak, panjenengan badhe tindak pundi?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "68328fd7bb4131d855d7acc070e2108c6fea968fabbf1953706d30bcfaccc873",
      "text": "Matur nuwun sampun rawuh, Pak. Sugeng tindak.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "695d0b76c98a262e3cddbc8db5398544aca5f5e4e475eafadba5812e982cbd68",
      "text": "siram",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "698e180259db319755a300e0b985c4629e662970ab5d9fefc65fb8435831f137",
      "text": "Kula badhe kesah dhateng Tugu, Mas.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a45224a0696802152d86c9cee53d611e069be53592971e710f9046f58e0885b",
      "text": "jahe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b05e582c8730946f646e5584dc04bbd60bea446c4fe5b88fe29382c736c98e7",
      "text": "Sugeng rawuh, Mbah. Mangga lenggah.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ba72bb6e101862617869ccc9857d410ac97b2cc91f754a81c907397477114a3",
      "text": "andhong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bc89129ec7b000ea6b66dc477bc2337ae2ffec4b72389d476bacf44bf8ff5d0",
      "text": "Mangga, benjang numpak kaliyan Dimas.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cb1e24dbd749475ab37556bfa35e675a892ae3f2537eb087296fa947f9d02f9",
      "text": "Inggih, Pak. Sugeng tindak.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d1a3434a7414f1e0d7a2986b0bb6a3240d1f525c3f9eaaba8947f57b6de6236",
      "text": "Sampun, Bu. Simbah sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7072dbcc589e8355ef2f3d3ac2682645c0630afd11198abaa6c62fb6e272cc05",
      "text": "Dereng, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7966a2f3dbad7dd67b60b7edba1c0beeb06d08880168f0ef287fa303bb3d392b",
      "text": "midhanget",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "79a86e6372ec84413e1c1beef37f087933dfa976229b9e5e2dd86f5f66c5d0b1",
      "text": "Mas Mohamed kersa ngunjuk menapa? Teh menapa kopi?",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6061f9809fd2148a9ec9711d7d11c895ea3037104e16b48e13946721218591",
      "text": "Dereng, Mbah. Mangga, panjenengan rumiyin.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b149b321fe6546d320abbd040d42d581a5b55ed59bc3e74e1cc08998a08be2b",
      "text": "miyos",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d668b6cab15ec745611ce42e9a352ceb3da14bdb80ec35a247d73f4bac6fc8d",
      "text": "Simbah saweg mirsani TV.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d748abf60e4f9d46e31a615135e9779c2d17735538872de6f3904b0884e5c65",
      "text": "Kula lair ing Kotagede, Nak. Sampun dangu sanget.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e877881d48e424d026b28f783a840bc12fb402e3691ea79fe5b1407c35842e5",
      "text": "Kula nyuwun ngampil bukunipun, Pak. Benjang kula wangsulaken.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f3079c578a832b38c45237fea61283880658d3f4328ff9591277dc5184beb78",
      "text": "Saweg sare, Bu.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f5f0a84d677d0bbc7cd299db4b641f8895eba76982348ff0275009db9606ccc",
      "text": "Sugeng rawuh, Mbah. Mangga lenggah.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "818384d096b5f1c39a9e65100b7e3cdb5f5a7ec7f08dbe1e893c2fb3b2380b8d",
      "text": "Matur nuwun, Mas.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8220d417740bb91dace44b57f9e3d5c8e826ecc544c0b13e73122cf264ccb926",
      "text": "Aku eling, aku wis mbalekake bukune.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "823b8b62fe1c8c791f152477985dbde2cf98cbfbeb0bbd7b5c932a57768760f3",
      "text": "Bapak saweg siram.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "82d95852b477b2c685c227bdd4f3b2fcc59d87011711765070bfaf16c5b80b4e",
      "text": "Kula wangsul sonten. Mangga dhahar rumiyin, Mas.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "847cffde479fda822ba6d1ed88ea8dcdd5c907c7de328f642168d3b02f26c57e",
      "text": "Simbah wonten pundi, Mas?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "84d97a8c160b787595bfed27c7de43e08782d02c4be5f3c98c1e9bdce313d477",
      "text": "Mbah, Simbah ngersakaken menapa?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "864276a922697e0fa0a0d9d823c679351cd85a912609a51d59e50ebc17723837",
      "text": "Kowe gelem ngombe teh?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "86e38a23e726e919f375cf5840b2a293a0c66c31c2718a17936b03694a08e817",
      "text": "nggalih",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8890d98c558917ce3a3186d241157df2c5f41d4a894cf96eb73f9cc48664ca45",
      "text": "kepengin",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "89341a923191ef88ca70e2dc78eb81611044ce1b56472342e66b78d11bcf8649",
      "text": "wedang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a8c0fd2395f892a69e9f5b4205b17aa8fc2f40343a6e3ad87b5522644a6cb46",
      "text": "Inggih. Mangga, Pak, panjenengan rumiyin.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ac1ef2fccc9d27e8048c5fa408093d5a13a5ff4d41c53442808e2ecdd315057",
      "text": "Bapak sampun tindak dhateng peken.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c903cf481b14ee60fb06a0a7aea7727cc1239f15f963aef75d56cffb5c3f7f2",
      "text": "Panjenengan kersa ngunjuk teh, Pak?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f3abcb38ac36c5d74844f40745a3ebaaa3b4a9f6b0d70d22dc543405065fb61",
      "text": "kesupen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "90879ff02184252d77cfe876dbd25ac7227a64b67151eaf413b1035d3e880dc8",
      "text": "ndangu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95aaf5e491cd4e92f7c383e166c7cc1708b66128bcb0a2d1e42025c701fce06b",
      "text": "kersa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "96cad1a14bce70c1483cd2e4d51c0f419701e0f5530aaa387cff7d092af3a403",
      "text": "Inggih, matur nuwun. Bapak wonten masjid.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "980f08557c5e88c67999fd3282a5fe4edfd42e9829c8bdc1359af1716c8f2ae8",
      "text": "titihan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "994f540d866ba27820e1c486e1b85b044913e71752defedf81d5e31a3f61f3ae",
      "text": "Wah, taksih dangu. Kula wangsul rumiyin, Mas.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "998d622248ff1065f421258c81df47e4c0dbd85daba797486739cbb6607e16a3",
      "text": "Simbah ngendika. ___ Simbah sae sanget.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a3d21b1af281c6da4c1f15cfe41c6fb843078f5d6aa22534ed6d23c6415ea64",
      "text": "mbalekake",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e8664d05935285acc3053f03f06a8ad7f80995ef17e5fee453405da29705b17",
      "text": "Mbah Putri wonten pundi, Bu?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5194b9457c20dcf22eaf47b421fd7416c3d642acd72b9e781b75820f430d45a",
      "text": "supe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c0f7a5c0f458f2a06fbf139bdbb801403e6055be5c7ced718111d58d7681d0",
      "text": "Inggih, Bu. Kula ugi ningali TV kaliyan Simbah.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a732e7a3fd5cb18dea2a42191f3aed3bc03d3340403ab628efcedb0703a58092",
      "text": "Kula badhe wangsul rumiyin.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a77f85a8960a8afb7549ec1fd6f2e18c5b2aac1a58fb6fec6613b0c793121f05",
      "text": "Enjing, Simbah siram lajeng dhahar.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9a7898a221de918957a23df28818469917b6b8c1bb0788ebc02c24259197346",
      "text": "Simbah saweg nggalih tembung menika.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9a79ac1faa5c244309e5876d15db6072af083927eacc153ffe8aac6f33cd2c8",
      "text": "Mas Mohamed, Bapak sampun tindak dhateng peken.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae79d7bab9afa9e6dc687e74b380e1b85c32358cc661c206c1399aef594770c2",
      "text": "Simbah saweg sare, Bapak dereng kondur.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "af866f8da0f68e18612c8e5ff74ebbcc5cdadf428888c17e2e3382945085468a",
      "text": "ndhawuhi",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b59fc88f9ebd58cc22b70d96769d7cdec4aebf9f03ce2c795f28212545e553ea",
      "text": "dhokar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5e290a64b75be79ff70aba5cb4a8e2fc6389693d350859877b22002f3d42281",
      "text": "mangga diunjuk",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b890b6b85e07327c9dcfba2afee40facc43661be08898190e1603a7ef2d5fd06",
      "text": "sugeng tindak",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba14b92019f8e16eecc5e1f23a53de97856d16bd55792f1e6a3dac08bbfd272c",
      "text": "tindak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba21845506633bf54944cdbc4687530b9df44b67a55fe57aab0d68a43f6960c4",
      "text": "Bapak ngendika, Simbah sampun dhahar.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba90ca03731f665c3b7edb16d4deafff611354cb0c520e05da56da2c9623ac94",
      "text": "Mangga diunjuk rumiyin, Pak.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bca7a91067b0d2810514bf92e68eb09085d31bff084305ee0217e2c57ab89aed",
      "text": "Aku kepengin numpak dhokar.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf532b494284b7759229080ce5569f2ceee42eb5ff5b969d817573b24529200a",
      "text": "ngrantos",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf855a640f373f7da5504792860ac61192ebd6d7232dbe4a18f19902cd597f28",
      "text": "Inggih. Kula badhe kesah dhateng Tugu rumiyin, Bu.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c27a9b8ac828d523f93dc59f5f4715abaa3ae16b4f7789d961668d910ff2a66e",
      "text": "Bapak ___ kula tumbas teh.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c45f9c8c3b9e508868a6c820ad0141adde38cedc11e1da6e56a5ea00756bff43",
      "text": "Kairo tebih sanget! Basa Jawi angel, nggih?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a995edc7804fb7aef2c2f7fd543eb743b46817c0277bb5864093243d97e406",
      "text": "Mbah Putri saweg sare.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7023c4db8a4b0df573879ef80db9856d9bca918fbeabaef6e679bd7ee892b31",
      "text": "Kula sampun sanjang dhateng Mas Dimas.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c76238e75fee3060a29eca8d4e15b61bfdd925a96072f42f9df80cd3de99d6e0",
      "text": "Mboten, Mas. Simbah saweg sare.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca8c50bf181e1542db1629f07f09c78690cf907604f0515a845a1170c69e1525",
      "text": "serat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cac8922c07c5bf1a727da37ee39d3d71d1238e647b320c2d9399b6bacd1260fa",
      "text": "ngunjuk",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb61f9683b6874b0d9e20b7ce58ea6c4e1130470f4c729337d27e81026fa8a6a",
      "text": "Sampun dados penggalih, Mbah.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbbd27e385290944386b944e8064a1a3feb03d50b3d016a3313d4dd6a38e8af7",
      "text": "Kula ugi, Pak. Simbah kersa tindak ugi?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6f2ef52f77d783df0ba0f3ee7f3dbaf5d3de52861a84a4e05562f30e3ffe4e",
      "text": "Mas, Simbah sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce72eea16d5143a90129a3160fa5ed635e228366ea4dfd65d8066cfb263edcd2",
      "text": "Simbah ngersakaken wedang jahe.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14146db4a8896b6912317f9d36a5ed72004439a17b2e752d4e7ae4ce559d7f3",
      "text": "maos",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d18cf92f2431bc2cc7f2899ed58fc8c5f2f174171702bc8c1c4de4b6729fc8f8",
      "text": "Inggih, Mbah. Pangandikanipun Simbah kula serat ing buku.",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d338bd812088d205dd222afaf911742a9fbd1bbff009ef724dbe957e63241f53",
      "text": "Lenggah kemawon, Nak.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d54e64baffbcceafd6eabc9cada8559b4386a29302d86285b90331f8f31bf885",
      "text": "Mangga dhahar rumiyin, Mas.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6466cd0d28f77fada674247458d250d1459eaa7929132630c7db6c433d7743c",
      "text": "Teh kemawon, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7f62d776fa0facd76eb0127f228c7c008708bee639e11e58a42f7bfc1839416",
      "text": "Inggih, Bu. Kula aturaken dhateng Bapak?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8f54054f8a02906d10970bdb497a68b1698c3c6683fb13f2812ffce18a23878",
      "text": "Matur nuwun, Mas. Wah, menika menapa?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "da5f19428500f5441a8a69c98106cf2c1dbf06b3bbcc793bd6052b1ff5aa107a",
      "text": "nyerat",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbbae59ebd845edb02e17aaa104f6e4b27c0e7537eec0b835d64276a6fe2f142",
      "text": "pangandika",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e10d3f55564bb96e8297d237a6cd6a4f69cf0604ee623b00142a43f2b70e7f2e",
      "text": "Wah, sae sanget. Matur nuwun, Mas.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3a8964f4c6c0bd4b8cb1e5a498a6160a1d9cbcdde17739fd86735c99f18a639",
      "text": "Inggih. Mangga, Mas, diunjuk.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e450b3fc5bda01670c35f4fe50dfa8483fec2b2f7c54fd08b9756cc0d7e32f59",
      "text": "Nyuwun sewu, Mas. Pak Harsono wonten?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fa60c605e621ee8266d63c3b8181080f823fef74fc05c6133882beaa6f651f",
      "text": "Inggih, Bu. Simbah wonten pundi?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e63b8d50f9ebb88407e8e9dca259b486bf84cfe9b0f5b01edae9a6db8455f09d",
      "text": "Sugeng enjing, Bu. Bapak wonten?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec3fece56d895b74804468e47cec8456c7e359de22d34e8269eecb85d94fbcb6",
      "text": "Nitih andhong saka Malioboro.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec413d245f58b94778fa3d444071fd79c7931c3ef422962750f8cd0bf8057667",
      "text": "Kula badhe wangsul rumiyin. Sugeng tindak, Pak.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed62a8cefe8a66ef5234187a6557a645d83be686b1fb53a9fca8f3fc09cf07f4",
      "text": "Mas Mohamed sampun ningali Tugu?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef65f175c06ad1813aecaf8ddcd2a67c114da1795608a5812439b99af972df29",
      "text": "Pak Harsono nitih apa, Mas?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef6c2b575865a96f3d5b81c6e1d177566fff8ed842bbd5073101dd567a975c65",
      "text": "sanjang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "efc66408af44cab639507a148ad977d8764d57ea60dc7f2af974e37a0507394d",
      "text": "lenggah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "efcedaf31c543d4b26dbbb0b74b1a7aa1a617a04d4b502dafeda3e00507af524",
      "text": "Mangga diunjuk, Mbah.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "eff03734b50dd635d2cec8d37f5e5075b1d47f2f5c548c84bcfb179614e6f8ef",
      "text": "nginum",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0db5594c251edf4f4aa286da31621565d5100e9b39a2555ff38effe2208059a",
      "text": "Nyuwun sewu, Bapak saweg siram.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f13e490e0b9bbd97ef30cd49479ab2366c7f63155b95e362435083d2f87959cd",
      "text": "Panjenengan kersa ngunjuk kopi, Pak?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f14756a829fac780da04210f198454bca02f3701ae15375088bd8c419965e1f5",
      "text": "Dereng, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2413b07521993618f68f84be00811de81a0c21c4f0f72ac796444d79d80217d",
      "text": "wangsul",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f370755c1b6261dd58b50be7ffb20c3a53e45d71a81089c4f65df251f2424baf",
      "text": "mirsani",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39cd7cefc92af74b3c56d76a760d1e9a2da31db5fde8655c5b1a9e890fb6a22",
      "text": "Wedang jahe, Nak. Setunggal cangkir kemawon.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3d016ff35a87f112c8464f3171c194371880bf6ae02b278af5f4a9964e455c9",
      "text": "Simbah ngersakaken wedang jahe?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6502fc3c44123558a3b644fcdab92418200b7682d15c0b1bcb15dc140ea0950",
      "text": "Simbah saweg sare.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8fdf60aaf9fde0a7300dd3189a09c1fdd697b970b162dea673a69cb4fd24566",
      "text": "Nyuwun pangapunten, Pak, kula ___ nami panjenengan.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "faed053c7f234916f0ed1b4247b362c87eb23612f89b401398c4392ff2d64b14",
      "text": "Wonten pendhapa, saweg midhanget gendhing.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc061141cb417690d5d4a6ef4ba0d8334dc5fc7c8cb7d7b21d753a9bb88c085e",
      "text": "nitih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc6e7cda4f1d537202a50bcb2cd05f47748e6236093cd9c26d794c39cfb23d13",
      "text": "Mas Dimas ngrungokake radio. Simbah uga ___ radio.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff827f2b74632e171ce184a5ea062d4bc4b780d6693e65f6152a363d80c98968",
      "text": "Inggih, Bu. Kula enget.",
