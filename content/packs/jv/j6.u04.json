    },
    {
      "id": "j6.u04.l12",
      "sha256": "c31c3de1cb97be8b0723968034bfbee6b73e0f0e3fcdbefd3cf280aa60851f7c"
    },
    {
      "id": "j6.u04.l13",
      "sha256": "5879ed65a56c2b8a040d05bb65a5b8e405023f7b9a4651652a7f90f05657d044"
    }
  ],
  "audio": [
    {
      "key": "010a0d7f96401ea1d5651dffe3c11b47b2f89797fbe806683ef1f2b6c6ec4f1b",
      "text": "Bu Guru mulang aksara Jawa nganggo kapur lan papan tulis.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "02ab61a788a022a9600b22eebc1759c9c078fcbff12a0be2f9e643077714745f",
      "text": "Ing gang Rukunan, jam pitu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "040a6e5778ee3d7adc6c38b8d55191ee61f580b0eab6d2682605860a7f36e620",
      "text": "Isa. Kowe tukang perak, duwe anak loro.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "06be4219a8f68ebbeb02f28c68bbb9db26be85ece54ca895bdc6aaa1cbe3f2e4",
      "text": "Inggih. Malem Minggu wonten pagelaran ing sekolahipun.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "07789d88751788f6d8e70e8e18b0eaf8572f68fa7d8dc68687d3f59781f81018",
      "text": "ꦏꦚ꧀ꦕ (kanca)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "080921e7620d4799cbae52e77bd28f2dbae1f81e775cf8d065d49b5111a414a2",
      "text": "kapur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a827aa2a45b3ff44979c9022da413d391303f401213134dc4615fbe0a43a345",
      "text": "Sugeng enjing, Pak. Kula sampun saged maos lan nyerat.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dbac7c02fc97326bc4db415e1512d289ddcc6decbd0ed2cb5606815218306b8",
      "text": "Bu Guru nulis aksara ing papan tulis nganggo kapur.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e0a83ee579c06cd72e30d0202d5c6c8a17d9b7635a18cc382ea2f2946580cf1",
      "text": "Ayo. Lho, kok wedange dipanasi ing anglo?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e0ff4d8b7e172ad7b03f0d2b7a24537147ff85dbd2b79908a29b2beac803bc4",
      "text": "sendhang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "10783b60a9dff4a0534ac9991098d2a9adc1a250136577e86cbc8b8bbfb7076d",
      "text": "pindhah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1260946220ee1440ddbbfd4c2cd9c23f514e158e516c75c007933c6690102fcd",
      "text": "Alhamdulillah. Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c2681db6a54c53dae688d50a2891c3932e15cf3eb41d1d44db69a0fd1a4021",
      "text": "← ꦏꦿꦠꦺꦴꦤ꧀ꦔꦪꦺꦴꦒꦾꦏꦂꦠ (Kraton Ngayogyakarta)",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "15c3aba08f118a5af51ac33805ba1f83d775b045a68b51a0245577bddff47565",
      "text": "Tembok ing pojok menika menapa?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "15daf6e4c42e9aa4909295f2f20d5025814c8c1fc2940b515d6857e23b8404dd",
      "text": "mulang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c0b0d4b92cad3b7bc5d9a3fd16618b8a809605b2a2153ae34f321c4e681377d",
      "text": "Tulisane aksara Jawa kabeh.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ed1dcdc7b5bc3032de7d78e0d5218755dda60fe2590b24d3bacd429c1373df5",
      "text": "mlipir",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "213ed16797a6e2099f13c46d22123e4992249b52d57ce148f704e0ac96bc60f7",
      "text": "Layang kanggo Pak Slamet, nganggo aksara Jawa.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d68bb972d8b754f50b81280971cf3e4d0ae1a9883bdcd47debdcd441f6dacd",
      "text": "ꦩꦠꦸꦂꦤꦸꦮꦸꦤ꧀ꦱꦔꦼꦠ꧀꧉ꦩꦺꦴꦲꦩꦺꦢ꧀ (Matur nuwun sanget. Mohamed)",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2390a52f91f9e2562abbe2a062797e6de5e3e95bda3dc2096a03bf3f3b5db37f",
      "text": "ꦲꦤꦏ꧀ꦭꦤꦁ (anak lanang)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "246b8cc13e37dd9a744cc271e00e8de5724bbacf2ba86bfa6d6d7dc17625c0b6",
      "text": "ꦗꦼꦤꦼꦁꦏꦸꦧꦶꦩꦺꦴ꧉ꦲꦏꦸꦠꦸꦏꦁꦥꦼꦫꦏ꧀꧉ (Jenengku Bimo. Aku tukang perak.)",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "25768506ad6e582b69a7630a8ef8606265d1b95a9faf2b9c09fbdd87471927ae",
      "text": "Wedang ing ceret dipanasi ing anglo nganggo areng.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "26a821690c13f89a76a2fcc4330532fe519cbcf0a92e257bc5f6267a1fbd7b3a",
      "text": "Lurung ing Kutha Gedhe ciut-ciut.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "271bf82801974f4855180245ec27373dfdec421ebaa2dd44a5056233975db7cd",
      "text": "Mlampah lurung menika, lajeng menggok tengen wonten prapatan.",
      "voice": "jv_dimas",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "295bafa9b835fda40f8b2418c5a8becd3169bc4bf417a6b64db0300403c68bf6",
      "text": "lesehan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d05df229c7818c57c1726d5ed87ab0ec8c679ef3ad3b0ed4c612e3189d3fef",
      "text": "keret",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c7331446313636416aea17bdc1136795fb943401193d3c230e0a5bb6e9a283a",
      "text": "pengkal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dba05e28d0d3eda0d220f7622958339ca5b8c37490b96aa12f5d45871b736e7",
      "text": "wadon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "30128282e3b9a5c33c62a1b619357a91a8df13c236c855cefc5f05909fa2fa1c",
      "text": "pentas",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "32c936c340bcc3b2913f0dbbf8896061c07f81c4c69f0001a8a581f91000e866",
      "text": "ceret",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "342d0b192dadb32fe50d3d6c6ec377ce0c738f0201c498645b0000f130df9ed4",
      "text": "Wis, Mas. Sesuk Minggu kerja bakti, jam pitu.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "34b30cc8b71fc57e28b62426ce801a8d766e40bcbfc88c0b6076b8a708b05378",
      "text": "Wah, nganggo aksara Jawa! Isa maca kabeh?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b37bf35df98c6713e1c79268971834949051f3d375ce09a94441cf5b50b30ec",
      "text": "Bener! Ayo ta, tak duduhi bengkelku.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6237b9d7a99a246c6f60cf7f522c65c866d459189e9c9402b3a176063e1c1c",
      "text": "Halo! Iki anak lanangku lan anak wadonku.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cab501229af652f705da55d74b77c9c682bb57e796e0f3ca65fc9eb1ad39c8b",
      "text": "Menika tilas benteng kraton lawas.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f12e3a43681d6806b71493542b6804bdcf0b397911f55eeef83c172dd9ac535",
      "text": "Jenengku Mohamed. Aku saka Mesir.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fbf2fbe2e81efd22d9fe5f8b88c1c39a7533ae7e29df6e42915316b5918a230",
      "text": "ꦩ꧀ꦭꦏꦸ (mlaku)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "417a5e4a07ab33507c7078a8e78d5d42b94f4f658aa5faa7eeb6015c9506258a",
      "text": "Iya. Wong kene urip rukun lho, kaya kulawarga.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "428cf16548c3f49f484db7db394a5eb4d5f26d85789fe363b25a6233a40c6e66",
      "text": "Lurungipun ciut sanget, nggih.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "45a85bb2b465a3d9a838ebb09fb6e31b6cee9dcb2f2637bfa14bc7f5f3b2c0a7",
      "text": "pacul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "46d430b988d662b5f322c83f62f9e737c3a22db0d74d2b7f3348def678fb4c4f",
      "text": "Omah-omahe cedhak banget.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "476c8de5ccc4ae90569a0671144ac2d10199d3714386551f591007d1d8149770",
      "text": "ꦠꦶꦤ꧀ꦢꦏ꧀ (tindak)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "484da3dead3084bcdbba491702c3f5468eceac51e788749709b3827b687f0540",
      "text": "ꦮꦼꦢꦁꦗꦲꦺ · ꦏꦺꦴꦥꦶꦗꦺꦴꦱ꧀ (wedang jahe · kopi jos)",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b2923b962db3a0b06fa57675d979f95af16c5f89685d7359afa528fdebffbc0",
      "text": "ꦲꦺꦴꦩꦃꦏꦸꦲꦶꦁꦗꦒꦭꦤ꧀꧉ (Omahku ing Jagalan.)",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bed06662b060bc67269196294d026ce72cbb609d55c9cea4110454d2c6b8f75",
      "text": "Sate usus rong ewu.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c9039b6344f0828ce91a9243514822618e66d1da640bbf07e73f9888cefd8e9",
      "text": "Melu! Aku gawa sapu wae.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d485f2fb1ffb1b88c4e64ba6b632631b9d5187c7c0378a53274ec472e9eea55",
      "text": "Taman Sari ngiwa.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e1f931a28463d37beaf9c707b79128efbc9138cc13f761779d8386b269ec5f9",
      "text": "lampu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ef330b791863c9118b188ff9986e2f143fdc79f70d5ef468fc53238871a3467",
      "text": "ꦏꦸꦭꦱꦩ꧀ꦥꦸꦤ꧀ꦱꦒꦼꦢ꧀ꦩꦲꦺꦴꦱ꧀ꦭꦤ꧀ꦚꦼꦫꦠ꧀꧉ (Kula sampun saged maos lan nyerat.)",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "50673dc905bb0e32d5ebba67cf38043959881632b12c5d6948e68a1606ee2609",
      "text": "ꦒꦮꦱꦥꦸꦭꦤ꧀ꦥꦕꦸꦭ꧀꧉ (Gawa sapu lan pacul.)",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "5141469105446a1bbd90c3a9165a5874f9073e676550976e825f201d174dc34a",
      "text": "ꦭꦩ꧀ꦥꦸ (lampu)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5177a47f23ad7180d06af6c7376601ba617653c0863fbd67c6413b9a7375539d",
      "text": "Kowe wis mangan? Sampeyan sampun nedha? Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "576096cacf4a81188fdb6a598e91c2136efa4e3cc7083083f74b9993502b363e",
      "text": "ꦲꦤꦏ꧀ꦮꦢꦺꦴꦤ꧀ (anak wadon)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "578fea3305020df21b3930f2cd014db3174fc7ea24fc56a89935c3f2728013d6",
      "text": "Mangga, Mas. Badhe ngunjuk menapa?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "582efec0c137f7f07267ddb3a476a172c773fa35dc3ecb3a90cd4c2efb98bed9",
      "text": "Mangga, Pak. Kok murah sanget!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "58f9c60794c5b133fcd8911893f8219f26a3fdc633408e56b14b89699fefb3d7",
      "text": "Bapak-bapak ronda ing gardu nganti esuk.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "59147dde5e95794cb44edb639d5313ac7224f27868ba633ac7eee4aeaf51b163",
      "text": "Bengi iki ana sarasehan babagan aksara Jawa.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dd33fc4f5af010efadf00e4b7fb92ca702ceca6b28c1e230777af8836a94e87",
      "text": "ꦱꦼꦒꦏꦸꦕꦶꦁꦠꦼꦭꦸꦁꦲꦺꦮꦸ꧉ (Sega kucing telung ewu.)",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f7a0cf77655cf9b7c503598080ee3a6c7e184c5d60b22e993019e0cd4aa1769",
      "text": "ꦲꦏꦸꦢꦸꦮꦺꦲꦤꦏ꧀ꦭꦺꦴꦫꦺꦴ꧈ꦭꦤꦁꦭꦤ꧀ꦮꦢꦺꦴꦤ꧀꧉ (Aku duwe anak loro, lanang lan wadon.)",
      "voice": "jv_siti",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "624c8001ace489f1cf42a0581c636a8ad7a646fd0a29f47739ec257117c7616b",
      "text": "ꦲꦶꦁꦒꦁꦫꦸꦏꦸꦤꦤ꧀꧈ꦗꦩ꧀ꦥꦶꦠꦸ꧉ (Ing gang Rukunan, jam pitu.)",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "64b16884b89d849b72c99bcc69476cfdc414e429743534b9fad6f49f0b0e1172",
      "text": "cakra",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "656dfafa51f8e6d0084f7ba185032d63d32b36bec8ebb53ac3b0dea6b1a6c619",
      "text": "Mas, krama ditulis nganggo cakra, ya?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a5c4f4372eaafeb803fab651daa78bcfae719e9da826bbff6d1f80a27bbeea2",
      "text": "Kula badhe dhateng!",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b1de17216a7c48da8dc74a1f16ff1f283de45b183c83db2d845d7d22944b330",
      "text": "Med, wis maca pengumuman ing papan?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c194c750d49334ae385265bcb2f5bb93158dec0787af82bb614dc23a41de79c",
      "text": "← ꦠꦩꦤ꧀ꦱꦫꦶ (Taman Sari)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c3308a405917981f105c8091898b91d153da5d75357091a4ac9f4fcca5cc2e9",
      "text": "Hah? Areng ing kopi? Aku kudu nyoba!",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cef4edbfdd4a0aae762506a014f2a34278cbc329d3ca66515a9940ac4f35878",
      "text": "lanang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d136e1bf6c1e096a8e021564a7b7265188470e30b2d13cdd3c15a6c50fa5a09",
      "text": "tukang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d745abd2c9742a69ba9261c2d9839608405867e9d17fc448b337562b2503c59",
      "text": "rukun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e0a23cc13c885077c2b37813f01b1925ba86d5c8d95c460a420315ac9e8764c",
      "text": "Menapa saged dipunwaos, Pak?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e1fb411ffe25a18436496c8bb27e1e09409b1fa4fc6f1577b22f966a1f153f1",
      "text": "Pagelaran wayang iki ing alun-alun.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e66c135abd0df44ec0d4da582f4efc2a6c9540105d54e539f4d3120c814104a",
      "text": "Sawise ronda, aku nongkrong lesehan karo kanca.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f54f375ecea1ea99bf329150da8639705c8d5b20532046835d0d7af7e4c31ee",
      "text": "ꦱꦩ꧀ꦥꦺꦪꦤ꧀ꦱꦩ꧀ꦥꦸꦤ꧀ꦤꦼꦝ (Sampeyan sampun nedha?)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "74049121954225ae4834814cf7505ae479ec8d013b3f7de281142c68daab1d42",
      "text": "Mas Mohamed, kula sampun nampi serat panjenengan.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "75c9022a5cbfd66730fdc5c697d842901ff6263e69d6de397d63c12b317abb8c",
      "text": "ꦱꦼꦱꦸꦏ꧀ꦩꦶꦁꦒꦸꦲꦤꦏꦼꦂꦗꦧꦏ꧀ꦠꦶ꧉ (Sesuk Minggu ana kerja bakti.)",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "78a2eea2ca7ff4830599006524e40788dbfd84151a3f6afcd2a7233a85de47ba",
      "text": "gang",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "79bcdb80a0e256bd7b0e25dd1854553dc2a2a69fc1ccfb57be7116a424ad8406",
      "text": "ꦱꦼꦒꦏꦸꦕꦶꦁ · ꦱꦠꦺꦲꦸꦱꦸꦱ꧀ (sega kucing · sate usus)",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c49efef8e968cd2e9b76f764aa119e168de1df52ffdaf47cc420f8ab2f5922b",
      "text": "Aku maca geguritan ing pentas.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d17e1f9a649ab7df8d2dee948b94f26d2e203d5c4e6a1da9ce38c8ef4f5cf5b",
      "text": "papan tulis",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d8ce6ec23d18216eb4643f95d540c31f657b22c8ebc9c5e6659e5338f09b527",
      "text": "ꦱꦸꦒꦼꦁꦲꦺꦚ꧀ꦗꦶꦁ꧈ꦥꦏ꧀꧉ (Sugeng enjing, Pak.)",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d9d23ed29f65cb29d00374dc18a5fe3c0f65c82fd11e9a66be58bdd991f24a1",
      "text": "geguritan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e8295c6b31e3317bcbac7c78d0f7b632893af85c54f9ffcfe3a85665c499a17",
      "text": "ꦏꦿꦩ (krama)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "83d490d80a6181a9a66f61154f06f1c16fdd32a852c0c6103a2ea37c5b596473",
      "text": "ꦠꦤ꧀ꦥ (tanpa)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8436fe80d35f68536ef12c755712c9a6200f9bddb1aeaeff694bdd09ef0a0bb8",
      "text": "ꦒꦁ (gang)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "85029e90444f594706753b9479b366a0305cb63fa04944f5c6eb32f99c79d947",
      "text": "Isa! Sampeyan sampun nedha, Mas Mohamed?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "87e75f392094dc93eab2c0c0342c9207edf5a85755549d1ba462061d18c188a5",
      "text": "ronda",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "886cf9cddc0257a9f2abb6b70e56ed7de03e16ab502425edebd6503286b54536",
      "text": "Iya. Matur nuwun, Pak. Wis tak tulis, lho!",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "887d40d0c453f1a7b7bc70441c72e64932eb6d89f42f0876257f544cb1546a00",
      "text": "ꦮꦺꦴꦁꦫꦸꦏꦸꦤ꧀ (wong rukun)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8881d7ba42fd9dd11ac2b2e20877589120b50bdf7e24157f51506541baa94587",
      "text": "sarasehan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "89197faf920edc057d979546732873abc76a77b819a81f6ab72401f7a7306df6",
      "text": "anglo",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab46606a1f133b24fa3c7904a6fd6848515c58860ab0cba7550339183b29571",
      "text": "Aku mlipir lurung tekan sendhang.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8df724ba157b831468a8b797f07867b7b17096c19e72191597d1c7354aca9306",
      "text": "Iya. Kaya Kraton lan Prambanan.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e19ff502239a19e64167e1ae6be2fc2f8f87fd13bd482aca366515cb99f7e05",
      "text": "Lan mlaku?",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eab86ed6c9404233b30061512ff9af3cbcb492e5864267e034eb3a885ed4762",
      "text": "Med, sesuk arep menyang ngendi?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "925f39885fa3475a8b9e93150dacaed4b97f9bd4648c0c77ca66a3e19a273c45",
      "text": "Bengi-bengi wong-wong nongkrong lesehan ing angkringan.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "936439b748a3e2126248ecd29ff17cc07bd647cb452e844bc1b2ebde7ae4c9ce",
      "text": "Mlaku nganggo pasangan la. Ayo mlaku-mlaku wae!",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "93922d510355fbd488ebdd27c1a38632e4a3eb735662b3e0df861c5f5e740164",
      "text": "Wedang jahe limang ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ab95ece344398a80ba2cb0d41adb73d9aeeaa3968663cc208a11542e7b362c",
      "text": "Kowe wis mangan? Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d897a5685e53e41c69058a29e976220cd644f0669723fb393d530bdb0d1d2d",
      "text": "Isa maca?",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "96020772118a4559912ff191207bee664756f19a530b641fc8ed9aebdd006693",
      "text": "Menggok kiwa ing pertelon, banjur mlaku ing lurung ciut.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9720ca791e8aaa70289c206881da823be90e018c137ab8b00669bd2600a92e3b",
      "text": "Aku duwe anak loro, lanang lan wadon.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "975082547731af9864e9b78daabfbd00d939017d72d66055f2a4adebc87c2574",
      "text": "Med, iki kancaku, Mas Bimo.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "985bc68409cdc97cb13c55b0e8f4d00d72233dbdbea54066e644be373ff9faee",
      "text": "anak lanang",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "99470aef502a0d68b11583f21b5beb8fd58335760fb29ef7cf70c519dc9bb2e4",
      "text": "Sedaya sewelas ewu, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9add9a664216e50b70572d5e843db12b4c963efc1fec180d1c5cb299e9eeb787",
      "text": "perak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d0df6a1b4d1bfaf818e971e511eef2c004af265dcaa03e0ff78ab75f77d506a",
      "text": "tanpa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9db2da9eca19490a6a1cb92a43dc309ce0160e4d71549aa963fa2e0ebc5debf4",
      "text": "Wedang jahe setunggal, Pak. Lan sega kucing kalih.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a565f02af2180800b061298220ca8438fe0abaac8c9a605c5e089d59f04d74fc",
      "text": "Saged sanget! Pasanganipun leres sedaya.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6a4552f86033026e0623453434c5442ffdf8caf4382824bb309866918251131",
      "text": "areng",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a83883cae0ec3bbcc570e7e444dceb104fd31e4eff44e5c2fdf7c627274cde9b",
      "text": "Inggih. Menawi wonten motor, minggir sekedhik.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a96758125eb16f52ba94eff6f795e0b1dd26cffb4c844c56d14fb6fb3a275408",
      "text": "Mas Bimo, aku wis maca profilmu.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab659826e7f0be9a4edbc9239764dff2c625bfcc41d4234a4a8dcd42e934c1be",
      "text": "Ayo nongkrong ing angkringan, Mohamed.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae15ac5a35c32ceb7601ce86950c525714f8567a4acf3a0929a0adfd97958cb4",
      "text": "Yen ana motor, minggir lan mlipir tembok.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae42af46826e5947db49fdd791ee7932887dcb9258de34985bed6514b0dc1cdc",
      "text": "pojok",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26ee28f77a877410d2eb2fa2283ecc83242a6d2bcda4b40f35523e1cd6f7a0a",
      "text": "Bocah-bocah enom seneng ___ ing angkringan nganti bengi.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7744bac22d2b9968a91f382a5b38f2b12f6e10c1014384b50046ff4f11a7f8e",
      "text": "Nyuwun sewu, kula badhe nglangkungi.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8b1974cd4ff3a80335691daf4cb3323794048844555e3130a82d901a1f02834",
      "text": "Aku melu sedhela, banjur lesehan maneh!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9d3130c6b98c7c97d1e78c664c462e6866a4b9ef5a7f624c76572f66c4bfc7c",
      "text": "Med, ana layang kanggo kowe saka Pak Slamet!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba14b92019f8e16eecc5e1f23a53de97856d16bd55792f1e6a3dac08bbfd272c",
      "text": "tindak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab5b44757b5b1e9da17ee452e31d858b23b9f625cfb3d9f7a8e52f704bfe65b",
      "text": "nglangkungi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb2ab650610d995b3df2eaaa742b96e4ff2fe8eb6b41ca6e55b98cca2b0b6f38",
      "text": "Med, kowe nulis apa?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd337d92b7464a8ba7e9c672b50f7b80a97cc4fd4e25fef367e0d2d610b0e0b0",
      "text": "Bener. Nanging adoh, numpak bis wae.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdd4ac619a52a4f9ce2383355ba13a6c794e1552a608307d0565df51409f9a5b",
      "text": "'Sliramu' iku tembung kanggo 'kowe' ing geguritan.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "be32890c0b171c5df4a9e55d0742a6d22d1008e438870e257bfd7610624fbf5e",
      "text": "Oke. Matur nuwun, Mas!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1622598f8bcdf0e16a5e5ac14b8cdb8d1ffcb60456e6807020e9521124d3b1a",
      "text": "Wah, kok lucu-lucu banget!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1f28056e4ab86918c645a604557f66492bb16ccf2256fe3b40889cdbbf54553",
      "text": "Ha ha, Pak Slamet pancen seneng takon kuwi.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4b501940cd65e6ca785c78a96a046636ffd75afddc0a520929161bd93b4b617",
      "text": "gardu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4cc92594249105d0f447ed47c22fde154142c8fe8d50ec1c1f18f26f97c22cb",
      "text": "Ing geguritan, tembung '___' tegese 'kowe'.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c705454eca3a3be1d4e1abbfc5066333fbbfd402589d62fd1240d2b4d95e1b70",
      "text": "Nyuwun sewu, Pak. Sendhang Seliran wonten pundi?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb0915c7a9498ae97d48f96bd0d1a6c83ffaaa02790752f2910f9aac0fbae354",
      "text": "Prambanan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb0a88bb4d9df6c3f595d15e3be8b682b15ea821b98f539eb9272fbfb74135da",
      "text": "Sega kucing loro lan wedang jahe siji, Pak.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "cea5928e73886d5e2d39aade627225a87623850fa5d550a1b69112c44f3c5285",
      "text": "Halo, Mas. Aku Mohamed saka Mesir.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d02ebeb6b8749f922844b9e6bb748e113295555c68e4da813442a77fa4083d23",
      "text": "tilas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d443cc87fcc491e77c40a0e8c694c08a245c2ced92ba153d9fb3eae0b0f9348d",
      "text": "Murid-murid maca geguritan ing pagelaran sekolah.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d45cc17c4711fbae415dd02acc838276812c2b1858cf51064084b2b11ab4c142",
      "text": "Menyang Prambanan. Papane muni nengen.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d837eb777fb4abad548d001116ed499fa4c07472d7aec1e34d8a4c8e6227647e",
      "text": "sliramu",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d940b3c89e190f21e4e37101438ccb6a82a83eaf2e9dd9839f8ac987b694ee8d",
      "text": "Mas, gang iki jenenge apa?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "db0bd527b9ef6e9147c6952947d0a8665cb3c938a7b60cc7e7e3e2615505734b",
      "text": "ꦥꦿꦩ꧀ꦧꦤꦤ꧀ → (Prambanan)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc10cfc0e26bf1027e1e4d4fd6f2efad3a51e5265b23427ca3cf9d14ad5c761f",
      "text": "Iya, nganggo areng. Kopine dicemplungi areng, jenenge kopi joss.",
      "voice": "jv_dimas",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcafd23f773d17c7d55ee3db4605089844fa277687bb673de6b1779441343c0b",
      "text": "Sabanjure aku melu ronda ing gardu karo bapak-bapak.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcdc2fbf9ad196d21c013d8f48c9a379c592303a26c51f0bd88a566ca7f77205",
      "text": "Kula sampun saged maos lan nyerat.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "dedea3c49d8fd0a17d09756054dc7bd500df1cd839236714245522c4e77fa6a8",
      "text": "Rukunan. Saka tembung rukun.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e08a5ad8f678548a2fe647eb591c2c0322adb3ff5ed50a6adac3c7a3d5a09b2b",
      "text": "ꦥꦿꦩ꧀ꦧꦤꦤ꧀ (Prambanan)",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0c1868aa6a3f3be9a964cfaea24b5a0d0f3a06d476615c996cbe1de2d50ff62",
      "text": "Sesuk Minggu aku melu kerja bakti.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27c1c84cb553ebbbf789186050cc9b669962b888bc810090341187d82a1c07d",
      "text": "ꦏꦺꦴꦮꦺꦮꦶꦱ꧀ꦩꦔꦤ꧀ (Kowe wis mangan?)",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3e4cba0df2113f3818459f6f950bab3e41bff7d33f8510a5a2039a16cc9603f",
      "text": "minggir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e60026802aa064c68bf024ee1a07803eb39cd489d8090e4567c3458a94c3dfe2",
      "text": "Iki ___ tembok kraton lawas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e76c3d3652c1d596b07aed59b95b943d2496808e1132f394e123f05b0408be5a",
      "text": "Wah! Aja lali nganggo krama, ya.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8fb4f7cd203d59828e5d264ef5787509a23406736f60228f02a4f0a0ba78fe7",
      "text": "Kowe melu? Aku duwe pacul loro.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecec0edeef33ca6c5336c78a17536a1d28efaf359aff5a378466171a4e234167",
      "text": "pasangan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecfc8f061490c0ebe2ebef30ff7d3647de92baf6fadcbbce06e49eb93b90c460",
      "text": "Lare-lare badhe pentas menapa?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f11263a5ffcfb976ef1fbf7a089160e8817366215c0f3948b7147fa935e3a7b1",
      "text": "Mas, anak kula mulang aksara Jawa wonten SD.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f27bd92a7b9f062d429af35e92db6b96f302665ae767b4a732e9c57f6aa639f5",
      "text": "pertelon",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4e51b74189f0ec7911edd7bcd78c9923405090373eb10b6ffaf4f399daa11c0",
      "text": "Maos geguritan. Wonten tembung 'sliramu' ingkang endah sanget.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "f70461a6b1d50457491b9b5bc52fd35edc5017cd71b07ce55e2cc299dd1ca572",
      "text": "Kancaku duwe anak lanang lan anak wadon.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7fe9c47ed23ed56ca1caf2160a3a5c044267d58002bde2dd5b8f5ed1840286e",
      "text": "lurung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa2bcb2121c1773fde16e8c7690cc543d705e107eed858619f3fa7ad685e8ef6",
      "text": "Sae sanget! Menapa taksih mawi kapur lan papan tulis?",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc149d56fc05a4d2d0ad0d4513aab1ac870f83c1f79a59ca1868c55cfec88e6d",
      "text": "Menggok tengen ing prapatan, sendhange ana ing pojok.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fca8a599c4caefaf9cec99059dae8cb5c8382a9bbb90cf4bfeddafafa925e1c6",
      "text": "Kraton ngiwa, Prambanan nengen.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd9e07021ff8c8e755c3f27b1933f491472174546371418426befb0cc06c935c",
      "text": "Sega kucing telung ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    }
  ],
