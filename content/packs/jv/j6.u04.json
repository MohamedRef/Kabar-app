  ],
  "audio": [
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "07789d88751788f6d8e70e8e18b0eaf8572f68fa7d8dc68687d3f59781f81018",
      "text": "ꦏꦚ꧀ꦕ (kanca)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "13a8ed968859e959acfbdf385bc06710e7b5c333c099b8df397cbd7463477fa2",
      "text": "Med, iki kancaku, Mas Bayu.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c0b0d4b92cad3b7bc5d9a3fd16618b8a809605b2a2153ae34f321c4e681377d",
      "text": "Tulisane aksara Jawa kabeh.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "213ed16797a6e2099f13c46d22123e4992249b52d57ce148f704e0ac96bc60f7",
      "text": "Layang kanggo Pak Slamet, nganggo aksara Jawa.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2390a52f91f9e2562abbe2a062797e6de5e3e95bda3dc2096a03bf3f3b5db37f",
      "text": "ꦲꦤꦏ꧀ꦭꦤꦁ (anak lanang)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d05df229c7818c57c1726d5ed87ab0ec8c679ef3ad3b0ed4c612e3189d3fef",
      "text": "keret",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c7331446313636416aea17bdc1136795fb943401193d3c230e0a5bb6e9a283a",
      "text": "pengkal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dba05e28d0d3eda0d220f7622958339ca5b8c37490b96aa12f5d45871b736e7",
      "text": "wadon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6237b9d7a99a246c6f60cf7f522c65c866d459189e9c9402b3a176063e1c1c",
      "text": "Halo! Iki anak lanangku lan anak wadonku.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fbf2fbe2e81efd22d9fe5f8b88c1c39a7533ae7e29df6e42915316b5918a230",
      "text": "ꦩ꧀ꦭꦏꦸ (mlaku)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "46d430b988d662b5f322c83f62f9e737c3a22db0d74d2b7f3348def678fb4c4f",
      "text": "Omah-omahe cedhak banget.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "476c8de5ccc4ae90569a0671144ac2d10199d3714386551f591007d1d8149770",
      "text": "ꦠꦶꦤ꧀ꦢꦏ꧀ (tindak)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e1f931a28463d37beaf9c707b79128efbc9138cc13f761779d8386b269ec5f9",
      "text": "lampu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5141469105446a1bbd90c3a9165a5874f9073e676550976e825f201d174dc34a",
      "text": "ꦭꦩ꧀ꦥꦸ (lampu)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5177a47f23ad7180d06af6c7376601ba617653c0863fbd67c6413b9a7375539d",
      "text": "Kowe wis mangan? Sampeyan sampun nedha? Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "576096cacf4a81188fdb6a598e91c2136efa4e3cc7083083f74b9993502b363e",
      "text": "ꦲꦤꦏ꧀ꦮꦢꦺꦴꦤ꧀ (anak wadon)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a293137533de0d9bd0fe2c6bd9343174d579837df189a84e5952c33aa8b908",
      "text": "Mlaku nganggo pasangan la. Ayo mlaku-mlaku!",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "64b16884b89d849b72c99bcc69476cfdc414e429743534b9fad6f49f0b0e1172",
      "text": "cakra",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "656dfafa51f8e6d0084f7ba185032d63d32b36bec8ebb53ac3b0dea6b1a6c619",
      "text": "Mas, krama ditulis nganggo cakra, ya?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cef4edbfdd4a0aae762506a014f2a34278cbc329d3ca66515a9940ac4f35878",
      "text": "lanang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d745abd2c9742a69ba9261c2d9839608405867e9d17fc448b337562b2503c59",
      "text": "rukun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f54f375ecea1ea99bf329150da8639705c8d5b20532046835d0d7af7e4c31ee",
      "text": "ꦱꦩ꧀ꦥꦺꦪꦤ꧀ꦱꦩ꧀ꦥꦸꦤ꧀ꦤꦼꦝ (Sampeyan sampun nedha?)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "78a2eea2ca7ff4830599006524e40788dbfd84151a3f6afcd2a7233a85de47ba",
      "text": "gang",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e8295c6b31e3317bcbac7c78d0f7b632893af85c54f9ffcfe3a85665c499a17",
      "text": "ꦏꦿꦩ (krama)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "83d490d80a6181a9a66f61154f06f1c16fdd32a852c0c6103a2ea37c5b596473",
      "text": "ꦠꦤ꧀ꦥ (tanpa)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8436fe80d35f68536ef12c755712c9a6200f9bddb1aeaeff694bdd09ef0a0bb8",
      "text": "ꦒꦁ (gang)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "85029e90444f594706753b9479b366a0305cb63fa04944f5c6eb32f99c79d947",
      "text": "Isa! Sampeyan sampun nedha, Mas Mohamed?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "887d40d0c453f1a7b7bc70441c72e64932eb6d89f42f0876257f544cb1546a00",
      "text": "ꦮꦺꦴꦁꦫꦸꦏꦸꦤ꧀ (wong rukun)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8df724ba157b831468a8b797f07867b7b17096c19e72191597d1c7354aca9306",
      "text": "Iya. Kaya Kraton lan Prambanan.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e19ff502239a19e64167e1ae6be2fc2f8f87fd13bd482aca366515cb99f7e05",
      "text": "Lan mlaku?",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ab95ece344398a80ba2cb0d41adb73d9aeeaa3968663cc208a11542e7b362c",
      "text": "Kowe wis mangan? Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d897a5685e53e41c69058a29e976220cd644f0669723fb393d530bdb0d1d2d",
      "text": "Isa maca?",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "985bc68409cdc97cb13c55b0e8f4d00d72233dbdbea54066e644be373ff9faee",
      "text": "anak lanang",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d0df6a1b4d1bfaf818e971e511eef2c004af265dcaa03e0ff78ab75f77d506a",
      "text": "tanpa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6f62ae4acfc364b971d485aa6fd2f4106707471f1bae8e8cd7f8c9e8254235c",
      "text": "Wah, lucu-lucu banget!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae866ba3bfe4dc70caadd98378dfe00a615792f2171a5191728fb4f21ab3a59e",
      "text": "Iya. Matur nuwun, Pak. Wis tak tulis!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9d3130c6b98c7c97d1e78c664c462e6866a4b9ef5a7f624c76572f66c4bfc7c",
      "text": "Med, ana layang kanggo kowe saka Pak Slamet!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba14b92019f8e16eecc5e1f23a53de97856d16bd55792f1e6a3dac08bbfd272c",
      "text": "tindak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb2ab650610d995b3df2eaaa742b96e4ff2fe8eb6b41ca6e55b98cca2b0b6f38",
      "text": "Med, kowe nulis apa?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1f28056e4ab86918c645a604557f66492bb16ccf2256fe3b40889cdbbf54553",
      "text": "Ha ha, Pak Slamet pancen seneng takon kuwi.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb0915c7a9498ae97d48f96bd0d1a6c83ffaaa02790752f2910f9aac0fbae354",
      "text": "Prambanan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cea5928e73886d5e2d39aade627225a87623850fa5d550a1b69112c44f3c5285",
      "text": "Halo, Mas. Aku Mohamed saka Mesir.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d940b3c89e190f21e4e37101438ccb6a82a83eaf2e9dd9839f8ac987b694ee8d",
      "text": "Mas, gang iki jenenge apa?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "db90f755cff1aac4cb743b50fc150fe4845e21413933dfeafbb03965e19c1e3e",
      "text": "Iya. Wong kene urip rukun, kaya kulawarga.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "dedea3c49d8fd0a17d09756054dc7bd500df1cd839236714245522c4e77fa6a8",
      "text": "Rukunan. Saka tembung rukun.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e08a5ad8f678548a2fe647eb591c2c0322adb3ff5ed50a6adac3c7a3d5a09b2b",
      "text": "ꦥꦿꦩ꧀ꦧꦤꦤ꧀ (Prambanan)",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27c1c84cb553ebbbf789186050cc9b669962b888bc810090341187d82a1c07d",
      "text": "ꦏꦺꦴꦮꦺꦮꦶꦱ꧀ꦩꦔꦤ꧀ (Kowe wis mangan?)",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e76c3d3652c1d596b07aed59b95b943d2496808e1132f394e123f05b0408be5a",
      "text": "Wah! Aja lali nganggo krama, ya.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecec0edeef33ca6c5336c78a17536a1d28efaf359aff5a378466171a4e234167",
      "text": "pasangan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f70461a6b1d50457491b9b5bc52fd35edc5017cd71b07ce55e2cc299dd1ca572",
      "text": "Kancaku duwe anak lanang lan anak wadon.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
