      "id": "j3.u04.l07",
      "sha256": "f4ddcc29293c73ded0d32fa053e867df9971b201c886959ae61b0150d7c94ad5"
    },
    {
      "id": "j3.u04.l08",
      "sha256": "01234dfd9c4b3c0ccd47d4182aade048f359e709ae78bc88566b2137631301a4"
    },
    {
      "id": "j3.u04.l09",
      "sha256": "c9298804c3e88968ed6449cfb95b0c524dc71c74e45d08acb72bc09505d5c261"
    },
    {
      "id": "j3.u04.l10",
      "sha256": "27a0133af177b18d231eca90f035b29c82a2767c083b1c9351409ce47369a112"
    }
  ],
  "audio": [
    {
      "key": "01545ac0f34eafe10f99c9c224ce78f487188f10a310dbc187a762e8bc156a7c",
      "text": "kemawon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0167eb07c7057a52b8de2d761dfc2990e0954ed8f8299a89948ea7068580d810",
      "text": "Masjidipun ing pinggir margi.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "01ccc6150bed840460f065e8c04796ee4c156b0504805b89d97f7c5e85c7de98",
      "text": "Kula mandhap ing bandara, Pak.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0224b9a6d77e2fd49d60ed553a447b3a49a16324491cca43c119898d3411b6d6",
      "text": "Kula remen sanget basa Jawi lan pendhapa menika.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "044e5b261dcc42f2b122974a726a3f629e76c55ad8cf11ea0d2380a594132400",
      "text": "Mboten menapa-menapa. Marginipun taksih lancar.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0598d01b31612af8493dcfe41db9b903071530541cf114c3f56ff1375bfcc4e8",
      "text": "Pak Wiryo: Jam sanga, Mas. Sampeyan saking pundi?",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0667fbf8f5521964500df4573e33f191b1d33f43ea6d7f143771d403f285391c",
      "text": "tebih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "06dfcf07b8098b9f0d8ab36ed082a3903591f24d88e9c12ae6e4d0d400a47ee2",
      "text": "Menika menapa? — Menika pendhapa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "091749d01239b19bf8b746306eba8a3d1a802b3478027a73d03a1f1ffee2ee74",
      "text": "Kula badhe dhateng Pasar Klewer, Pak.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b57d96a512d4fe5ba88b046a57790e23bc3dc143cea2bf8468622270508829a",
      "text": "Sugeng enjing, Mas Mohamed. Tebih?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e58608822b1fcd7174f0ea439b33e352bfe6d4dc9786a8e74ef53e92b87358f",
      "text": "Dhateng bandara, Pak. Kula kesusu sanget.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0efa5cfc0f4d4f81b523914b5c23e1c9d833739623d298ea4d9126e3f6b5873d",
      "text": "Saking mriki lurus kemawon, lajeng nengen, Mas.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1118efd3011bb2b4ba026cd6a959cecfd76d3c5e0563848a183b33e91bf2de7a",
      "text": "Batik Klewer sae sanget, Mas!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "11367223c560ef7c1b347b92093f67655b28df6352a9d7f09f55fed2899b7f97",
      "text": "Nyuwun sewu, Pak, Pura Mangkunegaran ing pundi?",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1286b26d4c39ebea1f56724e0469cd6285aff1ad239920464f54de4eca44c04a",
      "text": "Nyuwun sewu, Mbah. Saking mriki saged mlampah dhateng Pasar Triwindu?",
      "voice": "jv_siti",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "16bf2fd9b52014d0f9f05051bd29c73dd5b45c0538241488e27f901bafe31608",
      "text": "Mboten, celak kemawon. Nanging mboten kepareng nedha ing pendhapa, nggih.",
      "voice": "jv_dimas",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c543046da932b6fbf977cde4b8c9c4c7c13366839a3abc58ae313b36e2a9e3",
      "text": "Pak Wiryo, panjenengan saking Klaten?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "186dce75b1d72813a2f42c64243eba0c656938039bfa836364bd020af9ffa6c1",
      "text": "sinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "18f57ba0edb66411269cce34858215ae84004ffcccf2b2ffa460d7cc857408b4",
      "text": "Sugeng enjing, Mas Mohamed. Pripun kabaripun?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ad557cd6128fcb4d8483ed079e7df5cc4528275b333af4002907f08a4429caa",
      "text": "dawa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1efe23e2429fc9a9aab327cbc15e3a20829dabafd141e7840b082090fe77cbe0",
      "text": "Inggih, Pak. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fa33ca878da09c239dd9687f3e1c92b85bee9a56897cf7400a16c65f98acd47",
      "text": "remen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fccdcecd31cfc5b2d9df4336b9786d10d5498e63c2ac98baad3aaca176bf354",
      "text": "mlampah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd1dfae7c9eb2f90eb1922097a4dd21f75b63567e7a0b5eaf2200d2af21e9d0",
      "text": "ngrika",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "207dfe9bcef3290972ba6ac6aae5afee5755f368ebe2205022d779aba6d1340f",
      "text": "Saking mriki lurus kemawon, lajeng nengen.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2657ac362abbbef0560fa3b3c915a6ba5ae87ac69d70c5ccf8618b5b9921f27c",
      "text": "pinggir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2af103c6c2f3ea9cb8d727161587e711d9b5f68faf60a928021b12911a522dcf",
      "text": "bandara",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b3bd14665e5b60d005000cc07d5671bbc0a5b8fe211f6c799d240e7417431a9",
      "text": "Mboten. Kitha ing ngrika, wonten menara masjid ingkang inggil.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d9bb4b3314611aa683e9605b508895e6ba0d75229d799ea3b5c57929c4ad172",
      "text": "mudhun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3018fb78a5c4462bef6c5815071e8164ebb3f37e4f2d400a54e170aee5b41ee7",
      "text": "Lare-lare dolanan ing pinggir lepen.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3038e37c27d2a8f27e56085d7f0a4a4247bb3abd6bacfad055c43aa7b52e5d8f",
      "text": "Pesawatipun mangkat jam pinten?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "31d9834b7e7d4a78aa78e1becdb39f7dcad25dc485e2847248e115fcea5380a7",
      "text": "Nyuwun sewu, Mas, mboten kepareng nedha ing pendhapa.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "32594aa919885cf5404bc39717f9e1e9aca221e533a781d614dc8a7ff3bf4b3e",
      "text": "kepareng",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "338a12cce919a0e8ad441c1240a410f065a906ea3a826bfcc6077696693f87f7",
      "text": "Inggih, Pak. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "365651f01c36ddd0fd647508fe2dc1ac677d6db893df0bdf96ad8772f5e0e81c",
      "text": "mriki",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "371bd2daf4fe64908c09d4a829d4944391929343309d911380103e170baed064",
      "text": "Matur nuwun sanget, Mbah.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b10d62b3f1f3592460c0807e78be3433608ceca91ccbdbfd4a8fb45c91d5611",
      "text": "mangkat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fb0010f9af8df8ee4e365fdda71db6b377f53fd39a5fdcc3d9da065b869812c",
      "text": "Masjidipun ing pinggir margi, ing ngrika.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "414dce4b1e686d5d332af0b9ca3dbdc0d0f6c664e84ec3154130c64ff621abdf",
      "text": "Sugeng enjing. Nami kula Wiryo. Kula saking Klaten.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "424122bc03bb5b503d55891a98f03eb30971da8c1a39fd7c9186e58819086127",
      "text": "kenging menapa",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "430102143024567d65ef25ede898edbe57c23306d58478d454574b71ce2d83a0",
      "text": "Nyuwun sewu, Pak. Pendhapa ing pundi?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c5b54602915629e10e1f499e8306b934865e08fbadba454545b908cd73cc287",
      "text": "Nyuwun sewu, Pak, kula badhe taken. Pura Mangkunegaran ing pundi?",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "4db99aeb5a739f4252d94327a4ebbdbeb34ae1653a9a394ea56c373a5bba1e59",
      "text": "Petani wonten sabin.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ecba1d084c993f97b6890e5d1d6f4e37938bc34ea1551a6b31252b66fd1dfed",
      "text": "Panjenengan badhe tindak pundi, Pak?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5230ac4b8398a35bb4738dca407ec83685a54f344cc8bcbdb63bd0613748745b",
      "text": "Margi menika dawa sanget.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5407d13e0ac57866361e09078a609910a24ed4b9a28026362253fa09e8dd05ec",
      "text": "lepen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f102e9f21047801a2817c4295adb8549dddfee000b708a56037f86a7a3612c8",
      "text": "Sugeng enjing, Pak Wiryo!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "60cbf238591a56b8415447f03575990bbe010192e2ead9be39a6325147de914c",
      "text": "Jarakipun saking mriki dhateng kitha pinten?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6256e329d528988064fd578e91f130051a87707e6b1e7164a739694a5a9baa85",
      "text": "Jam sedasa. Kula wau budhal rada telat.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "63fcb5e53f67da65974d57b7cd5c22d60096dd59957373d633e3711c1d6e5ca0",
      "text": "jawah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "64375e13c2bdde6e5e51b4078d962507f37b9fc775ef67df5df45697be19061b",
      "text": "sanget",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6520633821471af035df89de01d9155283c1ea5472c5407b2ddf0ca08d38cf6e",
      "text": "Kenging menapa panjenengan remen basa Jawi?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "662d859eef88ceaa956c5a5c9be3f0e421a3df9dd5c918bec1b35f2fdc328f23",
      "text": "saged",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f4d508174889ecf9bcb282eaa9175011037c738948f5614f6a71bbc7beb09d1",
      "text": "Jawah, mangga mlampah alon-alon.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7156b1b0c2d3b86883693518f2316ad7f5af15210b1346377fa1cda41dbfa690",
      "text": "Pak, jawah!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "71900d380c54cf773fd18e25f14a6b4ae1714211c727259127bfb564ed5618a1",
      "text": "Wedhus mangan ___ ing pinggir sawah.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "74658e194f9a3b70a2e05ab004903aefaccd996c779705c131bb43de343aad6f",
      "text": "Saking mriki pripun, Mbah?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "77bf6f3a225f8712ca919c8a3ae822c3e7cf61716d1bf8a994deb919b13ad796",
      "text": "Nyuwun sewu, mboten kepareng nedha ing pendhapa.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "784aa3cf32e0eebab6df39ba3454dd91139b805d82618c5ec4974c30e17dc20e",
      "text": "Munggah (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "78c379b215670475fe92ff5eb152881456d89f2849d408aa810186faf3dba44b",
      "text": "Inggih, leres. Ati-ati, Mas.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "78f44f3fb91301742e2191598ef41cf6a0c600c54f05128750e4b48cb43c4325",
      "text": "ngriku",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aa17b5d767e3b1316aae069bf627e053275d4d107cfd8aa6908e83eaeeedcf5",
      "text": "Mangga, taken kemawon.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e06e3cd08a97ed08eacc93b501068c46008220bf2bbcaaa70bd59f515201cdd",
      "text": "Udan (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "80950c401a3fbb3a8eaf2bf452104f289a73c9f6474b53ff891e3392e4695269",
      "text": "Pak Wiryo, kula badhe taken.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "83784f44f45d1508522c42f3733c4fb0a90b3e5611b286bd69955f1250e64841",
      "text": "Matur nuwun, Pak Wiryo.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "841b3ba4ca6771b837ebde940301443e3bb026c404c979fe29f1a89d67c60d86",
      "text": "pripun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8456e1f10b66f88a981509190ba2f0d95df72a31bd6d5e3b04653fa4d5e5f9f8",
      "text": "kitha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "86f22e093df6d23d6f38d95fd90cd25d2ffd60d4e8344a2939a9cbf10ef0c22f",
      "text": "Kono (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "889c74c9482c1fec0c65fb59c4870367fe14635d5c48289684e4f3843291a1bb",
      "text": "Nyuwun sewu, Pak.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ac9adaf8c2427f7f273bf37625051aa76780f69de8d43c166f8011710cdcbac",
      "text": "menapa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c06a86b99da168f0b1362035bcf74d53eb0e834fa3adc58a42dab4bb28158bb",
      "text": "Nyuwun sewu, Pak Wiryo. Pendhapa ing pundi?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eac4d7188af3ea8a2f3c6fb44d5915e808950951d71d004b7cc75153d7e085e",
      "text": "Alon-alon waton kelakon, Pak!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f915a831f69131699339b352096e8b645a93bf07f4cadde0097fed1208e088b",
      "text": "Mboten tebih, Mas. Saged mlampah kemawon.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "92dc2e789f263f2a4a39d742fade458855fb0c30ee7cc3c93b413d19c7cfebde",
      "text": "Mangga minggah, Mas.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "939f3f15628e059ac88201fb94375867d6d6299170f80d50103384803f1c944f",
      "text": "Kana (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9632113485e8fb03bf6e4bbe1cae44732f11438a1781b4dea8c61414760fb7c1",
      "text": "Masjid ing pinggir margi menika?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "973d231be4b6b4ed1d89da0ae38db15527218a99d62cb6ca491135a0bee94b73",
      "text": "Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "97b9d312b0a3f351a1eb24de366e609f376f9448e89dd6c3c7d8e47c0db54b9d",
      "text": "Panjenengan saking pundi?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "98212adc839247fc623efa65970d1bf8d2ed10b1513e354122e42a3df112ceb9",
      "text": "Sae, Pak, matur nuwun. Nyuwun sewu, jam pinten?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ccfca3da0e2b74dabf6033fc3df3d8810962b23bb6d2649a066fea1fbe41874",
      "text": "Kula mandhap ing ngriku, Pak. Pinten?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f268ca5e4fbaf2c203bd1b77115551757b33c6f85377e73b4f67e9442e98957",
      "text": "godhong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a394dea7e832d4f86748f12889c2819a259627705c36f5158020422efd2a9807",
      "text": "pundi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3bf467739ec65789c00de2bb0ee804af055f5127fb8b0f39a0f70276f389c65",
      "text": "pendhapa",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f9973366070763d0e916fc200ff3aed7f93dc9967dfa4f321c87f3311a2767",
      "text": "Sami-sami, Mas Mohamed.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6113c5dd75dc0f68ca94e5f6e6f1fcf646e4c994c51d49523cba70e6db80527",
      "text": "Panjenengan badhe tindak pundi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a685bf99f190d90d6d850c4f98ffb769d391b14ac05f5acea077e291a685a568",
      "text": "Panjenengan saking pundi? Mangga, taken kemawon!",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a69a5ded43eb9b40543e8d5ff846c6db9b0bcf653366d95f051832165aae1584",
      "text": "lajeng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a709415c5cdd04e79d24de9522aa8d16bc8e89cb076f2cf38103a49d82719081",
      "text": "inggil",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a79a19d2ee0499e68401f96bae0031ebb1cb3a23ddd7e311aa30aeb7a39acbf2",
      "text": "parkir",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7d0fa2dafa0cc6ff0dcbc3a48df8eea49c704f03f7b3d8bc1e1758e4ecfd97c",
      "text": "Saking mriki lurus kemawon, lajeng ngiwa.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a90a25b170992b8d388cf458e7682989c7c8dfe003017c995d49d11194bd9b43",
      "text": "Kula remen sanget sinau basa Jawi.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaa6ca3bbe61437c952c47f145802c1cfac99ba65a1f308f03c86af21ef7c27f",
      "text": "Kula mandhap ing bandara.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb3f1801b323c2015d899ec10827a27dfafcbc966d639db5689665de43b852f",
      "text": "kesusu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "abf9615ebd9d34dd6ed75382dad6f3e535988921066fbda1ff1720a3136089b7",
      "text": "Alon-alon waton kelakon.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b03fd27ec0c8f6468f99751a59ab2a81c45d36f183f1fe2157bffa9084b38080",
      "text": "mandhap",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0802fd6b54a9d5e030178d0e47032ea35cf22da7643f0caea4ec353592aad09",
      "text": "taken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24dbb76117832ce40e8e8bda1884310d40e8a2d4363b5ee0efc628f1ca6d857",
      "text": "Pendhapa: saking mriki lurus kemawon, lajeng nengen.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b46f0fc5886345be09b1522d025827dc60335e47d13956be2d363479a5ea5d39",
      "text": "sabin",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b474a83bcce6cb441c8ebb8b1680ef7916e91e4c6b4abb0c791541f9ef9d78e2",
      "text": "Mangga minggah, Mas. Dhateng pundi?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5ad338347abec0b91a2c6f97afbc7b919b9dba15c69d8cbc947655b7c279129",
      "text": "Saged, Mas. Mboten tebih.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbf667c22142f339050dfdf933962f91b85f3dc8ed0b3a114f4daf0fa38bca5b",
      "text": "Nyuwun sewu, Pak. Margi dhateng kitha pundi?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bca5fe50e0c70f15cd8dd7b7b38786bb48a2702ec05701319852d6da610156a3",
      "text": "Jarakipun tebih, Pak?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd30c66907010aa9dbf3d88a92315ba57edda62354391f241c6d7754b50b6937",
      "text": "Kenging menapa panjenengan remen pendhapa?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd5690cd56385df5f348e3e6f2d7c8943b415c5b08c8eb1ff33fcbe806e5f526",
      "text": "Tebih, Mbah? — Mboten, celak kemawon.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf56d5ddc2597e60b0d147c6ddd7f555e1e80dd772c45a146adced432889ffdb",
      "text": "Menika pendhapa, Mas. Sae sanget, nggih?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf8b94b70500a28512089bc4f5bb357b6b682f12f28358e38fbdb6fb9e050ca5",
      "text": "Nyuwun sewu, Mbah. Kula badhe dhateng Pasar Triwindu. Ing pundi, nggih?",
      "voice": "jv_dimas",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "c139259b1e905393d85ef3bc364aa9893ec651e63a24181dfd2091081fa453d8",
      "text": "Mas Mohamed, menika sabin kula.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c15d7dff3c8682978c2cff94eb899e086997eeaccdf416b59851061ad873aaf8",
      "text": "pinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5ae292f230628b79fca30a30d61eb3df9ffd1b534bf0d0100238b757903d2ee",
      "text": "Menika, Mas. Sampeyan saking pundi?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b4d2194c90908937ff2d8675a63dcfbc09115e3c78186e92443b058d2210b0",
      "text": "Kula remen basa Jawi.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83bed81d6a50b7fa59b865acc3ccf751e11755ede93a0e5051a69c03fd859d5",
      "text": "Tebih, Pak?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8de7f66144b722e9f458ac455ae2b2c12420398ec8f4acbee3c5b9b0de4a70d",
      "text": "Mboten menapa-menapa. Mlampah alon-alon kemawon, marginipun lunyu.",
      "voice": "jv_dimas",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "c914e0b83e0ddec1ef06a19fe6b816377ec08d364af805b040400fd1aab64c79",
      "text": "Nyuwun sewu, Bu, kula badhe taken.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c97955b7ece424e5d82291a068ff81060bb71ee5e7766a07ef343e1d6959c496",
      "text": "Mohamed: Saking Pasar Gede, Pak. Tebih? — Pak Wiryo: Mboten tebih, Mas. Saged mlampah kemawon.",
      "voice": "jv_siti",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "caf88bd6100b1c8cdf732fbe41c16f3f3a3e191d82a1b428eb07c972ef21c8ce",
      "text": "Kula saking Kairo, Pak. Nyuwun sewu, asmanipun sinten?",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccd53959b9cad86f80749dcf72d85f608b2a6e1b42125aedecccc17fe7676f4e",
      "text": "Nyuwun sewu, asmanipun sinten?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6b16186fcded0f29f9e2c876a41186de988563dc73363cc1088c2a1b07db36",
      "text": "Mboten, Pak. Kula mlampah kemawon saking Pasar Gede.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfbcc99334ae8ce3ec58fe0540756b9d1eb3a4ee2ce1fc2d4b07e98b48436921",
      "text": "Wah, sae sanget! Panjenengan petani, Pak?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0feee0470955c5136f17092ae2ff613f031005f07a4e86d62d34407ce8688a5",
      "text": "Inggih, Pak. Pasar Triwindu ing pundi?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4f6727f99134e1243f3f3becdb059b88692e8e85414de8386419867ce4969ba",
      "text": "Jam sanga, Mas. Sampeyan badhe dhateng pundi?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52f1908acd31d7ce8ffcd0732cbcdf97a999920e7780560416dea908aca3c01",
      "text": "Mohamed: Sugeng enjing, Pak. Panjenengan wonten ing pendhapa jam pinten?",
      "voice": "jv_siti",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b744fe7686d3139677993c1c60a32d7c55bf9a30e1b02b61e8c1b3e674bbaa",
      "text": "Reginipun pinten, Bu?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f07f39ea62a954f78a3089b324bc96bc47e4f80ccbbc1c0aec120d2652dc74",
      "text": "Pendhapa menika sae sanget, Mas. Sampeyan remen?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "da4c701dd4c802617f95ba30c50556fa6c867bd47d78026db36367059a662f97",
      "text": "budhal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "da8499b37557071a42c293baaf9f17e37138a44f8393c4e249d48c89d67ab1ca",
      "text": "Inggih. Saben enjing kula dhateng sabin, lajeng dhateng lepen.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "da946bd70c2630a8bf1c64458986094f02b241d5892eef091735059e19e85eda",
      "text": "Pesawat kula mangkat jam sanga enjing.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc74d7dd4b04574976373d314efb8a6931f8b88284706456ea90d58ea284da7d",
      "text": "minggah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "de1775dda7ffabab5c6aed0eaad292754494a0ce050903f319a65b12ce127e4e",
      "text": "sawah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "de76b8755488730734bbad0dc2ded9bd3ced17ce9f25c64b2532a54268553177",
      "text": "Pripun kabaripun? — Sae, matur nuwun.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "df3f2dc71fe930fa318b91250612502402f1df4931b81f4284769bb0cd9ad708",
      "text": "Inggih, Pak. Remen sanget!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfdf4a16375b08f19f3375abd48bd03162d7bb3abdb1dc77feb702ae91facdc0",
      "text": "alon-alon",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1358649c8e217e35f6f6828d2551b4797d42522743baa63929213948f8bf777",
      "text": "margi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2beaeb72da886f8da5c73fb5b926d02ca2d4e7429fdba7a32a51e4a0cfb3ebe",
      "text": "Celak kemawon. Saking mriki lurus, lajeng nengen.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33ca55b1939d728d158786d153997b01ed81a66a5d5c0ea36828e71aa1ef8e5",
      "text": "Nyuwun sewu, Pak, jam pinten? — Jam sanga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e567830595b26cdbbf3f0f85a9139de6635ad312cec677171f7872a9edd988d8",
      "text": "Sugeng rawuh ing Pura Mangkunegaran.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e62f76ba29256faef660b2cd9ceb780b3935db387b004fd0c9541048c4760498",
      "text": "Nyuwun sewu, Pak Wiryo. Menika menapa?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7828dd70e8a02153b0475cc2091cc6000e3b001f3d0338104df087f18f92391",
      "text": "Menika sinten?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea316ab51cbb4b0c97707d8a8db15fb6a9b679d079f9ab547beb48cb8d12a49d",
      "text": "Menapa menika? — Menika pendhapa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea89b4f0db2d89ced057016da303171bfe13eb730bc2db506b9c34a6322063aa",
      "text": "Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec4a3c3405f722bf1cbfe098f311beb15ec5725888a056f70736ca0acf4faa5f",
      "text": "Nyuwun sewu, margi dhateng kitha pundi?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecbace16a5b771edd383069e162d5061753399ee1f6638acfd82c1404e1b5419",
      "text": "Nyuwun sewu, kula kesusu. Pesawat kula mangkat jam sedasa.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecd782ad006a58f93fd24b9fc6277305675949f11b543d1f924344457d56808d",
      "text": "Lurus kemawon, lajeng ngiwa.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed20ec777065dd2c92c814474bef6dbd61a5d4ccdf0125eb1fc5cd57e1b72ffa",
      "text": "Aku mudhun kene, banjur budhal nang bandara.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb872d2b36a2e54a8cee4993e5dfba654d500cedf7dd0f240bf0f850b7b77e5",
      "text": "ron",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f059db686077d7a078829a55f70394d3298bd590b081eb4ef1544fe4c84e2493",
      "text": "Matur nuwun sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
