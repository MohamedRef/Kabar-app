    },
    {
      "id": "j3.u04.l06",
      "sha256": "c4019816a3a089fd5163993310f80f2d2663e63132c3cefdfec14945c5aa7601"
    },
    {
      "id": "j3.u04.l07",
      "sha256": "64affd5852d1c84a5d5e99750028ae905397a011e41a30ff4ed92dcb707159de"
    },
    {
      "id": "j3.u04.l08",
      "sha256": "8b2f019971047b89d63f87e30de23ddd13415d8b0a2fe8970102ea0c4554598f"
    },
    {
