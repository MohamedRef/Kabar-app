    },
    {
      "id": "j3.u04.l10",
      "sha256": "8c42592cfe5c7441db8142b18df4aafdcf57f01646e287e2a4429c394ea9d2a3"
    },
    {
      "id": "j3.u04.l11",
      "sha256": "850b0eafc01c5e5a7d0b8618090d251f8144652c8939b113566538ff3034f46e"
    }
  ],
  "audio": [
    {
      "key": "01545ac0f34eafe10f99c9c224ce78f487188f10a310dbc187a762e8bc156a7c",
      "text": "kemawon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0167eb07c7057a52b8de2d761dfc2990e0954ed8f8299a89948ea7068580d810",
      "text": "Masjidipun ing pinggir margi.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "01ccc6150bed840460f065e8c04796ee4c156b0504805b89d97f7c5e85c7de98",
      "text": "Kula mandhap ing bandara, Pak.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "020e1b57f5415a72c700bd66a9d37d6b18e3b22d2c2adcb5f6da932d0f78ab31",
      "text": "Pak, kanca kula tumut, nggih?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0224b9a6d77e2fd49d60ed553a447b3a49a16324491cca43c119898d3411b6d6",
      "text": "Kula remen sanget basa Jawi lan pendhapa menika.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "0598d01b31612af8493dcfe41db9b903071530541cf114c3f56ff1375bfcc4e8",
      "text": "Pak Wiryo: Jam sanga, Mas. Sampeyan saking pundi?",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0667fbf8f5521964500df4573e33f191b1d33f43ea6d7f143771d403f285391c",
      "text": "tebih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "06dfcf07b8098b9f0d8ab36ed082a3903591f24d88e9c12ae6e4d0d400a47ee2",
      "text": "Menika menapa? — Menika pendhapa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "07aba8cb36df16df51a001c3908a12469cbe3c34ce77f9eb808f40bd609f8d26",
      "text": "Inggih, Pak. Pasar Ngasem ing pundi?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "092799ad5b853f841039ecea13934f3b89fd78fff57e328d53fce107f6576bf2",
      "text": "Lurus mawon, mangke ngiwa.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e58608822b1fcd7174f0ea439b33e352bfe6d4dc9786a8e74ef53e92b87358f",
      "text": "Dhateng bandara, Pak. Kula kesusu sanget.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "15407d3d6b38fc57098d5ab8d08928625bedddcd966755af9849c25db2aab8b7",
      "text": "andong",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "16bf2fd9b52014d0f9f05051bd29c73dd5b45c0538241488e27f901bafe31608",
      "text": "Mboten, celak kemawon. Nanging mboten kepareng nedha ing pendhapa, nggih.",
      "voice": "jv_dimas",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c543046da932b6fbf977cde4b8c9c4c7c13366839a3abc58ae313b36e2a9e3",
      "text": "Pak Wiryo, panjenengan saking Klaten?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "186dce75b1d72813a2f42c64243eba0c656938039bfa836364bd020af9ffa6c1",
      "text": "sinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ad557cd6128fcb4d8483ed079e7df5cc4528275b333af4002907f08a4429caa",
      "text": "dawa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1efe23e2429fc9a9aab327cbc15e3a20829dabafd141e7840b082090fe77cbe0",
      "text": "Inggih, Pak. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f2de9aafae767dabddbffe4c4b5facaa6f9c044d05c7cad2c8fb7d5032a5e01",
      "text": "Waduh, payung kula kantun ing warung!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fa33ca878da09c239dd9687f3e1c92b85bee9a56897cf7400a16c65f98acd47",
      "text": "remen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fccdcecd31cfc5b2d9df4336b9786d10d5498e63c2ac98baad3aaca176bf354",
      "text": "mlampah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd1dfae7c9eb2f90eb1922097a4dd21f75b63567e7a0b5eaf2200d2af21e9d0",
      "text": "ngrika",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "207dfe9bcef3290972ba6ac6aae5afee5755f368ebe2205022d779aba6d1340f",
      "text": "Saking mriki lurus kemawon, lajeng nengen.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "22dfb106819a4e73e9fdab987bc4277006a96bc613cdf60031e6d43e09bf8c2e",
      "text": "Sugeng rawuh ing Pura Pakualaman.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f8b71ef8eb6760ff8e7c71bc58437cfd7b4190b03f7d8d3850e04767d27973",
      "text": "kantun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2af103c6c2f3ea9cb8d727161587e711d9b5f68faf60a928021b12911a522dcf",
      "text": "bandara",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e1913e771d44e6d9d0c6f689fc9b8ca5e31c4be25c0b67c6010062bf11dec5e",
      "text": "Pesawate mangkat jam pinten?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fdb79618a0f23f666126b49da6b02b571f578c6704a9a425f03aee0f9685a3b",
      "text": "Kula badhe dhateng Pasar Beringharjo, Pak.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3018fb78a5c4462bef6c5815071e8164ebb3f37e4f2d400a54e170aee5b41ee7",
      "text": "Lare-lare dolanan ing pinggir lepen.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "31d9834b7e7d4a78aa78e1becdb39f7dcad25dc485e2847248e115fcea5380a7",
      "text": "Nyuwun sewu, Mas, mboten kepareng nedha ing pendhapa.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "32594aa919885cf5404bc39717f9e1e9aca221e533a781d614dc8a7ff3bf4b3e",
      "text": "kepareng",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3316ca005f6c296e7b491f8dfd51c447d4f538135afc94ff915a737f1e822c69",
      "text": "Mboten, Pak. Kula mlampah kemawon saking Pasar Kranggan.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "338a12cce919a0e8ad441c1240a410f065a906ea3a826bfcc6077696693f87f7",
      "text": "Inggih, Pak. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "365651f01c36ddd0fd647508fe2dc1ac677d6db893df0bdf96ad8772f5e0e81c",
      "text": "mriki",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "371bd2daf4fe64908c09d4a829d4944391929343309d911380103e170baed064",
      "text": "Matur nuwun sanget, Mbah.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fb0010f9af8df8ee4e365fdda71db6b377f53fd39a5fdcc3d9da065b869812c",
      "text": "Masjidipun ing pinggir margi, ing ngrika.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e890dfe9ec21b53024172936420d28ea87be31c9e64dbe49ad8efb23fb5b21",
      "text": "Pura Pakualaman ing wetan, celak sanget.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "414dce4b1e686d5d332af0b9ca3dbdc0d0f6c664e84ec3154130c64ff621abdf",
      "text": "Sugeng enjing. Nami kula Wiryo. Kula saking Klaten.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "424122bc03bb5b503d55891a98f03eb30971da8c1a39fd7c9186e58819086127",
      "text": "kenging menapa",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "42b92cbf36858b255173865234c8269359954d2059b8b016fa6796401d2bff04",
      "text": "Pak, andongipun kosong? Dhateng Pura Pakualaman pinten?",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "430102143024567d65ef25ede898edbe57c23306d58478d454574b71ce2d83a0",
      "text": "Nyuwun sewu, Pak. Pendhapa ing pundi?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "44715904521167b4eed4388f8ca03c28b0f1237ebd632efe545afd8216e97589",
      "text": "Aku melu ya, Med!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d3d97d3b0f8ba345e6add9e248734027fe178426b8f9e8ac59da7758ead42c",
      "text": "Jam sanga, Mas. Badhe tindak pundi?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "461c6b45ca25c9ddcd07af99e2d646aeecd395619c9449e6f18e8ba5c81ab532",
      "text": "Niki, Mas. Mase saking pundi?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "496446ec4cfe7cdb54f87e65ddf65f8d7065c17be1ec77f439fb31eac43436ee",
      "text": "ngandhap",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c53398cf0882ce7bee96f02d973c17fd619eb17ecfd73624279b2f7f2a51c89",
      "text": "Penumpang mandhap ing bandara.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c8119efb00a4c6a2852f452282d5647e2bad196d63ed8b190b74eb043703ae4",
      "text": "ler",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "4db99aeb5a739f4252d94327a4ebbdbeb34ae1653a9a394ea56c373a5bba1e59",
      "text": "Petani wonten sabin.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ecba1d084c993f97b6890e5d1d6f4e37938bc34ea1551a6b31252b66fd1dfed",
      "text": "Panjenengan badhe tindak pundi, Pak?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5230ac4b8398a35bb4738dca407ec83685a54f344cc8bcbdb63bd0613748745b",
      "text": "Margi menika dawa sanget.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5407d13e0ac57866361e09078a609910a24ed4b9a28026362253fa09e8dd05ec",
      "text": "lepen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "58017893b8cc099c3b622fe63aaf84846dbdabe6e97dcb68d01bc4339c111a39",
      "text": "Batik Beringharjo sae sanget, Mas!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cb3b4b36ce32e6bbaa86d2a96d739c8e25fc149028cad272d4c61c1615adf7e",
      "text": "wetan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d5e7888d0843346558ebb2dbc43bb6904f3e84fa2a3981467d124f8e12bef30",
      "text": "Taman Sari ing kilen Kraton.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d8f6b624d534000c57db3811d29c7de47275ac04ec55731c392eb680b9735d9",
      "text": "Saking mriki lurus mawon, mangke nengen.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f102e9f21047801a2817c4295adb8549dddfee000b708a56037f86a7a3612c8",
      "text": "Sugeng enjing, Pak Wiryo!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "60cbf238591a56b8415447f03575990bbe010192e2ead9be39a6325147de914c",
      "text": "Jarakipun saking mriki dhateng kitha pinten?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6256e329d528988064fd578e91f130051a87707e6b1e7164a739694a5a9baa85",
      "text": "Jam sedasa. Kula wau budhal rada telat.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "63fcb5e53f67da65974d57b7cd5c22d60096dd59957373d633e3711c1d6e5ca0",
      "text": "jawah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "64375e13c2bdde6e5e51b4078d962507f37b9fc775ef67df5df45697be19061b",
      "text": "sanget",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6520633821471af035df89de01d9155283c1ea5472c5407b2ddf0ca08d38cf6e",
      "text": "Kenging menapa panjenengan remen basa Jawi?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "66270b658975d65c2e687533d13278a0f20873dd322692c95a54ce5f8595eecb",
      "text": "Mboten napa-napa. Margine taksih lancar.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "662d859eef88ceaa956c5a5c9be3f0e421a3df9dd5c918bec1b35f2fdc328f23",
      "text": "saged",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dc7fe2ec217eaa4701ef0587b849bf62a3639944657ac23b836eed740741ecc",
      "text": "celak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e6a5ef3e5e76759664c4fa66054d0ca73ff009402c6d5ed8e1653a966d99905",
      "text": "tumut",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6eaeeec9f567eacadeee288a33136a8043e1fef73914b0fbc1df08f0d5a49ffd",
      "text": "koper",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f4d508174889ecf9bcb282eaa9175011037c738948f5614f6a71bbc7beb09d1",
      "text": "Jawah, mangga mlampah alon-alon.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7156b1b0c2d3b86883693518f2316ad7f5af15210b1346377fa1cda41dbfa690",
      "text": "Pak, jawah!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "71900d380c54cf773fd18e25f14a6b4ae1714211c727259127bfb564ed5618a1",
      "text": "Wedhus mangan ___ ing pinggir sawah.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "74658e194f9a3b70a2e05ab004903aefaccd996c779705c131bb43de343aad6f",
      "text": "Saking mriki pripun, Mbah?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "77bf6f3a225f8712ca919c8a3ae822c3e7cf61716d1bf8a994deb919b13ad796",
      "text": "Nyuwun sewu, mboten kepareng nedha ing pendhapa.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "784aa3cf32e0eebab6df39ba3454dd91139b805d82618c5ec4974c30e17dc20e",
      "text": "Munggah (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "78f44f3fb91301742e2191598ef41cf6a0c600c54f05128750e4b48cb43c4325",
      "text": "ngriku",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aa17b5d767e3b1316aae069bf627e053275d4d107cfd8aa6908e83eaeeedcf5",
      "text": "Mangga, taken kemawon.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b87da60459fc5f1e28c6d4bbfa666667a7f7f3068a87c38c32b9b8bee226216",
      "text": "Nyuwun sewu, Pak, kula badhe taken. Pura Pakualaman ing pundi?",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d0596d8c19df18c97ea84830c7aa03e01780e0f72ee0c4deeae4c371a87f9b3",
      "text": "Nggih, leres. Ati-ati, Mas.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e06e3cd08a97ed08eacc93b501068c46008220bf2bbcaaa70bd59f515201cdd",
      "text": "Udan (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f4979a9fe3762d45d491277f3eba45b334a0f5a7d4ed96fc6047c1d9fdd6320",
      "text": "Celak mawon. Saking mriki lurus, mangke nengen.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "7faa7911c76ef98b778ddb493f262db193ecca89db1a0f3912fe4126ca02aac2",
      "text": "Andongipun ing ler, celak Tugu.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "80950c401a3fbb3a8eaf2bf452104f289a73c9f6474b53ff891e3392e4695269",
      "text": "Pak Wiryo, kula badhe taken.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "81f7b3c3e0c13cd09ad775307dfbc6da19af7b8eb1938ea29d5e3e5bd6ae3bfe",
      "text": "kari (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8233e677b032cec83df83a301a3b7f7925f4ba5348ebe063d4e344f0f9002a0a",
      "text": "lor (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "83784f44f45d1508522c42f3733c4fb0a90b3e5611b286bd69955f1250e64841",
      "text": "Matur nuwun, Pak Wiryo.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "841b3ba4ca6771b837ebde940301443e3bb026c404c979fe29f1a89d67c60d86",
      "text": "pripun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "841bf817a21767b773600b36db39cfa5d9860250c8fde8847e01d633478754e2",
      "text": "Tugu ing ler, Taman Sari ing kilen Kraton.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8456e1f10b66f88a981509190ba2f0d95df72a31bd6d5e3b04653fa4d5e5f9f8",
      "text": "kitha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "86f22e093df6d23d6f38d95fd90cd25d2ffd60d4e8344a2939a9cbf10ef0c22f",
      "text": "Kono (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "87c9133bd6427a328ae25c954804b9756fe311349ad35d255f077ae4eed5a584",
      "text": "Nyuwun sewu, Mbah. Kula badhe dhateng Pasar Ngasem. Ing pundi, nggih?",
      "voice": "jv_dimas",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "889c74c9482c1fec0c65fb59c4870367fe14635d5c48289684e4f3843291a1bb",
      "text": "Nyuwun sewu, Pak.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ac9adaf8c2427f7f273bf37625051aa76780f69de8d43c166f8011710cdcbac",
      "text": "menapa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b678080e5cea55276fe2e2f563e2f6e5a3531924147d60242733d82baed17e8",
      "text": "Mohamed: Saking Pasar Kranggan, Pak. Tebih? — Pak Wiryo: Mboten tebih, Mas. Saged mlampah kemawon.",
      "voice": "jv_siti",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c06a86b99da168f0b1362035bcf74d53eb0e834fa3adc58a42dab4bb28158bb",
      "text": "Nyuwun sewu, Pak Wiryo. Pendhapa ing pundi?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eac4d7188af3ea8a2f3c6fb44d5915e808950951d71d004b7cc75153d7e085e",
      "text": "Alon-alon waton kelakon, Pak!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ef727fbb3eb74239281858a20fbe1910de63b263aca809652768a8ae86fb8e1",
      "text": "Pak, tas kula kantun ing ngandhap kursi!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f915a831f69131699339b352096e8b645a93bf07f4cadde0097fed1208e088b",
      "text": "Mboten tebih, Mas. Saged mlampah kemawon.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f93293d83672861f00706b0fc3881f23fe88c312db5769cf0e74c44f95009e8",
      "text": "Saged, Mas. Mboten tebih, kok.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "91e7ab90d1175ed512ccfe1a8da7e346a8fa211b014a959976462c9c9ec0d20a",
      "text": "Sami-sami, Mas.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "92dc2e789f263f2a4a39d742fade458855fb0c30ee7cc3c93b413d19c7cfebde",
      "text": "Mangga minggah, Mas.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "939f3f15628e059ac88201fb94375867d6d6299170f80d50103384803f1c944f",
      "text": "Kana (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9526fc09c4d381ef7d5e9b797892c617f5eba5c07b9e1f10a054d14ca659b3b7",
      "text": "Monggo, Mas. Teng pundi?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9632113485e8fb03bf6e4bbe1cae44732f11438a1781b4dea8c61414760fb7c1",
      "text": "Masjid ing pinggir margi menika?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "973d231be4b6b4ed1d89da0ae38db15527218a99d62cb6ca491135a0bee94b73",
      "text": "Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "97b9d312b0a3f351a1eb24de366e609f376f9448e89dd6c3c7d8e47c0db54b9d",
      "text": "Panjenengan saking pundi?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "98212adc839247fc623efa65970d1bf8d2ed10b1513e354122e42a3df112ceb9",
      "text": "Sae, Pak, matur nuwun. Nyuwun sewu, jam pinten?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ccfca3da0e2b74dabf6033fc3df3d8810962b23bb6d2649a066fea1fbe41874",
      "text": "Kula mandhap ing ngriku, Pak. Pinten?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d29cf03bbd3063111b643601393414be25e672f9e7944e757416d5b5293a34b",
      "text": "Nyuwun sewu, Mbah. Saking mriki saged mlampah dhateng Pasar Ngasem?",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f785ecdee112576584c1934ef6ea73ab210db752eef17c94d47eb20eaa5d618",
      "text": "Mas Mohamed, niki sabin kula.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fb959b883d5e863790ac9fc65637858ee1c69189f066ed6f3b74e1408a6211a",
      "text": "karcis",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a394dea7e832d4f86748f12889c2819a259627705c36f5158020422efd2a9807",
      "text": "pundi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3bf467739ec65789c00de2bb0ee804af055f5127fb8b0f39a0f70276f389c65",
      "text": "pendhapa",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6113c5dd75dc0f68ca94e5f6e6f1fcf646e4c994c51d49523cba70e6db80527",
      "text": "Panjenengan badhe tindak pundi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a685bf99f190d90d6d850c4f98ffb769d391b14ac05f5acea077e291a685a568",
      "text": "Panjenengan saking pundi? Mangga, taken kemawon!",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a69a5ded43eb9b40543e8d5ff846c6db9b0bcf653366d95f051832165aae1584",
      "text": "lajeng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a709415c5cdd04e79d24de9522aa8d16bc8e89cb076f2cf38103a49d82719081",
      "text": "inggil",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a79a19d2ee0499e68401f96bae0031ebb1cb3a23ddd7e311aa30aeb7a39acbf2",
      "text": "parkir",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7d0fa2dafa0cc6ff0dcbc3a48df8eea49c704f03f7b3d8bc1e1758e4ecfd97c",
      "text": "Saking mriki lurus kemawon, lajeng ngiwa.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a90a25b170992b8d388cf458e7682989c7c8dfe003017c995d49d11194bd9b43",
      "text": "Kula remen sanget sinau basa Jawi.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaa6ca3bbe61437c952c47f145802c1cfac99ba65a1f308f03c86af21ef7c27f",
      "text": "Kula mandhap ing bandara.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "abf9615ebd9d34dd6ed75382dad6f3e535988921066fbda1ff1720a3136089b7",
      "text": "Alon-alon waton kelakon.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "aebbd2c30ce809794dc410e2f5e71d292ee7f7b9a12f1df7f66b13985f16d200",
      "text": "Karcis kula ing koper. Pesawat kula mangkat jam sedasa.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b03fd27ec0c8f6468f99751a59ab2a81c45d36f183f1fe2157bffa9084b38080",
      "text": "mandhap",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0802fd6b54a9d5e030178d0e47032ea35cf22da7643f0caea4ec353592aad09",
      "text": "taken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b11dbbe80d152f9b599dd11d6fc235ce5cfc039f3f6234a99010552fea92d490",
      "text": "penumpang",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b163d6a07c7d35a29deed8eaa9843d6e9cfdf4408401895ec63ecca2aea61b85",
      "text": "nandur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1ce5c6fa4fabec0fec19cd0aabc0e5c3e27ad9293442caea0e9d94f2d63c88b",
      "text": "Sugeng enjing, Mas Mohamed. Tebih, to?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24dbb76117832ce40e8e8bda1884310d40e8a2d4363b5ee0efc628f1ca6d857",
      "text": "Pendhapa: saking mriki lurus kemawon, lajeng nengen.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c6076a6954b6ec8c2a34c6b204d31519a06c2c6f8f6e5ae1f407e7398879a3",
      "text": "Kosong, Mas. Pakualaman ing wetan, celak. Seket ewu mawon.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b46f0fc5886345be09b1522d025827dc60335e47d13956be2d363479a5ea5d39",
      "text": "sabin",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4e6e1ddfaef1c91bd458a476def5b05df165a5e7aae9e17d1f01c4bc3ee0c79",
      "text": "Niki pendhapa, Mas. Sae, nggih?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbf667c22142f339050dfdf933962f91b85f3dc8ed0b3a114f4daf0fa38bca5b",
      "text": "Nyuwun sewu, Pak. Margi dhateng kitha pundi?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bca5fe50e0c70f15cd8dd7b7b38786bb48a2702ec05701319852d6da610156a3",
      "text": "Jarakipun tebih, Pak?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd30c66907010aa9dbf3d88a92315ba57edda62354391f241c6d7754b50b6937",
      "text": "Kenging menapa panjenengan remen pendhapa?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd5690cd56385df5f348e3e6f2d7c8943b415c5b08c8eb1ff33fcbe806e5f526",
      "text": "Tebih, Mbah? — Mboten, celak kemawon.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c15d7dff3c8682978c2cff94eb899e086997eeaccdf416b59851061ad873aaf8",
      "text": "pinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b4d2194c90908937ff2d8675a63dcfbc09115e3c78186e92443b058d2210b0",
      "text": "Kula remen basa Jawi.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83bed81d6a50b7fa59b865acc3ccf751e11755ede93a0e5051a69c03fd859d5",
      "text": "Tebih, Pak?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c914e0b83e0ddec1ef06a19fe6b816377ec08d364af805b040400fd1aab64c79",
      "text": "Nyuwun sewu, Bu, kula badhe taken.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "caf88bd6100b1c8cdf732fbe41c16f3f3a3e191d82a1b428eb07c972ef21c8ce",
      "text": "Kula saking Kairo, Pak. Nyuwun sewu, asmanipun sinten?",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccd53959b9cad86f80749dcf72d85f608b2a6e1b42125aedecccc17fe7676f4e",
      "text": "Nyuwun sewu, asmanipun sinten?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfbcc99334ae8ce3ec58fe0540756b9d1eb3a4ee2ce1fc2d4b07e98b48436921",
      "text": "Wah, sae sanget! Panjenengan petani, Pak?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d278091b2df0abc1460af37ae1a2198cb752804360ece3eff1b690acd4a57d68",
      "text": "Mboten napa-napa. Alon-alon mawon, margine lunyu.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52f1908acd31d7ce8ffcd0732cbcdf97a999920e7780560416dea908aca3c01",
      "text": "Mohamed: Sugeng enjing, Pak. Panjenengan wonten ing pendhapa jam pinten?",
      "voice": "jv_siti",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b744fe7686d3139677993c1c60a32d7c55bf9a30e1b02b61e8c1b3e674bbaa",
      "text": "Reginipun pinten, Bu?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f07f39ea62a954f78a3089b324bc96bc47e4f80ccbbc1c0aec120d2652dc74",
      "text": "Pendhapa menika sae sanget, Mas. Sampeyan remen?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "da4c701dd4c802617f95ba30c50556fa6c867bd47d78026db36367059a662f97",
      "text": "budhal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "da8499b37557071a42c293baaf9f17e37138a44f8393c4e249d48c89d67ab1ca",
      "text": "Inggih. Saben enjing kula dhateng sabin, lajeng dhateng lepen.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "da946bd70c2630a8bf1c64458986094f02b241d5892eef091735059e19e85eda",
      "text": "Pesawat kula mangkat jam sanga enjing.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "db0e94f55128a18ff108313bbc258f304c513d79194499a9bcc79a853362b93b",
      "text": "Pura Pakualaman ing wetan, celak.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "db29f348deebd1ec5117a7cbddf76f9f093f4de29e902617618488d92a53f05a",
      "text": "Saking mriki lurus mawon, mangke nengen, Mas.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc74d7dd4b04574976373d314efb8a6931f8b88284706456ea90d58ea284da7d",
      "text": "minggah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "de76b8755488730734bbad0dc2ded9bd3ced17ce9f25c64b2532a54268553177",
      "text": "Pripun kabaripun? — Sae, matur nuwun.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "dedf19d5b8a9d6d5260b4db2fc2382bf2dca5d82d7dc3473c3045a7693893b00",
      "text": "Nyuwun sewu, Pak, Pura Pakualaman ing pundi?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "df3f2dc71fe930fa318b91250612502402f1df4931b81f4284769bb0cd9ad708",
      "text": "Inggih, Pak. Remen sanget!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfdf4a16375b08f19f3375abd48bd03162d7bb3abdb1dc77feb702ae91facdc0",
      "text": "alon-alon",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1358649c8e217e35f6f6828d2551b4797d42522743baa63929213948f8bf777",
      "text": "margi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e22779c87151d019334ba5408c9e20201dce9709f6f0600b1fa619d62336340c",
      "text": "Mangga. Tasipun dipunselehaken ing ngandhap kursi.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33ca55b1939d728d158786d153997b01ed81a66a5d5c0ea36828e71aa1ef8e5",
      "text": "Nyuwun sewu, Pak, jam pinten? — Jam sanga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e62f76ba29256faef660b2cd9ceb780b3935db387b004fd0c9541048c4760498",
      "text": "Nyuwun sewu, Pak Wiryo. Menika menapa?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6c8879903208a09d638518069d39e186b194b5398222cba18a4acd3ffd23f1e",
      "text": "watu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7828dd70e8a02153b0475cc2091cc6000e3b001f3d0338104df087f18f92391",
      "text": "Menika sinten?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea316ab51cbb4b0c97707d8a8db15fb6a9b679d079f9ab547beb48cb8d12a49d",
      "text": "Menapa menika? — Menika pendhapa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea89b4f0db2d89ced057016da303171bfe13eb730bc2db506b9c34a6322063aa",
      "text": "Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec4a3c3405f722bf1cbfe098f311beb15ec5725888a056f70736ca0acf4faa5f",
      "text": "Nyuwun sewu, margi dhateng kitha pundi?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed62a045a658014a535c4eb34d4c3fb3ad3494413f99485a9d0d8d8a8a7bcc46",
      "text": "Sugeng enjing, Mas Mohamed. Pripun kabare?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee37635ee6d1d4d27917bffb9a001d7a0b6bf21c9dbc5443313db609a7419d78",
      "text": "arah",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb872d2b36a2e54a8cee4993e5dfba654d500cedf7dd0f240bf0f850b7b77e5",
      "text": "ron",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f059db686077d7a078829a55f70394d3298bd590b081eb4ef1544fe4c84e2493",
      "text": "Matur nuwun sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f07bc09392370ca25e9bbc7def91f75d22696c383a39b5621d6ba727465ed4f5",
      "text": "Saged mlampah, Mbah?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4aeb086603e6815de73ffe774140fe9684e89d1402db26f444981f5933201e5",
      "text": "Kados pundi, Pak?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "f50e6ebe45121e49d38013ace4e0d8639fdf491a2c4c7e83f0ad33770c020422",
      "text": "petani",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7f40ebe73ecf41fa94aa0c262689e4c54e09ea276726ae7283aea721fb6ce3d",
      "text": "kilen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f902f73339bf9ed626810cac0bc4e1307ae055b2557aae8d710664bc59bd025e",
      "text": "Matur nuwun sanget, Mbah.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa302c5053f6d41afca026f5f58c660d46b9b036137333deaeb3b030c4dc4ac5",
      "text": "basa Jawi",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb27fc58686095bd93be496661d74eb6cdcb9d1e1851ea26976abc9f520ee7bd",
      "text": "Mboten. Kitha ten ngrika, wonten menara masjid sing inggil.",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc8568b5387ad90e124eca9fc091d836798927e39db783cac57d63524960102a",
      "text": "kados pundi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcb2251e966b61362d7086250c56056c4417fc9278d181fd7cf0eae950712c46",
      "text": "jarak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcf231ea120fba92be793b558fad156406b7670301ebe0e8c4130d6f4b03bbd5",
      "text": "Kenging menapa panjenengan sinau basa Jawi?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd5e16e31b2539ae2725c9a7c8b958c7a94ddc6606156978a29f9a686636fae3",
      "text": "Nami kula Wiryo, Mas.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "feabdf95aa50c8a71b69253ee0166a297a3be8eb647d5086cf7662a5ec81bb38",
      "text": "Sae sanget! Monggo, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    }
  ],
