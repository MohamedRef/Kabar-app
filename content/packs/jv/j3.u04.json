    },
    {
      "id": "j3.u04.l04",
      "sha256": "0708cb1aa5b7a02ac877c3ebc480d01fd64515c44b54186ec1e61e2c2040e2ec"
    },
    {
      "id": "j3.u04.l05",
      "sha256": "08c466d73396d8d4f94707c8b9aadce17f679a2d38b2631e7812de3f1ca6b0c9"
    },
    {
      "id": "j3.u04.l06",
      "sha256": "461fbbd1bbd645a034f67609e4269cb090b7a9580f7e6e3bd736caa08e8b18af"
    },
    {
      "id": "j3.u04.l07",
      "sha256": "6e949f2222d98620a78dce2e37c06c512a3321c0cc4e37e2f20580431baa3625"
    }
  ],
  "audio": [
    {
      "key": "01545ac0f34eafe10f99c9c224ce78f487188f10a310dbc187a762e8bc156a7c",
      "text": "kemawon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0224b9a6d77e2fd49d60ed553a447b3a49a16324491cca43c119898d3411b6d6",
      "text": "Kula remen sanget basa Jawi lan pendhapa menika.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "0598d01b31612af8493dcfe41db9b903071530541cf114c3f56ff1375bfcc4e8",
      "text": "Pak Wiryo: Jam sanga, Mas. Sampeyan saking pundi?",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0667fbf8f5521964500df4573e33f191b1d33f43ea6d7f143771d403f285391c",
      "text": "tebih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "06dfcf07b8098b9f0d8ab36ed082a3903591f24d88e9c12ae6e4d0d400a47ee2",
      "text": "Menika menapa? — Menika pendhapa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "091749d01239b19bf8b746306eba8a3d1a802b3478027a73d03a1f1ffee2ee74",
      "text": "Kula badhe dhateng Pasar Klewer, Pak.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b57d96a512d4fe5ba88b046a57790e23bc3dc143cea2bf8468622270508829a",
      "text": "Sugeng enjing, Mas Mohamed. Tebih?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0efa5cfc0f4d4f81b523914b5c23e1c9d833739623d298ea4d9126e3f6b5873d",
      "text": "Saking mriki lurus kemawon, lajeng nengen, Mas.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1118efd3011bb2b4ba026cd6a959cecfd76d3c5e0563848a183b33e91bf2de7a",
      "text": "Batik Klewer sae sanget, Mas!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "11367223c560ef7c1b347b92093f67655b28df6352a9d7f09f55fed2899b7f97",
      "text": "Nyuwun sewu, Pak, Pura Mangkunegaran ing pundi?",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "16bf2fd9b52014d0f9f05051bd29c73dd5b45c0538241488e27f901bafe31608",
      "text": "Mboten, celak kemawon. Nanging mboten kepareng nedha ing pendhapa, nggih.",
      "voice": "jv_dimas",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c543046da932b6fbf977cde4b8c9c4c7c13366839a3abc58ae313b36e2a9e3",
      "text": "Pak Wiryo, panjenengan saking Klaten?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "186dce75b1d72813a2f42c64243eba0c656938039bfa836364bd020af9ffa6c1",
      "text": "sinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "18f57ba0edb66411269cce34858215ae84004ffcccf2b2ffa460d7cc857408b4",
      "text": "Sugeng enjing, Mas Mohamed. Pripun kabaripun?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1efe23e2429fc9a9aab327cbc15e3a20829dabafd141e7840b082090fe77cbe0",
      "text": "Inggih, Pak. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fa33ca878da09c239dd9687f3e1c92b85bee9a56897cf7400a16c65f98acd47",
      "text": "remen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fccdcecd31cfc5b2d9df4336b9786d10d5498e63c2ac98baad3aaca176bf354",
      "text": "mlampah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "207dfe9bcef3290972ba6ac6aae5afee5755f368ebe2205022d779aba6d1340f",
      "text": "Saking mriki lurus kemawon, lajeng nengen.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "31d9834b7e7d4a78aa78e1becdb39f7dcad25dc485e2847248e115fcea5380a7",
      "text": "Nyuwun sewu, Mas, mboten kepareng nedha ing pendhapa.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "32594aa919885cf5404bc39717f9e1e9aca221e533a781d614dc8a7ff3bf4b3e",
      "text": "kepareng",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "338a12cce919a0e8ad441c1240a410f065a906ea3a826bfcc6077696693f87f7",
      "text": "Inggih, Pak. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "365651f01c36ddd0fd647508fe2dc1ac677d6db893df0bdf96ad8772f5e0e81c",
      "text": "mriki",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "371bd2daf4fe64908c09d4a829d4944391929343309d911380103e170baed064",
      "text": "Matur nuwun sanget, Mbah.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "414dce4b1e686d5d332af0b9ca3dbdc0d0f6c664e84ec3154130c64ff621abdf",
      "text": "Sugeng enjing. Nami kula Wiryo. Kula saking Klaten.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "424122bc03bb5b503d55891a98f03eb30971da8c1a39fd7c9186e58819086127",
      "text": "kenging menapa",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "430102143024567d65ef25ede898edbe57c23306d58478d454574b71ce2d83a0",
      "text": "Nyuwun sewu, Pak. Pendhapa ing pundi?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ecba1d084c993f97b6890e5d1d6f4e37938bc34ea1551a6b31252b66fd1dfed",
      "text": "Panjenengan badhe tindak pundi, Pak?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f102e9f21047801a2817c4295adb8549dddfee000b708a56037f86a7a3612c8",
      "text": "Sugeng enjing, Pak Wiryo!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "64375e13c2bdde6e5e51b4078d962507f37b9fc775ef67df5df45697be19061b",
      "text": "sanget",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "662d859eef88ceaa956c5a5c9be3f0e421a3df9dd5c918bec1b35f2fdc328f23",
      "text": "saged",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "74658e194f9a3b70a2e05ab004903aefaccd996c779705c131bb43de343aad6f",
      "text": "Saking mriki pripun, Mbah?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ac127db60a91dfa86320f6c0f0927b612ac231344965a2da8e32c7be07ed66",
      "text": "Nyuwun sewu, Bu, reginipun pinten?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "77bf6f3a225f8712ca919c8a3ae822c3e7cf61716d1bf8a994deb919b13ad796",
      "text": "Nyuwun sewu, mboten kepareng nedha ing pendhapa.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aa17b5d767e3b1316aae069bf627e053275d4d107cfd8aa6908e83eaeeedcf5",
      "text": "Mangga, taken kemawon.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "80950c401a3fbb3a8eaf2bf452104f289a73c9f6474b53ff891e3392e4695269",
      "text": "Pak Wiryo, kula badhe taken.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "83784f44f45d1508522c42f3733c4fb0a90b3e5611b286bd69955f1250e64841",
      "text": "Matur nuwun, Pak Wiryo.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "841b3ba4ca6771b837ebde940301443e3bb026c404c979fe29f1a89d67c60d86",
      "text": "pripun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "889c74c9482c1fec0c65fb59c4870367fe14635d5c48289684e4f3843291a1bb",
      "text": "Nyuwun sewu, Pak.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ac9adaf8c2427f7f273bf37625051aa76780f69de8d43c166f8011710cdcbac",
      "text": "menapa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c06a86b99da168f0b1362035bcf74d53eb0e834fa3adc58a42dab4bb28158bb",
      "text": "Nyuwun sewu, Pak Wiryo. Pendhapa ing pundi?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f915a831f69131699339b352096e8b645a93bf07f4cadde0097fed1208e088b",
      "text": "Mboten tebih, Mas. Saged mlampah kemawon.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "973d231be4b6b4ed1d89da0ae38db15527218a99d62cb6ca491135a0bee94b73",
      "text": "Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "97b9d312b0a3f351a1eb24de366e609f376f9448e89dd6c3c7d8e47c0db54b9d",
      "text": "Panjenengan saking pundi?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "98212adc839247fc623efa65970d1bf8d2ed10b1513e354122e42a3df112ceb9",
      "text": "Sae, Pak, matur nuwun. Nyuwun sewu, jam pinten?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a394dea7e832d4f86748f12889c2819a259627705c36f5158020422efd2a9807",
      "text": "pundi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3bf467739ec65789c00de2bb0ee804af055f5127fb8b0f39a0f70276f389c65",
      "text": "pendhapa",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f9973366070763d0e916fc200ff3aed7f93dc9967dfa4f321c87f3311a2767",
      "text": "Sami-sami, Mas Mohamed.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6113c5dd75dc0f68ca94e5f6e6f1fcf646e4c994c51d49523cba70e6db80527",
      "text": "Panjenengan badhe tindak pundi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a685bf99f190d90d6d850c4f98ffb769d391b14ac05f5acea077e291a685a568",
      "text": "Panjenengan saking pundi? Mangga, taken kemawon!",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a69a5ded43eb9b40543e8d5ff846c6db9b0bcf653366d95f051832165aae1584",
      "text": "lajeng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7d0fa2dafa0cc6ff0dcbc3a48df8eea49c704f03f7b3d8bc1e1758e4ecfd97c",
      "text": "Saking mriki lurus kemawon, lajeng ngiwa.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0802fd6b54a9d5e030178d0e47032ea35cf22da7643f0caea4ec353592aad09",
      "text": "taken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24dbb76117832ce40e8e8bda1884310d40e8a2d4363b5ee0efc628f1ca6d857",
      "text": "Pendhapa: saking mriki lurus kemawon, lajeng nengen.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5ad338347abec0b91a2c6f97afbc7b919b9dba15c69d8cbc947655b7c279129",
      "text": "Saged, Mas. Mboten tebih.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd30c66907010aa9dbf3d88a92315ba57edda62354391f241c6d7754b50b6937",
      "text": "Kenging menapa panjenengan remen pendhapa?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd5690cd56385df5f348e3e6f2d7c8943b415c5b08c8eb1ff33fcbe806e5f526",
      "text": "Tebih, Mbah? — Mboten, celak kemawon.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf56d5ddc2597e60b0d147c6ddd7f555e1e80dd772c45a146adced432889ffdb",
      "text": "Menika pendhapa, Mas. Sae sanget, nggih?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf8b94b70500a28512089bc4f5bb357b6b682f12f28358e38fbdb6fb9e050ca5",
      "text": "Nyuwun sewu, Mbah. Kula badhe dhateng Pasar Triwindu. Ing pundi, nggih?",
      "voice": "jv_dimas",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "c15d7dff3c8682978c2cff94eb899e086997eeaccdf416b59851061ad873aaf8",
      "text": "pinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5ae292f230628b79fca30a30d61eb3df9ffd1b534bf0d0100238b757903d2ee",
      "text": "Menika, Mas. Sampeyan saking pundi?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b4d2194c90908937ff2d8675a63dcfbc09115e3c78186e92443b058d2210b0",
      "text": "Kula remen basa Jawi.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83bed81d6a50b7fa59b865acc3ccf751e11755ede93a0e5051a69c03fd859d5",
      "text": "Tebih, Pak?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c914e0b83e0ddec1ef06a19fe6b816377ec08d364af805b040400fd1aab64c79",
      "text": "Nyuwun sewu, Bu, kula badhe taken.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c97955b7ece424e5d82291a068ff81060bb71ee5e7766a07ef343e1d6959c496",
      "text": "Mohamed: Saking Pasar Gede, Pak. Tebih? — Pak Wiryo: Mboten tebih, Mas. Saged mlampah kemawon.",
      "voice": "jv_siti",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "caf88bd6100b1c8cdf732fbe41c16f3f3a3e191d82a1b428eb07c972ef21c8ce",
      "text": "Kula saking Kairo, Pak. Nyuwun sewu, asmanipun sinten?",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccd53959b9cad86f80749dcf72d85f608b2a6e1b42125aedecccc17fe7676f4e",
      "text": "Nyuwun sewu, asmanipun sinten?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6b16186fcded0f29f9e2c876a41186de988563dc73363cc1088c2a1b07db36",
      "text": "Mboten, Pak. Kula mlampah kemawon saking Pasar Gede.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0feee0470955c5136f17092ae2ff613f031005f07a4e86d62d34407ce8688a5",
      "text": "Inggih, Pak. Pasar Triwindu ing pundi?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4f6727f99134e1243f3f3becdb059b88692e8e85414de8386419867ce4969ba",
      "text": "Jam sanga, Mas. Sampeyan badhe dhateng pundi?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52f1908acd31d7ce8ffcd0732cbcdf97a999920e7780560416dea908aca3c01",
      "text": "Mohamed: Sugeng enjing, Pak. Panjenengan wonten ing pendhapa jam pinten?",
      "voice": "jv_siti",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b744fe7686d3139677993c1c60a32d7c55bf9a30e1b02b61e8c1b3e674bbaa",
      "text": "Reginipun pinten, Bu?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f07f39ea62a954f78a3089b324bc96bc47e4f80ccbbc1c0aec120d2652dc74",
      "text": "Pendhapa menika sae sanget, Mas. Sampeyan remen?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d81d6b323f00b9016e6ac066d01e282462bea42e95ee912cbf9e95ecbc476001",
      "text": "Nyuwun sewu, Mbah. Pasar Triwindu ing pundi, nggih?",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "de76b8755488730734bbad0dc2ded9bd3ced17ce9f25c64b2532a54268553177",
      "text": "Pripun kabaripun? — Sae, matur nuwun.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "df3f2dc71fe930fa318b91250612502402f1df4931b81f4284769bb0cd9ad708",
      "text": "Inggih, Pak. Remen sanget!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2beaeb72da886f8da5c73fb5b926d02ca2d4e7429fdba7a32a51e4a0cfb3ebe",
      "text": "Celak kemawon. Saking mriki lurus, lajeng nengen.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33ca55b1939d728d158786d153997b01ed81a66a5d5c0ea36828e71aa1ef8e5",
      "text": "Nyuwun sewu, Pak, jam pinten? — Jam sanga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e567830595b26cdbbf3f0f85a9139de6635ad312cec677171f7872a9edd988d8",
      "text": "Sugeng rawuh ing Pura Mangkunegaran.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e62f76ba29256faef660b2cd9ceb780b3935db387b004fd0c9541048c4760498",
      "text": "Nyuwun sewu, Pak Wiryo. Menika menapa?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7828dd70e8a02153b0475cc2091cc6000e3b001f3d0338104df087f18f92391",
      "text": "Menika sinten?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea89b4f0db2d89ced057016da303171bfe13eb730bc2db506b9c34a6322063aa",
      "text": "Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f059db686077d7a078829a55f70394d3298bd590b081eb4ef1544fe4c84e2493",
      "text": "Matur nuwun sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f07bc09392370ca25e9bbc7def91f75d22696c383a39b5621d6ba727465ed4f5",
      "text": "Saged mlampah, Mbah?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f105bc4d77384ce7e88fdd7506ecd01f135268ed7ab4a53555b98f139fc8ea3a",
      "text": "Sae sanget! Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4aeb086603e6815de73ffe774140fe9684e89d1402db26f444981f5933201e5",
      "text": "Kados pundi, Pak?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "f902f73339bf9ed626810cac0bc4e1307ae055b2557aae8d710664bc59bd025e",
      "text": "Matur nuwun sanget, Mbah.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa302c5053f6d41afca026f5f58c660d46b9b036137333deaeb3b030c4dc4ac5",
      "text": "basa Jawi",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc8568b5387ad90e124eca9fc091d836798927e39db783cac57d63524960102a",
      "text": "kados pundi",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "fccf055ff81927fae8890e001ac93a63d20cd3f091a343c25cd5316a0253d636",
      "text": "Pripun kabaripun?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcf231ea120fba92be793b558fad156406b7670301ebe0e8c4130d6f4b03bbd5",
      "text": "Kenging menapa panjenengan sinau basa Jawi?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
