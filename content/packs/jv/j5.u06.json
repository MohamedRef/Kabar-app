    },
    {
      "key": "dd8d2e06024a77f1886c8d4cf82dc15c21ee0a1bf217c281f24c6d31ea75d1ac",
      "text": "ambyar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "df74efedd99c730bbce5acd1ec339cc6dfd925f6fa7fb13af311e41807e00491",
      "text": "Rungokna, iki campursari. Critane wong sing ditinggal lunga.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd95c5609afd97a5a114c5a041237d9e6acc0f719c346c352f2df7747bb67ea",
      "text": "Hehe, aja kakehan sambat. Ayo njoged wae!",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e16a2047047daa2c7a5041260939eaa6602ee108ce8532f60e18287ba4880631",
      "text": "dilakoni",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2bd5489155e57fd8d2037327326408400e3c6329d4e23da4c78f7f901d38393",
      "text": "pesindhen",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46e5ef95e35c3efd95da6f222b9bfa681cc0b9f7e863a2effbc9ea55be9a72e",
      "text": "piwulang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4c9694caee97b8a56751d80fd5484d2c05b1fd4e5bb4ecbf2bfcf5551fc6bb3",
      "text": "Untung aku ora tau ketemu wong lamis.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5567a5a5bc9e674f70f27c7408cd637d7dd3f7470176bf49d7fb16d26545cbe",
      "text": "kangen",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56ad3345808c317f656b2e9387a3fbfdb44a1c8f291894f5ec84f7c04e9132a",
      "text": "tresna",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e63fe2718abd046a9fc1ebab7ec70a64ed4efdd904cee76903406e181e2b7ddc",
      "text": "Sluku-sluku bathok, bathoke ela-elo.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6e8034fb1b66a982c6fa33a41a7ff8de862e0be72bf5aca4f63c367aef05168",
      "text": "Saiki aku mung bisa kangen, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7e289796146c39ce106d46c4cd30955b9285ea59fc0c17c7b4f5e83bb8359dd",
      "text": "deres",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec9a708e103e1230ea9e0f1611bf8c6602299ffc2c787d449ba6c4075ff7269c",
      "text": "Nalika kekasihe lunga, atine ambyar?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "edd5649549a9c1b729707b0b6a3be4ec379da45a706815517e77b0c2d4d48778",
      "text": "amanah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee212b4bcf74c29dda8b4a329374e9a8c560df6ca98307063461fc25646dcad8",
      "text": "Piwulangipun sae sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0e370ec3a443c037e539877aca21e6afb88ae781055e44b72426b4c03416f60",
      "text": "Ora bisa turu, ora gelem mangan: dheweke lagi ___.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1631ec8c390d876d68fbb6d3108f853aeb23f3512259bbdad8960a863ee419e",
      "text": "Sukur, aku oleh undangan.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a009e542242454e7cff5a4d83247aba54f04293c68b0ef8a9fe2929e364a57",
      "text": "Mohamed, tegese Lir-ilir apa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1c2f87ca7a73b1ad2327176265128bc6b36140c8e4209798fb143c9fe27f063",
      "text": "Critane cah angon sing dikon menek blimbing.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f20f41c69783f0fa4d3dc9d5805a0e8751cf89caab0ab711cfb1aa8d5f33fd46",
      "text": "Ngelmu iku kalakone kanthi laku. Ngelmu menika ilmu, saking basa Arab, nggih?",
      "voice": "jv_dimas",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9054e64838160f5bf99aed5a439ab6d68ffb66a7ab343345e37d122653103c8",
      "text": "wakul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f99fbb7caf750f094570f7fbdf0c5e9e2ca8fcabbc91fdf1693a6e7261e7918f",
      "text": "Tembang Lir-ilir",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9c3bae7d3dd8cd3e30774b27ffa812df3c4f2f275886d094f0345d4c8fbb985",
      "text": "medeni",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa768f18a3f5b2672bbbe250ef17e07080208bb8c197fab4dab70e23e98ce976",
      "text": "Omongane lamis, banjur cidra janji.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc7eb69a208fbe1b21d3874420ad247cb66ba14d1b0b579926629cdc470474e6",
      "text": "gandrung",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcfc510b1fd97323a47cb1f814201945f406ba7f6ec00bd4d8cb2d657779904e",
      "text": "Lir-ilir iku tembang kang misuwur ing Jawa.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd0ff62145d85eb96d837ee4e0da5a9be58cf4d1d660959675a43c173bc929dc",
      "text": "Mohamed, aku duwe undangan loro kanggo pentas campursari.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7370f7b40bcb72da3e8bf16365130f5e161ebd8573d92551f5f5092972dc3f",
      "text": "Miturut crita, Sunan Kalijaga, salah siji wali ing Jawa.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff94b557cfad7f0c8ff9751d0a21ddffe34c8ad73624f95ced7aa92e18ca5653",
      "text": "tembang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    }
