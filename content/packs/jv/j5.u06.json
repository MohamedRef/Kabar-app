  "version": 2,
  "content_hash": "06919bf5cbea68ad6c7d309ac33091ab2f426770ce4f1aa975c063d3ccc340a5",
  "lessons": [
    {
      "id": "j5.u06.l01",
      "sha256": "40bc187a7f245fbb022c1ec1ef3c55728d6eec9590741673ab63d4c3953aa83e"
    },
    {
      "id": "j5.u06.l02",
      "sha256": "e1e97e008870275f9b38bb560e1c22e4f8c3013b4f619d16229a928b5d55e6dd"
    },
    {
      "id": "j5.u06.l03",
      "sha256": "3af2683fb7e55366652555b9913faf7e4f5f376c7bccd796878028620ab664d2"
    },
    {
      "id": "j5.u06.l04",
      "sha256": "db181fc4e72e976f07b6841c6f9520fe92049f2beee36e57fd4ac0ed2b3775e6"
    },
    {
      "id": "j5.u06.l05",
      "sha256": "f8ced2005d8a610097871ef59c183778d2cb6b8527e11a0408f8d60955c5a1f3"
    }
  ],
  "audio": [
    {
      "key": "0094fd3a28a0f0d09eb3532669029e041a6a05cb2a9b077c4b020b7b119278fa",
      "text": "Piwulange, ngelmu kudu dilakoni.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "014db276919e3ab47e9cff284681bcf5aca7b6d23a361928799acf5ed5798ebb",
      "text": "Pungkasane, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0874bae432a59d96243d96f1ef0e347b13bdace8f267f219729879019b048e35",
      "text": "Lan piwulange?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "124e4ed3a3eb640b66ac1058d9849db4375d15410e557e0bd5d8606879a7a62b",
      "text": "Wus menika wis, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "26033279701aaab6f538f28510fdc7f50c62a1708294aeb2e583bd4cf3a70fe3",
      "text": "Aku kangen kowe.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "261fd7d89aff224d34bfb9c52d49397b0c7399f7338dd4ebce88ff69f5914671",
      "text": "tegese",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "281540c454edd874b9bd3dc885c40dff45116badeb035635733f8cdb506cd613",
      "text": "Mas, sampeyan ngerti tembang Lir-ilir?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a943ddf2a58702af3172e66b36c78332ba03b31045e848c4244572dc3baf76b",
      "text": "Mas, iki tembang Pocung saka Serat Wulangreh.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f9fcf9fa37436ac8817480431961f621c72a95679f7f50b7367732aa0c8d6a2",
      "text": "Iya. Nganti saiki tembang iku isih ditembangake.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c1377837e45bdaf477ad9ed466782fffb6675d89f5b94238c67d4329d22719",
      "text": "Tembang macapat ana sewelas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "393f8c680a3384d4869e58e324b8869232f06629d772197ba41c0f4d09b6dad9",
      "text": "ngelmu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aadd25072b2b65e2df1396de05452745f1c5ec86be604923a02a754dfb9151f",
      "text": "Tegese, atine ambyar merga kekasihe lunga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ec198725cb6df5bc80788a88bf9a1f90930c998a98adc23ee7deb3bfb683035",
      "text": "Wah, kowe wis bisa nerangake tembang!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "47a0535abc9c6f0a7f98301ce91c005bec9263f7016e0bcbd43369f4799f8df2",
      "text": "Blimbing iku duwe limang sisi, kaya salat limang wektu. Nanging iku tafsiran.",
      "voice": "jv_dimas",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "48c70e033fad991066ed0aa4692a01503322bf8a4c58e91e822b0ff53b9c70da",
      "text": "Sakmenika kula saged maos tembang, cerkak, lan warta basa Jawi.",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5007a7adb895dbfefb04ef614c4f25ee28f0e612888dd2b3339d32a1e1caef97",
      "text": "janji",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "52818f7522ebbf1e813ad43c0679aa14ebafe562d02485724eef29c53d30583c",
      "text": "Aku tresna marang kowe.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "550ab93a07da965766f4e58a440d13a89fae333c1a2f8bf5225dfbb2ea40c421",
      "text": "Pocung iku tembang macapat kang cekak.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a99f148ba7cde3ab0d99b74bc466ef940b098017026dc969905af7474d5cef",
      "text": "tandur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c06cf5693f8a31d2d9936c6a613f4131aa55b9c30843fabb14c26f3a1dc81ab",
      "text": "Cah angon, cah angon, penekna blimbing kuwi.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "667c7fe3a8f162ff572855c8320114ac1d103fb3d415d71c40c882ea4842696c",
      "text": "laku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccfd7612fdd4e6d6dee53b1cd72076bd01f64a760acbeac76794b16dc46999a",
      "text": "Inggih, Pak. Lir-ilir, lir-ilir, tandure wus sumilir.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "7117e12234d145a3bd85a6a797ac83a1d807f9217af444677506b5547b3014e6",
      "text": "Tak ijo royo-royo, tak sengguh temanten anyar.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c81903aade6d9ecd69cebd20f5b2a4ce08a768bbb6b921098558cd50b8f0f56",
      "text": "Ngelmu iku kalakone kanthi laku.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7efb588542f6a11f23ca2f2d9051ba60eea63ea12904adaaf778f0e3a8d6ac10",
      "text": "Biyen kowe janji ora bakal lunga, nanging pungkasane kowe lunga.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "872f4b37f9ae34c3f80c2bd5964caf4dca44b596868659af5770f1fe7e4ca6b2",
      "text": "macapat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "90e678e605c04210b5fbd2561be75557b955c3ff0890e861cb61891cb85197c6",
      "text": "Nalika kowe lunga, atiku lara.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "920623c4d9d182c30b02e729434745e378a5240e68b26c7a8d7cd0ef8b313a50",
      "text": "Kados paribasan Arab, Pak. Ilmu tanpa amal kados wit tanpa woh.",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "98293c60980b270780c8e0b694ef69132647cbc6e7fe8057bfb0ca771d7100ee",
      "text": "Lekase lawan kas.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2f05db2ad66a88a53f51e5e83fce0282363c8f74f89a6a5af9c514ac4cd9f59",
      "text": "kanthi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a630a328b6bfc6bff5a608fc11ed7e6ef393e65226e174e7d0f8378c5849197e",
      "text": "wus",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c2f264d2bdaed7b682670a54a7cb2f2aabf68bde2fb81d048ee46bc812388c",
      "text": "Critane wong sing ditinggal lunga, atine ambyar.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "adae5574263b77472ff7258949d742846f9d4ca73c30162f727adc96627cc3d8",
      "text": "Kados Lir-ilir, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b039f66cbde9215b172659ecd16d9c3a7173014e5e696d0bc470b46cf6509272",
      "text": "Sedhih, nanging apik banget.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b13d718d08877c214670c0d79c1106de754bf24bb5c7e9b3b747108bb4ab0e76",
      "text": "Critane cah angon sing dikon menek blimbing.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2e5613d6a2e9102f8146280443053e7b550c4e842276feb7d8af94c5debfebc",
      "text": "Bener. Ngelmu ora cukup diwaca, kudu dilakoni.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6eb54cf05404069f6427a7f0057cce93a8f357f86c1bbecfd3bfc13482b93cd",
      "text": "Lir-ilir, lir-ilir, tandure wus sumilir.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9a9c787d12cd19c3720aadc3292f8ac8080eeada93d6584e21c1200f3e926f4",
      "text": "blimbing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c47ba80c29e7ae380c5925ad01f933d27410965ceaf66e16cb0e071bf91f525f",
      "text": "Bener! Akeh tembang campursari critane kaya ngono.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55a56a0a027218ddf940a663e40ddc5cde9882492d51286f25f2667ec49ffb7",
      "text": "cah angon",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c72cb10e1aaed47441f5edb04ee81803119cdaa3288d993d0ced24c640de85f1",
      "text": "ati",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7a475ef78c8d5e3e52f99065106a69e8db008109189fb9f6aa58f762a154fa2",
      "text": "Nalika kowe lunga, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f8b01d04d5662a7dc3fcf3276bb2464bc8a8ac51e529d7c0875f269e697daf",
      "text": "ijo",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1697d887524549bb1a6ecc2dd1c42d83cff61b5f6999f8020fac89b9dbdf10c",
      "text": "Tegese tembang iki, ngelmu iku kalakone kanthi laku.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d9fb93855fba991d639e6d9a06e2e51e0483af1de3493b4156148b91b333f4",
      "text": "Mas, Wali Sanga mulang Islam nganggo tembang.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "db7412dda99ecf771a4f1e97730a8918dce4da2796a6d8ec0edffeca566c3d40",
      "text": "Alhamdulillah. Sugeng tindak, Mas!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd8d2e06024a77f1886c8d4cf82dc15c21ee0a1bf217c281f24c6d31ea75d1ac",
      "text": "ambyar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "df74efedd99c730bbce5acd1ec339cc6dfd925f6fa7fb13af311e41807e00491",
      "text": "Rungokna, iki campursari. Critane wong sing ditinggal lunga.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e056795a45450580897c7d98a5927e572f0a3019400b9b4216a1494d6d0d813b",
      "text": "Wah, pinter! Miturut crita, tembang iki kaanggit dening Sunan Kalijaga.",
      "voice": "jv_dimas",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3ada41b103b9a8278395adfff92a330d525c54145f3aa8bc6892b7264bfeaa6",
      "text": "Miturut crita, tembang Lir-ilir kaanggit dening Sunan Kalijaga.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46e5ef95e35c3efd95da6f222b9bfa681cc0b9f7e863a2effbc9ea55be9a72e",
      "text": "piwulang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5567a5a5bc9e674f70f27c7408cd637d7dd3f7470176bf49d7fb16d26545cbe",
      "text": "kangen",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56ad3345808c317f656b2e9387a3fbfdb44a1c8f291894f5ec84f7c04e9132a",
      "text": "tresna",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec9a708e103e1230ea9e0f1611bf8c6602299ffc2c787d449ba6c4075ff7269c",
      "text": "Nalika kekasihe lunga, atine ambyar?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a009e542242454e7cff5a4d83247aba54f04293c68b0ef8a9fe2929e364a57",
      "text": "Mohamed, tegese Lir-ilir apa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1c2f87ca7a73b1ad2327176265128bc6b36140c8e4209798fb143c9fe27f063",
      "text": "Critane cah angon sing dikon menek blimbing.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f20f41c69783f0fa4d3dc9d5805a0e8751cf89caab0ab711cfb1aa8d5f33fd46",
      "text": "Ngelmu iku kalakone kanthi laku. Ngelmu menika ilmu, saking basa Arab, nggih?",
      "voice": "jv_dimas",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "f99fbb7caf750f094570f7fbdf0c5e9e2ca8fcabbc91fdf1693a6e7261e7918f",
      "text": "Tembang Lir-ilir",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcfc510b1fd97323a47cb1f814201945f406ba7f6ec00bd4d8cb2d657779904e",
      "text": "Lir-ilir iku tembang kang misuwur ing Jawa.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff94b557cfad7f0c8ff9751d0a21ddffe34c8ad73624f95ced7aa92e18ca5653",
      "text": "tembang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    }
  ],
