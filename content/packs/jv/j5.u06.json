{
  "format": 1,
  "id": "jv/j5.u06",
  "language": "jv",
  "unit": "j5.u06",
  "version": 4,
  "content_hash": "6bc2f8159dc963b8470e96085a47ff3fcc1a2db9472af2f17e3cadac0185beb1",
  "lessons": [
    {
      "id": "j5.u06.l01",
      "sha256": "40bc187a7f245fbb022c1ec1ef3c55728d6eec9590741673ab63d4c3953aa83e"
    },
    {
      "id": "j5.u06.l02",
      "sha256": "e1e97e008870275f9b38bb560e1c22e4f8c3013b4f619d16229a928b5d55e6dd"
    },
    {
      "id": "j5.u06.l03",
      "sha256": "3af2683fb7e55366652555b9913faf7e4f5f376c7bccd796878028620ab664d2"
    },
    {
      "id": "j5.u06.l04",
      "sha256": "db181fc4e72e976f07b6841c6f9520fe92049f2beee36e57fd4ac0ed2b3775e6"
    },
    {
      "id": "j5.u06.l05",
      "sha256": "3b28600d0c989875a8eed96efebf02eb3033383d52ca144d2351f09ef1f9d820"
    },
    {
      "id": "j5.u06.l06",
      "sha256": "614f2eb919d8befe599765a0a9ab5b00a0f416f85c949fc26a7479b1bdf4c237"
    },
    {
      "id": "j5.u06.l07",
      "sha256": "ad6f3a3a6b744ec9d41dd14900bb0bcd312733842bbdc0b9bd715f61b1409b3c"
    },
    {
      "id": "j5.u06.l08",
      "sha256": "41eccc469e9870ee82cbb61690d6bc792760f28cf455516570fddad23df033e7"
    },
    {
      "id": "j5.u06.l09",
      "sha256": "e10a8a240cf1d7e0c3965a9930b43b77c21f808f34600fadae298c32f8fa1a52"
    }
  ],
  "audio": [
    {
      "key": "0094fd3a28a0f0d09eb3532669029e041a6a05cb2a9b077c4b020b7b119278fa",
      "text": "Piwulange, ngelmu kudu dilakoni.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "014db276919e3ab47e9cff284681bcf5aca7b6d23a361928799acf5ed5798ebb",
      "text": "Pungkasane, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "02b349843bdc0b7ed3debc3c0a1f98875e588916871886d67f656669fa0fcf77",
      "text": "Gundul-gundul pacul-cul, gembelengan.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "042904ffe1cc708a9780dcf743735c7429fef9d228dfc6a4c2c84570640b8479",
      "text": "Waduh, ambyar maneh!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0874bae432a59d96243d96f1ef0e347b13bdace8f267f219729879019b048e35",
      "text": "Lan piwulange?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1150e7ddd49a7ee1578505ddee283f7a4790187518545bf63b12a469625fbcbc",
      "text": "Biyen kowe janji ora bakal lunga.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "124e4ed3a3eb640b66ac1058d9849db4375d15410e557e0bd5d8606879a7a62b",
      "text": "Wus menika wis, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "17b7bbc1eb53ee528fffa0d39faa72c0c934277c797b6eb4550da670adef79a6",
      "text": "Lunyu-lunyu ya penekna, kanggo mbasuh dodotira.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2028fad3c99c153cb671c3e732603c8914fd80e885c6960d402f11f988d1d386",
      "text": "Mohamed, iki tembang campursari anyarku, \"Udan ing Demak\".",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b20c51d2b3d7cb815bda02456c65f7f3e8887699a81805c4f16e8fa5437805",
      "text": "Wakul ngglimpang, segane dadi sak latar.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "26033279701aaab6f538f28510fdc7f50c62a1708294aeb2e583bd4cf3a70fe3",
      "text": "Aku kangen kowe.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "261fd7d89aff224d34bfb9c52d49397b0c7399f7338dd4ebce88ff69f5914671",
      "text": "tegese",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "26871008ca2674e9e7fab8fab98873fc7a536e47a0cf759b180f2c11d01118e3",
      "text": "Dondomana, jlumatana, kanggo seba mengko sore.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "281540c454edd874b9bd3dc885c40dff45116badeb035635733f8cdb506cd613",
      "text": "Mas, sampeyan ngerti tembang Lir-ilir?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "28be5c9e040f7561be5f74f5072d3807a38e15b7de8ae3ab565e0646f47fe9f4",
      "text": "bathok",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a943ddf2a58702af3172e66b36c78332ba03b31045e848c4244572dc3baf76b",
      "text": "Mas, iki tembang Pocung saka Serat Wulangreh.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f9fcf9fa37436ac8817480431961f621c72a95679f7f50b7367732aa0c8d6a2",
      "text": "Iya. Nganti saiki tembang iku isih ditembangake.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "30f0edbc091f3eb2312ce7051dd95bdb51d16444038f01df2e5cdff4c3b7ae8d",
      "text": "Miturut tafsiran, ela-elo saka \"la ilaha illallah\".",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f94d4d77b6daa5f8591d4a740570ff5e072a9a41212f7eeefaa2f0cfb1faf7",
      "text": "nyunggi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c1377837e45bdaf477ad9ed466782fffb6675d89f5b94238c67d4329d22719",
      "text": "Tembang macapat ana sewelas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "393f8c680a3384d4869e58e324b8869232f06629d772197ba41c0f4d09b6dad9",
      "text": "ngelmu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aadd25072b2b65e2df1396de05452745f1c5ec86be604923a02a754dfb9151f",
      "text": "Tegese, atine ambyar merga kekasihe lunga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ec198725cb6df5bc80788a88bf9a1f90930c998a98adc23ee7deb3bfb683035",
      "text": "Wah, kowe wis bisa nerangake tembang!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "47a0535abc9c6f0a7f98301ce91c005bec9263f7016e0bcbd43369f4799f8df2",
      "text": "Blimbing iku duwe limang sisi, kaya salat limang wektu. Nanging iku tafsiran.",
      "voice": "jv_dimas",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "48c70e033fad991066ed0aa4692a01503322bf8a4c58e91e822b0ff53b9c70da",
      "text": "Sakmenika kula saged maos tembang, cerkak, lan warta basa Jawi.",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a4328e58b10dd651de513e4c91b8a42366e8979bab27560bd44820bfd87fc5b",
      "text": "Biyen kekasihe janji ora bakal lunga. Nanging dheweke lunga tanpa pamit.",
      "voice": "jv_dimas",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d37b8358292d7584561a7db5562c311181c03b70b3c25729548318d59462956",
      "text": "urip",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5007a7adb895dbfefb04ef614c4f25ee28f0e612888dd2b3339d32a1e1caef97",
      "text": "janji",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "52818f7522ebbf1e813ad43c0679aa14ebafe562d02485724eef29c53d30583c",
      "text": "Aku tresna marang kowe.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "550ab93a07da965766f4e58a440d13a89fae333c1a2f8bf5225dfbb2ea40c421",
      "text": "Pocung iku tembang macapat kang cekak.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a99f148ba7cde3ab0d99b74bc466ef940b098017026dc969905af7474d5cef",
      "text": "tandur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5807c246e02235be5d122a532024c1ebba55922539a1fab80c4e2f918410b711",
      "text": "Sirahe obah ngiwa nengen.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a2ade57472fe7a2220df463e852bcce6fd513a587c6dd5fbea91550be66cfb2",
      "text": "lunyu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c06cf5693f8a31d2d9936c6a613f4131aa55b9c30843fabb14c26f3a1dc81ab",
      "text": "Cah angon, cah angon, penekna blimbing kuwi.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "667c7fe3a8f162ff572855c8320114ac1d103fb3d415d71c40c882ea4842696c",
      "text": "laku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccfd7612fdd4e6d6dee53b1cd72076bd01f64a760acbeac76794b16dc46999a",
      "text": "Inggih, Pak. Lir-ilir, lir-ilir, tandure wus sumilir.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "7117e12234d145a3bd85a6a797ac83a1d807f9217af444677506b5547b3014e6",
      "text": "Tak ijo royo-royo, tak sengguh temanten anyar.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "727799c62b1622009ec2b6e9f4f82906249a64d0657ca08b1502dfc38d0ab933",
      "text": "Mas, bocah-bocah ing Demak isih nembang Gundul-gundul pacul.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "762915937ef9d2f3e72e1a94ef183f9aa2cd9aabc09add452de469979b8d3523",
      "text": "Nyunggi-nyunggi wakul-kul, gembelengan.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7639f86afd850ea7e8d488f769a4a49a652241cb8adb7a393f189d082697a890",
      "text": "Tegesipun menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c81903aade6d9ecd69cebd20f5b2a4ce08a768bbb6b921098558cd50b8f0f56",
      "text": "Ngelmu iku kalakone kanthi laku.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7efb588542f6a11f23ca2f2d9051ba60eea63ea12904adaaf778f0e3a8d6ac10",
      "text": "Biyen kowe janji ora bakal lunga, nanging pungkasane kowe lunga.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "8295d3351bd17eba2cc97573803a75d551595348aec850b199121fc3ed5d240b",
      "text": "Wong mati ora obah, yen obah medeni bocah.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "83bc3996db3ff94c49e01c21ddd5155f8829851f7648ff5d205e41e2d20c2415",
      "text": "Dodotira, dodotira, kumitir bedhah ing pinggir.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ca2ad6d831b36c676430ec930ed5a72add40e6eb7c053eff2eebc43d5ea3be",
      "text": "Hehe, tembang campursari akeh sing ambyar.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "872f4b37f9ae34c3f80c2bd5964caf4dca44b596868659af5770f1fe7e4ca6b2",
      "text": "macapat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ff2c5b7b882d0be2e925ab8ae7824d0b8757061c473b23a8c71731dfe6aefa",
      "text": "Critane piye, Mas?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab8db94a356d89e2a17b0eee8e7d1a2bc92f2fdacdd85620b0ae672ab50607b",
      "text": "Masya Allah. Lan \"yen urip goleka dhuwit\"?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cc4c24ca77f02b939941a3525d9b7fd789bf0d7c5c8888c6f72c344b329489f",
      "text": "dondomana",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "90e678e605c04210b5fbd2561be75557b955c3ff0890e861cb61891cb85197c6",
      "text": "Nalika kowe lunga, atiku lara.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "920623c4d9d182c30b02e729434745e378a5240e68b26c7a8d7cd0ef8b313a50",
      "text": "Kados paribasan Arab, Pak. Ilmu tanpa amal kados wit tanpa woh.",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "950faa7d751356f8ba5ef95d91d2c1481ffffdfd8f470e8d9c1bb8ed6fb4610e",
      "text": "Miturut tafsiran, wakul iku amanah rakyat.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "95e59544ff13f42fd213dc79a10819f4cda73c5c7b80b9e669c8896eb22d9e45",
      "text": "Lajeng, tegesipun lirik menika menapa?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "98293c60980b270780c8e0b694ef69132647cbc6e7fe8057bfb0ca771d7100ee",
      "text": "Lekase lawan kas.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c9f8b289d503fe575df7e3cdf35c82aae7ee719c519a3ebe658cc5cb9f9309c",
      "text": "Miturut tafsiran, dodot iku iman. Yen bedhah, kudu didondomi.",
      "voice": "jv_dimas",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e59d630c9f7878ac37969627e21725d7c1d96a4fcedda1007c1ac865ab7f887",
      "text": "Bener. Yen pemimpin gembelengan, wakule ngglimpang.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e84f834c0872776f4a9595ad197b93da22fe93d520ed426233c972d639c5d59",
      "text": "dodot",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a27b0c94365cd0098c717ccc141e0da3c7e666dc62ea1ad0141cfd7679dc0e6b",
      "text": "Dodot iku klambi Jawa jaman biyen, Mas.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2f05db2ad66a88a53f51e5e83fce0282363c8f74f89a6a5af9c514ac4cd9f59",
      "text": "kanthi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f795c02cba974d1a8bdbcc58529d5401cffde110d1ee7cdf0dffa5a8104252",
      "text": "Yen urip goleka dhuwit.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a630a328b6bfc6bff5a608fc11ed7e6ef393e65226e174e7d0f8378c5849197e",
      "text": "wus",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c2f264d2bdaed7b682670a54a7cb2f2aabf68bde2fb81d048ee46bc812388c",
      "text": "Critane wong sing ditinggal lunga, atine ambyar.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa6f2791c157a203b5a9cbe4e42d8a8a40930ac793a8c36f15337ff919b6f47e",
      "text": "Tegese, yen isih urip, kudu nyambut gawe.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad530c4b85a8f40ef2ab61b40456098d0916c9bb37afdd49aafe65190a04553f",
      "text": "Pak, \"ela-elo\" menika menapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad7363121ab9dbec917a5695d1cfd5f7739fb0d0c30f76f578f6ae21220c973d",
      "text": "mbasuh",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "adae5574263b77472ff7258949d742846f9d4ca73c30162f727adc96627cc3d8",
      "text": "Kados Lir-ilir, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b039f66cbde9215b172659ecd16d9c3a7173014e5e696d0bc470b46cf6509272",
      "text": "Sedhih, nanging apik banget.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b13d718d08877c214670c0d79c1106de754bf24bb5c7e9b3b747108bb4ab0e76",
      "text": "Critane cah angon sing dikon menek blimbing.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2e5613d6a2e9102f8146280443053e7b550c4e842276feb7d8af94c5debfebc",
      "text": "Bener. Ngelmu ora cukup diwaca, kudu dilakoni.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6eb54cf05404069f6427a7f0057cce93a8f357f86c1bbecfd3bfc13482b93cd",
      "text": "Lir-ilir, lir-ilir, tandure wus sumilir.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9a9c787d12cd19c3720aadc3292f8ac8080eeada93d6584e21c1200f3e926f4",
      "text": "blimbing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb1a92c9d46ea32f3908d8ec871e0d2fff4e72da1eab33408416cb198277b1f9",
      "text": "Nanging nalika udan ing Demak, kowe lunga tanpa pamit.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2a7f8cc02b56bbc7fc37a24c26556eb1d5b579d8d02fb508c16c470c3600126",
      "text": "Pak, dodot menika menapa?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c47ba80c29e7ae380c5925ad01f933d27410965ceaf66e16cb0e071bf91f525f",
      "text": "Bener! Akeh tembang campursari critane kaya ngono.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55a56a0a027218ddf940a663e40ddc5cde9882492d51286f25f2667ec49ffb7",
      "text": "cah angon",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c72cb10e1aaed47441f5edb04ee81803119cdaa3288d993d0ced24c640de85f1",
      "text": "ati",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7a475ef78c8d5e3e52f99065106a69e8db008109189fb9f6aa58f762a154fa2",
      "text": "Nalika kowe lunga, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f8b01d04d5662a7dc3fcf3276bb2464bc8a8ac51e529d7c0875f269e697daf",
      "text": "ijo",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce794d6cf314d71c71dd951d454be08c760a1b4c3aa7ec4d8904f89ebd32e5e1",
      "text": "bedhah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfd0683ce58a6746b43d16254298d71316aec75d6b15786d3071c913be6c7bb7",
      "text": "ngglimpang",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1697d887524549bb1a6ecc2dd1c42d83cff61b5f6999f8020fac89b9dbdf10c",
      "text": "Tegese tembang iki, ngelmu iku kalakone kanthi laku.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d9fb93855fba991d639e6d9a06e2e51e0483af1de3493b4156148b91b333f4",
      "text": "Mas, Wali Sanga mulang Islam nganggo tembang.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59ddb7e1a2fcfe56eaef0e23301cbd8994cc1b77fe0dd7652f68e4ca266584c",
      "text": "Amanah, saking basa Arab, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "db7412dda99ecf771a4f1e97730a8918dce4da2796a6d8ec0edffeca566c3d40",
      "text": "Alhamdulillah. Sugeng tindak, Mas!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "db86e7151e0da57066ac2c65dcef3b700723f31e55bbd4ce526f47f7d1a62759",
      "text": "obah",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc92c1fdb8b129570cbc6ed7f785e99d9326b35a74b7dc39fc4bd4c74611fcdb",
      "text": "gembelengan",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd8d2e06024a77f1886c8d4cf82dc15c21ee0a1bf217c281f24c6d31ea75d1ac",
      "text": "ambyar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "df74efedd99c730bbce5acd1ec339cc6dfd925f6fa7fb13af311e41807e00491",
      "text": "Rungokna, iki campursari. Critane wong sing ditinggal lunga.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e056795a45450580897c7d98a5927e572f0a3019400b9b4216a1494d6d0d813b",
      "text": "Wah, pinter! Miturut crita, tembang iki kaanggit dening Sunan Kalijaga.",
      "voice": "jv_dimas",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3ada41b103b9a8278395adfff92a330d525c54145f3aa8bc6892b7264bfeaa6",
      "text": "Miturut crita, tembang Lir-ilir kaanggit dening Sunan Kalijaga.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46e5ef95e35c3efd95da6f222b9bfa681cc0b9f7e863a2effbc9ea55be9a72e",
      "text": "piwulang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5567a5a5bc9e674f70f27c7408cd637d7dd3f7470176bf49d7fb16d26545cbe",
      "text": "kangen",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56ad3345808c317f656b2e9387a3fbfdb44a1c8f291894f5ec84f7c04e9132a",
      "text": "tresna",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e63fe2718abd046a9fc1ebab7ec70a64ed4efdd904cee76903406e181e2b7ddc",
      "text": "Sluku-sluku bathok, bathoke ela-elo.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6e8034fb1b66a982c6fa33a41a7ff8de862e0be72bf5aca4f63c367aef05168",
      "text": "Saiki aku mung bisa kangen, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec9a708e103e1230ea9e0f1611bf8c6602299ffc2c787d449ba6c4075ff7269c",
      "text": "Nalika kekasihe lunga, atine ambyar?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "edd5649549a9c1b729707b0b6a3be4ec379da45a706815517e77b0c2d4d48778",
      "text": "amanah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee212b4bcf74c29dda8b4a329374e9a8c560df6ca98307063461fc25646dcad8",
      "text": "Piwulangipun sae sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a009e542242454e7cff5a4d83247aba54f04293c68b0ef8a9fe2929e364a57",
      "text": "Mohamed, tegese Lir-ilir apa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1c2f87ca7a73b1ad2327176265128bc6b36140c8e4209798fb143c9fe27f063",
      "text": "Critane cah angon sing dikon menek blimbing.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f20f41c69783f0fa4d3dc9d5805a0e8751cf89caab0ab711cfb1aa8d5f33fd46",
      "text": "Ngelmu iku kalakone kanthi laku. Ngelmu menika ilmu, saking basa Arab, nggih?",
      "voice": "jv_dimas",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9054e64838160f5bf99aed5a439ab6d68ffb66a7ab343345e37d122653103c8",
      "text": "wakul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f99fbb7caf750f094570f7fbdf0c5e9e2ca8fcabbc91fdf1693a6e7261e7918f",
      "text": "Tembang Lir-ilir",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9c3bae7d3dd8cd3e30774b27ffa812df3c4f2f275886d094f0345d4c8fbb985",
