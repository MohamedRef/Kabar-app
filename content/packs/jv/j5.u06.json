      "key": "fcfc510b1fd97323a47cb1f814201945f406ba7f6ec00bd4d8cb2d657779904e",
      "text": "Lir-ilir iku tembang kang misuwur ing Jawa.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff94b557cfad7f0c8ff9751d0a21ddffe34c8ad73624f95ced7aa92e18ca5653",
