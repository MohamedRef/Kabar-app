    },
    {
      "id": "j5.u06.l12",
      "sha256": "e0c6bf86da998f76f043a935f3987f643065a0d2f31b8415f79bbb0ddf482ec7"
    }
  ],
  "audio": [
    {
      "key": "0012faa670735412f8d9976d255f2a6766136a9531bac7e56c84bda36155e7d4",
      "text": "eluh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0094fd3a28a0f0d09eb3532669029e041a6a05cb2a9b077c4b020b7b119278fa",
      "text": "Piwulange, ngelmu kudu dilakoni.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "014db276919e3ab47e9cff284681bcf5aca7b6d23a361928799acf5ed5798ebb",
      "text": "Pungkasane, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "02b349843bdc0b7ed3debc3c0a1f98875e588916871886d67f656669fa0fcf77",
      "text": "Gundul-gundul pacul-cul, gembelengan.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "042904ffe1cc708a9780dcf743735c7429fef9d228dfc6a4c2c84570640b8479",
      "text": "Waduh, ambyar maneh!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "05bb9369cff58c28500182e849d509769e4b2afa4675fb8d37038d194cda8246",
      "text": "Bener, lho. Yen pemimpin gembelengan, wakule ngglimpang.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "065a8af199235aeba77cf8b668741504fa562ba94b23b21d9934613ec6a42da4",
      "text": "Mohamed, kowe ngerti sapa sing nggawe Lir-ilir?",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "07f0a916e0a8528b0cfa9d1ad69467c922a4700ce7105955360a5fbcfecc0e26",
      "text": "Swasanane beda banget karo campursari sing sedhih kae.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0874bae432a59d96243d96f1ef0e347b13bdace8f267f219729879019b048e35",
      "text": "Lan piwulange?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "09003eade8bb86f9dc5fc7c3bb02112f0c4f80926f21618dfe8c8cf544108c33",
      "text": "Udane ___, aku nggawa payung.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1150e7ddd49a7ee1578505ddee283f7a4790187518545bf63b12a469625fbcbc",
      "text": "Biyen kowe janji ora bakal lunga.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "124e4ed3a3eb640b66ac1058d9849db4375d15410e557e0bd5d8606879a7a62b",
      "text": "Wus menika wis, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "17b7bbc1eb53ee528fffa0d39faa72c0c934277c797b6eb4550da670adef79a6",
      "text": "Lunyu-lunyu ya penekna, kanggo mbasuh dodotira.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "18eac564073d78b477ffc6896e480e9933de5c28586db161609419bb46bbc796",
      "text": "lelagon",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "19a44dd5637ea57cd9bd69266ee88e40371e26082f5ed5aecde99239dd34177a",
      "text": "Sunan Kalijaga iku sawijining ___.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2028fad3c99c153cb671c3e732603c8914fd80e885c6960d402f11f988d1d386",
      "text": "Mohamed, iki tembang campursari anyarku, \"Udan ing Demak\".",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "217be69e2ec0c185004daf800ede18ccf97f2f57d62289d3456c1f327045cd10",
      "text": "cidra",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "21bb0160b786a3c4258645a9170bc805eda5bc921b2eae23ee5810039af23567",
      "text": "Sanadyan atine ajur, dheweke lila.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b20c51d2b3d7cb815bda02456c65f7f3e8887699a81805c4f16e8fa5437805",
      "text": "Wakul ngglimpang, segane dadi sak latar.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "26033279701aaab6f538f28510fdc7f50c62a1708294aeb2e583bd4cf3a70fe3",
      "text": "Aku kangen kowe.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "261fd7d89aff224d34bfb9c52d49397b0c7399f7338dd4ebce88ff69f5914671",
      "text": "tegese",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "26871008ca2674e9e7fab8fab98873fc7a536e47a0cf759b180f2c11d01118e3",
      "text": "Dondomana, jlumatana, kanggo seba mengko sore.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "26e335417a1f112b61715d9ae1a1628d474ab7cd75e752fc55704771fb6a1d1b",
      "text": "Lho, kowe wis bisa nerangake tembang!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "27c2a0eaab3344afbb9180a9d9ea960c3aec0df4d2ea66a2c3a081ae9305b8f9",
      "text": "Aku seneng krungu pesindhen nembang.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "281540c454edd874b9bd3dc885c40dff45116badeb035635733f8cdb506cd613",
      "text": "Mas, sampeyan ngerti tembang Lir-ilir?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "28be5c9e040f7561be5f74f5072d3807a38e15b7de8ae3ab565e0646f47fe9f4",
      "text": "bathok",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a943ddf2a58702af3172e66b36c78332ba03b31045e848c4244572dc3baf76b",
      "text": "Mas, iki tembang Pocung saka Serat Wulangreh.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d4b49635656bc3cea37be8b126a2831104f4c144e4ad306be8bd22cb8afc985",
      "text": "sak",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "30235aceae7998d769438e96334b26da788f58ea57d1291d4b6bb14f92f4a8db",
      "text": "Wah, pinter lho! Miturut crita, tembang iki kaanggit dening Sunan Kalijaga.",
      "voice": "jv_dimas",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "30f0edbc091f3eb2312ce7051dd95bdb51d16444038f01df2e5cdff4c3b7ae8d",
      "text": "Miturut tafsiran, ela-elo saka \"la ilaha illallah\".",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f94d4d77b6daa5f8591d4a740570ff5e072a9a41212f7eeefaa2f0cfb1faf7",
      "text": "nyunggi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c0eb4b831b9a296fa915d5c8fb2c9ba216ea4e3085e7ede4910993c4acce60",
      "text": "Udane deres, nanging wong-wong isih ngantre.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c1377837e45bdaf477ad9ed466782fffb6675d89f5b94238c67d4329d22719",
      "text": "Tembang macapat ana sewelas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "393f8c680a3384d4869e58e324b8869232f06629d772197ba41c0f4d09b6dad9",
      "text": "ngelmu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "397f27eea8397436c4f8ee4093bf87bf435cbd170c2aab8650e3c8de025f5402",
      "text": "Mbak, lelagon iki kok sedhih banget ta?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aadd25072b2b65e2df1396de05452745f1c5ec86be604923a02a754dfb9151f",
      "text": "Tegese, atine ambyar merga kekasihe lunga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "41c37abd8152cb7eaf6c0b026fab84d6fe83cb4a3fa5bcc101af51966c0fca1b",
      "text": "tulus",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4288901c4b4cf44067e3237a5c07e3de03cf261576aa56a1a21110b1467112db",
      "text": "Atiku ajur, nanging aku lila.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4528b09ad4c8e278f1884d8ee7b9c6793cb942249649559919ac74e86f419496",
      "text": "Bener! Akeh tembang campursari critane kaya ngono, kok.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "46756aaa91e41cde4152cc7f05f15255bc7290394ead4ffc416b99bf691b0cfa",
      "text": "Tegese, yen isih urip, perlu nyambut gawe.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "47a0535abc9c6f0a7f98301ce91c005bec9263f7016e0bcbd43369f4799f8df2",
      "text": "Blimbing iku duwe limang sisi, kaya salat limang wektu. Nanging iku tafsiran.",
      "voice": "jv_dimas",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "48c70e033fad991066ed0aa4692a01503322bf8a4c58e91e822b0ff53b9c70da",
      "text": "Sakmenika kula saged maos tembang, cerkak, lan warta basa Jawi.",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a4328e58b10dd651de513e4c91b8a42366e8979bab27560bd44820bfd87fc5b",
      "text": "Biyen kekasihe janji ora bakal lunga. Nanging dheweke lunga tanpa pamit.",
      "voice": "jv_dimas",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "4adb2adfe937069d1ba92f8ab532a26d326d4b1cb116e51c8f8bf4bfb391e334",
      "text": "Eluhe tiba amarga dheweke wuyung.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bb3596273600ce9e02ee59c28737766ba4b641b2a4fbad1ff89b55e67aed7c2",
      "text": "Pesindhen iku nembang lelagon campursari.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d37b8358292d7584561a7db5562c311181c03b70b3c25729548318d59462956",
      "text": "urip",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e48cb9dcf72e1d99cd301b62a2a990c340a49ab45d3bb1d15575cd91501cabb",
      "text": "Dodot iku klambi Jawa jaman biyen lho, Mas.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5007a7adb895dbfefb04ef614c4f25ee28f0e612888dd2b3339d32a1e1caef97",
      "text": "janji",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5119c12cd5bf1bb3e4bb6eccfa521ffa97865a81a8d944e336f304a29fb1689b",
      "text": "Ya ngono kuwi campursari. Sing gandrung dadi wuyung.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "524684cab20d921b3c24a8515ad1d818c308ecae7919380a117c3b4313e39b7f",
      "text": "Miturut tafsiran, dodot iku iman. Yen bedhah, perlu didondomi.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "52818f7522ebbf1e813ad43c0679aa14ebafe562d02485724eef29c53d30583c",
      "text": "Aku tresna marang kowe.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "550ab93a07da965766f4e58a440d13a89fae333c1a2f8bf5225dfbb2ea40c421",
      "text": "Pocung iku tembang macapat kang cekak.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "55104de7810cfba4b35375ed80dedef22eb9438d011d4b7eaf39b69d566de435",
      "text": "Segane dadi sak latar.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "551dee471730735d8f9a9a137bcd0596b7c648390a7ce459f2e967ffe3e415d4",
      "text": "lila",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a99f148ba7cde3ab0d99b74bc466ef940b098017026dc969905af7474d5cef",
      "text": "tandur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5807c246e02235be5d122a532024c1ebba55922539a1fab80c4e2f918410b711",
      "text": "Sirahe obah ngiwa nengen.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "591d852b5472a1325d7d387e4cbe6bd5d58730769642ce1b3fcd7ee5ae0fdc6d",
      "text": "Seniman lan penari iki istimewa banget.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a2ade57472fe7a2220df463e852bcce6fd513a587c6dd5fbea91550be66cfb2",
      "text": "lunyu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c060f0de110ee9f6ecc401334b98c5922485f9f6ada22c428368f476750e623",
      "text": "mutu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c06cf5693f8a31d2d9936c6a613f4131aa55b9c30843fabb14c26f3a1dc81ab",
      "text": "Cah angon, cah angon, penekna blimbing kuwi.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dca2d87d964ab275171e6851141a9dbfba0b054f6a32a97905ae71d2af62385",
      "text": "ajur",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "65078e342e27b509452ab49316090da32b24a85b73bab380a070f9e039a91d7c",
      "text": "Swasana tembang iki seneng.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c0d5fceb0928e333f72b5588b96f9db9ae107d8475f2009c8554930cc583c6",
      "text": "Pesindhen nembang nganti eluhe tiba.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "667c7fe3a8f162ff572855c8320114ac1d103fb3d415d71c40c882ea4842696c",
      "text": "laku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c65f5011b7fd49a24d170cf84aa2acbcb6b990dc6f79f4c0ba1b85b9bf354c5",
      "text": "Sukur, aku oleh undangan!",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c6bde7bafdc97907d8e7c36d6e3d2693c0d527b942c99a893b9cf5101388fe7",
      "text": "Mesthi akeh wong ngantre, ya?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccfd7612fdd4e6d6dee53b1cd72076bd01f64a760acbeac76794b16dc46999a",
      "text": "Inggih, Pak. Lir-ilir, lir-ilir, tandure wus sumilir.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "707a26ba022317f685b532eead52246c49956ca6363fa093403fad2ed577a4e1",
      "text": "ngantre",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "70e8cee2c97fb3041577cbab48fb8d630656e7d97bec8e021b4407cf5fc96520",
      "text": "Iku 'Cidro', lelagone Didi Kempot. Critane wong sing dicidrani.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "7117e12234d145a3bd85a6a797ac83a1d807f9217af444677506b5547b3014e6",
      "text": "Tak ijo royo-royo, tak sengguh temanten anyar.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "727799c62b1622009ec2b6e9f4f82906249a64d0657ca08b1502dfc38d0ab933",
      "text": "Mas, bocah-bocah ing Demak isih nembang Gundul-gundul pacul.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "762915937ef9d2f3e72e1a94ef183f9aa2cd9aabc09add452de469979b8d3523",
      "text": "Nyunggi-nyunggi wakul-kul, gembelengan.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7639f86afd850ea7e8d488f769a4a49a652241cb8adb7a393f189d082697a890",
      "text": "Tegesipun menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "783f297805d93e4f9729bb65b44c1191879ca42a01d7313663c4ac35173d3e5d",
      "text": "undangan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b2680943744a2bab467d397977028f96435b4fb8156691d3ae75e2640f6fd85",
      "text": "Sanadyan sedhih, tembange tulus.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c81903aade6d9ecd69cebd20f5b2a4ce08a768bbb6b921098558cd50b8f0f56",
      "text": "Ngelmu iku kalakone kanthi laku.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cc1d307b53fc29c7bedaca2c08f51ac3e9ec7a03414bd1f3075d0ec041cf9a6",
      "text": "katresnan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cddd8b420ecac063f0012b743c9f3431fd1bb994328da9730f96733775d3e89",
      "text": "lamis",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7efb588542f6a11f23ca2f2d9051ba60eea63ea12904adaaf778f0e3a8d6ac10",
      "text": "Biyen kowe janji ora bakal lunga, nanging pungkasane kowe lunga.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "80d9752ae3251ea1a86d04a82cbc98f9d79cb027db922f7912cbdfa80415a641",
      "text": "Penari lan seniman campursari pentas ing Madiun.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "827d938de2ae0d5c739eed8de23636cabb76e872a2068d42ad9444158ab5d029",
      "text": "nembang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8295d3351bd17eba2cc97573803a75d551595348aec850b199121fc3ed5d240b",
      "text": "Wong mati ora obah, yen obah medeni bocah.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "83bc3996db3ff94c49e01c21ddd5155f8829851f7648ff5d205e41e2d20c2415",
      "text": "Dodotira, dodotira, kumitir bedhah ing pinggir.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "84426b2e28f93352e7031525e05ae43d8f02ab06e2e34690e49fa223f85281d9",
      "text": "istimewa",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ca2ad6d831b36c676430ec930ed5a72add40e6eb7c053eff2eebc43d5ea3be",
      "text": "Hehe, tembang campursari akeh sing ambyar.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "872f4b37f9ae34c3f80c2bd5964caf4dca44b596868659af5770f1fe7e4ca6b2",
      "text": "macapat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "87f9b49f4c7bee0e030f31898c75aeb05c4cd9d7201509ba8d6bee2110396028",
      "text": "wali",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ff2c5b7b882d0be2e925ab8ae7824d0b8757061c473b23a8c71731dfe6aefa",
      "text": "Critane piye, Mas?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8961d2d9ac0921c62b095c077c3f61db4510584fb00d54b57194c1f7114caa15",
      "text": "Pesindhene nembang nganti eluhe tiba, lho.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a410c6437553d941c5da5cf709860bced8e8d0f3052e9e1267beb5bc852f658",
      "text": "Ngelmu kudu dilakoni.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab8db94a356d89e2a17b0eee8e7d1a2bc92f2fdacdd85620b0ae672ab50607b",
      "text": "Masya Allah. Lan \"yen urip goleka dhuwit\"?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cc4c24ca77f02b939941a3525d9b7fd789bf0d7c5c8888c6f72c344b329489f",
      "text": "dondomana",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "90e678e605c04210b5fbd2561be75557b955c3ff0890e861cb61891cb85197c6",
      "text": "Nalika kowe lunga, atiku lara.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "919bb5a862f856eff6c1496d25747f388e02a1c1d8e32737b35cd8505f039cd5",
      "text": "Mesthi. Senimane apik, penarine uga istimewa.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "920623c4d9d182c30b02e729434745e378a5240e68b26c7a8d7cd0ef8b313a50",
      "text": "Kados paribasan Arab, Pak. Ilmu tanpa amal kados wit tanpa woh.",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "944589a6991dd04995dbbf0c6186a8c581f03086540f044a559973fba6ae36d7",
      "text": "Durung ngerti, Mbak. Sapa ta?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "950faa7d751356f8ba5ef95d91d2c1481ffffdfd8f470e8d9c1bb8ed6fb4610e",
      "text": "Miturut tafsiran, wakul iku amanah rakyat.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "95e59544ff13f42fd213dc79a10819f4cda73c5c7b80b9e669c8896eb22d9e45",
      "text": "Lajeng, tegesipun lirik menika menapa?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "976663171a93ed5d7ee37330d7d79296b8f0e69e402c44491685c954cdb26352",
      "text": "Miturut crita, Lir-ilir iku tembang saka Sunan Kalijaga.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "98293c60980b270780c8e0b694ef69132647cbc6e7fe8057bfb0ca771d7100ee",
      "text": "Lekase lawan kas.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "99651587073ceeed26fb748e94a4736e26e3c07d12fa39ec65b16edf21a82bb8",
      "text": "sunan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "99a1732b0ec3ee8ba8690cec76dcb3475b2bd3f82cd32e6a4d2a6ecdc9e88d7a",
      "text": "Sanadyan atiku ajur, aku lila.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b81ceae6f6c1d25969e567e7c048c7314bca4349c292a881690803b9a8e24a0",
      "text": "sanadyan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c479b15fdb8ec3ee57b712af2a936c40834d58718fc93b97554907db9e1f4cb",
      "text": "Iya. Campursari akeh critane katresnan: ambyar, nanging lila.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e84f834c0872776f4a9595ad197b93da22fe93d520ed426233c972d639c5d59",
      "text": "dodot",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f32b3f462bbc7a56285f317e2c9afeb7ef95ca0a5722d0e66adfb361e801211",
      "text": "mati",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fcef26ea0317b7c68336ed0cd0452ae2fbcb9c4f5458d614673a01661cc3708",
      "text": "Bener. Ngelmu ora mung diwaca, nanging ditindakake.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2f05db2ad66a88a53f51e5e83fce0282363c8f74f89a6a5af9c514ac4cd9f59",
      "text": "kanthi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f795c02cba974d1a8bdbcc58529d5401cffde110d1ee7cdf0dffa5a8104252",
      "text": "Yen urip goleka dhuwit.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a630a328b6bfc6bff5a608fc11ed7e6ef393e65226e174e7d0f8378c5849197e",
      "text": "wus",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6bb7c960b38c17284189dc81bf7d076139880a05d0839d07e91415b2586a8ee",
      "text": "Muga-muga ora udan deres!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c2f264d2bdaed7b682670a54a7cb2f2aabf68bde2fb81d048ee46bc812388c",
      "text": "Critane wong sing ditinggal lunga, atine ambyar.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a883b52f34105f1682b0ee42dc5ce41fdaa443b0fe4307140cce8f7baf95c197",
      "text": "Iya, lho. Nganti saiki tembang iku isih ditembangake.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7b2fc9b70a4c123a26f925695ada22a30b6c1d80391d87ac4925ec5e624014",
      "text": "Malem Minggu ing Alun-alun Madiun, lho.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad050b23f68fd3f1e273e99e59525ab46af69b34cb52637af70cfebc9406e2da",
      "text": "seniman",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad530c4b85a8f40ef2ab61b40456098d0916c9bb37afdd49aafe65190a04553f",
      "text": "Pak, \"ela-elo\" menika menapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad7363121ab9dbec917a5695d1cfd5f7739fb0d0c30f76f578f6ae21220c973d",
      "text": "mbasuh",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "adae5574263b77472ff7258949d742846f9d4ca73c30162f727adc96627cc3d8",
      "text": "Kados Lir-ilir, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b039f66cbde9215b172659ecd16d9c3a7173014e5e696d0bc470b46cf6509272",
      "text": "Sedhih, nanging apik banget.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b13d718d08877c214670c0d79c1106de754bf24bb5c7e9b3b747108bb4ab0e76",
      "text": "Critane cah angon sing dikon menek blimbing.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6eb54cf05404069f6427a7f0057cce93a8f357f86c1bbecfd3bfc13482b93cd",
      "text": "Lir-ilir, lir-ilir, tandure wus sumilir.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9a9c787d12cd19c3720aadc3292f8ac8080eeada93d6584e21c1200f3e926f4",
      "text": "blimbing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb1a92c9d46ea32f3908d8ec871e0d2fff4e72da1eab33408416cb198277b1f9",
      "text": "Nanging nalika udan ing Demak, kowe lunga tanpa pamit.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "be90ecfa7a9674838471cbde029e5ea121ff04f5d9dae40c7b97508ff2d52be7",
      "text": "Ibu tresna marang anake kanthi ___.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13415f903cae51223daad4251e43874ba82e5fff63276b6f1b31ece361fc002",
      "text": "Lelagone babagan wong sing gandrung lan wuyung.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c178a93ee2f74fd47f5358c593e712222daed21457fe426a77f235a4ac4c9054",
      "text": "swasana",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2a7f8cc02b56bbc7fc37a24c26556eb1d5b579d8d02fb508c16c470c3600126",
      "text": "Pak, dodot menika menapa?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4931173fe881b1e1db13fcfbd7a060c3c412a666e55700895f821d6db2a01b1",
      "text": "Wah, sukur! Kapan?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55a56a0a027218ddf940a663e40ddc5cde9882492d51286f25f2667ec49ffb7",
      "text": "cah angon",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c72cb10e1aaed47441f5edb04ee81803119cdaa3288d993d0ced24c640de85f1",
      "text": "ati",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7a475ef78c8d5e3e52f99065106a69e8db008109189fb9f6aa58f762a154fa2",
      "text": "Nalika kowe lunga, atiku ambyar.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8a8d125bdb1f3ef5c2fecb91b6d10909d3fd151b06fd9427a9fad96948458b1",
      "text": "wuyung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f8b01d04d5662a7dc3fcf3276bb2464bc8a8ac51e529d7c0875f269e697daf",
      "text": "ijo",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd5484f8c23ac6798de67c2510124d337eae482780fe66966e9268a1c56cfe29",
      "text": "penari",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdabe5cc689394440e71fe6622213e6b75f02e7ff7b39c21da4ccde99e8fabdc",
      "text": "Bengi iki ___ banget, ana tamu saka Mesir!",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce794d6cf314d71c71dd951d454be08c760a1b4c3aa7ec4d8904f89ebd32e5e1",
      "text": "bedhah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf94737d72544b0a1e7f2252e271d6126427c9e94236e2d726a301ab83bef48b",
      "text": "sukur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfd0683ce58a6746b43d16254298d71316aec75d6b15786d3071c913be6c7bb7",
      "text": "ngglimpang",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1697d887524549bb1a6ecc2dd1c42d83cff61b5f6999f8020fac89b9dbdf10c",
      "text": "Tegese tembang iki, ngelmu iku kalakone kanthi laku.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d9fb93855fba991d639e6d9a06e2e51e0483af1de3493b4156148b91b333f4",
      "text": "Mas, Wali Sanga mulang Islam nganggo tembang.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59ddb7e1a2fcfe56eaef0e23301cbd8994cc1b77fe0dd7652f68e4ca266584c",
      "text": "Amanah, saking basa Arab, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d741aadb0ef4f479830265ec7b66001df18307d1dc8c996f852dc710c32231df",
      "text": "Miturut crita, Lir-ilir iku tembang saka Sunan Kalijaga, salah siji wali.",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "db7412dda99ecf771a4f1e97730a8918dce4da2796a6d8ec0edffeca566c3d40",
      "text": "Alhamdulillah. Sugeng tindak, Mas!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "db86e7151e0da57066ac2c65dcef3b700723f31e55bbd4ce526f47f7d1a62759",
      "text": "obah",
