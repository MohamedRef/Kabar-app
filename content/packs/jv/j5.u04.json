      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f6634808d28eb8b5f9158e06bdf4d8bac579a20fb16cd5efefc4528884b1ac1",
      "text": "Durung. HP-ne lowbat. Mengko tak kabari.",
