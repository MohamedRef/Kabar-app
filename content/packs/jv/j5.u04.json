      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fcbbf07925500b560ed32408a881b0c9af3a6db1941366af80781d0639c4e17",
      "text": "Aku blm iso, ana kuliah. Sorry yo.",
