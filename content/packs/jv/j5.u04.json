      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "21b463779d6387f03523535648db98a2b54708e2c0fd5f2de7dd97881e023405",
      "text": "HP-ne lowbat, mengko tak kabari neng grup.",
