  "audio": [
    {
      "key": "00126015c6af0c6a4cd822594a7ff9a1585e8ac961af5368d316be189fc4bd7a",
      "text": "nggumun",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "008cadfd860d3c96cb95fafd4d5d7bbd7b717d2e0f82b8748919be1dbc66ff8b",
      "text": "bgt",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "04c9937b23a7330ce547f0b7911c0ac0c9ef9727690642049a58a3f183fc4c4a",
      "text": "Halah, paling ngapusi. Fotone njupuk saka internet, lho.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0635c20f0dc2067966091bea5562916fc536677dd2118d656ad5159031495042",
      "text": "Lan \"iso\" iku \"isa\", ta?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "06a1f8af95dd7263a1d5cbe3dc7dbc099d4bf2a83af13997d2cb8869ed6bdada",
      "text": "wajib",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c74e8983cb9447b64d9bbae806d45415b697d972f7db7fd00f1348aeeb3e655",
      "text": "Iklan iki ngapusi: regane beda karo sing ditulis.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dc926c2dc69c2d962b3aaf4f40892b7604f91f28fe2c051f47047a5472d48db",
      "text": "Mbak, aku nyilih HP-mu sedhela, ya? Kuotaku entek.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dd77e5ff47612a7910eb1489d4e16080ac96fec46db5efedce5b9c5fc3a5f1d",
      "text": "Mampir wae neng Ambarawa, healing tenan!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "110935031ea15ee38eef488c6c465e99e67d3c4ede76853ab9d93e67b9385091",
      "text": "macet",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "112b0750afc45e1c175519caa4f3bbcf885c4a9e8839f3033360befd82644937",
      "text": "Wong sing nulis iku iri, ta?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1712ff78635aa038824089f7dabcd54d724c0478a28223cb1bc644f5861760bf",
      "text": "telat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "18c12f491e361780a2e9feffac55d15b677a4678bba2b0aa29c153f148e911eb",
      "text": "Museume resik lan apik, cocok kanggo healing bareng kulawarga.",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1913ed9b50dc18e9de73a4ae4ae79d52ca7d206e43b9f97e223477e9a2bdc92b",
      "text": "Nggak papa, basa Indonesia. Padha karo ora papa.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1961a79e48498eb74083e68cd72068b6bcc62d0816a2b2af49e3480c329ed4a8",
      "text": "Hehe, grup kulawargamu telung basa!",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1968626b5b7c536a8a5c240ddbe50689c889c1cd83a9dfe551253d760542afaa",
      "text": "nyacat",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a7b1502f0c8a740e5fa926d11509a512ad1b474530ce943668f215496d7ec36",
      "text": "Lima! Nanging parkire rada adoh, tulis uga.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ace9ebbe0b5d829e41f7172264df27a26b3f48b53e503e7c48cacf04066c012",
      "text": "Mas, karo ibumu kok nganggo krama?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1adb0d1dde2f56cb68f10ecb4bfb184db432fcae46cffc10d2a835683791c0c1",
      "text": "Wis. \"Wajib\" iku saka basa Arab, Mas. Wajib, perlu banget.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1be02a4bdfe68f5cb0fcdcea1357b3da810dbb6de545a80f0423f4e34d0d49ef",
      "text": "ngece",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cfa6821e28e00daa4775add926f728fdeab9be3f16919f7702e57b91d8ccbf2",
      "text": "Bojone ___ yen dheweke chatting karo wong wadon.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dda027321ef7c7da2647f5f48d901457e6916f803b1e604291de7a7101e61cc",
      "text": "Pungkasane piye?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f6b5118b1daff381fd0aa286bc0de32eb7f9f855f0ff4098aef285afaf0f652",
      "text": "Apik. Aku kapok padu ing medsos!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fcbbf07925500b560ed32408a881b0c9af3a6db1941366af80781d0639c4e17",
      "text": "Aku blm iso, ana kuliah. Sorry yo.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "21b463779d6387f03523535648db98a2b54708e2c0fd5f2de7dd97881e023405",
      "text": "HP-ne lowbat, mengko tak kabari neng grup.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2248c8603cd4880fd1de35f91c01df4a63814efbec125c934e5e46319f471771",
      "text": "Videone wis dishare neng grup.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "24f364a497b29b30b35a4578942f0494b1f1b0903f6f6271a8fe19318d8c88e5",
      "text": "OTW",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "257e69122194647d938306bfed5e44439493be9fe3df17dec407b18d5b246b63",
      "text": "Wah, campur kode! Saiki kowe kaya wong Jawa asli, lho.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2644b2713409da443c914ba9660c83bb145b610eccc65e54da39e0d4b3ef43b8",
      "text": "sambat",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2794368e2d3f2b17d8ffd987b507be440ece55fbecb1da38726d77d057879b0b",
      "text": "Yen selo, nyapa simbah ing omah, ya.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "27ba40ee4465791ae26bc420ff6282a7190ad6d6689f8a4536efc85e03e6a6d6",
      "text": "Tenan? Lan \"akhire\"?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a6e7f47055dc658ceeb054c7b3a0695890400926add5bddc0c52eb44946709f",
      "text": "ngetik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b6f6ebd8d3aedad77d8d150e279ad10c783ff8cadc26bfb998213603c3886bf",
      "text": "Nanging karo simbahmu, aku nganggo krama.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d68e32ed0dbe908f2f48c7bbe49250eaed95fe4b809d045109abb5d491dc12f",
      "text": "Aja sombong, kabeh wong bisa salah.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f665d954919b44044f200dcc306a1fd795e8355713ce4679345bb2231c49909",
      "text": "cemburu",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34aeef7e8c779dfa80aad7518738b8ccd28c6a325c849733a7229f500d55ba2c",
      "text": "keren",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "366837b0a93e9344147e64aeebf6c54a387547c08205b075a482f4684f7e7f06",
      "text": "kuota",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3711ad04191f71da288da3410796f9f3b41d2c8da4bcdf565438311040eab766",
      "text": "akhire",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "37d0884362149f7c82c03bcfcddcccc161168dec4cae4364c389b2833f036ab5",
      "text": "Wah, aku butuh healing neng Ambarawa!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "38a2c85b41887be38abfb42223ed074c181d462d3cb3c7c328d0345d1de89183",
      "text": "Min iku admin, sing nggawe postingan.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b785060cda336f81f55cb8035dc7ec8dc67188316966dd885c476ea21267702",
      "text": "Kuotaku entek, ora bisa ngunggah video.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cbab2950d3a275df2e62a1e3e181c87e82e1c9ca0d4595fc2742af3e6edc8a9",
      "text": "dishare",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3db6c993b99a5aeb95fd1c2da356164bb8314cce3b6af8c64b593d465cc8717d",
      "text": "Karo ibu sing sopan. Ora nganggo basa Inggris.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fe28cf1e683ee60887e6c295f09931fbf1a287cf3fc204fdd19246ce7627dae",
      "text": "Pira, Mas?",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "404690f746527fbb0ad295782e90909092693371ee9ec8211b426df21dd7c674",
      "text": "Ana sing drengki, ana sing sengit. Medsos ya ngono kuwi.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "414c1bb836ca6f75dfb144c7f36fb0ca29fee95a4fc0714da2e3a5452422faa5",
      "text": "HP-ne lowbat, mengko tak kabari.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "41e851486f78184a5588585cb053afac324fe8caa806fbb8da501409281a60d2",
      "text": "ngglembuk",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "43883961d193c2ad9da8274dd31a54d03587729e3a6c44315ff3357f53d2b40c",
      "text": "Wong loro iku njaluk ngapura. Saiki padha nyapa maneh.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4843a632c751aa4d636bb64b0cdeb2d4c95aae8a7a08416855db1f5275afc53c",
      "text": "Mas, \"min\" iku apa?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "491309391c5c88e3b2f2a6622e5c6766576cc6ff0310f1230746c788a411db8e",
      "text": "Sorry, bro, isih macet. Aku telat sithik.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aa8081e917e0a86673d3fc2d5bbcb36b4698cb2d405c27b85a0e9292c6844b3",
      "text": "grup",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d68981f2eb9f2785054b5074158acb0447144ad179b9f074a66b6b441a2a107",
      "text": "Kuwi warta palsu, lho. Aja disebarake!",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e323f33f4d9bbe118ed780fbd836ec7d4c10d6011a78e31943ceada78bb6037",
      "text": "Aku udh tau mrana, healing tenan.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "5259816c737251f2ca7e5ac709067f73f201e1288dac69313111997499354e38",
      "text": "Sabar ya, aku lagi OTW.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f185812cd473786c1cd6950fe1ba2013705352127d972180a096bc01b0c302",
      "text": "Suwun, Mas!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "540233da062ca48ec71d8cd6b5d4853dd97838f9b741a9c78471e4fe0bd9437c",
      "text": "Aku kapok, ora arep nyebarake warta palsu maneh.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "549454c3aa4498a3b511f470d3ebd7ddf0cd009e582193995b0e5198888c2560",
      "text": "kuliah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5539cbe2df93941c7da223872d9a2ab81db365eef4dd76d1248c38cd7fb361ff",
      "text": "Oke. Recommended bgt!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b24d5fbad53b46f90fd81848ff884019c49b8a7326263c895887c6a35f86945",
      "text": "Iki lho: 'Sombong tenan, mung pamer mobil anyar!'",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dfc4d7bef682f5399153b0039d227b212f2272cd9d8c60dbaa164eb0a992146",
      "text": "Oh, karo kanca campur, karo simbah krama. Ngerti!",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f7eb13b72fad7cf75f67329bfcf4135a5dc4c0784e6c8f89d9e1a7a8c2b1bc5",
      "text": "wadul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "604eebc9ca269e6baa099b0755e0a0c791252de69d9de3a3775e0bf75ab5511a",
      "text": "Aja ngece komentare wong liya.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6079714468a8a6c5a136eab19b3fba3576189d985e6a7f1e26c1916237ed567f",
      "text": "Aku selo saiki, ayo nyapa Mbak Ayu.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "609d55412927daa87807cd29618bc67a01536ac6ebec9b8c24acb4eaa4d7b5a6",
      "text": "Akune umuk terus, mesthi ngapusi.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "615fe1526bec254a364a2819122072c0a37e367e78010e7428b9a6415edb1a36",
      "text": "Mas, iki postinganku. Sepur lawas neng Ambarawa apik bgt!",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "630c4a9246fda18162567283ce870e108fd779cb69dc98e4fdbb38b582191987",
      "text": "tontonan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "63fb6502067f3b9275181cf09960019f2cd673ad02aa80c296b9b35d2bd209ee",
      "text": "cocok",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b14ccd7e0eaf8a18c3cbab857e560bfcf53d413aa0dfe7b0c1530792bbfab88",
      "text": "Aja ___ video kancamu, mbok menawa dheweke lagi sinau.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bfebad051d860713b3a360174940c4874f7026a045782372fcd686d52631e4c",
      "text": "Gpp. Tikete wis ana?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
