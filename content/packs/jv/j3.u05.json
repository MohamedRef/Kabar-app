    },
    {
      "id": "j3.u05.l10",
      "sha256": "70209a07027e7b535bd76574f4bad5f3e0f9518f83c183e529882ea9645d8ccc"
    },
    {
      "id": "j3.u05.l11",
      "sha256": "63cc965fe4a875adc9788c28570eb9f2cc6d59fcedddbc010b83efc19301d75f"
    }
  ],
  "audio": [
    {
      "key": "021086a63642501a274dd28651b63f7469edf54ec3f05b7558f9021687a0aca0",
      "text": "Matur nuwun sanget, Bu.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "03259b96e3ed1345cf2b9378d2b1e9b43eb32e213be679b3a4e5ed15630bcf9b",
      "text": "L. Wonten werna biru?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "0563575aae161d1d657bd1daf7b0dce84023121fb0cf6cebdaa2148e16e3936b",
      "text": "Mase saged krama, nggih! Nggih pun, angsal.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "06407126029b9e806b3b6c086d817fc4abdc5880357e89c445720d6510d70f11",
      "text": "Niki, Mas, susuke satus.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "076c37233f65f0adeae4dbc352ee987a4b11440a158375ad1b0c66b41f56c739",
      "text": "Bakpia lan kripik ing kotak kertas.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "07bb9640affdb1aa81b90ade84c8dccd9e41f4ccbf488caa320577013df9da0d",
      "text": "Nggih, Mas. Kalih nggih.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a613918ad931bcf56c93e46caac3e3220f37dc0816ac407ddb2f20d1d7fe2c5",
      "text": "Bu, setunggal pinten?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b66938a7155bfe56a910cb4f5ee70042bd2ab523ef0db481010ae7f7f0d664a",
      "text": "sekul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c54c43939fd3c19c0d5d0a4a44055df547f8ef3b241a797f5ac39f1bf44618a",
      "text": "batik cap",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ccf2479503dd66f7700691e4253f7f4376e99b08b706d51e513072faab31f38",
      "text": "Sekawan kemawon, kangge kula.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d0a914762986bbcdfd99c708ea13e27de2c71e5ef9dfc785a71284e150502ca",
      "text": "sade",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0da51b0e1e787142983febce65fbb91dfe1e1bce66c2d0e54af3ac5a9a71b92f",
      "text": "Kula badhe tumbas rasukan batik ingkang rapi.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0efa3da3258224b2e07f89e0e7da3727bfa04b05bb2c0802575fef7ce46704ed",
      "text": "Sepatu menika ___ pinten?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "1123d20393f51e8f89fe7acaed0a01da368d91c7baf7ce1a4e2f63fc799c395d",
      "text": "Bu, angsal nawar? Wonten diskon?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1187f2c0d859941b978dd61500fa4e26ba1f2857b6600e0036a941a1007a454b",
      "text": "Uwos kalih kilo lan sarem, Bu.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "14e03bb81ba85b12fc656676ed1d33b416ae38347fc92344ebf0fda006cebed4",
      "text": "Bu, sekul kaliyan sate setunggal piring.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "173216e70080e99e4f8a612ae4f6b15de5c01e64bc2d73a1a32f2b89206d010d",
      "text": "Wah, awis. Angsal nawar, Bu?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "179d05639cf36cc5f975610275b07b9df6b4b5702abe8c675e6e8bfd95df6b10",
      "text": "Menika artanipun, Bu.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "17daed881eca5185409a59ff427a275ae183f117ab6cef310f7262f360ca40a1",
      "text": "kosong",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1864f8811e1fa36378bc62b2f1a2787206f11789ab8d832159e74e6cf9f80775",
      "text": "Niki reginipun pinten, Bu? Awis sanget. Angsal kirang?",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "188c7d9bcddcb359560fb91173e35e79eac7193bc2058b58e6fa1f644c152421",
      "text": "endah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "18fb1a3e58048c4a962131542e01fa2d567c2f2833e39ebc3851152bba214a69",
      "text": "Beras (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "194dc67a032ffb760130802aa684720a352c7d73f435f5a5d098d9a3c91fa458",
      "text": "dompet",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "195de43b1e03b10416007a0c1ab521bd4387e6e55dd29f0c599c622a36476159",
      "text": "Rasukan batik menika ___ sanget.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d9e9781a794f49b5062e52ec4a2c7cb74f716b388bf7df5a999a18bd4a83904",
      "text": "Matur nuwun sanget, Bu. Menika artanipun.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "202f80eccacf8681ab2d09f6a0e3af2bfaaa409fd553926fd20ab6f228f28c01",
      "text": "Kula langganan, Bu. Kula asring tumbas uwos ing mriki.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "208310ae8e196b85786a11b7904bb88c184411f79a9a80ecb9d3fcd6b46cf28a",
      "text": "mbayar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "20cefa968ff1eb82e204d47324c249722fef5ef1ec0425f1771a294d9ea3f009",
      "text": "Batik cap kalih, satus ewu, Mas.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "22c84cd836045ef6034544442f29e945571479f9e17a54b9c687848dab583695",
      "text": "Niki pinten, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "23ddfd78b778c0a4ee584cf4c607d0fae5adbef3df16a8c47515d91dca764136",
      "text": "piring",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "24107698b6fed1198d5ab13dc8e77ffc65d4cda5d98c97a5846f74ffee945035",
      "text": "setunggal",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "249d76b439e0f5f62e5b822a4c8790975bf697842e3cea37f6ec65985c755c47",
      "text": "Nyuwun sewu, Bu. Batik cap menika seket ewu?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "25974a6ab8fc2032a6a78385648810d9bdee06309f001d613aff3b23e7f49151",
      "text": "Sekul kaliyan sate, setunggal piring.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "28798b3772143d3dc1ae8c8af46d56fefc39abee58047940150e75153ba44735",
      "text": "Mangga, Mas! Sate, tempe, sekul!",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b64e9a8fea59984fd9b9f46f22e4a792e1d5b7ab3bebc07631098bf1342463f",
      "text": "tumbas",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c002b6e91981e1646573a26bc8136057f55955cdd56f86b94a36aa03b0e74d5",
      "text": "Inggih. Kula mbayar pinten, Bu?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cf64c5bd1dbb72e94910bcaf4db2237e24ccc1481b0c0f37b75f7fa53ecce6b",
      "text": "Ukurane pinten, Mas?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d942966649395331bb1891600fe0002c0960b0fe3a860e626418cef34eed31f",
      "text": "Bu, kripik tempe setunggal kotak pinten?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "30ad54ff17d3dcebed8427f79794536af51dc3d02cf0c268602c97176cdd33db",
      "text": "Kalih dasa, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "31177769eccd61ab24f1452810ac3d82d5d8ce87ce073605d0db3acb6699303d",
      "text": "Angsal nawar, Bu? Wonten diskon?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "33e0da1c9e9c46bb027114a1fcd7afa489f1d2977fe369d7d78d53981a9301c4",
      "text": "Kula tumbas kalih, nggih.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "38badf06dc4c3cca8d01cda05a7007f6f27f7184ef785aa8db00ebf716812f1f",
      "text": "Mas Mohamed! Pados napa dinten niki?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b00c03c6fa78e91cba3eb7e47022b4b37f3da685c767993acfa3aaaa6f0756d",
      "text": "Niki mirah, Bu.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b609dbcb5c8cef08c24cba9fd4805592daef33327cdc11e6f0342ed50c10511",
      "text": "Piringipun sampun kosong. Enak sanget!",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6a3ee088b34cf12497436befa20e0c801300f9b26e765475f514f0d512cd8b",
      "text": "Kalih atus ewu.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "3babf3d2b8d031dd7271c524ab98012893714c8cc823be8778b18903e2da5f04",
      "text": "selawe",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf10067b1fc8fd8b43bc772ab82ee0f20e80d6e95e64820d51c50ad7691e506",
      "text": "Sedasa ewu mawon. Sampeyan langganan, to.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dd5c0cd92158c407addd780e60d45d95c6504a83e043a66de47b829c32c12c3",
      "text": "Uyah (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f88de09edc373799ce444fe7f98cf9efc719980332d7c45c83e871223e628ef",
      "text": "Nggih, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4022e4c60acf60bd932bfcf59e228d6e9acf0a12e5b5c5328bdd8244913fe633",
      "text": "tempe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4062d2db93c99930719fb7016422cce68e0c25d138996d6597b99de6df71a110",
      "text": "Sae! Nyamping setunggal kangge Ibu kula.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "41cad96686bed0fedab012cdeeccc9b4b51e925c2d55648bbd7413c583a0bc74",
      "text": "Setunggal kemawon, Bu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "46bdcbc22e3bd02689733083157dd5d920d94d6b96be9b9355903e23f8679aec",
      "text": "Wah, batik tulis menika awis sanget, Bu. Kalih atus ewu angsal?",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "4843f1aaa82b87d463fd39ecd05857672db668850f18bdf5b9da42a0712021b6",
      "text": "Kula tumbas sedasa, nggih.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a15c6dda6481478d79ff138d007568f293ca858977725750363f36a44b9d079",
      "text": "Selangkung ewu angsal?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b7dfff67e95d90ad2ce737b89483a58cb0bb905f18f4a4430ecf8d337344dc8",
      "text": "kirang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4be963b3882ddee1497810cb2ff73d6877e25e37b11ce20ef81fef338b2385c3",
      "text": "Sing tulis niki tigang atus, Mas.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f78f9b869b7f84ee31dea68ff8a083e7c2d7757b00ecb35fc396a536f5f5644",
      "text": "kertas",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "515eb9aa5203a5ab6228e56a4bbab86db55eb0c97e89a58b53da84ecb61dc5a8",
      "text": "kartu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5173d78aff62a200822fde7c5ce9c4fb032adf61d54106cb36c39e4c9fb0c52f",
      "text": "sate",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "51c4207d462e1d34fb975b218ae467ec44518b889cf42478bf2bf0d786fb9dea",
      "text": "Sekawan dasa mawon, pripun?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "524060dc1183800fdd27fb1af83668b55bbe5d3f53028132fb3a075713327b2d",
      "text": "Kripik tempe setunggal kotak, pinten?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "525043ff343ad76d68faa6496ca4e7de0c55e60dadd86e914b875588bf583101",
      "text": "Tulis setunggal, cap kalih. Dados tigang atus, Mas.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "528b12833d3e0f0a63736c8d5805e5a698098c2be5cbd16a409c36dc9e1731f1",
      "text": "bakpia",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5499bdf579d4847fe33d55b08eaba55c3132b3d5a03e007a0c1ab4462b549e1f",
      "text": "kalih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "549e29e5f5d6b767eab1f5578053c15eb37f327a644738b6c2e5588a26e1d7ca",
      "text": "nawar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "551b50f862d21e59feba8ebc940ac42c5f49f74ec03647d3fc4cf12910979ce3",
      "text": "sepatu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5660ff9041bfc8e05ac4a103f33d4bff80fc16586078d0c58e10e44c1406f7e1",
      "text": "Pinten, Mas?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "57013681201fb02ec18033f6beae93f7c774f2d555d22f86d50a372651e35d66",
      "text": "Dados tigang atus ewu, Mas.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "57b535be36b63a533f21a4486dce4226739c366296b9c85603d13a6e2f9b7bc0",
      "text": "Wonten. Kaine tipis, kepenak. Nyamping nggih wonten kangge ibu.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a6f8e10e69eb8009a9f3ca152428c18cae00d06d814364a5df7aa2c5a4584dd",
      "text": "Badhe tumbas pinten, Mas? — Sekawan, Bu.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d6fc2cfcf86e879e6e7d5dd5ffa32a00d071b6e8afc735d6fa7b6c3a4abfef6",
      "text": "arta",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d79e123522e93c2fb6d1fe961ed966ebdb197b61e826053d5e55ad6fd6f09c3",
      "text": "Kula tumbas kalih, nggih.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df33c35584d799262b86960704f1d31b1119ee875079afa55c18078b6733b5f",
      "text": "gangsal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "605a236b7ebb1e6815b7bc25c8ea50d5d9766bf75ec661446f0f1cbf4739b285",
      "text": "Kalih, satus, Mas.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "61ab2e812a0ed5db17d77a90585ebeaf51a20fb8372473fcc91bb9355a21d32e",
      "text": "rapi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "62cb992e42f55b16b066e8c19bdb2326b88ee4bd474f47987860506bb6b9d5e3",
      "text": "Tigang atus ewu",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "64f5117123e58fb28c391238d2125e50c230035e91a45ac0f4b9fd3ff69a8598",
      "text": "Batik tulis menika tigang atus ewu, Mas.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6851f174c839d78edecb052d116cd355ac6a09473967bd6e89649c9ad069b666",
      "text": "Aku dodol tempe ing pasar.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "68544ce37c55df2b2ba99161205038e174ce80cf9975b44bc512c442c13d0c95",
      "text": "Mangga, Mas, rasukan batik. Endah-endah!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "687c40f9f492918ab9cddf027ad6c2f8ae3e66d8fecb17943ce66d037a6a0382",
      "text": "Reginipun pinten, Bu? — Kalih atus ewu.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "693a554f62afd319515b4f8f13698adaba84bdfe0901b141b24cf31f174a9fab",
      "text": "Kalih, satus. Nggih, angsal!",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bae8bc188bb3e4cee10c9f45e81e8bb174eb3db8858b5f0650bf937813afba6",
      "text": "Mbayar ngangge kartu angsal?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "70129961824c9c20413235bb7ecdd58ef68e3c1709086f6a7a26a37a4bcc7dcc",
      "text": "Sedasa? Nggih, matur nuwun, Mas!",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ac127db60a91dfa86320f6c0f0927b612ac231344965a2da8e32c7be07ed66",
      "text": "Nyuwun sewu, Bu, reginipun pinten?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "75370e8c982d7f34e24e7a22f33b65a2b58bce756e53fb09e21caa92c7f94922",
      "text": "plastik",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "75f5d0106cc8256ba1c5a455b24990707d4d60e9a9be0957d8d6ff6fdbd9ef53",
      "text": "Saged kirang, Bu?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7700c2c6f76283e52523669e2c2d99a7e8fb0014171dbb2413bab81d569d5f08",
      "text": "Seket, Mas.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "77fa55ef6b51e5863d186689fcba383801642feeb6dea317bcb10644885fa57c",
      "text": "Pak, panjenengan sade sate?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "780b4b05a479b74ed503b57d48dd916fe1f62cb78693e48dca02ac8c18b77046",
      "text": "kripik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a10b01322454f2fa84fc7e4e1e9e2313509c120df20ee2f400f77b3c54eed80",
      "text": "Piringe sampun kosong! Enak, Mas?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a126450ead7205f07742c3dd3a8f089bc158354ad3e7a9b1cc147839d35af11",
      "text": "Nyuwun sewu, regi pas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a8a73a337f9a5bee87b88fcce7fe438f6595468b1efd9146ba2d08a5a6ce95e",
      "text": "nyamping",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d2c05241ca0571137e90a7f891a8caa8c2afea1dcaf4949ec987575da438ffd",
      "text": "Sae, Bu, matur nuwun. Batik cap menika reginipun pinten?",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d78e1dbeb33e44508b3e80a7719dcb6d164c346071ac11fa1c544abd4ff85e0",
      "text": "ukuran",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ff01bf4c8a36f96de58643de2dbe315627a1211caa93e743eff7c836709b55c",
      "text": "sarem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "80edd8c4cefe0cc1a9040d7a6f9dc1a8ff64cea7959fe9d5ce6eb5fad1b303ae",
      "text": "Enak sanget, Bu. Benjing kula tumbas malih.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "818539586962a84e4d629822c33e22276adb9661784a09d5cfe0761d13da44b9",
      "text": "dodol",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "818baf3c98087adcfee4cbdde2ee04711eaa4c37ef062cf61feb7c5248e80e67",
      "text": "sedasa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "82f6ed3e0188d3173acd3bf10dde2c945bce062e174541250793ccb5d376fb19",
      "text": "Mbak, nyamping menika endah sanget.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "86d9353a10d353ada7cd13c6bb0ef73730949558348c79880a1f78862f56122b",
      "text": "Ukuranipun pinten, Mas?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "86fab69388bf649aadd122a9a79008c3c94f6b84b9434af4d1c4a32515703b9a",
      "text": "rasukan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8768a8628e8c1a5eb9de86821deda0d9bdf36cd2a34ae4ee123d3f6fb01787fe",
      "text": "Selangkung, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8886dbd42a263f6d58af91dd00aa1fa02f950d170a80f0772f319375e84f6e01",
      "text": "Ingkang menika batik tulis menapa batik cap, Bu?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c28cf5982736f2370e08f1f7bfdad5000e3d024745d638108d6d2e076b6ba15",
      "text": "Kripik menika pedhes, wonten ___.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ca5273181e9c9ac75224b9a9542b2eec39eb0387aaffa04205b2eecbc829e5f",
      "text": "setunggal, kalih, tiga, sekawan, gangsal",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "91b2922097911ae312ff414b58ff98dc08428928b8684df9626dc4e2177802d6",
      "text": "Angsal, Mas. Tak bungkus kertas, nggih.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "924827f8c01caccbb4643b1d214108feb646fb4200cbe0838d8a514fdc9454b5",
      "text": "niki",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "95486335ff0a85e4835b81140a7689b3708bed634c6f5ff412198a64309e369f",
      "text": "Laris, Bu! Matur nuwun.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e01af94eeb33cbe6c06ca6adeb9f34f09c35593021c4c0c0a454d3829c33913",
      "text": "Mangga, Mas. Pados napa?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e82b302d95079fc3b240f9984cb327eb3072e24b85ad053f387eadf586fb238",
      "text": "Batik tulis: tigang atus ewu",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a34ccb9659f642ed8944a6b2347196a8489b45a4eeaff6d80c2d78a513426d3f",
      "text": "Mas Mohamed! Pripun kabare?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a48bbaf96d388c43c998c912c0a28f5a34129ef0bcd210ef7b774dd21cae0612",
      "text": "Niki mirah, mboten awis.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4fa88eefb1e415780ca173a2325a9c105bfca881025b9301bf02455b6cfe7f6",
      "text": "Inggih, Bu. Menika sekawan atus ewu.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a516f700ff8415fc28a2810fa985c0cd78983ddb93b63cffbee8d6b1087b1f08",
      "text": "kecap",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a599c04e98a1311a42aac5eb0bbb02d179be30b980d364bfe8d38765406ad35d",
      "text": "ingkang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1d8c8bf140feec204c93d93ec01efef00aa0110797fc691ab2c981fdff23cd",
      "text": "batik tulis",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae02b857ed864ea0afdd2a2f20e6a00eddb237d87e9125a3a8e00d3e7266a89c",
      "text": "Ingkang menika reginipun pinten, Bu?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0cc9f53454f2ddf71017496488dc0789fae01d258e95c0983dd60c668b1fecc",
      "text": "tiga",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1710b4a093940d2c3ecb08ec35008f5c716402d5ad612fba3281943fdab2697",
      "text": "selangkung",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1bd02f4ec5453d015e8d26f814799d04998db57d9c41929e76eea254c47f830",
      "text": "Dados tigang atus ewu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b340c0fe1ebbca8a63243ff3be1e3f1feba1e5c09ce925e85bc272b1d3a9f8c5",
      "text": "Tigang ewu, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38d9913aa5da4e49cf8e3bfd1a055d42746ebb7861608bb8a5d5158c31ebdbb",
      "text": "setunggal, kalih, tiga, sekawan, gangsal, enem, pitu, wolu, sanga, sedasa",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3d0c3d551d36b990f877a994b1526d0a38ca7e34a91d403c5c564521af25b51",
      "text": "Menika artanipun, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5464ae4efd210217dc7be8209a318addbab0dbc1750756ac483435359a2659c",
      "text": "mirah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b55918c2e73053a0da9e169e4d7993802518bea8937347d31e5f214b480fd96f",
      "text": "Aku dodol sate. → Kula ___ sate.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b63b7098e729b1d0106eb145d41e23a0f2a7c05fccc52875986bccd1a721255b",
      "text": "Matur nuwun sanget, Bu. Menika artanipun.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b834a351aa91e01fe4f343b110546bf14ef1697917fb2924ff7c1f578dc1b488",
      "text": "dasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9fc69c5198c3a6579d15f01efce9f32dc3c25ac2c922c8582be6569cbb961e8",
      "text": "Nek tumbas tiga, wonten diskon.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb36a54ba75c41117fe95a79b1f4bf7b03d182814afb53104399abfe7ea0b497",
      "text": "diskon",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb93599cda88a277239656faca387d0af57b385f825723de579fab28a723aa9a",
      "text": "Angsal nawar, Bu?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc6fe39107e6ba614406708c523cbabb17927bb1683b38f1fd493cf4220091c3",
      "text": "Inggih, tiga, kaliyan bakpia setunggal kotak. Mbayar ngangge kartu angsal?",
      "voice": "jv_dimas",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd1fde1384f52812aa7263f87248fd620037dc0fb416bd8f42671db89344155a",
      "text": "tipis",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd2945009854376bb9b46b66b10551ce209f931601fd7348292218b332001a94",
      "text": "Mangga, Mas. Niki batik tulis, niki batik cap.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd90c892ea8d55c4c2d755ab67df807aaa70ce7910563cfbc3e142631108353b",
      "text": "asring",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c381bba13f8443d6b174a1e8aaec1b48d4a6632f896aaecc0a2b9f5c785c3c94",
      "text": "Kalih, Bu. Setunggal kangge kula, setunggal kangge bapak kula.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "c514309eea9b0ff47edb37f84f8e317e9186b99cb95021330874908882e26c17",
      "text": "Mangga. Plastikipun setunggal kemawon?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6843c7226dd2f450e05753862761d171a0a8fd6f706e01b8255e36b00521e18",
      "text": "Bu, uwos sekilo pinten?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f44ba8852ab0a2924777e798840b619b8b5496aa0616586a225019e7bfbfc6",
      "text": "Tempene pisan, Mas? Enak, lho.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9fa7708faca73b02680ecce85bbda4451c42637a62ccfb6d94a264162de035a",
      "text": "Kula asring tumbas wonten mriki, kula langganan.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb61c79ee8556fc233b8f619ad7335a38279085667f749111e360c7fa18527a7",
      "text": "angsal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc085d76e1ea5a5edf351bd34d329bd165fd21a27b523528ff7e409c8497a6fd",
      "text": "Kula badhe tumbas batik, Bu.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc4016cce714ed395b09696036234a746eacc85a9b04d44936865bf369be8bc6",
      "text": "antri",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef48ad32357f1bef6f9304f8e5ff3136ba2b2adcbcca5061e8f5aa52c7a5f62",
      "text": "dados",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf9645a872a7900e7f84b4455a4d9e1928d6025aa143be71d6021c30374af315",
      "text": "Sami-sami, Mas. Mangga!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0fc58e2783a65b15b57f8867fc6350fde341fcf67a957ff20949785c8101885",
      "text": "Sedasa kemawon, Bu.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1f484367ac1956620353a2fa63d78171797827192ee4ffe91fb7c133fef5e59",
      "text": "uwos",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
