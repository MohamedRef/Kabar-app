  "audio": [
    {
      "key": "06f11a15c49efa4070370f06778f7a0bb8b859dce45bc13ab134b65a0190bfca",
      "text": "mangga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c54c43939fd3c19c0d5d0a4a44055df547f8ef3b241a797f5ac39f1bf44618a",
      "text": "batik cap",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "15ec90538baabab8f6fba284017245c30e04173fc12e760761cf5e1c6dd7f83c",
      "text": "langkung",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "179d05639cf36cc5f975610275b07b9df6b4b5702abe8c675e6e8bfd95df6b10",
      "text": "Menika artanipun, Bu.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bc4b039b891c38d51d9136e78e3322801603c25ad693d2b0b522c0dd773e691",
      "text": "Selangkung ewu",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d9e9781a794f49b5062e52ec4a2c7cb74f716b388bf7df5a999a18bd4a83904",
      "text": "Matur nuwun sanget, Bu. Menika artanipun.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "22c84cd836045ef6034544442f29e945571479f9e17a54b9c687848dab583695",
      "text": "Niki pinten, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "24107698b6fed1198d5ab13dc8e77ffc65d4cda5d98c97a5846f74ffee945035",
      "text": "setunggal",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b64e9a8fea59984fd9b9f46f22e4a792e1d5b7ab3bebc07631098bf1342463f",
      "text": "tumbas",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "33e0da1c9e9c46bb027114a1fcd7afa489f1d2977fe369d7d78d53981a9301c4",
      "text": "Kula tumbas kalih, nggih.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f08b7abac53de8eecd29c5736f7f9aa5f06ced11122ec787e02f06a6b20155",
      "text": "Wah, awis sanget, Bu. Saged kirang?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "35009455e2b976d736bea2fcfe47d1d136ef05e711da09ee02937e70fc7e2673",
      "text": "Badhé tumbas pinten, Mas? — Sekawan, Bu.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa1f4c7dcae7a9ffdf52f355b0e7cfad0047fafdd3744876a3831eb746e7f4f",
      "text": "Batik tulis langkung awis tinimbang batik cap.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ae474418642beb3da3b1774055873e5aca48fcb2e1265cbc5b714bd715e8369",
      "text": "Mas saged basa krama, nggih! Inggih sampun, angsal.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6a3ee088b34cf12497436befa20e0c801300f9b26e765475f514f0d512cd8b",
      "text": "Kalih atus ewu.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "40f1f850383e5137d05b93cf9fac65fdb8567af2a540d82a272ecf1c4a6c2cd6",
      "text": "Nyuwun sewu, Bu, reginipun pinten? Saged kirang?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "41cad96686bed0fedab012cdeeccc9b4b51e925c2d55648bbd7413c583a0bc74",
      "text": "Setunggal kemawon, Bu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "49ca7e4d5690562a2f236958b7c736912aba28b31fa9a5fa784db98ce00880b2",
      "text": "Reginipun sekawan dasa ewu. Mirah, Mas!",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a15c6dda6481478d79ff138d007568f293ca858977725750363f36a44b9d079",
      "text": "Selangkung ewu angsal?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b7dfff67e95d90ad2ce737b89483a58cb0bb905f18f4a4430ecf8d337344dc8",
      "text": "kirang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cdd41ab866a0a336ad128dd147658f7697bbfad1b5270284cf2bb8144715b98",
      "text": "Kula badhé tumbas batik, Bu.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d9158d0bd0e4badf831309cb17084de6952303a742ba99cf4539ab0ba3a1f50",
      "text": "Mas Mohamed! Pripun kabaripun?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5499bdf579d4847fe33d55b08eaba55c3132b3d5a03e007a0c1ab4462b549e1f",
      "text": "kalih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bf65a0dc72f66357bf042c8f8a2214af53ab6173b52df80a670f01fe1ec1732",
      "text": "Badhé tumbas pinten, Mas?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d6fc2cfcf86e879e6e7d5dd5ffa32a00d071b6e8afc735d6fa7b6c3a4abfef6",
      "text": "arta",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df33c35584d799262b86960704f1d31b1119ee875079afa55c18078b6733b5f",
      "text": "gangsal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef61711d22be259172645720f3f843554a6e1c6a5df4e755f3af863bc1ec867",
      "text": "Mangga, Mas. Badhé tumbas menapa?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "62cb992e42f55b16b066e8c19bdb2326b88ee4bd474f47987860506bb6b9d5e3",
      "text": "Tigang atus ewu",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "64f5117123e58fb28c391238d2125e50c230035e91a45ac0f4b9fd3ff69a8598",
      "text": "Batik tulis menika tigang atus ewu, Mas.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "687c40f9f492918ab9cddf027ad6c2f8ae3e66d8fecb17943ce66d037a6a0382",
      "text": "Reginipun pinten, Bu? — Kalih atus ewu.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fe410f460154aa6ec0ef75e4fde5b8959744fc816a034cafd87eb32fd9dc115",
      "text": "Seket ewu, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "71d572ed109a75078d42ba555718894a494126088f2ceacea8c2107543c34dd2",
      "text": "Kalih atus seket ewu, pripun?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ac127db60a91dfa86320f6c0f0927b612ac231344965a2da8e32c7be07ed66",
      "text": "Nyuwun sewu, Bu, reginipun pinten?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "75f5d0106cc8256ba1c5a455b24990707d4d60e9a9be0957d8d6ff6fdbd9ef53",
      "text": "Saged kirang, Bu?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "78d823978a9a05fadbab856e10cf7d788bf240f6ca37ba68acef994006694248",
      "text": "Inggih, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "818baf3c98087adcfee4cbdde2ee04711eaa4c37ef062cf61feb7c5248e80e67",
      "text": "sedasa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "849a8e127d41d9b358dcfb003142403a8fa6ee0d67c32c154d583f90fe06e973",
      "text": "Sekawan dasa ewu, pripun?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8886dbd42a263f6d58af91dd00aa1fa02f950d170a80f0772f319375e84f6e01",
      "text": "Ingkang menika batik tulis menapa batik cap, Bu?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ca0aa7fb08512f6daad1d2a54304d4501d86df90a870f44ebd6a2e3429f5252",
      "text": "Gangsal ewu.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ca5273181e9c9ac75224b9a9542b2eec39eb0387aaffa04205b2eecbc829e5f",
      "text": "setunggal, kalih, tiga, sekawan, gangsal",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d45892e642eb9548dc32213d3a5f569a690fe47e4b6574297cb9de7957b602b",
      "text": "Kalih atus seket ewu.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "924827f8c01caccbb4643b1d214108feb646fb4200cbe0838d8a514fdc9454b5",
      "text": "niki",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "96d822d06e99991f13d720f91b44a774959caaa6d1767121dd711a181489c06e",
      "text": "Wah, awis, Bu. Saged kirang?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1a279bc3ca1441abf5caca519dd084397ee451ca45f9e04dece677a22425227",
      "text": "Sekawan kemawon.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a599c04e98a1311a42aac5eb0bbb02d179be30b980d364bfe8d38765406ad35d",
      "text": "ingkang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1d8c8bf140feec204c93d93ec01efef00aa0110797fc691ab2c981fdff23cd",
      "text": "batik tulis",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae02b857ed864ea0afdd2a2f20e6a00eddb237d87e9125a3a8e00d3e7266a89c",
      "text": "Ingkang menika reginipun pinten, Bu?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0cc9f53454f2ddf71017496488dc0789fae01d258e95c0983dd60c668b1fecc",
      "text": "tiga",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1710b4a093940d2c3ecb08ec35008f5c716402d5ad612fba3281943fdab2697",
      "text": "selangkung",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b257c7a5d4ae5c859bf3c2f7e3ba2c08f37ffb869e243120f742b3fce22d241c",
      "text": "Nyuwun sewu, Bu, batik menika reginipun pinten?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b340c0fe1ebbca8a63243ff3be1e3f1feba1e5c09ce925e85bc272b1d3a9f8c5",
      "text": "Tigang ewu, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38d9913aa5da4e49cf8e3bfd1a055d42746ebb7861608bb8a5d5158c31ebdbb",
      "text": "setunggal, kalih, tiga, sekawan, gangsal, enem, pitu, wolu, sanga, sedasa",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5464ae4efd210217dc7be8209a318addbab0dbc1750756ac483435359a2659c",
      "text": "mirah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6194d44cfcaa06900c19c7fbe2af352a59d9203d8071335f4d5b729632f28e3",
      "text": "Kalih, satus ewu. Inggih, angsal!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b63b7098e729b1d0106eb145d41e23a0f2a7c05fccc52875986bccd1a721255b",
      "text": "Matur nuwun sanget, Bu. Menika artanipun.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7ce421abb39b431d7aab45679b587fe39a7bc7e066254eea82130e4f6c389f4",
      "text": "Tigang atus ewu? Awis sanget, Bu.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b834a351aa91e01fe4f343b110546bf14ef1697917fb2924ff7c1f578dc1b488",
      "text": "dasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90ab8790202907cc0f8c69b0cf8f9018785ff750aa9be879e71e1c2a9585e24",
      "text": "atus",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb58f1f6ab0e536e65f4cda9e0ee54e8b3673dd9e5d9e44933578b0d4776c1f4",
      "text": "Saé, Bu, matur nuwun. Batik cap menika reginipun pinten?",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd1ee2a7ab3a88cb8643edd0e3be026ebe703ab08e6c40a38d32eae365dd6eda",
      "text": "Wah, awis sanget, Bu. Kalih atus ewu angsal?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf26694ea35ef616b05ca4fc8d700c6527581db83c86e59f58ef56ec849e847d",
      "text": "Inggih, Mas. Kalih nggih.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfcde6e584476828cee3df03634b0ea2b0486a1fe904de8016fd7a402094c34d",
      "text": "Kula badhé tumbas batik, Bu. Kangge ibu kula.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c28547ab45c38f05543705600076b62bc134808dbb7e8275de2c8617d87d27ff",
      "text": "pados",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c381bba13f8443d6b174a1e8aaec1b48d4a6632f896aaecc0a2b9f5c785c3c94",
      "text": "Kalih, Bu. Setunggal kangge kula, setunggal kangge bapak kula.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "c43fc14c33550036bd4679b23e46a95cba191554d8c49b6a36b36fea54172221",
      "text": "Kalih atus ewu angsal, Bu?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb61c79ee8556fc233b8f619ad7335a38279085667f749111e360c7fa18527a7",
      "text": "angsal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2c97024b4f788287ffa87122e2a9585edb345ecb38f79c669f6fc4b78c7f99d",
      "text": "tinimbang",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2d2882f4f2890553546bd3fa98d22dba401574ad15ede8184f04654d55aef84",
      "text": "Mangga, Mas. Badhé pados menapa?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7cea4c1e6bc29c062d814f78d31899a906687765f4b069a09888944930bf764",
      "text": "Matur nuwun sanget, Bu Siti.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0c6c60b9aef09ed2742d4bebc3409c7c31f5c63c597f85357f9a4f4e062462b",
      "text": "awis",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4add6dee011a20c438b6948aee0c12a8c4501a4f7694c2171c1e4cd976df9f9",
      "text": "kangge",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e94a19e076b82f7d2a2e0e549dcb5afb2db8732ec4d9c4cb264e956f3134bfd8",
      "text": "Kula tumbas kalih. Satus ewu angsal?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb3033c4a86830c79bbf3ab8c5ae8a52229fea8323d7691569544cff5d39d5fa",
      "text": "Menika batik tulis, menika batik cap.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
