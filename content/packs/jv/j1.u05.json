      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c3aefe5efe11e13ed253c95721f287821b1216567569d82bf5782565f6bbd9",
      "text": "Kowé wis mangan to?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8b6cffffa3080f57c14175b5a1e6bc46524746c708735e102e4c834be15ec51",
