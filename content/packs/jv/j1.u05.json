    },
    {
      "id": "j1.u05.l03",
      "sha256": "231f70987c0819ad04a378679e880a539382f28c7b8922c3a9472f828a9eed64"
    },
    {
      "id": "j1.u05.l04",
      "sha256": "f03969a3be930a671c9a0a3019714236da6f81a6974b198bfb7f910e55737e21"
    },
    {
      "id": "j1.u05.l05",
      "sha256": "71c190f6d0cb9c5f811728ca70d9c0f4199c705b26677930b9d5b5a8e66cc420"
    },
    {
      "id": "j1.u05.l06",
      "sha256": "c79e296e40001caab61f748f761c2cb13ed9c4c014d283236b3940da11d8d5f4"
    },
    {
      "id": "j1.u05.l07",
      "sha256": "92b65b4c3c869804844e3db7504a5e4ce265ffe304a464458c0604184d0fa7a3"
    }
  ],
  "audio": [
    {
      "key": "0221167f17cabe95e6232083dc58e4174bb0529cee698113a35e0c8fff1ac557",
      "text": "Aku gak ngerti, rek.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "031a26770909751410cdbfdc5924a8d60109aff72649ff5cbce0910f268b9258",
      "text": "Gak onok, Ning. Lontong balap ae, ya?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "0361cf277887e5483a106d23b4fcc4371c95acc05e93c01ee18b1ce38e4014f6",
      "text": "Aku eroh warung iwak sing adem.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "053f7e39df5553da22c6ba7c57217796476407f0ec191ea1fb8d14981b7462c6",
      "text": "Lho, koen ngerti basa Suroboyo ta?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "05d0da07baf32140d3fe58f24e5d7bcbb8f888e85ec7d7cc6e76eafbbc392325",
      "text": "Wis mangan? — Durung.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "06e0756cda6f85061ace4000276624ffeb6205f395d3d23c83923f6a8f425cd0",
      "text": "Sampeyan wis mangan, Pak?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0736a5bd741461f4f019580c6df37640204cbe1830541192f621d8a0a0adcfd5",
      "text": "mek",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "08d60be537e6b06df2ab48fb227fb9468703a583ef5116e78ed1ffa459da6f58",
      "text": "Lapo koen gak mangan?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a97d5c5d8364d2c310860b91b3eef1833693759d741da7a56c5e9b92aa1bbb6",
      "text": "Iya, Cak. Lontong balap karo teh ae.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b45e85141831b5e8555afd562d98f1705b3330a27a7c6a56a1fa56903bcd28c",
      "text": "Maeng aku ndek pasar.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "102a9a6e76f7269461105c36962cec1832c144227ec7807bd35f96fa69b6b40e",
      "text": "Sepurane, Cak, aku gak eroh.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1465acc941942f6a11052fb393fa2ce51a9f378d93b1c27f0269ac84d66d107f",
      "text": "lek",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "15bcb60f55148ab85fb412af4f0502f7c28844a3d05284be98b6ee606f7e1dc5",
      "text": "Lontong balap onok. Teh onok.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "17f1d62ea26c3978a7b758501a851db6204f34b29102af9826c3f1527adbeb2c",
      "text": "Kopi ae, Ning.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1adad6431e1df48df2039a1a75a6ad27ec451fa3d2e1b625be8ae79e60656365",
      "text": "teko",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c1f9b403bb6eab233032357a58ee3057462f78bc0644d2d6188802fbbc718ca",
      "text": "Mangan lontong kupang. Koen wis mangan ta, Mohamed?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c4c00531ab672542e8467ba2e5e40b5812c62807eb3dceb76f00a13e4ab68ef",
      "text": "Engkok bengi cangkruk yok! Lek onok wektu.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cd1af692f4f283bfff44e06f380a40e7cf749fbda4fcded2078e0be2064568d",
      "text": "Hahaha, iyo, rek!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "1efbbcc4747a5298ced66b5e7dd765ef3349e00f91d0323e21de7367191c0fb1",
      "text": "Sepurane, aku gak eroh alamate.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "203e0cea1f0ce718c4ac1416f52659ec35f8bc4737c8cb334e8bd62254d07ad4",
      "text": "Yok opo kabare?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "243daa066ca12197da3323eb47b3b577ed8495a35d935fe41cba04f3c2019f01",
      "text": "Aku dudu wong Jawa, aku wong Mesir. Iki omahku, ora ana kopi.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "257bab8c33c1016d6c0392ee11199354480881aefca1ad130ac727f650e0bd72",
      "text": "cangkruk",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b9af132528bd16e00a51eb8c598bc91d7558c4997f4e5c0abb08f0b7a9f3c1",
      "text": "Iki dudu kopiku.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "27d5fa76bade4d6e7ae36c69cab5ebb2e72a4947aae3380136e81a4db0999da6",
      "text": "Kate lapo nang Kenjeran, Cak?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "292b56370f6664200b884f15e118f5933bb4a6658a0f26cac233ef27b505ba5d",
      "text": "garai",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d2279fe6863349164d0147b63ea87e615060eb59abdaeeeea327cab069347f9",
      "text": "Rapopo. Tak ombe ae!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ea2007179557f6d6eb9a9aaf1a7f1db92bd58e9565b4f473dfb3b18b3d7ba12",
      "text": "Engkok bengi aku teko, rek.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "366dceeea6cf676e0b6551e25deaa836d60548edb919e46bd7ad60925032d4b8",
      "text": "Kopi gak onok, Ning. Iki dudu warung kopi!",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "379187c33e31af5b61c61fc821bdb5e3bf9c837835e639e231f6f0a4d1cbaf6a",
      "text": "Lontong balap ae, Cak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "37ac7ace055ff5c4cc877845f952f5dd490d6076689e9e36b42772f8db11d43f",
      "text": "iwak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e59f622c68530ec19366269a7e7003c0cfde3bf8eb285f49faf70df93c803a8",
      "text": "Ayo, rek!",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "42f2661d707992d55fa4e9a3cfb0cebeda4429afa4485206f196fc5f41292173",
      "text": "Lho, durung mangan? Ayo, rek!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4392ac460d23815618eaa120c29e4ee9db9e9a351a15f60a85a984038b8a7791",
      "text": "nemen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "44c963d0490553d735a9ec16f1c0be3bff1072aa08e368adb4bc5de130be8bb0",
      "text": "Kate lapo nang Kenjeran?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "45f2bab8e6a41e74c81878d42709f09e6fdfec76ea3b6d16329aa44107215f06",
      "text": "Durung, Cak.",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b407f537389f3b769a7db139e96ef5032a236618c5781ca2ceb10083130e0b0",
      "text": "Kupange gak onok, rek.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bcb4e432ea8d6e11bdf39e8f1503883a598bcc708c0cda3a6aef3a39211921f",
      "text": "Iki dudu warung kopi.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fadc05bf035f7b61612494b97dda3a55c307832936ac1396c8da8010f4275c7",
      "text": "Aku cangkruk ambek kanca ndek warung kopi.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fff5b0e3cf3b729930d961c31036b9e0c246818c21c5710a9ecce394548f86e",
      "text": "engkok",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ce84567cedb75cbb1fc035be0c0e3b3efa80a5f461b53a83cf5ff08d4cd6bb0",
      "text": "Iwak bakar enak nemen.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dde0f05ac2f27e3fbcbd960c3c77f72c83176b88c8c793481d7bb1c9879779f",
      "text": "iki",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e571ed32b3446d293a32ae8c952d088cae96fb6b31a99c85f0b72981d742536",
      "text": "Sepurane, Cak, aku gak eroh panggon nang kene.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "603f6c926fe634a18f8a0b4b1a830b42e1c3d3ea2876623f1082dc2b51296e2d",
      "text": "Aku lontong balap karo kopi, Cak.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "624ebd1c50f6d1ba367f4fefe17f0ed15245bd0f85119e3706e0be81e6196c7d",
      "text": "Gak onok, rek.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "67206adf9c66a64697cca156e972878371780a165ca425c4ff0c42c4dc9793ff",
      "text": "Durung, Cak. Aku durung mangan.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "683bd2920103e32cb59e48456f3cae83a9c7b87b71dc2397ce996c7ef43d5479",
      "text": "Onok kopi, rek? Aku kate tuku.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "755888da9cba53a3ef8505fcf5efd9edd2be746919a841039b09eb45857b34c9",
      "text": "ambek",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7770c1c0a1a5bf447193be676c7ddb55c106d6c8192d1474c07f68efb2f3c563",
      "text": "Kopine gak larang.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "7873266b2fb124a2755a434407da975513bc89a8f3f12ff2319946f12c33877b",
      "text": "Kate nang endi, Cak?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "79fa94070e94c8dc06c0b0089e8e4e6dace33fd20f844c396d6c447307a433ad",
      "text": "Sumuk nemen, rek! Ayo golek panggon sing adem.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "82511192b271f6b549a05acf279936eec2edb3983522c5f221392a4956830191",
      "text": "sampek",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "859234f58ebf5608b5542a4947808851895a6b2de268353a1ed292c3b22235ce",
      "text": "maeng",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "860ae5b891cb7bce850039df093617a9fdf1d2e102ca71b1c7fdef759191ed82",
      "text": "Maeng aku ndek pasar ambek Mas Yudha.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bcf1058d11127ea6495b76a74cb74b7fa98fc98ff575633cb12c05cc6daeb5f",
      "text": "Iki ___ omahku.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dbba695d5c0663e3a298b5ea02ff6047aa14b51ed45728ffbd6b620a4d0a909",
      "text": "Dudu, Cak. Aku teh ae.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dc520292ac19af002c31c457a4c833a02cf438f80ce75d49cb3a1fc1a0a017f",
      "text": "Kowe wis mangan to?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "92a598cd5693a6624185d4e6e396d0c80c8cf747dca21ad91096bda910081f75",
      "text": "Sumuk garai ngantuk.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "967d478ef899e0f3cbcd8ee639faaba7c6441ab8595f02c86b73ece16c932d4d",
      "text": "Kate lapo, Cak?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dec662803fb8e685e475abc5dd3a3b65ee440155331c1299722adfab14c1a79",
      "text": "kate",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e4355e717d0fd0a67e79487ae4aad72d467209d2f0c5274aabd8757160e0fa7",
      "text": "Regane ora larang.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f216d9cebebf17bd33de8800821395955e9052fb2ffc2038ebe066d0a1fcb08",
      "text": "adem",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ca109bcb3a1370a4365859fcea8a009591f086ba7c0934bfc599dc25a03a3b",
      "text": "Iki dudu warung kopi. Kopi gak onok!",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8b6cffffa3080f57c14175b5a1e6bc46524746c708735e102e4c834be15ec51",
      "text": "ora ana",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9c8c4fd4a222d3c504f5e0e80d6d7a5253957df65abe1428e79697d59508d10",
      "text": "Lek onok wektu, ayo cangkruk!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab0f0b5e2b432d0aa058c95be3323e106827482003fc20c1eb182321b45cfbcb",
      "text": "Lho, kopine sapa?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b65622b4d80ef5262862d4848c5da0628143b313efc0ce0fcc1a3c4ae7446c08",
      "text": "Sip! Ndek warunge Cak Man, ya.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b66f7eb4fc5e08991d867c4ec98d327e1d0b5ce4fc339b03f3271ecbea3f2351",
      "text": "wong Jawa",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b787c62c8c743a43ba85acdfe7714ed6af7b3590f3763c64ac8c2dffc26da750",
      "text": "Kowe saka ngendi?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a6bf4a2be1a5a7b5048bdf9ceb7e11f3f4943011d32253f24db2b42420cc2e",
      "text": "sumuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbf41a97bc895f155ef619359ea773833283b98818995fd23ef5b0fc647a2608",
      "text": "dudu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc86817c0089a82f6bfa3389df2d96d0bc018e1c1ef7488b95d4d6f3b1793784",
      "text": "Apik, Cak. Koen kate nang endi?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf02abde5d43a7d8230bb90fbb53c918759cf4b52a2c5644ac387139f381d9ad",
      "text": "Rapopo, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfccf2e11cb16fbf868f2ca309db1138098f3f354d38a4e09f836edd32ea1e3f",
      "text": "Aku saka Kairo, Ning. Aku dudu wong Jawa.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0ab6fe0bd8da58e97d649d859f86be5e987b6ca60b9a2d031fe9170b867f126",
      "text": "Aku dudu wong Jawa, aku wong Mesir.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c18f0fc3d8f413532e066ee46677d2e7c77810b743a972417a1545276c47c5f1",
      "text": "awakmu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c24613153d7be2eac843b18976e028cb1c26b981ce3ffd6a8c5e299545c3ec54",
      "text": "Nang warung. Koen wis mangan ta, rek?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c579bb9f37b18ef783202968cfa07f0c9663a7242ff3cd2865266501a9e18660",
      "text": "eroh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0725653c7fe9b256345b44dc0c413f84a62e55448e98797db72c0dac2d3c742",
      "text": "sepurane",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1d4f12977e470fb4662b982d83cb1f4f40b0082d97c3c4418da0ef80c6605ef",
      "text": "Lontong kupang gak onok, rek!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d16598d7628af59e5549f7faea33a6b26d3779a55b4bc0964e2c98e0349573",
      "text": "Rek, ayo nang Kenjeran!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d753bb3c71f29ef828ba46cdfa0ac92ac4f21cc5913669e5cb27347b90028338",
      "text": "Mohamed, koen teko endi?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "db367f1be175cd5c43bc89b42114b71ab12bf979c30700929f3f470ee4a411af",
      "text": "lontong balap",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "dca3b1bd0ada7f569d15f67b89bffab70065b11044de24a2146ad21edc48210f",
      "text": "Lho, lapo durung? Ayo, rek!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfb61b42856ec5fc7ad88c563c11ed76815efdac34364531c3a7a051a8f61acf",
      "text": "Mohamed, ayo mangan lontong kupang!",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e023fdfdd3578458e7c8417c9fe4845c850ff1c1a3df5ca39cdc63b6070ed09b",
      "text": "Aku cangkruk ambek Cak Heru ndek warung.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2e73223c246281ccb241689c8fc538762c75ebf4db63e609b6f4ef7d074436e",
      "text": "Aku ora ngerti, Cak. Dudu kopiku.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e36a898084ffd1e62b31717241a6d4ba10bc05ea7fd35cc11e6384fd296f4773",
      "text": "Mohamed, iki kopimu?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3b2d8e5da70bcb8a82be84fcba184f0ac173da19a9cb05549491906b3f0dda8",
      "text": "Yok opo kabare, Mohamed?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3ecd3b3c29695cac4c14a03b1512a025a436f07578095e7229c96bc5171f750",
      "text": "ndek",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e62ca91e5d725a3dcc1379d435cdf831f4cba952e3f1e0b5ee1481f19ec8cdee",
      "text": "Iya, Ning. Koen, gak, onok, kate… rek!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6f23ce5641597536edc3f20ce4f8d89b20358949a788c83e26b3e75e8052b2f",
      "text": "Sip. Tapi ojo kakean sambel, ya. Sambel garai aku ngelak.",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e866484f5a404cc717244a23bbe3c37b4f18e15a10afa6777cb293c31fbadd4e",
      "text": "Lontong balap onok, rek.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea3172ad5879c64bb82cea0dcfb787549f2e895547848d02f211a7be9df47d98",
      "text": "Engkok bengi aku teko.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb4527f48450149e47f5b2422bc1b1d7ebfdaf886c35b84927ed42a703086543",
      "text": "Aku ___ wong Suroboyo.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "efb34e74384d68885d22d17798e8fde2e273217168769826dd5132271a3fd2b7",
      "text": "Onok, Cak. Tapi mek sedhela, sampek jam sanga ae.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f136ce8e9310bfb730efa5c7e6b9a2eaca6ea789c8ef36226b870dc3f38571ce",
      "text": "Koen wis mangan ta, rek?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f243465f86282e5cc9df16393eeb1b18b446c20ae6f4a3d7c28a5139afa67b1e",
      "text": "Aku eroh warung iwak bakar ndek Kenjeran. Adem, onok angine.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "f247249af00c956ede36f08de7618c4134e13827f93cdc3dc0f499a05deeddb0",
      "text": "onok",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f57e579ec3d3c22801f6efce3885d9162e839f6bb97ac030590a12f6bd91bca3",
      "text": "Rek, maeng koen ndek endi? Tak goleki.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f69a01ffdadda95122777eeddcc01514cc48050fe82fc841b735ee9e8c3cad87",
      "text": "Wah, apik, rek! Koen arek Suroboyo!",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f770288b3c943bfbb62eb3d90d1ef652bf5e61cbb8cb442e317b2f0572951073",
      "text": "Rek, ayo nang Kenjeran!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f83ceb91447fecc0a8844344bf6f63e8f51f6f81e100faf708021d5168fa9034",
      "text": "kakean",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8d49aa6da1e0d3fae509e942d8a7c67b79fd4b36eb0235de763ec46da5b8961",
      "text": "Kopine ora ana.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8f5b7c516ab5e2a836be3719af332419f5dc2b4f7de91ba7fab3948d8a5fc11",
      "text": "Sumuk nemen, rek!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc41202bc9a734bcfca40d551707ef6689337edb8a8c17f35b5ed2b4c625dbe0",
      "text": "Lho, Ning, lontong kupang gak onok.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdaa5e8714d2d9fb47ea068add39667858df2207de2be22b4d481c4b074981de",
      "text": "lontong kupang",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    }
