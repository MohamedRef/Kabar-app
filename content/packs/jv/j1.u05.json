      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2a6426a1dcd901c8e37684c7ac575960c02e3b0fe81a9b8e3437d6b2fdc7132",
      "text": "Lho, kopiné sapa?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
