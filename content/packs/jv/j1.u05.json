    },
    {
      "id": "j1.u05.l10",
      "sha256": "15af079e7d095b51344be16656d660e72e58b98c20c6feee8c7bd5733f2c416d"
    }
  ],
  "audio": [
    {
      "key": "03fd2b10ee998260f24f0d7daf3d47f5303cdeef22a28e81a1c078b757fe8ccf",
      "text": "mengko",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "05d0da07baf32140d3fe58f24e5d7bcbb8f888e85ec7d7cc6e76eafbbc392325",
      "text": "Wis mangan? — Durung.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "067f5a4d9075e21290bea11dbc07c25caea4ccc3310f5b1d3ddc6eda76865b5c",
      "text": "sithik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "06a7e25388ee6b2a6d88d53312f9c2cc460afcfc6db0b9a3d9c99b561be6ed5e",
      "text": "Jagung bakare enak banget je!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "06ff780ea705814e6409eeef683fb281f58c835fe568cd7935021bcd2fcc6229",
      "text": "Cah, mengko awan neng Parangtritis, piye?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "070b7c972f2ebea1da9985c95fd15e7113ca1c156373dd9cace57d84393b9c78",
      "text": "Aku mung tuku degan, Mbak.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "081d02e931ea217cd13c8a1bad02117b981ac4b10dc4a9314656d59b157e1624",
      "text": "Iki dudu degan, iki banyu putih.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0945d5443a6ace7b7c1a2032a626ffa5787a9cc0fd133e2ee59e80836cbbefb8",
      "text": "Ngapura, Mas, layanganmu tiba!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "09c6fb20b767fabb55069e05818e9286532b588349c7f3a9b969dc116ebe870c",
      "text": "Adoh tenan, Mas!",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "09ce6fd54dac1e3084b835f963ac353812a721f43623e136c8f0013bc023b63a",
      "text": "Yen ora kesel, nongkrong nganti bengi, ya.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb12a43fef5dbc24b113f6438381aa68b9acbf37973bf7fba573c368ebce55f",
      "text": "Mau panas banget, neng warung adem.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e536bc98c91b05a1cd9761016ea3808dfb4a1eb4ea2f4d7bcaf8e6c9c40d5b8",
      "text": "Sithik wae, Mas. Enak tenan!",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed793b9c249dce3f0735cdd9fa3b76607c47deaa6606ea6bb3e181444fbc5ad",
      "text": "Sikilku reged. Alon-alon wae, ya.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fc682119f7eb9257fb7e1d65fa89eb3403ecb3cd2db9a73b8ea030e24756171",
      "text": "Ngapura, Mas, aku ra ngerti og.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "11d97f2ff7a417a64692956dfb62b4a639b3ab44bc73a415ccd6d1986f5ce058",
      "text": "je",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "11dd28073f4b56413f808276f2307f9468c8ab50f3c03e367b7958d76ba7cac4",
      "text": "Aku ra ngerti, Mas. Dudu kopiku.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "135661401e402150b2fc623d3cca59c2a5c647ab27f69012d571eb94f45a003f",
      "text": "Ngapura, Mas, aku kakehan gula.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "135a22c40d7999fb2e6c098c0ef8c6d0959718d0be1f42895dd6f5ed170bb587",
      "text": "kabeh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "140832d26b0fea5d98d7b102cfaf792dd5e048720742af90c16391453c4066b9",
      "text": "eseman",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "14b9ede4035005623190022a4221b9e854d61b3b231d8bcecd1a7137341c13e1",
      "text": "Panas je!",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "14bd3b91281e8f0fd603ef70d342d7f177e2a01166cb829d1bc5f250f5a35bca",
      "text": "Mau aku wis tuku bensin.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "14cdb3f575fcb48f5b2bcc20b57ecb1830d4a35a07d10c31906082b16249fb7c",
      "text": "Omahku rada adoh, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "14d0bf0b9b10ff74dae8cde968308dff821cb56b22e207c7f5ed285c07a1c442",
      "text": "nongkrong",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a8c1aeaf3dfbecbbcb9ed17037f841a138bcf66590a2902c0c5776e257b8f96",
      "text": "Ombake gedhe kaya omah!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d037fc5dbb0e002d19bca4e3bce7815b34ce673fc69c74052ea3b6e54898a00",
      "text": "wani",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1de66150b9461dd44a30eb20ac1eeffe8752c67c6cb8d84e3b078cf41730f2c0",
      "text": "tenan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e00709ff30bed78784223d37afc92a53cf080770384a8511732d179ef85fe06",
      "text": "Mengko jagung bakar wae, ya. Nganti bengi!",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e57d71ba4b3c686ec43fd18df4d593c804c6d72748e8f14199233650628ea64",
      "text": "Sikilku reged, akeh pasir.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "23c06df16ed87c8dc772ed0da240eb903c773033a711efa957ae10e166f4479b",
      "text": "Wah, panas je! Sumuk banget.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "243daa066ca12197da3323eb47b3b577ed8495a35d935fe41cba04f3c2019f01",
      "text": "Aku dudu wong Jawa, aku wong Mesir. Iki omahku, ora ana kopi.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "251d9f88c82b8c55de6facc75f6d4a2c3d00ae9be2325b584beaaedc7c52e141",
      "text": "Iwak bakare panas, ati-ati.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b9af132528bd16e00a51eb8c598bc91d7558c4997f4e5c0abb08f0b7a9f3c1",
      "text": "Iki dudu kopiku.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "264fb35f2ecd0b4b9daa01834f3db2401c74c4a52226d18134283a0604ac8e0a",
      "text": "kakehan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "268121685dc007b06fa0f56326b3a6a172bba59827f3b20c770f8edcd4db72e7",
      "text": "Kopine ra larang.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "29c217ded7dd18f8419e2951a0f4d51df55af0050ac95d41b4646992bd3e854b",
      "text": "Mengko jagung bakar wae, ya.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bb02bb65169a2f8c42c8fc997ed65088ec2223043805b7b2a6d29db6d1a24da",
      "text": "Iwak bakar karo banyu putih, Mbak.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ea7c1e788dcf685fa99f6cb072f1af058a8bc5da48511e55cc63efdbb986610",
      "text": "Iya, ombake paling gedhe neng Jogja. Ati-ati!",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "32810af58a646ef26be0f2c359166483a3b9ebef5429bcdf665ef79ab7b833d6",
      "text": "Aku mung tuku jagung bakar karo degan.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "35ab8d12e6168a3ada2669ffa5765640f848c60c94b3eb8f0b98855b3e2a8714",
      "text": "nganti",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "37ac7ace055ff5c4cc877845f952f5dd490d6076689e9e36b42772f8db11d43f",
      "text": "iwak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "38b72e495671c61f1d4ac8cc51bce55d8848e0133851e6f272c6807e6d0e5b7d",
      "text": "alon",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3959234ac1f1e36a87a84dfff7fa31fd7a014174bc6e8da28e1ac3a63fe85d5f",
      "text": "Degane siji apa loro?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "39fa03e683e447c2e73b4558dff836246d52c1f495b07ac312a69ad6576897b3",
      "text": "Ombake rada gedhe.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a225a2c35bf8238dd0f80ae508f3b219273c7c6ae7e33753ccf046d2ae85847",
      "text": "Aja! Ombak neng Parangtritis gedhe banget. Aku ra wani.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b761485364e6e36ae9dc6ffa6b4146206703152002ed43a053c751a151abf70",
      "text": "Piye, Mohamed? Seneng neng Parangtritis?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bb3ae17e7b9d3fb662716fd998862e92159b1e3905ab88a996278cec4c1bc5a",
      "text": "Mas, Parangtritis adoh saka Jogja?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf9a3d17240c2ce3b8fb866230bb4c3e12f192ad4c250e80739aa33ea10f0c0",
      "text": "anyar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c0778996ce369d27c4d10c5477a94901a21e297b9bcf8bd0a683b2253332ac6",
      "text": "marakake",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cc912281508adf2d5552336d0736b632aca61e7d3e92aacaa5b9c44ba625134",
      "text": "Sumuk banget, Mas! Banyu putih wae.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "3da2f61c45941b23f7ffbb6b858f844885f5aca67617121319cbaaab3c466ccc",
      "text": "Degane larang ora, Mbak?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e00bc3c74fd0eeebd26a6d9e8cbfd8f3f396934f5a771d71a74a4cd05abdf1f",
      "text": "Panas je! Ayo neng ngisor wit sing adem.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ec35a886aaf9b0daa45b2e505389d61ba9079aa00d6dffbb38dcdc1a2a9032f",
      "text": "Seneng banget, kabeh apik!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ecca6e57508a338e97bdd66507da1a5c9f35336cee6a960dfc054f55b85348e",
      "text": "Rapopo, mung kakehan gula sithik.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f8f61000654b660b9b79a9b42915360888efda8eb384684cf6fce85cacc99a0",
      "text": "Kok meneng wae? Endi esemanmu?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "42045482f463382c072b1b4f28c433d8b6f8b76c1db2178e3d979572d62cc9a4",
      "text": "reged",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "439c49dbcd5408f1d18bfc3c179a424dc510e2e8f78bc5d381cd0b8db34ef20a",
      "text": "paling",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d1dc85a2cf5e5294ae53f7b6d1d429359b87268c580645901b30096b2e00fb",
      "text": "Oke. Iwake panas, ati-ati!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "45568098c097e8834cb16d3276f9334b7150c5ff088c5def58ce9b4355e94c44",
      "text": "Piye, cah? Wis tekan?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a966939dd6c98ab87c03f564f41d85989a4d466d8b73af0201c10a851eea815",
      "text": "panas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c8812026a124c1e7fb6ba6607b54ded8bc9077dec740c906a23a2c7ed8ea565",
      "text": "Yen ora udan, nongkrong nganti bengi!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "51dd69be3238f6114dbeaba1732d326379d380b290f87ac7f5f7d890c0d266e7",
      "text": "jagung bakar",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "52aa7ce0ad3ed53b776ed8933609addf2227df5fddd8c15822e6754662bfa43a",
      "text": "Pantai iki paling apik!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "540218927a07f0b9ff0a355eafe9aaf0aadb07787b1a34f9383a1728abede3a0",
      "text": "Wah, jagung bakare enak banget!",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5448e9fd8709bbf9922399b21a872e527255b3d08f388cf52e0fc804e3280f9e",
      "text": "Ombake gedhe tenan!",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a6e66363e85ee3d3ce2868a789cbd4037f760f4209db550be9f550e4b18c6bc",
      "text": "Degane pira, Mbak?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ee31e82f2c6cc0744e9f2863e914b2449a153ac1d2a5e8851efd5219798c738",
      "text": "mau",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f43b68f4ccac386e7b96432c72aa43638509300208bddc4e59ffaf9ee090248",
      "text": "Ngapura, layanganku tiba neng pasirmu.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f49b5e09142ba98566869ee941acff9572071ebc9cb93bf18b1e57c47f53643",
      "text": "adoh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "627cd06977da5973c192a9d1759f64f5852e642e56c8aa4201d9fa0107532143",
      "text": "Sugeng siang, Mas. Arep apa?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "630fbf6eb7b8df5947b311cef3435a93d892df16620657456a026ace2e0f7d59",
      "text": "Oh, ngapura. Dadi mung dolanan pasir wae?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "641fb1dda5a5412a62a92eccf9f6ae620e45a87e8770b3a06a01cf6db4e89bee",
      "text": "Mengko neng pantai numpak motor, ya.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6453d045f8f1bfe5f0f9a5415749f5db9ed9553dfb6bb8af88f20ecd62b04d50",
      "text": "Parangtritis adoh saka Jogja.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "65493c6546074536043035c5509ad8321f8cde6a1b07baedd5ab6a238d761031",
      "text": "banget",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "67150b636166a1cfea8a867a1cbaab8b85697f61d63ecbf29779f0de421d6967",
      "text": "Iwak siji karo degan siji, ya.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "671da43f76595669efdcc61ec4e62342253e32f3c52fcfc6e4aa948d66dd4348",
      "text": "Wis. Numpak motor mau, panas je!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "695ace8ff33eea3e730c9b0fb2b59dde0c054aafd5298ed2a06d036e6e87b810",
      "text": "Wah, kowe ngomong kaya wong Jogja!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "69b374fe192078f9f8c69af8b60175fc106674cad88e1edc4a6cf861a888e8ed",
      "text": "Mau ombake gedhe, mengko mung layangan sing mabur.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d0dcf8eb172892a8707cb7171f9c1383ecaf48bcff0eb4a43834fcc2c6d0096",
      "text": "Yen ombake gedhe, ora usah adus.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d364be6c3a29dda609a126545f0a12d1f0162f6250f67296fe35e1d86f914f0",
      "text": "motor",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ffe6b438b36828f9bd425bdbf1002a0ba848a1f83c036bf27290fecd03bc074",
      "text": "Aku ra ngerti og, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "72e3ae047bca96cea1d999228a43de40fdb7aa3a7822ac0e7c781ca87b61c8ef",
      "text": "Neng warung iki ora ana wifi, mung ombak lan layangan.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "74956218134dc83ecad4556f844704799bd57d6900a1772156a0176f1aa9d03e",
      "text": "Yen ombake gedhe, nongkrong wae neng pasir.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "799394ea532ca6bc003281ce27aecfc3490847f9bfdd360b276111b6312fbfc6",
      "text": "Alon-alon wae, Mas.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a9557ca537744d9d508b5df92495a878b8c5dab563450bcdcd310eced9a88f7",
      "text": "Iwak bakar karo banyu putih.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "8498d6031f8b02ab525c9fbf095714ba7bbd57793e2b785ac1e0bd0a02904012",
      "text": "Ora larang, Mas. Iwake ya enak lho.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "85b3b2e9fe84fcb06b37af996b0474c97b1ff13d9896585e69c6b56d1025328b",
      "text": "Ayo! Numpak motor?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a06083554ded96f0f8b83b07b48991c29e9ef2a273acaf1110a251fb3587027",
      "text": "Ombake gedhe banget je!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a25000aa33d981e5e28ff92085aa45c96b1215a4ce01ed414478969c3d2513f",
      "text": "nglangi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a85c03679cbf098bce58180d0daef8e21808063e87d1ccb3d28add1a0593643",
      "text": "Kabeh kancaku seneng degan.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b216b53f45c19c9da839d05ef0a64cf044d229a838e74cf7e53ef4bb4808e4e",
      "text": "pantai",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b6c4b2113535fb9f50ac70ac692631a5add1d490cef0d572262906859be6cc8",
      "text": "Iwak karo banyu adem, Mbak.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bcf1058d11127ea6495b76a74cb74b7fa98fc98ff575633cb12c05cc6daeb5f",
      "text": "Iki ___ omahku.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "8beadf7fdab5985c5e973b258c9e775d1362ea8201ef02a7994de00775383058",
      "text": "Jagung bakar karo degan wae, Mbak.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c1ec662a374e946744680c627b5ae323efcd89f43a64965645c723f312a2baf",
      "text": "Ora apa-apa. Aku wae sing ngombe!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c3bc062e8c2b9fd8fb78323ef85d9b9426a5b825c0790bba2c7173e0564ccc1",
      "text": "Mau aku wis mangan.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d36cb3e04cda4879b258035b4bdedf665db64a036c37277b5091d75a5795b30",
      "text": "Aku ora ngerti og, iwake panas banget.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d4bcacb703babcac9a74c9dcdc4efdd1273b20a3b7ef4e096f9b56aa48318aa",
      "text": "mung",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e0fa251464e94e502b1c18e146945b40f57cb354d718cfdb9b1fa63f44e1e8f",
      "text": "Iya. Ngapura, aku ra ngerti tembung «og».",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e18f22799e00dcb9500b7f9ed3d123e2988efe374890693ad10a5e72dfec73f",
      "text": "degan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e3f1d668148c24b805425f283d61f3753f145d9529d4a117a8b57b6ae51ba33",
      "text": "sikil",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f3e2788871a5ffc9a1ed388cf2c467154137739e89018a073e5c432cdbb42f8",
      "text": "Ayo! Aku ra mulih nganti bengi.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "913f881f8cddb969f0dadec7e86e0c3d0ac643e298b99ed92837e6efaf99bac7",
      "text": "kaya",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "93a1f74fabace9fd9846b80967f46b23faab25aa68551d7e0675650203aa89b3",
      "text": "Iya. Mau aku wis tuku bensin.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "9645319bf3ef0216572129bd5561786f8f4966c22f2929ad3b88fdc149b40062",
      "text": "Apik. Neng pantai nganti bengi?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "977fa83e03e89f2152720d4c51bd8f48b1709364f652d7d4761403606706c68e",
      "text": "Mengko awan ayo neng pantai numpak motor!",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "98684d751b00de9d3a6e3dd5850b8a5026c9ad3e8dc1153494a8867ed7a4d3ec",
      "text": "Kowe wis mangan to, cah?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c5881965b1b312b8e56e15fa9494344687b7065d433f2357e25dbf86405e50b",
      "text": "Mau numpak motor neng pantai, panas banget. Neng warung adem.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e4355e717d0fd0a67e79487ae4aad72d467209d2f0c5274aabd8757160e0fa7",
      "text": "Regane ora larang.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e7754fd8907bd53cbaf37bccf022f3f49abdfd2752ee481e58fd49efa29992a",
      "text": "rada",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ecbf0474edd931e68bc56f5411996d0d1d15a5bf9986f4ac73bb0a3e26ce7c6",
      "text": "Arep apa, Mas?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f216d9cebebf17bd33de8800821395955e9052fb2ffc2038ebe066d0a1fcb08",
      "text": "adem",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0a853da893c4208ce25db97de8c3adb030f8927c41dbbae1ae8738af8900f26",
      "text": "Aku ra ngerti og.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a42ff98013daf2a118ec5d606f0a0ade3adadc3fcfd20024cb9deaef6305e908",
      "text": "Mengko nongkrong nganti bengi, ya.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5615d0252ead7c968268bf0bfc11e79af4f2ef25d2b20c5301f4d71777eb05c",
      "text": "nangis",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f635c861b4f6e5a50c3385ad50f64e5b31d53d769d4c1d435e2887be100cc3",
      "text": "Rapopo, kuwi mung basa Jogja, kaya «lho».",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a76f29586665f2b74b4a7fc9addaf5e661b90a050c0bb585a44c8a259e1ec1e4",
      "text": "Mengko aku neng pantai numpak motor.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8615eab4dc78d2a5bca5add2351081c2d8d4d59f386e2a4e69304ac9c4af681",
      "text": "Jagung bakar, Mas? Degan?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8b6cffffa3080f57c14175b5a1e6bc46524746c708735e102e4c834be15ec51",
      "text": "ora ana",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9a8ff399e9475116514bc4fa211ec273aba9a9b189e46d5d80f8df9a43fc848",
      "text": "pasir",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9ef7caef8d70eba66ea54b5f6918eb031b0bfa36ea6ae6f8746b4fcbee1af95",
      "text": "Jagung bakare enak banget!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "aac6a2fe0fadf39a4070dba782f2b6a55c37182dcc0358b08c65e688b3a9f682",
      "text": "Mohamed, seneng neng pantai?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaddafbd8671b23f3abfc7d2ee2cf8309474c19c3a29bc9122c96e648fc8b9f4",
      "text": "Iya. Alon-alon wae, sikilmu reged, hehe.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab0f0b5e2b432d0aa058c95be3323e106827482003fc20c1eb182321b45cfbcb",
      "text": "Lho, kopine sapa?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "adb7423152b280eb04622e431d3efdcb15bb107d3f57f74501f13e7d17301b86",
      "text": "Ombake gedhe banget, Mas!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "b057aced134bd7b0af6404144a0945219b012cc3b56cfbe9374bd147577a6246",
      "text": "Ora, Mas. Iku motore kancaku.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "b34eba763407a01318b997f0eb3907a5927aa8811e92ce39cc7a7f795b9c7408",
      "text": "Seneng banget! Mau panas, neng warung adem.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5b3d33b93e5d6f52a480ff7a08270c63ed9cc934dc7b738f3c9128646f12537",
      "text": "Mas, ayo nglangi!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5f6734b355cae6ec5a48b08ab93290419db74a4c5cf01119d97245003237bab",
      "text": "Dudu, Mas. Aku teh wae.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b66f7eb4fc5e08991d867c4ec98d327e1d0b5ce4fc339b03f3271ecbea3f2351",
      "text": "wong Jawa",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8588944b2e21ff7fbf7f791259e3f9512afd4075011330c776d7cedd3afce30",
      "text": "layangan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a6bf4a2be1a5a7b5048bdf9ceb7e11f3f4943011d32253f24db2b42420cc2e",
      "text": "sumuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90b13f5f6a882b56d71f25fbb96c9d0c552595fb09dd7535c4b6726f801d0cc",
      "text": "Aku seneng neng pantai.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbf41a97bc895f155ef619359ea773833283b98818995fd23ef5b0fc647a2608",
      "text": "dudu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "be6c8184f0ed369a861f940736a5afd87acfc5ed96a84b5f2b5838995da853b2",
      "text": "Wah, sumuk banget, Mas!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf02abde5d43a7d8230bb90fbb53c918759cf4b52a2c5644ac387139f381d9ad",
      "text": "Rapopo, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf1869b1f76fac4252d352953263a25921df15a53138d34fde5e1477e716849b",
      "text": "Lho, bocah kuwi nangis. Layangane mabur!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c008a38df683f85ba007d3753ebeff6331b84a3458a414b7a61b3f3db6e2b743",
      "text": "yen",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0217bbc764ae3f6284267c380e42b2291944008d48f5abb322db4ef8f3ce300",
      "text": "Seneng banget, Mas! Kabeh apik: pasir, ombak, layangan.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0ab6fe0bd8da58e97d649d859f86be5e987b6ca60b9a2d031fe9170b867f126",
      "text": "Aku dudu wong Jawa, aku wong Mesir.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c33a0b2dd8b699a18797dec6aeca939f564297ff520aca7f759bf3c55e61f969",
      "text": "Motormu anyar, ta?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40866839a60b9c0b04e6ff3e284996d3c6a95a5bb1def3185fedc1eb73737b0",
      "text": "banyu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c554ae7c4cbd7b46ff9ba1c7098e9f2c4b8356fb78a20498a6680e27b6ca7bfe",
      "text": "Ora ana wifi, ngobrola wae!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7de3d15893942fa56fb18020f2a10324d4f964164fbc6b8e0ee9ba0e9e474f6",
      "text": "Rada adoh, numpak motor.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8899fbf4374b07331be9fc4ff5e7eb36bc477d4311de6953130995d6f5eaee7",
      "text": "Kowe ngomong kaya wong Jogja!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc45f0ada482926d4ae0341b142b6faa64394cd7f30709f4e3b0a799e7f31a87",
      "text": "Yen ombake gedhe, ora usah adus. Nongkrong wae neng pasir.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d476193b9c4203132c93f7e98690ea30317ae76e8a4c33a9ae437b93a86916b4",
      "text": "Yen ora udan, nongkrong nganti bengi.",
      "voice": "jv_siti",
