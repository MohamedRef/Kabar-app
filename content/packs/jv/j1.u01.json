      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "38f7aec10e8778a3c4cf903ddd75007858490d8c17180e46429aa3bbcad33427",
      "text": "Mohamed! Sugeng sonten. Kowe kenal Mas Heru?",
