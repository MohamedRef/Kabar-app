      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "399c79b8c6315a077e89cb1f440ed5fb1f4caa6f96980e90b4fbdde031a953ba",
      "text": "Kenal, Mas. Aku ketemu Mas Heru esuk.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf5d0ba8036442cf0bd23a46748d3f3c15c4e4e6c946f5afaee8f2298e7ce17",
