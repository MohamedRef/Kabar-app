  "audio": [
    {
      "key": "00cd4b6a0a1717e8f323d616f02085c3923c29200567c62332da036ded9aab1e",
      "text": "ngelak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "018affde433fb2f1067f1f850d3a74b0eb92cb8d05a5893bb13f457cc711c05b",
      "text": "Apik! Mbak Rara kancaku.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "01ddbeba440722e76e1ed89ebb1a9e4fc778556522dbaf55673413ae4d9813d8",
      "text": "Aku ngenteni ing dalan Malioboro.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "02fe9ec8d576cbc663e6813fbe236a330a419a1d34ad74cd3f2057888d238482",
      "text": "Mohamed, Mas Heru, ayo, cah!",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "039a878dc07639f09a22a078cef0c37a8d849b86723187e6b8e13d6a7ff0562f",
      "text": "Mbak piye kabare?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "03b7a164c7d05376c6ed3dedea1595fa8b062c60d35e91cad2bea5ca78ef7418",
      "text": "ayo",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "05b78d4c587809b514617dc53290898545d8db0925d21ca5a5b96a146abb769d",
      "text": "ngantuk",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "066ab958e5a6da316d87ca5ea8dfd2fde691f731c8ec83fdd8451d8fc99a195c",
      "text": "Sugeng siang, Mas!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0855ff09647772781fd52e1c798c71c294d645a02154a6f431718b7193563429",
      "text": "cah",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "09cf2b606ff4c5c05d0de4fa1fa84ec510e0876c1cb3ddc9094de201f13d16bf",
      "text": "pakdhe",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e9e0c3fe20efb237a2964c01ab92316d9939815e4c10ce6b971f585b399bea",
      "text": "siji",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b10f1a948ae30c501bf889f0a57a1c3d9282f7a55c336ededdc310cda55f383",
      "text": "lan",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb1b01741bc6933ae76e0b7a934e3c4247e16381a7b160b2fa0d2dc14788913",
      "text": "nduk",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d50cf081bec404d1628cb11e927f18d7579fdc14e008b8f1183f7168ce0396d",
      "text": "isa / iso",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d95f9eb0398fcc03afee3679219edd87dfb476e253af7a90c151dd1970d3bd9",
      "text": "Sugeng enjing, Mas Mohamed.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e843e6b07f2bf61ab23e05d98c3509301f2b94fe30b83123d18755de8cdeaae",
      "text": "Apik, matur nuwun. Pakdhe piye?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "103e730e11dd9522785d7df132dddd76b81003946d40b2e63e702ac7dd05441a",
      "text": "kaget",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "11dbc01059068e592889901fd862b1d09ee97607b89fe58920159467d0e5ac8d",
      "text": "Piye kabare, Dhe?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "1356e20de871db0eda8c7418cabaea040a994af5b4fe965978a1e3ff35f2049a",
      "text": "ngenteni",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "14068b18776025a046b18aa15170438a7f42ac2ccb88caae732b9fb10848b29f",
      "text": "Aku lan kowe kanca.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "17458c6d7971b24692a24e50f270c0a0878e909358abda875826fc6c2f6200ab",
      "text": "Aku isin, Mbak.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "176af12b31108e262513268496c6d1c1642cce388fb3024db0a691c702f3d776",
      "text": "Alhamdulillah, apik. Ayo, cah!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "17d8be5339749e35c28b87e8ac83b1d2b094b8221b80e99a2dd4feb1140a2aef",
      "text": "awake dhewe",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a8c2a218066f67d6e8f375fc700c6c2d326c381781152a7b367dca380f6733f",
      "text": "sami-sami",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bcbfc142a43cb561ef5032f8e2c122a36b6df6c1be189c286467b8eec26bf9c",
      "text": "Nggih, Mas. Kopi joss iki apik.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c237c3e37e9dfc860cb65f14cf35b829e67d56d8c7f13902d63bc8bab8341d2",
      "text": "Dheweke apik.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f90aa26936e51cf5596803539272f7e36ee081aa3a1e993f6fb0402e668ba98",
      "text": "kudu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "206c17dc9bd0603526e73d68314bbf8a0881e4c2df1fe9ae886c5bcf8a41a66d",
      "text": "Sugeng enjing, Bu!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "21fd5d7d6b69d67df7336964f890c1af1546c7d7a932aaf31c8227a83ab18e4f",
      "text": "Mohamed! Sori, kowe ngenteni suwe?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2334ab25abf923f54def6684bce807cc5a1babcec184ecbd8797b7a3c08d7db2",
      "text": "Aku ngenteni kowe ing dalan Malioboro.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "23ecc57fa6c5f6b4cab5afcfd158775de5410fe63d70fca1f3dbcd58fd5e0e53",
      "text": "dhisik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "25506cb1e5b79bd50f8cb2478bec9304e351cc663076bc3ee62301553ca49094",
      "text": "kabare",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "28f5970cc2439a1db52e7f85e56e7efbf342ac76cfca4bd02ecbc826735f6210",
      "text": "Nggih, Bu. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2acf823f291eb5f77460eda2ba8b7aceb5ba6a18d3d015a94819b9ba8a6ce78e",
      "text": "Ayo, cah!",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b235f9368d7557ff4757bc32fc2e3e8a6d9366459841e66563492136c296be5",
      "text": "angkringan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bb6e1dfad05f7176f4814f99e72488ee367e75affccf156a1b7ecab00e60474",
      "text": "bengi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bd9ae4fa83ec1df45f3fbd465b342fa6445611f56094afc8f75eb9c722de693",
      "text": "salam",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c24b06eab9be01635b303192ad0ab9b816b935a1645b5b262d053dec49bb143",
      "text": "lumayan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c83847316a67b573318bc948b0f0b333a9f9c01cc371dc24978ad284f88a951",
      "text": "Aku Mohamed.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "306f5b05787447c30304dad4c7eaefb6e1c4968d7e8e550400c6f03d47e82d2f",
      "text": "bingung",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "30ea2deef2db466bca71117974614f3911cf289bd6c9dc02f8f14e74394402e4",
      "text": "Piye, cah?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3180d493f9a2af245a6038dc0b0a9974406575bd47cadcecf2d058556d20b74c",
      "text": "Lumayan, Mas. Aku ngantuk lan luwe banget.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "382e62d0d0dc93809285b4c001d210ff2f9df8f9631154ff0775274a6d443b6f",
      "text": "ing",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "38f7aec10e8778a3c4cf903ddd75007858490d8c17180e46429aa3bbcad33427",
      "text": "Mohamed! Sugeng sonten. Kowe kenal Mas Heru?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "390b9dedfe313af3a00bb4f175a4d28fa61369de8bb352142bdc7f9a4efb4e0a",
      "text": "Alhamdulillah, apik. Suwun, Mas!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "399c79b8c6315a077e89cb1f440ed5fb1f4caa6f96980e90b4fbdde031a953ba",
      "text": "Kenal, Mas. Aku ketemu Mas Heru esuk.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf5d0ba8036442cf0bd23a46748d3f3c15c4e4e6c946f5afaee8f2298e7ce17",
      "text": "Piye kabare?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3bf6a5fb1fcf227bac6d4c2af31c3bd65b71fd3b5748a8148c8e49ea33329a",
      "text": "saiki",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ef23dbf0918e07f77aaf5f6ee76585a4f262c24ac2440908e932de903aa0625",
      "text": "Sugeng dalu, Mas! Saiki ngombe kopi?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f75e0d8c951566c5a095eb104e29531073c5dbd0ddd4eeda2edd67a57002f07",
      "text": "Sugeng enjing, Bu!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "40b1c8ed8b2008726b95eba60767a2b149bc7b2d328701dd2730476027633175",
      "text": "Kopi joss, Mas. Angkringan iki rame tenan.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "42300d3fc2912c5a81b55d76524e9fb6a7280863a79ff7244c85e70272d17279",
      "text": "luwih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "42d6cb3cb3353d2b51177397cf74e9432731e919361460877f83844c987b1244",
      "text": "Apik, matur nuwun.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "45575cc8c4b5076f22061c9defac6a8bf06e1d3884bdc95cd053da8888a7fc82",
      "text": "sampeyan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "46203e8992f98dbc56c3d3e9b547a4d8b8ea4c6f32faca562febc40b9493edd9",
      "text": "cedhak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "46a34dae4c5eb11367045042cc59d06cb2ffa2982bddc683836fe5e0ca8ca34f",
      "text": "nanging / ning",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b51219ac3a47895777ec640ea938a0d1738d1345465831bc3fcc2e84ecdcfa4",
      "text": "dheweke",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eff46807b43a1d9bae1324747cc374f1e03dee11f1be6dd102acdbbb1f74524",
      "text": "sesuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f1abbf17f8da3d28cbca92dcef566785cba2fa94180d54e7903057643de5f7c",
      "text": "bengi / dalu",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5064d5cce82136dd5098f3d3e2a59545135be6867ff8fad24dd26944f331de38",
      "text": "Aku sehat, nanging ngantuk.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "508d561a7ea6441c31dd52e3d891cc55066c05811b53f43feb2e57cc0d1a0086",
      "text": "mbak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "509d2df75391643402bf8821bb29cf2e4afca8fecb764f58ea737b539acba666",
      "text": "Nggih, Mas. Sesuk aku ngomong maneh!",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5136e9ad6becd29ec287d249b2f9d738514762e70de1118ae845c151caa859b9",
      "text": "Sami-sami. Sesuk ketemu maneh, ati-ati!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "52b0d4f81a0f2cb00ce41b5bb4d8534455afbdc8f966b56f308eeef3c2028173",
      "text": "ngomong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5301d896e6e37fd0ace09bd0a94b3bb09166726393359225951af27d2fdacf6e",
      "text": "isin",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "558b3430e265ae00aa8faf41dd0c14599090ee39c7e624a2549b6cd9c819892a",
      "text": "Aku pamit dhisik, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "56014a76e0d91af1c8bf85658e31e462ebfaa5fac953ab9f7f24c3e0aee1eb5d",
      "text": "Aku luwe lan ngantuk, Mas.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "56ba671a10d5afc8bb6177533bc739b9bfda30a7f83ecd5d0f0b1e8549d4df98",
      "text": "Sugeng sonten, Mas. Piye kabare?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ce896b82655e2b843a3ab566ea6e86278a985af941231a36fb710eb4479dc7d",
      "text": "sepi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dde0f05ac2f27e3fbcbd960c3c77f72c83176b88c8c793481d7bb1c9879779f",
      "text": "iki",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef48660913ed97749aba9afe9c0132fda0b73eca2d7f176bd5fa7f1773d5c7e",
      "text": "Saiki aku luwe.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f2c6a7bbaf734b6e3061a8609d92ddc1e54fa60ffac77717da0ca3ce45a427e",
      "text": "matur nuwun",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "600cf9eb82059ff49a3233299e3a7d4e5e5724a3da273092f90f673ce895eb44",
      "text": "Dheweke kancaku.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ea5e666ca2a66f73b408fbb00c94c86474c7bc1c860561caecb527c82b80d5",
      "text": "sehat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "65866bbf454bb3723debe272de8978fa4379ce3bacb1ccc25012e8c9f6dd3f52",
      "text": "sugeng enjing",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "663425fe19914d3102b654ed1dcc023e123ca1019d6c061fbfed56d779c6b2cd",
      "text": "Iya, saben bengi rame. Sesuk mrene maneh, to?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "66988438540730b24ef0ffca29f6cd4b1d06122585c9ba08c40495d3f245c3aa",
      "text": "Matur nuwun, Bu. — Sami-sami.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "66d7a50b108dcba1f996b7de828c2c5e59045c3b2cff010358ff388c6b6f0d26",
      "text": "Aku apik. Kowe piye?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "686147216e290cb5f8b13e02f4789e5c9b52658ca03ccb0ca01008a8ad12a80c",
      "text": "Sugeng enjing",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "68b152278008383a5f9585fc07e4e0bae79023e1050108017732a0c32046ff99",
      "text": "piye",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c4e6f9bcf7ee2c2d73b29f712064fd181b73dc6fae5ab3416b299ba55b255ab",
      "text": "Hehe, rapopo, cah! Basa Jawamu apik.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c9ed8244581c2ea2a9af2ef473b8ada1846720ad5602f20f549378143be17ea",
      "text": "luwe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "70cd4a43eddda84ad5c34d3ce105e41d62fbbdd3492e335bd8080a3f4d089ff3",
      "text": "Mohamed! Piye kabare, cah? Kowe ngantuk?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "7230192ba19d8521643a2d7d63d96472a70f79ad3f5890d690b3a3a24b54f02c",
      "text": "Esuk, awan, bengi.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "72e676b7f17977b84a73d14d99d0fc53bc040e22ed6c35b3067ab4cbf7cfd484",
      "text": "Sugeng enjing!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "76b3ea0986e6371476ed40c513c6cfcb24af561bc7d5290e2a2eccf36bd38a59",
      "text": "Nggih, loro. Kopi joss iki luwih apik!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "777c61cf169b5dda199955ad294737f3a83aafe38a7c010b04ab6df70f2ecc7c",
      "text": "isih",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "794521dc7f06bbe3990fc9933aff225524c012a4bda55de12f8d5136d901778d",
      "text": "Piye kabare? — Apik.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d5210d6501f7255bd7fa5f98ac289a17a9ee4433bb0cb991e31fe143ce516c",
      "text": "Mohamed! Piye kabare?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ae640fb63442b5d38bc3bd63ffdc3fba52892861c32baaf7adca180694ba264",
      "text": "Sugeng sonten, Mohamed. Piye kabare?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ced942a554a0ea5ad76b5b2b299d342953bb705bafdc227e4670e18426df728",
      "text": "Apik! Warunge rame banget, ya?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d9eff7fdf9addda40dd1c9d2503bce60c7df058eba374bd6727575f32c10206",
      "text": "le",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e4c4b91a63302e21be4e22ce6f6cb403beca01f59bbcbe66bab1849cd607941",
      "text": "kanca",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ebb66df5060dad31a2975d9067f7eccdecfb5c971ec7e9fba8894ad4a001bae",
      "text": "Piye kabare, Mas?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fd880a817e94411d48fc053c7788d013f24783ec059f7225337979530ddcd26",
      "text": "kopi joss",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fe93ade1fdbacb019152061764c7a54633398bc387c7cf2135d082633f92e9c",
      "text": "Sampeyan piye, Bu?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "806cf64fae3a97b741e8b9ead81beea0c34975fdb0bda2546a3afff979e409ce",
      "text": "apik",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8223e77e4e11792d5cbfe71a6ba59389efcc050042588798d38c6b13f76ee2e8",
      "text": "Aku luwe banget, Mas!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "82af17fa28c6d064b8be48af5c7221ac80be6a7f5442b3bc864328f665d8d6f1",
      "text": "Sugeng enjing, Bu Yani!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "86c7f994fbcaf04f29ca73df7a6c31727d031760070779249f4b1c0356f420dd",
      "text": "Suwun! — Padha-padha.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e0ad8cf66a73a23ac6723d3e526224edb560dfe173401b2c3e95a2ef3b9479f",
      "text": "Sugeng enjing, Budhe!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e11347becd0df697ce32e9a6a1f1a83b49280cbd71a662d10f60ea1ac2db5fc",
      "text": "Sugeng enjing, Budhe!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9096cbb56831c10c59cab4c82dbea69f924db575145715e3938974f56efeba3c",
      "text": "Aku pamit dhisik, ya. Ayo ketemu esuk!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "91238702ce0afb2eb2555b3b8b5be0527af7dcc0ab1e361cfc869eac7b6ff701",
      "text": "Esuk sepi, awan rame.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "927bce0f33f572939e53fcfbb5719007e5a4c2ccfd86be8e83488c730b771685",
      "text": "Duwe, Mas: kowe lan Mas Dimas!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "92ecb39b9ceb507d667b27d90009e438ad500370af4f71aafb62c1e4b92db57c",
      "text": "Ayo! Mohamed, saiki kowe duwe kanca?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9305b395e5ecb819f2da362998c8129da4d4dde0840357d077dd10c01b4fff4a",
      "text": "budhe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9336daf4b6a5a7fcf498959034b0461898eca25094950727f0f420f8a388f4fe",
      "text": "padha-padha",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9388836e2fae86955ce0162c5a42d7eb1fd9dc8553a342422f8b4cf1fc8fc909",
      "text": "Aku isih luwe. Ayo mangan!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "94704b13175eb2d7874ac7066b1b41203f9f84923fcbb7d79544e886940defcb",
      "text": "Sugeng enjing, Pakdhe! Sugeng enjing, Mas!",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "981c9ddba1867504463fd3a40ee341f92839dd810979e2a7805788498d3fc5a4",
      "text": "dhik",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bf31365b279747890b731efd6c6bd920acd32804230f2b193ce881d2a57aea9",
      "text": "awan",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bfc328680c58c5c7aa89801fa640dcafe7f62e78cdcb0222dda45321870ae12",
      "text": "Luwe? Aku yo luwe, cah!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e68f2d016da2b411504ac55e3567877c183b60fc9a54b614a1e1202b3a6abb2",
      "text": "Kowe piye, cah?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e9278f8e21b2bc4f4b377bfd88d0229a0336bd181ccd3ef364a33b40647e1f0",
      "text": "Bener! Nanging kowe isih isin ngomong, hehe.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f6e4abbaf8f7e80173e5f2f2b62e53921c61276c0ef5db82e00c1801f50ac78",
      "text": "maneh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a007c8ad720968a99a872e094fb3318cb592a0228c38228afef110a58d408066",
      "text": "sugeng dalu",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a05c95b7d66c989117fe696273007e9ac8139af47681ac85c1a7a3357f234938",
      "text": "Saiki aku isa ketemu.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0d24795ef4e5f51e29810cb55479312d368db046416c4ee656c6df58e57a2de",
      "text": "Iya, rame. Omahku sepi.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1c40e5ff1d189e5c2174b65491857620fbf376b2a3806f3cd5b432cb4cbe0ee",
      "text": "Ati-ati, ya!",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a41c458e87f363f56d6ca2041f13fdbe5ebccb2b3a42371dcbe511cb9ae26f28",
      "text": "Sori! Angkringane cedhak, ayo!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5931e119f8fb9db7ba50feb794ff1cc61962bbe8113f12c997173f9715a8dc5",
      "text": "esuk",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a94399a988bc205896451caf937f1970b0fcb4e18fa4304d7ad76678642cc891",
      "text": "Matur nuwun, Mas!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a988026f5644ce565c1f935b62ad4e419c017a2b886d4ddd05c600529cfa903d",
      "text": "Sugeng enjing, Mas Mohamed. Piye kabare?",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa5250fdd904e3759129e86e4c33dc4a1dac5c47cf7b130970c69c0bd57cff36",
      "text": "nggih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb42a5fe8ea92ac2bb084bbfbca32bc46aeb89a3a78002638c1f403d8772147",
      "text": "esuk / enjing",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aeb0766c26ee58dbea30ed9c2867b10978d44d3daa10e5702fb7d73d8759bcce",
      "text": "Pakdhe, Mohamed. Mohamed, Pakdhe Darmo.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "af0a8d1dd6160be06b17c5c5522aab6492f0a55feab7fd86879cec3d712f00c2",
      "text": "Aku apik. Kowe piye?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "af284e645efc4e51c3775800547a500961e19dbcd6e2fa91ce1e25913d29223b",
      "text": "suwe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "afbf247e34dd3203e914ea70cc4238776994607e1afd3121183d31a56c9f6c04",
      "text": "loro",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b04ba41b01f6a3d9376ca0341850947bbc6f8b3cd17399b40d0c67ee1fed12aa",
      "text": "pamit",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0bb84130f2de92fadfa8edb826544e4e5c66fca2f26ac99724f1ac2df02c5b3",
      "text": "Mohamed, kowe isih luwe?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b30d45e52b17f7ddeac0df4061036ccc7f8143f9032ee95b3f62291a3c8c76ef",
      "text": "kenal",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3218d996d01e1f28d7f4e24ea737b5e82e257f123dcc5f566b49951614c78b7",
      "text": "Kopi joss luwih apik, Mas.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3a9c1ad5113621ddc84c8e1eb8f984866ebcdb4d70f12ccf458cc4b8bc92d1b",
      "text": "aku",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "b42a24de7b6088ebf44ab8681088759da8514e7464e140444309b27c80446525",
      "text": "Iya, Mas. Ati-ati!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9cab646aa1af94359bf387309c0e5da7144ee928cabbe0afd3e7ce172d2b7e2",
      "text": "Ayo! Kopi joss loro, nggih?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbe54acbce2808021921008ee4c8b11dd3d6f2ee3a232451873b51d5961bb9c1",
      "text": "Alhamdulillah, apik.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc1844c6c707d800c5b2d9023a1bb114e6e101ccfe8e418d7c6d2b2e798268c0",
      "text": "Isih, Mas. Kudu mangan saiki!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "bec5acf493b36859ade674a480f07554ff87b1fbed76d8cbfdb5481ff73b4327",
      "text": "Piye kabare? — Lumayan, matur nuwun.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfa905ede5f33a2505b961b4f71129ff9a39214a9a6e0c2a724e130a44ac1856",
      "text": "duwe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0a6a6b7e4ed2700b7d8d4ba03ce6e7d633bacae00a21b9107a0e16b3fb7cd62",
      "text": "Nggih, Mas, sesuk aku isa. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0c1dea20961378ed8c3bb5d95e3a3168fccd10fd0bad529861b0cc9c72b4b44",
      "text": "Sugeng enjing, Pakdhe.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c25c78903c1c257772d0f8df16ba881b3514a581800f92f4cff322af1bab9260",
      "text": "Aku luwe banget, Mas.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c41988d6170eb023c49d1bf744724c795a52a08adff5b35dfe9c19991b8a298f",
      "text": "Alhamdulillah, apik. Matur nuwun, Mbak.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4d4ffceaed4f3ba27dfb011bc041161a1f30affe81646f2f08d09a8281846ac",
      "text": "Kopi siji lan kopi joss loro, Mas.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c59f0f063b6de90def16f7888ab6cc336adee550043f3ec3b293ad298d125287",
      "text": "Sugeng dalu, Pakdhe.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
