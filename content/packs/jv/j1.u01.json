      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "103e730e11dd9522785d7df132dddd76b81003946d40b2e63e702ac7dd05441a",
      "text": "kaget",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "11dbc01059068e592889901fd862b1d09ee97607b89fe58920159467d0e5ac8d",
      "text": "Piye kabare, Dhe?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "11f501c00aaa04e27817c40fb91305541559dd9db6d2bc6b8567f047d3acc79b",
      "text": "Aku luwe banget, Cak.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "123100de6b1228a97f5244358fbe3f356c02603edfb77cd0b491e1bde402ca9f",
      "text": "Mohamed! Sugeng sonten. Kowe kenal Cak Heru?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "17458c6d7971b24692a24e50f270c0a0878e909358abda875826fc6c2f6200ab",
      "text": "Aku isin, Mbak.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c87e464e8aac3ccffa539ef7ad64ea1ee629ecc43d2204cb0955ff7aa48c76",
      "text": "Alhamdulillah, apik. Suwun, Cak!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "17d8be5339749e35c28b87e8ac83b1d2b094b8221b80e99a2dd4feb1140a2aef",
      "text": "awake dhewe",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a1b1715367bcb6d5b69aa98c731c6dff0542d8da72eb09b06109d0d4a7cedd6",
      "text": "Suwun, Cak!",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a8c2a218066f67d6e8f375fc700c6c2d326c381781152a7b367dca380f6733f",
      "text": "sami-sami",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c237c3e37e9dfc860cb65f14cf35b829e67d56d8c7f13902d63bc8bab8341d2",
