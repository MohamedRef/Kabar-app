      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "206c17dc9bd0603526e73d68314bbf8a0881e4c2df1fe9ae886c5bcf8a41a66d",
      "text": "Sugeng enjing, Bu!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "23ecc57fa6c5f6b4cab5afcfd158775de5410fe63d70fca1f3dbcd58fd5e0e53",
