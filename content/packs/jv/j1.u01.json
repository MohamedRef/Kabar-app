      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "82af17fa28c6d064b8be48af5c7221ac80be6a7f5442b3bc864328f665d8d6f1",
      "text": "Sugeng enjing, Bu Yani!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
