      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf5d0ba8036442cf0bd23a46748d3f3c15c4e4e6c946f5afaee8f2298e7ce17",
      "text": "Piye kabare?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "3db04240b357b3c84ccb800eaddb2385ce3ed0459c4a86371099696fdb92d5a9",
      "text": "Luwe? Aku yo luwe, rek!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e59f622c68530ec19366269a7e7003c0cfde3bf8eb285f49faf70df93c803a8",
      "text": "Ayo, rek!",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f75e0d8c951566c5a095eb104e29531073c5dbd0ddd4eeda2edd67a57002f07",
      "text": "Sugeng enjing, Bu!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "42d6cb3cb3353d2b51177397cf74e9432731e919361460877f83844c987b1244",
      "text": "Apik, matur nuwun.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4459bd7d753151f149f396e0fc3bb549997cc6d7ce05fa6ef14d15029521f468",
      "text": "Ojo isin, rek! Basa Jawamu apik kok.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "45575cc8c4b5076f22061c9defac6a8bf06e1d3884bdc95cd053da8888a7fc82",
      "text": "sampeyan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "46e92623976aca2e7c05117bbc54da0b097b603ec38347fe72eee9b3f1d2d4ed",
      "text": "Sepurane, Cak, aku isih bingung. Basa Jawaku elek.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b51219ac3a47895777ec640ea938a0d1738d1345465831bc3fcc2e84ecdcfa4",
      "text": "dheweke",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f1abbf17f8da3d28cbca92dcef566785cba2fa94180d54e7903057643de5f7c",
      "text": "bengi / dalu",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "508d561a7ea6441c31dd52e3d891cc55066c05811b53f43feb2e57cc0d1a0086",
      "text": "mbak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5301d896e6e37fd0ace09bd0a94b3bb09166726393359225951af27d2fdacf6e",
      "text": "isin",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "558b3430e265ae00aa8faf41dd0c14599090ee39c7e624a2549b6cd9c819892a",
      "text": "Aku pamit dhisik, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "56ba671a10d5afc8bb6177533bc739b9bfda30a7f83ecd5d0f0b1e8549d4df98",
      "text": "Sugeng sonten, Mas. Piye kabare?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ce896b82655e2b843a3ab566ea6e86278a985af941231a36fb710eb4479dc7d",
      "text": "sepi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f2c6a7bbaf734b6e3061a8609d92ddc1e54fa60ffac77717da0ca3ce45a427e",
      "text": "matur nuwun",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "600cf9eb82059ff49a3233299e3a7d4e5e5724a3da273092f90f673ce895eb44",
      "text": "Dheweke kancaku.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "64881acb0addefd2e157adb0cfd92e98a6e8e3246117ea6380b77fd0259eee5e",
      "text": "Koen piye, rek?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ea5e666ca2a66f73b408fbb00c94c86474c7bc1c860561caecb527c82b80d5",
      "text": "sehat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "65866bbf454bb3723debe272de8978fa4379ce3bacb1ccc25012e8c9f6dd3f52",
      "text": "sugeng enjing",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "66988438540730b24ef0ffca29f6cd4b1d06122585c9ba08c40495d3f245c3aa",
      "text": "Matur nuwun, Bu. — Sami-sami.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "66d7a50b108dcba1f996b7de828c2c5e59045c3b2cff010358ff388c6b6f0d26",
      "text": "Aku apik. Kowe piye?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "686147216e290cb5f8b13e02f4789e5c9b52658ca03ccb0ca01008a8ad12a80c",
      "text": "Sugeng enjing",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "68b152278008383a5f9585fc07e4e0bae79023e1050108017732a0c32046ff99",
      "text": "piye",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c9ed8244581c2ea2a9af2ef473b8ada1846720ad5602f20f549378143be17ea",
      "text": "luwe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7230192ba19d8521643a2d7d63d96472a70f79ad3f5890d690b3a3a24b54f02c",
      "text": "Esuk, awan, bengi.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "72e676b7f17977b84a73d14d99d0fc53bc040e22ed6c35b3067ab4cbf7cfd484",
      "text": "Sugeng enjing!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "794521dc7f06bbe3990fc9933aff225524c012a4bda55de12f8d5136d901778d",
      "text": "Piye kabare? — Apik.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d5210d6501f7255bd7fa5f98ac289a17a9ee4433bb0cb991e31fe143ce516c",
      "text": "Mohamed! Piye kabare?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a543d6fcd78669d475cad90149289aa51df770cc4d5e5a4dfad70155f16c7dd",
      "text": "Mohamed! Piye kabare, rek? Koen ngantuk?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ae640fb63442b5d38bc3bd63ffdc3fba52892861c32baaf7adca180694ba264",
      "text": "Sugeng sonten, Mohamed. Piye kabare?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ced942a554a0ea5ad76b5b2b299d342953bb705bafdc227e4670e18426df728",
      "text": "Apik! Warunge rame banget, ya?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d9eff7fdf9addda40dd1c9d2503bce60c7df058eba374bd6727575f32c10206",
      "text": "le",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "7da6ef9c51dc5a43ace4625a0c94d0a237b8ed0fdd04e037760594fefe870f09",
      "text": "Kenal, Mas. Aku ketemu Cak Heru esuk.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e4c4b91a63302e21be4e22ce6f6cb403beca01f59bbcbe66bab1849cd607941",
      "text": "kanca",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ebb66df5060dad31a2975d9067f7eccdecfb5c971ec7e9fba8894ad4a001bae",
      "text": "Piye kabare, Mas?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fe93ade1fdbacb019152061764c7a54633398bc387c7cf2135d082633f92e9c",
      "text": "Sampeyan piye, Bu?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "806cf64fae3a97b741e8b9ead81beea0c34975fdb0bda2546a3afff979e409ce",
      "text": "apik",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "82af17fa28c6d064b8be48af5c7221ac80be6a7f5442b3bc864328f665d8d6f1",
      "text": "Sugeng enjing, Bu Yani!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "847a2125c1ba59c2e5c72ab9b839d6f009be027534763898ade7b1e1a266e5c3",
      "text": "Aku luwe lan ngantuk, Cak.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
