    },
    {
      "id": "j1.u06.l02",
      "sha256": "674d2723020c8d9f343d98698ec99a61141cccbd68b6b5576742103a4855b8b2"
    },
    {
      "id": "j1.u06.l03",
      "sha256": "6ebf05f59ba4ffc5e04a16686d93847fb2aef22a01d1834b2180626fce8ca6c1"
    },
    {
      "id": "j1.u06.l04",
      "sha256": "4aee4a1f2f34220113e7f990828c1c8f8e9918d0f5bc8cd57854897842233964"
    },
    {
      "id": "j1.u06.l05",
      "sha256": "fa7f646035fd4751a652829ef57d1083b6486e084ca0c8ca038eee5fc5350435"
    },
    {
      "id": "j1.u06.l06",
      "sha256": "49859de802e2e412ecf2e26aa9dcea4c5f90c71583d6242729e7e749951f7b07"
    },
    {
      "id": "j1.u06.l07",
      "sha256": "53964efde512754fdd22842d23397a4acc30f81a6095965789219da98c455b27"
    }
  ],
  "audio": [
    {
      "key": "00a166bd4a098b95ebc920eae13eccb912a10334dbee631eed7367bd43933355",
      "text": "klambi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "01b3a690976baf86653f37d3fed4465a47eb93a78d9042efdd21c129aac7a02d",
      "text": "Mbak, kebun binatang neng ngendi, ya?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b8abedaa2ae06ded4a5d385a63a56dfa8aaa9967c16895b5b093c6d673273d",
      "text": "Aku arep menyang Prawirotaman.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "093a843927689a31f35b5c33d5670a648014066b3ccb9ded271bb9ada41f6641",
      "text": "Lurus wae, terus ngiwa.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "098e50ea35478ff4924e1fbd87c6504e5e4c2e8e74c2c1edf7e64629f0b5249e",
      "text": "mrana",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a8273f2eb8ad18e370f9e850da423217ddc7373ce89a5133c9e496b71395454",
      "text": "Sing kae, neng kana.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c1cfc936dc906637aa8ee83832b8db133c7210959ad07468f6a869a0bc000c7",
      "text": "Oke, Pak. Engko mandheg neng prapatan, ya.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "10e961431e89b0726f28365042f4f5c7b731e6e65c9460991ab1fe504c752194",
      "text": "Aku nyabrang dhisik. Terminale cedhak kene?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "123d5a9c9e941dd5a4bace64cc92f7e9530b57e63f4341b710604074822260e6",
      "text": "Mas Dimas neng omah.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "12a3e3dcf0a5ca5614bbadcd629cf11780fb14b1244ceb3860fa6e89d95ae1fe",
      "text": "Mas Yudha neng omah?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "14c31b4c7caf959637a665e4f304ba966ffa50741c4511d8486d76d610616cef",
      "text": "Kebun binatange neng jejere terminal.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "14f293da3ab540c02ad860ba2406a98f3cff4c7f8bc34110e061bb3ec5d30ef8",
      "text": "Aku arep neng Prawirotaman.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1698ad595cdd7f53ff293908edbd9c252cde5d26c614e8c6635b1ac62e7ddbd2",
      "text": "Mbak, stasiun neng ngendi, ya?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1717654cb833f24df99ed34ef93dea97b7e5d23d70ac6849ef4ea62157d6205d",
      "text": "Mbak, dalan menyang terminal sing endi, ya?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e4ade5b8ed4b464d36474197339b3217e793a30015ab74a30317335e15045e1",
      "text": "menit",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e4e0e7ea8ee59c167a18035aaa65d53d7a99706dcb415a4f4e07d7107f93725",
      "text": "Iki apa?",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e583990d5319898e20ae2bb0d6c84fcc3bc4c9e91f554311bcb1ef8d5786215",
      "text": "Ngene wae.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "223ca04a1497d1637bc540642b7ba33aa6cadb5da22f29e27d18e06e46f4120e",
      "text": "Tikete pira, Mbak?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "23fc302a2a8aa91fe97cdaf7b8ea810a0b95b8c6eb74073e8765c447c97dbc58",
      "text": "liwat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "250b463104c94796df4c2bf8429d76531d988ba1b06e8d92904a5c33af58dcf2",
      "text": "Sing endi? Ora ngono, cah, ngene!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "254b8f01a1232de4ad1e76998bce49451d1dbe1b77c203ee6c235253c561ef85",
      "text": "Saka stasiun lurus wae, terus nengen.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "25af0580f3926fd051fc3a7952b306ce2b165431f98315ae2b84413f049ba23e",
      "text": "metu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "28bcdf4571f04a2706950198829f04a71b53ecde0b0b7a80e2899a9dc85998a0",
      "text": "nyabrang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a09663b3eec20219736c5d33a8237f934f55296a38f72e91e6a4a7647828096",
      "text": "Sing endi? Sing kae?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ae45c6fab77734dfcece0dcd6d333e6e796fd2a8559600556594d3834bd1720",
      "text": "Ngapura, Pak, mandheg neng prapatan.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c8175088f384127c1976c35c54b194ea124abef5cb3cd932ff2e6cdfd4212da",
      "text": "Stasiune cedhak kene.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d9bb4b3314611aa683e9605b508895e6ba0d75229d799ea3b5c57929c4ad172",
      "text": "mudhun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eacb28f97ae7c49b393cb8b279ab5af6225102cc78cb95e324aeaeff161abbc",
      "text": "Neng jejere terminal Giwangan, ta?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f684128f235b0bf3fb9775c0230b40bcc9a947f8cedb16da76286e341f00be8",
      "text": "Aku sing iki wae.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f92b7d5985aa8b9125b381b2e56f030271e3df351d9c4eb5ee1741966fe6090",
      "text": "kana",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "31cde04f84fa41ceddc764cfd23d011bd929815b7b0097582a59e96a898ed0e8",
      "text": "Omahku neng mburi masjid.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e9223a8853cfffa1bdb5ba2c92752eeb2076e2bcee77152f71caccaf229d0e",
      "text": "kene",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "357e45771055880395e1ab923e33a423fee0f56ee6c0a56e6a3e2029c3df97d7",
      "text": "Ati-ati nyabrang dalan, Le!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "374542680f77e2690ec94530f52c11c94d0d2b67b7d5dccc0b2410b6e3f7a501",
      "text": "Larang, Pak. Bis wae, tikete murah.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "382e62d0d0dc93809285b4c001d210ff2f9df8f9631154ff0775274a6d443b6f",
      "text": "ing",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a64a55c89740ee5c26abe7105ce08a4441c7e05333c64333947609e9404bbd7",
      "text": "mburi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c7f9a3d11c558408679a430b1cc9edd3796cbc8738359f3047921c6043cdbad",
      "text": "Wong kae sapa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f8075047b7558441a3bed6f3fa9a8110c4500ffee645fd6382376e07369769d",
      "text": "Sing endi? — Sing kuwi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "42c4cfb4ebec7e8b4e01810b60dbb48835dc23be99da192b9384923c88e44de8",
      "text": "Bise teka pira menit?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "42cdf53080784a12a9c65c20def7b79ea5a267f63f659dea0ce0a8edafc664ec",
      "text": "Matur nuwun, Pak!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "44de5185071100440843fd6705d50046dd84349467deabc7e352efe60e5de796",
      "text": "Becak apa pit, Mas? Pit wae, cedhak.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "46203e8992f98dbc56c3d3e9b547a4d8b8ea4c6f32faca562febc40b9493edd9",
      "text": "cedhak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4880ea6247e19c794774566b7c0ff91e241afc7d9601fe06987912c8840cbf0b",
      "text": "Dudu, Mas. Aku arep neng kebun binatang.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aa7fdfe6f26f9198cf124f0f7c13b26644d871ad760e1fa26e58cc999a4adef",
      "text": "Bise kesuwen, Mas. Limolas ewu wis, ayo!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cdbea32d4e9866a61a78af72d45471be55191ea3537fa8b2192b98176f6e5d7",
      "text": "mlebu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e7a651847dc126e5351754ae033c9259a7c165d9d0fcfdb36e514bfe0ab4b7f",
      "text": "Matur nuwun, Mbak!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fd3ced013d2f9cf25feca8901cd37f6d4c51b154aff9b32a452a09f381fa3e7",
      "text": "Mandheg neng prapatan, Pak.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "50a11283c1ec52774e67afd745f131eedd986693be4b7b646d918b04b792b94c",
      "text": "Warunge neng ngarep stasiun.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e4dada2cbf277d577141cbb8b5f8c5c62a4f77d85aa06ea3e7ba3349b9e3cc",
      "text": "menyang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "58bd3724b5708a188063786700963e176e59d784b6a1ab2cdad47b08136f0287",
      "text": "Lawange neng sisih endi?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "59e6da78bc93b4621bfb272a746ca29fa7af4c83dcefde932a07352ef37f6ad8",
      "text": "ngarep",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "59f79a01fc7bcfdbcfe087bcc3ed1d76e69e02213532862660d20d7f18f22c7e",
      "text": "Yudha neng kana, neng stasiun.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa6ceb04776b88e2f212538de9d35d1863dc78fe0c7d7d9f9106df4c3672944",
      "text": "jejere",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "661fb853eb235656d459de04ed286e83233d0cc20febfae9dbce4514a3a417b6",
      "text": "Aku arep neng pasar. Kowe?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "662488f4b2577bcb68c6ec4b5df41d9bab60f3eaca9d59aeb73d42bfefecb389",
      "text": "Ngapura, Pak. Aku bingung. Gembira Loka ngendi?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b6f93323acd7a90ce542f0fca4268bb7838900aab4a5dc7a3453ccbed4d3a18",
      "text": "becak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c0b404dac6fdc3d18fded2441036fe62b6238c8a1841758ae3613cfadcbab39",
      "text": "tiket",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "743777fdd1129c6f206ca4f269c41631460bd87429340c144460d41236320289",
      "text": "Kebun binatange neng mburi masjid.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "75a0a30b7a933ca431850c1f063ffc01078e0a4095f54fd11cdc1476a06071b9",
      "text": "sisih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a104a9494e7c76cbf686dd773139f6351f28c37a89cd8c9f23c1523cf97593b",
      "text": "Mas, kae apa?",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8308e810e9fbec1978fde5ff9e87afa0dfba0a3d6f7fc7cf33e26c816f4fea08",
      "text": "Klambi kuwi apik, cah.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "843338bcd195abdd62d1e324c464cc9173419b78c702361e8dc9996db780c847",
      "text": "Ora ngono, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "84ffdd860ad082be273cdbe6199b9f21c6da53408a6f4a9744914348dcee8442",
      "text": "Terus nengen. Kebun binatange neng jejere terminal Giwangan.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "86dceec061c013ba7f8efd4367916b0c43944cf448a7d8648193b48f888b2b15",
      "text": "Mudhun neng kene, Pak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "87ed0aa0650a46d7dff9a36e0aa5a0f834ad68dbb4c404d8a6f3a89e3a6447ff",
      "text": "Pak, becak neng Malioboro pira?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8936d669599939e9a7f355a830ed68cdcd14322eed550d5a49e4978fda3c5ff7",
      "text": "Mas, kowe neng ngendi?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c0e1962a9019405369894a66b4704a808000a1dd34ab5dee436ed50c7877edc",
      "text": "Ati-ati nyabrang, Le!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ea02dc579650255a71ce01a9c4cf4e7a72532e5cb580da086aed2fc11a53563",
      "text": "Aku neng kene, Mas!",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "91cdd9b9cdafc413ec6d8778deec3a0671884acfde5c991eafe7001fdd87a55b",
      "text": "Saka kene lurus wae, Mas.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "92db08292f269c4b2c7ffed8239dc01687ff0912a6f3a828927bf3389a9dea72",
      "text": "Aku arep neng kebun binatang. Neng ngendi?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b310c9f51224971ef0a56d050c5494d16ca3162c20a220289057d09ac21e1e",
      "text": "Sing endi?",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a3861273041eb34b7d1c25333b1bca2ea88990ffdba08314182ad5e902a12f8",
      "text": "ngene",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ad92f4f38269689116f0b3ef5d59741e9c4d4376752ef3d0c57afdfc1b9ead1",
      "text": "kae",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
