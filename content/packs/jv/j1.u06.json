      "sha256": "fcecefc8dba9eb5c5e48a5e6b1d0c35f6daa759f579f62f9142c1e74f0138c87"
    },
    {
      "id": "j1.u06.l07",
      "sha256": "ae9dd105b907c6c502d067490ee3079e08a0c0a3a50ed799e7556a3048a2887d"
    }
  ],
  "audio": [
    {
      "key": "00a166bd4a098b95ebc920eae13eccb912a10334dbee631eed7367bd43933355",
      "text": "klambi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "033267ab1283f4a338404d1d490b709d83ed081fbd4cfd8c5a81d9ba53cf6df8",
      "text": "Warunge nang ngarep stasiun.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "033a22bcb75895b6daa11ecba53e82135247de5ed0275bf32c022c07acb123ae",
      "text": "Sing kae, nang kana.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "063474d4bf00751ba944a247f5d01e5369e34622a4f161d7e88c3d7164b87258",
      "text": "Aku nang kene, nang pasar!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0866f8ebf35edfba9f900b9951c5c53b9642b279e656974c53e8fd24c9b94009",
      "text": "Cak, kae apa?",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "093a843927689a31f35b5c33d5670a648014066b3ccb9ded271bb9ada41f6641",
      "text": "Lurus wae, terus ngiwa.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "10e961431e89b0726f28365042f4f5c7b731e6e65c9460991ab1fe504c752194",
      "text": "Aku nyabrang dhisik. Terminale cedhak kene?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "123d5a9c9e941dd5a4bace64cc92f7e9530b57e63f4341b710604074822260e6",
      "text": "Mas Dimas neng omah.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "12a3e3dcf0a5ca5614bbadcd629cf11780fb14b1244ceb3860fa6e89d95ae1fe",
      "text": "Mas Yudha neng omah?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "14617e40a955a11aa8afc53d666dca9596135453ad9c8926fd4b8dd210230b34",
      "text": "Mudhun ndek kene, Pak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1717654cb833f24df99ed34ef93dea97b7e5d23d70ac6849ef4ea62157d6205d",
      "text": "Mbak, dalan menyang terminal sing endi, ya?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e4ade5b8ed4b464d36474197339b3217e793a30015ab74a30317335e15045e1",
      "text": "menit",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e4e0e7ea8ee59c167a18035aaa65d53d7a99706dcb415a4f4e07d7107f93725",
      "text": "Iki apa?",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e583990d5319898e20ae2bb0d6c84fcc3bc4c9e91f554311bcb1ef8d5786215",
      "text": "Ngene wae.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "223ca04a1497d1637bc540642b7ba33aa6cadb5da22f29e27d18e06e46f4120e",
      "text": "Tikete pira, Mbak?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "23fc302a2a8aa91fe97cdaf7b8ea810a0b95b8c6eb74073e8765c447c97dbc58",
      "text": "liwat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "254b8f01a1232de4ad1e76998bce49451d1dbe1b77c203ee6c235253c561ef85",
      "text": "Saka stasiun lurus wae, terus nengen.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "25af0580f3926fd051fc3a7952b306ce2b165431f98315ae2b84413f049ba23e",
      "text": "metu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "28bcdf4571f04a2706950198829f04a71b53ecde0b0b7a80e2899a9dc85998a0",
      "text": "nyabrang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a09663b3eec20219736c5d33a8237f934f55296a38f72e91e6a4a7647828096",
      "text": "Sing endi? Sing kae?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c8175088f384127c1976c35c54b194ea124abef5cb3cd932ff2e6cdfd4212da",
      "text": "Stasiune cedhak kene.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d9bb4b3314611aa683e9605b508895e6ba0d75229d799ea3b5c57929c4ad172",
      "text": "mudhun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e02de6a090f641968f5121f160f16b4f6d78e1e3c92b2ef3553b6279a5fb0e3",
      "text": "Matur nuwun, Cak!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f92b7d5985aa8b9125b381b2e56f030271e3df351d9c4eb5ee1741966fe6090",
      "text": "kana",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e9223a8853cfffa1bdb5ba2c92752eeb2076e2bcee77152f71caccaf229d0e",
      "text": "kene",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "34a66e35d16ed0d86240e88cc64b174818a142b6856c7b3a76347b7029c5153c",
      "text": "Oh, iku komodo, rek!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "357e45771055880395e1ab923e33a423fee0f56ee6c0a56e6a3e2029c3df97d7",
      "text": "Ati-ati nyabrang dalan, Le!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "374542680f77e2690ec94530f52c11c94d0d2b67b7d5dccc0b2410b6e3f7a501",
      "text": "Larang, Pak. Bis wae, tikete murah.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "382e62d0d0dc93809285b4c001d210ff2f9df8f9631154ff0775274a6d443b6f",
      "text": "ing",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a64a55c89740ee5c26abe7105ce08a4441c7e05333c64333947609e9404bbd7",
      "text": "mburi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c7f9a3d11c558408679a430b1cc9edd3796cbc8738359f3047921c6043cdbad",
      "text": "Wong kae sapa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f8075047b7558441a3bed6f3fa9a8110c4500ffee645fd6382376e07369769d",
      "text": "Sing endi? — Sing kuwi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "42c4cfb4ebec7e8b4e01810b60dbb48835dc23be99da192b9384923c88e44de8",
      "text": "Bise teka pira menit?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "42cdf53080784a12a9c65c20def7b79ea5a267f63f659dea0ce0a8edafc664ec",
      "text": "Matur nuwun, Pak!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "44de5185071100440843fd6705d50046dd84349467deabc7e352efe60e5de796",
      "text": "Becak apa pit, Mas? Pit wae, cedhak.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "44eb7b6129652957e4f16a46e217db84389e88ff7f824fe97293c4e19bcd8a2c",
      "text": "Aku arep menyang Wonokromo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "44ec2f8bc1f189e67b6dcc21c930306c347ba55b5836696d8f3eefa970dfcbf8",
      "text": "Pasare nang kana.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "453002cd3b98a7da82b244f3acee9c965be8e5d1d0798fa8f80ef4e06d4e42ba",
      "text": "Aku ng pasar.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "46203e8992f98dbc56c3d3e9b547a4d8b8ea4c6f32faca562febc40b9493edd9",
      "text": "cedhak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "46ef182b5ea5bdaa6b3c96bd8e87bfe1da2b84cb66b9b6283f8b7355d625777f",
      "text": "Aku nang kene, Cak!",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "46f64d46a33bda386d3529a45e734a46640c88d14681bb79061a1fe18e58b97b",
      "text": "Cak, kowe arep nang ngendi?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a5b4125fdf6980b2d283bd059338a285a0d387b676050f15f8ec7838e78b554",
      "text": "Warunge nang jejere masjid.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aa7fdfe6f26f9198cf124f0f7c13b26644d871ad760e1fa26e58cc999a4adef",
      "text": "Bise kesuwen, Mas. Limolas ewu wis, ayo!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cdbea32d4e9866a61a78af72d45471be55191ea3537fa8b2192b98176f6e5d7",
      "text": "mlebu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e11f019b0a9fdcd608d31a434d187858da0ca05d2b28f9b552b78b342eeb73c",
      "text": "Mandheg ndek prapatan, Pak.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e7a651847dc126e5351754ae033c9259a7c165d9d0fcfdb36e514bfe0ab4b7f",
      "text": "Matur nuwun, Mbak!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e4dada2cbf277d577141cbb8b5f8c5c62a4f77d85aa06ea3e7ba3349b9e3cc",
      "text": "menyang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "552aef04f981cf6990390c96fff36dd53e1c621c9f7fdca260af9e2015e2f5cd",
      "text": "Cak, kowe nang ngendi?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "59e6da78bc93b4621bfb272a746ca29fa7af4c83dcefde932a07352ef37f6ad8",
      "text": "ngarep",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ab6413d9d5d8475b874211770ede1e9a727724e480fe52ed723d9340c516c2e",
      "text": "Iya, rek! Ati-ati, ya!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa6ceb04776b88e2f212538de9d35d1863dc78fe0c7d7d9f9106df4c3672944",
      "text": "jejere",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b6f93323acd7a90ce542f0fca4268bb7838900aab4a5dc7a3453ccbed4d3a18",
      "text": "becak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c0b404dac6fdc3d18fded2441036fe62b6238c8a1841758ae3613cfadcbab39",
      "text": "tiket",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7048b25684d982702d8829928a5f819fdfac275898de5adbb94c53508f6c1409",
      "text": "Aku sing iki ae.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7413476bfb133f0ce9dd53b3b48a24ddb433e0ce15e049c0dd113f7cdb5d2b46",
      "text": "Mbak, stasiun nang ngendi, ya?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "75a0a30b7a933ca431850c1f063ffc01078e0a4095f54fd11cdc1476a06071b9",
      "text": "sisih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7660ba616e6df30815968cf1e375430fb942a7a12006123435d719fefe81a661",
      "text": "Klambi iku apik, rek.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d634c30edb887f30d79ad24b2c7b10229d033ebcb6a6cf91ab75f2194eab13d",
      "text": "Kebun binatange nang jejere terminal.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "843338bcd195abdd62d1e324c464cc9173419b78c702361e8dc9996db780c847",
      "text": "Ora ngono, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c0e1962a9019405369894a66b4704a808000a1dd34ab5dee436ed50c7877edc",
      "text": "Ati-ati nyabrang, Le!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "91cdd9b9cdafc413ec6d8778deec3a0671884acfde5c991eafe7001fdd87a55b",
      "text": "Saka kene lurus wae, Mas.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b310c9f51224971ef0a56d050c5494d16ca3162c20a220289057d09ac21e1e",
      "text": "Sing endi?",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a3861273041eb34b7d1c25333b1bca2ea88990ffdba08314182ad5e902a12f8",
      "text": "ngene",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ad92f4f38269689116f0b3ef5d59741e9c4d4376752ef3d0c57afdfc1b9ead1",
      "text": "kae",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cb84418371cb5a0cebb4d6266aaf728d4bc19c324c48b2e637e0d2ae3a46206",
      "text": "ngiwa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cea8255d76e2acb0044aa526986b7e8db8d49e48ac9d753af7d8b2a752ec4d5",
      "text": "munggah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d7afb0350ac238b8c44bd92a4408f49657cb158413ebb1fc57dccacba6a6df4",
      "text": "prapatan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9db4c9babd58d819002fcf141f84963bbcf5d435d9f65bb760e21f76991577d8",
      "text": "nang / neng",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf6366dfb41962dde184f1f65437e1416d92259888b69eb6aea7cd996e4ec71",
      "text": "ng prabowo?",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab1950fa96e07d0b7a3b1e1ba4b086298b41fe37a295fe3419ff1ea922ae36bb",
      "text": "Aku kate nang pasar. Koen?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad2608a5805a68c2c2f1d7504cb9d44310c7fd87ea5ddd0f56054c273cef057f",
      "text": "lunga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b071a1f0da41c06a0d70225772ad035bb7771293d2befc1df0f164aca7c2b122",
      "text": "Pak, becak nang Tunjungan pira?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4606ae853bfe4b1db46f1c6995685311c12e4c8bc52abcac6d33814f63fb36a",
      "text": "Saka kene lurus wae, terus ngiwa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5073372bcaacbcb01c45a1794f047009ed5b9d8a7a79db159296fc5700d0762",
      "text": "nengen",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7781a27d3735bcf458ad0fc793f05697f9a4f75d92af819c4439ca473d706a8",
      "text": "Lurus wae? Terus?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b787c62c8c743a43ba85acdfe7714ed6af7b3590f3763c64ac8c2dffc26da750",
      "text": "Kowe saka ngendi?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b81da9b652740d0ad1a4c3dd377bd6e58b3fd89a16df1ad81d5d989a6ded653e",
      "text": "Nengen, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab4f7e70f183ebcdb54ca895f3cd97d87f68841d0ff2fe1800cda766e70cb7e",
      "text": "Sing endi? Ora ngono, rek, ngene!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd855311b191ba13c16beaf33e8994e30e0afb60deea05f2d218a44355d94f0e",
      "text": "Lurus wae, terus nengen.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c08ece4e2734e36bebe3f4c800324f69f292bbc635172af392dc8c325de42608",
      "text": "sing endi",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1cf2ce2b95355b36011de897f2a4f4f59ba9406fc3700f523d611cec78eaa51",
      "text": "Saka kene lurus wae, terus nengen.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c263202621ef4fadf7ef7c555318217a1ad2a147b8ca7c4413fe34499f3a2ba9",
      "text": "kono",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c31d52dd6c255ed1488ea0f0b3092d4efec5ae411d99d0f8ec7bbb140f24a373",
      "text": "mandheg",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c423adfe5e794a1f48c2ce3f82baa5f8079c8c2d06c6bf929d86a4e39b8fb15f",
      "text": "Ayo mlebu, Mas, ndek kene adem.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c442fe8efbb92e3bb1ba3538309a58543db420d1a1bedc5b8de08cec83f6e496",
      "text": "Wah, gedhe banget!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c44a5666e1801edaee8db4f55e017bad45ceba212563153abe015b3282f358d8",
      "text": "Yudha nang kana, nang stasiun.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c44b78b8cd14878089d423409655cc86b70fffbf5572f9c39ecbba642604c1ce",
      "text": "Sepurane, Pak, mandheg ndek prapatan.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c52218915a6d351db9b73783b02c0b54986baa2df83a6058e2edc2b6486e1c",
      "text": "ngono",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c928deeb0de743ef317fca292dad606c9db2ee1585b238679ce2cdc0c55875a1",
      "text": "Dudu, Cak. Aku arep nang kebun binatang.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9a0ef5d7bd65c767251c9af8e5a9291cee40ba6b64c1ad692f5d969c8c36cbb",
      "text": "Cedhak, Mas. Liwat prapatan kae, terus ngiwa.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb6f79e993cda9927bb7bcdf2fa05d7383fc1a634badb364ef505914d24ddf87",
      "text": "Sisih tengen. Mlebu saka kono, metu saka mburi.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdd27626cdd2e2bb98eab4f652942cb480de1da94c1260f13a8d13bde4ff37e5",
      "text": "kebun binatang",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14a0c9e5016348b5c1b16dd9f3c38d49e4cab6e1c27686bc9b83c78ca8e45e1",
      "text": "terus",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14edc32e609dd9f8d2761d95f28af1c552cddf6e9f6ff258501316d58b7f2cb",
      "text": "Terus nengen. Kebun binatange nang jejere terminal Joyoboyo.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2344313df9aff651968a43fb52dc9d64ed05c3c650fa4d6f7a4e858bfa15321",
      "text": "bis",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3ccd9be16c95a4daf84fdec8f89fe05d7c74bf31c2e2cb9cee281612544a851",
      "text": "Aku saka Mesir.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4dba9733bff0f37191d86beb42318b0d5df26d3976b0edce5ca9ed0127ed4e5",
      "text": "pit",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d514eb171c9156120feb7c78bafd3b0cefa59b786691296fe1fa7233512eada3",
      "text": "Omahku nang mburi masjid.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d88481eab112b1b1bb0d54cbf88675803864c803817d97564b4ff93cc47b7cc9",
      "text": "Saka kene lurus wae, terus nengen.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d2d96d15e772b6a571208bdbc9953228d7374d1b443e1d45d07a27a13cd94f",
      "text": "Iki omah.",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d364874cf24ff5a8682416c4d0afcc1f025bba7aadd4eb2d4fcb55dcc5e237",
      "text": "Mbak, kebun binatang nang ngendi, ya?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2e2fe4ac987fa56c6b4e6844ad78cd5ef3297c3f4cee6175b52f08e3abd5ef8",
      "text": "Omah iki gedhe.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4ce5df92fc55999a78f575fc8b3e9a9fe5603fb4bdcd5cb72e8efda281abdda",
      "text": "kuwi / iku",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e547e64c797cb16575ca34a07b1e15d0695062b2657e907baf70cd830bdb38b5",
      "text": "Nang jejere terminal Joyoboyo, ta?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecdad4d07771497c47bb71452694701e0a972b1231e8aebd4842b5537728eeb2",
      "text": "Lawange nang sisih endi?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee85040d321fac546d17e84d2cc17f954cda7b191fc59f68bef3ff55b3d6afd8",
      "text": "Aku arep nang kebun binatang. Nang ngendi?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0e5b770f52bc909235540b43f8c7593bf720604f5f7db0fc6a2ef30e867aa4d",
      "text": "terminal",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4085ff2c0cd2fbf4acda85101d9fed86ab3bd1726f19babe04fae283781a295",
      "text": "Padha-padha, Mas. Ati-ati, ya!",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f437f0cff1fc44857f572437f9449b0509df92c60b4135d073029b7325ab52be",
      "text": "Sepurane, Pak. Aku bingung. Kebun Binatang Suroboyo ngendi?",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f50a3a95a4a56f73929aeedf83c5fbee06cfe777e1d6845dd2105b0777ff48a1",
      "text": "Nyabrang dalan. Stasiune cedhak kene?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5c968bc04c552263943fecc6724bee13bb22e3b7ce564cb363b666034354d97",
      "text": "Kebun binatange nang mburi masjid.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f94aac36405738f684b1cc63270bb12f478a2eb32f6477b42b15f7998c0e682e",
      "text": "Rong puluh ewu, Mas. Limang menit tekan.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9e1d277e73b1fcae069c740df563d907491b31211dd26b3316ff55c30d9bc32",
      "text": "dalan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fad2518d5b07df41633c2e7d7ff2367d69c5971c9763a336ac1d6efc5869f894",
      "text": "ng prabowo?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb10321ab9ba4e11000b817a59951db6f124058414a3d0d7e2b2dc5f89a04df1",
      "text": "Dalane lurus wae, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcd3a4fa929d1dec051823ae77189265754ba9894ec4abdf98d04acb2ae75932",
      "text": "Oke, Pak. Engko mandheg ndek prapatan, ya.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fded79101a722e16c92416df62cd6b780953c8c9c5d3479284fbe726aa048bcf",
      "text": "lurus",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffc187c54bbb2ccbd145c1ce5434a606ceeb97600b5f923562c2805d1e479405",
      "text": "Aku arep nang Wonokromo.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    }
  ],
