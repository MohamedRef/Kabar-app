  "audio": [
    {
      "key": "00a166bd4a098b95ebc920eae13eccb912a10334dbee631eed7367bd43933355",
      "text": "klambi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "071843830ff9e837d9b1bb54bcf87cbcb3b2595aae721e187f12e2829108ffe7",
      "text": "Iya, sing kaé, nang kana.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "093a843927689a31f35b5c33d5670a648014066b3ccb9ded271bb9ada41f6641",
      "text": "Lurus wae, terus ngiwa.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d37af48c273c1c06165e170482f853f4b70a5c9aaeee08e335dbca5f7e29022",
      "text": "Cak, kaé apa?",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "123d5a9c9e941dd5a4bace64cc92f7e9530b57e63f4341b710604074822260e6",
      "text": "Mas Dimas neng omah.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "16607112e6a6d1772a8cc826bb7af0f45a0a5e194f097fe309fcda93cd903e37",
      "text": "Aku saka pasar.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "16bded047d01a126dced6a1ec962551e6ed20e4663f2644cc426febf6f89b954",
      "text": "Pasaré nang kana.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e4e0e7ea8ee59c167a18035aaa65d53d7a99706dcb415a4f4e07d7107f93725",
      "text": "Iki apa?",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e583990d5319898e20ae2bb0d6c84fcc3bc4c9e91f554311bcb1ef8d5786215",
      "text": "Ngene wae.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "254b8f01a1232de4ad1e76998bce49451d1dbe1b77c203ee6c235253c561ef85",
      "text": "Saka stasiun lurus wae, terus nengen.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e02de6a090f641968f5121f160f16b4f6d78e1e3c92b2ef3553b6279a5fb0e3",
      "text": "Matur nuwun, Cak!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f92b7d5985aa8b9125b381b2e56f030271e3df351d9c4eb5ee1741966fe6090",
      "text": "kana",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e9223a8853cfffa1bdb5ba2c92752eeb2076e2bcee77152f71caccaf229d0e",
      "text": "kene",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "34a66e35d16ed0d86240e88cc64b174818a142b6856c7b3a76347b7029c5153c",
      "text": "Oh, iku komodo, rek!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "382e62d0d0dc93809285b4c001d210ff2f9df8f9631154ff0775274a6d443b6f",
      "text": "ing",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a64a55c89740ee5c26abe7105ce08a4441c7e05333c64333947609e9404bbd7",
      "text": "mburi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f8075047b7558441a3bed6f3fa9a8110c4500ffee645fd6382376e07369769d",
      "text": "Sing endi? — Sing kuwi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "453002cd3b98a7da82b244f3acee9c965be8e5d1d0798fa8f80ef4e06d4e42ba",
      "text": "Aku ng pasar.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "45a95d159d8f8161e5ae869d42c3c59c8beeb83c965f5db1cc83426e5dcb12da",
      "text": "Mbak, kebun binatang nang ngendi, ya?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "46ef182b5ea5bdaa6b3c96bd8e87bfe1da2b84cb66b9b6283f8b7355d625777f",
      "text": "Aku nang kene, Cak!",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a0a71ee57e981833c43a1ae9886273ce9a83eeae62f16ca61ed78950eddf832",
      "text": "Cak, kowé arep nang ngendi?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e7a651847dc126e5351754ae033c9259a7c165d9d0fcfdb36e514bfe0ab4b7f",
      "text": "Matur nuwun, Mbak!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e4dada2cbf277d577141cbb8b5f8c5c62a4f77d85aa06ea3e7ba3349b9e3cc",
      "text": "menyang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "53d10fd6418f73d98145a52d779bfbd70f1f70c181ea53b808a39da12a31bd74",
      "text": "Wong kaé sapa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "59e6da78bc93b4621bfb272a746ca29fa7af4c83dcefde932a07352ef37f6ad8",
      "text": "ngarep",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ab6413d9d5d8475b874211770ede1e9a727724e480fe52ed723d9340c516c2e",
      "text": "Iya, rek! Ati-ati, ya!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7048b25684d982702d8829928a5f819fdfac275898de5adbb94c53508f6c1409",
      "text": "Aku sing iki ae.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7413476bfb133f0ce9dd53b3b48a24ddb433e0ce15e049c0dd113f7cdb5d2b46",
      "text": "Mbak, stasiun nang ngendi, ya?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7660ba616e6df30815968cf1e375430fb942a7a12006123435d719fefe81a661",
      "text": "Klambi iku apik, rek.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7892956d11a6e644cce4e68a57c60de99a3edfbc66e94d25736b1a718ea1c90a",
      "text": "Nang jejeré terminal Joyoboyo, ta?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "78c20892c4473376736c808de6265803a34af61378ea8d43a1ff1ede37dc155b",
      "text": "Kowé saka ngendi?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "843338bcd195abdd62d1e324c464cc9173419b78c702361e8dc9996db780c847",
      "text": "Ora ngono, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "88346363d8b39a2d800592d807d31bf9afdd5118359be28613b8fd1e60a73a7b",
      "text": "iku",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a7a0a9d758a42a8ec67b82ce737430954a2314ee1aec7f08755649cd4fac531",
      "text": "Kebun binatangé nang jejeré terminal.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "91cdd9b9cdafc413ec6d8778deec3a0671884acfde5c991eafe7001fdd87a55b",
      "text": "Saka kene lurus wae, Mas.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b310c9f51224971ef0a56d050c5494d16ca3162c20a220289057d09ac21e1e",
      "text": "Sing endi?",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a3861273041eb34b7d1c25333b1bca2ea88990ffdba08314182ad5e902a12f8",
      "text": "ngene",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cb84418371cb5a0cebb4d6266aaf728d4bc19c324c48b2e637e0d2ae3a46206",
      "text": "ngiwa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9db4c9babd58d819002fcf141f84963bbcf5d435d9f65bb760e21f76991577d8",
      "text": "nang / neng",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f5c4c99af2ee12079db9b099262e81753eaf740d5d34f407f2735cb3d376f2",
      "text": "Klambi kuwi apik.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf6366dfb41962dde184f1f65437e1416d92259888b69eb6aea7cd996e4ec71",
      "text": "ng prabowo?",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab1950fa96e07d0b7a3b1e1ba4b086298b41fe37a295fe3419ff1ea922ae36bb",
      "text": "Aku kate nang pasar. Koen?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad3548ce9af35612c3f3f4ced9dcd42c4d174757061b05b4cc38d49f722edac0",
      "text": "jejeré",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0f40e139a0dc86a3e0bff9659f81f20099786b0e44879e869bfab7b968d30c3",
      "text": "Aku arep nang pasar.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1eacd8ba030e34476a75a5c73b24323e60501058af75002196246cb7b21bca3",
      "text": "Warungé nang jejeré masjid.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4606ae853bfe4b1db46f1c6995685311c12e4c8bc52abcac6d33814f63fb36a",
      "text": "Saka kene lurus wae, terus ngiwa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5073372bcaacbcb01c45a1794f047009ed5b9d8a7a79db159296fc5700d0762",
      "text": "nengen",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b62fc421f3f135cabedc168d662464810b08a62b5f140dc50b5575b9061d43db",
      "text": "Sing endi? Sing kaé!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7781a27d3735bcf458ad0fc793f05697f9a4f75d92af819c4439ca473d706a8",
      "text": "Lurus wae? Terus?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b81da9b652740d0ad1a4c3dd377bd6e58b3fd89a16df1ad81d5d989a6ded653e",
      "text": "Nengen, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd855311b191ba13c16beaf33e8994e30e0afb60deea05f2d218a44355d94f0e",
      "text": "Lurus wae, terus nengen.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c08ece4e2734e36bebe3f4c800324f69f292bbc635172af392dc8c325de42608",
      "text": "sing endi",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1cf2ce2b95355b36011de897f2a4f4f59ba9406fc3700f523d611cec78eaa51",
      "text": "Saka kene lurus wae, terus nengen.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c263202621ef4fadf7ef7c555318217a1ad2a147b8ca7c4413fe34499f3a2ba9",
      "text": "kono",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3bf6261d4afd7000468863fa59ba16fddc453b63ed42d9b8029e599aa7d0201",
      "text": "Terminalé sing endi? Sing kaé?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c442fe8efbb92e3bb1ba3538309a58543db420d1a1bedc5b8de08cec83f6e496",
      "text": "Wah, gedhe banget!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c52218915a6d351db9b73783b02c0b54986baa2df83a6058e2edc2b6486e1c",
      "text": "ngono",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c928deeb0de743ef317fca292dad606c9db2ee1585b238679ce2cdc0c55875a1",
      "text": "Dudu, Cak. Aku arep nang kebun binatang.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cab1dfcb308d0cf5c4350a7115d80ff2e2fa33efd26ee1edc3d96d4b10d934d7",
      "text": "Sing kaé, nang kana.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "cce61c3aa5dbbe16913cc8ff2449a8d997b01cf43bab3cc10fd92f8c3f674eb3",
      "text": "Warungé nang ngarep stasiun.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdd27626cdd2e2bb98eab4f652942cb480de1da94c1260f13a8d13bde4ff37e5",
      "text": "kebun binatang",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14a0c9e5016348b5c1b16dd9f3c38d49e4cab6e1c27686bc9b83c78ca8e45e1",
      "text": "terus",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3ccd9be16c95a4daf84fdec8f89fe05d7c74bf31c2e2cb9cee281612544a851",
      "text": "Aku saka Mesir.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "d514eb171c9156120feb7c78bafd3b0cefa59b786691296fe1fa7233512eada3",
      "text": "Omahku nang mburi masjid.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d88481eab112b1b1bb0d54cbf88675803864c803817d97564b4ff93cc47b7cc9",
      "text": "Saka kene lurus wae, terus nengen.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d2d96d15e772b6a571208bdbc9953228d7374d1b443e1d45d07a27a13cd94f",
      "text": "Iki omah.",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d364874cf24ff5a8682416c4d0afcc1f025bba7aadd4eb2d4fcb55dcc5e237",
      "text": "Mbak, kebun binatang nang ngendi, ya?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "db03021039da4e03e8caa6a79e3b06d422fdb2e4508ee5ebfd897ebc6a99e774",
      "text": "kaé",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "df4833793ec5bebef6f38dffd3b655d1aa9cbf997626a12d36b870ac09373472",
      "text": "Klambi iki apik.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2e2fe4ac987fa56c6b4e6844ad78cd5ef3297c3f4cee6175b52f08e3abd5ef8",
      "text": "Omah iki gedhe.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e829777aa53c917c6c4471ba8c4bcc194762413e4c2955e9f694632161ebf58b",
      "text": "Sing endi? Sing kaé, nang kana.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee85040d321fac546d17e84d2cc17f954cda7b191fc59f68bef3ff55b3d6afd8",
      "text": "Aku arep nang kebun binatang. Nang ngendi?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "efabfb84e457d5bb2da7660a7ad7287372dd78e9d52c57a7b7fa7b4dd519258b",
      "text": "Sing endi? Sing kaé?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0e5b770f52bc909235540b43f8c7593bf720604f5f7db0fc6a2ef30e867aa4d",
      "text": "terminal",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1e4cb60821bef6eca1ed4f6af0dcaa1fd06a150368d078769461f992404170c",
      "text": "Terus nengen. Kebun binatangé nang jejeré terminal Joyoboyo.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
