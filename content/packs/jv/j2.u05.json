      "sha256": "84cedf78d6d13626354b5659ed43040997c07a95a2416d329a6686b74b7e28b5"
    },
    {
      "id": "j2.u05.l04",
      "sha256": "deb409c47641f23a0398bfa6f4f69ddd51995f8f4cabaa8da0e0ac09829644ba"
    },
    {
      "id": "j2.u05.l05",
      "sha256": "19fa3db070c67d93aea7a0d1ea75f1aab70b2288e7d7652a1adf2b3becbe9bcb"
    },
    {
      "id": "j2.u05.l06",
      "sha256": "e2f058418441b50e0f8c4f9c0285c9ab73ea5806c142ebb68987f8ca9cea870e"
    },
    {
      "id": "j2.u05.l07",
      "sha256": "bc3bb31b9a2de83a09aaf96c87b2888c5ce72288f594677316910978c3d2600b"
    },
    {
      "id": "j2.u05.l08",
      "sha256": "c2446042e50183b1664b673a128ae946d95304afc0a6405abcf3eb756fabddfc"
    }
  ],
  "audio": [
    {
      "key": "00abe34daedf1990fe90197014c1088780591e47f2bb99914690d3d228577864",
      "text": "watuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "066a512dc8d2b1296d80b70081a3891a4e27efcc23a9401f8fc1c951da47c70d",
      "text": "Aja lali nyirami kembang lan mateni lampu, ya!",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b86135a7d85a8a6e32f4ced8be366685290f174c5ba6305904f04f69add0de4",
      "text": "Aku mriyang lan watuk.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b92ccad4a1d6b113b82a57e9b8686bab60746bf58a2b88a8a4649ef3f99fde7",
      "text": "Mohamed, mangana sik!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "102d305ba04a4fd40b91767c37c5cee9c1c72929620935a034c7c1295f34355c",
      "text": "adusa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "106f7a1446d408e500923a3b34cde0e68ecb31ae1e441f60d0f4ec5234fce6ff",
      "text": "jupukna",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "107a5a0256417ac3e7c41903be3d7ba251927c88ca858ff3832ada6190738bad",
      "text": "Awan ngapa?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1356e20de871db0eda8c7418cabaea040a994af5b4fe965978a1e3ff35f2049a",
      "text": "ngenteni",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "192c8c129c6d51ba85c9f64de190aeb718b44c2c6d97f53286a381f4dcb5bb4f",
      "text": "Mangana sik, ya.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b8cf591067f806c46e7f91eabf2199b362814d057ade54ee0c015c8a43dca14",
      "text": "Mengko, Bu. Aku lagi maca.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f7c6a53de33d651f48092f43358a08c30da0e51f4be527630e973b537767bdb",
      "text": "Iya, Bu. Ra lali kok!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fa0f04e93047791dcb352461988c078a3ea68f8b07edb54fb47e6e6e34c2b91",
      "text": "Wis tak pateni, Bu. Saiki aku ngrewangi Bayu sinau.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2033171e57f19eb1c9ef0f2d9506655474b2d5b6c4a0dc41283f2efeaede8c33",
      "text": "Aku sibuk saben dina, tangi, salat Subuh, sarapan.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "2040b5c3660a00e3d7f2494c96bfa849377c637f06af6116de1aac50d81101d0",
      "text": "Ayo, tak kancani.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "20954a48133a6ae3d8d814837b6eb6926b4b8e5f347d02633b3f049a354b98ee",
      "text": "Ayo ngobrol karo simbah ing ngarep omah.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2136ab13c0915bd9ca4a8f649b8b5375fad1a83d28d27716b9e41d5f8eed5d14",
      "text": "pegel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "224f89530ece1a8584755c65db4ec64cccdd172ac7f2639836de08ec9fe7a129",
      "text": "rewangi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "23eb652d8270f1241d3ec1bb553af7cb692ddb32224898cc95c8ee12d97fca2b",
      "text": "ngancani (kanca)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "26cf77152bc2d9e014a115c0a234dc0f66867825e5e4a06dc020f674a2c79081",
      "text": "Saben dina aku tangi jam setengah lima.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "26e71c37409809c9bacf7c5fc86da0d6d18c737fa2b24d9d17ff86d84df6babd",
      "text": "Bu, aku wis maca layange Ibu.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "26f90010a48373634fd24cb8b68b8f8f7a28c727c90e3ed98a10ad6cd9df9b6b",
      "text": "Aja lali, ya!",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b4b7f5bdc12547409427e1752c6dc62b521fcba3fa3e689d5c1c2b511524bf4",
      "text": "Neng Kairo, Sari kuliah.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e43666d2c860c93dafda2d98bec213e1d33379ccce9485430f9a6bfec0c2fe4",
      "text": "Ibu ngongkon aku tuku endhog.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ef760df6c6f9be539c56d9733a375269f59cd532826dfa3eaa076454ed3c75b",
      "text": "Apik! Aja lali turu, ya!",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f177a3f717bb26759e121afd6aebc4ad943f60cade8881090d2532453303abc",
      "text": "Tulung jupukna, ya.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "33fd0a1d5de3e124c73563133f2224ed237af11e9c96fdb8cee181a49499c515",
      "text": "gawe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "35e68cca05510aec81f67a3ddbfd626ec341dd8eb313175b8a1494513d27ee12",
      "text": "Mas, wis adus? Kelase wiwit jam pira?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b10d62b3f1f3592460c0807e78be3433608ceca91ccbdbfd4a8fb45c91d5611",
      "text": "mangkat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b8c5c02ed07f1f9a5a9d763434964ab4e3fa0d64110e49f62ebb7080d02857f",
      "text": "Hehe, iya. Sing penting ngobrol karo pembeli nganggo basa Jawa!",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be59c2b2facf234adb641dec8c7ade445419118c8a306acd7f3ae426fff8ca1",
      "text": "Aku tangi jam lima, salat Subuh, sarapan.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f1aa493de5c518d98a8306714f893bd0734da20af662409de0a32119f539140",
      "text": "Saben dina aku salat Subuh jam lima.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4226f516f3d217d216e6a4277ce50b700ac5095e754312bffd221134979f0302",
      "text": "Ndang ngombe obat.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "46029b3195077a81f882f58fc4f4473b5bd372f2761091a74af4751c58bc6445",
      "text": "Pateni lampune, ya.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "46d765a848f41e8dcc784eba8363e4948d6b1ee29aecbfbc934c24ce809f8c9c",
      "text": "Saben sore aku nyirami kembang.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "490540275125cb685ebbe4fca601a2efb010e5df8edfd061ed3e455f00a4d9c2",
      "text": "Wah, dinamu sibuk tenan!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a4253f0511d0b3cb7f9a80a3b97c7b3f33a018dbd1b0f22c64153764542255a",
      "text": "Sari, saben dina kowe ngapa wae neng omah?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b17251736c66e086864546536fe7c9c527e69542caa5572537fa45ef994bd6b",
      "text": "Aku mbantu Bapak, terus ngobrol karo Bayu.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c566be06a82a7b42568441dacd3a5696896828f96c8f0000e2612b0002f207a",
      "text": "ngongkon",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cf4f984ae636bf81affc26083f6c989b7019f31e83b2c587c3dd0ab5aecc896",
      "text": "Awakku pegel kabeh.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e1f931a28463d37beaf9c707b79128efbc9138cc13f761779d8386b269ec5f9",
      "text": "lampu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ed53ccae09a4529a069c8dd48f7feb3647cd921af145d0f7342d39b7734b160",
      "text": "sibuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "52b0c095d0c71037b2ff31bcc05af886c2a049e0112e42782ea783b3d6f44e46",
      "text": "Ayo, tak kancani!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "574b32e81e9fe877c16294b2effb650cc8438f3489c20163866ce6af7c39e095",
      "text": "obat",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "584ca66ffe45ac197f1eb2cf5aea084aee4650b2325174d16642664d9ccc1db4",
      "text": "Tak rewangi, ya.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b6b800942941261b97842807aa97e0052a235d3312b8de5825b7dfba65c3f71",
      "text": "Neng Sarangan. Aku ra ngerti dalane lho.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b71dce58e8298fcef844d6a11749fe89f8856337d962c6d47480648363b724d",
      "text": "Wis, Bu. Sotone enak tenan! Kembange wis tak sirami.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d442e2b61425d9886109f793b95795cec16a24f5568828385bc7910d1de7e7d",
      "text": "Sore?",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f64393c718ef18d15dada04cdee93894c89a5d9aa2c25e114732a112b88510c",
      "text": "Matur nuwun! Mengko sore aku nekani mantenane kancaku.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "6170c8dc5363215f2895fd22cc410f1f0aacbb58a5c9ab156d558d219f1bbcf4",
      "text": "Aku nabung saben wulan.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "64edd1e57c8888a6dd83eb18aac76b58a945bfd23637cf968f2d863062b27ef6",
      "text": "kembang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a31e30c1fed72b313ea91b8108ab0125d3f3ef466c21f0c6b092072c45e059b",
      "text": "Apik. Lampune piye?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cbf3281e22ec83d3fb73b06a579922558efe96042d18fccd76cf39f80983c68",
      "text": "Sari tangi jam setengah lima.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f651495e6d47cde53131e1fa6fc1707f0dbe8a6596cb648f8ec2b0ae62bdf5b",
      "text": "Jam pitu aku sarapan.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "700f4195a1a0c18778484e685b7645631e590a2fe01199f9fb058d6477a06189",
      "text": "kuwat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "731c0dbde0bd07b2f56fa1a2c192a64e3f1bc6837821cebe912bfd1dcaf18e85",
      "text": "Mohamed, aku arep nyirami kembang.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "79ad01b63c58dad646d013ac8a10d5a0b4346fa20c09a2579db152a9174ac2f2",
      "text": "Sore aku sinau basa Jawa!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d0b8e50e83e874697e58de8341e55bf0fa70c15245bdda155c93379f9c7a8b9",
      "text": "masak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d9d31311b3e527b09f086f3f9cfc33c0f7267b366cfb9a9b8a37a2ce0c55656",
      "text": "Aja lali mateni lampu, ya!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "820452204e5d42e02cd97dd97620cbc15526f3c78b88e52c58a80565f5bd1278",
      "text": "Awan aku masak. Sore aku nyirami kembang.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "83f52e530bdb99e1e3c5c02a2c41c07cd342b24a59c2313ceb1a1c4b30b0ca4b",
      "text": "nyirami (siram)",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "8740d50873e54f4e54af1076c609f9837e9db21b95995059ce430fd2d3456c59",
      "text": "nekani (teka)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8856eed195f280d149c2b25485aeacd19f0ac168c4147ea5f6eadc21321994f2",
      "text": "Aku ngenteni kowe neng stasiun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "89be546eb92dc2057f608d63befa693f38da56a6f489ef397f22dda2691cd5d6",
      "text": "Subuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e7ec053b5a6f994303b77981f4860c5bfa19041301a91f3b64cbc431e5f27e1",
      "text": "Wis, Bu. Wiwit jam wolu, aku mangkat saiki.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "901ea6d18a6a34496051d448cecd9b7bc90cf2780a025a59072ac8dcb1b250d3",
      "text": "Iya, Bu. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9074dbc5c8f49c85975e7e48eb709d616177800efd219fd886ae818127b6a777",
      "text": "Sotone wis tak gawe, panganen, ya.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "94de6fe24a9f417a5db6371a50806ef3148b407c795502f44db8a2d3515f02b1",
      "text": "Mohamed, neng Kairo saben dina kowe ngapa wae?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "95e2cd80c1cfe25d7c7612f4f4c4ec208dc28cbcf2e949b96864d55e387af173",
      "text": "weteng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "977d21b98fc67e950481639eb1a13826ece4689230adfddbf1ed9d9cea503c39",
      "text": "Sari, Ibu neng pasar karo Bapak.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a4f5b635a80bf22b7ea678f25bff21621112ca85cd644fad73b7500b6767e61",
      "text": "Tulung tukokna gula, ya.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ac09cab246ad3f287f67bd9a6ef3d1a5e1f8e417127ddec0bc162786594e9cc",
      "text": "Awake Bayu kuwat lan sehat.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e06ea82343954ce16265bd126d62d8f5f0fe3a4f1f43feafa56ee06ad80a6ad",
      "text": "Aku mriyang lan watuk, Sari. Awakku pegel kabeh.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fcfc02e9ae9b29b83a0fb5740ae95b28aabc7ab1f986754370632d3aa1dbc5e",
      "text": "Mangan sega anget sik, ngombe obat, terus ndang turu!",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a12289714ba8602d1824cea22c02c7632fe369067778c53ec2f527a71c3a0d41",
      "text": "Matur nuwun, Nduk. Enteni Ibu neng omah, ya!",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a16e3d812b2c558e71da70c20d685afccb420109dc3871f60f0ef73d608a4cc0",
      "text": "Rewangi aku, ya!",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2e60c25532d6bb9ef9bff83776a7d55be778b72db8ec7a74a1e3e4745786a6f",
      "text": "ndang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a42021f636701ce93dde949a31fdb0ab82e117d148daa44c9647c03d6839c4b6",
      "text": "awak",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4269cb3d41b7899fa830f45770dc2a84d381a1f9d7b8d93009e0fc1b92c7afd",
      "text": "Wacanen bukune!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a453a1ee2bbd7dbf93d75d3eeeeb3927a0ee20c06f114fe5eee2d589af3219d4",
      "text": "Sesuk aku nekani mantenane Dimas.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a75c19e703582ea281b8d4a61189efcc16ec15ca07148a026c5306181345398b",
      "text": "leren",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7f01a5f2640bf2b028345d8df7d482a028c4e7b054b83ddd2194b3e1feecb5b",
      "text": "Ibu mulih jam sewelas. Rewangi Bayu sinau, ya.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a96cb29c73e42866f503800584baf82f266159658324912390c6ff04d7dc54f6",
      "text": "wacanen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9fe27a31ffd2355a80af8b4dc61da5b2a4842cc74dd66dee5b3845d0adf8b75",
      "text": "Sotone sapa sing gawe?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "abf402635bebe3a0b85257890f994bfa490d9ee3e551a44af48743718ef107a6",
      "text": "Wis ngombe obat durung? Ibu duwe obat watuk lho.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ace98dc7b1c8b6e1b96682b4b989aae52cdc2f51d7ae1a7c767ef08d132bbaf1",
      "text": "Adusa sik, ya. Mengko mangan.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad05d24ae99f914881c5b29fdbd101f4ac8ecf586caa083acb3289ddde7658f5",
      "text": "Iya, Bu …",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae736652ee0cd5acc7060a7d47b0e4bb9e66582b9677129cf29bb7a135b8c90e",
      "text": "Sari, Ibu neng pasar karo Bapak. Sotone wis tak gawe, panganen, ya.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "aed764d2351a903f79df01eb122c5ea55d0499b8c21845355f4d1686f8e7a3cf",
      "text": "lali",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b28fc7860357363a10833cf05b126b74ace1c351caad5dc8116daa15cae6e5e2",
      "text": "Iya, Bu. Nanging leren sedhela sik, hehe.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4b54f16a342531bc1ebbc17b354768966abe97fdc103b9bc0b3c4bcdb683191",
      "text": "Jam wolu aku mangkat kuliah.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b53fac6e4ccfc7b90ddd95568d602e7fb640421737d4b0994dc75be25d531c90",
      "text": "Jam pitu aku sarapan karo Ibu.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8329f65786b11602a9de1e3e1dd3b6a03bb270ddda31ada55498dc97a734c9f",
      "text": "Ndang turu, Le!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b91ac34b2c1cae8119de2e6554bf51ee4298844481e948f96b0d7a0f8dcf3dd6",
      "text": "nabung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c058240b5beeac7fa6e7621e42159dabd910f1a84127b05b177be339716d1c4c",
      "text": "N- + teka + -i → ?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4dbfaa046f6888a2697a594b3abac181796db92e4dbe06d774dc0e4571cb525",
      "text": "Aku watuk. Ndang ngombe obat!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c815f8f6e86be28b2024e6de4b07b258acc30b22ce5c4192f60da8eed2c9b746",
      "text": "Neng ngendi?",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca1a39206e1d7e082b4de3eb0e56064017982f647ac4fc8f40bbe88460f093d4",
      "text": "Aja lali nyirami kembang lan mateni lampu, ya! — Ibu",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccaf221b123896be017fb4a795ae8242c81f9e09fb6cf45ebbf8ce7bdfa072a1",
      "text": "Bapak mateni lampu saben bengi.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd60b43e171555f60ea8ea4bf8ce2e7a2891804a46e3ebb2d7bf415c673b3cb6",
      "text": "mriyang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce17d3ddf1d9be1cbcba43ab88c53c2ec24c82f9993412659cdebf16cb21e78f",
      "text": "Bapak lagi ___ lampu.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d19586fc87f806a98b23f042dac6f4a25fbbd16351ff9194719a27b2c7e32d61",
      "text": "Enteni aku neng stasiun.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d294f0514871d70fa89becd423176f1a62576c819fb73d7028ba2b254d1427b1",
      "text": "Wacanen mengko. Panganen sotone!",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3a6ab4b2ced965f291b83cc2dfe70a57d210aa58cd4f7b96bc24d8b115ea654",
      "text": "Wis mangan, Nduk?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d437c6d02bc3af64c42d593ac35ef3066b6a3ca5f8a8f5d0cef1cdbac54ee70c",
      "text": "Mengko sore mbantu aku neng warung, ya? Bayu tak kongkon tuku gula.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d73c073810c2d0c7dc91d4493b0cc3e4ed353da39081341a68d66ec3308394fa",
      "text": "salat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d758b1ad36188976b5da587444b2aef7c1ea16e6b928817263f60985aa950f7f",
      "text": "adus",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "da426c74eed11ed820d94410369dda06a65f2c7bc5bbbf005da0d2fa11a311a2",
      "text": "mangana",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "da7c0e02f7fefc9062424c2d8159622706cff0e2957003bb4f953e4295a50489",
      "text": "Tulung tukokna gula, ya. Aja lali!",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "db834cf7286bacd0b7e285ba3e2eee1348dfdb91c2d5b3933c9dfee8ab7b0ef9",
      "text": "tangi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbc5dacc5d9e610c8f4d66919d5e8989f1bf378cdff56367e0cabebb9b18c7cd",
      "text": "Mohamed, kok meneng wae? Lara?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc5dbfb6152c51d64b1d1acbac20ac5986f3f387efe36e0fcabf6bfde46ab0e1",
      "text": "Ibu mulih jam sewelas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "de1c252515800a4c66173360e87fc0d9df44b182841c7a9744512c395eee7136",
      "text": "Ibu nyirami kembang saben esuk.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "de810f1033533311bae200302dfacfe6c02ca6b50909bebc82aca252ebef954c",
      "text": "panganen",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "df650bb677ca872e3c103c9655d336bd0d865af7c2dbb2330844698da459b980",
      "text": "Wacanen bukune, terus adusa.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfa04143ef793f22ac15abb7eb69ecad31d4ec2f343013a5324627f60a5fcb47",
      "text": "Sari, tangi! Wis jam pitu.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e05f0c7fea198e8a45ce6dabadc45aeb7101c6e8715e9a269146d881ace78beb",
      "text": "Bu, aku arep neng pasar.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0829ada6b605c85bfd7b5c56a4d0096a923e5c8314dd16ffb7cccdeb0798c0b",
      "text": "Durung. Wetengku ya luwe, aku durung mangan.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e13f36a4a24939d4291311e3427323bfe52a77ca3da96556346ecf6db33a6947",
      "text": "tukokna",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6107d4adf1b1789c1b2acedb1c332786ae04edf57a806f509893c1d5462d8c7",
      "text": "tulung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e87008b3be27e963db258ddfe5cfa9d22673e5f2b20772bac87141404d76ba33",
      "text": "Aku tangi jam setengah lima, salat Subuh.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea82a966e9afb20be24aa1081afcc6c05f390a826151ae2972e41c35d139fe39",
      "text": "enteni",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec01b4234690ec7138183ccb803c2a18aaa4c9e28935b62314c3b70842488eea",
      "text": "sarapan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee47f80f5e890ce9bf738fe4342e0503af4a5dcbdfddc1a9c66501420192cc80",
      "text": "ngobrol",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f038743dcd7d9b799475e40628720a0cbcca277fbaf8919b8c29dd6d4dd67055",
      "text": "wiwit",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4d5e8d80ba3ba599b5c853f65b11e5f96c9e71ff6e12a9c833b046415b340d0",
      "text": "mbantu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f61d6c29077ae92580b8e716968636260514f14de7168de7fcd346d07cca81b7",
      "text": "Awakku pegel, aku mriyang.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f700340e8f12d68ed0d6f26e0eb587e5faabb6d20b78dd708a0b1d9ab125f9c7",
      "text": "mateni",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f77a47e2c41b3447c440df349cf940d25bcef23026e5200e529858c51a638c96",
      "text": "saben dina",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f80b4e879562db6144f9d3302026324dddc54c83690fc9b50970215cfa9e7ee3",
      "text": "aja / ojo",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f90eff9b9cf749f2a8ab3b3b3260a42fdc9ce6497f2df2d827f9997cde98e16a",
      "text": "saben",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9d62224e3f46f33a3660f32f1c75766566f568d96953406830162f9b5d078d0",
      "text": "Aku adus dhisik, terus mangkat.",
      "voice": "jv_siti",
      "chars": 31,
