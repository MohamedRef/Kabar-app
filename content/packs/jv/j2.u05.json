{
  "format": 1,
  "id": "jv/j2.u05",
  "language": "jv",
  "unit": "j2.u05",
  "version": 1,
  "content_hash": "e38d417b4872156f3b1100f550a8260f78932e02596e393b2fb5ceb1880c95e5",
  "lessons": [
    {
      "id": "j2.u05.l01",
      "sha256": "91ab9c9c9b17eb1879c03639549e0824ab97c286221e27a0e80f18563fc8653d"
    },
    {
      "id": "j2.u05.l02",
      "sha256": "5d183e0ef74784bff88bbc46508aa57f7fcf8302379950997d368a2ae55ef046"
    },
    {
      "id": "j2.u05.l03",
      "sha256": "4354280366c16f556c225511fcd1e350c50a659024dd2e9abd394e2e35c5fc80"
    },
    {
      "id": "j2.u05.l04",
      "sha256": "dabd7e9063d9e650c829f341d93c28bbd6e5f01b55b8f26178a0e4ba86ccabf6"
    }
  ],
  "audio": [
    {
      "key": "102d305ba04a4fd40b91767c37c5cee9c1c72929620935a034c7c1295f34355c",
      "text": "adusa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "106f7a1446d408e500923a3b34cde0e68ecb31ae1e441f60d0f4ec5234fce6ff",
      "text": "jupukna",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "107a5a0256417ac3e7c41903be3d7ba251927c88ca858ff3832ada6190738bad",
      "text": "Awan ngapa?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1356e20de871db0eda8c7418cabaea040a994af5b4fe965978a1e3ff35f2049a",
      "text": "ngenteni",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "192c8c129c6d51ba85c9f64de190aeb718b44c2c6d97f53286a381f4dcb5bb4f",
      "text": "Mangana sik, ya.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7a7e241bf7a477600e54b3003a818878e051690e5581da2bc113af198ac85d",
      "text": "Jam enem aku ngresiki omah.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2040b5c3660a00e3d7f2494c96bfa849377c637f06af6116de1aac50d81101d0",
      "text": "Ayo, tak kancani.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "206590260c96f6c773d872f5d0fb1aa06286e0d7f0b8f410bfeb773e01c3466e",
      "text": "Jam lima aku salat Subuh.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "224f89530ece1a8584755c65db4ec64cccdd172ac7f2639836de08ec9fe7a129",
      "text": "rewangi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2277103d0eebe83c5d1bbb10a25cab0360d937ca97bec42d52e05973e6716045",
      "text": "Matur nuwun! Mengko soré aku nekani mantenané kancaku.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "23eb652d8270f1241d3ec1bb553af7cb692ddb32224898cc95c8ee12d97fca2b",
      "text": "ngancani (kanca)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "26cf77152bc2d9e014a115c0a234dc0f66867825e5e4a06dc020f674a2c79081",
      "text": "Saben dina aku tangi jam setengah lima.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "26f90010a48373634fd24cb8b68b8f8f7a28c727c90e3ed98a10ad6cd9df9b6b",
      "text": "Aja lali, ya!",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b4b7f5bdc12547409427e1752c6dc62b521fcba3fa3e689d5c1c2b511524bf4",
      "text": "Neng Kairo, Sari kuliah.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ef760df6c6f9be539c56d9733a375269f59cd532826dfa3eaa076454ed3c75b",
      "text": "Apik! Aja lali turu, ya!",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f177a3f717bb26759e121afd6aebc4ad943f60cade8881090d2532453303abc",
      "text": "Tulung jupukna, ya.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "35d45f6e033ec7395976066d8eea13b2f41895b5a1641b1646e09688d5050126",
      "text": "ngresiki (resik)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a6f28ee4b36e94b4e4a7d99ad64a29ba0bc35ef461ffb53871cd863b2cfd94f",
      "text": "mantenan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b10d62b3f1f3592460c0807e78be3433608ceca91ccbdbfd4a8fb45c91d5611",
      "text": "mangkat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be59c2b2facf234adb641dec8c7ade445419118c8a306acd7f3ae426fff8ca1",
      "text": "Aku tangi jam lima, salat Subuh, sarapan.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "451618bee49b69a59fb3d8521ce6a2946065dd4a4383b8df5b011ee97c570e3a",
      "text": "Soré?",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "47661ff4152e09fdbf014c356ff56742187ccf2445be588753c334ad40f2ef1b",
      "text": "Aku ngenteni kowé neng stasiun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "490540275125cb685ebbe4fca601a2efb010e5df8edfd061ed3e455f00a4d9c2",
      "text": "Wah, dinamu sibuk tenan!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e1f931a28463d37beaf9c707b79128efbc9138cc13f761779d8386b269ec5f9",
      "text": "lampu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ed53ccae09a4529a069c8dd48f7feb3647cd921af145d0f7342d39b7734b160",
      "text": "sibuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f5a9adcec7dbfe4ba780cc95dca3897047e5564245bcd1c867130a841bc587c",
      "text": "Jam enem? Isih esuk banget!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "52b0c095d0c71037b2ff31bcc05af886c2a049e0112e42782ea783b3d6f44e46",
      "text": "Ayo, tak kancani!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "549454c3aa4498a3b511f470d3ebd7ddf0cd009e582193995b0e5198888c2560",
      "text": "kuliah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "584ca66ffe45ac197f1eb2cf5aea084aee4650b2325174d16642664d9ccc1db4",
      "text": "Tak rewangi, ya.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a24df9917c68804237346f7dab7ab593f1b92b8a751fad35ba80e5865b57449",
      "text": "N- + kanca + -i → ?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "6004a38a27d48516b8550e175f2910d496dd805d5d7432cf0344e19a632f5904",
      "text": "Mohamed, neng Kairo saben dina kowé ngapa wae?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6313e03152e2ca5d8102ec6aee1e2c1222a2c0638e5d4d17b6ac9255f54e79d7",
      "text": "Soré aku sinau basa Jawa!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "64edd1e57c8888a6dd83eb18aac76b58a945bfd23637cf968f2d863062b27ef6",
      "text": "kembang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "67362221f56b3240bcc90c5eeb9018547186c5e63d3633d9dc8ac8821f3be4b4",
      "text": "Saben soré aku nyirami kembang.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cbf3281e22ec83d3fb73b06a579922558efe96042d18fccd76cf39f80983c68",
      "text": "Sari tangi jam setengah lima.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f651495e6d47cde53131e1fa6fc1707f0dbe8a6596cb648f8ec2b0ae62bdf5b",
      "text": "Jam pitu aku sarapan.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "731c0dbde0bd07b2f56fa1a2c192a64e3f1bc6837821cebe912bfd1dcaf18e85",
      "text": "Mohamed, aku arep nyirami kembang.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d0b8e50e83e874697e58de8341e55bf0fa70c15245bdda155c93379f9c7a8b9",
      "text": "masak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7efd125a919b24a67251babd911aef101dcb9bdc7f2e4a52cc49e8b0c2976ed7",
      "text": "Bengi?",
      "voice": "jv_dimas",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f72989e79bceed5282f2e533ad1b3db7bd06973a99ecd604bfccbb2b3a2783e",
      "text": "aja",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "83f52e530bdb99e1e3c5c02a2c41c07cd342b24a59c2313ceb1a1c4b30b0ca4b",
      "text": "nyirami (siram)",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "83f9d1d6b11e1a1e3ee1ef1de0436307a389f0a7b921ef6e816d5818465251a2",
      "text": "Awan aku masak. Soré aku nyirami kembang.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8740d50873e54f4e54af1076c609f9837e9db21b95995059ce430fd2d3456c59",
      "text": "nekani (teka)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "89be546eb92dc2057f608d63befa693f38da56a6f489ef397f22dda2691cd5d6",
      "text": "Subuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a4f5b635a80bf22b7ea678f25bff21621112ca85cd644fad73b7500b6767e61",
      "text": "Tulung tukokna gula, ya.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e001f9adeb5270b8373dd676b69a9571d58a8aeb333aeb26ff6cc24a8e12f27",
      "text": "Wacanen bukuné!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a16e3d812b2c558e71da70c20d685afccb420109dc3871f60f0ef73d608a4cc0",
      "text": "Rewangi aku, ya!",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5b54c525211e0cf4bcd0a9d07f070bd566010fa63ff28e164db880be2a2da1c",
      "text": "Sésuk aku nekani mantenané Dimas.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6e46ee9fa79f5f5467b7cc476fff0eddc1a807d6448e7543f297cdf25242acd",
      "text": "Neng Sarangan. Aku ora ngerti dalané.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "a96cb29c73e42866f503800584baf82f266159658324912390c6ff04d7dc54f6",
      "text": "wacanen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ace98dc7b1c8b6e1b96682b4b989aae52cdc2f51d7ae1a7c767ef08d132bbaf1",
      "text": "Adusa sik, ya. Mengko mangan.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad05d24ae99f914881c5b29fdbd101f4ac8ecf586caa083acb3289ddde7658f5",
      "text": "Iya, Bu …",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "aeb64f482b82e87e253b3516ab23beee0fbe19bff527f21b089d6037e966e717",
      "text": "Bengi aku maca buku. Jam sepuluh aku turu.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "aed764d2351a903f79df01eb122c5ea55d0499b8c21845355f4d1686f8e7a3cf",
      "text": "lali",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "afce9c033caf7ff754a4d951311ae8e43acd0273200aea7e0a8b97d99945b4f2",
      "text": "Saben dina aku tangi jam lima.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0a9d684bad577a8ea64839013622f187fae1dd8af803143f7843a9875d9c3de",
      "text": "Jam pitu aku sarapan, jam setengah wolu aku mangkat.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4b54f16a342531bc1ebbc17b354768966abe97fdc103b9bc0b3c4bcdb683191",
      "text": "Jam wolu aku mangkat kuliah.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb5f536a4be08b77b3186d151c1499843198e7c27523e1f83bfe0a9dcf14d1a4",
      "text": "Iya, Bu. Ora lali!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c058240b5beeac7fa6e7621e42159dabd910f1a84127b05b177be339716d1c4c",
      "text": "N- + teka + -i → ?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0acde028ec8da1decfa3cedb5e8d8071886564767b40f6c2d07d5903ed05a62",
      "text": "Pateni lampuné, ya.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "c815f8f6e86be28b2024e6de4b07b258acc30b22ce5c4192f60da8eed2c9b746",
      "text": "Neng ngendi?",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9c32742f8b4fd78eeec67cd657116cfd8ff2d956d1e6db0e97f17d058bdfcaa",
      "text": "Iya. Jam pitu aku sarapan karo Ibu.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "d19586fc87f806a98b23f042dac6f4a25fbbd16351ff9194719a27b2c7e32d61",
      "text": "Enteni aku neng stasiun.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d73c073810c2d0c7dc91d4493b0cc3e4ed353da39081341a68d66ec3308394fa",
      "text": "salat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "da426c74eed11ed820d94410369dda06a65f2c7bc5bbbf005da0d2fa11a311a2",
      "text": "mangana",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "da7c0e02f7fefc9062424c2d8159622706cff0e2957003bb4f953e4295a50489",
      "text": "Tulung tukokna gula, ya. Aja lali!",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "db834cf7286bacd0b7e285ba3e2eee1348dfdb91c2d5b3933c9dfee8ab7b0ef9",
      "text": "tangi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "de1c252515800a4c66173360e87fc0d9df44b182841c7a9744512c395eee7136",
      "text": "Ibu nyirami kembang saben esuk.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "de810f1033533311bae200302dfacfe6c02ca6b50909bebc82aca252ebef954c",
      "text": "panganen",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfa04143ef793f22ac15abb7eb69ecad31d4ec2f343013a5324627f60a5fcb47",
      "text": "Sari, tangi! Wis jam pitu.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfaab713f9961ebe145bc6a4a7ec10ed5cd4acec4112f4780f0eab6b45655412",
      "text": "Sari, saben dina kowé ngapa wae neng omah?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e05f0c7fea198e8a45ce6dabadc45aeb7101c6e8715e9a269146d881ace78beb",
      "text": "Bu, aku arep neng pasar.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e13f36a4a24939d4291311e3427323bfe52a77ca3da96556346ecf6db33a6947",
      "text": "tukokna",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6107d4adf1b1789c1b2acedb1c332786ae04edf57a806f509893c1d5462d8c7",
      "text": "tulung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e87008b3be27e963db258ddfe5cfa9d22673e5f2b20772bac87141404d76ba33",
      "text": "Aku tangi jam setengah lima, salat Subuh.",
