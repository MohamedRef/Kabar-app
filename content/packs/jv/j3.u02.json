      "sha256": "af34f5fa362101677d031e890fbc8e067810de7a843aa003654e7bdfbcf9963e"
    },
    {
      "id": "j3.u02.l09",
      "sha256": "409d2dd48c4a8c4b785011d3921d309527f2a1e653d2d4d538675e4d20ed5de1"
    },
    {
      "id": "j3.u02.l10",
      "sha256": "fd9c5c9c3935a601178edbcb547fd1c1b646385eb41b09ded2de2faa3c037dfc"
    }
  ],
  "audio": [
    {
      "key": "0018c377816279b39c794c7b560357848ddbf60552ae3cfc490690df9693af5d",
      "text": "Lemari kula sampun kebak oleh-oleh!",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "024c99af6a769e89943adadf595dda21cd1a51645bd331127221f303dae6a2c5",
      "text": "Sugeng enjing, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "04fab94f3d04ad2dd3fca9f6e5d1fab61512986851c1c986867a9d2eeab822df",
      "text": "Mangga mlebet, Nak! Sugeng rawuh.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0899e8fe1dcada49cc33df611979c71085440911f7a96a2c232c45ce63eaf7d4",
      "text": "Piyambakipun sampun nedha.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c92bcde7a44c557a39ab85dbdfc22289ad3a4839c677c22b174faeeb845759b",
      "text": "kori",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb42636b664e9d9f1fe95f0fcc1b351cb68c03a3b236f4d46eb5fd2b737cdc7",
      "text": "Sugeng rawuh, Mas Mohamed. Mas saking Jakarta?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dc2c304665aa92c5dccd52cafa6871bf338f76928c3488e669457cfe6ad6fd7",
      "text": "andhuk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fcbc13d043b2ddd2cc39f1a0b7f3f400f1f634f77b7f3cc1d84a139fcdc3747",
      "text": "panjenenganipun",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "100dbbb56e96ce53067115cfac3bb3922c40552ec38069509f0e1f0897492b6c",
      "text": "lantai",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "127d4ebb00fd2cc4dd51be8b2f10d2b39d29da1d42459f050b6a14676e28c53f",
      "text": "Kula saking Mesir.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1377dee2e0ec085830a9fbc54beb8575bcfba77f3d49bf0c733f9e3c3ba94e77",
      "text": "Menika simbah kula. Panjenenganipun sampun sepuh.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "14328419a4f0b47cfa75e859ac4b0fc7898b230e9d8e3aa026e5632ad5884ba0",
      "text": "Linggih, Nak. Toya napa teh?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1485bf7350fcf9aa60c9ee162b01d17ec1f7ff7aeb3574f7adbf556e53ee74fc",
      "text": "Sugeng enjing, Mbah Putri.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "159ca612da69f16a93b98ed4ae1567aa2a2c441eb3af9a4582d30c6961898364",
      "text": "Kunci kori ing meja, Nak.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "17053d36c1af9358cacdda79efa45ed2203c83977e61be60fd7b3d95ef2c71b8",
      "text": "bantal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fe79abeb4b04861217c36d549b40dcb8ec46860cc9ae3afef606aa280baa826",
      "text": "Dalem, Mbah?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fff82e636e2d95e502b5666969c62c849667c72d9a3bcfc5a896865db9ed47f",
      "text": "kunci",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "282dc5ced437e9c8620bfe21c422e242dd196b0ae26767a1d41151ee7101867d",
      "text": "kuciwa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d0b1a1f8f26342890777141c26759d1cdf1768fc7e0daa888178cc43e28a54e",
      "text": "HP-ku ora ana ___.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e2c455b1c1561bb864f856f080628b022963dac84dc59d56b40d0edd0b67269",
      "text": "nyimpen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eb7843d4a38a0c250e58646f41b28e517ed64c5fc6e89b68f07dfa238ab137b",
      "text": "Kula ing Pasar Kranggan, Mas. Mangga!",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "315177008c70deba2af14e49e560292c565ee1747e51b73c42387d5e6f314f34",
      "text": "Inggih, Mbah. Mangke kula ngandani Ibu kabar kula.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "31973c19f05f9e9f48b748f2bb09eee2c11be8c7f2f6da9b9710c4378d3a6682",
      "text": "Wau Ibu telpon, ngandani kabar saking Kairo.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e2cab6c9a1de5bf4c112f773287aa33e1277bf6b63b58e8b2c9f7f60574695",
      "text": "Inggih, Mas. Menika griya kula.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "338d20450c149a952573345837e45a3eb8ce4d27b8ae20c6bf9de85373f1dc3b",
      "text": "Ayo, Mas!",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "378db8091a6146072802741997f0d2a05b8b82a5c9a242af9cd1834d9a43a5c5",
      "text": "medal",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "384625a6c9487478e7a6b41f752cee9ad6e9b249ededd5370613afa7e7c9d87d",
      "text": "Piyambakipun saking Yogya.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "3acb23f62e07179790dd02453870aa2f34e39c9709122f645d58252f5ab71ab6",
      "text": "Inggih, Mbah.",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f341d270785a9a57ad8e931d3d25db6fa51bb114b655cc3d963ed580479aea8",
      "text": "Tas kula ___ oleh-oleh.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f5633b5d9a30d4dda6077228382fced7f34d8473de73bec3164619a2eed8aee",
      "text": "Mas Mohamed! Sugeng rawuh.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f7ea451e8a5cf250aa0b12135c2f7741a85231822521c63ed4de8341e5f34fe",
      "text": "Inggih, Bu. Piyambakipun saking Yogya.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "40dfb47c36b7d7a992a6434fc52f88f9ca06c8e364dc7f21d0d076c0b16c60b5",
      "text": "oleh-oleh",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4299e4656c66e54fb02589e656a8082366dad9a5d9f2b4e45bb9341c762b1be9",
      "text": "Matur nuwun, Mbah.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4367d2473db546bf7a45243942446d1d8075d46f2fcf086eaea260209d95b30a",
      "text": "Salam kangge Ibu saking Mbah.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4739a496e5d26a0646059da9adff35d7939ab4bd3dca4793e1d2d73382370f56",
      "text": "Nak, niki kamare. Rada peteng, nggih.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "48e031542ca627fc37e24f7c3c798b518374a63880a31a5ee0b5a9114476242b",
      "text": "Pasar Kranggan",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a2e06bd0a0c57f402e660b873ffcad217d767c55fe720424416a10553425024",
      "text": "Le, iki layang saka Mohamed, to?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a30fe93fac18c00cb933f4bae682b33a47c8f0e31b33e70996b6f2fb7ebc5cf",
      "text": "Mbah sampun sepuh. Panjenenganipun saking Jogja.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a7dfe39b5aefb5e9fa98f00a19e5f0736a8399c14db38df9255960190297d2b",
      "text": "Sedhela, Mbah. Kula medal.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c7f6f8ba8559f79f4d5ba6a3831056d7f7302065fe3e93cff64d4dff7acb80d",
      "text": "Oh, Mas Mohamed. Sugeng rawuh.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dbca0a41ca0c7787aa053fbe64045a4cfcd7b033dad6aac3ca33192e816010a",
      "text": "Oleh-oleh saking Mesir? Wah, kebak!",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e00e27b061d8c7c3db5e7df0ca86b10698b49cf6fc59eafc63ab157e3f7ea68",
      "text": "Nyuwun sewu, Mbah.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f4b2b1e557243f9587a8ed35f26dec82466a308eec3dc3d4b0a2fae237f6f89",
      "text": "Mas, Mas Dimas niku saking Yogya, nggih?",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fcfb13dc8540cab12c108894c73b4399ff2cad0661b9284628292e7d9e68b80",
      "text": "nomor",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "50f0b3241b501158439d1ad86e473842237b8b7f82c8384fa36704222163342b",
      "text": "Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "53b21d9209272653951a663a8a8422fae8606afd3ec172d1709b1b432ddc695c",
      "text": "Mbah, menika Mohamed, saking Mesir.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "54c0b277cb3ec06d5afafa682ea2cfe13ad23c2392b080b1aab6bda15e6d6842",
      "text": "ngandani",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5558901558f47bbc9923e465554409c0fc186eec5964d63b138e1c857049b2fd",
      "text": "Dereng, Bu.",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "57da2067c7ef69fd7a1b49d73c2c73e70387636e3f7ae54be955986206be1e9d",
      "text": "Toya ing meja, Nak.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "598f8997793f3b5d30e39558db2e1c2c9985243ecb962395d34816480d60031d",
      "text": "Sugeng rawuh, Bu. Nami kula Mohamed, saking Mesir.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cec5e1dd5931cb68eeee550e29c342bac42a2af1de84787100ac5658dd0bacb",
      "text": "Nak, kok ketok kuciwa?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d644bba83034a55c304aae91878963544d39de9245f3bb55a6e6f11abdbcb30",
      "text": "Wah, Mesir! Sugeng rawuh, Mas.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dceb14c1859d81d80ed3f1f099c8cf0d01ef5749f2160439adacc2dd99fd307",
      "text": "mangke",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "618f07f1b33203b5564e674b09019f1932ffbc9b68fbadb275f52367473c73c4",
      "text": "Bu Siti, menika kanca kula, Mohamed.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "64485b2fe5d7ff7d65b4558610f3a4eb41e45aa373040eefe12390b0e1ac1424",
      "text": "Matur nuwun, Mbah.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "6663dcfdf91a6ea19fd86b11222718fc0d58d50d750a5921edb537c0b155e90d",
      "text": "samenika",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "68aefc7788501abc6d6c3eb840bcfc92c29b2eb84226598f0820c6bb7e88194e",
      "text": "Mase sampun nedha?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "741974688375c00ba16362c9c9bc8e78f0a6b7b491368bc19f647e7d8595a883",
      "text": "Menika griya kula.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "754aea7a8f1e0b8a22d00496897221032c4d79ad8e433dbb2b2e7a55ae129fe2",
      "text": "Sugeng enjing, Mas.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "761751068ff21d959f82f8ab00261f8aec63e2a3fec8bf3d3ad7caa7b9332f80",
      "text": "Mangga, Mas, mangga.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "77dc2904496107e90dadae11bc7468ca12ab527be3a4c64f9f2a2339c69d12a6",
      "text": "Mbah, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "78971c251e2ebafb237dfa14d5ec30c20cb107906a072b09c6f3c6cf76f7b452",
      "text": "Oh, nggih. Sampun nedha, Mas?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "79f66281924ab4dd50cdb94b92f5e5bd74d01e59724d44f240dd577aaddc66f7",
      "text": "Inggih, Mbah. Menika kangge Mbah lan Mas Dimas.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ae4bf1a107e99da75970eab267d690489ff443b0dcbb4233349203db2198b70",
      "text": "saking",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7afcc4d29d6204567dcac2fd5c813ffb5c7d18f6dd20bf98fece5ed767b10ad6",
      "text": "sinyal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d4b5e3621e1426709500d9235d623a4e2e5cecb786466af4ad4611f6456e340",
      "text": "Sugeng enjing, Bu. Nami kula Mohamed.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d95900279f97c037baef9e9ecc11295c2386443e1487e9e161b54d3e5314c56",
      "text": "Samenika telpon saking mriki mawon. Sinyale sae.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dd597d08cfa72ca1fca09f72a82deda76351d36b6468cf00e4532e6e4505343",
      "text": "Mohamed, ayo mulih, wis sore!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8259db1110f356c438a3d45232a54fb4f626abc812437151f78e556bfd588114",
      "text": "Mangga mlebet, Mas. Sugeng rawuh.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8303b8d9216c975f9b0fd99493caa6e8ac468a387886b6517f09a8bfb5ecda4a",
      "text": "nami",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8337080da9c9ca9cce82547ff8d7393d57b7775f984047633273453e1697788c",
      "text": "Endhog (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "85aac627a6c5a42cb4f04812e2a7a325373b99ecb7ec1ec280fe39e1b4b9e2f2",
      "text": "Mangga, Mas, mangga!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "891cdb46239d443937a3538c18e96e04c87abecc3100202b3b7adae057340993",
      "text": "meja",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c6551b7b469670d0e2853bd60ba8b6aef8c71c8cd4cbd94f9aef2d33d9f8aab",
      "text": "Sedhela, Mbah, kula medal tumbas gendhis.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cd27624f0df2e4fdb12276a4c8f68225288ef2672c337e977b1cda4407a1664",
      "text": "Andhuke ten lemari, nggih.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d54fc40b80d2ae2186822c07392ddfb006eb15f535cc07a4f56656d48ee9883",
      "text": "Kowe ___ dhuwit ing ngendi?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fe3bd49ab131ba08cd2615790f38f3ffb2e490df8fcd6f0d18b12d15f720f0d",
      "text": "Sampeyan sampun nedha, Mbak?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "9156b151a6e757e9242241cc9c509769367a19736596defd0e6ff97af32097c8",
      "text": "— Mas Mohamed! — Dalem, Bu?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "934173f54d50af5312c5e61c146277ab162fa5acfdb873e3cef673f0729212d2",
      "text": "piyambakipun",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "93799c74d417d2d4bdb4f06beda638d5a1525e82502f7b5e8fac741134fe8e9f",
      "text": "Wah, saking Mesir! Mas Dimas, simbah sampun dhahar?",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "940700644173478329f3c3d79b8ac049ddc0f58f26be91d5cb98f4c3f5a038c1",
      "text": "Kula lan Mas Dimas ing Pasar Kranggan. — Mohamed",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "966193ba1ec28068776f8b4ded79421cccb8c58d09657a65cf14ea535a9807d5",
      "text": "Mangga mlebet, Mas.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ee8d61cea8b2282547f2b67f92a6079433271661dc447b0fa384e02c69d021",
      "text": "Kula nyimpen andhuk lan bantal ing lemari.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "996e9e349e2632fb67791964f7c2f88172a6f73f9f6d2cd1d31fac918b2a5491",
      "text": "toya",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a80f7aabe12ff68df98c6a7d68c4336aee4d592788281de3141d00dffb3d682",
      "text": "Piyambakipun saking Mesir.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ba0a7af4415806739b69b2195b9779adb6c94c237f16a2a8bd6465f00ad5d58",
      "text": "Matur nuwun. Kula nyimpen oleh-oleh ing lemari ugi.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9edcc758fa4ac0f2c724c148fd677f3065b2b867756fe871d94c33d1fd17797f",
      "text": "Mohamed, iki mbahku.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0381cfe3c3d1c38da30ec5dbfe2ebad4d9c92f3fdabeb33f56c549b73215c1a",
      "text": "Sekedhap nggih, Nak. Gendhise ten meja.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a23a92a6b0cb503f8624e513b0e99413e2f0c91168202eb7d5cdb3276637a66f",
      "text": "Rada peteng, nanging kepenak sanget.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3320ee6a00c8943adaf9130a774a75f40d4c8ff58fe1e698164fc8d79972958",
      "text": "Nami kula Bu Siti. Menika griya kula.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3e3888b2efbbac66ad83ea7f05f618963bd6f8637fe04c76ac06cf5105df482",
      "text": "Sugeng enjing, Bu Siti. Sampeyan sampun nedha?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a43c60268894c1da8e08644d41e1fe12e870059cc8ad6c872f1cb2917f9132ee",
      "text": "Kula saking Mesir, Bu. Saking Kairo.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a45ae9390c8468f897eb43f112037fc3659f4f4f29c3b6dfce70ab5396b38777",
      "text": "Mase saking Jakarta, nggih?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa00b38fb3d9f4e7e4535a043233e43651bcc93a3cf0c0d4de0fbe9b90777eb3",
      "text": "Nami kula Mohamed.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ace2d5dbcd455e5968c434ffa7c1cd666a23d6605a1678e9f715c602a51e7bf8",
      "text": "menika",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae1a191683d74d097a624843f3df4e05913fcdfe1d5b1c0f6e19f37de0dba671",
      "text": "Bu, menika kanca kula, Mohamed.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b026970aa45b29ba7673bb969bbabe8fe1fd4c96daa5c9d69f81944e2dcb1c37",
      "text": "gendhis",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b032cd828adbd2640950ef8de30e20f53ac843e0bc56fc21a4addac7414d233c",
      "text": "Dereng, Mbah.",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "b29179861a96e5093ac963ceb252c6e9017ef391a7149efaefa1d5664916d4c6",
      "text": "telpon",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52cdeba775f429d646e7cc05d3a75cdcb1a66cb186cbcd95118acbd25470e11",
      "text": "Mangke kula telpon panjenengan.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b57c7a260339b572b08114b3fb75870e0c1190dd7aa8a417cf94bce8e373f55c",
      "text": "sepuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6138ad0ed570de4b3be24fdf6aa54a0c64b454a480d937f82600a610b7b2887",
      "text": "wau",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6d95ed96991c7bded63392912e76bf4a866f54101c8f994815dbdd77ab690f7",
      "text": "Nami kula Mohamed, saking Kairo.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7a7c23786b41afaf44315958107a3906c1d367c259b3442222fdc478441e776",
      "text": "mlebet",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a67606b53a07acbba406bb61eb5743589d6fb86a917785f031db41de11e5ff",
      "text": "Sugeng rawuh, Mas Mohamed!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9cdc34b2bea65efa0d38700fb99b87a631890cecf648fe55a5925cbe59c4267",
      "text": "Dalem, Bu? Menika griya kula.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c00b38029c7432c26070e7bedc1fcbd77d3e87178f903fa0c4b62d4eb116d626",
      "text": "Kula Mohamed.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e7622fa5b8b43d7c76828f716b2d92bdc72fc492f03817cdaca5b4a685677b",
      "text": "Inggih, Mbah. Kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3cafe7265188ea486adfa967c8cc4f65d9453fc40dd59a71091a70a6526091b",
      "text": "Mboten menapa-menapa, Mbah. Kepenak sanget.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c495203adbc41e46201cc8680b5ac53834c12b6355f7df33c8545dfdd5c3b6b6",
      "text": "Apik. Mohamed ki bocah apik, lho.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c70b338100c5fa55cbe5ce4f6d50ffd930d47cf01d39ca5c35ed40c0656337cb",
      "text": "Menika nomor HP kula.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c771222d8341c49870a90da00f81e872c373a77ff5961fbc606825f8dba3af52",
      "text": "dalem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbdd435fe5fa993d9956877c9e90dae178e7b8a750d6d695ede8fedb66005a1e",
      "text": "lemari",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cce7114027256e054efa30fd9ad8aca7a1b82c2264c65b18757c87d2ccb5e8db",
      "text": "Panjenenganipun sampun sepuh.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "cddc8113507e701036e19878d28206c6747724927d226bc1d22aaa49366d7f6f",
      "text": "tigan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf60543063ec091ffc70e3f6a0346fc4f5923945366522499f886d7551d7990f",
      "text": "griya",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cffbaf0397d1f49ed48c56f421f6931771faa1214a864c3bc8629bc5e5fe28bb",
      "text": "Sampun, Mas. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ee34e6003ef1465bcf12f4546e1e0b8c87bd40bcf98e0bba2bc0dc6c6b36fc",
      "text": "Sampun, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4e4e1e418b26c3ebd66cf621336dc02a6b73620cbcaffaff8f4cb59939fe46f",
      "text": "Kula badhe dhateng Pasar Kranggan.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d57a02f0953971e1aec8698d747ccb8464b4296635cbc7a42bcafa609fd30484",
      "text": "Teh kemawon, Mbah, mboten ngangge gendhis.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d601bdcbcfe4273d5efcc2e925b858e47b8d7851197e238b2de93f8451013a06",
      "text": "Menika griya panjenengan, Mbah?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8f5d630cc7b15fe8d27479f29e0e20b7e8549c96091bec537ebd12c77db1937",
      "text": "Mohamed wis mangan durung?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd800c48805735a42f5bad70b4e6e387c967a4dc0bba82da370203805eccffd4",
      "text": "Wau Ibu kula telpon saking Kairo.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "de13f58d11ce1280c5c365d114ea36d87923a916dd7e2d57a0e11ea2b49c21ed",
      "text": "Kula sampun nedha. Matur nuwun, Mbah.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0e67f297bc3a23857022d2044424dd13317fff1db9fed20b1b03f919fb2e0a0",
      "text": "Andhukipun ing lemari, Nak.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e9b35700bfe0662c0245493eeffd4ea0cf430517e892f68fab78e5a5b46dec",
      "text": "Matur nuwun, Bu. Menika griya sampeyan?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e75f8e14c1584326d651dcec5bfbb7036d5f189588f5f3da9859e63397951385",
      "text": "Sampun, Mbah. Piyambakipun sampun nedha.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e97735d9458db839b44fa814a1d15d384c02379fa8f6dd63ddd87bec7db121cf",
      "text": "Sugeng rawuh, Mas.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9cf47498d6db555d7825ab28359c6d7c7aacf11dcebff5925bbade8eb2e4a40",
      "text": "Kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea5868a03e772e7d1429a346109b759c29bd7153c9d88f297ba0d134840a457a",
      "text": "kepenak",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecb2cdbacd912ff81a7812a10dfc5b79515dea9031992cb00c02d338af1ca544",
      "text": "Dalem, Mbah? Inggih, kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed46485ba90a79ad47ac320a4ba7e89254fa5f80981e8779d160b39f58d31535",
      "text": "Wau Ibu kula telpon saking Kairo, nanging sinyalipun mboten wonten.",
      "voice": "jv_dimas",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee103aaf854f393648bddb7cbfc487c34ea4737ce0269623427a41a932e7c839",
      "text": "kebak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee6accf587d8b7fc60489d100a8f32a4832f8f3924422f63e4aef5aedf204e0c",
      "text": "Matur nuwun, Mbah. Nami kula Mohamed.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "eedabfc2631cb5fece05d8bec14b025ddda21850b31929c75e21258aaff93b2f",
      "text": "Kursi menika kepenak sanget.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0913f95fae78b17d77b7e46459b133df60e7feedf8bd1209ee05a3de1d884f8",
      "text": "Samenika sinyalipun dereng sae.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1238ab36063b5775e6b13830e0fdc51d279bca9e6010883db41496b8e1e2e6f",
      "text": "Kula lan Mas Dimas ing Pasar Kranggan.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3907dc9d9b33b473928c725aad101cefb3516aa6c6fd8f0947812c1bf31aff0",
      "text": "Sampun, Mas Mohamed. Sampeyan?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f48809257bb952fbc0c46958447074b9e5f2b2de8e98e9e5d0b394580a30eec2",
      "text": "sugeng rawuh",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    }
  ],
