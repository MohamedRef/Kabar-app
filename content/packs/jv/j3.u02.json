      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d644bba83034a55c304aae91878963544d39de9245f3bb55a6e6f11abdbcb30",
      "text": "Wah, Mesir! Sugeng rawuh, Mas.",
