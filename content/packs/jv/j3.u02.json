    },
    {
      "key": "e9cf47498d6db555d7825ab28359c6d7c7aacf11dcebff5925bbade8eb2e4a40",
      "text": "Kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecb2cdbacd912ff81a7812a10dfc5b79515dea9031992cb00c02d338af1ca544",
      "text": "Dalem, Mbah? Inggih, kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 39,
