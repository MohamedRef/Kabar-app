      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeaaf95f42b37bd3d6ac4383b24d7b78fd6059a43d9abdc142f23c0687a6e335",
      "text": "Mohamed wis mangan?",
