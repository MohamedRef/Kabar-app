    {
      "key": "024c99af6a769e89943adadf595dda21cd1a51645bd331127221f303dae6a2c5",
      "text": "Sugeng enjing, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0899e8fe1dcada49cc33df611979c71085440911f7a96a2c232c45ce63eaf7d4",
      "text": "Piyambakipun sampun nedha.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fcbc13d043b2ddd2cc39f1a0b7f3f400f1f634f77b7f3cc1d84a139fcdc3747",
