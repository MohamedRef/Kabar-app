    },
    {
      "key": "1fe79abeb4b04861217c36d549b40dcb8ec46860cc9ae3afef606aa280baa826",
      "text": "Dalem, Mbah?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2734e8268c2b1ff2fc9bd18dbc75ccbf4f8fe5f714d33cb2a8412c24facb679b",
      "text": "Mas Mohamed, Mas Dimas saking Yogya?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "338d20450c149a952573345837e45a3eb8ce4d27b8ae20c6bf9de85373f1dc3b",
      "text": "Ayo, Mas!",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "384625a6c9487478e7a6b41f752cee9ad6e9b249ededd5370613afa7e7c9d87d",
      "text": "Piyambakipun saking Yogya.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f7ea451e8a5cf250aa0b12135c2f7741a85231822521c63ed4de8341e5f34fe",
      "text": "Inggih, Bu. Piyambakipun saking Yogya.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c7f6f8ba8559f79f4d5ba6a3831056d7f7302065fe3e93cff64d4dff7acb80d",
      "text": "Oh, Mas Mohamed. Sugeng rawuh.",
