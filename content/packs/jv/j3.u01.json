    }
  ],
  "audio": [
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0343cc712f6cd78f7e63642f2b4f3bbf68e72b6c73d0d49ec86445bd09102f5a",
      "text": "kursi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0441c563690da0373a2d7daffb2759b8f65a707ea551172a7ae2996f418b6db6",
      "text": "manten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "049a986649cd2d7814aec6d70903588abf67bfc4b08606481f0c8192e729dc06",
      "text": "Kula tumbas kado kangge manten.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b9c6bcec6f6a010339d49c002c7d308efc729f68e880504cd833a722b3a84b",
      "text": "Panjenengan sampun dhahar, Mbah?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "06a2817bb08b9ca1a986cbb9dd76970b4c153fa5c032100d3daa18562faa8838",
      "text": "lingsem",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "06f11a15c49efa4070370f06778f7a0bb8b859dce45bc13ab134b65a0190bfca",
      "text": "mangga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "07476724c4dd6b84cce1886c7d103e1dec8891f6487df9d91950713d56a1ced6",
      "text": "Dereng, Bu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "092671682d2a7322d49cbc0dc12faaa32f2a893fac40203bc8957baeb050ed4a",
      "text": "Nggih. Sing alit taksih ajrih, lho.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b0541dd5942d8226138b977909474dc4037f9a64f5156fb7b7bea2fde8591ae",
      "text": "sampun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b0c04299ee23afed97a14a20f3c8a8eb85f2175b68df7a222da18b65db46cf5",
      "text": "badhe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ba68c5d7f9c129e3dda4857a53dd393ce742ecb6f4e343adbb6382352df1acc",
      "text": "ajrih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eee9d594932ba73ca02b9d6d51fdadef2a3e7d5376f0f4dfe4a68c7686ffb62",
      "text": "Bungah sanget saged pinanggih, Pak.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "114170c410f8e6ec3e50a2f38a6e4ddc77ff04fe176ee111e2a5f2fe6d23c895",
      "text": "isin (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "11939973344d3c302f3b671be089e85a2733f0af4978b73008a9e3961ab72829",
      "text": "ngoko",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1213a6e15816022e4e641d82159050f9ff1e99988c43d6f55320263085fd0d88",
      "text": "Mbah mesem, lare-lare ngguyu.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1397bc79d8d461968cad5973cf5c4ee121201cc37a243b71cfff7f16a1c09c10",
      "text": "dhuwit (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "16a24175f4c71adb066c41dfc6716acbcad3aa9ea0a6376cb8f5adba68696f0a",
      "text": "Lare-lare taksih murid, Bu?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "16dc6282cafa25903463dc00a0b5e95d80bf2e67bd4db4cd684fa7d5d7a5cbdb",
      "text": "donga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ca729debbb0b2f960ce250c16c768bfa286891267bdb2505b297aa8fd3214fd",
      "text": "Krama, to? «Sampun nedha?»",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e6e71a9dc4d9fafc329c33a126bbceaaefefea72fb35b0e00d4c0d6f9a7b9d4",
      "text": "Apik! Karo mbahku?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e95f8c3fd640f54e4991cb83d494764c3f6e17c9a9b44b270eaf1e0cbec31aa",
      "text": "Aku wis mangan.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "20e3cd235724bd8d685a692880dd5270ccb882f2b85db09539817cee9d100599",
      "text": "Dereng, Mas. Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2200ec5af85c6556828c1d56b46c7e06c19cd151a00c46df18cfe2104f0f4a9d",
      "text": "Ibu kuwatir, lare dereng dhateng.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "247dc8cbf353abe2ee5859e3ac5a2c2cb97fb6ea27bae9df9422437aaad143d0",
      "text": "Ayo mangan soto, Mas!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "24a278cff9ba98edcd26551a5afe329526d777197da83271241903bc76af55f7",
      "text": "Adhikku isih lingsem, Med. Ora apa-apa.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2782e9662ca2f907dcdec0237a4ac92848f0513f6bd44dd498fa650014e3fa9b",
      "text": "Wis mangan durung, cah?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "27b4ac2f691ac4e16824731573b92b538e1420faeadee67b8e4b85ce4701c7bb",
      "text": "Kula taksih kengetan mantenan menika.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2879e05da060368b3baaefc6b7bd2693c61c250c69cbf47a13d46d0424db3059",
      "text": "Mohamed, aku ya durung mangan, je.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a569d274d2cede5fbffab640fe46552c99e449da7bdaa2812d489260824b2c",
      "text": "Wis tekan, Mohamed! Iki Lempuyangan, lho.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b0571dabfe6b87b096bbb64c5b176e2fa71a7ad8aca25e3e1b50df29a435e9a",
      "text": "dereng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b64e9a8fea59984fd9b9f46f22e4a792e1d5b7ab3bebc07631098bf1342463f",
      "text": "tumbas",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c81062b614b454acfb73cecb063528d508984b26c5c7594bd932bb1481601ab",
      "text": "Krama: «Sampun nedha, Bu?»",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d3310531b1a9c5ecdec291b087a5156435073f18f57efba10805b8442e2f3d4",
      "text": "Nyuwun sewu, KRL wonten pundi?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eeb4a97eb4bc2b87faa63c91407663956a368e8dcd02405ba79c5a058f6c83b",
      "text": "Inggih, mangga, Bu. Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f337806abbbb71d3103db3ef1704247bbcd6cfdf24e9923b50662e12b520408",
      "text": "Ra usah, donga wae.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fbe1e2f6e20a46b89bf7442f4bca7a51bac7addf7c707c08e19dee91f48b0e1",
      "text": "sedulur / dulur",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "320cfea52914ee06fba04ebc3a9190432151fff0762f17afff52d3866042d5e7",
      "text": "Lare-lare tanggi kula taksih murid.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "339720efa5596fa13491e92c91c0e7a1c3402b78310053de6db3df9a4e1a4d26",
      "text": "Mas Dimas: Mohamed, kowe wis mangan? Aku neng Lempuyangan.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "339b9cc5e48e3e8ac50ce59a6cd1ff44a84d771688fc4da16d9fce3d660f1093",
      "text": "Dereng, Bu. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "33b921b8d4bf806bcdbecb28e1fd3284cd4804535b5d82ca304a9e73bb3241d1",
      "text": "mangertos",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "344406dce8188e30eb659a65921226426f920f6e3ac7feb4dcc60d48f6ec6391",
      "text": "Aku ya kelingan. Mbah becik banget, je.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "344f60cb4cec30853ac296f76d48ca1b688a979caad60939021dbf70aad42e87",
      "text": "Mas, iki pesen saka Bu Siti.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3513ef174acd5cf33a454e6ce7d53b7ae16395623e01373b502f5c525bb360ba",
      "text": "lare",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "351c0d9ee91d3c1caa5a9c08d9d00d916135720119d1b6f73504719997feb303",
      "text": "mesem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3754f9987692eb152fc9fce57e239ec704bdd83b32a3984d9e5cb3d382d42af1",
      "text": "Nyuwun sewu, Pak. Kamar mandi wonten pundi?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "3936d904334428a2f9e3e6d767f3303ccf16a16bb3f99004903182657ee75569",
      "text": "Mangga linggih ing kursi, Nak.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a268531f55d8cd648bdb815192d40d358b4bc1cec82b6e6e22ad98456d6458f",
      "text": "Aku kelingan. → Kula ___.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa0c831205dd100d7f2011c3ce0dbec39a6bfe3015024b6f1dd35743af3d4a5",
      "text": "ngundang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be4bd898c87131b579f864d63ee0a55362c1d25a205d072e25de387e9e13a3b",
      "text": "murid",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ceaad455cd08972584d78d2114c9285fd7759b524c91097df82d68da8f6ea47",
      "text": "«Panjenengan sampun dhahar, Mbah?» Aja «kowe», lho!",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f2db4a1041b37f38b55f462a7e73f580167ca643e8120e239fe0fca0a89213f",
      "text": "rayi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f6df5e4c49f5daa587484f2314e3985c01e4e6c9a8b676bdbbd0d9802c2a820",
      "text": "Stasiun punika sae sanget.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "418c026e304a3239cd41b774770054d6f58501653aa1bf146c950880ee321b79",
      "text": "Uwis, Mas! Enak tenan, je.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "42993b7f4a52a4a75a207946329333f32348524e6ad44ea8bfffba5909f5cc3f",
      "text": "kula",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "42b705ab92a583bf5eec05a558d55c876208d1dfff3e2fc9d8aa4f0d33aa218d",
      "text": "Mbah Putri teka ora? Nek teka, aku nganggo krama, ya.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "430fc50f946530d042c82670904e126f8a0caa5def5707da70d79da8fa689bf0",
      "text": "Kula badhe dhateng peken, tumbas kalih.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "44223022e5aef56f9dd8d3d9496f8b097abb764c21c4aea80b7f42ae782d67be",
      "text": "Dulurku slamet tekan Jogja.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "46230ecba531d688429a38a32d137365f30697464d2a27a75050e3b438817f65",
      "text": "Sedherek kula ngundang kula dhateng mantenan.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "48de3165b4c8df9bcbee210af5f57b1287196e03265744cfad5d9c2583a5e74f",
      "text": "Wingi kula ___ tanggi kula ing peken.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "48e276d19d99ff8279321dc5cf09f4d6b5c4955c8af3f723ee0f8d63d8820e8f",
      "text": "Dhateng Kauman, Bu. Matur nuwun sanget!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a43157a8b31f6fa2bfc23a4e5a4525af28b9253f119ddaaa501e684ea417da4",
      "text": "Lare menika taksih ajrih.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b3816e7da8676d242b112276f1fe5aaea43b09f4fce73be3935fe23b50368ab",
      "text": "Mboten menapa-menapa. Kula ugi kuwatir, basa Jawi kula dereng sae.",
      "voice": "jv_dimas",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "4beeb628c9784d8494c49bbcd4f27e34a5fb9ec1c16f34c0dce343281c733d81",
      "text": "Bakpia kalih kotak, Bu. Setunggal kangge Mbah Putri.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d556caaf698f08ba6a13384e01933457606cdf06754fab6a36579a82fa65a99",
      "text": "Kula tumbas gangsal kangge kanca-kanca.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d7f4c9794977d244a44f28e4bef926a541f2a0c7ae01a923e82453611360fb6",
      "text": "Mangga, Nak, linggih kene.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4df7b2339c15796d33c318cd9c8df0d2df147056a9c952e3b60ec476a63b0e71",
      "text": "Sugeng siang, Bu. Bungah sanget saged pinanggih.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e6c19ee75697b31de41786e1dabdc2f74d5f0c83879362b7d02bb5bc32aa880",
      "text": "sedherek",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ea323b25c2c8fce15d7bc53060a645c7e1d17698d665e60563c53512d5c4c67",
      "text": "Mbah tiyang becik sanget.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "502d8925831e837a92b0eda5b1dceddc9b65435f417d0a510577a951a7001e70",
      "text": "Dulurku arep dadi manten.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f185812cd473786c1cd6950fe1ba2013705352127d972180a096bc01b0c302",
      "text": "Suwun, Mas!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5318f54a8da06e9cf35ae63f9b60030e6b595f02755e2317a2a5ebe24c374c9b",
      "text": "Mas, mangga, soto!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "5499bdf579d4847fe33d55b08eaba55c3132b3d5a03e007a0c1ab4462b549e1f",
      "text": "kalih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ed77d9e7a49ad09d983739562bb2159c79d4588e6b82f22c684858877de60c",
      "text": "Mohamed, iki tanggaku, Bu Parmi.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5558901558f47bbc9923e465554409c0fc186eec5964d63b138e1c857049b2fd",
      "text": "Dereng, Bu.",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "578bc50b1a3ae603ca3e58180ed77352f69e659225ba61681e9ee37b5a7318a8",
      "text": "Kula bingah sanget, Eyang.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a08685c7bde206811c54bbcc8d309ae20fdbadfd4d6852e9f2e0c46866f7c97",
      "text": "guyu / ngguyu",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ab819fe7fc2dbf353aad8614a53103eb3eca29e90d6d7532cb4836f5312f112",
      "text": "Mas, sampun nedha? Mangga, soto!",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c8d1a0048826bc3c0f96234ce97338f133a7515c6b6f61ecfcc6fdc8e5d69ff",
      "text": "wonten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d6fc2cfcf86e879e6e7d5dd5ffa32a00d071b6e8afc735d6fa7b6c3a4abfef6",
      "text": "arta",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df33c35584d799262b86960704f1d31b1119ee875079afa55c18078b6733b5f",
      "text": "gangsal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f338aca4f39f5d80100d94528d0230aadb50a92207436db354d7b0e46e10fe3",
      "text": "Sampeyan sampun nedha, Mas?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f9b553780c431ef827a1586f314e21698a1328ec7075c43dfa09c3cdaf11ec3",
      "text": "Kula gumun, Eyang mangertos basa Arab.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "606b2a48f290f5d8936f2ead02948926ca74561485e1e2eb9b014122de481438",
      "text": "tanggi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6145ed3e38bc7a66ae9323dadc9839fd8751d33b1b9c4786819bcdfa75edb620",
      "text": "Mohamed, kowe wis mangan? Aku durung.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "62bdec4f191275e8e478d77ee7725bcdec2266fa6444f386d1e084ccaf93eb73",
      "text": "kuwatir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "632ed8f05d48ba7523855c4206424ef2af3232db8e2f3f48306c74713f5a157d",
      "text": "bingah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "64375e13c2bdde6e5e51b4078d962507f37b9fc775ef67df5df45697be19061b",
      "text": "sanget",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "64bcefddebe330767cdff632ee09251766d997e1124f6c9be8ab58bf36ee499e",
      "text": "Eman sanget, Mas Dimas mboten saged dhateng.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6582626a59a528df6c4523813386ed2972613c4456c529b9bca62dc3dc1eaed8",
      "text": "krama inggil",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "65b6c27ff4a88698ea5ec1a021d9956f829c436d8bd5ea3566e691daf57ff27c",
      "text": "Sugeng sonten, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "66c5f1759fbc4e3138da7fdd6027df5690e10fa221d0427bfd94a27bba3f4ae0",
      "text": "Sampun, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "66ee97b32e5b14e89f55bb4e2dc4b850e4a4dc129b1fecb0bf6bf1ea6c3373ce",
      "text": "Karo bakul: «Sampun nedha, Bu?»",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6af9f1407fe320aa8b3c0809f9ab9915735a7689dbaefb5f91807d1d480353e8",
      "text": "Eman tenan! Nanging Mbah bungah kowe teka, lho.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b4613edcaaeb8e37199ceeb6fb39b747b681a6918cec30f5329ad9b1bae8b8e",
      "text": "lima (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c8c51d82a460a9a80b1e5cf6d07fff6ca198bafa908913ebd9a3813a23c1321",
      "text": "Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "704bab12c9fbef15301913fcdc8730f9e148b8a710ed2b44768b9368f2177399",
      "text": "Kula badhe tumbas bakpia kalih kotak.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "725791417bb8a322147961116d37c7fd26da374ed28673dd94597002067b474b",
      "text": "becik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "72c9dec595fd02aa012b97af5230bd0cab66fd7b57264bd914eb5c6651f89f7a",
      "text": "Teka. Mbah isih kelingan kowe, lho!",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "761751068ff21d959f82f8ab00261f8aec63e2a3fec8bf3d3ad7caa7b9332f80",
      "text": "Mangga, Mas, mangga.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "766f1a4e153a60d2d9b6e9d26d34a3edd40fc16e4c4aeac4fa268bd518f2f822",
      "text": "punika",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "77dc2904496107e90dadae11bc7468ca12ab527be3a4c64f9f2a2339c69d12a6",
      "text": "Mbah, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d6662f64199a180ab68ea3c7e38ebe4aeef7c0c0c76a0325334d4e0da08b44",
      "text": "Mohamed, karo Bu Siti, ngoko apa krama?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a2affbd470f9ab7fcc825eb19601bfbd666888b003e4d45b352c28574bcabf9",
      "text": "Sampun, Mbah.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "80431106f7424191aeb1a5a445b2dfb4a05dacff6c064f93102ef3b0ecd2c824",
      "text": "Mboten, Mas, punika sepur Bandara. KRL wonten ngriki.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "80916b41b57815aabecb9d1e29d58381eb74a090397e4d53b83f27c5eb2c2d2d",
      "text": "cariyos",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "820f0d43a2cf43ce07a7bce8bf6f5cbc09a1fdea8affa835103f0d3607669272",
      "text": "Mohamed, Setu iki dulurku mantenan. Kowe tak undang, ya!",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "83ddf8ef1022e5afb1c8367a2f2a8835600a63b459d4fb0e6cfd9a5d7ed31ba2",
      "text": "banget (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "85282495065e4f36777cb6b90d06a316e8e280ec5bf7a772e93e16654eab7796",
      "text": "eyang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "85eed1da1f59bdf6f58aebb09641b2a8d726ca10c6a4ab97e9baeffc9cea489d",
      "text": "Bungah sanget saged pinanggih panjenengan.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "871c47f49d39b61c616b438dfa615c9e8a5be9d2591b21b5a3ec72342f3c93fd",
      "text": "bungah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "87f1b3e9ce71d196e7636024b4b81d6bb56dae3f08647119ff4b7c17ab32c248",
      "text": "Iya. Aku arep bales nganggo krama.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ac9adaf8c2427f7f273bf37625051aa76780f69de8d43c166f8011710cdcbac",
      "text": "menapa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8adfdf4cd390172d11b9fde027508f1df4dad4a58074b8b47a4d506716f6dbdf",
      "text": "slamet",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c4efe8b8c79b1cee84b0b639dab3b81c138caef02f6a596c53e351d55dc71df",
      "text": "Mohamed → Mbah Putri: Sugeng sonten, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "90c1023d9af4366c2189393ecf9a1a62191b27c2891c42e124879c38b0a9235a",
      "text": "Piye, wis mangan durung?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "913d4c9b015848005f11f009a2be4e4b0836ab3beea917a31d4f1b6b298ef08b",
      "text": "adhik (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9641fe4655e4ed9d59ef5bbc1b6b01b01e43c254ce30b8321119c7f527c3a029",
      "text": "sae",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a30a1db089e7581711d08ff24757932cf9b7384edc2ad94c261ad9ee8e11b95",
      "text": "krama",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c0b3ba63739868734f82a2847190014dd7fb873305c1245f422e6149cefe497",
      "text": "Menapa punika KRL?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d52702fa80ef992f4b2de775f887173316278aaf6c6644beffddb61bd4dbc45",
      "text": "kado",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f4ceac57d209c9f1c0da58bb584411b03f79ce3f638c2841e45e417a65ca890",
      "text": "kelingan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ffc944d468914dbf56d46964c48bdde6f68bb12dcff9c19de2cb2cc68161068",
      "text": "Mas Mohamed tamu kula.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1128af6caf0833ab33d734f2e3b8b5936320fb0c592b2970cb0e4bc7e319023",
      "text": "Apik! Karo kancamu ngoko wae: «Wis mangan durung?»",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a181b8f427fbc32337cea4b2d58fdd8881b05ab5eb15c78af62da2956bd248e0",
      "text": "sayah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1fe7be017958dc1b5b9da126263b9658c032961cf046f99abf69abe8c94c2e8",
      "text": "Wonten mrika, Mas, celak mushola.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a37badcbf82ddca59b92aa18563a5364b977b22ac9361af26d9f94594592527b",
      "text": "Sedherek kula tiyang Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a394dea7e832d4f86748f12889c2819a259627705c36f5158020422efd2a9807",
      "text": "pundi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a817953b68113b358f41a3f56622846a527b007ba0a50b94bdad145b4c15b95a",
      "text": "unggah-ungguh",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a84f5d85f4f04b78ebac788315f24a124478ad49d2dae6d3f794c69d6b43e162",
      "text": "gumun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8a15d3475a24f4d1594d1f8652b6bd7e6b8c47e131603373d4c2ce1b90e4ac3",
      "text": "Monggo, Mas. Badhe tumbas napa?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "aad694631dcf4654712ddfb8cdf4927fc29d76eb0d4c0c1aa7c4dcbc8bf59f0b",
      "text": "panjenengan",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac2477004f447bfb5ab35548f556535f6bd5bff837b59488748fbdf92d0fb481",
      "text": "Wis mangan durung, Mas? Aku durung, je!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca4ba50216b94f97dd936a18a32e9c71ae46612143833230d0498b6ee6438eb",
      "text": "Matur nuwun, Mbah. Kula sayah sanget.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "af41a80326374b24d35b76845fd47e3dceca2083350d3df4bbb33c34e3c39e1f",
      "text": "Wedi (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa8c8276b65282efee60c6da53794896dbcaf63d87a90bbe8718ab2c631930d",
      "text": "Bu Siti: Sugeng enjing, Mas. Sampeyan sampun nedha? Mangga, soto!",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5749fa05cd4ea7116789e732ab4cb63ba71ff9edff6db82afa8eb0eb95ff44a",
      "text": "Kula tumbas ___ kangge manten.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b837aa3e1093c886f1899f6f4d59c9018978b8414c116f62000c8e37bf5bc6ec",
      "text": "Kula taksih kengetan mantenan sedherek kula.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba219deb05e21c28aca26de2b6fb28db4246f4d5cc781ed28503c705faad1c1d",
      "text": "Eyang, menika rayi kula.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba5aab45592804d06e05a58d2372c2b53d0b112ba3647ffcb0ba1565d8676fcf",
      "text": "mboten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba6434ba5e905cd16709fec7d594ce206b45bdaabdbf761f26a3d1d701ebaecc",
      "text": "Mas, aku pengin sinau krama.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc0fad73776cc156e246af81f3bece86fe71664fe6496a0bd72c94d8eb487db3",
      "text": "eman",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13375dfebc7209a61ed4d1b4b569ba54582ab01188514b2ae3242ebb86a6921",
      "text": "Karo mbahmu?",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e0358d3c5ae277aff79f3cee1f6af278338eee9bb885bdc937e9a9c6ef7a47",
      "text": "Karo aku?",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ae0210fc584496a072a7a77ecf5ea38f3bd5c2c3b3a93bb0353295eab4c6b5",
      "text": "dhahar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c42a9045f11efb054a58e45fc99bed339cf85633a21dcbeffc0e5c3f69f59612",
      "text": "linggih",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c552d8569a1913c67297499d82c086faa1169fe7076b4bba64605d33c6c32315",
      "text": "Kula sinau unggah-ungguh.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5e1819a97ee03ad366529946b310234ed99eadee8876185ae4e88e586d53875",
      "text": "Mas, sampun nedha?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5e4d87f1d9b396973518fe95af289a337346d5b3ab27f28b44a5152276f638a",
      "text": "Saka ngendi, Nak?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd99d153953df6d61e25d2ed4b93a95eb92df3e275e544532c1afda40b899315",
      "text": "adhik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce95a9411ffdb9c095ad9c468891178058741ac7c2768c9c46dce839d3786ba1",
      "text": "Apik! «Nggih, sampun, Bu.»",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d191d6af0be9c2b2b17811f436893e7f00cc854e91592e9fb9a82ccf57aa391f",
      "text": "Krama inggil: «Panjenengan sampun dhahar, Mbah?»",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ee34e6003ef1465bcf12f4546e1e0b8c87bd40bcf98e0bba2bc0dc6c6b36fc",
      "text": "Sampun, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3679782fea520480b83701f76c0cc98304097988d80d3fa1195079e7dad2964",
      "text": "Mangga linggih ing kursi menika.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d44d5fd54c138feea78b5a281dc8d8e3dbcefc1089d38cba9c9c71be6d38c0ca",
      "text": "Niki rayinipun Dimas. Kok namung mesem, Nduk?",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d516bdbbfe5cebca237425e1f524f37dcdb11a471bded4933faff132d439d01c",
      "text": "Wah, suwun! Aku tuku kado apa, ya?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a703943112f787f4a3ed3fd83dada14095229c513ae00ab916b9759813e9e7",
      "text": "Inggih, kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "da56ffa90300b6480a0fcf725abd0d99ea1ae90ab17c8324a719b4595f733fb8",
      "text": "Aku lungguh ing kursi. → Kula ___ ing kursi.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "da6ec95e03ef8dddba8e816ddac3427e1fb63d963c89e95914e696d7fb333653",
      "text": "kengetan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0aa0b4baf96196bcae927253547bfa8bbb929a86998d29a70123ff8b1968905",
      "text": "ora (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e21a167ce8adbd2a2b3d3c69f258439a238750100044acc4a5368e41ba197c23",
      "text": "Mangga pinarak, Mas. Niki lare-lare kula.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4add6dee011a20c438b6948aee0c12a8c4501a4f7694c2171c1e4cd976df9f9",
      "text": "kangge",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5f3120eb0c03e070921daff13a702f67dcdf5e2f852890f8ef502f647492430",
      "text": "Kamar mandi wonten pundi?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6fc7a13dd2727efad660398d13eca1fd33cdfa0581d7973b597b3efae52ad1a",
      "text": "Kula badhe dhateng Kauman.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8b15be2c1e12ce0666af1dfb1b5428eb69f7c4d6a3024c7da3bcaa21a6132ab",
      "text": "Mpun, seket gangsal mawon. Badhe teng pundi, Mas?",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8beaf7edfc249acc647fb643a27512d6b140d8b151287328f293bf87b0d9d5a",
      "text": "krama andhap",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e914d77bf44e16c0cc66ea9374f1dcad26a2e80fe039485cc0350b7470ded99b",
      "text": "Mangga, Mas, pinarak!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9bd9601e554ce82f2431325cb3bf7a06aa7c28d3240e385da97606dfa509e67",
      "text": "Kula gumun, Eyang taksih mangertos basa Arab sekedhik!",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9cf47498d6db555d7825ab28359c6d7c7aacf11dcebff5925bbade8eb2e4a40",
      "text": "Kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea3f545908d964e5f8bb91418a6a1ac979d58d2c4b1dee71e36c262fa524345e",
      "text": "Ayo, Mohamed, neng omahe mbahku!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab9a8e688630ab9984f690019132b058377f1859f4cdb89cc4f23493dad2c69",
      "text": "Setunggal kangge Mbah, setunggal kangge kula.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc2da5d969d6dd408b3c8ea770c6198977688696b642292bed88b1f0a86ce1c",
      "text": "Eman, Mas Dimas mboten saged dhateng.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee2c29c1bdd00d7d8e8d06135bcf78c8e4b699229f16995517b9f41d09f0d32e",
      "text": "Matur nuwun. Menapa punika KRL?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb89e61036187f8b71ecfdc8fa7b8ddd9de2f4beef8739c3dee1bdade524036",
      "text": "Nak Mohamed, Dimas sampun cariyos bab sampeyan.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef8d9039fa4719671f912bd840cb3813f3f6fa8cddf63aa532d66dd86734cabe",
      "text": "Sampeyan sampun nedha, Bu?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f22614b0889ba6cc5852e2132c165861db786cc9aa992344d78674185ce0fd5b",
      "text": "inggih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2a3fec42ffbba1ced852908481447c1bea2cd36c68e6ba47091ccf9d34a554e",
      "text": "dhateng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3f69e96f0c363a74fb9787398be05d7eb4dbdacdccc4d79e30eddaa632d2c1d",
      "text": "pinanggih",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f429aefae19d7cf47a005cbc2289347c5382e8fc6c3926bc93e273cb749474cd",
      "text": "Nggih, Eyang. Kula bingah sanget saged pinanggih.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f43f9b600a723f7774a1be38e419cc2125ccbf2e45d4ae994364ca5e8bd41227",
      "text": "Nggih. Kalih kotak, sewidak ewu.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f57559dfee20450e195440be42431ad712fe59b728a0e0600886e73d92cf2e7f",
      "text": "Peken Kranggan, Mbah, mlampah. Mas Dimas mboten saged dhateng.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "f718463818ce72f417d3ee2d7d495d38a44ecf9e676b0786a5514ca7635a0bc8",
      "text": "nedha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7459544caedaf1109d203e74bf6670c518d30d8b2e4e086e27136fcc4c50b7d",
      "text": "Sugeng enjing, Mbah.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f845f9d5ef690be30153b45122ae81ad76a414f64678d7f3388f2435e9e53ed9",
      "text": "Aku gumun, Mas!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8c851fd9c7fa4359c551db7177cd50c2ec42fbc006bb51f2889666e9c4fc284",
      "text": "Oh, nggih. Stasiunipun sae sanget!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f935252cbcab20b14a03dfa52b384ed6b92f0723162abdc3ca4b558ded44c403",
      "text": "Mboten, Mas. Sepuripun sae sanget.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f94f3b85af571b432986fc732dee56fb5bca582a533d58b00ccbb89138b4906f",
      "text": "Waduh, arta kula namung seket gangsal.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb45540f3337c79e9122cc6a757d745fee23a46c0cabc659678500cc30da99a7",
      "text": "Le, Dimas! Wis mangan durung?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc295bfa9c674a100acefe52fcbc6eb8e5f454c6cfc268026beb0c8b3bbeb240",
      "text": "Nyuwun sewu, kamar mandi wonten pundi?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe55bfb5d2853e8cbe9101554477aedf55fe481ad226a87fc360ddd0b1830cb0",
      "text": "tamu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff47acdc578cb3f99f547b496bf9d6fee782d2c3f6827ad356e81337cb33e762",
      "text": "Adhikku isih lingsem.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 13,
