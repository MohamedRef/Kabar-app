      "sha256": "7186aeacf819870413f92c10f57515b3e37c512d72395a157f478bf4a6c9c3b7"
    },
    {
      "id": "j3.u01.l10",
      "sha256": "1fc6094467e6304a3dd59b7644c44db7932142d59715e59a024705c368f2ed73"
    }
  ],
  "audio": [
    {
      "key": "010a4e4cad318d4a64deec6879973422f52ce58b6a3c420bc107b46e62f60ad6",
      "text": "lungguh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0343cc712f6cd78f7e63642f2b4f3bbf68e72b6c73d0d49ec86445bd09102f5a",
      "text": "kursi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0441c563690da0373a2d7daffb2759b8f65a707ea551172a7ae2996f418b6db6",
      "text": "manten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "049a986649cd2d7814aec6d70903588abf67bfc4b08606481f0c8192e729dc06",
      "text": "Kula tumbas kado kangge manten.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b9c6bcec6f6a010339d49c002c7d308efc729f68e880504cd833a722b3a84b",
      "text": "Panjenengan sampun dhahar, Mbah?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "06f11a15c49efa4070370f06778f7a0bb8b859dce45bc13ab134b65a0190bfca",
      "text": "mangga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "07476724c4dd6b84cce1886c7d103e1dec8891f6487df9d91950713d56a1ced6",
      "text": "Dereng, Bu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b0541dd5942d8226138b977909474dc4037f9a64f5156fb7b7bea2fde8591ae",
      "text": "sampun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ba68c5d7f9c129e3dda4857a53dd393ce742ecb6f4e343adbb6382352df1acc",
      "text": "ajrih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d88458090da875764c43ec48242a9b29bada5cb15c0cf1590c3f2094b949901",
      "text": "Krama: «Sampeyan sampun nedha, Bu?»",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e695eaab779721c78cc03d8c77fd4e0baeb2b3897d67bba1481a8b3a90057d9",
      "text": "Piye, Mohamed, wis mangan?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eee9d594932ba73ca02b9d6d51fdadef2a3e7d5376f0f4dfe4a68c7686ffb62",
      "text": "Bungah sanget saged pinanggih, Pak.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "10ec629788d20bb30e944b27073043ac25caa8d16b0933f97066d4954d82107d",
      "text": "Le, Dimas! Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "11939973344d3c302f3b671be089e85a2733f0af4978b73008a9e3961ab72829",
      "text": "ngoko",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1213a6e15816022e4e641d82159050f9ff1e99988c43d6f55320263085fd0d88",
      "text": "Mbah mesem, lare-lare ngguyu.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "16a24175f4c71adb066c41dfc6716acbcad3aa9ea0a6376cb8f5adba68696f0a",
      "text": "Lare-lare taksih murid, Bu?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "16dc6282cafa25903463dc00a0b5e95d80bf2e67bd4db4cd684fa7d5d7a5cbdb",
      "text": "donga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "18653806d77fd435057e2dce7294bc9cf733968197610b6c6e7f10bc3b6d5524",
      "text": "Saking peken, mlampah. Mas Dimas mboten saged dhateng.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "18b8f06307bf1a7ad86f781c0abb33820270625da4dd3e03ca524dd56f078590",
      "text": "Mbah Putri ana? Aku nganggo krama, ya.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ab9441b5527053cb603d676732e2aa7aa0cdc298ce301dd10e29c19bd74cd40",
      "text": "Apik! Karo kancamu: «Kowe wis mangan?»",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cce9a4c1fad997a40f41f9a53baded8923a6c9677494333880bd210230b44b1",
      "text": "Saking pundi, Nak?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e6e71a9dc4d9fafc329c33a126bbceaaefefea72fb35b0e00d4c0d6f9a7b9d4",
      "text": "Apik! Karo mbahku?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e95f8c3fd640f54e4991cb83d494764c3f6e17c9a9b44b270eaf1e0cbec31aa",
      "text": "Aku wis mangan.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f247c5a16c17475e819ae70b259b3bfd7d48f0e738d086eb9aa831696916d65",
      "text": "Ana. Mbah isih kelingan kowe, lho!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "20e3cd235724bd8d685a692880dd5270ccb882f2b85db09539817cee9d100599",
      "text": "Dereng, Mas. Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2199e70f92037ef2e6d74adf8bc48016d71ed9dfce7549bd989ae00587dadf54",
      "text": "Krama, ya? «Sampeyan sampun nedha?»",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "2200ec5af85c6556828c1d56b46c7e06c19cd151a00c46df18cfe2104f0f4a9d",
      "text": "Ibu kuwatir, lare dereng dhateng.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "247dc8cbf353abe2ee5859e3ac5a2c2cb97fb6ea27bae9df9422437aaad143d0",
      "text": "Ayo mangan soto, Mas!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "27b4ac2f691ac4e16824731573b92b538e1420faeadee67b8e4b85ce4701c7bb",
      "text": "Kula taksih kengetan mantenan menika.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b0571dabfe6b87b096bbb64c5b176e2fa71a7ad8aca25e3e1b50df29a435e9a",
      "text": "dereng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eeb4a97eb4bc2b87faa63c91407663956a368e8dcd02405ba79c5a058f6c83b",
      "text": "Inggih, mangga, Bu. Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fbe1e2f6e20a46b89bf7442f4bca7a51bac7addf7c707c08e19dee91f48b0e1",
      "text": "sedulur / dulur",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "320cfea52914ee06fba04ebc3a9190432151fff0762f17afff52d3866042d5e7",
      "text": "Lare-lare tanggi kula taksih murid.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "339b9cc5e48e3e8ac50ce59a6cd1ff44a84d771688fc4da16d9fce3d660f1093",
      "text": "Dereng, Bu. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "344f60cb4cec30853ac296f76d48ca1b688a979caad60939021dbf70aad42e87",
      "text": "Mas, iki pesen saka Bu Siti.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "34c0eb905813e4c85ab90e734db73238c95bd2342809ad2c5dd831cd50ecf512",
      "text": "Ora apa-apa, donga wae.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3513ef174acd5cf33a454e6ce7d53b7ae16395623e01373b502f5c525bb360ba",
      "text": "lare",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "351c0d9ee91d3c1caa5a9c08d9d00d916135720119d1b6f73504719997feb303",
      "text": "mesem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "37b0fcfe7659f52654850ec459ee9fae1299ee3caa5b6c7830ef1efecc8e0dfd",
      "text": "Aku lungguh kene wae.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "3936d904334428a2f9e3e6d767f3303ccf16a16bb3f99004903182657ee75569",
      "text": "Mangga linggih ing kursi, Nak.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a268531f55d8cd648bdb815192d40d358b4bc1cec82b6e6e22ad98456d6458f",
      "text": "Aku kelingan. → Kula ___.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa0c831205dd100d7f2011c3ce0dbec39a6bfe3015024b6f1dd35743af3d4a5",
      "text": "ngundang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be4bd898c87131b579f864d63ee0a55362c1d25a205d072e25de387e9e13a3b",
      "text": "murid",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "42993b7f4a52a4a75a207946329333f32348524e6ad44ea8bfffba5909f5cc3f",
      "text": "kula",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "46230ecba531d688429a38a32d137365f30697464d2a27a75050e3b438817f65",
      "text": "Sedherek kula ngundang kula dhateng mantenan.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "48de3165b4c8df9bcbee210af5f57b1287196e03265744cfad5d9c2583a5e74f",
      "text": "Wingi kula ___ tanggi kula ing peken.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a43157a8b31f6fa2bfc23a4e5a4525af28b9253f119ddaaa501e684ea417da4",
      "text": "Lare menika taksih ajrih.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b3816e7da8676d242b112276f1fe5aaea43b09f4fce73be3935fe23b50368ab",
      "text": "Mboten menapa-menapa. Kula ugi kuwatir, basa Jawi kula dereng sae.",
      "voice": "jv_dimas",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b756442f949c96a7d78de659ae8b212029c4a6fe0212088e2285e44ce6e249b",
      "text": "Mas, sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e6c19ee75697b31de41786e1dabdc2f74d5f0c83879362b7d02bb5bc32aa880",
      "text": "sedherek",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ea323b25c2c8fce15d7bc53060a645c7e1d17698d665e60563c53512d5c4c67",
      "text": "Mbah tiyang becik sanget.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "502d8925831e837a92b0eda5b1dceddc9b65435f417d0a510577a951a7001e70",
      "text": "Dulurku arep dadi manten.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5177a47f23ad7180d06af6c7376601ba617653c0863fbd67c6413b9a7375539d",
      "text": "Kowe wis mangan? Sampeyan sampun nedha? Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "52066d09f4e42c0047398e24722caa9e18f8123a853a5cce038d37194c8b477c",
      "text": "Mohamed, aku uga durung mangan.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f185812cd473786c1cd6950fe1ba2013705352127d972180a096bc01b0c302",
      "text": "Suwun, Mas!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5318f54a8da06e9cf35ae63f9b60030e6b595f02755e2317a2a5ebe24c374c9b",
      "text": "Mas, mangga, soto!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "54e7fc37044341eb8ad17f665877a0252a28a3d0bff39d65686c9e81da3e97b6",
      "text": "Iya. Aku arep nulis nganggo krama.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ed77d9e7a49ad09d983739562bb2159c79d4588e6b82f22c684858877de60c",
      "text": "Mohamed, iki tanggaku, Bu Parmi.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5558901558f47bbc9923e465554409c0fc186eec5964d63b138e1c857049b2fd",
      "text": "Dereng, Bu.",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "57085bbc55f6af1f6988e4c7cb93336b36946ead1e78de8437ccfe0458af7c21",
      "text": "Inggih. Ingkang setunggal taksih ajrih, Mas.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "591fd4685720c8f3968b120f0a3d154bc5ae08f8ecece3cf66041ba61fe2d346",
      "text": "Karo bakul: «Sampeyan sampun nedha?»",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a08685c7bde206811c54bbcc8d309ae20fdbadfd4d6852e9f2e0c46866f7c97",
      "text": "guyu / ngguyu",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cb1519fc9da89be5774b04dd87eb9983d38a2c4734d06ba5c7b417d47e66341",
      "text": "Ayo, Mohamed, nang omahe mbahku!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e4b97879c513956ddb67ed3995d9e5c8800d45e30b80cbb785507e36a991970",
      "text": "Wah, suwun! Aku tuku kado apa?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f338aca4f39f5d80100d94528d0230aadb50a92207436db354d7b0e46e10fe3",
      "text": "Sampeyan sampun nedha, Mas?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "606b2a48f290f5d8936f2ead02948926ca74561485e1e2eb9b014122de481438",
      "text": "tanggi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "610b504a818c74567b24c0509e0d8428efcb28e006aa195350a3cab1859ac2be",
      "text": "Mohamed, iki Solo Balapan!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "6145ed3e38bc7a66ae9323dadc9839fd8751d33b1b9c4786819bcdfa75edb620",
      "text": "Mohamed, kowe wis mangan? Aku durung.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "62bdec4f191275e8e478d77ee7725bcdec2266fa6444f386d1e084ccaf93eb73",
      "text": "kuwatir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "63fdd3ee5a9bffa072ae2f005a867abc00a9bfd1a49b7f5042c1f2edd53beb48",
      "text": "Apik! «Inggih, kula sampun nedha.»",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "64bcefddebe330767cdff632ee09251766d997e1124f6c9be8ab58bf36ee499e",
      "text": "Eman sanget, Mas Dimas mboten saged dhateng.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6582626a59a528df6c4523813386ed2972613c4456c529b9bca62dc3dc1eaed8",
      "text": "krama inggil",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "65b6c27ff4a88698ea5ec1a021d9956f829c436d8bd5ea3566e691daf57ff27c",
      "text": "Sugeng sonten, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "66c5f1759fbc4e3138da7fdd6027df5690e10fa221d0427bfd94a27bba3f4ae0",
      "text": "Sampun, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6776fd05fb2e76078383171d50f9ecd8e073f81fcaa136fdea1b80d2fd3070a3",
      "text": "Kowe wis mangan, Mas? Aku durung!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c8c51d82a460a9a80b1e5cf6d07fff6ca198bafa908913ebd9a3813a23c1321",
      "text": "Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e25f171ffe255a391e9b9b960918749bdfd9e54b61f29a6805fe1ca15f40027",
      "text": "Mohamed, dina Setu dulurku dadi manten. Kowe tak undang!",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "725791417bb8a322147961116d37c7fd26da374ed28673dd94597002067b474b",
      "text": "becik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "72b01227cae3c82d0004189acc54c4073794536a88188d19aaed960f4ad2dbb3",
      "text": "Mangga, Mas!",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "761751068ff21d959f82f8ab00261f8aec63e2a3fec8bf3d3ad7caa7b9332f80",
      "text": "Mangga, Mas, mangga.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "77dc2904496107e90dadae11bc7468ca12ab527be3a4c64f9f2a2339c69d12a6",
      "text": "Mbah, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d6662f64199a180ab68ea3c7e38ebe4aeef7c0c0c76a0325334d4e0da08b44",
      "text": "Mohamed, karo Bu Siti, ngoko apa krama?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a2affbd470f9ab7fcc825eb19601bfbd666888b003e4d45b352c28574bcabf9",
      "text": "Sampun, Mbah.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "85eed1da1f59bdf6f58aebb09641b2a8d726ca10c6a4ab97e9baeffc9cea489d",
      "text": "Bungah sanget saged pinanggih panjenengan.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "871c47f49d39b61c616b438dfa615c9e8a5be9d2591b21b5a3ec72342f3c93fd",
      "text": "bungah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8adfdf4cd390172d11b9fde027508f1df4dad4a58074b8b47a4d506716f6dbdf",
      "text": "slamet",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c4efe8b8c79b1cee84b0b639dab3b81c138caef02f6a596c53e351d55dc71df",
      "text": "Mohamed → Mbah Putri: Sugeng sonten, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "957466974465919adb5cc0d91c8fa5b607fcdfb449aaf84444674ce887f710e8",
      "text": "«Panjenengan sampun dhahar, Mbah?» Aja «kowe», ya!",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a30a1db089e7581711d08ff24757932cf9b7384edc2ad94c261ad9ee8e11b95",
      "text": "krama",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d52702fa80ef992f4b2de775f887173316278aaf6c6644beffddb61bd4dbc45",
      "text": "kado",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f4ceac57d209c9f1c0da58bb584411b03f79ce3f638c2841e45e417a65ca890",
      "text": "kelingan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0be2d05aa7de9e4df986ef275f42ce220bdda2173425911b0e71ed8873dd048",
      "text": "Mas, sampeyan sampun nedha? Mangga, soto!",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a181b8f427fbc32337cea4b2d58fdd8881b05ab5eb15c78af62da2956bd248e0",
      "text": "sayah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a37badcbf82ddca59b92aa18563a5364b977b22ac9361af26d9f94594592527b",
      "text": "Sedherek kula tiyang Kairo.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6567e7502cb7e9f93e86c7203e88d1aac04de71a49969a766a78d555a494168",
      "text": "Mas Dimas: Mohamed, kowe wis mangan? Aku nang Balapan.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a817953b68113b358f41a3f56622846a527b007ba0a50b94bdad145b4c15b95a",
      "text": "unggah-ungguh",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa0357d18f4bc01b36536826abbd247e483a24ddf76d124ddbbb008ce4e009fa",
      "text": "Eman! Nanging Mbah bungah, panjenengan dhateng.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "aad694631dcf4654712ddfb8cdf4927fc29d76eb0d4c0c1aa7c4dcbc8bf59f0b",
      "text": "panjenengan",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca4ba50216b94f97dd936a18a32e9c71ae46612143833230d0498b6ee6438eb",
      "text": "Matur nuwun, Mbah. Kula sayah sanget.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "af41a80326374b24d35b76845fd47e3dceca2083350d3df4bbb33c34e3c39e1f",
      "text": "Wedi (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa8c8276b65282efee60c6da53794896dbcaf63d87a90bbe8718ab2c631930d",
      "text": "Bu Siti: Sugeng enjing, Mas. Sampeyan sampun nedha? Mangga, soto!",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38dfadf06411c0da9d9f0fffe25afc48cb124958fa9cbe9371d08c0fe07aca1",
      "text": "Aku uga kelingan. Mbah becik banget.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5749fa05cd4ea7116789e732ab4cb63ba71ff9edff6db82afa8eb0eb95ff44a",
      "text": "Kula tumbas ___ kangge manten.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b837aa3e1093c886f1899f6f4d59c9018978b8414c116f62000c8e37bf5bc6ec",
      "text": "Kula taksih kengetan mantenan sedherek kula.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc0fad73776cc156e246af81f3bece86fe71664fe6496a0bd72c94d8eb487db3",
      "text": "eman",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13375dfebc7209a61ed4d1b4b569ba54582ab01188514b2ae3242ebb86a6921",
      "text": "Karo mbahmu?",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e0358d3c5ae277aff79f3cee1f6af278338eee9bb885bdc937e9a9c6ef7a47",
      "text": "Karo aku?",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ae0210fc584496a072a7a77ecf5ea38f3bd5c2c3b3a93bb0353295eab4c6b5",
      "text": "dhahar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2b3784783e3f69b1cbec157ba004b102a7d7629f9281cd7fae0b0adaeaee950",
      "text": "Sugeng siang, Bu. Bungah sanget saged pinanggih panjenengan.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c42a9045f11efb054a58e45fc99bed339cf85633a21dcbeffc0e5c3f69f59612",
      "text": "linggih",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c552d8569a1913c67297499d82c086faa1169fe7076b4bba64605d33c6c32315",
      "text": "Kula sinau unggah-ungguh.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5d62b087eee7b78d2393b7d74e773c019fdf9aed6340ca22f853e5fa4df2d57",
      "text": "Mangga, Nak, linggih ing kursi.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c853c76346bd561463b8a21f3495ebdebab084616eac07ce9ce3eddfd10833f1",
      "text": "Sugeng rawuh, Mas. Menika lare-lare kula.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d191d6af0be9c2b2b17811f436893e7f00cc854e91592e9fb9a82ccf57aa391f",
      "text": "Krama inggil: «Panjenengan sampun dhahar, Mbah?»",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ee34e6003ef1465bcf12f4546e1e0b8c87bd40bcf98e0bba2bc0dc6c6b36fc",
      "text": "Sampun, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3679782fea520480b83701f76c0cc98304097988d80d3fa1195079e7dad2964",
      "text": "Mangga linggih ing kursi menika.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a703943112f787f4a3ed3fd83dada14095229c513ae00ab916b9759813e9e7",
      "text": "Inggih, kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "da56ffa90300b6480a0fcf725abd0d99ea1ae90ab17c8324a719b4595f733fb8",
      "text": "Aku lungguh ing kursi. → Kula ___ ing kursi.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "da6ec95e03ef8dddba8e816ddac3427e1fb63d963c89e95914e696d7fb333653",
      "text": "kengetan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e016fd05a58077dd8a45e896a273fe371f39f22ad803a7c40573d4e551e5e81b",
      "text": "Mas, aku arep sinau krama.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e89afb8daca3d7b33e5f1df58341557d8d917b4ea4c753e3dbced0dc2a76d5ea",
      "text": "Dulurku slamet tekan Solo.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8bce7f86d2a683197b0942f37e2f0e4b0454db8d79df4b576279bf2d75b54ad",
      "text": "Wis, Mas! Enak tenan.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8beaf7edfc249acc647fb643a27512d6b140d8b151287328f293bf87b0d9d5a",
      "text": "krama andhap",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9cf47498d6db555d7825ab28359c6d7c7aacf11dcebff5925bbade8eb2e4a40",
      "text": "Kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc2da5d969d6dd408b3c8ea770c6198977688696b642292bed88b1f0a86ce1c",
      "text": "Eman, Mas Dimas mboten saged dhateng.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef8d9039fa4719671f912bd840cb3813f3f6fa8cddf63aa532d66dd86734cabe",
      "text": "Sampeyan sampun nedha, Bu?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f136ce8e9310bfb730efa5c7e6b9a2eaca6ea789c8ef36226b870dc3f38571ce",
      "text": "Koen wis mangan ta, rek?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f22614b0889ba6cc5852e2132c165861db786cc9aa992344d78674185ce0fd5b",
      "text": "inggih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3f69e96f0c363a74fb9787398be05d7eb4dbdacdccc4d79e30eddaa632d2c1d",
      "text": "pinanggih",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f718463818ce72f417d3ee2d7d495d38a44ecf9e676b0786a5514ca7635a0bc8",
      "text": "nedha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7459544caedaf1109d203e74bf6670c518d30d8b2e4e086e27136fcc4c50b7d",
      "text": "Sugeng enjing, Mbah.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    }
  ],
