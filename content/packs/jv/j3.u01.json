  "audio": [
    {
      "key": "009e5e4c1e68fc6c00896e0c7db758b936ab60275cb332f6c5a902dd154695af",
      "text": "Mas, sampéyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b9c6bcec6f6a010339d49c002c7d308efc729f68e880504cd833a722b3a84b",
      "text": "Panjenengan sampun dhahar, Mbah?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "06f11a15c49efa4070370f06778f7a0bb8b859dce45bc13ab134b65a0190bfca",
      "text": "mangga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b0541dd5942d8226138b977909474dc4037f9a64f5156fb7b7bea2fde8591ae",
      "text": "sampun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bc8ca55461f6cbf6c563599cb7616ce3205814e687fba1ca774186d1e59cbf1",
      "text": "Sampéyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fab9f5e251dbfdfa205e7445a8492bfd835f262390eae7c74cc3da52ea0bdc0",
      "text": "Dèrèng, Bu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "11939973344d3c302f3b671be089e85a2733f0af4978b73008a9e3961ab72829",
      "text": "ngoko",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1abd4734415bd588fa0f1075c7a1eed255b191eef57ba2fe8e06ac87f8951df6",
      "text": "Le, Dimas! Kowé wis mangan?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e6e71a9dc4d9fafc329c33a126bbceaaefefea72fb35b0e00d4c0d6f9a7b9d4",
      "text": "Apik! Karo mbahku?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e95f8c3fd640f54e4991cb83d494764c3f6e17c9a9b44b270eaf1e0cbec31aa",
      "text": "Aku wis mangan.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "236023bae46804cc143c3dc77a1e1478374c7822d6ed1ce1efb4229ed9949116",
      "text": "Wah, kowé wis bisa krama!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "23bec81e589b2fc8c45ef9588e8e11afa425481156bc2c4b8e9e525b8d0b9b68",
      "text": "Kowé wis mangan? Sampéyan sampun nedha? Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "290870ae8e6583567386c44ecb0f5f6f00776dff825ffc27c8cf76636e6fab67",
      "text": "Kowé wis mangan, Mas? Aku durung!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "29162e1ce3ef79fd998352d8901e0afb178c061535260cebe681f266fcadf408",
      "text": "Apik! Karo kancamu: «Kowé wis mangan?»",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ba9edf3837b83f986e7e85ddf236922c3a1ea2a88d4744506bfc33f8ec40b7e",
      "text": "Wis, Le.",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cd32e8d79447e2796d19201b10574ed08d29d8482160bb1df92595938f93667",
      "text": "Sampéyan sampun nedha, Bu?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "42993b7f4a52a4a75a207946329333f32348524e6ad44ea8bfffba5909f5cc3f",
      "text": "kula",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5318f54a8da06e9cf35ae63f9b60030e6b595f02755e2317a2a5ebe24c374c9b",
      "text": "Mas, mangga, soto!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "610b504a818c74567b24c0509e0d8428efcb28e006aa195350a3cab1859ac2be",
      "text": "Mohamed, iki Solo Balapan!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "61e16a619e49de14a8ed313d1ff4a98266d2c9162972826b67f2ece0f7b26ac4",
      "text": "«Panjenengan sampun dhahar, Mbah?» Aja «kowé», ya!",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6582626a59a528df6c4523813386ed2972613c4456c529b9bca62dc3dc1eaed8",
      "text": "krama inggil",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "66c5f1759fbc4e3138da7fdd6027df5690e10fa221d0427bfd94a27bba3f4ae0",
      "text": "Sampun, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a63f749d790efe332db4fb34b2ffdc7427bb664306610508b88ad387491ff5f",
      "text": "Kowé wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "72b01227cae3c82d0004189acc54c4073794536a88188d19aaed960f4ad2dbb3",
      "text": "Mangga, Mas!",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "72db460d35ca42461831d6a30b8a8b5c1f2b786d23754ba3cefd00811dc701bf",
      "text": "Krama: «Sampéyan sampun nedha, Bu?»",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "77dc2904496107e90dadae11bc7468ca12ab527be3a4c64f9f2a2339c69d12a6",
      "text": "Mbah, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d6662f64199a180ab68ea3c7e38ebe4aeef7c0c0c76a0325334d4e0da08b44",
      "text": "Mohamed, karo Bu Siti, ngoko apa krama?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a2affbd470f9ab7fcc825eb19601bfbd666888b003e4d45b352c28574bcabf9",
      "text": "Sampun, Mbah.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "869a75b466cc2b31950a07a6542510a417addc61c54d1bc192c2fb6e488f2835",
      "text": "Piyé, Mohamed, wis mangan?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "94c02a2d8aa63e4abc165e3cb97e19ac283aef2ee31a18457a00ac555d913dc5",
      "text": "bakul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a30a1db089e7581711d08ff24757932cf9b7384edc2ad94c261ad9ee8e11b95",
      "text": "krama",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b709409626380c00b744c00f663b8012000293816d32c5b0c49934f9a267846",
      "text": "Karo bakul: «Sampéyan sampun nedha?»",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a817953b68113b358f41a3f56622846a527b007ba0a50b94bdad145b4c15b95a",
      "text": "unggah-ungguh",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aad694631dcf4654712ddfb8cdf4927fc29d76eb0d4c0c1aa7c4dcbc8bf59f0b",
      "text": "panjenengan",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13375dfebc7209a61ed4d1b4b569ba54582ab01188514b2ae3242ebb86a6921",
      "text": "Karo mbahmu?",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e0358d3c5ae277aff79f3cee1f6af278338eee9bb885bdc937e9a9c6ef7a47",
      "text": "Karo aku?",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ae0210fc584496a072a7a77ecf5ea38f3bd5c2c3b3a93bb0353295eab4c6b5",
      "text": "dhahar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83759bd9631ef039aeabe77f6b1697c340954add41347caec5fb2bd6d0938e4",
      "text": "Ayo, Mohamed, nang omahé mbahku!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d191d6af0be9c2b2b17811f436893e7f00cc854e91592e9fb9a82ccf57aa391f",
      "text": "Krama inggil: «Panjenengan sampun dhahar, Mbah?»",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ee34e6003ef1465bcf12f4546e1e0b8c87bd40bcf98e0bba2bc0dc6c6b36fc",
      "text": "Sampun, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d32dc9342d95fd89842471c5454885d82ca732474384214c02a90e0cccdc206f",
      "text": "dèrèng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a703943112f787f4a3ed3fd83dada14095229c513ae00ab916b9759813e9e7",
      "text": "Inggih, kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfb3cf178e092c87522c7b4db78927a35ae6fece3f662aee8c0c0f37dbfa893b",
      "text": "Dèrèng, Bu.",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e016fd05a58077dd8a45e896a273fe371f39f22ad803a7c40573d4e551e5e81b",
      "text": "Mas, aku arep sinau krama.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8bce7f86d2a683197b0942f37e2f0e4b0454db8d79df4b576279bf2d75b54ad",
      "text": "Wis, Mas! Enak tenan.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8beaf7edfc249acc647fb643a27512d6b140d8b151287328f293bf87b0d9d5a",
      "text": "krama andhap",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9cf47498d6db555d7825ab28359c6d7c7aacf11dcebff5925bbade8eb2e4a40",
      "text": "Kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "f136ce8e9310bfb730efa5c7e6b9a2eaca6ea789c8ef36226b870dc3f38571ce",
      "text": "Koen wis mangan ta, rek?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f22614b0889ba6cc5852e2132c165861db786cc9aa992344d78674185ce0fd5b",
      "text": "inggih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f635debc3d61c23a726c0f23e611447fb125d6a57c184d932c38883754a5df38",
      "text": "sampéyan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f718463818ce72f417d3ee2d7d495d38a44ecf9e676b0786a5514ca7635a0bc8",
      "text": "nedha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7459544caedaf1109d203e74bf6670c518d30d8b2e4e086e27136fcc4c50b7d",
      "text": "Sugeng enjing, Mbah.",
      "voice": "jv_dimas",
      "chars": 20,
