  "audio": [
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b9c6bcec6f6a010339d49c002c7d308efc729f68e880504cd833a722b3a84b",
      "text": "Panjenengan sampun dhahar, Mbah?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "06f11a15c49efa4070370f06778f7a0bb8b859dce45bc13ab134b65a0190bfca",
      "text": "mangga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "07476724c4dd6b84cce1886c7d103e1dec8891f6487df9d91950713d56a1ced6",
      "text": "Dereng, Bu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b0541dd5942d8226138b977909474dc4037f9a64f5156fb7b7bea2fde8591ae",
      "text": "sampun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d88458090da875764c43ec48242a9b29bada5cb15c0cf1590c3f2094b949901",
      "text": "Krama: «Sampeyan sampun nedha, Bu?»",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e695eaab779721c78cc03d8c77fd4e0baeb2b3897d67bba1481a8b3a90057d9",
      "text": "Piye, Mohamed, wis mangan?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "10ec629788d20bb30e944b27073043ac25caa8d16b0933f97066d4954d82107d",
      "text": "Le, Dimas! Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "11939973344d3c302f3b671be089e85a2733f0af4978b73008a9e3961ab72829",
      "text": "ngoko",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ab9441b5527053cb603d676732e2aa7aa0cdc298ce301dd10e29c19bd74cd40",
      "text": "Apik! Karo kancamu: «Kowe wis mangan?»",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e6e71a9dc4d9fafc329c33a126bbceaaefefea72fb35b0e00d4c0d6f9a7b9d4",
      "text": "Apik! Karo mbahku?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e95f8c3fd640f54e4991cb83d494764c3f6e17c9a9b44b270eaf1e0cbec31aa",
      "text": "Aku wis mangan.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "20e3cd235724bd8d685a692880dd5270ccb882f2b85db09539817cee9d100599",
      "text": "Dereng, Mas. Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2199e70f92037ef2e6d74adf8bc48016d71ed9dfce7549bd989ae00587dadf54",
      "text": "Krama, ya? «Sampeyan sampun nedha?»",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "247dc8cbf353abe2ee5859e3ac5a2c2cb97fb6ea27bae9df9422437aaad143d0",
      "text": "Ayo mangan soto, Mas!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b0571dabfe6b87b096bbb64c5b176e2fa71a7ad8aca25e3e1b50df29a435e9a",
      "text": "dereng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eeb4a97eb4bc2b87faa63c91407663956a368e8dcd02405ba79c5a058f6c83b",
      "text": "Inggih, mangga, Bu. Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "339b9cc5e48e3e8ac50ce59a6cd1ff44a84d771688fc4da16d9fce3d660f1093",
      "text": "Dereng, Bu. Matur nuwun!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "344f60cb4cec30853ac296f76d48ca1b688a979caad60939021dbf70aad42e87",
      "text": "Mas, iki pesen saka Bu Siti.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "42993b7f4a52a4a75a207946329333f32348524e6ad44ea8bfffba5909f5cc3f",
      "text": "kula",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b756442f949c96a7d78de659ae8b212029c4a6fe0212088e2285e44ce6e249b",
      "text": "Mas, sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5177a47f23ad7180d06af6c7376601ba617653c0863fbd67c6413b9a7375539d",
      "text": "Kowe wis mangan? Sampeyan sampun nedha? Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "52066d09f4e42c0047398e24722caa9e18f8123a853a5cce038d37194c8b477c",
      "text": "Mohamed, aku uga durung mangan.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f185812cd473786c1cd6950fe1ba2013705352127d972180a096bc01b0c302",
      "text": "Suwun, Mas!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5318f54a8da06e9cf35ae63f9b60030e6b595f02755e2317a2a5ebe24c374c9b",
      "text": "Mas, mangga, soto!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "54e7fc37044341eb8ad17f665877a0252a28a3d0bff39d65686c9e81da3e97b6",
      "text": "Iya. Aku arep nulis nganggo krama.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5558901558f47bbc9923e465554409c0fc186eec5964d63b138e1c857049b2fd",
      "text": "Dereng, Bu.",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "591fd4685720c8f3968b120f0a3d154bc5ae08f8ecece3cf66041ba61fe2d346",
      "text": "Karo bakul: «Sampeyan sampun nedha?»",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cb1519fc9da89be5774b04dd87eb9983d38a2c4734d06ba5c7b417d47e66341",
      "text": "Ayo, Mohamed, nang omahe mbahku!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2cc0487762a95f0d8c6e52811a848ab1a6677c391ec077165c9b8deb51e55",
      "text": "Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f338aca4f39f5d80100d94528d0230aadb50a92207436db354d7b0e46e10fe3",
      "text": "Sampeyan sampun nedha, Mas?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "610b504a818c74567b24c0509e0d8428efcb28e006aa195350a3cab1859ac2be",
      "text": "Mohamed, iki Solo Balapan!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "6145ed3e38bc7a66ae9323dadc9839fd8751d33b1b9c4786819bcdfa75edb620",
      "text": "Mohamed, kowe wis mangan? Aku durung.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "63fdd3ee5a9bffa072ae2f005a867abc00a9bfd1a49b7f5042c1f2edd53beb48",
      "text": "Apik! «Inggih, kula sampun nedha.»",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6582626a59a528df6c4523813386ed2972613c4456c529b9bca62dc3dc1eaed8",
      "text": "krama inggil",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "65b6c27ff4a88698ea5ec1a021d9956f829c436d8bd5ea3566e691daf57ff27c",
      "text": "Sugeng sonten, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "66c5f1759fbc4e3138da7fdd6027df5690e10fa221d0427bfd94a27bba3f4ae0",
      "text": "Sampun, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6776fd05fb2e76078383171d50f9ecd8e073f81fcaa136fdea1b80d2fd3070a3",
      "text": "Kowe wis mangan, Mas? Aku durung!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c8c51d82a460a9a80b1e5cf6d07fff6ca198bafa908913ebd9a3813a23c1321",
      "text": "Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "72b01227cae3c82d0004189acc54c4073794536a88188d19aaed960f4ad2dbb3",
      "text": "Mangga, Mas!",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "761751068ff21d959f82f8ab00261f8aec63e2a3fec8bf3d3ad7caa7b9332f80",
      "text": "Mangga, Mas, mangga.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "77dc2904496107e90dadae11bc7468ca12ab527be3a4c64f9f2a2339c69d12a6",
      "text": "Mbah, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d6662f64199a180ab68ea3c7e38ebe4aeef7c0c0c76a0325334d4e0da08b44",
      "text": "Mohamed, karo Bu Siti, ngoko apa krama?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a2affbd470f9ab7fcc825eb19601bfbd666888b003e4d45b352c28574bcabf9",
      "text": "Sampun, Mbah.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c4efe8b8c79b1cee84b0b639dab3b81c138caef02f6a596c53e351d55dc71df",
      "text": "Mohamed → Mbah Putri: Sugeng sonten, Mbah. Panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "957466974465919adb5cc0d91c8fa5b607fcdfb449aaf84444674ce887f710e8",
      "text": "«Panjenengan sampun dhahar, Mbah?» Aja «kowe», ya!",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a30a1db089e7581711d08ff24757932cf9b7384edc2ad94c261ad9ee8e11b95",
      "text": "krama",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0be2d05aa7de9e4df986ef275f42ce220bdda2173425911b0e71ed8873dd048",
      "text": "Mas, sampeyan sampun nedha? Mangga, soto!",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6567e7502cb7e9f93e86c7203e88d1aac04de71a49969a766a78d555a494168",
      "text": "Mas Dimas: Mohamed, kowe wis mangan? Aku nang Balapan.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a817953b68113b358f41a3f56622846a527b007ba0a50b94bdad145b4c15b95a",
      "text": "unggah-ungguh",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aad694631dcf4654712ddfb8cdf4927fc29d76eb0d4c0c1aa7c4dcbc8bf59f0b",
      "text": "panjenengan",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa8c8276b65282efee60c6da53794896dbcaf63d87a90bbe8718ab2c631930d",
      "text": "Bu Siti: Sugeng enjing, Mas. Sampeyan sampun nedha? Mangga, soto!",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13375dfebc7209a61ed4d1b4b569ba54582ab01188514b2ae3242ebb86a6921",
      "text": "Karo mbahmu?",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e0358d3c5ae277aff79f3cee1f6af278338eee9bb885bdc937e9a9c6ef7a47",
      "text": "Karo aku?",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ae0210fc584496a072a7a77ecf5ea38f3bd5c2c3b3a93bb0353295eab4c6b5",
      "text": "dhahar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c552d8569a1913c67297499d82c086faa1169fe7076b4bba64605d33c6c32315",
      "text": "Kula sinau unggah-ungguh.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d191d6af0be9c2b2b17811f436893e7f00cc854e91592e9fb9a82ccf57aa391f",
      "text": "Krama inggil: «Panjenengan sampun dhahar, Mbah?»",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ee34e6003ef1465bcf12f4546e1e0b8c87bd40bcf98e0bba2bc0dc6c6b36fc",
      "text": "Sampun, Bu. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a703943112f787f4a3ed3fd83dada14095229c513ae00ab916b9759813e9e7",
      "text": "Inggih, kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e016fd05a58077dd8a45e896a273fe371f39f22ad803a7c40573d4e551e5e81b",
      "text": "Mas, aku arep sinau krama.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8bce7f86d2a683197b0942f37e2f0e4b0454db8d79df4b576279bf2d75b54ad",
      "text": "Wis, Mas! Enak tenan.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8beaf7edfc249acc647fb643a27512d6b140d8b151287328f293bf87b0d9d5a",
      "text": "krama andhap",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9cf47498d6db555d7825ab28359c6d7c7aacf11dcebff5925bbade8eb2e4a40",
      "text": "Kula sampun nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef8d9039fa4719671f912bd840cb3813f3f6fa8cddf63aa532d66dd86734cabe",
      "text": "Sampeyan sampun nedha, Bu?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f136ce8e9310bfb730efa5c7e6b9a2eaca6ea789c8ef36226b870dc3f38571ce",
      "text": "Koen wis mangan ta, rek?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f22614b0889ba6cc5852e2132c165861db786cc9aa992344d78674185ce0fd5b",
      "text": "inggih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f718463818ce72f417d3ee2d7d495d38a44ecf9e676b0786a5514ca7635a0bc8",
      "text": "nedha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7459544caedaf1109d203e74bf6670c518d30d8b2e4e086e27136fcc4c50b7d",
      "text": "Sugeng enjing, Mbah.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    }
  ],
