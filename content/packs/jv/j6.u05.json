      "id": "j6.u05.l06",
      "sha256": "0249569791c6e0eccf5541dfcfc4a5783f7171946b5d02b1b00a31081c733533"
    },
    {
      "id": "j6.u05.l07",
      "sha256": "bd31bb92632a87847dd829dd2a7fe1348ef56dc838deb8228456e43fcb53a313"
    },
    {
      "id": "j6.u05.l08",
      "sha256": "ec65bc6dfb7b37b2e1583e6c996f7d8cf31dacc953182fbf1db6c3672b698057"
    },
    {
      "id": "j6.u05.l09",
      "sha256": "edfd314129c14f8451dd87714314046ce5938ea39bcb91880329a7cc6c418eb7"
    },
    {
      "id": "j6.u05.l10",
      "sha256": "e4c857ef4fc064620bdc3c73c58de78493df1babce68beea24fa237ec177e555"
    }
  ],
  "audio": [
    {
      "key": "00b7b10907e29463d83da54110e0190c8acef59a8c6752ad76d9e61e926c2e89",
      "text": "Aku wis munggah patang atus sanga undhakan!",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "00cb4dfa9485142e0ce4e059f6183a31e8eb94d91172ded29a96b509346f3318",
      "text": "Leres. Mangga sareng-sareng, Mas.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "013b66d7ad967d9e483e2ce67181edb4865b7155d16e55891f6d25e583a7ee3a",
      "text": "Masjid iki dibangun taun sewu limang atus wolung puluh pitu.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "030b8730cae8c4876a9f77ca9a111326b64cf15c4b000d26680a5afc2aab2e09",
      "text": "꧇꧒꧐꧒꧖꧇ (2026)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a0d561a31b31bf96ea7d239ee2ed7ace032672a4320a8e611523c91d7a85162",
      "text": "Isa maca? Aku nulis nganggo aksara Jawa kabeh.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca8d306cafe3ca283411b4778fd712d7f33589b5be086873a63d8b84a320537",
      "text": "ꦲꦶꦁꦝꦸꦮꦸꦂꦲꦤꦩꦏꦩꦺꦯꦸꦭ꧀ꦠꦤ꧀꧉ (Ing dhuwur ana makame Sultan.)",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d949734c6ecd7a8554888129fa167ab651646b483f11628e38fd937a6f93673",
      "text": "Kaya krama inggil, nanging ing tulisan!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "10ccc18cb1fb21e175070f3058f21d24921a2ac5e2fabb0d54585026501b4c42",
      "text": "Leres. Panjenengan sampun saged maos aksara Jawa!",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "17443c41bebbf5f5f865a2bef61c6497316abb07ad1815cd32eb024e48294440",
      "text": "ꦲꦶꦩꦺꦴꦒꦶꦫꦶ꧈ꦠꦁꦒꦭ꧀꧇꧑꧗꧇꧉ (Imogiri, tanggal 17.)",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "197402a3486c2e13a828d00b1d600406ca719bf584019c8f2d2272bca2da555f",
      "text": "Zaki",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bd772abea3af000357b031490c0add677db4c9ea46685920193ebc3e6a3af74",
      "text": "Pak, kula badhe minggah dhateng makam.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "205fd8e122667f16e8b7053c063bd8231496879acd65855c6236d78977e5c594",
      "text": "Wonten, Bu!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2328f5a200f2ae52d07702ac1931c296af54c81c65d08fe5f2050ab0bf3155ed",
      "text": "Fajar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "24012fe4f3ff5ec24bf7f37885c788e4dc695e9ffdb7934de032e393b56232cd",
      "text": "ꦗ꦳ꦏꦠ꧀ (zakat)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "25f93f1cdf7172181ebf0f33c1641cf62c0923a2591418c047b71f07c0457d07",
      "text": "Alhamdulillah. Sikilku isih kesel, ha ha!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d71c90733e1472aa9b9107db3260e2f1ef2fe0564bea15f7f32d2c860589da",
      "text": "Asmanipun ngangge sa murda, nggih?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d5d649fee6a048f207bcc920448f64f6fe7e0ec72b36da3048779163d8bc756",
      "text": "Dina Jemuwah sawise Asar aku melu pengajian.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e3f40c92335e44ee41a801522695d3a33f6bb6e0702dbc6e55d5c572c404c57",
      "text": "ꦯ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ea1a816646536603542741bae3dfdd0e5f214a9a099b4c15ddadca7ba22d1df",
      "text": "Undhak-undhakane akeh banget!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ec752080c6527b3983f97f4af2039b077178c831b3cded6014b9ae7636cb0f7",
      "text": "ꦗ꦳ꦃꦫ · ꦥ꦳ꦠꦶꦩꦃ (Zahra · Fatimah)",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "310387db02a00cbf05cfbdf967c14e0ed7f95ffa5135e49d6ce729d096cf3a4a",
      "text": "ꦱꦮꦶꦱꦺꦲꦱꦂ꧈ꦲꦶꦁꦩꦱ꧀ꦗꦶꦢ꧀꧉ (Sawise Asar, ing masjid.)",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "440938a0db3d75609a915d6ff5914d0174245ab102cdea078469407baa5680c0",
      "text": "ꦲꦏꦸꦢ꦳ꦶꦏꦶꦂꦲꦶꦁꦏꦤ꧉ꦩꦺꦴꦲꦩꦺꦢ꧀ (Aku dzikir ing kana. Mohamed)",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "45422c9c6022a819f48a3cf69e9439973356dab5012caaa3c29efc4d1f660ff5",
      "text": "Wah, prasasti. Panjenengan saged maos angkanipun?",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c331126a575f94f7daeb26aa798744e684792876a080744f72fd79f45f936ba",
      "text": "ꦩꦸꦒꦶꦓꦸꦱ꧀ꦠꦶꦥꦫꦶꦁꦫꦲꦪꦸ꧉ (Mugi Gusti paring rahayu.)",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d7f2aca5cb13b9cef50663d814c6de199d9914c32fde536624715af49dd5013",
      "text": "Med, iki dalan menyang makam Sultan Agung.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f314821867f8002c7b2769fb85c6ac1b50563cbd5be753a19165526e3347fbf",
      "text": "Mangga. Undhak-undhakanipun kathah sanget.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "503a3200b1b0436d729d7b9de406c29ba84fdc102a62f5215b940d71f30f64de",
      "text": "Gusti ngangge murda, nggih?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "53c3d77f1ca3e45042629cc76ab2992035c04abd7fedaf24f8ff37114e2033e0",
      "text": "Med, kertu posmu wis tekan!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5522af93ded24b06f0ac8348e5f4f5fb6623e6a938936daf41467e65764862e3",
      "text": "Pak, angka ing papan menika pinten?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a30c5dfb7c99eb29ef49de60a348f86909e93a874ab0bac0c9933007300ec81",
      "text": "fajar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ce56d9b0a775dc9811fe8a243a13cb798c2b1f107807898e02d3178aef79467",
      "text": "angka",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d6d0a493c150dc23267db5f0edc8ac3018fb2c468927a9e7fa42dcffc5cf630",
      "text": "Undhak-undhakane ana patang atus sanga.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5edb2e321fa9eebdfe1301569e607b099b96c15d4921a71b2b0a93c61dc9beb0",
      "text": "khusus",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "604e94ad060664ba17d2e46260ea10a02beba1d8dd3d10a3ac978e8cce9a63d7",
      "text": "ꦥꦶꦏꦶꦂ (pikir)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "61f71c82132adbd5ea94573851fe2a8e94cc5497a874fa5ab21ceb406e00700a",
      "text": "Inggih, Mas. Panjenengan saged maos papanipun?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "637e23b3a0bdefefc808676cf1e57baf756c6112bfc9e16b048309b04c34a902",
      "text": "Matur nuwun, Pak. Mugi Gusti paring rahayu.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "65f618a083256640f15cccede5153db79f5063ca1b09c5b6642e772377fc217f",
      "text": "Leres! Ngatos-atos, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "660df584c80cfef6c6ae255e81c38fcb842781f6cfc09dc7579f014fadc2c3cc",
      "text": "Isa. Sultan nganggo murda, dzikir nganggo rekan. Apik tenan!",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "67395f6e3a08b82672045c1660d0665111381ffc3f2cc297d479d4cbfef189f5",
      "text": "Kula sampun maos ing papan, sekawan atus sanga!",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bb9434b4094ddb52d84f81f7c6a77d7d97e90c60c74698b41328828144224f6",
      "text": "zakat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c0fe292d5378134afe57ba629bb91911e62cb0543fe1fbab1e3f0a7e4a22f73",
      "text": "꧇꧔꧐꧙꧇ (409)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fe6a2bdd9f4d1b3ffcc1fd4456e4b98ba01e1c54b5eb9d9886a8cad06fc1b68",
      "text": "ꦓ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "71a179ee98531bd54d61c3159da9cf587c2819c3b447ab7f59f28b663e918292",
      "text": "Leres. Sampun sepuh sanget, nggih?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "720c46482b2a8b9639a182d1b21eb8c54af261e43068fa120dfc451d3c816578",
      "text": "Oh, ذ ngangge titik tiga!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "771986656eebda0e0ea86beb47c4a4d9c459041bfa6457940269a124879e887c",
      "text": "ꦠꦁꦒꦭ꧀꧇꧑꧗꧇ (tanggal 17)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a7649e0f52f4b1fbb315d2b1520de2dce2f8c0e2d35527f81c7cb297576dfca",
      "text": "ꦢ꦳ꦶꦏꦶꦂ (dzikir)",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d2617f03f1f80eea7c39172eb71b668b5e62a0a008a88c3b18f4eb1986dfe14",
      "text": "ꦩꦱ꧀ꦩꦺꦴꦲꦩꦺꦢ꧀꧈ꦩꦠꦸꦂꦤꦸꦮꦸꦤ꧀ꦱꦩ꧀ꦥꦸꦤ꧀ꦫꦮꦸꦃ꧉ (Mas Mohamed, matur nuwun sampun rawuh.)",
      "voice": "jv_siti",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "831099b81b041e4688cd28445e09697ff1105831daa2a12ed4c7dd00ea088b15",
      "text": "Menika dzikir, ngangge aksara rekan.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "832be145a1e4d9c277b24b2c63ff7880512ef3fb914cbfb1d7fc5506fbec87c3",
      "text": "ꦢꦶꦤꦗꦼꦩꦸꦮꦃ꧈ꦠꦁꦒꦭ꧀꧇꧑꧗꧇꧉ (Dina Jemuwah, tanggal 17.)",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "837f66585ae22fcb71e5c3dfd19fbb1862288c77a4a7ac0d8f2c0a2af45537b8",
      "text": "Tulisane aneh, Mas. Iki sa?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8513fd55515fdfa2c6b89eeaa478b5d0aafc57ebbbfa6d63d8b552512b0ef3b1",
      "text": "Inggih, Mas. Mula ditulis nganggo aksara rekan.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "8535d24bd0b532b20ad389a8bcafe6bfa9f47a3d33405c1b8c84cbdff7d0568e",
      "text": "Pak Harjo, wonten pengajian dinten Jemuwah.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "87d0f18b7a2813747315d4918d48d601644dc98beec4a5ab09df8e80815d0a44",
      "text": "Juru kunci njaga makam.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ae1ecf2cb16dfc42c493fd2a873a2119a7ee9bba287968c605eeb8c58890086",
      "text": "ꦦꦔꦺꦫꦤ꧀ (Pangeran)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb75b04231c8916bf8fa87bee027e468d8996250bba0445250cd866f1a259b8",
      "text": "ꦩꦱ꧀ꦗꦶꦢ꧀ꦒꦼꦝꦺ (Masjid Gedhe)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "92669462535de46353147c0979290eb97b1b39f83fafe47cb1c456478b660f57",
      "text": "Mangga, alon-alon kemawon.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "935016feaa4729644f95cd5615a6b11600f3e6a8a65fd9336097e67f9c45819d",
      "text": "ꦯꦸꦭ꧀ꦠꦤ꧀ (Sultan)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "940847e737a4ee6dabb0fa9967cc90479df10bbd9bb959dede187209f39cff8f",
      "text": "rong ewu rong puluh enem",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "94bc8d714c34168dd0ae27b06714d61cc8e1484cf5a1319c6b5d29e1b806dfe8",
      "text": "Khadijah",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d2abf843a06a9fb2849ea55476ef95c8a1700b89580249759512466d6f494b",
      "text": "Gusti, Sultan, Pangeran.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9635b28cc996ec8d7f9cbc8f8789e0b081e63135a75391083917e0fdd1feff4e",
      "text": "Sampun, Pak. Kula saged maos sedaya.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9782082819ecd26a650b6f7e8b8ecd2da07bbc905c104627e6cc861df6e590a8",
      "text": "Saged. Dibangun taun sewu limang atus wolung puluh pitu.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "98523ab6f8e16e6a5d2facee3a028a89ddebfb215a790215dff0f579a0e5efaf",
      "text": "juru kunci",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "99102acd9d9d7162b4bb511e7e1fcaa8df8855a22471ee8faee0a015cf678be0",
      "text": "Sae, Mas. Menika makam Sultan Agung.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "99a926fa12ee550209aae024cf30218d51e1171aae5e345884642be257cb5b31",
      "text": "dzikir",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bd8110bedf9fa6b215b54323eab8be24700cde7f2c61d9a5bf561678cdf2ff5",
      "text": "Sekawan atus sanga! Kathah sanget.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e67607a0998e652e9b706a1a060223b217b2283ee5ed1a39476b2163fb9e99f",
      "text": "Bu, jeneng-jenenge kaya ing Mesir!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fce5ebd38ebfbeb8097575486d2ab4aa9a1a638c6978cf8923763b448a560f6",
      "text": "ꦢꦶꦧꦔꦸꦤ꧀ꦠꦲꦸꦤ꧀꧇꧑꧕꧘꧗꧇꧉ (Dibangun taun 1587.)",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a058c5ccd97d2071f6b979a4dadc2873e8aa1da8bd438b6ab9745b27a405ba6c",
      "text": "tanggal pitulas",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "aedc507cb4faac9ad4790158a177f0bde40d7202b51834d1ff6a492c431070fa",
      "text": "aksara rekan",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "aee606c9e424091c9ed38771f96b18d8e17eb38ef4330938302981d9e5f0371c",
      "text": "ꦩꦱ꧀ꦢꦶꦩꦱ꧀꧈ꦲꦏꦸꦮꦶꦱ꧀ꦩꦸꦁꦒꦃ꧇꧔꧐꧙꧇ꦲꦸꦤ꧀ꦝꦏꦤ꧀꧉ (Mas Dimas, aku wis munggah 409 undhakan.)",
      "voice": "jv_siti",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7d2881a0efb2768503740b6e33b090cc2d3530299081d8cc545b1eb7ed62bf",
      "text": "Sekawan atus sanga, Mas. Cacahing undhak-undhakan.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b71399897784fe9bd495aae558166352601ad08d92ac92ca5ce94a38eab09be3",
      "text": "tanggal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba5993b61214f0f011e1f9475340e3a31ae7383c902148a9fea9efe6a417836f",
      "text": "Fajar karo Zaki teka.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb9748e94074c27c9ab62f249a66d139f5b2ec2f5b35899472b1c319d2455445",
      "text": "Gusti, fajar, zakat, tanggal pitulas.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "be7ebc3ac84b70c006c82d980aa59b43f7114e1fc55af6ae77ab5ce8cfbc991a",
      "text": "Iku sa murda, kanggo ngurmati Sultan.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "be9a788ba1f3bfb8fa58ef37f8d10b04057c83dba9bc1002b0c1f5ac4f1c2daf",
      "text": "pengajian",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0070fb0a413d41aa45b38d49faf17cf2c2550e8d732a1d48b0b16c6dfd22b33",
      "text": "ꦥ꦳ꦗꦂ (fajar)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0453c857be9ba7c51f2fc6c0c5610abd896ecb26a0ba84809cc5c894ae6282f",
      "text": "Pangeran",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c552f54b8f4fe757f56df30415db07a9f4f758ad3edf45651fbb1be33d891bc1",
      "text": "paring",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6a64a21f4f08bc6a6a50055045cd690c4d387e0fffce6d00d82ced7d9028f6e",
      "text": "pada pangkat",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c79291200f77b2872d63143c4c1e948d5f3c609ae544873db3297695b9b4d8df",
      "text": "Dina Jemuwah, tanggal pitulas.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8d568a8cc5f463d0da80af4b3a729b7d863bd090e5e69746de309936cd4b165",
      "text": "undhak-undhakan",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb1d9b1566db141f2a937b19183e17f5eaae2545f4a7a4355cf9d359c52d8cde",
      "text": "Mugi Gusti paring rahayu.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccfad25487b3e7f5e1ebf1b3945c1a9f8aa990f60a723fa651bcba14c6e5bfa4",
      "text": "Tanggal pitulas, taun rong ewu rong puluh enem.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd0cccfe1e9d2d494dee6d2dc47da01d5dc8f879013784d226ec96777df2cd42",
      "text": "Masjid Gedhe dibangun taun sewu limang atus wolung puluh pitu.",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce3ef80ed9b5db61a4057c1dc49b53995f64033c30428657bf1889247dd493a9",
      "text": "Fajar? Zahra? Khadijah?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6adbbd4303b8633b0f45bdc4ccbc84e22f965ddf5413d4d720753a1827f9a27",
      "text": "Pak, kula sampun dumugi ing nginggil!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "daac28e17872e611e0af1334cc0083bb75fa158f446097d9ec1d91a4a2834277",
      "text": "ꦥ꦳ꦗꦂ · ꦗ꦳ꦏꦶ (Fajar · Zaki)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc5fef209612499d3f4c8b27dabb8a74af69edb8b9398c0f881139bea7e215d7",
      "text": "Fajar, zakat, dzikir, khusus.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcc0b0fa77097d8602a4b52b390a5baf795e37d2481bfb2f2f26aa936c5d52e8",
      "text": "ꦦ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd39b6b7bc70b4be829768f8ffebf3226279902158e77c9d09fd96d6a524a2fd",
      "text": "ꦢ꦳ꦶꦏꦶꦂꦭꦤ꧀ꦥꦼꦔꦗꦶꦪꦤ꧀ (Dzikir lan pengajian)",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e108037054d6b82e951c0c79a45affbecc9e6e0e67e7601095619638a24cfcae",
      "text": "ꦓꦸꦱ꧀ꦠꦶ (Gusti)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3962e4719c2ecae4db1dc6d5eee6600995841c7fd6b4ec4988c2e30c4fb4ba2",
      "text": "Leres. Mugi Gusti ugi paring rahayu dhateng panjenengan.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e894bfa7f329c4ff82142380166bedec46be808443b00f08407184c9cd263156",
      "text": "ꦏ꦳ꦢꦶꦗꦃ (Khadijah)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "e99ed88b629b94a48703ba7707337393d799efda1ad7857adac592dc1963b339",
      "text": "Kula juru kunci ing Imogiri, Mas.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9ada5218ba561a58866549fa02a21c7206a5b03b44ed9c01cf3aa11d15cc99f",
      "text": "Inggih, Pak. Menika tulisan menapa?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9dcdd423ee756ff69477b5401ea419b77f1d2f0a227c2d4aa7d79e1498bed66",
      "text": "Sugeng enjing, Mas. Badhe nyekar?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed1bd152d69086653911723fb6e08fb72ce09bb36414612ee2fb6a341620bc5f",
      "text": "Mas Mohamed, serat kula sampun dumugi?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "edd32cfd98eed191979ade216c21882f087c21158d273591e1077a149dd8f270",
      "text": "aksara murda",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f24f58611459fba18c74bbb43328d01c66fc758d6ac5817ab6c8d4c32c9d4299",
      "text": "Pak, menika foto saking Masjid Gedhe Kotagedhe.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "f51f2d7b7e465ecd885ececb5f260fe97139cbc9cc65693205ba29f28785c94a",
      "text": "꧇꧑꧗꧇ (17)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6939a4761efe2aaa83efe6be062af067272b6b6255666c03ec39be03e43b5dd",
      "text": "ꦲꦸꦩꦸꦫꦺ꧇꧔꧓꧙꧇ꦠꦲꦸꦤ꧀꧉ (Umure 439 taun.)",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8fbe6103cfa7662952634a2c38eb4d42d221e85ae934311f1406f313ae81cde",
      "text": "Aku dzikir ing kana.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd77c8aa27bc01c2ca445d4a474d93d2b8e8afd4b85756721da5906b92b1b900",
      "text": "rahayu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff2916a88f8f92feea55dd49dfa264fd15f9086d2d5e610ddec324261f045a7e",
      "text": "Saged, Pak. Dzikir ngangge aksara rekan, tanggalipun pitulas.",
      "voice": "jv_dimas",
      "chars": 61,
      "mime": "audio/mpeg"
    }
  ],
