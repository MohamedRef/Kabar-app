    },
    {
      "id": "j6.u05.l03",
      "sha256": "458b877174c9754de97310b7d6a0a0081c7c011e62e4c5f284c071e5a023597d"
    },
    {
      "id": "j6.u05.l04",
      "sha256": "079bb6e74f6c8b946a0f64c7c42d0d5a5667c016852f1e5bae447d22ab0a363f"
    },
    {
      "id": "j6.u05.l05",
      "sha256": "38f38c0dd470ef511d00c437cb5b43bf78dbbc29d9a0fce4a7745fcdcfaec354"
    }
  ],
  "audio": [
    {
      "key": "030b8730cae8c4876a9f77ca9a111326b64cf15c4b000d26680a5afc2aab2e09",
      "text": "꧇꧒꧐꧒꧖꧇ (2026)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d949734c6ecd7a8554888129fa167ab651646b483f11628e38fd937a6f93673",
      "text": "Kaya krama inggil, nanging ing tulisan!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "10ccc18cb1fb21e175070f3058f21d24921a2ac5e2fabb0d54585026501b4c42",
      "text": "Leres. Panjenengan sampun saged maos aksara Jawa!",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bd772abea3af000357b031490c0add677db4c9ea46685920193ebc3e6a3af74",
      "text": "Pak, kula badhe minggah dhateng makam.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "24012fe4f3ff5ec24bf7f37885c788e4dc695e9ffdb7934de032e393b56232cd",
      "text": "ꦗ꦳ꦏꦠ꧀ (zakat)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d71c90733e1472aa9b9107db3260e2f1ef2fe0564bea15f7f32d2c860589da",
      "text": "Asmanipun ngangge sa murda, nggih?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e3f40c92335e44ee41a801522695d3a33f6bb6e0702dbc6e55d5c572c404c57",
      "text": "ꦯ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ea1a816646536603542741bae3dfdd0e5f214a9a099b4c15ddadca7ba22d1df",
      "text": "Undhak-undhakane akeh banget!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d7f2aca5cb13b9cef50663d814c6de199d9914c32fde536624715af49dd5013",
      "text": "Med, iki dalan menyang makam Sultan Agung.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f314821867f8002c7b2769fb85c6ac1b50563cbd5be753a19165526e3347fbf",
      "text": "Mangga. Undhak-undhakanipun kathah sanget.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5522af93ded24b06f0ac8348e5f4f5fb6623e6a938936daf41467e65764862e3",
      "text": "Pak, angka ing papan menika pinten?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a30c5dfb7c99eb29ef49de60a348f86909e93a874ab0bac0c9933007300ec81",
      "text": "fajar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ce56d9b0a775dc9811fe8a243a13cb798c2b1f107807898e02d3178aef79467",
      "text": "angka",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d6d0a493c150dc23267db5f0edc8ac3018fb2c468927a9e7fa42dcffc5cf630",
      "text": "Undhak-undhakane ana patang atus sanga.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5edb2e321fa9eebdfe1301569e607b099b96c15d4921a71b2b0a93c61dc9beb0",
      "text": "khusus",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "604e94ad060664ba17d2e46260ea10a02beba1d8dd3d10a3ac978e8cce9a63d7",
      "text": "ꦥꦶꦏꦶꦂ (pikir)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "65f618a083256640f15cccede5153db79f5063ca1b09c5b6642e772377fc217f",
      "text": "Leres! Ngatos-atos, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "67395f6e3a08b82672045c1660d0665111381ffc3f2cc297d479d4cbfef189f5",
      "text": "Kula sampun maos ing papan, sekawan atus sanga!",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bb9434b4094ddb52d84f81f7c6a77d7d97e90c60c74698b41328828144224f6",
      "text": "zakat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c0fe292d5378134afe57ba629bb91911e62cb0543fe1fbab1e3f0a7e4a22f73",
      "text": "꧇꧔꧐꧙꧇ (409)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fe6a2bdd9f4d1b3ffcc1fd4456e4b98ba01e1c54b5eb9d9886a8cad06fc1b68",
      "text": "ꦓ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "720c46482b2a8b9639a182d1b21eb8c54af261e43068fa120dfc451d3c816578",
      "text": "Oh, ذ ngangge titik tiga!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "771986656eebda0e0ea86beb47c4a4d9c459041bfa6457940269a124879e887c",
      "text": "ꦠꦁꦒꦭ꧀꧇꧑꧗꧇ (tanggal 17)",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a7649e0f52f4b1fbb315d2b1520de2dce2f8c0e2d35527f81c7cb297576dfca",
      "text": "ꦢ꦳ꦶꦏꦶꦂ (dzikir)",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "831099b81b041e4688cd28445e09697ff1105831daa2a12ed4c7dd00ea088b15",
      "text": "Menika dzikir, ngangge aksara rekan.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "837f66585ae22fcb71e5c3dfd19fbb1862288c77a4a7ac0d8f2c0a2af45537b8",
      "text": "Tulisane aneh, Mas. Iki sa?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "87d0f18b7a2813747315d4918d48d601644dc98beec4a5ab09df8e80815d0a44",
      "text": "Juru kunci njaga makam.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ae1ecf2cb16dfc42c493fd2a873a2119a7ee9bba287968c605eeb8c58890086",
      "text": "ꦦꦔꦺꦫꦤ꧀ (Pangeran)",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "92669462535de46353147c0979290eb97b1b39f83fafe47cb1c456478b660f57",
      "text": "Mangga, alon-alon kemawon.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "935016feaa4729644f95cd5615a6b11600f3e6a8a65fd9336097e67f9c45819d",
      "text": "ꦯꦸꦭ꧀ꦠꦤ꧀ (Sultan)",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "940847e737a4ee6dabb0fa9967cc90479df10bbd9bb959dede187209f39cff8f",
      "text": "rong ewu rong puluh enem",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d2abf843a06a9fb2849ea55476ef95c8a1700b89580249759512466d6f494b",
      "text": "Gusti, Sultan, Pangeran.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "98523ab6f8e16e6a5d2facee3a028a89ddebfb215a790215dff0f579a0e5efaf",
      "text": "juru kunci",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "99102acd9d9d7162b4bb511e7e1fcaa8df8855a22471ee8faee0a015cf678be0",
      "text": "Sae, Mas. Menika makam Sultan Agung.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "99a926fa12ee550209aae024cf30218d51e1171aae5e345884642be257cb5b31",
      "text": "dzikir",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bd8110bedf9fa6b215b54323eab8be24700cde7f2c61d9a5bf561678cdf2ff5",
      "text": "Sekawan atus sanga! Kathah sanget.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a058c5ccd97d2071f6b979a4dadc2873e8aa1da8bd438b6ab9745b27a405ba6c",
      "text": "tanggal pitulas",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "aedc507cb4faac9ad4790158a177f0bde40d7202b51834d1ff6a492c431070fa",
      "text": "aksara rekan",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7d2881a0efb2768503740b6e33b090cc2d3530299081d8cc545b1eb7ed62bf",
      "text": "Sekawan atus sanga, Mas. Cacahing undhak-undhakan.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b71399897784fe9bd495aae558166352601ad08d92ac92ca5ce94a38eab09be3",
      "text": "tanggal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb9748e94074c27c9ab62f249a66d139f5b2ec2f5b35899472b1c319d2455445",
      "text": "Gusti, fajar, zakat, tanggal pitulas.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "be7ebc3ac84b70c006c82d980aa59b43f7114e1fc55af6ae77ab5ce8cfbc991a",
      "text": "Iku sa murda, kanggo ngurmati Sultan.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0070fb0a413d41aa45b38d49faf17cf2c2550e8d732a1d48b0b16c6dfd22b33",
      "text": "ꦥ꦳ꦗꦂ (fajar)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0453c857be9ba7c51f2fc6c0c5610abd896ecb26a0ba84809cc5c894ae6282f",
      "text": "Pangeran",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6a64a21f4f08bc6a6a50055045cd690c4d387e0fffce6d00d82ced7d9028f6e",
      "text": "pada pangkat",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8d568a8cc5f463d0da80af4b3a729b7d863bd090e5e69746de309936cd4b165",
      "text": "undhak-undhakan",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccfad25487b3e7f5e1ebf1b3945c1a9f8aa990f60a723fa651bcba14c6e5bfa4",
      "text": "Tanggal pitulas, taun rong ewu rong puluh enem.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6adbbd4303b8633b0f45bdc4ccbc84e22f965ddf5413d4d720753a1827f9a27",
      "text": "Pak, kula sampun dumugi ing nginggil!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc5fef209612499d3f4c8b27dabb8a74af69edb8b9398c0f881139bea7e215d7",
      "text": "Fajar, zakat, dzikir, khusus.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcc0b0fa77097d8602a4b52b390a5baf795e37d2481bfb2f2f26aa936c5d52e8",
      "text": "ꦦ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "e108037054d6b82e951c0c79a45affbecc9e6e0e67e7601095619638a24cfcae",
      "text": "ꦓꦸꦱ꧀ꦠꦶ (Gusti)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e99ed88b629b94a48703ba7707337393d799efda1ad7857adac592dc1963b339",
      "text": "Kula juru kunci ing Imogiri, Mas.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9ada5218ba561a58866549fa02a21c7206a5b03b44ed9c01cf3aa11d15cc99f",
      "text": "Inggih, Pak. Menika tulisan menapa?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9dcdd423ee756ff69477b5401ea419b77f1d2f0a227c2d4aa7d79e1498bed66",
      "text": "Sugeng enjing, Mas. Badhe nyekar?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "edd32cfd98eed191979ade216c21882f087c21158d273591e1077a149dd8f270",
      "text": "aksara murda",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f51f2d7b7e465ecd885ececb5f260fe97139cbc9cc65693205ba29f28785c94a",
      "text": "꧇꧑꧗꧇ (17)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    }
  ],
