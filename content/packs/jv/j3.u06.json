      "id": "j3.u06.l08",
      "sha256": "52b4defbd0d80c5ab2035d35583392689e375b96ef6adb19281eb065fd896848"
    },
    {
      "id": "j3.u06.l09",
      "sha256": "bd969fa2fd68aa971bc921d1a27c8855762336eb50e96a62857040e3ccf8b17d"
    },
    {
      "id": "j3.u06.l10",
      "sha256": "56f182c8331ba714f17adaa8c457ddd091bbc7100ad9ec6f56d72550b8729dfa"
    }
  ],
  "audio": [
    {
      "key": "01597cb3caae96baf717bca0cdafa4f8a5ac62c1e1a72fc86e40228883b686d0",
      "text": "Kula saking Kairo. Kula badhe tumbas batik wonten Giriloyo. Reginipun awis, amargi damelipun dangu.",
      "voice": "jv_siti",
      "chars": 99,
      "mime": "audio/mpeg"
    },
    {
      "key": "03a5416cdbba78ea88efc3c7fa1476d11a849162fe76af257adee438a562c788",
      "text": "-aken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "042dd836020af876dbc73f4052866efaadc1c91fa786ba8a1c62dde143aaf80c",
      "text": "Mas Mohamed, batik sampeyan sampun dipuncelup.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "04b3528f0bdb4440d37e77c765eaf9ee6278f33b0c34e5f2c67b77da2f6841c0",
      "text": "Batik menika mboten saged dipuntumbas.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "05fce3b6525c59140ed27da030599dfcb0535ff5031e4935c35b77b97db0989a",
      "text": "Kula mireng swanten gamelan.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "06dfccceae6a6eddcfe0fb3b3edb77e4ce3c9540ced585097e7e5d7938611e82",
      "text": "Inggih, matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "07439fba2917ad4e71041803ecc582f42c4a447c261e91ac10217e944e41876f",
      "text": "Kula ngginakaken canthing, Pak?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "077507c22600e19528e6969f998cb58274ab5b33b64fe21cc0fa54f6bdf9f3fc",
      "text": "juragan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "07d79bdc5c4cf715e134a47ef22f65bb695e4be716d671666ae8af9007315fad",
      "text": "Damelipun dangu. Rumiyin, motifipun dipungambar. Lajeng dipunbatik ngginakaken malam, lajeng dipuncelup.",
      "voice": "jv_siti",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "086cc7218bfa8b271d8b14d3ebaabcb1933eafe9dca544291a2163afcd5def42",
      "text": "ageng",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "08f1c37837f29f1f5ced3864532dfc18db548005fb5c3ba328521def25094ea4",
      "text": "bathi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a2082b63554aa0cdc6ae1f9b1ba4ca53b15a439c5f31322bb628f8f84f679c1",
      "text": "Pak Harjo nerangaken caranipun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b18bde326588bd2f98b2797313a5648e897d06d323411a72a434e169e198d86",
      "text": "Mangga, Mas. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c041c12ddd27b10109b375b6a6e8608e38f8625dccc25b138768d80489d3d9b",
      "text": "Nyuwun sewu, Pak Harjo. Kula badhe sinau damel batik.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c1e9bb07ebb9b8e26bcc51c7d3dabd1ffdcfec504b0cfc3dd1416efffd11d79",
      "text": "Tiyang menika saudagar batik.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d1085688b320edf73afd6749790e761712e545dc3be245e38ee1f341bc9e208",
      "text": "Pak Harjo, griya menika griyanipun sinten?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d667e03cba4f41a23a07e154f664b0df5631c6d29b75626fb856875ebf9b373",
      "text": "mumet",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0def13f136d3f3815f8a80b534b15115471ca48d24baab0a0d7db6509ab49e51",
      "text": "Inggih, leres, Mas!",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0defae2cb7057a4b91f645ef58c198529159eb1f0fe2eb013f6f102357cfca7c",
      "text": "Inggih, leres. Nanging batik mboten saged dipuntumbas wonten mriki.",
      "voice": "jv_dimas",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f1ab6e4d34d0a62ce70b20c3e3120b2fce290ead6305c4ab2e0f5b468427855",
      "text": "Inggih. Canthing lan malam saking kula.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "108f34fc1699d0391c6aec2da5e1121f9cd4f81343d1ab6ac7aa32f739439e05",
      "text": "Wonten. Panjenengan mireng swanten menika?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "10a0a8d9f04f4b494aa4dbf22d1ce2907b5d071c8129fd8470db9554aedc0e6a",
      "text": "Mumet? Lumrah, Mas! Ngaso rumiyin.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "112da1145e9a2f6194f4b84db194de0bb8a2a135f498f8b9ffb70cf3a467bca8",
      "text": "leres",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1167a36f227e7812ead07a7de0874ddf281966999d891cee9b33a2d790b41cfc",
      "text": "lumrah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "11a68272e37d9e5baa86ba8123a816690b2964b7788a816cacaac5f62193d19b",
      "text": "Kula mireng swanten gamelan saking griya Pak Harjo.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "11cd2d9e841756965d4c56c4732e31abee98c83998b288e3bf2b7591c1ec01cf",
      "text": "Pak Harjo nyambut damel wonten Giriloyo.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "159146a9e7e568202c687b85dee8786ee7a2c754e959d0065b4e960c080592ec",
      "text": "tiyang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "16ee3a6a405038fd03ec122ec8041c9ca099f095e9645f498bd7ea0b2674c318",
      "text": "njajal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1834a2b2ec5bacd870674487f238dc81c979a92ddffc8e6c45e2c0fbae0f1456",
      "text": "canthing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "18fa0c7492ea69ba389a64cf55e0e2c91364ff001bc2b8b674d8bde54cc32d39",
      "text": "Mangga dhateng griya kula. Kula damelaken teh.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a898936d669edbb1d411bb71a229e6c4131db1074e863bbb64c366c41fc07cd",
      "text": "Oh, inggih. Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b126a03b496afb0bfe2eb4128af1870bd0678b9bf130fdccc832b972eec2762",
      "text": "Griya menika griyanipun saudagar batik.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b17b2ff6eda1fa295dedffd9d117a0cd560a3af16789f5783f700559b7d5510",
      "text": "Batikipun sae sanget.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dd30f74d2ccdf0b1c7fa4db5837d7fe27d25e384999a67f7b99c463b972d17a",
      "text": "Rumiyin, motifipun dipungambar wonten kain.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1efe23e2429fc9a9aab327cbc15e3a20829dabafd141e7840b082090fe77cbe0",
      "text": "Inggih, Pak. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d6858a9cf2aef29bbc587984b5aac1fc445f16056b290e400739011c89cbee",
      "text": "rejeki",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2439face2f925e5c1a1f181691c7dc3637ab9be84ae8f7170b2849d713c9e5d6",
      "text": "Kangge ibu kula wonten Kairo.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2695f8dbaebf0c9ea2c7ebc9e815329d0437f934d1570954b0110ccbc57593b9",
      "text": "ngginakaken",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "293b8d9a0454cf7b60cc129effe71d1305074acb836bf75314a67bb32ffffceb",
      "text": "Mangga dipunjajal, Mas!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2afe3c54f0b1feb8aa02334c6dd223bc0bd8be422531cba5e806c7a8cd240908",
      "text": "ngaso",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "361c49c345fd216aa6f52a52aec3c527939582b36877df2d6aaf56abdbc60008",
      "text": "Kula tumbasaken batik kangge ibu kula.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "364b15ce7b0bfc8ae3d9427788efcf236686690ad8af8898d4fa820227ec7986",
      "text": "Sinau damel batik tulis wonten Giriloyo!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "378455c073e2e56e52fc425c740590810301b69f4446109cab0b725b20e528d5",
      "text": "Sekar lan ron. Mangke kainipun dipunpepe ngantos garing.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "37bcfe24b0410b5a69080639f2f59ae663196ced38b0b0a0f47dd2a4b7c843a4",
      "text": "Nyambut gawe (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be78b9a24bc846dcb22e414808fa6cf04dc68bbe07920d326b3846e1fd34a7d",
      "text": "Untung kula pinanggih panjenengan. Kula sida tumbas batik tulis setunggal.",
      "voice": "jv_dimas",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ee207297abe1455d84332e9fa222f59c8db98c54a46b0f5495b553d7b9e9b8b",
      "text": "tumbasaken",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "400c02c6ca7f0553d04df9e7c8e1d6254f94690595843c0ceb5aef742241add9",
      "text": "Bukunipun sampun dipunwaos.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "40ef2915eae547f2ec3f4d691346a4023854d370f56cbc08cb31c6b8d51ad300",
      "text": "Motifipun menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "41d64e63e25b0dff2942d2be7981abf0842cf4ce0deca948f4ea6fec6ca070a0",
      "text": "Bukunipun sampun kula waos.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "443e8ef8f25796956a59330af2883ec5ede5a1015e1792635d35febed021d9e4",
      "text": "swanten",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "449f89474d02622d201bda9747d956ab568b032dad6250952f61bcc96ce79170",
      "text": "mireng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "452670e28388277823fddbc4ce29f8343e79bcab225a2116345701ac10741560",
      "text": "sewulan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "458dfc007d988e0bb420111b5108bd06890ba2f980075f88aa42fef13405085a",
      "text": "Griyanipun ageng sanget.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "49928374da429ce3046ec4310299a5dd92d2c62910e217a2b1f2305b163fc471",
      "text": "Batikipun dipundamel wonten griya menika.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "499d79842fdb4854513ccdd916987095327e93eee6b829c61bb22097cdc0b5b5",
      "text": "untung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bc8917bd10aa61b0ee3ec6b85676cc7c5cf88476a60b8c82f152489120f04d4",
      "text": "Mangga, Mas, mangga.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bf25ab361d56783695a9105b7df170fe78c8a68f5d8df7e230055dfe9de3921",
      "text": "Untung, kula sida tumbas batik wingi.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cdf131556c5f940e6b46f0205671f32546294dabf998609eea8504f9db553be",
      "text": "Sae sanget! Kula tumbasaken setunggal kangge ibu kula.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "50b6573e36251a06e93d92a6ced2c92faccc275077f24cb338b19edbdcdc68d7",
      "text": "Batikipun dipundamel wonten Giriloyo.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f0f3c0be54babb9bc7e7f9b1188cd6fa65f73d1841daa6286dd09449292fa0",
      "text": "Leres, griyanipun saudagar menika ageng sanget.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "537cc635d71de006f5c5a99680defcef513f802d2a6fce41b5e4585817878fd7",
      "text": "Batik tulis saged sewulan.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5479852539aead7d637b5fdac85ad1af42f924d1ed17b41fa4585dd54aca3266",
      "text": "Reginipun awis, amargi damelipun dangu.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "55e016fb665ae3eaf5d2b1e9fa09fc8e50b52ea3b5c7af89b5d64c41c10ac506",
      "text": "Batik tulis dipundamel ngginakaken canthing.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5654e85c8f5ba9370c706a43e1a3cfb3ab0bdbc8c360ba09610c178209a906ba",
      "text": "Modal alit, bathi kathah.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a59693a47f83078a28a642ea0410fdb4b7f2acb890660cf4bd00bad67aed959",
      "text": "Lajeng kainipun dipuncelup.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e71034448a28a7d6f05c085f963f6cb66709b648767210b9dff2ce7c5806d7b",
      "text": "Inggih, Mas. Menika griya saudagar batik.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ea380fa8f9827e4029ae68f57726a2f884ee622fd34312077587da86e886d4a",
      "text": "Wah, awrat, Pak! Kula dereng saged.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f53f1688b501124709840c2d3b637f719fe3d3d0f899da4537fd462bc93e567",
      "text": "Malam menika lilin kangge batik, Mas. Lajeng kainipun dipuncelup.",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "62ab8ffe55f5268933b371ba77a96631aef0c8b14db55520b9130a510799ab4d",
      "text": "tlaten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "69fcb475b148f09f78ddba992fa65f7c3fb950246ed4d36e19a75bf125c60e67",
      "text": "Mohamed, mangga dipunjajal ngangge canthing.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac264789d4f5bf23f900a49bf2f46cd06ae22626c1ed311c3ff84e795a53270",
      "text": "Alon-alon kemawon. Damel batik kedah tlaten.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae1af719793e27de8c7c73add2a28b724a6149f4d8624a5b7b98d567c3a72fc",
      "text": "damel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d7642ce49a27dfa1c28d8e61bddd05ca2885b85e5bc694244593215f1c42f3f",
      "text": "Sae sanget. Batikipun dipundamel wonten Giriloyo, kangge ibu saking Mesir!",
      "voice": "jv_dimas",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9f59f96f85205220c5b14e71cf6651a48f36053d22b3086d7b0132a8d81300",
      "text": "Reginipun satus ewu. Canthing lan malam saking Pak Harjo.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e8acb7bf212d270d1cd9d1dd78c5d2f3e9981e6e095d36631ea51c44bf35cfd",
      "text": "Damelipun dangu, saged sewulan.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ea4480ebb586aa7357c30985895063dd08e43f8bdb031fc06a2b117ce73380a",
      "text": "Swara (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f9c72b7719ce562b497d08b6ab70a30ad6164d9ab7779b64705eec50d395ed8",
      "text": "Pak Harjo badhe nerangaken caranipun.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fc9d19aa06555cd06e5120070fafc94d5b81c0f8db8eeb0cd98fed429037a0b",
      "text": "Pak Harjo nerangaken caranipun damel batik.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "71418d799b3ba50f011b026cdce120ea66af08db3090713099ba9aae34da4648",
      "text": "Mas, saged tumbasaken teh?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "714ea73eea4af5f1fda98fd10293d5342efd9ec0dc17ff547492d91e6f820470",
      "text": "wekdal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "71b3d5ccecf7c5730ccdde5eeef118a97eee78fb27f70f2847f316de8d5b02c5",
      "text": "Kainipun sampun garing.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "736b391038868c5978a4dfbc2027a7eecf39bd6e2fc2dc5e090d58c4f37565e7",
      "text": "modal",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "787591132510b9abe7f44469bb1e282eda3ad1d40d76a329e9a61f01a6ccdc9b",
      "text": "kain",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b8ddf3330b0cfcd71fd9590deac2273452f475d4f4450b35ec38bc263e691cf",
      "text": "Lumrah, Mas. Mangga ngaso sekedhap.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c86b27b160290f551b7e3c7358f23ece32a5a35d8f8f8e9cb4731c55ce726be",
      "text": "waos",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dbf1f8855530b0a369ba5d298d75bb378a72b1aef4bdb724a11581268256660",
      "text": "Batikipun sae sanget! Matur nuwun, Pak.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dc1e382e3723a4a0932eb76d741d5c9665b4ba23298b79fb734b35963797b5b",
      "text": "Mangga ngaso sekedhap, Mas.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ec89844e8d6776b44923f9990917565c497aaabd9fa884cbb7daf7d4f61e74c",
      "text": "Nyuwun sewu, Pak Harjo. Batikipun sae sanget!",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f689df7838cc720c9fe9aba737554a55c0eebb0c324924d337f5307980e929f",
      "text": "Kula damelaken teh, nggih, Pak?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "818e6c0e109daf4f7b2acc8ad3997184bdf4b330015736ed5f85d21b0253a8de",
      "text": "Pak Harjo ___ malam kangge batik.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "85545c6f7ce149539da64c0e5add9fae60593aeff52227b4ba717450b4f3ea93",
      "text": "Mas Mohamed, kula damelaken teh, nggih?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab0baa1d9b869bc4a0879de87630ce2ed0b78fc3af18480c7ac66999d613818",
      "text": "Rumiyin, motifipun dipungambar wonten kain.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ccf3bb9d10ea92bcf1925f492a9d1fbca4a985da30716fd33fe9dc6c7c7f122",
      "text": "damelaken",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cdfa0f56f49fe95ae205422635f29939b4b23ccf48cf6f97f5aa0a454db6d79",
      "text": "Saudagar menika tiyang dagang, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d8ed44f8ec6262d337b87caa126c0ed4af1101ba4e72b15a1f059243d891252",
      "text": "Kula sinau ngantos sonten, lajeng mumet.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ed6be00845f4826bf4cfbdda82384411580a8400f8f9963532dc3d8ec768691",
      "text": "Griyanipun saudagar batik, Mas.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8268e25d7ea749107f9a996d33da82501f2fa6d9921e6450995b7e46a5a8fa",
      "text": "Wah, sampun dipuncelup! Sae sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9497a45fa2167b9650a2ab1406a439dbc27297ffafcc904d00460d0deb4e8594",
      "text": "Damelipun dangu.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d2e6d1975c46446a93bfbfa8cb93843e861ba8a78f423985cf992dc127b268",
      "text": "ngantos",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "96d3e0f53617ee84cb21e956ece1a12d962047a633c3c4ba45bfafcc9cb1e5a7",
      "text": "sekedhap",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "99a7e70ff6677a141d5eec5460ad14fd3916bad2de933cf0526b2e2f10c1a74f",
      "text": "sida",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b0c6f9c130a4c2bc93c6fb1ff71b36b92dcf8d198a507675ba5bcf5395a3a5f",
      "text": "pegawe",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2cd908bcaf73734bef60b67483c4a1c386e86e701e862a22bb3ea9e782a7000",
      "text": "saudagar",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f9973366070763d0e916fc200ff3aed7f93dc9967dfa4f321c87f3311a2767",
      "text": "Sami-sami, Mas Mohamed.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a684b926e8e5f47db5003647f4bffdad6674ea0d0d2b408a02b1a23da604d395",
      "text": "Krungu (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8250eafa15ccf04a58a0119e350dbe41586f31c328f84f33770a57402eb0d0e",
      "text": "Pak, panjenengan juragan batik?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa68e1dcbb9961539e8d6c0cf163aae5a1a65cdf87c754d219acd4ba4a3527c3",
      "text": "garing",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab11124465848cfdfbb7d08242f7d361ba48eec06a1c346285965d97a35d6471",
      "text": "Pegawenipun kathah, sedaya nyambut damel wonten griya.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad046d758598ead5f1638528b2cfc405799ab10965b67d1ed8c1f952f2bd2dc0",
      "text": "Sae, Mas. Batik menika kangge sinten?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad901c00da94ff692d5c46f5eb929b08da4a3e2afe0f9ad0f70d314b5e49bc5a",
      "text": "Mangga, kita mireng gamelan rumiyin.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "adaaaeed42a97a9aaabb9c5a9699bebd297925b3989a3a7d7578630582b082d0",
      "text": "Matur nuwun, Mas. Batik menika dipundamel wonten griya kula.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b09c735df061a890cdf05c69c56fc136e080e28fffcbfc03bbf2274c00fe1721",
      "text": "Mangga, Mas! Reginipun satus ewu.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26d9b31abd07df69f0ca52372398107865ed97ea11b856f2a899cb7962f91aa",
      "text": "Kula ngginakaken canthing kangge damel batik.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b323724ee90eb87ee64dda1f0fc215f225756d67bb376f364e0e0d6d7cb7f1ad",
      "text": "Pak, batik tulis dipundamel kados pundi?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3fa9801f23505298ae3a14f40f2f6fe179f666d620e3d7f4d6f3d780911c406",
      "text": "caranipun",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b55b740447957ca12ef3107a2811dc6c3b4860f66f00d4954fc828c4af3ddeb1",
      "text": "Motif sekar lan wit endah sanget.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b794454bdb6c1c09ac6850b3de14d522952a4ec3b96722bd9d9f6d3f434c6559",
      "text": "-ipun / -nipun",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b84eebdf912a9dcc83dd61017bf0e3a61082dae543910cbe548e107c58d6828a",
      "text": "celup",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8c7890c4299a644a22c9116b88d027b231b0254db9963d29fcc5835140a0483",
      "text": "jembar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b94269523e412ac9b67bdbb7e1057f2ba462a1471fef4b08ca0fcde7bda0a91b",
      "text": "Damelipun dangu, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9dd40310ecaa562249be1fc7a905359400b945bb4cd6f11ac7870750888e9de",
      "text": "Inggih. Pegawe kula sedasa, sedaya nyambut damel wonten mriki.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf6421eb54df7649bc4d81e070842f9e0fa962e0a0813d7176d329960fd4da37",
      "text": "Batikipun dipundamel wonten mriki?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0093644fb5638849919e4162cb2f4bd663492fdde8ff1210e7de54b9e559cc7",
      "text": "Pak Harjo, batikipun sampun kula tumbas.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1d24fcc831923773adc5dfab5fddca7f55362418706581d9fd28edc90a9e6bb",
      "text": "Batikipun sae.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c253f2df1f7da16f077b3aab6cfbdee0b56b299425cc750a3fad188dc30f90fa",
      "text": "malam",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c407ea2972bc374654a5d08cf645f126b232dc204b487dbf70f70e7ab84f1ce3",
      "text": "Matur nuwun, Mas. Mangga dipunpilih.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c458f2be8c2697f8236be6030324e74263fcbb432a9cebae32268c5db2bcc12a",
      "text": "Batikipun sae sanget, Mas.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c46f9ddac6fb5e8f4e9791e7927660ee92f76e078da1bdb9af24f1de7cf4b566",
      "text": "warisan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca22748c39ac29a9c656b8c49030bb493888ad0bfeebf0e9c87a5a743974786b",
      "text": "Pak Harjo ngolah malam, lajeng nggambar sekar.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d30e00b8695d0060f965bf1c8a4ce2c5a639a5d7ebf0ec6f91046b94c09ba6b1",
      "text": "Inggih. Kula damelaken teh, nggih?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4a6c8cf740d4490f6ad15e5a650d382d62f4e66598b2c9e78b2b36f72b199fc",
      "text": "nerangaken",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d79ef653df6a2d457796ad289810c08f63aa39e749e24dd60c70415093a20005",
      "text": "Nyuwun sewu, batik mboten saged dipuntumbas wonten mriki.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e2bac1cdac63ab45cbe3de4ee85adf8df23feb03dc5af1e4201969fb5e52ef",
      "text": "Damel batik tulis kedah tlaten.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9f4531dfac2ac8cbf8484f6c751a64b38e8adfcfe01f9376a195dab7563bca6",
      "text": "Sida tumbas, Mas?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "da9e28f1bba31f38dc199c185d16eae16b08e4a542336c9e7a85681c0e6a66a3",
      "text": "Inggih, swanten gamelan! Endah sanget.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "debe43bbe6c1fb48d052ca4c1760e241eb4d5d458ae3078f5c08efadc28b93ac",
      "text": "Kembang (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1778627f4ffe4e1b478e6b399651e542c6343f95c8e2bbd0f13b0b19dc37fb0",
      "text": "Inggih, dangu. Batik tulis saged sewulan.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5f11f4bf605ba8f416cd1a79539abf21c602c589510f56808a3dd9abb4a3373",
      "text": "Batik tulis menika dipundamel ngginakaken canthing.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e97de0fbc62a6e2a9c2cbf0202ac7d3d121b37f8e7b012cd557f013d93d288f1",
      "text": "Lajeng dipunbatik ngginakaken canthing lan malam.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9977ba0d96e8c8015847a801bbee09ddb17f169f1f8f11929ee8d2f6d618a5a",
      "text": "sekar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea69ffb7aeef68489fe53e54b2e37a2ae7b4f8f9c97ae884fb56b56b3133c660",
      "text": "Kain menika kandel, mboten tipis.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb3b81e208d4a75c9a6ffc972af797764bcc9ec6a68570a870207492b6dbb2e8",
      "text": "nyambut damel",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec339f91078ee02a11b497438260ba4f9b2b418cbd9b24806dc2be53e80b681b",
      "text": "Rumiyin alit sanget. Alhamdulillah, rejekinipun sae.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f059db686077d7a078829a55f70394d3298bd590b081eb4ef1544fe4c84e2493",
      "text": "Matur nuwun sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0a26bd64daa4b78c2cdd86ae09def4da2b2401b269427c43496ed0ffd5b4f2e",
      "text": "Griyanipun ageng sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
