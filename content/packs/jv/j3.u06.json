  "audio": [
    {
      "key": "03a5416cdbba78ea88efc3c7fa1476d11a849162fe76af257adee438a562c788",
      "text": "-aken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "06dfccceae6a6eddcfe0fb3b3edb77e4ce3c9540ced585097e7e5d7938611e82",
      "text": "Inggih, matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "086cc7218bfa8b271d8b14d3ebaabcb1933eafe9dca544291a2163afcd5def42",
      "text": "ageng",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b18bde326588bd2f98b2797313a5648e897d06d323411a72a434e169e198d86",
      "text": "Mangga, Mas. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b4e34c9769fc37312e25d10422ad896b66afadde1add4ec0e6d1665b3d39cbe",
      "text": "amargi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0def13f136d3f3815f8a80b534b15115471ca48d24baab0a0d7db6509ab49e51",
      "text": "Inggih, leres, Mas!",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed6d280754833c18e9886ea38fcf13f03c2d7da517721c1cc26175dcc394750",
      "text": "Rumiyin, motifipun dipungambar. Lajeng dipunbatik, lajeng dipuncelup.",
      "voice": "jv_siti",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "112da1145e9a2f6194f4b84db194de0bb8a2a135f498f8b9ffb70cf3a467bca8",
      "text": "leres",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "12b5d8b669aa78c80b77a75b1d47fefaf5b18f7237c616f2099525c4642166e0",
      "text": "Batikipun dipundamel wonten Laweyan.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "159146a9e7e568202c687b85dee8786ee7a2c754e959d0065b4e960c080592ec",
      "text": "tiyang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "183457b2efe15054bbc3c14f8f062173361aa31bc362b2c867f57fb56fd30807",
      "text": "Griyanipun Pak Harjo ageng sanget.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1834a2b2ec5bacd870674487f238dc81c979a92ddffc8e6c45e2c0fbae0f1456",
      "text": "canthing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dd30f74d2ccdf0b1c7fa4db5837d7fe27d25e384999a67f7b99c463b972d17a",
      "text": "Rumiyin, motifipun dipungambar wonten kain.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1efe23e2429fc9a9aab327cbc15e3a20829dabafd141e7840b082090fe77cbe0",
      "text": "Inggih, Pak. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "231e3ad7690520882d57e6d7a672c9696be36d05838f97dcefa2affcdce48a46",
      "text": "motif",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2439face2f925e5c1a1f181691c7dc3637ab9be84ae8f7170b2849d713c9e5d6",
      "text": "Kangge ibu kula wonten Kairo.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2695f8dbaebf0c9ea2c7ebc9e815329d0437f934d1570954b0110ccbc57593b9",
      "text": "ngginakaken",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "361c49c345fd216aa6f52a52aec3c527939582b36877df2d6aaf56abdbc60008",
      "text": "Kula tumbasaken batik kangge ibu kula.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ee207297abe1455d84332e9fa222f59c8db98c54a46b0f5495b553d7b9e9b8b",
      "text": "tumbasaken",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "400c02c6ca7f0553d04df9e7c8e1d6254f94690595843c0ceb5aef742241add9",
      "text": "Bukunipun sampun dipunwaos.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "41d64e63e25b0dff2942d2be7981abf0842cf4ce0deca948f4ea6fec6ca070a0",
      "text": "Bukunipun sampun kula waos.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "452670e28388277823fddbc4ce29f8343e79bcab225a2116345701ac10741560",
      "text": "sewulan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "458dfc007d988e0bb420111b5108bd06890ba2f980075f88aa42fef13405085a",
      "text": "Griyanipun ageng sanget.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "46392869f7fbca2d4828eeb8253bd5df777dbcc8493bce825ed200a0f57b94c4",
      "text": "Saé sanget. Batikipun dipundamel wonten Laweyan, kangge ibu saking Mesir!",
      "voice": "jv_dimas",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "5065065aa91130ce36d6b6d494876dad11f00cf25ad2957f38f355584e2bc412",
      "text": "Kula tumbasaken batik.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "52c3f104d36a9e3107b4e865ed5763e830cb82c2fb8f6933aaa9512c4421c969",
      "text": "Matur nuwun, Pak. Batik tulis dipundamel kados pundi?",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "537cc635d71de006f5c5a99680defcef513f802d2a6fce41b5e4585817878fd7",
      "text": "Batik tulis saged sewulan.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5479852539aead7d637b5fdac85ad1af42f924d1ed17b41fa4585dd54aca3266",
      "text": "Reginipun awis, amargi damelipun dangu.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "55e016fb665ae3eaf5d2b1e9fa09fc8e50b52ea3b5c7af89b5d64c41c10ac506",
      "text": "Batik tulis dipundamel ngginakaken canthing.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a59693a47f83078a28a642ea0410fdb4b7f2acb890660cf4bd00bad67aed959",
      "text": "Lajeng kainipun dipuncelup.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b15f1491143f27bb4ca867c9f0baa51b6885fb297fe8cd159fa129328dc34d8",
      "text": "Kula saking Kairo. Kula badhé tumbas batik wonten Laweyan.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e71034448a28a7d6f05c085f963f6cb66709b648767210b9dff2ce7c5806d7b",
      "text": "Inggih, Mas. Menika griya saudagar batik.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f53f1688b501124709840c2d3b637f719fe3d3d0f899da4537fd462bc93e567",
      "text": "Malam menika lilin kangge batik, Mas. Lajeng kainipun dipuncelup.",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae1af719793e27de8c7c73add2a28b724a6149f4d8624a5b7b98d567c3a72fc",
      "text": "damel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fc9d19aa06555cd06e5120070fafc94d5b81c0f8db8eeb0cd98fed429037a0b",
      "text": "Pak Harjo nerangaken caranipun damel batik.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "787591132510b9abe7f44469bb1e282eda3ad1d40d76a329e9a61f01a6ccdc9b",
      "text": "kain",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c86b27b160290f551b7e3c7358f23ece32a5a35d8f8f8e9cb4731c55ce726be",
      "text": "waos",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e6a9ec3d13e2b5f7dae50a255a1a10c92294d1fdef304f806f4a3a1c5bd0b23",
      "text": "Nyuwun sewu, Pak Harjo. Batikipun saé sanget!",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f689df7838cc720c9fe9aba737554a55c0eebb0c324924d337f5307980e929f",
      "text": "Kula damelaken teh, nggih, Pak?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "85545c6f7ce149539da64c0e5add9fae60593aeff52227b4ba717450b4f3ea93",
      "text": "Mas Mohamed, kula damelaken teh, nggih?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab0baa1d9b869bc4a0879de87630ce2ed0b78fc3af18480c7ac66999d613818",
      "text": "Rumiyin, motifipun dipungambar wonten kain.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c225663f5396d27605a7e5f7b5143d2d5503dae06e9833310de8d1ecfb9bddc",
      "text": "Mangga, Mas Mohamed. Menika papan damel batik.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ccf3bb9d10ea92bcf1925f492a9d1fbca4a985da30716fd33fe9dc6c7c7f122",
      "text": "damelaken",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cdfa0f56f49fe95ae205422635f29939b4b23ccf48cf6f97f5aa0a454db6d79",
      "text": "Saudagar menika tiyang dagang, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f55991ee4d1113a290199fb4f3790d3a817a0b50b53a9e84ba25ae8e83e2cd3",
      "text": "Saé sanget! Kula tumbasaken setunggal kangge ibu kula.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f839043e67e4ddf8c3cf6dc41504abbdd96bedd8bb16839930cf7ba3e94c034",
      "text": "Saé, Mas. Batik menika kangge sinten?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "935bb511a7df90ce2ecdeeeff7dd9e876b5c9bf097ebaeb7ff7b7e91d16f963c",
      "text": "Malam menika menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "9497a45fa2167b9650a2ab1406a439dbc27297ffafcc904d00460d0deb4e8594",
      "text": "Damelipun dangu.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2cd908bcaf73734bef60b67483c4a1c386e86e701e862a22bb3ea9e782a7000",
      "text": "saudagar",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f9973366070763d0e916fc200ff3aed7f93dc9967dfa4f321c87f3311a2767",
      "text": "Sami-sami, Mas Mohamed.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "adaaaeed42a97a9aaabb9c5a9699bebd297925b3989a3a7d7578630582b082d0",
      "text": "Matur nuwun, Mas. Batik menika dipundamel wonten griya kula.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3fa9801f23505298ae3a14f40f2f6fe179f666d620e3d7f4d6f3d780911c406",
      "text": "caranipun",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b683e6e14cc811ff67205e3eb5028b0b5a7d93e77c17b2f15a07f171c99eab42",
      "text": "Mas Dimas, saged tumbasaken teh?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b794454bdb6c1c09ac6850b3de14d522952a4ec3b96722bd9d9f6d3f434c6559",
      "text": "-ipun / -nipun",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b84eebdf912a9dcc83dd61017bf0e3a61082dae543910cbe548e107c58d6828a",
      "text": "celup",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b94269523e412ac9b67bdbb7e1057f2ba462a1471fef4b08ca0fcde7bda0a91b",
      "text": "Damelipun dangu, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0093644fb5638849919e4162cb2f4bd663492fdde8ff1210e7de54b9e559cc7",
      "text": "Pak Harjo, batikipun sampun kula tumbas.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c253f2df1f7da16f077b3aab6cfbdee0b56b299425cc750a3fad188dc30f90fa",
      "text": "malam",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4a6c8cf740d4490f6ad15e5a650d382d62f4e66598b2c9e78b2b36f72b199fc",
      "text": "nerangaken",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "de03dc7ac9dc02221e56bdc3daa86ec2fa9f502b37bc9fa5925f664cb1c40115",
      "text": "teh",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1778627f4ffe4e1b478e6b399651e542c6343f95c8e2bbd0f13b0b19dc37fb0",
      "text": "Inggih, dangu. Batik tulis saged sewulan.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5780c8ce681db5f7aec8152d61b659ab0d6cc82d52d4e3bc412c255fcdca436",
      "text": "pantes",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5f11f4bf605ba8f416cd1a79539abf21c602c589510f56808a3dd9abb4a3373",
      "text": "Batik tulis menika dipundamel ngginakaken canthing.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e94902a0d51e54ae6d7ee8a3446dca81b318492f56e13a403fb943cf3a5a51af",
      "text": "Batikipun saé.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e97de0fbc62a6e2a9c2cbf0202ac7d3d121b37f8e7b012cd557f013d93d288f1",
      "text": "Lajeng dipunbatik ngginakaken canthing lan malam.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0849a80fc16aec9e93d25ecb2997fb2917875899fb2930d2cf304d0729cf989",
      "text": "Kula saking Kairo. Kula badhé tumbas batik wonten Laweyan. Reginipun awis, amargi damelipun dangu.",
      "voice": "jv_siti",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0a26bd64daa4b78c2cdd86ae09def4da2b2401b269427c43496ed0ffd5b4f2e",
      "text": "Griyanipun ageng sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4efc66df50d60cf37205eab818f18d2090f65c0d2b3adc4ca49ae51ce06d630",
      "text": "Pantes awis! Kula tumbasaken setunggal kangge ibu kula.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc4121760e58871cc6c9f20e9f40b30f7855200d65bb669f85d986d77648d759",
      "text": "rumiyin",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fccf055ff81927fae8890e001ac93a63d20cd3f091a343c25cd5316a0253d636",
      "text": "Pripun kabaripun?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe45f818c0be4ff691f9c99ebb2fc533b59dbd80b161c06c227cd239aedfc379",
      "text": "dangu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
