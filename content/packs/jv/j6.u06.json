    },
    {
      "key": "fd0a62551cdab2146ef9bb7dea7df7362b46de83e3d6e205888149a07a5ccb02",
      "text": "Kersa sanget, Gus!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdf9e76a57240aff25b61c5b2b567338f73be4fa9a2d6f8795d8c51ecac696cc",
      "text": "Jenengmu ditulis Arab, ya. محمد!",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe5c3e2ae58e89dfa17f82edeee2c087fc95712796f06bf6fcb79447691b17eb",
      "text": "Amin. Aksara Jawa lan Pegon, kula remen sedaya!",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff95dc03633fc3d26b8559a1162a7fe0603d063e0e8deb6e30016dd2270e1eee",
      "text": "Mas, sadurunge Asar, ayo wudhu dhisik.",
