      "text": "تاهو · سوسو (tahu · susu)",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb8fc1a08fc88c0bff5e8c1a0934ceea0d48a85684bf4505a37b0d68e64c7110",
      "text": "omah · ꦲꦺꦴꦩꦃ · اوماه",
      "voice": "jv_siti",
