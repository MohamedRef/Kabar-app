    },
    {
      "id": "j6.u06.l12",
      "sha256": "dcf02be117802be074c9665f0cb73a0ef8a033e2239af6ef13dbb0c0bd3780f0"
    },
    {
      "id": "j6.u06.l13",
      "sha256": "e3942be4d2e44b6f6598befb225b4a1d0fb5714454407c4ca3fe95c99da896a7"
    }
  ],
  "audio": [
    {
      "key": "006030be75b5d3d82b6ae910a76b90c25a29c2f4e0f237e0c91e95e723b2553a",
      "text": "Med, iki pesantrene kancaku ing Plered.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "00b0ba43600bf028b483f3228ab4d2fbe6029fb8e073b8040c3190d95d2997c8",
      "text": "اوياه · روتي (uyah · roti)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "00cb81178db8cd569d889d689017687689c0b4a0a1a10723b13388e4d089dec6",
      "text": "اجا رامي ايڠ مسجد. (Aja rame ing masjid.)",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "047dbcc97a6950698fba25aeef6ca9f271e0787e2c10f474213a0b4875fa892d",
      "text": "Ayo nguri-uri kabudayan Jawa supados lestari.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "07f78ae971f108aae6be8e7682e45eb4e642daace1acda14915a6195e811fa0a",
      "text": "Utawi menika tandha mubtada, nggih?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "08875a02dbc75e1d0e0481aa13333bf24607fc7e56b4a422751de18c0b4ba47e",
      "text": "Kados nahwu ing Mesir, nanging basa Jawa!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "091a7310371b430498c8805c84d79a8f9b01cfe4ffd26542bcec2f22e5af2ec0",
      "text": "ڮولا (gula) · ݢولا",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "096b7401ab3b7b231717b0cf36f63c10fec1720149a89b618d64bc43ad556df9",
      "text": "Mas, menika makna gandul. Tegesipun dipun serat ing ngandhap.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a95c1c36ca495ed5b0b67065c0af2b458a505569a975c57de8907afe1e93657",
      "text": "pisungsung",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ad7be6aab06ff7b9944aaceb3687ca05e052227aa534914de8cb86005d6c292",
      "text": "sorogan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ad7d5521b0ac6455972acc2c1b7a4deb069906409dc42557944ac21f6dedcfa",
      "text": "كاڠڮو ساكابيهي سانتري (kanggo sakabehe santri)",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ddddb9dd823c90a6c246e8cd242bb862c3b18f9c66a79e473bb2bed50dadd54",
      "text": "Iya. Aku wis maca aturan ing tembok.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "155f5399a1124881be71c0c9c1e1e6c38d0bb4e51f1554f17d9430c7ebbd248f",
      "text": "Matur nuwun, Gus. Santri-santri sami wonten pundi?",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "174e238b0742e5705f9541da211b254fb67b0e6ed37f14057ccf3e24e251c38d",
      "text": "Ayo mrene, gawa kitabmu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "177209394bffa40e706859fafd2083918a1924cb1a91b2ef26632b93b8a04002",
      "text": "Ing bandongan, santri nulis makna gandul.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1922b33128966588cab11acb9c50e6d2ae1d2e7115e62ccbb3d960ac6bacd204",
      "text": "santri",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "197df7987d142b8424ce19bc0d9d0f29b588bf1bec46ea470ede2c5fdd0d9d8b",
      "text": "bandongan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1aefc6b5289367a53e3df59fe9266e59c5172fa540daa7d697e186cda810bedb",
      "text": "Iya, lan jenengmu uga, علي. Ayo ngaji!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c17de23e6e0611e7d7bbffe331c6c1c2d10def7ef2212407d45fa22a68d0f5b",
      "text": "dhadha",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd6149e08c98002743176cab01fccbac9f2a7b423b964468b0a1b6756c40938",
      "text": "ڮ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "21c129f8e8edcf27daeff976e60bac972bb3a562844b3a3f7586c07c8b7a8c92",
      "text": "Pepeling kula: nguri-uri kabudayan menika kewajiban kita sedaya.",
      "voice": "jv_dimas",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2215cb8d313d910516c45646ee871a554162bcdaa4636674a7acf98c6fde111f",
      "text": "kenang-kenangan",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "22520806503de00dbc6084098b7ce25e788b7396ea5b2708fab70ec9e94cd2e8",
      "text": "Kula saged maos sekedhik, Gus!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "26bea24c507451d3660481cd569c23cbe2ca00f8a0d50b90a79cf7da0ebf609c",
      "text": "Kluwakipun seprapat kilo, nggih.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2890a9c206ec7afd831b0dcf34dbbcb981c759708a9b8ecf5f35306d49fe25a8",
      "text": "Leres! Lan iku tandha khabar.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d1a5b89aa7f2ae6e187dd11c2702d56b0ab2322e00d16995e1c292cd9817f1",
      "text": "pondok",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b7a4c32017d74b3a6cc17d651d28e2700057648c4ef2553738313b70d486794",
      "text": "ايكو (iku)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b8a6983300a4a9ada8f2733bfd74cd9d945ac0be58f080980a257ba3406cb20",
      "text": "العلم نور — اوتاوي ilmu ايكو cahya",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2deea7c99503f60a49772ac58739859ae82444fa20e40739a9a65428da3b4193",
      "text": "utawi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3192aa121d25c3cda96b65b61daf97efe1c72b90f05c5aaa89d55391c8243277",
      "text": "Mas Mohamed, sampun maos papan menika?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "33d296cb244266b15be135e879f7c2e4b435ada2ddc441b10e2c970f3774ef04",
      "text": "Kabeh nganggo Pegon. Isa maca?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "35b401d17d9d957587cadc407abd69c3cf6af0030029fc68b0d55d18bc135b49",
      "text": "Wah, cathetanipun ngangge Pegon, nggih?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "362c1c65a82cca676a9829ed74d8a97f491d9d5da4bc4df1e0d6951989b089f6",
      "text": "agama",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "37aa175ab33ad54a55bed14a0cc81eb032194ac29a6d63180ada268903499d45",
      "text": "makna",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "39474b3ee6c77bf77f8509c3f5f5b062331923d122d6aaf631c79d40eb26425d",
      "text": "Makna gandul, mawi Pegon. Enjing-enjing wonten sorogan.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "3951198f29566704ecbe2942ec394b0feb3f988647240cbaaee6f71ef6553d35",
      "text": "cara",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa55667ce0c44671e749cc3fee854bf0ccb889b62df4c9e4ecbafad6d8f7283",
      "text": "Wah, pinter! Sekedhap, kula timbang rumiyin.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e12ad50ebab323cf84af5cbcebeb0293ca5137f565e7bbf66e2582f0e367152",
      "text": "gula",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ef087274759f3693d5a04a117ff0cd2d4cbcda14582ba3562fc76b9f3d29161",
      "text": "Leres! Utawi kangge mubtada, iku kangge khabar.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f9d2efcb21cb1e644a515415d331135bb69f4c06ec9c2bd23ff49ca3d1f7ba7",
      "text": "cahya",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4207a58615bdb0830f9ddf5cf80de3d153abef63d164593549185e790216234e",
      "text": "Gula, kopi, uyah, roti, tahu lan susu.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "446ff6e03b5e564bc6584730caf4c32f5216d37482ec25d5f3ae807869b45c4c",
      "text": "Leres. Panjenengan kersa tumut?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f9aae40bbf860445a8c95afea133c60379cb10aeb175eb432528ff28308d5f",
      "text": "Aja rame ing masjid.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "45c2f721498f4acb7fcbd05dc5db5cdad28093dcc68161825cbf5166b9873528",
      "text": "Aku seneng sorogan karo pengasuh.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "46c8e7fdb2ff9228af4acb1e72a1214bbddd9cea8f662199592faf13f385d222",
      "text": "ساڤا (sapa)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "487864cea0a90d5bb3831b402e28015bbe9e14fc348c6afb60e3ed62ce97a23c",
      "text": "lestari",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "48818e7d2a4e7b7bff00eaf32eb72a17104a2b68099f676f35e639e4aca9c2cd",
      "text": "Med, jenengmu tulisen nganggo aksara Jawa.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "49315ffb89a1ddcf9422a8b83ca032f472a41da6a2823745f0d5992403204a9e",
      "text": "Pak Slamet menehi ali-ali perak kanggo kenang-kenangan.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4972e32bad9ae795f837bb539894814d70d074b4aef3c5b7abde537165d5e51a",
      "text": "ڎاڎا (dhadha)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b331d1613a09cddd96ef740edc97dfe4d0c241480e3f1c2c9ae83387c24b5fe",
      "text": "Leres. Menika cathetanipun, kula serat mawi Pegon.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c55aa3f5e307ad96339fe6529806fb1147104683e43f69ab14aecc46abb5f92",
      "text": "Bu, kula badhe tumbas bumbu rawon.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e314d3645c7583004b0a51cf724ff4da81ab175c85bfa6744473f5bc21ec67d",
      "text": "Mas, menika ali-ali perak kangge kenang-kenangan.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e3f235783a3b8ac3ec1a350710510a86425410c74950cca409c0061c9c71461",
      "text": "Matur nuwun, Gus. Menika kitab napa?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e53e72269f7bfce37dbe9142842a08adb378873fe88fb6ce53d94ba54988025",
      "text": "nyicil",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e8d5bed068785dbd627212deb4f1b9e7a8631881eeff50c321895080ebe2157",
      "text": "سادوروڠي صلاة، وضوء ڎيسيك. (Sadurunge salat, wudhu dhisik.)",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f54e34b8482b20d40f0d85ffeb5a1f977642139b2f63cdee61c024455c77ed3",
      "text": "Nggih. Kula lebetaken kranjang panjenengan, Mas.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f8abd73ce908309efaadf1fb71683b70533d6d58aec5aa1f4eb92ab46c3730b",
      "text": "Sampun, Gus. Ngaji kitab saben sore, kangge sedaya santri.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "509bce3716ce7333965b6fa70509b98b996ab24f833bf0ab5b5c52da4c3a05c3",
      "text": "Wah, telung aksara! Latin, Jawa, Pegon.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "55e15b7f7b150813ae645aeed55fd763274b02f4427c571ebd5b8ce7b96f19e9",
      "text": "ڠ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "58a77aeb710d726e16f1cc341c82d2fd8f605557a100559ccc75799d081b3d1e",
      "text": "Saben sore santri-santri ngaji kitab.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "597f91b1e6fcbdc8e2bd83934041abf0a678542a0af621fa8ef9410cd3cec619",
      "text": "Sadurunge mulih, aku pamit marang Pak Slamet.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca4b725b9e1d30f0aeeefe54c13ec019b938612d8232866a86447635bec1340",
      "text": "Wah! Aku isa maca, aku ngaji!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d19c0350f8e1c46243efc4436deb492d85912115f7877a5bcf8d9c8cc3b965f",
      "text": "Lan aksara Arab, aksaraku dhewe!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f2f480e7ed0427694e4f1df6e5da2fc46dec2e9c6695d7e2661627cb595e954",
      "text": "Pengasuh pondok maca kitab.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "633c78140036a4ed9dc932aa57da17fd61127d238c38b9a4a3e3a86241593d5e",
      "text": "الدين النصيحة — اوتاوي agama ايكو nasehat",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "63ff02a075cb89bc8dc44d437a0cf2e1c158a5925089a6b240a1475397cb32c9",
      "text": "kluwak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65656ef1fe3705721797443bc30f057786999db0d13d3744249fd6ad34f5d8ac",
      "text": "ڠاجي (ngaji)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "66403d097b1f134251277ef7cf6917071bc1f58d91d80e56e466cc856b98d34b",
      "text": "ايو مريني، ڮاوا كتابمو. (Ayo mrene, gawa kitabmu.)",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6869d260d654a1b1f2e48531720dfcb4a619f7bd263f883277a919b80cbd4b6d",
      "text": "ڤ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b08a2b38efdbccb7f3305d6a7e3e8e79a3f9fda2e4dc5ad5d4b368f72201d8f",
      "text": "اكو ڠاجي (aku ngaji)",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b0f62c8d159bff963c4f5eb125f92b0e0d53433a61c97b11b6094b7b4a07897",
      "text": "Dhadha, pathi, gula, nyata.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "6da38ca96d3653339fffcba57d140ab3f63beda8b141d519d7e7fdc5c84e4f8f",
      "text": "Sae sanget. Kula kepengin nyobi!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dd09c6aa184c8199fe8026760fd24ea2021f1da22a45ca75cf9bfe314c587e7",
      "text": "trasi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "706dbc85f9c2e6060baedc9bc5551ecb535440a340d58ae34b74f1822e6e91a2",
      "text": "Kanggo sakabehe santri.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "71cf83c9b52418a9fd7aaab8c368011ca4215a20b99b583a2eace1516aa39315",
      "text": "علي (Ali)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "760f0da21c3f40ae99a3f105b46ee41ad715e2287da61a64ca228fd3fd2a5a8b",
      "text": "Pados menapa, Mas?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "791bf25db6e3faa689668e07cf3bda39baafd5bdc359bba00a8ad13209b41e44",
      "text": "Mas Mohamed, «al-ilmu nur», maknanipun menapa?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c6a8b2a2af0b74f3376cc854d8d3015873be6dc0581ba0c7f17310168ccdd20",
      "text": "ڟ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d47b170f3351bf0a20769f1be046f41312f59b2a88a0ee8cf8bb2c2f5ba7399",
      "text": "kranjang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d9093fedf1c65215f5a193430fac07af196dcdb2efbc91b0cb0176c6ffda20d",
      "text": "ماس محمد، سوري ايكي انا ڠاجي كتاب. (Mas Mohamed, sore iki ana ngaji kitab.)",
      "voice": "jv_siti",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f1477ebd04d551a8dc987e1aa6c78dbb217968b7fbadeca8da97e8b4a782df2",
      "text": "Rawon ireng iku saka kluwak.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fcabe77fd9138bed97eeb94afe4227db7dd0d9e43a252eb87c5af36d1c2daf5",
      "text": "Utawi sakabehe puji iku kagungane Allah.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "802d64e03b0e98674cac0d4ead44143a27fe201f078ce3da4ca7765508cff2f6",
      "text": "Wis! Tulisan Pegon gampang kanggo aku.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "829ac0c18c3ece7510c72e15d283d27673cd3c958db44fed9da9ba26a9f9141f",
      "text": "Dudu basa Arab, Med. Iku basa Jawa, tulisane Pegon.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "82ea661b8f4cd324913e660d13b4ae522d8fccc7ee5d20c865c887ab88e89887",
      "text": "pengasuh",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "837124f9853cbc55d9a9201cc550973452f55efe2e623d67f272d0a2c97c40e2",
      "text": "nasehat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "840b6548593fc919a46620da085e4b157ce8780d6d1ac91184eecdd24bd26247",
      "text": "Aku tuku trasi lan kemiri.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8522ff51aead5e9419464a61e481bf1ea52e7e69980681705480bd8f9d55475e",
      "text": "gula · ꦒꦸꦭ · ڮولا",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "86a01a9b31a1cf0a3df5c89c87d061a0b9e92f8876e15a76911faedb49a9962f",
      "text": "Inggih, saking kanca santri. Kula saged maos!",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ba02320c8d830f91c8d320fe0a0a7b2e2f858558a549bad5dad8430ec7fb26",
      "text": "sapa · ꦱꦥ · ساڤا",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "878b9a1a0948c55c11c353dbf2b1f5912c66eea09a6f796574c483f0cec5fb7b",
      "text": "kamulyan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d7e985991443f35e17a58586c19ecbe6360624fefd0eb2c02a18b61ff850029",
      "text": "Sadurunge salat, wudhu dhisik.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ee4d7ddcdbb67c2d280861e3a5d733ecac714e317c52017f0dfe0f4348ab981",
      "text": "Matur nuwun sanget, Gus! Kula badhe sinau Pegon malih.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ffcdd10c51c70541d35b7c15147282ede936cfe9b6407e90340a365c3019a8c",
      "text": "Kula badhe nyariosaken Kutha Gedhe ing Mesir.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "918018e12b0aa3d86aaa1b63c608cba29f824e08b57976ec7032a6b4820311b3",
      "text": "Utawi ilmu, iku cahya.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "924adaa15b4a2b74ae527cbe07747036e11ba231c16d2d0d510a6497fe4fbb45",
      "text": "Aku ora ngaji.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "92cd80ace6fb18a696f52b66925a03d4013c8b91eaa94c6758242339414ac7e2",
      "text": "pesantren",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "971500603851945cf6fce610ce5473d8c1c43dfffd2efe763fa7bac57608bf65",
      "text": "چ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "9731e4c7acacaa888247f5b490a87e87b799afccf89e8a3267a3cba757306a0a",
      "text": "Santri turu ing asrama pondok.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "9841cdb1996d158a32e1182bfdd954140067b8c640bda3917b8d2e9de2d91a27",
      "text": "kitab",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "99bb8db66d0c8bf9ac07f22032033c1cdddffae7b9b7acf9d901d0961e4ef9d5",
      "text": "sumbangsih",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d9e5daefcad4449b13cfa81ab750d42fdae5f041fa6f52bb554dca285762fe0",
      "text": "اوتاوي (utawi)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9df4747ec2abe4b568da9960835fc071e475d14526d479a5af289286c5db9383",
      "text": "ڮولا · كوڤي (gula · kopi)",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a009fd80523c88c96ffef35d2427681f39131cf0c5d345d90be065933a1a61cc",
      "text": "gandul",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a19292c17c043f20432bc6b33b4c888c9adb949f9423b435fbd191cc5cefea1b",
      "text": "Mbok bakul nggendhong tenggok.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a344382e7c59a411a37b662dd4c2379a7e5068e2a31bcc9a769a3b147779adf8",
      "text": "ڎ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ea8dafecf5f899b31fcad03a3175195ff50d23623bfaf93c024beb92a555eb",
      "text": "Sugeng rawuh ing pondok kula, Mas Mohamed.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4de5d6b8a345c47b5b688e3fa55e1da09e93dfea23627134e94a47290c5d400",
      "text": "ڤاڟي (pathi)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5393249194157bbd0ac7c182de837a426815a4eb25d16968f4ff1dff4ca9fe9",
      "text": "Mas Mohamed, menika kitab kagem panjenengan.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a663f777a5edb481f92111c0fccedac6b58c859302777de40112fd9bf1a4f553",
      "text": "Sakmenika wonten bandongan. Bapak kula, pengasuh pondok, maos kitab.",
      "voice": "jv_siti",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa5e4ca1225c161122aec9ec54cf8c8ef996e1437d25bcb8f3fa2f800f45df1b",
      "text": "Isa. Sandhal dicopot ing njaba, ta?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa674d9a0a8470262ee988ea26e864f2a05fbd2cf510df176c09a6b4d56f2485",
      "text": "Mas, wis maca layangku?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab35e18ac3cf6581ec208cf88d0cd8c9913c0bc561e7852246cc3ae30633542f",
      "text": "Mangga. Mugi-mugi manfaat, Mas.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac9a1e4ac60dc33134aa4374d951f4c34f34686ec263f9518b9376eeb651f8f9",
      "text": "Gula, kopi, uyah, roti, tahu kaliyan susu, Bu.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "addb8767af7a047c1fb3b3158b857d534fde9504139d34f7082976671c536e5d",
      "text": "tenggok",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae5f5e746f5c93844030431cb4cda1b249df8ae2094471287a3914ff863760ba",
      "text": "اورا (ora)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "af413e37b382aadb16a9235f1a69cac5b7bfeb7167694e9fb6a4f10c16c96db4",
      "text": "kemiri",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b01efb2b697ba7f96d10cc69a8c5cb5cd7365baa315d424ab3db41ab0f6b0b1e",
      "text": "Iya, aku mrene. Matur nuwun, Ali!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2160d683a257de1220ea5b37bdd6c74ed3283bbf205f473c311b1d0ff49afce",
      "text": "pepeling",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8c2cd66fc8e6df1d7ad66dafcc79df08a7a86efde4c714b148943844f2edc6e",
      "text": "tasbih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbd53673bf6ac7cd5aa919a39aa95315851baeb92eb49a8b9423c3e1e7ebcf64",
      "text": "Utawi ilmu iku cahya.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcb6ad266941fe7928ef8bcbc1e27775e129a3b9cf584e6628320865254ac6d3",
      "text": "Simbah ngendika: 'Eling marang Gusti.' Iku ___.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd33a5f9b61462eb5f7407ec633d95f6d41a8ab6181193cc979321146bf9bc5e",
      "text": "Wis. Saiki nganggo Pegon uga!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4adaa8284ae7356e8e4ec423a4cb483db10673ec09ea13c769c463c0538d57f",
      "text": "Matur nuwun kanggo sumbangsih panjenengan.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c54934860133c1bc31bb4724b80207b9c2d1db5ce24d94d387f84084de4810d1",
      "text": "سانڎال ديچوڤوت ايڠ نجابا. (Sandhal dicopot ing njaba.)",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6607f3a7b14b8391f54a942fa92373b420292bf3410e9a0cb7f947108d75b93",
      "text": "sumunar",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6ee8a79e7a261ec71ad125d3bc11ab89a091bdc700b0ed5e424e45178b279fc",
      "text": "ڠاجي كتاب: سوري (ngaji kitab: sore)",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa17b30d25a29fcd7359b2e5780ac83f419850a043be2c7533ed1568941836f",
      "text": "ۑاتا (nyata) · ڽاتا",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd42a22a809b6af78f7192f199c3f86d4ac73df0ddd3093a3274cf45707b1d6e",
      "text": "Sugeng rawuh ing pesantren, Mas Mohamed.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd4e93acf709757e09ba47b37f2d993c1114eb22810ff9d26a00493d405e7077",
      "text": "Aku ngaji ing pesantren.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d249cf0f327dbec945ea8ea3292e10a9ac4c77ebc31cc2ce80ae1d37a523a5e4",
      "text": "asrama",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d314758c1a333685e362c1ccf5f537284e70833b8b546663f46a51d80887d838",
      "text": "Nahwu ing Mesir, makna ing Jawa. Kula remen!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3b12dc4c6e30e3392951dceb280ae3f93b9d11a73159d8db0517bdccea14401",
      "text": "timbangan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5a7600a19751760ce9598b793633db9586ea1c0f62453e915b225608b44f596",
      "text": "makna gandul",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "da29c683d9740d209d2ddc299ca6296fe923afe11e8c13321f25ccc51017454c",
      "text": "Kitab basa Arab, tegesipun ditulis Pegon.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "dac5dedc7491a6abf1ee78e32ef3920377aea2e4a19dc4d95433528501b337df",
      "text": "pathi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc73c62422b671093d1aef89b6463934dff80a1e82865885db27d2dcfa952050",
      "text": "Menika sumbangsih panjenengan. Mugi lestari!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "dda0d7064aba524085270f05321afd4a7a06b32a788549d2e66ee08e652bd8f6",
      "text": "nguri-uri",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "dff2b0006e91747c0438d89b26f172c52551833170d24fcaf38ba58c92d22c82",
      "text": "Makna gandul ditulis nganggo Pegon.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "dffc4c8b25c02161d578d2e646f2c0aa2008ed0852c54fb0a92540509968e786",
      "text": "Bakul nimbang trasi nganggo timbangan.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d21e67fc7fc3f707e9931f7c7d1c41ba9241b0dcd8d8b41323b575b0a463a3",
      "text": "Dhuwite durung ana, mula Mas Dimas tuku motor karo ___.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1fc28ce45c64a27439af083d187cbb2a6b54b30af5d9a6a1695a3163cfbdf83",
      "text": "ڮورو: ڮوس حنيف (guru: Gus Hanif)",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2471a2460e18264075eccd7ad802c9a58da64308166d323ac130c06c75671cb",
      "text": "Utawi ilmu iku cahya. Utawi agama iku nasehat.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e66f297a72f818a6eff7243d32e15528531fd46fe7e35588493a5cac238338a3",
      "text": "Santri nyerat menapa ing kitabipun?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e937a80fb7038d490f7d5e02fff7558c3785fa3e6f482513272d8f6bb757aa30",
      "text": "Aku isa maca Pegon!",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed4f96f79e3657bf50fd64229d0c055b002d8969774fd18c1600c4b32aadccbe",
      "text": "dagangan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "eff4698bee4b374ad8f1794eb3a0e0f3f31d3946386c46180329de8c2ffb33c0",
      "text": "Kranjangku isi kluwak lan trasi.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f063263df7f81280cda98948c31e60936f529322dba68994f995506a9e9e60bb",
      "text": "Santri-santri lagi ngaji. Kitabe nganggo huruf Arab.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0a4dd93c51458c832db76a7e1677a1a48cbba54589a24864594d06da474c7f0",
      "text": "pegon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2125746cb8147c52526d8efd580609c9baa74b14e9672a7c5e60f6f084b0a95",
      "text": "Ali-ali perak iki kenang-kenangan saka Kutha Gedhe.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2ab124cd133edb7d9ff3f85805d123c3a7a997229a5f7f1b2729ae7246f28b9",
      "text": "Simbah dzikir nganggo ___.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2e8f7caa16df664b283e35c1b594d7fc2f760726e78e5848ee236ccf318d5b6",
      "text": "ۑ",
      "voice": "jv_siti",
      "chars": 1,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3bc4af25d7c7ed51f4f2411164211b982d1d15f763f2fcc187985d08877dd90",
      "text": "Nggih, Mas. Kluwak, kemiri, trasi?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4e9b0b832e149ccd3114f3461853bf618a3c5f0f527923189951ce4e1540bb7",
      "text": "Pak Slamet, kula badhe pamit. Benjing enjing kula wangsul.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "f69bf91640254a3104d1a483395b0671aa131630fefeae40502cfc630da0c665",
