    },
    {
      "id": "j4.u05.l13",
      "sha256": "a99735f31e3b8a27575bea5ea7c197b27565b86e4326a6ff89257dfd0ca1fd26"
    }
  ],
  "audio": [
    {
      "key": "000796a5503a4bce97a250951b6f8efb94ce93ffac82f340c5efc9841c159a9d",
      "text": "warsa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0024f452dde8a883b2b571dbe249a8cd7c6fa853ef8803bdac948029603a3a9c",
      "text": "Ra papa. Ayo nggawa tumpeng.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "005b4fd46244f9e03824f9db0ebc55daf4465ae5acdf27775434dfd8f938002c",
      "text": "rapat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "00ee57c1367e90df12a1ffbbeb80fc952e47c9106d999720fa47448e1965f966",
      "text": "Waduh, kula gela.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "02d585e7099adac9202b791df465c5271333885f9f0f8037dcb2ed76eef1eadb",
      "text": "Karo Mbak Ratri aku nganggo ngoko alus, «Mbak wis dhahar?»",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "02df6abe9d08a9d9a20444d148048200005240b4f7a4baf5238002729aceceba",
      "text": "Ra ana. Kumpul wae, mangan sega.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0348cf149c6a52c694568bad25a679e201f349865fb986551e688ceeabaabe79",
      "text": "Kaliyan Pak Bambang kula ngangge krama alus, «Panjenengan sampun dhahar?»",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "03db9ab37bfa09f02cf81937d658e46b3b7fef6bdba13f7346e0f43961b17253",
      "text": "pengumuman",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "049fb2a2c3bb26d66e9f9039a579e83f3f2c79a12ca4fe85414babe810be2827",
      "text": "Mbak ngasta payung?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "07e15c113b1260e47c644a6f05d12881bc34ee42624de9a995efbb86d6a578c0",
      "text": "Mas, sampeyan wis dhahar?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "084c99db8b1339f7fcbcd46d3ee0c7bca5d572eb7c2d6d63a6dff060bf15ffab",
      "text": "Menika ikhlas saking kula lan Mas Dimas, Bu.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "097f32cbd90e42e690daea5f9a992585362c17f210c92abe45270b79ce05e0b9",
      "text": "sepura",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0abf220fd499e97d25b05c856605041c3112bdf62ee36e90a81ddc66e816bc1a",
      "text": "Durung. Ayo mangan neng Kotabaru!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b88b83b3045c6236a70bca746c6c612d230489a1199c858f4fb4423ae91e6ec",
      "text": "uleman",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "12e05d52207f683be3204945d76b3a09686b7473784fedb048a9671e0c2a7884",
      "text": "Bu Warsih badhe mantu.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "155850ec48406b324089d14e401a71747970933c3a6f3fb8cf31d92e142cb94a",
      "text": "Mas Rudi durung bales. Aku nelpon wae.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "15eae79a7e623392d548785765aa20aa1176f5fc708137ad532b231f2fe1d7f9",
      "text": "Mbak, wis wungu? Arep ngasta payung?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a64556097c9bf8aa02d60a49ea19f29b4908d86a3ea9b7cbb882862fb58b920",
      "text": "Kramamu apik tenan, Mohamed!",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a712e6de53dc183d139d301fb796c387083ec563bbac6880f3e2fbe7907aa7c",
      "text": "Sesuk aku jagong manten.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ad5d0e7f7d4506d1357d39669ab03e86791b0a104c68938bac5a1b6ca6afc0c",
      "text": "Leres, Mas. Sae sanget.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bb9b48f327069eafd5d6c18515a19f7f6704e01e49b2ec3c1d6500188cd6b4d",
      "text": "mantu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c4eb01c50917d976d7774427082eb08a2ae7ce2a08ce50012e4315631ad6cd7",
      "text": "tumpeng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d199657ef9171ed5f0fd3b84ddca0eecae592d38244e814e837e562e7a86d32",
      "text": "Aku tuku ___ loro kanggo pagelaran.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f703da524ac850d3d382933d68a7d25626e1d5f44bae5e56d3aee52d2eccff0",
      "text": "Tumpeng menika kagem Ibu, saking kula.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd2885d7b2bfc3c10751a1aa33bafc7eb18f065abe1bd996f02b4028d6619d1",
      "text": "Sae, Nak. Pagelaranipun dinten Setu ing Prambanan.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "221da7918d8cf759f0f46c7ddd1f06b0900d9085485f37afb94d3ee38847af64",
      "text": "Durung, Mohamed. Kowe?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "253e4c47ff68cd856ceecac3b11a8e9559e17ec2709f04b9250aade539b63711",
      "text": "Mbak arep ngagem batik?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bde9605b8275f9255e508e6747b6f647e101d65207790e6e73c75856b17c644",
      "text": "Mas Rudi durung bales pesenku.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c63b734e11b4a09601112c6ef74f40006e917601098e3401ebe292473b5592c",
      "text": "Sugeng ambal warsa, Bu! Mugi tansah wilujeng.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "31839dd3f70ba083d68ac06768b70e78c93006a73d359feadd3c860c42707780",
      "text": "Kaliyan Mas Rudi, sampeyan ngangge basa menapa?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "321f525bacbd67c828607d4078b84d859652c1dbccce304f6cb67b719758d284",
      "text": "Ijab wonten masjid, pahargyan wonten pendhapa.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "388c04e579ac9e0a98e2b165070c6094666edae448d6c32361db6741ef159eaf",
      "text": "Bapak mboten duka, Mas.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b70aa77add1c10631493b86d23a6a1571710715d2ce54b1e535dce30bbbc789",
      "text": "Aku kepengin nonton sendratari Ramayana ing Prambanan.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d5d15c6a57643112c3d8a063b1a602e516257ce89ece0a21de22708e5eae336",
      "text": "bales",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d60d404b960dbe2461abd236dc013ef59ef084c5018b9583cda53c37cb2afc9",
      "text": "Dinten Setu, wonten masjid. Lajeng pahargyan wonten pendhapa.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4088955bd41a0ad9c932d6ddf8588152739636e45a2a27794716a58f3599b147",
      "text": "ngasta",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "40bd711f7eb4a7e572b618fb10c1e979a9c6a121e69f33930d4f01e59baa80c2",
      "text": "ikhlas",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "42603addc0aa1eb33046be949bcfc5d0f641e6afe5511cce903eace3af58cfbb",
      "text": "nelpon",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4431313948bf78ba0ac6d8e28c9ea6e23116be6ce897ef476965041102796877",
      "text": "Durung, Dim. Aku isih ing kantor. Udan ora?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "44a9190a3a3aaee1d167bb0ed6f95d7caef2081ebf98635b02ac2701c179986d",
      "text": "Bapak saweg rapat ing kantor.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "46bc8abf02a30e97f8ccf6a1bda1be35bad7b2b9fe1a14e960d754bc84074eb1",
      "text": "Mas Dimas sampun dhateng kampus, Pak.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "486e0962b3cd684579df6634f2b3318d7ea50af9faeafde78328881f26230420",
      "text": "Dhuwit neng amplop wae.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "48ecd4e0cfe2c6ce3a24806b34d97892e1d6b7828f01de9ace2126eff806ceb6",
      "text": "Udan, lho. Mbak Ratri ngasta payung?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a1bc7b3a00e92f1d5ca7bb5cb8d68bb56f33e6b83827cc25ea6232cb377a739",
      "text": "Pak, kula kepengin nonton sendratari Ramayana.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bf450a6cbcc5f05b689b2712be7ebf09ef68fac94d409fbc5230b36109a9c10",
      "text": "pagelaran",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c5596af86b8ee207f4cd0d43123ea74c19068aeaf3c518cdb7f607fbf29b7b0",
      "text": "ijab",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "50f86e85e1b714b5bb17d065209705d7281d4c49c8b03e5a4aa8cdce3083fd5e",
      "text": "Ijabipun wonten masjid.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "51241b1b00a2961830a4391c8715cbf002ccb92767205b9efe1258d806ddd235",
      "text": "sugeng ambal warsa",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "526cf34a611b92f2588c7fef1259d1c239e3a98444be43f1df154b73726b62d1",
      "text": "Udan, Mbak. Mbak ngasta payung?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "52fe375f65b6b52d5686e396da482dde63d82ababe3add75bd53d9690bcd893a",
      "text": "besan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5381dab1c9456c71bfce6c80b059019db7393467fb87bd5a3024e1523c4953d5",
      "text": "ngoko alus",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "53a5c6cd8df8f238e0742b8bf6356b3c3de432a687d1d8b906f4dde99ad4a3dc",
      "text": "jagong",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "54001dbaabc5cff81e5a9a2ffa7e161ec3902ff6a4f8f3292f60decf50d12c99",
      "text": "Iya. Sesuk penganten nganggo paes ageng, apik tenan.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "54f742ba042441687a6aaadf84a44c20f25cd9bbddc13df5e33643069d79034c",
      "text": "Aku wis mangan, Mas. Sampeyan arep kondur jam pira?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "56f042dec453c468ff5d48328d5618b6d90c3e815d1f870cbed2713db2c6d2cc",
      "text": "midodareni",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "59747943a4b47e239fb0530c3550400bb55991d5720277aa2f5a8bcc999db2c7",
      "text": "Mohamed, Setu iki jagong manten anake Bu Warsih, ya.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "599c4ab989aab7799a28e817fab194a5136a7cb488f9d90d5dd04133015eb06d",
      "text": "Sesuk aku kondangan nggawa sumbangan.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a8de354c45dab3c10b0642c81935304924dfad501a54184edb0b0c8300a1d35",
      "text": "berkah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ac708b1ead6ef80d7ebc7e8d17ad60c46f69b219ced926526d6fc5c53d42379",
      "text": "Wah, Bu Warsih badhe mantu! Ijabipun kapan, Bu?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b7468904ba1d6d6932a7faad1fc4432a1fd8986f439c8b205313e162a7b344a",
      "text": "Titip salam kagem Simbah, nggih.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bc5e6635caa50a58390dd6704bf594f39b7f44ff4e3e73848a4d2155ff3ea2f",
      "text": "Karo Mbak Ratri aku nganggo ngoko alus.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bfcd73ca9a1a0bcba6839569427c5665216d4751df6746cafc796b650ae73c5",
      "text": "Matur nuwun, Mas. Wah, tumpeng!",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d68b4f185d5b49d4c54ca65e011cdbebc619889145831f2d2b677876099e81c",
      "text": "arisan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "60ca6b0eb7ff233407ce4cbc38a030c4c11703c67a37a44d10ffe04225158bfa",
      "text": "Aku wis mangan. Mbak wis dhahar durung?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "649c3eca651fcffbc048e2883a35821b41332501de7c2b51712f63f2c483d43b",
      "text": "Wayang wong menika beksan Jawi.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "65df3aaca6e06b47be2349b73cf275e37cb8bbf385bef7b52965667859e9c635",
      "text": "kondangan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "668ec9484fcf8fd436b51346ae749f67e5174f93a309155a83705c1382b37002",
      "text": "Inggih, matur nuwun, Mas.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "6729bb23e415cbe5319d317ef141351a599c821506c41c49f4886d8404e94a91",
      "text": "Udan, Mbak. Ngasta payung, ya!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "695de3ddfa3fe95db3adb0868159d8af0caea99f12dd950d509dd57bf47bd665",
      "text": "penganten",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d10c3df0bc2aa2fff18ebb01e11e48cedb45c74f875fce318350aa2f7c8f0d8",
      "text": "Kowe arep lunga menyang ngendi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e1f641ff7a7ba5b1004b07d2909a678d9e785355c46e24ac523dd3cd5f5c742",
      "text": "Waduh, aku lali je! Sepura, Mas.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ebe8145edd488f7b05888f228309187578c5eaacceab0a814cafeb5c4ade19d",
      "text": "krama alus",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "723391a89b16d32359165865add737baa76edb86a8d6dae5953806bba0305f92",
      "text": "Jam lima. Kowe arep melu?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "72ab2c83bd7251ef28e80b0242e0fcb1705748f8a26d554a2ba8032e9a346250",
      "text": "Panjenengan badhe tindak dhateng pundi?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7377be13ffdd42d61ff0264bbfc4741e28a5892f0bb60a1223b1d315e6e17055",
      "text": "Mohamed, dina iki Ibu ambal warsa!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "75a760c11e0ab6d704c28e988d92be32bde51721ad52ba91823a811840fc6c75",
      "text": "gela",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7635a2118c0e776f0406fe2a200c5d736df9af71d97ef40aa8bc50650247b72f",
      "text": "Ayo! Aku nggawa sumbangan apa, Mas?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7733348cf2c33eb42858800b9a836e6be0e0aba6c74c694921f8ee354c14a804",
      "text": "Mas Rudi ora bales. Aku ___ wae.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "78f67b447ac07940f5f98a5e7af792a012ac0cac0dfbf42455f64e16fc3e4446",
      "text": "gotong royong",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "79b09eecaa44e29290598aef16618d4b126fa98893aa42111985e611a484469e",
      "text": "Sampun gela. Wonten wayang wong ing Kraton, benjang Minggu.",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bedef65b85459d10cd573ed0ff2f7ee9e9581ce0e50ed9822208cbeb7e1915c",
      "text": "Paes penganten Jogja apik banget.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cb4d7a4196bfd13e0e86bbdc92477d207dd2e708357138d2e5a425183dcc10d",
      "text": "kumpul",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d33e92882962d01b93ccdd8c6833c1d47652770b3b0a3bf24df4876595893b7",
      "text": "Sip. Titip salam kanggo Simbah, Mbak.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f8c7fa18e7c4084f7902d5f41910e3b2b557ad8b9b2f9926a1b3eb53bc7fdc5",
      "text": "Iku ngoko alus, Mohamed. Mbakku luwih tuwa.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "809625bc6cebe696de5093ba2b0d2c15d4b65c46fe8de6af2ce32d3d3d9757e4",
      "text": "Sakikhlase wae.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "85614c77567326daf965a5a7db8e6675c0ada517343d88ec61b6d5300b50a26d",
      "text": "Iya, aku arep neng kantor. Udan ra?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8725a88fd128a52041a715f6be9167e1cdd6b1492efb1df7b96fe7faec654e13",
      "text": "Aku melu, Mas!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "87e29893bfa609163c4431a588510008b876d87c9318c10a99d97d452e5b49ed",
      "text": "Sesuk arisan kulawarga ing daleme Simbah.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8825ee7c800bec9cde3e299a7cc5035e685a615c31d487e49a7f0044e8e2b1a7",
      "text": "Inggih, Mas. Mangga.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "88c0fa7a2015aff3eb59ef23297da55676d150f8e498117361216b16de1a3ac1",
      "text": "Bengine, penganten putri ana ing kamar. Iku ___.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a95755425737fdd22d0819c158e862db74212bed2351b8557947416295932a1",
      "text": "Kula nembe wangsul saking Malioboro.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bda52d1802f1733a74f480d3ba08b7230b791ef88259a32f29f88d7b12edcff",
      "text": "Panjenengan arep tindak menyang ngendi?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c57a6d088cbb9b9a7bba7b58956bbc9ec0d1074ac7bb194c0d7078207ad6538",
      "text": "Mbak, panjenengan arep tindak menyang ngendi?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ed70e3a1dde5b8e7b86b2c25219966c8c38d32a8fc9025d881f1a43a901ca57",
      "text": "sumbangan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "90561f995315bde0751c408dddb0e764745e201b72729fb2d6f1e62e1b2db9e4",
      "text": "krama lugu",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a5805af6a13621f830dcecaca8afe1ddd8d8d1f5a07b59c323da5af1b19cf8",
      "text": "nembe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "90f1d7297efd429d8c80d8f72ab1eca65cb15ac7afa51a5ff7817b648488054f",
      "text": "Iya, Mas.",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "92c635b00d5ef3ff2f3d6da29fb47384c59feba928d09b4ba995b3106ab632c7",
      "text": "Wis, Dim. Kowe wis tangi saka mau?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "930658d9b20c7eefd03bf293bb4103eb7dfd9953347f7263fa5610bef43fe6cc",
      "text": "Aku ing Kotabaru, Mas. Sampeyan wis tindak menyang kampus?",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "9321c58214d427579b5671fe9a63af7a82450dcbd6adfea9b7c9178fed084976",
      "text": "nggawa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "936ea08062e284eb0c6ebd3abe96fdd100f1c3e7aa789414d52f189ff14e9cbb",
      "text": "Karcise wis ora ana. Aku gela.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b77f3d94d5fc3555b99317b081a423b7e3c79bc31f65043de1f0a63745558b",
      "text": "Sampeyan wis tindak menyang kampus?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "94a22536878bfc2f311e25a654ea9bb7db1f8d4521107a6e364a27e66f308b4e",
      "text": "beksan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "960dbab56eceb3131b1faf9f5b01306405c1f1b584b89201d867f13daec9de0f",
      "text": "Mbak wis wungu?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "973d231be4b6b4ed1d89da0ae38db15527218a99d62cb6ca491135a0bee94b73",
      "text": "Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "97b411e8e13ff89a7016fdec22cf6a97b28d1c94b5cd410386c26f03b5a198d7",
      "text": "Sepura, Mas, aku lali. Aku getun banget.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "99ff93ea9abc02401da900842a33f727a3679ab12c42821698e2fe9c27fe7f3a",
      "text": "Sugeng ambal warsa, Bu!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a3ffa72d5dabbcde6d0398d6e8dc060bd28374ed4feeda926994b18b8e475a1",
      "text": "buwuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2982135d63e10973f8a7592ebc5e3f8fcac7f0a6010c8b43e83d4ee3b4cd75",
      "text": "Aku wis mangan, Mas.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2c64e1fc9de9be85c6aeff4408ad31e8dd037aa13301ce8850b0853104c178",
      "text": "Mas, kok «panjenengan» karo mbakyumu?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b5c9f0e3dbeed75512133d5c32d409f4e4068c905c78823d0100abfd4a05b4f",
      "text": "Jam sanga. Enteni aku, ya!",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9be599cc4148a877e65d81f5dc074c12be6d3330890e71b7e3956a5f5d6c67c2",
      "text": "Mohamed, kowe saiki ana ngendi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c66f375db5e1caaaf0c0cd664cde639ea37160b34d58e22e4112bd5b89199cf",
      "text": "Durung. Mengko wae, sik.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d044c5697d78270f48be276f7a0396d146ad8e28b51709145b4357b86ef4b14",
      "text": "Mas Rudi durung bales. Mengko aku nelpon.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d70446cadedfbc54a2e9da6acb7ed0699404ab06e65d338fd4e32d2ad8d9a4c",
      "text": "Mas Mohamed, saking pundi?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f2c10711ac704da3850c25919d46b35524f536529711d5a93fc7f136a689db2",
      "text": "Aku wis tangi.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "a600bb9732c2d9682cc82d849fd0a1ea2a2000a3231c43aa1ce8e0ddda9a1ed4",
      "text": "Beksan Bedhaya saking Kraton alus sanget.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8c25fb820fedf26e98f328bab03f2ca42cad604459562418807cc159adcd4be",
      "text": "Iya, Mas. Aku melu.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9abe00f0d9f6098d251e630ac503e10208bcc6c206137a76cbc8f0642ee9497",
      "text": "Durung. Aku arep lunga jam sanga.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa01f4fa8b349dedb6b543bc228505a5c0ebe2cab005899a7e0b98e5194e2ee4",
      "text": "Wis, Mas. Sampeyan wis dhahar?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab129833ac835eb0f64e76cb6bb97cd0309b15d1f2b02bb4d3171cecbef7802c",
      "text": "siraman",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab8a306dd34d3e7b3f5a2d22969bee15e88bb60a50cb1a493fb39667108242da",
      "text": "Mas, sampeyan arep kondur jam pira?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac5523399d589a894eebcc7c1119c1f5abdf3461d5887b185bcab349c42f991b",
      "text": "Kulawarga ___ ing daleme Simbah saben Minggu.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ade8c5a3584ad3d01866d1e161532efe190c00e3ece0e16f82806dabdebbd8e1",
      "text": "Kula nembe wangsul saking Malioboro, Pak. Panjenengan badhe tindak dhateng pundi?",
      "voice": "jv_dimas",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae04d1c8334d802e8c92ad343dda023ab6a82d2552f89f095104508db4b86d2d",
      "text": "Aku wis mangan. Mas wis dhahar durung?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae7749cd1613927ad53426ea26fd3067a0d17513e95c0517e3895e9f027b54c7",
      "text": "Wong tuwane penganten loro iku ___.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9074a30186b020d9e7a3280df7f06ae9a65db89eaf321cae1a7f2d97f4b1fe",
      "text": "kembar mayang",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "afe3b501b124838d571a0dc0243cdc25a5d45402b14c4d603c55a44d52b9ebd4",
      "text": "Kula badhe jagong manten, nggawa buwuh.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2ac0df797464a1a3d1dbe395a56f2b2a5f7294d220d7564d255e9febc0e070b",
      "text": "Iya. Mbak arep ngagem batik?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2aed3f56e3d4eccd49f4a8e0f75866838e76270aacb48a6335ee4ebbc83e3e9",
      "text": "ngagem",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b612a0c90242e0581ea1ebd1c28142994d3b68d8d6de2c9656764bfd9fb4e3be",
      "text": "kakang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b62ba3a4d123996081c54903dd3d58a9e9ffd8141308fc6b6e296c46c075709c",
      "text": "Mas, Mbak Ratri wis kondur?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b74cd91473b946d6b1bd4346063560d742afcf902fa066372c7ae7042495556c",
      "text": "Warga kampung gotong royong ndandani dalan.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9adf62521b660cf7704e969ba335b5dcd676d9019e5490ae4d83876e5e4833a",
      "text": "Sampeyan badhe kesah dhateng pundi?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2f16b166c8674cc136f0003c83f3dac6178031d7a38a8d2a4463ba2e86d0c2",
      "text": "Iya, Mbak. Aku teka. Mas Rudi rawuh?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbe6d3d55ab6a01a3e2a45f68696d61bb3d89127df912f901869edfc5d6c54be",
      "text": "Ra. Aku arep neng kantor nggawa payung.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce5d3e1fdbc10dd31d92a15a41e5ef9359c876028d8aadf66f7ed26bd1fddd5",
      "text": "Mbak wis dhahar? — Pak, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdaa686831d6ca73c05756ac4f3a7d0c893ac954f227d288ed5cc4a14f0042c3",
      "text": "Kowe wis mangan?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c15e4dd1ae454cb199f7ce8b18745b9e23476795d1fa9ac915ab9e4539e934fb",
      "text": "Aku uga, Mbak. Lho, iku Pak Bambang.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3016fb5b00c5a7b1238275e8fb540af51205212e2c1cfb5419f23f38cbfd340",
      "text": "Kakangku wis kondur saka Kairo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c38c2b5b497fe0554e2a8ace7239abaf9cdb75dc75b78f342894bebffb1c561e",
      "text": "Mbak, panjenengan wis kondur saka kantor?",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c70d0f7c03d81a9425688ce8779e93a7d797b8cf1743a129ec811c5ce4489f33",
      "text": "Pak Harsono mboten ___. Panjenenganipun sabar.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8c45dbdc7ffa37c525ad5cc4e952aed182954a5c2d991938eacb1d3ac8b5ac3",
      "text": "Durung. Mbak Ratri isih ing kantor.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95324dc10c74ecc15b41f1cc72d73006be5639d1f126ba6b5c1f000dd7d7eda",
      "text": "Sugeng ambal warsa, Bu! Mugi tansah wilujeng.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca6219fbb2793e15e1369e021bb329c895aa1bfc12881b2b6dc99d3e58de9736",
      "text": "Mohamed, ayo kondangan karo aku!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd30fc61b713a152314e90a64f67b8e8b63f111d0bc867e5080757a2e48b89a6",
      "text": "Mas Rudi, sampeyan wis dhahar?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfd2f819e0b0454e968ac0c974d4cc1180b6d3b53dcb1a81e51be6ec54c65f4d",
      "text": "Neng Kotabaru, Dim. Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1d8610bb416a06590cb7fb407d9a7f2f98e7b5a509ce4f84306f556530dbfbe",
      "text": "wungu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2548fc2bfe30ad89c37778c5dc8d284a3a067883dc88c8b7250e8e36e974d02",
      "text": "Kula badhe kesah dhateng kampus.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d30d527571a39851e8c659c58019f0725902c8cf8c15906f9478728d21b1931c",
      "text": "Ya wis, mengko jam lima.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d35e195ce3ff8136ff219fc67c944e0920bc31f0457e76135c94a013b742d11f",
      "text": "duka",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4d1607dffd8783acc87e35a8bacb22ac3328eebc784038274e7a0960517d2aa",
      "text": "Pahargyanipun wonten pendhapa.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59261a5ad2845abd2245205c406780ee6a77ad623cf51939fb586de3963c6cf",
      "text": "Wis, Mbak. Mbak wis dhahar durung?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5d94a4833612f349a54f8645279942a158d523adfbc02d2df93685bc6c13dd9",
      "text": "Menika ikhlas saking kula, Bu.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d68e7f85e7b87101a81beb1bdc179a5c2a412e8682d44d3441e14bf30aa1715c",
      "text": "Iya, Mas. Aku nggawa buwuh pira?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8d2d17d86c0d2f3d6b6c83e83056c9c149f15d34944cad71c006e3908b798c8",
      "text": "Mas Mohamed, menika sae sanget.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d928383ea03a2f02899568b2af1c7506568ecd5c740f01007a5bd2902fd117c0",
      "text": "Mbak, wis wungu?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "db61e4e6f307dd6f7d863a01e3a33e40d01a8ad257da953065da8aa7883db17d",
      "text": "Ibu sampun sewidak ___.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc289570de58ce74d3579bae45ef31ad282af88d59f7b29cb3ebace8378eea77",
      "text": "Lan kembar mayang sampun wonten ing pendhapa, Mas. Sae sanget.",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "de8f81c5cadccac524742655f05e24457dae3e0455855711ec896a04903fcdff",
      "text": "Ing pendhapa ana kembar mayang loro.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "df09f860a5efdcee46a350171d0ff6b07b66a0053bb64f349d91dcbca6ec8360",
      "text": "Menyang Masjid Syuhada, Mohamed. Kowe?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0b9df20e463cf6bb15d3a20b070edddd3e233ba948b7b0d8cd0197883d5dc9b",
      "text": "dhaup",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1cb69f7ddb3c4f7d4fd57224971b13f7b064f6996d4b5937eb7f412fc4826b5",
      "text": "nggantheng",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2dabc78c53c14390701cb9bb5ccdf92de66467100ca49fad550df817f42ce02",
      "text": "Wingi aku weruh siraman. Bengi iki midodareni, to?",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3b0fd559b559f66b0ef0067bf159423d6ca51faa2f6a78f073020d3fb2da562",
      "text": "Pengantenipun ayu lan bagus.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e52791586efc013a153d179d660d06b7b1b1c6aa5338873564a00caeacc8e696",
      "text": "Nyuwun sewu, Pak, kula nembe wangsul saking Malioboro.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6940b63a917cec49f22ff8a458793738bfa877a7b6465c3f6d790145d2d7265",
      "text": "Pak, karcise wis ra ana.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e75ec4341b585b067583d92572ee1470b5c5fecc78d599cf22d7ce809815b982",
      "text": "muga-muga",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea061960faa189f9ba632c21c6cb1a57abd8691dd7172a935f9bc7e33846a0d0",
      "text": "Mas Rudi arep dhaup sasi ngarep.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb7ab6fda216c2989c768a12eaa6dc8eaa98f4b614cc50dfcebf69cdc0580c0a",
      "text": "Mbak wis dhahar durung?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee624e64f435e15416c582244ec890df8ef8ecc024c14dfdd42e9d4475e9cde7",
      "text": "sendratari",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee8f02b099ace9438e91d43cdb44179f71de00a0de89e609077d7a9e9e3f7398",
      "text": "pahargyan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "efb4dfbaba87c68859af598b89af2757cabea4e4dfe47759f459a8525851d31e",
      "text": "Iya, Mas. Sampeyan tindak jam pira?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "efcced45c76b8af1018a4e615da285cb9d19990e20b0383e36ac0c51ba1d7aec",
      "text": "Ngoko alus, Pak. Mas Rudi langkung sepuh.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "f075209a6bacb674ca594f24be28d992c39c267105e96cd8fe075e7ff9057c93",
      "text": "wayang wong",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f152b0b99f20e6bfee6d8cb690aa688a76a5da0e0c21b0ceadfb6ed79b3187b7",
      "text": "Tumpeng menika kagem Ibu.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f271113a27a27bf914138bb55c9c7e71bb52a75b684a960189801386b265e6f2",
      "text": "ngoko lugu",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2ae522a1e027145373b3eb605f4b652e37433ed458c9fd41ed509cfbea73d33",
      "text": "Karo Mas Dimas aku nganggo ngoko lugu, «Kowe wis mangan?»",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7136a08575315398a80efa5831614df013493d816a76bc8efef451d3ff5cdc9",
      "text": "Sugeng siang, Pak. Panjenengan badhe tindak dhateng masjid ugi?",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8beff9bf405d6b58a8a6d66a08bd2e4c625ae6d7af2441dae401f74ef86b752",
      "text": "Mas Mohamed, menika uleman saking Bu Warsih. Putrinipun badhe dados penganten.",
      "voice": "jv_siti",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9005d455160c87f7c6cfe59676a0286def94ab71100e62eb3c3bc66cbb07d30",
      "text": "Mbak Ratri, panjenengan arep tindak menyang ngendi?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa8112eed7ffc3e7c9dac9f2a470443014748b356271c9a4c10ff9cf23d18b75",
      "text": "Matur nuwun, Pak! Kula purun.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc53408813d29d5a2dd572f1cedb72b1ef362004894362cd381874ab07c29324",
      "text": "Mas, sampeyan wis dhahar? Aku wis mangan.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe8a574c1b5e40732bef5e58e7e81959037a7d98ea1284a5df00f97b877dbce9",
      "text": "Ana pengumuman apa ing grup?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "fec625ff1074cac2435e9996c4f739f7d5c707407d36062c4705c81ee80a1fab",
      "text": "paes",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff7e0d567cb65ea43ac0f2977892bfd2f1400b6fc766837fcd137cbb3d4c595e",
      "text": "Mohamed, sesuk arisan kulawarga neng daleme Simbah. Kowe teka, to?",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffbf37d0164aea13cb49e749eda1a8dc0b2ccbb03c1f509cdcd1efbad8a68538",
      "text": "Sampeyan arep kondur jam pira, Mas?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    }
  ],
