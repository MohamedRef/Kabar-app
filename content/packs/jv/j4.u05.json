      "sha256": "6820459551774a493a1b2d6d34593f96dfd8eca6ed3c1f4aec45f4840d30ba3b"
    },
    {
      "id": "j4.u05.l03",
      "sha256": "d613b3d26ef7196b0fb1e1faf4b6608a1219d0f425c3ac70b653c0b6d57fea34"
    },
    {
      "id": "j4.u05.l04",
      "sha256": "004d3188cc9379c515fac3f13cf7ebab5d8323f4dcbc92cac98c3be3879091d3"
    },
    {
      "id": "j4.u05.l05",
      "sha256": "0c5777cf30099db92ead53d16600f16326478fc792689530665f77c8ededce2a"
    }
  ],
  "audio": [
    {
      "key": "049fb2a2c3bb26d66e9f9039a579e83f3f2c79a12ca4fe85414babe810be2827",
      "text": "Mbak ngasta payung?",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "07e15c113b1260e47c644a6f05d12881bc34ee42624de9a995efbb86d6a578c0",
      "text": "Mas, sampeyan wis dhahar?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "15eae79a7e623392d548785765aa20aa1176f5fc708137ad532b231f2fe1d7f9",
      "text": "Mbak, wis wungu? Arep ngasta payung?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a64556097c9bf8aa02d60a49ea19f29b4908d86a3ea9b7cbb882862fb58b920",
      "text": "Kramamu apik tenan, Mohamed!",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "221da7918d8cf759f0f46c7ddd1f06b0900d9085485f37afb94d3ee38847af64",
      "text": "Durung, Mohamed. Kowe?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "253e4c47ff68cd856ceecac3b11a8e9559e17ec2709f04b9250aade539b63711",
      "text": "Mbak arep ngagem batik?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4088955bd41a0ad9c932d6ddf8588152739636e45a2a27794716a58f3599b147",
      "text": "ngasta",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "46bc8abf02a30e97f8ccf6a1bda1be35bad7b2b9fe1a14e960d754bc84074eb1",
      "text": "Mas Dimas sampun dhateng kampus, Pak.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a966d5a8ee8531f29192b2a43080196362ee019cd2c9b4940e2cfb1b28cede1",
      "text": "Durung. Mengko wae.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5381dab1c9456c71bfce6c80b059019db7393467fb87bd5a3024e1523c4953d5",
      "text": "ngoko alus",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "54f742ba042441687a6aaadf84a44c20f25cd9bbddc13df5e33643069d79034c",
      "text": "Aku wis mangan, Mas. Sampeyan arep kondur jam pira?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "60ca6b0eb7ff233407ce4cbc38a030c4c11703c67a37a44d10ffe04225158bfa",
      "text": "Aku wis mangan. Mbak wis dhahar durung?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "668ec9484fcf8fd436b51346ae749f67e5174f93a309155a83705c1382b37002",
      "text": "Inggih, matur nuwun, Mas.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "6729bb23e415cbe5319d317ef141351a599c821506c41c49f4886d8404e94a91",
      "text": "Udan, Mbak. Ngasta payung, ya!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d10c3df0bc2aa2fff18ebb01e11e48cedb45c74f875fce318350aa2f7c8f0d8",
      "text": "Kowe arep lunga menyang ngendi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ebe8145edd488f7b05888f228309187578c5eaacceab0a814cafeb5c4ade19d",
      "text": "krama alus",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "723391a89b16d32359165865add737baa76edb86a8d6dae5953806bba0305f92",
      "text": "Jam lima. Kowe arep melu?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "72ab2c83bd7251ef28e80b0242e0fcb1705748f8a26d554a2ba8032e9a346250",
      "text": "Panjenengan badhe tindak dhateng pundi?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f8c7fa18e7c4084f7902d5f41910e3b2b557ad8b9b2f9926a1b3eb53bc7fdc5",
      "text": "Iku ngoko alus, Mohamed. Mbakku luwih tuwa.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8825ee7c800bec9cde3e299a7cc5035e685a615c31d487e49a7f0044e8e2b1a7",
      "text": "Inggih, Mas. Mangga.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a95755425737fdd22d0819c158e862db74212bed2351b8557947416295932a1",
      "text": "Kula nembe wangsul saking Malioboro.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bda52d1802f1733a74f480d3ba08b7230b791ef88259a32f29f88d7b12edcff",
      "text": "Panjenengan arep tindak menyang ngendi?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c57a6d088cbb9b9a7bba7b58956bbc9ec0d1074ac7bb194c0d7078207ad6538",
      "text": "Mbak, panjenengan arep tindak menyang ngendi?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e5119f3b2fc0178ffca9d7d548afddf777d7839ec96c8b8ef0d4993f9878a94",
      "text": "Mas Hendra, sampeyan wis dhahar?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "90561f995315bde0751c408dddb0e764745e201b72729fb2d6f1e62e1b2db9e4",
      "text": "krama lugu",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a5805af6a13621f830dcecaca8afe1ddd8d8d1f5a07b59c323da5af1b19cf8",
      "text": "nembe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "92c635b00d5ef3ff2f3d6da29fb47384c59feba928d09b4ba995b3106ab632c7",
      "text": "Wis, Dim. Kowe wis tangi saka mau?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9321c58214d427579b5671fe9a63af7a82450dcbd6adfea9b7c9178fed084976",
      "text": "nggawa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "960dbab56eceb3131b1faf9f5b01306405c1f1b584b89201d867f13daec9de0f",
      "text": "Mbak wis wungu?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2982135d63e10973f8a7592ebc5e3f8fcac7f0a6010c8b43e83d4ee3b4cd75",
      "text": "Aku wis mangan, Mas.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2c64e1fc9de9be85c6aeff4408ad31e8dd037aa13301ce8850b0853104c178",
      "text": "Mas, kok «panjenengan» karo mbakyumu?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d70446cadedfbc54a2e9da6acb7ed0699404ab06e65d338fd4e32d2ad8d9a4c",
      "text": "Mas Mohamed, saking pundi?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f2c10711ac704da3850c25919d46b35524f536529711d5a93fc7f136a689db2",
      "text": "Aku wis tangi.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8c25fb820fedf26e98f328bab03f2ca42cad604459562418807cc159adcd4be",
      "text": "Iya, Mas. Aku melu.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab8a306dd34d3e7b3f5a2d22969bee15e88bb60a50cb1a493fb39667108242da",
      "text": "Mas, sampeyan arep kondur jam pira?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ade8c5a3584ad3d01866d1e161532efe190c00e3ece0e16f82806dabdebbd8e1",
      "text": "Kula nembe wangsul saking Malioboro, Pak. Panjenengan badhe tindak dhateng pundi?",
      "voice": "jv_dimas",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae04d1c8334d802e8c92ad343dda023ab6a82d2552f89f095104508db4b86d2d",
      "text": "Aku wis mangan. Mas wis dhahar durung?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2ac0df797464a1a3d1dbe395a56f2b2a5f7294d220d7564d255e9febc0e070b",
      "text": "Iya. Mbak arep ngagem batik?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2aed3f56e3d4eccd49f4a8e0f75866838e76270aacb48a6335ee4ebbc83e3e9",
      "text": "ngagem",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b612a0c90242e0581ea1ebd1c28142994d3b68d8d6de2c9656764bfd9fb4e3be",
      "text": "kakang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9adf62521b660cf7704e969ba335b5dcd676d9019e5490ae4d83876e5e4833a",
      "text": "Sampeyan badhe kesah dhateng pundi?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce5d3e1fdbc10dd31d92a15a41e5ef9359c876028d8aadf66f7ed26bd1fddd5",
      "text": "Mbak wis dhahar? — Pak, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c15e4dd1ae454cb199f7ce8b18745b9e23476795d1fa9ac915ab9e4539e934fb",
      "text": "Aku uga, Mbak. Lho, iku Pak Bambang.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3016fb5b00c5a7b1238275e8fb540af51205212e2c1cfb5419f23f38cbfd340",
      "text": "Kakangku wis kondur saka Kairo.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4d3c1da5ad0cd1f5cb10cba44c30bfa5cded5ae58b180eefa8f1590c20af7f5",
      "text": "Iya, aku arep menyang kantor. Udan ora?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1d8610bb416a06590cb7fb407d9a7f2f98e7b5a509ce4f84306f556530dbfbe",
      "text": "wungu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2548fc2bfe30ad89c37778c5dc8d284a3a067883dc88c8b7250e8e36e974d02",
      "text": "Kula badhe kesah dhateng kampus.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d30d527571a39851e8c659c58019f0725902c8cf8c15906f9478728d21b1931c",
      "text": "Ya wis, mengko jam lima.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59261a5ad2845abd2245205c406780ee6a77ad623cf51939fb586de3963c6cf",
      "text": "Wis, Mbak. Mbak wis dhahar durung?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d928383ea03a2f02899568b2af1c7506568ecd5c740f01007a5bd2902fd117c0",
      "text": "Mbak, wis wungu?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "df09f860a5efdcee46a350171d0ff6b07b66a0053bb64f349d91dcbca6ec8360",
      "text": "Menyang Masjid Syuhada, Mohamed. Kowe?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e52791586efc013a153d179d660d06b7b1b1c6aa5338873564a00caeacc8e696",
      "text": "Nyuwun sewu, Pak, kula nembe wangsul saking Malioboro.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e839dbe44ddde243a803bed63fa9809559d030eea6ed53a0142b5fd3992eb809",
      "text": "Menyang Kotabaru, Dim. Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb7ab6fda216c2989c768a12eaa6dc8eaa98f4b614cc50dfcebf69cdc0580c0a",
      "text": "Mbak wis dhahar durung?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f271113a27a27bf914138bb55c9c7e71bb52a75b684a960189801386b265e6f2",
      "text": "ngoko lugu",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7136a08575315398a80efa5831614df013493d816a76bc8efef451d3ff5cdc9",
      "text": "Sugeng siang, Pak. Panjenengan badhe tindak dhateng masjid ugi?",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9005d455160c87f7c6cfe59676a0286def94ab71100e62eb3c3bc66cbb07d30",
      "text": "Mbak Ratri, panjenengan arep tindak menyang ngendi?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc53408813d29d5a2dd572f1cedb72b1ef362004894362cd381874ab07c29324",
      "text": "Mas, sampeyan wis dhahar? Aku wis mangan.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffbf37d0164aea13cb49e749eda1a8dc0b2ccbb03c1f509cdcd1efbad8a68538",
      "text": "Sampeyan arep kondur jam pira, Mas?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    }
  ],
