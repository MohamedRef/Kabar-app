    },
    {
      "id": "j4.u03.l08",
      "sha256": "ba36794cdb4a2ccb0fd212bbd2a8d290261823efd78bd946c6a989ead8c978e7"
    },
    {
      "id": "j4.u03.l09",
      "sha256": "842af7772d97c419786d885225a01cf538fd8e91834eb8be1bcdc0a8193e3b29"
    },
    {
      "id": "j4.u03.l10",
      "sha256": "9d9092daf54475910d6db994a9316cee620e652845da516eb427ef0a8de37fc9"
    },
    {
      "id": "j4.u03.l11",
      "sha256": "0b87a4499e38be2ff1aa85d2db390e957a79b99351137a03bfc0587c68a64f92"
    }
  ],
  "audio": [
    {
      "key": "002cf7f4afa63e720c8db431607b5d3391a1addb979ee7ac626e064a1edacba4",
      "text": "Matur nuwun, Pak. Panjenengan abdi dalem?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "028ca3b94009e6d443c65858561d6d6d393f43bf7ea869dc920e285c48895353",
      "text": "Setu sonten kula damel syukuran. Kula ngaturi Bapak rawuh.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0627ebdfead3389ad46be879f52fc61e347cd1ce1018776ab3e6031fa10aaf6b",
      "text": "Kula ngaturi Bapak rawuh.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "06bc17907113a46c885b5a4aea47280a5c60ba34cde430e5cda447bfa079db05",
      "text": "nyuwun pirsa",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "06e3271a725c95e6c72595e0cd6c79bdbcd99985ea7010865963e3263a5ade35",
      "text": "Nyuwun pirsa, Pak, Taman Sari wonten pundi?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0965721e4828b4f0ea9ffcc8e785e1c0e3d34b67419e04bc3445175e40996af3",
      "text": "Kula nyuwun karcis setunggal, Pak.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b9110c429ffac174a7ab60037752224506497576c373a4e6cb9a55d2ffb9895",
      "text": "Menika prajurit kraton, Nak.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c1d153906045ce88407d732e2f15325e53049d3f85e649bcac07898389147e7",
      "text": "Prajurit kraton ngadeg ing regol.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c8a2e815f02d7d3fc83c0f14c1f3c463a0a3954fc7a0ea956ccaff3747fa931",
      "text": "Kraton Yogyakarta ageng sanget.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d9550b6e5c0254676a1913d9ba145dfd1c3e7c7b9afee2b49be6a0874e759c5",
      "text": "Pak Sastro maringi kula buku, lajeng kula nyuwun pamit.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e1006c54e7d763f3993c0e3325050ee6bb58da007573da5f03be94351c0bd60",
      "text": "Kula abdi dalem Kraton sampun kalih dasa taun.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e9978513062ba5e1ea7640cba09fab52d76bae514e0ca14b774506abfb43ada",
      "text": "Pak Sastro ngabdi dhateng Ngarsa Dalem.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "127e0069c0a8696b11a7c40eaeb0343ad3fc3f6410c7a8bd29e6dd974f1c5d89",
      "text": "Pak Sastro setya ngabdi dhateng Kraton.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "152d6249a9adb864b20161d440aa19127784019b767a5bbc467589ef2d17fa99",
      "text": "Inggih, Mas. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "16fd546cd33655c972408b46afd1516bc7ecd965f524b2cb546b3966b39bcfb4",
      "text": "Abdi dalem ingkang sepuh matur: «Inggih, ___.»",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "17155e66fdb7e3719539c8df8eb30e9438c36d24090fa808b33fc61f10353312",
      "text": "Kula ndherek, Pak!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "171fb81fc28a55c3b99f6af62544c907271173ae2d289ec8b10be6006116a49f",
      "text": "Saben enjing kula sowan dhateng Kraton.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "19fa8b625ae15c4708001ac9fdc9c5c375e07340b23f39a4bb647df858cf367f",
      "text": "Simbah maringi kula arta.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c98f9cf1ad0aaf4aeeb7bd4e626a44ad3964bca3a3f720430e4733a0ae14920",
      "text": "regol",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d47900b66b223e031ad2506aea9f9af66827c3d5dce7f9cfb268dfb7b863371",
      "text": "Menika serat saking Pak Harsono, Pak.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e759fec8a66e1cd87f36a88cc1a8087c88f4531352601e838fd94de26e4bba4",
      "text": "Minggu enjing kula badhe sowan dhateng dalemipun Bapak.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "207e035d379b8c5c563a0c41ac9d5bf09e4b496a04600d29caa762321aed83ee",
      "text": "Sampun kula tampi. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "212b2c94886846455b517af505e34a1b6cef9eb96f4055433eed850df2898e82",
      "text": "Kula badhe sowan dhateng dalemipun Bapak.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f2d0efa56110375c10bed0c29a1542a2ba856e8b41710919ec88295d367c3a",
      "text": "Papirus saking Kairo, Pak.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "24dd794e39834077916a27409a2f3d342426295da7fd3392ef1e87f5d4cf720d",
      "text": "nyuwun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2599d32405c41aee7b321f714df2bbec88a3ce57fb109b536324dc0bc3028c2f",
      "text": "Abdi dalem matur dhateng Sultan.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2802cd15ede733fe2d5408a8f2e34206f2b42bfe1b245bc4da767190b247e326",
      "text": "Kula ngaturi Ibu rawuh.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "29db5ac42ad0b3200847e9e10e3ce6ef1f079f2f4729e3143757ad83bbb18406",
      "text": "syukuran",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c3a7e4f8a34f8c08addb88c69f592e361e2d10d872aa0374d080bd77b519c77",
      "text": "Pak Sastro ngagem ___ lan blangkon.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e969e3a7263c912f9ff1357768ad036cd139e0dff3ee7a06df2bf542d874c60",
      "text": "seba",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "307d4e1032a982e9d3871190c20d9cf612fce051779f9c264d60eb83ed6088d4",
      "text": "Pak Sastro, panjenengan saben dinten seba dhateng Kraton?",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "333c06d32a83341baa97f022e96c885ad3cbd994c38eb226480614fbb4512d3f",
      "text": "Matur nuwun, Mas. Menika kangge Mas Mohamed.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "36315238f23dc233d56ebb975cd6d0ba701bc577abc0dd38b22bfbbeb6a60d0e",
      "text": "Inggih, Mas. Mangga. Jam pinten?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "364d90d4b2aabc19b23d54e1829b5582368cfd06cbae470f9352b4ca7b1384d2",
      "text": "Sultan lenggah ing ___.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3717ca7e1607d1277b9ee57282535505abb29789f45c48df679b57cdfd758dd5",
      "text": "Wah, sae sanget, Mas.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "378b446fcb9fcff5d8363eb27622f9bf0ff34e8f89ad09590b1984de7aa2ab63",
      "text": "Wah, dangu sanget, Pak!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "38dddeb1a7ff27aff663708d2bbd5484b72937e6250325e3ce1b4e3c5cf4191c",
      "text": "Setu sonten kula damel syukuran.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "39d4a240a21cb2e1956910bb7e7daf1816c2878727a2aa4a422425ccc414b9c7",
      "text": "Matur nuwun sanget, Pak. Kula nyuwun pamit rumiyin.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be062bf40dc5f04ec6aec98c8a6aadfebe00d17320e0afb9e9f04f089da1be4",
      "text": "Kula ngaturi Bapak rawuh wonten syukuran kula.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "421053b31ca07cbd4701a62f7ff2a11cd2d536370fe9369bddf77811e1ce5121",
      "text": "Abdi dalem menika setya sanget.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4320fd564af9d3f444219cbd9c358c2695b3a62befef4a5f7491e6e05e45a641",
      "text": "Inggih, Pak, kula ndherek.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "438ef1b3a3a65e523ef0bada78f8495006610d11aca1ab56f4f2ef03a237e876",
      "text": "Wonten, Bu. Pak Sastro maringi kula buku.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "46a6926807b765b9194233f6d86a904ebed34331fa888c0a57a39ffc754da3ca",
      "text": "Inggih, kula badhe dhateng.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "49f97c3466ecf853278f00788d6ce44d550662441c1c8a5309dfed64fe849be5",
      "text": "Mas Dimas ___ kanca-kancane ing warung.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ab4050c598b1f9631a4d73c340162383ef08a19c60505f5bc83f4007bd542cb",
      "text": "ngaturaken",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b7ad9fec92f9a02b70bf7b456240e77b322e748e2fe2d23e120afaabdcbd785",
      "text": "Kula pinanggih prajurit wonten regol.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cd9247c23f64ed3f02f621e2568d2d486e44e95fea08fb594f6c3714908bcde",
      "text": "Sultan dhawuh, abdi dalem matur.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "51df10901a9edc0b1e09468914c04e2b10f8335318523dc4bd3152e19a6bf7ad",
      "text": "Inggih. Pusaka menika kagunganipun Kanjeng Pangeran.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "560ad8f3d6f1f74d71101e70380f06c91e5fe2d0c2dd7580cde1cb7f5aa2ad1a",
      "text": "Kula caos unjukan dhateng Simbah.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "58329d2a992301e576a7499117eeb095598c08879ca8947adcb4643c79e75a94",
      "text": "Saking Kraton, Bu. Kula ndherek Pak Harsono.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c5524543ec0011eb262e724befc3cac104444b7dc9dc77dcbb745a6cfd36f59",
      "text": "Mangga, Pak, unjukanipun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dd06b48d8febb8b8ace03f509395fd82917703fe8b1185050c7821dcc38e353",
      "text": "Inggih, Mas. Sugeng tindak.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "606ed991503221bae12f25fc52518640041bba5f5a867c8f20ee3e35b60856cf",
      "text": "Mas Mohamed, saking pundi?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "60c2661162dfbb4f94730c21e4afe18ed943fad582f9b07e608bd923d971bc38",
      "text": "Pak Sastro, matur nuwun sampun rawuh wonten syukuran kula.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "618560e93939327ab23a1c3add510b592686a8fb94a5a0f2c2de8f55880c8029",
      "text": "Ing riyaya, kula sungkem dhateng Bapak lan Ibu.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "62a9651bb1fa3bc52944076d8d338f54b3603a0dd1d16fc1fbd33eab3fcb3751",
      "text": "Abdi dalem seba dhateng Kraton.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6306e8c939423e50b177348647964ed717854c0166b2e94e67b8ca59153ea83c",
      "text": "Kanjeng Pangeran tindak dhateng bangsal.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "68ba568ca888e0665d2880e28d81977c32f3f8b32f44437cf49224b623d0d28e",
      "text": "Krama inggil, Mas. Sultan dhawuh, abdi dalem matur.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "699b10bcc17160b0d8fd047a4b4650c3cb205ea259c503a5f2383bfc28635e6d",
      "text": "Matur nuwun, Pak. Kula nyuwun pamit rumiyin.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b23f65405e46a82b3f32b26134afb579d3e11a9be8b9fbffb48450c057f751a",
      "text": "Kula sampun nampi seratipun, Pak.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d1a292e4e7e29d527e3cc3e37289b84931ab6b939525da3f2ab1ef0a40989b8",
      "text": "ndara",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e4431d5c6d5c89b932fb174992029ce21479da4ed7a0fb7472377dc5eb46214",
      "text": "Wah, menika menapa, Mas?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f16ecf5076e683a794eaf3935ccc525ee62d583823679c32f55a743dfed8355",
      "text": "Sampun tigang dasa taun, Nak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "71eb1dd92f8e9a24b9a1307e7b31ecdeb171ffa9c8ad14b22e1e11b325d85ed6",
      "text": "Abdi dalem matur dhateng Sultan kados pundi?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "720d47325a92302fcc5d2cecf4f32fd0654ec2f51d378432f5a2475c4ca0945e",
      "text": "mundhut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "73180e8ffaa88dac9f9ea93dbe1ea66aa5c446d13d66f94f58608cf4bf2f4872",
      "text": "Matur nuwun sampun rawuh wonten syukuran kula.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "762249f7685461de5783853275a1e43eb2b47afabfe9d40762c21bea4234acc4",
      "text": "nyuwun pamit",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "768d09873db15d681817be59f722188dffc7f2ff347bda5f500d4afa4598dd18",
      "text": "Panjenengan angsal gelar saking Ngarsa Dalem?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7887ca8f0fc72eb6aec2e96db7cf8292944c6e5d583c91d00b26b323a9df467a",
      "text": "ngabdi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ccf6384acf097e27ef36a89c2d0134acb343ceff79797976dd84e80e2e2d8fe",
      "text": "Prajurit ingkang wonten regol menika sinten?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7edf62151d9f11d4d25054625f7a09cb76e81b8c5c41288ead7d04bb6fd8af65",
      "text": "Kula pinanggih Pak Sastro wonten bangsal.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f5b826f612d2eb2e9f52c427d7ab6e55953c50fbf551bfb416d43abd0c70a63",
      "text": "Matur nuwun, Nak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8407b2507a136d7510f38266a071dddb2caf5d66c712d4c127d2c45f002f9137",
      "text": "Pak, kula badhe matur. Kula sampun saged basa krama.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "85b3d3c7998df3faf05aedb4627722aeced2ccc5e3750351e1dcadb777a4777f",
      "text": "Kanjeng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ee867f9e2d9afca6d4ac7a8e29b989ebe45406d8917e6eb5b0ff44b2228fc8",
      "text": "Kula nyuwun pirsa dhateng Pak Sastro, abdi dalem Kraton.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "880a491f91ff1f1e1b2dab63a2cd1008116fa7134a77dade70520dd0b66d4aa1",
      "text": "ngaturi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8996ff2415094dd91aa613054c143f612f2aa377666be5405fce96d119197cd9",
      "text": "Inggih, Mas. Wonten menapa?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b66565cda0e5084758844960db9cd29bfe0aa234bf78091044d63479d5d6459",
      "text": "Sugeng rawuh wonten Kraton, Mas.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c332fba2a64b67d5317cff40f8f5276e363f9d25b36264fdaa6ba9e3f94f260",
      "text": "pangeran",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb63172449a6eba172b388881562e8890f70bbeec70a4c8fa7fd1a3b7bd4bfc",
      "text": "Bapak badhe mundhut menapa?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d99044e91dee05e0e6fd8849c795a8ecf8d77da0e74dccd6837d7f6aee41730",
      "text": "Mas Mohamed, matur nuwun papirusipun.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e30dc59a22523868ed8635d76c6ed3cf74443c5df8e5263d97f98f0958c1ea4",
      "text": "Inggih, Pak. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e9e384881925361ef67ae2304579e6864c4610e168beb8b7ea2d03e45f2ec91",
      "text": "Aku wis ___ layange.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f90cf7f3bde0e5a732f99f404a38819a56136bb7378f380183c8b1a0506f68e",
      "text": "Simbah maringi kula arta, kula ngaturaken jeruk.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "9154f08d8a37e001b671cbf2a78c48b6467ffd714ccc0bcc6e100a5c5af6664b",
      "text": "nampa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "922e16187f9d5ac0e9da47655b73336a9a95101feb0ead9767fe108b868d916c",
      "text": "nampi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "93188611b81a914f82ea9fe9d7caa541a8a55873f3368ed39168e03e94642ead",
      "text": "Pusaka menika kagunganipun Kanjeng Pangeran.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "93a03f5dab56106f77c55c466b6773958ee5fcfce28bfe88dd1ecf2bccf5842d",
      "text": "salim",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "950c46bb21821c28150a95cfcbd034989973d3e9806ec66a3e6320c3bbcc6537",
      "text": "gelar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "95aa0817a19d67e1a476bad38a64e987fd961a6650555ff6854c3ccb629bec59",
      "text": "Jam sanga, Pak.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bab531e3d4fa7ebe88b61f7a332d8e63ce7ba379aa1654f53cfeeca72f082b2",
      "text": "setya",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bcadd7c8c1dff0706487c2ba9f3bc96348f2156e4bdebd487e288c18e425484",
      "text": "Nyuwun pirsa, Pak, saben enjing panjenengan sowan dhateng Kraton?",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e2f2880d9b4bed09ce2ab84cb67d83c6e4c2b2027bd8972a65884db4a36704a",
      "text": "Sultan kersa tindak, abdi dalem ndherek.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f7d92f2dfd2806fa824eb64da6e352278f0479b7dfadaaa9d72535607a446fc",
      "text": "Leres, Mas. Krama sampeyan sae sanget.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a578034390505fed1839cd16d3111d3de498f3532775ce285f424bcebeca1657",
      "text": "Enjing kula ndherek Pak Harsono dhateng Kraton.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9da60f241cdc80aba632d2af07d8846d011538210ba5fcf765ed573bbdad5a9",
      "text": "pusaka",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "acdfb45b7ecefc281edfde6881603a8083732304e75b69bfd60954ce8e1b3491",
      "text": "Inggih, Mas, kula badhe dhateng.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad1cd897f883c7bbe2e4f944d868c1caf51c9f1ca570ccd3537870362338c382",
      "text": "abdi dalem",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad44a01f7eff7e5624e486402a4d97205a34c064faaeeeeb2569d7f847798a75",
      "text": "Pak, kula ngaturaken oleh-oleh saking Mesir.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "aea66ff5d1027d50f0d3275327833d47ea327016ae1d0ecebda64049d5dab59c",
      "text": "Ngarsa Dalem",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "aec0cab0e55370897651c3e56c985564b2c73596a3f453a95c0c8bce2cc00ad5",
      "text": "Pak Sastro angsal ___ saking Kraton.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "aed11d101b32861d141b5c031e3254c7edfa0b25f87a2706f934f2de18667960",
      "text": "ndherek",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b192d83826407009385a7c6399f46c8ee6bcb7a36a2e54f44050b683722d8c4b",
      "text": "Pak Sastro, sampun dangu ngabdi dhateng Kraton?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b702e10552a8a5517f63594bd7a23241c2dd660f139e0c355ce18781a355884b",
      "text": "maringi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7409cabfe8ee806bc778cacfad1ba429142dbf91909784278ffee3331b2c1fd",
      "text": "Nyuwun sewu, Bu. Kula badhe sowan dhateng dalemipun Simbah.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b79ddf92cdc6d7a486bdaf2a7a1f3294c5b197636e5371d5aaf24e0e9e78000a",
      "text": "surjan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8b76d1fbbaf9d477a71486f1984476d31be321f05f465106426fb708afe3888",
      "text": "Inggih, Nak. Kula abdi dalem.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba45306d74f23ca239cf761f3010177d642b4d48dde9ca7a636d7dd3a3207145",
      "text": "Bocah iku salim karo Simbah.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2101dbf28230d4fe49d62bb56fa4a8319b60d0b3e8aad3518e1e53abffb8d9c",
      "text": "Menika pusaka Kraton, Pak?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a45cd9cb69c7d81f1f50c1b5fbfee199e0e903455a4361f2ed9b6a8698f385",
      "text": "sungkem",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5f1e3cb6b1bd5a643aad7f9cc9fcb2a956c5cc0deb086ffcc386550a0ccb28e",
      "text": "Nyuwun sewu, Pak, kula badhe matur.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6b943314c02125cfdd6aed5f8a21ea47518f9e139a854ca592cc80b96620527",
      "text": "Kula badhe matur, Pak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8136c36336dde2e45d7a0ac9463ad337732d8bbd093e9c5560533b41e85200e",
      "text": "Inggih, Mas. Sampun kalih dasa taun.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbda048300b438ab7bcc60c8ca21013a9489f412a303324efb3dec8ebe338d1b",
      "text": "Benjang kula pinanggih panjenengan wonten bangsal, nggih?",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc164fb6bc7d9a03015952596791a769b4fcdd8855ebb94345ffa2f2aee96bda",
      "text": "Pak Sastro ___ sanget, sampun tigang dasa taun ngabdi.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc49725b2dc2433c84a8a3c9c5519155d571321e1a1e62768291ab9ac9e8ce98",
      "text": "sultan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccab1d9ca3219b882af8fb44fe6d807b4ed2e24fa1d5273151d7a452937526a0",
      "text": "Nyuwun pirsa, Pak, Taman Sari wonten pundi?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0f2402e5e37e205d45cb09c8b5de627418d06655feda548c0bceed50f2f8e40",
      "text": "Sugeng rawuh, Pak Sastro. Mangga lenggah.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d12d36de55e7b697cbe8c6205520929dbf80284566986799dbabf686cd969822",
      "text": "ngladeni",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3bc2a78aa7ca3387df25e1350b249255c2e9ba7b116b279a3abe241874ca316",
      "text": "prajurit",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d702d3b1a49e355a46d682f20fd3101d0f7fffcc3af97b43cf96b12e0ce85125",
      "text": "Wah, matur nuwun. Jam pinten, Mas?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d941c8ecac99f780dee806c756c6391d541ff0252f195aea80d1480e5fc4d4bd",
      "text": "ngladosi",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbf4f85628337b91d5fc41354f977136e0aeb2e6627fc5ef684160b6d351f56c",
      "text": "kraton",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e11bbf9c2298ff3b879ddd9b0d29b75356eef10bb991f55ce90f5221cd34002c",
      "text": "Inggih, Mas. Kula abdi dalem Kraton.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e20ca21ba94c865800679d878b35a70fc9362758edb09392a5b5f1d598ee59f2",
      "text": "Putra-putra salim dhateng Simbah.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26aaea55776b94b9986fda3772a4dbc646b210625b8731426daeb2dff8bffc9",
      "text": "Mangga, Nak. Ngagem surjan, nggih!",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2c154b5df18547063fb24fa43e236d38355f51c2e0751bd102f237c7f3a766e",
      "text": "Mas, mangga caos unjukan dhateng Pak Sastro.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3ee680566cb086577e195e487c4225b06d6db8183ae1850393dbac3a45c18ff",
      "text": "Simbah maringi kula jeruk.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e51c4b21d53e7d40ac6fe9f5bd75ba615c35bf3de50c406936a437f0203ea95a",
      "text": "nyaosaken",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5bca7f32865872da1b5e3419d0b82e2abaf5cd31d66454c6bcdc46835b62a9d",
      "text": "bangsal",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e636717c0c3a234479f911f4d3511cef60b224cf909c0ec6264fba780502f7c1",
      "text": "Kula nyuwun pamit rumiyin, Pak.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e85cea767c6ff91e990c24d2e24c8da8ecd0e75c6cd1da758a840b8a5e34708a",
      "text": "Sami-sami, Pak.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9805f21fa92448f270525894affe8c74a807ae90789b6af18b34258351af2ff",
      "text": "Wah, matur nuwun sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9d149b999c0403187c2562fef36fadfaeba717258a3e26c499252508349dd9a",
      "text": "Jam pitu, wonten dalemipun Pak Harsono.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "eae2be848cb9e76e9dd4b8c850c543b9f17fb616d6e3cb7e18880c5cf0f30511",
      "text": "Caket, Mas. Mlampah kemawon saged.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb5e3f4b8f712257da07b78fb2cbb60568d48d4b5f8a05459f9d186b62dd38dc",
      "text": "dhawuh",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecf5994bda8bb6c07b500876fde8523f12c2e46423b2ad0d022667ef8dcc6b16",
      "text": "Sami-sami, Pak. Minggu enjing kula badhe sowan.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef193b5fe91989c418fe1856f791fea585867d6547dc992cd60d52c1e279341e",
      "text": "sowan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef325687ac6a67afcdaff6dd469d9ed3623006a1e5d7bfc46f1c9596f1c54495",
      "text": "matur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2e9f6dfddb91e187cd2c578e72bc2eca054ee5318fcf4a09d165a859356f790",
      "text": "Kula ngaturaken papirus saking Kairo kagem Bapak.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4fef48def4f52f8e0e61f2fa2f8d822181b7867f87668b33e2bfa44987c6dc5",
      "text": "Matur nuwun sanget, Mas. Sonten menika kula badhe kesah dhateng Kraton.",
      "voice": "jv_dimas",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "f54685fbd63a835ff82d409fceed48dade9ba49042a8d8be6ca1626f0c89272d",
      "text": "Kula ngaturaken oleh-oleh menika.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7aff0975af69f0f3d80788fa9cbf268e728bb77408e9538cc7b7db39ccb7239",
      "text": "caos",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb9fb136f7aee9b2e0a9e5de0fca9bf5ba737751b5d0307658f5d2b1db93b3f6",
      "text": "Kula ngaturaken papirus saking Kairo, Pak.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
