    },
    {
      "id": "j4.u03.l06",
      "sha256": "5c99d4c1b1c6d5521a0c5b1fd77fb7458b4f3efe3aed4bdb1359cc243f24845a"
    },
    {
      "id": "j4.u03.l07",
      "sha256": "b6db34832b90eacdd38e9fd257ba89075b54054f6c24ee1c6a9653f7daabac97"
    },
    {
      "id": "j4.u03.l08",
      "sha256": "8f4236e3e77f684d0799a4a267c7704fefa04871db6b1e5cef203dbbc7e4f963"
    }
  ],
  "audio": [
    {
      "key": "002cf7f4afa63e720c8db431607b5d3391a1addb979ee7ac626e064a1edacba4",
      "text": "Matur nuwun, Pak. Panjenengan abdi dalem?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "028ca3b94009e6d443c65858561d6d6d393f43bf7ea869dc920e285c48895353",
      "text": "Setu sonten kula damel syukuran. Kula ngaturi Bapak rawuh.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0627ebdfead3389ad46be879f52fc61e347cd1ce1018776ab3e6031fa10aaf6b",
      "text": "Kula ngaturi Bapak rawuh.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "06bc17907113a46c885b5a4aea47280a5c60ba34cde430e5cda447bfa079db05",
      "text": "nyuwun pirsa",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "06e3271a725c95e6c72595e0cd6c79bdbcd99985ea7010865963e3263a5ade35",
      "text": "Nyuwun pirsa, Pak, Taman Sari wonten pundi?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0965721e4828b4f0ea9ffcc8e785e1c0e3d34b67419e04bc3445175e40996af3",
      "text": "Kula nyuwun karcis setunggal, Pak.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d9550b6e5c0254676a1913d9ba145dfd1c3e7c7b9afee2b49be6a0874e759c5",
      "text": "Pak Sastro maringi kula buku, lajeng kula nyuwun pamit.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e1006c54e7d763f3993c0e3325050ee6bb58da007573da5f03be94351c0bd60",
      "text": "Kula abdi dalem Kraton sampun kalih dasa taun.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "152d6249a9adb864b20161d440aa19127784019b767a5bbc467589ef2d17fa99",
      "text": "Inggih, Mas. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "17155e66fdb7e3719539c8df8eb30e9438c36d24090fa808b33fc61f10353312",
      "text": "Kula ndherek, Pak!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "171fb81fc28a55c3b99f6af62544c907271173ae2d289ec8b10be6006116a49f",
      "text": "Saben enjing kula sowan dhateng Kraton.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "19fa8b625ae15c4708001ac9fdc9c5c375e07340b23f39a4bb647df858cf367f",
      "text": "Simbah maringi kula arta.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e759fec8a66e1cd87f36a88cc1a8087c88f4531352601e838fd94de26e4bba4",
      "text": "Minggu enjing kula badhe sowan dhateng dalemipun Bapak.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "212b2c94886846455b517af505e34a1b6cef9eb96f4055433eed850df2898e82",
      "text": "Kula badhe sowan dhateng dalemipun Bapak.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f2d0efa56110375c10bed0c29a1542a2ba856e8b41710919ec88295d367c3a",
      "text": "Papirus saking Kairo, Pak.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "24dd794e39834077916a27409a2f3d342426295da7fd3392ef1e87f5d4cf720d",
      "text": "nyuwun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2599d32405c41aee7b321f714df2bbec88a3ce57fb109b536324dc0bc3028c2f",
      "text": "Abdi dalem matur dhateng Sultan.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2802cd15ede733fe2d5408a8f2e34206f2b42bfe1b245bc4da767190b247e326",
      "text": "Kula ngaturi Ibu rawuh.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "29db5ac42ad0b3200847e9e10e3ce6ef1f079f2f4729e3143757ad83bbb18406",
      "text": "syukuran",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "333c06d32a83341baa97f022e96c885ad3cbd994c38eb226480614fbb4512d3f",
      "text": "Matur nuwun, Mas. Menika kangge Mas Mohamed.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "36315238f23dc233d56ebb975cd6d0ba701bc577abc0dd38b22bfbbeb6a60d0e",
      "text": "Inggih, Mas. Mangga. Jam pinten?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3717ca7e1607d1277b9ee57282535505abb29789f45c48df679b57cdfd758dd5",
      "text": "Wah, sae sanget, Mas.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "378b446fcb9fcff5d8363eb27622f9bf0ff34e8f89ad09590b1984de7aa2ab63",
      "text": "Wah, dangu sanget, Pak!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "38dddeb1a7ff27aff663708d2bbd5484b72937e6250325e3ce1b4e3c5cf4191c",
      "text": "Setu sonten kula damel syukuran.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "39d4a240a21cb2e1956910bb7e7daf1816c2878727a2aa4a422425ccc414b9c7",
      "text": "Matur nuwun sanget, Pak. Kula nyuwun pamit rumiyin.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be062bf40dc5f04ec6aec98c8a6aadfebe00d17320e0afb9e9f04f089da1be4",
      "text": "Kula ngaturi Bapak rawuh wonten syukuran kula.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4320fd564af9d3f444219cbd9c358c2695b3a62befef4a5f7491e6e05e45a641",
      "text": "Inggih, Pak, kula ndherek.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "438ef1b3a3a65e523ef0bada78f8495006610d11aca1ab56f4f2ef03a237e876",
      "text": "Wonten, Bu. Pak Sastro maringi kula buku.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "46a6926807b765b9194233f6d86a904ebed34331fa888c0a57a39ffc754da3ca",
      "text": "Inggih, kula badhe dhateng.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ab4050c598b1f9631a4d73c340162383ef08a19c60505f5bc83f4007bd542cb",
      "text": "ngaturaken",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cd9247c23f64ed3f02f621e2568d2d486e44e95fea08fb594f6c3714908bcde",
      "text": "Sultan dhawuh, abdi dalem matur.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "58329d2a992301e576a7499117eeb095598c08879ca8947adcb4643c79e75a94",
      "text": "Saking Kraton, Bu. Kula ndherek Pak Harsono.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dd06b48d8febb8b8ace03f509395fd82917703fe8b1185050c7821dcc38e353",
      "text": "Inggih, Mas. Sugeng tindak.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "606ed991503221bae12f25fc52518640041bba5f5a867c8f20ee3e35b60856cf",
      "text": "Mas Mohamed, saking pundi?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "60c2661162dfbb4f94730c21e4afe18ed943fad582f9b07e608bd923d971bc38",
      "text": "Pak Sastro, matur nuwun sampun rawuh wonten syukuran kula.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "68ba568ca888e0665d2880e28d81977c32f3f8b32f44437cf49224b623d0d28e",
      "text": "Krama inggil, Mas. Sultan dhawuh, abdi dalem matur.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "699b10bcc17160b0d8fd047a4b4650c3cb205ea259c503a5f2383bfc28635e6d",
      "text": "Matur nuwun, Pak. Kula nyuwun pamit rumiyin.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e4431d5c6d5c89b932fb174992029ce21479da4ed7a0fb7472377dc5eb46214",
      "text": "Wah, menika menapa, Mas?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "71eb1dd92f8e9a24b9a1307e7b31ecdeb171ffa9c8ad14b22e1e11b325d85ed6",
      "text": "Abdi dalem matur dhateng Sultan kados pundi?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "720d47325a92302fcc5d2cecf4f32fd0654ec2f51d378432f5a2475c4ca0945e",
      "text": "mundhut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "73180e8ffaa88dac9f9ea93dbe1ea66aa5c446d13d66f94f58608cf4bf2f4872",
      "text": "Matur nuwun sampun rawuh wonten syukuran kula.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "762249f7685461de5783853275a1e43eb2b47afabfe9d40762c21bea4234acc4",
      "text": "nyuwun pamit",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8407b2507a136d7510f38266a071dddb2caf5d66c712d4c127d2c45f002f9137",
      "text": "Pak, kula badhe matur. Kula sampun saged basa krama.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ee867f9e2d9afca6d4ac7a8e29b989ebe45406d8917e6eb5b0ff44b2228fc8",
      "text": "Kula nyuwun pirsa dhateng Pak Sastro, abdi dalem Kraton.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "880a491f91ff1f1e1b2dab63a2cd1008116fa7134a77dade70520dd0b66d4aa1",
      "text": "ngaturi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8996ff2415094dd91aa613054c143f612f2aa377666be5405fce96d119197cd9",
      "text": "Inggih, Mas. Wonten menapa?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b66565cda0e5084758844960db9cd29bfe0aa234bf78091044d63479d5d6459",
      "text": "Sugeng rawuh wonten Kraton, Mas.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb63172449a6eba172b388881562e8890f70bbeec70a4c8fa7fd1a3b7bd4bfc",
      "text": "Bapak badhe mundhut menapa?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d99044e91dee05e0e6fd8849c795a8ecf8d77da0e74dccd6837d7f6aee41730",
      "text": "Mas Mohamed, matur nuwun papirusipun.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e30dc59a22523868ed8635d76c6ed3cf74443c5df8e5263d97f98f0958c1ea4",
      "text": "Inggih, Pak. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f90cf7f3bde0e5a732f99f404a38819a56136bb7378f380183c8b1a0506f68e",
      "text": "Simbah maringi kula arta, kula ngaturaken jeruk.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "95aa0817a19d67e1a476bad38a64e987fd961a6650555ff6854c3ccb629bec59",
      "text": "Jam sanga, Pak.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bcadd7c8c1dff0706487c2ba9f3bc96348f2156e4bdebd487e288c18e425484",
      "text": "Nyuwun pirsa, Pak, saben enjing panjenengan sowan dhateng Kraton?",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e2f2880d9b4bed09ce2ab84cb67d83c6e4c2b2027bd8972a65884db4a36704a",
      "text": "Sultan kersa tindak, abdi dalem ndherek.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f7d92f2dfd2806fa824eb64da6e352278f0479b7dfadaaa9d72535607a446fc",
      "text": "Leres, Mas. Krama sampeyan sae sanget.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a578034390505fed1839cd16d3111d3de498f3532775ce285f424bcebeca1657",
      "text": "Enjing kula ndherek Pak Harsono dhateng Kraton.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "acdfb45b7ecefc281edfde6881603a8083732304e75b69bfd60954ce8e1b3491",
      "text": "Inggih, Mas, kula badhe dhateng.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad1cd897f883c7bbe2e4f944d868c1caf51c9f1ca570ccd3537870362338c382",
      "text": "abdi dalem",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad44a01f7eff7e5624e486402a4d97205a34c064faaeeeeb2569d7f847798a75",
      "text": "Pak, kula ngaturaken oleh-oleh saking Mesir.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "aed11d101b32861d141b5c031e3254c7edfa0b25f87a2706f934f2de18667960",
      "text": "ndherek",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b702e10552a8a5517f63594bd7a23241c2dd660f139e0c355ce18781a355884b",
      "text": "maringi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7409cabfe8ee806bc778cacfad1ba429142dbf91909784278ffee3331b2c1fd",
      "text": "Nyuwun sewu, Bu. Kula badhe sowan dhateng dalemipun Simbah.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5f1e3cb6b1bd5a643aad7f9cc9fcb2a956c5cc0deb086ffcc386550a0ccb28e",
      "text": "Nyuwun sewu, Pak, kula badhe matur.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6b943314c02125cfdd6aed5f8a21ea47518f9e139a854ca592cc80b96620527",
      "text": "Kula badhe matur, Pak.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8136c36336dde2e45d7a0ac9463ad337732d8bbd093e9c5560533b41e85200e",
      "text": "Inggih, Mas. Sampun kalih dasa taun.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccab1d9ca3219b882af8fb44fe6d807b4ed2e24fa1d5273151d7a452937526a0",
      "text": "Nyuwun pirsa, Pak, Taman Sari wonten pundi?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0f2402e5e37e205d45cb09c8b5de627418d06655feda548c0bceed50f2f8e40",
      "text": "Sugeng rawuh, Pak Sastro. Mangga lenggah.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d702d3b1a49e355a46d682f20fd3101d0f7fffcc3af97b43cf96b12e0ce85125",
      "text": "Wah, matur nuwun. Jam pinten, Mas?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e11bbf9c2298ff3b879ddd9b0d29b75356eef10bb991f55ce90f5221cd34002c",
      "text": "Inggih, Mas. Kula abdi dalem Kraton.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
