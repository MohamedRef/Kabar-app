    },
    {
      "id": "j2.u03.l02",
      "sha256": "da8521ed4b9ddde7288e38448391bd754933ccf4a77daceefe59868dc46dec15"
    },
    {
      "id": "j2.u03.l03",
      "sha256": "d0f6a7997cc4fc1b2c6e924a67b929cb16bcff404309dd147b07ba5225e87242"
    },
    {
      "id": "j2.u03.l04",
      "sha256": "98a590543d32dce781df2b67d4066921951cda4f5a0fcac036d2f2fb1845340f"
    },
    {
      "id": "j2.u03.l05",
      "sha256": "f232a4448b7a00b990dc6f6fa612f9652bc93b708772cff3e0b39fb10a568517"
    }
  ],
  "audio": [
    {
      "key": "0218b7048d8f253cfd26ba732f7e55f8ceb77911e41a2fe9df336912fae89305",
      "text": "Iki satus ewu, Bu.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c1834b51dd05a9ac1ee399146467f039dac70e394a7312c801b49835a8ef30",
      "text": "Umurku selawé taun.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e045b753ca4361a92b3808e6c400bb8c381f2e66547703c7f854836bb6d7dbc",
      "text": "Iki susuké selawé ewu. Matur nuwun, Mas!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "18c14448e4c682f04fee789e8bd25617f8bd959d862b3e63a0ac44c12eacb036",
      "text": "Selawé? Mbakyuku uga selawé taun!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "20ecbf1ee001b54a5ffedd6a9cdfc67a7b083ab5fd9a2fa97e2bd18275296198",
      "text": "Wah, larang. Oleh kurang, Bu?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2866311b4701757c1a8ca83480d000c735c363b40cd7a3062ca89725315b02e0",
      "text": "Le, karungé ana pira?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c4b57d9e3a3cd2021838a97bf1748c509eb2f1d033fa3fab53e3a64b9c28353",
      "text": "Umurmu pira?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e62f0b3eea4b643eca8a8a14940624a5768a0649f8c41fdcbcbcdfb8974168f",
      "text": "selikur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34856efa8ab2f89c2d7095d585b2d92b5ebdfc0cf0deb7aa7982f363aa77d836",
      "text": "limalas",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f829d1bdb2c987ed1549359e25f809bc7560c4c9df2efbfbed67a9b6e7700d",
      "text": "Mohamed, bawangé sekilo pira?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "35ab8d12e6168a3ada2669ffa5765640f848c60c94b3eb8f0b98855b3e2a8714",
      "text": "nganti",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "37214c71e9ac5c244fc81df024fac6b81b6323d9daf02c5ddcb0b1da51fcf092",
      "text": "Mas arep tuku pira kilo?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "3799b2125f458d5ca423648dc6c27fe305e44fcdab8a0ee48596069520838c2c",
      "text": "Ya wis, selawé. Kabèh dadi pitung puluh lima ewu.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "37a41d0c6d12755f8f5220fce9cf50fbfa0f53f09f15d5d1bed695d54b640b4d",
      "text": "Rolas taun, Mas. Umurmu pira?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f58ead99917b17e2d922846e2e7a481fd69fcb448d42ff1a4eeb596663be9c5",
      "text": "susuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4247e1467f6fa4481f073a91b243a56ca5b810a4dd9b7bd1dbadee741cf6fd27",
      "text": "HP-né regané rong juta.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4637bc9342cf325edc24db1d1ca773462c9803dd3058ae51b064af41cb0c9374",
      "text": "kutha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "47b9af60c11e2b8255c99b39f5ee0930e285efb8e275d9b47aac96ce0b70f555",
      "text": "60 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a6791f5bb86da244e9ea9ad762bda70be0285747ff828f5281d9162a506e530",
      "text": "Selawé? Murah tenan!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a8950a926c5daf3ac69633a449d7cd8bac629adf5a50a28f7fe57ff48cdcafe",
      "text": "taun",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a9524a7a7108af27bb55ca766afa97facfbc7bdd93133f33aee6968db5121a9",
      "text": "Oleh kurang, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f778dbd6caf70a5120e3d71835182716868fe5fb3432a6d12fa998665d816df",
      "text": "25 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "506ace1605615a8334d25d94d35a44b4b74c03b0e82c14e3253eaef5f3bf3a2d",
      "text": "karung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "57c42c3dfc79ca2afb5c289b37bc0c158fdee113cba5a7e2675dcb99f359ebec",
      "text": "Wolulikur ewu wae, ya?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bf1c3c1b2f71c498e64aff0f8d5b6f2d9acb6a893105550ce9b783c3e546b52",
      "text": "rolas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "628f484bd974faab9f10e44a0a1ae29b95ceebdb0d72cb33ab3fee0e615c64d9",
      "text": "bawang abang",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "670116da610a98a7a87646c15942004449480e3563e0f9759d14d4be10d59026",
      "text": "Seket! Nganjuk pancèn kutha bawang.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6711d6666a896935487769110d72681c0019fcfd66215709a48e329906892210",
      "text": "Iki durung kabèh, Mas. Kabèh ana seket.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "68fd3edf9bfc7ea9ce9ba4e5e65dd157974ddadc4d58bed912ca23afbe0c259f",
      "text": "Regané selawé ewu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b0bba7155479d75516e0daecd8cf7aff2f9a5cf91db04bb8164949df60c5d7e",
      "text": "Apik tenan, Mohamed!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c132984fbd80891d83fe21ce2d0476966b5404c950affb56360216993f99e0a",
      "text": "Ya wis, oleh.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a4912dc2b5b3f10a5b264c594be5856ce0b44cf9618057f2aee74ab2d6cad0",
      "text": "Seket ewu wae, ya?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "70b975930787977a64c8bbd9602ecae9ef1514283bc1be3432a6cc577ffec24d",
      "text": "Iya! Kabèh pitung puluh lima ewu, susuké selawé ewu.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d418acea78e1fec9373fb2e749ed092071622ab1f5eb57ba1b2d4283d3a7aa",
      "text": "Bawang abang sekilo telung puluh ewu.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7148701eb7346fcc7888efd12e459d539599b46e2aa64670968274a0e5edbcd7",
      "text": "Karungé ana seket.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "72484c024e42684e1b479ba43705d1794c7892704a39695578b87dfef63c6504",
      "text": "Susuké selawé ewu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "746dff68e5f9c3f427507975d4ed1b7ecf29b4152fe0618521bfd20db6e3cac4",
      "text": "sewidak",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "759e3d7476cce8f36079680608e85f98450143d7857b9592b5502dca1f32ab1c",
      "text": "Bawang putihé limalas ewu. Kabèh dadi pitung puluh lima ewu.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "776de520bfc18ede4c8b7bb4a478f2549f21c499b72528a8c9c145216c4882eb",
      "text": "sekilo",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e6def0268dd2e13ca3d04757ce1f053f0e2bab8ff7a04832cf3973a2a683d65",
      "text": "Selawé ewu. Aku tuku telung kilo.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ec9bbb5b6aca5b9880ba8160cfd29eb5e0da4c0acbc4c01ab0ab03b6b4ad85f",
      "text": "setengah",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "823c4486bfb77e9abc34b70073b5dd2422d64aa8a18b04dff395ac3b26e5070b",
      "text": "Umurku selawé taun.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "88322076f557822ee469d6c8b2acb7a1d8d0a18af870f4d964e9cc26ed1671c9",
      "text": "yuta / juta",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8916c7eaa418d86a28f0cae9bd7707cd587116ba93639e43530011b9a9db77b1",
      "text": "Umuré Pak Budi seket lima taun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c9664678789bf7a83d7e5f4ed328b7f21589a84b38aeb1fd66162310eecc8c4",
      "text": "Selawé ewu wae, ya, Bu?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7679fdd4d9b1f0b561e0da42a432f68c003959c7141bb52f1f9ce4a3f29f43d",
      "text": "umur",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "aab5bb6ae0344db1fc248ab1bc1f19bce1afe3540e37c6c3fa73ea2b26574305",
      "text": "Selawé karung bawang? Akèh tenan!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ade461a7654ab7a4947f3619f1be3411c9eee6ddf1ee98daf68f3b4d32c34541",
      "text": "500.000 = ?",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b196fedeac4919906eb70d6e2c3126045acc2e166b4e5db8485cfd526d5614e8",
      "text": "15.000 = ?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b81c30cc42e03a600e2ae6c27453708316f8d66614466df7387ffade4e7c27e0",
      "text": "Sewelas, rolas, telulas … Ana selawé, Bu.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9036772fa110531de31afc9a48f86d7396e089893d18facf94d8cd237cf8754",
      "text": "dadi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b947afcbbfb25d2b86160ff442c75356b90653576f99cee1ba4d6d46f5a11d2b",
      "text": "seket",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9ee25c9fb67e463617ab47dcdc3f93e2da9e7dfc0ad681384f3b72f50ca0d9f",
      "text": "13 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb93f72e6c2bc6f19e841878943f7ec6c5f759ee2b26cfc56d8cd921f23c2702",
      "text": "Gus, umurmu pira?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2eb4500834ba61f9b81b1889bef4af59008685f4e84747b78724defa6558517",
      "text": "Wah, larang. Selawé ewu wae, ya?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c93c6da81e58e842f697e464e62cede4147273f345e4dc24b89dfbfc7d21e9",
      "text": "Bu, bawang abang sekilo pira?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "caf740adf9f88c1a5fe56100f92748fdc72949f43c17bc97f258fcbb953e1374",
      "text": "Regané seket ewu.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d03de45a2d608f2abc102ab0704e410dffc6fac1e0815caa1128139d961e5a92",
      "text": "15 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2a5da23b5d4125163fa872c39edf0acb14b9821cb78721e5306759390b596fa",
      "text": "Aku tuku rong kilo. Karo bawang putih setengah kilo.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83570f4589c6e13fcf9b9f31a4ecad95240219b14397cc57871cfe611018f93",
      "text": "wis pas",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "db4e3389ca5f917b6ec4f80c491eddcc662446f17cf4907db91463742cc66857",
      "text": "Wolulikur ewu wae.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbcadbf86fd3d2ca599993817fc4de689fa1cc8bd2d178dc9af7403eb52dbfc2",
      "text": "akèh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd20b8935fe3048d45bf97d094cacc162e878d278cde0eed0074626f6741295f",
      "text": "sewelas",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd58565db6f775656f1294307e977bb21707c17b0afd8fd70188ecab705f70e1",
      "text": "Kabèh dadi satus seket ewu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "de73f863c9f7d20ea082d2fc25f463b1ec5d2151f9c23bc8b07d87c2f0747e0e",
      "text": "seket lima",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dec16ba5a44c7fe812152431624b1c49c89cf8b80ead6516bfd40d930291ce24",
      "text": "Ya wis, selawé.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e2f4335580cc09ce13021dcb5f269db7b82cce57cef5f70c29ea1c21b16970",
      "text": "Seket, sewidak, pitung puluh.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e61a2170ae60563600f5047668d7491d9327b76e3ec2fbae9f37131f3a571599",
      "text": "Telung puluh ewu, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e834ebf2e4f8259b3e2b262b573d1109e7e97c5f0dc4fa60692fcd83423a9bd9",
      "text": "Bawangé ana rolas.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b3d7b641426cb47bf48cdd0cf5b66305a61c783e8d394e38f6faf2e61d3959",
      "text": "Iki susuké, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaecaab9f542b4372f480147c67f8bfcd297eb46d36055c5a3a346781817946b",
      "text": "Telung kilo. Selawé ewu wae, ya?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee06c9ea1c1db58fdd17a603d5d6705758f9f9eb2b7d9d0cb37d2246d837468f",
      "text": "selawé",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee4455269d7222663d65b35d2bb584a62975f6a18774e8267fae56cea09f0499",
      "text": "bawang putih",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd20fb8f9efa39e37da8cb51eb72c2e41b47db3ea7c7d64c2d7cdbb2497352ff",
      "text": "Umurku selikur taun.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
