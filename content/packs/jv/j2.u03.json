    },
    {
      "id": "j2.u03.l02",
      "sha256": "24a703565f38b19e1e8c1cafd97be99be7714228f51bc39d850b26f2d8194a24"
    },
    {
      "id": "j2.u03.l03",
      "sha256": "d9fb0ff766d28cc8a69b5eb356d8a6b63850d573e6d6e531d3c297f56e427b54"
    },
    {
      "id": "j2.u03.l04",
      "sha256": "4a1bfef939a9681b899ad3d49cc812134927bc1519ac5af134b1dde276007fa9"
    },
    {
      "id": "j2.u03.l05",
      "sha256": "b3688bf75e1b5dfcfb1c23c3de08edbef63f099b4802871bad5badb7c23c5f29"
    },
    {
      "id": "j2.u03.l06",
      "sha256": "06b8b27e25aee7c14623270066f03c358511f614ad9704ed00096112486a3cae"
    },
    {
      "id": "j2.u03.l07",
      "sha256": "19bbb8ec09e80a3cad687493855ec736c8c9a3a425dd3ff7e57c5bda66c36041"
    },
    {
      "id": "j2.u03.l08",
      "sha256": "ecfc85167349ea314368cbcf3eea6d8a7080afd335500394b6a7726f9b55eb18"
    },
    {
      "id": "j2.u03.l09",
      "sha256": "63770a955d53dc62248552b5d7b227a54c782fa555b00a2d882c493c2e9cda99"
    }
  ],
  "audio": [
    {
      "key": "0218b7048d8f253cfd26ba732f7e55f8ceb77911e41a2fe9df336912fae89305",
      "text": "Iki satus ewu, Bu.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0651853f126e18e066e9dca60555d578c9bcf90912e6715a5a84d47ffa82c2c7",
      "text": "Selawe ewu. Aku tuku telung kilo.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "089b51ea22fbc09ce832d992a6abd958080c749873e7d4686e95380022177601",
      "text": "kacek",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a5bf3a53104ba3c28eef77f3d2ee24fd4fc76e91df2ac680bb77b7a5cb6a152",
      "text": "Wah, larang. Selawe ewu wae, ya?",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a6b5b1af49a8cd544ff0e5f05bd33475be623a02fca437bf098dd019079fec9",
      "text": "Le, karunge ana pira?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c6c19ffeef50cb7d24398ac0603e379cf7b94d8fe90dc47b815b9de9e022777",
      "text": "tiwul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cab20e3f09846d3986ddd4a9a38048c4ae9ca91bba01f85beb2e0992e936d41",
      "text": "Regane selawe ewu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e2d59d1dde5d3de5cfe97a78f5be5c2da834ad80245ae8f3da0f43288d90c47",
      "text": "Pas. Tak jupuk loro: ireng karo putih.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ebc01406a0555ac32dc771eb91b0fa178ced3d30a4ab5d8f7db8fb65386d501",
      "text": "Rolas taun, Mas. Umure Mas pira?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "12ecc0d683c42783246ea56722e4d9204b1888951dc61e53ae32e385f820895f",
      "text": "Lomboke wis entek.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1392d08d81c66eea1794d03c431ee18a72b2f427ccf37806a11d06f3659ec422",
      "text": "Bawang abang telung kilo, wolung puluh papat ewu.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "13947390350884cedc2c98910540ba696ea657ced54b4ffe0d2dbc645830bae8",
      "text": "kuning",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "14df4337389ff2c1a5c62033a689c6613cd5298a6ab19ff0f3e1487c94505a4f",
      "text": "Duwite satus seket ewu. Susuke patang puluh ewu.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "15a917cccc1afbd2abc9000f051a864ce65d7a2d693a0b60ada119f014fc9415",
      "text": "Bu Karti kulakan bawang neng Nganjuk.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1738cb1af5433a034d522e36333e20ec9bff3e786207727e3dec475204d3866b",
      "text": "kaos",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b8183858ebedb5de39a5fc042e8d299d6a085c350adda5aece8a86535bc5d8a",
      "text": "Iki susuke selawe ewu. Matur nuwun, Mas!",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d24e076a03c905b432293d08007c496c04641bf69b542ea24901edd63c90319",
      "text": "Bawange ana rolas.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1da2ef15115d97bb15ebcc6965eb0f87fa494756327f35c8c3ba6cd4c5e6bdcc",
      "text": "Ya wis, selawe. Kabeh dadi pitung puluh lima ewu.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "209f5cc20a00c0a7ea0a9f5f7d74b179ee54c2d1115ce6f3eaceb3a90d9d4bbc",
      "text": "ireng",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "281caba02eb94b7e749f5fc869cb821e871505ffed36911181ad377273e4e286",
      "text": "Wis pas, Mas. Ora oleh kurang.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "29b23aed8fb20d96c18d778aec4b62bc2fa0d0a57fb23b47d13e8228d4707457",
      "text": "ngetung (etung)",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b388419be8d51d3c7bba7c8e256006b9ecd12e81cb322b0eb79072ba15b4d4d",
      "text": "Oleh ngenyang, keceke sithik wae.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b42ad481414ffc2e17bce54e9611612753cbd9605b50213aa31e9f835b036e6",
      "text": "Bu, bawang abang sekilo telung puluh ewu? Oleh ngenyang?",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c4b57d9e3a3cd2021838a97bf1748c509eb2f1d033fa3fab53e3a64b9c28353",
      "text": "Umurmu pira?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c9865d163eaa00e2c42688ad196655b2719fbc76a7813ef2a497d8923bc619f",
      "text": "utang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d5be60762007fc726c8bf2fe8cea4cc70ba54e8fdb0d3d938112ddfd88cd56d",
      "text": "Umurku selawe taun.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e110e6366c8605bd7d13d5c75a4b8d2cbd0185774a1f008d14d7926af185b52",
      "text": "Selawe, nggih? Keceke mung limang ewu.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e1801d45a33e4453ead9eccdeef590cd73c4feee1fa6473166b6a0c242117dc",
      "text": "Kabeh dadi seket ewu. Susuke pira, Bu?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e62f0b3eea4b643eca8a8a14940624a5768a0649f8c41fdcbcbcdfb8974168f",
      "text": "selikur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eaeaa25612223b0e129cdaaa420daec69812e139e261b7aa640dfe9f543db13",
      "text": "Umurku sewelas taun.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "318745d1a82f164c362e9950cd6d419bb0d58abd28044d55c1c9a6c32ecfba17",
      "text": "Iki durung kabeh, Mas. Kabeh ana seket.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "34856efa8ab2f89c2d7095d585b2d92b5ebdfc0cf0deb7aa7982f363aa77d836",
      "text": "limalas",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34c1cc8c7e58f7c771535c0848259352ffec68496278616ef1a8363ed3d2d03e",
      "text": "Bawang putihe limalas ewu. Kabeh dadi pitung puluh lima ewu.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "38820f47d559c891bd618045fd5a4a72370ee70247821e6d318de13229f86cfb",
      "text": "rugi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "39bbcafafc1436075ea84426aa75aeb0e83e91aeec4f315891989364cf5a88a2",
      "text": "tuna",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3babf3d2b8d031dd7271c524ab98012893714c8cc823be8778b18903e2da5f04",
      "text": "selawe",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c884a3d3f1b7e274ff2618b3bb8acba1d0ba862b26e79c1849016b9b5b1a784",
      "text": "Mas Mohamed! Langgananku teka. Golek apa?",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f58ead99917b17e2d922846e2e7a481fd69fcb448d42ff1a4eeb596663be9c5",
      "text": "susuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f6b11b9fbd4f31043a83a002e051c9aba4c6b9c379fcb91ca75cd8d2f1af9f4",
      "text": "Iya, matur nuwun, Bu!",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fea4f73c8d421985aa62ae6dbc1d50277cc60cda473f7d7327b4d42690e57af",
      "text": "Selawe? Lho, murah tenan!",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "41be19200431272f8c423dabfbf9d05ab9c9c4d71de146bad6f21d7548940158",
      "text": "werna / werno",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "42d52878a2007add1227c763583613f72499cd2fa277bf35cf377a27679cf745",
      "text": "putih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d6a89cf4687bbfd2190d5b96f59d2cc1c5771a7e96fc30564804e9b47ce0a4",
      "text": "Seket ewu. Jajal sik, Mas!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4637bc9342cf325edc24db1d1ca773462c9803dd3058ae51b064af41cb0c9374",
      "text": "kutha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "47b9af60c11e2b8255c99b39f5ee0930e285efb8e275d9b47aac96ce0b70f555",
      "text": "60 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a8950a926c5daf3ac69633a449d7cd8bac629adf5a50a28f7fe57ff48cdcafe",
      "text": "taun",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a9524a7a7108af27bb55ca766afa97facfbc7bdd93133f33aee6968db5121a9",
      "text": "Oleh kurang, Bu?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c5a93ee1eb5037478afe04af624d4039c232b9bab77c5e9593f91415b8ae7c5",
      "text": "Mangga, Mas, kaos Reog! Ana ireng, putih, kuning.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f778dbd6caf70a5120e3d71835182716868fe5fb3432a6d12fa998665d816df",
      "text": "25 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "506ace1605615a8334d25d94d35a44b4b74c03b0e82c14e3253eaef5f3bf3a2d",
      "text": "karung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "543def3151c7d9ce71675327abaf534d47624fde0fb9fd665777cc297110648f",
      "text": "HP-ne regane rong juta.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "54cd72025c4c76fb1de31f3d032d58f6394bdf62f6f64cb408712baee4635a49",
      "text": "ngenyang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "57c42c3dfc79ca2afb5c289b37bc0c158fdee113cba5a7e2675dcb99f359ebec",
      "text": "Wolulikur ewu wae, ya?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "57f906ae1c2004b3ecb4d8b8110ac1428ea3f758685dd53ea3b5cd0c0389691a",
      "text": "Warunge Bu Siti lengkap, aku langganan.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "58ec6fb4bce6e81aae71b0eb25f4eeed7a4fca12f9490c48ca73063f64b7fcd8",
      "text": "Iya, Bagus lagi sinau.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bf1c3c1b2f71c498e64aff0f8d5b6f2d9acb6a893105550ce9b783c3e546b52",
      "text": "rolas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca822d9e523d782fcd6bcc39ad6f4fc3b5284090325b334d68bb2695273b00e",
      "text": "Endhoge wis entek, Mas.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "628f484bd974faab9f10e44a0a1ae29b95ceebdb0d72cb33ab3fee0e615c64d9",
      "text": "bawang abang",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "67d5c8022895bd485c4b9fcd56c45b06388a74f8bb8490843d7e02ff2748143a",
      "text": "Sewelas, rolas, telulas … Ana selawe, Bu.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b0bba7155479d75516e0daecd8cf7aff2f9a5cf91db04bb8164949df60c5d7e",
      "text": "Apik tenan, Mohamed!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c132984fbd80891d83fe21ce2d0476966b5404c950affb56360216993f99e0a",
      "text": "Ya wis, oleh.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c97724cc499e8273497a885dd3ad6dc246eca4f0a9de1203188d2ae426fad48",
      "text": "Susuke patang puluh ewu, Bu? Matur nuwun.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fae9e7b853ac90e65b668d8ae00a0db6f538a197f43cfe3d258b77558206108",
      "text": "Wonge akeh tenan, nganti sewidak!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "702291b921d3457e422e18933a2531a8b85480e5d30b5a27cf17c022fb160b8d",
      "text": "28.000",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "707c04202b794902adc21c33dee33d4885dbfe65f983d1e8d713cde075cc0a61",
      "text": "lombok",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a4912dc2b5b3f10a5b264c594be5856ce0b44cf9618057f2aee74ab2d6cad0",
      "text": "Seket ewu wae, ya?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d418acea78e1fec9373fb2e749ed092071622ab1f5eb57ba1b2d4283d3a7aa",
      "text": "Bawang abang sekilo telung puluh ewu.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "736069f731235912e373ccdd9f035b69c9c030568ca46e0695e745b82a4f247d",
      "text": "Iya! Kabeh pitung puluh lima ewu, susuke selawe ewu.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "746dff68e5f9c3f427507975d4ed1b7ecf29b4152fe0618521bfd20db6e3cac4",
      "text": "sewidak",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "751659486db4c4fa8c0791ac318318706f74d4e280c04f8a1bce5487dbf418c5",
      "text": "Iki satus seket ewu, Bu.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "75c541051a0c3d694b33e1a932dd9ebf2789d22e5a55ff1847c3de34bec6770b",
      "text": "Ya wis, selawe. Kreseke siji apa loro?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "7764f894fdf8fcb93fb099693db8feb3813449d0323b1bb6cab5f16778571fa2",
      "text": "Bawang putih setengah kilo, Bu.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "776de520bfc18ede4c8b7bb4a478f2549f21c499b72528a8c9c145216c4882eb",
      "text": "sekilo",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c365662da1b96431db773b8f6d1c632b6715e770dc039649541345e376dbfd0",
      "text": "dhewekan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ec9bbb5b6aca5b9880ba8160cfd29eb5e0da4c0acbc4c01ab0ab03b6b4ad85f",
      "text": "setengah",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef57f0a988b0f52bbae02a889525fea1e9f878af02aa340675af444ceeeccf4",
      "text": "Jajal dhisik, Mas!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "830a8bb07ef42afc2404b13f796671d4fcf8b66b9cd927e56274c8df1b3c0bd2",
      "text": "Mohamed, bawange sekilo pira?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "86c94d24ac26d027c58aa88b5f07c404533149ee7fa977068a8264d34595164d",
      "text": "Wernane apa? Ireng apa putih?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "88322076f557822ee469d6c8b2acb7a1d8d0a18af870f4d964e9cc26ed1671c9",
      "text": "yuta / juta",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "886d24cef51b13e94b1d284cb11a8e39797f6d18966346b3539e23c241ccbfd2",
      "text": "Kabeh dadi satus sepuluh ewu.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "89b673070fd8b7e44afacc07a90eb7e5ce9889f1fc1444ca245de537dddba02f",
      "text": "dodolan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "89c31de91716a28c5938525cd983d1adb2c4cc641f309bcfd07251d430020a0e",
      "text": "bayar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "95b7f47687de2da981600bef1234caf98c6d204fc4b20e0c6d3c7eb6add4bd9b",
      "text": "Ya wis, tempe wae. Wingi aku isih utang, ta?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "96b979395acab1d007ae174a1a37f62bd03bf30dd6c2710f4dda72c7af1d5631",
      "text": "Waduh, Mas, aku kulakan wae wis larang. Mengko tuna.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a413c50668d4a240213ac471dcbcf12e44b1bfe578edd309292c919817a743b",
      "text": "Keceke mung sewu.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d77b022d1c460a5484ec7ab77cc1f2c22e0d4bc755edd618931408f1e5ebf57",
      "text": "Aku bayar saiki, ora utang.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f2509d4130fa96436ebda7cfada0a8b3a6bcd4a16d6d42c19ef9cac7e56a579",
      "text": "didol",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a15da2aa5362370a432a098c3e4b159947c071665d425de17fd3f7d25e2c64f5",
      "text": "Ya wis, selawe.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2052999d8c7afdde15b92d350898477836fa0f21c100d01f731a6161c85573c",
      "text": "Umure Pak Budi seket lima taun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a672ab2932a9280bd24d1448ee8e342f0b41e63e53405c13ac5e7e92ef5dc28d",
      "text": "Wah, larang og. Oleh kurang, Bu?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7679fdd4d9b1f0b561e0da42a432f68c003959c7141bb52f1f9ce4a3f29f43d",
      "text": "umur",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7a8466b8484cc47184355500f802c517839b916432055040aa65e4224b5cf9d",
      "text": "Selawe ewu wae, ya, Bu?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a973ea6b4205d6e4ef810fe4fc589d89c3845ee2268b0bbb83575c66d12d0834",
      "text": "Tak bayar kabeh saiki, Bu.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab65e68066203e16834b3654f1fb127897021914f046a5a7d5cbfb0c8b3b3ad2",
      "text": "Aku isih utang limang ewu.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac61c84213ca11e211f802470cd35bae9b3042d67aa1876345b6cfd542605585",
      "text": "Njaluk kresek, Bu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac8c93843f3a2b13fc38d57ff19a7a8d3f5b825b86a7f30cecfe13f632439400",
      "text": "Satus ewu. Sedhela, tak etung susuke.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ade461a7654ab7a4947f3619f1be3411c9eee6ddf1ee98daf68f3b4d32c34541",
      "text": "500.000 = ?",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b044dc378ea6e689fca82baea96ce11806ff05c42eaba368c0246b7ba148ba20",
      "text": "Susuke selawe ewu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1697ab88c8780cd70c335c0b26434b9e301e024abb40892118e23dc8021ea08",
      "text": "Mas arep tuku pirang kilo?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "b196fedeac4919906eb70d6e2c3126045acc2e166b4e5db8485cfd526d5614e8",
      "text": "15.000 = ?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b336634c76d43be6a8ff4e58ef951e7a3317c49d1017dd8b6a0fe0a82a6b2751",
      "text": "entek",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38dc34fb2136c574fa3f73fed563cf1f5a009cc117539fdfe5e35292051ecbd",
      "text": "Telung biji pira, Bu?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4bfdb4f6edc5a08f83a806704d80ac7a47e9697c7f1fef681cec33aee9f437a",
      "text": "Kaos putih iki regane sewidak ewu.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b57d9f614e38e26bed3f00976594ecf99514cf877b829286a8c2e8e6666a8dc2",
      "text": "Seket! Nganjuk pancen kutha bawang.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b64a18acf27e014ed3466586f5fb151d36a75f3d73f86c27b5d43eb63c4b483e",
      "text": "Endhoge sekilo pira, Bu?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b681c765246924d2976627845d4fb07462cdbd7ebb9b8ba7f1dd459240ba4c95",
      "text": "Kaos putih iki pira, Bu?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b69b5715dc860399951a1599cba2511502f0e085f7f3565818e52f5fb5f64170",
      "text": "biji",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6ab087e094fcd43f4a7e50267ba086bc61429593a207e2681a6762d3c3189b0",
      "text": "Umurku selawe taun.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "b947afcbbfb25d2b86160ff442c75356b90653576f99cee1ba4d6d46f5a11d2b",
      "text": "seket",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9881ffd54ef90f88fd524177d2d13271df0d0d163532127140ec8462350dd1b",
      "text": "Lomboke pedhes tenan!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9ee25c9fb67e463617ab47dcdc3f93e2da9e7dfc0ad681384f3b72f50ca0d9f",
      "text": "13 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb93f72e6c2bc6f19e841878943f7ec6c5f759ee2b26cfc56d8cd921f23c2702",
      "text": "Gus, umurmu pira?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "beca96f3aa9aa38d0505a4274e0c6de6910df38c54f333c84d79d46e01dcc292",
      "text": "Kabeh dadi satus seket ewu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3aaab4841f521b5be68c16bff84ed1532e8e399273b647ab8a11cb234f91c91",
      "text": "Bawang abang telung kilo, endhog sekilo. Kabeh dadi satus sepuluh ewu, Mas.",
      "voice": "jv_siti",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c93c6da81e58e842f697e464e62cede4147273f345e4dc24b89dfbfc7d21e9",
      "text": "Bu, bawang abang sekilo pira?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c72f70ef91f24a4a4b57288636d52196f17b635007720e937976c2bbad92ae69",
      "text": "jajal",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d03de45a2d608f2abc102ab0704e410dffc6fac1e0815caa1128139d961e5a92",
      "text": "15 = ?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2a5da23b5d4125163fa872c39edf0acb14b9821cb78721e5306759390b596fa",
      "text": "Aku tuku rong kilo. Karo bawang putih setengah kilo.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5121888bbd3618aace65e419659ca28836de1304b887f52d10282ed1d3e7b35",
      "text": "Karunge ana seket.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "d631367fe1c1791ee0bddf9dd39a4b99d83f303b91804521f1bc4dc7cdc32018",
      "text": "Iki susuke, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d79d5ab7626ebd13b9de505510b3021bd23a2a9a1050b0e537f09b780aa1fd21",
      "text": "Bawang putih setengah kilo, kabeh dadi pira?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d89d0b87db86aba6cb2ce34748ed0d63141a3c1f1f4009f31316f5af5d0e0ab7",
      "text": "Selawe karung bawang? Akeh tenan!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d99038a251c9b0f2c808912c92837a0ddb82fa24e09549ee16b7eec609e051ee",
      "text": "Siji wae, Bu. Ibu dodolan dhewekan?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "d993c9dbbc8c8699e8d9da1d6322ce3180645538f14f6aeb87e680504bd37fb2",
      "text": "Sing ireng pira, Pak?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "db4e3389ca5f917b6ec4f80c491eddcc662446f17cf4907db91463742cc66857",
      "text": "Wolulikur ewu wae.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc148959be1e5cce2fc062034fe20be980136e2fd6f92dbfe3d9307fb17b104c",
      "text": "Iki susuke, patang puluh ewu. Matur nuwun, Mas!",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd20b8935fe3048d45bf97d094cacc162e878d278cde0eed0074626f6741295f",
      "text": "sewelas",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "de73f863c9f7d20ea082d2fc25f463b1ec5d2151f9c23bc8b07d87c2f0747e0e",
      "text": "seket lima",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfe45e399cc3169b0bd8e0462e20650e7fd3cb17067e710abbcdf62e0ba77764",
      "text": "kulakan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1384b951fe43b9fd425466f32fa70d4eeaadb7076fdf0c66121b122982e396c",
      "text": "Bu Siti dodolan tiwul dhewekan.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e24b0a7231bfa23d115c04e517a4b41c3395f19ebaee398376323b7b8cd103bc",
      "text": "Lombok kuning, lombok abang, kabeh pedhes.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e61a2170ae60563600f5047668d7491d9327b76e3ec2fbae9f37131f3a571599",
      "text": "Telung puluh ewu, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6fe60d70639acb11281365321e99a2868236e90114ec74870c62cd7e945cf8e",
      "text": "langganan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e81bc25e897bf695156f70127c12d09bc625fe54a21369d5e0287a316febd36e",
      "text": "Ngapura lho, Mas, endhoge wis entek. Laris tenan esuk iki.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9634bf670e62e388c784b1d3589872ef42dcf1cde7e73cbed2298b7c5ce9a18",
      "text": "Aja ngenyang banget, mengko aku tuna.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaaa8e1d9cb7d1b7b41acb0bde6957b25aa09cc95e58c27c9372716fa6252ca1",
      "text": "pas / wis pas",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed39a4c572cccc411053a2074fa8c8c2192d2f37804b8d86a486039ab0c68554",
      "text": "Endhog sekilo, Bu. Lan tempe telung biji.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee4455269d7222663d65b35d2bb584a62975f6a18774e8267fae56cea09f0499",
      "text": "bawang putih",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f02edc97cc489ed03c99ebeac123e454616de9a859992ce5aeadd99c5cfe8ca1",
      "text": "Bapak tuku seket karung.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f049f8b313e19648f55c1f4a93fb6c5247cd75d143082ae1c809230360f54fe8",
      "text": "Selawe? Lho, mbakyuku ya selawe!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04d9fd1ec8eca95f746945bc24ec82281e105397b6063d9ecf7c9bdb8adae31",
      "text": "lengkap",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f091233dbc3d5d534ba95af81db299eac6331e3e5452f9baab54fa6cedaedd1c",
      "text": "Iya, rong ewu. Ora apa-apa, aku ra rugi kok, hehe.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9b6c0f16088c76fe817b5cac14be479cbb5591746844a038267f85dfb573edb",
      "text": "Nemlikur ewu, Mas.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa321cb68a7d88921ede47935ec36854ed5a0918362b58d699f079ebcac3d344",
      "text": "Regane seket ewu.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc6b6211ea37950d926bf13ec2525d5222473608a02882ae1d483dd5df87fd36",
      "text": "kresek",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd20fb8f9efa39e37da8cb51eb72c2e41b47db3ea7c7d64c2d7cdbb2497352ff",
      "text": "Umurku selikur taun.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd8e154be31b44828df995cbe36fd862ba8d4135c335a953845619ff6bf6fbeb",
      "text": "Endhog sekilo nemlikur ewu. Kabeh dadi satus sepuluh ewu.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff69d8ae4c9561dde2ccffb5338a1737c2533f03babf789713af356a5ef49d1c",
      "text": "Telung kilo. Selawe ewu wae, ya?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
