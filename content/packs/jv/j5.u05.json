    },
    {
      "id": "j5.u05.l06",
      "sha256": "114d0158058d24c656976128c83deab8bdb325b6398ed3f8a5c5126e22502f31"
    },
    {
      "id": "j5.u05.l07",
      "sha256": "6bdd851f155dc80b6d71387d093c90702e3c7b7b6615e93c8030fea783762f53"
    },
    {
      "id": "j5.u05.l08",
      "sha256": "d6a31d9cde0d470e392e653f75116a392a738a487246be48be7c9831a9dc2570"
    },
    {
      "id": "j5.u05.l09",
      "sha256": "32072e2e58cac644ed5df846013d5d606706fe825b309f64b0aef8de93c8bf28"
    },
    {
      "id": "j5.u05.l10",
      "sha256": "80396da5dbced6c2649244216ac8635f277ac60d673810d756c4735affe11a25"
    },
    {
      "id": "j5.u05.l11",
      "sha256": "9af988050ec4c7e3eac63442ececfc1ae9ad586bce490bc3e7ce4db641c0b4cb"
    },
    {
      "id": "j5.u05.l12",
      "sha256": "a81ef3c2b9d6f4874e4c5712f702783287203c140bc0c6dfb1f024fdfce696ca"
    }
  ],
  "audio": [
    {
      "key": "007377d9903c2ba3056cb4d4bf7643722421d4d967fd081d836f293abac0b841",
      "text": "Saben sore, aku dolanan ing ngarep menara karo kanca-kanca.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "0540bc8cbbfb46879cb1c3aae99a6a262cf9b30e74907e2b48a9d38da6c0d100",
      "text": "Terus simbah nemokake Bima, lagi mangan jenang.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "05ea7c736ae6a0e7f98a1e42e71d9b1d10078e0a6144ebee3abde73ed2e4b20a",
      "text": "musuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0768868d2eece18fc2f3ed71371eea0e766b1a56612a1656752477ecb7c97742",
      "text": "Lan nami Kudus saking Al-Quds, nggih?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "08ef8584840b7484af99686070efa65ceec045f867497c87c3a25feb3714e6ed",
      "text": "Dumadakan ana sing nyeluk, aku noleh.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "0acb2d4a191457b4a179083b63bcf282cc48ec5d1149e30892f9d9cee17dc8db",
      "text": "Iya. Lan jeneng Kudus uga saka basa Arab lho, Al-Quds.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cd442148ea402052056c2be26969b99f195d8c489e910233c4710c2188c7b42",
      "text": "Critakna maneh, nanging cekak wae.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f9a38dba29da4505877ca4b80cf0019acc58fae3ef7b97b2f1cd5ee675daa28",
      "text": "Sawise salat, dumadakan Bima ora ana.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "14f57cad735e0566cbc086cd6974ab39d684c6522c0c4999444eba9ed5a2fffa",
      "text": "Dumadakan udan deres, pungkasane Bima mulih.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "19889c79e08d1e20b4ef4871c5e83a46a3e7cb28610f349bdebe8eaa1aa6f203",
      "text": "kodhok",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b0a7ce1cb453128650a482bed281406b0a501a941e2d32a71630ee340e3c0fc",
      "text": "Nalika isih alit, kula manggen ing Kairo, Bu.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d13f958e11e68d1660e32fb67ae984c5df678b1a6a41aff0e15bd24a7513ced",
      "text": "Lho, kok bisa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dd3024863df9d5a77f22dd5113da6fa0aeebb5e6dc457ec033167ed6cc61972",
      "text": "Ing ___ crita, kethek slamet.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e700d8dd1eaf3dfe5a57826701cb87f481c5cecd881666be7593c5b7365a139",
      "text": "Ing sawijining dina, kancil menyang kebon timune Pak Tani, banjur mangan timun akeh banget.",
      "voice": "jv_siti",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "200ad1826d409d5066709cb0789dbbdb5248bea61c9b6771c70ab89eaee87b44",
      "text": "sedina",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "200d63cc395a6d3352fc86828cbd1bd2c257fd569f641035f2c07abea46c3ba5",
      "text": "nuli",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2154d6da408ce31d068481883adc6ad92d1dd3bdea6306642737f0f6cc4badbf",
      "text": "nemokake",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "21ad554b530efb5cd31e869530ae34c8ed0c5b9d68c2a692d49949e276c457a5",
      "text": "Hahaha. Wekasane apik tenan.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "2607543fe0f2370e9d3db12df852f7d331b64ab5cc7254edf82d623ecfae468c",
      "text": "Bima tangi esuk, banjur adus.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "27b44c64a50614e5f589a1a3cd87769fee71e9040d68d3f1fa9004658d140957",
      "text": "Pungkasane, kabeh padha bungah.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a8084185cf6e9e8ad257bc4446fdfeca90df6e8e27eb4cd3aeda5e68c2f17c4",
      "text": "Nalika isih cilik, Rina manggon ing Madiun.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cb5ac938b718eb3b335f71be7cd36bfa5013e726bab1595924e38308d89f528",
      "text": "Aku ora nyangka musuhe kancane dhewe!",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc3660be5fa42cbe604fafc1f575c12584089716a8cc725007a5eb5c3a73b28",
      "text": "ndilalah",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f3a7390a56ff69d922b3a43730e5c93aee6d4a9e0619da76704d14e17641e44",
      "text": "Rina telat tangi, banjur mlayu menyang stasiun.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "308a9639226e30cae8f91e4c8060e3f730e8b081eee28b93f5a16715bf7aa951",
      "text": "Ing sawijining dina, kucinge Sari ilang. Pungkasane, kucinge mulih dhewe.",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "31387799b8cee64fec0aa51abaa654664521b91e8f4287756ad6b6cce478ff7c",
      "text": "mbujuk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "332e2e7658f8c64e2a12c43795fcd05a2e0f9af674a7270f39e24cb13c9542c5",
      "text": "Kodhok ndhelik saka baya.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "33bc779a9c9de8de128f0622d0e428ed92e3b631bb92eb1efa44ccd5fd259527",
      "text": "Desa iku ora ana perang, ___ banget.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "34acad6ba40bac49df763006016f1873d1e719cbe0436edb82cc75fde2807451",
      "text": "Leres, Bu. Al-Quds menika Yerusalem.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "35d6f3222b18a46eb11f54e2cc54264318a59f5f335a2547f11163c2a1ab2a41",
      "text": "Inggih. Sasampunipun basa Indonesia, kula sinau basa Jawi.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "388adf126c4f602228654e4706e783643f22738d6b02866c498ffdf0c0c86ee7",
      "text": "Pungkasane, Rina isih bisa numpak sepur.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "38a2070273fa321c5411f04f50c84e45f9e85712ffd38e325a753ac71a41d125",
      "text": "sawise",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "38e71b7fd986c4b862156588fb67dfbc0f49d96abeb712f73938e93b95f760a5",
      "text": "Lakone cerkak iki bocah wadon sing kendel.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3924eac3c3b688ca228fd60365204d3550ed43840e28e048c2aa6050ca489b44",
      "text": "gemeter",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d10cfd1b8cb2abb857157f314a5f6b5934bf9f8816d6d1414492fd6c2f3ce1d",
      "text": "Matur nuwun, Bu. Ing sawijining dina, menika \"pada suatu hari\", nggih?",
      "voice": "jv_dimas",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "411704072ea6333356f0fe65fd8ee601f99e248f772fb67d2a60b91ddabd9c3e",
      "text": "Sunan Kudus iku sawijining Wali Sanga. Dheweke sing mbangun masjid ing cedhak menara.",
      "voice": "jv_siti",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "4138b49be474832d39fb3215d2ab1d042e77a2da33a492b936a45d757d4df81c",
      "text": "Aku medun saka bis ing papan sing salah.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "43ca34ec7e83de5050bd0108b803fd9ed0035d9ad12c78f3069a333ab4bca290",
      "text": "Bima karo simbahe lunga neng Menara Kudus.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "47636254805378c91d472e771bba14ed1013e5e82c224b63f0dcdfa392a4fe5f",
      "text": "maghrib",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "52319c7e70d2027ca66f5dad06e824cfb2132d667857e9fa36c9c86b85062233",
      "text": "Pungkasane, simbah nemokake Bima ing ngarep menara, lagi mangan jenang.",
      "voice": "jv_siti",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "52a8d4f215d1677da2da882ef6dda4537fee1d2ce3529c30e896699881074b47",
      "text": "Waduh, kethek mesthi cilaka!",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "53fdde553fb78b85e27ef2fea04fb7a914813970a4df8b09101c3369511dcacf",
      "text": "Bu, pungkasane critane piye?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "543fccc08b2eab65ad47c6bc1c415b1ee15cf5eea4287f02200134705d840530",
      "text": "Ing sawijining dina, kucinge Sari ilang.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "56d0d220d3c41173ff5fbeb4bd86e4c33b7ffb8d2077f2c8a50f0594f428eda2",
      "text": "Sawise maghrib, simbah crita babagan Sunan Kudus.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "56f76dd76c7622e34512ae3175da21acd3330b162f395f1f7433ffff3c6a272d",
      "text": "Mbak, wingi aku kesasar ing Pasar Besar.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5782f1f619ebe60b50bba88e6b3a4919af0aa40036f196ca8e82dcd02e4bb24c",
      "text": "Mas, iki Menara Kudus, kaya ing cerkakku.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "581cef5676346716e9b34bc7f8fd0fa10de1ede03d9128b71675f99e67a3fd06",
      "text": "Dereng, Bu. Kancil menika menapa?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "58d2dd1e3b9d7daccff14c818c96c20d7f45ff580ba6e987502a8a9dc214f6a6",
      "text": "Ing wekasane, baya ora oleh apa-apa.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c1b50b502de08b58343ad9fc60375cf9fd601650c08d77277cecc0c53184822",
      "text": "Ing Mesir ugi wonten crita ingkang pinter, Bu. Juha!",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e722548184f358ff5290065ea69097db7608c0e368d5eb488dc467c324e6779",
      "text": "bareng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "610c45b15969fe5ff1770dbb831102977994913932845df543c12002f0acfd81",
      "text": "wiwit iku",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "617a5aa2723f2fd0e251823a1379d8325e921f4facafdcc273a1f326d6e63009",
      "text": "Ing sawijining dina, Dimas lunga menyang pasar.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "626f7884c6cdfbc47394071917147cbe25b31a14924197daa1646fc530db8ca9",
      "text": "wekasan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "63020fda5e28c7109e758b57e2f08797b7b3473fd3c944dfd4ab1fc208902869",
      "text": "Wingi aku kesasar, nanging ndilalah nemoni kanca.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "63e29558fe9f763c69722e9d815dc1ef80756b98c8c9812fe7540d8d74d585dd",
      "text": "Ing sawijining dina, Bima lan simbahe lunga menyang Menara Kudus.",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "64592e85e6eadc0f974af00c5a1b36dab5ce5c33926fbdd812b508d33ad33049",
      "text": "Bima karo simbahe lunga neng Menara Kudus.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "65517098de20061beef560b912b2cae325e1e9036c32765bce4322646f977290",
      "text": "Banjur?",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6679ee8d7c564a9d0a64386d2cc6e9df7d1c2cb7e339c0ae76950593eafadd4d",
      "text": "lakon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6737c67fe8bad99b73e70a69ceefc7ff72d8cbfb0c9560c9a142768b5a5d87c9",
      "text": "Mohamed, kowe ngerti crita kethek lan baya?",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "68162efb28fa491eba73fda62980d8ed7051c32dcba55e441d91ded963d8bb78",
      "text": "Baya mbujuk kethek numpak gegere.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "68b381ce617af0df0b677f04abebf39279f47ce67143941ec5230ec626964975",
      "text": "nalika",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6980dd432d468a1da65fa14066a4a09057dd88d4d33413494990ba3c609ddb4d",
      "text": "Sadurunge lunga sekolah, Bima sarapan.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "69a7b133df5e5988dc70e565c0d382bac1854a725485dc409a621c6489011c45",
      "text": "biyen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ad0d6d16fe18e610d0cea0101845b506c47403032fd52cffb69234735f99fdf",
      "text": "Lan pungkasane?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cb746843ca17f74fb435f732fd6d8ac2cdf2fcf79f69ba1b5272ebc0022f752",
      "text": "Bareng tekan omah, dumadakan udan deres.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ed137e6bac297fe48fbccf9839b9c93527a017abd8bd9791f0da01fe8e5b192",
      "text": "Paraga ing crita iki yaiku kethek lan baya.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f2e21d1c63382e8fc179b498dda91024955a53607a6f9f67ed3c098a952468d",
      "text": "Wah, kaya cerkak wae!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "711d5d06c956455b3445f47db0615aee71131c34edc447c2b9eb64d8a627feb0",
      "text": "pungkasane",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "73271103a4757093a4bc24432377ebdbaa5c7a34cb4c510d682d4d199199a090",
      "text": "timun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "735b0c5dfcc6109c7a30ad0c16f71b08d9d0404d1f36205c0385cb9925b8759e",
      "text": "Critakna maneh: Ing sawijining dina, Bima lan simbahe lunga menyang Menara Kudus.",
      "voice": "jv_siti",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "7530ea3f141ab44ddf2717a546b1b4fdf503c6c8944f8d29ef2eb8634fc8e372",
      "text": "cekak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7576bc7418e873cc0cb33af6fea91d552a900172fc0a25d868d6adf1cd91725b",
      "text": "kethek",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "77f3a599acdfaaff7bf1a4a468d740f46dd36b06590e62a7d65edd3fed0f8080",
      "text": "Sawise salat, Bima ilang.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "78ce1464fcc325f5891e0c3955344cf156a472e641bb1896efe1bf2cbe861be5",
      "text": "Biyen ana bocah cilik jenenge Bima.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "78e9d6d1d87e6824051f37bbde03b97c3d9c57a9e64e3d4a45263e61ffc5ad1c",
      "text": "Kodhok ndhelik ing mburi watu.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d1416dba76d014640a86481341cae82e98897e5752d854d6cf8de75552f95da",
      "text": "Mas, critakna maneh cerkakku, nanging cekak wae.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d5428969b148aee801724c7ed9c72d167dfa6be3007c0c1ffd5404f0b21dd49",
      "text": "Dumadakan, ana swara saka mburi.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f85792a2e99cf0a7daec8059e9ba4c0a8364a4ca0fea648b74b455aa6b63622",
      "text": "cilaka",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fbe4c792d166564e9db4be531a5d6ec3018ee20366fedbd7d7abeda538630d9",
      "text": "noleh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "80d17555a87e58f31e0e8f8de866ebacdc04dd061089d3dabeeff8726c915f32",
      "text": "medun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "820dae6fb38c5ec94a3e975b4fd26d68cd3599addf2e276e6d446b0eff9acae6",
      "text": "Bu, Sunan Kudus menika sinten?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "851c97417ca107d3c0201483a0a0c918409669b9a87560797f65065552f211c5",
      "text": "mabur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "85f2c3145c83e2b40a6cce286222a55049c72812229344edf268188ae5dbed85",
      "text": "Bu Retno nulis cerkak, banjur dikirim menyang Panjebar Semangat.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "882bdc42d28a3dc619f4142478635beee269c9fe340f4dd98aa3cd236d26ecf3",
      "text": "ndhelik",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "89ea3af3d84fc19933be21581c766283fb4a206d7b7e7324419bdddc68d122e7",
      "text": "Kancil iku kaya kidang cilik, pinter banget. Saben bocah Jawa ngerti critane.",
      "voice": "jv_siti",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "8acc0935e5a1eef4de532cf5bc3d18a5620338159973a4edce73114a27082340",
      "text": "rahasia",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c70ede5c129928163a6db25b8f9ff99fa47b9f8f80b9352c17006d09669c955",
      "text": "Mas, wis maca cerkak anyar iki?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e7104f0724277965746418c48d8697709aefb1adb2a9f69cd4de25dfdf2afb4",
      "text": "Nalika isih cilik, aku manggon ing Kairo.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e81c6837ec6a8fe80033294761ec499a236d193cd4115086a5e53cad3e2000d",
      "text": "Aku lali dalane, aku ___.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "904214cbcda5efbad0a9c46c2b478a13c3ddc4c252e6dbda0a0296eb9fbe7844",
      "text": "Mas, nalika isih cilik, sampeyan manggon ing ngendi?",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "94029d25258c32a6e251c4469e64722e3896350e6afd7ab07de39422832c12e8",
      "text": "Dumadakan ana sing nyeluk. Aku noleh... ndilalah kanca saka kampus!",
      "voice": "jv_dimas",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "94ea52c0a3948ea49d121ba8a05bac74ad5ce50a397d90c9b887f6e16ac0d232",
      "text": "Adegan endi sing paling kok senengi?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9888055dd93da1b636907d51e6feedc2059be529815fad8017ede0523558a83b",
      "text": "Ana pengumuman, sepure uga telat! Pungkasane Rina bisa numpak.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "98efaacfedc005bbed073ff8baaad67a89287e22649f1a61505503483ac580d4",
      "text": "paraga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "99327a659b45593e2700859d8f6b02b6d793197cb322c7d9aeae56b9ce7da59c",
      "text": "mlayu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "999a02dbcd2033d68321d2371529da383d101e812fbdaff927bc60bb010bc3fe",
      "text": "Bareng tekan omah, …",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b464d6775615c62b6ee98063d22dbb9b153fc40e7d1ad3b71c0f36baa36750b",
      "text": "Wah, mengko critakna, lho!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ba14a3d95eae99c48d8fce20e6e9a8f5ed7792746370a54d3d3886a176e6ea1",
      "text": "Sedina iku, desa sing tentrem dumadakan rame.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e6befb93610867d16204cd3538073c44deea2cada459e62c80ac59e5337d7c7",
      "text": "cerkak",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f9b5d67e2ac410ffcad8f18587e6567e14afc51f6d00732352ea538ec99fc0d",
      "text": "Bareng tekan stasiun, dumadakan ana pengumuman, sepure telat sejam.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "a079c41621f3a87a7fd35431458ab1ccbdf41c87e8e0a15d7e26191f0fec801e",
      "text": "jenang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3435e5b48f6faab45efbf29e277ef1a6efe6f529ab29d041b81d2828a64f3e0",
      "text": "kesasar",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4a825a2938ef173a4d89274c19bc8e4e0e1df980ae29b2c731db8ea0cc8cd53",
      "text": "Dumadakan Pak Tani teka, nanging kancil wis mlayu adoh.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4b32711c746c349a6263da63a35e10cef358a66425e7c3d2ac157e485f82d2b",
      "text": "Ayo, saiki mangan jenang kaya Bima!",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a504dc8d5056c2f219459324384ea0eca7c28fc7fa3375085c8f0d2859da96cd",
      "text": "Kethek sing pinter lan baya sing luwe. Baya mbujuk kethek numpak gegere nyabrang kali.",
      "voice": "jv_siti",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "a61f56d1ee04be451efb4fe3d06cbb82026bf70fdb9111e18119ad13d795d27d",
      "text": "Ing sawijining dina",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a73e7c5b80baa5fdf8dc2bd252e047700c057de7c8b297bac7977a1aa610cf3d",
      "text": "Ing adegan iki, lakone weruh musuhe.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a86077346a00b60012378b2f79a691076c66586645e5c7c7ef0d59198e70446b",
      "text": "Esuk iku, Rina telat tangi, banjur mlayu menyang stasiun.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a87e100d397f62b2619b3e4d2e4a47a5d08acb7e417818900c936f83a14bf38a",
      "text": "Bima karo simbahe lunga neng Menara Kudus. Sawise salat, Bima ilang. Pungkasane, simbah nemokake Bima.",
      "voice": "jv_siti",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8d0a0113429a93004f945fb5d565cb3dd14316409d9b34d0ddbd8320c8d5abc",
      "text": "Durung. Paragane sapa wae ta?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "a91768f06d93abe15fff61d39794b59c32e939cf6104935469023b8e0e79c659",
      "text": "Banjur Bima piye, Bu?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad8f9a175462f10ffac7afde29107e1acfca6aa8ccd8bd9ad1ab3877ee6b97c5",
      "text": "Lho, bener! Saiki sampeyan wis bisa maca cerkak.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7df1657462c6efe543e5356bc9b867189ac4caf4a2489f4a55a6e6f5fa92f2",
      "text": "adegan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1c74714266eea25534f1364bb0ab6f2a30fb01be80b71a237e38efe388c9de5",
      "text": "Bener lho, Mas. Simbahku crita kaya ngono saben sawise maghrib.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "b45f11994564ebf8eda6aa27d63bc96074432642c2162208467a6e75240e9b47",
      "text": "Inggih, Bu. Kula remen cerkak.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4ac619d301f8f30638e50a4ac3ae1ea20e66c48e07287c30f611bdb34f80bd2",
      "text": "Matur nuwun, Bu. Kula badhe maos cerkak malih.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4eef125a630775a4441bb41e29a38cb5b7ea32770dbdb433997df4ed2191d3e",
      "text": "Hehe, untung! Critamu cekak lan cetha.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b53aedb53146f92c2324c1f5434f9883c4170342051c5ad7e2626106496e2d08",
      "text": "Dheweke sarapan, nuli lunga sekolah.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6efd730b3df4782a4b5fa849af71beb10a357be7ae51318a3db84df4ccbd77d",
      "text": "Wiwit iku, aku seneng maca cerkak.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7a1b441a93529e7bd8b0a6ce002254d289314698f93a68db6a9b0736365b59d",
      "text": "Mas, sampeyan wis tau krungu crita kancil?",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b84a93b66d9ed7448b9cad03d76f5ae751bdaf100dd44140eeca9680e91d5cc0",
      "text": "Aku lali dalane. ___ ana polisi sing nulungi.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b93dbb19e6f7aa2decd247386d5c36cef20d638a33cb2a007fd4dfdb7dba8d60",
      "text": "Aku seneng maca cerkak.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd6541cfead3ef6f795c0829a4b746db80619437046d706b6e6c5fbe6e05c035",
      "text": "Sugeng tindak, Mas!",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "be17ba6af998adae7864fc15c5d19bf61c4f05e58a2d69ea984fa82409733654",
      "text": "Aku kesasar ing Pasar Besar Madiun.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1583c1847dfa9f91007205731b0814cf900b087eff9fe2c72624487c9530677",
      "text": "Desane tentrem maneh. Crita sing apik!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c210b68db4206a99d15e89aceadaf9d6a1c39ac196def28df48b5b16b721b936",
      "text": "Sari ana ing kebon, nuli ing pasar.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c34683fbaf123dfad6914094bbfcf730fcc2d705edbec9341481679b3f1d0c1f",
      "text": "Sadurunge menyang Jawa, sampeyan sinau basa Indonesia, ta?",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c391375d0e39030ce019fe629431f31772cb52ee867532301ffa1481c9354543",
      "text": "tentrem",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55a2d5bb4b97effd7dea3c6daf3e2d3859dfb021f881a9dbfc34d76349c0c8c",
      "text": "Aku seneng jenang Kudus.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5f6b6caf2546a6dce4fc9b99d50afd5c989f731f3ae2e69f31a4142a9b9bac4",
      "text": "Sampun, Bu. Kucinge Sari ical, nanging pungkasane wangsul piyambak.",
      "voice": "jv_dimas",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "c65b6f1dbf1752580aef7e692bebaef849ead1f218254940acee4916b6ebe118",
      "text": "Ndilalah aku nemoni kanca lawas.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c67e11b62d480cee88ee0c90552299b85225c1a450726ed3bb04c0f3dbeebdc5",
      "text": "kendel",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83420d9e8a504871bf1e429d146250c2666795c331b36459d199e20c005f802",
      "text": "kancil",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c85aa31c096afea216985f7750e5f2532be7728165a873e222a601982c74ac6d",
      "text": "Mas Mohamed, iki cerkakku. Wacanen, ya.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c85b4400ceb15df5962d8d87ba3fd541285f6483f3544c9cf5cc05f3f8a3847e",
      "text": "baya",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdf39d58a514055a30ab4ed6c95aa7fab11700685de8b109784a54f7566c0547",
      "text": "nyawang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d042fc2a5030a0a3d54462e5b99a0b15acddb77ea2b84a34ed4c08f30dce3976",
      "text": "Nalika isih cilik, aku manggon ing cedhak Menara Kudus.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d04958c27cb4535d6806c055bacf64fbcae8eae8f31832608cfe06142558958e",
      "text": "Wiwit iku, Bima ora tau lali payung.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d429511793814d937f818dca7cf1d1d8f72a894923198839cdcb8041a49cbc22",
      "text": "Mas, critakna cekak wae cerkak \"Sepur telat\".",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d46870ea00ebd5517889a0d7e8ec57059fbcef62c341954ebf55c1b389127200",
      "text": "Terus, dumadakan apa?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d883bbd95b49430ab598bba0b322440db7e6b31ab26e38ebabd0b2145d757819",
      "text": "Bima teles kabeh. Wiwit iku, dheweke ora tau lali payung.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "db7a450d4bbc6ae61a42748e462e5589b97be25d731a6cbd97883e5619d67d04",
      "text": "dumadakan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddbfe3eefbda63dea52090a48ba71c75e9bd4b167f040374c8fe8196126498f0",
      "text": "Wis. Lakone bocah wadon sing kendel banget.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "de24bee643e6a21b1243f780cf5ade4107821d2995a758e8115493c3448bfe1a",
      "text": "babagan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e083704aa7a094191bd6939f429b7bbbe084ebf9c8b30bd9d7e398e72368feeb",
      "text": "Wis rampung maca cerkak sing tak wenehi?",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2272af4e6489fcf89fdfe4b6d3044688088696e716e1ca97326d1085f66d753",
      "text": "Sawise salat, Bima ilang. Pungkasane, simbah nemokake Bima, lagi mangan jenang.",
      "voice": "jv_dimas",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2dfb7dcff2f9e3bcc4bc9033481575c31ce8f80a1e91af89c3c9be6ceb19af5",
      "text": "Apik banget! Critamu cekak lan cetha.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3b67e3f5d45cbf28abc41d23f5abaea6987264eec6e1b9d7ecfb295e59c7659",
      "text": "Sawise mangan, dheweke banjur turu.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5591fa43f67fa6528996191fb5df73f429f262216d348a4dbccaf384afdd29c",
      "text": "Nalika iku, Bima isih cilik.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5596e6a3808b9fb8c544a045bfaa49e107ac624a8bda21e3900f715482c5fdf",
      "text": "nemoni",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8e1644a4820d9ccc42f1cd3ea0fbcf4a6ccfb0d414d5781632687c6bd41be10",
      "text": "Biyen ana kancil kang pinter banget.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9887ac7d1c6ebfc3ef0101b6014147865f9e4b2daa2cc8f5ffbb4b534755597",
      "text": "Pungkasane, kucinge mulih dhewe.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9e0995e80fc3200d4aa3ebbdec57e80de327639cbc9a699c44af940df0e8e32",
      "text": "Bener. Banjur wacanen nganti rampung.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea0e1b350d9d92453aea7e475e8354d03d9ac20a506ee47c344dbcb55b836a80",
      "text": "critakna",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea691dfa99b1334c45018e12430e4cdd7a8714d3492dc3a8ea15031c0678406b",
      "text": "Terus?",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb86505f26d5c1c1fbaf507c67d1a11ac9cee21ca4acb1ae0452fc19baabe810",
      "text": "Menara! Ing basa Arab \"manara\". Sami, nggih, Bu?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec167d8c89f6ce176cfbeab88e903fe5edaf5ffedd163a0de82a54b097ef5fec",
      "text": "Nalika dheweke ngerti rahasia musuhe. Aku ora nyangka!",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f14f43a136473f204de5dfbea8b7c659d211d4726e5d6626a34bd27514db429e",
      "text": "sadurunge",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1eafa54a6b957ca29d274d532de45a9e58fb69122229175bc89a6db7a09df1f",
      "text": "Ora, lho! Kethek ngapusi baya: 'Atiku keri ing wit.'",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f21b0a4f093281152efbf1b56b7f015e89e8ccb4feedc42a71a9a0d315629ba1",
      "text": "menara",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2bde05c783ffef6e3432b9f07307ab1308ba80f7fa25da9ec02d868418c9687",
      "text": "Sadurunge turu, Bima maca buku.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3683616f7c889351fcb6b919cd20f67c6cea629deb3d29e6f370f7146c9155c",
      "text": "nyangka",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5e19a044d43bc00e2875c43b034a45a385bdb0e45548ebcbd1d7c53dd9066d1",
      "text": "Manuk mabur, aku nyawang langit.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f63abb844eca9b7230d6305522b0e5e43ad0e3bf04fbeb3f0e24a2761f2816e4",
      "text": "Sari golek ing kebon, nuli ing pasar.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8e5675879286d2787b20795ee27c78da03a29165513456e334c2696bb2ac8b9",
      "text": "Biyen ana bocah cilik jenenge Sari.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9add4511550011936a148855f8fad412a41dbe20933479053565f8623046940",
      "text": "Bima lagi mangan jenang ing ngarep menara.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa722214a710e602ddc536eaea44e9bf2642c943143188b66693a9cfce7cb893",
      "text": "Ing adegan pungkasan, desa dadi tentrem maneh.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff2014e004baf4ca6a9a1abff07978a5a6429311ae5aae0887f7f269540ee50a",
      "text": "Lakone kendel banget, ora wedi karo musuh.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    }
  ],
