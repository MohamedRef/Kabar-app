    },
    {
      "id": "j1.u07.l07",
      "sha256": "f03d0d4ab11648c03c38d5b75a4abc7450f913b5bfe51e1cbec1028d6b17d176"
    },
    {
      "id": "j1.u07.l08",
      "sha256": "5a9e38f9687d0d9d4693ae9de9f648924e56c3ebccdaeeb0f7b2fc84ef4f6b81"
    },
    {
      "id": "j1.u07.l09",
      "sha256": "e33dfdba0dd3f5bb8cee5e658303c8beacfb453ab313c9a91c03929a19354aaa"
    }
  ],
  "audio": [
    {
      "key": "019fe5b0110bc2f45d0264602cfe7f01cb5ec7d728b8e7c611c7397eda140ffa",
      "text": "Tak jupukake, ya.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e9e0c3fe20efb237a2964c01ab92316d9939815e4c10ce6b971f585b399bea",
      "text": "siji",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b86c0bb40cafd4c3e3b7288da70341bdcaf6cfd3d90a3e3645a20af4240d45f",
      "text": "durung oleh",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d428f4d2c1ddf98ddaa70d6e6a05baddeaf129306921211f63a86c5a77d13c4",
      "text": "arp dicul piro, Mas?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ee5641962ef098e0edd8af6c2b546449d728618585143d58b620833075c1703",
      "text": "Larang, Bu. Rega pungkasan pira?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "104d21896628f90b6aa5ad294b8f88224de691e46359dd6485837c0de76fbcde",
      "text": "Padha-padha, Mas!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "105316d76347fb3f1918744cdba8a3b7f8f81ddc07788e159aadc35cbf08f328",
      "text": "Regane pira?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "117e74dc54e97e34342b75172c8afd42325c2f909f755e5489395e3cf64fc7d3",
      "text": "pilih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "120779aa400d599d91e6af80a0a71e0bbffc1f661eeb1c88fd6edd1c492ce23a",
      "text": "Eh, teh telu, Mas!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c75651c0306dd318d35e2f664e0be93fb9cdb288015e6e891d0d02f3ce005f",
      "text": "Satus ewu.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "13d73ba64433d9e62a3ee1b7024b334cbec29bf482c42065b32f716de731b0f3",
      "text": "juta",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "174f87ec28541a43c61b7a974b523afd28016c4fdb93ffaf6331fde0b8b36b48",
      "text": "dhuwit",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "17af9b262e09050c4c724e25d276f4deea1f7f7a9becb9cccca3f5ed36f107b4",
      "text": "Regane pira? — Telung ewu.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1891dd8521080d03e2d792c3e11119c7fc6ae4da650f29c8ea34a47652d9e825",
      "text": "kegedhen",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1924fde62bb2b79c42c74b09f507c79be04d0142bdd6e256f7634b78f3b926de",
      "text": "tukokke",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "19ee76fa94d31181d400c08defdb4c27528255de6a4fe3a72dd87fae6b553d50",
      "text": "Oleh kurang? Rong ewu, ya.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e0d722ffbb2a0baae19e8b4e64c5ba15b7d1ef70373e179bb1db8a73ecf29bb",
      "text": "Ayo, tak terke mulih.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2115dff38b6d6d001a5d87e8150355c8f853862dacccd07f00c53ee8cccd4341",
      "text": "Siji, loro, telu, papat, lima.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "21626625d312ed502286b8bdd64497072e55d77273da3895834a6745a8e5dc3b",
      "text": "sepuluh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2212daf1b0cf40b892b0cf91c4f828ef72a7b327a16b94ceb264aea048df1886",
      "text": "rong puluh ewu",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "2278b987d9ea876ccd4b572102eeedcd0351b29386e05151e25067106e81d69f",
      "text": "Kathok lawas iki rong puluh ewu.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "24b894df7a442eee8d0876cbbcac1b9e0c980f51f9938b5a74ce6bf4188b8404",
      "text": "Wolung puluh ewu, ya.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "252de1fd986ec5adc2027aa5cc8fbf0986e2fb6c70b4f7c2ab03c981b568f408",
      "text": "Klambi iki elek, ora usah.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2548e1ce407394795f0b261b74431fa34984e08b04791f316c37b1913cc29b9a",
      "text": "Sip, tak jupuk. Kresek ora usah, Bu.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2611cf56cadb13512d21dc6a54119c515c87868664b93e07d9f7adf743916bcc",
      "text": "Teh telu.",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "26a11e3c4ec993a0463dded92cd774249568bda66deb280728c5d1fefeb37348",
      "text": "Satus ewu? Larang! Oleh kurang?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2943bfed0b1adc3170615f26ad6e5ac0be1c2a7715110f6d5a8eee9c64134fe6",
      "text": "Satus ewu? Larang!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a65ad46c3e519c874d71d9d28d267f96e7803d37daffdd4d86454e830127239",
      "text": "telung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bf5a4850b1805551ad9f2d0a19d343617f30387e34334dc02185f5d9eb81969",
      "text": "Iki dhuwite. Tak tukokke Mas Heru siji.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c4e25a3197eb19fe3aa5cf70a1ba9bf530ceae36e78731d2b216eb9c0319fa9",
      "text": "Mas, kopi loro. Regane pira?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e1c41ff611c6d584dc13e5d9ed536dccbd2498e8f60b58f4f555924c6fbd72",
      "text": "Sejuta? Oleh kurang?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "330582729855ce3a6f27a49f51d815930a5d72c659bb0189e065af49c4836761",
      "text": "Rong juta, Mas.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "3523eb27a648ee5f4e2ec61ed5730e76b54300f5f8eb7ca48e330e1a67532b53",
      "text": "sangu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "367616fee0792ab4562abe98fa882ab010b018a29d9c217ae8bb46d01d5da95c",
      "text": "laris",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3736b0a437c6af87b5bcf827703c69173254a0c6c6f071b11e3521e76abaea6b",
      "text": "Sanguku kari patang ewu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c2df6a2a94dbd49d3fb1c0ff2ff5feb171b7691cb4046cefc2c9bca12e154d1",
      "text": "giliran",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cae601cc866aa76430000efa12a56b1926c02f2c2c4dfad44606bc98190be04",
      "text": "ewu",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea6bfe0c4d0381771277281e2d1904dc86bc883d564692a8d760b68f6409a0c",
      "text": "entheng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "423e991907634b2dddd1fe0eb41073945a896bdb4fc7fe692cff82449b6be3b3",
      "text": "Klambine kegedhen, Mbak.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "43b7dcf26b9def9405256cac231f1b7b678f33374ff56cb9f37207aba1a1e57a",
      "text": "elek",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "47c3a51115932cbe40f708c10f556387600232162498f7f12a073660722dcead",
      "text": "kari",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aa992581312bf2db66574605b120554e55bfc76ee7d804aaeabd3325cc48c21",
      "text": "Rong ewu, Mas.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b4fc0f4b496a7a77bcb2f73a6b5fd9c44e676c2b52319c6ad5bdbfba7649126",
      "text": "Ora usah, Mas, matur nuwun.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b735bb665c127dfe57970eb8efd38fd85b118f9f211a07fa1888f7e8b8fd55d",
      "text": "Aku pilih tas iki. Satus ewu, ya?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b91481b5c83b59682a0db41d0f445ef03ee8f4e6134368018d5b8deb87cd87a",
      "text": "kilo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d2183e1823f2115b1b618ea60f93a83f47ae2c8547a7330632edc565b0d5485",
      "text": "Ya wis, oleh. Laris, laris!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fbb03596f3ebb12dbb8ac3475233aa0ec2bc1e4fe46850a6d416efe2f3b1191",
      "text": "Bu, klambi iki pira? Kegedhen sithik.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "51012b53437ccf603dfc0914ba5041badc408dfbd03f893ecc2e9be6f174a10f",
      "text": "Murah! Aku tuku, Mas.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "51d9c1cc59e61e76acf7e631075bef846b3a4e62c4c5479cbd38a03af5e3c28b",
      "text": "Telung ewu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "535dd2aa008186e587b489ae3798dffafd525b6cedf208cad86cd0113641c932",
      "text": "rong ewu",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "53b3c8cbeda0a9eece29adbc67154b8e7b45a466ae7ca3830de98ac94aca05c1",
      "text": "Sepuluh, Bu. Lan tempene rong kilo.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5927276331f9fd971df6f5f87139ff306c0a09f24e25f8188eeb86a449419637",
      "text": "Nomer pitu. Omahmu?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a498d1ebaf1bf8e8ede243c8645e21da756348310250b1668350b83c2360252",
      "text": "Omahku nomer sanga.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "611434d866a95396ac97b78c5111e752a118ffdfff35311b6ea9cb20a64ca7dd",
      "text": "Murah, Mas!",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "62e1cb4dfe0b53fce4db113bf5f7fa5c36686e72a59c05c829015d1a34a036e9",
      "text": "kathok",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "649b256303d930f0c60570e86c51cca6271001daee9f796234a0a01c4ffca83e",
      "text": "Wah, cedhak!",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "66515269f111c769d2d044c20e3867fb1df4b76b1e821bd147e7aa27fb5d8866",
      "text": "Pitu, wolu, sanga, sepuluh.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "675f0c58e651bdb4ca33cfc11e224e4d0d080b3b44c13dcea7b6543f7d9f15e9",
      "text": "Rong juta? Larang, Mas! Oleh kurang?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a41513ea21a5cc42b3a32143b50731bf991b78c1f24c714c413402654f847b5",
      "text": "Yudha, omahmu nomer pira?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b45a91b770907bdc5ed3857a546de2686d3d73e904c9a0949fca9bb819a611e",
      "text": "abot",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c132984fbd80891d83fe21ce2d0476966b5404c950affb56360216993f99e0a",
      "text": "Ya wis, oleh.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d300e0fff95d846f32d0020fb8f23fc81b9d1fda0c500f843ac7492ba374af4",
      "text": "oleh kurang?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d4785f34e8519986ed0068ecc10f980686809ba5d5b8e09f5957fe111c854e0",
      "text": "Siji limang ewu. Loro sepuluh ewu.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d99f8991a7eef135436656dde3fe73cbe5c0af95a7b477e6bdfb296bf603c8e",
      "text": "ya wis",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f51f90a39f0843e80342fdfe0c3547185d5b4b4ba590c2cd140a5f3d7489268",
      "text": "HP-ne arep diculke pira, Mas?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f9fb2e44d33dbec844e1c124b6dc3647b3364917da9ceb66b8d2fb7a0562aa1",
      "text": "pitu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "708f6dd20591f0bde67135d4fc9ecb68274d2a76984110eb03daf00e5843af8c",
      "text": "Satus ewu? Larang! Oleh kurang?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "73c7e761349580597cce419b029afd61794b5d15a697d79aa415bf8ffb22aa30",
      "text": "Mas, klambi iki regane pira?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "768f9e57ea373b0fad556b8fdd0c597bc9456b930e20654f1c0453cb5872f803",
      "text": "Bu Siti adol tempe. Tempene laris.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "76ccef82ac5042a5a2741d72d8debc8cbed49759463c434bb11f282baf3e6ab7",
      "text": "Kathok lawas iki isih apik.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "773329014cf499a70fc33be9bcb8d7b6f46031099ebca5a8962a44d7e438c498",
      "text": "sanga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "782c50f2343ce3675ab62ae0f14270c651a145f71d302ca4a4d34be0f3c88b03",
      "text": "rong",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a4d4af82f764426006076751a5a21df4a2f1cdd007830bb96d45e31a98e8da1",
      "text": "patang ewu",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bd8f36692c359a8c218b7103ccf8063565650df37751ea17c6d6edec6313005",
      "text": "Pilih jajan sing endi, Le?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f6fd1c925e8c31d586123ab271fca096b4ec371458a602fcfb6238f3fbb3688",
      "text": "ucul",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "81491b861b9264c234e8afe5611221218d6d5e558135aefe52710de01e6ffffc",
      "text": "murah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "842ea7abc2f2ba58bee4d181921357c1040269d8a132d80114fe557ec7f746a1",
      "text": "Rega pungkasan pira, Bu?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "85a4e0010a6641d1d40ad71fb23509b857bc1ca277a11ef1e8decb16baa3fd76",
      "text": "Kopi loro, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "88631a6f54b0ca9460e6913ece72e217ad86bb568bd173114a5e1d8a1da66a4e",
      "text": "Ya wis, oleh. Murah iki, Mas!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a0c41dc5450f4471e10406601177eee781613422559f1f099d7c78e4474c91f",
      "text": "Sejuta limang atus ewu, ya?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ad889023567eb39cdb9c9254707be8ab4dbbbd99b74fa12be3c6cc39386cc7f",
      "text": "Sik tak lapor pusat.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b55015d38e59a4167351fd467b02cfd2d5f002bacb6cc6ac6e57ef7f2856515",
      "text": "oleh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c3a891d6227eca652f1dc18b572689ac77c68abf1518f1e2e0bb39fa6b26138",
      "text": "Pitung puluh ewu wis.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d9056e2fc0d08dec6f479ccd59c6454eeba96120a2b2f9ecdc600f201d67049",
      "text": "Pira, Pak?",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "92fd522ac834c1a56575fb5c3459f2795303dc42a7368bf245185e3ac8b56bb0",
      "text": "Tase satus ewu, Mas.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "95083f335e4dd9484dc068a4d3fb7a9541554af900ca12c766e1b8ee5b81c2bd",
      "text": "HP-ne arep diculke pira, Mas? Oleh kurang?",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9626550a969f2974045dbd3f543b6eefd5d5a6d940e92493b94c40e09ab08323",
      "text": "Monggo, Mas! Kathok lawas, isih apik.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "978b66fbe5740d70826fe7ca81cf339c297b301c98b09a507d0476951849a4b8",
      "text": "tas",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "997b701fb5c5fdf2ca0e38994fb195afc1c4636045d121e9ab8499bfba73b390",
      "text": "Telung atus ewu? Larang!",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8a02e763d65c12a011db95e12a3f55220fa9ae28ee9f51a0cd44d356908024",
      "text": "Sing iki pira, Bu?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c602b9f0d35814f8cbc13d773291adb99fc1aeb870f5ddd7966482e0aa51f2f",
      "text": "Sejuta pitung atus ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e7e74afac7ded3bcca8dec32f1ad6f290b1046e1b299bd96819cad67fc8d130",
      "text": "Rong juta? Larang!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "a025359ddd51cc9cda68d8be210b5811357afecf43dac2433fda3f6d3444099f",
      "text": "Satus ewu, Mas.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2c7e1a0e359414d0c1319df91bc9ea4f293feaaba55a34bbcdcf7ae1da612d5",
      "text": "limang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3216ab614067c864270636600983b73f92c3536b07fc41ec95b8eadeb1e164a",
      "text": "Sing iki telung puluh ewu, sing kuwi patang puluh.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c6bd1311cf0a493cbb974758843103c72265834155c2a47e0c52619d1acff1",
      "text": "Kabeh seket ewu. Tasmu kene, tak lebokke.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9ca2333a99754d5f4687fd0f051309b6c4735b5930947a197bf60cf8ffd361a",
      "text": "Kopi pira, Mas?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab2de799e5f6e674088d332a3e0870668e2daf9cc65ed39cb642efc7184b172b",
      "text": "Monggo, Mas! Jajane anyar, laris tenan.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab9e41536c330adc60a7bade986e316962f9f6275e57c7ca4095a7ffc5c2f174",
      "text": "puluh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af124a8024df78ce10537e57da906aea5be2de5a38252aa2d081e7f72e4be573",
      "text": "Bu Siti adol jajan. Jajane laris.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "afbf247e34dd3203e914ea70cc4238776994607e1afd3121183d31a56c9f6c04",
      "text": "loro",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b178f57d06e932ae274b22e0612b4c9e6f7e7f6aff120cebc5c82b6fa8d2b857",
      "text": "Wah, suwun, cah!",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4117a871824571cbcaf6aac092d2e9db98abb3183191fc6864ba688938ea4b4",
      "text": "papat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6fa2dfea40e7db967f0a2925699c064c134601421646faf0255c6253a621c27",
      "text": "Sik, tak jupukke.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "b725abced2566eb8a1e64a7eb91334d175895ec773f15f2e37de06ec8fd2475d",
      "text": "Entheng! Aku nawa: rega pungkasan pira?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b73f5003b3738e2603cd169b17b9c87a7148e284923ef0bd1727460421f0dab3",
      "text": "Limang ewu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7b2b5e0a401d821f411ef00622b47753073252186aecd9f3da18532b58ea438",
      "text": "HP",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90ab8790202907cc0f8c69b0cf8f9018785ff750aa9be879e71e1c2a9585e24",
      "text": "atus",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9867684cb654b387c6fdfa8821cceb97a18b227b836034b25caa0ce82d0ee02",
      "text": "Kopi loro, Mas. Lan teh siji.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "baada7377d304b859e18f36998a9d7879d0baa293102ef745525c3eaeaa58601",
      "text": "Kopi loro, teh siji. Wis?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf0540e9d6a9c757179821acfef8d89e20fd8eb71805a0e719c883367b1b7646",
      "text": "Mas, HP iki arep diculke pira?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf3e0d861dd6a854bf165f1c831c1b76b2e140b2aa700fe9d5725988b06d24fd",
      "text": "Sewu, rong ewu, telung ewu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1a148cf40fbabb8ed5ab0007c55827e8abd3d19407781b827e1f6f7317e5674",
      "text": "satus",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e3d7dbe8cb8477b2fde4fd293623b4c3cad01b188ed9d6ef0123ed5bdcea51",
      "text": "Enem, pitu, wolu, sanga, sepuluh.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c37949e1b9a2160052a9fe532afee98bac15d405d03db089abe25dcb98393c96",
      "text": "lawas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c395b3604fecfa0c67fc470b4f03d158cefb815aa389a4bf6f817cd14c2b0f29",
      "text": "Durung oleh, Mas.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "c66153adf4fd3b4ac38829f2ab3fe7dc59745157d3019dac9dccdbef1ac86df9",
      "text": "jajan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6f17b54128a42fe81b71f9b65ec2d4869440bd9e50d6f5e205967b4c445ba93",
      "text": "Pitung puluh ewu, Mas?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9b03a8d16b7bf38656aa3b274db3626660cefcf924a9de8b5c45930f3fde3ca",
      "text": "Sanguku kari sewu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca75c222cf28d5b654c083457aefa5af092f28bd342402cbe761e6d68c6f03c1",
      "text": "Rong kathok limang puluh ewu, piye?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "d044d124667cf50a8ec72592910dbc46e354e9dc2c210c03bbad708822a116aa",
      "text": "Aku pilih sing entheng.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6a911ce0ffa2c1f8505d33a4850a50dcb40aca20098ae1f3c9b73c6c14e159e",
      "text": "arp dicul piro",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f6f0ab4f96022d5fffa8627b3469e29eb3149193e9766a9fb8bf8bd92ff851",
      "text": "telu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d75ce5b294dace1d198b7127a83c11208d3d51960b01fe2bf2943377d1e33b79",
      "text": "lima",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "da200c292df33a4c85a4bb18570f612bed54ec9b7287634af4041032fa4a9e80",
      "text": "Waduh, sanguku kari limang puluh ewu. Rong kathok limang puluh, oleh?",
      "voice": "jv_dimas",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "da21d0d4810c7457ce573775b639365c4938f71c0f38b308eb8f687f400b5423",
      "text": "Dhuwitku rong puluh ewu. Oleh kurang?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbc48864223a85891de427ab209ce0ddccb456e27bf77785f34c379789703967",
      "text": "Sewu siji. Pilih wae, Mas.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc1f97a678b158d92573463e3a9964b443d9b3fdfa2758418b0d818495131d08",
      "text": "nawa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "df8f4d210ab2aa490e6026590d98db8d015159f37576926e53cf5bf48fe1a961",
      "text": "patang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd7631030c121fcd505f7de9b8fa91e929ad05bc86534e91c28682b28ca415a",
      "text": "Sejuta wae.",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2c5d4bd4e901dd19e54f69f49fbdaff50a8a27888a561473abda6872ddd845e",
      "text": "usah",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e39d3a8893940f59614d972371a35af2436b0f967e7b08ab88778e0e90535837",
      "text": "adol",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3de5c55a4a87af9f27303c7372182b27f40f051f37685e7147c849b312415b3",
      "text": "enem",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5b147a037bf8a2dd58b54aab6c914265b07ec7aa922b2d5f7874c626bb2ccef",
      "text": "jupuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b4fb692be63eaa456a710dbde15ba274b4edd9be467b1d688bcaa62d85be1c",
      "text": "Sejuta wolung atus ewu.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec56315cbde576ab0847d4915045931f4217a460382ca385e63e595de697101b",
      "text": "Oke. Sesuk tak terke neng omahmu.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "eddab54f317cb3ba5f0e738fad4894b198ab15ba981f198d4ee0bf70b8beac92",
      "text": "Satus ewu, Mas. Iki sing cilik.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "eef42735979b4f5a63aa736bf4ed4b8fc8eadb4b20d37114a84982ece89bb4ee",
      "text": "Cah, HP iki arep diculke. Sapa sing arep tuku?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0ea479665b1584cfd6a6ab0537dd027516c11dcc114a2ba40d60b7ea2179f00",
      "text": "Sik, HP-ne tak jupuk.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "f16813c4d93ff725586dead5a8ac4b8a8dd2a1798e392b3c4ecb4683002f96b5",
      "text": "Aduh, HP-ku ucul! Tak jupuk sik.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f40682f95fa74a55885b37b245856317451059e0d5bae7c43947a02a23130f4e",
      "text": "sewu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4786963abec7f7e59dea73830e6b7f205d2f24c61fcd3ff00e2cf31d09c6bce",
      "text": "Mas, giliranmu. Aku wis tuku tas.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f95f2735e11b417bcaab168dddbe84e60d9377b0e551e3552433a88e31bb5dff",
      "text": "Tase abot, klambine kegedhen.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa6e7c10548d4681769c0d6b633d1ab388c94a9a2a032af265d248c6e010953e",
      "text": "wolu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc467ace64ee5e229932c3ff835ba9c6a32091bd54f16af0156348fc48641180",
      "text": "pungkasan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc735d00ae6e7f17842c2c67f4770576656b035c577d81aa8cc7680f0592cda0",
      "text": "Durung oleh, Mas. Sik tak lapor pusat.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "fedaafe35357621ff6f11263f2613d27f3ea5f327a94ef6171d07f0b375f52f3",
      "text": "Tak tukokke kopi, ya.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    }
  ],
