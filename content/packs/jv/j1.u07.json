    },
    {
      "id": "j1.u07.l04",
      "sha256": "6dcde4c206b3b716ba9c1ee2b1c0a9c16f0144292a2e3c8d887b50d018a4c82f"
    },
    {
      "id": "j1.u07.l05",
      "sha256": "59ca0c9cfdebf67d806af8af16457b36efc0e73670115d87238b58e6d7785b48"
    },
    {
      "id": "j1.u07.l06",
      "sha256": "b7874b4b43ed4fcf9e547437f76b44da6e03c947a10bd7e36a2886d031d83ee3"
    }
  ],
  "audio": [
    {
      "key": "020d05c13f0211fcfc7f6e32f5b30f5c4450f016b18ed2296b466e033ba0ac88",
      "text": "Cak, klambi iki regané pira?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e9e0c3fe20efb237a2964c01ab92316d9939815e4c10ce6b971f585b399bea",
      "text": "siji",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b86c0bb40cafd4c3e3b7288da70341bdcaf6cfd3d90a3e3645a20af4240d45f",
      "text": "durung oleh",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1208af2f8b90dcf752f67666e25e734f702c6f276eba725674f8a127a47649f5",
      "text": "Sek tak lapor pusat.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "122bf67bfab3954bcbfc9fde20890835269765afcd90b766cf59e188b9cc0b58",
      "text": "Regané pira? Oleh kurang?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "13d73ba64433d9e62a3ee1b7024b334cbec29bf482c42065b32f716de731b0f3",
      "text": "juta",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "174f87ec28541a43c61b7a974b523afd28016c4fdb93ffaf6331fde0b8b36b48",
      "text": "dhuwit",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "19ee76fa94d31181d400c08defdb4c27528255de6a4fe3a72dd87fae6b553d50",
      "text": "Oleh kurang? Rong ewu, ya.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2115dff38b6d6d001a5d87e8150355c8f853862dacccd07f00c53ee8cccd4341",
      "text": "Siji, loro, telu, papat, lima.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "21626625d312ed502286b8bdd64497072e55d77273da3895834a6745a8e5dc3b",
      "text": "sepuluh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "24b894df7a442eee8d0876cbbcac1b9e0c980f51f9938b5a74ce6bf4188b8404",
      "text": "Wolung puluh ewu, ya.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2611cf56cadb13512d21dc6a54119c515c87868664b93e07d9f7adf743916bcc",
      "text": "Teh telu.",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "26a11e3c4ec993a0463dded92cd774249568bda66deb280728c5d1fefeb37348",
      "text": "Satus ewu? Larang! Oleh kurang?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2943bfed0b1adc3170615f26ad6e5ac0be1c2a7715110f6d5a8eee9c64134fe6",
      "text": "Satus ewu? Larang!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "330582729855ce3a6f27a49f51d815930a5d72c659bb0189e065af49c4836761",
      "text": "Rong juta, Mas.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "34fc60f3bcb1a40489e9d1540a95d81caaa44b91269856dc4bbcb669b9fd6aa9",
      "text": "Cak, kopi loro. Regané pira?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cae601cc866aa76430000efa12a56b1926c02f2c2c4dfad44606bc98190be04",
      "text": "ewu",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "41af0af117c360b441bcaf6ebf1678c1de16556506d8654b8ab7fa8a017c9998",
      "text": "Kopi loro, Cak. Lan teh siji.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "51d9c1cc59e61e76acf7e631075bef846b3a4e62c4c5479cbd38a03af5e3c28b",
      "text": "Telung ewu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "535dd2aa008186e587b489ae3798dffafd525b6cedf208cad86cd0113641c932",
      "text": "rong ewu",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "53f2234b45fabecb2bdc4eb8b9ac9aef8be7191a9892bed661b453fbbe0ed192",
      "text": "HP-né arep diculké pira, Mas? Oleh kurang?",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5927276331f9fd971df6f5f87139ff306c0a09f24e25f8188eeb86a449419637",
      "text": "Nomer pitu. Omahmu?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a498d1ebaf1bf8e8ede243c8645e21da756348310250b1668350b83c2360252",
      "text": "Omahku nomer sanga.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a56eee46ffc97df994ba24c212696361401cc2f3c38304d497866e0e1a8f560",
      "text": "Rong juta? Larang, Cak! Oleh kurang?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "649b256303d930f0c60570e86c51cca6271001daee9f796234a0a01c4ffca83e",
      "text": "Wah, cedhak!",
      "voice": "jv_dimas",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "66515269f111c769d2d044c20e3867fb1df4b76b1e821bd147e7aa27fb5d8866",
      "text": "Pitu, wolu, sanga, sepuluh.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b3d02e2a8729bb492c606089fee922d0be75825cb84f228ebf638773586fbe4",
      "text": "HP-né arep diculké pira, Mas?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d300e0fff95d846f32d0020fb8f23fc81b9d1fda0c500f843ac7492ba374af4",
      "text": "oleh kurang?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d4785f34e8519986ed0068ecc10f980686809ba5d5b8e09f5957fe111c854e0",
      "text": "Siji limang ewu. Loro sepuluh ewu.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d99f8991a7eef135436656dde3fe73cbe5c0af95a7b477e6bdfb296bf603c8e",
      "text": "ya wis",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f9fb2e44d33dbec844e1c124b6dc3647b3364917da9ceb66b8d2fb7a0562aa1",
      "text": "pitu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "708f6dd20591f0bde67135d4fc9ecb68274d2a76984110eb03daf00e5843af8c",
      "text": "Satus ewu? Larang! Oleh kurang?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "749109f8c044c5e69d16f05bb4f8bb6e619ee82969cc9f623fd79044bbd67b03",
      "text": "Ayo, tak terké mulih.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "773329014cf499a70fc33be9bcb8d7b6f46031099ebca5a8962a44d7e438c498",
      "text": "sanga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "798acde05186cbf10a0830fee03141c6bce29354f67fd67a9e81ab02cef2c378",
      "text": "Wah, suwun, rek!",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a4d4af82f764426006076751a5a21df4a2f1cdd007830bb96d45e31a98e8da1",
      "text": "patang ewu",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b0f2c1217dc0fac9b7b7c2b2b3365fb01f1569ab35eb1816788ed57aa1468db",
      "text": "Regané pira?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f6fd1c925e8c31d586123ab271fca096b4ec371458a602fcfb6238f3fbb3688",
      "text": "ucul",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "81491b861b9264c234e8afe5611221218d6d5e558135aefe52710de01e6ffffc",
      "text": "murah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "88631a6f54b0ca9460e6913ece72e217ad86bb568bd173114a5e1d8a1da66a4e",
      "text": "Ya wis, oleh. Murah iki, Mas!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "886bd44a67e171abc9d9bc27a4191997d981fb6299182ce5c67766c9341246b1",
      "text": "Murah, Cak!",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "888a3e15117244ed8f635d6f9dc851819860ec29b8092e176ece2d2530427dc4",
      "text": "Kopi loro, Cak.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a0c41dc5450f4471e10406601177eee781613422559f1f099d7c78e4474c91f",
      "text": "Sejuta limang atus ewu, ya?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a2a4c93c8279bc3d4a213263001ca33064d96c78b104896f7a721489404deb3",
      "text": "Cak, HP iki arep diculké pira?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "90545c236ef1418374eabb28649b6b8694b7ebef80d48684037f720de64b633d",
      "text": "Iki dhuwité. Tak tukokké Cak Heru siji.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9464f2eb9dd4f251971c5b2f9a9abf5291b4ae96caf4e52de09e3613c2da00bd",
      "text": "arp dicul piro, Cak?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9849935c59713aade44a0909a51bd114fd9465006a0925f48f18c31655267b40",
      "text": "terké",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bc8c13c55ed0d9c9aee5e5b09e97b7ee876130387fc666a3bf2c20deb3a8cc9",
      "text": "Bayu, omahmu nomer pira?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c602b9f0d35814f8cbc13d773291adb99fc1aeb870f5ddd7966482e0aa51f2f",
      "text": "Sejuta pitung atus ewu.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e7e74afac7ded3bcca8dec32f1ad6f290b1046e1b299bd96819cad67fc8d130",
      "text": "Rong juta? Larang!",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "a025359ddd51cc9cda68d8be210b5811357afecf43dac2433fda3f6d3444099f",
      "text": "Satus ewu, Mas.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9ca2333a99754d5f4687fd0f051309b6c4735b5930947a197bf60cf8ffd361a",
      "text": "Kopi pira, Mas?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab9e41536c330adc60a7bade986e316962f9f6275e57c7ca4095a7ffc5c2f174",
      "text": "puluh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "abfedc4783616cccce885d9d317520ae7f9ca6f360b7d157a1a0141d427479be",
      "text": "Murah! Aku tuku, Cak.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad4c2a550461906766dc4ea64efca1210fcca0de2971441632346b5700b65271",
      "text": "Tak jupukaké, ya.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "afbf247e34dd3203e914ea70cc4238776994607e1afd3121183d31a56c9f6c04",
      "text": "loro",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4117a871824571cbcaf6aac092d2e9db98abb3183191fc6864ba688938ea4b4",
      "text": "papat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b72a60450873630f63728475387e3178e97034814b7642fc3c49470b2ddf4be5",
      "text": "Sejuta ae.",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b73f5003b3738e2603cd169b17b9c87a7148e284923ef0bd1727460421f0dab3",
      "text": "Limang ewu.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7b2b5e0a401d821f411ef00622b47753073252186aecd9f3da18532b58ea438",
      "text": "HP",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90ab8790202907cc0f8c69b0cf8f9018785ff750aa9be879e71e1c2a9585e24",
      "text": "atus",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "baada7377d304b859e18f36998a9d7879d0baa293102ef745525c3eaeaa58601",
      "text": "Kopi loro, teh siji. Wis?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf3e0d861dd6a854bf165f1c831c1b76b2e140b2aa700fe9d5725988b06d24fd",
      "text": "Sewu, rong ewu, telung ewu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e3d7dbe8cb8477b2fde4fd293623b4c3cad01b188ed9d6ef0123ed5bdcea51",
      "text": "Enem, pitu, wolu, sanga, sepuluh.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c395b3604fecfa0c67fc470b4f03d158cefb815aa389a4bf6f817cd14c2b0f29",
      "text": "Durung oleh, Mas.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "c72107fbb898bf47080ab61ba8f1b5ef765c94c6c13edd3f1af2ab800024b9ca",
      "text": "Regane pira? Telung ewu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb9957bda6a41ef1a03c8b3cf1d2570ea81b85c0f1b8ca1caee9ca30c2f1b9b1",
      "text": "Tak tukokké kopi, ya.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdbb8cdf97176e6eea8ab138d2b10e06aa778a400e3f18489a70dd3e8628f580",
      "text": "Eh, teh telu, Cak!",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "d03d983ae06956b41c3ba7e1071682aa16215f0498b4236ea6946312a4baa6b2",
      "text": "Regané pira? — Telung ewu.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d24fae3fd0de4c5444a3c363be0b12db43924ac54ae46f26201ec134af18b2f3",
      "text": "Pitung puluh ewu, Cak?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3f2130f109c652dfc13ea5101015b23dfa0761e664134ef0f16faee9075fb04",
      "text": "Sek, tak jupukké.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6a911ce0ffa2c1f8505d33a4850a50dcb40aca20098ae1f3c9b73c6c14e159e",
      "text": "arp dicul piro",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f6f0ab4f96022d5fffa8627b3469e29eb3149193e9766a9fb8bf8bd92ff851",
      "text": "telu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d75ce5b294dace1d198b7127a83c11208d3d51960b01fe2bf2943377d1e33b79",
      "text": "lima",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
