  "audio": [
    {
      "key": "060db2ed219853a6e4c5506acc242c13d66c320e7df73bda0facbe9058ea009a",
      "text": "HP-ne arep dituku sapa?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "09a95cb44a3ea4fe804ad054287c6d1f0652a848952948734de58c3b5b5d6bff",
      "text": "Sek tak lapor pusat",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "149d21812e77475eb6558a5ba501b58772a633c8650b71f48d1ad8a676cb7289",
      "text": "takon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "14bdaacbf4f29866fe34e82a869e45c463a419950b4ee74d4f0f94da3902df83",
      "text": "Mohamed, kowe arep tuku apa?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1534b4e9d9fd9449588c81e7e51b99f0c9df2e082ab126d1c7c1f4c6c55b030f",
      "text": "larang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "17177a3f44091eff8cdacd452d8004d3d2e1e7d79ec3c16f7b1d672eefa5e092",
      "text": "Iya, tak tuku, Pak. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "17363d5ceec68500ca6345ed4dc2e1806a0116b5cd6575f955d8f05e7bb68ff1",
      "text": "Kurmane enak lho!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "191af2d413951b036640e674867a694828f4cf7b810dac3c58263930351b1fd8",
      "text": "ae",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "23b472d1ff1f7214027d6decaccdbd3c4c0a3891e21631c1edaae8f26cc1629e",
      "text": "Sore, Mas. Tak tuku.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "31434dd85792c0fcf5ff8d43ad1b438095a9b6b06a3d5a8e2f421e4461631754",
      "text": "Aku mulih sek, ya.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c709e961d926c52ad9a7d00577b30c9367784f20d657961185062e6cc761927",
      "text": "Tak tuku, Pak.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f1bed2f933e4dc6dc46fb665fa1ae1603e5864dd752092db5bacec17514d494",
      "text": "Seratus ribu, Mas.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "40442cde5f2506e7cffce45ed243ced6a16aff3f185b4eb6305b142c3642ac72",
      "text": "Iya, tak tuku, Pak.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d12f3f526249ccc7908d766e7d0cf3849329d3bed4e806f58ab9546c915673",
      "text": "Aku arep tuku kurma.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d2da424a7a61dfba97da141d51cd0b3fbfdf52213840419e743d389135639cf",
      "text": "isih ana",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "52b0d4f81a0f2cb00ce41b5bb4d8534455afbdc8f966b56f308eeef3c2028173",
      "text": "ngomong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e67722c3db348ec3023c9dc5e250341b4447822f9947298ecebec5c70ba7b6",
      "text": "minyak wangi",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5552021840ad0668617eb999b1f6ed7c2562ab61a4bccec942ad392dc05c34be",
      "text": "toko",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c9f7edd6f832b5145c5f814cd7ebc44f4ee64a100baf4f01248a0bcf1abc30",
      "text": "tuku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e7425c0115ef82e3124e441bcf7c86084cdf77e25b28b97708481e52d18eb25",
      "text": "Iya Mas, tak tunggu.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f0dbb5fa8c7fd879ea6f2ca43eb77064b4a7be1628349176aae025065d97193",
      "text": "pusat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "618eab632d2c45afecae920ae5ca1a05fc2b7222db583cd75114767dedbbe3d8",
      "text": "Durung. Ayo! Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "655fda5f9a8eb51f65953dd21360f08ed3f5d0f4a203b127fade0a791a265171",
      "text": "Isih ana lho, Mas! Arep tuku kapan?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c2c910a7146373de99ed59238ee938d6661d7ced5a252ab31fdf27789ed3fe",
      "text": "Sugeng siang, Mas. Kurma Ajwa isih ana?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "683faa948df06f80f717b471be9d538a53b2d05c5796a349c6fba9f914ed4928",
      "text": "ta",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f02ffa52f50f04f70cc771ec62192ec927629911dd25a1de789da8ef99f880c",
      "text": "Oke, tak tunggu ya, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "8352cf4ae4a225363a3c846cb214ace50129b3d9a4b9843c8579e367ee21c24d",
      "text": "Mohamed, koen wis tuku kurma ta?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b2ff9064c4d02c8a0738808ce00d764ed4f84152c5dedd0be09e26cab0a5ebd",
      "text": "terke",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fa2ff936c554a18beafcc8ee8cd7ec5f7c8cc5e778eb6995803a71565eb1088",
      "text": "Kok larang, Pak?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "91ccd6a2078e0cb2ccfa7d1fb7c26f783bed85d8d76839f4f72c20c51eb890c3",
      "text": "Kurma Ajwa isih ana?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "959eacee02bb50a530b080851cdc5daaddc5c760f73236d2e00cac389c3df4b9",
      "text": "Tak tunggu, ya.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "9621113aaf90513259c965ff733899b0189ada92c623b27b8deb832c60f49d25",
      "text": "Mas, kurma Ajwa isih ana?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "97939b2da118281bf58bc39ac7a71a583d50bffe5d804483bb92e7d9d2182490",
      "text": "Bukune wis tak waca.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9920894e84892165cf174bab3fd257a1517b1f7a72ff2f633fe4eafb2ff4b3d7",
      "text": "mulih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac4c5b9f022ca57118c4516e7ac561941b555ae5fac441d26b8b1bd34192136b",
      "text": "Aku teh ae.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae4c014f21e7e7d03c5514397e6591ffecba5dd33298e269f37551cf02d0b508",
      "text": "Koen wis mangan ta, rek? Ayo mangan sek!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12f77ecf782315bdcfe35a0251bd9d88f998ff1222d2910a3767a6a5f87ba24",
      "text": "Pak, minyak wangi regane pira?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4d3c78b16d6334caaf5e99a002a51acc61b385d507e54ea94f2ca637909f8c0",
      "text": "Kok larang, Cak?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c02778701ef61482418be67b38f7c46dc38330d4e16037a00fbcba720d5a79",
      "text": "layang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bacf51db0e5dd799a18aa7ed4a0eb34882ffc6db113d9f953f6a8ec1860b867d",
      "text": "Sek, tak lapor pusat.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbbb4df771a6f81ffa3ebfcd55748d20e8721bf9f4974b85bb1e2511f24cf0cc",
      "text": "lapor",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfe2a29d1285be9b355c5c880a5dc80befc7deb214b4a49c44f75e743b649068",
      "text": "Iya Mas, tak tunggu.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "c43761e9beb69d5e20303d4d3d7e1c8cc91af01bf254d27c01ec0e451295dca5",
      "text": "Durung. Pak, kurma Ajwa isih ana?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68f324f02bbea9a29de7a2d2b4fde0778b6e4c1cd409dfaca0030cdac0c3327",
      "text": "Isih ana lho, Mas.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccd36ae19dfc06e6d141a6de0fd0ccf1100d2d825a6dc7b7d174981dcec41dcf",
      "text": "Wis, ayo mulih, rek!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "cecc95be36252e4e4f1f2cf4e3e833f9c4135009e1d64de0dea2739f5992636c",
      "text": "Layange wis kok waca?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3186551afc7911b5888f951f34382a80a70ce2849716fe30e9014613209d1b8",
      "text": "lho",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "db900016b9a1c781c45925996ceedb75b3058f2b2dac3304cd61c02cc8632054",
      "text": "Apik! Tak tuku, Pak.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc79869a566d0fcdcc3c1c7681cff4137fe4d0e7e925e3c9011aa5176d747a7b",
      "text": "Ora apa-apa kok.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27c111be81bf150a5b2df728f1ecf626c504206d39ebe8dde0e127a1f40a0e6",
      "text": "Matur nuwun. Sek, tak bungkus.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4515834d15e2ce85d181371719d63ef6fb6c892b0f1b709f97842c933bb0a99",
      "text": "Mbok mangan sek.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec70d16f130795861edf418069956c08b6100396ab5f5bf2a90539d8f038f63d",
      "text": "Sek tak lapor pusat",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0be48c27a07ca949a4aa56c28c5895f3b30ce3332ca948dac261c5cdb53bd0c",
      "text": "Iya, tak tunggu.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f136ce8e9310bfb730efa5c7e6b9a2eaca6ea789c8ef36226b870dc3f38571ce",
      "text": "Koen wis mangan ta, rek?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39941b1dfe6837854db8cc20661a6f6152dfd5551430e923906f7aef35b0c70",
      "text": "mbok",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8f5d2ba6128a3a491e48b24e70b77972d7e906922b6e50e3407ba67ffca7307",
      "text": "Kurma Ajwa, Mas? Apik lho.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa562be8f212fca89fb9f4bec39c89e880d163cb84d49ed04ce76b2a557d0d99",
      "text": "Wah, kurmane wis dituku Mohamed!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "fde36f3c78d53c15397ba5e22496afe3edf702a75152824d2b4dd11f5f6bf6ba",
      "text": "Asli lho, Mas!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe53ee70e338cef4390df05e8c32a53f0bb0623f450008ede72725f50037d1bf",
      "text": "tunggu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7e7bde0f246841d1eb01f21ca3db7f8a2e4cb3e30670960971874f382848ca",
      "text": "kok",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    }
