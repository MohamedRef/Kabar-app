    },
    {
      "id": "j1.u04.l03",
      "sha256": "e33f56a674aeaa7dd89786a7c6faf791ca936ff53850cde78fced64c46a14552"
    },
    {
      "id": "j1.u04.l04",
      "sha256": "9deb160665c6cf77c3b1d66da7bf06c6e5a27e04bbdb6ca4c2e32fe32356b706"
    },
    {
      "id": "j1.u04.l05",
      "sha256": "21c58956e357218e5152939285d12076febe83441bf91f676af4a81bf3745d31"
    },
    {
      "id": "j1.u04.l06",
      "sha256": "1c27aa3e8bddc1f4a46c1b16203d054a3c48dc6ad4e5718b4ec5eaa86034b5f6"
    },
    {
      "id": "j1.u04.l07",
      "sha256": "83a4eb2c3014512fdb200e28b0601da43140fe2bce6571cb500c9ba220b3ddcc"
    },
    {
      "id": "j1.u04.l08",
      "sha256": "a3e498d89e79a76ec855669c16308547b5a54627659d980a399b864bc1fe29e2"
    }
  ],
  "audio": [
    {
      "key": "060db2ed219853a6e4c5506acc242c13d66c320e7df73bda0facbe9058ea009a",
      "text": "HP-ne arep dituku sapa?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "08fb6dc4e1918ff43e1a2ff3b17796526efbfd672e8143a0f9e7f09e96bcde4a",
      "text": "Barange rusak, Mas.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "09bf099f7bedc7af179f6cf5e0326f7250c03388caf64be55c2bac65e9041ee8",
      "text": "barang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a045e3403244f945ea8d09a9cf0cc8ec191fc9edcf5878734698e595c12fbaf",
      "text": "Kurma, Mas. Sing gedhe neng ngisor, abot lho.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b9c0b7935ab527a786cd566c49160e10af1f3d92b3bfbae87ec23652bbf3786",
      "text": "Cah, ayo ngopi! Gaweanmu wis rampung?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "149d21812e77475eb6558a5ba501b58772a633c8650b71f48d1ad8a676cb7289",
      "text": "takon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "14bdaacbf4f29866fe34e82a869e45c463a419950b4ee74d4f0f94da3902df83",
      "text": "Mohamed, kowe arep tuku apa?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1534b4e9d9fd9449588c81e7e51b99f0c9df2e082ab126d1c7c1f4c6c55b030f",
      "text": "larang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "161f75725f633a7161d4891a2951d0eedd1d3ae48c1e46bc7c3e4fc9a1f4fa4d",
      "text": "ganti",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "165b7660541570804728b854fc45b98fe7ebb2673d5ae72676d6bd09937a1d57",
      "text": "jero",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "17363d5ceec68500ca6345ed4dc2e1806a0116b5cd6575f955d8f05e7bb68ff1",
      "text": "Kurmane enak lho!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "213cfa62320d2f0c0fc5836fc257ad9905add043c6eab42c1310362f3dc2a870",
      "text": "dhuwur",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2289100a18b604681b6318fa0134adcc673ec0a698c81563dcdfa963a5aab8f1",
      "text": "Kowe wis mangan to, cah? Ayo mangan sik!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "23b472d1ff1f7214027d6decaccdbd3c4c0a3891e21631c1edaae8f26cc1629e",
      "text": "Sore, Mas. Tak tuku.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "26636d77a9584004e50f3605169927c7659dfb9ecaebdcfe2bcdbb312c2201aa",
      "text": "Kowe wis mangan ta, cah?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "288be013b9b07da8ee5962513fd6dfe214d022318f95fbccfb4a18ffdf42b6e8",
      "text": "Aku teh wae.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f5044b049daa31d504f3d34ef67420e03b5e770e49cca6bef06fbde3e56c5e6",
      "text": "Lho, sing dhuwur iki rusak!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "33c6db9169e99d9757f765d4e676a67d92e8fa5a6b14640e0ca38d544c6adec6",
      "text": "kentekan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "361d517a5969cc02e04e9665b6ec77ebe188a3b9345d3e17019a06c80ae539e7",
      "text": "Isih apik, Mas. Kotake tak ganti.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "38bbb1c44f2f640ffb5c431c7d24901d43f1c1eca84aa21e8422bbde1fde4de2",
      "text": "rusak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "39a70fa07c6b05dda016bc0f568ce99d008284fd7b12193f07b836c73c88f473",
      "text": "angel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c709e961d926c52ad9a7d00577b30c9367784f20d657961185062e6cc761927",
      "text": "Tak tuku, Pak.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f1bed2f933e4dc6dc46fb665fa1ae1603e5864dd752092db5bacec17514d494",
      "text": "Seratus ribu, Mas.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "40442cde5f2506e7cffce45ed243ced6a16aff3f185b4eb6305b142c3642ac72",
      "text": "Iya, tak tuku, Pak.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "40cea7a2b7e9c780d1b422463d900e68f8111c608a5dd1f7b619ac6c278af27d",
      "text": "Mbok mangan sik.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d12f3f526249ccc7908d766e7d0cf3849329d3bed4e806f58ab9546c915673",
      "text": "Aku arep tuku kurma.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "49759460d8c05851323e66dd7f13c3a9c563548cf51da9dffa834b6ce8796a74",
      "text": "Mohamed, kurmane wis tak tuku!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c45a6274ee4cc5cddb54a362ff6e662e94db0ea9770826f407bc07819b986ab",
      "text": "Wah, wis kasep! Tokone kentekan.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d2da424a7a61dfba97da141d51cd0b3fbfdf52213840419e743d389135639cf",
      "text": "isih ana",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e72d8e4483c82ba158d1ab748075a6c3dd0e7d71f9679fca474c9e63a1a3c12",
      "text": "Basa Jawa gampang ta?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "52b0d4f81a0f2cb00ce41b5bb4d8534455afbdc8f966b56f308eeef3c2028173",
      "text": "ngomong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e67722c3db348ec3023c9dc5e250341b4447822f9947298ecebec5c70ba7b6",
      "text": "minyak wangi",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5552021840ad0668617eb999b1f6ed7c2562ab61a4bccec942ad392dc05c34be",
      "text": "toko",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c9f7edd6f832b5145c5f814cd7ebc44f4ee64a100baf4f01248a0bcf1abc30",
      "text": "tuku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ad10a17d5a2205d5973242964894d1f89e765a4e6df72ffb062fb80286e52f0",
      "text": "Kurma Ajwa isih ana neng toko?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cd109533218c1b4a6c82898af0ecb3848b7017fb9e8a88dd680ec525975a6b9",
      "text": "wae",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e7425c0115ef82e3124e441bcf7c86084cdf77e25b28b97708481e52d18eb25",
      "text": "Iya Mas, tak tunggu.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f0dbb5fa8c7fd879ea6f2ca43eb77064b4a7be1628349176aae025065d97193",
      "text": "pusat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "602cf576bfc2ce040d31aa415d40f2a84cbc13e4966ab05c3aa4dd2601d87489",
      "text": "Sik tak lapor pusat",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "608f02b544e440060704ca71cf3b8306274bfa7de269678ac99500ac0f0d6752",
      "text": "Mbok mulih sik.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "618eab632d2c45afecae920ae5ca1a05fc2b7222db583cd75114767dedbbe3d8",
      "text": "Durung. Ayo! Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "655fda5f9a8eb51f65953dd21360f08ed3f5d0f4a203b127fade0a791a265171",
      "text": "Isih ana lho, Mas! Arep tuku kapan?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c2c910a7146373de99ed59238ee938d6661d7ced5a252ab31fdf27789ed3fe",
      "text": "Sugeng siang, Mas. Kurma Ajwa isih ana?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "67c38f09de6c39d5675960481077c17b53780e3a4407b4e9af4bd02dcc3cfe75",
      "text": "Sik, tak takon regane.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "683faa948df06f80f717b471be9d538a53b2d05c5796a349c6fba9f914ed4928",
      "text": "ta",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a8eff4c046cee84e332ef5e26151cea2d91c7e4aa1a146d1f72decc3d1b6237",
      "text": "Mohamed, kowe wis tuku kurma ta?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b6786388c470a36c9254d692694e96eea2e36ccd371edeeb4340225f77929f9",
      "text": "kesuwen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c25a38304412f54ee324417f62364de98504aaa5ed57e0e6fc771a7f97c9175",
      "text": "Durung, Mas. Aku repot, sedhela ya.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d23ed27d78bd2105d6b8de955eb306b4dffd519fc3dae0eb27952234cb7fe5d",
      "text": "Kok kesuwen? Aku bali wae.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "6eda34298e21479317aa94479a7ed16246a2e26d5fc0471841330bd190f99421",
      "text": "Wis kasep, paket wis bali neng pusat.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f02ffa52f50f04f70cc771ec62192ec927629911dd25a1de789da8ef99f880c",
      "text": "Oke, tak tunggu ya, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f4962c9dd51268b007bd47087162900ef1d702ebbadd24aadea9bccc24780aa",
      "text": "Paketku kok durung tekan? Kesuwen!",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f5af5f49f59873e2dd3f1778cb0de4b9f6a22e84e4ddf48f99a5633b1ebce31",
      "text": "Basa Jawa angel? Ora, gampang!",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fa80df48d06b531671fa7aa48c74e7cf78961a906766b3aef5912ffa228527e",
      "text": "Sugeng siang, Mas. Paket saka ngendi?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7275433e6795604534fc60343c5223a40376ed9dfc3c6011540f7e77437c51cf",
      "text": "cilik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "74fea1fe764f57b0666acb8fde571d2ddc393881d9b7931ad5e2f2fe89b1f5d5",
      "text": "Paket kurma saka Mesir wis tekan.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b3cd1ab1ca678048f6311960fa6db07a3aaa6141b6c249f669b9f72d7e7ecd4",
      "text": "Sik tak lapor pusat",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "804989bbd9fcdba8e3197a63bce09d3daa9e867da21cf9668e2ce9ecdf94b797",
      "text": "kasep",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8490740ff354cdcbda1a1f6d619792e4c96344e447480b4d8a43b17a4db2335b",
      "text": "Ngapura, Mas. Wis kasep, kotake kentekan.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8991399fe44468d30f33138c3573f47fe7a104a4c09d57f3d0f316e332e070ad",
      "text": "Mas, kurma Ajwa isih ana neng toko?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a3ab4ac1ecd5e644594aa251b25c4fca0596140160942a2124331d7df65661b",
      "text": "Sik, tak lapor pusat.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b2ff9064c4d02c8a0738808ce00d764ed4f84152c5dedd0be09e26cab0a5ebd",
      "text": "terke",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bae45c6cfa5cefd53634efb3d15ef6f261206f7d6d266b94196117ea0c2a276",
      "text": "rampung",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cf044c84c1225829f9f88e3e6591a4fc4d3b6559973e0aec2478e241bcae1b5",
      "text": "Angel ta? Butuh tulung?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d9d5fe02cb86c74b5b6adb2f390fbe9c5bbc8aca217432208b00b522fca27c7",
      "text": "Lho, kotake rusak! Barange isih apik?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ee02434cbc8c9d57bbaa73d68d31bccd702af3017779824ca4323b6c38ca4cd",
      "text": "Saka Mesir, isine kurma. Kok kesuwen, Mas?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fa2ff936c554a18beafcc8ee8cd7ec5f7c8cc5e778eb6995803a71565eb1088",
      "text": "Kok larang, Pak?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "90e6ba285ddc4063774ec3afd75cf3379a455bc6eec3a18cacccb1bc574ab601",
      "text": "Kowe arep kurma? Ngomong wae, tak tuku.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "91ccd6a2078e0cb2ccfa7d1fb7c26f783bed85d8d76839f4f72c20c51eb890c3",
      "text": "Kurma Ajwa isih ana?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "91eafc9e34976557c9f9bf6f51710efb62ce0848ece50c20ba3b559cb07f52f0",
      "text": "Lho, minyak wangine kok larang, Mas?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "926d65f053103ce7a060329df45441513dd5146d8736c8c00ef74281046af738",
      "text": "Tak terke, ya.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9502b967a3203428af0d2e7aeda4624b9649bf47464291cbc66e3b348f33a0dd",
      "text": "alamat",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "958da2b2c38a03ce615a0dd320b049fe09a76ced79f6b21d8a194fc1d570f3c6",
      "text": "Aku mulih sik, ya.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "959c178a5f3304db64c3147a36160318787cf742ec7f28c195ecb055440dbb3c",
      "text": "Kurmane enak lho, Mas!",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "959eacee02bb50a530b080851cdc5daaddc5c760f73236d2e00cac389c3df4b9",
      "text": "Tak tunggu, ya.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "97939b2da118281bf58bc39ac7a71a583d50bffe5d804483bb92e7d9d2182490",
      "text": "Bukune wis tak waca.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "98684d751b00de9d3a6e3dd5850b8a5026c9ad3e8dc1153494a8867ed7a4d3ec",
      "text": "Kowe wis mangan to, cah?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9920894e84892165cf174bab3fd257a1517b1f7a72ff2f633fe4eafb2ff4b3d7",
      "text": "mulih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "99768934633e27c22cb7cf56998bbfd9464a53f85ef34b9fac612227b7a7cd6e",
      "text": "Barang sing gedhe neng ngisor, sing cilik neng dhuwur.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cd597944e2a3fc3cb2da4ab3e5a2aec5addb102dbab2778d7e346bd206e902a",
      "text": "Ora apa-apa, Mas. Ayo mangan kurmane sik!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d49b8a06b82dc2c10730c9f08d401f3c4d6de13bf4870af5f4d6f0668c4a5ba",
      "text": "Mohamed, aku isih neng Jakal. Kurmane enak lho!",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e8fcda56c3b7ce0b783b3889205027b16bb75b401a53b9034e53c9bae4c7c5f",
      "text": "perlu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ef1b553699f14d5a0e125471e41bcf8e67200126ead2c209c8ba058e4526355",
      "text": "Ayo! Enak lho, cah.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a25e64f371591075673779d9ea21fc8d876925696a38eb42e88c340a64531f56",
      "text": "Suwun, Mas! Regane pira?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2aafbf5be0b9c6c2d226bc3fe22aa34316f3a07f56d5d5fa7c93c79b2ee496f",
      "text": "Ya wis, tak tunggu neng warung.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6829c1f3ab4bb90475604f3e003fd9319c19db5e169d37ef9a89e63a8360cc9",
      "text": "Mas, dina iki paketmu akeh!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab6a666e962e7dfdc5b30258dae61a10ab571de9380eb17bd54ef7b197835ffa",
      "text": "Dina iki pakete akeh.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "acfca63dc2193a4aa49dba8c677d50a067af2bd02dd305eb103efe000d5f5c75",
      "text": "Sik, tak takon regane. Lho, kok larang?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa76e00435de7736a42ae776905b47c4655db883e8a6fa522eb8f69ef19f93e",
      "text": "Aku mulih bengi.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0dcbc61788090fccee291885c8fe2b343923d62cf12d5fc24bfb4570504ff3d",
      "text": "Larang, cah! Kurma Ajwa lho.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12f77ecf782315bdcfe35a0251bd9d88f998ff1222d2910a3767a6a5f87ba24",
      "text": "Pak, minyak wangi regane pira?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1a8a76986f2179a73efc0780682ed42574420d5c1ce1ae04247125918192233",
      "text": "repot",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7263c3af7f82b05d7c23a6f9b8aee800c829aef7b91dc4b10c32cf73f5f5ea1",
      "text": "Gaweanku wis rampung, aku mulih.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b73766b5c15483e6c9f1b38ecfd805cf11c58892ceab68c7acfe9276f173ece0",
      "text": "gawean",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c02778701ef61482418be67b38f7c46dc38330d4e16037a00fbcba720d5a79",
      "text": "layang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7cd594b5f99f52a06d4f51b9998ee871b021654a97107ee7d0d55c10a15a922",
      "text": "sedhela",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbbb4df771a6f81ffa3ebfcd55748d20e8721bf9f4974b85bb1e2511f24cf0cc",
      "text": "lapor",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc2b5d9b150ebebd8b6e953cffa176a2bdf7e3af6e5710d29ff4832475346bb9",
      "text": "Sedhela, Mas, tak lapor pusat.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdaa9a7078f73d12e0c0ee3c677a6661a69f856d6fcc7a2db25ceca7a5033ec1",
      "text": "wektu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "be3ab5580c8f5999aeacf25d0c0bb66207472c7ffba51336937a751830ffcc52",
      "text": "Wis, ayo mulih, cah!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd9e4cebcc1d2caa061b27cf7939ecdce186a69a71bcb476ef01260d21b1c8e",
      "text": "Matur nuwun. Aku bali neng omah saiki.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfe2a29d1285be9b355c5c880a5dc80befc7deb214b4a49c44f75e743b649068",
      "text": "Iya Mas, tak tunggu.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "c29864c0006e19eeaeffbbd1669b47260046ec0cc79278682fdb62b7eab4cd32",
      "text": "Kowe arep kurma? Ngomong wae, tak tuku. Aku mulih bengi.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3aec54d49213438d084c948448a14b49f87e54ea37cbc41799567a729627223",
      "text": "Wah, wis kasep!",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c43761e9beb69d5e20303d4d3d7e1c8cc91af01bf254d27c01ec0e451295dca5",
      "text": "Durung. Pak, kurma Ajwa isih ana?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68f324f02bbea9a29de7a2d2b4fde0778b6e4c1cd409dfaca0030cdac0c3327",
      "text": "Isih ana lho, Mas.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c93fb2d3c6599c46520c062e13f3f87b5d906d31ad96de0d679e08b94055e6e0",
      "text": "Matur nuwun. Sik, tak bungkus.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc5f3a69c8e0d66978f4adb679b7a32b9e1b5b4bb5e9c50f838b9740bb842dc4",
      "text": "bali",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cecc95be36252e4e4f1f2cf4e3e833f9c4135009e1d64de0dea2739f5992636c",
      "text": "Layange wis kok waca?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1a4eea70ba2a93caa3d9f21a60bc1ca3e5085713abaaeb63526fbfa571ef616",
      "text": "Iya, tak tuku. Ngomong karo pusat sik, ya.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3186551afc7911b5888f951f34382a80a70ce2849716fe30e9014613209d1b8",
      "text": "lho",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7792045574d04e6a216dfbb41e9f8a8e6e6aeadae144cd8f3ccdefc7c4d8495",
      "text": "gampang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d911c5262ffd317f2947830d4b799aa2407edd42e37393ba8517ea59af2d3119",
      "text": "Alamate ngendi, Mas?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "db900016b9a1c781c45925996ceedb75b3058f2b2dac3304cd61c02cc8632054",
      "text": "Apik! Tak tuku, Pak.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbce75a9a0c09b56cfe7bb3e404ecfe90d518137d23ffb83b7e195110644269e",
      "text": "Barange rusak? Tak ganti, ya.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc79869a566d0fcdcc3c1c7681cff4137fe4d0e7e925e3c9011aa5176d747a7b",
      "text": "Ora apa-apa kok.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "de982f4c162e11e088a46e3064f19e641ffcdc12d4d371a7cefa408ad1d5b2cc",
      "text": "Ora perlu, Mas. Gampang kok, mung layang siji.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0312cd71e2a85162f77533431aa9661e6bf80a29c20546c4d46fe559ee5bacd",
      "text": "ngisor",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6ba2110d80bd72bf426114a8412603f081520fe4657d64781eb8b7a6e6d7804",
      "text": "Gaweanku durung rampung.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8edd9b1bc845fa3c9c968b138f4acd58deea7d5eaff273d42e8a8dcfd963298",
      "text": "Kok larang, Mas?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9c0d75491e1a002cc260b012b2655dec71748ffd07ed8f8f44e8ce2a98995a6",
      "text": "akeh",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0be48c27a07ca949a4aa56c28c5895f3b30ce3332ca948dac261c5cdb53bd0c",
      "text": "Iya, tak tunggu.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2f6d1d8b13d384222c9fc3479b592d6c50bf2d1ed128bb5a8b19a29e69c17b0",
      "text": "paket",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39941b1dfe6837854db8cc20661a6f6152dfd5551430e923906f7aef35b0c70",
      "text": "mbok",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f588df6232269da0375a57e23269508527b847bcaf1df731feb60026329666f3",
      "text": "Repot? Ora, gampang kok!",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5a904f17affe0de4acaf118d9678ae4d71b39b11ad3f2c990e0c957314c521c",
      "text": "Sing cilik neng dhuwur, sing gedhe neng ngisor.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "f666d09bc5a7b3bdf5ff1b8e20fd817ed04d165f2619030d4f1c3800d8b17ad4",
      "text": "Ngapura. Alamate kliru, saiki wis tekan.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f796a4cc901b6bd733dba7b8d1f463af7c926becb9fe9eed4ac69c8e569cefb1",
      "text": "dina / dino",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7d446046ae73ed25f27b1fe67e9beb747bbe7b6786d78fadf2a9845242578b6",
      "text": "Sik, tak lapor pusat. Tunggu, ya.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8f5d2ba6128a3a491e48b24e70b77972d7e906922b6e50e3407ba67ffca7307",
      "text": "Kurma Ajwa, Mas? Apik lho.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa562be8f212fca89fb9f4bec39c89e880d163cb84d49ed04ce76b2a557d0d99",
      "text": "Wah, kurmane wis dituku Mohamed!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdc44b97e723d7492ab8a2a0510edea507892b70119ea7407d6a3ec6dc39b087",
      "text": "Waduh! Sing cilik iki apa?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "fde36f3c78d53c15397ba5e22496afe3edf702a75152824d2b4dd11f5f6bf6ba",
      "text": "Asli lho, Mas!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe305d5ae36cb78cb07c068e76753f53478c37ea92b71ba8e800a72fdf17e18e",
      "text": "butuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe53ee70e338cef4390df05e8c32a53f0bb0623f450008ede72725f50037d1bf",
      "text": "tunggu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7e7bde0f246841d1eb01f21ca3db7f8a2e4cb3e30670960971874f382848ca",
      "text": "kok",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    }
  ],
