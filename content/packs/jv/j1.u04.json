  "content_hash": "bc5a3213ccad7378d8edf280275405600cd336984de08160c615ca25d8ed005d",
  "lessons": [
    {
      "id": "j1.u04.l01",
      "sha256": "d4267bf7078b7e74ae6a8b8fa36dbed3c135ea34b34a9c6a276f07d8924a2689"
    },
    {
      "id": "j1.u04.l02",
      "sha256": "b69cd72dbffe4b0c10fa82d20c667894d4b9e3a8f30d4f456e123b9c9f6caa54"
    },
    {
      "id": "j1.u04.l03",
      "sha256": "9e535ffc5cf2ff0637170ef96aa65b25a12e4a37a63d73a2a312adb435b06caa"
    },
    {
      "id": "j1.u04.l04",
      "sha256": "6add84ac69685616dad22855908bee6761c8d2355ae202fb32f98c5aba21c182"
    },
    {
      "id": "j1.u04.l05",
      "sha256": "cf45f62003eca105ff4ced5ae23ca0ff23ae2a2cc941f366e8dea752abb8a4bd"
    },
    {
      "id": "j1.u04.l06",
      "sha256": "f3819614f5883a8d828d0cd47a8781935b6750060278f58a59043dfbb5253c03"
    },
    {
      "id": "j1.u04.l07",
      "sha256": "5a5fcb3ac9d77a720ebf4c9f99c56cb78540012b6c037fa0e589ca885db9f696"
    }
  ],
  "audio": [
    {
      "key": "060db2ed219853a6e4c5506acc242c13d66c320e7df73bda0facbe9058ea009a",
      "text": "HP-ne arep dituku sapa?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "08fb6dc4e1918ff43e1a2ff3b17796526efbfd672e8143a0f9e7f09e96bcde4a",
      "text": "Barange rusak, Mas.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "09a95cb44a3ea4fe804ad054287c6d1f0652a848952948734de58c3b5b5d6bff",
      "text": "Sek tak lapor pusat",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "09bf099f7bedc7af179f6cf5e0326f7250c03388caf64be55c2bac65e9041ee8",
      "text": "barang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f029a53098f8bb690c3c24b24f112c892748bdfbbf8c7fbdf96c1262da6d870",
      "text": "Sek, tak lapor pusat. Tunggu, ya.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "149d21812e77475eb6558a5ba501b58772a633c8650b71f48d1ad8a676cb7289",
      "text": "takon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "14bdaacbf4f29866fe34e82a869e45c463a419950b4ee74d4f0f94da3902df83",
      "text": "Mohamed, kowe arep tuku apa?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1534b4e9d9fd9449588c81e7e51b99f0c9df2e082ab126d1c7c1f4c6c55b030f",
      "text": "larang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "161f75725f633a7161d4891a2951d0eedd1d3ae48c1e46bc7c3e4fc9a1f4fa4d",
      "text": "ganti",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "17363d5ceec68500ca6345ed4dc2e1806a0116b5cd6575f955d8f05e7bb68ff1",
      "text": "Kurmane enak lho!",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "23b472d1ff1f7214027d6decaccdbd3c4c0a3891e21631c1edaae8f26cc1629e",
      "text": "Sore, Mas. Tak tuku.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2457e5473b9664a497dd12f47c2ee9a9d7ae7b1aa27a7bfd5587a24654476277",
      "text": "Alamate ngendi, Cak?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "31434dd85792c0fcf5ff8d43ad1b438095a9b6b06a3d5a8e2f421e4461631754",
      "text": "Aku mulih sek, ya.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "361d517a5969cc02e04e9665b6ec77ebe188a3b9345d3e17019a06c80ae539e7",
      "text": "Isih apik, Mas. Kotake tak ganti.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "38bbb1c44f2f640ffb5c431c7d24901d43f1c1eca84aa21e8422bbde1fde4de2",
      "text": "rusak",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "39a70fa07c6b05dda016bc0f568ce99d008284fd7b12193f07b836c73c88f473",
      "text": "angel",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c709e961d926c52ad9a7d00577b30c9367784f20d657961185062e6cc761927",
      "text": "Tak tuku, Pak.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f1bed2f933e4dc6dc46fb665fa1ae1603e5864dd752092db5bacec17514d494",
      "text": "Seratus ribu, Mas.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "40442cde5f2506e7cffce45ed243ced6a16aff3f185b4eb6305b142c3642ac72",
      "text": "Iya, tak tuku, Pak.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d12f3f526249ccc7908d766e7d0cf3849329d3bed4e806f58ab9546c915673",
      "text": "Aku arep tuku kurma.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "49759460d8c05851323e66dd7f13c3a9c563548cf51da9dffa834b6ce8796a74",
      "text": "Mohamed, kurmane wis tak tuku!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d2da424a7a61dfba97da141d51cd0b3fbfdf52213840419e743d389135639cf",
      "text": "isih ana",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e72d8e4483c82ba158d1ab748075a6c3dd0e7d71f9679fca474c9e63a1a3c12",
      "text": "Basa Jawa gampang ta?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "50bd1d92a4caa11e716f2852cb3343a01c448e9e511eace6e3fde7e28825c8e2",
      "text": "Kurmane enak lho, Cak!",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "52b0d4f81a0f2cb00ce41b5bb4d8534455afbdc8f966b56f308eeef3c2028173",
      "text": "ngomong",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e67722c3db348ec3023c9dc5e250341b4447822f9947298ecebec5c70ba7b6",
      "text": "minyak wangi",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "554ef808330cd71af2e4d068847d3be077046b60beac3b3d855349506848869f",
      "text": "Sek, tak takon regane.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "5552021840ad0668617eb999b1f6ed7c2562ab61a4bccec942ad392dc05c34be",
      "text": "toko",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c9f7edd6f832b5145c5f814cd7ebc44f4ee64a100baf4f01248a0bcf1abc30",
      "text": "tuku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e7425c0115ef82e3124e441bcf7c86084cdf77e25b28b97708481e52d18eb25",
      "text": "Iya Mas, tak tunggu.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f0a912c96c5659bf15462bd5479407902688dad2c97a0194c536c2cdbdd1806",
      "text": "Sek, tak takon regane. Lho, kok larang?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f0dbb5fa8c7fd879ea6f2ca43eb77064b4a7be1628349176aae025065d97193",
      "text": "pusat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f8ddea2ceccc20fafcf2b1bc14f7c988cc5f1298ed33e01d173e717973236dc",
      "text": "Ora perlu, Cak. Gampang kok, mek layang siji.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "618eab632d2c45afecae920ae5ca1a05fc2b7222db583cd75114767dedbbe3d8",
      "text": "Durung. Ayo! Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "655fda5f9a8eb51f65953dd21360f08ed3f5d0f4a203b127fade0a791a265171",
      "text": "Isih ana lho, Mas! Arep tuku kapan?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c2c910a7146373de99ed59238ee938d6661d7ced5a252ab31fdf27789ed3fe",
      "text": "Sugeng siang, Mas. Kurma Ajwa isih ana?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6668568f299d2895fab6582b194092c2b6dc5634ce052905d0a27feca802126c",
      "text": "Mohamed, aku isih nang Ampel. Kurmane enak lho!",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "683faa948df06f80f717b471be9d538a53b2d05c5796a349c6fba9f914ed4928",
      "text": "ta",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b6786388c470a36c9254d692694e96eea2e36ccd371edeeb4340225f77929f9",
      "text": "kesuwen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d23ed27d78bd2105d6b8de955eb306b4dffd519fc3dae0eb27952234cb7fe5d",
      "text": "Kok kesuwen? Aku bali wae.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e1675725206c042567d4a59066551b0669d9e838b75778defe51e603a028718",
      "text": "Matur nuwun. Aku bali nang omah saiki.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f02ffa52f50f04f70cc771ec62192ec927629911dd25a1de789da8ef99f880c",
      "text": "Oke, tak tunggu ya, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f4962c9dd51268b007bd47087162900ef1d702ebbadd24aadea9bccc24780aa",
      "text": "Paketku kok durung tekan? Kesuwen!",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f5af5f49f59873e2dd3f1778cb0de4b9f6a22e84e4ddf48f99a5633b1ebce31",
      "text": "Basa Jawa angel? Ora, gampang!",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fa80df48d06b531671fa7aa48c74e7cf78961a906766b3aef5912ffa228527e",
      "text": "Sugeng siang, Mas. Paket saka ngendi?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "74fea1fe764f57b0666acb8fde571d2ddc393881d9b7931ad5e2f2fe89b1f5d5",
      "text": "Paket kurma saka Mesir wis tekan.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "754de50be76e16157cc00685ef6016ab4acd90d2c2382b5d56434aaf57fa3e72",
      "text": "Ora apa-apa, Cak. Ayo mangan kurmane sek!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "78c8b68f5bceb89114a39de049a49035f0289aeef9524a5132e08961503dd618",
      "text": "ae / wae",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a008d2b569d9c5e71b7c214db39b27c6cdc866a5a9f0b98a07c380fa749c942",
      "text": "Durung, Cak. Aku repot, sedhela ya.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8352cf4ae4a225363a3c846cb214ace50129b3d9a4b9843c8579e367ee21c24d",
      "text": "Mohamed, koen wis tuku kurma ta?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b2ff9064c4d02c8a0738808ce00d764ed4f84152c5dedd0be09e26cab0a5ebd",
      "text": "terke",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bae45c6cfa5cefd53634efb3d15ef6f261206f7d6d266b94196117ea0c2a276",
      "text": "rampung",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cf044c84c1225829f9f88e3e6591a4fc4d3b6559973e0aec2478e241bcae1b5",
      "text": "Angel ta? Butuh tulung?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d9d5fe02cb86c74b5b6adb2f390fbe9c5bbc8aca217432208b00b522fca27c7",
      "text": "Lho, kotake rusak! Barange isih apik?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ee02434cbc8c9d57bbaa73d68d31bccd702af3017779824ca4323b6c38ca4cd",
      "text": "Saka Mesir, isine kurma. Kok kesuwen, Mas?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f894a838196071afe558f94c5040a14629266da51cce49ef5c818e202a07752",
      "text": "Suwun, Cak! Regane pira?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fa2ff936c554a18beafcc8ee8cd7ec5f7c8cc5e778eb6995803a71565eb1088",
      "text": "Kok larang, Pak?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "91ccd6a2078e0cb2ccfa7d1fb7c26f783bed85d8d76839f4f72c20c51eb890c3",
      "text": "Kurma Ajwa isih ana?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "926d65f053103ce7a060329df45441513dd5146d8736c8c00ef74281046af738",
      "text": "Tak terke, ya.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9502b967a3203428af0d2e7aeda4624b9649bf47464291cbc66e3b348f33a0dd",
      "text": "alamat",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "959eacee02bb50a530b080851cdc5daaddc5c760f73236d2e00cac389c3df4b9",
      "text": "Tak tunggu, ya.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "97939b2da118281bf58bc39ac7a71a583d50bffe5d804483bb92e7d9d2182490",
      "text": "Bukune wis tak waca.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9920894e84892165cf174bab3fd257a1517b1f7a72ff2f633fe4eafb2ff4b3d7",
      "text": "mulih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e8fcda56c3b7ce0b783b3889205027b16bb75b401a53b9034e53c9bae4c7c5f",
      "text": "perlu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fe8da24d9df9be7788f7599693a142ee0ab200679b19653c9dc051394721115",
      "text": "Ayo! Enak lho, rek.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a39e49a7eac98147bc9451132b952672c93320bb79599897f046a58845a4995c",
      "text": "Lho, minyak wangine kok larang, Cak?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8e653692c1bc3700beba4ea026bcc92ce2b8182848da7990cfe6baf54b7fcb3",
      "text": "Rek, ayo ngopi! Gaweanmu wis rampung?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac4c5b9f022ca57118c4516e7ac561941b555ae5fac441d26b8b1bd34192136b",
      "text": "Aku teh ae.",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad08b795f1a800216cdf1093940f208e43a881f8ebb1f043d7949d2356568978",
      "text": "Kowe arep kurma? Ngomong ae, tak tuku. Aku mulih bengi.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae4c014f21e7e7d03c5514397e6591ffecba5dd33298e269f37551cf02d0b508",
      "text": "Koen wis mangan ta, rek? Ayo mangan sek!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa76e00435de7736a42ae776905b47c4655db883e8a6fa522eb8f69ef19f93e",
      "text": "Aku mulih bengi.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12f77ecf782315bdcfe35a0251bd9d88f998ff1222d2910a3767a6a5f87ba24",
      "text": "Pak, minyak wangi regane pira?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1a8a76986f2179a73efc0780682ed42574420d5c1ce1ae04247125918192233",
      "text": "repot",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4d3c78b16d6334caaf5e99a002a51acc61b385d507e54ea94f2ca637909f8c0",
      "text": "Kok larang, Cak?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7263c3af7f82b05d7c23a6f9b8aee800c829aef7b91dc4b10c32cf73f5f5ea1",
      "text": "Gaweanku wis rampung, aku mulih.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b73766b5c15483e6c9f1b38ecfd805cf11c58892ceab68c7acfe9276f173ece0",
      "text": "gawean",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c02778701ef61482418be67b38f7c46dc38330d4e16037a00fbcba720d5a79",
      "text": "layang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7cd594b5f99f52a06d4f51b9998ee871b021654a97107ee7d0d55c10a15a922",
      "text": "sedhela",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b97bde427ffc8bfa0456250f9501a392f42d748ddbe8676fc382f5e836026e98",
      "text": "Larang, rek! Kurma Ajwa lho.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bacf51db0e5dd799a18aa7ed4a0eb34882ffc6db113d9f953f6a8ec1860b867d",
      "text": "Sek, tak lapor pusat.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbbb4df771a6f81ffa3ebfcd55748d20e8721bf9f4974b85bb1e2511f24cf0cc",
      "text": "lapor",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc2b5d9b150ebebd8b6e953cffa176a2bdf7e3af6e5710d29ff4832475346bb9",
      "text": "Sedhela, Mas, tak lapor pusat.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdaa9a7078f73d12e0c0ee3c677a6661a69f856d6fcc7a2db25ceca7a5033ec1",
      "text": "wektu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfe2a29d1285be9b355c5c880a5dc80befc7deb214b4a49c44f75e743b649068",
      "text": "Iya Mas, tak tunggu.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "c11215162a40b7bb901291eacdd6ae6fd1acd84767d35adcce6436e8c3466a91",
      "text": "Mbok mulih sek.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c43761e9beb69d5e20303d4d3d7e1c8cc91af01bf254d27c01ec0e451295dca5",
      "text": "Durung. Pak, kurma Ajwa isih ana?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68f324f02bbea9a29de7a2d2b4fde0778b6e4c1cd409dfaca0030cdac0c3327",
      "text": "Isih ana lho, Mas.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc5f3a69c8e0d66978f4adb679b7a32b9e1b5b4bb5e9c50f838b9740bb842dc4",
      "text": "bali",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccd36ae19dfc06e6d141a6de0fd0ccf1100d2d825a6dc7b7d174981dcec41dcf",
      "text": "Wis, ayo mulih, rek!",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "cecc95be36252e4e4f1f2cf4e3e833f9c4135009e1d64de0dea2739f5992636c",
      "text": "Layange wis kok waca?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3186551afc7911b5888f951f34382a80a70ce2849716fe30e9014613209d1b8",
      "text": "lho",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7792045574d04e6a216dfbb41e9f8a8e6e6aeadae144cd8f3ccdefc7c4d8495",
      "text": "gampang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "db900016b9a1c781c45925996ceedb75b3058f2b2dac3304cd61c02cc8632054",
      "text": "Apik! Tak tuku, Pak.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbce75a9a0c09b56cfe7bb3e404ecfe90d518137d23ffb83b7e195110644269e",
      "text": "Barange rusak? Tak ganti, ya.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc79869a566d0fcdcc3c1c7681cff4137fe4d0e7e925e3c9011aa5176d747a7b",
      "text": "Ora apa-apa kok.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27c111be81bf150a5b2df728f1ecf626c504206d39ebe8dde0e127a1f40a0e6",
      "text": "Matur nuwun. Sek, tak bungkus.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4515834d15e2ce85d181371719d63ef6fb6c892b0f1b709f97842c933bb0a99",
      "text": "Mbok mangan sek.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6ba2110d80bd72bf426114a8412603f081520fe4657d64781eb8b7a6e6d7804",
      "text": "Gaweanku durung rampung.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8d7b485ab58eb37550f565bccc64bb989680ee8a39e7c53f9ed2cf6cc316243",
      "text": "Iya, tak tuku. Ngomong karo pusat sek, ya.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec70d16f130795861edf418069956c08b6100396ab5f5bf2a90539d8f038f63d",
      "text": "Sek tak lapor pusat",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed2f0847672ca3da1385b97df5092f5519fe49a6023c5fe1af90c94461cb2c59",
      "text": "Ya wis, tak tunggu nang warung.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0be48c27a07ca949a4aa56c28c5895f3b30ce3332ca948dac261c5cdb53bd0c",
      "text": "Iya, tak tunggu.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f136ce8e9310bfb730efa5c7e6b9a2eaca6ea789c8ef36226b870dc3f38571ce",
      "text": "Koen wis mangan ta, rek?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2f6d1d8b13d384222c9fc3479b592d6c50bf2d1ed128bb5a8b19a29e69c17b0",
      "text": "paket",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39941b1dfe6837854db8cc20661a6f6152dfd5551430e923906f7aef35b0c70",
      "text": "mbok",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3f760a29a9e2f4e11623bb8fd4099e7f2ba7f5b73dd9a023d1767878d17cb30",
      "text": "Kowe arep kurma? Ngomong ae, tak tuku.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f422ff25584a90527cb2a7586f82730e3678e84de5d753711958ea568ac59243",
      "text": "Sepurane. Alamate kliru, saiki wis tekan.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "f588df6232269da0375a57e23269508527b847bcaf1df731feb60026329666f3",
      "text": "Repot? Ora, gampang kok!",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8f5d2ba6128a3a491e48b24e70b77972d7e906922b6e50e3407ba67ffca7307",
      "text": "Kurma Ajwa, Mas? Apik lho.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa562be8f212fca89fb9f4bec39c89e880d163cb84d49ed04ce76b2a557d0d99",
      "text": "Wah, kurmane wis dituku Mohamed!",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "fde36f3c78d53c15397ba5e22496afe3edf702a75152824d2b4dd11f5f6bf6ba",
      "text": "Asli lho, Mas!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe305d5ae36cb78cb07c068e76753f53478c37ea92b71ba8e800a72fdf17e18e",
      "text": "butuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe53ee70e338cef4390df05e8c32a53f0bb0623f450008ede72725f50037d1bf",
      "text": "tunggu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7b6b417f6a206a022423038983e173e296332bba73a4e9e0b7d3c11d040d01",
      "text": "Mas, kurma Ajwa isih ana nang toko?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7e7bde0f246841d1eb01f21ca3db7f8a2e4cb3e30670960971874f382848ca",
      "text": "kok",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff3888fcb57bce2b31f9fa76b290c542a6c836f39f51911f202806296530cb8c",
      "text": "Kurma Ajwa isih ana nang toko?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    }
  ],
