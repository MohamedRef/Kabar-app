  "audio": [
    {
      "key": "0120b5c8a098533b656cacffb47df2156b8b85ce8bafdc524c691526dbf5b9a3",
      "text": "Wonten batik, Pak?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bc8ca55461f6cbf6c563599cb7616ce3205814e687fba1ca774186d1e59cbf1",
      "text": "Sampéyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f5f6b0ec311859804f2f5409d72257e4c83267b463b66b7d312d425cbf8b7b4",
      "text": "Bapak wonten? — Mboten wonten.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "16f6f86083bba4b55cbeac13084b018a75349e6948c8a714fc536a53e0546931",
      "text": "Kula ugi dèrèng nedha.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "217e4322246abcdbe0e7ab65daefe6aace0855a454840499d68bfaa2caae54d7",
      "text": "Mas Mohamed, sampéyan badhé nedha?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "34e8a7ad2beb049f302f5e9b909ef547ef4b7b85fe2f5de329716c7c311a6aa8",
      "text": "Sampéyan sampun nedha? — Dèrèng.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "39169c19eaed2b85596f989da2c83faf6be3535901597c62991d2dda5ec36923",
      "text": "Inggih, kula sampun nedha. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "3da3587bbb5a50dbd1dbb8c89a2bf2532689be5fae62f27f441ab33704022e6c",
      "text": "Pak Harjo mboten wonten. Piyambakipun badhé dhateng peken.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "42784b475c55176e08dcbdace10d493cdb0f35e2dca9185efbc3c619811110ef",
      "text": "Inggih, Pak. Kula badhé nedha kaliyan Mas Dimas.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "455430e4c53b641d3cf6e27cbe7c28adf119c6dce38a6efd94955fe7beb002ef",
      "text": "Kula taksih sinau.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "485bf9e9fbbc78bf6b1fceac77345a5e24fe0723347e2d0b037b1876e1b8b76a",
      "text": "Inggih, Mas. Kula badhé dhateng Pasar Gede.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "489097a1feac3dbc868e5979e772b1bac7cc6ba33e13b11b12148435b2c69b41",
      "text": "Wonten, Mas. Menika.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c124275eda9d5a223fd4ea847172c521ed3dc7e065a9399abf88e947799a973",
      "text": "Wah, saé! Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "544453f28fc3359e0ca44dc158df8589d9df763db025bd8510a4f2a3ba9cd449",
      "text": "Inggih, mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c654e7de085a666d96b86e927b75d6707a40c13b8d7b8c89b3fc9b1dcd28c68",
      "text": "peken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c8d1a0048826bc3c0f96234ce97338f133a7515c6b6f61ecfcc6fdc8e5d69ff",
      "text": "wonten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cf8099ae5471698e99f0d93f3fe0052e6643cb31f07a8a23eb3761e326a3ede",
      "text": "Kula taksih sinau krama.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e172a9ad4922a0ff46fb91a782494c29b0a6b9bc4de64f5b7b083e186ec19a2",
      "text": "Nyuwun sewu, Pak. Wonten batik Kauman?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "60538001db7876c084c79ed0a92d1a9e4f9b09135f013d6f1905f85487899ad5",
      "text": "Mboten wonten, Pak. Piyambakipun taksih ing masjid.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6516409a494ffc19a9e1d53280a0cfbb534e33341753e631c3bc5b7b0176095a",
      "text": "ugi",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c704ff16b6de901eddeb3e8e85aaf04a111530aba94f2a928bc30891c83918",
      "text": "saé",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "65d5bcf1ad4168dba57d0af9eb08469bf6f6d6cef7c7d438a24cac78e297adcd",
      "text": "Dheweke durung mangan.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c3b63ecb24651bdfd98ba80466a43f6648d7dd1b29ce9fba6256d8d1172c48",
      "text": "arep",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a63f749d790efe332db4fb34b2ffdc7427bb664306610508b88ad387491ff5f",
      "text": "Kowé wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "75789ab33ddb554a72e069321b404ccf11c1988eb4334e7aa0a86475b1dbe716",
      "text": "Inggih, kula taksih sinau.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "812930c3c56e81e0f3b5ca2029c325febd3c10dfb81c0df69022e6008bf10095",
      "text": "badhé",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "83a9acc2c822a225f0f06654875d63acaab62a6f762386baaf4d31bceeae9d98",
      "text": "Sugeng enjing, Bu Siti. Sampéyan badhé dhateng peken?",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "841f5bbbbf5e36774e0ab6a2a216be33ecc3933e4c31913d706c4d555aad71c5",
      "text": "Kula dèrèng nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "858b9de9f9050c140a5464b03042fde2fca385af49afd8fc824ee6321a45086b",
      "text": "tèh",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "94438630f85ba3f85cbc14beeafe3546198db2b1fd72db51ac920652cf2a51cf",
      "text": "Mohamed, kowé wis mangan?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d9192da832bd08bf9012cf492edef7cc204d9919766995ba50a89d08753d73",
      "text": "Oh, inggih. Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "957bb7c84b6a24b4ea634cd59b1fb50dca7fad983604bcbb9e43ef791bfd3b50",
      "text": "Mas Dimas wonten?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "973d231be4b6b4ed1d89da0ae38db15527218a99d62cb6ca491135a0bee94b73",
      "text": "Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "978c7db4e5756ab272448d58653bd681df62d1f6a1d27ca4cc92a1cea51a21da",
      "text": "nyuwun sewu",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9970251b2b90c8fbdac3f057ac3f693a709d3dfe4f1793bbca28db403809fad9",
      "text": "Bapak wonten?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f730b942940a287bd746bbe43a2dbc2dec37e715cab8db31e06c976c5c45b7e",
      "text": "Durung, Mas. Ayo mangan!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85d5c00dc92de6ec3d62061a5826f99c5caea4e465b2f876a90832826d367bb",
      "text": "Mboten, Pak. Kula saking Mesir.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa7087edc0fb6ced4364216d9887489c47577b4d3cfc428bb3884219df91ad31",
      "text": "Wah, saking Mesir! Sugeng rawuh ing Kauman, Mas.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "af9032ec9fa72835b7574fd23a1bc3709031c698ac5056547bbaef06d69b8872",
      "text": "Sampun, Mas. Sampéyan badhé nedha?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b961f8285be28bec1c82fe11d3f73b14d7d624e1d80c5d34c996d2d2fd5ab393",
      "text": "Mboten wonten.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba5aab45592804d06e05a58d2372c2b53d0b112ba3647ffcb0ba1565d8676fcf",
      "text": "mboten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c408862f7cf2da1ccf4611c4e818281bce344efbc0132727080075a5176a6714",
      "text": "kaliyan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40c76bb521a906f8db347423c5bad149f2a25cd0742d8ae1e089eb19eb425ea",
      "text": "Nyuwun sewu, kula mboten ngertos.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6a0b51e56585335250b5446c689cddf0f0337f5d88600beffa6b72c0eed2e88",
      "text": "Inggih, menika batik Kauman.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c87251c0e6dfdbaa53757cf5fe67f3c06f841cd195c4800478cded815938a226",
      "text": "Dèrèng, Pak. Kula badhé nedha kaliyan Mas Dimas.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9414b1ee7e6fd919c238a013935c0e5cbf477b0c9ed1f8d0a62537ad64b6d8f",
      "text": "Kula dhateng Kauman kaliyan Mas Dimas.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc7a995744c8b4894861a322e33733e25505b9804cb0b822c9898fdb6fbbdc0c",
      "text": "ngertos",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d9bf1ab0f0f203c1b78212200d60fbf0ea27eabff396be28f850e52c345ef7",
      "text": "Dèrèng, Bu. Kula taksih sinau krama.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d70a1fe9e40b6344882508ca2610b0477927576c1830089521d547b566aaf655",
      "text": "Kula badhé dhateng Kauman.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9206ad888769ad20a75cfec6d4a1bf32c1ac5a46783b0270c833b98fb29b974",
      "text": "Dèrèng, Pak. Sampéyan?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9cf4db3790a30db3c2d40a254095ed1cdca6afb5c44761ee02d2f7dcf1a90b3",
      "text": "Mas saking Jakarta?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc9424b66f846829ab65427d748cde16afe107f9d67793a5c56bcbe54b426674",
      "text": "Kula badhé dhateng peken.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1149df35719d621c1c2a1121a584b17dd6417328357d20612175a4f1f4ca603",
      "text": "Kula ugi saking Kairo.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e344dd154a01a5f8a70ad8151aff430a22cf73c149a6b521d2aaa91d4ce83b47",
      "text": "masjid",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e553ba79bb154438a8b71a99e9693e8bc588c0800496fb93f1f1b326b520373b",
      "text": "Kula mboten ngertos.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7f8fefe2a286d700495cb529841b1f6375a1f362b8f3bd0b29255bd4586ec30",
      "text": "Menika batik Kauman.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04f11623e9cd6f5d92537fb0c3aaba8e4de6803321e7d9aaa7c7a21a9972aa6",
      "text": "Sampun, Mas. Sampéyan?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2a3fec42ffbba1ced852908481447c1bea2cd36c68e6ba47091ccf9d34a554e",
      "text": "dhateng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f949561c35495d239dfa57f5d6a8e2f8075d615b224f0359bd27638c9bc40566",
      "text": "taksih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe3919a7982ef594866fd6eea12d071e7c2d49c7e5749806a3b59afbf59f794f",
      "text": "Mas Mohamed! Sampéyan sampun nedha?",
      "voice": "jv_dimas",
