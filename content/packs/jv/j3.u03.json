    },
    {
      "key": "dd71040905070e4dada8776d7d802ec794a5f67da498cd087c939eb032824e48",
      "text": "Sae. Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddb50bb528be984307a803b2d583a231d92cdc56c29c7bcff79b6bd1fad62d14",
      "text": "Griya Mbah alit, nanging kepenak.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "de03dc7ac9dc02221e56bdc3daa86ec2fa9f502b37bc9fa5925f664cb1c40115",
      "text": "teh",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0662da9d5574a347bdcfd81054113e55f6da3fa5fd961fce9ac841e11732ba9",
      "text": "Batik menika mirah, nanging ___.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0ef7c553bdb1cf12521d6683cdcb8aed6934a209af2f5cf93980ad23a6e9c8e",
      "text": "Wah, sae! Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1149df35719d621c1c2a1121a584b17dd6417328357d20612175a4f1f4ca603",
      "text": "Kula ugi saking Kairo.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e344dd154a01a5f8a70ad8151aff430a22cf73c149a6b521d2aaa91d4ce83b47",
      "text": "masjid",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4ec6d54e9103f8a9a052b65b3d647c6d071dc4faae483146b4b9be09d288366",
      "text": "Matur nuwun, Pak. Punika PR kula.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6fc7a13dd2727efad660398d13eca1fd33cdfa0581d7973b597b3efae52ad1a",
      "text": "Kula badhe dhateng Kauman.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e96651f96e030efa93faeea42a268926cc199eb028ea4b6c96be229e7b72cca1",
      "text": "Mboten napa-napa. Krama sampeyan sampun sae, kados tiyang Jogja, lho!",
      "voice": "jv_siti",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab851d7ef9824a65d5a1605f3cd38a0385933febd530789e0951c4a3c47f79f",
      "text": "Sae, Pak. Kula mbekta menapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb297a399418a8c08e16fdd24954cd5e99964232e5a3cdfa2a318b840be3f29b",
      "text": "enjing",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec3b79ead8ccd02d980829f4bd98bf93671b3826e8ed574616d3a9818e4f0115",
      "text": "Mboten wonten, Mas. Bapak teng masjid.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed11c3932c1057776683800fcf3c2456e7c65c74a9ce285d75d0b7e4250dcf19",
      "text": "alit",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f17e858b4e3b3ddc227f31191985ecd02325cc48ffe719bd7b38114c67f56496",
      "text": "Bokmenawi benjing Mas Mohamed saged krama kados tiyang Jawi!",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "f550579e800108a87163382db1fe0558a6fcb81d12c0df3cae5451c7031dd41d",
      "text": "Wah, kathah sanget batikipun! Arta kula namung sekedhik.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f871556f5f5b011bde953501d2ed78e3ecec9af922d8d96c0c97b81ca0302f32",
      "text": "Aku weruh Mas Dimas ing pasar.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f890118a058d634c729ff8981dc49435a8e1ab7d9f93a404f6b15e59e9c39c99",
      "text": "Wonten, Mas. Niki.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe0acdcfd260e5bfaccc2e4541fe27bccdf15fa6f026b769f5e998e873263ede",
      "text": "Mas Mohamed, kula badhe dhateng peken kaliyan Bu Harjo.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff3e90c20d042de7e467d4c7cd9297910abc9efb23d7e96f18850646c34ded86",
      "text": "Sampeyan sampun nedha? — Dereng.",
      "voice": "jv_siti",
