      "sha256": "d3e5dfa92293f199696f5e2a46c19b053d17dbe43baca7e82b854704bd15f8a5"
    },
    {
      "id": "j3.u03.l07",
      "sha256": "5a5a7ae0d942bfb712148b77b7a348c7cea397e9d3de830bfdc42598213f8c9e"
    },
    {
      "id": "j3.u03.l08",
      "sha256": "10e80bb288b61a597e7369baa1aec670f52ea73a3b806f3cca4986683d8c3715"
    },
    {
      "id": "j3.u03.l09",
      "sha256": "337cbae4c93d4d7b2c76e282e08a8050ef7074ac2b8446a66a432dd5249a28f3"
    },
    {
      "id": "j3.u03.l10",
      "sha256": "4a3e1be5d797d37f555705f95b3e772bb620c17f7911682663c966916a3ff2d5"
    }
  ],
  "audio": [
    {
      "key": "0120b5c8a098533b656cacffb47df2156b8b85ce8bafdc524c691526dbf5b9a3",
      "text": "Wonten batik, Pak?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0257baae28fb2a8f08c679ccd03b69a509871bc9f468f08f8a9a3d3784ce27c6",
      "text": "dinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "02bf5d87e8ca796f6ee7a82ab8fa8ed2f506a511942862b2cc257db3d2504e63",
      "text": "Mas Dimas lan Mohamed ___ remen batik.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e11bbf86388ce8177996639004c53e4eedbfd23c16ce37167de91135404478",
      "text": "Sampeyan sampun nedha?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c70d839987bd1eb963c8eaf33e2b83a2bee46d2089e28e68eef253fc2529b8",
      "text": "mbekta",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "058a781d0464c430c9bc0d0f60ccef845917d466147de91acfb87a1df3c4fca6",
      "text": "Taksih, Mas. Mangga!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "07744122ac0b452e2a20e6f50b168b466096ed6b645a8bf43e540fd5e2963fb2",
      "text": "Dereng, Pak. Kula badhe dhateng masjid kaliyan Mas Dimas.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "089e7674d7b4072dc8496689aa9936f65e608054e903c3d0eb65c5a384c5e567",
      "text": "Dimas (ngoko): Aku durung mangan. Aku arep nang pasar karo Mohamed.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b0c04299ee23afed97a14a20f3c8a8eb85f2175b68df7a222da18b65db46cf5",
      "text": "badhe",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b8567874711963b6e9d54c636c238ce501953b3e133711f39e535b79ea978e7",
      "text": "Kula badhe dhateng peken.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f5f6b0ec311859804f2f5409d72257e4c83267b463b66b7d312d425cbf8b7b4",
      "text": "Bapak wonten? — Mboten wonten.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "11a9111c77aad46877bafdba4609752dd6627f62395112027aefd2584cefecb0",
      "text": "Sampun, Pak, nanging namung sekedhik.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "15d86f767745a425b8e05cdf4386042ccea5bffb27f54ab8e5a17cac82d728d1",
      "text": "Kula getun, wingi mboten tumbas batik.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "15ec90538baabab8f6fba284017245c30e04173fc12e760761cf5e1c6dd7f83c",
      "text": "langkung",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "17d6463544fbaf3342ec18b30bd699c773fb4f58a631bbdd6a65f01a3009d91f",
      "text": "Mohamed (krama): Mas Dimas dereng nedha. Piyambakipun badhe dhateng peken kaliyan kula.",
      "voice": "jv_siti",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "18a0e5e13599066e2c8862a2fc1bf0bcb462787874562c8dfe0f4b97f28c6563",
      "text": "kathah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "250ddee34da2ac24a9b44a068866241c853875734053ebe7568735ff143d2c03",
      "text": "menawi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ffa9b2bb046426fc463598ea954ca3385e80802177edd167979c2842ae6b6d",
      "text": "Batik taksih wonten. Matur nuwun! — Pak Harjo",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "27274718693e84701cdc6e5458270facf06d863ab744b6b47eeab0f550abc070",
      "text": "Nyuwun sewu, kula dhateng masjid.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f10b404058c255d0ab036c866e49a0694f290be7475640d3d9910762448831",
      "text": "Benjing enjing kula nengga panjenengan.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "28346ff436327eac7d231618575a9df64b5d1715a443930450f7f380db8f361f",
      "text": "nengga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b81288ec78bc6485f817e86fe6d8a39bfc756918ee78ecbf63c5bff443c2380",
      "text": "Mohamed, panjenengan sampun sinau?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d773bef6582d427f19277a2a17b297b411a9f9cf8b09fadbc9da6baa0af6078",
      "text": "Sugeng enjing, Bu Siti. Sampeyan badhe dhateng peken?",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f19ea64b8b304e1aa6dd12d4e04f0e4ffa2189d6bbd00b10ae06f5008d1afab",
      "text": "sedaya",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fbb9209c7a5f0e0e83a991aa62b9a8a8969f009f9dfa4a67f21a64e6e6ed98f",
      "text": "Menika langkung sae, nanging regi langkung awis.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "30da82a5abc9952a3f4d4930a8c9143af7320e7d41836c6e03b2349ef5886cbf",
      "text": "Sae. Kula taksih ing peken, Mas.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "30f03f4df3921911fcfde21b9ffa22f4bfb6adbbad72be09883bc0cf3a1f5d1c",
      "text": "Teh menika legi ___ gendhis.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "32802584f31d3d14da69844e8de65477dd2fad8489d315b26663de4617690b79",
      "text": "Dinten menika kula mbekta oleh-oleh.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "39169c19eaed2b85596f989da2c83faf6be3535901597c62991d2dda5ec36923",
      "text": "Inggih, kula sampun nedha. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c979827567b4fe4f6a6f11969f92b9e4a3f41f457ea275ea2bf13e354d6a0c3",
      "text": "Oh, Mas Mohamed! Sampeyan badhe dhateng Kauman?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3c182a37ef311a293dc78d7faa77e67128187120ec36f9a805d3098d716236",
      "text": "sekedhik",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "427a4453ece14f6b4cab26265bf529c9d2a7b097634bf363138183d2f988299e",
      "text": "Sampeyan badhe dhateng Kauman?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "47785775735929b680a9fd46359ae2f78f1d96575a58cc87195e5d41fd508ec1",
      "text": "getun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "489097a1feac3dbc868e5979e772b1bac7cc6ba33e13b11b12148435b2c69b41",
      "text": "Wonten, Mas. Menika.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b2d00a0dc26763976a6e90ded40875ae82e070dc1d647bf1c14eee0f9c9425f",
      "text": "Dereng, Pak. Sampeyan?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c1ff5dc539e0ad47cd8c288441915e564cd30f2b08a32f56ba37804e1519001",
      "text": "Tas menika awrat sanget.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "53abfd90c0c70373bcb8fe952db1b6977cbb8d4e9280038dd74fb7801e8d0236",
      "text": "Wonten teh, Pak?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "544453f28fc3359e0ca44dc158df8589d9df763db025bd8510a4f2a3ba9cd449",
      "text": "Inggih, mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c83eb409ac48c692fc1d8ee1ed8e3df864c667531ee0b4a6ae3679930df078",
      "text": "Kula ___ saged ngoko, dereng saged krama.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "560f59e8662e0b9eae9d5edd84f1bb550e75f5f5eaaed868d518592fa3ad1018",
      "text": "Ngenteni (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c654e7de085a666d96b86e927b75d6707a40c13b8d7b8c89b3fc9b1dcd28c68",
      "text": "peken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c8d1a0048826bc3c0f96234ce97338f133a7515c6b6f61ecfcc6fdc8e5d69ff",
      "text": "wonten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cf8099ae5471698e99f0d93f3fe0052e6643cb31f07a8a23eb3761e326a3ede",
      "text": "Kula taksih sinau krama.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e172a9ad4922a0ff46fb91a782494c29b0a6b9bc4de64f5b7b083e186ec19a2",
      "text": "Nyuwun sewu, Pak. Wonten batik Kauman?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "61b59f99ed3a53aa9024387219d5c218b5d8bea5118700ded52f20f1d649c91c",
      "text": "Kula ugi mboten ngertos.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6478d225f9b848b7940ed2f10135907e1e9aa9ab37dc4797404f5df411747b25",
      "text": "Menawi sayah, mangga linggih.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6516409a494ffc19a9e1d53280a0cfbb534e33341753e631c3bc5b7b0176095a",
      "text": "ugi",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "6528e357e71cdd0cc68add33a8a2dacbd749d4c59b9a3d41a006bcd91b343600",
      "text": "Krama langkung awrat tinimbang ngoko.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "65610983c24c29748303ccd6550d3b2808fc9c14aa0e7e28a348b301d3a2b3b5",
      "text": "awon",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "65d5bcf1ad4168dba57d0af9eb08469bf6f6d6cef7c7d438a24cac78e297adcd",
      "text": "Dheweke durung mangan.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "66752417d2f0644f628dafd29cb857a2895c56d340c415dd5fe46ec8a6992753",
      "text": "benjing",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c3b63ecb24651bdfd98ba80466a43f6648d7dd1b29ce9fba6256d8d1172c48",
      "text": "arep",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a96fb632b4a902317ea8081e938c235c650b387ee88f39c29f18281447081e3",
      "text": "Oh, inggih. Batik taksih wonten, Bu?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d63cf99bbd44a1ceba32f0be82977bb6906d3a10222588324138552c706d616",
      "text": "uga",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9c8881dc1a8885d1e08e50266c475edaa6215e29436694be674a90f58bdce1",
      "text": "Tiyangipun kathah sanget wonten peken.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "716fe571f8bdfdcc4cfe9f7f615f25f8ca54f04d09ae5aac4b0389b063e2c6dd",
      "text": "Matur nuwun, Bu. Krama taksih awrat kangge kula.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7260835a590cfb7abc7c8333f6cb0fd278a460de6927de5b708b58aeef5c87cd",
      "text": "Aku weruh omahe. → Kula ___ griyanipun.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "72e1fe4b019280f26ebc5cbce3c21265a06d0cee6f713049631a3e3adb0c14b2",
      "text": "Punika griya kula. Mangga mlebet.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "75789ab33ddb554a72e069321b404ccf11c1988eb4334e7aa0a86475b1dbe716",
      "text": "Inggih, kula taksih sinau.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7579806bd0fe8a99b7e546e41ad7c9d5330e9bfc3e79824309d1ec9fd36af4b6",
      "text": "Nyuwun sewu, Bu. Pak Harjo wonten?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "766f1a4e153a60d2d9b6e9d26d34a3edd40fc16e4c4aeac4fa268bd518f2f822",
      "text": "punika",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7861d507988c981f3761eabbdfa620ee1732773b82f9c6ea6b2066cc85c8ece0",
      "text": "Kula mboten sumerep griyanipun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "787fb876e940fc6110f8a277edfe63ea12082484ee06caadb4b3d1b311438b77",
      "text": "Sampeyan badhe dhateng Kauman, Mas?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e8a84905bfb8c5ec2df95ed5127a43e42cc3193c8d406edee7df553addc8c54",
      "text": "sonten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fc54993eb2fa65925a6a1f661b3094a92844fcd6419faa37406d46039a217d3",
      "text": "Kula badhe dhateng masjid.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "806cf64fae3a97b741e8b9ead81beea0c34975fdb0bda2546a3afff979e409ce",
      "text": "apik",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8305efbbd8a6741ee146de3470d43c9f74485e6c828f0709401e66355213190f",
      "text": "kados",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "868f8e08108435c1b5aac7d7f7fb4171e8f2baa046357d41ef62ea879496316f",
      "text": "Mboten wonten, Mas. Pak Harjo dhateng masjid.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "875aca50f110e5106eeecb32811d8ca815e3c68b0a50d0191a8b7e9fc6e7eb2d",
      "text": "Inggih, Pak. Kula getun, wingi kula dolan kemawon.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "89558b16c6e34b53a1f5628efd1d59063a745c119e8d4f3f24518089f78012e6",
      "text": "Inggih, Pak. Nanging kula dereng sumerep griyanipun.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e30dc59a22523868ed8635d76c6ed3cf74443c5df8e5263d97f98f0958c1ea4",
      "text": "Inggih, Pak. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d9192da832bd08bf9012cf492edef7cc204d9919766995ba50a89d08753d73",
      "text": "Oh, inggih. Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9641fe4655e4ed9d59ef5bbc1b6b01b01e43c254ce30b8321119c7f527c3a029",
      "text": "sae",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "973d231be4b6b4ed1d89da0ae38db15527218a99d62cb6ca491135a0bee94b73",
      "text": "Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "978c7db4e5756ab272448d58653bd681df62d1f6a1d27ca4cc92a1cea51a21da",
      "text": "nyuwun sewu",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "985df008093b81d8b6cb9fc4cd391a25ad9bec19d5d2bf65393233bb14e746d9",
      "text": "malih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a4a182bb1e8f516869dbab51fb8e819803183a7b109028f046c3e7bbc974f9e",
      "text": "weruh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e6974a47894c5bc02555512bb3135f41e938b865c8d04b042e05f37a4d352d9",
      "text": "Dereng, Pak. Mas Dimas ugi dereng.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e85f599583e56993a457f22c89082774f73fab1446aea4eaadba647a65f3801",
      "text": "Bu Harjo wonten ing griya.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f730b942940a287bd746bbe43a2dbc2dec37e715cab8db31e06c976c5c45b7e",
      "text": "Durung, Mas. Ayo mangan!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a306d08e243061b642de4380f3947cebc5ebf0e0853ae4972a18ded11998ca7a",
      "text": "awrat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a50d2c3ac43e3d66b12a0467a4d3d19ef4ab37d462ac5df459d9e00f3f8c84cf",
      "text": "Batik menika sae.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a634b8cbc4988a5bd16457f0f03abca85c7b408f6d7052a50c2ceb49bbc8526d",
      "text": "Dereng, Bu. Kula taksih sinau krama.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a723dff72c8d58159ca7b1e57500a5a60e15776d26c2bde18428acb595a28ef5",
      "text": "sumerep",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85d5c00dc92de6ec3d62061a5826f99c5caea4e465b2f876a90832826d367bb",
      "text": "Mboten, Pak. Kula saking Mesir.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa520d12778dd933d3c63206b6e86315d2d3a01601f0c60b1ad1e3535cbcac4d",
      "text": "Inggih. Dinten menika kula sinau ing griya.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa7087edc0fb6ced4364216d9887489c47577b4d3cfc428bb3884219df91ad31",
      "text": "Wah, saking Mesir! Sugeng rawuh ing Kauman, Mas.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac2da75e40aeba193b153a94f8fbb3f37c7367ec6ffa196c88953ecb36eb81f0",
      "text": "Kula ugi dereng nedha, Pak.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b31b48ee2be4fae175cb46375645730f00a677b719fd06528163dc6045e050bb",
      "text": "Nyuwun sewu, Mas, batik taksih wonten, nanging teh mboten wonten.",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b37655987b7d38ab8546d772b881e0c1ebfdbc83bc753e77a1932fec761262a4",
      "text": "Mas Mohamed! Sampeyan sampun nedha?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4a4b4549de634d1b2fe5701721e3243cf63ce448cb72ece65d4913537bbec30",
      "text": "Mbekta buku kemawon. Sonten kita sinau malih.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5dfd523eb42dd4261fb7bd290f98cfe3345aea172b6f6ad3c984cd9dffe4bfe",
      "text": "sami",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b81beffaf59fe49a4a77b84dd7ac15862934c53521de90873efdce769b87e0a8",
      "text": "kepungkur",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b858422fd52ccd3f0acdafaf42816a6ee52c1471eb190531c5079bfbe72c360a",
      "text": "Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1357d988fedef40ea8b55e2da6c160ff96d2f278898d26fa8c4ba2350aa229",
      "text": "Inggih, Pak, kaliyan Mas Dimas.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba5aab45592804d06e05a58d2372c2b53d0b112ba3647ffcb0ba1565d8676fcf",
      "text": "mboten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb20cf9bd10519cdd89f07375bb9361a29be1539a8f64f561a1bf5f7d01725ce",
      "text": "namung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb6b23d29b8981a7b35717dbcef49b4c7a0c64f4898e824da43d3c4017d8cb56",
      "text": "Inggih, Pak. Kula badhe nedha kaliyan Mas Dimas.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb8884cbc02e7a7bfb5e4575d33ec423a51f4f3b3be022bb2304c23c866c0b05",
      "text": "Menawi namung sekedhik, panjenengan kedah sinau malih.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc19a4a01240ff5657e355b85ab83bac0877397e7d33839d0124af3df017045e",
      "text": "Mohamed, kowe wis mangan?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcdf7f54fbaf8b24f219d16b7c06e82084b4101093e7fcd5157354135c9c91c8",
      "text": "Mboten menapa-menapa. Krama panjenengan sampun sae, kados tiyang Solo!",
      "voice": "jv_siti",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd212f02e43ec32baeb2142899be8065699b7dbf2a36eaedee5b67bbc5c98bd7",
      "text": "Sugeng sonten, Pak Harjo. Kula Mohamed.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdf87f490e34000222628fa3b4d166516a931c9f42334688e78b0c5c0cfdcd9a",
      "text": "Sampun, Mas. Sampeyan badhe nedha?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "be23e95655c8d98bd07ff2204228956826dbea93ce77fb10fa4092181ce074b4",
      "text": "Kula nengga wonten peken, jam pitu enjing.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c09791125f80ada82b8c4450f7224500571c8c29b7240752f6d45790416afbfb",
      "text": "Kula mboten sumerep griyanipun Pak Harjo.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c17953bed8210d4745fb6ea049fabd296fd5d1cfb48b50fdd0e39b34cb9e204d",
      "text": "Tiyangipun kathah sanget.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2297dbf6f7f1abdfe856fe14d93d5cdf2a2fd1f6566f2165803a74088cf8ff0",
      "text": "Sore (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c408862f7cf2da1ccf4611c4e818281bce344efbc0132727080075a5176a6714",
      "text": "kaliyan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40c76bb521a906f8db347423c5bad149f2a25cd0742d8ae1e089eb19eb425ea",
      "text": "Nyuwun sewu, kula mboten ngertos.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c58f4838de82c6c9f8c7713a20ecb639d04be3b4505dead3e417eecb0871626f",
      "text": "gampil",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a77ad847ca2afbd1cb8bd3ddb8d28138eab3850528d632fe6298e5498c01e6",
      "text": "Piyambakipun badhe dhateng peken kaliyan kula.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6a0b51e56585335250b5446c689cddf0f0337f5d88600beffa6b72c0eed2e88",
      "text": "Inggih, menika batik Kauman.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9414b1ee7e6fd919c238a013935c0e5cbf477b0c9ed1f8d0a62537ad64b6d8f",
      "text": "Kula dhateng Kauman kaliyan Mas Dimas.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb2f7f989cccbeaaae3a0856a8f893aeb8aedc67a43f83c3ac7c6568e9ff4ae3",
      "text": "Inggih, Mas. Kula badhe dhateng Pasar Gede.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3dc924f38efae8be4c8f6295c803febd9dc7b1a0e6b0034014dc2d9f4f9f33",
      "text": "Mboten menapa-menapa. Sedaya murid sami.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc7a995744c8b4894861a322e33733e25505b9804cb0b822c9898fdb6fbbdc0c",
      "text": "ngertos",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd1b11f5fd5e1f4ba38279945546e818b9841b580948ac6054dbffd023774424",
      "text": "Kula kedah sinau malih.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce074ae476d78ad5c4a26a608cf5c0af2691776700e08fb1f637ee116d1203f6",
      "text": "Sampeyan badhe dhateng peken?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce0a49e956262692b5f8fea2b8d0b699408956a1a6e98f56e806e0bae5459d8f",
      "text": "Benjing enjing kula nengga panjenengan wonten stasiun.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d613b6cef8054ece551ccfe7dd93b90c1cc22786230f8dc9fd05e7a1fdac79f5",
      "text": "Sedaya tiyang sami bungah.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9cf4db3790a30db3c2d40a254095ed1cdca6afb5c44761ee02d2f7dcf1a90b3",
      "text": "Mas saking Jakarta?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "db16494ed44aaf1362c81d3a0dbaf5e695bf12c16906338c7b817b6f247ef00f",
      "text": "Kula namung saged ngoko.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbf116ceeb9f714b2bc266d2a30314e7c57b5eb902e0c5f1a0ef8e88290a6d28",
      "text": "kedah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd71040905070e4dada8776d7d802ec794a5f67da498cd087c939eb032824e48",
      "text": "Sae. Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddb50bb528be984307a803b2d583a231d92cdc56c29c7bcff79b6bd1fad62d14",
      "text": "Griya Mbah alit, nanging kepenak.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "de03dc7ac9dc02221e56bdc3daa86ec2fa9f502b37bc9fa5925f664cb1c40115",
      "text": "teh",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0662da9d5574a347bdcfd81054113e55f6da3fa5fd961fce9ac841e11732ba9",
      "text": "Batik menika mirah, nanging ___.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0ef7c553bdb1cf12521d6683cdcb8aed6934a209af2f5cf93980ad23a6e9c8e",
      "text": "Wah, sae! Mangga, Mas.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1149df35719d621c1c2a1121a584b17dd6417328357d20612175a4f1f4ca603",
      "text": "Kula ugi saking Kairo.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e344dd154a01a5f8a70ad8151aff430a22cf73c149a6b521d2aaa91d4ce83b47",
      "text": "masjid",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3761aec8d51888cc3867b55477da662e0871e305a8ba404c8f0fef00b3ab0ff",
      "text": "Mas Mohamed, sampeyan badhe nedha?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4ec6d54e9103f8a9a052b65b3d647c6d071dc4faae483146b4b9be09d288366",
      "text": "Matur nuwun, Pak. Punika PR kula.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6fc7a13dd2727efad660398d13eca1fd33cdfa0581d7973b597b3efae52ad1a",
      "text": "Kula badhe dhateng Kauman.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab851d7ef9824a65d5a1605f3cd38a0385933febd530789e0951c4a3c47f79f",
      "text": "Sae, Pak. Kula mbekta menapa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb0c4a3fda8a697dc537aa6a1dfcfe21a9e376eac9f1a33d0e73289a75b19df5",
      "text": "Mas Mohamed, sampeyan sampun nedha?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed11c3932c1057776683800fcf3c2456e7c65c74a9ce285d75d0b7e4250dcf19",
      "text": "alit",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef4e4fd70b2de3fce0084ccbe96d771d87187b08a8e4499b5f59f9776d39f182",
      "text": "Batik alit setunggal, Bu.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2a3fec42ffbba1ced852908481447c1bea2cd36c68e6ba47091ccf9d34a554e",
      "text": "dhateng",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f550579e800108a87163382db1fe0558a6fcb81d12c0df3cae5451c7031dd41d",
      "text": "Wah, kathah sanget batikipun! Arta kula namung sekedhik.",
      "voice": "jv_dimas",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f58ff21caea28b192b9077dd149e394395b4c2162cf8ba8ec7dde5545ba1249c",
      "text": "Mas Mohamed, tumbas menapa?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "f871556f5f5b011bde953501d2ed78e3ecec9af922d8d96c0c97b81ca0302f32",
      "text": "Aku weruh Mas Dimas ing pasar.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f949561c35495d239dfa57f5d6a8e2f8075d615b224f0359bd27638c9bc40566",
      "text": "taksih",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fce7b77a47f3372f207a6c61c7e7f618c8a046d69dde4da8e4f42d1a85343878",
      "text": "Mohamed, benjing enjing panjenengan dhateng griya kula?",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
