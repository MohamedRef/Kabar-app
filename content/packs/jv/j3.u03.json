    },
    {
      "id": "j3.u03.l10",
      "sha256": "935dca29885baf5ea1a1a3ee557c1a832afdf5db17f50ae46513f7baa71f09f6"
    },
    {
      "id": "j3.u03.l11",
      "sha256": "23df3b7461a3f9d7bfe402f12013d6b8206c428c4466171452a9f332cb65b1ea"
    }
  ],
  "audio": [
    {
      "key": "0120b5c8a098533b656cacffb47df2156b8b85ce8bafdc524c691526dbf5b9a3",
      "text": "Wonten batik, Pak?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0257baae28fb2a8f08c679ccd03b69a509871bc9f468f08f8a9a3d3784ce27c6",
      "text": "dinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "02bf5d87e8ca796f6ee7a82ab8fa8ed2f506a511942862b2cc257db3d2504e63",
      "text": "Mas Dimas lan Mohamed ___ remen batik.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c70d839987bd1eb963c8eaf33e2b83a2bee46d2089e28e68eef253fc2529b8",
      "text": "mbekta",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "07744122ac0b452e2a20e6f50b168b466096ed6b645a8bf43e540fd5e2963fb2",
      "text": "Dereng, Pak. Kula badhe dhateng masjid kaliyan Mas Dimas.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b4e34c9769fc37312e25d10422ad896b66afadde1add4ec0e6d1665b3d39cbe",
      "text": "amargi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b8567874711963b6e9d54c636c238ce501953b3e133711f39e535b79ea978e7",
      "text": "Kula badhe dhateng peken.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f5f6b0ec311859804f2f5409d72257e4c83267b463b66b7d312d425cbf8b7b4",
      "text": "Bapak wonten? — Mboten wonten.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f82e3f553e2aa06c7dede78b6f6baf5e7fa849c95488dea7150ada813b2f09b",
      "text": "sanes",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "11a9111c77aad46877bafdba4609752dd6627f62395112027aefd2584cefecb0",
      "text": "Sampun, Pak, nanging namung sekedhik.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "13ae6827158e0e1bbfdaebb191828be328a2056a2a193d7c876084bbd9ef9903",
      "text": "Badhe teng peken?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c4c6d140ef07fc67b9803c50c59926711960abc17ea7f0c82b9caeb8fca0f3",
      "text": "ngaten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1544e066a162fbbe92e750229405518920cbda2b370d6ea852c580a62d959ee3",
      "text": "kinten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "15d86f767745a425b8e05cdf4386042ccea5bffb27f54ab8e5a17cac82d728d1",
      "text": "Kula getun, wingi mboten tumbas batik.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "15ec90538baabab8f6fba284017245c30e04173fc12e760761cf5e1c6dd7f83c",
      "text": "langkung",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1691c75181fa1e77417042659a271bac7b30d7ba6179c6a50e6c252aa1451335",
      "text": "pitados",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "17d6463544fbaf3342ec18b30bd699c773fb4f58a631bbdd6a65f01a3009d91f",
      "text": "Mohamed (krama): Mas Dimas dereng nedha. Piyambakipun badhe dhateng peken kaliyan kula.",
      "voice": "jv_siti",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "18a0e5e13599066e2c8862a2fc1bf0bcb462787874562c8dfe0f4b97f28c6563",
      "text": "kathah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a852820086ca8aabc4ee85591ff78612ae8ef813383c9240286b2615468a491",
      "text": "Mase saking Jakarta?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c481fc84b04d96621b2b6edf9ce4692ddb577ceff4f2c09fcd25b976c718b90",
      "text": "Sampun, Mas. Badhe nedha?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7eae74754f2afe215d1175bb4c4b5b8e629a92996091c5fb43178ec5ea6756",
      "text": "Matur nuwun, Bu.",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "250ddee34da2ac24a9b44a068866241c853875734053ebe7568735ff143d2c03",
      "text": "menawi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ffa9b2bb046426fc463598ea954ca3385e80802177edd167979c2842ae6b6d",
      "text": "Batik taksih wonten. Matur nuwun! — Pak Harjo",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "27274718693e84701cdc6e5458270facf06d863ab744b6b47eeab0f550abc070",
      "text": "Nyuwun sewu, kula dhateng masjid.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "277a9be25d99b809d2895cc7e5e8f22f44e8a8abb53c626a56410e43254781d6",
      "text": "pernah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f10b404058c255d0ab036c866e49a0694f290be7475640d3d9910762448831",
      "text": "Benjing enjing kula nengga panjenengan.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "28346ff436327eac7d231618575a9df64b5d1715a443930450f7f380db8f361f",
      "text": "nengga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b81288ec78bc6485f817e86fe6d8a39bfc756918ee78ecbf63c5bff443c2380",
      "text": "Mohamed, panjenengan sampun sinau?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f19ea64b8b304e1aa6dd12d4e04f0e4ffa2189d6bbd00b10ae06f5008d1afab",
      "text": "sedaya",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "30f03f4df3921911fcfde21b9ffa22f4bfb6adbbad72be09883bc0cf3a1f5d1c",
      "text": "Teh menika legi ___ gendhis.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "32802584f31d3d14da69844e8de65477dd2fad8489d315b26663de4617690b79",
      "text": "Dinten menika kula mbekta oleh-oleh.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "38367ccac38da0539a39a02e055992ed4c7d99c3f5b0c8bff6a42420055e9725",
      "text": "Taksih, Mas. Mangga, pinarak!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "39169c19eaed2b85596f989da2c83faf6be3535901597c62991d2dda5ec36923",
      "text": "Inggih, kula sampun nedha. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b55b083b676ad512ca0ec62d5d580ad44eca57444a449fbda838e98e59eab60",
      "text": "Enjing kula badhe dhateng peken.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3c182a37ef311a293dc78d7faa77e67128187120ec36f9a805d3098d716236",
      "text": "sekedhik",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "427a4453ece14f6b4cab26265bf529c9d2a7b097634bf363138183d2f988299e",
      "text": "Sampeyan badhe dhateng Kauman?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "427e3725eac25cb34d96039c15af26a61bc2b60d926aa4a73a25e3033db8db92",
      "text": "Kula dereng nate dhateng Kauman.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "43eaa448149c7c9167a0d42e054c5acd59847ae3e037053d366d7ef80ebc02ba",
      "text": "Mas Mohamed! Sampun nedha?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4474874ef081bbc60dd333f8ddd6e80f506df7187e7fd956722bfc06e63d5ec6",
      "text": "Kula kinten dereng, Bu. Kula taksih sinau.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "47785775735929b680a9fd46359ae2f78f1d96575a58cc87195e5d41fd508ec1",
      "text": "getun",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b2d00a0dc26763976a6e90ded40875ae82e070dc1d647bf1c14eee0f9c9425f",
      "text": "Dereng, Pak. Sampeyan?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c1ff5dc539e0ad47cd8c288441915e564cd30f2b08a32f56ba37804e1519001",
      "text": "Tas menika awrat sanget.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c9a6e310d0fe86348a6cc696cba8ba488f3c297f8af311748dc5f8e27f872b0",
      "text": "ananging",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d5d32cddd085332ae5973c26621bc4e1c8b4c9b5dafe0fb12370a3b6e0797da",
      "text": "Sugeng enjing, Bu Siti. Badhe teng peken?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "525923e5e7bd10bb575948f5a88dd1b87966e34376edf57649ab802025682cff",
      "text": "Oh, Mas Mohamed! Badhe teng Kauman?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "53abfd90c0c70373bcb8fe952db1b6977cbb8d4e9280038dd74fb7801e8d0236",
      "text": "Wonten teh, Pak?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "54465aa54cd7abd7d414b575940fbd220dcd9a4250c67e26a6fd45266c7e7057",
      "text": "Krama sampeyan sae sanget. Saestu sanes tiyang Jawi?",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "55936691b2256623461172998feec066de62801e4e57bc44da17e60108741822",
      "text": "Mas Mohamed, badhe tumbas napa?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c83eb409ac48c692fc1d8ee1ed8e3df864c667531ee0b4a6ae3679930df078",
      "text": "Kula ___ saged ngoko, dereng saged krama.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "560f59e8662e0b9eae9d5edd84f1bb550e75f5f5eaaed868d518592fa3ad1018",
      "text": "Ngenteni (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "59ac2aa759231021e3117911f426c57b2b1a06ab816c846208c8a5ef7f1a8110",
      "text": "Niki langkung sae, Mas.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c654e7de085a666d96b86e927b75d6707a40c13b8d7b8c89b3fc9b1dcd28c68",
      "text": "peken",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cf8099ae5471698e99f0d93f3fe0052e6643cb31f07a8a23eb3761e326a3ede",
      "text": "Kula taksih sinau krama.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "5daf7ee48e59af7b529b5abe3b80123272a668d98ee861ffc0cdf9583ffd5857",
      "text": "Ngaten, Mas: sinau sekedhik, ananging saben dinten.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e172a9ad4922a0ff46fb91a782494c29b0a6b9bc4de64f5b7b083e186ec19a2",
      "text": "Nyuwun sewu, Pak. Wonten batik Kauman?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "61b59f99ed3a53aa9024387219d5c218b5d8bea5118700ded52f20f1d649c91c",
      "text": "Kula ugi mboten ngertos.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "621c240ea6bd9b979ccfa2ee6136406d6d0a4b2a57acc7df72e4e5a0ee6746b7",
      "text": "Mbekta buku mawon. Sonten sinau malih.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6478d225f9b848b7940ed2f10135907e1e9aa9ab37dc4797404f5df411747b25",
      "text": "Menawi sayah, mangga linggih.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6516409a494ffc19a9e1d53280a0cfbb534e33341753e631c3bc5b7b0176095a",
      "text": "ugi",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "6528e357e71cdd0cc68add33a8a2dacbd749d4c59b9a3d41a006bcd91b343600",
      "text": "Krama langkung awrat tinimbang ngoko.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "65610983c24c29748303ccd6550d3b2808fc9c14aa0e7e28a348b301d3a2b3b5",
      "text": "awon",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "65d5bcf1ad4168dba57d0af9eb08469bf6f6d6cef7c7d438a24cac78e297adcd",
      "text": "Dheweke durung mangan.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "66752417d2f0644f628dafd29cb857a2895c56d340c415dd5fe46ec8a6992753",
      "text": "benjing",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "67a38c278e242b8e945b5d1ec7186054826efd30d2261073c5be1c6d708eb6c7",
      "text": "Sampun nedha, Mas?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c3b63ecb24651bdfd98ba80466a43f6648d7dd1b29ce9fba6256d8d1172c48",
      "text": "arep",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a96fb632b4a902317ea8081e938c235c650b387ee88f39c29f18281447081e3",
      "text": "Oh, inggih. Batik taksih wonten, Bu?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d63cf99bbd44a1ceba32f0be82977bb6906d3a10222588324138552c706d616",
      "text": "uga",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d730a79c83c186bb4c681c20736b9c2b90a4a6e272bba801ef4d942cc432f44",
      "text": "Menawi namung sekedhik, nggih kedah sinau malih, to.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9c8881dc1a8885d1e08e50266c475edaa6215e29436694be674a90f58bdce1",
      "text": "Tiyangipun kathah sanget wonten peken.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6de59594cca7c64bf421d1165a61c5deeb15ffca79d8ea95a5fb7371d0030f1f",
      "text": "Kula pitados. Amargi sinau saben dinten, krama sampeyan sae.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "716fe571f8bdfdcc4cfe9f7f615f25f8ca54f04d09ae5aac4b0389b063e2c6dd",
      "text": "Matur nuwun, Bu. Krama taksih awrat kangge kula.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7260835a590cfb7abc7c8333f6cb0fd278a460de6927de5b708b58aeef5c87cd",
      "text": "Aku weruh omahe. → Kula ___ griyanipun.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "72e1fe4b019280f26ebc5cbce3c21265a06d0cee6f713049631a3e3adb0c14b2",
      "text": "Punika griya kula. Mangga mlebet.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "75789ab33ddb554a72e069321b404ccf11c1988eb4334e7aa0a86475b1dbe716",
      "text": "Inggih, kula taksih sinau.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7579806bd0fe8a99b7e546e41ad7c9d5330e9bfc3e79824309d1ec9fd36af4b6",
      "text": "Nyuwun sewu, Bu. Pak Harjo wonten?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7861d507988c981f3761eabbdfa620ee1732773b82f9c6ea6b2066cc85c8ece0",
      "text": "Kula mboten sumerep griyanipun.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "787fb876e940fc6110f8a277edfe63ea12082484ee06caadb4b3d1b311438b77",
      "text": "Sampeyan badhe dhateng Kauman, Mas?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e8a84905bfb8c5ec2df95ed5127a43e42cc3193c8d406edee7df553addc8c54",
      "text": "sonten",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fc54993eb2fa65925a6a1f661b3094a92844fcd6419faa37406d46039a217d3",
      "text": "Kula badhe dhateng masjid.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "829a70eb8734c3f9e02663c2bce0084121122fa156fb1a5c778fd868262e0c85",
      "text": "bokmenawi",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8305efbbd8a6741ee146de3470d43c9f74485e6c828f0709401e66355213190f",
      "text": "kados",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8711deb1ebc8e6b9d15c7962f00488f5cf9e1659ca108e95fcb1b15e9eb075dd",
      "text": "Mboten napa-napa. Sedaya murid nggih sami.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "875aca50f110e5106eeecb32811d8ca815e3c68b0a50d0191a8b7e9fc6e7eb2d",
      "text": "Inggih, Pak. Kula getun, wingi kula dolan kemawon.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "886d2e036b7b4d8141af2e5d8e21326842dd7cff9feb3d213217199e45e8ec23",
      "text": "Kula nengga ten peken, jam pitu enjing.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "89558b16c6e34b53a1f5628efd1d59063a745c119e8d4f3f24518089f78012e6",
      "text": "Inggih, Pak. Nanging kula dereng sumerep griyanipun.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b2601a63edc9383a5d2baad185b7de3c77dfab2b5dd05ee9787a5e6ad604d71",
      "text": "Kula sanes tiyang Jawi, kula saking Mesir.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d1915d43e3f01bdbe806e11f2df268a9e0b111abd9babf82b690f53ba06a6d0",
      "text": "Saestu, Bu. Kula saking Mesir, ananging kula sinau saben dinten.",
      "voice": "jv_dimas",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e30dc59a22523868ed8635d76c6ed3cf74443c5df8e5263d97f98f0958c1ea4",
      "text": "Inggih, Pak. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f2bdc36e926e0b6a11c540d35818c5194876a6bf23395127b5a195126150f96",
      "text": "Mas Mohamed, sampun nedha?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9215a255a01b7c79c294aba5cc78043748746361084e80bd3fb5d8bc8d51a540",
      "text": "Mohamed, benjing enjing mampir griya kula, nggih?",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "922f9920040b03b4207f957e3590c28b5eb0c66a29767f5ba688ec251f246597",
      "text": "Nggih, Mas. Badhe teng Pasar Kranggan.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "973d231be4b6b4ed1d89da0ae38db15527218a99d62cb6ca491135a0bee94b73",
      "text": "Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "978c7db4e5756ab272448d58653bd681df62d1f6a1d27ca4cc92a1cea51a21da",
      "text": "nyuwun sewu",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "985df008093b81d8b6cb9fc4cd391a25ad9bec19d5d2bf65393233bb14e746d9",
      "text": "malih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a4a182bb1e8f516869dbab51fb8e819803183a7b109028f046c3e7bbc974f9e",
      "text": "weruh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7083b8d31b29a1cdecb33de887e93fe4e3961f6e27ed743cd622e3a3996b69",
      "text": "Saestu, Bu? Kula mboten pitados!",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e6974a47894c5bc02555512bb3135f41e938b865c8d04b042e05f37a4d352d9",
      "text": "Dereng, Pak. Mas Dimas ugi dereng.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e85f599583e56993a457f22c89082774f73fab1446aea4eaadba647a65f3801",
      "text": "Bu Harjo wonten ing griya.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f730b942940a287bd746bbe43a2dbc2dec37e715cab8db31e06c976c5c45b7e",
      "text": "Durung, Mas. Ayo mangan!",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a306d08e243061b642de4380f3947cebc5ebf0e0853ae4972a18ded11998ca7a",
      "text": "awrat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a35d4933611e02613ab98c9d4941e1425fd274214b44f6e8ce9e677f77560c79",
      "text": "kira (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a634b8cbc4988a5bd16457f0f03abca85c7b408f6d7052a50c2ceb49bbc8526d",
      "text": "Dereng, Bu. Kula taksih sinau krama.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a723dff72c8d58159ca7b1e57500a5a60e15776d26c2bde18428acb595a28ef5",
      "text": "sumerep",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7b4a7115407767693a31cb35a878394b03e2d298ee71fa517a1b530007a3ba4",
      "text": "Dimas (ngoko): Aku durung mangan. Aku arep neng pasar karo Mohamed.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85d5c00dc92de6ec3d62061a5826f99c5caea4e465b2f876a90832826d367bb",
      "text": "Mboten, Pak. Kula saking Mesir.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9409a7004498c4c046fac769189ac0564e1c4cd6f1957a4fe08f0680da9c7ae",
      "text": "nate",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa520d12778dd933d3c63206b6e86315d2d3a01601f0c60b1ad1e3535cbcac4d",
      "text": "Inggih. Dinten menika kula sinau ing griya.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa7087edc0fb6ced4364216d9887489c47577b4d3cfc428bb3884219df91ad31",
      "text": "Wah, saking Mesir! Sugeng rawuh ing Kauman, Mas.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "abf64fd45c026c749cab5d58d50e5ae138284ae67339acf123e8be69c392f792",
      "text": "saestu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac2da75e40aeba193b153a94f8fbb3f37c7367ec6ffa196c88953ecb36eb81f0",
      "text": "Kula ugi dereng nedha, Pak.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae20cc000ca0db8531cb1fc26d97880031226d7ce0fe25d0961bbe4b89ea6c2d",
      "text": "Kula sanes tiyang Jawi, ananging kula remen basa Jawi.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1be2c3321406a1cc78e4685bfbb2785a409cbc060a5dac2c45ee7ebb2b3c8ad",
      "text": "Nggih, mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2178bcdf7c0ebd60718571dac432ca75cb18261444534fa913c3ba8e00dfba3",
      "text": "Mohamed, wis mangan durung?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b31b48ee2be4fae175cb46375645730f00a677b719fd06528163dc6045e050bb",
      "text": "Nyuwun sewu, Mas, batik taksih wonten, nanging teh mboten wonten.",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5739ab572f3f1b3c11c04ccd42594b7a70ba2a6259b3bcec42739c5db4515cf",
      "text": "Kula ___ Pak Harjo taksih wonten peken.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5dfd523eb42dd4261fb7bd290f98cfe3345aea172b6f6ad3c984cd9dffe4bfe",
      "text": "sami",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b81beffaf59fe49a4a77b84dd7ac15862934c53521de90873efdce769b87e0a8",
      "text": "kepungkur",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b858422fd52ccd3f0acdafaf42816a6ee52c1471eb190531c5079bfbe72c360a",
      "text": "Kula dereng nedha.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1357d988fedef40ea8b55e2da6c160ff96d2f278898d26fa8c4ba2350aa229",
      "text": "Inggih, Pak, kaliyan Mas Dimas.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb20cf9bd10519cdd89f07375bb9361a29be1539a8f64f561a1bf5f7d01725ce",
      "text": "namung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb6b23d29b8981a7b35717dbcef49b4c7a0c64f4898e824da43d3c4017d8cb56",
      "text": "Inggih, Pak. Kula badhe nedha kaliyan Mas Dimas.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bba9b1e31ab0f2313507fa36bfd5b1cd05b31b6d303bc66b2eb5ac2e712cc7ee",
      "text": "Batik alit, Bu.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd212f02e43ec32baeb2142899be8065699b7dbf2a36eaedee5b67bbc5c98bd7",
      "text": "Sugeng sonten, Pak Harjo. Kula Mohamed.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c09791125f80ada82b8c4450f7224500571c8c29b7240752f6d45790416afbfb",
      "text": "Kula mboten sumerep griyanipun Pak Harjo.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c17953bed8210d4745fb6ea049fabd296fd5d1cfb48b50fdd0e39b34cb9e204d",
      "text": "Tiyangipun kathah sanget.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2297dbf6f7f1abdfe856fe14d93d5cdf2a2fd1f6566f2165803a74088cf8ff0",
      "text": "Sore (ngoko) → ___ (krama)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c245856ae489a07bfaa9c448a15371f59268f262a1a5c2ce7fd835f0008c3d8d",
      "text": "Ngaten, Mas: sinau sekedhik, ananging saben dinten.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "c408862f7cf2da1ccf4611c4e818281bce344efbc0132727080075a5176a6714",
      "text": "kaliyan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40c76bb521a906f8db347423c5bad149f2a25cd0742d8ae1e089eb19eb425ea",
      "text": "Nyuwun sewu, kula mboten ngertos.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c58f4838de82c6c9f8c7713a20ecb639d04be3b4505dead3e417eecb0871626f",
      "text": "gampil",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a77ad847ca2afbd1cb8bd3ddb8d28138eab3850528d632fe6298e5498c01e6",
      "text": "Piyambakipun badhe dhateng peken kaliyan kula.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6a0b51e56585335250b5446c689cddf0f0337f5d88600beffa6b72c0eed2e88",
      "text": "Inggih, menika batik Kauman.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9414b1ee7e6fd919c238a013935c0e5cbf477b0c9ed1f8d0a62537ad64b6d8f",
      "text": "Kula dhateng Kauman kaliyan Mas Dimas.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc7a995744c8b4894861a322e33733e25505b9804cb0b822c9898fdb6fbbdc0c",
      "text": "ngertos",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd1b11f5fd5e1f4ba38279945546e818b9841b580948ac6054dbffd023774424",
      "text": "Kula kedah sinau malih.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce0a49e956262692b5f8fea2b8d0b699408956a1a6e98f56e806e0bae5459d8f",
      "text": "Benjing enjing kula nengga panjenengan wonten stasiun.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d010bac8946b01d0c1c1c32a045c49c5dfa152f55ef02bdf1985b9df14d11017",
      "text": "Mas Mohamed, badhe nedha?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2333a1aef86ddeac70e8d67d6e20339f1c788719e6206ff91791b3541252d9b",
      "text": "Oh, nggih. Mangga, Mas.",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2e26ba821f679b56eb2bf6b9afc653f37396881a0ebb2a375bb7f0e7959d7c1",
      "text": "Saestu, Pak? Kula pitados.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d613b6cef8054ece551ccfe7dd93b90c1cc22786230f8dc9fd05e7a1fdac79f5",
      "text": "Sedaya tiyang sami bungah.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d89b66bf592ca0cf2ec4d8efe23af59105eb158041c4aec043ba92e9edeed2fd",
      "text": "Sae. Kula taksih ten peken, Mas.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "daf830e957706d1d88e2e4759be6162b58e4515ed9fb23955cb4417d22a72b64",
      "text": "Kula kinten Pak Harjo taksih wonten peken.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "db16494ed44aaf1362c81d3a0dbaf5e695bf12c16906338c7b817b6f247ef00f",
      "text": "Kula namung saged ngoko.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbf116ceeb9f714b2bc266d2a30314e7c57b5eb902e0c5f1a0ef8e88290a6d28",
