    }
  ],
  "audio": [
    {
      "key": "00a56a3383e75db6b91b01f6843a722763c67ab599251e92178d9d2f1fa3b456",
      "text": "seminggu",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0270b71417978dbec3e06b1c9b01b9f3744f52c1c04f8f3a38fdcdc9e755fe87",
      "text": "8:45 = ?",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "027600c46459f4a14fb6414e29d6279fd5c1c6b5a7a45244ac3bb4139d97b32d",
      "text": "Selasa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "03dc176c10f1eb13b05b63e7c1018560fcbe1d8f17217fd990be05866832225f",
      "text": "Sip! Mengko bengi cepet turu, ya!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "054da6925656c5c9ef132eeb09020e1b329da1e15aa733990ffe8f484ba3750e",
      "text": "ping",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "055b3e92575f49ef3e6e7ffd2537e4b2900a47ef817f4c28a8d5447b0a653f26",
      "text": "Cepet, Mas! Pasaran dina iki Legi.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "07fbb506891fbeb76e9cc64f4cb714486095218386ae44f4321d5b81008657e2",
      "text": "Sepur menyang Suroboyo jam papat luwih seprapat sore.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "09deb7cfe1e8d15d7ba988fce6944a099f722b1216300cca3330669c58888f10",
      "text": "Gunung Lawu cedhak Madiun.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b4d939ec14d5a2487ccd6bc8a60d0ee8363bdf7818f6c35b7c7d594ead2c740",
      "text": "weton",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ce7220f9be8eba28112b4fdd54b90e280d0ca08cfd0f4c98656a80a7ccad777",
      "text": "Minggu aku neng omah, Senen aku sinau.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d50cf081bec404d1628cb11e927f18d7579fdc14e008b8f1183f7168ce0396d",
      "text": "isa / iso",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e2e2bf481e2d35f15c5c22e28d909b66bb38c56ccea7fde7b2db3f967ff570d",
      "text": "Pasare buka seminggu ping telu.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e8a531aba95c25c5bbf690baad298e16cc10e0db1f45a6da25037585072269b",
      "text": "biasane",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "10b0221f868efecafac71420766d8196ee6748ffec91374fb49446465a3384c3",
      "text": "Senen Legi, Selasa Pahing",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "10e762f6a8b06b2376c660f5ca0c50ffa4091030681ce89cd3279a5f88c2a33a",
      "text": "Minggu / Ahad",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "114d553d33701fc10414f11ee88315bb0bdfd4870d62bcbed4432898aa364114",
      "text": "mendhung",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "11f3fe63453dff2d34409253d6cc780cef3ab1a8f6b966653e3c140e88fb1c6f",
      "text": "Jam setengah wolu, neng ngarep alun-alun.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c7b3b4bc152308f389d6352d3451cce11498ecaf3dcd863c7edb46a89309b5e",
      "text": "banjir",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dfcfdbde78e882cbfdc4b4585213d2d3ec7f069a570d1eeb7935776c754eed8",
      "text": "Mengko sore jam papat luwih seprapat.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e73522b558ee1f711f3124506403dd768bec3f32e0c8ffaea0faa6732a530e6",
      "text": "Ayo! Kapan?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eb9e496cde82f4033c91cae21ac01c1325cd8da855cd2204b61d19cdaf0ca0f",
      "text": "buka",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f504204e1d9305c1016c5941d6ea24035314e291aa9584fc45257b8ccf9cf6e",
      "text": "Ana jam setengah wolu esuk lan jam siji awan.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d4c6b26ac54fcf68402bea0c1485a2deeb7902a95bd0a307e4c2fd22d93e1b",
      "text": "Bener! Kowe cepet sinau lho.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "24833a8778134d74305b045a9ef30433d767f336bb5e3f39856437d48d19f4e0",
      "text": "Lho, sesuk Minggu. Dina Minggu ra ana sepur jam siji.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b3d6c363956db67295af36175ede03e5b30ef7ec6e2cc6d5243e71fb3463147",
      "text": "Reoge jam pira?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b5211d016279b363f2c84db7fb95191d8d7de47c476f2eb93643ebdf803cc45",
      "text": "Dina iki Jemuwah Kliwon.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d62873501ca436cc8ff3799dfe34cb24d2d258635bd8909e672863413d35d0b",
      "text": "Senen, Selasa, Rebo, Kemis.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "316b9ca89472c172e4e0b646efbb5cb5ece036c75939a75c9987f3abf074c59c",
      "text": "Seminggu ping telu aku sinau basa Jawa.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "325f41572e5ea575de1460e2249a82638ba0775c8e95c4589b2e9038b5532feb",
      "text": "alun-alun",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "33770d19a3d8953fa2fd1f7ef38661aae4eac849519a7168197e46e87be1993c",
      "text": "Sari, saiki jam pira?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "36d9dcf7144350d51b5c4471ea2f8c61469286877bae96cdeccdae0f55430c75",
      "text": "Dina iki Rebo.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "385b831284ea4725c0dbf2755a62fafcb76d97dc67c8990692a2ab3e6be3256c",
      "text": "Sari, Setu ana Reog?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "38644b3da362dc43689589500b3f310849912a739217c0ebd82048f6b7ba77a5",
      "text": "janjian",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "39f1ff198c3df2655416f1f2becb6ebc3d6fbc0e4fdba144fcd7c22a4de95d38",
      "text": "Mohamed, ayo nonton Reog!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b0d74e517c2735d1fc9835717a643b88d7d4575c7df4b07fafcb8fee401e289",
      "text": "Klambiku teles kabeh.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d4c9304d969c271cb7eafa23f21a0c5443b6f81aa9dd069f8d3d90b7273c231",
      "text": "Kemis",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f2ad4779551e9fdbcf65506a72ae8d9756c8732b42ccd4ab4739dc67d6f78ec",
      "text": "jadwal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ff165d691b2ede4dce4819606904c74ff7aa7a25a8a727c13ef75f748a228bb",
      "text": "Ojo mulih peteng, ya. Dalane kadang banjir.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "42300d3fc2912c5a81b55d76524e9fb6a7280863a79ff7244c85e70272d17279",
      "text": "luwih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d75eb4e419a1856ab85aa1986bb2577f7f3c0069b7ea1a5ed7e391f6d0519c",
      "text": "Biasane ping telu, Mas. Kadang saben dina.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "497361ef1f21a46344698004a2a2cdcdee6721f5473e6f7f98b6c03108829217",
      "text": "sore",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bf7c6a98044cc900cebe8e6f3bbcc81da782433f052b4192c7b6e8d84ecf495",
      "text": "Ketemu neng ngarep alun-alun, ya.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eff46807b43a1d9bae1324747cc374f1e03dee11f1be6dd102acdbbb1f74524",
      "text": "sesuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "512fdf0b1252fc1301e1002e4b0780d95e0f60a7c8dd9056a99c15d71bd5d96a",
      "text": "Aku neng pasar seminggu ping telu.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5306f5c6e3b47fab7420eb1436865462c1ef94ce742a3ecc394c3e4fad46582a",
      "text": "Saiki jam setengah wolu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "53c451476d501be98f35d99ac9ae23b467e683ee5374730eaad9f06ebcd8027d",
      "text": "payung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "54e7e43c8a769360c38f92ef134c7edc3e518a66df3ef3451b90b4776ab1dfc5",
      "text": "Sesuk Kemis.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "569fa91057d6d8ca95845be9ada4243673d7b6d9f5e74dfd13b4f984565a4f13",
      "text": "Sesuk Jemuwah ayo ngopi. Warunge buka jam pira?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "589877e27f0d66b126ff2e3d23a19ab50bb1d47f0ff4615e0b38339069e307e1",
      "text": "cepet",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a235fa0931d614ff90a71533e9cf23a12a61ca30ab50d3284b8d11c5750d8dd",
      "text": "Wah! Ya wis, jam setengah wolu esuk.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a61383c0ca237fe642724bde129372a5ee7b001a2579fbba44ea90813c18765",
      "text": "Reoge jam wolu bengi.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bb135cbc1b4e55440e8893d605a14122fe5d76061352a3ef25f6cfa6de894ef",
      "text": "srengenge",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fb38899a0a1e832700d3b73d765c39c91091e2ac9d26b51c2f90bb431268e88",
      "text": "sip",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "67e3146f70357a900dc559a0505fac423aeb2b51830c7ceaed54908a8b0e213a",
      "text": "Kuthane banjir.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "698ba71e7d56395958799b43c0337fe2d683ae5a5d8d227b0d237edd61e2ed12",
      "text": "Saiki jam pira? — Jam telu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c1f1114a49e36abdbaea708e2e7a25f98f3cd4baec992b0d10e068d4e45d4d6",
      "text": "Mohamed, kowe sinau basa Jawa seminggu ping pira?",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "700c38427bf509cd3da23a573dfd72fb35de547e8e60ccea3136ad4ac2f7f920",
      "text": "Mendhung. Payungmu ngendi?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7051fa4c41a207b8880222cb0b4d11efe320cf3b254ccf547902d73179d25610",
      "text": "Jam setengah siji aku Jumatan. Jam papat sore piye?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "715ebb54d2611eb9b16e337d85df2f7000deae131469e22b0de8ecf234ef97d1",
      "text": "Jam siji wae. Esuk aku isih turu!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "735ace4871fc1181a71ef0bf0d04864d9ceb069f003c04032b08499c9df47963",
      "text": "sesuk jemuwah jam 4 sore iso?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "736d694c33aae694954b61ccd55d80ede1b541b1dff16ca8236e6daa5141cd10",
      "text": "Setu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "757027bb56bf99cad54202c56c6fd45efcd5dc237111ccf3eedd7b38e2956e23",
      "text": "Cepet! Pasaran dina iki apa?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "772a02c42837fdf882cb0ad943e243019c2fcec124b4af657709bdc9c7425ab1",
      "text": "Sesuk Jemuwah, jam setengah siji awan. Isa ra?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f0f693287d14e6863a22522c52c28c887efacce7a875031dd9101588812dd",
      "text": "Sari, dina iki dina apa?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b3c1e735fbd8972e5efb8a51e8837188b55339d2892ae68d0be6edb9e035821",
      "text": "jarang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bf9f4f1af2b9fd5dfbb520b06d0ad73ed1cc88a39fe7f4e84c150ade9bd8736",
      "text": "Pon → ?",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fcc83ac928b218633c8c74664f8d7b60c8b4c706e09d9734cebda028c14aeef",
      "text": "Senen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "808fb2aea16a2df7c287c2412e14abdb47ff76716de447a02db99c303cf5d448",
      "text": "Bener, wetonku Senen Pahing.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "82b0da51f6c6b1d5a3706068248538d8e2c94f71f60d28f150f12b35525a140f",
      "text": "Sepur menyang Solo jam setengah wolu esuk lan jam siji awan.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "8717006c1df2cd4b6f1d2c30b9f20770b3f7c75d49046a5660cfbc47a339a4e8",
      "text": "Senen, Selasa, Rebo, Kemis",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a77199c5b9c6f62420b44fb955b42cf24d09ef9761532ca1cbdea652ed85a41",
      "text": "Aku teles, payungku neng omah.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bac610a4ee8747439d3305595c693126a848bf55587bf2e4a9974ac718246be",
      "text": "Jemuwah aku ra isa, Setu isa. Ketemu jam pira?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d2fec599ebdc3026fb385bb17955fc04b291fd0b63503f4972782820e213197",
      "text": "angin",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8df230c1094dff3101e0ac5550412df28a9806e2ac5ecd1e90bfac8ea8255a80",
      "text": "Mas, arep neng ngendi? Mendhung lho.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f73ca320fa8a0529ed4e7230c09cda237b39073d6432da8f1255c4a557fdf1c",
      "text": "Sesuk aku arep neng Ponorogo.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f80babb325c7eb68e9863bdc693ebe261ee599467c2aa045ba079b7a1afa059",
      "text": "Kliwon? Apa kuwi?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8c63363b9b98d80f3dc703f24ef4053d685a20acfc6ba2fc2fe3e09d23945f",
      "text": "jam",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fea0a5554a13c768b3514b564d92ccb1abaaccbe81b4aecd9ec60ecf3bfaa14",
      "text": "Sip! Janjian neng alun-alun, ya.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "907a86a264d1f239f07885f80b6d680ec5896e62976ea21b705a8acff9e04eab",
      "text": "Dadi sesuk Setu Legi?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9148a69eab910aa25c31d8e41bef190f39d69766afdbcc86bb57f8cd6d7e0633",
      "text": "wingi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "929ba60606475e10e20242e0cefbd578e9a5783257e154e8d1b36acd27128187",
      "text": "Kliwon → ?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "93d94a1cb6d7f4bed22f41a6028d94b27e6b61e00a3003f2939b4a0968221391",
      "text": "Selasa Pahing → ?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "95b5ab17a16d3b2e10ba7a90877a343c7f5d08e41bc66247a83f0351a8af74f8",
      "text": "Mendhung lan angin, aku nggawa payung.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "96aabfec9920cf87f083af73668a358e96f11f68e8f7b7fd048030ba1e6dcf49",
      "text": "Isa! Ketemu neng ngendi?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "96b3ab2426305eb3c2f438e1e5b0a019390a22df257c9b3ff0da9ac3f03cbf89",
      "text": "Matur nuwun, Bu. Wingi aku teles kabeh!",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a1362800d692f64f3daba17ebc8f2bb69b7130dd8c7c40469c7cb86341d893f",
      "text": "Jemuwah. Jemuwah Kliwon!",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ab07b02e44741fcee67fa08fe9c5edb962c0f5264e3e41af438840c1eca70cb",
      "text": "wulan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b76e01b752b65d7d8e823e1b6d97f1963e1865c2b1b667e1824dc62a12b16ad",
      "text": "Jam wolu bengi. Mau awan kowe durung mangan, to?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b93a0418ed635e35541dafbe73f1bc4cb18f04a0448fe3088c3e3e70bc8dfcb",
      "text": "Sari, sesuk aku arep menyang Solo. Sepure jam pira?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f5581ee99659861768953a6a6e289ec2f67bd761cffbfd9d5230d80773a8dc5",
      "text": "teles",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a284f39cb250c7ce84820ab0073136a37c189fb8b7695ddc0b630132924d873d",
      "text": "Wis peteng, ayo mulih.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a573cc553f5040f5228798a1ead06b1036f55c4fed58747d3ce5abb4373e9f69",
      "text": "peteng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6b672d65531597ab621fae7e7fc6f721bed134b4ce5e504778d996a2ae2f277",
      "text": "pasaran",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa2f8d4f23dfcf1244e30b3928b326c4b950981b0ea44b60049d5963f799b517",
      "text": "Warunge buka jam pitu esuk.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac624bfb91ecdfd92ed89d12dbe684a6e54349608a433821deb300111d34b1ce",
      "text": "Janjian neng ngarep alun-alun.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae29d1507d19a6274481836e5a32da10f3dd755f11143dd8d974c58f0353fbc1",
      "text": "Sip! Setu ya.",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aec0ea7e1ef13bd6957183e160d20ebef6df64a77cedb4805231405647c6ba8c",
      "text": "Iya. Jemuwah aku neng pasar.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "aeefaf9bfe9f464c8b7386894da1f029d7e20867b99ef7a13ad7bcecb0e50459",
      "text": "kadang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b35338db6e7a02eec0f27c074e9a77820348db299bc4e7a620c9807f445443bf",
      "text": "Mau esuk aku wis mangan.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b465afbccc7ee396a1cf9e829996095b85933c86de8767c67a48ae32430cc121",
      "text": "Ketemu jam papat luwih seprapat, ya.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6a36fa8c0afb910d9e6075cf12d81599b1b3d62a8584e675fd6a4558256632c",
      "text": "Neng alun-alun, Bu. Srengengene isih ana kok.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6d2a180584185c5ce598183ba0c608b1116f25af9d4ff1b247064c807558d3e",
      "text": "Biasane aku ngopi esuk.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c9111b7af01a5cb701ac92c67d367e0ac85b531f4f73549ef5bc5cb39609bd",
      "text": "Durung. Ayo mangan sik!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b86f12f73a4898e280b736bc3a1a9cec46977846e1dfb0e2708047fb25ee231e",
      "text": "Jemuwah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcfe192283400d7abc5a24a6f6abaa5c31b2b1ce621389d2ad943b3882ab55f0",
      "text": "Sesuk jam papat sore, isa?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "be4408c15034e96a15a8fef1691d133f6676dd2719472a64564a7f3c6ee6556a",
      "text": "Aku jarang mulih neng Kairo.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "be8bdfa8712a2b088dd41897036cd097f29ed4d7df7ca9cf61abc61071afa7c7",
      "text": "Dadi sesuk Kemis, to?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf581b3eb134b271384d16e462fa425dda5c4a0b0af76042423f6131aa1ffd28",
      "text": "Jam setengah wolu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2e026f8c03ca833d8d47b160559d8a3445c7d0e1b86c25333710e18c1bd9dcf",
      "text": "Sip! Sesuk nonton reog, janjian jam papat sore.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd3d5697b54652e310752c866fd922b24b139910e4f46bfc84efa5430f23f94f",
      "text": "nonton",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf205586a455588286e7962ca67fdedf87a1dc6ff32d44a3d50d654d1ac4a667",
      "text": "Apik! Aku jarang sinau, hehe. Jadwal kuliahku kebak.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf494436bf51efbcef7e9e07ca960136c525ad60e8c2749614a0e078e3c61505",
      "text": "Dina pasaran. Legi, Pahing, Pon, Wage, Kliwon.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d130374e1aea34b21f54dcf9570d86024c0fc69a3c6bcb1836869cb694cd19c6",
      "text": "Angine banter. Sore iki mesthi udan. Iki payunge.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2dea9c95d353eeb99440d8a5292897cab224d22f93d95b7e33297ea0cc9787b",
      "text": "Dina Minggu ora ana sepur jam siji awan.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9ddcad3c9c6dba3ee6c8b11fc3722595512b3d7c1bb291915a73f8385c2747b",
      "text": "Sari mulih saka Kairo wulan ngarep.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "daab0383e2f24ae93766f9f13423cbaa1055bea2feaeeb07ff6257bac0d525fa",
      "text": "Ana! Setu Pon, jam wolu bengi, neng alun-alun.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "df16d26eee15bb6e5a65f028b329c483753eebbaa99734de04c8a3a7d29a9b7f",
      "text": "Sepur menyang Solo jam setengah wolu esuk.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfaefc2b67ef38694a293b1ac7b7a1dd3f406ed3bf7d4ec67057b425a2e09151",
      "text": "Wetonmu apa? — Wetonku Senen Pahing.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfdb9ad9d23a3b91c987885e442a4858c5a68f22d230f05969abab6b5fe3dd2a",
      "text": "bener",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e42a97b82f36130e4d7ddcb29458d2a93fabe135a13b38d25c803ee477c0e888",
      "text": "Aku ora isa, aku Jumatan.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6007b59e11e8c597a3eee5e4ac3512743220f28b119759986385dd5fce61f82",
      "text": "Jam pitu. Sari uga mulih wulan ngarep, lho!",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e88eb053a29406e49b1d177899e80a684cb96e8bcc3bad50e199f6b0778f352b",
      "text": "Jam papat sore piye?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8c3e70074aea76f06bbde1535b38d62cd0ec4a8dec4cba1e375bab06528b81e",
      "text": "Dina iki mendhung lan ana angin.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8d3eae66e83171ba76a029947550bb06b0ae6b850580dd220a0597e6139c7d5",
      "text": "seprapat",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "edde2e29acae71c40a914c4b96dfe8cb0e825b4e0f6ff19d8b416d117ed52afe",
      "text": "Dina iki dina apa? — Rebo.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f15f18408cb6b5c82c565985031ceb7e57a7c31eb5961f89806f1c49292eca41",
      "text": "Jumatan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5d82a724b82d1d3fdb2d52f15f3f44840a3e73adb8a1e6531eda2ac1befb38f",
      "text": "gunung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f796a4cc901b6bd733dba7b8d1f463af7c926becb9fe9eed4ac69c8e569cefb1",
      "text": "dina / dino",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f79b70359a0641087e70359be352ba89251a4343d9fb62db2315ae917f21c9f2",
      "text": "Legi, Pahing, Pon, Wage, Kliwon",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f94820146ffb917588b87a16858279cfeebbe904690a4f4a80ae60508c8c203a",
      "text": "Neng ngarep alun-alun, ya.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe2c30988a15fad83a60b5c31aaef6e323eeafd9cce20d6d302f6ea3e60a1ef3",
      "text": "Rebo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    }
  ],
