    },
    {
      "key": "10b0221f868efecafac71420766d8196ee6748ffec91374fb49446465a3384c3",
      "text": "Senen Legi, Selasa Pahing",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "10e762f6a8b06b2376c660f5ca0c50ffa4091030681ce89cd3279a5f88c2a33a",
      "text": "Minggu / Ahad",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "11f3fe63453dff2d34409253d6cc780cef3ab1a8f6b966653e3c140e88fb1c6f",
      "text": "Jam setengah wolu, neng ngarep alun-alun.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1564a2ba96946d49588a74eaa87238234ee9401415cf536143fcc853383d6ba0",
      "text": "Ketemu neng ngarep alun-alun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e73522b558ee1f711f3124506403dd768bec3f32e0c8ffaea0faa6732a530e6",
      "text": "Ayo! Kapan?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b5211d016279b363f2c84db7fb95191d8d7de47c476f2eb93643ebdf803cc45",
      "text": "Dina iki Jemuwah Kliwon.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cdae5212d125a18ded4ae6166907c2308b2557fd0d476b2737b5e472572cf15",
      "text": "Jam pira? — Jam setengah wolu.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "325f41572e5ea575de1460e2249a82638ba0775c8e95c4589b2e9038b5532feb",
      "text": "alun-alun",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "33770d19a3d8953fa2fd1f7ef38661aae4eac849519a7168197e46e87be1993c",
      "text": "Sari, saiki jam pira?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "34ac4028f65b65405f3e5fc351e71cec63e296d759a6a3272e47ea35f716bc2b",
      "text": "Sésuk jam papat soré, isa?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "385b831284ea4725c0dbf2755a62fafcb76d97dc67c8990692a2ab3e6be3256c",
      "text": "Sari, Setu ana Reog?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "38644b3da362dc43689589500b3f310849912a739217c0ebd82048f6b7ba77a5",
      "text": "janjian",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "39f1ff198c3df2655416f1f2becb6ebc3d6fbc0e4fdba144fcd7c22a4de95d38",
      "text": "Mohamed, ayo nonton Reog!",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d4c9304d969c271cb7eafa23f21a0c5443b6f81aa9dd069f8d3d90b7273c231",
      "text": "Kemis",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "42300d3fc2912c5a81b55d76524e9fb6a7280863a79ff7244c85e70272d17279",
      "text": "luwih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "482b6d2710ebc14002ad74b9731fd8636394ddc0067d4af688f0567047ed8311",
      "text": "Bener! Kowé cepet sinau.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4952f2eadfd0db4874f344eea8a8f063f735a866a6a318630142a174fd74caab",
      "text": "Sésuk Jemuwah, jam setengah siji awan. Isa?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bf7c6a98044cc900cebe8e6f3bbcc81da782433f052b4192c7b6e8d84ecf495",
      "text": "Ketemu neng ngarep alun-alun, ya.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fb1e84d3b773f50d4331793809261de005983f91f814c1c55e1ec7971146437",
      "text": "Reogé jam wolu bengi.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5306f5c6e3b47fab7420eb1436865462c1ef94ce742a3ecc394c3e4fad46582a",
      "text": "Saiki jam setengah wolu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "54b04bd8a999edc203ec6ae0890011d65e2f6921b72fed893710bfaccafac169",
      "text": "Jemuwah aku ora isa, Setu isa. Ketemu jam pira?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "589877e27f0d66b126ff2e3d23a19ab50bb1d47f0ff4615e0b38339069e307e1",
      "text": "cepet",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ee31e82f2c6cc0744e9f2863e914b2449a153ac1d2a5e8851efd5219798c738",
      "text": "mau",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fb38899a0a1e832700d3b73d765c39c91091e2ac9d26b51c2f90bb431268e88",
      "text": "sip",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ffbf20045c9d90106f48956df28e48c1e794e0564f5a5d5d813f01d83b2a125",
      "text": "Sésuk Kemis.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "621221ef4278236c580ebcc45555c7569dd19ad704e0d313b8b12f176dd62cde",
      "text": "Jam papat luwih seprapat.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "63c63cddb0f87618ecc34a4838e1b4a81ef8020fb68f2771f8605dd93edaa9cd",
      "text": "sésuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "698ba71e7d56395958799b43c0337fe2d683ae5a5d8d227b0d237edd61e2ed12",
      "text": "Saiki jam pira? — Jam telu.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "735ace4871fc1181a71ef0bf0d04864d9ceb069f003c04032b08499c9df47963",
      "text": "sesuk jemuwah jam 4 sore iso?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "736d694c33aae694954b61ccd55d80ede1b541b1dff16ca8236e6daa5141cd10",
      "text": "Setu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f0f693287d14e6863a22522c52c28c887efacce7a875031dd9101588812dd",
      "text": "Sari, dina iki dina apa?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b65cee69f603af7eb84f0d451a13a583dc9c2923ee1d5b805c2d4d4034b9128",
      "text": "dina",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bf9f4f1af2b9fd5dfbb520b06d0ad73ed1cc88a39fe7f4e84c150ade9bd8736",
      "text": "Pon → ?",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fcc83ac928b218633c8c74664f8d7b60c8b4c706e09d9734cebda028c14aeef",
      "text": "Senen",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "85829e01ff3023e4e5147925d7dc9fb19c34eda42f61f9c089383ef6e50a4217",
      "text": "dina iki",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8717006c1df2cd4b6f1d2c30b9f20770b3f7c75d49046a5660cfbc47a339a4e8",
      "text": "Senen, Selasa, Rebo, Kemis",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f80babb325c7eb68e9863bdc693ebe261ee599467c2aa045ba079b7a1afa059",
      "text": "Kliwon? Apa kuwi?",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8c63363b9b98d80f3dc703f24ef4053d685a20acfc6ba2fc2fe3e09d23945f",
      "text": "jam",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "9060a632bbce34d043d9f9e8f13ea4232f48922815c5edff553d9ecaea4c3410",
      "text": "4:15 = ?",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9148a69eab910aa25c31d8e41bef190f39d69766afdbcc86bb57f8cd6d7e0633",
      "text": "wingi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "929ba60606475e10e20242e0cefbd578e9a5783257e154e8d1b36acd27128187",
      "text": "Kliwon → ?",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "93d94a1cb6d7f4bed22f41a6028d94b27e6b61e00a3003f2939b4a0968221391",
      "text": "Selasa Pahing → ?",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "96aabfec9920cf87f083af73668a358e96f11f68e8f7b7fd048030ba1e6dcf49",
      "text": "Isa! Ketemu neng ngendi?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9739e7e1584e8448d08dda1614345b1968dca0f0e9799864c4c7892b5aa657df",
      "text": "Jam setengah siji aku Jumatan. Jam papat soré piyé?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a1362800d692f64f3daba17ebc8f2bb69b7130dd8c7c40469c7cb86341d893f",
      "text": "Jemuwah. Jemuwah Kliwon!",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4cd0179a76bdcdf2083480204b94a3153997d29ee9954295a211cb8d3d8c278",
      "text": "Legi, Pahing, Pon, Wagé, Kliwon",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4fab0bca836934be72cbcf8c218bb3b130153967ae1ae2a2a53f87150dd19af",
      "text": "Jam papat soré piyé?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6b672d65531597ab621fae7e7fc6f721bed134b4ce5e504778d996a2ae2f277",
      "text": "pasaran",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad36eddfa793e3e99211c02d688f428ec0443a0405adde042b1f000f6d981803",
      "text": "Sip! Sésuk ya.",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae29d1507d19a6274481836e5a32da10f3dd755f11143dd8d974c58f0353fbc1",
      "text": "Sip! Setu ya.",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae3a5bc05e6ef4d2ef0b772e1428b2bb837624808d74eb9bf53e87469814af44",
      "text": "soré",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b35338db6e7a02eec0f27c074e9a77820348db299bc4e7a620c9807f445443bf",
      "text": "Mau esuk aku wis mangan.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b465afbccc7ee396a1cf9e829996095b85933c86de8767c67a48ae32430cc121",
      "text": "Ketemu jam papat luwih seprapat, ya.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7bee0f0c8806ee3e060c38f08bca74a2a4b8e020b1bf0760c2edf9ae7af34d7",
      "text": "7:30 = ?",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c9111b7af01a5cb701ac92c67d367e0ac85b531f4f73549ef5bc5cb39609bd",
      "text": "Durung. Ayo mangan sik!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b86f12f73a4898e280b736bc3a1a9cec46977846e1dfb0e2708047fb25ee231e",
      "text": "Jemuwah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf581b3eb134b271384d16e462fa425dda5c4a0b0af76042423f6131aa1ffd28",
      "text": "Jam setengah wolu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfc3b56c89d001bc55d9766155bd7d9869ae2ca350a98f42d0c7306616e8341f",
      "text": "Dadi sésuk Setu Legi?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9b7a1ef9b1e2cce01402d8e56abc2d34da9250cff04575f818409bf85ee710c",
      "text": "Sésuk Jemuwah jam papat soré, isa?",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb6b8692da45b601ca807a601ea115db50e77b82f67aba3fc93dc8668de08228",
      "text": "Sésuk Setu jam sanga esuk.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd3d5697b54652e310752c866fd922b24b139910e4f46bfc84efa5430f23f94f",
      "text": "nonton",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "da4efdf16aa35bab9fa551c7fa6f6399d5db9f18389679e64769b682bb92a408",
      "text": "Wetonku Senen Pahing.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "daab0383e2f24ae93766f9f13423cbaa1055bea2feaeeb07ff6257bac0d525fa",
      "text": "Ana! Setu Pon, jam wolu bengi, neng alun-alun.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbc7596cf9e23945cf609d6d1263415df74f78423a39926087abcd739ceefcc2",
      "text": "ketemu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dee514f231a1dff3b197433f010296b2f4321ab274a6637e96adc54ab09320e4",
      "text": "Oké. Jam papat soré neng ngarep alun-alun.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfaefc2b67ef38694a293b1ac7b7a1dd3f406ed3bf7d4ec67057b425a2e09151",
      "text": "Wetonmu apa? — Wetonku Senen Pahing.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfdb9ad9d23a3b91c987885e442a4858c5a68f22d230f05969abab6b5fe3dd2a",
      "text": "bener",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e105e17cce0474b3accc331a149b3c3f10695e911f9f3ac52d00fa8a1f6ce253",
      "text": "Jam wolu bengi. Mau awan kowé durung mangan, to?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e42a97b82f36130e4d7ddcb29458d2a93fabe135a13b38d25c803ee477c0e888",
      "text": "Aku ora isa, aku Jumatan.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e542ac766c7fe41d1d3cb4650c49b82cd038ead8e1199145fb0edba4d0e67437",
      "text": "isa",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8574b651c8213f3bf9b05429445c3c0dbd38d7d916a191cdc58aed00e2a0f01",
      "text": "Reogé jam pira?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
