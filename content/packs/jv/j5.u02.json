      "sha256": "0ef4e13c627328b39f92a8f3e08eed54ab7ee11b32476c1cfc888e450c3ba4cd"
    },
    {
      "id": "j5.u02.l03",
      "sha256": "744585ee98641c2560254f2240e1503710bddf2aa9c1837a8f38ddc5d5bc5c8f"
    },
    {
      "id": "j5.u02.l04",
      "sha256": "021b2f93017b33a196fbb7d52caf6531079cf1fb7c8596e8b842afed7baf9a3a"
    },
    {
      "id": "j5.u02.l05",
      "sha256": "f0235f8d3c5e767ebd72297e0595c0f81dfad93918c13e869590dc6900567b5e"
    }
  ],
  "audio": [
    {
      "key": "00349f45b977aa5df7b0e708da1e67dd7064db60d1e2c15df07baf2cf4cb7b08",
      "text": "redaksi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "08dc1931443032768fec29ffed62016c28195b56d68b5995649b59a12de55af7",
      "text": "lurah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0acf7c87e4f24bd11c3e39db8d9a0b96d1061d75dc4b7d3a26f1156918f3d5b3",
      "text": "Saka warga dhusun. Ditulis nganggo krama, kaya layang kanggo wong sepuh.",
      "voice": "jv_dimas",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eaac84b2a1599693bdd728d6d4f555034d4159efe687506f234448b106b78ea",
      "text": "enggal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f310c97df1c2fe77587ab85ebe38a51e67fee7fad945050aeaab761ee4a9181",
      "text": "kapilih",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1130ccb3ea0ec1814ae788c4115855d12f9366c322acfd1fb417720e3e0ccad2",
      "text": "Tinulis, t-in-ulis, dados ditulis! Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "1730865b35db9d564e4af302a169ae8e8857925e8a3ae7b5209156a42ef97333",
      "text": "diresiki",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c9c322213aa05d2d6e7f4b6655ea528ad69a0bea6c2f48fd8a507185f41bf2",
      "text": "Dalan ing Kutha Lama kebanjiran rob wingi sore.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba538e03b7f2b9e90d919b637c74b25126cc8ce1a71e8be6d2c3afcabf7ea21",
      "text": "Kutha kasebut ana ing pesisir lor.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c23ca7887f223ee886a7a09a1754788c13d8290c65ffb834870a692d520558f",
      "text": "dhusun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "215ab29b16f628cdc5a1c4b6038aa31b64bfd8b1b981af82a791d5fa284be03d",
      "text": "Banyu segara sing munggah menyang dalan. Ing Semarang kerep.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "24d812669b7bb87e13594c8bf4f475449ce95d3d0396c879774a974753cec864",
      "text": "Lawang Sewu dibangun dening perusahaan sepur Walanda.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "24fd244e1765686367dad4db9582b523176fff7dfabc0c498bdcce943abb8fcf",
      "text": "kinurmatan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "27331ccfa4d9a3d88af69fdfb078f93a56fc9915b80ee49816d53ca277f046a3",
      "text": "Ana warta apa, Mohamed?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c21b1148ab6ce0876aab05876236fd187d027c109c6bec7fd7d1515035bb62e",
      "text": "Mas, iki Panjebar Semangat, kalawarti basa Jawa saka Surabaya.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d5005684bee0b17d59b78d9a0fc6c08106d88bca4750352cea1b723beed8bc0",
      "text": "Kalawarti menika sampun lami, Pak?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "329c4e5d5e1e7f6f32fa5f51acddd6223601b8f269f968e135fe094ce3860389",
      "text": "Kutha iki sinebut Kutha Lumpia.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a1b8eac74fc241d22eb682059f7ac259c723f4b202d451371c2048205e203a8",
      "text": "Iya. Kapilih dening warga. Jenenge tinulis ing koran.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a5c4f0df787fb3feca443a0784b2be161423263ab4b88e482fc0c9f57262bd7",
      "text": "Dalan iku didandani dening warga.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ba2f3acb5fc22d921ddb587bfcf60522b761bf88d8c8843f24abbb059bc53e5",
      "text": "Matur nuwun, Pak. Kula remen maos warta.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c10ef917aabb0bdc7b28e098d54fc366492cfb590df5e34185ecb628aa073d6",
      "text": "Waduh! Saiki piye?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3b4a8dc2c949401a28eb97fcc3d5aef096d13cf9da892ed4ad24e3ca72ce25",
      "text": "rob",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dd4c3e762caa5b40d99c13150fbca9154f8b6892b5e7496d5d1e0e1b242c9de",
      "text": "Gedhong iki didandani dening perusahaan sepur.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "60770d7d27dc7da413fca45eac20f9b762b4b9043f1152ed5fea14efa54253a4",
      "text": "Pak Harjo kapilih dadi lurah.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "61a16332426d9905e133ae7e4a7167a82c4c17ad97e0ab26919d3aa21623221f",
      "text": "Redaksi ingkang kinurmatan,",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "681fc2ab6cdf491b960c758604ed138b09c3d85e7cd15287a20948bf3e21706f",
      "text": "Wingi dalan ing Kutha Lama kebanjiran rob, esuk iki diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9c6d72a1d89e282e77aa8fddaa67d84429c2c99b3b801eb2df001307a29016",
      "text": "Mas, wacanen. Pak Slamet kapilih dadi lurah.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ecf240de1eeea507836cca34663eb9ef2970adc24bfa7162ea10885aad545d9",
      "text": "Iya. Saiki wis didandani. Wacanen warta iki.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "73c0dbd6a6bef2121d6bb7e4dd7f24cc7a52047856c7082e11b70c4d2c785394",
      "text": "Esuk iki, dalan kasebut wis diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7485f3b1d2755442b4cee78ba2d7da4f82c9a2f747d86c39a80089cacbcb6980",
      "text": "Warta iki ditulis dening Pak Harjo.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "787f0fb0bf33e7358b0a199f4f7ab9cdfb8cca990a2388ba66381a811f3a875c",
      "text": "warga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d728fb4e518c6258abd3b8cf7a04e347220a23a2fbc4f445292cf75aaaff864",
      "text": "kebanjiran",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8033da15dd65f6feac70f825aa4588432af6c78ba1a552d1adca47983fe44721",
      "text": "Masjid enggal dipunbangun dening warga.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8063cf78579a393ba2edae81ac72edd60bc48169f50f9886745d98a4ef417eb4",
      "text": "Ing jaman Walanda, Pak?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ea42e711395eb032c882eda2faa39ecc420508a4529737e2dd829e2bb178f5",
      "text": "Masjid enggal ing dhusun kula dipunbangun dening warga.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e1f3ea9d3393f41621f9fb6d460757fb2b65bea63287e3adae2963f7fd1ba3b",
      "text": "warta",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eaf5e74b431c222df3317e4796f5dfc3fbce5eac1754dd44e07dcdf961d4449",
      "text": "Lurah enggal kapilih dening warga, jenenge tinulis ing koran.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9632d1c9f0eec255e242c5e577536cae6cf28d006904ba326eafe4be73752567",
      "text": "Wis diresiki dening warga. Aman, Mbak.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fb5108ca0395549dfe0cc2eba64688265e169d54580634a1ad35f5ad9c31046",
      "text": "Redaksi ingkang kinurmatan, kula nyuwun warta menika dipunmuat.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "a210a75fd8c2c5095a0b77dc42e08bfb9387c4825b95d8b7ab18f29faf34e29d",
      "text": "Mas, gedhong iki dibangun dening perusahaan sepur Walanda.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa23d134a7ac6c9374daadc2a84aeab30143402f4ee81d43d60424821ab72ba7",
      "text": "Rob kerep teka ing pesisir lor.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0bdd5a8f775a752465e3c613afbee57219ccd2933ccd02fc9387e9744054534",
      "text": "Wis lawas banget, wiwit jaman Walanda.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce8e1a7e60fe845ba5d82fca4303cfa79f5fcb1f9f74eeced1b5587f4dd28be",
      "text": "Wingi dalan ing Kutha Lama kebanjiran rob.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3758425980cc242c29349dc5947a1c89ba8e0fb205821b6eebcce045d300a7d",
      "text": "Kapilih menika sami kaliyan dipilih, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3fec9760e93fc04bd993ff0346e7807b3bffcc4ed4adf21d354af9278bb4929",
      "text": "kasebut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4cc69393789441fb43672b995ca1ab9d75fc7a08b5e891716e3ebec314559a9",
      "text": "Jenenge tinulis ing layang iki.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68a5acb9847545fb091087ebd1b94bf74ffbaa770bf7e18f69d4ac250f07103",
      "text": "Kula nyuwun warta menika dipunmuat ing Panjebar Semangat.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc084dc2c9a8903eb42c207401bfc08169aee7466b37dee0505cafb9384cfd4b",
      "text": "Dalan ing Kutha Lama kebanjiran rob wingi sore.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca7a6e6c64f3ddf6dd5e75fc15bf2fe6558b741cc1137a06cd1d0337d0c8c56",
      "text": "Lurah kasebut kapilih dening warga.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd4e776aa47fd1d5f410bc73a94c67fca53c11cccaf3c618433284288fc978b5",
      "text": "Dalan ing Kutha Lama kebanjiran rob.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce512b3e68ffd3d9ff33e9c6314c01713c943cd75e666c8d47bb54f03af417b0",
      "text": "sinebut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfdb9ad1f8809258dce7c6e02529d5f0e640966a5b728d2a9b1629fe80f67037",
      "text": "Rob menika menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6bf626aba387c827638dff6ad227d86c811eee954ffa2b495f8b8f5a25e8151",
      "text": "didandani",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6df1a94f47764383b34d854a3575290f5f59aba057b20e8f6a533916581b8fd",
      "text": "dening",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "deedda9e9537749761616287d86e911d1f3ee87c86f30f657e3269ddf9794ca3",
      "text": "Oh, kula ngertos. Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e43b7d6fe688d276fee34ab0b7f21a7110e307e04e152e81b0f0cad74a307a83",
      "text": "Menika layang saking sinten, Pak?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4d390357a920ffb75676dbc8ce01c91a436ef745aa0ce94c3f83ab62aebf2d5",
      "text": "dibangun",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e76953a704a5ec0cbea97d4240261edd45eb53ec2fc371427be9c1e7721a78dc",
      "text": "Lawang Sewu dibangun ing jaman Walanda.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f48bb1008e7bb5381be4c7a6ae3fa13f9d0d54b5e0686d425f04120a73a3ce58",
      "text": "Buku iki dakwaca wingi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5b63dd122ee7b4156736ae22749b47d8a06c20e4d1b6d3c4681b6281f150fd6",
      "text": "Pak, wonten warta menapa ing koran?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f709ca4e39ecbe85db9b39599efd6fa06083a8956e58ad5b90b75aa507744d07",
      "text": "kerep",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffd7bf0b93a9660f3fc054068765e1e6106dc01a11767370b8e7c8861a220370",
      "text": "tinulis",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fff261821b06bfb651af78faf167d9e77ce8849da46f9a90f547c8cc2840ab04",
      "text": "Pak Slamet kapilih dadi lurah.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
