    },
    {
      "id": "j5.u02.l10",
      "sha256": "aab913f368230a0c2a69c1f651c37d3d81eab3b74292328cfa034c88d5de1d50"
    },
    {
      "id": "j5.u02.l11",
      "sha256": "c6dbd9b0a5f3b8ff4a64ca3b0ccf4c45b1ed1eeef0dd32402d7a389f42323feb"
    }
  ],
  "audio": [
    {
      "key": "00349f45b977aa5df7b0e708da1e67dd7064db60d1e2c15df07baf2cf4cb7b08",
      "text": "redaksi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "02577ec71df10c66c76a8a9023934055b5933069990333555b0bd9d6491f484a",
      "text": "Pameran kasebut dibukak dening Walikota Semarang wingi esuk.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "06dfdb408397562b6f347caff5decccccf83fe621457f16e1daf0f876c2c8ab4",
      "text": "Rombongan saka Jakarta mudik menyang Semarang.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "08dc1931443032768fec29ffed62016c28195b56d68b5995649b59a12de55af7",
      "text": "lurah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0acf7c87e4f24bd11c3e39db8d9a0b96d1061d75dc4b7d3a26f1156918f3d5b3",
      "text": "Saka warga dhusun. Ditulis nganggo krama, kaya layang kanggo wong sepuh.",
      "voice": "jv_dimas",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c7e3aeafe0172ebe69576a42c663404a38d843f50493bd9aa665cb1cb8e1a3c",
      "text": "Pameran foto sepur lawas dianakake ing Lawang Sewu.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eaac84b2a1599693bdd728d6d4f555034d4159efe687506f234448b106b78ea",
      "text": "enggal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f310c97df1c2fe77587ab85ebe38a51e67fee7fad945050aeaab761ee4a9181",
      "text": "kapilih",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "10699d91311b1191ab8a0d0af03c4a8e728f9c89063d3473d19a14e023499ac1",
      "text": "Bener. Sewu ing kene padha karo akeh banget.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "1130ccb3ea0ec1814ae788c4115855d12f9366c322acfd1fb417720e3e0ccad2",
      "text": "Tinulis, t-in-ulis, dados ditulis! Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "139629df40c671ae8c8f7ba6e39e8726abbe44d13effeffc612dc6aa8bfef77b",
      "text": "kacilakaan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c90b102d71aab682f12239c11da1c524be2caee6a6ce798a42c2dce2d1fbcd",
      "text": "dianakake",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1730865b35db9d564e4af302a169ae8e8857925e8a3ae7b5209156a42ef97333",
      "text": "diresiki",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c9c322213aa05d2d6e7f4b6655ea528ad69a0bea6c2f48fd8a507185f41bf2",
      "text": "Dalan ing Kutha Lama kebanjiran rob wingi sore.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "183a166cc6127143cfd2456250f6bd7bc99465608ba61ca7dbf6730394f4e065",
      "text": "Pak, lawangipun leres sewu?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "19cc756d47cc11d513eb83345414b6bdd9a2d26ef5e8f445e4a96abd42760ac8",
      "text": "Ana kacilakaan ing dalan tol Semarang.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a121b51caf18542765a0eb9c7eabb2e13b5b69de363b37f2faa7f7703c9451c",
      "text": "ngati-ati",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba538e03b7f2b9e90d919b637c74b25126cc8ce1a71e8be6d2c3afcabf7ea21",
      "text": "Kutha kasebut ana ing pesisir lor.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c23ca7887f223ee886a7a09a1754788c13d8290c65ffb834870a692d520558f",
      "text": "dhusun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2010305791b08579692aea194afd62ddd6c8b3fa64a900592097ce0002105306",
      "text": "Rombongan mudik sing liwat ing kono.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "215ab29b16f628cdc5a1c4b6038aa31b64bfd8b1b981af82a791d5fa284be03d",
      "text": "Banyu segara sing munggah menyang dalan. Ing Semarang kerep.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "2262c4854f8712bb6861191874e719af690ecbc859f21896565e6af0a4051588",
      "text": "bupati",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "24d812669b7bb87e13594c8bf4f475449ce95d3d0396c879774a974753cec864",
      "text": "Lawang Sewu dibangun dening perusahaan sepur Walanda.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "24fd244e1765686367dad4db9582b523176fff7dfabc0c498bdcce943abb8fcf",
      "text": "kinurmatan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2516d9f514977d09a5a93a74388ba50daff94a4f97bb04cb3efd659f2c167b6b",
      "text": "Bima sekolah ing Semarang.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "254d51bb6723f8eb89319942e9d6334a7030a80ccd3b44e168a35a9f452c83b2",
      "text": "Wong iku tiba lan meneng wae, ora tangi. Dheweke ___.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "27331ccfa4d9a3d88af69fdfb078f93a56fc9915b80ee49816d53ca277f046a3",
      "text": "Ana warta apa, Mohamed?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c21b1148ab6ce0876aab05876236fd187d027c109c6bec7fd7d1515035bb62e",
      "text": "Mas, iki Panjebar Semangat, kalawarti basa Jawa saka Surabaya.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c744e5b0bcbe19ba4f27374cde718fa38ea7743f661fedb60256df6bf8fdf4b",
      "text": "Oh, kados \"Kutha Sewu Menara\", nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d5005684bee0b17d59b78d9a0fc6c08106d88bca4750352cea1b723beed8bc0",
      "text": "Kalawarti menika sampun lami, Pak?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "301a95a3542fe2953d701f76c64f9e963c9253f1ac32d013db9a8f32e9205019",
      "text": "Ora persis sewu, Mas. Nanging akeh banget, mula sinebut Lawang Sewu.",
      "voice": "jv_dimas",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3202de534358decc4354393c5c98f7ff3ef53b36a06328cc64ebf9bcb5924e90",
      "text": "sekolah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "329c4e5d5e1e7f6f32fa5f51acddd6223601b8f269f968e135fe094ce3860389",
      "text": "Kutha iki sinebut Kutha Lumpia.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "32e321722391133860892f4a354e961b1eff3366965ec4171402b95dedbef07d",
      "text": "Miturut keterangan polisi, slamet. Sopire mung semaput sedhela.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "339c65de398311fed17156d7e36222528161f4886564b7e009e5c3e11083f275",
      "text": "kantor",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "34cf1789e96ab2db615db0d3fb3b0b2d5e461515991ad6ae5548d6ade7c1d02d",
      "text": "Pejabat iku ngakoni salahe.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "34ee0a4485ae81aa2ac4e9c25c4c494dd018422378328bcca7070b8bdbcfa73d",
      "text": "Jam pitu. Sarapan disiapake dening ibu-ibu.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "376f9b2f25b1d986a7fcd10b8e74d94383d9c35e349f92019d3c81916b6971d0",
      "text": "Sampun, Pak. Kula badhe dhateng.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a1b8eac74fc241d22eb682059f7ac259c723f4b202d451371c2048205e203a8",
      "text": "Iya. Kapilih dening warga. Jenenge tinulis ing koran.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a575dc8401bb87e20753646a4c7acb5d60e4ebe845ca07d6c55ace45b57a77d",
      "text": "Panganan disiapake dening ibu-ibu.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a5c4f0df787fb3feca443a0784b2be161423263ab4b88e482fc0c9f57262bd7",
      "text": "Dalan iku didandani dening warga.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ba2f3acb5fc22d921ddb587bfcf60522b761bf88d8c8843f24abbb059bc53e5",
      "text": "Matur nuwun, Pak. Kula remen maos warta.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c10ef917aabb0bdc7b28e098d54fc366492cfb590df5e34185ecb628aa073d6",
      "text": "Waduh! Saiki piye?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3b4a8dc2c949401a28eb97fcc3d5aef096d13cf9da892ed4ad24e3ca72ce25",
      "text": "rob",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "404cb83cef78b98eeaa48a245d9b42bd4cfec0142aa49d30dd67d53c44780d48",
      "text": "nyoblos",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4127152ad17bfe58e0003683ba36cf138a1a98c0136088c13d381f54c9db311e",
      "text": "Iya. Nanging rapate wis bubar, lan kabeh wis sepakat.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "41fe3fcf8e77d0cbab377a64b23c05c10b875d3aac2ab76e0f0b48e8121cedcb",
      "text": "Banjir gedhe ing desa iku sawijining ___.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "453a01ebbe61c169a3be436ef5a88bc01fa4bf110581bfbb4dca2371ca2c782d",
      "text": "Saiki gedhong menika dados museum, nggih?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a33d842a7f2fa69b38392083599fa6159527921425f556248f73ee8f7b792c",
      "text": "bakal",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dd4c3e762caa5b40d99c13150fbca9154f8b6892b5e7496d5d1e0e1b242c9de",
      "text": "Gedhong iki didandani dening perusahaan sepur.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fc32dc7cb4e263d4d213321fb02253be4e907856ed1b06f661bc9f18985120e",
      "text": "Bupati Kendal teka ing pasar anyar.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fee289722a8abaf89a07c9bea031d4b8db7ca34ec64f546ec63b002bbae4f7a",
      "text": "pitulungan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "506b25d49ded9626603ef3c1db3a02de5ad726df84960727e51ff8e78212e285",
      "text": "Pejabat iku ___ yen dheweke salah.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5594c7c8bc0ee951c46daad75a3b178182b2e8ff6ef4e5e444af978dbc29d688",
      "text": "Ayo, saiki wae. Pamerane dibukak nganti sore.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "58bc595b23d19330225e15325207754c8f50a571eb68bb6d361881695236b31c",
      "text": "Dalan ing Kaligawe kebanjiran rob maneh.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a047d78aed0b639682033de8cd82c6ad2e465998b8a60194bf9fbc4985f6a50",
      "text": "Foto-foto kasebut dijupuk ing jaman Walanda.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5af2f428f463859251b73d3c0ac85d4855da1358cad1118bfca5fc9f77002986",
      "text": "Mohamed, ana warta: kacilakaan ing dalan tol Semarang.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ea9c1e024d045a51f98c8005bf261f487a652bc2aee0c158b247fe03f0305db",
      "text": "Bupati prihatin marang warga sing kena banjir.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "60770d7d27dc7da413fca45eac20f9b762b4b9043f1152ed5fea14efa54253a4",
      "text": "Pak Harjo kapilih dadi lurah.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "61a16332426d9905e133ae7e4a7167a82c4c17ad97e0ab26919d3aa21623221f",
      "text": "Redaksi ingkang kinurmatan,",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "681fc2ab6cdf491b960c758604ed138b09c3d85e7cd15287a20948bf3e21706f",
      "text": "Wingi dalan ing Kutha Lama kebanjiran rob, esuk iki diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6be511c05a99dd9836a6d02f12663386803e83a36f7af5d8d3d9f26c888996ba",
      "text": "pameran",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9c6d72a1d89e282e77aa8fddaa67d84429c2c99b3b801eb2df001307a29016",
      "text": "Mas, wacanen. Pak Slamet kapilih dadi lurah.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ecf240de1eeea507836cca34663eb9ef2970adc24bfa7162ea10885aad545d9",
      "text": "Iya. Saiki wis didandani. Wacanen warta iki.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "732ad59e61f02fa700253f7f365f53c18aecb2177d37016d80a787b1da0e717a",
      "text": "kerja bakti",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "73c0dbd6a6bef2121d6bb7e4dd7f24cc7a52047856c7082e11b70c4d2c785394",
      "text": "Esuk iki, dalan kasebut wis diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7485f3b1d2755442b4cee78ba2d7da4f82c9a2f747d86c39a80089cacbcb6980",
      "text": "Warta iki ditulis dening Pak Harjo.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "754764cf93f35d7c2a6d6b8206796e9f30aefcc7774d9add089cb6a661844cb6",
      "text": "Jam pinten, Pak?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7640305da003acd5f7f564b6612ae50f78a33e291557193600f2cabe37b8de01",
      "text": "musibah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "77ceb6e0cb70a482f29a1f5b12aa2b87cf1e49a6f9ee3e1b468c7e86c27623d6",
      "text": "Saiki Lawang Sewu dadi museum lan papan wisata kang misuwur.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "787f0fb0bf33e7358b0a199f4f7ab9cdfb8cca990a2388ba66381a811f3a875c",
      "text": "warga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "78d909d868a6b0ac2493a3f4d24dd4eb2d50fb2be269d4d1aa258eb16725ba5f",
      "text": "ngakoni",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d728fb4e518c6258abd3b8cf7a04e347220a23a2fbc4f445292cf75aaaff864",
      "text": "kebanjiran",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ff4c989069e6900a577449ca97f159e99275226667d57f6f2b4f9f5ff740d9d",
      "text": "Warga nyoblos ing TPS saben limang taun.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8001db52e4b7cf8a1ff53ff8a03613cf0a6307936462a755ab8230c669ed3304",
      "text": "Dewan lan warga wis sepakat.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "8033da15dd65f6feac70f825aa4588432af6c78ba1a552d1adca47983fe44721",
      "text": "Masjid enggal dipunbangun dening warga.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8063cf78579a393ba2edae81ac72edd60bc48169f50f9886745d98a4ef417eb4",
      "text": "Ing jaman Walanda, Pak?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "85367e60660e18918358e51cede797893d838b4859a9380807c25103fe8f7a4d",
      "text": "disiapake",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ea42e711395eb032c882eda2faa39ecc420508a4529737e2dd829e2bb178f5",
      "text": "Masjid enggal ing dhusun kula dipunbangun dening warga.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ca2fa354da39737ab9aeee215436ef901d7ff47430853498690b4abe38ad3b",
      "text": "prihatin",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a86f5555fa44553a66a68d2ff48e7d9d19f7c0f0e3d2446178159abb783b118",
      "text": "Mas, wis maca warta? Ana pameran foto ing Lawang Sewu.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bebf24b50d2a2c904d83acaeac9d0fda2173329f301cd11d1edaeaaa402d54f",
      "text": "ditutup",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e1f3ea9d3393f41621f9fb6d460757fb2b65bea63287e3adae2963f7fd1ba3b",
      "text": "warta",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eaf5e74b431c222df3317e4796f5dfc3fbce5eac1754dd44e07dcdf961d4449",
      "text": "Lurah enggal kapilih dening warga, jenenge tinulis ing koran.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "945c44bd42942cb3ae951611dbcf60c29e97d486da030411105f27dbd56d5458",
      "text": "Iya. Foto-foto iku dijupuk ing jaman Walanda.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9632d1c9f0eec255e242c5e577536cae6cf28d006904ba326eafe4be73752567",
      "text": "Wis diresiki dening warga. Aman, Mbak.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "981734ab6ff90884dff85930075be1fbb8577900585c236c89ec9cc067e67307",
      "text": "Kabeh warga prihatin, nanging durung sepakat.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "98bb71ea005e2498374e8cd09fb77e7e70c084b58d312780da070ae8eb7d05e5",
      "text": "Wong saka dewan. Dheweke ngakoni dalan anyar durung rampung.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e430c718eecfba20a674f999924607bb18831f4ea463de0d908470dbf2e4420",
      "text": "Sopir bis semaput, banjur oleh pitulungan saka warga.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f6e4abbaf8f7e80173e5f2f2b62e53921c61276c0ef5db82e00c1801f50ac78",
      "text": "maneh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fb5108ca0395549dfe0cc2eba64688265e169d54580634a1ad35f5ad9c31046",
      "text": "Redaksi ingkang kinurmatan, kula nyuwun warta menika dipunmuat.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0eea0632d7299126a7d826a5147c033e667832c5a87c17ceafd151a61df5ba7",
      "text": "mudik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a210a75fd8c2c5095a0b77dc42e08bfb9387c4825b95d8b7ab18f29faf34e29d",
      "text": "Mas, gedhong iki dibangun dening perusahaan sepur Walanda.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8404b0525a750c5c8172909dd9bbbb1ed1a56448a23753fde2bcc16a427ae04",
      "text": "Dalan kasebut ditutup dening polisi nganti sore.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a88310275688551f2ef8991d04e744bd7be3c2e0a75913fea82ab5b3acf6a26d",
      "text": "rombongan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa23d134a7ac6c9374daadc2a84aeab30143402f4ee81d43d60424821ab72ba7",
      "text": "Rob kerep teka ing pesisir lor.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab502695f1f8486a480729eafed5831bb7a6ee1483050252cae642a175d227fc",
      "text": "dibukak",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "abc14c5a320d00ad5a51f66ea97c377b4c25635fe3da67e5c78b60963f910bde",
      "text": "Kerja bakti bakal dianakake ing dina Minggu esuk, jam pitu.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0bdd5a8f775a752465e3c613afbee57219ccd2933ccd02fc9387e9744054534",
      "text": "Wis lawas banget, wiwit jaman Walanda.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38f9e130fa9db7e3ed099bdc59c52a83aec08d2cc534f87dc8328217d728a69",
      "text": "Aja saiki! Dalane ditutup dening polisi nganti sore.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5e816f9dd6e82b04a03d3565fcb6577de5f7a71e1cd8d9a71ae2844ba1dcb37",
      "text": "Warta saka Semarang. Esuk iki, dalan ing Kaligawe kebanjiran rob maneh.",
      "voice": "jv_siti",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8683b1fe380ee432075f284fd21bdd0fd0ad48ffd9dba215ed245e754026827",
      "text": "pejabat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9195824c17c4b7e6c8d31151ae250a2fea5e272127c926eb4260c7d9e34eae5",
      "text": "Mbak, 'nyoblos' iku apa?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1d56052f9025756d89dcfd0d1a4e7d3d24c0d37be41e824b3905eedd9d06e0",
      "text": "Sesuk esuk, dalan kasebut bakal diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb7fcc8e261ac41054240f82db4fb9ec660bdf045b393abcd3ff227e1618b540",
      "text": "Ya wis, sesuk wae.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce8e1a7e60fe845ba5d82fca4303cfa79f5fcb1f9f74eeced1b5587f4dd28be",
      "text": "Wingi dalan ing Kutha Lama kebanjiran rob.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c11f31caee66b90e67623ba01cbb8677217330a26185c0b6798c5e282ec61642",
      "text": "Krungu. Dalan ing Kaligawe kebanjiran rob maneh.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c196b41ab2fc845894e021448e42f4f7e641287f0c6942b97a2e778ce5676957",
      "text": "dewan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2947538e948c9bb37bf3b609fa9dfab194657bb72309ded4c1511b6ad93e35b",
      "text": "semaput",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3758425980cc242c29349dc5947a1c89ba8e0fb205821b6eebcce045d300a7d",
      "text": "Kapilih menika sami kaliyan dipilih, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3fec9760e93fc04bd993ff0346e7807b3bffcc4ed4adf21d354af9278bb4929",
      "text": "kasebut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c41e2b0290c261886aa8fb30876b7bc9cb1186a3198ed792d4f9d1096fa46e6b",
      "text": "Iya, lan papan wisata kang misuwur.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4cc69393789441fb43672b995ca1ab9d75fc7a08b5e891716e3ebec314559a9",
      "text": "Jenenge tinulis ing layang iki.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68a5acb9847545fb091087ebd1b94bf74ffbaa770bf7e18f69d4ac250f07103",
      "text": "Kula nyuwun warta menika dipunmuat ing Panjebar Semangat.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95d1b1db0f679bd8c585523c08ad21b48b1cb48664a425ae7e2073231999c4b",
      "text": "Gedhong iki sinebut Lawang Sewu, amarga lawange akeh banget.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9cdd7c7a031a81e6dc7b70fd90a9f042ae89e67703934a0a3535b985b087229",
      "text": "Miturut keterangan polisi, kacilakaan iku ora gedhe.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc084dc2c9a8903eb42c207401bfc08169aee7466b37dee0505cafb9384cfd4b",
      "text": "Dalan ing Kutha Lama kebanjiran rob wingi sore.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc7854626b7b4fb4e209263e0c38b2ba064663eb3f7c219518ad3ed33822e67f",
      "text": "Ing jaman Walanda, gedhong kasebut dadi kantor perusahaan sepur.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca7a6e6c64f3ddf6dd5e75fc15bf2fe6558b741cc1137a06cd1d0337d0c8c56",
      "text": "Lurah kasebut kapilih dening warga.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd4e776aa47fd1d5f410bc73a94c67fca53c11cccaf3c618433284288fc978b5",
      "text": "Dalan ing Kutha Lama kebanjiran rob.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce512b3e68ffd3d9ff33e9c6314c01713c943cd75e666c8d47bb54f03af417b0",
      "text": "sinebut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef2e6fdd391d51f81bcb899d2c57853f62fe87ac8d7fb83e85647651dd2cc2b",
      "text": "Waduh! Kabeh slamet?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfdb9ad1f8809258dce7c6e02529d5f0e640966a5b728d2a9b1629fe80f67037",
      "text": "Rob menika menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2405e8537b8bf84cc293fd2d5d2cf7893a913825edcfe67a76d80bdc2f4554e",
      "text": "Mas, wis maca pengumuman? Minggu esuk ana kerja bakti.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2649c3dbcd1145365ac51055329a3d5afc13226d138641eb392b344fc75f3dd",
      "text": "Waduh, aku arep menyang Kaligawe.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3b212e1d979e6265bbd3071bf0eac7ab02414b76c7057a034dbfdd407e255f8",
      "text": "sepakat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4f76d34d0b0dd1afc40c279f38b7c6548e67b41ad41c8fe5bab986b8b5b50ca",
      "text": "Mohamed, krungu warta radio esuk iki?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5505d804e049c093735eb4728dd0b0a7414ee8d942929db77d99df29f0c46cb",
      "text": "Alhamdulillah. Musibah bisa teka kapan wae, kudu ngati-ati.",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d663697d44d998c89c59f19e8a3fca7aee659b25dc9c481d84989d6044931a73",
      "text": "Apik! Kali lan dalan ing kampung iki bakal diresiki bareng-bareng.",
      "voice": "jv_dimas",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6bf626aba387c827638dff6ad227d86c811eee954ffa2b495f8b8f5a25e8151",
      "text": "didandani",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6df1a94f47764383b34d854a3575290f5f59aba057b20e8f6a533916581b8fd",
      "text": "dening",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "deedda9e9537749761616287d86e911d1f3ee87c86f30f657e3269ddf9794ca3",
      "text": "Oh, kula ngertos. Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "df657f56515c791dba9ca7a0d9fac33fa1af6e010cc728b9adaa5f046124b187",
      "text": "bubar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e08e31abc5960c3c38e7c35c9659242976e6d289baf7a82e7ded1338ecfbf9ac",
      "text": "Kula badhe ningali, Pak.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e098ff77f2946256e9225902cee49c24c04917bf725380702db4273e28b1c760",
      "text": "Warga prihatin, ya?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2554acc7532cd7a36086727bcc8e91e4b9e990391c78cb9bafba2e28723087a",
      "text": "Kerja bakti bakal dianakake ing dina Minggu esuk.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e43b7d6fe688d276fee34ab0b7f21a7110e307e04e152e81b0f0cad74a307a83",
      "text": "Menika layang saking sinten, Pak?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4d390357a920ffb75676dbc8ce01c91a436ef745aa0ce94c3f83ab62aebf2d5",
      "text": "dibangun",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4d5d8c274cf9d04b8a723df50011c857dc9c2aadb1977343d62bc9a661fd0b9",
      "text": "Sampun, Pak. Fotonipun saking jaman Walanda, nggih?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6ffa40c0aa08f6476b786f93c19b6e0ccab9e1a461c02bd5c1cf250ebe8b8f6",
      "text": "Warta saka Semarang. Dalan ing Kaligawe kebanjiran rob maneh.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e72c4b432e5f38a4f9387c5dfbee57bf8ba300efea4c5b7fd1ea18dd655d12e0",
      "text": "Kali lan dalan ing kampung bakal diresiki bareng-bareng.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e76953a704a5ec0cbea97d4240261edd45eb53ec2fc371427be9c1e7721a78dc",
      "text": "Lawang Sewu dibangun ing jaman Walanda.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f014cdefd9641de513c6a4f7c8d739e3cc3ce4ad983d31b2da5889b071631184",
      "text": "Sapa sing menehi pitulungan?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "f301ab9fb88168cee9b7f31c409f41233c1a8e7e70b8fcd86be04bca3544c447",
      "text": "Milih ing TPS. Warga nyoblos kanggo milih bupati.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3adbfaa2b6834675af2528665b76bb1fd7251314a627b9b948343e5cf1e068c",
      "text": "lawang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f48bb1008e7bb5381be4c7a6ae3fa13f9d0d54b5e0686d425f04120a73a3ce58",
      "text": "Buku iki dakwaca wingi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f57419f1b7ee06df9cad5ce128ea03ac0d3c9906d5d5d09b47c4673b6431e9cd",
      "text": "Miturut keterangan polisi, kabeh penumpang slamet.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5b63dd122ee7b4156736ae22749b47d8a06c20e4d1b6d3c4681b6281f150fd6",
      "text": "Pak, wonten warta menapa ing koran?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f709ca4e39ecbe85db9b39599efd6fa06083a8956e58ad5b90b75aa507744d07",
      "text": "kerep",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa01c9cfc5d1ac15f049176e836766afd0e9cc43f948ab745a11e7dc03c0520d",
      "text": "keterangan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdc09992e1c138beb4565ff261aa87e71c499dc5814a3d1f37a39ea2c3b972a7",
      "text": "Yen mudik, ngati-ati ing dalan.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff369da183741191fd878e7a3fc7e85b9f97dfb023a5d1f9a3cc090720a2830e",
      "text": "Ing warta iki, pejabat endi sing ngakoni salah?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffd7bf0b93a9660f3fc054068765e1e6106dc01a11767370b8e7c8861a220370",
      "text": "tinulis",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fff261821b06bfb651af78faf167d9e77ce8849da46f9a90f547c8cc2840ab04",
      "text": "Pak Slamet kapilih dadi lurah.",
      "voice": "jv_siti",
      "chars": 30,
