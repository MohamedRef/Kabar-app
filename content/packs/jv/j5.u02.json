    }
  ],
  "audio": [
    {
      "key": "00349f45b977aa5df7b0e708da1e67dd7064db60d1e2c15df07baf2cf4cb7b08",
      "text": "redaksi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "08dc1931443032768fec29ffed62016c28195b56d68b5995649b59a12de55af7",
      "text": "lurah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0acf7c87e4f24bd11c3e39db8d9a0b96d1061d75dc4b7d3a26f1156918f3d5b3",
      "text": "Saka warga dhusun. Ditulis nganggo krama, kaya layang kanggo wong sepuh.",
      "voice": "jv_dimas",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d93e0c5af650d8982b81b2e7ce8277c2e50115eb3d5c005aa6290225fc221ef",
      "text": "Kali Madiun kerep luber yen udan gedhe.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eaac84b2a1599693bdd728d6d4f555034d4159efe687506f234448b106b78ea",
      "text": "enggal",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f310c97df1c2fe77587ab85ebe38a51e67fee7fad945050aeaab761ee4a9181",
      "text": "kapilih",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1028c096102d7be5e5ca1ba08ead33145a9b71c4cbf9c954c07bac148ca334f4",
      "text": "Saka dalan ra katon, lho, Mas. Ana lemah dhuwur ing ngarepe.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "1130ccb3ea0ec1814ae788c4115855d12f9366c322acfd1fb417720e3e0ccad2",
      "text": "Tinulis, t-in-ulis, dados ditulis! Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "139629df40c671ae8c8f7ba6e39e8726abbe44d13effeffc612dc6aa8bfef77b",
      "text": "kacilakaan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c90b102d71aab682f12239c11da1c524be2caee6a6ce798a42c2dce2d1fbcd",
      "text": "dianakake",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1730865b35db9d564e4af302a169ae8e8857925e8a3ae7b5209156a42ef97333",
      "text": "diresiki",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "195c45145cf17a37af38234cdc4f1d3051c734f92f0aab76fd2a95e04839fff1",
      "text": "Mas, wis maca warta? Ana pameran foto ing Stasiun Madiun.",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a121b51caf18542765a0eb9c7eabb2e13b5b69de363b37f2faa7f7703c9451c",
      "text": "ngati-ati",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c23ca7887f223ee886a7a09a1754788c13d8290c65ffb834870a692d520558f",
      "text": "dhusun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2010305791b08579692aea194afd62ddd6c8b3fa64a900592097ce0002105306",
      "text": "Rombongan mudik sing liwat ing kono.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2262c4854f8712bb6861191874e719af690ecbc859f21896565e6af0a4051588",
      "text": "bupati",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "24fd244e1765686367dad4db9582b523176fff7dfabc0c498bdcce943abb8fcf",
      "text": "kinurmatan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "254d51bb6723f8eb89319942e9d6334a7030a80ccd3b44e168a35a9f452c83b2",
      "text": "Wong iku tiba lan meneng wae, ora tangi. Dheweke ___.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "27331ccfa4d9a3d88af69fdfb078f93a56fc9915b80ee49816d53ca277f046a3",
      "text": "Ana warta apa, Mohamed?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2892bedabf89d4dad80ab36df3b51444d228314baa10e583248c80765fbf7ce4",
      "text": "Wingi Kali Madiun luber, esuk iki dalane diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d5005684bee0b17d59b78d9a0fc6c08106d88bca4750352cea1b723beed8bc0",
      "text": "Kalawarti menika sampun lami, Pak?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e0ac7fad2a11d4cb920115960f800f8abfdc122e6bbcd2c5ce2271d04ac7711",
      "text": "Iya. Kapilih dening warga. Jenenge tinulis ing koran, lho.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "3202de534358decc4354393c5c98f7ff3ef53b36a06328cc64ebf9bcb5924e90",
      "text": "sekolah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "32e321722391133860892f4a354e961b1eff3366965ec4171402b95dedbef07d",
      "text": "Miturut keterangan polisi, slamet. Sopire mung semaput sedhela.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "339c65de398311fed17156d7e36222528161f4886564b7e009e5c3e11083f275",
      "text": "kantor",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "33c9e389d7059cea95e5b2401248df540fe30f98b2c86151588164443e0a8448",
      "text": "Banyu kali munggah nganti metu menyang dalan. Yen udan gedhe kerep, kok.",
      "voice": "jv_dimas",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "341a88b679aa8f575f85c782676185d0a7d9ee8d1e0361bd16bef6bfa8c15023",
      "text": "Wis lawas, lho, wiwit taun 1971.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "34cf1789e96ab2db615db0d3fb3b0b2d5e461515991ad6ae5548d6ade7c1d02d",
      "text": "Pejabat iku ngakoni salahe.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "34ee0a4485ae81aa2ac4e9c25c4c494dd018422378328bcca7070b8bdbcfa73d",
      "text": "Jam pitu. Sarapan disiapake dening ibu-ibu.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "376f9b2f25b1d986a7fcd10b8e74d94383d9c35e349f92019d3c81916b6971d0",
      "text": "Sampun, Pak. Kula badhe dhateng.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a18c42d63bdd58a5867cbba4196f7e2db6a52fdb3096030d097a068763fb393",
      "text": "Pameran foto sepur lawas dianakake ing Stasiun Madiun.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a575dc8401bb87e20753646a4c7acb5d60e4ebe845ca07d6c55ace45b57a77d",
      "text": "Panganan disiapake dening ibu-ibu.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a5c4f0df787fb3feca443a0784b2be161423263ab4b88e482fc0c9f57262bd7",
      "text": "Dalan iku didandani dening warga.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ba2f3acb5fc22d921ddb587bfcf60522b761bf88d8c8843f24abbb059bc53e5",
      "text": "Matur nuwun, Pak. Kula remen maos warta.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c10ef917aabb0bdc7b28e098d54fc366492cfb590df5e34185ecb628aa073d6",
      "text": "Waduh! Saiki piye?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ccde1771aa0ead252e2fc112b549c3c533cad2ec49d181ffb3b2e65c5ac989f",
      "text": "Wingi dalan ing Manguharjo kebanjiran.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ef67e1fa5cfc2f8b2bcb756ce702d9bfd7bc8057cb2bec79d8892b60f43f0fe",
      "text": "Waduh, aku arep menyang Manguharjo.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "404cb83cef78b98eeaa48a245d9b42bd4cfec0142aa49d30dd67d53c44780d48",
      "text": "nyoblos",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4127152ad17bfe58e0003683ba36cf138a1a98c0136088c13d381f54c9db311e",
      "text": "Iya. Nanging rapate wis bubar, lan kabeh wis sepakat.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "41fe3fcf8e77d0cbab377a64b23c05c10b875d3aac2ab76e0f0b48e8121cedcb",
      "text": "Banjir gedhe ing desa iku sawijining ___.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "425b920e5483c19826eb514bbeac656452448d2ac91b0bd1bbd0acd30c74f3f5",
      "text": "Warta saka Madiun. Dalan ing Manguharjo kebanjiran maneh.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "43186f3b0e3016ae6f2b14a7f1d3e94da3baa0235cd4ce5579e2fcb4c67aff1b",
      "text": "Kutha kasebut ana ing sisih kulon Jawa Timur.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "4683efaeda634e20e4cba82cdd5481a9eaf83e29ad817d12da48a976226c2e44",
      "text": "Bener. Biyen dibangun dening Walanda, ing pinggir Bengawan Solo.",
      "voice": "jv_dimas",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a33d842a7f2fa69b38392083599fa6159527921425f556248f73ee8f7b792c",
      "text": "bakal",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b8fff134e3fe02d9f75e42757a58f9ee0b7564eb6cb3b1a121c139633566287",
      "text": "Dalan ing Manguharjo kebanjiran maneh.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d5afeb760a5677c7559fcfe72d3df6e24be72a8270f75e19a0efd90bb870c37",
      "text": "Pak, benteng menika kok sinebut Benteng Pendem?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dd4c3e762caa5b40d99c13150fbca9154f8b6892b5e7496d5d1e0e1b242c9de",
      "text": "Gedhong iki didandani dening perusahaan sepur.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fc32dc7cb4e263d4d213321fb02253be4e907856ed1b06f661bc9f18985120e",
      "text": "Bupati Kendal teka ing pasar anyar.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fee289722a8abaf89a07c9bea031d4b8db7ca34ec64f546ec63b002bbae4f7a",
      "text": "pitulungan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "506b25d49ded9626603ef3c1db3a02de5ad726df84960727e51ff8e78212e285",
      "text": "Pejabat iku ___ yen dheweke salah.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5594c7c8bc0ee951c46daad75a3b178182b2e8ff6ef4e5e444af978dbc29d688",
      "text": "Ayo, saiki wae. Pamerane dibukak nganti sore.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "584d50a32575efb30acb0db4be6bdab2fd8f6e2436c16a8c181a79fe867bb26c",
      "text": "Dalan ing Manguharjo kebanjiran.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a047d78aed0b639682033de8cd82c6ad2e465998b8a60194bf9fbc4985f6a50",
      "text": "Foto-foto kasebut dijupuk ing jaman Walanda.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df8b715514a25d4e61046a687a610cdf01155f796c5a9dea86249e638ff9473",
      "text": "Stasiun Madiun dibangun dening perusahaan sepur Walanda.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e84c7dd7392dc757eb4124fdd9cc7cc6ad290477f622eb50167852a4ee50994",
      "text": "Warga prihatin, ta?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ea9c1e024d045a51f98c8005bf261f487a652bc2aee0c158b247fe03f0305db",
      "text": "Bupati prihatin marang warga sing kena banjir.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "60770d7d27dc7da413fca45eac20f9b762b4b9043f1152ed5fea14efa54253a4",
      "text": "Pak Harjo kapilih dadi lurah.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "61a16332426d9905e133ae7e4a7167a82c4c17ad97e0ab26919d3aa21623221f",
      "text": "Redaksi ingkang kinurmatan,",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "65de011e245b78347d68226359309422403981c710b41487588f14e73a30f4ad",
      "text": "Mohamed, ana warta: kacilakaan ing dalan tol Madiun.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bdb8d0b94be33b532b6481cfa7bf34369af1ccab6a935b914c89d798a9670ae",
      "text": "Iya, misuwur tenan. Ayo mlebu liwat lawang ngarep!",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6be511c05a99dd9836a6d02f12663386803e83a36f7af5d8d3d9f26c888996ba",
      "text": "pameran",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c2504a523a44caa89384d2091db69c63533ea5437e00786438fbfa6c7da40df",
      "text": "Krungu. Dalan ing Manguharjo kebanjiran maneh.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9c6d72a1d89e282e77aa8fddaa67d84429c2c99b3b801eb2df001307a29016",
      "text": "Mas, wacanen. Pak Slamet kapilih dadi lurah.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ec97c023728c903fa409d4fa028968aa47ec58685cb163b1cbf152dbab2d826",
      "text": "Bima sekolah ing Ngawi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ecf240de1eeea507836cca34663eb9ef2970adc24bfa7162ea10885aad545d9",
      "text": "Iya. Saiki wis didandani. Wacanen warta iki.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "732ad59e61f02fa700253f7f365f53c18aecb2177d37016d80a787b1da0e717a",
      "text": "kerja bakti",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "73c0dbd6a6bef2121d6bb7e4dd7f24cc7a52047856c7082e11b70c4d2c785394",
      "text": "Esuk iki, dalan kasebut wis diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7485f3b1d2755442b4cee78ba2d7da4f82c9a2f747d86c39a80089cacbcb6980",
      "text": "Warta iki ditulis dening Pak Harjo.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "754764cf93f35d7c2a6d6b8206796e9f30aefcc7774d9add089cb6a661844cb6",
      "text": "Jam pinten, Pak?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7640305da003acd5f7f564b6612ae50f78a33e291557193600f2cabe37b8de01",
      "text": "musibah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "787f0fb0bf33e7358b0a199f4f7ab9cdfb8cca990a2388ba66381a811f3a875c",
      "text": "warga",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "78d909d868a6b0ac2493a3f4d24dd4eb2d50fb2be269d4d1aa258eb16725ba5f",
      "text": "ngakoni",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d728fb4e518c6258abd3b8cf7a04e347220a23a2fbc4f445292cf75aaaff864",
      "text": "kebanjiran",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ebd294b2c16c46063642735e18e4981e0a25ba1637193d783d2ab29a4873afa",
      "text": "Warta saka Madiun. Esuk iki, dalan ing Manguharjo kebanjiran maneh.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ff4c989069e6900a577449ca97f159e99275226667d57f6f2b4f9f5ff740d9d",
      "text": "Warga nyoblos ing TPS saben limang taun.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8001db52e4b7cf8a1ff53ff8a03613cf0a6307936462a755ab8230c669ed3304",
      "text": "Dewan lan warga wis sepakat.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "8033da15dd65f6feac70f825aa4588432af6c78ba1a552d1adca47983fe44721",
      "text": "Masjid enggal dipunbangun dening warga.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8063cf78579a393ba2edae81ac72edd60bc48169f50f9886745d98a4ef417eb4",
      "text": "Ing jaman Walanda, Pak?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "806b582be81e2868dcac7ea0f8492c668956ad8eb643816c7cb1ccf487a948d9",
      "text": "Ing jaman Walanda, ing benteng kasebut ana kantor lan kamar prajurit.",
      "voice": "jv_siti",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "8375600458f60a8f677fe1ebaaef1a10a15b1cc411fcee5bb8314c94d7458198",
      "text": "Saiki benteng menika dados papan wisata, nggih?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "85367e60660e18918358e51cede797893d838b4859a9380807c25103fe8f7a4d",
      "text": "disiapake",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ea42e711395eb032c882eda2faa39ecc420508a4529737e2dd829e2bb178f5",
      "text": "Masjid enggal ing dhusun kula dipunbangun dening warga.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ca2fa354da39737ab9aeee215436ef901d7ff47430853498690b4abe38ad3b",
      "text": "prihatin",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a3840074671e0035b64bb067c0033395019b718abbfad5116de03b7481d7339",
      "text": "Stasiun Madiun dibangun ing jaman Walanda.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bebf24b50d2a2c904d83acaeac9d0fda2173329f301cd11d1edaeaaa402d54f",
      "text": "ditutup",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e1f3ea9d3393f41621f9fb6d460757fb2b65bea63287e3adae2963f7fd1ba3b",
      "text": "warta",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eaf5e74b431c222df3317e4796f5dfc3fbce5eac1754dd44e07dcdf961d4449",
      "text": "Lurah enggal kapilih dening warga, jenenge tinulis ing koran.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "945c44bd42942cb3ae951611dbcf60c29e97d486da030411105f27dbd56d5458",
      "text": "Iya. Foto-foto iku dijupuk ing jaman Walanda.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9632d1c9f0eec255e242c5e577536cae6cf28d006904ba326eafe4be73752567",
      "text": "Wis diresiki dening warga. Aman, Mbak.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "981734ab6ff90884dff85930075be1fbb8577900585c236c89ec9cc067e67307",
      "text": "Kabeh warga prihatin, nanging durung sepakat.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "98bb71ea005e2498374e8cd09fb77e7e70c084b58d312780da070ae8eb7d05e5",
      "text": "Wong saka dewan. Dheweke ngakoni dalan anyar durung rampung.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c229f308aa7a3b9aef009659173fe771612eda3c179dee392934a083d75cbd5",
      "text": "Ing jaman Walanda, ing benteng kasebut ana kantor prajurit.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e430c718eecfba20a674f999924607bb18831f4ea463de0d908470dbf2e4420",
      "text": "Sopir bis semaput, banjur oleh pitulungan saka warga.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f650baa5e53d83da4efd180b676137d73813af7d807e6ee096d5b4975a477dc",
      "text": "Kali Madiun luber, dalan ing Manguharjo kebanjiran.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f6e4abbaf8f7e80173e5f2f2b62e53921c61276c0ef5db82e00c1801f50ac78",
      "text": "maneh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fb5108ca0395549dfe0cc2eba64688265e169d54580634a1ad35f5ad9c31046",
      "text": "Redaksi ingkang kinurmatan, kula nyuwun warta menika dipunmuat.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0eea0632d7299126a7d826a5147c033e667832c5a87c17ceafd151a61df5ba7",
      "text": "mudik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8404b0525a750c5c8172909dd9bbbb1ed1a56448a23753fde2bcc16a427ae04",
      "text": "Dalan kasebut ditutup dening polisi nganti sore.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a88310275688551f2ef8991d04e744bd7be3c2e0a75913fea82ab5b3acf6a26d",
      "text": "rombongan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a910609d99ed2452e870e66660fdf2867ead3f808ae3cf05a2772abdc2f491a5",
      "text": "Dalan ing Manguharjo kebanjiran wingi sore.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab502695f1f8486a480729eafed5831bb7a6ee1483050252cae642a175d227fc",
      "text": "dibukak",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "abc14c5a320d00ad5a51f66ea97c377b4c25635fe3da67e5c78b60963f910bde",
      "text": "Kerja bakti bakal dianakake ing dina Minggu esuk, jam pitu.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "ade46680f88cda07d2e878a82d742cb55efa1aa8510e9e844db9d8c48b4c046f",
      "text": "Ana kacilakaan ing dalan tol Madiun.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b108f63c81cce4f8126dcdbe1ee871cd6c1647f4e5164ccc677eb5c955327b44",
      "text": "Mas, iki Djaka Lodang, kalawarti basa Jawa saka Yogya.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b371850caa7a56272e25b9d00360e341154d091f0df6fbdcb548de573615412e",
      "text": "Mas, gedhong stasiun iki dibangun dening perusahaan sepur Walanda, lho.",
      "voice": "jv_dimas",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38f9e130fa9db7e3ed099bdc59c52a83aec08d2cc534f87dc8328217d728a69",
      "text": "Aja saiki! Dalane ditutup dening polisi nganti sore.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8683b1fe380ee432075f284fd21bdd0fd0ad48ffd9dba215ed245e754026827",
      "text": "pejabat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9195824c17c4b7e6c8d31151ae250a2fea5e272127c926eb4260c7d9e34eae5",
      "text": "Mbak, 'nyoblos' iku apa?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1d56052f9025756d89dcfd0d1a4e7d3d24c0d37be41e824b3905eedd9d06e0",
      "text": "Sesuk esuk, dalan kasebut bakal diresiki dening warga.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb7fcc8e261ac41054240f82db4fb9ec660bdf045b393abcd3ff227e1618b540",
      "text": "Ya wis, sesuk wae.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc9ab4710c1f56345a3c39b0b13c4e4d06a6b17ae8901a26da9c7c8d384b255a",
      "text": "Kali Madiun luber, dalan ing Manguharjo kebanjiran wingi sore.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "be8047bc5bd390f10863caf247068170b4578e227038a94813d6061d4b6ea972",
      "text": "Benteng iki sinebut Benteng Pendem, amarga ora katon saka dalan.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "c196b41ab2fc845894e021448e42f4f7e641287f0c6942b97a2e778ce5676957",
      "text": "dewan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2947538e948c9bb37bf3b609fa9dfab194657bb72309ded4c1511b6ad93e35b",
      "text": "semaput",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3758425980cc242c29349dc5947a1c89ba8e0fb205821b6eebcce045d300a7d",
      "text": "Kapilih menika sami kaliyan dipilih, nggih, Pak?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3fec9760e93fc04bd993ff0346e7807b3bffcc4ed4adf21d354af9278bb4929",
      "text": "kasebut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4cc69393789441fb43672b995ca1ab9d75fc7a08b5e891716e3ebec314559a9",
      "text": "Jenenge tinulis ing layang iki.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9cdd7c7a031a81e6dc7b70fd90a9f042ae89e67703934a0a3535b985b087229",
      "text": "Miturut keterangan polisi, kacilakaan iku ora gedhe.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc8579d858347b1f12efe8e0c2970acc2889913b28f6d2f94755cbb80bb3e22f",
      "text": "Apik! Kali lan dalan ing kampung iki bakal diresiki bareng-bareng, lho.",
      "voice": "jv_dimas",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca7a6e6c64f3ddf6dd5e75fc15bf2fe6558b741cc1137a06cd1d0337d0c8c56",
      "text": "Lurah kasebut kapilih dening warga.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce512b3e68ffd3d9ff33e9c6314c01713c943cd75e666c8d47bb54f03af417b0",
      "text": "sinebut",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef2e6fdd391d51f81bcb899d2c57853f62fe87ac8d7fb83e85647651dd2cc2b",
      "text": "Waduh! Kabeh slamet?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2405e8537b8bf84cc293fd2d5d2cf7893a913825edcfe67a76d80bdc2f4554e",
      "text": "Mas, wis maca pengumuman? Minggu esuk ana kerja bakti.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3b212e1d979e6265bbd3071bf0eac7ab02414b76c7057a034dbfdd407e255f8",
      "text": "sepakat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4f76d34d0b0dd1afc40c279f38b7c6548e67b41ad41c8fe5bab986b8b5b50ca",
      "text": "Mohamed, krungu warta radio esuk iki?",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5505d804e049c093735eb4728dd0b0a7414ee8d942929db77d99df29f0c46cb",
      "text": "Alhamdulillah. Musibah bisa teka kapan wae, kudu ngati-ati.",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5c7b625b2e15081266ec172c7b18b8601e2d167f3e4acfc73829e1762ec997c",
      "text": "Rombongan saka Jakarta mudik menyang Madiun.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6bf626aba387c827638dff6ad227d86c811eee954ffa2b495f8b8f5a25e8151",
      "text": "didandani",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6c5bc034af8cd83ec42fe570ad1b66e4a441662c0e7be38acd6ffebc1377786",
      "text": "Pameran kasebut dibukak dening Walikota Madiun wingi esuk.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6df1a94f47764383b34d854a3575290f5f59aba057b20e8f6a533916581b8fd",
      "text": "dening",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbdfb15abba54c037eba5800866707d2e038c2d6ff786ed3fab89da7f943e9e7",
      "text": "Kutha iki sinebut Kutha Pendekar.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "deedda9e9537749761616287d86e911d1f3ee87c86f30f657e3269ddf9794ca3",
      "text": "Oh, kula ngertos. Matur nuwun, Pak.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "df657f56515c791dba9ca7a0d9fac33fa1af6e010cc728b9adaa5f046124b187",
      "text": "bubar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e08e31abc5960c3c38e7c35c9659242976e6d289baf7a82e7ded1338ecfbf9ac",
      "text": "Kula badhe ningali, Pak.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2554acc7532cd7a36086727bcc8e91e4b9e990391c78cb9bafba2e28723087a",
      "text": "Kerja bakti bakal dianakake ing dina Minggu esuk.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27f795dc899de747dcee856e0bdafa93820cfeb5a032aef3d59a58d73b55587",
      "text": "Luber menika menapa, Pak?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e43b7d6fe688d276fee34ab0b7f21a7110e307e04e152e81b0f0cad74a307a83",
      "text": "Menika layang saking sinten, Pak?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4d390357a920ffb75676dbc8ce01c91a436ef745aa0ce94c3f83ab62aebf2d5",
      "text": "dibangun",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4d5d8c274cf9d04b8a723df50011c857dc9c2aadb1977343d62bc9a661fd0b9",
      "text": "Sampun, Pak. Fotonipun saking jaman Walanda, nggih?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e72c4b432e5f38a4f9387c5dfbee57bf8ba300efea4c5b7fd1ea18dd655d12e0",
      "text": "Kali lan dalan ing kampung bakal diresiki bareng-bareng.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec3e8d3a778ae7550d1da5a437fd0ed4441961aaacc520305b65b11fb1c347fe",
      "text": "Kula nyuwun warta menika dipunmuat ing Djaka Lodang.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "eddb19ee88baa7bc3c1508f114fb8d0929dc5aa4eada36a9c4acedd57138ad64",
      "text": "Saiki Benteng Pendem dadi papan wisata kang misuwur.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f014cdefd9641de513c6a4f7c8d739e3cc3ce4ad983d31b2da5889b071631184",
      "text": "Sapa sing menehi pitulungan?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04aca5b3b5d5810ae479e2b9d8d2870807d6f2e01766c2e0eded85b7d1ad410",
      "text": "Benteng iki duwe lawang gedhe loro.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f301ab9fb88168cee9b7f31c409f41233c1a8e7e70b8fcd86be04bca3544c447",
      "text": "Milih ing TPS. Warga nyoblos kanggo milih bupati.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3adbfaa2b6834675af2528665b76bb1fd7251314a627b9b948343e5cf1e068c",
      "text": "lawang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f48bb1008e7bb5381be4c7a6ae3fa13f9d0d54b5e0686d425f04120a73a3ce58",
      "text": "Buku iki dakwaca wingi.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f57419f1b7ee06df9cad5ce128ea03ac0d3c9906d5d5d09b47c4673b6431e9cd",
      "text": "Miturut keterangan polisi, kabeh penumpang slamet.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5b63dd122ee7b4156736ae22749b47d8a06c20e4d1b6d3c4681b6281f150fd6",
      "text": "Pak, wonten warta menapa ing koran?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f69a2724c33aa34dd291d9da9e85c88ba67052cfa80b6c0b0bda1dea6c2708e5",
      "text": "luber",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f709ca4e39ecbe85db9b39599efd6fa06083a8956e58ad5b90b75aa507744d07",
      "text": "kerep",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa01c9cfc5d1ac15f049176e836766afd0e9cc43f948ab745a11e7dc03c0520d",
      "text": "keterangan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc863ef055e7b0b6402c605f1f92b6ebbe193a7ff209880e90631a95e15c999a",
      "text": "Oh, mula sinebut \"pendem\", nggih?",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdc09992e1c138beb4565ff261aa87e71c499dc5814a3d1f37a39ea2c3b972a7",
      "text": "Yen mudik, ngati-ati ing dalan.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff369da183741191fd878e7a3fc7e85b9f97dfb023a5d1f9a3cc090720a2830e",
      "text": "Ing warta iki, pejabat endi sing ngakoni salah?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffd7bf0b93a9660f3fc054068765e1e6106dc01a11767370b8e7c8861a220370",
      "text": "tinulis",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fff261821b06bfb651af78faf167d9e77ce8849da46f9a90f547c8cc2840ab04",
      "text": "Pak Slamet kapilih dadi lurah.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    }
