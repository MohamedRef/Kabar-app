  "unit": "j5.u03",
  "version": 3,
  "content_hash": "0a23f12b71a9a48aa96af024b951a4efcf021b6b046fe158f75454bcc9f31754",
  "lessons": [
    {
      "id": "j5.u03.l01",
      "sha256": "c4e73fe49c9c42d6c0808097a17fc8a93d67a5d52b4f0ce70de03aaf266145a0"
    },
    {
      "id": "j5.u03.l02",
      "sha256": "2b3aebcccb6503f52b116356b3850e1c6ec935e126dc11edbca42e4f382a4bf3"
    },
    {
      "id": "j5.u03.l03",
      "sha256": "ac7f5ed19e19b84b287861dce3825bc8649f0d7cd95c4df3a6eead7e4bb32d9e"
    },
    {
      "id": "j5.u03.l04",
      "sha256": "218ff890c4cc3a723362bac4f2f367e56c65ba856d4622aeacda9bd86e85f50e"
    },
    {
      "id": "j5.u03.l05",
      "sha256": "d13d6a1cbbfe5b9bdd0d51d762ad9e7513773c8387ea6d136a975234ae22b578"
    },
    {
      "id": "j5.u03.l06",
      "sha256": "66d8c7bfd07f8aa789d43276d7dde6ede9549394d723a52b9bf891e84d40488a"
    },
    {
      "id": "j5.u03.l07",
      "sha256": "3eb1e24a35ad904a77371ee6117427234c541f0195f6fe7ba60bae990f1cb702"
    },
    {
      "id": "j5.u03.l08",
      "sha256": "b27a2d81ce8e44b38c8e4a8d444758221a7ed17b879b00f81a6d624c3a3996da"
    },
    {
      "id": "j5.u03.l09",
      "sha256": "662220ff48b32eff8263b6c345db7658cb3fcf5b41a49aa8eeab57c9576cf029"
    }
  ],
  "audio": [
    {
      "key": "091b4a03bb787c5d8b61cbab1f053b13828c64d7648f3db6250d70305f0147de",
      "text": "Wedhi, pasir!",
      "voice": "jv_dimas",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "095ffe35881797889a69ae10ce75be18b0427ad1a0db5bcb6dc3c09c4cb20b42",
      "text": "Mohamed, adhiku lara. Aku ora bisa teka.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bdb3c2ef0606190bb150373586aba2f6f33e21616ad3d060311b36aa32e7df1",
      "text": "Sega kucing kalih, Bu, kaliyan tela goreng.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e0caf8c02745f1e0aa489dc78f1562fe3aa7b55f3842e27efd44503de98cc7f",
      "text": "Aku lagi lara, ora isa teka.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f386e7a1b99d97507c897168f468186760437e0b77cc4bf34bddf04d2b3e42b",
      "text": "Sesuk aku mesthi teka.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fa51dda9bf7c11667be5af6be22d08ba98bfd79d1901ddbe4eaf19fac3b3675",
      "text": "Dibungkus, Bu. Pinten?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "105316d76347fb3f1918744cdba8a3b7f8f81ddc07788e159aadc35cbf08f328",
      "text": "Regane pira?",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "10997a760727cb4a12cdbe240474c4f72a8fcc06a14af1e455380760321a4166",
      "text": "Waduh, aku lagi loro, ora iso teko.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "135fe000d5918d206cf917c6575f98787d701685c66cfe3cdfd69495aea3126a",
      "text": "Mohamed, aku wis ana ing Simpang Lima, ing ngarep masjid.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1378cd6689f2c942bdcfeec0e5a1448d682f44e6bff492512008bca07edefa5e",
      "text": "Sesuk aku mesti wes mari.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "180aa7a8909696646d606246c7d45bb08fa93090a64afd5a2a93af6f8a341a03",
      "text": "Mohamed, tulisanmu apik, nanging ana sing kliru.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "182473a4f3b66c0bd4705d394b3978c34781f5c85a9d11e82c07da18af11f2d7",
      "text": "Tembung \"sega\" munine kaya apa?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a8d8019744d518402d877fe8f70214b460ae8c95d13b674aff9fcfa47f5b8a6",
      "text": "Tulisan sing bener, piro utawa pira?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c17de23e6e0611e7d7bbffe331c6c1c2d10def7ef2212407d45fa22a68d0f5b",
      "text": "dhadha",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eb0b80e14a9ba47ed44a328f2f8f9b0c6025bd650cd16a77d6ffc568ce4b7c8",
      "text": "Ora lali. Aku mesthi teka.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "21035658ce12093521c03d0b54bdea4326e7565383fa0adc8e8667030d8da530",
      "text": "Iya, munine loro, nanging tulisane lara. Loro iku angka loro.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "2816b9c55463ca39171780bb5742f42c11240623b7b3510652dc465c1ccad808",
      "text": "Iya. Ing buku lan Wikipedia, tulisane pira.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ca88bac27e46c226bfe050360fae741a35ecf55aaa455a561ef36b0a2db011e",
      "text": "Sesuk aku mesthi wis mari.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "3311ba7062639aa4370c59d815a92e4283281ead00bc8e2c62fc427bcc63228b",
      "text": "Simbah tuku puthu kanggo putune.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "356b1c76888e6a5038070c1251def9bb2688a182998af7f74452458b47a83327",
      "text": "Eh, ing chat kowe nulis \"loro\", nanging tulisan baku \"lara\"!",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b9128af7de74fa9f85c36c6cb5928c24915e520f8bce3728c6759f609bcb221",
      "text": "Mbak! Aku wis krungu. Kowe wis mari?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c72ae5e44f76228c230396d39a17e5a295049d4efef00fa2eacb4b7bc40bdc1",
      "text": "Merga munine piro. Ing chat, aku nulis kaya munine.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "40a47887a7b5c3e0c45f438cc229970d4f66b75b84af68c1ad9c238440cee0c6",
      "text": "Monggo pinarak, Mas!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "42c3447235d4600c98cc7263616597f814faacdfd7c4dcb664d6dda3416d26a9",
      "text": "Aja suwe ya, hawane adhem banget.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4343b718950134a0302f0efc53b8a3f9d3be85aa359423591d7405cda96d93b0",
      "text": "Lara? Aku krungu \"loro\".",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bed412051caf66690d6b2d94da63f3d78bd1d6e49884f4cf17b285a660dd8e4",
      "text": "Ora. Puthu loro, angka loro. Iku bener!",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ca553b993232df0ba5e371d78b280a557e919db4ee47705c05fd19e42d6b220",
      "text": "wedhi",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "51cb2aabbb566510c732310cef75ece94a06ce4b1164d732af8b32744516779b",
      "text": "Oh, ngerti. Muga-muga adhimu cepet mari, ya.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "59733a79cbb752a485c509641f6f18e4b09e3bbcab72f998dcb19328b0c69cc9",
      "text": "Adhem, karo dh. Hawane adhem, nanging puthune anget!",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b95d1b9f794752543d327530354c753db9b9f2ed9b3882184002e9d7469def3",
      "text": "Dina iki aku tuku puthu loro neng Simpang Lima.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dc9c04c602c00723a28cd67e81053be50cc7d5ce1bf9981e20172181dcb1ff2",
      "text": "adhem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "61594b23dbf1e82b1e9f955aa12782c56a308d27290b8f4bc59af2b8cb1d5d90",
      "text": "Mangga pinarak, Mas!",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "6371fa58a324328fef0ea8647fc2d4852d48d1906db1ed48fbd276f9ed47ffa0",
      "text": "Ayo! Jam pira?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "646336a9502aa0f5d37de1eba05033e0ead2ca16b31de01913b7d3040b91326c",
      "text": "Bu, puthu setunggal pinten?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "680aeeaa54f01369037051a8973648b9554b7ff678b9fda65ebcde58e46ce9dd",
      "text": "Sesuk aku arep teko maneh karo Mbak Ayu.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "68959f33a4cb6a69cea1ed3ae245969ecdeff26275a920b994839f0a2dc4534c",
      "text": "Adhem, karo dh. Hawane adhem!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a65b47cdc6c4788a07773ffb231d7afcb79791417e90f16675b6cfa98f77351",
      "text": "Mohamed, sesuk dolan menyang Simpang Lima, ya?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c2ad7a002f497b3cc1bec845f1bddbaa5c2409b06daecdc5ffb8cacda10058f",
      "text": "Sesuk aku arep teka maneh karo Mbak Ayu.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ef1b24b6b4c233a91bbc06a95a762e4564ecc6cacff4308d9d8d6e916117f88",
      "text": "Suwun. Sesuk aku mesthi wis mari.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f977ee696d127aba49bb96fab2d564f8d9d1e440748070a7ae8fce5ddc8026f",
      "text": "Pinter! Kowe mesthi menang.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "710e0e44d126525dd39313fd16d2a67ca8f9787c8361b71eadc3e95c1c983fc2",
      "text": "Wah, Mase pinter, munine \"puthu\" wis bener!",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "72922cd6bf09266039c40790e4f1d000e0342957d125d6dc055e18ef8a5b5a5c",
      "text": "Kula tumbas kalih, Bu.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "742fc47f8dc33153db1dbae6dea16621d129e459ced7655aee01441fe34c0d27",
      "text": "Tulisan baku saka \"nggih\"?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "75f77e790abb687d7da8af80110473889e2c6f5aa07285ba98798229a0690457",
      "text": "Aja lali, segane wis mateng.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "79e047c947ec7df7464eb5a9707362a34bde5b7ba7be8ac1a831c2e0b85fc8a1",
      "text": "Aku teka saiki, Mbak!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "82fe9447f0b5d9a007507fd617288257d58ee518c05276d8e97f10fcb67d0e8c",
      "text": "Hawane adhem banget.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "87ae8a5c2c5322201abf24e5bd0848e1e84cd94b49a337b3983677bad912e123",
      "text": "Ayo dolanan Minimal Pairs! Rungokna, wedhi.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8aadbab46db83ddb7f183fd2e5a179730140384c3155c09905b559ac264438c4",
      "text": "hawa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8be9ce1dff5d4786a4680056d3293da2e48991975fe5d5c659e2620ec3c669e8",
      "text": "Mengko awake dhewe mangan sega lan kenthang goreng.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f553118638d8c8b8c99fa886c9f5f728b561384a1cb802438767dff2c972f85",
      "text": "muni",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f626e20fd1322e1ce7f6736b22d3c68e092341deed8b15fecec559c25fce475",
      "text": "lara",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "902d17c1da46b94043fc2d750633703e5b0022cc12f1a5068469164b8ee83626",
      "text": "\"Dino\" iku kliru. Tulisan baku \"dina\".",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "904f527dac78d8762765d77ca9ca64b79c7afbadb65bda005fdc3d128dd7ff3f",
      "text": "Ing kene ana puthu lan kenthang goreng.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "91577af5517da4583ea38420d5b93bad763b3f6bcb63b9a04e8c240cdf9889aa",
      "text": "mateng",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "92bfa245ccaa474795d12b1a346d882af599845632f47ca54249b096deedf8a2",
      "text": "Aku dhewe wis mangan.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "95289e949202a7968ed4e9c54c5642b6213ad075f6984586d287b319dcf0cee6",
      "text": "Tulisan iki kliru, sing baku pira.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "966034f6efce00db217514d223b20d68c7f82ed595b47cc5ba7aca647d83a7fa",
      "text": "Hawane adem, aku mung arep turu wae.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "990b574abe5e96cad1e3de9e9558d64e25b94541951ff31e540c52b357a9939c",
      "text": "Wolung ewu, Mas.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d9faf9ca4dd0053a8d35b2e2bd54ae898b022a5979b2bd2e1323a8bf85b2d0d",
      "text": "Lan \"loro\"? Iku ya kliru?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a78f4e3a3adcb16a96a0a3e308ffae6b423ad72e44f177093942cd2ac108058e",
      "text": "Sing endi, Mbak?",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9212c6729c37a765afd7e7fdefccf61f960a61b14e8f394802e9dccb85d7ae9",
      "text": "Tulisan \"monggo\" ora kliru ing chat, nanging sing baku \"mangga\".",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a96398f7dc7bd38fbd9a7023fe0a9f2c5a1d5812cadf1864817690cd3e64462f",
      "text": "Bocah-bocah dolanan wedhi.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9b4dcf34a4d68dc026e9bda059242f8e983eac9e7d7396a19bb5ab8e2c8e2ff",
      "text": "Nanging tulisan sing bener \"pira\", ta?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9bd2e81bffb391715403d4e50de1e23554ec23634751b55700c70d0385c40af",
      "text": "Tulisan baku saka \"monggo\"?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad39d8a4829da4336e0e960cc51a2e3feb3505bbdfbe65db55609153e7761294",
      "text": "Kowe arep apa?",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "adc4941af3da9177d562168ac5463c9016da26f8fbe368d79fb567c51caeae4a",
      "text": "Jam papat sore. Aja lali, ya!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "adc76d105e679ad260e0fb9a61344410384da2b7311c9d6dd518c54e0918f462",
      "text": "Wedi lan wedhi iku bedha.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "af61c323f27f51355c685ab53ae95bdaa25fd4830d47629c90a33cdb38dde7eb",
      "text": "Mbak, kok kowe nulis \"piro\", ora \"pira\"?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1bf5580bd7967046f7f394b225dafa4f12862236539bdb9d5d2bd9bb783357d",
      "text": "Aku seneng kenthang goreng.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4b66935f630f887ae7b84a6e9c66993ffbb27dc2d71d723be0539e87c3ce547",
      "text": "Puthu karo th, kenthang karo th. Aku wis ngerti!",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8b77d11733261fcadba8bdf500bad0ed9ec1d3eefd16e1be4db51d5a262c0b2",
      "text": "Pira regane? Segane wis mateng.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba7550b66733207be36b8cc6b2336446247339508d6580639bb6805b6bbd74e6",
      "text": "Tulisane pira, munine piro.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd181001ecb6c1c66db4d026360c1ba3b8375d96c891cca8c713d3918f3e38fa",
      "text": "Mangan neng kene apa dibungkus?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdd27371aa6eafef89f8c77af4bab6d7225b7f9df8d81f70111119ca8badde9d",
      "text": "Mbak, aku maca chatmu. Kowe lara apa?",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4284d472bebf16fa9b774f6c88c92e139224ad08b53b4414c1e528aba138c13",
      "text": "SEGO KUCING 3RB · TELO GORENG 2RB",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7a20955704375636fbc2df6f87f0dd99ee8d4dfee2c5b329dfc9fd94c202e8e",
      "text": "Aja lali, aku dhewe sing teka.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c849f2bf4e3a7b45ec8e7dbb7519af330d5378ccc3b94be085ec4d873be80978",
      "text": "Aku ora wedi.",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3281248c36a6c3916aa1cf84c1b55bfcbbbabdec0da92080f491a5193813c1",
      "text": "bedha",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccac577ecb74e4465d5e8772643f91cb04222978c5ff51979d9e16b0fff746c6",
      "text": "Aku arep mangan sega.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "cceeceeba4afa1b461dd858081f336014a56be75439daf0fa739d572860f974e",
      "text": "puthu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfb2392f8e0e36a6240bf3a02f2d8356909632c9431b28b05a818acc60d464d6",
      "text": "Adhiku lara, ora bisa teka.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d012c2e51a31bbad79d7a88cc70baa936c2d78167092305a7fd97f2750c8eb15",
      "text": "Anakku loro.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2515118334fe8bcc0c00995adf80436aadc31ce98be4327400808f90534a40d",
      "text": "Wis. Ayo tuku puthu, isih anget.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4723c1f3a1089e0f9401cffe24cc647267e40a7831bcaf1533264273db66a8f",
      "text": "Pinter! Saiki ngomong \"adhem\".",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d762d864272d3e97b49c043e2e672d898683cec4205dec7a0770dd5128882ac8",
      "text": "Mung masuk angin. Hawane adhem banget.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d824170e7cafb5dfd7a99571cd2c5f13bbe7bbc06031a49564f13b5a3671347b",
      "text": "mesthi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "da45dad4766db2b6cd2eb26460a2acc114997a63ee74409c9e856259080c5184",
      "text": "tulisan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc8572e01220ccba7b2013e3a0a1f1db4212b3ef3be568e3fa4bb9307d41ab6e",
      "text": "Tulisan \"sego\" kliru, sing baku \"sega\".",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd1f80e9fcba8363e3735227c242ac3fe02adfd8aa7d7318faf881154b336667",
      "text": "Sewu, Mas.",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0a87b3432e0627df95fbd4910250915d389e18910205f398a54b7132f8e10ed",
      "text": "Hawane adhem, nanging aku mesthi teka.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f7daafbb6ea7df18118774313540b2993db33e930f2c74f72ba6a07f66fd72",
      "text": "TELO GORENG",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1938c8e8bf3a97c279f1ed9fc6acc04d90bbef4511f1822153d950d7a32c271",
      "text": "Mangan neng kene opo dibungkus?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2040533c687ace77eb1fd2f3442a1f33627bc4bbc55647833a366dfa46125d1",
      "text": "sega kucing",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2e07d6234364403113c0191b93c25ee206d67a1f079f9cbaf46f5c9be10fac2",
      "text": "Puthune enak tenan, nanging hawane adem.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e449845bf9a6a7a9ccc0b91e1464988c856cd595c92d0f726b65cfe5fca77c80",
      "text": "mari",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e57e1e00a6c87dd3c78edba2b15d6018fcf3b829cb3f1503b1854d409d215d2a",
      "text": "tela",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e816400700e96c6f355bff5cbcdc10d26c1fc3adc242e9007c109a02be05ba39",
      "text": "kliru",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f14eeb45c5d935785cad7302907ef3422a16da2924c48259b8b77719e9f62a6d",
      "text": "Muga-muga cepet mari, ya.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f580d5c2da394ad66dbd5255d4fe09da86172b2709f33922a5b849aa97776a1f",
      "text": "kenthang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5d3a4b452d8aaab119db7ab2e240f0997ab105d08636b326d7f6df931dcc465",
      "text": "Simbah masak kenthang goreng.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7930dcec63e742993365074f2bb6da74fe8f2856b55ce9eaff0f6a37ffb2b76",
      "text": "baku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f94f6e4d7d8cb1ad772f6956205b00bf09c481aa51cd2d34d563a3ddd249066a",
      "text": "Mangga pinarak, Pak.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9ceff2bb530e09a39400a22a13330d4d51ce4cf884b6e5980e74cc321434e26",
      "text": "Bener. Saiki, adhem.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "feb906b48001c88d9f504ba2fe7f981b8928dc6c79c909e8989b18eeb99e9177",
      "text": "Puthune enak tenan, nanging hawane adhem.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff5d4e346b3731b5f3c102e411a8990ea4ef754d3955609a13055474d16fff25",
      "text": "Dino iki aku tuku puthu loro neng Simpang Lima.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    }
  ],
