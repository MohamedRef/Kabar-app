      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d70116a8e556c2a64c39555601182add566265290ca08e618cf789fd5f6033bc",
      "text": "sek, aku lagi moco",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "d726dbdf87b3ffbaec57f96636787086c3de0d85d5bafe82f6d736e3096e436c",
      "text": "Lha, \"aku lagi makan\"?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e13d061d03ef8bd2af0d38db2f4d5a18966097235d98d7ea2cbf9d134437a095",
      "text": "Mohamed, kowé wis mangan?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e99ce0eea1f6e46b0b1a7eb91042565a78c854b890698e9446e60c73770c71e1",
