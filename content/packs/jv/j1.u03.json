      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca7d5846a0241bddf64f238fffa4d74da03252c63328bb9c54fbea61d384b705",
      "text": "Aku durung turu.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "cab3957997d89f148c6f839df40fff047a91f275d091b52467d59b98a1eeb276",
      "text": "maca",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cba83389cc4146143fdf5ad228c0f8879a0363e21c5c0354519c07f1613dfd96",
