      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0330fd510e27a6faa7b24423fe82688352097d3a3a0b8c22dcbb3550a7c75bb",
      "text": "rek, ws mangan?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
