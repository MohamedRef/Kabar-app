      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb8aa5d9d41c5d9873814f151f83c2e1a3c83f9ba6b74ff744ee4e865cf5feef",
      "text": "rek, aku gk ngerti opo2",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3e9ec95d8879205cb2d9c9ca3c5024e899fba2c92da5d9aa979db045d280302",
      "text": "Sek, aku lagi mangan.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c895de42ccb6a9212bb22949fe82acc48db9880680f79b410649f0dd91681622",
