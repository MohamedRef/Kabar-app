      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5901d2a156359ea220b54622aa615065edfafcb82fa5645dcaa026f1cf5ee04",
      "text": "Dheweke isih turu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ec73a9e071a6d1afaa7f7c4737018bfa474c382c76c1b8bec50f56378c7784",
