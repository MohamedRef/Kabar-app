  "audio": [
    {
      "key": "02555545e7e395d0e4454706ccd1a103c410a956e208f0bef95c3c29a91a9d4a",
      "text": "Aku arep mangan sate karo Rara.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "05f90a16eec9f7a745eba094e7b76371e2e7d23cee83aa7a394927dcaa66ba79",
      "text": "Kate nang endi, rek?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b35d182f546efd3569869d52afbde681d6d0140093bd571cf637d83dfd871de",
      "text": "Aku lagi maca buku.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d165d60358735a095328f1fdd94e8a32f3443f4b968eeaa191e90512b269e89",
      "text": "Aku lagi nang pasar karo ibuku.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f9ab6d005dec14a8b21765cd44c397068918c3b91a4b3ebfb74f65cd37f2042",
      "text": "Wes tekan, rek?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "107ab5cb8ce01ceaed00d3ffe10935f786f4704748bcb29361fbc8c743405688",
      "text": "ws. aku lagi moco buku",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1362ec2c7bef2c7d5068e28c3bc013b5628a50e677cdd88343df681b88c6f16f",
      "text": "Aku lagi di pasar sama ibuku.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "137d5f06f0a48dbfa9f3a941df69f649cb96836a2abbacb55ed6978b687a178b",
      "text": "ws tekan durung? → Wis tekan durung?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d3fed85f356d5956fb8d98da5cfcee134d4c50472b8cd92b7005d07aee819ff",
      "text": "oke, ati2 rek!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f71719d50066c007fe43c576e399332ab26e712a544e66bb5e3ba3405bcf3da",
      "text": "ws, aku lagi ng Tunjungan",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "20b8f84b85a9e5d2d077244dfe3de5e38484991cae95b020f1e32c719876f479",
      "text": "Wis ngerti. Suwun, Cak!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "22433a91cc64fe0f2ea03be8783b3711792dc4a6c78e503503f292883a9df36f",
      "text": "rapopo. aku arp mangan sate karo Cak Heru",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "287a5aa8f24b0f05fa577a35827342d898c4d650c9ede7207457c490ac31a958",
      "text": "durung! aku arp mangan sate. ayo cak!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "296f38ebb714565d8a5c09f3c07ffe1b12ee7d970a6d9d4cf6f94af4fb6ce2ad",
      "text": "arp turu",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f038ef6a0cfc47a9388aa89ae81d803dea9395a7d77fde5c9bb0fcac65998ff",
      "text": "ati2 ya rek",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "35842d6c42c1f97fe32c86b8b3da75d8e20df632c55351ed4ed4d97be0335c31",
      "text": "Ayo mangan, rek! Aku arep mangan sate.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e77eb610996feba70848ba50c1ba740f4b74a079d18dd8d9e62209e2bce352b",
      "text": "ora apa-apa",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a377267c1ac9cd57ba3a3673c0f23b3f3c6ac9f298b80d883ae5f85435dd73",
      "text": "sing",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c835a2baad895d80be8b541839838c08ab67a5fc15d3d39ed24b2a7e52cd41f",
      "text": "ayo! sek, aku arp ng Tunjungan",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5003ecf51e2485db761f9f0c8800d5e2758cd1603b3d7d1eb3701139c3e56e52",
      "text": "Durung, aku isih nang sepur.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "505f4b726e0a1f384bc7f9ed2ad140fa627ed7842449c5eedd73f498e255dccb",
      "text": "opo",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "56af16b4bc9a00e28905839d5ec401bbf6b62ba0a57d776a0103c46ac93792d1",
      "text": "ng prabowo? → Nang Prabowo?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e0b381a36b1bb0ed90ae0b24055d5672d6ef4d90c5e880d287b7f5c1d72eff6",
      "text": "Kopi apa teh?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "655ab40e5217a62535edbd3ed7b0a62c77f4c083ea4c36404e124bdb3cbe12ea",
      "text": "Aku lagi makan, kok.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "674bb2f9fb3239673ed1e2bf7258d3222bceff5b1d90c313f0da0284eb4d3eb3",
      "text": "Aku isih nang Tunjungan.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "67712f585693d154726da325725483a44cf0c862f437f257f4d635d7bd8f39d4",
      "text": "diculké",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "68828a07135d7fd71e64f80c78fcf0149e0c0185459496627d4ed4ff08f656d9",
      "text": "gk",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "6957d4034d9f7705452a901b128340b3b5ba23f3ab74a0bdb5b3d45961d51bf4",
      "text": "Aku durung mangan.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c3b63ecb24651bdfd98ba80466a43f6648d7dd1b29ce9fba6256d8d1172c48",
      "text": "arep",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a63f749d790efe332db4fb34b2ffdc7427bb664306610508b88ad387491ff5f",
      "text": "Kowé wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "71d6e41dfdd343a81e1dbdeb8a8f784d23d79847f4a4d36ab8344dd794383ed0",
      "text": "Kowé wis mangan? — Durung.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "77308e1b9cfb4353028d23e009103a8276800a32c22cb5cfa1fcb704c0ab2178",
      "text": "Ayo! Mbak Rara wis mangan?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "776a11148826a8e0ffbe64ee4b8911da0d0b60758016c4c404225602bf6f6080",
      "text": "Wes mangan, rek?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "777c61cf169b5dda199955ad294737f3a83aafe38a7c010b04ab6df70f2ecc7c",
      "text": "isih",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c6200950c9fb4088b8c0032a8e44a1f32d1c42c2b36d6d69a17cd0891b77f83",
      "text": "rapopo → ora apa-apa",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7fad459783be49f31390784715722d36b1d3820403959d305564e415747f63",
      "text": "Sing abang regane pira?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "81956ed20089d33ee6be45eea3ebfa672b99901a76fec45d8db0000a8cc0555a",
      "text": "Basa Indonesia. Basa Jawa \"aku lagi mangan\".",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "81ccae646b181a75bea1d0257bad905ebf1d05c9d001aadf074092678b87abb6",
      "text": "Durung, Mbak. Aku lagi maca buku.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8247c714a2b5b41bf52b7745bce484223ac0819ea0d88b43d0f32940a549acec",
      "text": "durung, aku isih ng sepur. sek ya",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "82acd776e66c5c0f947854c646c48d15b88a63b838035b9f69c3e127849572e7",
      "text": "Aku lagi di rumah sama adikku.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "86105f6a2d2012b9611aaf1f805d84320d3a9551bc31d68fd5efe359296f6d20",
      "text": "ana",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c9cda1ddbe35c9c233adb947244fc0e9f9044d63dcd8da357c5c64a16007952",
      "text": "suwun Ning!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d3120ba9f496ffd48216790d6fbafe06772186c782635b235f2cba1a9d5312a",
      "text": "Ora apa-apa.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da23b952b238fdd4ce1a5db3fbfd2e39ae5267e5716fef6254e548fb78e1eeb",
      "text": "karo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "901e2d5dfce12c26dd2b945d6d4a36aac74c46b3bc04bb40301296ade558979e",
      "text": "Basa Jawa! Nang = di.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "907793d4da57ab1065fafcea3468c71c8e35edac446bb2cefdebe779ad9a4245",
