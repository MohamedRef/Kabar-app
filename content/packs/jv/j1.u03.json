      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "91ad19cb65f6adf00e257236098549d9e1ae49c36950f817320672bf43a0e93a",
      "text": "Padha-padha, rek!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9428a92bf129b8992f11b896b20f99e2a84da8f65a0cc404db27c7345b1d9409",
