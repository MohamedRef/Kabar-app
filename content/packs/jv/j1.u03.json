      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "98a5e2d969ddc7d6e61247be5a5cd13d158b7c8924da0e202c2930eb39451c9f",
      "text": "sek",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a08388fb44540473b7c70a32fcf9660a4a9a839e32d8458088af7f321db5910",
      "text": "abang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a09a280e8b93efbeaa4a3878a9135219e6094e4aca38ba199f763438ada76516",
      "text": "gak",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3725b12dbc38585fa9409d1dea094cec26013d73a7e77e431a6a8af3d763f90",
      "text": "Kowé wis tekan?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a546beeeb541d5f2cd20cd249dd49bb8b07dc4caa8fda7531d41b48cb7259e6d",
