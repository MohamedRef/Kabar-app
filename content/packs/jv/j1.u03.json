      "sha256": "09f917d2054766fd7cf4fd24b017b0c1a4619bc3226dc2cdd7ab975735859c36"
    },
    {
      "id": "j1.u03.l04",
      "sha256": "d2b1bf3e83d54a6466bc252048533b0cc0fd27276e91d3fb99f0ed9c117257f4"
    },
    {
      "id": "j1.u03.l05",
      "sha256": "fabc14ded005be10c0278b4dbe977a315ab36613b03f7950354cf353c74b27e5"
    },
    {
      "id": "j1.u03.l06",
      "sha256": "811350667cd73c623983561e81bd1812b80e9d19ca5b2085e6577710fef9898a"
    },
    {
      "id": "j1.u03.l07",
      "sha256": "f50044572f7d6a3ef7e1bb2e981b6d44ae687a991792f672d934d7f0534f7dd1"
    }
  ],
  "audio": [
    {
      "key": "01358beb991ced9ef8eb9c19bcf7b15fa6f4951a853ca7edc85f145473b99080",
      "text": "Basa Jawa! Neng = di.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "01bfaef02173df7dd128a5c222d7874dfaf108e6b0ffaa61a61d780970549320",
      "text": "Ayo neng warung, aku ngopi sisan.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0554487be92a8c9522486d9a13822ab2b4d7c3a82fe7834d7f3db12d08ee470d",
      "text": "ra",
      "voice": "jv_siti",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b35d182f546efd3569869d52afbde681d6d0140093bd571cf637d83dfd871de",
      "text": "Aku lagi maca buku.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c0bb242224eea23778250ab6a809815e33205db801eb5b1ae00219f42b9c515",
      "text": "ws tekan Alkid! lagi mangan sate karo kanca2",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "107ab5cb8ce01ceaed00d3ffe10935f786f4704748bcb29361fbc8c743405688",
      "text": "ws. aku lagi moco buku",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1145f5c781712a24dd105dc125033a951d98346504004eb375cf0bfc40eccc8f",
      "text": "ati2 ya cah",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1362ec2c7bef2c7d5068e28c3bc013b5628a50e677cdd88343df681b88c6f16f",
      "text": "Aku lagi di pasar sama ibuku.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "137d5f06f0a48dbfa9f3a941df69f649cb96836a2abbacb55ed6978b687a178b",
      "text": "ws tekan durung? → Wis tekan durung?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "16ada07297dbdc8701ef9b15c71d3512a8f1f361dc1ade566fd2e0657f936ad3",
      "text": "tok",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba844f2bc8eb5e9c0771fe52f713bc314ce1aca9e31ed7cd2f42bd14ab0e02e",
      "text": "Sik, aku lagi kesusu.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d4278fceb0870b66a755f08e71a1219d0ba71992c0f798b7b60f336cbc1ac19",
      "text": "Aku isih neng Alkid.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2717f7686a2352d5371023ff271ceac621c475ec6c632fa604ffc82b816d6857",
      "text": "Aku lagi neng pasar karo ibuku.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "27a1cec217f48804e68c573f7113802ee93d388539abd4465bfd6a53c636ad6f",
      "text": "Mohamed, kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "27c4353ed7e2ec0ca65d192f739f2b0eb8f3902d169dcbb7dd2730eaba6a6677",
      "text": "sik",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "296f38ebb714565d8a5c09f3c07ffe1b12ee7d970a6d9d4cf6f94af4fb6ce2ad",
      "text": "arp turu",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "36ae48cf8a219455abe83a8e1658c100d88998755089e55759bb13a58c08c7b3",
      "text": "golek",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "370bfa1334ba4efac78d9d343bd2f165db9fa6c1b9283110f9e1245f3037b015",
      "text": "Mas, \"aku lagi neng pasar\" basa Jawa apa Indonesia?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a78b93a8ce568604b46ee002894f59c0d57d40473e6d835d7ee6c580bec333c",
      "text": "durung! aku arp mangan sate. ayo mas!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e0e2eb10eb62f0b4c083c4ed85403d99052e2186703a0109f7d1f30d4b28094",
      "text": "malah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e77eb610996feba70848ba50c1ba740f4b74a079d18dd8d9e62209e2bce352b",
      "text": "ora apa-apa",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eed2e9d5c28bb8bafcc6b09d0fff0bb3d73e9e0e0b6d1e7f1cf6ef9d7f23846",
      "text": "Ora apa-apa. Ayo mangan sik, cah!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e97d8eb127e38b4689a636985f1947e825135ed98e5c205677f0fc85d17354",
      "text": "Aku durung entuk wangsulan.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "42f54496a57d149919c0d3ae97d4176722b3266c414454b6a28e26097dc29b5f",
      "text": "Mas Heru! Aku wis tekan.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4314afb714a09a59213ca2f9db1144ba9f9bcf9cf3bdc814772e681d535546ec",
      "text": "Sik, aku kesusu, durung mbales.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d8d37b1692fc8fbaf2fdfcd1da30b69397c7e78e1afd0056258f4c3a98ebfa",
      "text": "sik, aku lagi moco",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4437f7768f517119de667d011421d0e8f160d5c4f3b739d46fa59eb0ff52664b",
      "text": "Ora, jebul sepi saiki. Pancen enak, cah!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "48311632404db6c3b7e9a928b5a6e3423b3bc612d54895f412c0e7dafbca573b",
      "text": "jare",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a377267c1ac9cd57ba3a3673c0f23b3f3c6ac9f298b80d883ae5f85435dd73",
      "text": "sing",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e42622efc996ff5e694edb3e5fcc2d059b9190d378fe2b0e495b8da851c41f6",
      "text": "nyeluk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5076289d0d91365711cfb636a3785698da523f8970e3d2b6bf5e4e6650c71b0a",
      "text": "durung turu, isih moco buku",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "52df9f4402520e7b231688088ff4f5ce5f4213e4d78bfe1598cc4eb6aa3fc8dc",
      "text": "Durung turu, isih maca buku.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "564e1b7decfbf2aab7cff591ced6d7256988653fe71397d878b33b63986f673c",
      "text": "Durung. Aku njaluk tulung, ya?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "568ecc5fd3cd5253263b003b71837283a0cf08c52752926e8c58e40013f7d0a2",
      "text": "entuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d32a005f75f0025b228fca736d32481e6bd448a62eb9cb5baf3eda091ab491c",
      "text": "Ayo mangan, cah! Aku arep mangan sate.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e0b381a36b1bb0ed90ae0b24055d5672d6ef4d90c5e880d287b7f5c1d72eff6",
      "text": "Kopi apa teh?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "602cf576bfc2ce040d31aa415d40f2a84cbc13e4966ab05c3aa4dd2601d87489",
      "text": "Sik tak lapor pusat",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "62a8cc15bb922c7c96811da059505420fb7d3eb420cdeee01e278e6a15d8e79a",
      "text": "Cah, jare Mas Yudha kowe durung mangan?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "654d2e6468e0159f91b12ec7712559cd48b87f8f6432dbcf6466a3635c6b65be",
      "text": "wis / wes",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6888be8785ae99c469a31fb40b37c969811c6315b13dc7bd17485eba56604836",
      "text": "diculke",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c3b63ecb24651bdfd98ba80466a43f6648d7dd1b29ce9fba6256d8d1172c48",
      "text": "arep",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a9e37ed51c9eedf674e888c90b17c2501cf7f4000762e07f762f43a7ccefbec",
      "text": "Kopine pancen enak, cah.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "726832e401f85a1d9642c8b8a4e65ff8c5a0c11ddb268dc89bb99805da337dc0",
      "text": "Wes mangan, cah?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "732f313254bee2f32c2d6ae6369c317cf6acf6836d421199ccf43477bca2ac1c",
      "text": "Aku ora luwe, malah ngelak.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7522eaf3b15b8bc02f51fee004128d4c27f66ac8d344f9df4d426c44dcb2b7fa",
      "text": "Ayo mangan sate, cah! Kowe wis mangan?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "77308e1b9cfb4353028d23e009103a8276800a32c22cb5cfa1fcb704c0ab2178",
      "text": "Ayo! Mbak Rara wis mangan?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "777c61cf169b5dda199955ad294737f3a83aafe38a7c010b04ab6df70f2ecc7c",
      "text": "isih",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b2d115dec5d44dec0b88b25748ede1dd5dbcc384203a91494ee7f6744fac638",
      "text": "ws, aku lagi ng Alkid",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c6200950c9fb4088b8c0032a8e44a1f32d1c42c2b36d6d69a17cd0891b77f83",
      "text": "rapopo → ora apa-apa",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7fad459783be49f31390784715722d36b1d3820403959d305564e415747f63",
      "text": "Sing abang regane pira?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f5df92bd91aa3c4df484b47c97ebf9700126610077b82d45d0bc1ee462ed7ed",
      "text": "Warunge rame? Soale aku kesusu.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "81956ed20089d33ee6be45eea3ebfa672b99901a76fec45d8db0000a8cc0555a",
      "text": "Basa Indonesia. Basa Jawa \"aku lagi mangan\".",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "81b43dac5866db0d882023169279cc79d7f798bad8bffa29c4f4f8e4729b3f4f",
      "text": "aku mau ke Alkid. udah makan belum?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "81ccae646b181a75bea1d0257bad905ebf1d05c9d001aadf074092678b87abb6",
      "text": "Durung, Mbak. Aku lagi maca buku.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "82b8132f0af9770e9f3a7636f43e319671604610e12dd9cb5b346d1254cca9ef",
      "text": "njaluk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8412e8b9cd2b27e4be853d560c2119c8b991268a0d8d64a9afb2ba865eaa5892",
      "text": "Sik, aku kesusu. Ngabari aku, ya!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8562fc1573799bca9544496b0258c2fcafc2412d84bf108e41ce0222d46d0661",
      "text": "Aku wis ngabari Mas Dimas.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "86105f6a2d2012b9611aaf1f805d84320d3a9551bc31d68fd5efe359296f6d20",
      "text": "ana",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d3120ba9f496ffd48216790d6fbafe06772186c782635b235f2cba1a9d5312a",
      "text": "Ora apa-apa.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da23b952b238fdd4ce1a5db3fbfd2e39ae5267e5716fef6254e548fb78e1eeb",
      "text": "karo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "907793d4da57ab1065fafcea3468c71c8e35edac446bb2cefdebe779ad9a4245",
      "text": "aku gk ngerti opo2",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a031fa4b98fdc0accb923e457ee4fcf8bf4d910cc224ba595bd540197c1c09",
      "text": "Rara wis tekan omah.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9428a92bf129b8992f11b896b20f99e2a84da8f65a0cc404db27c7345b1d9409",
      "text": "turu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "95e2bc132778f75ad0afec929eeeb1f00a69afb20aad2790cf6c2f919bc82f0c",
      "text": "wes mangan durung?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ce583a3a288050f389fe828552d823cd1d80d3c3e600b2ae6c84114629bb01",
      "text": "ndelok / ndeleng",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a08388fb44540473b7c70a32fcf9660a4a9a839e32d8458088af7f321db5910",
      "text": "abang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a298052774cee9b33e685c95f8b5ce41fb8d61bd43b6087429422272001b4468",
      "text": "Arep neng endi, cah?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "a30774c49a457be0f2b64fca4811f3d8d56b9b430dd0deac35eee5bc6206a9ed",
      "text": "Sakjane aku ngerti, soale aku sinau.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a46e3aa5a027ea3611ae6b3949830f2cd01f5cc3d4f85e71c21b50315f0c0798",
      "text": "ayo! sik, aku arp ng Alkid",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a546beeeb541d5f2cd20cd249dd49bb8b07dc4caa8fda7531d41b48cb7259e6d",
      "text": "piro? → pira?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5901d2a156359ea220b54622aa615065edfafcb82fa5645dcaa026f1cf5ee04",
      "text": "Dheweke isih turu.",
