      "id": "j1.u03.l05",
      "sha256": "34798ee73c0f005f5acefa7835536229ee2d531c6039133d04413007e8b64218"
    },
    {
      "id": "j1.u03.l06",
      "sha256": "44c40d94f12854d8f348a7820ccc3f9f098bd5f4b14a9f698e300470a963d3c7"
    },
    {
      "id": "j1.u03.l07",
      "sha256": "8fc8fb67cc44318415795a4c885a3c03e04ee670b6e52bc87c749272af1e9bae"
    }
  ],
  "audio": [
    {
      "key": "05f90a16eec9f7a745eba094e7b76371e2e7d23cee83aa7a394927dcaa66ba79",
      "text": "Kate nang endi, rek?",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "067541d0030986997bf160366eafbf7cbcd5e77ae9d1abd68894c61d07a2b941",
      "text": "Ayo nang warung, aku ngopi sisan.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b35d182f546efd3569869d52afbde681d6d0140093bd571cf637d83dfd871de",
      "text": "Aku lagi maca buku.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d165d60358735a095328f1fdd94e8a32f3443f4b968eeaa191e90512b269e89",
      "text": "Aku lagi nang pasar karo ibuku.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "107ab5cb8ce01ceaed00d3ffe10935f786f4704748bcb29361fbc8c743405688",
      "text": "ws. aku lagi moco buku",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1157ea4e178605f60073473c4dc95f04dc630d7a828288d9c0161d0f41cb290c",
      "text": "Sek, aku kesusu, durung mbales.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1362ec2c7bef2c7d5068e28c3bc013b5628a50e677cdd88343df681b88c6f16f",
      "text": "Aku lagi di pasar sama ibuku.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "137d5f06f0a48dbfa9f3a941df69f649cb96836a2abbacb55ed6978b687a178b",
      "text": "ws tekan durung? → Wis tekan durung?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "16ada07297dbdc8701ef9b15c71d3512a8f1f361dc1ade566fd2e0657f936ad3",
      "text": "tok",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "18360cff1d100c6a097d36afc7be2e892ccd12f2ae01a690e8e6f45a27e62ce1",
      "text": "Sek, aku lagi kesusu.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d3fed85f356d5956fb8d98da5cfcee134d4c50472b8cd92b7005d07aee819ff",
      "text": "oke, ati2 rek!",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f71719d50066c007fe43c576e399332ab26e712a544e66bb5e3ba3405bcf3da",
      "text": "ws, aku lagi ng Tunjungan",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "20b8f84b85a9e5d2d077244dfe3de5e38484991cae95b020f1e32c719876f479",
      "text": "Wis ngerti. Suwun, Cak!",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "22433a91cc64fe0f2ea03be8783b3711792dc4a6c78e503503f292883a9df36f",
      "text": "rapopo. aku arp mangan sate karo Cak Heru",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "27a1cec217f48804e68c573f7113802ee93d388539abd4465bfd6a53c636ad6f",
      "text": "Mohamed, kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "287a5aa8f24b0f05fa577a35827342d898c4d650c9ede7207457c490ac31a958",
      "text": "durung! aku arp mangan sate. ayo cak!",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "296f38ebb714565d8a5c09f3c07ffe1b12ee7d970a6d9d4cf6f94af4fb6ce2ad",
      "text": "arp turu",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f038ef6a0cfc47a9388aa89ae81d803dea9395a7d77fde5c9bb0fcac65998ff",
      "text": "ati2 ya rek",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "35842d6c42c1f97fe32c86b8b3da75d8e20df632c55351ed4ed4d97be0335c31",
      "text": "Ayo mangan, rek! Aku arep mangan sate.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "36ae48cf8a219455abe83a8e1658c100d88998755089e55759bb13a58c08c7b3",
      "text": "golek",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a005926a98021089eab6e5cf40e4625bb54aeaeccb3daf7b0381b5675aa043b",
      "text": "Iya. Sek, tak nyeluk Mas Yudha. Engko tak kabari.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d39d6693d9f42e798c2c7d7657f2db85c432198127d2ffd3f3c685f9af862ee",
      "text": "Sek, aku kesusu. Ngabari aku, ya!",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e0e2eb10eb62f0b4c083c4ed85403d99052e2186703a0109f7d1f30d4b28094",
      "text": "malah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e77eb610996feba70848ba50c1ba740f4b74a079d18dd8d9e62209e2bce352b",
      "text": "ora apa-apa",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e97d8eb127e38b4689a636985f1947e825135ed98e5c205677f0fc85d17354",
      "text": "Aku durung entuk wangsulan.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "48311632404db6c3b7e9a928b5a6e3423b3bc612d54895f412c0e7dafbca573b",
      "text": "jare",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a377267c1ac9cd57ba3a3673c0f23b3f3c6ac9f298b80d883ae5f85435dd73",
      "text": "sing",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c835a2baad895d80be8b541839838c08ab67a5fc15d3d39ed24b2a7e52cd41f",
      "text": "ayo! sek, aku arp ng Tunjungan",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e42622efc996ff5e694edb3e5fcc2d059b9190d378fe2b0e495b8da851c41f6",
      "text": "nyeluk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f3015764828d3afcaed2c803e1c5d7ac0063ffb62cb3afc717975465eebd425",
      "text": "Ora, jebul sepi saiki. Pancen enak, rek!",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5076289d0d91365711cfb636a3785698da523f8970e3d2b6bf5e4e6650c71b0a",
      "text": "durung turu, isih moco buku",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "52df9f4402520e7b231688088ff4f5ce5f4213e4d78bfe1598cc4eb6aa3fc8dc",
      "text": "Durung turu, isih maca buku.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "564e1b7decfbf2aab7cff591ced6d7256988653fe71397d878b33b63986f673c",
      "text": "Durung. Aku njaluk tulung, ya?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "568ecc5fd3cd5253263b003b71837283a0cf08c52752926e8c58e40013f7d0a2",
      "text": "entuk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "56af16b4bc9a00e28905839d5ec401bbf6b62ba0a57d776a0103c46ac93792d1",
      "text": "ng prabowo? → Nang Prabowo?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e0b381a36b1bb0ed90ae0b24055d5672d6ef4d90c5e880d287b7f5c1d72eff6",
      "text": "Kopi apa teh?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "61fa5f3839043df63f99871c17430162dd4ae5983f55ff4af2a00ff454a83fa9",
      "text": "Aku ora ngerti.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "654d2e6468e0159f91b12ec7712559cd48b87f8f6432dbcf6466a3635c6b65be",
      "text": "wis / wes",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "674bb2f9fb3239673ed1e2bf7258d3222bceff5b1d90c313f0da0284eb4d3eb3",
      "text": "Aku isih nang Tunjungan.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "6888be8785ae99c469a31fb40b37c969811c6315b13dc7bd17485eba56604836",
      "text": "diculke",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c3b63ecb24651bdfd98ba80466a43f6648d7dd1b29ce9fba6256d8d1172c48",
      "text": "arep",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "732f313254bee2f32c2d6ae6369c317cf6acf6836d421199ccf43477bca2ac1c",
      "text": "Aku ora luwe, malah ngelak.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d6de79fb8f150c8cfc9de77f4f23ff280b9c624fa0f2dcdd381071479cea65",
      "text": "Kowe wis mangan?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "77308e1b9cfb4353028d23e009103a8276800a32c22cb5cfa1fcb704c0ab2178",
      "text": "Ayo! Mbak Rara wis mangan?",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "776a11148826a8e0ffbe64ee4b8911da0d0b60758016c4c404225602bf6f6080",
      "text": "Wes mangan, rek?",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "777c61cf169b5dda199955ad294737f3a83aafe38a7c010b04ab6df70f2ecc7c",
      "text": "isih",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c12c1114820c52923e03b140fb9fd1bd2cccb67caa1e3908fe67247d27d0c39",
      "text": "Ayo mangan sate, rek! Kowe wis mangan?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c6200950c9fb4088b8c0032a8e44a1f32d1c42c2b36d6d69a17cd0891b77f83",
      "text": "rapopo → ora apa-apa",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cc4214df540d296c780257b0aea334cc16782c2ca0ae572d04b2b11c9332ded",
      "text": "Sepurane, Cak, aku kesusu. Aku golek kantor pos.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7fad459783be49f31390784715722d36b1d3820403959d305564e415747f63",
      "text": "Sing abang regane pira?",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f5df92bd91aa3c4df484b47c97ebf9700126610077b82d45d0bc1ee462ed7ed",
      "text": "Warunge rame? Soale aku kesusu.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "81956ed20089d33ee6be45eea3ebfa672b99901a76fec45d8db0000a8cc0555a",
      "text": "Basa Indonesia. Basa Jawa \"aku lagi mangan\".",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "81ccae646b181a75bea1d0257bad905ebf1d05c9d001aadf074092678b87abb6",
      "text": "Durung, Mbak. Aku lagi maca buku.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8247c714a2b5b41bf52b7745bce484223ac0819ea0d88b43d0f32940a549acec",
      "text": "durung, aku isih ng sepur. sek ya",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "82b8132f0af9770e9f3a7636f43e319671604610e12dd9cb5b346d1254cca9ef",
      "text": "njaluk",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8562fc1573799bca9544496b0258c2fcafc2412d84bf108e41ce0222d46d0661",
      "text": "Aku wis ngabari Mas Dimas.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "86105f6a2d2012b9611aaf1f805d84320d3a9551bc31d68fd5efe359296f6d20",
      "text": "ana",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c9cda1ddbe35c9c233adb947244fc0e9f9044d63dcd8da357c5c64a16007952",
      "text": "suwun Ning!",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d3120ba9f496ffd48216790d6fbafe06772186c782635b235f2cba1a9d5312a",
      "text": "Ora apa-apa.",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da23b952b238fdd4ce1a5db3fbfd2e39ae5267e5716fef6254e548fb78e1eeb",
      "text": "karo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "901e2d5dfce12c26dd2b945d6d4a36aac74c46b3bc04bb40301296ade558979e",
      "text": "Basa Jawa! Nang = di.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "907793d4da57ab1065fafcea3468c71c8e35edac446bb2cefdebe779ad9a4245",
      "text": "aku gk ngerti opo2",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a031fa4b98fdc0accb923e457ee4fcf8bf4d910cc224ba595bd540197c1c09",
      "text": "Rara wis tekan omah.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "91ad19cb65f6adf00e257236098549d9e1ae49c36950f817320672bf43a0e93a",
      "text": "Padha-padha, rek!",
      "voice": "jv_dimas",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9428a92bf129b8992f11b896b20f99e2a84da8f65a0cc404db27c7345b1d9409",
      "text": "turu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "945b49377b2e40ad38da18d29e2ef68edc9ccc9b48d8f5b20778abdd648d18ec",
      "text": "Sek, aku wis ngerti. Ora apa-apa.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "95e2bc132778f75ad0afec929eeeb1f00a69afb20aad2790cf6c2f919bc82f0c",
      "text": "wes mangan durung?",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "98a5e2d969ddc7d6e61247be5a5cd13d158b7c8924da0e202c2930eb39451c9f",
      "text": "sek",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ce583a3a288050f389fe828552d823cd1d80d3c3e600b2ae6c84114629bb01",
      "text": "ndelok / ndeleng",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a08388fb44540473b7c70a32fcf9660a4a9a839e32d8458088af7f321db5910",
      "text": "abang",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a09a280e8b93efbeaa4a3878a9135219e6094e4aca38ba199f763438ada76516",
      "text": "gak",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0f31f3818ec297a5e095b392ce235e22a2fd349e763e4d6b7dbb6251703c737",
      "text": "Kopine pancen enak, rek.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a30774c49a457be0f2b64fca4811f3d8d56b9b430dd0deac35eee5bc6206a9ed",
      "text": "Sakjane aku ngerti, soale aku sinau.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a334d5b9d6beaa9fa5721f01fc7dea85f22cf085d8a57f892030a8405ba96ee3",
      "text": "Ora apa-apa. Ayo mangan sek, rek!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a546beeeb541d5f2cd20cd249dd49bb8b07dc4caa8fda7531d41b48cb7259e6d",
      "text": "piro? → pira?",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5901d2a156359ea220b54622aa615065edfafcb82fa5645dcaa026f1cf5ee04",
      "text": "Dheweke isih turu.",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ec73a9e071a6d1afaa7f7c4737018bfa474c382c76c1b8bec50f56378c7784",
      "text": "rek, ws tekan durung?",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9fe0e8257875683eae2406ad7bee114a896d73da2567afecc0db1df9188e975",
      "text": "Rek, kowe wis ndelok chatku? Kok durung mbales?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa8aa33555e49c487e71b026dcfadf4eb18ed81f0172bd2f0a0c27d0626e7a31",
      "text": "Wis entuk? Jare cedhak stasiun.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "aac16b440a5c152394d11dd771b546524ef1d39ad7b6a1610c75090b491d5907",
      "text": "ngerti",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb3f1801b323c2015d899ec10827a27dfafcbc966d639db5689665de43b852f",
      "text": "kesusu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac4bd0152ee48ad695cd8d662b46b619ca26e81d010c788da7eab59a8553dced",
      "text": "nang",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad8353f90607590fde3bf871e2e577c2a7762379e151a6186455b9b71bc95591",
      "text": "ngabari",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b133dc2035be1947ec4ef46a9ce8389490628382eae2dea6a0310efef6a05a2b",
      "text": "Dimas piye?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7994d559e0947efa1324e9ff2d0d432709601ecfc6b7def62e4f151936c90f6",
      "text": "Dimas arep nang Tunjungan. Statuse basa Indonesia, Cak!",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7ebb2c5f191c2b2659ed7c35e8495841c50417de59017dbc5c8926d8a075810",
      "text": "Mbak Rara durung turu, isih maca buku.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7f42367ef8fdc850a6404893fd583e68c3f4ef4d315bbb99f1e0538fcd871c7",
      "text": "Iya, Cak. Sakjane aku luwe banget.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b942bf04e03d862a2311192e67be6d21c24349f119ba78243ce83dafde174414",
      "text": "sek, arp dicul ng pasar",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb7030c554212c15e42cc2eaa0d3140eb305e821b710daf061be3bcc443bf52c",
      "text": "Rek, jare Mas Yudha kowe durung mangan?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb8aa5d9d41c5d9873814f151f83c2e1a3c83f9ba6b74ff744ee4e865cf5feef",
      "text": "rek, aku gk ngerti opo2",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc2172071a4efdcd502c7bb50533df5b667913a53345ebe916fdad74fc94f92e",
      "text": "Kowe wis mangan? — Durung.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc878c6b757304a646204151fadf3462084be565c4ba72296e0964339f45ebfa",
      "text": "Durung, Cak. Mbak Rara durung turu, isih maca buku.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1df26b7e1046e8befc77200166817cba385efcd03dcfc595bb697d837c38546",
      "text": "mbales (bales)",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c27f0ee199fb171e38a3ac1d42b428dac2bc6e92bfc3e815d9bcafdcd8a5dcdb",
      "text": "sakjane",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c512302714e699c1797ab55e6de716f8de4e5c17b9facc95d56ae4868076fbca",
      "text": "Ana sing abang?",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c721456d68998cf3b1c68ffd7aff1fec6c81dbbb1ab978f0c539d3f3bccb752f",
      "text": "Kowe wis ndelok status WA-ku?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c85675f57097cb3deec880a6b09f364efe947e9e8c2749da2b0ba8df6491053f",
      "text": "Jebul dheweke dokter!",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c895de42ccb6a9212bb22949fe82acc48db9880680f79b410649f0dd91681622",
      "text": "tekan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c93afd9e55269d90718b5dd65e3818cadb86c6935b202f26e719a0ef38a2ccfe",
      "text": "Wis. Aku arep turu. Wis ya!",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "cab3957997d89f148c6f839df40fff047a91f275d091b52467d59b98a1eeb276",
      "text": "maca",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cba83389cc4146143fdf5ad228c0f8879a0363e21c5c0354519c07f1613dfd96",
      "text": "mangan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0330fd510e27a6faa7b24423fe82688352097d3a3a0b8c22dcbb3550a7c75bb",
      "text": "rek, ws mangan?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0b607a62f39f3fb8448f7e55d2adf0a5f5ff1383f2ee3bac54b5bb0224c0d8f",
      "text": "pancen",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1865dda606fe591193d8365277bf37d222cd06919123e6ebad5e2e858920681",
      "text": "durung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d42a73ee7fef9116b1bbf72a7447cad3f273d44f6cd72269e377deae2f16bf60",
      "text": "jebul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d58bfc08da0f4528331f2cdf1c0b32cabe24d0dbfc029f67e6e9dd522d189d48",
      "text": "aku mau ke Tunjungan. udah makan belum?",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6a911ce0ffa2c1f8505d33a4850a50dcb40aca20098ae1f3c9b73c6c14e159e",
      "text": "arp dicul piro",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d70116a8e556c2a64c39555601182add566265290ca08e618cf789fd5f6033bc",
      "text": "sek, aku lagi moco",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "d726dbdf87b3ffbaec57f96636787086c3de0d85d5bafe82f6d736e3096e436c",
      "text": "Lha, \"aku lagi makan\"?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7fb6f08d5bb6c69ef0079cd1ba9b28164dcb94880668d7dd83d14620a5e7198",
      "text": "Cak Heru! Aku wis tekan.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d93f5761c5505a79e7f99bb510f39569e5ffe01ae741c1d5a4b95aa36d23f0fd",
      "text": "Aku luwe, soale durung mangan.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e973e6d7c831b89b000f41d94e648474d6bbe63dafc3905d3f45d82b30724853",
      "text": "Kowe wis mangan? — Durung, aku lagi maca.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e99ce0eea1f6e46b0b1a7eb91042565a78c854b890698e9446e60c73770c71e1",
      "text": "lagi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea0eeba8a42bb53ea448fa30ca50203eadbb83bd94f129c34b635aa15531acd2",
      "text": "Wis tekan? — Durung, isih nang sepur.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "eac933087ac002a56c8984aab7de9a0f8eb4e24bee2e21dc1b51a09027b4510d",
      "text": "soale",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec70d16f130795861edf418069956c08b6100396ab5f5bf2a90539d8f038f63d",
      "text": "Sek tak lapor pusat",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed89e9172dcc951d651003bbe0851f13e045baae5d18d2643e0871fd95425c5c",
      "text": "Aku arep turu.",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee801e6ccae79c0cf7a85978900ccec9d5c8ab742271ebcddea16843043d9296",
      "text": "sisan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f08705f821eab73484daedb62d7cd762e86b423916204d49a05da1fe5d0d1dc8",
      "text": "ws tekan Tunjungan! lagi mangan sate karo kanca2",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f92d08259f108604030abe20d466c7cfdf4657ccfeebc84f29b28747fa7641b1",
      "text": "Cak, \"aku lagi nang pasar\" basa Jawa apa Indonesia?",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbde9c84d385ba7b76bcca5df85d24a4f96333051747b90ebba2fc5033231e64",
      "text": "Aku lagi makan nasi.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefe053ee91bb4af8419d6252c01c3998053160c8e6b6845aafc606ec1604ae1",
      "text": "Ana kopi?",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    }
