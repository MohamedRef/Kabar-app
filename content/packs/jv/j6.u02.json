    },
    {
      "id": "j6.u02.l07",
      "sha256": "e4846908dd56692e88872c21e62ab93257b83d64a9dfa1a080b6e046b647efe9"
    },
    {
      "id": "j6.u02.l08",
      "sha256": "304a4b492c8411f2ee1d71e924d8160fdef72bbcc9b1a724c2c71dadaf5b004d"
    },
    {
      "id": "j6.u02.l09",
      "sha256": "09714e1137773c0eebed70c7b2a285e26ebd3d53937898652bd36b677bad258b"
    },
    {
      "id": "j6.u02.l10",
      "sha256": "67250cc73d78a7e82ca6ed01d9af27429f7f52cb7ef05d1db9fd8882e6bcafa2"
    }
  ],
  "audio": [
    {
      "key": "02dd3a4dc39f0a92209a35b029e9828289c61fcc753f33346e452e7bf008a6d3",
      "text": "Sate sapi nggih wonten, Mas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "03cc9b998bdc1b6c3898ea56320d3189268c8e8b37a24ab7e905f9f183318c0f",
      "text": "ꦉꦒ (rêga)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "07677137b403d546d4083dcc0319c970c0c41e5fea2fb4f6a229983690e301e5",
      "text": "sandhangan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "08ca9c40cf14d0a69595c5876a54994d0b9f708563e3b759f18bca2f83c2d25e",
      "text": "ꦱꦶꦠꦶꦭꦸꦔꦔꦗꦶꦱꦺꦴꦫꦺ (Siti lunga ngaji sore.)",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e9e0c3fe20efb237a2964c01ab92316d9939815e4c10ce6b971f585b399bea",
      "text": "siji",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a35c33c860c0db44737e4f6785a95495e3d3cf53852873d274c55f9116a219e",
      "text": "Bener kabeh! Saiki iki?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "10158fbe81b9270200f7e6de35a58602e38228a0119df86261ada22518e77de9",
      "text": "ꦔꦗꦶꦱꦺꦴꦫꦺ (ngaji sore)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1235afce4d1bffbbc170d5903fcdcc50b0d6fdbd8ff98d5e59c5c29d4288e26b",
      "text": "rega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "19ed8ba2df7666aae5ad0d212b627f5edabc571edb06e0bde740207034d65e83",
      "text": "Ka, ki, ku, ke, ke, ko.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a17a7bf963678b18e5f8ecde0d23578a67d7dccc54e30a59f82fc81d651f132",
      "text": "Bener. Gurune Bu Dewi.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2146a3668e0fe586f664c2500a3d610f33aec89a3547ef1bdf2862c9326bde5e",
      "text": "Selasa, Rebo lan Setu. Kabeh sore.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "24d0f9f2f2bcb585a10ff8f47e8742c5ba48e2c948ae76d948db183238e0e9a9",
      "text": "ꦱꦺꦴꦫꦺꦏꦺꦤꦺ (sore kene)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2855e81c05b33481a9837940efe23153706d0cf958dbeb0f52520f3cea4842b6",
      "text": "Aku isa maca siji. Nga, ji... ngaji!",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b0a63c90c888e7adee2a6bc0c3071684c5a0af25eb6eafb3f7e29ee431b410b",
      "text": "ꦲꦏꦸꦔꦗꦶ (aku ngaji)",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2db6ba7dada5d7c67fb7726391e78ab9c72403c33a53dcccff58f111e5395833",
      "text": "Apik. Ayo mangan sega!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2edaafa26cbac85f33b5ab81136d8d3b8a7238c1a52c444fb68fdb725596df66",
      "text": "Isa! Si, ti, lu, nga... Siti lunga ngaji sore.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3329ec2e52125acfb2ad523b932a810451a936058aae61c9081032f9541d0f72",
      "text": "teka",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "344e35606278149eaadae55c1b50ba5da4ca8238d785152f47833153cddebc63",
      "text": "pepet",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "37a38657b78db4034abace1cb3abe17a5f0edda3425ee90543ac0e29dc112c47",
      "text": "Ana siji sing aku ngerti, ngaji. Liyane durung.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "37b2fffbaf25c8b85cdaa189066ccc518bec3e4821b10fbae5cfbb61f89a5950",
      "text": "suku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "39c8240cc330267015ec773deb73923d32e866cc242f6383615007c6c9bfa405",
      "text": "ꦮꦺꦴꦭꦸ · ꦱꦔ (wolu · sanga)",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ffdad5572eadbf3591e3108786f36b282351339fae927d1949ad3c24dccba82",
      "text": "Aku ngaji ing masjid.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "46b5d16881252e5464622a7d39917b388273b5e074003ac19283283a1f4391c7",
      "text": "pa cerek",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a30272e0ca76631d8bf12f21cc3a832a4b4629e4c97727137fb7e1a1b47991",
      "text": "Sega telu! Ayo mangan, Mas.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cca4e70e07c74a6ce1aa99d347d37b8f1662646329c7f3899356e65489127fa",
      "text": "ꦲꦶꦏꦶ (iki)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ff79799e1d6370c6ae92d8dc26f01b31c09f31a2b1a3bd2704914931f5054a7",
      "text": "Dudu ra karo pepet?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "500974721d332d2f0db4e231b3f0fb38a31292ea1146e77b7061080b7659787a",
      "text": "sega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "509f3d7e5e9e369ce4b5c9743246e220bef367392f7818f60a184f6756b052f8",
      "text": "ꦱꦶꦗꦶ · ꦭꦺꦴꦫꦺꦴ · ꦠꦼꦭꦸ (siji · loro · telu)",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "53bc7d1041f49f9ae14e79254a2ef92dcfa8387879046ded4d718cd7d76c5442",
      "text": "ꦱꦶꦠꦶꦒꦮꦧꦸꦏꦸ (Siti gawa buku.)",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "54297c2428911a9a770b9df263536395b0cdff38a9f73095a06a55ec20d47b87",
      "text": "Piye, Med? Kowe ngerti critane?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a24c291b81ec3c893ef39fa042b2d1adf3588c3a3ea00f557909d634680758",
      "text": "ꦒꦸꦫꦸꦧꦸꦢꦺꦮꦶ (guru: Bu Dewi)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "595f806d07b58d3b5c7022a90a19f07d4a8527233050ee66fec7b48895406414",
      "text": "Soto setunggal lan kopi kalih, Bu.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "598a0e3e4c0cbaee49d8046b09ce2b5a59c1791b8c2966c0033245d33fe2caec",
      "text": "ꦱꦺꦴꦠꦺꦴ · ꦱꦠꦺꦱꦥꦶ (soto · sate sapi)",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dde0f05ac2f27e3fbcbd960c3c77f72c83176b88c8c793481d7bb1c9879779f",
      "text": "iki",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ee8c00c033affc73f296804f8daf651230659f87683499679b133ea75e4aa78",
      "text": "Med, kowe wis ngaji?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f1fddfec4c21863cc8a7e679586603b2dfd4218cfd5f59ac0a75c774d795283",
      "text": "Oke. Ayo!",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "602a5b001aa4b172861ca00546dc12048919665ab1b2b9bbf2c655dcb8d8038a",
      "text": "Pitu.",
      "voice": "jv_dimas",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6085a770a2cb9169cd4562e6ac6cdddce8fd95320c67df95ff1750ab246b9c05",
      "text": "ꦏꦺꦤꦺ (kéné)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "62940016697a576a5ccf4ee092990b30b6af8364324d044e2a67dc784195bd5a",
      "text": "wulu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "652e782453b1ac8d2cb43d66b0c6c60c7f4145fe0c59f51f83b527e3768f8bf4",
      "text": "Ngaji sore, Selasa, Rebo lan Setu.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "67eb737f6de1b0536ddde4f74b55c118878ec137158ab846f8ad36fbb82cca94",
      "text": "ꦱꦼꦒ · ꦠꦲꦸ (sega · tahu)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "68780d674c96bf0da4707b00274870f23ad1b356d1f4fb3423e7c8bb74e9fbba",
      "text": "Bener! Lan kene nganggo taling.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6933ee7c453c2e1291ec4cf38b409e833e960b0f68d9b8ba45d015f1316db124",
      "text": "ꦱꦼꦭꦱ · ꦉꦧꦺꦴ · ꦱꦼꦠꦸ (Selasa · Rebo · Setu)",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dedd380a710c7b6b8991c29f44bcd55220a7b5029ed9c8a3a53fb5106b9467e",
      "text": "Bener. Aja lali tuku sega, ya.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f9fb2e44d33dbec844e1c124b6dc3647b3364917da9ceb66b8d2fb7a0562aa1",
      "text": "pitu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fa224adccbccb0f51d21c4c718363cbe4cd350d2cadc21f2fa5f84b04e0f0da",
      "text": "Aku lunga ngaji.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "71fed89f138a9de8770ef70e1d3a3b222f827acfdf86396482277ee248d08932",
      "text": "Aku arep melu ngaji Setu sore!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "72c27683ea7a8e3b65277492999d6ab9a4d39c838df60853c60c9e92635793b5",
      "text": "ngaji",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7806dba2f051eb9141b7667344a7acdd2b6c123932c7c2219983f7465bd58625",
      "text": "lemu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bf377f71f09ea814a8a70c5bd2d514e823504b3288e4aecc0934bad2afa6297",
      "text": "ꦧꦸꦏꦸꦤꦺꦒꦼꦝꦺ (Bukune gedhe.)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "80307d190513bfc19513bdab212b0ba56cbbe2c74b8dbc0153bc3c4875dc1b60",
      "text": "Tenan? Ana tembung apa?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "83668c2308a954610c55baa86bfc1dfd98d3a57ad8846eb6bce11e024669e60d",
      "text": "ꦭꦺꦴꦫꦺꦴ (loro)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "892eea14eec6dbafe5c8b65af5e4728e2a518f6ad3b8b88956d457529e8ab273",
      "text": "Siji, loro, telu, lima.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8943ebbd864d41f7113355ccc9f926d8a7aa96a9d924f5738a07216527583708",
      "text": "taling tarung",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8afcc989e77a1f82259e326a27fd3a9e3644890734c2cbb050a0c21118727a51",
      "text": "Soto siji, kopi loro, Bu.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b946054d1aec113e8ad2f72df7980af3fe31710e7cc488ebec0385d6c98689b",
      "text": "ꦱꦠꦺ (saté)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dac6094bb21bf1d76f74b8338b5fbfe6ac670787e2d5b997bb229f539742028",
      "text": "ꦏꦺꦴꦮꦺ (kowe)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "9046aae4010ebf0d817ea35c7d2d3fa21f6651b4615e4894e8bb946ce54e0f0a",
      "text": "ꦏꦺꦴꦮꦺꦠꦸꦏꦸꦱꦼꦒꦪ (Kowe tuku sega, ya?)",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "919239851ec1882b2e78e89f57989789b32f5224e0d2c42ddddc5d4844005f1a",
      "text": "Med, aku nyebut angka, kowe nuduhake tulisane.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "92610d01d60463d32e48fbd2582ad84e1f4430de9f552ffa7b7b542041f49c25",
      "text": "ꦱꦼꦒ (sêga)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "93f75b9c5cc270e36bcd7efa36bbec359e143e7c726ff518048bfc4d276389a0",
      "text": "ꦊꦩꦸ (lêmu)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "96d08fc731bad486fc311960caba0524a82cdc6c9b289ea61ff92ac1d37d4e9d",
      "text": "Iya, sega loro. Siji kanggo kowe!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "97328b847416b6e683eabb75cde5ee37cab927b1c759dccb4627afa3514fcc20",
      "text": "ꦏꦺꦴꦥꦶ · ꦱꦸꦱꦸ · ꦗꦩꦸ (kopi · susu · jamu)",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9734919d085990ccb41ddaa05b2e6984fb52ac4b5ee7fd1f42c7b15c0e8232ac",
      "text": "ꦧꦸꦏꦸ (buku)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cedb138bdfea1d1492adafda39665a4553730197016109b1acd44bf32fe9c18",
      "text": "Ora apa-apa. Sesuk mesthi isa!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d24d1a8843a7d18ab6b59d155b7d0c552f62ab2cb395b80c7660cd5b7f01cc1",
      "text": "Siji, loro, telu.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4d51be5adaf7b194462c66a35aae62d888a483199b45d3cb01a79435abaad46",
      "text": "ꦭꦶꦩ · ꦥꦶꦠꦸ (lima · pitu)",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6219633ae396478ac9e9ce956c335798ee24b6ed76e2c956e15c0235d1a1423",
      "text": "Iya. Ing papan kae ana aksara Jawa.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a94137612067041a9476986a833b740083bfd72245c6293cbde09801ee0c942f",
      "text": "ꦠꦼꦏꦱꦺꦴꦫꦺ (Teka sore.)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "abf40a5cc7b1f947a980776b9c7a434d337e1eeb123a30cb14b13400844fd6c0",
      "text": "Iya. Coba wacanen dinane.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "affabe157fb094558e9d72431fcf6102ad523a67d145fbd887d097f09d859756",
      "text": "Bener. Kowe isa maca tulisane uga?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08799007868e80b6ed4e0b8c199e30de845f0d02e636e99ba78c80c5b7d1bfb",
      "text": "Med, teka kene! Iki warung sega.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0a4e4684b6e8036e3c462b1606ba33af41116c11e03f4838675fb67cfd6a178",
      "text": "Wis, Mas. Lan aku maca papan ing masjid.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b363d48ec28c369afb6dca9ec5a15eb2e0083d7bf7413e49a072b6eb49bc5be8",
      "text": "Pinter! Saiki wolu.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "b519cc988348c8ac7e8f92446afbf699a557f849214d373c01aad9b7e5bbc6ce",
      "text": "Ing papan ana tulisan sega. Iki pepet, ta?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b58eae73a32afc9ac7534c26c73f3ae4be61e77d54a407cfc667aa93e163f364",
      "text": "ꦲꦏꦸꦭꦸꦔꦔꦗꦶ (Aku lunga ngaji.)",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b677026d0217577571ee68b1ff097342b744f6f58305aa5f6f0488ff7ed41be8",
      "text": "nga lelet",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6d594098031638779994ea1963a389fc0ed83f68a60c931864376d3138acce6",
      "text": "ꦒꦼꦝꦺ (gêdhé)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba995ed06f4224ca4ef9d805f31d773661e2f4cad54607f019c7c807b6d963d8",
      "text": "Iya, rega. Aksara re iku pa cerek.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcbf5c68f77027cb1b0bb99e5f4300b35bfd3afea223c9570e35ba47ffcc7b2e",
      "text": "ꦱꦶꦗꦶ (siji)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce16f1a5c31ff6eec0a7150988afc8f707ecc045fa0bef153f22ca2c05fad2f",
      "text": "Mas, papan iki jadwal ngaji, ta?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0bbd10b185c551727a6db9cb2db2c9fd368aa4b2cebb0c26946260514a47ced",
      "text": "Med, ayo dolanan. Aku nulis, kowe maca.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7d96a6b936a4cf315cc066ccb5a80260ebc7f734e0efd5f539f70ee541a905a",
      "text": "Mas, iki diwaca rega?",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca6e403b474836500086150d20a1ace565be2c1ee2549d654b4731f7b85df509",
      "text": "Badhe dhahar menapa, Mas?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb52a8efb89b1abe516d7f3bc54d8038e1ee77e36fc5836d36cf5f16fc735a3e",
      "text": "Sega telu, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd20c55891fdf7d72d0e2da045d77af1563be9d7115debe27c43ff28ddc50b46",
      "text": "Ngerti. Siti lunga ngaji, gawa buku gedhe.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "cee53994027717eb372870bdd5b6acf99c5df6a5e5368222b7414cc641ed098f",
      "text": "taling",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef550b5f0827d9f6180cf71e1835b851435e9b44474acdd08650db893557f98",
      "text": "Med, wis maca layangku ing lawang?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf09aac2879377cd919baf00e505f1256c42a23357ff08bdacaa0b5435e7708a",
      "text": "Siti gawa buku.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f6f0ab4f96022d5fffa8627b3469e29eb3149193e9766a9fb8bf8bd92ff851",
      "text": "telu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8072b13f71717f6649f9bcb521864a40a83bbf802267fbf82ba99babbb65502",
      "text": "Aku lunga ngaji. Teka sore.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "da33205c4d99f5c57d1fd29dbc62a23ae8c90d58cd7cfd44d4d824a98298d7e3",
      "text": "kowe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "da768d961d78a12dbb806ab18e8576d8d2edbf9f64401f56e78da2c1574e1027",
      "text": "Oke. Iki sore, lan iki kowe.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "de88a2aabcd4cda2599ed1a30615bb9afa626c781c496e7101c7ea30d2b5d59c",
      "text": "Apik banget, Mas. Bocah-bocah lagi ngaji.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e99a64e861f4267285dd8f8ecd09792d9855d2e4bacd7d5bdcbf1b69ec52c3e1",
      "text": "Mboten, Bu, matur nuwun. Soto kemawon.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaa101cf66f89d5b93624295e9112640cd13d091adb63ac606ea9da0b3852609",
      "text": "Siti lunga ngaji sore.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebe1ed3b82574f5ef2f1a19db4635264b19a42f4eebe78d0c97dfb6b6acebc10",
      "text": "Soto siji, kopi loro.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee62e5df3fcf825324b012fea9b07b531afa7261a9a184af68d50465901f8081",
      "text": "Pa nganggo wulu, ta nganggo suku. Iki!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef48153881958d9666f60f7889221180103365d505239b54d81b7bd02afc589c",
      "text": "Dudu. Re lan le duwe aksara dhewe.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f24f20eff7522ff6bf3d04ae57c6ffc47351d459ec0613b6a1957c30ff4afb40",
      "text": "Wis, Mas. Kowe lunga ngaji, teka sore.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6e35d65e4ca18332e9d8f5e1e70f614aa90b9d7e24edd24c4920d9f229c51d4",
      "text": "Med, iki Masjid Gedhe Mataram.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa6e7c10548d4681769c0d6b633d1ab388c94a9a2a032af265d248c6e010953e",
      "text": "wolu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe2c30988a15fad83a60b5c31aaef6e323eeafd9cce20d6d302f6ea3e60a1ef3",
      "text": "Rebo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    }
  ],
