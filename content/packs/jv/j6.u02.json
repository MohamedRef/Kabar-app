    },
    {
      "id": "j6.u02.l15",
      "sha256": "168ec19f281d645b395d03a2d659093886375a52cad4573e5776e124327aaef5"
    }
  ],
  "audio": [
    {
      "key": "011f81feb3d5c85b548adcae47a118b341f1e9d783a38d9ff0a4bf493b8f8891",
      "text": "tobat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "02dd3a4dc39f0a92209a35b029e9828289c61fcc753f33346e452e7bf008a6d3",
      "text": "Sate sapi nggih wonten, Mas.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "03cc9b998bdc1b6c3898ea56320d3189268c8e8b37a24ab7e905f9f183318c0f",
      "text": "ꦉꦒ (rêga)",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "060aee1b8832458a8040c8ae4c57162a4823a6e51ba5949af65bc1470dee5fd8",
      "text": "Khutbah dina iki bab apa?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "07677137b403d546d4083dcc0319c970c0c41e5fea2fb4f6a229983690e301e5",
      "text": "sandhangan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e9e0c3fe20efb237a2964c01ab92316d9939815e4c10ce6b971f585b399bea",
      "text": "siji",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a35c33c860c0db44737e4f6785a95495e3d3cf53852873d274c55f9116a219e",
      "text": "Bener kabeh! Saiki iki?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca8a795f1f207ba553073b43381b522bcfbf1c2bc44f1b62799fd9bf84fc918",
      "text": "ustadz",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d904ec51bea1988759407dce3898a729127f113bb407ecc4c0528661a6b068c",
      "text": "kawruh",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e7d52302f4107525f48d59af5166853c96224d3f292963e7d7223aacf21a925",
      "text": "Ana siji sing aku ngerti, ngaji. Sisane durung.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fe6e1560856f10584604e023150dccf9e4c129394dd9c9e8c869fc1be7c5694",
      "text": "Sawise salat, bocah-bocah ngaji karo ustadz, ta?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "10158fbe81b9270200f7e6de35a58602e38228a0119df86261ada22518e77de9",
      "text": "ꦔꦗꦶꦱꦺꦴꦫꦺ (ngaji sore)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "109c5c2414ba8feadc56a700430d1dd878f8edc751ef5dd116466ab717748891",
      "text": "jaburan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "10d8c17ed657c1409a25292d9f067ae278cde0537ab094a0c09d573d6a8c29ea",
      "text": "Kula badhe nyerat wangsulan.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1235afce4d1bffbbc170d5903fcdcc50b0d6fdbd8ff98d5e59c5c29d4288e26b",
      "text": "rega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "12a4b43ae57d7cfa08636b21ba9f8331d757953d36f298d0324ff608f07452dd",
      "text": "mangsi",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "131da5261ce4adf67d06c290d9657a01093e2593123097db8b02cf29e2545022",
      "text": "Bab tobat lan kurmat marang wong tuwa.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "13a50faed90a4b396fd21d3f525c0aaddebfa903ea5fc53bd790281501bece0e",
      "text": "Pujangga nulis kidung ing lontar.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "15751916abac68946fc298aa08c0c611f0313827a6af6aa61335290f7016290a",
      "text": "Sasi pasa, sawise tarawih ana jaburan ing masjid.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "172ab8b34d64c10dd33fdbff3a6fbf935fa13d188f55a1aa8554cc7c72dfcb8f",
      "text": "Mas, iki rega?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "19ed8ba2df7666aae5ad0d212b627f5edabc571edb06e0bde740207034d65e83",
      "text": "Ka, ki, ku, ke, ke, ko.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a1305cb8e0866b4dee892241c7f5f7107c34accbda6c1e39da17924b70b191e",
      "text": "Matur nuwun. Kula kepengin pinanggih Pak Harjo malih.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a17a7bf963678b18e5f8ecde0d23578a67d7dccc54e30a59f82fc81d651f132",
      "text": "Bener. Gurune Bu Dewi.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b282ec6ed015631df1c263a5b65946d0dc9d13d9f6fb9f0cfb9140b3deac7ac",
      "text": "Jamaahe wis akeh. Khutbahe arep diwiwiti.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f256dc4549f3c5c6b462241909100d2e3c3bbfa3cc434b475c8d3fa34fd3382",
      "text": "Serat menika saking sinten?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fec0088790890f2a271d1941dd5e47d9c49d90f7a032d10b514603c92f23d7f",
      "text": "Pitutur saka simbah kudu dikurmati.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "2146a3668e0fe586f664c2500a3d610f33aec89a3547ef1bdf2862c9326bde5e",
      "text": "Selasa, Rebo lan Setu. Kabeh sore.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "24be244997d5a95ce121fdda45b9d04fa5df851643f3c0121aee09b17762af87",
      "text": "kintun",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "24d0f9f2f2bcb585a10ff8f47e8742c5ba48e2c948ae76d948db183238e0e9a9",
      "text": "ꦱꦺꦴꦫꦺꦏꦺꦤꦺ (sore kene)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "24da568cd7efd01e49a2c15cc42aee77be0672212a5b05ce553b089675bc2df0",
      "text": "Menawi wonten wekdal, sowan mawon.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "27a3c016df30e73665dafbbd44345f3276662896c7ee3e0a9038f2c53af87ea4",
      "text": "Sega telu! Ayo mangan wae, Mas.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2979eb4d1d40717c40ed10132e79d5ed76ce5d73c43a8c42f30d0a17ffad7934",
      "text": "Opor ayam, ya ta! Aja lali ngijoli dhuwit anyar kanggo bocah-bocah.",
      "voice": "jv_dimas",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "298e025a91591bc37ba1f14286786e79b138ec8b7f050204a4fc9ed074fbff75",
      "text": "Menawi wonten wekdal, kula badhe pinanggih panjenengan.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ab32ab3efc7924411882504f650f437153e36983ad18210aefa7c712f4bdf7f",
      "text": "Pitutur sing apik banget.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b0a63c90c888e7adee2a6bc0c3071684c5a0af25eb6eafb3f7e29ee431b410b",
      "text": "ꦲꦏꦸꦔꦗꦶ (aku ngaji)",
      "voice": "jv_siti",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2db6ba7dada5d7c67fb7726391e78ab9c72403c33a53dcccff58f111e5395833",
      "text": "Apik. Ayo mangan sega!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "344e35606278149eaadae55c1b50ba5da4ca8238d785152f47833153cddebc63",
      "text": "pepet",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "346afe3f2a23896d55101563ae8030ada9d2a936d5da4e8ac7482604d44066fe",
      "text": "Serat lawas iki ditulis nganggo mangsi ireng.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "354dda7270eb731bfcfe19ec2c5874e3c1a146bb0057b9cd96e4a0d1025738ff",
      "text": "Mohamed, bakda tarawih mengko ana jaburan, lho. Arep ora?",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "361080eed5c219900422a03fa077bf445a4104264bce4a08753fe5d8eaa88cc0",
      "text": "Inggih, nanging kula dereng lancar nyerat krama.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "361686cb845a0a440487f9bbca58d419879e6d516794f16ed8c820dd7fac9419",
      "text": "Jamaah sujud bebarengan.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "377c592a9f8d606d51e1e8b5895308afae12ff780e29341e3e478fcb8604e45e",
      "text": "seratan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "37b2fffbaf25c8b85cdaa189066ccc518bec3e4821b10fbae5cfbb61f89a5950",
      "text": "suku",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "39c8240cc330267015ec773deb73923d32e866cc242f6383615007c6c9bfa405",
      "text": "ꦮꦺꦴꦭꦸ · ꦱꦔ (wolu · sanga)",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fa9eb066bd39a59afd71d6e16dd365020bcb2fc6351cda229aff18c60a71421",
      "text": "Lare-lare ngaos wonten langgar saben sonten.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ffdad5572eadbf3591e3108786f36b282351339fae927d1949ad3c24dccba82",
      "text": "Aku ngaji ing masjid.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "41dffa0ada768faf0bb8a33756efbf38ae5d377bca5983b7bf4e8ff490bf6748",
      "text": "Kabeh jamaah sujud bebarengan.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "46b5d16881252e5464622a7d39917b388273b5e074003ac19283283a1f4391c7",
      "text": "pa cerek",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "474ab76597929db2cbdbb0b7362a9795785898d23f611b42749b282c29dafbaa",
      "text": "Kula sampun maos pesen panjenengan.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4931bf89070d5a5698f334df5b440d4ef028998c733bb18babec80ac487d596c",
      "text": "Jamaah ngrungokake khutbah kanthi meneng.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c17c63abd058d10e31e1d548318170dc72eb7d93897ff254bd28887d2f07fc2",
      "text": "ngaos",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cca4e70e07c74a6ce1aa99d347d37b8f1662646329c7f3899356e65489127fa",
      "text": "ꦲꦶꦏꦶ (iki)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ff79799e1d6370c6ae92d8dc26f01b31c09f31a2b1a3bd2704914931f5054a7",
      "text": "Dudu ra karo pepet?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "500974721d332d2f0db4e231b3f0fb38a31292ea1146e77b7061080b7659787a",
      "text": "sega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "509f3d7e5e9e369ce4b5c9743246e220bef367392f7818f60a184f6756b052f8",
      "text": "ꦱꦶꦗꦶ · ꦭꦺꦴꦫꦺꦴ · ꦠꦼꦭꦸ (siji · loro · telu)",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "50d46940cc131ab5308336b11e92246494de0ac92b0cb6d45b76514b953ebaae",
      "text": "Biyen wong nulis aksara Jawa ing lontar.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "517adcea04909294850c3e7439c5afb044eb12f2ae4416cb15e16706493ce410",
      "text": "Buku iki menehi ___ babagan aksara Jawa.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5413300a46da1d58cd455c6f4f13244392a5625ed0c6da66c24611f1d22cf633",
      "text": "ꦮꦠꦶꦭꦸꦔꦔꦗꦶꦱꦺꦴꦫꦺ (Wati lunga ngaji sore.)",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "54297c2428911a9a770b9df263536395b0cdff38a9f73095a06a55ec20d47b87",
      "text": "Piye, Med? Kowe ngerti critane?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5467fba4e087125f15509d0cdefc68b0a553138d47814d448d3311d7321af093",
      "text": "Ngerti. Wati lunga ngaji, nggawa buku gedhe.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "54f55f0aedadfa67498c4e959d7b44cb3af50a28a989d3a54afd98155884639b",
      "text": "sumur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a24c291b81ec3c893ef39fa042b2d1adf3588c3a3ea00f557909d634680758",
      "text": "ꦒꦸꦫꦸꦧꦸꦢꦺꦮꦶ (guru: Bu Dewi)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "58448364bd1e264dc831b42ba53d7dde4d2e3d6a6e487c6134fbab4fdb566a4d",
      "text": "Mbahku mutih sadurunge riyaya.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "58845a7091cb848c5b7962632513529d4f410f6fe14e80ba363e0c854a62e99e",
      "text": "Lawuhe apa?",
      "voice": "jv_dimas",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "592b91e8b764a33fbdc05a4fd2f7df86fe25716350472f905741a8647b893e3d",
      "text": "kidung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "595f806d07b58d3b5c7022a90a19f07d4a8527233050ee66fec7b48895406414",
      "text": "Soto setunggal lan kopi kalih, Bu.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "598a0e3e4c0cbaee49d8046b09ce2b5a59c1791b8c2966c0033245d33fe2caec",
      "text": "ꦱꦺꦴꦠꦺꦴ · ꦱꦠꦺꦱꦥꦶ (soto · sate sapi)",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ad2a5235be86795ab45359fb56b856801b8602f28fec6317445cf5e870d40d0",
      "text": "lawuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b8c8747fd39079fef1562d610e5cd18ea6f40b05bd44fc7c228ebaa83faf0bd",
      "text": "langgar",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d32485f656d140255eb4bb519e4c5188e83a45566ddc3afa3b6ce17c8f2d3df",
      "text": "Aksaranipun alit sanget! Menapa ngangge mangsi?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dde0f05ac2f27e3fbcbd960c3c77f72c83176b88c8c793481d7bb1c9879779f",
      "text": "iki",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e403411191fd72d0563193475764cf3eeb1981dd7b98ba5a82fb7c2455220c6",
      "text": "Kula badhe nyerat cathetan. Kawruhipun kathah sanget.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ee8c00c033affc73f296804f8daf651230659f87683499679b133ea75e4aa78",
      "text": "Med, kowe wis ngaji?",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f1fddfec4c21863cc8a7e679586603b2dfd4218cfd5f59ac0a75c774d795283",
      "text": "Oke. Ayo!",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f45127a9f993294c9ff75a2beb228a9adf36f82a158ed5c81af5304aa4bc1f5",
      "text": "bakda",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "602a5b001aa4b172861ca00546dc12048919665ab1b2b9bbf2c655dcb8d8038a",
      "text": "Pitu.",
      "voice": "jv_dimas",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6085a770a2cb9169cd4562e6ac6cdddce8fd95320c67df95ff1750ab246b9c05",
      "text": "ꦏꦺꦤꦺ (kéné)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "608d687c2e3c6bac5563727c2fe57c2bbbb578a100f5fc3c1444cf13dd91d6b7",
      "text": "sujud",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "62940016697a576a5ccf4ee092990b30b6af8364324d044e2a67dc784195bd5a",
      "text": "wulu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "62fc3aec25ef28662efed1968e17a3bffe460de5f2512b23ce6a0f5f39939d04",
      "text": "kenthongan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "64e2ae476ec00dd995ff4f31b2cf8bba077c6d3575648a78be525e6f4e62ff8f",
      "text": "Aku isa maca siji, lho. Nga, ji... ngaji!",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "652e782453b1ac8d2cb43d66b0c6c60c7f4145fe0c59f51f83b527e3768f8bf4",
      "text": "Ngaji sore, Selasa, Rebo lan Setu.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "670a937879419ff8a745d73737f0d0a705f9d7076b255caa0b5d160d460b2896",
      "text": "Ora apa-apa, kok. Sesuk mesthi isa!",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "67eb737f6de1b0536ddde4f74b55c118878ec137158ab846f8ad36fbb82cca94",
      "text": "ꦱꦼꦒ · ꦠꦲꦸ (sega · tahu)",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "68780d674c96bf0da4707b00274870f23ad1b356d1f4fb3423e7c8bb74e9fbba",
      "text": "Bener! Lan kene nganggo taling.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6933ee7c453c2e1291ec4cf38b409e833e960b0f68d9b8ba45d015f1316db124",
      "text": "ꦱꦼꦭꦱ · ꦉꦧꦺꦴ · ꦱꦼꦠꦸ (Selasa · Rebo · Setu)",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dedd380a710c7b6b8991c29f44bcd55220a7b5029ed9c8a3a53fb5106b9467e",
      "text": "Bener. Aja lali tuku sega, ya.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e2dd7925820fc9eb12c31a38056daf5204b27bfd278e1664446c4dd23cd3cfc",
      "text": "ngijoli",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6eb2aea5788dfd6a27a3686637c158fa7d00d2035418cde174c3c917839d3a05",
      "text": "jamaah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f9fb2e44d33dbec844e1c124b6dc3647b3364917da9ceb66b8d2fb7a0562aa1",
      "text": "pitu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fa224adccbccb0f51d21c4c718363cbe4cd350d2cadc21f2fa5f84b04e0f0da",
      "text": "Aku lunga ngaji.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "71fed89f138a9de8770ef70e1d3a3b222f827acfdf86396482277ee248d08932",
      "text": "Aku arep melu ngaji Setu sore!",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "72c27683ea7a8e3b65277492999d6ab9a4d39c838df60853c60c9e92635793b5",
      "text": "ngaji",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7539bf9400a0050f91dd3970a9ecdc23d08adc9aee1e1e240195015139c01ac8",
      "text": "Sae. Panjenengan badhe nyerat wangsulan?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "75c3911211e24ff90b56e40b985dbad8e8129fde371643d5d95cf02175ba2b67",
      "text": "Bocah kudu ___ marang wong tuwa.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "77668b591433c924f95ecdcb309d850ca7c4de5e1c98b227725c57b70b41897b",
      "text": "Dudu, kok. Re lan le duwe aksara dhewe.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7806dba2f051eb9141b7667344a7acdd2b6c123932c7c2219983f7465bd58625",
      "text": "lemu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a598d0d2f5abf1cb07cb1b121df3dfd698a1143c4ac2048574762f607f6731e",
      "text": "Wong-wong nabuh ___ yen ana maling.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a87d603ba0cae6224c0b7ada5b233e30557622c86e2c78e1d716a4fc56fb319",
      "text": "Biasane ana kolak lan gorengan. Pas riyaya, ibu masak kupat.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bf377f71f09ea814a8a70c5bd2d514e823504b3288e4aecc0934bad2afa6297",
      "text": "ꦧꦸꦏꦸꦤꦺꦒꦼꦝꦺ (Bukune gedhe.)",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ce1e4e873adb11edbb110188cad41a4864ca103aa524a2c90e5041956ee66f0",
      "text": "Aku ngapalake surat Al-Fatihah.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "80307d190513bfc19513bdab212b0ba56cbbe2c74b8dbc0153bc3c4875dc1b60",
      "text": "Tenan? Ana tembung apa?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "83668c2308a954610c55baa86bfc1dfd98d3a57ad8846eb6bce11e024669e60d",
      "text": "ꦭꦺꦴꦫꦺꦴ (loro)",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "85cd6718577015623339a68518c62d60b613e33edc8520ae96e28ae7e6c81692",
      "text": "Kupat lan opor iku lawuh riyaya.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "87bddc2035eff526b442949749aee4770ca9a40376bd2d382ba3e13006161420",
      "text": "nderes",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "892eea14eec6dbafe5c8b65af5e4728e2a518f6ad3b8b88956d457529e8ab273",
      "text": "Siji, loro, telu, lima.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8943ebbd864d41f7113355ccc9f926d8a7aa96a9d924f5738a07216527583708",
      "text": "taling tarung",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a4f7d509d28667fdee091eb5a0cf0b0b3bb7f95ea0a9594ccd9981ba42c032c",
      "text": "mutih",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8afcc989e77a1f82259e326a27fd3a9e3644890734c2cbb050a0c21118727a51",
      "text": "Soto siji, kopi loro, Bu.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b946054d1aec113e8ad2f72df7980af3fe31710e7cc488ebec0385d6c98689b",
      "text": "ꦱꦠꦺ (saté)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d997571eadd1d98a03e20d5fd298ce09b7bc49cff4f801cf0f613a332b4d6da",
      "text": "piyambak",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dac6094bb21bf1d76f74b8338b5fbfe6ac670787e2d5b997bb229f539742028",
      "text": "ꦏꦺꦴꦮꦺ (kowe)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "9046aae4010ebf0d817ea35c7d2d3fa21f6651b4615e4894e8bb946ce54e0f0a",
      "text": "ꦏꦺꦴꦮꦺꦠꦸꦏꦸꦱꦼꦒꦪ (Kowe tuku sega, ya?)",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "90ebc7da5ece8410fc2922affd1f8f566cbe01ac43dc9dc0fb09170bb71cf376",
      "text": "mekaten",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "90f1d7297efd429d8c80d8f72ab1eca65cb15ac7afa51a5ff7817b648488054f",
      "text": "Iya, Mas.",
      "voice": "jv_dimas",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "912079fc03e8d0792465148ed42ee8abc4e4ac70baa87a02144e608a85fe592e",
      "text": "Iya, sega loro. Siji kanggo kowe, lho!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "919239851ec1882b2e78e89f57989789b32f5224e0d2c42ddddc5d4844005f1a",
      "text": "Med, aku nyebut angka, kowe nuduhake tulisane.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "922ac9d6ff5a537f651d96958293a65874f5c8cb1db6d505bbaae0a6c7942517",
      "text": "Pak Slamet, kula sampun maos layang saking Pak Harjo.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "92610d01d60463d32e48fbd2582ad84e1f4430de9f552ffa7b7b542041f49c25",
      "text": "ꦱꦼꦒ (sêga)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "93f75b9c5cc270e36bcd7efa36bbec359e143e7c726ff518048bfc4d276389a0",
      "text": "ꦊꦩꦸ (lêmu)",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "966f6a0cf00f80188214aa2da90af479220febe4d98f8c6ec6907b06e61299ff",
      "text": "kopyah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "97328b847416b6e683eabb75cde5ee37cab927b1c759dccb4627afa3514fcc20",
      "text": "ꦏꦺꦴꦥꦶ · ꦱꦸꦱꦸ · ꦗꦩꦸ (kopi · susu · jamu)",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9734919d085990ccb41ddaa05b2e6984fb52ac4b5ee7fd1f42c7b15c0e8232ac",
      "text": "ꦧꦸꦏꦸ (buku)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a430a8091c3782481671dc92788e5f467ad918fced22b98c6badbf1329f3e20",
      "text": "Segane wis ana, ___ apa?",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b9bd5b016d2c0493b616029b0977f4dd70772658d087dea3af00846c69ecd8e",
      "text": "wudhu",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d24d1a8843a7d18ab6b59d155b7d0c552f62ab2cb395b80c7660cd5b7f01cc1",
      "text": "Siji, loro, telu.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0ba1e6654e19d99ff080c870300bbe8a9f431d298cf53540192a5867156cade",
      "text": "Krungu bedhug? Wis wayahe salat.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "a183a3566bfa6b82bd53549450e951ed0b5efaf1cb6431e3579d1eaebe3e70c6",
      "text": "ngapalake",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4d51be5adaf7b194462c66a35aae62d888a483199b45d3cb01a79435abaad46",
      "text": "ꦭꦶꦩ · ꦥꦶꦠꦸ (lima · pitu)",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4e498a3f0405e5ec35e4efaf1a350d148e236ee4865ddcefa5fbb8d968aa354",
      "text": "Ranggawarsita, pujangga ingkang kesohor.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6219633ae396478ac9e9ce956c335798ee24b6ed76e2c956e15c0235d1a1423",
      "text": "Iya. Ing papan kae ana aksara Jawa.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a77596cda46640721673e86a7b0fdf5ed51072786418d41c5004e2f1379ba242",
      "text": "Aku uga perlu nderes maneh, akeh sing wis lali.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a87ab5685c60d91f2184b55b6638bbb069fa199ec5edfd713633e3b7402b744b",
      "text": "Serat iki isine kidung lan kawruh.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a94137612067041a9476986a833b740083bfd72245c6293cbde09801ee0c942f",
      "text": "ꦠꦼꦏꦱꦺꦴꦫꦺ (Teka sore.)",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9c78fcd1932552e2cfb90cc409bc33d49b20f02e7895c6a4bf4ca3a0692ad98",
      "text": "Kula badhe kintun seratan menika piyambak.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab3020ddce1a93118a0fa17571eb8d0d1aea343ffc69f29d446a55baf9374b67",
      "text": "mene",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab573d9974f46d8c454f298e1d1c5e7529a40c8df7affcd87755c85c8de91f94",
      "text": "kurmat",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb37d8561e1c0725cabb0ee1ab2cf7264bc6be422b9f36cad8ed8c016b407b6",
      "text": "Iya, arep! Aku pasa, wetengku luwe tenan.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "abf40a5cc7b1f947a980776b9c7a434d337e1eeb123a30cb14b13400844fd6c0",
      "text": "Iya. Coba wacanen dinane.",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad8e22b9132a6c71df9d32bb20d32766ad8703e7fcb59ec0b1044a260b88b5db",
      "text": "Sadurunge adzan, bedhug ditabuh.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "affabe157fb094558e9d72431fcf6102ad523a67d145fbd887d097f09d859756",
      "text": "Bener. Kowe isa maca tulisane uga?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08799007868e80b6ed4e0b8c199e30de845f0d02e636e99ba78c80c5b7d1bfb",
      "text": "Med, teka kene! Iki warung sega.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0a4e4684b6e8036e3c462b1606ba33af41116c11e03f4838675fb67cfd6a178",
      "text": "Wis, Mas. Lan aku maca papan ing masjid.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b16e0057cc49a9464bfb424b548d56061a2b7ac019fa30651651a1ef98e0eb22",
      "text": "Isa! Wati lunga ngaji sore.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1a868c472db880337e49badbce24cb9dbaca50f11ca3c1452d2d2ee29592dcd",
      "text": "kupat",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b363d48ec28c369afb6dca9ec5a15eb2e0083d7bf7413e49a072b6eb49bc5be8",
      "text": "Pinter! Saiki wolu.",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3852704b2884e77bf44a7429144ad4b6a61728e67bd1f94bfc8018920e41028",
      "text": "Iya. Adhiku lagi ngapalake surat cekak.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b519cc988348c8ac7e8f92446afbf699a557f849214d373c01aad9b7e5bbc6ce",
      "text": "Ing papan ana tulisan sega. Iki pepet, ta?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b58eae73a32afc9ac7534c26c73f3ae4be61e77d54a407cfc667aa93e163f364",
      "text": "ꦲꦏꦸꦭꦸꦔꦔꦗꦶ (Aku lunga ngaji.)",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b677026d0217577571ee68b1ff097342b744f6f58305aa5f6f0488ff7ed41be8",
      "text": "nga lelet",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6d594098031638779994ea1963a389fc0ed83f68a60c931864376d3138acce6",
      "text": "ꦒꦼꦝꦺ (gêdhé)",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7fdbe903e604b6ac9aea0c65982d0f846845d6ccdf0fb7ddb4e85df99f40c4e",
      "text": "Ing desa, wong-wong wudhu ing sumur.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a1af278bcdc6d16326757d14f3be7a5122ee35ce7d1af1bf0f6ae60681baa9",
      "text": "pasa",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba995ed06f4224ca4ef9d805f31d773661e2f4cad54607f019c7c807b6d963d8",
      "text": "Iya, rega. Aksara re iku pa cerek.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc63ce100cfcb8d8a7802443583bdd796fedfb4aff70f08f02faff3313511641",
      "text": "lontar",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc85ca02ede82d6d5b892f92d46c1cd9747784ecd185a4037014aceace57f2aa",
      "text": "Mboten menapa. Nyerat piyambak rumiyin, mangke kula maos.",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcbf5c68f77027cb1b0bb99e5f4300b35bfd3afea223c9570e35ba47ffcc7b2e",
      "text": "ꦱꦶꦗꦶ (siji)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce16f1a5c31ff6eec0a7150988afc8f707ecc045fa0bef153f22ca2c05fad2f",
      "text": "Mas, papan iki jadwal ngaji, ta?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0bbd10b185c551727a6db9cb2db2c9fd368aa4b2cebb0c26946260514a47ced",
      "text": "Med, ayo dolanan. Aku nulis, kowe maca.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40e3815275d9f2ac6fa57cc47468694fd0aa0460fccfe485c44fca089520c3f",
      "text": "khutbah",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9ba16d3498b284ebdab064ae4eddd46606644912c8898866cd0941e5e5af96a",
      "text": "pujangga",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca6e403b474836500086150d20a1ace565be2c1ee2549d654b4731f7b85df509",
      "text": "Badhe dhahar menapa, Mas?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb52a8efb89b1abe516d7f3bc54d8038e1ee77e36fc5836d36cf5f16fc735a3e",
      "text": "Sega telu, Mas.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbb98ce8c8f4e034e9e83e39fe08b633aaa6804d13840ad9ca588aee1e83fdc7",
      "text": "Mohamed, sore iki melu menyang langgar?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccf0ac4a07cae882a6f2eddb2e37eab4b5a26ddf6e52f363e584f7f538f16b4d",
      "text": "Ustadz nabuh bedhug ing langgar.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "cee53994027717eb372870bdd5b6acf99c5df6a5e5368222b7414cc641ed098f",
      "text": "taling",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef550b5f0827d9f6180cf71e1835b851435e9b44474acdd08650db893557f98",
      "text": "Med, wis maca layangku ing lawang?",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d06750e7f7876808eb27afa5c2bc386e8c5e2deb0d1779c2a08eca658def4704",
      "text": "cathetan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2820b9aade1c8a7ccdaf48317c761352b140579fe6e4d884539fe0af3c8e71f",
      "text": "Wati gawa buku.",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2891dcf23b112234de0cd8e197bb1e501c186050b7ed5bba49aa33f32a37e96",
      "text": "Ranggawarsita iku pujangga kesohor saka Surakarta.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3f0d10bfe29d34d777adccdb05ea80fadf39f460c28358d533b8d923cab6068",
      "text": "Mugi kita saged pinanggih malih.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4830051a29855bb6b47ea73278e973dfc6d7cb316737381a98b07348bf047e5",
      "text": "Khutbah Jumat isine pitutur sing apik.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d545b8c10400322410a836169d74c776ca11d3438631bd91005ab8f282bb24ce",
      "text": "riyaya",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d68138e84f573a65309d86ef725c1c7a95ae63c9f60f6c88aeba9e4e1fe2d2d5",
      "text": "Riyaya, ibu masak kupat lan opor.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6a22ca8cfa595316deb7326c866afbe6eb6ff70ce3b478ab2bf738299f4de3d",
      "text": "ꦮꦠꦶꦒꦮꦧꦸꦏꦸ (Wati gawa buku.)",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f6f0ab4f96022d5fffa8627b3469e29eb3149193e9766a9fb8bf8bd92ff851",
      "text": "telu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7dfd804be2fb7f1fcd54c5404aa5390c7a096d0a254e471cfe9575c4af1ee55",
      "text": "Bakda Isya, bocah-bocah padha tadarus.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8072b13f71717f6649f9bcb521864a40a83bbf802267fbf82ba99babbb65502",
      "text": "Aku lunga ngaji. Teka sore.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "da33205c4d99f5c57d1fd29dbc62a23ae8c90d58cd7cfd44d4d824a98298d7e3",
      "text": "kowe",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "da768d961d78a12dbb806ab18e8576d8d2edbf9f64401f56e78da2c1574e1027",
      "text": "Oke. Iki sore, lan iki kowe.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "dad0e29629dbc00af0e646dc8db88ac6cae665a8af8a815da83d0b0e23cbff5f",
      "text": "Kula remen sanget saged ___ kaliyan panjenengan.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "db5680022f671c99624cfec42f8ef326cf976f0cc176d08fbbe18b51b317c548",
      "text": "ꦩꦼꦤꦺ (mêné)",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "de56b72bed055e19dfd82632e471e8b820bc73b810c0adf10523a950c4a38cd6",
      "text": "Mboten, dipunukir.",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "de88a2aabcd4cda2599ed1a30615bb9afa626c781c496e7101c7ea30d2b5d59c",
      "text": "Apik banget, Mas. Bocah-bocah lagi ngaji.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "df3c920be0d54591fb503c24b94c74fc6cbbd9450a4d5fcebf495be90f643609",
      "text": "pitutur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07219550f4d877de15c8950aa1a9a709603b8ec3a2089fcdff3c3a1f4394d8e",
      "text": "Ing serat iki ana kidung lawas.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e171608ec642ee89ff6290ad00d6e7fed80260d8f7586ac8ef05236a4403afa3",
      "text": "Mohamed, ayo menyang masjid. Dina iki Jumat.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e29050196238d2242fabc8e59da339b938736aab431e3cab23330081453558b7",
      "text": "Mas, menika lontar saking jaman rumiyin.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e65fc24e46919979d96eeeb1b9b1c5302557d85946c5c4f2a846811969ad2440",
      "text": "Bakda tarawih, aku mangan jaburan ing masjid.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7bae4f3f6315104c6a0bce09bf400e5341bbd083863cafbb5790410aedcb5fd",
      "text": "Ustadz ngajari bocah-bocah ing langgar.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e99a64e861f4267285dd8f8ecd09792d9855d2e4bacd7d5bdcbf1b69ec52c3e1",
      "text": "Mboten, Bu, matur nuwun. Soto kemawon.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebe1ed3b82574f5ef2f1a19db4635264b19a42f4eebe78d0c97dfb6b6acebc10",
      "text": "Soto siji, kopi loro.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee62e5df3fcf825324b012fea9b07b531afa7261a9a184af68d50465901f8081",
      "text": "Pa nganggo wulu, ta nganggo suku. Iki!",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "eed943dfe2136d0a2b54cf056991928ef59fa14a2eb2c6bfbf3a029539f3da3c",
      "text": "bedhug",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f24afc547a5f75dcfc1ae80dc2850ed5ae5e416da80a42a8989118208eaf0393",
      "text": "pangapunten",
      "voice": "jv_siti",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f24f20eff7522ff6bf3d04ae57c6ffc47351d459ec0613b6a1957c30ff4afb40",
      "text": "Wis, Mas. Kowe lunga ngaji, teka sore.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2b76b81716ed6a86179489dfca4e200348fba58ec9e22a61a421ec0df65bbd3",
      "text": "Wati lunga ngaji sore.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6e35d65e4ca18332e9d8f5e1e70f614aa90b9d7e24edd24c4920d9f229c51d4",
      "text": "Med, iki Masjid Gedhe Mataram.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa1646a2d929e4c5341492e3697a7acc9efaa1f3617b962ed0915e36007402ee",
      "text": "Melu. Aku nggawa kopyah.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa6e7c10548d4681769c0d6b633d1ab388c94a9a2a032af265d248c6e010953e",
      "text": "wolu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc89f3ac46ef0467a9f867b9bd8be55f916744a1a27fa279b1c49db345a3da2d",
      "text": "wacan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fde493a50a1f177ad2f36ddd855ac87551f10a3310ddd302a279c6b6fbe81ca0",
      "text": "Sik, aku wudhu dhisik ing sumur.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe2c30988a15fad83a60b5c31aaef6e323eeafd9cce20d6d302f6ea3e60a1ef3",
      "text": "Rebo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff3b1b18b60dd6c32194aee1904a407c603b27e140d0bd9ca5f8d9ef40016941",
      "text": "Kula ngaos kaliyan Pak Ustadz.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    }
  ],
