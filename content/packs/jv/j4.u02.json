    },
    {
      "id": "j4.u02.l04",
      "sha256": "20cab0c4e00dc35de11f150ccebae5910dbd94d0657252c7c8e059315f371f5e"
    },
    {
      "id": "j4.u02.l05",
      "sha256": "4fdf05634bae0cd67e015bda212efa09cbc7442e89eba4af05edb01e60ccb46b"
    },
    {
      "id": "j4.u02.l06",
      "sha256": "e7ff37cc4bffbbb39f361a0bda58a0ceaf57108909c5651750161e66fe31c416"
    },
    {
      "id": "j4.u02.l07",
      "sha256": "6df1cb05451429e65b5979dec8c4703c791f3244bc187a6077e8b99b626a1705"
    },
    {
      "id": "j4.u02.l08",
      "sha256": "c4b877bb0fbce2c2c8880ad367bd26b4026f4fe3edeb8d4b6daf8e5cff9b99a5"
    },
    {
      "id": "j4.u02.l09",
      "sha256": "ce040b1f98e028fd2ef856b6a4cdc4d50c50685df6021d1245341646b9cdc485"
    },
    {
      "id": "j4.u02.l10",
      "sha256": "72c6a97919f9f8aa2673ab1e762498bcd0da980404a139857e74d7d17b305e98"
    },
    {
      "id": "j4.u02.l11",
      "sha256": "a16ace89451529d14744a1254dd458ead57f4a7c6105c9b22e59c34fa0e18f01"
    },
    {
      "id": "j4.u02.l12",
      "sha256": "094b98f44d5096a6a2c89912346cf74daeebafdf2ef38d2300e117af56ba3d59"
    }
  ],
  "audio": [
    {
      "key": "053b9927f9b0f9b7bfc9ee40eab46273863a379c92c19d60c1207572469a17ea",
      "text": "Pak Slamet, dalemipun wonten pundi?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "054ac5aedc4907e7095ee06f9032428411b03f62e3ab17e94e64c9cc1eb9d3f8",
      "text": "Bakpia menika kagem Ibu, lan jeruk menika kagem Simbah.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b36136ed1f361c475715873af85ec3aeff55c26d7cfeb381b7f437849c7f67e",
      "text": "Umur kula seket gangsal, Mas.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c02f5c082ea703c40c6d337c55876dbda82de532b4d4d8952c506d7f56041f7",
      "text": "sinjang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c4253db64dc15555f41a2c6ac025fce4e1be279bb8cc39dbebf452e477be4b0",
      "text": "Bapak ngagem beskap, Simbah mesem.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c994ce4b8a29859eb8e6c3b2ff55c62fe56de0b52af5892ebecf7543670ce7d",
      "text": "Mbah, mesem, nggih!",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d4fc4f61bc39d05d3ece28326e151f37c7f389033fddd2e36f320330a239f61",
      "text": "Irunge bayi lucu banget.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e1941d2aeef167e8f63cc1651045c20f117921fdc129489ec7d91b1ecc83837",
      "text": "Kula saking Mesir, Pak. Yuswanipun pinten, Pak?",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f0dd52d0696ce8567fe28147337ad0d20d1045f8f2448da9af90a133394a5b8",
      "text": "pakewuh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f5a6c6d2cf2da378e5f27b48b96acd69e01c705d8447ce2a8c17f913f80b17e",
      "text": "Garwanipun wonten dalem, Pak?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "10234b7eb83e8523933e3ab365c1621771b10c014ed94cbbfa5c4ddc842ca526",
      "text": "Untu kula sampun mboten wonten, Nak!",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "10ffac6625d029fb4ceab8077bb92f0aff21bc0581e7dad5f6bbcc99512070ac",
      "text": "Bu, Simbah wonten pundi?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "114a5957185101c636612a08d1432bfc669499dcd2d9d51ac3724599af7d9a5d",
      "text": "Nanging sirah kula taksih rada sakit.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "12d4bafc7cfb04ad7d97893c906e4e31243ec7fdd046f15d23116e60575cf1df",
      "text": "Garwanipun Pak Slamet saweg gerah.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1368831e05b53fa14466efaab83871fb4037684cef8c6cf0d8e435d7a88b32d5",
      "text": "Semah kula taksih gerah, Mas. Astanipun ugi gerah.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "13d2fa28a69173e8aaf0d464484d6e400449ae03685f214c63dbddea5fd23a26",
      "text": "Simbah ___ ing foto.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b552e3afa74172a598309a9905a5fb6b1d3c541ebe30aac531c64a3994db0e",
      "text": "waja",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e2bdcfe2255632069fc9b91debbfe276b71316fa34c6a621694e1edb019ca06",
      "text": "Asmanipun Pak Slamet. Yuswanipun seket gangsal.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e91912c2d722e02bbb4c2045be2e6da8246bb16f82a0bdbee7452514ff3c1dd",
      "text": "Dalemipun Bapak wonten pundi?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "20450c19a016f894262f361fafe442c3a765d707ac4303f4d9347bddd19b5747",
      "text": "mustaka",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "217d457889573578c94cc2c2b1b58ed5909dc080bf7fb50233fbf6bd6990364c",
      "text": "Simbah saweg gerah.",
      "voice": "jv_siti",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2215cb8d313d910516c45646ee871a554162bcdaa4636674a7acf98c6fde111f",
      "text": "kenang-kenangan",
      "voice": "jv_siti",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "25ee2dc0f47d4150aa074530fcbd9f8125ab4636613688a2afdf51647d0942d8",
      "text": "Setunggal wonten Jakarta, kalih wonten Yogya.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "288f27f17ffd2c08fc59a4f28c166abeeb06417858e3c0521dff5c01262d3566",
      "text": "Wah, matur nuwun sanget, Mas.",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "28c809821b369f426dca277fbbbcff81be31d21833bf9c01c3da3968d625bfb4",
      "text": "Dhayoh teka. Ibu ___ dhayoh.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "296f173b46c82a5adacd56b68c709bd09bfaad785d21053f6ba71efb0ec4baad",
      "text": "Mohamed, ki lho bayine Mbak Ratri! Irunge cilik banget.",
      "voice": "jv_dimas",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dc09651cc606d281e1a97985f0ab64b57e0b87f1caba3519518a02741ab5ffd",
      "text": "Menika semah kula, lan menika anak kula tiga.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f94f4b10a4ebf2a25d99f7c7cd23dad802b29b4778abf1048f6cc72e0344f54",
      "text": "Saking Malioboro, Bu. Menika bakpia kagem Ibu.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "305b9a3b8b967daccc19e1a6778ca74aa04a562fa7ee171207a60ea7df099c6a",
      "text": "Menika kagem Ibu.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "30863d463eaffd15e762355675c793d63a51e9c65d22e8d58fce16f77e6566fb",
      "text": "Simbah saweg sare, Mas. Simbah gerah padharanipun.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3126d787a2b0f5e8ea914f9c35e1228606ceb457ab33de1a0ac913741f77a674",
      "text": "dhaharan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "32758c41302b852f41b01816f86561bc8e6dcf03f6b054b484f7feee01bf6e1e",
      "text": "yuswa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "32d2a56c00284184bafdecbdc078c06bd073f1ec6e2383960ee3e5ee66f84346",
      "text": "Kula gadhah anak tiga, Mas.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "32d934d8a642d5649203675ed9b88b3b25beace780cd37faa7f3d48b95b89b11",
      "text": "Wah, sae sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "38974067f73ae4abe8b38d9af353a0064f81ee1fd9ee4a4a8382efef37a890c1",
      "text": "Garwanipun Bapak saweg tindak dhateng peken.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3af15858b6fe3048da62ec6e81c23fad10ca1a4436d47830bf3943e209f6935e",
      "text": "Wonten pawon. Pasugatanipun ugi.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3afa9a9fc35d5af4cfcc176a97eaff4dab54e03e0bdb6ec3ef6f1acea363bbb6",
      "text": "Menika ageman batik kagem Pak Harsono.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b7a8bdabf3caf0269879f350eea15cb3c2bc98574856881c1434ce72da85ebb",
      "text": "Iki kanggo kowe.",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eabd4a0bd0841b646188cd29dee760172a4b42a48cda0ac925a44c27c577c49",
      "text": "rai",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eef25138604d30f843cfce35bebd97829b32248a6bcce2cb65721eac7e2de3b",
      "text": "pandonga",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "40a47d6ed595aa59ed94be9fab94638e64486582635c356fa12ee27e7fe95663",
      "text": "blangkon",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4105bdbfb9e1c67ecca8ea1653806c450a9e1916eb31faef23e4748a25db671d",
      "text": "jaja",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4160867e64816d1fa39eb923d8db81d94cb5359f024c863de6497694bdae34eb",
      "text": "Sugeng enjing, Mbah. Pripun, taksih gerah?",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "469783f92e830ee0e821dbbab3c60807c98d06ecf95f8a10be877ff3ecf62b80",
      "text": "Kula gadhah adhi kalih. Bapak kagungan putra pinten?",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "46ddc6b4d5a9ef6e52ff3ac0bc42301aac9af0b04ef169bdd302a28d882b424c",
      "text": "Anak kula setunggal wonten Jakarta, kalih wonten Yogya.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4841f61c4213b381ddb5ea4daee03a3dfc4493fd6a4ec9274fad11e265a31f2a",
      "text": "putra",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "487d8a9e9414825dc50fdc2853f9ef85e5ee20d5b31f6c13626193841d9aae5a",
      "text": "Sampun. Kula ngangge kebaya.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "49f93c2e02dea18773725af7ff63bbcec6a365f1b5039af28708f809b5a0ad06",
      "text": "Nyuwun sewu, Pak, asmanipun sinten?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b139f1e4a7f4be5b1700b11d35251d5c65aa58c3f4bdc4154b7876bcfccfdce",
      "text": "Sugeng siang, Pak Slamet. Garwanipun pripun?",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bffbfd31314e019967c70c8afcdf29aa1e7e2523ffaf1ef326235e96422dd17",
      "text": "Kula pakewuh, Bu. Panjenengan sampun repot-repot.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e020fc321dd30f914cf41db68ec5e393ad5183a42664c01abd2f978d648d625",
      "text": "Sae sanget, Mas. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e0f318310aa47669ca77a3787c527ea4f2342324ba5350089e54b8bf146650c",
      "text": "Lho, Mas, sinjang menika kagem kula? Kula pakewuh!",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e4fda1c8d1b2cdb1243502149dbbe199cd31c1bb2aa5fbca16d65cdf1cc474f",
      "text": "rikma",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f9b99558f2f91b40182e89e07a2681b8fc71c489664ec09ba7f4edfce89cdcf",
      "text": "Mas Mohamed, mangga foto sesarengan!",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5099d80c76d9ccc28af7ffc44ba7548ff6310884053cedda310bf7d27f806548",
      "text": "Simbah gerah padharanipun.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f1df9268966a8da1c486ae5643b8bf48f52aa15ff521403fcc9afaaab39fd1",
      "text": "Inggih, Bu. Kenang-kenangan saking kula.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f35b956ea5a0099eba1f1ff475fa06e8bea3b9bb88f99facbb00e81779b2ac",
      "text": "Bu Harsono ngagem ___ batik.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "5375e7bc6ed7a5e5fd07645d86c93d02150e4e87ada037ade0c23ec6a2b35db0",
      "text": "Sampun, Mas. Sakmenika Simbah sampun wilujeng.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "53b32b9775fc6bf3a05d6d0233bbe273bc0f82f329e088e6a61b38dc2fca09b7",
      "text": "Pasuryanipun Simbah mesem.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "54706a19beeb271aa720049c2a00242c85f2043fa057442cb27651f053c2a9ca",
      "text": "Aku titip gudeg, ya! Simbah seneng gudeg og.",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ba689360a16b5ee4d401aa260d10d48ab109bf426b301545a1623e1c5b50fa",
      "text": "Mangga, unjukanipun, Bu.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "5678adcf13e9ca6bab125fe2460807254edcb0dca6655e686925fe497523fafc",
      "text": "jamu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "575fbc1fb176bf8ccc2173ca06a75fa474e74fe527ce2f99267431ad25f2d7a0",
      "text": "Kula lega, Simbah sampun wilujeng.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a282fc6d477b71110e25a1887f3101f674675d3bc0d77910797e2dc7f79aca5",
      "text": "unjukan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b31cd139f1503f3769822c43216b985bf6c0bdb1a6ebf8fa8cece8414588998",
      "text": "asma",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e9515830d9ea8248c7b5dd6af2e7a85f1ed2162129cee281ad7e40f6771330f",
      "text": "Mangga, pasugatanipun dipundhahar.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f41a992c8432793d7493e379ae62eab6c7b67a9a2de8f66285dbf70b55a361e",
      "text": "Sae, Pak. Garwanipun pripun?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fc040dc825114f3a97168db3feea1b3a51fdb9cbedeb838b1afbca05ad30963",
      "text": "Dalemipun caket kaliyan Malioboro. Pak Slamet kagungan putra tiga.",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "601a8c52132e87e4ccd42961f75d7407f2eb5b433c4acfe278b3a3828a208098",
      "text": "Griya kula caket kaliyan Malioboro, Mas.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bceebf1c241a1e464ed40c4196d89b6ce27666baf55eac91bca1b5573cc1db7",
      "text": "jarik",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e82fd7affcbfb85141cd0a61161b59ab35521afb334bc70db5da53dcb83d193",
      "text": "gerah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "70663604ee362cc6a795718c092bb735bbe850b24c4db00232c08f896cd17f4a",
      "text": "Mas, dhayoh sampun rawuh. Kula badhe nyuguhi unjukan.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "709e9d89e2b40b78b7b649255f9b31c2752726798874f3b7a120d48bfe950605",
      "text": "Kula lega, Simbah sampun dhahar.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "71a94ca58e107d7145cb151c14abfd5d914292004bdb0fde785f6e3dcd241a95",
      "text": "Simbah mboten saged midhanget. ___ Simbah gerah.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "71dde5fa7eb35c40c451eca83b5a4682f8c07c68786bc99a3dda02f6dcf0497d",
      "text": "Simbah taksih gerah mustakanipun?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "726286b47fce0fad5a2c5df58fa5eafbd178853f04a05c85b54a4a62fcfba2c0",
      "text": "Bapak ngagem beskap lan blangkon.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7334dc04f380dd9b01bdfd699d34ae24ebb0028ac75a192f716b8141a260a0f7",
      "text": "kebaya",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "771c70c2d4392d1719c694bcfe1959f208fd03cdc87c32c36b290318dab6755a",
      "text": "caket",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "77c3271fdeb585620e892d1a8fb019f846199087d9775b8b06dd200cc9cd42f6",
      "text": "gelas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "77f4eae41f76bb31d544b5a38140faf52cbef25515cac58a79429b0d67e79396",
      "text": "Inggih, Mas. Semah kula wonten griya.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7826801aae4f4e6f9d4ff8f3890afa777128b183ade7ef86e00e35c2a16debdf",
      "text": "beskap",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "78afc4ecb6072aa1c571fa01f132524c0d9c35c12ebb44c7d141f2ff149076e8",
      "text": "nyuguhi",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c698b385c9ec757897dcc2b5a0dd95e4f96422948b91249002f6822346eafc1",
      "text": "asta",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e34b8a5defdf7e66d1ca3ad573bc713c840163d367d0e8fae90e20f42172087",
      "text": "Nami kula Slamet, Mas. Sampeyan saking pundi?",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eebcc761c84374a4edf4553039b1ec55c0045c540bebebf2140ecfabcdd5cb3",
      "text": "Menika jeruk kagem Simbah.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7faa28a3d38be7440f21b1edf467d5505ff492c3d2c46a1a16b2ed5ea5395406",
      "text": "Rikmanipun Simbah sampun pethak.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "80c54d9eb28e939e7d36047a64c8afff50999b36af9afc9c6bc5f335f2ae4520",
      "text": "Sampun, Mbah. Simbah sampun dhahar?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "811f5d6eb22c9c1a90fd96a49e0aa85c9d92c2e1d4b3d8b4375f78fc0745810e",
      "text": "Mohamed, arep tuku apa neng Malioboro?",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "81c0728ee611425f1f9934610c0f4e934e3afa3879a6a2e39c3c0243b1ce65f1",
      "text": "Sae, Mas. Mbah Putri pripun?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "86123847de560e946d37cff062d9139abb9fec20ebcf342f8b57f18bf8b62a35",
      "text": "Semah kula sampun mboten sakit.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8655dae313366822effff7df8021ce2eb918b5b864524843dfee87bae10959ee",
      "text": "Aku titip bakpia, ya, Mas!",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8758fb40c50f4683867d1f4e41e54c570d211f47c80f83238af1ec3a13cd4108",
      "text": "mugi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "89d1f2c34aaefa58f7f8d72d1ef858f0f87f8f8ea7e997e8f47dd5b11e87b31a",
      "text": "Iya. Aku uga tuku selop kanggo Pak Harsono.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b48421dec8f0091a7eef79159f794e7cf4b0659ea325527a9e649741e857d52",
      "text": "Kula tumbas ageman batik kagem Pak Harsono.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fe9c4d484f1cb4d1cf3f86b4e0fb8e06a919e9cbb0432444fe4ae7cd81c6f87",
      "text": "sesarengan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "92237e20f7d77dc5271a1f7e416b50c2ae2a5be5bae55368b177ca3db76205e5",
      "text": "sirah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "937bc1130385bdcb176be949abf811bcb61687a151c445ca373ada1d56b86d0b",
      "text": "pasugatan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "956f362b6b2003ca7d42ff52741ed8ceea0a6037fd86ffee55e5cc2d4cb178f0",
      "text": "gudeg",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "97211e14d7ccc76f2dd124f10eb7f25ea72b9558bf7ec9351d74c3e1431c55a2",
      "text": "Ibu ___ dhayoh kaliyan pasugatan.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a317fa8cacb45f7b5a702e5670b05bcb407f590c76e612110b624b4809c9b4f",
      "text": "Menika bakpia kagem garwanipun, Pak.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c59110041396284719b743207e34f2586f9e585ec29e4194fe230b602af8f6a",
      "text": "Garwanipun sampun mboten gerah, Pak?",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dc2c529ab99c1cf3423476de9d9ae92ffd70026df4d53a23ef773e964898c80",
      "text": "Asmanipun sinten, Pak? — Nami kula Slamet.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ef802988fd72a11377c17b22defad2ae4061049dacbd13d003d5ed6018dd873",
      "text": "Bu Harsono nyuguhi dhayoh.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a005795b73bb7901de88394c88ce06e60b181bf5dcb8550fd684735a1d69f291",
      "text": "Wah, matur nuwun sanget, Mas!",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0ac2e77769966939e09f232e45ca43f944334112a90208c8e723146afd3cffe",
      "text": "Umur kula selangkung. Yuswanipun Bapak pinten?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1881eab82e166e9aa5050d56f3a4136fa973dda52229f9f2511e0ba30e49b4f",
      "text": "kuping",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1c80e30ba27cef69527618c8ea0f8460741494e9eb7e6ee7af909c3fe42b3da",
      "text": "kagungan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6b6e51e8fb394eb006342496f61bee795e89995b221ced132af82d5aff62eed",
      "text": "Matur nuwun, Mas. Mugi Simbah enggal saged dhahar.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb48c3935892d4729afad0ea338a6d0563d61bb4eace84e47729f838f952ec1",
      "text": "padharan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac647771e9e8da3655fbc1f77a8822f704d1b48adfb4626192b39f833f8a0185",
      "text": "lega",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "acc87b39c04023116201f80e09ae8fb87ce5cdff70004531edfbe41502ccc7b8",
      "text": "Dhokter: «Simbah sampun wilujeng.» Mohamed ___.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad698b69bded563edff26ea24df1d5435f8b3b3fc5882d779e0e066a200f6eb1",
      "text": "Dhayohipun sampun rawuh.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0a8c3cb17fd3ef98fe00f4fde628f25b3397dab4cbd3efe754b006045dbcc4d",
      "text": "Unjukanipun wonten gelas menika.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4062b025b2719e1de20cb4ca402396f97238f3a183be906e986304cf94ba5ef",
      "text": "Simbah saweg gerah astanipun.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52969cc58b074b793a747b868971e1f0cdb3e5d7214129e335a17b6fece0bc3",
      "text": "Inggih, Bu. Kula badhe tumbas jeruk kagem Simbah.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7bef8b3cd16b8eaad25d1ec2b099989fc4ab9ea6b0d41f4b83fe794b782bd71",
      "text": "wilujeng",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b88bcef67f9e70163a8303225475bdfe7e2bfd94304e3e3d835f7f828737e478",
      "text": "Selop menika kagem Bapak.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8bb57e3f02a45bd49f7def0cb67b0e76ee9388aea42d5a512eb4c517e739d07",
      "text": "Simbah sampun mboten gerah, Pak.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b97574284b915bc0c636a36b765919e49c39bbada3b1aaafcf59c988c62741f0",
      "text": "Jarik kanggo ibuku ing Kairo, Mas. Lan bakpia.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb62b34e3423de8c24317096780d098aa4a39551a02dfd23cdc338e4f2f91bf5",
      "text": "ageman",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc8dd738e0552104a44d65b960489b582aa07b0733f6a4dcd935ed10f3b754fd",
      "text": "Kula biyantu, Bu. Gelasipun wonten pundi?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf5c70e795e1036670e1e0589e8c08b943fc827a1d751a2d6d72081127e7dca6",
      "text": "Dalemipun Simbah caket kaliyan Malioboro.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf6f22711275363a250fcb5c03e9f85ab76260b03817e799a7fe4dc7d3cc1e5a",
      "text": "Inggih, Mas. Menika semah kula.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0dd3206ac902d34c2ca444e1e5fe1cda7e9e91982fad7f8e08e8f94e63b62ca",
      "text": "Griya kula caket kaliyan Malioboro.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2b637990ba542bc39a492735e0e7dc0a85d230922ca16897f959be6c94f3bd3",
      "text": "Wah, matur nuwun, Mas. Mas Mohamed sampun nedha?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4615f842630869b012fa5871e2a64f60fcba2c452abbe165d99af0261081b19",
      "text": "Menika dhaharan kagem Simbah.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5bd59d57bd98d158f7f262153ddfd85cba51b6454e6fac1a3896d8b4ced1a23",
      "text": "Bapak kagungan putra pinten?",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c771222d8341c49870a90da00f81e872c373a77ff5961fbc606825f8dba3af52",
      "text": "dalem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca29261a44e26eb1667a167c2130fc09d6680511d492b8bf98f1777a2fb7eb81",
      "text": "Inggih, Bu. Bapak sampun ngagem beskap lan blangkon?",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc503bcb378b85470e910ddd18962dbd022d0ad752299827f9225574a73204d2",
      "text": "Mangga foto sesarengan!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccd53959b9cad86f80749dcf72d85f608b2a6e1b42125aedecccc17fe7676f4e",
      "text": "Nyuwun sewu, asmanipun sinten?",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "cffbaf0397d1f49ed48c56f421f6931771faa1214a864c3bc8629bc5e5fe28bb",
      "text": "Sampun, Mas. Matur nuwun.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ffbe166046bd6efda1bbc23e51273e297929efc6904691d235dd5d8948ff2d",
      "text": "titip",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d213ed00c6e70188b8f51380d8ff3a2a22134d466fbb3e33914176d7b83303b2",
      "text": "Sirah kula sakit.",
      "voice": "jv_siti",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3382e2fde0381b360125c5e519b87e79bfd87eb3b5f012cc22e1c4df90ead15",
      "text": "Sinjang menika kenang-kenangan kagem Ibu.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d36bfaed25f834326004e206398d7fb3f1e30529a7f0e3722e35771a166ef4e4",
      "text": "kagem",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52d07d5dd60b045ff931df2e09ad551fdf684555703915d7fb94a4ee8132db4",
      "text": "Alhamdulillah. Menika bakpia kagem Simbah.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d58684e002c81f0460cc3f2718f930251bc1a6213a5d00fdc9212e38a3034869",
      "text": "Putranipun wonten pundi, Pak?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d883e94d59ec3d39bd916b09e92abbfdd8c15a8276cfac28f396cf0e9461e250",
      "text": "Simbah sampun dhahar, Bu?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b9bd33845536256f71e242353b3d1fcbc0f4d69a7a5504619ddb548a3dd36e",
      "text": "Kangge kula, kula tumbas buku basa Jawi.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9b438a9a035379b8a0372116f476f1eba4ab07dfa96aeb88a14a152361a7084",
      "text": "Simbah gerah jajanipun.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "da0146cae32f4375cc9488e2d0604c58005d3382e548c4c8592f204f2a7dc0ce",
      "text": "Alhamdulillah, kula lega. Pandonga kula kagem Simbah.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "db95c66f9b9a979a2b62fb9f2210b438c5822cccab8786bfc2d19eb8637e6bf4",
      "text": "Simbah saweg gerah mustakanipun, Mas.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc395e07d06ca721c478659f0ed038bc91d425ec81b6255b0046cf7e47a3eec6",
      "text": "Wah, matur nuwun sanget, Mas!",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcae2129de42686ffb6a73cd59114d9a1736e9124a5e1c05dbb8855a9350ab4b",
      "text": "Garwanipun saweg gerah, astanipun sakit.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "def3c24211f9c5bbfab989d642735f469db21e18de96aa063199c23d73abe012",
      "text": "Mugi Simbah wilujeng, nggih.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0586cbfdda078a9cfd2f0be345a865a8540136d2f4ec61249658334a0ccf610",
      "text": "Ngapunten, Bu. Simbah sampun ngunjuk jamu?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0b37a12a5a468a91b5295835606bcd7dff40246403496238b1a43e28dc508a7",
      "text": "pasuryan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d69cde6f6f929b20af419a7fd11da891b3b67db8a9eeefe865ab94df8a5358",
      "text": "Mas Mohamed! Pripun kabaripun?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e236219910e4d57c7122cfaec38133a1ecc813af8465ed76f232f5b26405a785",
      "text": "garwa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35ca38590aaf6527152c9ad17934dfdb03abab55290a7854ed885628a7c2761",
      "text": "selop",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e391ef203c836a2eca7004266109b6792369691dbe24a05f8ff764ce6f8ef2fa",
      "text": "Dereng, Mas. Simbah saweg sare.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e85cea767c6ff91e990c24d2e24c8da8ecd0e75c6cd1da758a840b8a5e34708a",
      "text": "Sami-sami, Pak.",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e87bdeb16f045fd7f9a5dd34a7363c1778ef30cfde45ecbfab36748ccc10d571",
      "text": "Pandonga kula kagem Simbah.",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8e33e530d9054f1483e8fd1c6bbc3b75bc261b25ba1578940faf421bfe61a86",
      "text": "Menika jeruk kagem Simbah.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9f19518a537920b33494ce3c42bb26b9cb4000dbbf737c7da5aadb6a14b2eeb",
      "text": "irung",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb6284025962ccf01bc5424da8c8b9373896d99f69fc82d68f1e2a682a3923eb",
      "text": "Pak, menika garwanipun?",
      "voice": "jv_dimas",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb883b523c3136f30f2fc7ad207212c424a6e1a45ddd926a50014b6029a99a5b",
      "text": "Bapak kagungan putra pinten?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "ede6e557eed921f7474b97938017ef935e03eda0e267e47f5c2d3c31497fa44d",
      "text": "Kula gadhah adhi kalih.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee8e2bad261cc249153da4a1cc73bd6fcf1838c6db64466bd89aa0b5d2d27c6e",
      "text": "Yuswanipun Simbah pinten?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f059db686077d7a078829a55f70394d3298bd590b081eb4ef1544fe4c84e2493",
      "text": "Matur nuwun sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f09dcbf192500de86bc6ca57d9d79ed06cf20bec9d1394c012c5524bcb2360b1",
      "text": "Iya, Mas. Raine mirip Mbak Ratri, ya.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6ad98cb2917328f229d553c58f7a4e7156f4e45f28bf2c2a531f0f34eb86869",
      "text": "Mboten menapa-menapa, Mbah. Pasuryanipun Simbah sae sanget.",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8b28869fbaf8adebd1afa8e9e639476a5d90bb04f2504e96de11c70ffb30ad2",
      "text": "Simbah gerah astanipun.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8c6508d419d11dec78ef0ec14d7d98495c12052d32218a3ddd0ca26b78b0b6c",
      "text": "talingan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbd0c1c462a64ac8716855ec2c89cccf8cf14f8068ac320e6a40a0ed74fb59b7",
      "text": "Sampun mboten, Mas. Nanging sirah kula taksih rada sakit.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbe57b7229968cdb35391855c8e8a50870c7879b6467571c572e54f1a4f84917",
      "text": "Agemanipun Simbah sae sanget.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd0643c5711456d6f6b9406d5a30b78f14ad2fd64c3325bc9fa3635f53184aaf",
      "text": "dhayoh",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe669c6a1c4b282f0e34ce0f7ce1f1ea9b069787da2a6c65de2612b7f5bbfd68",
      "text": "Mas Mohamed saking pundi?",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff1977572910c82444a2284c25cfcdd6198c9974a5e258de36436df839848a30",
      "text": "Kula pakewuh, Bu. Sampun repot-repot.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffe04f70dc9539a4fdab6b402e6ccb1f5ccc3ac5e5315fc262fead85ef8c29f9",
      "text": "Sugeng enjing, Mbah. Pripun, taksih gerah?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    }
  ],
