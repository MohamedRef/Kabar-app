      "sha256": "079f7eba52e7cfe9ce14c875d6cef7849b6143754556e33e1ef9b5761e5e6301"
    },
    {
      "id": "j5.u01.l11",
      "sha256": "11eaed38e16dfaed3e102743cae573b996f61012997c8c1309b6a0d07a4f4c07"
    },
    {
      "id": "j5.u01.l12",
      "sha256": "555afb7d19128ba654e9e65ecc0772b9d27e3511460f9ed843b5f510b806c6ec"
    }
  ],
  "audio": [
    {
      "key": "006702d6df3436953133fe80a059ba5fa965b287a973c09860bfb22b4db3bf6c",
      "text": "Pinter! Ringkesanmu bener.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "01729092533af4526ae38d5af2139c506f4f1692d8b69bad762f6a4d59db3e5b",
      "text": "Jalan Pahlawan iku papan kang lawas ing Madiun.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0858cfac69c570f7b96270016e4c791888cabb167a90a27b91314a6e0d3f0864",
      "text": "tugu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca2abb1b73e579c50dde3ad2ed37259f9ed773798b8bd104f698cdea9616aa7",
      "text": "Kudus iku sawijining kutha ing Jawa Tengah. Gampang, kok!",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cde68b8a5f674fa9571946d28b132fc778730e3cb06e851e30f2cc4658fd93b",
      "text": "Brem iku sawijining oleh-oleh kang bahane tape ketan.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d26e64a785a7a91a4f45ea19c387de4b374ac8342fbd7811a8de32620359255",
      "text": "Cacahe pedunung Kutha Madiun kurang luwih 200.000.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d28477cb28238f6dc73550e386fc789c62540d74ed5e0aa30ae8185340d0004",
      "text": "dumunung",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f6d07ebad5860509d2ed2e2b1336a992ba54bd91a228a1dd13b72a85aed83e6",
      "text": "Benteng Pendem dibangun ing abad kaping sangalas.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "10e8a07047f57da1bc50eaf25043c00defb4a4a412dc48b50207ed17da1119c4",
      "text": "Gunung Lawu ana ing sisih ___ Madiun.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1184a6f693364e0143477cb71b2451779740c638111f954622575f3731cbe609",
      "text": "Buku riwayat iki awujud komik.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "121a84317902edbffa831857ff9ef3f7c20602e07897cb3766c6bb96361faa71",
      "text": "Iya, Jalan Pahlawan, Alun-alun lan Stasiun Madiun.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "15475dd5b11a2e6b623353abd91506d6acf68fc03e80508b897246652e1a867d",
      "text": "Atusan prajurit Walanda manggon ing Benteng Pendem.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "1818c7b29fcd89d9d1681c0c738c4544fe9b2dace17e0eb75d420167aa80f0ce",
      "text": "Apik tenan. Ayo mrana!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b5f0a68627746bb7b4da31db72c2485d0a0955f3e112f24dc8cb4c15cc5dc2b",
      "text": "Kairo iku sawijining kutha kang misuwur ing donya.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c90ab14240cff48d9428d2793abe0c1623ec3a341d478edec5a64cfae41215b",
      "text": "Kairo iku ibukutha Mesir lan kutha kang paling gedhe ing Mesir.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d463faddb6e8c542b12256fefe6d1069aecda74e928145e851d693f2da2baef",
      "text": "Ing pinggir pantai ana tebing dhuwur.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d954c13e96dd46d708ad2c6440c505a53aa44054f42b19549b81271b6d56d8d",
      "text": "Mohamed, aku maca artikel Kairo ing Wikipedia basa Jawa.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "213c03bf8fc0761f820a96303c26d91962cef44f759fc4a8baac037917a8c87a",
      "text": "Madiun duwe kecamatan telu, yaiku Manguharjo, Taman lan Kartoharjo. Yaiku padha karo \"yaitu\"?",
      "voice": "jv_dimas",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "21c2a172e002ae9e347858e57596005297efd0b9eedd37cbf3a7e642c6b02bdd",
      "text": "Ing pegunungan akeh sawah pari.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2342d3e5a7b68cb5673a2271728f7d4b48c89d0498346179ce156bd2501edcc3",
      "text": "Kudus misuwur minangka apa?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "24da898a54477f0e6187b870752a32aa7109c9b9e5a282a9f731663acda701e1",
      "text": "atusan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2528864f4f8cb87238114a24f00fc71ef70b7f0b1c09245906b41695d90589db",
      "text": "Stasiun iki ana ing cedhak pabrik sepur INKA, ora adoh saka Alun-alun.",
      "voice": "jv_siti",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d23109d06103c68952144b7e5648181ee7e72a07e2658ac115a459c5294069",
      "text": "sawijining",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2742efb17f1b2670afed730ed33ffee26db4a2408157bdddefc5e9018d258218",
      "text": "Ing kono ana gedhong-gedhong lawas saka jaman Walanda.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "27ee338b60f819b6434ef6f56586b45cb1bc99244fe65f295db53873bb06115e",
      "text": "Minangka Kutha Sewu Menara. Lha Madiun? Kutha Pendekar, to?",
      "voice": "jv_dimas",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f737c0fd2c79fc6ad8016939b8e49d02cc4d22c53ccb54f26acf4cddf95418",
      "text": "Stasiun Madiun iku stasiun sepur kang lawas lan misuwur.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "29fda849328e042bbd871b119ff923cbeceda17925bae9d744975f1f8310c450",
      "text": "Lha, Tugu Jogja riwayate piye?",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a57cf5bcc942676d900a6674c32a975cf78cdfb69509bf0a3771cde8becac0a",
      "text": "Kairo iku kutha kang paling gedhe ing Mesir, ing pinggir kali Nil.",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "2aac7a01644913ec2b2be499a6945f3af40e9528882a2436252f80e076da586c",
      "text": "tumbuhan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bbeba9397e0d1f54e8874803a960c42ff142253d1596e1c836a52feccd96388",
      "text": "Satus taun iku siji ___.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d2d0ddccb317ac8fdc901560781320a41120a26b36c1f82969fa78b3fd1e017",
      "text": "yaiku",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dfaafb6ecfa4542b347b2bd2495ea336751a8315a37fc2f13308c30e571978f",
      "text": "Iya. Ana atusan prajurit Walanda ing kono.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3164d94dbf3ce41cb14606e06889636d3ab42dbf1a69d8aa01f1de8d96e2ad6d",
      "text": "Kutha iki ana ing tengah pulo Jawa, adoh saka segara.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "33dda04885d9fc9fea90405e6b2c924ae042567baf07b3edfbe137db82b8071b",
      "text": "Gedhong iki anyar, dudu lawas.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "34fc18750b1b5e0dc13d0c105cda9044a9ab47cbb04411bc63a4a5d701177c0b",
      "text": "Jalan Pahlawan iku papan lawas saka jaman Walanda.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "36e0ab13f063c7143757898ef70c1c5fa557cbf4bc1574f6c23bc97858ccece7",
      "text": "Aku seneng banget papan sing lawas, lho.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3745255e0181820283fa9eab153fb9c6a1a9554893e7579829333a4f985fbf88",
      "text": "Ayo mrana!",
      "voice": "jv_dimas",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "38001dc18132d621f9551bc9aec21f4c3596cd96e0eec62cc4d9eafc83355237",
      "text": "Madiun iku kutha ing Provinsi Jawa Timur.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "387c7cf2ef5fada00fe0b51fce4f8c3f689db27ab20660987e8c26d3b5ae27d8",
      "text": "Stasiun Madiun iku stasiun sepur kang lawas.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c3dded14be29e6a647324629f26140437c3232cb9893f92552cf9964f77a828",
      "text": "Pabrik INKA cedhak saka kene, ta?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cd759f8c2e2ecc7184b6a99be10f0ecfbfe56599f2712022fa795dd43b1156b",
      "text": "Candhi Cetho iku candhi kuno.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "41d40fe60e8e7bfb841a3f604314dd5cdeef4919448d79001047880ec83ac25d",
      "text": "kulon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4258aa1cfe60f01faa0f786be5dcec48e0af909965321213e3c8a6750a259bdb",
      "text": "kawasan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "429772132216caeb9e92460b1e6516fae4755c23e4832dd313b8b910d61c512b",
      "text": "penutur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ccd669278cd478faa5277e5be51c67712b611f9b5dad5b212a7a2de30b023d",
      "text": "pesisir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "42fef81a9811677c552db5d81b00005957d477b562fa30d78672c2bd46c514f9",
      "text": "Wewengkon sisih kulon kondhang banget.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "433d761fa974766d935a7729e864866a1aa596f33fcdbf21988c5854a0c82d6a",
      "text": "Madiun dumunung ing sisih kulon Jawa Timur.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a16c67b3f1584b8abac6e522835295aa1d42c5f7070fff3f0066d43c6799a56",
      "text": "Saiki Jalan Pahlawan dadi papan wisata kang misuwur.",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c0f72d0877a4b73affa30d5b964ab91128436feeef8c1461bf0889fe3f64004",
      "text": "wit-witan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d5f3cd882bd8fce28de58e634921fce3b463013030b6ff75f87ff30427e8d07",
      "text": "Pecel lan brem, ya ta! Lan esuk-esuk Wilis ketutup pedhut, apik tenan.",
      "voice": "jv_siti",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d6e1d154fdb35a10d7c59fb067ebd2403ec0b5e57fc66758542fba9c0563959",
      "text": "Jalan Pahlawan iku papan kang misuwur ing Madiun.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e48f6d73aed5d6cd1c620e53787e9e71fa7d699122aead212ff475cc2b39bb0",
      "text": "Cacahe kurang luwih rong atus ewu. Ora akeh, nanging rame.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eeb4cffbe8de26942d436fed075e7dbfcc44f72069de94fd8ac3b26013188a0",
      "text": "Mbak, Madiun iki dumunung ing ngendi ta?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fc601a44ec4d789ddbfe57062a22f11210f880562017aa07347a494ac667b93",
      "text": "Oh, kang iku sing, ing iku neng.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "502ed334e7b7b169fd40c1d010d3b42292460e0f76153bcac4f84efaaec0349e",
      "text": "Iya. Nek ngomong, aku ngomong \"papan sing misuwur neng Madiun\".",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "503a17258bfe31c75785c43a8f72fd1197d6895e25d0ee2351fd9f6d20637dea",
      "text": "provinsi",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "51b0ab7ed7222255fc08461d9eb1d3e749f3d408b2996cabba30c08c126f11eb",
      "text": "Stasiun Madiun ana ing cedhak pabrik INKA.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5369c2e2b74ce4553ef26e757a07414dd5069129cd37152cc10dadc69780ea2c",
      "text": "Mohamed, wis maca riwayat Benteng Pendem ing Wikipedia?",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "53bd1d03ce89851604761249d950f057deec03c1de68281fc9dc668e17fcc084",
      "text": "Ayo! Aku arep weruh sepur anyar.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "53f8dbd636f57e25a1e96c05c20b1abc1c8412f5728ba49c3bda0cb1972d07f9",
      "text": "Tape ketan, Mohamed.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5534413e13f6632ad0c56ba1c2e75b511799dc8524130d108a157973a3cb9b55",
      "text": "Iya. Kairo kalebu kutha gedhe ing donya.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c8ef501f9cef1958680ffc658e15672ef18d57cc5b466fa54344eeac4e810b",
      "text": "papan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "593431f774d1a33b3d7d72ad5c1aebeb20aecbf2440ad3301c7b2595e36551ea",
      "text": "Mohamed, iki Wikipedia basa Jawa. Wacanen!",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "59ce175b4e8538bbbeb4ddbca9f86464a423da76d04e16fe3326c6616a6b3d48",
      "text": "Madiun iku sawijining kutha gedhe ing Jawa Timur.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ad2e7da674631710f1e88c036b0ba8916c59cce2d3d8f182fd0c85ecd2c7cbd",
      "text": "Aku saka Kairo, ibukutha Mesir, ing pinggir kali Nil.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cd5710e913a689696b08e01ea368e61f120eef2dff90a8eb870764a2191104d",
      "text": "tebing",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ed71c0e64c4bd499a270e09ec4231d4eb096259b35f508e697fde90e3961799",
      "text": "Ing Madiun ana papan-papan kang misuwur, yaiku Jalan Pahlawan, Alun-alun lan Stasiun Madiun.",
      "voice": "jv_siti",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fabca814b39f9cf13647790f6aa6a2e46786326af303a100ba806143f9784f4",
      "text": "Bener, lho. Omahku ora adoh saka kali Nil.",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "61596a5931ddbf485423845824d272fcd449741e1173e66307fe03e6a28aafb7",
      "text": "Iya, ngoko, nanging basa tulis. Iku ing kene padha karo \"adalah\".",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "631184216605f87138308917649328a36803f668cecac1a1f4cc498b9102d7e6",
      "text": "ringkesan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "64f62faff6263dd41743131478ce32fa4628e2308583f3071be18d0acc518bd9",
      "text": "minangka",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6575107cef420e2ba01b5c50fefce22163af2e3b5318d460844d34d321946286",
      "text": "Akeh manuk. Nanging ati-ati, ana tebing.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b5be2e340f4ba8b75195bbe15bdde06974648836a6bd9bff381e265e0664afa",
      "text": "abad",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ba9eed76bb6dd517e53d2ac5d90728e7a105bdbfa9ff43f7f32f0efd6ca7e23",
      "text": "Ing kawasan iki akeh wit-witan, tumbuhan lan satwa.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "702211368cd1ac4879d397a6c9ed2e6bde87e32f3a5450fe9e0372b8af01e6fb",
      "text": "Madiun iku kutha ing Provinsi Jawa Timur. Lho, iki ngoko, ya?",
      "voice": "jv_dimas",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "70451fc8b018cc6ab71852ebc952f457993f72aeb5e0650d9362c45c4b249811",
      "text": "Madiun misuwur minangka Kutha Pendekar.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "74c01db6c42c0f5b661ad73207a05b9169a4d164406b118cbc30c20668064521",
      "text": "sepur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "75301398752da6d7ce78e8a5781ea193da58d58aff11a38ba802b9123dc7219b",
      "text": "pedunung",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7583f6e75ee33dd3191fa3133c4fcbe050f3fdc7748ec87a51f6dddff83a7260",
      "text": "Mbak, artikel iki ngomong saka Madiun ana sepur menyang Yogya.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "762d139a02ee101bfb03bb860b96ff0e9280345daab0f2076bc5f06d44216c55",
      "text": "Kali iki dadi wates desa loro.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "78fcd322a3f50feb3b29d3a745f358fe95ce2866010b89b94461b091078857d1",
      "text": "Stasiun Madiun iku stasiun sepur kang lawas lan misuwur ing Jawa Timur.",
      "voice": "jv_siti",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aa3a5777969883807bc40965d65946b77f9f90085f464c7869b5e493037818b",
      "text": "pari",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c27093cb17f1784ecd91d8c14f430971bd0cd2476f2adfc9e493796df10ee58",
      "text": "Mohamed, wacanen artikel iki ing sepur. Iki artikel Kudus.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f3138b5b7f88fe8b458a5441eaa163a76b99fb3acbfaa210f75263573121dfc",
      "text": "Jawa Timur duwe pesisir loro, yaiku pesisir lor lan pesisir kidul.",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "838fd28eb085a0b32349aa4393f0bc656b3f78eb8f9897f11056c3e90517aa5a",
      "text": "Ana telung puluh turis ing museum. Ana ___ turis.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "83cadabe8d80fbac126737a03e6e7d9d9be5bab93d177613ed7688f70e6c3a23",
      "text": "Mbak, brem iki saka apa?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "84633418c931deedc5d646500391dd94b30905e1d3ebe56b73c226ce69cadb66",
      "text": "wewengkon",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "85f10e2c56ad18ae1b4a89207a0f6ff5e99b16e7eb82e810cf1b423fa2245992",
      "text": "Kutha iki ana ing pinggir kali Nil.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "88215da01b6bc5ad4a6ab2abf9d81c23c84b11cb122472e76506d4263c99906a",
      "text": "awujud",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "88e3f0724980d7a4abcc55f3411022a7faa35946135002c611a11dc0d044ad55",
      "text": "Puluhan turis teka menyang candhi kuno iku.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8933613b48128f5ea4a56dd831e372d6508ad97af7935b7efd1ea28ea4da12f2",
      "text": "Bener. Lan saiki piye?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf8a8ef8433c7cc1dc98dbefdc804c99f3e1c3e79247d8a2c904ffa3f33f30d",
      "text": "Wah, aku uga arep dolan menyang Kairo!",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e95eb1c4b27a8c0b9d879dd005ce453b47529c1c9f4d9e4651d0617ad27e44e",
      "text": "Alun-alun ana ing tengah kutha Madiun.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f420635c77d4c11a3c812dd27be14d1186bef44709fd488f61df39e8341ed92",
      "text": "tape",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f745f8f9ab94f9c888ae66a085bf4b9602aaa4849721076bf4a32160a6e7101",
      "text": "misuwur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "90cb3173df32150d46cede8a9b7c8b95a184ca0a8f7eacd4d220e58b0ad0ffd0",
      "text": "Wis ana wiwit abad wolulas. Saiki dadi lambang kutha Yogyakarta.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "955b8c5fbedf8ce8b7886d70cdefe7300a9a60fbf4713686c47c9c61f1095cb4",
      "text": "Pinter! Saiki kowe bisa maca Wikipedia basa Jawa.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "984ff078e879e3c34d858de3ad4c811126cf3b0bd6cd1b4e0ba4cd94978eaf7c",
      "text": "Gunung Wilis dumunung cedhak Madiun, esuk-esuk ketutup pedhut.",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ab4983b2f1792eabfe57604569ac6554707c0c53dd2d77abce8cedb077cc97d",
      "text": "Adoh, lho. Madiun ora duwe pesisir. Sing cedhak segara iku Pacitan.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "9af842c706a004221d32e08de41ad9fe6746c53ad93bcc055cd848e3257598ca",
      "text": "Tlatah Madiun kalebu wewengkon Mataraman.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c75f954c0ccc2c74b3e4758cac63cc669fbd7a2f99801842aa3532d16421b5f",
      "text": "donya",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a24483d357dac6521c0ac9bbe14b6f553ea0df67f7f08ef8475b5f76b2c7c9a3",
      "text": "Wis maca artikel Jalan Pahlawan? Ringkesane apa?",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3bd410426e24d787f2d62e98354a40e8345a6d69bfbd16427a378de35410635",
      "text": "lambang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a909562851e13971a5118ba81de5fb144a689a52a5b59a3d19ca86412efb1f24",
      "text": "pedhut",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa92c88776be57215460ba23c405741e327e9c9bed2c0d2825d2c0bb6db78a8b",
      "text": "Madiun kondhang amarga pecel lan brem.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa93af574e2138bbf6d8323431e6df32c4fb8804bf192a09f1a682aaf930b12f",
      "text": "Bener! Gedhong-gedhong neng kene lawas banget.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad6f09fdc0567abe742f29e9ffe5dd9fec0f36fcd73b64cc3922536614edcf34",
      "text": "Wis. Benteng iku saka abad sangalas, ta?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "adc6a6e48893b06c516577483fb762ed97e2f55989a285b2360a548c612900af",
      "text": "Macan, gajah lan manuk kalebu ___.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "af50b3eeed393a23f2f1d2549b5f62917c5e34b51e4c5b247fff9fadcd90ec51",
      "text": "Basa Jawa kalebu basa kang akeh penuture ing donya.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7d0f1e8821d848da6d757c6512a92f80d33420cb9549285f5bb186241ba371",
      "text": "kidul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7dec8fa50e3bb2f106e59b00fd7a762e923ec96a659d17c81f77c773736431",
      "text": "Dieng iku kawasan pegunungan sing adhem.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0689dcc340fdbd0c2abecb953cb9869a59a8a9d4823adf47ea7381a1ae50c37",
      "text": "Ing Kudus ana menara lawas kang misuwur, yaiku Menara Kudus.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0803cde8f68522110db8acac66ae03ee98c32dfcc62dd2970d80420bf571089",
      "text": "Satwa lan tumbuhan ing kawasan iki dijaga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0eef9f2cc31aa5bc07d773e3801941ca6300c5afc21ce7013f7ac72239d9367",
      "text": "Ana ing sisih ngendi saka Madiun?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1e3f8de2b757d72e30f39ce7348b6466b27db068e97405898dd1b4b1f03a643",
      "text": "Ana satwa apa wae?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "b40f5cc7a5aa30d98a0166d5f3e255e8adc44333089aac56ce615d6b9b99653c",
      "text": "Saka Madiun ana sepur menyang kutha-kutha gedhe, yaiku Jakarta lan Yogya.",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd9f1bda3f8e558a7713f3ef01045a96d046c1f2a2acc4734f9b9aaf159eb5c7",
      "text": "puluhan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdccdb7e7477921f4a9cb397d1deea7139cf0e20ad35bdc2489fe25c4c36afd7",
      "text": "Ana menara lawas kang misuwur, yaiku Menara Kudus.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "be1f0ebee66d2fe66f60725c1e92999a0741e127351bbfc920d24b7a17f2fe66",
      "text": "cacah",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "be51a1ee91f50c2d4aadfe317bf372c1b28591f91c2949a188a5a5ff5035d85a",
      "text": "Ing Kairo ana masjid kang lawas banget, yaiku Masjid Al-Azhar.",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "becc8b6778e238fb3b8d58fef3ade399d9fb0e6cbae6123977588aa5d42a896b",
      "text": "Mohamed, Kairo iku kutha gedhe, ta?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfb9eed96dc2cdd2de8d282c117d329c94c14060576c8a0eeca164181fae711a",
      "text": "Pacitan ana ing pesisir kidul pulo Jawa.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c28f4b5aa6d526dcfefdd32ebe8ad7635296adacba714731b2b10146280edd2d",
      "text": "Bener. Saben dina ana sepur menyang Yogya lan Jakarta.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2d607ddafd5c7cf40ed8f55dc0e5c6a3ac4e97f3a74c3f1a864a23e0b802edb",
      "text": "kali",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2e8957bad8e507080ecd76fa798c0a13c32aa6ba124ef409d2ae314d0848ace",
      "text": "ana ing",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3dbe7a8126c6c920399a3e34d463c28e0f0a8e716ed4d7a3682a2f27e9dbc32",
      "text": "Kairo misuwur minangka Kutha Sewu Menara.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3f16f99f255516b4c9d6cba9cbc663521fb77742fccffb2bc703ef9cbb12c0a",
      "text": "Walanda",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c51808ab6c7d1aaa6ca319febbc4ddc2d095bee6807006f0a7c70cc2a634ebd0",
      "text": "kalebu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c541c41f541cdfef79aa92a298b8655429f23dcf5e1306c0dd25b46adde0243a",
      "text": "isi",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5ade6f06d60d2b903571c2a0999571cded5cfea9ad2f7d38503cccf727cd807",
      "text": "kuno",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb7d964dbf0359460fa71d7d637865f6dce3b0d40a5cb412355f72799e015a7d",
      "text": "kang",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce2164e8195be006542ae234d5dfd1b4a99f4198dc8661e36b034a3b827aed37",
      "text": "pulo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf1fce6c09a646cce6c72a11d0eeffbd9aab509a28982669146a8810114a46ce",
      "text": "riwayat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf28c6b033f9ef857a31ba7f6400ae17d0341f7c17bb8b6bb25f4382b4e4964f",
      "text": "ibukutha",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14850b7d434d805720a9ed47a63968e4d5699bcb8f50b23b61b1e1dad408623",
      "text": "lor",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d281591470cfdd8f45c462b33638e640bca93b26c73ff43875e4c7078873471d",
      "text": "Tenan? Artikele ngomong apa?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2bd2cd6c435d3e2e0dd825976b9b040e847ea78664bea3b2b04325d04448e03",
      "text": "Ing sisih kulon Jawa Timur, cedhak tapel wates Jawa Tengah, lho.",
      "voice": "jv_siti",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "d39f83deced232e1b9facfe04ae82a0cc8dd914a27ecf757c9f5ae1ce4366606",
      "text": "Pedununge akeh, to?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5a34604fa5495596eb229f9d47cfe480f6d17470682e15d1f90d82cb8466c70",
      "text": "Brem pancen ngono. Legi lan kecut, ta?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6e0666a524c11f7a95734728b60ef80b3debeb7feb5d80a081c11311355367b",
      "text": "kondhang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d743377062c941fe021189a13cfded563f914d881f7be2517e9f1d2b782c857e",
      "text": "pegunungan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7ba563f8452b9f503b6176814c28c9ff1e346e5dd38f065cf62492b6074b350",
      "text": "Mbak, artikel iki ngomong ana papan misuwur telu ing Madiun.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "da0e2d3796ca7c7d6112698ed01e55d7e77014f6408b900a4c762da1d31b1dad",
      "text": "Enak! Aku tuku sekothak kanggo oleh-oleh.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "dabfdc1423f71a06f48b98adef427421609090f53c50100802f777650c8939ba",
      "text": "Bener! Lan saiki awake dhewe ana ing Kartoharjo lho, cedhak stasiun.",
      "voice": "jv_siti",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc92b11e9a6a4b21d6bd89cb6a13e8820a68adec909bdd8d759bd1c34def398d",
      "text": "satwa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd33b9b7397f368d9c4b746092f67b7b1acf736ada9e20471bc5071a19d6c2f4",
      "text": "jaman",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "de564a9a8c5cfaa4064277c961e97684cdd6fe63862bf383270f076e2a02a676",
      "text": "Lho, kok krasa adem ing cangkem?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "dff9ee009c5d0aeac872b1c9f252eed25cba812a775ea3f600226806efcf20ef",
      "text": "tlatah",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1b92a87bb72b905f3e4bb808f14fc9bd1967586ed1b1baefd9c2d3af624482c",
      "text": "Kudus iku kutha ing Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1ea70f46556e7bd311d74a90cd6b789e6f5034b4fcbd9d5fca1f7ce4abc943b",
      "text": "Brem iku panganan kang misuwur saka Madiun.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7e9bf0413d2ed4025ed1da9f7a39f765c89a78fc800d8b6c14ddaa50d395573",
      "text": "Segara adoh saka kene?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e858a883a5310949abe2216d620b2eae6df8ad3af0914ec0533bc3c7f8ae1e73",
      "text": "Cedhak banget. Mlaku wae, ora adoh.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8913b504de6df4dd2cedfa649a2299e401a2b18f0691989a8e65eac51542659",
      "text": "Madiun duwe kecamatan telu, yaiku Manguharjo, Taman lan Kartoharjo.",
      "voice": "jv_siti",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea1cc78f68b01c50272ff18b71e61d675bd9ba0353b12c14cdb7a7a69535d26b",
      "text": "Lha kok kondhang banget?",
      "voice": "jv_dimas",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaf8e8d29dc69c846d3efa9b7d8067c1917cea7262ed1839bbf279ab89ac353c",
      "text": "Kothak iki isine brem sepuluh.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec1855c96bdbbfbae435b9a79e7a9b8986a2c4429f1d3438df181814440c03f1",
      "text": "Saiki dadi papan wisata kang misuwur. Eh, papan wisata sing misuwur!",
      "voice": "jv_dimas",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec8a0032daa62d09dd877987bcb3c5544f4a28b1c0cebfa6596fde6d92d85364",
      "text": "Yo wis, ayo menyang Alun-alun, banjur mangan pecel!",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecd482ab5c68e11edec4f0ba3c72784e18d7a1a8ff8632ec83954a531c5f628b",
      "text": "Ing sisih kidul wetan. Kawasan pegunungan iku akeh wit-witan.",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ece97cd9a1e747d1d4fce7d7b300c754a8f3efc693f593ee3ba2cc66e40eedc4",
      "text": "ketan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed06497a55c31987dbbe9c36ecb4ba9858e1522c1f35c062996c4ca6afb9bfda",
      "text": "Menara Kudus kalebu papan kang misuwur ing Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5b0df03e0893f3c97b27c4a0ff84607d072c6e3fac6e7fe34120ab2997cc61",
      "text": "Jalan Pahlawan iku papan kang misuwur ing Madiun.",
      "voice": "jv_dimas",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0a06ab66f7ec3b41f1e5deb9ae540040b7f701267b094e5b894ae50bf682cbf",
      "text": "Madiun iku kutha ing Jawa Timur, adoh saka segara.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9bd00b101e9d043af1224f468e3453a482478ad0908069f63411a1c7b2bd1d0",
      "text": "Ringkesane, Jalan Pahlawan iku papan lawas saka jaman Walanda.",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9ce0e5af09506ffefbc6942f515edb8fbc69328068670e6967b2d7dbee33907",
      "text": "Kudus iku sawijining kutha ing Provinsi Jawa Tengah, ora adoh saka Demak.",
      "voice": "jv_siti",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa32f3a698e8d970048721d1c754dcd5ee8639b3897626a5c09ee3b642b54153",
      "text": "Wah, kowe ngomong kaya Wikipedia! Kairo misuwur minangka apa?",
      "voice": "jv_siti",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcbfca66786991b4e3cf9ec756e5c2fd6def26e22e79b7613aa9e69d6318db4a",
      "text": "segara",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fee581b57885c29dbdc361e1c3853d9a1886c38e7f544ce7370253dc3cc3cdac",
      "text": "wates",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fee847e3503792cbcbb0a6cd5d831266c5eff070a8df8e8b3eba7b7bda4b55a0",
      "text": "Mohamed, iki artikel ngenani Gunung Wilis.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    }
  ],
