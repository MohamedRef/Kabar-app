    },
    {
      "id": "j5.u01.l03",
      "sha256": "b6f3649299cdb175e9be58c58e9026c1ed2db28bdef2e238244f259004450ccf"
    },
    {
      "id": "j5.u01.l04",
      "sha256": "928ba5ca9c61a47b3c406de83dc4d6b2e7541a318565eed898b2e273f5ffab2f"
    },
    {
      "id": "j5.u01.l05",
      "sha256": "1873b553fdc51b95c4e96396aa035f15365e8b37091e2d5194c2a6659f7dfc7e"
    },
    {
      "id": "j5.u01.l06",
      "sha256": "e697d34354cd2d885e79cfa1897532587983ecc96dd25abf30829daec1089775"
    },
    {
      "id": "j5.u01.l07",
      "sha256": "00f801aebc540adf51084abf1f66b25e549c8e8c93c18d92879cbc8028beb147"
    },
    {
      "id": "j5.u01.l08",
      "sha256": "ff0160e4cdaf73c242eb47fa7c0e1037dbaf7bc2d546a0d82f049ea7d92a2f4e"
    },
    {
      "id": "j5.u01.l09",
      "sha256": "df5306bd96c6f2119a26e4a4389c1bd26f05415aeb9100a32145a2dbff2cc25b"
    },
    {
      "id": "j5.u01.l10",
      "sha256": "2c253a08abaf3fb56c342c2c7753539ca9bb45c7a3d788c554c822848b2a164f"
    },
    {
      "id": "j5.u01.l11",
      "sha256": "ca5d7ba9eb54bc4353240b8461406a5027773f590a9fa4fe21098e4ef1347239"
    }
  ],
  "audio": [
    {
      "key": "023d5b8b6116e0462535bd7d811961ea675418d398aa2f1101154a94ea23fb4e",
      "text": "Bener. Saben dina ana sepur menyang Surabaya lan Jakarta.",
      "voice": "jv_siti",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "02f2a101648613d7f0c1e4c3ac78d005204a5c4b44e83d27679371b368c3c950",
      "text": "Semarang iku ibukutha Provinsi Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0858cfac69c570f7b96270016e4c791888cabb167a90a27b91314a6e0d3f0864",
      "text": "tugu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b3796cf0503f316efd5df891a57840ef4df1028e066790635f9757d8909dae5",
      "text": "Lawang Sewu duwe atusan lawang.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b9f36e416d62ff92b479d6b58157dcc4361ed21921d7bb48f9759a3134f15ca",
      "text": "Enak banget! Aku seneng panganan Tionghoa-Jawa iki.",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c06adb04af5ec16066434b3b5d4c37492d1de8d0a4e15bf5f2c89d5c1c927f3",
      "text": "Kutha Lama cedhak saka kene, ta?",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d449a4e94eb0c3dee3e8cb3bfb4ed9c6109b1b148867f895dc4f05720879a33",
      "text": "Iya. Nek ngomong, aku ngomong \"papan sing misuwur neng Semarang\".",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "1184a6f693364e0143477cb71b2451779740c638111f954622575f3731cbe609",
      "text": "Buku riwayat iki awujud komik.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "154a3af70188b76b9b116aadc296bf4810fa3887795ebd30a65e5e278cb2803a",
      "text": "Candhi Gedong Songo iku candhi kuno.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "15df6e96bcebe59ed5d8d892a26276ac0c8c231732aaf0ffa39ccd1b7e410707",
      "text": "Stasiun Tawang iku stasiun sepur kang lawas lan misuwur.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "1818c7b29fcd89d9d1681c0c738c4544fe9b2dace17e0eb75d420167aa80f0ce",
      "text": "Apik tenan. Ayo mrana!",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b1b116356ddf668665a4bfbf9fdddd02b4bf5940e62dc8de51b25bf05b699fe",
      "text": "Aku seneng papan sing lawas.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b5f0a68627746bb7b4da31db72c2485d0a0955f3e112f24dc8cb4c15cc5dc2b",
      "text": "Kairo iku sawijining kutha kang misuwur ing donya.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c90ab14240cff48d9428d2793abe0c1623ec3a341d478edec5a64cfae41215b",
      "text": "Kairo iku ibukutha Mesir lan kutha kang paling gedhe ing Mesir.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d463faddb6e8c542b12256fefe6d1069aecda74e928145e851d693f2da2baef",
      "text": "Ing pinggir pantai ana tebing dhuwur.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d954c13e96dd46d708ad2c6440c505a53aa44054f42b19549b81271b6d56d8d",
      "text": "Mohamed, aku maca artikel Kairo ing Wikipedia basa Jawa.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e85f20590c95f3cc96cec8128134a037f8cda06bc56f40059970e53c92b5eb0",
      "text": "Semarang misuwur minangka Kutha Lumpia.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "21c2a172e002ae9e347858e57596005297efd0b9eedd37cbf3a7e642c6b02bdd",
      "text": "Ing pegunungan akeh sawah pari.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "21dfcf041160bcfa06b435e04e7572a9fa5a2b5061b64e1b891ec701d9ef8073",
      "text": "Tionghoa",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "22b4657ca9431a61cfe5c84546cbe54caf337250c4dbc60b5e8d482b417855ea",
      "text": "Lawang Sewu dibangun ing abad kaping rong puluh.",
      "voice": "jv_siti",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "2342d3e5a7b68cb5673a2271728f7d4b48c89d0498346179ce156bd2501edcc3",
      "text": "Kudus misuwur minangka apa?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "24da898a54477f0e6187b870752a32aa7109c9b9e5a282a9f731663acda701e1",
      "text": "atusan",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d23109d06103c68952144b7e5648181ee7e72a07e2658ac115a459c5294069",
      "text": "sawijining",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "26426b5db109b9642ecdf89c0d67b1188222051d9199c9e3f8a05c3545205e83",
      "text": "Mohamed, wis maca riwayat Lawang Sewu ing Wikipedia?",
      "voice": "jv_siti",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2742efb17f1b2670afed730ed33ffee26db4a2408157bdddefc5e9018d258218",
      "text": "Ing kono ana gedhong-gedhong lawas saka jaman Walanda.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a57cf5bcc942676d900a6674c32a975cf78cdfb69509bf0a3771cde8becac0a",
      "text": "Kairo iku kutha kang paling gedhe ing Mesir, ing pinggir kali Nil.",
      "voice": "jv_siti",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "2aac7a01644913ec2b2be499a6945f3af40e9528882a2436252f80e076da586c",
      "text": "tumbuhan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bbeba9397e0d1f54e8874803a960c42ff142253d1596e1c836a52feccd96388",
      "text": "Satus taun iku siji ___.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d2d0ddccb317ac8fdc901560781320a41120a26b36c1f82969fa78b3fd1e017",
      "text": "yaiku",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d9f5e3919a938429a4e25276bc44e8b04c3691b73bb2a9522c599670c1dfc6b",
      "text": "Mbak, lumpia iki isine apa?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "33dda04885d9fc9fea90405e6b2c924ae042567baf07b3edfbe137db82b8071b",
      "text": "Gedhong iki anyar, dudu lawas.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "376cd6ac7df72256a5685caf761cf66b772230805217976b5e7e52338579bfc5",
      "text": "Minangka Kutha Sewu Menara. Sewu, kaya Lawang Sewu!",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf9a3d17240c2ce3b8fb866230bb4c3e12f192ad4c250e80739aa33ea10f0c0",
      "text": "anyar",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e77abd094d9df59134c1c0458c45a244ece2f1f016094e7eeceae5b200f2045",
      "text": "Stasiun Tawang iku stasiun sepur kang lawas.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4258aa1cfe60f01faa0f786be5dcec48e0af909965321213e3c8a6750a259bdb",
      "text": "kawasan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "429772132216caeb9e92460b1e6516fae4755c23e4832dd313b8b910d61c512b",
      "text": "penutur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ccd669278cd478faa5277e5be51c67712b611f9b5dad5b212a7a2de30b023d",
      "text": "pesisir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d26b24bd678c4b55876739ea8a2fef2e3ea347836044495bea593c013cd131",
      "text": "Ing Semarang ana papan-papan kang misuwur, yaiku Kutha Lama, Lawang Sewu lan Simpang Lima.",
      "voice": "jv_siti",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "47946a92cf0155ea91295c7d80ae18edda175d0581a1b6a910bc7d400287aa69",
      "text": "Kutha Lama iku papan kang lawas ing Semarang.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "488d9513ef07ab2b91016848f1bfed8401d7e01ce9c7fdb8ed29f568b68ca725",
      "text": "Ayo mrana sesuk!",
      "voice": "jv_dimas",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "495dda3f1b189560590382cc2109040c6a11a70132911572fff4f619113ced16",
      "text": "Stasiun iki ana ing cedhak Kutha Lama, ora adoh saka pesisir lor.",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a6556ecd367e55c004112c968e048edbbc225c28ecc88284379f52900259e97",
      "text": "Lumpia iku sawijining panganan Tionghoa kang wis dadi panganan Jawa.",
      "voice": "jv_siti",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ab2ec52443ba5fc2b7b186eb312e7c3914162404e62d1d48a94b2138c58581b",
      "text": "Semarang iku sawijining kutha gedhe ing Indonesia.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c0f72d0877a4b73affa30d5b964ab91128436feeef8c1461bf0889fe3f64004",
      "text": "wit-witan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fc601a44ec4d789ddbfe57062a22f11210f880562017aa07347a494ac667b93",
      "text": "Oh, kang iku sing, ing iku neng.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "503a17258bfe31c75785c43a8f72fd1197d6895e25d0ee2351fd9f6d20637dea",
      "text": "provinsi",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "503f2cb03809e67822652cb8ae2b1069d6f0379067214fd083bac815d7ddf237",
      "text": "Segara Jawa adoh saka kene?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5156578de80589fe793536a59a24da5cfe5bbdc670bf55380fdd117a875cefcf",
      "text": "Semarang iku ibukutha Provinsi Jawa Tengah. Lho, iki ngoko, ya?",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "546e63beeeebd3c28d6abcdd4d4df022feb343ec19360d865da077de285f9d7d",
      "text": "Rebung? Ing basa Indonesia uga rebung, ta?",
      "voice": "jv_dimas",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5534413e13f6632ad0c56ba1c2e75b511799dc8524130d108a157973a3cb9b55",
      "text": "Iya. Kairo kalebu kutha gedhe ing donya.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c8ef501f9cef1958680ffc658e15672ef18d57cc5b466fa54344eeac4e810b",
      "text": "papan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "593431f774d1a33b3d7d72ad5c1aebeb20aecbf2440ad3301c7b2595e36551ea",
      "text": "Mohamed, iki Wikipedia basa Jawa. Wacanen!",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ad2e7da674631710f1e88c036b0ba8916c59cce2d3d8f182fd0c85ecd2c7cbd",
      "text": "Aku saka Kairo, ibukutha Mesir, ing pinggir kali Nil.",
      "voice": "jv_siti",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cd5710e913a689696b08e01ea368e61f120eef2dff90a8eb870764a2191104d",
      "text": "tebing",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "60020743a26aa1567676b70c5d504cc64235a3d9a3c51576d42b401309712fa2",
      "text": "Wis. Gedhung iku dibangun ing abad kaping rong puluh, ta?",
      "voice": "jv_dimas",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "61118c216a34dd58a13036074b91894512e4779ad9a1be426100d5f63a7d54cb",
      "text": "Isine rebung, endhog lan udang.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "61596a5931ddbf485423845824d272fcd449741e1173e66307fe03e6a28aafb7",
      "text": "Iya, ngoko, nanging basa tulis. Iku ing kene padha karo \"adalah\".",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "623606eb87b69b0ad9c405ca1a2c382168bf7197f5e8a3d8c553b0423b39d6c7",
      "text": "Bener! Lan saiki awake dhewe ana ing Tawang.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "631184216605f87138308917649328a36803f668cecac1a1f4cc498b9102d7e6",
      "text": "ringkesan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "63c0889f027b06e5b860fe680da21f3d44d8da5b4583e1f873c569f2ca99a56e",
      "text": "Semarang iku ibukutha Provinsi Jawa Tengah, ana ing pinggir Segara Jawa.",
      "voice": "jv_siti",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "64f62faff6263dd41743131478ce32fa4628e2308583f3071be18d0acc518bd9",
      "text": "minangka",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6575107cef420e2ba01b5c50fefce22163af2e3b5318d460844d34d321946286",
      "text": "Akeh manuk. Nanging ati-ati, ana tebing.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b5be2e340f4ba8b75195bbe15bdde06974648836a6bd9bff381e265e0664afa",
      "text": "abad",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ba9eed76bb6dd517e53d2ac5d90728e7a105bdbfa9ff43f7f32f0efd6ca7e23",
      "text": "Ing kawasan iki akeh wit-witan, tumbuhan lan satwa.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cbb106da1f7b68bb59f611fd99ab0b5f0c1e49f86770a19fb95ded917f5ed2c",
      "text": "Mbak, artikel iki ngomong ana papan misuwur telu ing Semarang.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "74593b29c3ba29ed1bb517eedf667b626dcca0083d4f00f97ee1e8e6a7a24bbe",
      "text": "Lawang Sewu duwe atusan lawang lan cendhela.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "74c01db6c42c0f5b661ad73207a05b9169a4d164406b118cbc30c20668064521",
      "text": "sepur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7603b44f77ddc671ea42ebeef91fe70617218707bb11844f30dd5cc53d197c0e",
      "text": "Kudus iku sawijining kutha ing Provinsi Jawa Tengah, ora adoh saka Semarang.",
      "voice": "jv_siti",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "762d139a02ee101bfb03bb860b96ff0e9280345daab0f2076bc5f06d44216c55",
      "text": "Kali iki dadi wates desa loro.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aa3a5777969883807bc40965d65946b77f9f90085f464c7869b5e493037818b",
      "text": "pari",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c27093cb17f1784ecd91d8c14f430971bd0cd2476f2adfc9e493796df10ee58",
      "text": "Mohamed, wacanen artikel iki ing sepur. Iki artikel Kudus.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8134beb41cd9184077e2c459010e109ec98d126cbee0a1716702f0563e2ea35b",
      "text": "Wis maca artikel Kutha Lama? Ringkesane apa?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "82991d186eee0d6c61f64a93f2d770b3663fbc0b0aa39129d33f2f2c487d3785",
      "text": "Semarang duwe stasiun gedhe loro, yaiku Tawang lan Poncol.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "838fd28eb085a0b32349aa4393f0bc656b3f78eb8f9897f11056c3e90517aa5a",
      "text": "Ana telung puluh turis ing museum. Ana ___ turis.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8440b7edab62d864a32f749e0d1fb4e154f85b2ee0bdb00b849c8d2bcd5bd18c",
      "text": "Semarang duwe stasiun gedhe loro, yaiku Tawang lan Poncol. Yaiku padha karo \"yaitu\"?",
      "voice": "jv_dimas",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "84438b312763a330493e124e24009388c1c461dbaa305eb46ce827cdaa291cfe",
      "text": "Mbak, artikel iki ngomong saka Tawang ana sepur menyang Surabaya.",
      "voice": "jv_dimas",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e823f9717a6e004f6373be9a23d0d2725c7c3467e589eaac694b4564f5e345",
      "text": "Stasiun Tawang ana ing cedhak Kutha Lama.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "85f10e2c56ad18ae1b4a89207a0f6ff5e99b16e7eb82e810cf1b423fa2245992",
      "text": "Kutha iki ana ing pinggir kali Nil.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "88215da01b6bc5ad4a6ab2abf9d81c23c84b11cb122472e76506d4263c99906a",
      "text": "awujud",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "88e3f0724980d7a4abcc55f3411022a7faa35946135002c611a11dc0d044ad55",
      "text": "Puluhan turis teka menyang candhi kuno iku.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8933613b48128f5ea4a56dd831e372d6508ad97af7935b7efd1ea28ea4da12f2",
      "text": "Bener. Lan saiki piye?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a4f2ec601097fb21bf2858b72da0f39d39d47ebe4ca2693ed3477a03d477de2",
      "text": "Stasiun Tawang iku stasiun sepur kang misuwur ing Semarang.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf8a8ef8433c7cc1dc98dbefdc804c99f3e1c3e79247d8a2c904ffa3f33f30d",
      "text": "Wah, aku uga arep dolan menyang Kairo!",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c3d625a21f0f770c839f13aeae10ebe8a73059b4ff2056f39f76cef75dfa80c",
      "text": "rebung",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f745f8f9ab94f9c888ae66a085bf4b9602aaa4849721076bf4a32160a6e7101",
      "text": "misuwur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "955b8c5fbedf8ce8b7886d70cdefe7300a9a60fbf4713686c47c9c61f1095cb4",
      "text": "Pinter! Saiki kowe bisa maca Wikipedia basa Jawa.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "95c56c990124fdce8fcd75ea8347170121af608d0420872dc22723147cff7542",
      "text": "Saka Tawang ana sepur menyang kutha-kutha gedhe, yaiku Jakarta lan Surabaya.",
      "voice": "jv_siti",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a2a821a3a1be22e2de106f1b9ff522ef69a9a6976d31dcda7a51c5bc60cf450",
      "text": "Kutha iki ana ing pesisir lor pulo Jawa, ing pinggir Segara Jawa.",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c75f954c0ccc2c74b3e4758cac63cc669fbd7a2f99801842aa3532d16421b5f",
      "text": "donya",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3bd410426e24d787f2d62e98354a40e8345a6d69bfbd16427a378de35410635",
      "text": "lambang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a521a32302f6ea5983b5b6d78d14098d0f2ca23670db89824fffc9e7c1571e98",
      "text": "Ayo menyang Simpang Lima, banjur mangan lumpia!",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa93af574e2138bbf6d8323431e6df32c4fb8804bf192a09f1a682aaf930b12f",
      "text": "Bener! Gedhong-gedhong neng kene lawas banget.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac2eeb9f0278fa3391eed8fa7fe0240a820fb726a2a7f93dbe63c7d0c54375d1",
      "text": "Mohamed, iki artikel babagan Gunung Ungaran.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "adc6a6e48893b06c516577483fb762ed97e2f55989a285b2360a548c612900af",
      "text": "Macan, gajah lan manuk kalebu ___.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae0efe9fe018888987218373c9fce649d32b49c4a27c8f63ae4a8883ffc41dd1",
      "text": "Lawang Sewu ana ing tengah kutha Semarang.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "af50b3eeed393a23f2f1d2549b5f62917c5e34b51e4c5b247fff9fadcd90ec51",
      "text": "Basa Jawa kalebu basa kang akeh penuture ing donya.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7d0f1e8821d848da6d757c6512a92f80d33420cb9549285f5bb186241ba371",
      "text": "kidul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7dec8fa50e3bb2f106e59b00fd7a762e923ec96a659d17c81f77c773736431",
      "text": "Dieng iku kawasan pegunungan sing adhem.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0689dcc340fdbd0c2abecb953cb9869a59a8a9d4823adf47ea7381a1ae50c37",
      "text": "Ing Kudus ana menara lawas kang misuwur, yaiku Menara Kudus.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0803cde8f68522110db8acac66ae03ee98c32dfcc62dd2970d80420bf571089",
      "text": "Satwa lan tumbuhan ing kawasan iki dijaga.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0886482c1fd253a2add9fd8609dd7102e8a1fe0dcd78288e307aafa25f1c2ac",
      "text": "Ing sisih kidul. Kawasan pegunungan iku akeh wit-witan.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1e3f8de2b757d72e30f39ce7348b6466b27db068e97405898dd1b4b1f03a643",
      "text": "Ana satwa apa wae?",
      "voice": "jv_dimas",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "b240c02d564f8da4e3b65fa2104e8afedd1850527fd90753754395a9e285463a",
      "text": "Bener. Omahku ora adoh saka kali Nil.",
      "voice": "jv_dimas",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8689b6f63949c7ea468242134d9cc3e0c21b8d659a37c187d5a3ac30fc8d64d",
      "text": "Kudus iku sawijining kutha ing Jawa Tengah. Gampang!",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd9f1bda3f8e558a7713f3ef01045a96d046c1f2a2acc4734f9b9aaf159eb5c7",
      "text": "puluhan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdccdb7e7477921f4a9cb397d1deea7139cf0e20ad35bdc2489fe25c4c36afd7",
      "text": "Ana menara lawas kang misuwur, yaiku Menara Kudus.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "be51a1ee91f50c2d4aadfe317bf372c1b28591f91c2949a188a5a5ff5035d85a",
      "text": "Ing Kairo ana masjid kang lawas banget, yaiku Masjid Al-Azhar.",
      "voice": "jv_siti",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "becc8b6778e238fb3b8d58fef3ade399d9fb0e6cbae6123977588aa5d42a896b",
      "text": "Mohamed, Kairo iku kutha gedhe, ta?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1be0f3d54118b74a487fb916d99e64aefc350a3b6f5b6e7389b2e1a58bead87",
      "text": "Iya. Lawange ora sewu, nanging atusan.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2d607ddafd5c7cf40ed8f55dc0e5c6a3ac4e97f3a74c3f1a864a23e0b802edb",
      "text": "kali",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2e8957bad8e507080ecd76fa798c0a13c32aa6ba124ef409d2ae314d0848ace",
      "text": "ana ing",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c37949e1b9a2160052a9fe532afee98bac15d405d03db089abe25dcb98393c96",
      "text": "lawas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3dbe7a8126c6c920399a3e34d463c28e0f0a8e716ed4d7a3682a2f27e9dbc32",
      "text": "Kairo misuwur minangka Kutha Sewu Menara.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3f16f99f255516b4c9d6cba9cbc663521fb77742fccffb2bc703ef9cbb12c0a",
      "text": "Walanda",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c51808ab6c7d1aaa6ca319febbc4ddc2d095bee6807006f0a7c70cc2a634ebd0",
      "text": "kalebu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c541c41f541cdfef79aa92a298b8655429f23dcf5e1306c0dd25b46adde0243a",
      "text": "isi",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5ade6f06d60d2b903571c2a0999571cded5cfea9ad2f7d38503cccf727cd807",
      "text": "kuno",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9e1197acc2f7306c469a22501d8b3cd25263177344601d2ec81a737951ed3f2",
      "text": "Kutha Lama iku papan kang misuwur ing Semarang.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb7d964dbf0359460fa71d7d637865f6dce3b0d40a5cb412355f72799e015a7d",
      "text": "kang",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce2164e8195be006542ae234d5dfd1b4a99f4198dc8661e36b034a3b827aed37",
      "text": "pulo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce57d56ef17014eb0a9d3fe5498eea56ed2215a6b102fcfbf989730d08855c2c",
      "text": "Kutha Lama iku papan lawas saka jaman Walanda.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf1fce6c09a646cce6c72a11d0eeffbd9aab509a28982669146a8810114a46ce",
      "text": "riwayat",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf28c6b033f9ef857a31ba7f6400ae17d0341f7c17bb8b6bb25f4382b4e4964f",
      "text": "ibukutha",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14850b7d434d805720a9ed47a63968e4d5699bcb8f50b23b61b1e1dad408623",
      "text": "lor",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d281591470cfdd8f45c462b33638e640bca93b26c73ff43875e4c7078873471d",
      "text": "Tenan? Artikele ngomong apa?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d29369aaacf344210c3e7507b288e5d02d92579083d707cc8b98f07a0f5a65d0",
      "text": "Iya, padha. Ayo mangan!",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4b8971f7505f648dbd584e59bf738a7489c7ac5dfb2b05808d7e0c38e14d738",
      "text": "Ayo! Aku seneng gedhong-gedhong lawas.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d62d146d8519d1025bf563512235bcc98951c29a13daaf2879b5596a70e59a92",
      "text": "Ana ing sisih ngendi saka Semarang?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "d743377062c941fe021189a13cfded563f914d881f7be2517e9f1d2b782c857e",
      "text": "pegunungan",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d931a3ad7a9cddaa915d4fad92d58b47be567c47390921f9085487bd29108e4f",
      "text": "Kutha Lama iku papan kang misuwur ing Semarang.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d98388ccf5303a4435f7045a76e76670710b69d9fd00129c5d769610411c99ea",
      "text": "Lumpia iku panganan kang misuwur saka Semarang.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc92b11e9a6a4b21d6bd89cb6a13e8820a68adec909bdd8d759bd1c34def398d",
      "text": "satwa",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd33b9b7397f368d9c4b746092f67b7b1acf736ada9e20471bc5071a19d6c2f4",
      "text": "jaman",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1b92a87bb72b905f3e4bb808f14fc9bd1967586ed1b1baefd9c2d3af624482c",
      "text": "Kudus iku kutha ing Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1be1152f988b84513ce98a85542c88acf4ce7e050021507177151630ce62213",
      "text": "Kutha iki ana ing pesisir lor pulo Jawa.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e858a883a5310949abe2216d620b2eae6df8ad3af0914ec0533bc3c7f8ae1e73",
      "text": "Cedhak banget. Mlaku wae, ora adoh.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e975c6c99835dcc8962ce0eb0d152902dc6de416fae6d144b113272fffa7fac6",
      "text": "Ringkesane, Kutha Lama iku papan lawas saka jaman Walanda.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9a53a5e6cd1025a276bd19865e41f1117a2107aaba12aad162f4e81c8a2e900",
      "text": "Tugu Muda, lambang perang limang dina ing Semarang.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec1855c96bdbbfbae435b9a79e7a9b8986a2c4429f1d3438df181814440c03f1",
      "text": "Saiki dadi papan wisata kang misuwur. Eh, papan wisata sing misuwur!",
      "voice": "jv_dimas",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed06497a55c31987dbbe9c36ecb4ba9858e1522c1f35c062996c4ca6afb9bfda",
      "text": "Menara Kudus kalebu papan kang misuwur ing Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee09d78918afc7ae1f816aeb6d37f56cd87ca7c3f3da357eeb0683486831b4ed",
      "text": "Lha, tugu sing ana ing ngarepe iku apa?",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5d374dcce18d509e447b902cfe46f151282dd594fa532817a3b30461b9cdfe",
      "text": "Ora adoh. Semarang iku kutha pesisir.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
