{
  "format": 1,
  "id": "jv/j5.u01",
  "language": "jv",
  "unit": "j5.u01",
  "version": 1,
  "content_hash": "775d4dd3b1b4869cd8ca705129aa31b5df4201519b6b76fba438ca425b208657",
  "lessons": [
    {
      "id": "j5.u01.l01",
      "sha256": "1d2b2b2bd41f958c5fdfc9f1d7d131fe42aefb6d8f422e016e87c767e3fe00f8"
    },
    {
      "id": "j5.u01.l02",
      "sha256": "7039f9981f0c53cad52b6e9125baed951f8de01d70cbb0ac7fa95b484524e42f"
    },
    {
      "id": "j5.u01.l03",
      "sha256": "b6f3649299cdb175e9be58c58e9026c1ed2db28bdef2e238244f259004450ccf"
    },
    {
      "id": "j5.u01.l04",
      "sha256": "643bfd256214b17539789953d582ea32948527281d5edf103de44ede45406596"
    },
    {
      "id": "j5.u01.l05",
      "sha256": "d8797f618ac2aa130a9724aa55185cc9aaeeef5cbf81159ca866e312b23cc887"
    },
    {
      "id": "j5.u01.l06",
      "sha256": "f2bec11772370f002fdd95b03094033e411acae7005fbb7414f91fb47b8ad9ea"
    }
  ],
  "audio": [
    {
      "key": "02f2a101648613d7f0c1e4c3ac78d005204a5c4b44e83d27679371b368c3c950",
      "text": "Semarang iku ibukutha Provinsi Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d449a4e94eb0c3dee3e8cb3bfb4ed9c6109b1b148867f895dc4f05720879a33",
      "text": "Iya. Nek ngomong, aku ngomong \"papan sing misuwur neng Semarang\".",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "15df6e96bcebe59ed5d8d892a26276ac0c8c231732aaf0ffa39ccd1b7e410707",
      "text": "Stasiun Tawang iku stasiun sepur kang lawas lan misuwur.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b1b116356ddf668665a4bfbf9fdddd02b4bf5940e62dc8de51b25bf05b699fe",
      "text": "Aku seneng papan sing lawas.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b5f0a68627746bb7b4da31db72c2485d0a0955f3e112f24dc8cb4c15cc5dc2b",
      "text": "Kairo iku sawijining kutha kang misuwur ing donya.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e85f20590c95f3cc96cec8128134a037f8cda06bc56f40059970e53c92b5eb0",
      "text": "Semarang misuwur minangka Kutha Lumpia.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2342d3e5a7b68cb5673a2271728f7d4b48c89d0498346179ce156bd2501edcc3",
      "text": "Kudus misuwur minangka apa?",
      "voice": "jv_siti",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d23109d06103c68952144b7e5648181ee7e72a07e2658ac115a459c5294069",
      "text": "sawijining",
      "voice": "jv_siti",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2742efb17f1b2670afed730ed33ffee26db4a2408157bdddefc5e9018d258218",
      "text": "Ing kono ana gedhong-gedhong lawas saka jaman Walanda.",
      "voice": "jv_siti",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d2d0ddccb317ac8fdc901560781320a41120a26b36c1f82969fa78b3fd1e017",
      "text": "yaiku",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "376cd6ac7df72256a5685caf761cf66b772230805217976b5e7e52338579bfc5",
      "text": "Minangka Kutha Sewu Menara. Sewu, kaya Lawang Sewu!",
      "voice": "jv_dimas",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e77abd094d9df59134c1c0458c45a244ece2f1f016094e7eeceae5b200f2045",
      "text": "Stasiun Tawang iku stasiun sepur kang lawas.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "429772132216caeb9e92460b1e6516fae4755c23e4832dd313b8b910d61c512b",
      "text": "penutur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ccd669278cd478faa5277e5be51c67712b611f9b5dad5b212a7a2de30b023d",
      "text": "pesisir",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d26b24bd678c4b55876739ea8a2fef2e3ea347836044495bea593c013cd131",
      "text": "Ing Semarang ana papan-papan kang misuwur, yaiku Kutha Lama, Lawang Sewu lan Simpang Lima.",
      "voice": "jv_siti",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "47946a92cf0155ea91295c7d80ae18edda175d0581a1b6a910bc7d400287aa69",
      "text": "Kutha Lama iku papan kang lawas ing Semarang.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ab2ec52443ba5fc2b7b186eb312e7c3914162404e62d1d48a94b2138c58581b",
      "text": "Semarang iku sawijining kutha gedhe ing Indonesia.",
      "voice": "jv_siti",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fc601a44ec4d789ddbfe57062a22f11210f880562017aa07347a494ac667b93",
      "text": "Oh, kang iku sing, ing iku neng.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "503a17258bfe31c75785c43a8f72fd1197d6895e25d0ee2351fd9f6d20637dea",
      "text": "provinsi",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "503f2cb03809e67822652cb8ae2b1069d6f0379067214fd083bac815d7ddf237",
      "text": "Segara Jawa adoh saka kene?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5156578de80589fe793536a59a24da5cfe5bbdc670bf55380fdd117a875cefcf",
      "text": "Semarang iku ibukutha Provinsi Jawa Tengah. Lho, iki ngoko, ya?",
      "voice": "jv_dimas",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5534413e13f6632ad0c56ba1c2e75b511799dc8524130d108a157973a3cb9b55",
      "text": "Iya. Kairo kalebu kutha gedhe ing donya.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c8ef501f9cef1958680ffc658e15672ef18d57cc5b466fa54344eeac4e810b",
      "text": "papan",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "593431f774d1a33b3d7d72ad5c1aebeb20aecbf2440ad3301c7b2595e36551ea",
      "text": "Mohamed, iki Wikipedia basa Jawa. Wacanen!",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "61596a5931ddbf485423845824d272fcd449741e1173e66307fe03e6a28aafb7",
      "text": "Iya, ngoko, nanging basa tulis. Iku ing kene padha karo \"adalah\".",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "623606eb87b69b0ad9c405ca1a2c382168bf7197f5e8a3d8c553b0423b39d6c7",
      "text": "Bener! Lan saiki awake dhewe ana ing Tawang.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "631184216605f87138308917649328a36803f668cecac1a1f4cc498b9102d7e6",
      "text": "ringkesan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "63c0889f027b06e5b860fe680da21f3d44d8da5b4583e1f873c569f2ca99a56e",
      "text": "Semarang iku ibukutha Provinsi Jawa Tengah, ana ing pinggir Segara Jawa.",
      "voice": "jv_siti",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "64f62faff6263dd41743131478ce32fa4628e2308583f3071be18d0acc518bd9",
      "text": "minangka",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cbb106da1f7b68bb59f611fd99ab0b5f0c1e49f86770a19fb95ded917f5ed2c",
      "text": "Mbak, artikel iki ngomong ana papan misuwur telu ing Semarang.",
      "voice": "jv_dimas",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "74c01db6c42c0f5b661ad73207a05b9169a4d164406b118cbc30c20668064521",
      "text": "sepur",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7603b44f77ddc671ea42ebeef91fe70617218707bb11844f30dd5cc53d197c0e",
      "text": "Kudus iku sawijining kutha ing Provinsi Jawa Tengah, ora adoh saka Semarang.",
      "voice": "jv_siti",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c27093cb17f1784ecd91d8c14f430971bd0cd2476f2adfc9e493796df10ee58",
      "text": "Mohamed, wacanen artikel iki ing sepur. Iki artikel Kudus.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8134beb41cd9184077e2c459010e109ec98d126cbee0a1716702f0563e2ea35b",
      "text": "Wis maca artikel Kutha Lama? Ringkesane apa?",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "82991d186eee0d6c61f64a93f2d770b3663fbc0b0aa39129d33f2f2c487d3785",
      "text": "Semarang duwe stasiun gedhe loro, yaiku Tawang lan Poncol.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8440b7edab62d864a32f749e0d1fb4e154f85b2ee0bdb00b849c8d2bcd5bd18c",
      "text": "Semarang duwe stasiun gedhe loro, yaiku Tawang lan Poncol. Yaiku padha karo \"yaitu\"?",
      "voice": "jv_dimas",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "8933613b48128f5ea4a56dd831e372d6508ad97af7935b7efd1ea28ea4da12f2",
      "text": "Bener. Lan saiki piye?",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f745f8f9ab94f9c888ae66a085bf4b9602aaa4849721076bf4a32160a6e7101",
      "text": "misuwur",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "955b8c5fbedf8ce8b7886d70cdefe7300a9a60fbf4713686c47c9c61f1095cb4",
      "text": "Pinter! Saiki kowe bisa maca Wikipedia basa Jawa.",
      "voice": "jv_siti",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a2a821a3a1be22e2de106f1b9ff522ef69a9a6976d31dcda7a51c5bc60cf450",
      "text": "Kutha iki ana ing pesisir lor pulo Jawa, ing pinggir Segara Jawa.",
      "voice": "jv_siti",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c75f954c0ccc2c74b3e4758cac63cc669fbd7a2f99801842aa3532d16421b5f",
      "text": "donya",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a521a32302f6ea5983b5b6d78d14098d0f2ca23670db89824fffc9e7c1571e98",
      "text": "Ayo menyang Simpang Lima, banjur mangan lumpia!",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa93af574e2138bbf6d8323431e6df32c4fb8804bf192a09f1a682aaf930b12f",
      "text": "Bener! Gedhong-gedhong neng kene lawas banget.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae0efe9fe018888987218373c9fce649d32b49c4a27c8f63ae4a8883ffc41dd1",
      "text": "Lawang Sewu ana ing tengah kutha Semarang.",
      "voice": "jv_siti",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "af50b3eeed393a23f2f1d2549b5f62917c5e34b51e4c5b247fff9fadcd90ec51",
      "text": "Basa Jawa kalebu basa kang akeh penuture ing donya.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "af7d0f1e8821d848da6d757c6512a92f80d33420cb9549285f5bb186241ba371",
      "text": "kidul",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0689dcc340fdbd0c2abecb953cb9869a59a8a9d4823adf47ea7381a1ae50c37",
      "text": "Ing Kudus ana menara lawas kang misuwur, yaiku Menara Kudus.",
      "voice": "jv_siti",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8689b6f63949c7ea468242134d9cc3e0c21b8d659a37c187d5a3ac30fc8d64d",
      "text": "Kudus iku sawijining kutha ing Jawa Tengah. Gampang!",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdccdb7e7477921f4a9cb397d1deea7139cf0e20ad35bdc2489fe25c4c36afd7",
      "text": "Ana menara lawas kang misuwur, yaiku Menara Kudus.",
      "voice": "jv_dimas",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "becc8b6778e238fb3b8d58fef3ade399d9fb0e6cbae6123977588aa5d42a896b",
      "text": "Mohamed, Kairo iku kutha gedhe, ta?",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2e8957bad8e507080ecd76fa798c0a13c32aa6ba124ef409d2ae314d0848ace",
      "text": "ana ing",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c37949e1b9a2160052a9fe532afee98bac15d405d03db089abe25dcb98393c96",
      "text": "lawas",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3dbe7a8126c6c920399a3e34d463c28e0f0a8e716ed4d7a3682a2f27e9dbc32",
      "text": "Kairo misuwur minangka Kutha Sewu Menara.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3f16f99f255516b4c9d6cba9cbc663521fb77742fccffb2bc703ef9cbb12c0a",
      "text": "Walanda",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c51808ab6c7d1aaa6ca319febbc4ddc2d095bee6807006f0a7c70cc2a634ebd0",
      "text": "kalebu",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9e1197acc2f7306c469a22501d8b3cd25263177344601d2ec81a737951ed3f2",
      "text": "Kutha Lama iku papan kang misuwur ing Semarang.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb7d964dbf0359460fa71d7d637865f6dce3b0d40a5cb412355f72799e015a7d",
      "text": "kang",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce2164e8195be006542ae234d5dfd1b4a99f4198dc8661e36b034a3b827aed37",
      "text": "pulo",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce57d56ef17014eb0a9d3fe5498eea56ed2215a6b102fcfbf989730d08855c2c",
      "text": "Kutha Lama iku papan lawas saka jaman Walanda.",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf28c6b033f9ef857a31ba7f6400ae17d0341f7c17bb8b6bb25f4382b4e4964f",
      "text": "ibukutha",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14850b7d434d805720a9ed47a63968e4d5699bcb8f50b23b61b1e1dad408623",
      "text": "lor",
      "voice": "jv_siti",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d931a3ad7a9cddaa915d4fad92d58b47be567c47390921f9085487bd29108e4f",
      "text": "Kutha Lama iku papan kang misuwur ing Semarang.",
      "voice": "jv_dimas",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd33b9b7397f368d9c4b746092f67b7b1acf736ada9e20471bc5071a19d6c2f4",
      "text": "jaman",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1b92a87bb72b905f3e4bb808f14fc9bd1967586ed1b1baefd9c2d3af624482c",
      "text": "Kudus iku kutha ing Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1be1152f988b84513ce98a85542c88acf4ce7e050021507177151630ce62213",
      "text": "Kutha iki ana ing pesisir lor pulo Jawa.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e975c6c99835dcc8962ce0eb0d152902dc6de416fae6d144b113272fffa7fac6",
      "text": "Ringkesane, Kutha Lama iku papan lawas saka jaman Walanda.",
      "voice": "jv_siti",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec1855c96bdbbfbae435b9a79e7a9b8986a2c4429f1d3438df181814440c03f1",
      "text": "Saiki dadi papan wisata kang misuwur. Eh, papan wisata sing misuwur!",
      "voice": "jv_dimas",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed06497a55c31987dbbe9c36ecb4ba9858e1522c1f35c062996c4ca6afb9bfda",
      "text": "Menara Kudus kalebu papan kang misuwur ing Jawa Tengah.",
      "voice": "jv_siti",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5d374dcce18d509e447b902cfe46f151282dd594fa532817a3b30461b9cdfe",
      "text": "Ora adoh. Semarang iku kutha pesisir.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f28e489121c9683cbf8e8f3f5ff759d789ceb93377aed2981a4f57aa2570b477",
      "text": "Apik! Ringkesanmu cekak lan bener.",
      "voice": "jv_siti",
      "chars": 34,
