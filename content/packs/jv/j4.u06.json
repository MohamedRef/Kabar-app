    },
    {
      "id": "j4.u06.l12",
      "sha256": "881d7f98b09d87accfaa7de9f8bfdbf01a1ffe2d477ef4e91a7e633d6371184d"
    }
  ],
  "audio": [
    {
      "key": "02e33ac07dd360d1fef24109d58ded13864cd9fb99696c5ae237092e98ccb761",
      "text": "Simbah ___ nonton adegan ingkang sedhih.",
      "voice": "jv_siti",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "057d6046a9d1d349b5dd6f3638dcaf078eef7788b022ecbd5724828cd3972bec",
      "text": "blencong",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "075ba9b35a6552e75fd6bf90fa109b73c2b4ed72050cc2fbd3303e82b69f443f",
      "text": "gong",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb1562243109601866346e208fe1bbd6c31972bcdf99428b734b701e64d0b43",
      "text": "Wah, gongipun ageng sanget, Mbah!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0defed767fa34b785015f52aa8e60491f133aeb15124f19d47b0129b90404d01",
      "text": "sekti",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "10702c85ba886c427f496d9f2283dda5c124c40ef13bac398fa2aaa56f7bdc69",
      "text": "Gunungan metu yen wayang wiwit lan rampung.",
      "voice": "jv_dimas",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "10dad9948d87d25bfdf0939b88e324f3595b8274a120bab5f4f5733cfda6e746",
      "text": "bonang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1561a10c20f53a72400aba05cd520cb153669242055bda79777abb2aa47e1b71",
      "text": "pelog",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "16f9ceee203ac126a41414f3caf81d12d2a4711f280f7948644e34637ef99b14",
      "text": "Mas Dimas nabuh bonang.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "16feb3344d3681e0ae0bba62d6a2778e994f6aabfac903a9c9206825fcefd2e8",
      "text": "dhalang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e3132d5cb4a6324fd421d81d12ff6d6cf5778ba9ebbe136199e646e6aec666f",
      "text": "Aku seneng gamelan. Kendhang, saron lan gong.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "208c6f7cf5b6b163ebc08f96e75f8615df5dcfda8c9aac4cc5678d29d67599cd",
      "text": "Semar, Gareng, Petruk lan Bagong iku punakawan.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "20b71b536b4ba528d42212c11fdbf7461f9842b6365c79c58a09c8b574054fe1",
      "text": "Saking Bantul, Pak. Panjenengan kersa mirsani?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "21271a9ff7f7530af339f5319187505ee42ba4d6728e0545aac7801756013d65",
      "text": "Reng, kowe wis mangan durung?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2553d0dc85284ab73292e88fef275022a102d4fb440e59ed54540591eefba904",
      "text": "punakawan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2769d7aeffcbf312a4bd1acd950d298532e91ef17b3407338f16de59eeb0eee6",
      "text": "Arjuna ngasta keris.",
      "voice": "jv_siti",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "286d0e823759fd3b14ce3b2462f62896854bd0d629e1ec188364fa270b399c86",
      "text": "Mangga, Pak. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "290b01d69893f0bc41e5d841b2742a2f18f776108d5c92eb7d335f51d0162d55",
      "text": "Mohamed, bengi iki ana wayang kulit. Kowe arep nonton?",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "293a23e3dff818ff11df72d236c2cec4f885c392981824bcad51fecc2f57f2b1",
      "text": "Nyuwun pangapunten, Gusti. Kula badhe matur.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2942738c90565eda79655e6a7a9969a8f1b214505f9b71117782d0d54cae2e59",
      "text": "Sapa sing paling apik?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dff67cfd812bb131e5ef938ccef6d4fa6d0984535e5fad107c4af89a7a09e6f",
      "text": "keris",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e47fb522d1719dd0b6882be89a14a970a9032c9ffbebc1945a8836567117f86",
      "text": "Arjuna iku satriya Pandhawa.",
      "voice": "jv_siti",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3288f52ddfb79e3a2d3b28b524646a5961229f85624f60566260b61e82a55300",
      "text": "Ngerti! Rahwana nyulik Sinta, digawa menyang Alengka.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "32e2074149054ea1bb289b9551c7aeec7c4b2c88245209571d69e6b03c0786c6",
      "text": "crita",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "365ee51747d320a993bcbdc5ec24a88e9330d3bf6b9dcd9da67a05d72738f236",
      "text": "gendhing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "38fcb72467820ec5a99b8d7f968037c9a75747388debff7ccd196d161b74579e",
      "text": "Lajeng ingkang ageng menika?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3af1654ded66dc241229522b89e71ac624646ce7900eb52b2461e352e5f6591a",
      "text": "Gunungan wonten tengah kelir.",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e16a998a4a2d82af6813481eafa109b06bd8044d9ed9868f0f84103d269ec78",
      "text": "Mas Dimas nabuh gender.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eb41bcf2cf65c16400a28b99b6b2cdff48527aedcd0a26523393bcc8d9d6ab9",
      "text": "Setu dalu wonten wayang kulit ing pendhapa.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "415e05e29b750e692900e412ac467c3b6dc671620e68135f2875b2c7ec3ff50d",
      "text": "Bener. Banjur?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "42c7b406ae80e315c436dfd435a9be0fb8315262ab85286205964db63df36906",
      "text": "Mas, kuwi Petruk karo Gareng, to?",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "448148e0a7420ddb74f151947bad422ad18a6bd740b4a0d2afe434ea10b96b96",
      "text": "Kurawa iku angkara murka.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "452f52da16fb49209ccb49c425eb7b850348ea0be2503b1d5fbb398bd8f05815",
      "text": "Sing nabuh kenong lan kempul iku ___.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a674c0db9b4fd9054129fc81b7fc3f2e56ce6bfcf1707ceb5850ff290b2ffd",
      "text": "Panjenengan remen gendhing menapa, Mbah?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4949a07e5167523b35d718aa7a3fab2f3d022cd264cd03bd6141d4ee6aefe189",
      "text": "sindhen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b77ee157e4a9063a555ceac594c8410b5af01a7df24e74f336a9c939455ec5f",
      "text": "niyaga",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c1b405e3c998ebb2f27b41b997a7fcf5852bec2bbe3c1bac0c3ce06af79ffb1",
      "text": "suling",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d6d2a6faa3a6840421e793961a9e4aa08c4eb4af2ba43bfb4a0c37233d3cfff",
      "text": "Iku gendhing slendro. Aku sing nabuh gender!",
      "voice": "jv_dimas",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de22ae84a485bbcb06e1601d9fc796e71332cf0431d533fcbb5aa98b4b59f8e",
      "text": "Wah, dhalangipun sinten, Mas?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f265075892669b9139d23729b1d7ed2c251c1446bbde30ac3a1403e99357421",
      "text": "Raden, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "50212d1e4822f6531067287b11966cb137e946a9be3ccfa11919c1bb41241595",
      "text": "paningal",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "504187e2b6f44e9f3bbf4dc684d53021e43ddd114665edfaa05dbd971f0e7544",
      "text": "Merga Petruk matur Raden Arjuna.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5256b2329f4466fdf5d73ec04f2d2bd25f366bb29a9e4f5e8971ae783f0ea2f4",
      "text": "Aku nabuh kenong. Pak Marto nabuh kempul.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "530498124e045de4928fc6912d9b3022ddfdb96f9386aab4fefa16fd1b9291a5",
      "text": "gunungan",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ac0e8aa3e6c357b8123bbaae87b8a53ace261b4e30c2a1472c4bbcedae2e57",
      "text": "Gamelan lan sindhen ugi wonten. Mangga rawuh!",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "54c2b6ab5310ff0d09b883961584decc9865b71810679a604a1c8fa7e72bbc9f",
      "text": "Saiki Petruk nganggo krama!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "552ab6f35796d7fee86ce54e925c29f1ae0df4647e59235e559d5509da1c322e",
      "text": "Pak, menika sinten?",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "56eafd5e4641a29ea6d87a9f584379a2b786c106ad7fceb05f2b70c94a887226",
      "text": "Iya. Punakawan guyon nganggo ngoko.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "577ef1be140f6b13f15d58e7f2e5356b65fa093961c31a6716b346317298904b",
      "text": "Menika buta, abdinipun Kurawa.",
      "voice": "jv_dimas",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5816b8117bb38376091ed4ebbafcdd24a10d9b915fedd7582611c73f70a91778",
      "text": "Iya. Ati-ati, Hanoman.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "58971ece0d3b5202118c696e65ef25240583df1be318679841bd85524622daf8",
      "text": "Inggih. Menika kendhang, menika saron.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "59a46032a2f4f132aeba69f6e6fa72ee2ebadd33416f537b6d0538f5e198ee57",
      "text": "Rebab lan suling muni nelangsa.",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b5567bc3a81768bce841405f64afab7ad1161e5279a743559f97c32fbe5365b",
      "text": "trenyuh",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d141087bd3899a9b93ba587fbbb4c67632a005afb78fcf3b91c31a60c14fb7c",
      "text": "Dhalange saka Bantul.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dd35f6eaaeee80448dd8637eca74dde4f6be76f78e6274ed95d6fa1a85937a9",
      "text": "Kurawa",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "60a8db836ef814082ca5ecccdee20cbe2cada78356fee2a1fad33e260005ef3f",
      "text": "Mas Mohamed, mangga. Menika gamelan.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "631917014a067d5e90575d4eb350057c09edda02167eeefdc42252abfc15e6e0",
      "text": "Pak, kenging menapa wayang Arjuna alit lan alus?",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "636cc4996f61e51a6fbb6f4197aad6dd5284550e5fc73fa0906dfd193be2c049",
      "text": "Ana punakawane?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "63f887b347343a40f2e1ff573a49be83996e7fa9f1659ffad1d2688c98170117",
      "text": "Dhalangipun saking Bantul, critanipun Ramayana.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6415ace7c212c8bb3ff783ab1325d273c7700a140516f96e2c2265c0c5745ea6",
      "text": "Gendhing menika ___, dudu slendro.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "658a6b43d44d6f8c49734a6920f0b03311f654a80337f85b1c522933f13253ee",
      "text": "angkara murka",
      "voice": "jv_siti",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "66cb38a7f2562f3c6be483894327b4131fcfa2906f8e14e6cf112dd598bbed00",
      "text": "grana",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "66dbda3ea36af88044ea175598afb037393517af33cf31cd5dab3f9d7c2849c2",
      "text": "Mas Mohamed, mirengaken. Dhalang badhe suluk.",
      "voice": "jv_dimas",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6984d65d6fdaa1dc946f0e09bd79ee359b85f99b492e278e7267bc19732096d4",
      "text": "Panjenengan remen gendhing Jawa, Mbah?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "69b8839c11ff05a815e534633c2e72f61cccfd53adb9a2d8dc4d891396941854",
      "text": "nelangsa",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c0d62da9c8ac307d36f8f6a7c3f8ca14122f9bec7a708eecc9ef5a54039305",
      "text": "gladhen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b52e76df2b3f7deff81d32a80c5ee119f5c8b25266cf025278891a7073cfd2b",
      "text": "Saka Bantul. Apik banget og, nganti esuk.",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c3c35f43c0f7a2b918aac000c4fe52f44182741c98db6814a322e2285658796",
      "text": "nabuh",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6df474a1bb16bdc9aae88375e8250a4f3b71fc8d8a59f53d6651fc2485ccb2fc",
      "text": "Lho, kowe nonton Ramayana neng Prambanan?",
      "voice": "jv_dimas",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e39dcda6568ab3d65d28d04f10fc8fbda70943371c0a73df2623ec2cde631e7",
      "text": "Iya, Mas! Apik banget.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f394e293612138d2354759fb36589834450ae14abfff0f6664f2edcee9a4678",
      "text": "saron",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "746a783a1475c4c0284a780b1c5064a0ca5fb226feb4647928f4b2d691813289",
      "text": "Bratayuda",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "76225fc2c4de65a1851356115f883bd4a6ee1e53afa19001cd033d4f7becc85c",
      "text": "Mas, lampu neng kelir kuwi apa?",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "774cca9a152a85a3d845e076f32ad35e9b678ab2390b86976e9e84f221a6b640",
      "text": "satriya",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "77a3d7f74bb1878885e0f276ccf6ccb3fecd738845e59781b0ddbb3c9ac582d6",
      "text": "buta",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "786d9609d8467283ed5442021b0f2e29dd74fb72e54c2ffbc4a6def287447d69",
      "text": "suluk",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a8b66dff098613f45fdac47b19de441de853824f48061ba798b2624dc18936c",
      "text": "Niyaga lagi gladhen neng pendhapa.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d2dbcb8563d8c48712efbe9a097cd0b5507f554755f318ad342b13d3804aa61",
      "text": "Inggih, Pak. Hanoman matur dhateng Rama ngangge krama.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e13cf833c5c46d04c264c0eb65e9482dbd7290d91cc860e57c8dbf73b77e4aa",
      "text": "Hanoman matur marang Rama.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ec672b31d0a5164baba4250e497ff2167ff760de7bee7097e794ae7d15be58b",
      "text": "___ Arjuna ndhingkluk, alus sanget.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ed56e759a973585c839f8a9ba5755a3028950de70fb0a2eb2c2551b44c83ba6",
      "text": "Inggih, Pak. Kula ndherek.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8014f3752a3fee329da4d482add0816bf774067a9a08fd1d6aa27bd366519252",
      "text": "Arep! Dhalange saka ngendi?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8246ea8cba4b4ce9459809883bdb079c375b2d40b4168d2805c40c8c946fb71f",
      "text": "Panjenengan remen gamelan?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "839e768333a0badef188baf5eacf07eadd4b0ec2a880e16ce6e71e655f74af25",
      "text": "Sae sanget, Pak! Kula remen Hanoman.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8660fcf4bc19099aa8dd53afae0797ebb524f0d9bd561a849fda726bde201470",
      "text": "wayang kulit",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ca5f6f47140c9c286c4b2de7408ba4e1e8cbc72a0b3de65a203d0f9c23e333",
      "text": "Bengi iki aku nonton Ramayana ing Prambanan.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "88e8cd7c6b33ec0c46e8d286ed4a934268fae00e493a64e6a3bc664caed19ef0",
      "text": "kelir",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a8e1461f504c8dc2c9b69924bc326a141c478956233dfda13a7b01a4d6f2c58",
      "text": "Inggih, menika laras pelog. Mirengaken, dhalang badhe nuthuk cempala.",
      "voice": "jv_dimas",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bdb909b9d35fccf540decef9685b5d5c4d66f374a1618ee7cb009460775e88d",
      "text": "rebab",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c6cbf5abf50dff9a3a62fcda18e7cd11c688681803b4fe4aa5e9c44fb9ca937",
      "text": "ratu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c6df897d8992e742d21266c68dbf3bf26ee1ee54df1ba42fadd4485f33a3393",
      "text": "Janggane wayang Arjuna dawa lan alus.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c9b022fe899f7189b9ebe4f8c05a31eca8aa3f169ea4eb3ace886bde193ce30",
      "text": "Piye, Mohamed? Kowe ngerti critane?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "933627d711cf44a9b096b970b55f7f79ec30b4c9225ba231e51dea32d5d12da3",
      "text": "Ing wayang, ___ iku gedhe lan medeni.",
      "voice": "jv_siti",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "94211e45903b29c24ba6e53f6b20214ca3b8dc8a51f69a0f85f81a167a69c51e",
      "text": "Aku arep nonton wayang kulit bengi iki.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9432137dc2b6224d3071a6275e117112ffe4629ad170d1ce47aec133efcb62eb",
      "text": "Hanoman, kowe lunga menyang Alengka. Sinta ana ing kana.",
      "voice": "jv_siti",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f3721ec16063628db0c372345c34f7e782c0b65967ca8ec2f916f126d81d13",
      "text": "Sindhene apik, saron lan kendhange uga apik.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "95514eefa3c55b494621470426782046e3bbb1d5d2f740f20381699be6a80c56",
      "text": "sabetan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "96e2429b0f400fb79ab58ff9e28d60a311c93a097ceb273081e57d2af552bf17",
      "text": "Kula nelangsa mireng rebab menika.",
      "voice": "jv_siti",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "98f0119cff9d5cfd119614895e6f1c16fe4439cc9976fa315b11f4adbc50e526",
      "text": "Aku nabuh kempul, Mas Dimas nabuh kenong.",
      "voice": "jv_siti",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "99ee8d0b435e818e2b1281ba27496184642581a4433d86d7be7165765b6de87f",
      "text": "Oh, Petruk iku abdi.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9abe1e919345ab16206ea8345579e7ea17434cf898532a70314e085f7ce952b5",
      "text": "Hanoman sing paling apik! Dheweke matur Rama nganggo krama.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c455d83e7881fa52f79bd0d2bd3cda10bb605af6974b9f933a0f128071a2eb2",
      "text": "Suluk dhisik, banjur sabetan wayang.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d0f1855b8a91e7827197b3dd8bcd7c6144251114dbf7326d21af6f1b68da9d7",
      "text": "Leres, menika rebab. Wonten suling ugi.",
      "voice": "jv_dimas",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d3781ca6202806fe5870d93764387eb09f9a54d12513f3a7e7d22bbffa075f5",
      "text": "Ayo! Mas Dimas nabuh apa bengi iki?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ecb39cdbe1b979c1774cfd714a4b1db68c69c7940593cc0e3f10fed27a4de30",
      "text": "Wah, swantenipun alus sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f7fbabce5b850dd2c1572118a19851f33de0de5c67a4203a067324a4c1ef508",
      "text": "Iya, merga Hanoman iku abdi.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fc8268fbfebfea613b7606a316722b6fbcf91065bc7fcb802cd6abeb6cf4de9",
      "text": "Kula trenyuh mireng gendhing menika.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f86c318ab0b63c575e97a3df08727122505eaf08b7dda159bf2b3ff1462042",
      "text": "nyulik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f872b91ccaf0ae665ec8b7dcfab4bdad8ab151dfa6941081a18252d5d86da2",
      "text": "Hanoman lunga menyang Alengka.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ad9919c54c2db8d0eda4d49fd6101581b09ada440fe5f06bb8026a78dd7de5",
      "text": "Sendika dhawuh, Gusti.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "ada3c6ddfddf560d772a5c5d8e84054c2edd602bd18c9f4ab7fc683516a8d08d",
      "text": "Gusti badhe tindak dhateng pundi?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0fee100a173062c5ffd7f5214b8c41c51ec65783f776da6cd0ded2dd8af19d6",
      "text": "Inggih, kula purun. Mas Mohamed ugi?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b143e18c8726f1d05c1cc5c9f1f5fad786cefac0edbc3d71c5ed8ec7b97dbdc8",
      "text": "Sendika dhawuh, Gusti.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b23a49085f4f36519ea2f5d4e8a20a5eddff02b18be410b3e27e356f1624447c",
      "text": "Keris pusaka menika sekti sanget.",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52cbcd546cb2fd9184b776119e7dc47b1e2fa7847f1ea48825e5d147f770dd7",
      "text": "Hanoman lunga menyang Alengka, banjur matur marang Rama: Gusti, Dewi Sinta wonten ing Alengka.",
      "voice": "jv_dimas",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "b82e6e075dd2586a429dbc66412df0130dbddd1418d7c8933e34e2466ba0499c",
      "text": "Gusti, kula nyuwun pamit rumiyin.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9f2695ff7bd9793cbf09dc13a431f506806b2a47db0d9932832006579065288",
      "text": "Mohamed, ayo neng pendhapa. Niyaga lagi gladhen.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba032a434bd698ff9635968ee80a6e875d73e66e6739c2505e815502e95ddd2e",
      "text": "Inggih. Lajeng sabetanipun cepet. Wayangipun kados gesang.",
      "voice": "jv_dimas",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba41a6621e9b601ef82abf037b5b73de6453c7ab2257f2f1da9a31305178c5dc",
      "text": "gusti",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc6bc7c47597164480610c66139f83b545a7d4e9b32a509210987b308f7e7bab",
      "text": "guyon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc98d753895c5e600759d32abde0b558ce75b96d4ca28cbc2bd109bbfdaa7afa",
      "text": "Menika Arjuna, satriya Pandhawa.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "befc9d349bf4e230ffc831dcc897df2caa0e49f069696ae6f1beb3c9c9975251",
      "text": "Pripun, Mas Mohamed? Sae?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf073cf9b8e22b929741ee105856e48d05649680f47f6e43a3a8c8dbea62b366",
      "text": "sendika dhawuh",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c02e9870f3633a126ccb8a57f05a75f5de978913b766d6f9c3e55c2385da864a",
      "text": "Mangke Pandhawa menang, Pak?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c23820b6b90756157f847baf06e64248754eeef4de8d534951af30907ba771d7",
      "text": "Kuwi blencong. Saiki akeh sing nganggo lampu liyane.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55bfad2537dc48ad78d56ee3858e627674ed0793681984b485cd67b8f009169",
      "text": "Rahwana nyulik Sinta.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5cd7afb99309398447a920d49f9d4b37abff1fff0a83c554054431f15f563cb",
      "text": "Granipun Arjuna alus, paningalipun ndhingkluk.",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6bca185d7dc25a9d39187b2f5b8412e0b7a181aa37b39dd6b36a9a1a4536221",
      "text": "Hanoman! Lan sindhene uga apik.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8559e35ca4097b580ae51ce687937685b02ed45c1b58b2b09562cb41d1c412c",
      "text": "Sesuk aku melu, ya!",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "c89188bdacdd6b0b88fcc32c1df5ce0e5c646dfc11749e80ae02e7959e181e63",
      "text": "Ana. Punakawan guyon nganggo ngoko, nanging karo Raden Arjuna nganggo krama.",
      "voice": "jv_dimas",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "c940979cc39ea252114d4ecf8643c968775b8c104e71aaf1eb26eab17b4b6cf9",
      "text": "marang",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9a29b4be6f619221413304ea67d3fba763309bc241e0325ced59646a7d7ab7f",
      "text": "Leres. Sampun dalu, Mas. Mangga wangsul.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3147f6e0cfe8f591b5cba503c9eb032983d53648a255b9c834408168fb5d37",
      "text": "slendro",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceffdbfefc42e3c654589452c5b76da6827723b8d35006ccdd14911b5359aada",
      "text": "gamelan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfc68319dcf7b17478b78fee3088d6055b0ca36bbd3670d7a56a9b8d00262871",
      "text": "Aku arep nonton gamelan, Truk.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfdf43b5fd3b6728fca760fbf7e2933f3c6045f389afb3db77c0a4d0ce54ac38",
      "text": "Inggih, wonten Bratayuda. Angkara murka mesthi kalah.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "d09e309a11fe861ec67a902205c419a5a73a1907d36ee392a27f2911897422c6",
      "text": "Gong iku gedhe banget.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0aa6148e838a5ceb16890f2a9969bd306b1288f51b7f12cea41b05b67073897",
      "text": "Gamelane apik tenan. Aku trenyuh.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0ed12b1432984538c9602ec35a262a3c5e9d0ae7d5159913f0ef4dfc7cb5c40",
      "text": "Dhalang nuthuk cempala.",
      "voice": "jv_siti",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d106d9372a7eca8000bec69c4c81d80c273199b3e598bb3366cb361762bb1606",
      "text": "Inggih, Gusti. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d12be1906d3f0e7f2deae68c69e3f175a1e37d9bd0e86bd114710c2e42f8da7c",
      "text": "Reng, kowe arep menyang ngendi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3648f394c80c584a87b427b5cf540e4d492adac31e3d94301983961b377ba03",
      "text": "kempul",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3f26b43db58fd8beca97a845a971ff45997787c380e73b1253cb41a1358bb53",
      "text": "Arjuna satriya, Nak. Granipun alus, paningalipun ndhingkluk.",
      "voice": "jv_dimas",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d53b9b195bf10e2db5828ca8eb52f6f7fabc333cf329beeb950d4a938cc4e5d7",
      "text": "Critane ngene. Rahwana nyulik Sinta, banjur Hanoman lunga menyang Alengka.",
      "voice": "jv_siti",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6dc44168e50766f11babf83597b17bffecef07ac9e4b2cd0ec5bca92cdbdc6e",
      "text": "Lha gunungan kuwi kanggo apa?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "dba5038471fee57cccb89c41328fd121425f2bf9767b267293fccaf92716451a",
      "text": "Kula remen gendhing Jawa, Mas.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd61fc2ae7a38dc5cb27c89adf294dcad75763cb96da0d3bd4fd7a8f28c8e95",
      "text": "Apik tenan! Hanoman matur nganggo krama.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07ffd728df3a40217d5d076c544966ca593a067b6893ff161e2985a998f0e26",
      "text": "kendhang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e241e2a42d1f79f2dff294d124fcbc2989fb20272720df0916fa2160c8b93aee",
      "text": "Arjuna satriya Pandhawa ingkang bagus.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27a8de071f31ce84d95c7f00d66e67f751accdd618bb6226c5527d516865115",
      "text": "cempala",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e36f05cbf9805945cb578aaf4286704f6b5623490985bcf95bdaeb5a89888dea",
      "text": "Lajeng swanten menika menapa? Kados rebab ing Mesir.",
      "voice": "jv_dimas",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec45a0bd0b689a8d12f3b1235006dc716ba12e6c6fd3b1c8189ad1abc3b92f17",
      "text": "Pandhawa",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed3edf1d608599c166082cd11b16ef16f3438df3857184c40093594506828850",
