    },
    {
      "id": "j4.u06.l03",
      "sha256": "cc933aeb4060dc3e7ae7188d64465eb46179d05f1be81a079eb2264446b111a9"
    },
    {
      "id": "j4.u06.l04",
      "sha256": "edf40d9f7dc382ff8f9b9585f32b442832ed0f387e8d9025c93a2b85a20c796a"
    },
    {
      "id": "j4.u06.l05",
      "sha256": "20816abe28cc97dba2b61d3434119abc105b4d0bb95c38298059fa5e69649eed"
    },
    {
      "id": "j4.u06.l06",
      "sha256": "04aab06e12ae5b2eba9819aa25643c65b083c6e68228fb885b11565720617549"
    },
    {
      "id": "j4.u06.l07",
      "sha256": "03c9b926dcc8891ae87256cb64fb0b49dbffd0d3dbfe18b666047d7ee338f821"
    },
    {
      "id": "j4.u06.l08",
      "sha256": "80809b8e7ce4664341751d0dda7cb20cb8d782493da4ff1fc7b089e366e876d7"
    }
  ],
  "audio": [
    {
      "key": "075ba9b35a6552e75fd6bf90fa109b73c2b4ed72050cc2fbd3303e82b69f443f",
      "text": "gong",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb1562243109601866346e208fe1bbd6c31972bcdf99428b734b701e64d0b43",
      "text": "Wah, gongipun ageng sanget, Mbah!",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "16feb3344d3681e0ae0bba62d6a2778e994f6aabfac903a9c9206825fcefd2e8",
      "text": "dhalang",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e3132d5cb4a6324fd421d81d12ff6d6cf5778ba9ebbe136199e646e6aec666f",
      "text": "Aku seneng gamelan. Kendhang, saron lan gong.",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "208c6f7cf5b6b163ebc08f96e75f8615df5dcfda8c9aac4cc5678d29d67599cd",
      "text": "Semar, Gareng, Petruk lan Bagong iku punakawan.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "20b71b536b4ba528d42212c11fdbf7461f9842b6365c79c58a09c8b574054fe1",
      "text": "Saking Bantul, Pak. Panjenengan kersa mirsani?",
      "voice": "jv_dimas",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "21271a9ff7f7530af339f5319187505ee42ba4d6728e0545aac7801756013d65",
      "text": "Reng, kowe wis mangan durung?",
      "voice": "jv_siti",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2553d0dc85284ab73292e88fef275022a102d4fb440e59ed54540591eefba904",
      "text": "punakawan",
      "voice": "jv_siti",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "286d0e823759fd3b14ce3b2462f62896854bd0d629e1ec188364fa270b399c86",
      "text": "Mangga, Pak. Matur nuwun sanget.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "290b01d69893f0bc41e5d841b2742a2f18f776108d5c92eb7d335f51d0162d55",
      "text": "Mohamed, bengi iki ana wayang kulit. Kowe arep nonton?",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "293a23e3dff818ff11df72d236c2cec4f885c392981824bcad51fecc2f57f2b1",
      "text": "Nyuwun pangapunten, Gusti. Kula badhe matur.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2942738c90565eda79655e6a7a9969a8f1b214505f9b71117782d0d54cae2e59",
      "text": "Sapa sing paling apik?",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "3288f52ddfb79e3a2d3b28b524646a5961229f85624f60566260b61e82a55300",
      "text": "Ngerti! Rahwana nyulik Sinta, digawa menyang Alengka.",
      "voice": "jv_dimas",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "32e2074149054ea1bb289b9551c7aeec7c4b2c88245209571d69e6b03c0786c6",
      "text": "crita",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "365ee51747d320a993bcbdc5ec24a88e9330d3bf6b9dcd9da67a05d72738f236",
      "text": "gendhing",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eb41bcf2cf65c16400a28b99b6b2cdff48527aedcd0a26523393bcc8d9d6ab9",
      "text": "Setu dalu wonten wayang kulit ing pendhapa.",
      "voice": "jv_siti",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "415e05e29b750e692900e412ac467c3b6dc671620e68135f2875b2c7ec3ff50d",
      "text": "Bener. Banjur?",
      "voice": "jv_dimas",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a674c0db9b4fd9054129fc81b7fc3f2e56ce6bfcf1707ceb5850ff290b2ffd",
      "text": "Panjenengan remen gendhing menapa, Mbah?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4949a07e5167523b35d718aa7a3fab2f3d022cd264cd03bd6141d4ee6aefe189",
      "text": "sindhen",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de22ae84a485bbcb06e1601d9fc796e71332cf0431d533fcbb5aa98b4b59f8e",
      "text": "Wah, dhalangipun sinten, Mas?",
      "voice": "jv_dimas",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f265075892669b9139d23729b1d7ed2c251c1446bbde30ac3a1403e99357421",
      "text": "Raden, panjenengan sampun dhahar?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "504187e2b6f44e9f3bbf4dc684d53021e43ddd114665edfaa05dbd971f0e7544",
      "text": "Merga Petruk matur Raden Arjuna.",
      "voice": "jv_dimas",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "51b9011cc20d5b07e2902452ee18e1e340396e91ec3a03f51c1f6cde04f8412d",
      "text": "Wah, kowe nonton Ramayana ing Prambanan?",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ac0e8aa3e6c357b8123bbaae87b8a53ace261b4e30c2a1472c4bbcedae2e57",
      "text": "Gamelan lan sindhen ugi wonten. Mangga rawuh!",
      "voice": "jv_siti",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "54c2b6ab5310ff0d09b883961584decc9865b71810679a604a1c8fa7e72bbc9f",
      "text": "Saiki Petruk nganggo krama!",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "56eafd5e4641a29ea6d87a9f584379a2b786c106ad7fceb05f2b70c94a887226",
      "text": "Iya. Punakawan guyon nganggo ngoko.",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5816b8117bb38376091ed4ebbafcdd24a10d9b915fedd7582611c73f70a91778",
      "text": "Iya. Ati-ati, Hanoman.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "58971ece0d3b5202118c696e65ef25240583df1be318679841bd85524622daf8",
      "text": "Inggih. Menika kendhang, menika saron.",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d141087bd3899a9b93ba587fbbb4c67632a005afb78fcf3b91c31a60c14fb7c",
      "text": "Dhalange saka Bantul.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "60a8db836ef814082ca5ecccdee20cbe2cada78356fee2a1fad33e260005ef3f",
      "text": "Mas Mohamed, mangga. Menika gamelan.",
      "voice": "jv_siti",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "636cc4996f61e51a6fbb6f4197aad6dd5284550e5fc73fa0906dfd193be2c049",
      "text": "Ana punakawane?",
      "voice": "jv_dimas",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "63f887b347343a40f2e1ff573a49be83996e7fa9f1659ffad1d2688c98170117",
      "text": "Dhalangipun saking Bantul, critanipun Ramayana.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6984d65d6fdaa1dc946f0e09bd79ee359b85f99b492e278e7267bc19732096d4",
      "text": "Panjenengan remen gendhing Jawa, Mbah?",
      "voice": "jv_siti",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e39dcda6568ab3d65d28d04f10fc8fbda70943371c0a73df2623ec2cde631e7",
      "text": "Iya, Mas! Apik banget.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f394e293612138d2354759fb36589834450ae14abfff0f6664f2edcee9a4678",
      "text": "saron",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "70edabf8350cc54ea612443ee8af18b3c3f0f702ae82b5b776e60d50a7de6866",
      "text": "Hanoman, kowe menyanga Alengka. Sinta ana ing kana.",
      "voice": "jv_siti",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d2dbcb8563d8c48712efbe9a097cd0b5507f554755f318ad342b13d3804aa61",
      "text": "Inggih, Pak. Hanoman matur dhateng Rama ngangge krama.",
      "voice": "jv_dimas",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e13cf833c5c46d04c264c0eb65e9482dbd7290d91cc860e57c8dbf73b77e4aa",
      "text": "Hanoman matur marang Rama.",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ed56e759a973585c839f8a9ba5755a3028950de70fb0a2eb2c2551b44c83ba6",
      "text": "Inggih, Pak. Kula ndherek.",
      "voice": "jv_dimas",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8014f3752a3fee329da4d482add0816bf774067a9a08fd1d6aa27bd366519252",
      "text": "Arep! Dhalange saka ngendi?",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8246ea8cba4b4ce9459809883bdb079c375b2d40b4168d2805c40c8c946fb71f",
      "text": "Panjenengan remen gamelan?",
      "voice": "jv_siti",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "839e768333a0badef188baf5eacf07eadd4b0ec2a880e16ce6e71e655f74af25",
      "text": "Sae sanget, Pak! Kula remen Hanoman.",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8660fcf4bc19099aa8dd53afae0797ebb524f0d9bd561a849fda726bde201470",
      "text": "wayang kulit",
      "voice": "jv_siti",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ca5f6f47140c9c286c4b2de7408ba4e1e8cbc72a0b3de65a203d0f9c23e333",
      "text": "Bengi iki aku nonton Ramayana ing Prambanan.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c6cbf5abf50dff9a3a62fcda18e7cd11c688681803b4fe4aa5e9c44fb9ca937",
      "text": "ratu",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c9b022fe899f7189b9ebe4f8c05a31eca8aa3f169ea4eb3ace886bde193ce30",
      "text": "Piye, Mohamed? Kowe ngerti critane?",
      "voice": "jv_dimas",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "94211e45903b29c24ba6e53f6b20214ca3b8dc8a51f69a0f85f81a167a69c51e",
      "text": "Aku arep nonton wayang kulit bengi iki.",
      "voice": "jv_siti",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f3721ec16063628db0c372345c34f7e782c0b65967ca8ec2f916f126d81d13",
      "text": "Sindhene apik, saron lan kendhange uga apik.",
      "voice": "jv_siti",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "99ee8d0b435e818e2b1281ba27496184642581a4433d86d7be7165765b6de87f",
      "text": "Oh, Petruk iku abdi.",
      "voice": "jv_dimas",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9abe1e919345ab16206ea8345579e7ea17434cf898532a70314e085f7ce952b5",
      "text": "Hanoman sing paling apik! Dheweke matur Rama nganggo krama.",
      "voice": "jv_siti",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eb0b476bbbe246743e6f365a02e125c284f18cb34f3532d2f03160c00606603",
      "text": "Saka Bantul. Apik banget, nganti esuk.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f7fbabce5b850dd2c1572118a19851f33de0de5c67a4203a067324a4c1ef508",
      "text": "Iya, merga Hanoman iku abdi.",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f86c318ab0b63c575e97a3df08727122505eaf08b7dda159bf2b3ff1462042",
      "text": "nyulik",
      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5f872b91ccaf0ae665ec8b7dcfab4bdad8ab151dfa6941081a18252d5d86da2",
      "text": "Hanoman lunga menyang Alengka.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ad9919c54c2db8d0eda4d49fd6101581b09ada440fe5f06bb8026a78dd7de5",
      "text": "Sendika dhawuh, Gusti.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "ada3c6ddfddf560d772a5c5d8e84054c2edd602bd18c9f4ab7fc683516a8d08d",
      "text": "Gusti badhe tindak dhateng pundi?",
      "voice": "jv_siti",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0fee100a173062c5ffd7f5214b8c41c51ec65783f776da6cd0ded2dd8af19d6",
      "text": "Inggih, kula purun. Mas Mohamed ugi?",
      "voice": "jv_dimas",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b143e18c8726f1d05c1cc5c9f1f5fad786cefac0edbc3d71c5ed8ec7b97dbdc8",
      "text": "Sendika dhawuh, Gusti.",
      "voice": "jv_dimas",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52cbcd546cb2fd9184b776119e7dc47b1e2fa7847f1ea48825e5d147f770dd7",
      "text": "Hanoman lunga menyang Alengka, banjur matur marang Rama: Gusti, Dewi Sinta wonten ing Alengka.",
      "voice": "jv_dimas",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "b82e6e075dd2586a429dbc66412df0130dbddd1418d7c8933e34e2466ba0499c",
      "text": "Gusti, kula nyuwun pamit rumiyin.",
      "voice": "jv_dimas",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba41a6621e9b601ef82abf037b5b73de6453c7ab2257f2f1da9a31305178c5dc",
      "text": "gusti",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc6bc7c47597164480610c66139f83b545a7d4e9b32a509210987b308f7e7bab",
      "text": "guyon",
      "voice": "jv_siti",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "befc9d349bf4e230ffc831dcc897df2caa0e49f069696ae6f1beb3c9c9975251",
      "text": "Pripun, Mas Mohamed? Sae?",
      "voice": "jv_dimas",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf073cf9b8e22b929741ee105856e48d05649680f47f6e43a3a8c8dbea62b366",
      "text": "sendika dhawuh",
      "voice": "jv_siti",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55bfad2537dc48ad78d56ee3858e627674ed0793681984b485cd67b8f009169",
      "text": "Rahwana nyulik Sinta.",
      "voice": "jv_siti",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6bca185d7dc25a9d39187b2f5b8412e0b7a181aa37b39dd6b36a9a1a4536221",
      "text": "Hanoman! Lan sindhene uga apik.",
      "voice": "jv_dimas",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8559e35ca4097b580ae51ce687937685b02ed45c1b58b2b09562cb41d1c412c",
      "text": "Sesuk aku melu, ya!",
      "voice": "jv_dimas",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "c89188bdacdd6b0b88fcc32c1df5ce0e5c646dfc11749e80ae02e7959e181e63",
      "text": "Ana. Punakawan guyon nganggo ngoko, nanging karo Raden Arjuna nganggo krama.",
      "voice": "jv_dimas",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9a29b4be6f619221413304ea67d3fba763309bc241e0325ced59646a7d7ab7f",
      "text": "Leres. Sampun dalu, Mas. Mangga wangsul.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceffdbfefc42e3c654589452c5b76da6827723b8d35006ccdd14911b5359aada",
      "text": "gamelan",
      "voice": "jv_siti",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfc68319dcf7b17478b78fee3088d6055b0ca36bbd3670d7a56a9b8d00262871",
      "text": "Aku arep nonton gamelan, Truk.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d09e309a11fe861ec67a902205c419a5a73a1907d36ee392a27f2911897422c6",
      "text": "Gong iku gedhe banget.",
      "voice": "jv_siti",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d106d9372a7eca8000bec69c4c81d80c273199b3e598bb3366cb361762bb1606",
      "text": "Inggih, Gusti. Matur nuwun.",
      "voice": "jv_dimas",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d12be1906d3f0e7f2deae68c69e3f175a1e37d9bd0e86bd114710c2e42f8da7c",
      "text": "Reng, kowe arep menyang ngendi?",
      "voice": "jv_siti",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d53b9b195bf10e2db5828ca8eb52f6f7fabc333cf329beeb950d4a938cc4e5d7",
      "text": "Critane ngene. Rahwana nyulik Sinta, banjur Hanoman lunga menyang Alengka.",
      "voice": "jv_siti",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "d63d2c23eb7bfa8d8476e44c4f6b4a0f65fa7f332a823a08ddc7db3af6772c4d",
      "text": "Mas, iku Petruk karo Gareng?",
      "voice": "jv_dimas",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "dba5038471fee57cccb89c41328fd121425f2bf9767b267293fccaf92716451a",
      "text": "Kula remen gendhing Jawa, Mas.",
      "voice": "jv_siti",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd61fc2ae7a38dc5cb27c89adf294dcad75763cb96da0d3bd4fd7a8f28c8e95",
      "text": "Apik tenan! Hanoman matur nganggo krama.",
      "voice": "jv_dimas",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07ffd728df3a40217d5d076c544966ca593a067b6893ff161e2985a998f0e26",
      "text": "kendhang",
      "voice": "jv_siti",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2765214ce3a7d9571f16b258d72793e3dc0a8722d19db12084f50fc98f6aeca",
      "text": "Gamelane apik banget, sindhene uga.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f433adf4149ffd9d915c730d093dff713e8d14c04d9a763ee7309143ab552081",
      "text": "Raden, panjenengan badhe tindak dhateng pundi?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4d1114e431004de11997b6038654e916f6b3975505c6d3516fdcc4d4008b130",
      "text": "Inggih. Hanoman menika abdinipun Rama.",
      "voice": "jv_dimas",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f72ba6c5f82bd992d9acf8d627725e73c063ef29ab5611280833f3df681a38c4",
      "text": "Critane apik banget. Hanoman matur marang Rama.",
      "voice": "jv_siti",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "f94951eae795a36b5be38ec06a1548bbaab75030c82fe396aa845fa1d7cb25ab",
      "text": "Punakawan guyon nganggo ngoko, nanging karo ratu nganggo krama.",
      "voice": "jv_siti",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9c08de80041989d092c7a974b1b7b8ad295b45a0b551a2791a8752b0b27c105",
      "text": "abdi",
      "voice": "jv_siti",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fac09ad5c461bf99f2086ef20318097a5cf2ca9f07246526a123e769b7308de7",
      "text": "Gusti, kula badhe matur.",
      "voice": "jv_siti",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe65961ea44ac836780312160fad2d2072fbac2a72cdbc08d3e6abc13d0842f2",
      "text": "Pak, Setu dalu wonten wayang kulit ing pendhapa.",
      "voice": "jv_dimas",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "fed87cfd6b8f62400b9e6cd6306d2a3d01592ee57506df8272afef3fd264c7a9",
      "text": "Kendhang, saron lan gong.",
      "voice": "jv_siti",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff6b5e5d647ee79c27419d43b52aa70508f7211e0fcd6bb2683788583a6eb93e",
      "text": "Reng, ayo guyon!",
      "voice": "jv_siti",
      "chars": 16,
      "mime": "audio/mpeg"
    }
  ],
