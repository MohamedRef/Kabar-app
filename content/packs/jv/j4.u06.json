  "lessons": [
    {
      "id": "j4.u06.l01",
      "sha256": "d1b12e9e3574ff7cee757c5eb5f71c5dab6f20251feb61d4636dedb2285f7d36"
    },
    {
      "id": "j4.u06.l02",
