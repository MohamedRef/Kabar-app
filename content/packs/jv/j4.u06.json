      "voice": "jv_siti",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee667af211e91bbdd239116e0831ff58e766889e8b14714d7bfa1641d31c6860",
      "text": "Gendhingipun nelangsa sanget, Pak.",
      "voice": "jv_dimas",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2765214ce3a7d9571f16b258d72793e3dc0a8722d19db12084f50fc98f6aeca",
      "text": "Gamelane apik banget, sindhene uga.",
      "voice": "jv_siti",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f433adf4149ffd9d915c730d093dff713e8d14c04d9a763ee7309143ab552081",
      "text": "Raden, panjenengan badhe tindak dhateng pundi?",
      "voice": "jv_siti",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f453b5155d5d5a9b60cf8e1a8dc1bbb71d66c6793cfad1c59727428a2ffd4820",
