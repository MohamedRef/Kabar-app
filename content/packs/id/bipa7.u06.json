    },
    {
      "id": "bipa7.u06.l13",
      "sha256": "ee503a9f7c24e505bc4d3bfeae0662e4486e71a27adc577fe66fd3ee06f86d88"
    },
    {
      "id": "bipa7.u06.l14",
      "sha256": "8784b74726038d9b28195f6cee20cdbfde580fc5d57bfe2f2c82f1351edfa170"
    }
  ],
  "audio": [
    {
      "key": "01171050f14e7fd3df4fdc3f83235451b088dc1017cb87a34c03a5812a24d030",
      "text": "Di internet ada unggahan yang bilang umurnya satu juta tahun. Emang bener?",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "02c6b76558593c1cbdb37126e81eb3f30397ea2e450a5a7fd67f8514fe9a3831",
      "text": "Tautan itu mencurigakan. Alamatnya bukan situs resmi bank.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "02c939fee342be4c8e5b2c6f17a524df4448ef00b76789878ceb9c03f7f571c3",
      "text": "Mana tanda akun palsu yang paling kuat?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "039a9a53da5fbe7214cd8d78eb8a25ae28d9472d00b1fed3dd9f77c34529f5ea",
      "text": "privasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c086a16fb253f3f29a18380e03d148300c6acf50b25f26d018fa64b89eb047",
      "text": "disinformasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "065b96128d505549d04e794cbfd08c8c14117dc01626edc4704f6478d10fb12c",
      "text": "terverifikasi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "0979ed95461c5f2ba454979ba87c1b30e0bfac664185d63e352345720273992f",
      "text": "Suara dalam rekaman itu ternyata deepfake.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c82a9b3edfae5c9ba3aa96d480cf240ed673846d5a25341294ea51ff51f8f01",
      "text": "Nggak ada tanda #iklan. Tapi di keterangan ada kode diskon dari merek krim itu.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c83f11327ab4068b90090db41ce57cc2e3ae48bf0e3c1f95c3f88efa8538047",
      "text": "polarisasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d811072b56767ccfa3537fd6608ae48548109d73514c2bdd22fcad1ade2cadd",
      "text": "Pakai tagar CekFakta supaya utasmu mudah ditemukan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e78dab0f6be40420faea42d8a8ff9b757ed45166dddc14911197cccd4bd392c",
      "text": "Saya mau kerja sama, tetapi hanya dengan produk yang saya suka.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ebc91d6c4077a12b010d39a3d5060dc0b5265d9c8f3d5104b0728788e9d77a6",
      "text": "mencurigakan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f2db9542750fa7e06203aed146dd516008725c9f96a7b51ba874426e37b2349",
      "text": "Menurut saya, kuncinya bukan larangan, tetapi literasi digital.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "11e99827eb724897aa10e0a5130b68a69c7d78a4c5c03f044e56e0629568fba1",
      "text": "Terima kasih. Kami tidak menolak manfaatnya, tetapi dampak negatifnya nyata, yaitu kecanduan.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "1252d84965f0ca31fe16e9a004d9d577f43eda2c0d86ef2d438dd89305de8216",
      "text": "Judulnya provokatif banget, dan sumbernya cuma \"teman\".",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "12e86689e7ecfdab26e0493fd8774355c3c6c44d347522401349e22b00c0991b",
      "text": "Bagian pertama hoaksnya, terus fakta dari sumber resmi. Tagarnya apa?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "13d14f2084955ba0f19894ff6787a4ff0b1b869f96ec8eb96898c59b8803192d",
      "text": "Ini misinformasi atau disinformasi, Kak?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "14497bc979b97e6a61b2274fe2ffdb08da491fbbed01369b22fba2cb288138e8",
      "text": "antonim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "159bd0ae184cab005bb62c6754c4b85ee69d7d7c5a54cd53c1f1deb1933d8417",
      "text": "kerja sama",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1986de420a45b4da408d4eda8fedfaf61b4b7d99e0ff9147475bcc41e1a6a659",
      "text": "tautan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ae7f43a54362ea62007605e9fa1d37dcba862569cabcf71d5038b196d931e64",
      "text": "Berita bohong, kabar palsu… Tapi di judul aku ulang \"hoaks\" dengan sengaja.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "1af0fb389219161af38323a62abad6226f5cbecf69d1751d68b3e6860078de1c",
      "text": "Kalo gitu, besok kita cek faktanya bareng-bareng.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b1d7d013b5ee862fce346721499a9c237e146db84093f202f9d4a1d0c061357",
      "text": "Mohamed, ada pesan dari \"bank\" yang minta kode OTP-ku.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9ccdd5ee8b6029a18cb8ee5bbde4e996846ac7f1dbc956bffc9644a8fa7a85",
      "text": "Tulisanmu pake kata \"hoaks\" tujuh kali. Coba ganti pake sinonim.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bcd60533fd3c30ec6e02869cd09c0c6637e53088d46629b91de4456de752ff9",
      "text": "Wartawan yang objektif memisahkan fakta dari opini.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d45ecb1385c6823be57d91f737a7a8422aad90067fd5dbd24c04cc419bac030",
      "text": "konten berbayar",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e7f3b1703a8a5afbb1e495c840e9e86d7527acf551903a5db051bdcbbd77e80",
      "text": "Jangan klik umpan klik, dan jangan sebar disinformasi.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ead54e951511a192a70b70c551755d26bd3839e584784482e47dc8ad044f48a",
      "text": "Seorang saksi mata merekam kejadian itu dengan ponselnya.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f35f32d416c1ee0c42147902f2e2b083abeff1090d1e1b1f4f5b52fd1eedd8c",
      "text": "Pemengaruh itu membujuk pengikutnya dengan kata \"diskon\".",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f459beedfc1e5e780eb54be96d02f120e50bfcd4bd6c29a7a1bcf290aa59b24",
      "text": "kredibel",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "21256f1167332ff8fc0aa6f7dbe3eaa9201c54fe0325c0e842c7088bcc2254c7",
      "text": "pemengaruh",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "224ef758e2b9e52e063c7d956ef8a76b1669e4850224c94d019ba4c1ea914afd",
      "text": "Video deepfake itu memperlihatkan menteri yang tidak pernah berbicara begitu.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "227bb0d03d400380a240c70cec4a7ba823b571f920a4a7215057c9c3da53cb08",
      "text": "Teman sekelas diejek setiap hari di grup daring. Ini disebut ...",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2623bd349da679c86af6bc40bdf46679227e2473783b989a11f80bedf116b9c3",
      "text": "rekayasa sosial",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "26930e546cbc2167329ef6c88cfcab137a077d9db44e430ac1198a565c45c777",
      "text": "Aktifkan autentikasi dua faktor di semua akunmu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f91de1c36b055b3e686573e592eea0f99ed9aa78ff7bc6184dee4be26bed71",
      "text": "Judul umpan klik membuat orang marah sebelum membaca.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "294cea02189f3efd4d33af0c0e94203a0dba6a751e7fe7c1f74b8114e4e47471",
      "text": "Jangan kirim, Kaka! Itu pengelabuan.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2abf93cbb865fa35f570f8ccd89b611113ad311b5298201c06961b466a028378",
      "text": "kolokasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ae89e46be164c4938cae6622888505272b5640792f755756110642611b18b7a",
      "text": "Betul. Para nelayan udah panik. Hoaks kayak gini menyesatkan banyak orang.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dc1a22b3463a8d0847aecf59cd2010c7c09121f3eb5b8c8ee34966e9d97ad76",
      "text": "Jangan pernah memberikan kode OTP kepada siapa pun, termasuk orang yang mengaku dari bank.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f7d347dbd4acb6c4c277bb03371b6e9f7b4af42323977dbca3b72a13c8fb2dd",
      "text": "unggahan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ff11e8b41b4f3cccc362772fd95584b798c24d950c09c16e0766e85012e3bba",
      "text": "Kalau tidak ada tanda iklan, saya ragu apakah itu konten berbayar atau bukan.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "300672cc4f1dbf4eda8507eeecb363b5b9456f45bb4a048ca4ab9c5ce87ab10b",
      "text": "Kita cek dulu. Kalau deepfake, kita tulis berita cek fakta.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3084aa0ddbef8e63b1b8f0b4d4d8916f4dcafb7fd71eaea5f72db14440bb9d6a",
      "text": "Mohamed, lihat nih. Pemengaruh ini bilang krimnya bisa memutihkan kulit dalam tiga hari.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "31bfac03c01c517e32e79603e2f7c99fd449ac7bc76fd0e0744c953568813d93",
      "text": "Bagus. Sekarang verifikasi pake satu media lain yang kredibel.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "324e45447535e97e379bcc94717293106ded7de1f0c6d061d861b2655fc03c3c",
      "text": "Tunggu! Itu mencurigakan. Kamu nggak pernah ikut undian, kan?",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "336d3b890f72c83ef8967896b3f60b70d005a2f47f4d60c045d5cb4f1d54d229",
      "text": "Iya, tapi selalu jujur kasih label. Tanya juga soal kolom komentar yang kasar.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "339e67302e2ed190a879534b7f72ea3011861599944f2f2fcc929c3a6cc8f57c",
      "text": "utas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "339e6c953a69e24a5004dda2b083f2ae114539992c04b000c6bbaef8755f0946",
      "text": "rekaman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "346d2208bb0961e8d9d89082b61435bbad82f822dbe52ab6eb8f429221951b4e",
      "text": "Pemengaruh itu punya dua juta pengikut, dan videonya selalu konten berbayar.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "391b75cb87b7dba3dfd2e9bf6be79f1293a3ed7fdcf26595464d664e4dfc4279",
      "text": "blokir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3968c62081cc0f95bb7867a09d01da905e7d3926940cf6a9c632e769422644fa",
      "text": "Verifikasi membutuhkan dua sumber yang kredibel.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "39722944ae376a70d2435fccbc9f29f03fdbd0bd89b31e159abe79d974254527",
      "text": "monetisasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b97740dbfcb1f1af0075e07eea2bbfe19c87624255a897abfa00b26066cd26d",
      "text": "Siap. Bagian terakhir, \"Bagikan utas ini, bukan hoaksnya!\"",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bbb08047e91609ed8e8c784d0093c96149cf59084a012f314199ae1d95fdace",
      "text": "notifikasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f83923552fbc3f0b19bbe8a80bedf23c219e12f885350fc701a981ec791d473",
      "text": "Videonya tentang apa, Kak?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "438227de39197c9ca80755e117192369bb17f41d0866464fe2b44a938c5d8da2",
      "text": "Hiponim dan sinonim membantu kita menghindari pengulangan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4720da95f4b81493f1d9a35101ce0369c7ab8fb64c16e367ed3cfb04f4d8fe80",
      "text": "Radio Kaka Yohana di Sorong juga beritain hal yang sama. Jadi, itu hoaks.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "473e6b67e009e2d9c35ffaf4d27b46470e85f4c1be671564666641a31104643a",
      "text": "Itu boleh. Repetisi yang disengaja malah menegaskan pesanmu.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "490849b35ff57852ac93304ab59aa0c8de1b6c6320d045b94ecfd482706a659d",
      "text": "Lihat tebing itu. Ada lukisan tangan merah yang udah tua banget.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d3ebef748ce9ab8ba3d182daf88f658f6da24d141b9a585e36b51f146b6d080",
      "text": "Video ini adalah kerja sama berbayar dengan sebuah merek kopi.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d4e6b214f88a90a8969d17b57bcd4fcf97596bd3be6dfb5275a70359524d046",
      "text": "pengikut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dbb2268004323cc7d9782b0dd6fce299fa4a77ee1256236a7b7ac78b25d61fe",
      "text": "Itu cara peretas mencuri data pribadi. Hapus pesannya dan blokir nomornya.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e19b77972554b3ce2393b7dfa46467318ee64756a821e0fcb26c2f648ef064e",
      "text": "Aku udah ngobrol sama kepala kampung. Menurut beliau, larangan itu cuma sementara.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ecc248cd68fe30d33a969312ba108f0338fe9309cb1647cee2ad0447f19f331",
      "text": "kreator konten",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "54c7343fdc359ad03b8b9d0fe29ccb43ae78a1ec06b24897f48c506ae0f13456",
      "text": "Lihat, tagar ini naik dalam satu jam. Aneh, kan?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "559fb17e33d09272f346026c395d75ae3599a928926416afe4498bee61a00825",
      "text": "Boleh, tapi tutupin wajahnya dulu. Jurnalisme warga juga punya etika.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "55ac7d80184925752ace65681a796d66d54bfc4304d95e0e1f152a5c1ffbfa99",
      "text": "konten bersponsor",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "56bdf0ee1478d7d8ae057879c1160bbedb69261de113bd2f2a75f81fbae8b0d4",
      "text": "Satu per lima. Ada pesan berantai tentang air laut beracun. Mari kita cek fakta.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "58a4f40ac996798dd186f7ee6bccfa4700ddbc1d772baba6e2212e5796fa5776",
      "text": "propaganda",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "58fd031155eb6e2bc5404595692d810a6c6fa78d1e7a8d5de2bc2a599e6ae6ce",
      "text": "Kalo gitu, ini bisa jadi topik siaran kita soal keamanan siber.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dbf1af9079067bc9c710bb5f969dcb729056b9e5b51db3baf74163c8f987ef1",
      "text": "Pesan ini mencurigakan. Tautannya aneh dan pengirimnya tidak saya kenal.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ea282e745045fbf29348e9359c7fdcdc084ce00608d7762d296e22701d45d04",
      "text": "autentikasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ee7b82b9c3de1141ff2390d34bf190979a202812c4fb61cc0223ba9ecb272a6",
      "text": "Kak Selvi, aku punya rekaman perahu terbalik di dermaga tadi pagi.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ff1a45765519eb447d9149e50a75ff371d54c2de4afb55e8166b5d2209d1431",
      "text": "Nenek saya menyebarkan misinformasi tanpa sadar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "62a5f4e65a6ed705f717f970fe2770d1ef912059c411896cbf433ca3da69dbe0",
      "text": "Kak Selvi, aku dapat pesan. Katanya aku menang sepeda motor! Tinggal klik tautan.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "6398b7df2c5904d8f214067eda510701b6c43f324901fc23b184c25f05f9e09d",
      "text": "Apa yang memperkuat polarisasi?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6542410ea1e6cd81864a5bb8f753410acbd74ce3911f6476cf81dd7f132ce5fc",
      "text": "narasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65ebca8c0ebf52b05e53d6fdde98756a4007d7db7f206d605502098818ffa600",
      "text": "saksi mata",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "669d9f8c6956a895d67cb8e0778b742d94e4ed6474081a965b9c152805cd50f8",
      "text": "Unggahan itu dibagikan lebih dari sepuluh ribu kali dalam sehari.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "66b74635a373b43e7583a7f760f16e439268636a95e2a7850e49e34db2a66054",
      "text": "Setelah mendengar kedua belah pihak, ia menulis laporan yang objektif.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "66f30702517dad2b67ff2ac13d0746149b216746081d4b7f8ef7057d16812722",
      "text": "kejadian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "691e91f283ed6b81a1e4877614cff701c7593dc8ba9ee3d99da2981a19561f4c",
      "text": "Propaganda perang sering memakai foto lama.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a116a46f892d449cbaa1c49bb152f0892bb387b19080c69cefc1a8c12cd6722",
      "text": "Jangan mengunggah rekaman yang memperlihatkan wajah korban.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6acf2340072940bfe0a9f38b733738e212509816e2a8334bebbae7a807b90cb2",
      "text": "Argumen yang seimbang. Apa solusinya?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c18da10aa87893a35ca54b55e2c3c3b6fbfaff1a01b62b08951acecb8c863c2",
      "text": "sinonim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f89c5f431d88ed9a1af774359a8f6758d3d8786b181293bf4741b38aa6e02cb",
      "text": "sumber resmi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fb8d5e2edd4279c2734b206beecae528d5f850d9a09f84a228e9a64f6b49d19",
      "text": "menyesatkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "713b081ff54f1a6905828e914db7bfb8718cd4145c320f34cf716fa6f36ad5f3",
      "text": "Banyak akunnya baru dan fotonya sama. Ini akun palsu?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "761ef64bfb39706e3e474dbfbe43e684ece43e7e5c9c95de4f8420dbd34cc39e",
      "text": "Ratusan akun palsu itu dikendalikan oleh satu orang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "768f4c1c5fb918893afbbd62cf6481e208f78528b5149a94a6426c8a3adbec01",
      "text": "berita palsu",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "794101eab1cff738b7ee77861bb123073a20d4de4e525153d95e5506b30425a8",
      "text": "Kamu saksi mata? Semua penumpangnya selamat?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ab93a5a7f08ae985ceed4bfc9f2657e4b6e97ac937dc2e0f75394f5cb47ebf2",
      "text": "Selain itu, privasi anak-anak sering bocor tanpa mereka sadari.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c1400ad3b99edbdf8bfec9642cd7e2839697d78ffde616b1207ce7abb7099e4",
      "text": "Lihat pesan ini. Udah dibagiin ke dua puluh grup dari tadi pagi.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dc04254e67c2a540abb2d5d75d32279c00fa830f5236572e85244d4b2f34e6a",
      "text": "Korban perundungan siber perlu dukungan, bukan disalahkan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f01080ad6cdfb242ac34ffe6af32ed0ae01ec052f0635834c8d3b2e8eac46a7",
      "text": "Terus nelayan? Berita yang objektif harus dengar kedua belah pihak.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f01d6c93209be0d8dee7e73107a72ef7026f08e4222f8424ca4c446de839e02",
      "text": "pasukan siber",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fdaf99e7e8a97d682e852117c1b01bada6ffbe02f26ed3dd64897ee3fde0778",
      "text": "Hoaks tentang laut beracun membuat nelayan kehilangan pembeli.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "805ebb0bb3503bb9fd45824e2125f677e920b0013db8a49257ce3d2545212a08",
      "text": "Terus antonimnya, \"fakta\", aku taruh di kalimat terakhir.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "81dd9f71a80cdba2b651c8c86e58d42c96f22c9e8188b4b8ce3c107c0fb71266",
      "text": "Apa yang paling membantu kesehatan mental kreator konten?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "83eb6455b4b083fcb8de2ebac9b688e68dee6f805b1ccbcad84c996087496615",
      "text": "hoaks",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "880cdd4db651065c7607cb95832fe35b58eff7ebe1e133e9cc66ce95c7208d4b",
      "text": "literasi digital",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a10ea45f0d28242b602af0b3df82baa62a96cbfbc5873cb283bf392435293ea",
      "text": "akun palsu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c58064d99e3d1528d2a3eb13758e9f9467435a02bcc0a2a02d7bba4a0449a50",
      "text": "Disinformasi itu sengaja dibuat untuk memecah belah warga.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c7260f1fd3b923276a7a75a83455b9219954e45339650905ade077027f9f68c",
      "text": "Utas yang baik memakai sumber yang kredibel.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dd401602841b71903ccb4154f0c7e41a71d6e629d4aae3d758e11b4eef36420",
      "text": "Opini harus dipisahkan dari fakta dalam berita yang objektif.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f5671cf5e446d7605d1525d7689993a7d16acd08ec21479c927d59158b80701",
      "text": "swafoto",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9095426f74b6ce74141ac07e696ad260f9266bd4f39d86030ef192b8f03f17b3",
      "text": "Setelah kebocoran data, jutaan nomor telepon dijual di internet.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "913938dd080390900f9f048c63dffc77c048299a4852e249528934713ab830c5",
      "text": "CekFakta dan nama kotanya, Sorong. Pendek aja.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "92eff1d05b0f58737e6e15732a250c6e69ab81d104ace489440d893e4f44e3dc",
      "text": "perundungan siber",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "954b4486ff5e714d4f03846d12d310c4c48e718e7aeec8e2009a46d5ff35d8ea",
      "text": "Judul berita itu provokatif dan isinya menyesatkan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9569d8d68bb592e80f9e4c2619c4a878e2f87a1bf530b89c85ee26d6496e639d",
      "text": "Tim pro sudah bicara. Sekarang giliran tim kontra, Mohamed.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d0d592670a5719bf59908957e5e30c7d8d702b0b5b8edafd3eb8947558f866",
      "text": "detoks digital",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "973c43d025a04fa479b58cabcd05e8553e1e890fff4a334fea4454ee9d52d98a",
      "text": "Yuk, kita cek fakta. Mulai dari sumber resmi, situs Dinas Kelautan.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "98310e7bb4d5a8d0a9ef99d362d5609be2813b385e428c9efd2846cb951f8469",
      "text": "Mohamed, kita wawancara Lince, kreator konten dari Biak, sore ini.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "99e9fe98d26eb98489b26411872a6d42fae8760a32f48589dec76090106c6080",
      "text": "Kemungkinan besar. Mungkin ada pendengung yang dibayar.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b47ce6999b357f3dcbdb6dfb1638063a670a6779c36fc5a84c848a185401d49",
      "text": "Hasil cek fakta menunjukkan bahwa tangkapan layar itu palsu.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d9398e5424e8eac54b9f238bf019649d6a7fcfe66768d0231ef801329d24d8c",
      "text": "Jangan pakai terlalu banyak tagar. Dua atau tiga sudah cukup.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e0d0444295c2cc1ab205834d8cc853c77707daa68b0ab903925e367ce7e2b7b",
      "text": "Hoaks air beracun itu udah sampai ke grup ibu-ibu. Yuk, bikin utas.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e2b81af344a9e9eec08bb110aea88a259a66d87d95039d3195f28f09c6a6d88",
      "text": "dampak negatif",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0df25a0ec2b9158e534f57720d4d4eab8ff628a589c35a1c412860e7cc2fd4f",
      "text": "Repetisi dan antonim membuat pidato lebih kuat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a114ea2ea1e417dc5e3f503c0714c0a3dad0c28da27cc96ab128c05fad14ecdf",
      "text": "pemalsuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a26b9778cabbcae29ed21a143c54755f7272d3576a405b5fe34607489c76f9bd",
      "text": "Yuk, cek fakta. Para peneliti cuma memperkirakan ribuan tahun, dan mereka masih hati-hati.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ed49a659ff108d0e0beedf66971d9df033e89377eb83bad504f042d7c46075",
      "text": "Tim cek fakta menemukan bahwa kabar itu hoaks.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a46d00dcc9dc202a9433d48b46bf58cf6a1e245057bb95896b9538fdbb2e6dbd",
      "text": "hiponim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4e7c1f98346790e7aade9fe107859f14be810417642176692294832c9eba091",
      "text": "Unggahan soal larangan mancing itu udah viral. Tulis beritanya, ya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51aceb037bd163e71ef0fbae48e4acd9e4553d8bc5729f2a640426820029c15",
      "text": "Peretas sering mencari data pribadi lewat tautan palsu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5fc99dcdbb7134d4849c02b82aa35b83fe6d4ec3bc64a7d9094141641ec6547",
      "text": "Kreator konten itu membuat video tentang kuliner Papua.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a73e41e5c6d183a8b2010eb463dcb6c4392c77d15eac810c7e6e77b6e1bddf49",
      "text": "Kolokasi seperti \"mengunggah foto\" terdengar alami bagi penutur asli.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "a89250ce63e1e1df7f7af2e6f81cf218746d16136590ac740b35328ef0f36cc2",
      "text": "Unggahan yang provokatif itu ternyata berita palsu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a98999c2a4471de48df095113aa4f9999fe70dbc4b804fdd17db711567164075",
      "text": "Saksi mata menceritakan kejadian itu kepada reporter.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "aabac6a4d417939feff45a9122ffaf2961f7d8ebc43a3ae5048154f1a0e2d7bf",
      "text": "Akun palsu tidak bisa terverifikasi dengan jujur.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "aae041eab8062e43cfb7b312d225c3dc89fbbee1515df6d44eefe8e31f2c8921",
      "text": "peretas",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ada3ac4cec705c656d2ce080becb60c406c9efea1d51f25bd69569bfb6ea18ed",
      "text": "Mohamed, pesan ini udah dibagiin seribu kali. Isinya salah.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "af1405c2708aca5c85bea4074003070a0836498469ec24142de0c05cf8cb89a8",
      "text": "Unggahan itu memuat opini, bukan fakta.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b02f0a3cb35718bb7977b08727128dfe9e46f13f8c8de02db0e76fb1b588742e",
      "text": "Saya mematikan notifikasi selama detoks digital.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b078a5fc74ac0dedd2881a38f33f8f3b9e4d297bb3695b0bcc061248015a7530",
      "text": "Besok pagi aku wawancara mereka. Opiniku sendiri nggak aku masukin.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "b080a02ec1f111a5f027de72940b3add58faa48bc477a948536a3bf158377902",
      "text": "Jadi ada kerja sama. Dia membujuk pengikutnya tanpa jujur.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1e62d24873871b50a307f7a54495675c8a3d60a588576494642761d71753954",
      "text": "misinformasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c2b7a2656741afee8900dd272ab92fc11ca0db4f8b34cc1ae16a413f49ed41",
      "text": "Sama, dia pernah detoks digital nggak.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5b6c9f97a2c7aaf905d63cc017ee84d7259e2286a35c09daafb786126486ce6",
      "text": "Mungkin dari kebocoran data. Itu rekayasa sosial biar Kaka percaya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5cb4f59a25c1bc49f71998588740000c1cdb5694e3bdde1e1665196a8273aa5",
      "text": "Nggak pernah. Mereka juga minta nomor KTP dan kode OTP-ku.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b613e9f0b3261d191ff7663abc1a1a6ca0778111a4815b8bfd49ccf6ccd92468",
      "text": "Saya tidak mau menyebarkan berita palsu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b85ae82e0783dcd3fa25111919f4dab2a1f04e92e7ec6acb6ab8e196e9ca38bd",
      "text": "Saya saksi mata. Saya melihat kapal itu menabrak karang pukul sembilan pagi.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "b87e01c06de2d3177367aa357aabfdec0ecf2c57eed078fb74b8c6d33e2b7b2e",
      "text": "Jangan klik tautan pengelabuan, sekalipun pesannya tampak resmi.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8b92f23e8a1039e404da4b3906a75bfcea07c93e89f0723926963bdab253d4f",
      "text": "Literasi digital melindungi privasi kita dan keluarga kita.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "baefa2a434a5415eb8f9a5c1c9f833a25bd10d5a208e773ab21c549dbf8aa232",
      "text": "pengelabuan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc3b0025d5c4c666d34fdabfce9fb5993a2cdce8fd1309fea094385f5e3e1bf4",
      "text": "Kecanduan media sosial bisa mengganggu tidur.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "be7bf920be6dd45212821b8b6f8ed3b30215402d69b098b5df449968f5beb322",
      "text": "Video ini konten bersponsor, jadi harus diberi label.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfb3c2ce24db0d6a9ef8481cbf2c7e0645b709723e7e22ee2a9f3210e86fa5ca",
      "text": "Foto yang kamu unggah hari ini menjadi jejak digital untuk bertahun-tahun.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd4d3575631affcfa15d63ac30afdcf175304f3dd7b6442072c837d4c772709",
      "text": "jejak digital",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "c055eb9d93920d60b248fb432ae8be84fa2784fc1384d6e8cc0364828f8836ee",
      "text": "Ada siaran pers pagi ini. Katanya airnya aman.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c108beedbbbdb4ac9e185e3177c3ce82f7b24e74246b6ca102069c62c11cad02",
      "text": "kolom komentar",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c18b8ad165eaeade91f90a2a0535842196622bf581d665ed15da5bccacde992b",
      "text": "Mereka tahu nama lengkapku. Kok bisa?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c19654351f52a1d25ec63b7441252985e2e7d0df391908b6933281d8bae2cb89",
      "text": "Kata \"menyebarkan\" sering berkolokasi dengan kata \"hoaks\".",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1cb523e7056bcc8f5d2554bbfb6a1029e48c4f7cac31bb0a231817cf2da76f4",
      "text": "Akun dengan centang biru belum tentu jujur.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40309340ceda10ee52aa4e120b6484c2400d585c512f855e5d34eaafb0c3c1c",
      "text": "membujuk",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c8dfe0b1ac33f78c0c6f20a8098abf15f119d65652ce9687d30c66243b3ad9",
      "text": "Bocornya privasi adalah dampak negatif yang sering diabaikan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5dc80059dca6a26b0a84fc0f079d89e8a14e0515bc281cef572f3720a852b76",
      "text": "pembingkaian",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6d149ceee64b44c4b946cfb548120c1c70bc1594ee2a7bc3ad531192017533e",
      "text": "verifikasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c72d04039e9969f1370c8eb10b6a3b79fac67839cf969942660c92b87d65e6b8",
      "text": "Tiga hari? Ini konten berbayar, ya?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c802d99aaa618858b0537e784cb267e6232999da07be096bdc7790c01d912d3b",
      "text": "Pesan itu adalah pengelabuan yang meniru bank.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8c78c3cb2ab154a755f478b21b35cc22ede9fb2d294ee768e13a6ed98ac2dbc",
      "text": "centang biru",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9e48b32d238d265beccab3fddbeec3ed7138e7365fb4936ad9d50c54d189a74",
      "text": "Kebocoran data dan perundungan siber adalah masalah keamanan siber.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbae26790d782c26644c16fd91b80fe61fae60abf4f8684fc09e25eecd793fa7",
      "text": "Akun pertama yang menyebarkannya punya kepentingan politik. Jadi disinformasi.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf09bb624ebfba50f98ff2704aa73604d7fb8a52c4c3b3debd1377fe26a07402",
      "text": "Dia juga bikin konten bersponsor?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf6c95a1c852fc21a0167254d4a4f4722767bd55e14d031d79f2812c6a867d28",
      "text": "pendengung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4c4147315903a32d3ecb71dc9d5daf1908e2400d6ef88b9b22fcdaaddd77867",
      "text": "Judul yang provokatif sering dipakai untuk menarik klik.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d51c0d82d7961041c99a20608a23eaf2a43a0e8a24b9c2695b5c0e5be6d8e711",
      "text": "mengunggah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d80d05caac7e46a7ef1765fe9fee6151e53b16b0051a74c78ba736361f861e68",
      "text": "keamanan siber",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d845ca958bc170cdf8ac27b0b8d9bc63d9becaa7bcf51a3aadc01427327c7201",
      "text": "Selamat semua. Tapi ada satu ibu yang nangis di video. Boleh aku unggah?",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d89cac04718affa73f0b1c91d27dc0b0a701a38b92d7d92249e2090467f543f1",
      "text": "Para pendengung dibayar untuk memuji calon itu setiap hari.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b9abf8aa54257c911f6ae05c8180d2f75bfe8c019dbe72fb4d6a33263988ee",
      "text": "Masakan Papua. Kanalnya udah lolos monetisasi.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d922d33e82e2ecb89a1e91dd35ca2a77cef0e8139594c34f9b6a927617bd45ad",
      "text": "provokatif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9704494ef0e27dcbeb9544b002cee4d1e700f88cf32e67e4aab9a0e71c7d4e4",
      "text": "Dalam jurnalisme warga, kejujuran lebih penting daripada kecepatan.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfa9ff19c8b65d2bf4dcb34ce575957b8332ad0502ef1da98c7d422e2fb56818",
      "text": "Kreator konten harus memberi label pada konten bersponsor.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e039201411ca785e2c2edd5a7a5bbce4d7680e5c819c6327449617991913020f",
      "text": "ruang gema",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e04205bd4f7f71eda1a72c6d85f0e6ba0c4b22118e6abfaba9d6b4722672bde2",
      "text": "Jadi unggahan itu menyesatkan. Makasih, Kak. Besok aku berangkat ke Manokwari.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0c8f26daab42adbea8262605707e4dbd8caae2a17fae49c9d08437abdc958ca",
      "text": "kebocoran data",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e59f35774272c51fb43f5a66b15da4e22f278a2b79443068308e22f5e3dc39c4",
      "text": "data pribadi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e60362cee16381b91f1ef46a976a307d270eddcfeb15276f02b4b89599f6782b",
      "text": "umpan klik",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7188d54cb3cbf5498edfe47eca773ea3bebde4a0c8c173d3d8a6d8b4597bc95",
      "text": "dunia maya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8ec16e02c471d846d4d272c2daaf61d82d717631a65708a14c421b8971a6566",
      "text": "menyebarkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab1c71041f24f3da8c4888424fbcb7628a97788958726b211733a3ba2686b2f",
      "text": "Terus video menteri itu? Suaranya kedengaran aneh.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb66243781b81be1f718c9eafc01b94bd1dc4d64d9ff541b24ecb963fb4a24a8",
      "text": "Literasi digital, sejak sekolah dasar.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee866332ef67662f9076fb6ca6595303a03e6b1a95ba3f2e33749ad3e459aa1e",
      "text": "kecanduan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb2ca9e0eb14bfdecab5fc4331a560aa1ce342b7278209f85cbec0acae2875f",
      "text": "Betul. Bagi mereka itu misinformasi. Ruang gema membuatnya cepat menyebar.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "eefa4e7160a9faf6e705392882246a9992e283f7a50e2ab314c81e8a3ab56b15",
      "text": "doksing",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1022cf0b870391ce1b807dfafd9a16e5554a0e765e95b8fc9f02e48cbf58dba",
      "text": "Di dunia maya, orang lebih berani berkata kasar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f22026340439c144767baeffc82046abdd55feeb0dd82dce001053f5a4b3a7fc",
      "text": "Kolom komentar videonya penuh pujian dan beberapa hinaan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2ab484d23f692d79076ef8f2c27c7ba378b0f22da25b5e75921a84c0064bb58",
      "text": "objektif",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4087ad5acc19f27519f35d715c98caa1046b481ed3aaddb0f660f373c0fc3b0",
      "text": "opini",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4487ce8d918ec63d553383fc0ccc68db0a7bea65200a2f508790444288f9753",
      "text": "Media yang kredibel selalu menyebutkan sumbernya dengan jelas.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "f720e510c69f8e1187c59ad8495b52ce2b1837ac8e40cc1418f4c6a92c906f30",
      "text": "tagar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f85aa7eac0d177902eaf5f64ca5ca933668761b9be4875b0bfb2b8ac2aaff4d9",
      "text": "Di ruang gema, kita hanya mendengar pendapat yang sama dengan kita.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8cbadd9d843b3a1c8f7cabc2c8a5d77d207fc10b6c0f596f8ef7ee3ee179139",
      "text": "repetisi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa0b7e03d7b3fafc6cb8d6d9672a3ba087f1104da2bc980774512576f31bb9c5",
      "text": "pelindungan data",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbee72626749aae89888d64f87e4145600458e7b942ce1bee40e4d0bd8b321aa",
      "text": "Tapi kebanyakan orang bagiin karena percaya.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd82b1827a226286e02b27352c37f3befe30136ae0fc04e254776cbe507c2df6",
      "text": "cek fakta",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdd0dad46a6a616b35b900f998f05d95bc9424c8d9cb25b2884f9b50c0816da5",
      "text": "tangkapan layar",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdde647f00a24c7ed4f89bb3a7918f2ea9c309007d27484397bf196efd953326",
      "text": "kedua belah pihak",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe30a02d17e2527e177599a54440708c4fd43ec5eb0583626473dfb759469d47",
      "text": "deepfake",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefd2deba84ef6400f1fda0890c1a73357a0b6aa0dabd824461ee20ec030cf7c",
      "text": "jurnalisme warga",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    }
