{
  "format": 1,
  "id": "id/bipa7.u06",
  "language": "id",
  "unit": "bipa7.u06",
  "version": 3,
  "content_hash": "273ad1b938f7db944e0e95bfc51a644e5adb4613573045a11f09ba6f4a152684",
  "lessons": [
    {
      "id": "bipa7.u06.l01",
      "sha256": "be9bf8c7e2f32220461c34d7b8568cc21c01a2bd3386e12cd0d86152dc0e0888"
    },
    {
      "id": "bipa7.u06.l02",
      "sha256": "ac602a83085ca8d94861527e9cb41cfacc031fd5b3965f5b1025919b7ca92d0e"
    },
    {
      "id": "bipa7.u06.l03",
      "sha256": "0624e839049f47341d1a4117bc56fd1cb314dad9f036d5056ca6d4e6cd59fa25"
    },
    {
      "id": "bipa7.u06.l04",
      "sha256": "6b66b1495ce03bca8955715ab7b2a2b8051db0a506ba66cbdf5448dcdffdcf9f"
    },
    {
      "id": "bipa7.u06.l05",
      "sha256": "8c2bd09c01b5bc2be100ea21f1bf31fe5c725578bbd8ba85eb93ad9e1a14c821"
    },
    {
      "id": "bipa7.u06.l06",
      "sha256": "6ae5ae860599c89ffcdab32108cb91762b4095a7acb0c2e6ed4610d5f5b10b64"
    },
    {
      "id": "bipa7.u06.l07",
      "sha256": "20e518179154903401ccc823047aeb3bfb88da817cbfc0129be6b451ecdd753b"
    },
    {
      "id": "bipa7.u06.l08",
      "sha256": "e48bbae7c0f5e96e06f0f014c5c0cd16085999ab4c9295a74656fc2645507197"
    },
    {
      "id": "bipa7.u06.l09",
      "sha256": "63b66912f209d8a79d61073a241375cbe94814e162e3e36f11ea8093854196f2"
    },
    {
      "id": "bipa7.u06.l10",
      "sha256": "e5f0be67011d9a6b6f709fa70be6faa686d413efd7a8773bab7fa224950bf110"
    }
  ],
  "audio": [
    {
      "key": "02c6b76558593c1cbdb37126e81eb3f30397ea2e450a5a7fd67f8514fe9a3831",
      "text": "Tautan itu mencurigakan. Alamatnya bukan situs resmi bank.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "039a9a53da5fbe7214cd8d78eb8a25ae28d9472d00b1fed3dd9f77c34529f5ea",
      "text": "privasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "04efdd737591ab56d8005f14564555089f640169cd9667448d36dfca31beb92e",
      "text": "Ayo kita cek fakta. Mulai dari sumber resmi, situs Dinas Kelautan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "052206094f5cbc4a6be226e827c459fcfbb2e05ea058bb170061e957a1de0d5a",
      "text": "Lihat pesan ini. Sudah dibagikan ke dua puluh grup sejak tadi pagi.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "06b7d6730576a75c5ff00554fc15da0664b4f61a1ab68b4a8f0714cd18257505",
      "text": "Ayo cek fakta. Para peneliti hanya memperkirakan ribuan tahun, dan mereka masih berhati-hati.",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b6d44796fa7ca63284c4e592f564f5db4f0d379d41cc275e575b171110402d2",
      "text": "Unggahan tentang larangan memancing itu sudah viral. Tulis beritanya, ya.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b995f0377b53f55927ababe74a16bbd8d496f4f5ebee4e09ad58e92d4be1853",
      "text": "Lihat tebing itu. Ada lukisan tangan merah yang sudah sangat tua.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d811072b56767ccfa3537fd6608ae48548109d73514c2bdd22fcad1ade2cadd",
      "text": "Pakai tagar CekFakta supaya utasmu mudah ditemukan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e78dab0f6be40420faea42d8a8ff9b757ed45166dddc14911197cccd4bd392c",
      "text": "Saya mau kerja sama, tetapi hanya dengan produk yang saya suka.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ebc91d6c4077a12b010d39a3d5060dc0b5265d9c8f3d5104b0728788e9d77a6",
      "text": "mencurigakan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f2db9542750fa7e06203aed146dd516008725c9f96a7b51ba874426e37b2349",
      "text": "Menurut saya, kuncinya bukan larangan, tetapi literasi digital.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "11e99827eb724897aa10e0a5130b68a69c7d78a4c5c03f044e56e0629568fba1",
      "text": "Terima kasih. Kami tidak menolak manfaatnya, tetapi dampak negatifnya nyata, yaitu kecanduan.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "1286a6c9f3a11cede0fdd5858ebd3eb7ce9872414bcab6ba6eff45d6feed8a05",
      "text": "Hoaks itu menyebar cepat karena banyak orang tidak tahu cara cek fakta.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "14497bc979b97e6a61b2274fe2ffdb08da491fbbed01369b22fba2cb288138e8",
      "text": "antonim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "159bd0ae184cab005bb62c6754c4b85ee69d7d7c5a54cd53c1f1deb1933d8417",
      "text": "kerja sama",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1986de420a45b4da408d4eda8fedfaf61b4b7d99e0ff9147475bcc41e1a6a659",
      "text": "tautan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bcd60533fd3c30ec6e02869cd09c0c6637e53088d46629b91de4456de752ff9",
      "text": "Wartawan yang objektif memisahkan fakta dari opini.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d45ecb1385c6823be57d91f737a7a8422aad90067fd5dbd24c04cc419bac030",
      "text": "konten berbayar",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e99d36ad224e4e38b450eb82463c26909a25fa8a5765d9e9d40dae6033e789f",
      "text": "Boleh, tetapi tutupi wajahnya dulu. Jurnalisme warga juga punya etika.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ead54e951511a192a70b70c551755d26bd3839e584784482e47dc8ad044f48a",
      "text": "Seorang saksi mata merekam kejadian itu dengan ponselnya.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f35f32d416c1ee0c42147902f2e2b083abeff1090d1e1b1f4f5b52fd1eedd8c",
      "text": "Pemengaruh itu membujuk pengikutnya dengan kata \"diskon\".",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f459beedfc1e5e780eb54be96d02f120e50bfcd4bd6c29a7a1bcf290aa59b24",
      "text": "kredibel",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "21256f1167332ff8fc0aa6f7dbe3eaa9201c54fe0325c0e842c7088bcc2254c7",
      "text": "pemengaruh",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "22beeda499a69c438fb2591057d3b251b90d173776692ff699cdd5d22051a5d0",
      "text": "Tulisanmu memakai kata \"hoaks\" tujuh kali. Coba ganti dengan sinonim.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "2534ccb190d6cd5748a831fc7c3f90c460e327001cec1d7547503295ef6b8698",
      "text": "Kalau begitu, besok kita cek faktanya bersama-sama.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2abf93cbb865fa35f570f8ccd89b611113ad311b5298201c06961b466a028378",
      "text": "kolokasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dc1a22b3463a8d0847aecf59cd2010c7c09121f3eb5b8c8ee34966e9d97ad76",
      "text": "Jangan pernah memberikan kode OTP kepada siapa pun, termasuk orang yang mengaku dari bank.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f7d347dbd4acb6c4c277bb03371b6e9f7b4af42323977dbca3b72a13c8fb2dd",
      "text": "unggahan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ff11e8b41b4f3cccc362772fd95584b798c24d950c09c16e0766e85012e3bba",
      "text": "Kalau tidak ada tanda iklan, saya ragu apakah itu konten berbayar atau bukan.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "339e67302e2ed190a879534b7f72ea3011861599944f2f2fcc929c3a6cc8f57c",
      "text": "utas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "339e6c953a69e24a5004dda2b083f2ae114539992c04b000c6bbaef8755f0946",
      "text": "rekaman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "346d2208bb0961e8d9d89082b61435bbad82f822dbe52ab6eb8f429221951b4e",
      "text": "Pemengaruh itu punya dua juta pengikut, dan videonya selalu konten berbayar.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "3968c62081cc0f95bb7867a09d01da905e7d3926940cf6a9c632e769422644fa",
      "text": "Verifikasi membutuhkan dua sumber yang kredibel.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b97740dbfcb1f1af0075e07eea2bbfe19c87624255a897abfa00b26066cd26d",
      "text": "Siap. Bagian terakhir, \"Bagikan utas ini, bukan hoaksnya!\"",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "42f0cb1b50caac2a0af8dda3abec7113b6e484e095a9141b744d8145dffd9cf8",
      "text": "Radio Kaka Yohana di Sorong juga memberitakan hal yang sama. Jadi, itu hoaks.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "438227de39197c9ca80755e117192369bb17f41d0866464fe2b44a938c5d8da2",
      "text": "Hiponim dan sinonim membantu kita menghindari pengulangan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cae78e9c117f261eef18bc5ad79621151a99ca88a5da8d4103fb7023c1ed49c",
      "text": "Dan nelayan? Berita yang objektif harus mendengar kedua belah pihak.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d3ebef748ce9ab8ba3d182daf88f658f6da24d141b9a585e36b51f146b6d080",
      "text": "Video ini adalah kerja sama berbayar dengan sebuah merek kopi.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d4e6b214f88a90a8969d17b57bcd4fcf97596bd3be6dfb5275a70359524d046",
      "text": "pengikut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dbb2268004323cc7d9782b0dd6fce299fa4a77ee1256236a7b7ac78b25d61fe",
      "text": "Itu cara peretas mencuri data pribadi. Hapus pesannya dan blokir nomornya.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e607e8bb5c8b28e9cffaef543ea80b9605c3189d06849570df69fbd342ee48a",
      "text": "Jadi unggahan itu menyesatkan. Terima kasih, Kak. Besok saya berangkat ke Manokwari.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "56bdf0ee1478d7d8ae057879c1160bbedb69261de113bd2f2a75f81fbae8b0d4",
      "text": "Satu per lima. Ada pesan berantai tentang air laut beracun. Mari kita cek fakta.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dbf1af9079067bc9c710bb5f969dcb729056b9e5b51db3baf74163c8f987ef1",
      "text": "Pesan ini mencurigakan. Tautannya aneh dan pengirimnya tidak saya kenal.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "65473df8cca6d83e5d4e0abee550ae45c07cc978f977494605ca19c057ccab92",
      "text": "Tunggu! Itu mencurigakan. Kamu tidak pernah ikut undian, kan?",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "65ebca8c0ebf52b05e53d6fdde98756a4007d7db7f206d605502098818ffa600",
      "text": "saksi mata",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "669d9f8c6956a895d67cb8e0778b742d94e4ed6474081a965b9c152805cd50f8",
      "text": "Unggahan itu dibagikan lebih dari sepuluh ribu kali dalam sehari.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "66b74635a373b43e7583a7f760f16e439268636a95e2a7850e49e34db2a66054",
      "text": "Setelah mendengar kedua belah pihak, ia menulis laporan yang objektif.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "66f30702517dad2b67ff2ac13d0746149b216746081d4b7f8ef7057d16812722",
      "text": "kejadian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "696c566bd41a51622aa61e4b5c4a8f245d166e3859a7c8046a85f79a1467209c",
      "text": "Dan antonimnya, \"fakta\", saya taruh di kalimat terakhir.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a116a46f892d449cbaa1c49bb152f0892bb387b19080c69cefc1a8c12cd6722",
      "text": "Jangan mengunggah rekaman yang memperlihatkan wajah korban.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6acf2340072940bfe0a9f38b733738e212509816e2a8334bebbae7a807b90cb2",
      "text": "Argumen yang seimbang. Apa solusinya?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c18da10aa87893a35ca54b55e2c3c3b6fbfaff1a01b62b08951acecb8c863c2",
      "text": "sinonim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e51096b7bd8c2f5b91c158a5134592ec9cce93e229e4d2557af4c2ba72724c0",
      "text": "Tidak ada tanda",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f89c5f431d88ed9a1af774359a8f6758d3d8786b181293bf4741b38aa6e02cb",
      "text": "sumber resmi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fb8d5e2edd4279c2734b206beecae528d5f850d9a09f84a228e9a64f6b49d19",
      "text": "menyesatkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "733dc50bb1d1415e9114f261b03968853b1c6c78b5b50bdd9dfef93a17a898f0",
      "text": "Tim cek fakta melakukan verifikasi dengan sumber resmi.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "759023d57d4e43af790b051c0529745b30113edf324a4fdb8eacf819b140a33e",
      "text": "Tiga hari? Apakah ini konten berbayar?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "768f4c1c5fb918893afbbd62cf6481e208f78528b5149a94a6426c8a3adbec01",
      "text": "berita palsu",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "794101eab1cff738b7ee77861bb123073a20d4de4e525153d95e5506b30425a8",
      "text": "Kamu saksi mata? Semua penumpangnya selamat?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a0d03e464bd056ef27c1a64e209450c934b3586149d5be3edf2b0820961fc31",
      "text": "Berita bohong, kabar palsu… Tapi di judul saya ulang \"hoaks\" dengan sengaja.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ab93a5a7f08ae985ceed4bfc9f2657e4b6e97ac937dc2e0f75394f5cb47ebf2",
      "text": "Selain itu, privasi anak-anak sering bocor tanpa mereka sadari.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c194b351e788661c5f0fa320ccbc09fd0a6e387607b48e3dbd834885814894a",
      "text": "Itu boleh. Repetisi yang disengaja justru menegaskan pesanmu.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fdaf99e7e8a97d682e852117c1b01bada6ffbe02f26ed3dd64897ee3fde0778",
      "text": "Hoaks tentang laut beracun membuat nelayan kehilangan pembeli.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "83eb6455b4b083fcb8de2ebac9b688e68dee6f805b1ccbcad84c996087496615",
      "text": "hoaks",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "880cdd4db651065c7607cb95832fe35b58eff7ebe1e133e9cc66ce95c7208d4b",
      "text": "literasi digital",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c7260f1fd3b923276a7a75a83455b9219954e45339650905ade077027f9f68c",
      "text": "Utas yang baik memakai sumber yang kredibel.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dd401602841b71903ccb4154f0c7e41a71d6e629d4aae3d758e11b4eef36420",
      "text": "Opini harus dipisahkan dari fakta dalam berita yang objektif.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "924f86aa3e00e0f14f3b9ec4084764269b3a3563930196dd3847fcf09670c51c",
      "text": "Besok pagi saya wawancara mereka. Opini saya sendiri tidak saya masukkan.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "954b4486ff5e714d4f03846d12d310c4c48e718e7aeec8e2009a46d5ff35d8ea",
      "text": "Judul berita itu provokatif dan isinya menyesatkan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9569d8d68bb592e80f9e4c2619c4a878e2f87a1bf530b89c85ee26d6496e639d",
      "text": "Tim pro sudah bicara. Sekarang giliran tim kontra, Mohamed.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a5fdb2a94222cfafb40695166cb8431af4a56e4990222770dc6f97f6f39add8",
      "text": "Ada siaran pers pagi ini. Mereka bilang airnya aman.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b47ce6999b357f3dcbdb6dfb1638063a670a6779c36fc5a84c848a185401d49",
      "text": "Hasil cek fakta menunjukkan bahwa tangkapan layar itu palsu.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d9398e5424e8eac54b9f238bf019649d6a7fcfe66768d0231ef801329d24d8c",
      "text": "Jangan pakai terlalu banyak tagar. Dua atau tiga sudah cukup.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e2b81af344a9e9eec08bb110aea88a259a66d87d95039d3195f28f09c6a6d88",
      "text": "dampak negatif",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ecaeebf85c70256ee1215aa9c5c9532b17380f7eef4b948f64845df21f87a53",
      "text": "Tidak pernah. Mereka juga minta nomor KTP dan kode OTP saya.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0df25a0ec2b9158e534f57720d4d4eab8ff628a589c35a1c412860e7cc2fd4f",
      "text": "Repetisi dan antonim membuat pidato lebih kuat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ed49a659ff108d0e0beedf66971d9df033e89377eb83bad504f042d7c46075",
      "text": "Tim cek fakta menemukan bahwa kabar itu hoaks.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a46d00dcc9dc202a9433d48b46bf58cf6a1e245057bb95896b9538fdbb2e6dbd",
      "text": "hiponim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51aceb037bd163e71ef0fbae48e4acd9e4553d8bc5729f2a640426820029c15",
      "text": "Peretas sering mencari data pribadi lewat tautan palsu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a73e41e5c6d183a8b2010eb463dcb6c4392c77d15eac810c7e6e77b6e1bddf49",
      "text": "Kolokasi seperti \"mengunggah foto\" terdengar alami bagi penutur asli.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "a89250ce63e1e1df7f7af2e6f81cf218746d16136590ac740b35328ef0f36cc2",
      "text": "Unggahan yang provokatif itu ternyata berita palsu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a98999c2a4471de48df095113aa4f9999fe70dbc4b804fdd17db711567164075",
      "text": "Saksi mata menceritakan kejadian itu kepada reporter.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "aae041eab8062e43cfb7b312d225c3dc89fbbee1515df6d44eefe8e31f2c8921",
      "text": "peretas",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "af1405c2708aca5c85bea4074003070a0836498469ec24142de0c05cf8cb89a8",
      "text": "Unggahan itu memuat opini, bukan fakta.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3710fcb16dd1c74500d1f30d5272f3caf0d8b35df1dc70257cb5c88c222bf04",
      "text": "Bagian pertama hoaksnya, lalu fakta dari sumber resmi. Tagarnya apa?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "b613e9f0b3261d191ff7663abc1a1a6ca0778111a4815b8bfd49ccf6ccd92468",
      "text": "Saya tidak mau menyebarkan berita palsu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b85ae82e0783dcd3fa25111919f4dab2a1f04e92e7ec6acb6ab8e196e9ca38bd",
      "text": "Saya saksi mata. Saya melihat kapal itu menabrak karang pukul sembilan pagi.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8b92f23e8a1039e404da4b3906a75bfcea07c93e89f0723926963bdab253d4f",
      "text": "Literasi digital melindungi privasi kita dan keluarga kita.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba714ecd618c8eef15ce9bf14bad06f5c2bff477b03a220c2502d7483a3ecb0e",
      "text": "Di internet ada unggahan yang bilang umurnya satu juta tahun. Itu benar?",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc3b0025d5c4c666d34fdabfce9fb5993a2cdce8fd1309fea094385f5e3e1bf4",
      "text": "Kecanduan media sosial bisa mengganggu tidur.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "be1620a31f3d0beb77f9b7794d2a9008426f9cec427c4c171117b3c29fee8e28",
      "text": "Berarti ada kerja sama. Dia membujuk pengikutnya tanpa jujur.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfac3c35c9a0bdb30fc0595f8ff36117c8e9cb570b4829813d78e3c0e32d7703",
      "text": "Mohamed, lihat ini. Pemengaruh ini bilang krimnya bisa memutihkan kulit dalam tiga hari.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfb3c2ce24db0d6a9ef8481cbf2c7e0645b709723e7e22ee2a9f3210e86fa5ca",
      "text": "Foto yang kamu unggah hari ini menjadi jejak digital untuk bertahun-tahun.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd4d3575631affcfa15d63ac30afdcf175304f3dd7b6442072c837d4c772709",
      "text": "jejak digital",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "c19654351f52a1d25ec63b7441252985e2e7d0df391908b6933281d8bae2cb89",
      "text": "Kata \"menyebarkan\" sering berkolokasi dengan kata \"hoaks\".",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40309340ceda10ee52aa4e120b6484c2400d585c512f855e5d34eaafb0c3c1c",
      "text": "membujuk",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c8dfe0b1ac33f78c0c6f20a8098abf15f119d65652ce9687d30c66243b3ad9",
      "text": "Bocornya privasi adalah dampak negatif yang sering diabaikan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6d149ceee64b44c4b946cfb548120c1c70bc1594ee2a7bc3ad531192017533e",
      "text": "verifikasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbac4a49b7bf878d64523d62879f6dc9680f69f386c2b9798d52ee23370e3fd4",
      "text": "Bagus. Sekarang verifikasi dengan satu media lain yang kredibel.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd0f9457ebf79bb342a1918ea0f9e41e1cb367f13f8f633e1aa34b7c930696c4",
      "text": "Judulnya provokatif sekali, dan sumbernya cuma \"teman\".",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1e79dc64b9cf741e7bdb09b88f85bfd49bc6aa76253dd8c7c2bea94e24395bb",
      "text": "Kak Selvi, saya punya rekaman perahu terbalik di dermaga tadi pagi.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4c4147315903a32d3ecb71dc9d5daf1908e2400d6ef88b9b22fcdaaddd77867",
      "text": "Judul yang provokatif sering dipakai untuk menarik klik.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d51c0d82d7961041c99a20608a23eaf2a43a0e8a24b9c2695b5c0e5be6d8e711",
      "text": "mengunggah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8a3a9647a295874d5ef15f03da9d9f05b93cbbd9ee80a0e067f96a0891618a4",
      "text": "Selamat semua. Tapi ada satu ibu yang menangis di video. Boleh saya unggah?",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d922d33e82e2ecb89a1e91dd35ca2a77cef0e8139594c34f9b6a927617bd45ad",
      "text": "provokatif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d922dd71cb277fd526a58587c1412addb851b72db166228bcd992b8200f10009",
      "text": "Betul. Para nelayan sudah panik. Hoaks seperti ini menyesatkan banyak orang.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9704494ef0e27dcbeb9544b002cee4d1e700f88cf32e67e4aab9a0e71c7d4e4",
      "text": "Dalam jurnalisme warga, kejujuran lebih penting daripada kecepatan.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46e65b0265edcefa9eb0bedbaa0d808515eea9ede8a65adf3675f79018551bb",
      "text": "CekFakta dan nama kotanya, Sorong. Pendek saja.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e59f35774272c51fb43f5a66b15da4e22f278a2b79443068308e22f5e3dc39c4",
      "text": "data pribadi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8ec16e02c471d846d4d272c2daaf61d82d717631a65708a14c421b8971a6566",
      "text": "menyebarkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e96a1f1f82f2bf1393529198e83f150ba60aa442d73e7f3391a08aee29f0c870",
      "text": "Saya sudah bicara dengan kepala kampung. Menurut beliau, larangan itu hanya sementara.",
      "voice": "id_ardi",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb66243781b81be1f718c9eafc01b94bd1dc4d64d9ff541b24ecb963fb4a24a8",
      "text": "Literasi digital, sejak sekolah dasar.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee866332ef67662f9076fb6ca6595303a03e6b1a95ba3f2e33749ad3e459aa1e",
      "text": "kecanduan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f02983ead26a8d5fd7fba339a3df8e3952f3830a71e1ac1ba6a110a0b1c783cc",
      "text": "Hoaks air beracun itu sudah sampai ke grup ibu-ibu. Ayo buat utas.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2ab484d23f692d79076ef8f2c27c7ba378b0f22da25b5e75921a84c0064bb58",
      "text": "objektif",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4087ad5acc19f27519f35d715c98caa1046b481ed3aaddb0f660f373c0fc3b0",
      "text": "opini",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4487ce8d918ec63d553383fc0ccc68db0a7bea65200a2f508790444288f9753",
      "text": "Media yang kredibel selalu menyebutkan sumbernya dengan jelas.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "f720e510c69f8e1187c59ad8495b52ce2b1837ac8e40cc1418f4c6a92c906f30",
      "text": "tagar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8cbadd9d843b3a1c8f7cabc2c8a5d77d207fc10b6c0f596f8ef7ee3ee179139",
      "text": "repetisi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcf857f57ce79460eed9d656a21d317c42d8d1157f3d2ee670cdc049945abf50",
      "text": "Kak Selvi, saya dapat pesan. Katanya saya menang sepeda motor! Tinggal klik tautan.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd82b1827a226286e02b27352c37f3befe30136ae0fc04e254776cbe507c2df6",
      "text": "cek fakta",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdd0dad46a6a616b35b900f998f05d95bc9424c8d9cb25b2884f9b50c0816da5",
      "text": "tangkapan layar",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdde647f00a24c7ed4f89bb3a7918f2ea9c309007d27484397bf196efd953326",
      "text": "kedua belah pihak",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefd2deba84ef6400f1fda0890c1a73357a0b6aa0dabd824461ee20ec030cf7c",
      "text": "jurnalisme warga",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
