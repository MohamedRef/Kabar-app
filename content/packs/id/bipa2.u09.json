      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a8b95cbe08d55489f084c6d5632e86625c2228f9301abd3d9f2b3d20247896",
      "text": "Lho, kamera kamu mana?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc324e13d28e99bb82802835e33c54b942009a6e71f08ca0ccaa4a0332fefdf6",
      "text": "Aduh, kamera saya ketinggalan di hotel! Jadi, saya memotret pakai HP. Capek, tapi seru!",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf213246260d3a917b5cf11c755ef99801f12be340f034772983cdb56a58908a",
