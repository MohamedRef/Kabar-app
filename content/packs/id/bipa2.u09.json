      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c18bca0cdd033cc720be79703286843a1d7268da824cc39cc22a68d3d9bbd285",
      "text": "Kamu melihat lumba-lumba?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2f2f065737ca5b95e2855a35d26b1eb4f873e3b27e7abb0864642d1e75766d8",
      "text": "aja",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce92c9f1865b913f1d9bb430546255e6731328e42e06674d99ae888bdb9e231a",
      "text": "Saat matahari terbit, pagi di Lovina ___.",
