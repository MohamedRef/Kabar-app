      "mime": "audio/mpeg"
    },
    {
      "key": "d64d9b4ac8b54182a8edcd11cfe02609f1c3d5277fd410c95dff52c92da3f35a",
      "text": "Udara pagi di Lovina sejuk dan lautnya tenang.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7cbe60cc172bb5f7ea2d6cc765b7b65ceabc5a417e56e69e7dfd9ca3b2f3ab7",
      "text": "Gaes, aku ngantuk banget. Kamu aja yang nyetir, ya?",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83e1336160e07dcaa4a83548df3477aef7970d16fe12219d0a0a3bdf8d31d0b",
      "text": "jadi dong! berangkat jam brp?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e4b43af4352f643e160134037204b83efcff0e99613e2a17be1503b596c481",
      "text": "Pertama, kami bangun jam empat pagi. Lalu, kami naik perahu dan melihat matahari terbit.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "db781a0f721566964c787abe9a8a2fb4c3295bbfaf8799d6861991b33546719e",
      "text": "Pertama, kami naik perahu jam enam pagi. Lalu, kami melihat banyak lumba-lumba.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc714aa97ee03991ab8499337059ae7ab5613d3c4899cfff576cc725b0e3d178",
