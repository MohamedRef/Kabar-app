      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "08cbd9d6015854b37345e368dcaffe58c17ab29f77cdd77bb308ac9c0b4d5cf0",
      "text": "udh",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a4355f9e9ceeadbbdf45534a0ab1fb4dce59fad79f292eff1962a88f0598b7d",
      "text": "Tunggu sebentar, ya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d3036621d02ea4648b8b79ff2a6225d264e27227f659aa090b5f675f0901007",
      "text": "Kami naik perahu jam enam pagi.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eefc8ea3ccaa0c8f58468ec160a7b76ff6abc1764109c30c08f0f5abb21e3c8",
      "text": "sih",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fec4cf91617623ace10abbfa8bbc082dedfc7220f760124f05fd9e2e418b90a",
      "text": "Perjalanannya panjang dan melelahkan, tapi kami senang.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "16079d298a563f6a0eaca21189fd1d8086dff8490bd58334df7a36081120f93a",
      "text": "setuju. aku yg nyetir",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "167e96e0f34652ed0502d54b0e260a7215977e01ef8b4c20415243e25c88f955",
      "text": "aku yg nyetir",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9ee0d7a087fd3e1f80f90de3e05b44a8d21a7c63c3fbb8b68dd57f6499b970",
      "text": "makasih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bff3d6911e6805df1d4672c4126a4845e7404eb7658ac0a2f434870a9c0a59f",
      "text": "hah jam 4?? aduh, ngantuk bgt wkwk",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c266c68a131709076901e4dfee278f070f0fabc96c0ac76f7d8c424edc5d3be",
      "text": "gk papa kok, santai aja",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ddaa49f6ebb6254d93f68eab6a06dcebcd8dbdc08d2295724fd4bcc0c77e2fb",
      "text": "Lalu, kami melihat matahari terbit. Indah sekali!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ef4e083993e18c1854ffcca4c63ac854e4933d816cface7fdd5ec54701a99ab",
      "text": "Setelah itu, kami melihat matahari terbit.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f409db244879788e0da64e3257dd41e254d3faf1089e203ef24b8662fc4e183",
      "text": "bgt",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "211e42c96b21eb6aa7ca960dd487aff10ef845eee0cdb94f29deaf08962d25e3",
      "text": "seru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "22a0d00e6ee9d6b0756d7e49aee07fc9e0e2af99263cb28d32c4452ccdd3da21",
      "text": "Kan sudah saya bilang!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b8da0492ed6246ffa7775331d901aa5f2ecc79d4e5af58a452a39a6dde1b97c",
      "text": "Lho, kamu di sini?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b9f95a927d14d2c4b5a284ae95057baa81b6ccd3bc2651505883e41324ca326",
      "text": "Kok bisa? Pakai HP saja, dong!",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d09414610024e9607a14bcf6fcbdacd963fe61ebf0f1695bade0ad39a142dd8",
      "text": "Pagi sekali! Lalu?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fc0b5fd53b200e69916338c7f97af5b158c7cf38a991ca2979cd60686914766",
      "text": "wkwk",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "332ec2f71d1a49d8993b80474fbdc0b422b9c709a42cfab7add89a13b52a322f",
      "text": "besok jadi ke Lovina?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "362ba859a96873d75842fa1c8c1fef37bd8885dea2244b7f9e36f6113604eb27",
      "text": "Wah, seru sekali!",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "39749f05255987d82b0ea8213ae0b83e38f81a85a274a4da867b61d6f5db5ed2",
      "text": "otw",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ab75c9e448146be0682f2bd828115701fa5e2411c497e211cc7ad939da9c034",
      "text": "wkwk mantap. besok mau lihat lumba2?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b0596055a8dde4112589e4a2c04229106bf6e627aa54674e07d5928b83d2da1",
      "text": "Liburan saya di Lovina sangat ___.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b893ae1f2d3cf323ee6162028dfe2dfb084f63c1974eb4e2630f48f3559a99f",
      "text": "ok deh. aku bawa makanan yaa",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c9898511183b095a67702ee1af23648a12bc0a8ecc20ab478bd48269e994942",
      "text": "udh smp blm?",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d320570f6891a82d623b65c975c9de240daad718615e3afc6f5559a30550907",
      "text": "Wah, banyak sekali! Indah banget!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e8943be290c5a7a3fbb390e7e6b98cdb4092ae93ce0fa35372a4522ba68b7d3",
      "text": "wah",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f44b7f3ff09d2522648fbc79f7e06e01b0c7789e08372c0fc4b1fe9f7487f78",
      "text": "ketinggalan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "411639acfcb7eac46e9d04ff288ef3b667d3291f2680aa7620ae0f4ccbc5484e",
      "text": "Kok mahal sekali?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "4190bcf693c3fcfe9293bc73d4319f36433dcd941d9e4d05c6410f4ddc384878",
      "text": "Akhirnya kami pulang. Capek, tapi senang!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "433a2eb48aefe080ead6f82dc39d51fc1008ab27b60b1b0021287c22ab53840b",
      "text": "ok, makasih yaa",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "468c73d9a3213fd6b5d87457c5a4fedb6184b5082f8f65a0d35d125ef0ff9b57",
      "text": "nyetir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "490ad6d900a225de29d5065d11e6010122595517035315b31aacfdc15bd290c1",
      "text": "aku blm makan, km udh?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a2328979cf3d3373c7da1a9f9a0047b20620c0bdcaa1ee29cde6a847d811cc7",
      "text": "Akhirnya, kami pulang ke hotel.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1a53e1fe1d669f6c7c974f3f3e92205b4e9e3043be9287b59ce3e48c519276",
      "text": "gaes",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "52d0c80e5865e645bc7624ef8ac84be6fe1366f496fa7dbeb47e0734a8948178",
      "text": "Iya! Setelah itu, banyak lumba-lumba datang. Seru sekali! Akhirnya kami kembali ke pantai. Capek, tapi senang!",
      "voice": "id_ardi",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "59864e4cc71997108fa4ef64b340faccc94f51c736ea1ac7d453df48de552ee6",
      "text": "gk papa Rina, nanti tidur di mobil aja",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ac6a3f7f9cc6ce265749fc657387dd76ee46874ade7cb819198ae1d190d00d7",
      "text": "gk papa Rina, nanti tidur di mobil aja",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "613b6d8ba4a5a08178de5e787c672dee4ad83b3cecbd7abd6a1e11fc1148a1a7",
      "text": "kok",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "618086b68150eb48514bc778e6c6543d75b2f31e55d408a22f7429734ff3426d",
      "text": "Selamat pagi, Pak. Saya sudah sampai di Lovina.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "61cba09bb07ea4235115720db8d877a2454b0598bcaa267c18dfd2d3ae7e313e",
      "text": "Aduh, kameranya ketinggalan!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "641a7167d1146aaef45e989e7659f3cdbc161a0b000b35412015c11fd64e52a6",
      "text": "jadi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "657d8be857e01ca3f2eb39926d07a4c45deb59070ba4defc0cc4a84c574223b8",
      "text": "Lalu, kami melihat matahari terbit. Udaranya sejuk dan lautnya tenang.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6585b0a23bfbdb4ec4a6209535aef5e5b9537a76e1da7d457b61cb7463b96a89",
      "text": "Pertama, kami naik perahu jam enam pagi.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "667709a66b1134bc332359364707f583a9735274d51d17a13fb6c16f2508dbb7",
      "text": "iya, tp harus bangun jam 5 pagi",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "68215de474484ef95a62612396548997f00393895c3e7380b3de0ba23a348d5c",
      "text": "hati2 di jln ya",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e9116389f7f80d75ca4faa226f0584c556b13f2399811ff897e26a0fd8d5bd0",
      "text": "Aduh, dompet saya ketinggalan!",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "709bc4ace4456b4127335e0a220f41b3cf94288af84ba7a344d7a02053bebb22",
      "text": "Wah, pantainya indah banget!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "741227e49a1478ecca88b9f515269e1f501f33cf4d91046b9183cd20d2ab6744",
      "text": "lho",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c2ac2154372cb3d8aaf7dbca61cd1953c1f4ce2108a0472856b5b1278f1771d",
      "text": "Selamat pagi, Pak Mohamed. Bagaimana liburan Anda di Lovina?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c619c639246eea9c4d56993d521b890103bb68570b7db28ceacd7c5bd477396",
      "text": "lumba-lumba",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d284fa5b52b09c6edf884b07450c943bec98af1a156ca6acbb39038e1bd411f",
      "text": "Wah, liburan di Lovina seru sekali! Pertama, kami naik perahu. Akhirnya, kami melihat lumba-lumba.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d784782ad6ed28a6f55a75c0908e2386a3fa8a752e976f91f414b9442c7ea62",
      "text": "gk papa, lumba2nya cuma ada pagi2",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8127f25a324a3c667c29a61a9bab0334810351a9a4985a014e71ad5cb14fb337",
      "text": "menyenangkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "842837136841de359c1f3cefc689f5641b5bb89b27b1676da69ba02217c2b738",
      "text": "setuju",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dc33df088d191d3a6602b57e95508ba59eb59a7eb5b95ce75d0a3e1e4f0a928",
      "text": "Bagaimana liburanmu di Lovina?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "90ae7096038f53dee683c5cf0d7c34d2ed1f83240733ea7c2f301446a6d31adc",
      "text": "jam 4 pagi ya, supaya bisa lihat lumba2",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9104fa91405bd0eb34fee238def6a9a809b84a92cc250140864e7c811175d699",
      "text": "Aduh, kameranya ketinggalan di hotel!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "94419e935bf698c2415aa3bb29f0341e0261cbf8d4849e27649a821225c14f62",
      "text": "Mohamed, lihat! Itu lumba-lumba!",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "94bb2ed637a5bb8728417267f2c6d44e72174c6313fc799df0845267899cea09",
      "text": "tenang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9779fd71ddea09499688401ea431edcbbbbd3b7a220acf462bb2eeb24ae61e7c",
      "text": "Oke, aku bawa makanan, ya. Sampai besok!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f9314dbd56ac85c2c48f0c47c53e4c2f1ce24bd6a44ab94f4ce35d8d26b838c",
      "text": "matahari terbit",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a45c43992baa820217ffa2962eb69cf10e5b25febd9ff924d2f8c7bb37cfaf36",
      "text": "Pagi, Pak. Liburannya sangat menyenangkan.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51492060ec859074f4a5fa1063b23c5e2644a1e7ccb326f5a76fb2fae209d3f",
      "text": "Ya udah deh, besok saja.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a68c704acea26d46d216da9d534a071de379cb6de5de1cac49a418b2dff892d1",
      "text": "yg",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "a794c91aabc857580c6e93c45cee6c3900b987f97cf188d1765c3417e7defa91",
      "text": "mantap",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f1b593c2d14145eef0e7e626adacb3a03abc0dbe01faf2d0c051d94529ca3d",
      "text": "Menyenangkan sekali! Pertama, kami naik perahu jam enam pagi.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa5bd44eae6f46f9af1abafe247e980f861e514eb77f3f8ce12f76ed6109e69a",
      "text": "Oh iya, ya. Ayo, kita foto!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad15dcaca77dd0b8e64573f949053d76eeda05ca458e6c36e5195ad4762e5ae1",
      "text": "Di sana Anda melakukan apa saja?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "add569a67482be23df62227ee4ba0253f8f48b817c5bc6e47ab4ec9520698766",
      "text": "udh! hotelnya bagus bgt, dekat pantai",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "af183ae5cc88d57594cfbf7d81914e6bcb8102fd98fcad2859d44ecee4c5c0ca",
      "text": "Mohamed, udh smp Lovina?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "afcf511e4040390b1166410e17f5a4dfd982f6cbb50a6a06cc356f36f230fd95",
      "text": "gaes, besok jadi ke Lovina?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08e762d81fd1aed6988b508ad18263225f70140663dfa031d0db1f75ab357ab",
      "text": "sejuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b438f7832e70db022435a515b128d2adf123e6c2b46c4369d3355ea324636df8",
      "text": "perahu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4e64df764251d27436ef1a6f3ef26f99702aff9489376e55668a3612ef6b340",
      "text": "Aku sudah sampai di Lovina.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a8b95cbe08d55489f084c6d5632e86625c2228f9301abd3d9f2b3d20247896",
      "text": "Lho, kamera kamu mana?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b922b5513834c3bdc24da559b362527cd1f8fec1e68873d8e7ef0b10909f3300",
      "text": "aduh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "be01f64dcc3891fb3a3c7b9df3122c1a339ae59fab60dceea9ea599fc6f7c5d3",
      "text": "Wah, lumba-lumbanya banyak sekali!",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf213246260d3a917b5cf11c755ef99801f12be340f034772983cdb56a58908a",
      "text": "ngantuk",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c18bca0cdd033cc720be79703286843a1d7268da824cc39cc22a68d3d9bbd285",
      "text": "Kamu melihat lumba-lumba?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2f2f065737ca5b95e2855a35d26b1eb4f873e3b27e7abb0864642d1e75766d8",
      "text": "aja",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc12d247f0ca34ea426d35175362271db26aaa9a44d85763970a162cba967147",
      "text": "mantap! sampai besok, hati2 ya semua",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfd275cd1c09fed8a0129b326d3632851bcfa0c777e550c1ad41c2ad4ebc1543",
      "text": "melelahkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d15596acbcf85c0a5d4828b1fb9a73ae81349fe553297e8551dc171923780f4c",
      "text": "kan",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d15ac19e09cc129190e3503a066679718420c886d76a415aeef84db7001a6a3f",
      "text": "Anda melihat lumba-lumba?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d36c54e699435e87c844a3ac4dd65fe0ca4ea5854809efdc2390e81299d42ec0",
      "text": "sy blm smp, tp udh dekat",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d64d9b4ac8b54182a8edcd11cfe02609f1c3d5277fd410c95dff52c92da3f35a",
      "text": "Udara pagi di Lovina sejuk dan lautnya tenang.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83e1336160e07dcaa4a83548df3477aef7970d16fe12219d0a0a3bdf8d31d0b",
      "text": "jadi dong! berangkat jam brp?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e4b43af4352f643e160134037204b83efcff0e99613e2a17be1503b596c481",
      "text": "Pertama, kami bangun jam empat pagi. Lalu, kami naik perahu dan melihat matahari terbit.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc714aa97ee03991ab8499337059ae7ab5613d3c4899cfff576cc725b0e3d178",
      "text": "dong",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd0eb08d9cad30a1f337671769522cc8c590db8acd954778fd26d80c484b701",
      "text": "Hati-hati di jalan, ya!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec9170d4086b27ed8d297ff2b3bc90d370cd65fc3e38b899d5f3bf0f313f571a",
      "text": "Ya, banyak sekali! Akhirnya kami pulang ke hotel. Capek, tetapi senang.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1751eb578ebacedd94a76db0519ecce70f4cfaa219bfc024ced42b71ed69c4b",
      "text": "deh",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a4329fa3c76cc6f34de0c22f7b391c5e4e5275038655bf4c2664a54dd0c4f8",
      "text": "Capek, tapi senang!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6c0eb5626ecc777fa9c3478c821aa926aba5ff66f0c96d5b15ebe6ef269a942",
      "text": "Ikut dong!",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7ba71e5b00fa1af012ab1381dfaf94f3c8f2cd46513d45f35767ab63e1f3938",
      "text": "Akhirnya, kami pulang ke hotel. Capek, tapi senang!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb8ee04486a7c74801d9c144a2449152f667e80aca7f905f626ce9d58c823a65",
      "text": "berangkat jam brp?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc2f9acb8e3570cbb55c62d67b97514bbda108a4ed4bc05f0f5a15f529f159ca",
      "text": "Pertama, kami melihat matahari terbit. Setelah itu, kami melihat lumba-lumba. Seru sekali!",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd88d2e0d2746e67a19bd2bd88cdac19be8628e3d56ed3369b432a64e4fe3b24",
      "text": "perjalanan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    }
  ],
