  ],
  "audio": [
    {
      "key": "00f8b8124ff36c43d8d5b144160b6aadf71027dda1979e19c6636c31b687c6f4",
      "text": "udh smp blm? aku otw nih",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "01cdb6a4256f800bc4397e4e2f16cb4e901446d0e61150d31f3ef5833b680dd3",
      "text": "karang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "020c0a73ac436e34b39459ee1dd8a4bae0048c9968594a0dd3a79898ece832e9",
      "text": "gk",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "03cd76d78f8793571d1e0d37327171483425c1241b8bbc528bc3af491706f283",
      "text": "Kami bangun jam empat pagi. ___ kami capek sekarang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "061a5f68e1e041413278dd11c06d646c18e48aa74128ead2536ff8376e8cb92c",
      "text": "Wah, liburan di Lovina menyenangkan sekali! Pasir pantainya hitam, dan lautnya tenang.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "08a96588d5ed59a8935cf46bf343170334678a0c0b7c2d24540cbe6cf7b3661a",
      "text": "Aku bawa ransel, air, dan sandal.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "08cbd9d6015854b37345e368dcaffe58c17ab29f77cdd77bb308ac9c0b4d5cf0",
      "text": "udh",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "094dd5ac5b7eebcb296e4f0c2903301ad1dc7d08de4b86027f9d611636bcd60a",
      "text": "batu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "09a1f36ab5c2f76839316d98211e96c96cce3fdb7017622e04c5c185f5413824",
      "text": "Kain ini dari ___, jadi mahal.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a3034287cc5ed950e218f1ce5279729a44980a491f748444c3fab1fc1a35089",
      "text": "Ya, gaun sutra dari ibuku.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a4355f9e9ceeadbbdf45534a0ab1fb4dce59fad79f292eff1962a88f0598b7d",
      "text": "Tunggu sebentar, ya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d3036621d02ea4648b8b79ff2a6225d264e27227f659aa090b5f675f0901007",
      "text": "Kami naik perahu jam enam pagi.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eefc8ea3ccaa0c8f58468ec160a7b76ff6abc1764109c30c08f0f5abb21e3c8",
      "text": "sih",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "13977ae9e404c2262673ab48d28064a255f6d32ad324cb99c10a016843110376",
      "text": "Vila mahal, ya? Penginapan aja!",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "14362bb658875c17b0567172fdce71a0d9b2c4fa27f11ca1a086ed56c372400f",
      "text": "Pak Mohamed, Bapak melihat lumba-lumba?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "147aa3c60d21a21f8e1ebb2e4e7880864502279fd7fc270fbd646df7886e1034",
      "text": "Bagus. Malamnya kita tidur di penginapan dekat sana.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "16079d298a563f6a0eaca21189fd1d8086dff8490bd58334df7a36081120f93a",
      "text": "setuju. aku yg nyetir",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "167e96e0f34652ed0502d54b0e260a7215977e01ef8b4c20415243e25c88f955",
      "text": "aku yg nyetir",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "18152d9be2b4f59961e5f237bb10acde4c85a46b89283c40dccff672f0fb5999",
      "text": "jam 4 pagi ya, biar bisa lihat lumba2",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b3f9f46eb6e21a4d58f54fe4c1dcf033e760a3fd3bcb4e8bb03ba5aa0cf98e9",
      "text": "jas",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9ee0d7a087fd3e1f80f90de3e05b44a8d21a7c63c3fbb8b68dd57f6499b970",
      "text": "makasih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bff3d6911e6805df1d4672c4126a4845e7404eb7658ac0a2f434870a9c0a59f",
      "text": "hah jam 4?? aduh, ngantuk bgt wkwk",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c266c68a131709076901e4dfee278f070f0fabc96c0ac76f7d8c424edc5d3be",
      "text": "gk papa kok, santai aja",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f409db244879788e0da64e3257dd41e254d3faf1089e203ef24b8662fc4e183",
      "text": "bgt",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "273d735cb22c4939c35573869dcf13cf3fed7489fa35ef02c60e0d47433724ac",
      "text": "Kok mahal ___?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "2999ce799633e80d7b1adc5f450907dd7cf0d413e107dec30cc937357c7fce54",
      "text": "Gaun Rina dari sutra.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ae326373b2baccb3ce4e1a564296904047972563327e83204a521a0392efb07",
      "text": "gaes, setuju gk?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b8da0492ed6246ffa7775331d901aa5f2ecc79d4e5af58a452a39a6dde1b97c",
      "text": "Lho, kamu di sini?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c2d64efc08e9c00fd11cf0c6a893757e2ba7e165d584433353ccf30e312c0de",
      "text": "Kameranya ketinggalan, kan?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fc0b5fd53b200e69916338c7f97af5b158c7cf38a991ca2979cd60686914766",
      "text": "wkwk",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd16a6332bd550899308c6efadf7b0bf142d27465e4117a4b9e43d5984f3f4a",
      "text": "hitam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "362ba859a96873d75842fa1c8c1fef37bd8885dea2244b7f9e36f6113604eb27",
      "text": "Wah, seru sekali!",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "39749f05255987d82b0ea8213ae0b83e38f81a85a274a4da867b61d6f5db5ed2",
      "text": "otw",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ab75c9e448146be0682f2bd828115701fa5e2411c497e211cc7ad939da9c034",
      "text": "wkwk mantap. besok mau lihat lumba2?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b0596055a8dde4112589e4a2c04229106bf6e627aa54674e07d5928b83d2da1",
      "text": "Liburan saya di Lovina sangat ___.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c9898511183b095a67702ee1af23648a12bc0a8ecc20ab478bd48269e994942",
      "text": "udh smp blm?",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e8943be290c5a7a3fbb390e7e6b98cdb4092ae93ce0fa35372a4522ba68b7d3",
      "text": "wah",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f44b7f3ff09d2522648fbc79f7e06e01b0c7789e08372c0fc4b1fe9f7487f78",
      "text": "ketinggalan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ff331b1f8c89495cc5d53681492b953bb614948d26ed28907ef2ec989b38660",
      "text": "sandal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "411639acfcb7eac46e9d04ff288ef3b667d3291f2680aa7620ae0f4ccbc5484e",
      "text": "Kok mahal sekali?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "4190bcf693c3fcfe9293bc73d4319f36433dcd941d9e4d05c6410f4ddc384878",
      "text": "Akhirnya kami pulang. Capek, tapi senang!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "433a2eb48aefe080ead6f82dc39d51fc1008ab27b60b1b0021287c22ab53840b",
      "text": "ok, makasih yaa",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f9f73c6893b2f0d526254fcd2507fd8777d6ccd2f61d8572b26d7e80bc0c70",
      "text": "Kok bisa? Pakai HP aja, dong!",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "468c73d9a3213fd6b5d87457c5a4fedb6184b5082f8f65a0d35d125ef0ff9b57",
      "text": "nyetir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4916af4fedf216f92e4000f629d9371f6390c69e9b3dc7e63bedafb90a0e41a1",
      "text": "Rina, Ibu udah membaca tulisanmu soal Lovina. Seru banget!",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1a53e1fe1d669f6c7c974f3f3e92205b4e9e3043be9287b59ce3e48c519276",
      "text": "gaes",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "59864e4cc71997108fa4ef64b340faccc94f51c736ea1ac7d453df48de552ee6",
      "text": "gk papa Rina, nanti tidur di mobil aja",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a8a87d2043011b6347966280ee3d8419c2b1cdb52d2152e69b61ce7478f216b",
      "text": "Ke pesta, saya pakai kemeja dan dasi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa99d0299e438c2efceec09cdd6a537b59d7b5454c76004946b118a06aee6d8",
      "text": "penginapan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "613b6d8ba4a5a08178de5e787c672dee4ad83b3cecbd7abd6a1e11fc1148a1a7",
      "text": "kok",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "618086b68150eb48514bc778e6c6543d75b2f31e55d408a22f7429734ff3426d",
      "text": "Selamat pagi, Pak. Saya sudah sampai di Lovina.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "657d8be857e01ca3f2eb39926d07a4c45deb59070ba4defc0cc4a84c574223b8",
      "text": "Lalu, kami melihat matahari terbit. Udaranya sejuk dan lautnya tenang.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6585b0a23bfbdb4ec4a6209535aef5e5b9537a76e1da7d457b61cb7463b96a89",
      "text": "Pertama, kami naik perahu jam enam pagi.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "667709a66b1134bc332359364707f583a9735274d51d17a13fb6c16f2508dbb7",
      "text": "iya, tp harus bangun jam 5 pagi",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "67799a12e2eec004c2c1738bceb7efe8ecc8b0051580248f2459671570dd2fc8",
      "text": "Di Bali ada air terjun yang indah.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "67dd787843a028bde45383afdfa4b02a67d5d856c1de483f99a1cc41b08cbdb1",
      "text": "Bagus! Aku mau beli perak dengan batu biru di Celuk untuk mereka.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "68215de474484ef95a62612396548997f00393895c3e7380b3de0ba23a348d5c",
      "text": "hati2 di jln ya",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6afe7323966566439e16c406ebfce89827d31d90ae8ec54211322bc1638f7654",
      "text": "Nah, makanya kami capek!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bbbdba4715cea3fd7d4035f530001fb1bd4bdb9f0872be6b52c9879e6e8e3db",
      "text": "Aku pakai apa? Jas dan dasi?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e5779971b0d18137e7478e1ea84bd5d2896c04c2a14cbe5354e313afcd7369a",
      "text": "nah",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e82f11e817fc33a9488d60f9c303bb2fa560dd773107bfe5476e65e1a4bdc70",
      "text": "makasih bgt ya, aku otw wkwk",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f1080e1186e1c8b4eb52f8acf3ccb73bdca6ed643598208f4b479be16130ad1",
      "text": "Pagi banget! Lalu?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "709bc4ace4456b4127335e0a220f41b3cf94288af84ba7a344d7a02053bebb22",
      "text": "Wah, pantainya indah banget!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "7338f7a223ce71c5fc5dbfc9697a53d56e6ec0f8dd629401e8ee51b78dc587fb",
      "text": "soal",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "73d714b602178d787774ef31d8e937dac728fe6a33c30dffe2df4b9d68478d3c",
      "text": "Wah, lumba-lumbanya banyak sekali! Aduh, kameranya ketinggalan!",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "741227e49a1478ecca88b9f515269e1f501f33cf4d91046b9183cd20d2ab6744",
      "text": "lho",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "79116329fc3404885546d8f1b4738d59c147f0dd6886e2b62c7408d5b01ea262",
      "text": "Aduh, kamera saya ketinggalan di hotel! Berarti saya memotret pakai HP.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a3f9f6e8b46ae8568c78d161061870e38733bd3a350ab3836230517476c6ead",
      "text": "Besok kita ke air terjun Sekumpul, ya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6482f68b2cac7d207d4d4ddee069c87148b6842167b375ba9f1aee03023614",
      "text": "perak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a76dec5f32ccf4a8016af30e23e1f590e0bd176a6021570511453ebeba5e13c",
      "text": "hutan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aab84471c197c2be6f39dc78d3b0d94b8c34efa68e3a3f7566ab5c02d94f068",
      "text": "Soal pantai Lovina, bagaimana pasir dan lautnya?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b6bf3acda1c0b47bb20e635f99ffdeaff6016ff20b9cb09ff6563cad3cd4a62",
      "text": "Saya bawa ransel dan kompas ke hutan.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bad30b080aaaf78695619eeadb56624576db1ba7db20b5354f66412ac79ffba",
      "text": "kemeja",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bb597df10b62c68412d702f0dd009eb70c44b06bede46d5a1008c0ce04ec020",
      "text": "gaun",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c2ac2154372cb3d8aaf7dbca61cd1953c1f4ce2108a0472856b5b1278f1771d",
      "text": "Selamat pagi, Pak Mohamed. Bagaimana liburan Anda di Lovina?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d284fa5b52b09c6edf884b07450c943bec98af1a156ca6acbb39038e1bd411f",
      "text": "Wah, liburan di Lovina seru sekali! Pertama, kami naik perahu. Akhirnya, kami melihat lumba-lumba.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "8127f25a324a3c667c29a61a9bab0334810351a9a4985a014e71ad5cb14fb337",
      "text": "menyenangkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "842837136841de359c1f3cefc689f5641b5bb89b27b1676da69ba02217c2b738",
      "text": "setuju",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "85a13d371b1816c0dd8cb89df129892cc422f1a280ffe584c5314caf9e662033",
      "text": "Gimana liburanmu di Lovina?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "85af32d525cef9c429a92e6b344a5d1969934b86624dc99e3cf05eede3b5bda4",
      "text": "Jauh dari sini?",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e221d1aa4c2193de0d1a6e2b3f203dd0429d1fe4dc07a524b5745bbb203f2e9",
      "text": "Lumayan. Kita jalan lewat hutan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "901cccde5c6c369adc7513e264c7726497124979888b434957643b6929256b18",
      "text": "kompas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "90ae7096038f53dee683c5cf0d7c34d2ed1f83240733ea7c2f301446a6d31adc",
      "text": "jam 4 pagi ya, supaya bisa lihat lumba2",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9104fa91405bd0eb34fee238def6a9a809b84a92cc250140864e7c811175d699",
      "text": "Aduh, kameranya ketinggalan di hotel!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "91c5bc3022436ff665714dee27a2371f540277e3a045ff1fd6051a5e60bcbe4d",
      "text": "Terima kasih, Bu! Pasirnya hitam, lho. Bagus untuk foto.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "927dad95b8cf2b26a649ac1e241d1efc1324c17e9bea230cbd553f5a54c0d920",
      "text": "Lho, kameramu ketinggalan, kan?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "94419e935bf698c2415aa3bb29f0341e0261cbf8d4849e27649a821225c14f62",
      "text": "Mohamed, lihat! Itu lumba-lumba!",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "94515d71fc75068290834905ee92ecc70060fb356ed8479fbabc2b1b20878826",
      "text": "gk papa, aku aja yg bawa makanan wkwk",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "971fa4961be341a7ff58941327ba40138e0939445bdeece0c0a549084a340162",
      "text": "Kamu pakai gaun?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "9adf13ad6ae6e88c8859aeeadb169460b8e54b9010480266c2682c29a536438d",
      "text": "Iya, aduh! Tapi foto pakai HP juga bagus.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f82236d8202bd42607deb560e2809f4a750705f84633e09ef393bd1821dac61",
      "text": "Bawa ransel dan kompas ke hutan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f9314dbd56ac85c2c48f0c47c53e4c2f1ce24bd6a44ab94f4ce35d8d26b838c",
      "text": "matahari terbit",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1d345459bac1a0676af09ec35d7e7ce07ec9f10d4ae08a352453c985edc8bbc",
      "text": "ransel",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a45c43992baa820217ffa2962eb69cf10e5b25febd9ff924d2f8c7bb37cfaf36",
      "text": "Pagi, Pak. Liburannya sangat menyenangkan.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51492060ec859074f4a5fa1063b23c5e2644a1e7ccb326f5a76fb2fae209d3f",
      "text": "Ya udah deh, besok saja.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a68c704acea26d46d216da9d534a071de379cb6de5de1cac49a418b2dff892d1",
      "text": "yg",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "a78e34781b631cfce60615627ee48097f2a9a4df01e63038eb229cf4e711167b",
      "text": "Pasir pantainya hitam, dan lautnya tenang.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa5bd44eae6f46f9af1abafe247e980f861e514eb77f3f8ce12f76ed6109e69a",
      "text": "Oh iya, ya. Ayo, kita foto!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa61abf32aef4f766e8be134fabe92ba74a6244703240a35291c74317df7fd20",
      "text": "dasi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "aad8712ea57fee6cdac9fd564630d95579a063a4918d2ff0d5f6d6dbbeb347f1",
      "text": "sutra",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb68e01b513ee2f6595b96fa3d48ebffa2954beb7f1c734f955946f4a1fbc66",
      "text": "makanya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "add569a67482be23df62227ee4ba0253f8f48b817c5bc6e47ab4ec9520698766",
      "text": "udh! hotelnya bagus bgt, dekat pantai",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "af183ae5cc88d57594cfbf7d81914e6bcb8102fd98fcad2859d44ecee4c5c0ca",
      "text": "Mohamed, udh smp Lovina?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "afcf511e4040390b1166410e17f5a4dfd982f6cbb50a6a06cc356f36f230fd95",
      "text": "gaes, besok jadi ke Lovina?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08e762d81fd1aed6988b508ad18263225f70140663dfa031d0db1f75ab357ab",
      "text": "sejuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b297b0a22f30736fb0c6db14420f57ce320f6c7beb2aba14545032c0c3860ac1",
      "text": "Makasih, ya! Tunggu aja, aku otw.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2a67360a792a94f675a4dc4d4d7e5a66a3c47e29da761b96c51a2e3da12d907",
      "text": "gk papa, lumba2nya ada pagi2 aja",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2e5161f9401341e13b90c0aee170f00be636125ea9adc76e244b17d5df8c58c",
      "text": "Penginapan ini murah dan bersih.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b399f53409dd32f7ed9b14f00dee8e3a9bcfe03d28fd23d372b103d1add18916",
      "text": "supaya / biar",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3d188bf1d96474ec0e881cca3fcb546633776fbb2aaad81bb459cab4db096b8",
      "text": "air terjun",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b438f7832e70db022435a515b128d2adf123e6c2b46c4369d3355ea324636df8",
      "text": "perahu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6391ac237158d2baa0a3a10dd9706ca5ffa7e05c4c587766869e515097876ea",
      "text": "Gaes, aku ngantuk banget. Kamu aja yang nyetir, biar aku bisa tidur, oke?",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a8b95cbe08d55489f084c6d5632e86625c2228f9301abd3d9f2b3d20247896",
      "text": "Lho, kamera kamu mana?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc324e13d28e99bb82802835e33c54b942009a6e71f08ca0ccaa4a0332fefdf6",
      "text": "Aduh, kamera saya ketinggalan di hotel! Jadi, saya memotret pakai HP. Capek, tapi seru!",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf213246260d3a917b5cf11c755ef99801f12be340f034772983cdb56a58908a",
      "text": "ngantuk",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf54d00ce1b1629170298879fbde8afe7fdb879db0e3093b22e3bcd5147bb31c",
      "text": "Wah, banyak banget! Indahnya!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c18bca0cdd033cc720be79703286843a1d7268da824cc39cc22a68d3d9bbd285",
      "text": "Kamu melihat lumba-lumba?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4951611c6416a7f5c8b92d01dfb73782797876cec4a0687abedcef9734cc859",
      "text": "Soal perahu, jam berapa mereka naik perahu?",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68883ecb1f3139c45ade62274c07049ac1fa02ba441eee015da93b5a4df6890",
      "text": "Air terjunnya tinggi dan airnya dingin.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c87d59a52c7df52cf36090b78742af5b9e63d59ba91329e504d862de552db440",
      "text": "vila",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc02f4bb5160d728d4b2cf1a100ca5d2709c0bd241c4713e548a580732e13aed",
      "text": "Wah, tulisan Rina soal Lovina bagus sekali!",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce92c9f1865b913f1d9bb430546255e6731328e42e06674d99ae888bdb9e231a",
      "text": "Saat matahari terbit, pagi di Lovina ___.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfd275cd1c09fed8a0129b326d3632851bcfa0c777e550c1ad41c2ad4ebc1543",
      "text": "melelahkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d15596acbcf85c0a5d4828b1fb9a73ae81349fe553297e8551dc171923780f4c",
      "text": "kan",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d15ac19e09cc129190e3503a066679718420c886d76a415aeef84db7001a6a3f",
      "text": "Anda melihat lumba-lumba?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2c0d63b74168aa786c8326491d87ce80ad912faf1a71ae995e995f66b4167b9",
      "text": "Menyenangkan banget! Pertama, kami naik perahu jam enam pagi.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "d36c54e699435e87c844a3ac4dd65fe0ca4ea5854809efdc2390e81299d42ec0",
      "text": "sy blm smp, tp udh dekat",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d38ec874c7c1ce7c2043325e65115f91b228d89f1482949157b925f3953f6c34",
      "text": "Ke pesta, saya pakai kemeja putih dan dasi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "d64d9b4ac8b54182a8edcd11cfe02609f1c3d5277fd410c95dff52c92da3f35a",
      "text": "Udara pagi di Lovina sejuk dan lautnya tenang.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83e1336160e07dcaa4a83548df3477aef7970d16fe12219d0a0a3bdf8d31d0b",
      "text": "jadi dong! berangkat jam brp?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8bc0a1984340db63f312dc2a7ff9a81dbef30363f6c97dbf3945ce5119a0e8c",
      "text": "Banyak banget, Bu! Pertama kami naik perahu, lalu lumba-lumbanya datang.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e4b43af4352f643e160134037204b83efcff0e99613e2a17be1503b596c481",
      "text": "Pertama, kami bangun jam empat pagi. Lalu, kami naik perahu dan melihat matahari terbit.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "d96dee86e9bbda728eaf6d2747fb6518d3f360d5bd5f30e450bbd6951d64418d",
      "text": "Kami tinggal di vila dekat pantai.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "db781a0f721566964c787abe9a8a2fb4c3295bbfaf8799d6861991b33546719e",
      "text": "Pertama, kami naik perahu jam enam pagi. Lalu, kami melihat banyak lumba-lumba.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc714aa97ee03991ab8499337059ae7ab5613d3c4899cfff576cc725b0e3d178",
      "text": "dong",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcac54c7a8f6a657e2cc916231f76a7509ad8df6e519ff863ec55113f861f78a",
      "text": "Oke, aku bawa makanan, biar kita nggak lapar. Sampai besok!",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "defab4633f1be249875c2d1981528283160fbf7967af618027be0fd6ad8c7644",
      "text": "berarti",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1f8e8a7eb8bfee93eddd62cb11eccdca06c65b55904095e0b974bb3c88b232b",
      "text": "Pertama, kami melihat matahari terbit. Nah, setelah itu kami melihat lumba-lumba. Perjalanannya seru, makanya kami senang!",
      "voice": "id_gadis",
      "chars": 122,
      "mime": "audio/mpeg"
    },
    {
      "key": "e82c3b52bf79a5cd8b97d0e2772735521e119fe0771985bc7592c09223069371",
      "text": "Di Celuk ada banyak toko perak.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e90bf06148ab3b4d5bd08b543d2ef9ea02cd69bb3c055098de03f1dedc741c01",
      "text": "kaca",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec9170d4086b27ed8d297ff2b3bc90d370cd65fc3e38b899d5f3bf0f313f571a",
      "text": "Ya, banyak sekali! Akhirnya kami pulang ke hotel. Capek, tetapi senang.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "eded23c726ce0b7cf083890502891ad02e24d5bb3091c6b04bad85aac819865b",
      "text": "Kemeja batik aja. Di Bali nggak perlu jas.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee755ca4673c793847dcae5150a7e04c2ae468ddd3a1ddc847fb315f3911ae5e",
      "text": "Ke air terjun, pakai ___ saja.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "eec3b3a7feb7e518aa8923fa92f584b5f7d854da1e0ee5847e3b54128be63590",
      "text": "Di sana Anda ke mana saja?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1751eb578ebacedd94a76db0519ecce70f4cfaa219bfc024ced42b71ed69c4b",
      "text": "deh",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f53b49b0d3477ee6be83e7b68c2b7f5de87712ba0912dc05447a2d69830f41ca",
      "text": "pasir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6c0eb5626ecc777fa9c3478c821aa926aba5ff66f0c96d5b15ebe6ef269a942",
      "text": "Ikut dong!",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7ba71e5b00fa1af012ab1381dfaf94f3c8f2cd46513d45f35767ab63e1f3938",
