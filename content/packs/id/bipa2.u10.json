    },
    {
      "id": "bipa2.u10.l02",
      "sha256": "345e3376a579fc94f4167d0588b0588750454b588962cba32b5836c036b476f7"
    },
    {
      "id": "bipa2.u10.l03",
      "sha256": "17e2d4c1b0213b2c1db013839cef5a1758e683f24e18f7eb24dc2f4569c218cd"
    },
    {
      "id": "bipa2.u10.l04",
      "sha256": "46ec04c2d1a9d5911b8ba6312c1cd9ae9710c135cc66efe2f08c1653c4795cf0"
    },
    {
      "id": "bipa2.u10.l05",
      "sha256": "9eb8b122a470b527d25a4c6e410bb6cb52386c5d70ad50b99e6bba0710ca106d"
    },
    {
      "id": "bipa2.u10.l06",
      "sha256": "820a55ba4e0eb6ff224e6a64bfb3658827a7bff44514f5506d6b5fa3439ae4a2"
    },
    {
      "id": "bipa2.u10.l07",
      "sha256": "c7dcbb0315ee23a888d3d191b59edbb9340909cb344f093cb2716742370c5f83"
    },
    {
      "id": "bipa2.u10.l08",
      "sha256": "8042217255d7644e376a2de6b798c2ea8bbdb2dbc1bac4ec69d5a2e0f32bec52"
    }
  ],
  "audio": [
    {
      "key": "000ef1dda95bd07077884c7064014744e31226c7016cd4d8895a32368d4ad3bf",
      "text": "pilek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "03677333bd7ba2fae3e3e81fe845814b119e31c97b675031eca7555a235b121e",
      "text": "Sejak tadi malam. Gigi saya juga sakit.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0479d0cdfee6544127b6b4bb3b4066600f12dfb47a402bfd8da6b7beeb12a4b9",
      "text": "Sejak kapan?",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "050a87a58b34c85aaa4357dac08b17d54bfabd461ee065acb6be89dda49d1b10",
      "text": "perut",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "06a47d08c5277c7a375b9bda197494bed1cfeb1b1c5b01d19d64539fc040bc72",
      "text": "Saya merasa mual dan lemas.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "06c72bba7116ee0ce1119a0f2fccf7e773ac49da7da33805688c794308d19f6e",
      "text": "masuk angin",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "07ee0d48ea2e2e53512d36f1540d76647a2823dfb4951b7a111c579a62ad113b",
      "text": "ambulans",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "091910fff93c13a5cf9837d0d719aa6873c5ca10c7e8c96d44e20004a4d52411",
      "text": "Tidak, cuma lemas. Mungkin masuk angin.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a82a4c5ef805064a27483492d5a7b7f77082570c9c90e571e686f9ca0201553",
      "text": "tabib",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bdd183aff5784a7afd8474e1110f616c4a08d6ecc84fed351fc79bfd56b4604",
      "text": "demam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "10d432e8fc21ae44a650f924596a26823a63135a6dbc0ec8ae490b01a74c64ca",
      "text": "Ada luka di tangan. Pakai ___.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "111bde87194f9fd5f5d158290d2ce89d4429f74697901c116255fb21facd9523",
      "text": "flu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "182592f5d7b9ce86922ddac740c6d5a0f689db6c440f4996767693213eaa0de9",
      "text": "Selamat pagi. Silakan duduk. Sakit apa, Pak?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "1af697bb3c0638dd057792580bdb160a0204c3e96feaf20e81eed51e565f8bac",
      "text": "Tidak perlu. Sekarang dia pakai infus saja.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9c0d6b99a1f8bab4ed94b24c05b7ec1d95fa36f80ef9b12c40d2133aab658b",
      "text": "mual",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bc197adf9ca1af40db87129dc29c22f235557bbdbcbe352eeb32fbcdb58dee1",
      "text": "Kepala saya pusing dan badan saya lemas.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1df032fb06330da511a2173266028e1e44891e9aec913010d9e38ebdf482966e",
      "text": "Saya sakit kepala.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f8afe10637b0ac8df26e78b804a5b064b1671cd659a6534fd381b74b21f4937",
      "text": "Ada luka kecil di jari saya.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "222eb274db6f455947dfb86edaba284c688be5b7cab6a9eafdd8ceed2ddc1daa",
      "text": "Semoga cepat sembuh, ya!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2419a6eaabef815af323aebd43ed7ce5ee0118e0da1a32e6321e0fc719fef335",
      "text": "Ada orang pingsan! Telepon ambulans!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2585b9fba4d7762d4d85f0725207372edf2b17da7f4e06b3d6c734595c35da67",
      "text": "Semoga sukses ujiannya! — Aamiin, terima kasih.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c047087b67fa97d634a905fc7249f37c52e5d92b96b182f7006857fa3de628",
      "text": "jamu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "297d5e5d2d3814111f9ac1da263712e078f4ab111f0ae883cc0ddc970282cb15",
      "text": "Saya mau beli obat sakit kepala.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "298a89f79221fa9a51a4be0e7d74c19b4a6a8da2bcaa38b51f28b87a316ad274",
      "text": "Baik. Terima kasih, Mbak!",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d0864ab1a16078bdf4480aebf0e259d4dbf77e52ca6ceb52a2b7c40158841b",
      "text": "Aturan pakai: kocok dahulu, diminum 3 x sehari 1 sendok teh.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b0301e82894643f4d20c59c8e1d720ee5ac68fe98a131fb151314cd97d59ff1",
      "text": "Gigi saya sakit.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b91385b15953a1ebc73a0a62b325716542179b9082e88bca504fadfc76ad162",
      "text": "Dok, saya demam sejak kemarin.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ba897d7f35c4c695b5beeabd11b2e079174f13c92530c2babc20f8c7c5e6aa9",
      "text": "Sekarang saya sudah sehat.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2be39b974aea257b02c37a5a1919981c8b643fa265a439131f2fc61bfe9fa2f9",
      "text": "alhamdulillah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d67633a733bc7b85f8758646f1cbdd8511c94bed93ff4b3cad357711e2b4f47",
      "text": "kondisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3189dc7c0af52bb885e79325c80ec101949b14d1981a8b08a3833a6010102e95",
      "text": "Sudah lebih baik. Kemarin dia muntah dan pingsan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3286f61623c83ca6869b3f7e4678da8f262ca0308d6dc3b22d2d3975972c2159",
      "text": "Saya makan sate kacang. Apa saya alergi kacang?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f58729c0e5649774c269eef99c9352f4e9cbdf56a9d663bd992edfb4e0b7f2",
      "text": "Kaki saya patah waktu main bola.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3607ed40d9a4a4370f97233c03ba885e805c5e9ae9f587ed16a83af6c2dea9a6",
      "text": "sembuh",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "390c27bbfb625b0d942bddd8edfb74797f95db2db9dd77912499665b2e28fa9c",
      "text": "alergi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aafa7fbb775064c5b2fec65aa6383a9a1c341bcd392be7378e9d87b8c94614e",
      "text": "Mudah-mudahan kita bisa bertemu lagi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b052b31a3226a1a9eb87b0185148bced32ca58310b3004510d8eb1ea39be2fc",
      "text": "Sakit apa, Pak?",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b5d1aef87717c66685c42a0b66767baeb0d5940a1b388fd4f6f0750c599754e",
      "text": "Mohamed, kamu kenapa? Sakit?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bc19be9172d87a47a631d5fd1f626373c626bb4df29a0f740c39a17421397d7",
      "text": "merasa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be4989fadc87799e819699b962bdbe37989aa0001bb44023cea4fb9eaf0f4e0",
      "text": "Sesudah makan. Kocok dahulu, ya.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf0b2c238cb13889fda9339ee00cf01b969bcc7b158e0d85a679eb514893a72",
      "text": "pasien",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c67186dfb01c1e342618e91072545ac513c6b853731948c89bbcacf2fa1d30b",
      "text": "Ini klinik, bukan rumah tabib.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cd720683707af4ccc3cdaf50453c2ee4f4af2500b5466054173bd5118cfd69d",
      "text": "Pagi, Dok. Saya demam dan sakit tenggorokan.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3df1395a9858dd91023ec445691c9c9b8af4abdb5a997ee09d3f713bc504d39b",
      "text": "Dok, saya demam dan sakit kepala sejak kemarin.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eeb5307867024ae1e942af44a3faa02a3600357a5639836459c0f334ecfe451",
      "text": "gigi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f2e9deae6f6fbe8b9a3d337a8b348485d79ce02e04f61d923b407857637fd04",
      "text": "Besok kamu datang? — Insya Allah.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f977957f5d8a0212a1c12c99add310c6f6958f57550870fb571e70b7e862e08",
      "text": "Selamat siang. Ada yang bisa saya bantu?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f9e78711449e951800cb20ef4ab9ca58df8977678da7936c31aa0ebfa25ddd5",
      "text": "termometer",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fadb72f91f3ddc4da265077ad77fc05efe500eaf152e18b5f32299061ae7a19",
      "text": "Perut saya sakit sejak tadi malam.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4404f934c005f16d741c399ba592e0ca2048ec9399aea5075a5638dfa3bb91f7",
      "text": "gatal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "450ec20e93084065cf18d206bdd1744306ae052828f356bd1736747e4970ce9e",
      "text": "Halo, Mohamed! Kok kemarin tidak ikut kelas online?",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "465c2f94f81c47666f62c8d23271c582d4e8fca98a1df5f87a18196e9fc13575",
      "text": "Saya sakit perut, Dok.",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "47307de364aa437adfd72587b3ecf75d2ae6ee1e833d0efa6be9f953122a21f2",
      "text": "luka",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a0fa9235f7b3c160b6ed8999901559b20a822f1648c5e2831242c4aede8666e",
      "text": "sehari",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a1d2b2151bf672f8b3c93c38cc9f669b7aa546a9a12680ad334d827817cb0ea",
      "text": "vitamin",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4af33edb2a9dd40b0eaf120500221a412a43f44ef8df99d56739bb482542c67e",
      "text": "Dokter punya banyak ___ hari ini.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4db26c44e48f0fb0d627d2e08dd38a9f16fd8e86da83de8db89d9b1eeddc0929",
      "text": "lancar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "506846a41b9306539e3a8c628834949fd7bb5441ec25fdfd863ab2a3cfeb162f",
      "text": "suntik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "509e8470abf5cf1aeebe70f10893ad8adb03944baec131093c878e92e1e94997",
      "text": "Selamat pagi. Sakit apa?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "527304f70bcffca0dce11dbae71d63684a7629f1d40257b71c919815df3b507f",
      "text": "insya Allah",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "536008789cde96d0c02a55fb884b4de4a0b5828864c96d61116ba009d5993bb6",
      "text": "Ada obat batuk?",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "555e3679c6ba20d9925031b1ba51e34ca9f5fde64c7f7820533bc663dca6a87f",
      "text": "Kepala saya sakit.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "557c32c8f40b2523f65c00186679ca039d274233cf10ce64da017df1547cb2b4",
      "text": "diminum",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5970ddc9d0f52130673aac580458aec1b48a524adb20a752b91d4ddaa5a556a8",
      "text": "muntah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a9521e74bad913670b32d57230bceeb5f5a7ecf3ade156f9d3e6c6a840dc4ca",
      "text": "operasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c4bd4011badd17319e294bf1936b12d123d7d28ef5829a53492f4c6dff33f87",
      "text": "lemas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cf49fc5754eb7ef66d5ea251e0ba1bf5be8bd1fa7b450da3d259138fbf66efe",
      "text": "Saya alergi kacang. Kulit saya gatal.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f8913369c8fe68829dbc1265996e2e12606cc84356d87daeab7e7591e3f11d4",
      "text": "Sudah berapa lama?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "602aed98bc35c590bf019c299b0a416cc6a2c664020ff81205f4dcc109cd3303",
      "text": "pingsan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "60a9f55b21255d8db01bc1d3f753d4a2be5d8673c4a73364f312c0a7c1ab58e7",
      "text": "Dokter, saya takut suntik!",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "649a6f796aaf7aadc7ef673cc9b72a093eaf8741f863de7e5fd04d73c1ceef19",
      "text": "Ini jamu dari ibu saya. Ayo, minum dulu!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c58189d6c6e2e8063388ff0f20a19f60615d1549db0b500b4446a624985beb",
      "text": "Bagus! Saya takut suntik.",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "66af959d63ba56c8617824796e7751b9eebdf04884df44ae8a1db5208e4b42ce",
      "text": "Pasien itu pakai infus.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "67b90100174d59da99e1bca5e6e428319dc01d5ad11605596354776dd2c3bb95",
      "text": "Obat ini diminum dua kali sehari.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "696d1f406f9ec18ec409f1bca3fe0da6caca98677c216b0e32a6e91f1ff4931a",
      "text": "Selamat pagi, selamat datang di klinik. Sakit apa, Pak?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a5d87c2626716538d1bcb45b6f71e738530a8658fbfa60befefe516dcffcaaf",
      "text": "Anak itu muntah lalu pingsan.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dee27f4698f9fc443500e853a54781a5905e736e6d6d8ea6e6585e4dc8f6723",
      "text": "Semoga saya lulus.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f25c1de3fb97f2514b0ec6203554841db4c7dd79846b55ace12b1c4e725919c",
      "text": "pusing",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "703c29bb147d64869ae46e020bf6b74bcff349fa6b0b264630d54056f2c60baf",
      "text": "Coba buka mulutnya.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "71e9c78f77c6596b48283d6d6d3e7dc64b4f16ae1feac1afe8caf5931097792d",
      "text": "Sebelum atau sesudah makan?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "73f998f795defef15368991d9df1297cc11652e1dc215c386f97bc13ac46b36f",
      "text": "Baik. Boleh saya masuk?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "7890258276f59492c1fc230b7483b0679ffb4c2734511738dde76bd0b4808ed6",
      "text": "obat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d515588a83b44ca2acb21d48c7883216773d86133ce6ae91abfc4916f65cbb0",
      "text": "Sejak tadi pagi. Mungkin saya terlalu lama berenang di laut.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "7db4c41ffad4e3a271e6c8b2a9753fbaa2045c368dee0608c8265809cc9ff39e",
      "text": "Kamu sakit apa? — Cuma masuk angin.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8089a7bf927f2222e2efe1d5bc0034a69c80c4d2b25628e2465ee0634ec9f957",
      "text": "sakit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "80b14a8aedddc401d52d7bc68a31f3820a19d4738193b89a3590e5fd60f2666a",
      "text": "Pasien itu pakai infus dan perban.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "81118c4a89885060af744d2c35f05a35b2403af0680935e0eebd3f557b33c533",
      "text": "perban",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "85e9a1c71803d1bef0711c69a25e6256b0e29619fd4b73c53cb2656156a7297f",
      "text": "Sejak dua hari yang lalu. Kemarin saya juga batuk.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "87d55bbebb3b59fcd8d1ead3a0f8b56bdf3020b2dbf861b8e5de12ed9e0dc540",
      "text": "Ya, ini alergi. Minum obat ini, tidak perlu suntik.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "88002cba8fcddc8da23d6a8a4decbae3ddff74c2db023a79d54fda0207ae3abf",
      "text": "tenggorokan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "88b6fb1e89791c804f20386b299097d62c6b81c00c3d40e32084847d405407fa",
      "text": "Maaf, Rina. Saya sakit. Demam dan sakit tenggorokan.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b54593ac8d12160aae99414af33f473dea58ecf14dec33b7ee0c8780aea52c7",
      "text": "Ada. Ini sirup. Diminum tiga kali sehari, satu sendok teh.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8264658743e63d403492418530d4a277a8a6ca9a123f527bdc78c226e55542",
      "text": "Aduh! Sejak kapan?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "9134fb7c17ba8cf4c0fc917215e7bcd12708062693f44bb0f721e40feb311a4e",
      "text": "Dok, saya sakit perut sejak tadi malam.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "915b4643e3fbe41cee6cf9dfd5ab8880d6660a86d58f3f32e65ce36ca9f067d8",
      "text": "mudah-mudahan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "91cd4b0c5bd323049dbf6a9449b02ec76e4ee3792b17ee50acffcfd86db91f49",
      "text": "Sudah. Obatnya diminum tiga kali sehari. Sekarang sudah lebih baik, alhamdulillah.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "92eba1bbf640fbf454a9c3cd9d478b337712b9a4a6b0b6e113971d6859b20315",
      "text": "Kamu demam?",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "93068768d436207fe2c8dbcc57f49cf7c092535a6e4e81d41565aaaa45837c82",
      "text": "Perlu operasi?",
      "voice": "id_ardi",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "977e422d67846e4fee0d6c493bb05acb07a8ffe15e9ab4eae57cb2ca9f816138",
      "text": "sendok teh",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "97b307e1f100031c7871bc974e3d57e261edac40342ea15c1d643230fe9817ca",
      "text": "klinik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9adb6303ccc6dfdcef93b1d93375a08795a46c45104e15e958b00e817c56b8b0",
      "text": "Pasien itu perlu suntik.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b916d51a789c227983a3c9b76dfbb4674816b265b07b3846e657f582180e532",
      "text": "Ini resepnya. Obatnya diminum tiga kali sehari sesudah makan. Banyak minum air putih dan istirahat, ya.",
      "voice": "id_gadis",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c1cec23c7a04695019432863cc04377ab1e0a3a365122f8c4d888d2493ff59e",
      "text": "Selamat pagi, Dok. Saya demam dan sakit tenggorokan sejak dua hari yang lalu.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d11aa104c7cffd223489e0c8bfa0ca68c2c7857a6a202fdae8ecd8501f2794c",
      "text": "patah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ecfcd962914d0895676fa7fd87bbfcc2af1e71bae7e8786c43e793d795a7d4a",
      "text": "kocok",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0ddc5107bb8a3b919771e338adef6d0b0f16beaca4426a3d657a8ca4e9a37f6",
      "text": "apotek",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a14eba18b3915a8a264d8bf349471ec5f5994337acc8b2fa85f1069ed14cab90",
      "text": "Pahit, tapi bagus untuk badan. Semoga cepat sembuh, ya!",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a57132b226c117e2a09b8b9beaec1a034871e358fc763dca4dd46910a537019d",
      "text": "Di apotek, saya beli sirup obat batuk.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a76039fce5420430a9acaa82874ae363a3e45178d87b3551f306f29f0770a178",
      "text": "aturan pakai",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "aacbd06dd55023c9d8afbe4f25e7868c84e47fcb46f9f5a91ef155ccf7f63d72",
      "text": "Sesudah operasi, kondisinya baik.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab18d92d6238da614e36061298adaed40700083dc07f8ae9102c43f8b3141d88",
      "text": "Baik, Dok. Terima kasih.",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "abd2c52c1c3af1f547bcfecde97c95bfc6aa1ad0c6ecc9a8ac5293a70592e89c",
      "text": "3 x sehari 1 tablet",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad987b9cc0b56147976d1aa7d6f35617ff280dddc1c8ec0ee72ba4fe61e25304",
      "text": "Mohamed, masih pusing?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "aef124df49f75a9c2951d18c3bb53d90e1128e87ee436424df3d98c0d5df3d61",
      "text": "Siang, Mbak. Saya batuk dan pilek. Ada obat batuk?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b505d69acbff19497d004f171c05c0c7b0751071f1241c49d30b53365e2c5b60",
      "text": "mulut",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8bd37230306c4373000cdb858e60630f56e56e2cca2b7312da7ce988a84cb9e",
      "text": "Kulit saya gatal, Dok. Merah semua.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "bad265497e52bfdeb1e4bb70bb37ec22180471e395b7e35dc0ffa33dceeb85d9",
      "text": "Alhamdulillah! Ayo, istirahat dulu. Semoga cepat sembuh, ya!",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc5c2cd559680c31c37f4bdafd9d486744497c8acf75dd39405f8b78ee903dc9",
      "text": "Iya. Kepala saya sakit dan saya merasa pusing.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc7b246113a4fc33f34e7bb3dabbf44c618d6fd508a46b6a6cf6f90ed77d6138",
      "text": "Tolong! Ada orang pingsan! Telepon ambulans!",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdeef4ffe0cb98c2f3da4849fbc06ce10fd8955d3b455100788e41f85fb87dc7",
      "text": "Kocok dahulu sebelum diminum.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf8a33e0832c01f8255975fd26ea71b427fe8d08974659ea3af7253ce5d90705",
      "text": "Saya sakit tenggorokan.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c008fde832a0ddda948748ea35494944a390c773aeba8f50d15b6c6d900e88f7",
      "text": "Selamat pagi. Sakit apa, Pak?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c10cb383143a8017872b6f303991b18990ee1d126cc63b9884d1a5f1316f5fd7",
      "text": "Minum obat ini dua kali sehari.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6992cebcec54eb25d0e7b02e7bb4a8e4b8efeab9ad65a574c6d4ca0fd798167",
      "text": "sirup",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce402359a4969b146bac6c74fb430550d3e91f80a6de14bd4deb9feee01d6863",
      "text": "Mudah-mudahan besok tidak hujan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d054d49b7de4338a32a159796c7462998dcd40f07c0cc8e4dc064468a7d99280",
      "text": "Boleh, tapi jangan lama, ya.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d09b14b0a311aa8cfa9be25cb7881baa7b8019cd8c12284010997261ae172780",
      "text": "Aduh! Sudah ke dokter?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0f7308dfbfc0afc13ca146c980f8b16a6b826083eb3816ccfd552e5b0375576",
      "text": "Sudah lebih baik, alhamdulillah.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d28119230bf6a894514ecf92e426ab13a81949807dfb3acddd249d622cd3b540",
      "text": "Ayo, minum jamu dulu. Semoga cepat sembuh!",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2893f02ddc19b3be5a97f712bedfd6412fed40ed8abb2b6237f98ba5eb6ea1d",
      "text": "semoga",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d4543308932aea68f8fb11ccb300e158118e86db51d35270630f612e519704",
      "text": "Ayo, istirahat dulu supaya cepat sembuh.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d58244981c8d27182bcdd40d837f0652f9fd12a9f6d63f8adf6e6f671283d403",
      "text": "Amin. Mudah-mudahan besok kita bisa berenang lagi.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "db1b4930617e9665d6e1efd10337da9e1ee4da2fffe113b8220c3235f92bd73c",
      "text": "amin",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "db513e02b7e948bad6090afd9dacf87ceb373aa3b671a78c1fed0cee96538573",
      "text": "Kemarin makan apa? Ada alergi?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "db8c6aa207b202d7f358648c55a3dca051f48ef505261c8cdcbfc2f5ff0fe447",
      "text": "Amin. Terima kasih, Rina. Insya Allah minggu depan saya ikut kelas.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "de7216b74043e719ff39a160876a951eac59a588139143b62f0168f6176b06b6",
      "text": "infus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "df77ec9b1ba7ff417746dba49b6e6eb651601bf6e31c85b45d410ebb542b01fc",
      "text": "batuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2243d915a17058da482d2b6da55372267599e77a7ab076350ddcee82e0c09db",
      "text": "Bu, bagaimana kondisi teman saya?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8db25823f4c75d7498ff7ec771d54425ac9881f35b3cc7bcc23afe986542b18",
      "text": "Terima kasih. Wah, pahit sekali!",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea7916c6ab44795bb490fe28f3dbc8075dcd91d00cb491ebf7124b8853117106",
      "text": "Saya alergi kacang. Kulit saya gatal sekali.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4aaa3ed2cf75bf58be92f1db160a3f52c518413d38ff23c9038ccc57e95ef97",
      "text": "Diminum tiga kali sehari sesudah makan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7a3112dd7ac0e644342220f3d18cd64b449cbbf19ee9d29414b259f686693e7",
      "text": "Coba buka mulutnya, Pak.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbb51d2aaccf97896e977debbfae5ebfda5c578e18f28e740fb2a96f45cfa75b",
      "text": "Alhamdulillah, perjalanannya lancar.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 8,
    "clips": 143,
    "chars": 3721,
    "audio_bytes": 0,
    "missing": 143
  }
}
