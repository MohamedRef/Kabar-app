{
  "format": 1,
  "id": "id/bipa2.u07",
  "language": "id",
  "unit": "bipa2.u07",
  "version": 12,
  "content_hash": "dad0d7276eead5cbf8c1fe91335fee8fb261b186148056fc6316f8f39a63bd97",
  "lessons": [
    {
      "id": "bipa2.u07.l01",
      "sha256": "52a22d6785d4cee67bbbd1ee699b4b766aad474eb2069261e9a191785ad200fc"
    },
    {
      "id": "bipa2.u07.l02",
      "sha256": "53a0e5f615022d13c2d7bedadd4f022d3811de929105816facb92823c218a3db"
    },
    {
      "id": "bipa2.u07.l03",
      "sha256": "5ad82482e3ec654d7e0dc8b46c20a6a0183b7d4d63a097213741d64f39bd462b"
    },
    {
      "id": "bipa2.u07.l04",
      "sha256": "0ce6f1913ffeab5b983e01bf601560aacd26e08a8e655d5187a2c623ddb7ab7b"
    },
    {
      "id": "bipa2.u07.l05",
      "sha256": "083afe2e0fc6614f165a656dfaea4307f5e7bcf58637f6fc60c4ede806b4c833"
    },
    {
      "id": "bipa2.u07.l06",
      "sha256": "1a17f191fc069a61205deba997e935dbca5263cd53a12a82f3d8424d20ef6077"
    },
    {
      "id": "bipa2.u07.l07",
      "sha256": "48f5776f23f36a364b9ac0508db341b8b1816281e4dc3f092dfad0942a0c8963"
    },
    {
      "id": "bipa2.u07.l08",
      "sha256": "663c003e2296397911f5560dcbd49ef8467a6da80e861c8e3d5ba427eed8940a"
    },
    {
      "id": "bipa2.u07.l09",
      "sha256": "726a4a1b960d8662a6f2733dd926d94d291e62388bc1e91a3be85972bd09943c"
    }
  ],
  "audio": [
    {
      "key": "0061d4deab8baa5532e24fb48d5013b5fb431b24a765c9ddb231684971358b95",
      "text": "Mohamed, kamu bersepeda ke pantai?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "01deee559a90538e5b7086d44f2ee336f365a05e15fbc36d3a5a7cd38f339ace",
      "text": "Tekuk lutut, jangan takut jatuh.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0247de485157df187a2c6c392266a1b4a146abb0a52afcf37ce93f63ed997e75",
      "text": "Tapi lihat, ada darah di kakinya!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "031b0d21fe54be7cfffd735cb9483b9a4e324458c4a8de7d1c0d3a22b33eea49",
      "text": "Lalu?",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "06c8afe6d028d4ea3113529fa277dbbfa91521b5fbefd8fdbd830f29c3ca1624",
      "text": "Ayo nonton bola! Indonesia lawan Vietnam.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0739485d83c9af6424f2926818d5251edbd26354e38a4bac6a092aab82137be2",
      "text": "lompat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0aeae3e95e2b372b3c957758fb8fb06caec36f6a39ed4de065d55aa932ac1260",
      "text": "Belum pernah. Aku biasanya bersepeda.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bcafba59d984c1583a4df31c6cf1548e4cf57c79fefa2fd8183df3627f65b7d",
      "text": "jari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e706ca1f2a2996dba86d4154ea760fe62d6fb66bb44c2fbd93290efc5f9811b",
      "text": "tempat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec2ab4fe39280ee9011db92e95d4417c02db2926d53f84cb4c3d1d6c645b7ee",
      "text": "Kami main voli pantai di Kuta.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ecc8d91a9b0d14ddae07a904b043f260cfa7e3a270e9be2eb37e60116440aaa",
      "text": "Udah berapa lama berselancar?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "118a2c0562daa71278d5ad7359a3b86c4f7bed8f7ccbdbf8acd158aff80cf4cd",
      "text": "Dua-duanya! Sekarang tarik napas…",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "12c3eab9601a82fa86581666483e74feba61a0580de98393990e062806144276",
      "text": "Setiap sore kami berdua bersepeda di pantai.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "140a7dcb9e4c01ac299e0b6ff6680d29fba9483b89d5c87e0f5beec3392a0329",
      "text": "Putar kepala, lalu lompat.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1622237e7c728abfc8c3ad3abe159a0ab66d59125619c4a485e53e02d0a2bbc3",
      "text": "skor",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "18366658e2154d1ae6a79b9d45527da85ad871f3367892bf91c4fe8157795d39",
      "text": "Pertandingannya dua hari lagi.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b3e8bda3c2e5d23aca86cb4b8257a61f941c60582e4ac6ac5b3a67366cacd4d",
      "text": "selama",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b64ad2116767df7ede03c6a885693bcf727d442b3d704e00facedd31112b19f",
      "text": "Sudah berapa lama kamu main bulu tangkis?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cde8aefd2776562bde509fd0934e9796d0e5f5659d256a20e85d07670cf5051",
      "text": "lihat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dda7afb73fc6636e0713910eee197981ef74d997d9fcfbd48fc560832f014c6",
      "text": "bersedih",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e40843deb7b6684a704c61f13d4e9b441d77d0cb7acaaaa28cfe41483a9c1cc",
      "text": "Mas, lututku sakit.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f16161d1b6d1a921f1583b69d092abc98d65676474457f7b8699b8dd065c56b",
      "text": "Yang bertopi merah?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2161cfabd309339bb70b9f4f6e5af72e4b87ceda14b8bf3da780cac598fd126e",
      "text": "voli",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "234c299d03d8bf09db0eb26ebe32b433712f8a15e6efb8d2f8409ea331d6f73f",
      "text": "Gol! Skornya sekarang dua-dua!",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "26634f37bee3ed744f620f4bea8fbe45edb06d8f0c3af586bed000ba68ae71cc",
      "text": "Saya tinggal di Indonesia sejak bulan Maret.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "26724c2a6bc7b4276869d7e4938e95788856c9ba85446fccddc9c5b1089b799f",
      "text": "papan selancar",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "29a80d1fa52c493b1ba00e2505278d067a1fc4cd5209a6dbe130c01ec9439ff8",
      "text": "Anak yang berbaju biru itu bergembira.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "29ad481549b56c64f662a9361cb58e7245bfccda942f6b895c1a5c0f8eabbc52",
      "text": "Dayung dengan tangan. Lihat ombaknya, lalu berdiri dengan cepat.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "29b49e2d88a4732cb90f619ed4bc3157074c95204a5c78cf2ecf406d9db063b1",
      "text": "Jangan bersedih, besok kita main lagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cf86ada90e985dc75b650bb130eb6753c6d9d301199cf7fe5887e7a48a87332",
      "text": "Wah, aku senang banget!",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "32ad366adf3feb28c1697f9faba1b74dde45db594a33addde991cf71343bc29a",
      "text": "dayung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "33160e60b91547ac017d0a31176937cdd57142a474c56d22ad996a4175325244",
      "text": "Kami berdua suka berselancar.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "3349be3b61de3c35f7237dc242173c41399550ce0d8d51ccb3bf295b6cb32481",
      "text": "Mohamed, ayo main voli pantai!",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "36fb66c8b7d1d4493c2330c7cad4b78a615d5e39f80e78a81d9fb578e13f4d3a",
      "text": "kulit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "381531527f6f0d549c7e645da1a47d248de4a26e88915f9ac467e574a29dcc0a",
      "text": "Kami bertiga belajar dengan pelatih.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "38229708cb21c5aaaec80aaf6d8dfae95c52ed2719a4f44762f88e4f69566a1e",
      "text": "Putar bahu ke depan sepuluh kali.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "389cd1429eb503bff15d99978d211c807f7e540f8be294db6c451ec71bf567c7",
      "text": "Tekuk lutut sedikit.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b7513713fdde0b7b56890f162d4b132c0450f5b0d12f12b12d37e53ab398b6f",
      "text": "tekuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eaa47791302379475ee7b1f000550de5f4120d8dd66df4084c913f29dbe4623",
      "text": "sejak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ffc82682b7238e00d8178953f0c7f181083bac10d283339e29858ffb8220ab5",
      "text": "Baru satu bulan. Tiap pagi aku berselancar selama satu jam sama Mas Rizal.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "41167920319785d58dec092a0abf45b03289bd36328963b3363e5bc8d275ceee",
      "text": "Skornya berapa?",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "4954936f715066326d155a8f12059a2afbf8765865e98492a88edf0f48573591",
      "text": "Gol dengan dada! Skornya satu-nol!",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c9dba89a7d791539f2546d9cd4302228df05fef97b7d754a456a6f2e3c110d2",
      "text": "Nggak usah kaos kaki di pantai!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cad6d6a6845de1ee37ae722b3553cd16fc33c576e6b7622071f9a145a5b64f5",
      "text": "Mudah! Pertama, bawa papan selancar ke laut, lalu berbaring di atas papan.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d31344cdaf6cea925d42f9d2522dc248fc5bd5c7d0ef3c635be68011cb41abe",
      "text": "Pertama, berbaring di atas papan, lalu dayung dengan tangan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d82f742ef79825c2a182c3b510f179b21c09d1640b192ee87f30d96b907afff",
      "text": "Anak-anak bergembira di pantai.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f310038f9c926a41a7807dc9f45b8a5ac669eb87d3b15f7102b73481e855176",
      "text": "Panas sekali. Saya pakai celana pendek.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fa7e886766328ab5a2c00748bff3be0ffc2b6552377119c26fd11611db87391",
      "text": "Nggak apa-apa. Dia tarik napas, dia banyak keringat.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "50354c5b4025b50bee9fc31ac370e69bac95d09081be2a96b426263ca3333b0e",
      "text": "Ada darah di kakinya.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "54bdc8bc6af0a3e2e10896c39e5db5ba7c2ae649c614cad562e210fd56fd197f",
      "text": "Setiap pagi saya bersepeda di pantai.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "570fcea2e4392b34709706999d12a17f52c3ed17ba31993b845f8fc0500df13e",
      "text": "berdiri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "572e4d3a500bb23a5ce0b17eb723aa3d13053dec13b3aa5be718906ee669a481",
      "text": "dada",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "57e45e39e06a5e0df735a5e222b0b2e40423c883ff74e0512554c42c49c98fd0",
      "text": "Angkat kedua lengan, lalu lompat!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a98392721647e39803d731377563b62c4742d2cde3e0c627a0a0cc14f438c6f",
      "text": "berbaring",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e2bd68a4530b9e1cb9a95dfc46927a57412d58e177bc7b79c6a5bb8bad5b4c8",
      "text": "Udah sedikit! Aku belajar sama Mas Rizal selama dua minggu.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "63760f1dd4df9979b1af68e0595551f04581823fa877eae4f1e930cfdf7c3566",
      "text": "angkat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "64a61f64f1a4dad2a7e40c8750486805379f56429bce10334d46727ce9cbd9ea",
      "text": "bersuara",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "64b38c7ec40d9317b3e6b7931bfc434eeae1e1f5d07a521c452c92294f44edf4",
      "text": "wasit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "64b686dc1c84b7a5e4fe97215ebb50b1f2f9c5655af0fd8fe710a48742e38816",
      "text": "turunkan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "64fb1dee327fa7f7f244d0e0347d1ca23f477aa2acda984e5eb5345e479505da",
      "text": "Sepuluh tahun. Aku berselancar sejak kecil.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "656a908cb599341e4d859f1dba10f5d595532477252c84090823b616324896fd",
      "text": "Ya, kami bertiga bersepeda: aku, Raka dan Ni Luh.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "66f71f480bf5ff96778c63614bbc3290722c422fe0fb5868357ffd1f94c8b4fc",
      "text": "Setiap sore kami bertiga bersepeda di Kuta.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "67885e535f19ba69d1f2b241670570a8c590fc737a024fa6437dae47ffa09be5",
      "text": "Setiap sore aku dan Raka bersepeda berdua di pantai.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6821e738163999fd8630e033a61d2ee0222b866e3cd41b4ee954321220bc9c3c",
      "text": "keringat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "69f7cbbe982ea7baaad35be5a105518dad152ba15df0959aa3ca1a11f947f673",
      "text": "buang napas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c9e8c38505079333b8055829295236212bd6cf92cdf7936ccd6c59fea8add52",
      "text": "Mohamed, udah berapa lama di Bali?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cbb8952aebd306f051fe7e4abb366ef23df2c2bdb4c0ea3e7c99f163db2a797",
      "text": "Ayo! Aku pakai celana pendek. Kaos kaki juga?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d06b07271a2b9e773ff209240def70f0deb432a79593563fd1fc01dc904c117",
      "text": "berapa lama",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "71aa5fb0d70175748208dba50fd3a17b2d6fc109e3ed96b99ce65ad79288325b",
      "text": "Wah! Tolong ajari aku, ya.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "757f49da89fa275338680e81a26ed23940d8c2c6b0cddb8e6c34f5116b004e76",
      "text": "bertelur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "75c09f9995fca4eacbf3552be614b92d616852047fbc774e09464acd8e55966d",
      "text": "Ayo, coba lagi!",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "76820f3496fd3b650b0e250a47e89e4517ea125eb0b9fdffb7e6964c94cd6769",
      "text": "kepala",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "76ddbd01efdcf131ec60f84a41887b64e591f3dec21d45dbdc972fe6f6cef9a4",
      "text": "Berdiri, lalu lompat tiga kali.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "77401e70bc84ee8d0ef926e16faa3f7b0e2402ccb842a500a1046c445778fec2",
      "text": "bertiga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "799ca0502927b2d145979195ca3be723436e11972ee4115dec6465f8866c3052",
      "text": "Kalian berselancar juga?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "79ea797498b9eb7b46d9427db848eabf2d11c257c64ba05cb591b1e98ff75950",
      "text": "Pakai lengan, jangan pakai jari.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c07128c19671f1f6d31ac69a023c53da969312a7128e3eec8924043774f9dcd",
      "text": "putar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c0b3c21630d4f3f7dc23e0b9ed68706855d2973001cacdb8961d66d3435fd94",
      "text": "pelatih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c5e36708c3e069d22868d9aa8dafe7afbb66f4a46c06790bebb9415d97737b4",
      "text": "Gol! Skornya dua-satu!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c7e8a93d9035f0e75cec3cee7fc99b1842b5602717a96209ef11486862ab060",
      "text": "Saya berselancar selama satu jam setiap pagi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d106fab8472b937777234be8de16c38cabd0d603962505d43431951a81dd356",
      "text": "Baik, sampai hari Sabtu, Mas!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eafe0f1e2f0b30ae1940b3a03cb1efff7e0a5d1efbdcab9a89a04afa97f13cc",
      "text": "bersepeda",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8080dd7e6cfe1462c52334d693e4768c20693f294b4ad372dbc1ded38b6d2fc1",
      "text": "Saya sudah dua tahun bermain bulu tangkis.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "827265328e877369488cb38e67618c73757a1d55934ccbc86876678358c28bf9",
      "text": "bahu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8303235b3f477cb10ec3fa5f9339bf1f788569074aeb0a6a222f0a460fe28f57",
      "text": "berdua",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "83aa07f2a06a9c9ce232be248e8e9592aa8330f5887d4ef02969e7f58c650c8e",
      "text": "Sejak bulan Juli, Mas. Udah tiga bulan. Mas udah berapa lama jadi pelatih?",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "842b12b4eb5201c1046339c9899e412198d630f19078b9021b8f63dcf235cfeb",
      "text": "Aku suka berselancar dan bersepeda.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "84cb3e676a11f2210e5d361c1d86288928f7379dee98cceccf1d9b5aaecbd0d3",
      "text": "kaos kaki",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e1eb7b85eed532faf6e544492e19d4750eca17243e33474ea20827431ae11c",
      "text": "ombak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "86adbac700f05db73148f0bf79924e57c087b8be4bee6e061f0704aa8f58a524",
      "text": "Bolanya keras! Jariku merah.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ec9276756ec42a5aeb416710cefb35f974bc8486979b3596e18d84eced1e07",
      "text": "berkacamata",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a0d277b6a85c6e76752b558eb79983118a3c89aa57dfd256fdbe80a0fa9bb8a",
      "text": "Di Kuta banyak orang berselancar.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "925561173138cc01301da8989137068961bea1628b7a44eb8cf3c28f420306a5",
      "text": "bertopi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "94eaaa4c3e5ff2280a0023df425219fb2a98394e1027e8a7d59700613cf0026b",
      "text": "Wasit itu tidak adil!",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "950b88f04672c24e56d9cdf5e34b0a5ab7ce0116184c056093102aafe6c36010",
      "text": "Turunkan tangan dan buang napas.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "956955880c0caab7c9dac604e0ec5b3d71841012c5cb54642c1be3a89be1a981",
      "text": "lutut",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "967525ea5c66aa87e7144298e12ff88e22afd2daa6fbc43fa5e7ca5cd2c45b8a",
      "text": "bergembira",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9773cd4d80605847a256691719e717154fda1ccff1beef224a484a841118a1cc",
      "text": "napas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "993ee23a7e24bd1ea77b3f3d7464ef48d3df41fe83a8b21c3872c03a159de174",
      "text": "Iya! Besok kita berdua belajar berselancar sama dia.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2c94161f0d010308e139b76691c3365df10cf386d8273949765fc1f427cfde",
      "text": "berbaju",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bcc1f1319b370dbe30361049fb228170b7236f865ea54a7a2e2b9f4b67cb539",
      "text": "jatuh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dc7815ccdfc8e5b6240ac5ae52850bd36d246e95a2673aff8fc8da1a908c889",
      "text": "tarik napas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1ac9c8c5b3dbc1748f48627ee0d8fbd9dd77a5d6e9b9dbbab242f47c826dcdf",
      "text": "Kami bertiga berlari selama satu jam.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "afeecdfe482db375f589a404998e3cdd87a2671d3ac280d0e1e653e495a0bd37",
      "text": "berselancar",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3cecb30778e6300369ea66172c610926adaf1edc9fdbb01e17803714d0e5bae",
      "text": "Lihat ombaknya, lalu berdiri dengan cepat.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b54df0fd7789e7a93f3799ad251572507dc6f8879e40a4833b1b925338ded8a6",
      "text": "piala",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b873c7d3dc004c30edf7e6214c74329c343c7f1b626897bd139e290a31c7740f",
      "text": "celana pendek",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90847642b76c567d0c892e9d28d722fc37146ec032764f6c65fc0eddbde76ad",
      "text": "Dua hari lagi, hari Sabtu. Kelasnya selama satu jam.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9a6d853cf65dc410912d805b4297381d2828875618d7fd75e37ddcef2b1a61f",
      "text": "Hebat! Kapan kelas pertamaku?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba64eb94f293ed00a5c4c4142fd77eab0dba8261b3977205b6f13210648b33dd",
      "text": "darah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf9379d0e70dd4a0bc980048933afb6d1d5c2ad9ef4ca38e224fb1e8a0a70ad",
      "text": "Tangan saya punya lima ___.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd8871df3973aaf2423ae2658a9c037419982521c7f5684afb8506bde89b7a65",
      "text": "Ayo, Indonesia! Ambil pialanya!",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "be32e1d5f9f8be18706e230344bdb95c4c8e531baa69ec0465ca4c1fd4654d20",
      "text": "Pakai celana pendek, tidak usah kaos kaki.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf452e62c2be135d2e78d25407c485b8d53fb0831b21c55944f2585d5c0e9c70",
      "text": "Kalau sore?",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13e2523473ce220813e8d2883deea8761efbb6f918d5f58786558b755d48450",
      "text": "Lihat ke depan, lalu lompat di tempat. Jangan takut!",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4d125779a7f8120d2660ce853e75725c0803e3829a117287e88f60e7e5c44f2",
      "text": "Lihat orang yang berkacamata itu. Itu Mas Rizal! Dia juga pelatih selancar.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "c518263e9909468ea512b289cb0f0d4867c2c7b414cea300ccd5b6e7cdc22e5b",
      "text": "Raka dan Rina pergi ke pantai ___.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a2e725963e7f535792bd05954288f3bcd83dd98a73befd158d03a0cacb5189",
      "text": "Di pantai Kuta, orang main ___ pantai.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "caff48bce087237e6a2e780d8adc4ca9f7d16f633d3421d22dc7c4ed97858fda",
      "text": "Ya, bagus! Sekarang turunkan tangan dan buang napas.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1d68b66e774864afe0916487b4649156afacc6c995bdb3811405fe4f3c1116b",
      "text": "takut",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2017c17f60410ddd0e5e1b7cb363791f2f8d2609008657840e46ab3c5288acd",
      "text": "Sejak pagi kami menonton pertandingan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e8e03bdf0b4f49a0c9dddce588bb993e5ca8bf39533528409dc22d6d106c8d",
      "text": "Berbaring di atas papan, lalu dayung dengan tangan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9eec3a5ce1e7165bde1ca0cadf0c05da2df8bfbe70fdc9aeb94183e642acb53",
      "text": "Kulitku juga merah. Aku lebih suka basket!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "da2cce15d4ca94c733bd2d94d71f75f41d19e20a3a0e35e0742af9690271d32e",
      "text": "Ayo, Rina! Besok coba lagi!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc8d162f6c9c30f7d17af966e41de9dafee08a9b8288bb535aa910005d8ce5e2",
      "text": "Kayak gini, Mas?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd395d4b3d48297aa8a60a07d591c783b99b1cc8fb69b7c3f1f8caeca4ed69fd",
      "text": "Saya suka main basket pakai celana pendek.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "dde2524adc83d1e25f26cd8f5f584877405f958da012ba81d56f1a3df2a27729",
      "text": "Oh, berhenti dulu, Rina. Duduklah dan minum air.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "dea511b94c4bc0bbf9da441a9c4bd921be755d7c3287069b2bd165e17177d639",
      "text": "Sesudah main bola, saya banyak keringat.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "df1bfe2fe2330d3016d6ae276d2f70bdae7ef2438b185544ef4824fcedfbdd1f",
      "text": "Saya berenang selama tiga puluh menit setiap pagi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd5749ee363b08bf16beb9811c592a8dc087cb7d5be0e070b850b6770fa9795",
      "text": "topi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f8e9c750b7b6d681f77d5db1adb9c600555cca620b9d54a04dc3b1662d7a54",
      "text": "Ayo, semua! Angkat tangan.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e370a2068df159a61bf3a99eaa895ffb1d83cb94a2649b73b5cf9250e9247d50",
      "text": "Orang yang berkacamata itu pelatih kami.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4482cb63c8ec0219a5d13fd8a5a176c58fd2c67b9aa3f85f915f9177cbc6bcd",
      "text": "lengan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e45863822e4e0f3f9774c5e31a954d51435e3053c520805c0bdc504be134963b",
      "text": "Tarik napas, lalu buang napas.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6365520c292ce48ab0e3910edde3027772ea843d781488c530f23bd5e4b3caf",
      "text": "gol",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc1859342b3d1de94b17123ece5e74c9c77287f59d73889a856e584894ebed6",
      "text": "Saya main bulu tangkis ___ tahun 2019.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed661dd73ebffd773239ae2c50885a74b28d294e56360d9877450870217b0177",
      "text": "Belum. Besok kami belajar sama pelatih.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "edb957f1c82b7ba538c9142b5408d28ad53db28c91fc345ad92e18accf532bfc",
      "text": "Mohamed, kamu suka olahraga apa?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef4d0bd8d1bd6efa524ef29d0a2c84b1ff957534164222a286e501812044c3ad",
      "text": "pinggang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f053c0155eb4f2489fd42f8f50bd75e178f3565f3924e782f08a6f98b2100c12",
      "text": "Mohamed, kamu udah bisa berselancar?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f155d57a42cca7f4ba840b63eadb228a70c6e232901398015a3fedcd3e489aaf",
      "text": "tangan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f15e3a40e551002a2a1319fca44e70b7f027721f92c08c9627f0f8480689df34",
      "text": "basket",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f17cbd36ad0421c97d4ff6632b0ed4dbbe30febd5308c5ae8b04d90dc7c2d5d9",
      "text": "Masih nol-nol... Gol! Satu-nol! Dengan dada!",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f25ae75758a8e03bfa8b4b73f340f3b238baa24fdfdeff23d08ab47c36cd50a9",
      "text": "Setiap hari Minggu kami berdua bersepeda selama dua jam.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2c9644c4d5e68766cccad8a40b306b50d596eef2619c533d398da341b601559",
      "text": "Tangan di atas kepala!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f428530b0bf21c2c281d2144de3c69e6a878aafb247099ce215ce728385dfe94",
      "text": "Pelatih kami bertopi. Topinya merah.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f51ea5ab043ef2019a780ac5fdab72aebf95a89fa2a77175f19c590a43584064",
      "text": "kaki",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f60bf7bb3a3d9906c2ac272ae6bcc0976e81f2b57edfa16a7ddf26f70aa78c9d",
      "text": "Selamat pagi, semua! Ayo, berdiri. Angkat tangan kanan, lalu tarik napas.",
      "voice": "id_ardi",
      "chars": 73,
