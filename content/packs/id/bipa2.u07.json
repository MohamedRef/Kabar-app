{
  "format": 1,
  "id": "id/bipa2.u07",
  "language": "id",
  "unit": "bipa2.u07",
  "version": 5,
  "content_hash": "10027bd603398c713fa80dd8fdd2642edd8370fb62b4020e0c36ca2070edbefe",
  "lessons": [
    {
      "id": "bipa2.u07.l01",
      "sha256": "e05efa1ec4aa41385eb0f35f484005132b82f7cdc20e2f27de9f03ecc2a1ebbe"
    },
    {
      "id": "bipa2.u07.l02",
      "sha256": "8c344ce5a15734eaf5ac6dbc24ce03bfc92b6247b63cb6c9fd30d3641957fb08"
    },
    {
      "id": "bipa2.u07.l03",
      "sha256": "7150ab851fe788bc0cb7e40e05eba2229693bbbdb2e556e69087a81fc06e3767"
    },
    {
      "id": "bipa2.u07.l04",
      "sha256": "6c105796226a502688b65fd572d9d8c47cdbbca729bd8887b4df868b835519b1"
    },
    {
      "id": "bipa2.u07.l05",
      "sha256": "82ee5b40dd68a691146483d3b0a4c55a34abcfb62c1a526ed08014d24549d9a6"
    },
    {
      "id": "bipa2.u07.l06",
      "sha256": "67f0d024f7b11caedc2c8754fb17babf2ba3dde085928e1ff2c2ef38a4ab57a9"
    },
    {
      "id": "bipa2.u07.l07",
      "sha256": "5b411ac0d0ceeedac318af34519a26ff35232bf7683cbf28659aaa2a2e7c86ce"
    }
  ],
  "audio": [
    {
      "key": "0061d4deab8baa5532e24fb48d5013b5fb431b24a765c9ddb231684971358b95",
      "text": "Mohamed, kamu bersepeda ke pantai?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "024b8c5329c6d9a8a57356e161c2eb9a1aead736549de89e07bb70a527275319",
      "text": "Belum pernah. Saya biasanya bersepeda.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "031b0d21fe54be7cfffd735cb9483b9a4e324458c4a8de7d1c0d3a22b33eea49",
      "text": "Lalu?",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0739485d83c9af6424f2926818d5251edbd26354e38a4bac6a092aab82137be2",
      "text": "lompat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "118a2c0562daa71278d5ad7359a3b86c4f7bed8f7ccbdbf8acd158aff80cf4cd",
      "text": "Dua-duanya! Sekarang tarik napas…",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "12c3eab9601a82fa86581666483e74feba61a0580de98393990e062806144276",
      "text": "Setiap sore kami berdua bersepeda di pantai.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "18366658e2154d1ae6a79b9d45527da85ad871f3367892bf91c4fe8157795d39",
      "text": "Pertandingannya dua hari lagi.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b3e8bda3c2e5d23aca86cb4b8257a61f941c60582e4ac6ac5b3a67366cacd4d",
      "text": "selama",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b64ad2116767df7ede03c6a885693bcf727d442b3d704e00facedd31112b19f",
      "text": "Sudah berapa lama kamu main bulu tangkis?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d01ca54fcc6f3ecd3516b6884b10c1435b40a836b316339f47baa71f6b2e78a",
      "text": "Ayo, angkat tangan! Satu, dua, tiga!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dda7afb73fc6636e0713910eee197981ef74d997d9fcfbd48fc560832f014c6",
      "text": "bersedih",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f16161d1b6d1a921f1583b69d092abc98d65676474457f7b8699b8dd065c56b",
      "text": "Yang bertopi merah?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "26634f37bee3ed744f620f4bea8fbe45edb06d8f0c3af586bed000ba68ae71cc",
      "text": "Saya tinggal di Indonesia sejak bulan Maret.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "26724c2a6bc7b4276869d7e4938e95788856c9ba85446fccddc9c5b1089b799f",
      "text": "papan selancar",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "29ad481549b56c64f662a9361cb58e7245bfccda942f6b895c1a5c0f8eabbc52",
      "text": "Dayung dengan tangan. Lihat ombaknya, lalu berdiri dengan cepat.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "29b49e2d88a4732cb90f619ed4bc3157074c95204a5c78cf2ecf406d9db063b1",
      "text": "Jangan bersedih, besok kita main lagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "32ad366adf3feb28c1697f9faba1b74dde45db594a33addde991cf71343bc29a",
      "text": "dayung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "33160e60b91547ac017d0a31176937cdd57142a474c56d22ad996a4175325244",
      "text": "Kami berdua suka berselancar.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "38229708cb21c5aaaec80aaf6d8dfae95c52ed2719a4f44762f88e4f69566a1e",
      "text": "Putar bahu ke depan sepuluh kali.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "389cd1429eb503bff15d99978d211c807f7e540f8be294db6c451ec71bf567c7",
      "text": "Tekuk lutut sedikit.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b7513713fdde0b7b56890f162d4b132c0450f5b0d12f12b12d37e53ab398b6f",
      "text": "tekuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c8dbeb55c0b26c059da26d1b691b7ada4b2828416af5e17baf9065b79f8ec4a",
      "text": "Mohamed, sudah berapa lama di Bali?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eaa47791302379475ee7b1f000550de5f4120d8dd66df4084c913f29dbe4623",
      "text": "sejak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cad6d6a6845de1ee37ae722b3553cd16fc33c576e6b7622071f9a145a5b64f5",
      "text": "Mudah! Pertama, bawa papan selancar ke laut, lalu berbaring di atas papan.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d31344cdaf6cea925d42f9d2522dc248fc5bd5c7d0ef3c635be68011cb41abe",
      "text": "Pertama, berbaring di atas papan, lalu dayung dengan tangan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d82f742ef79825c2a182c3b510f179b21c09d1640b192ee87f30d96b907afff",
      "text": "Anak-anak bergembira di pantai.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "54bdc8bc6af0a3e2e10896c39e5db5ba7c2ae649c614cad562e210fd56fd197f",
      "text": "Setiap pagi saya bersepeda di pantai.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "570fcea2e4392b34709706999d12a17f52c3ed17ba31993b845f8fc0500df13e",
      "text": "berdiri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "579b25101522dcafdda74bb7b16ee95c7962f1073c48ca22bf8fd6804e15e07b",
      "text": "Setiap sore saya dan Raka bersepeda berdua di pantai.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a98392721647e39803d731377563b62c4742d2cde3e0c627a0a0cc14f438c6f",
      "text": "berbaring",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "62cc50752dfaa639a92b40121732fb67008dc4bc706e2778faa5f2f2d3ff1ba4",
      "text": "Sudah sedikit! Saya belajar dengan Mas Rizal selama dua minggu.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "63760f1dd4df9979b1af68e0595551f04581823fa877eae4f1e930cfdf7c3566",
      "text": "angkat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6402be42abb54e0b777861ec7a014855c9affa23170663462cb23de7ea3aef63",
      "text": "Pelatih kami berkacamata dan bertopi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "64a61f64f1a4dad2a7e40c8750486805379f56429bce10334d46727ce9cbd9ea",
      "text": "bersuara",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "64b686dc1c84b7a5e4fe97215ebb50b1f2f9c5655af0fd8fe710a48742e38816",
      "text": "turunkan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "66f71f480bf5ff96778c63614bbc3290722c422fe0fb5868357ffd1f94c8b4fc",
      "text": "Setiap sore kami bertiga bersepeda di Kuta.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "69f7cbbe982ea7baaad35be5a105518dad152ba15df0959aa3ca1a11f947f673",
      "text": "buang napas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d06b07271a2b9e773ff209240def70f0deb432a79593563fd1fc01dc904c117",
      "text": "berapa lama",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f8fea5ebb7006cb7f3d1a537624aead708d6de6f6cfa6b3cf8a089c1b9cf20e",
      "text": "Seperti ini, Mas?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "713fdb8dbe38ffcfddd39b536b6995e7fbc26ac4a52ba03cc5726eeabbe15847",
      "text": "Mas, lutut saya sakit.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "757f49da89fa275338680e81a26ed23940d8c2c6b0cddb8e6c34f5116b004e76",
      "text": "bertelur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "75c09f9995fca4eacbf3552be614b92d616852047fbc774e09464acd8e55966d",
      "text": "Ayo, coba lagi!",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "76820f3496fd3b650b0e250a47e89e4517ea125eb0b9fdffb7e6964c94cd6769",
      "text": "kepala",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "76ddbd01efdcf131ec60f84a41887b64e591f3dec21d45dbdc972fe6f6cef9a4",
      "text": "Berdiri, lalu lompat tiga kali.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "77401e70bc84ee8d0ef926e16faa3f7b0e2402ccb842a500a1046c445778fec2",
      "text": "bertiga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "799ca0502927b2d145979195ca3be723436e11972ee4115dec6465f8866c3052",
      "text": "Kalian berselancar juga?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c07128c19671f1f6d31ac69a023c53da969312a7128e3eec8924043774f9dcd",
      "text": "putar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c0b3c21630d4f3f7dc23e0b9ed68706855d2973001cacdb8961d66d3435fd94",
      "text": "pelatih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c7e8a93d9035f0e75cec3cee7fc99b1842b5602717a96209ef11486862ab060",
      "text": "Saya berselancar selama satu jam setiap pagi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d106fab8472b937777234be8de16c38cabd0d603962505d43431951a81dd356",
      "text": "Baik, sampai hari Sabtu, Mas!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eafe0f1e2f0b30ae1940b3a03cb1efff7e0a5d1efbdcab9a89a04afa97f13cc",
      "text": "bersepeda",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ed61105a48a37442e4c428a703a62c4aeb0ef955d324936c894666277109082",
      "text": "Wah! Tolong ajari saya, ya.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8080dd7e6cfe1462c52334d693e4768c20693f294b4ad372dbc1ded38b6d2fc1",
      "text": "Saya sudah dua tahun bermain bulu tangkis.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "827265328e877369488cb38e67618c73757a1d55934ccbc86876678358c28bf9",
      "text": "bahu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8303235b3f477cb10ec3fa5f9339bf1f788569074aeb0a6a222f0a460fe28f57",
      "text": "berdua",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e1eb7b85eed532faf6e544492e19d4750eca17243e33474ea20827431ae11c",
      "text": "ombak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8689d4dee8fdd520befdfb96dfbcaa375f433c479ebd33ccef27be2b9a69f476",
      "text": "Hebat! Kapan kelas pertama saya?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ec9276756ec42a5aeb416710cefb35f974bc8486979b3596e18d84eced1e07",
      "text": "berkacamata",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "88fdf246115df40624f700511a55fcd0904016ccacfa116e6696fa6c96925c58",
      "text": "Sejak bulan Juli, Mas. Sudah tiga bulan. Mas sudah berapa lama menjadi pelatih?",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a0d277b6a85c6e76752b558eb79983118a3c89aa57dfd256fdbe80a0fa9bb8a",
      "text": "Di Kuta banyak orang berselancar.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "925561173138cc01301da8989137068961bea1628b7a44eb8cf3c28f420306a5",
      "text": "bertopi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "950b88f04672c24e56d9cdf5e34b0a5ab7ce0116184c056093102aafe6c36010",
      "text": "Turunkan tangan dan buang napas.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "95675daff44b52f23eeee9dc1a6fd8261821597aaea16ec86fbd097ce8634b75",
      "text": "Saya ___ di pantai setiap sore.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "956955880c0caab7c9dac604e0ec5b3d71841012c5cb54642c1be3a89be1a981",
      "text": "lutut",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "967525ea5c66aa87e7144298e12ff88e22afd2daa6fbc43fa5e7ca5cd2c45b8a",
      "text": "bergembira",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b2c94161f0d010308e139b76691c3365df10cf386d8273949765fc1f427cfde",
      "text": "berbaju",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bcc1f1319b370dbe30361049fb228170b7236f865ea54a7a2e2b9f4b67cb539",
      "text": "jatuh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dc7815ccdfc8e5b6240ac5ae52850bd36d246e95a2673aff8fc8da1a908c889",
      "text": "tarik napas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1ac9c8c5b3dbc1748f48627ee0d8fbd9dd77a5d6e9b9dbbab242f47c826dcdf",
      "text": "Kami bertiga berlari selama satu jam.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "a83a663d694b02e5bf906ea8d3ca5cac5d99e4ca4bb11c3ae6dac6c9c8ffd904",
      "text": "Ya, kami bertiga bersepeda: saya, Raka dan Ni Luh.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab79e588b70738f2779294d05ba57312dcdd2480f1eaad940459648be51f5fa5",
      "text": "Baru satu bulan. Setiap pagi saya berselancar selama satu jam dengan Mas Rizal.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad115fbffaad251209e7ba6380cf1f5ef69d3965d893e3c9026b30fc7a43c117",
      "text": "Mohamed, kamu sudah bisa berselancar?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9bd27812ce5ba6c902499bc800f41ad7c1f4a9d4dfc7279a722ba638ae0ce1",
      "text": "Wah, saya senang sekali!",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "afeecdfe482db375f589a404998e3cdd87a2671d3ac280d0e1e653e495a0bd37",
      "text": "berselancar",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3cecb30778e6300369ea66172c610926adaf1edc9fdbb01e17803714d0e5bae",
      "text": "Lihat ombaknya, lalu berdiri dengan cepat.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90847642b76c567d0c892e9d28d722fc37146ec032764f6c65fc0eddbde76ad",
      "text": "Dua hari lagi, hari Sabtu. Kelasnya selama satu jam.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd066366ef00725cc900beb8c77790628dd7471ba374949e31b6ffa39778dc9",
      "text": "Saya suka berselancar dan bersepeda.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf452e62c2be135d2e78d25407c485b8d53fb0831b21c55944f2585d5c0e9c70",
      "text": "Kalau sore?",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4d125779a7f8120d2660ce853e75725c0803e3829a117287e88f60e7e5c44f2",
      "text": "Lihat orang yang berkacamata itu. Itu Mas Rizal! Dia juga pelatih selancar.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "c518263e9909468ea512b289cb0f0d4867c2c7b414cea300ccd5b6e7cdc22e5b",
      "text": "Raka dan Rina pergi ke pantai ___.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7c5f800d181811d408abeb094bc74998dc8464e48cb62507f7978335f705720",
      "text": "Sepuluh tahun. Saya berselancar sejak kecil.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "caff48bce087237e6a2e780d8adc4ca9f7d16f633d3421d22dc7c4ed97858fda",
      "text": "Ya, bagus! Sekarang turunkan tangan dan buang napas.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e8e03bdf0b4f49a0c9dddce588bb993e5ca8bf39533528409dc22d6d106c8d",
      "text": "Berbaring di atas papan, lalu dayung dengan tangan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "d97d91e9a9b4b113a73596ddb0f80a26d4ad1367e6e2e5bdf67c35e0e51541cb",
      "text": "Ya! Besok kita berdua belajar berselancar dengan dia.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "da2cce15d4ca94c733bd2d94d71f75f41d19e20a3a0e35e0742af9690271d32e",
      "text": "Ayo, Rina! Besok coba lagi!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "dde2524adc83d1e25f26cd8f5f584877405f958da012ba81d56f1a3df2a27729",
      "text": "Oh, berhenti dulu, Rina. Duduklah dan minum air.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "df1bfe2fe2330d3016d6ae276d2f70bdae7ef2438b185544ef4824fcedfbdd1f",
      "text": "Saya berenang selama tiga puluh menit setiap pagi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd5749ee363b08bf16beb9811c592a8dc087cb7d5be0e070b850b6770fa9795",
      "text": "topi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f8e9c750b7b6d681f77d5db1adb9c600555cca620b9d54a04dc3b1662d7a54",
      "text": "Ayo, semua! Angkat tangan.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e370a2068df159a61bf3a99eaa895ffb1d83cb94a2649b73b5cf9250e9247d50",
      "text": "Orang yang berkacamata itu pelatih kami.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e45863822e4e0f3f9774c5e31a954d51435e3053c520805c0bdc504be134963b",
      "text": "Tarik napas, lalu buang napas.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb74dabca7a2441afd199e0c88f15fdb8192df41fe0a67926f522a540cc667b9",
      "text": "Sudah berapa lama berselancar?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc1859342b3d1de94b17123ece5e74c9c77287f59d73889a856e584894ebed6",
      "text": "Saya main bulu tangkis ___ tahun 2019.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "edb957f1c82b7ba538c9142b5408d28ad53db28c91fc345ad92e18accf532bfc",
      "text": "Mohamed, kamu suka olahraga apa?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f155d57a42cca7f4ba840b63eadb228a70c6e232901398015a3fedcd3e489aaf",
      "text": "tangan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f25ae75758a8e03bfa8b4b73f340f3b238baa24fdfdeff23d08ab47c36cd50a9",
      "text": "Setiap hari Minggu kami berdua bersepeda selama dua jam.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f51ea5ab043ef2019a780ac5fdab72aebf95a89fa2a77175f19c590a43584064",
      "text": "kaki",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f60bf7bb3a3d9906c2ac272ae6bcc0976e81f2b57edfa16a7ddf26f70aa78c9d",
      "text": "Selamat pagi, semua! Ayo, berdiri. Angkat tangan kanan, lalu tarik napas.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6ec4eb55a69456901f50a57ed9c7e7a7dd8bdcacaabf391fdc32f406ca169b4",
      "text": "Tangan kanan atau tangan kiri, Mas?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8fc495247dd233a4d24658af8553e303e6180c00c794b3d907ee74c78b96d59",
      "text": "pertandingan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9950e33d8e2f62ce8a481209d86ca38d348254b4352732ce67e2bf88daae271",
      "text": "…dan buang napas. Bagus!",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "faf65c94566aaf1adecf84438d86d9f1468e4014976a4e4aa2dce81ba541a56e",
      "text": "Dua minggu yang lalu saya mulai bermain bulu tangkis.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbb840a47c60657cdbf92985e85d16bf3f68f801595e1e0b607c054732b9c3b8",
      "text": "Angkat tangan kanan, lalu tarik napas.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd7df395cbb9d6f600ed4b0bcf892c6fd61611bf40c3b73207bf2deabb99a076",
      "text": "Mohamed, kamu suka berselancar?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "fea1f15887fbc7151d36de9bd6fb6c89f6037d0fa30f7802914b57f8d48558a0",
      "text": "Belum. Besok kami belajar dengan pelatih.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    }
  ],
