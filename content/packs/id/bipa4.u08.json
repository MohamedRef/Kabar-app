      "sha256": "b666fbc00204f633bada36517e55b568332bdb1b6614fe7d552cd1c4e22ef50e"
    },
    {
      "id": "bipa4.u08.l03",
      "sha256": "5a205209786656a7a80c16ada8456676316ae88b99d93ffc97c4ad1e06f99a64"
    },
    {
      "id": "bipa4.u08.l04",
      "sha256": "c797cd50f62be439c3767e59c8023c1cccd3506c904053dfc9042d164e9981e3"
    },
    {
      "id": "bipa4.u08.l05",
      "sha256": "08ff1fba6af933292d45fce127271d3f544aa27021112e0db66557b30291375b"
    },
    {
      "id": "bipa4.u08.l06",
      "sha256": "948c673a13b6eaec97f65351fe4c67a0847d5c43ac2187136c8f28ab479b855c"
    },
    {
      "id": "bipa4.u08.l07",
      "sha256": "738ac3e3a7d12cc9cd6d1af31e82876b5796be87110fd340dcf6940571ba8800"
    },
    {
      "id": "bipa4.u08.l08",
      "sha256": "c6c79bf0efd8dc1c5c610827df2d3958f74c3ad909a19e83693bed447451849f"
    },
    {
      "id": "bipa4.u08.l09",
      "sha256": "acb427de4218739e32883c5252e5c32c4bde80e7d51b085b611f27ad2aea83e9"
    },
    {
      "id": "bipa4.u08.l10",
      "sha256": "8cddb05c362d5761849cf7f1a669c4e93efa4b39cc10f6650ce2e006c091b2b8"
    },
    {
      "id": "bipa4.u08.l11",
      "sha256": "9c7e535f168817c35d20a6fa82e43719240a85c42e16947edbb4179f4ab3048c"
    },
    {
      "id": "bipa4.u08.l12",
      "sha256": "ee19fc6a5dd85fa6448eb034cf99146d539be1e07bb7694dfe2f4c8f1e511034"
    },
    {
      "id": "bipa4.u08.l13",
      "sha256": "68993f008fd5ee750e95d603ad62bb4d108c91d8618c7363dd033bb8504f0139"
    }
  ],
  "audio": [
    {
      "key": "0091c9b94cba85f3c74221d4ec50ec7681bb5d8bc62cdf36d350e7f5dcd2931e",
      "text": "Tetangganya iri pada kalung itu.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0129fd0934f9f67b9c0af984f263c87a8013afa9a3c376316aaf4e2d41352892",
      "text": "Kalau aku jadi nelayan itu, aku nggak bakal cerita ke siapa pun.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "0191c2a8561d2234fdc6276a965387bc52a42d766d295fe987a9b39b9dcc3332",
      "text": "Raja sakti dalam kisah ajaib itu terkena kutukan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "01bcf7298397e18b4b92dbe7fc52a75620a4ea3d130a5f0cce03521b09b31ec7",
      "text": "Ksatria itu menyamar menjadi pedagang.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "030ae6433484b777f082aada9c03ad103640e75bf4d4b32b50e368096cd037ec",
      "text": "Nelayan tua itu menjadi kaya. Tetapi suatu malam, dia menceritakan rahasia itu kepada tetangganya.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "0577f10e4e664f77a456dbff9df31e9648a1bb2b3849d0041f8a68caa3a5b76d",
      "text": "Dahulu kala, seorang janda tinggal dengan anak yatimnya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "05c9dd77a3aac10528b1ce896590eabbe0884eb2e1c09a80ff3e4fc17f47f75b",
      "text": "Entah ke mana kalung mutiara itu hilang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "065321bdc23157ff8edbc87a529c1dee211b458bca1c9c34edc262f035c1278f",
      "text": "bodoh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "07479e83f65218a3295ed0c4fb27178436446c78852796a7049dd6fbab188ee0",
      "text": "nasihat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "08716bfaa822ae26ddd7fd9050b054d13723f3938da7190b7980591f9c22bc6d",
      "text": "mengalami",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "088214944358826e7df93a20cd1e814cf2399d30a43b4a51b5d5621972d60b99",
      "text": "Putri itu sudah harus pulang sebelum malam.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "08b7e0e899a3620ca70e7428408b271027e18a5c318e339c0973cf403e7be9b8",
      "text": "Ha ha! Amanatnya: jangan cepat percaya cerita orang.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "09714999181ecc16a6fe69c0268df19305d6391fdebab372e7326c08eb820607",
      "text": "Suatu malam, dia menceritakan rahasia itu kepada tetangganya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a0ef8390f290beab42750dffe7a9d0fa959fdabce3f10611566130cd4f79e3a",
      "text": "Tentang seorang janda miskin dan anak yatimnya. Dia hanya punya kalung mutiara.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cd660fade671283d2c05596494d7d65d262e4423abaae0bf24b57507044eab1",
      "text": "Ada penjaga jahat. Jadi dia menyamar menjadi pedagang dan memakai topeng.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dc2805f068fa88e957239389895c1006adabf14554e60321d5ffe1ebf1610ef",
      "text": "Gajah itu besar, tapi kelinci lebih cerdik.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ecf88fb51989b2a2dd5613ed13eb04d26cf4b82a5c7ba9f75f3c79a5af8488b",
      "text": "Mau! Tentang apa?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "100cf38faf98abade0d989374a8eaa3480258e76e81c5b5b5f0fd8e7c31a7bc8",
      "text": "Anak itu tinggal sendirian di hutan, entah berapa tahun.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "103c8c39fd7430025357379656ca883d80d1cd4039c91f782ea31911972c2110",
      "text": "Kancil. Wataknya licik, tetapi dia pintar.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "11aa31c2c056cc9ac563f0d1cdb26db73fb72edba08457a870d7d6196cb91a2a",
      "text": "Mereka sombong. Latarnya sebuah sungai besar di tengah hutan.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "11df1506be3deabb63d4d754eee502e228f48ea5b886c88c331daab5d37ff80d",
      "text": "rumah kayu tua milik kepala desa itu",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1359bf5f1e1f0b90ca5e328869d7607580a9b1d96da457d169f3d41a1c7c2c73",
      "text": "Akhirnya mereka berdua menuntun keledai itu, dan semua orang menertawakan mereka!",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "1509a37edcf067cf38986a7054788975f9b3cb7a5f62b5880b3124499e290dec",
      "text": "sakti",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1535593e44c9dff22d1720caeca73f055b7ba685ca976b6457ee0a1d27fef02b",
      "text": "Seorang nelayan tua tinggal di pinggir pantai dengan perahu kecilnya.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b3fa745fad0645d2431e39e9a5fc387b4bfced6755f6720e1bfbbae2c97271",
      "text": "Suka! Kancil itu licik banget. Dia bilang raja minta dia menghitung buaya.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "169f5c2655558e214eeb1a7ece88c5c767636492d6784a0b9e60260c938ecc5b",
      "text": "mutiara",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "17e73fd1d0a7147de4712463e1e9fc6af1873864ee9ef2c793c0839d3df642dd",
      "text": "Banyak! Ada kelinci yang menipu gajah dan rusa.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1944e33871cd30cd5c719cedacf14fcce8c80c6fab179ef379e9ca05a630c7c8",
      "text": "Ha ha! Jadi amanatnya, kita nggak bisa bikin semua orang senang.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "199211d9342f7539a3104f64f1db0c2b5496aa6348d1b87b7be8c03832e8f563",
      "text": "Lumimuut, seorang perempuan yang lahir dari sebuah batu besar.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a37e111db91b78d3c5b4025d4d39845ac927cbf7e5b575d960cce9e1accf76c",
      "text": "licik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b95f5b9afcd63905302c1d4679ffda5ff2cf89cc64f64d84314e3e83395224b",
      "text": "rahasia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bbb6dee6f8fc17f43e671088419a68e7a52da3701b08e1852a40b6ba8f0de10",
      "text": "Iya, tapi nelayan itu nggak boleh melanggar janjinya. Kalau melanggar, kutukan bakal datang.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "1beaa2f3d441c4c7e35b1bc50886b42711fe92f1919d5addc96287c088e813b2",
      "text": "Menurut cerita, anak itu ___ menjadi raja.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d5e11137f13a6ec77bd9bbe29f2e556f494fa7a8387987f7557be04ae67b265",
      "text": "peri",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e7edf013d14e5719f9168ff721064c0d0c16b52f670f5383cd832feb92a24fb",
      "text": "Terus buaya-buaya itu percaya karena mereka sombong.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e8417ccece1bdfdddc8dfb71368edfbeeea4ab1c2f0916be4e5997466048652",
      "text": "Dia malah jatuh miskin karena berpikir dia paling pintar.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "21af48436bb32e533d27faf21b47da5b6ea677e8230efd552aaac24a2bcb8a3f",
      "text": "Iya! Orang-orang bilang dia gila. Tapi naganya tampak sedih, jadi dia diam saja.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "23d2b738f39b0f819418bd80ca3328a30d101ea855ea4e3ae09999cc5b8e6d38",
      "text": "Ksatria itu memakai topeng supaya tidak dikenal.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "255ab0737f75d94c4626ef78651207c9ea9edf8ef8f03cc1d6ed56783d8ed94f",
      "text": "Peri memberinya ramuan dari bunga hutan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "257ee3d3d3f99689fc428d502693286c9796e65a3b9c7b1d505b46533a5d6cda",
      "text": "Watak buaya itu sombong, tetapi kancil lebih licik.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "268e92f2fb9c8e839175715780972dabc0412d44b6d9b3ee049ed9816d504447",
      "text": "Cerita terakhir: seorang ksatria mencari permata di puncak gunung.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "27a885605f5b21e299d7b87b0b210347cfb9758edf98cf13c5b0f31b0268208d",
      "text": "Kok dia nggak langsung naik?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bbfee8eac199a3b12255ac8e71d3b0596b272c26a33d1966bc1c3f6f7327bb4",
      "text": "Keesokan harinya, semua emasnya hilang. Nelayan itu sangat menyesal karena dia melanggar janjinya.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ce54e0a3dd8a5348909315bad6fdaf49f021946bca07d8936216eb9f705219b",
      "text": "Wah, kisahnya ajaib banget!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d0e9d5cb59dbf0daad65fd02a91f33818414a674a6f1a0e9a614c70a837c488",
      "text": "Menurut ramalan, raja akan punya anak yang pintar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dfe9ca964011f626b2deeb0a1c5c7a9c651ac64bda4474ef1fda8d8663360ad",
      "text": "Iya. Tapi dia pantas mendapat itu, karena dia melanggar janjinya.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fa9f931ce69018531fd0e7752d28c041719a15c5293bbdb28c38536a45ab2ef",
      "text": "Kelinci itu menipu gajah dengan cerita bohong.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "301c3c02c3e19044676dc24914bda91372e8b55c4f791a295cb21c630e3e6471",
      "text": "Mohamed, kira-kira apa yang terjadi pada nelayan tua itu?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "30aebb3f3ab75cdfb442867fad7a3a292a939c20ef587d218d923e86d03d6c12",
      "text": "Ya. Menurut legenda, Lumimuut dan anaknya, Toar, adalah nenek moyang orang Minahasa.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "3343336c5dc81663634ebfc796641633214563ca453286b470b0d0a0ddb09e28",
      "text": "Ha ha, ternyata dia tidak bodoh. Dia tidak benci pada naga itu.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "353b8149aa002683aa322e6b23ce8d6b7287bd077f298d543c32c32795508660",
      "text": "Gimana cerita kancil tadi? Kamu suka?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "355ef1a3b4a6d5a8d78f6df56b0a751ee5008482edd914ce5be1a1c100a2a7f0",
      "text": "Iya. Tapi pas harimau datang ke desa, dia jual kalungnya buat nolong semua orang. Itu pengorbanan besar.",
      "voice": "id_ardi",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "393a88e4cf0eb7eae5b6e4c864912bf23593af7faba370bc8cfd9a027e7066ce",
      "text": "Di cerita Opa Jemmy, siapa yang menjaga pohon ajaib itu?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a63da40aa6bcc2eba633a9cbe9db7828ddcf207a4be0c42eca6d74cb57dc3d5",
      "text": "Iya. Dia bilang ada ramalan: gajah ditakdirkan kalah dari kelinci. Gajahnya takut terus lari!",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d18b19bd7159e03791512c2a24e4e63eef2a4f9a8de8164a45dbfdef49f7c9d",
      "text": "tampak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dd29bcb6bca2f4f768f2ca5fa54aabd83f9b9a7f8b1e0e2d205124d61773298",
      "text": "Pada zaman dahulu, hiduplah seorang nelayan miskin di sebuah desa kecil di pinggir pantai.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e79da9e3379f1da77692b11ccc0ecdbf9167fbece19333b69710ef701a7aa3a",
      "text": "Malin Kundang malu karena ibunya miskin. Akhirnya dia menyesal.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e7b87e98be031f9a60a8cdd9a46d425b36aabea7c1f860af156a7e39f2fb588",
      "text": "watak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f2fdf97bcb46fac842d12a93489cc3dc6c13aeae0a8ae6590eea69262ae5a8a",
      "text": "mantra",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fb7078bcb51f58eabb12b8e09df4a3995205f92f2fc75a6adb47b5d8ddae44b",
      "text": "Tokoh utama cerita ini adalah seekor kancil kecil yang licik.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "42334ed99ea0467ce9111f918149a37f4f233fdd0341d4fb9fb1b32dbb7741fa",
      "text": "Kancil tinggal sendirian di tepi sungai.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "437f04ebce9394301eaf8dc30b727e07586535a8558ad2b5f984b50f668aa8a0",
      "text": "Juha dan anaknya pergi ke pasar dengan seekor keledai.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "43cd985e7c3568cb25e4dd3424f0cd4fa1fee9b3fe8204d7757de4d89419723c",
      "text": "Ya, sebuah perahu kecil milik ayahnya.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "443f7da7b456d85410788ffd2d12c4284fa740b6aa9e957134d94806a651328b",
      "text": "Amanat kisah ini adalah jangan sombong kepada orang lain.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f178e2af1fa9f41e7fe62b3565fe040f54c0618b420e200557c334606f3997",
      "text": "Kancil melompat dari punggung ke punggung.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f8208f2720e2561b69d0d1a81ab64c543bf37312331f45d074c7bbc107010b",
      "text": "Penari itu memakai topeng merah.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4515426c86fe3b5a6f4b104746cb9bc96c79634522b9c68da4859aa5a18311d3",
      "text": "Dalam alur cerita, ___ biasanya datang sebelum penyelesaian.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "45f7fca2737be4d2b7854d5ab061eddeec8a385f0c076ba1c5fb2a07ec26ab7e",
      "text": "pengorbanan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "46cbc008bfe27f85820b57a49460f3c057d105a456b96052d5a96cb7ce4e7dea",
      "text": "Ha-ha, itu kan cuma kata-kata! Menyimpan rahasia itu berat.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "46e4fb8e272119e1b30216a98f3bd4538728e2f27e63d497fa03fba3af8ab21a",
      "text": "permata",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "48319b20d2450865b63620083e8113cf5dc1fc0bf2ed1f3a939acce97b7a7383",
      "text": "tokoh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "488df6f1c4aaeb45c50da9dab36e8f31074c3dc12f6066a3ba29b30ebdf036d5",
      "text": "Terus?",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "48bba6f0bbf7716c478d5da2a02836e0c494f061b3b10b042ff44efa04c2a4f6",
      "text": "Hormatilah orang tua, supaya kita tidak menyesal nanti.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4919706be487cf7f964e4e13641a4d4525b5f8f9237c426f4152b7ac711b6cbf",
      "text": "Konflik dimulai ketika Malin Kundang malu pada ibunya yang miskin.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c39d9983b7d7e6b022e407c8ce0f4a2d0e8b30e9bb2bd4eb0068cf8697fd313",
      "text": "harimau",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d8c917b9b9eb8ee22ca709493afa505b96d576d744596e2071d6c254ec26bee",
      "text": "Kancil yang licik itu menertawakan buaya-buaya yang sombong.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f355924003c18fa7bc978a37f0ac893474d471b94305a10197f5658363c6d42",
      "text": "rusa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f77f1f82750a736666ae9eb64a8971991132148446ba713c876c3aec0e7c965",
      "text": "Kalian tahu legenda Toar dan Lumimuut?",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "500009dc61d8ed9ca6c16436f2213ec6391e8f5785de00b467f09c46c85e01b6",
      "text": "Kalung mutiara itu hadiah dari suaminya.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5090c3a9efbb32110afc1b434a37c9f53fe0005d63a6725bc6b4e1699804c2b4",
      "text": "Pada zaman dahulu, hiduplah seorang putri cantik dari negeri itu.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "50f6852aba87533581152bfec90f72b198b10ec9125987e6420bcd1f4c187555",
      "text": "Amanat cerita ini adalah jangan durhaka kepada orang tua.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "55b3607d1b5e9ed41161067694309970e9a8f1a5d9cb70210412609b03ccbecf",
      "text": "ramalan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "56222144e0cb82f4a6b356f81bedff71577fde9d2c31893815660a25c99371b3",
      "text": "Itu adalah ___ seorang ibu untuk anaknya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "57114a117856aa2bb274d9babb85feb9bae36861c9eaf1a7cda664280f72e5af",
      "text": "Orang-orang bilang pemuda itu gila, tapi dia sebenarnya pintar.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5861253c98cfc1f2a3111f7a915ab6c0d8b7a99a9ba63057cc69b673a3277fcd",
      "text": "Anjing itu menjaga rumah petani setiap malam.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "59548f588daa1a93920e0c62e8cc230b16720b675d013596507f3387e1c2454a",
      "text": "menyesal",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "599cd4a55bfe07be501b240e5b7d427678310b7651541e94b0be0250e7f50d86",
      "text": "setia",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5acacab37370f53a32bbc66e3a7eccdaec97c4e96418ff31cb9fd0b24db1eb10",
      "text": "Ikan ajaib itu berkata, 'Aku akan memberimu emas, tetapi jangan ceritakan rahasia ini kepada siapa pun.'",
      "voice": "id_gadis",
      "chars": 114,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b287d4eab9ef1f564fa9662d10fc740594ec617197068a06b276c7626764d21",
      "text": "Juha naik keledai, anaknya jalan kaki. Orang-orang bilang Juha nggak sayang sama anaknya.",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bb8b2cc4153103e5a649acb0550c4348a4a5cf461a0fa3661f61b540da8871c",
      "text": "Seekor elang membawa permata ke puncak gunung.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c63f70aa60fe52a1ea9db4ce38bbc7fad709ffc8b46df8bd893d71f64ebf82d",
      "text": "Saya kira dia jadi kaya karena ikan ajaib itu.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e6cbe3f5577145f06c570eff48f75c821d892f13c15c978b897f7371392e831",
      "text": "melanggar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eaff1c17025ac09bf3a4a119c8c95fbc73ca82c02889801016f93406aea0ff9",
      "text": "Seekor naga. Dia muncul setiap malam.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eba2c5790bb89fec4c60f6ce3689bdb548df769c7b26e3581443d99587afdb4",
      "text": "Terus, nelayan tua itu kenapa?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "60cb55c1a3d81353bc2aa5752f7c0f59b749aaf082326179cbf7715b28bf1e4a",
      "text": "malah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "61248a9aa1a052d8e5f95ef9d7533a68ee7f2e69a9081e0bbf75986514f3de51",
      "text": "Malin Kundang malu pada ibunya yang miskin. Dia anak durhaka.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "61bc2c8ad5a43f27363027ae3aa552d8792ac3a127690a1800779e87da4d5ad2",
      "text": "Bener juga. Amanatnya, jangan melanggar janji.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "61f5116aa5cfdb3faab3a0a2b4ccd13e1e64bef9402852d662150a4c4bf3589f",
      "text": "Penipu itu menjual berlian palsu.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "639c4668840dd73d16e2d2379b08e211602380dd6e94b1b96194901996c043bb",
      "text": "suatu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "63e29987f91c95867071f204a6e1079dadea904821c20489880d64b6b63f7942",
      "text": "Pemuda pemberani itu ___ mendapat hadiah dari raja.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "66dfb6c78123755db96845d1db06ee0d8bb4ae39da015fa085fcdf0a69a9b12e",
      "text": "kalung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "67239e0f25b564582efc537bd48569a41338c04c922b45fa847107ad4a4e21e9",
      "text": "Bener banget! Kamu udah kayak guru.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "67f7025e7efe88956d13cb9bfba50d6a0de16eb8e91f6d570d9f2b3924eb909e",
      "text": "Terus, siapa pemuda pemberani di cerita itu?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "67ff19fd753070c18589fff2a690969fabc8d379d9f438fdfd19b7c00fcb74de",
      "text": "seorang nelayan tua dari desa itu",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6839e7b7f66dfbfea76beb51132640687b90bd0f053aaa3902bfcf292837aee5",
      "text": "penipu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b607908074e14a43a0297905d18633209f4bc0649b50800cf7613d946f73b6d",
      "text": "kelinci",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c227b51047eb1826efe75e095a7e7a940c0e62022ae9bc62402f34b2f13f180",
      "text": "ajaib",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d70180e4549bac80ac83e8e82f5e06e1eb6f40fc8e7df0900e0c60b7624cab6",
      "text": "Kisah ini ajaib sekali.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dbb7b68f8bfc71d101282d9783d62323ae9a300ea1c720ad466761860a29d95",
      "text": "Tokoh utama cerita ini seekor kancil yang licik.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e02144cebfeff8ba3d775ed8baa33b8167b5ca862e8036df049e643a63d6ff8",
      "text": "Suatu hari, nelayan itu menangkap ikan ajaib.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6eaaf35c83893442e8b3fc68cd576de3f031df6798d65146bf62207fbe7860ef",
      "text": "Semua orang menertawakan Juha, tetapi dia masih tersenyum.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "73a8fb9611d6a3ba33bd1abf674d7cf0c7d3bc74b72ffaec86393ca799637753",
      "text": "Pada zaman dahulu, seekor kancil yang licik ingin menyeberangi sebuah sungai besar. Tetapi di sungai itu hidup banyak buaya yang lapar.",
      "voice": "id_gadis",
      "chars": 135,
      "mime": "audio/mpeg"
    },
    {
      "key": "74dd4a75812580c76ce84bf78c2c85b356eadf4da441400115db1c5d0599b855",
      "text": "sendirian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "75db5afdb1398581835a10d4d0abf53b526d54bc9107f55da6c332227e8e6d59",
      "text": "Seorang peri memberinya ramuan dan mantra. Dia menjadi elang dan terbang!",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "75f947f87827161ec3ec21f002900a3a8b13f8ac1a95d363c71ff8a5c88e9b0e",
      "text": "Mau dengar sebuah dongeng? Pada zaman dahulu, hiduplah seorang nelayan tua di pinggir pantai.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "77c065e6ab419ae837625eeef06d1ab4aaf575907d23e8106a3daeed36e8bac8",
      "text": "Putri itu tidak boleh melanggar janjinya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7880882b91554c1c37b5bf54ca626ae32709afb2b756d036ddbeee28e6e3102a",
      "text": "Kamu udah baca kisah Malin Kundang? Konfliknya apa?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "78f65e5c0d3a9306e1cd1a14f64ad104bc4a68c5663984e98fcd23f703d4cf2e",
      "text": "Kasihan. Dia mengalami banyak kesulitan, ya?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "79eb18a1fdb21802f376fabea2dad3bd21923407c98530afdac137111b59190c",
      "text": "gajah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a178d8f9cb55052890571011954fd3ef72a124124280998653969aaf2a2b549",
      "text": "Raja itu tampak marah, tapi dia diam saja.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ad89b37c821977f556a7257ad5d1f31485c85568b4eabf016f68331f86a858d",
      "text": "milik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b88c32457db40b0d9ad7518cc14ea3d9eeafe961af3a19e93f41e99a05ea74d",
      "text": "ditakdirkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "81e2707ba712376ea0f470720e27161dcd5286102da8d51ca8561a0b3286550d",
      "text": "pemberani",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "830646d00bfd453c1e8ef376b18758a45683245d589762a2c7a5be1c4b5a4122",
      "text": "diam",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8426b7668890977d4818a0c10286ebaff5ce4b52e42b1dfa37f495152566ed80",
      "text": "Aku akan memberimu emas, tetapi jangan ceritakan rahasia ini kepada siapa pun.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "8496847613870b31ad7ad7d59ce7e197141af006ff17b3fbbec7a5082232dd3a",
      "text": "Pada zaman dahulu, hiduplah seorang lelaki lucu bernama Juha.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "85f7c3c4f287156db8f9f1f7a2b3647e6beb6746eb37d854731ffbd1638c4001",
      "text": "kepala desa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8611be926b253bab77b194be3c77c88eba4bfa0b7492ece836ef59ecbf3284ef",
      "text": "Terus, amanatnya apa?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "890662bc63c4eb1d347136c89c3147c0d303d443ffcdcbeea69ec9df715f061b",
      "text": "Belum, Opa. Siapa tokoh utamanya?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "891563ec2198e7a4ac4e56450a9d0c5ae48ba819a9b4278bfe18055e2f27e8c1",
      "text": "berpikir / pikir",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cf6cd7fa7c681c43eeb83f984d75161c0b8b972475203f1472f5582feb44de4",
      "text": "menipu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d2a332ddda81bdda0da4e7a6d7e3395518eb1bcd5ad1cc52b706793b46e8b11",
      "text": "Iya. Dia melanggar janjinya ke ikan ajaib.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dccb40b6a3f5433f4b156b8a99167bb8f07ea541b6185baf092d38c80334590",
      "text": "benci",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "921893e7ba89761be13e4df9137886c102423dba07b1ec0ea55deac4c2191492",
      "text": "topeng",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "942f891b1d668d5c4b1e5fd6d02d842d70d5b29d96624b7beb1724b16c48db7b",
      "text": "Terus?",
      "voice": "id_ardi",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9561130ff8691195ddf91213b6225eacaf965160f004c43986adb4d2f203e83b",
      "text": "Wah, ikan itu sakti banget!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "96a3e842f57c0bd45003714b3cadba3d84e69d7ca6579a9dfb08ad150d259449",
      "text": "pantas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "96b7cc762ff1b681d4280483cad8cbcd6cb893a52e69f073aa9c0f93f1c67328",
      "text": "janda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9716ef3a76e11307ee6d97817aaed55e51093a4d9a0b6ce1e7894f332ee1b4cd",
      "text": "Rumah kayu tua milik kepala desa itu terbakar.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "98621f73117800d85db432a668e41e1955bcf592a691e43f69d9337e093405cd",
      "text": "menyamar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9878182e7e4732a0fd18c85299215e7ab4c8baaa120d0541620ad093ff2b526e",
      "text": "Dia disuruh belajar, tapi dia ___ tidur.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "98b3e302721771845bd554117a668c01018320479a6bc659075060f7ae8034a4",
      "text": "Buaya-buaya yang sombong itu percaya. Kancil melompat dari punggung ke punggung, lalu tertawa di seberang sungai.",
      "voice": "id_gadis",
      "chars": 113,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aba497e165d37417652a2503aaf85cbb5118d8aa35e0d5b4a0ac478a7231b4c",
      "text": "Pikiran saya penuh dengan cerita Opa Jemmy.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cf2388043989150c056b6bb38d8263a047ba979993cc0de76612201f8b31f98",
      "text": "Raja itu sangat sakti.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a25daa0714567dc127254f091be6b005d804a3d796e907127f90b80f323c50c1",
      "text": "Dengan mantra dan ramuan, ksatria itu menyamar menjadi elang.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a27a3cf391fa0d9301b8f9c87e1a52c9688c792b9da3af39744c12f1c519245b",
      "text": "menjaga / jaga",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ad48cf8bcbd181d969ad679d586f86194c8711c8d02afc5b07793ffb393240",
      "text": "Kelinci itu penipu?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f01cf2ab5931bea3e2633dffa0e57d8d324bc513836d50fab7bcc6d0ce8587",
      "text": "Buaya itu sombong, tetapi kancil lebih licik.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "a898adad183b91c4a198467854acce6b4188a0315dd8540506c84504c7e0a458",
      "text": "Dia punya perahu nggak?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a989326a57434e6947ac73679bba620a7cc69b6f0c01f16204857a91b4b5d0aa",
      "text": "Terus? Ada yang iri?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9a26a5668db2c498d4699a73e28f3602be979990feb0748236373aeada74c6a",
      "text": "Penyihir membaca ___, lalu pangeran menjadi katak.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa570801a4399dd3f3ad2cb8f76ccb35b91b3f23e23d2d38b57085f4c9a9f26d",
      "text": "pinggir",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "aba3b56e232bd141684741f1f048bc73371a313462b50db9149bf0298f17193b",
      "text": "elang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0ad387da20d54a39d843a7f1abb11f9d9bab891c61ded993a13b5719d9d9e70",
      "text": "Jadi amanatnya, jangan sombong biar orang nggak bisa bohongin kamu.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2aa8d5aaccb269e2d0b04c584f6bef1860cf9a3fb7d5b48026ea125fa9010c7",
      "text": "Terus gimana dia sampai ke puncak?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6a218c9fdce66a4ddcbab8bde2006e11512c7008d0f046c538c54f963620964",
      "text": "kira",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6bcee10c49a992e4528f2cbdca5743923a39f7b37e3d7b7fd2e91d4c59a83ea",
      "text": "Pemuda itu melanggar janjinya, lalu kutukan itu datang.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "baaf8721de282d8d77514f397ac12556143b61e22c38f10759c5922c6efb2ad6",
      "text": "Keesokan harinya, semua emasnya hilang.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb2862bd238b5a92f7eaa37e7a7ae98b4cfb58781ee34c37ff0e7650373eadbd",
      "text": "Waktu ditanya, anak itu ___ saja. Dia takut.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcfc06670655dc643b5dc5b0c2eea087f0c725ab6d466fe5662487131f4e0713",
      "text": "miskin",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf37fd73bf5e6806136496327a3355e1c2249a5af3aab4d7c491177500a99a3a",
      "text": "Pemuda pemberani itu menolong nelayan tua yang sakit.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfcbebb7bf5ca110c2fa12405eea519d285691a441ea92561a4d76fc1e0e01e7",
      "text": "Latar cerita ini adalah sebuah sungai besar di tengah hutan pada zaman dahulu.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "bff74158abebed5fc10eb743585c082cb4f6527e5c7673e587f0500089cf9133",
      "text": "Nelayan itu sangat menyesal.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1c01f38973363165c631a118d9ef2db44caacfb96966347452e131ee7bf4dbf",
      "text": "Juha dan anaknya menuntun keledai tua mereka ke pasar.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1c15357bdb845cce8cd7309e6e83ba247696a17fd2c952016a83ad7d9094e14",
      "text": "Ceritain, dong!",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2446a4615336b09305315eb72b3c51350d7dc9e4d6eea6b0b39bc2f8c772a15",
      "text": "ksatria",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4f91db7236c2820130acf28b1cdb8e2db4794989102cee032b5f0b529eb3867",
      "text": "membunuh / bunuh",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7af601bfa286871195f35749d5cfb769f9bf4f84efc00945bb6a92b6d5297fe",
      "text": "Di Mesir ada cerita terkenal tentang Juha dan keledainya.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca9910e16799819832e788daa6dd602cd6f3312099c6d3ac64b5a17b7d2cc0cb",
      "text": "Hati-hati, ada penipu di pasar!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb13f485b48b3ce80f68c9e4ed223c18d36c74152a820b3bd7537a5e25c00cd3",
      "text": "Pemuda itu sudah harus pulang sebelum malam.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb1deec64b746c3fb6682aed74d60f6e320211b2591badfa36757c13ae4a0634",
      "text": "Dia bilang raja nyuruh dia ngitung buaya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb2cf80bc01509d55c24b86dfe8b17717577ea509910c8ade63e492d9550e006",
      "text": "Penyihir itu benci pada sang putri.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdb22702628d1f6677e65eb33b16a9b74a14b8951b66bb82ea8974ae999aa63e",
      "text": "yatim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdbc6e55f6a9571e3871842cadd6bb5abc31574a512e7b8f9441b56d3cdda29e",
      "text": "Siapa tokoh utama dalam cerita Kancil dan Buaya?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf80f96c603697e6b488142553b9862b6cf88191a678c99abe7255cc77d5ce5e",
      "text": "Kalau buaya-buaya itu gimana?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "d085db16fadea9d81ac97fefda70b947b5f9802d293706eab5540c64ba19f57d",
      "text": "Mohamed, mau dengar cerita rakyat dari Bone?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d22200fd06f9e2a4be6118f14848e1cd4d6c70dad3a7424fed09c0df5a76c831",
      "text": "Mas, di Mesir ada cerita Juha. Di sini ada cerita hewan yang cerdik nggak?",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "d30de59a9e134699f8eecb8db150b3c207d1e46f89697cf1a9bedbaef36ff616",
      "text": "Pemuda itu melanggar janjinya dan terkena kutukan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d36a4c34918004e4f8029bbf2945724444a7863b822484785d3cb126863ff453",
      "text": "Malin Kundang menyesal, tetapi sudah terlambat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3fdd3f6536de4f9aebbbac2561c8974381375f7ef12f3549325cb9b61a54396",
      "text": "Ibunya selalu memberi nasihat yang baik.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4f3d6e6eef36c7eb767bbeaa8fc12d3c43d590aa34a5bb8c392b2cbed428925",
      "text": "berlian",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d98f3a9d3fb57e3dbb7a2d479ce139b02ba61d63f7efab256cc6060c4d75fd06",
      "text": "Dia menangkap seekor ikan ajaib. Ikan itu bisa berbicara!",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "de0b4f9589da30e2846307fb695eb54d3e3e6dedfcaf70b8d779b96899ecfd55",
      "text": "Terus, pemuda bodoh itu mau membunuh naganya?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "df4fe2c91ee7e90c91e044f0ea607f7746cdd14ad8f281962cd1809e52369647",
      "text": "Saya kira nelayan itu akan kaya.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "dff8b8b94f1748c52190daf155b48554ba1a9ee0d330fe7d06514f173b5f312f",
      "text": "Mas, akhir cerita nelayan itu sedih banget.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1788207c7aaa3b0ee98bf2299a1e620e8abb7049a23284867295542ec61e458",
      "text": "durhaka",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1c361f9ea49a8be843f9c30a58b12e691fe28ba82df7267b80b138f642ba2c4",
      "text": "muncul",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e532c9f688f85b062ee7e0d3ed97281a1f0bca8599852ce0ffef1a8621fa0a3f",
      "text": "Kelinci itu menipu gajah, tapi ramalan tidak bisa ditipu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e62e814bdd4328b8ad2a0c10f37b33d04757ec2de4fc53439a9c2c64718f9315",
      "text": "entah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e67b4ddca0f5c92241c799b38834b2f51cff0f5144239f796af0b11f51d2d12d",
      "text": "Janda itu memberi nasihat kepada anak yatimnya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e999016abbe2dc16a5784dd54a87d7913219ca0838c69216db5542cbd9478529",
      "text": "Salah! Dia malah tinggal sendirian di gua.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9afb33843ef34b0be7ddffcd28a7cf218f166664b207e03d7b79fbb420f54a6",
      "text": "Dia hanya punya satu kalung mutiara.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb569b1dfc98580ee0571514d7bfecbc984f44dd2eb73e0305d4cd03bd638c7b",
      "text": "ramuan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed3bdac015871114d074b99b008500d0cf8e471cd2d76b85815680103397facf",
      "text": "Kancil berkata, 'Raja menyuruh saya menghitung kalian. Berdirilah satu per satu sampai ke seberang!'",
      "voice": "id_gadis",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee5d8d9d2259e8384e56e5982161ec6c36fd00a0c35b823a7b1709b9e645e99c",
      "text": "kutukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f09c2873082975cf68a368e6356e8166696d05b9a9cd70e71bbf0e855f2b359d",
      "text": "Seorang lelaki tua menuntun keledainya ke pasar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f28bd6cf2a870c0ddef7f3555a79d9ad6d2bc346f165ef5fda71dc53bffa2649",
      "text": "iri",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3e5cea06b66e882b167ed1881892cbdfcd81c2c7ea736e426f69488dcaa4eab",
      "text": "gila",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f51d6c74088b4951a80d9c2a8bc1735e3385e70491af13cc14d89b8cc1b9ae9a",
      "text": "Pemuda itu tampak sedih sekali.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5c8370209912ad3534e6231da072a7ebc1b02afce0cf143ff7ccc95e59c115b",
      "text": "Tiba-tiba seekor harimau muncul dari hutan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "f63dca73a9da8590884884e2002f5cca038c31c06375bbb29a42d2a006a013cb",
      "text": "pikiran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fddc0dc3a4ebd3b4cbbe542722f9fc39bc484bae8e5631e9850b5be3534393db",
      "text": "malu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff1878dde3811dbc9a4ef8b15b8fda8fcc98813a93b41ce000ed18d4e73ba738",
      "text": "Malin Kundang adalah seorang anak laki-laki miskin dari sebuah desa nelayan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    }
  ],
