    },
    {
      "id": "bipa5.u05.l03",
      "sha256": "283ba63ca3c341c374414c046dc64b2312d66d88b137231d527907f52262a212"
    },
    {
      "id": "bipa5.u05.l04",
      "sha256": "28ce2143d2e7dcd7be15a9b126d72962640b5b79e73f8286bdc31d12ede42432"
    },
    {
      "id": "bipa5.u05.l05",
      "sha256": "fd1dbe6febc36cb6ea2e2faf344e651d406d2e5bc4c6190c79e8e86d1ba5ac67"
    },
    {
      "id": "bipa5.u05.l06",
      "sha256": "0b14999546c8a5535d60626e7bf51a25a7b3631c6b23f9a56a8316dbaa95d828"
    },
    {
      "id": "bipa5.u05.l07",
      "sha256": "8c6b59a5174c8e8235c2d3741dd509076dd55ae3069f99587c57d5e80f961e22"
    },
    {
      "id": "bipa5.u05.l08",
      "sha256": "d47d4f08c556e909e357aba9994915c60dc16139b87442cb48c86d25f5b4b9fb"
    },
    {
      "id": "bipa5.u05.l09",
      "sha256": "45b878525240e9ba969b48a3c3c631c2f5d1d17abd918b5343af3fa5650910a7"
    },
    {
      "id": "bipa5.u05.l10",
      "sha256": "77052d0834326c4693a3628b271c4af32eed1a1d5ad5233a93ff1664168aceac"
    },
    {
      "id": "bipa5.u05.l11",
      "sha256": "d3bf6513eb4d8d2be8920946ac62a590358858b80e119d5ffdb81c256a15a9b0"
    },
    {
      "id": "bipa5.u05.l12",
      "sha256": "453e0019fdc8db0976330b7d7b0b1dee5fb9d624f1f018e6565bbbe18b587cb8"
    },
    {
      "id": "bipa5.u05.l13",
      "sha256": "6fc08f5c968beed9acb0dc867ce11574aca60ee3e41b07513ef5703b8201f430"
    }
  ],
  "audio": [
    {
      "key": "000ac71cce20f0f7ac1d7f732bb0f6a0e1d6bdfd0ddc5c81a42ea7bf78c8e790",
      "text": "Menurutku, petani sama hutan sama-sama harus dilindungi.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0010ba3419003ce36dc945f8df492e44342e4d1c43fadf7b711425ffc4fcb85c",
      "text": "Tanpa hutan adat, banyak hewan bisa punah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0199bc428c2bae0d636e6e13f2f6972939f59ca1fb1f3c9695542bca0d4a501d",
      "text": "Api di permukaan sudah padam, tetapi bara masih menyala di bawah tanah.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "02550839ef07033cfa8d970495f8a06e3c7dd398f6330ca769290ae222012d67",
      "text": "Pada musim kemarau, lahan gambut mudah terbakar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "029d6d180571cd826298d0e2948df5f75aeb43737a2f803ea4c1bc192fd2c2db",
      "text": "Kalau hutan habis, macan dahan bisa musnah.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a933d777dccce4225a601cb7ea76483b1d107bbc315be12a45a3fc07fb12f5c",
      "text": "hutan adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a9a3dccd31681c3f613a4d3a901884907be6d8f8e1914cb81ad73718ff0eb5b",
      "text": "kearifan lokal",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bf8a4785d364e92a052f3543fb0a410a3baa1c81d827dedbaad1f92242ec76f",
      "text": "Desa itu kebanjiran dua kali tahun ini.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cbcbc08c899fcd705b6efee9b9282d8584ebb678b993b794a0cd10d0b27e945",
      "text": "Tentu. Di bagian akhir, tulis solusimu dengan jelas dan sopan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e478f07aed8cea1f283509dd002ecbd324c247f6ba14a6b14e1d709df07bc34",
      "text": "Dalam persidangan, kepala adat memberi kesaksian tentang tanah nenek moyang.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eba4c48c180c38b0ea644deed26972d9cabfe877116b8e1c505c9f6fd71186e",
      "text": "Terus soal sawit?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "108cef1a6db86144f91b221e9d617ce1ed1a0715a202733dddd7a1476f8005f4",
      "text": "Baik. Saya akan menulis bahwa hutan adat perlu dilindungi bersama.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "10f363a7faaddcc51687166153d194a77539d4e5462e731b00c8106609cfdc7c",
      "text": "Petani menanam benih padi setelah hujan pertama.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "110a7e71a5478534c5273618f379a623e381198d25b48279682d8a5b4baf692a",
      "text": "Menurut catatan saya, sebagian besar lahan gambut di sini pernah terbakar.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "122cd5ecb3e944e7726dc846b08f9cbd523cf83511648b6236e4916f81b059b1",
      "text": "Tetua adat memutuskan kapan warga boleh berladang di bukit itu.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1453886f746d4d17d52c6d948bc842298ab7961210a4dd77152ea85b1a2b60c1",
      "text": "sebagian besar",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "14e32488fdc047a3ad63e515e0abcd1e3b4f5dd6d898fb01a8583caec3ea2af9",
      "text": "limbah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "17412b1eb255a626633d6892fe43c285e59aed6fcc98835463cbfb55339a7c9e",
      "text": "kemarau",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "179b1bfedeac39fc9892b3cff1288169dc3b4cff4fc344bc7b7a3490c55219c3",
      "text": "Kebun sawit. Dulu di sini hutan hujan, lho.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "19483781f637c9eaf8d045cb6a5f160c3f9fe0e528dcc91a929fb304462c4e0c",
      "text": "Hutan rawa ini lebat dan sangat lembab.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bf361f27f422339438c747702c9a734f7707ee9a2aa150f84c594f966e22db5",
      "text": "musibah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d4b1e886948af0f2ab8376306ef58403c7cc9a12d07ab7718573ee363da9ad8",
      "text": "Kalau hutan terbakar, orangutan kehilangan rumahnya.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2414af51bb414cd70b3e6ce93ed7e321e320fa82b5c716b3341e2d6df9922ca7",
      "text": "subur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "245c4d8302ad118c19819a4afe71fc69aefaa6d0ddcb76d80a2f0cbaebbc1d1b",
      "text": "berladang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2470f83dde1c56e99dac1b8cba143182ec0c7bcaf3a2ac2a8f959e950e8a1052",
      "text": "Ini kebun keluarga saya di hulu sungai. Tanahnya subur sekali.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2479555d1fb7d2452cec69949de6c452aa434109c2f76c09f762c2cd205a95ad",
      "text": "Macan dahan bisa musnah kalau hutannya terbakar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "25a0dc1ddcdda12b64a71d05562c8521f4ce4f33a6b930e665951a5bcc11c7a8",
      "text": "Hari ini ada persidangan gugatan warga Dayak lawan perusahaan kayu.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "283adb4ea416939732be07eea64468a1461db20baf5a3c8e34e18e45f16793b8",
      "text": "Klotok kami berhenti karena sungainya dangkal.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "28fdf17a3cd3bc8779c53a9fa790753c30a79aee33b92e79f720b013953779ad",
      "text": "Ada dua hal yang penting: hutan dan penghasilan petani.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "29799c6ab2d2ebaa6c07f0973724fc44e9e0e7c89d4c6c4e313588b3abc98f17",
      "text": "Tapi tahun lalu di sini kebanjiran, kan?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "29904035772b30d00f59986b7f613809d0d12050362ac9ed376147eaec8bf2af",
      "text": "penghasilan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a521aefa7e1e69c784a6a0c90289ecd03941b5239d4e3e066ef1b969706dd27",
      "text": "Wah, pohon di sini kok sama semua. Ini kebun apa, Mas?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a552bf0485eec1c659be252b9077ea6cc237a7db3710b4bb6dd5ae425b9e3e7",
      "text": "penolakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b9fe3d43050b8dd45bfc384d7b87cc447ff5662a511c2f368e172a9bfc0d3e4",
      "text": "Jadi harapan masih ada.",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c521b68408bfeada0c3752046e224790ea5ae4d0672cf1faa7098eb247a53b6",
      "text": "Ini cukup serius, tetapi masyarakat adat dan taman nasional membantu melestarikannya.",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dfcb509687cf76877b6647b80f6925257f0ff2a512eb8e18d6ca41630c7e6ba",
      "text": "gugatan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f5dc36c4d8257ec684fa7137d4f35a44a4e668e9ed2e3d1f7a0bfdc13f4d555",
      "text": "perluasan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f92878e9ecd92616988ecdc1fc2a4cfcbb69c903bfa90c28ce0af7dea163b89",
      "text": "Mohamed, menurutmu yang bener siapa, petani atau aktivis?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "30e9e45bca574844612c20e4ce028c8f824e720c28c10cca9ee7c0e96d28a85b",
      "text": "kunjungan lapangan",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "35f128037784a22228d6222d06f02c55a4040796e985f2413d600401739645e4",
      "text": "Setiap pihak punya sudut pandang sendiri.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3751ac644247dc25a046210add11ea8080d7cdc930091d88b11ef14157097ff8",
      "text": "membuka lahan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "38b9e711600491c2b82d699c0483c22de1140bdebe750f1fb30960df2a9f5218",
      "text": "Kabut asap menyebabkan sekolah-sekolah ditutup.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bd0a93620eedfec0232e31747761a68d2095405223b58ad3c76d86a0086eb25",
      "text": "Ya. Kalau katak hilang, ular dan burung kehilangan mangsa. Semuanya berhubungan.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c2a200bc227fa74e4a9b74b8f65e784afa80bf243b13b5f1209778fda430cff",
      "text": "Pembakaran hutan menyebabkan kabut asap yang tebal.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c3d4c101d33f3a4f3e61ccfdf5f04fe994bf777433012afc8b8962d9cebf89c",
      "text": "sudut pandang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c83a20e9fc820814ed8a4e57b9c3d211e98d524e1123ef8dd2def8b522ce1b8",
      "text": "Menurut aktivis, pemerintah seharusnya melindungi hutan adat.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d86f3b88c5de4b9fb64fc5c0f1fd8c78fa91e8487e9bb99aa2fb21ed67c0830",
      "text": "Menurut para aktivis, perusahaan seharusnya melindungi hutan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dc534fc21959ac853c556f0c33a8a152892935091ce2b023a7f5e5ddcec3b83",
      "text": "seharusnya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f30f404681b809bb0d0f41ba8bd6bc7e162724469779b919c753001c26c37e0",
      "text": "putusan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "402a630fb22d3c69c56b89a41613d8b946b5f8107f90baa6e6271c3f6abde3b6",
      "text": "pembela",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "40b7d681c8cc55d0786aa775bc463a0553ce27a99604cf33de017475a8e331a0",
      "text": "buas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4118bd7c1397d1c4d022a7eb248ac3cb45de75232f98d7349d2b0b22fb14d9ab",
      "text": "masyarakat adat",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "413034f6e64d4e9efcbf9d46f89eaef5546894df1a28ed20dc6f0f75b2663051",
      "text": "Warga menyatakan ___ terhadap rencana tambang di tanah adat.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4251041da608d4764fca23810f93d0c898093e1b10f8a79bf0dd05fae5d0ea93",
      "text": "Seekor ___ mencuri pisang dari perahu kami!",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "42bf7dca09a6dddedbf48342f87129ed26203bef19428738f37913e093786323",
      "text": "dangkal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "449b73547ec82dac7b735e82a7c93d35a876d63c805aa63e708e4633a49a9a06",
      "text": "Kunjungan lapangan kami ditutup dengan diskusi bersama tetua adat.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "44bd7a8aa2527004b7d75d1e72850d1974ce8f76ec30db9e19f255203ea2c15d",
      "text": "Kalau putusannya penolakan, gimana?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "45105a438820a1d9454e7dc4cd7a0855de786bbcdbb0c070bc1d0a855d83536b",
      "text": "Selamat datang di rumah panjang kami. Dua puluh keluarga tinggal di sini.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "45b669029c555d6c42608f7b129718d7a9d372c915306c58e33c156fcc696541",
      "text": "Iya. Musim kemarau ini panjang banget, jadi lahan gambut mudah terbakar.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "484dfa5dc03bcd2e9a629a6359d28e7ef3198979b366985f7e10e54c987a78fc",
      "text": "Dari sudut pandang saya, kedua pihak ada benarnya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d0ce321f3c46ee0b0e1e296a2e2cea036acfef906fe798fcda316fbf95d0dc5",
      "text": "Boleh saya bawa benih sayur dari kebun ini?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4db6aa0d71eb9b4549ecaea57eeaf094dd38d0a7a653cab0555821a9650998cb",
      "text": "lembab",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f688670900b1436092e084f4c283bbaccd8d0fdcb7b1e6529385c0238bcb8ee",
      "text": "Ibu pakai pupuk kimia?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f9d0418280e79bcff7af785e63d465b471f4a794ca4876893af00f0f8800ece",
      "text": "gangguan pernapasan",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ee4312a00d1fc9711647056970646065f17b03e97c6b2f65d913cf6fd670ca",
      "text": "Perusahaan seharusnya membayar petani dengan adil.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "5146d07508f59c4440593d6639ebef2b6c7b029244477ead4440ec7d08a7fb07",
      "text": "Warga desa mengajukan gugatan terhadap perusahaan itu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "529e65b80d5782e4f5bdbaebde16af236a7c211498f68a0f836dcc6a13e0f5b5",
      "text": "Kayaknya ada yang buka lahan di seberang sungai. Itu dilarang, tapi masih aja terjadi.",
      "voice": "id_ardi",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "541538bd7dad720b5a13961fa651fc6a8f4235ee4267ba55fada3850c2369120",
      "text": "Hutan rawa ini lebat, lembab, dan penuh nyamuk.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5464f8f69db95788b809c9fbc5a9bbcfc5ee9f5375fe098ac779133d2952d422",
      "text": "Makanya warga bikin sekat kanal. Gambut yang basah nggak gampang terbakar.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ce0a20fa700aaf7e888a97110717c2405350f8270f707622901175cb140931",
      "text": "Hutan hujan Kalimantan terancam oleh kebakaran.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d072118ea5c72a2b2df8a42e75599d75b4f0389adfe1d34dbb2c3affd58a68d",
      "text": "Jika tidak dilindungi, spesies ini akan ___.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "61cc781405ff828a5d609f46f38c52fbd8e8d6f63fffd2ddfc160b3fc37cf402",
      "text": "Nah, itu dia. Makanya masalah ini rumit. Ada fakta, ada opini, ada kehidupan orang juga.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "62e2039f10a32348085c3c25ff8d1746af7c77056f4f3b01e346bc67b54e8f8d",
      "text": "Sayang banget. Tapi banyak petani hidup dari sawit, kan?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "655ba5ed135153eb04045ce1d65d6707c9308d479a1a78a825fc01943b26656b",
      "text": "Setuju. Dua-duanya ada benernya, jadi solusinya harus adil.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "655e2dda585361a47f2b8fce377dc2ae1ffa1b9a3be3840a110c474d16793334",
      "text": "hulu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "66702c7a2ad8db10dd9f125f7c0aac6fc4e7cadd2e1227d32a52e39557e08fda",
      "text": "lebat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "669f28db395644ce3ac873a476357b1f0f082ff6697ada9e7baa56bfec8ac6e4",
      "text": "Putusan hakim: perusahaan menerima sanksi.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "68a70106ccc7bcd6075ad67ad7f71e98881b49e32bfe700ba6142596406dd88c",
      "text": "Limbah pupuk mengalir ke sungai dan membunuh katak.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "68ad6733d66c9233378e1e4b5d5bac58beb3f00cab86c72e23599c9f15362be3",
      "text": "benih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6903033cd3bd45e6b11d0918130b30247b5484349efe59a129b84a02fa5529c1",
      "text": "karbon",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b7c41ff2ca7af0e24aaa4acf33a12eb0c87b59a62191668db65692916361745",
      "text": "Orangutan kehilangan rumahnya karena hutan terbakar.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bb5c5eb52c546d9c1042ed51bb71dc989b39bdc36188d7146078dfc52cb97ae",
      "text": "Dalam kunjungan lapangan ke Camp Leakey, kami melihat tujuh orangutan.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccb3f770cf31b7522f87999af5b37d4ded80d8060dd8602868484d571e4418b",
      "text": "Esaimu sudah menimbang dua pendapat. Bagus.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9f2a062be590a8002657839311cf2ac7a1725980b647f57a9877d791849bb1",
      "text": "Limbah pupuk membunuh katak di sungai.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "74f5e9d5c6682187e851d0632c56422547832eda3fc98d941ed87310038bfe10",
      "text": "Dikit aja, Mas. Kebun sawit sebelah pakai banyak, terus limbahnya masuk ke sungai.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "756b42da27fed46211da49b45d17295041d52e9e25d5a3b3c52ee419ad6985a7",
      "text": "terbakar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "75fe0d8108103b106a675e806327adc7c5f424a09fd43d143210f6dbebe82256",
      "text": "Warga desa mengajukan gugatan terhadap perusahaan sawit.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "780342f3df8ce40349e83d62864639db5abc0485856671af8e2ec69a655f4364",
      "text": "produsen",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "786745e6a39ae0a4037e8a43a3422092349348d38ec71a378c2f813e9b2fefd8",
      "text": "pembakaran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7878a14e978e5db49d4467632af030c4e8610597ea891e1bdd4ab442c554e790",
      "text": "rumah panjang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "788dacbead684554339fad0fa2c474d7900f8d8b9cdc3b7f2db5a6b085ac66ca",
      "text": "Kalau kebun ditutup, petani kehilangan penghasilan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c4bd2c1691a092da3b86a39dd374f29789883754e1310cc07e38d9565ec1988",
      "text": "Pengakuan atas hutan nenek moyang mereka. Pembelanya bawa kesaksian dari tiga kepala adat.",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cfaf3ee4f487c3dc03ac9e0fbef8cca610f6747f8fa11ffdb2d5b943819bbda",
      "text": "Dari sudut pandang petani, sawit adalah sumber penghasilan utama.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dc5fba5f66fc9c5b665d3cc10a8d5013d75021a5ab09df0320585ece6a0d7bd",
      "text": "Apakah orangutannya masih terancam?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7edf1f6abd25e48a7e6ca73c048216730d6f3faf8629e3b031d3735e40e05319",
      "text": "kadal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "82e31f2cf8d3bf63dc3ea13d9a657753fba09fbda1dd2059034cf4d8b91e092f",
      "text": "Ada buaya di sungai, tapi tenang aja. Yang paling nakal malah kera!",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "842c633ed73336b10e64df607a1d2b6c9b75d105e59c6754a97bb51ee93fb25b",
      "text": "Iya. Ini musibah buat manusia sama hewan. Orangutan sama macan dahan bisa musnah.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "85048353ce0d06c7962db4463bee2491a2504c998fb737b8e4958c844361a607",
      "text": "Mas Rizal, kok langitnya abu-abu? Ada hutan yang terbakar, ya?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "860b51b2afa00325290db200ade2f61054dc082bd81177a56c16ed8dc1834404",
      "text": "kabut asap",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "86a21a790e5e8914aa5724d3f234196e6f7e5291064e3c7cdd113e73b78247ac",
      "text": "Dulu banyak keluarga tinggal bersama di rumah panjang.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "86e70c0eb423aa34eade17b73769a13e0b3585e73eb5caf70cfb655838610c4d",
      "text": "kebanjiran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8710899aa6863f1a48615e8c99bdc502ea680f0296364a874ee08a245fffa195",
      "text": "Kasihan anak-anak di desa. Kabut asap bisa nyebabin gangguan pernapasan.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "87c3a93bf0f29a1114059d1f6057296f1ee1c54cc105e5c41d0ac1c7059c5121",
      "text": "hak ulayat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "887d1ef7735b15a6a20566478f09d23c708c6c68508fe3ade58cd15b3df89215",
      "text": "Tuntutan mereka apa?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "89d7e9874814347faa117223276fc423f6ddb3a0b9fc0e94c70bcf02498db980",
      "text": "Putusan hakim keluar setelah tiga bulan persidangan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8aef13bc6712296acc7465fc48e0d57752c0396ee7dd4eac628a88ee6577cfee",
      "text": "Gawat, apinya belum padam!",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb97b94469daee4fef296f4811e1172b03c031b2d9efc09de1956b583cd42ea",
      "text": "Luar biasa, Pak. Apakah Bapak tetua adat di kampung ini?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cf2e1d4a7dd485b392c4bfc53bd5ba9091b61a41905fce2cef72ca8112e2a25",
      "text": "Di hutan lebat itu ada binatang buas nggak?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e928281fbab4ac1650cbf92fd55f07c415b582b020703b3d63ad86515b991ae",
      "text": "Kedua pihak harus mencari solusi bersama.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f26a77ccd59549189fc89d741f49ed697f8c187737845a7278ec4be23681af9",
      "text": "lahan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "928ff7594b7e8d516898ded5ceceb5e4fbcc0b29b83ec7e12372d02f50c9134b",
      "text": "Setelah menimbang kedua pendapat, penulis berpendapat bahwa hutan adat harus dilindungi.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "95394195d8d50b0181d07aae6960dc1c6cbba4aee63e8cd52c0927aa0c472f82",
      "text": "menimbang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "958fc84bc267ea538228cd11286568eb04127362611cacc756001e90b1a1d10c",
      "text": "Perusahaan itu membuka lahan baru untuk kebun sawit.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "95e245e948063570eedaf6c44cb0aa8400a04c382c13a1e22f9a75e94dbbca7d",
      "text": "Setelah menimbang kedua pendapat, saya berpendapat bahwa kita butuh jalan tengah.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "9668b708bc28616a352157b09eed67fa5ec330a3cac487c92d7cf7d09cef6678",
      "text": "bersama",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "97d06afd0038e65c281979cfb56e3c51f6a5ea5eb3cb151d6870191cdb9e539d",
      "text": "punah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "97e3ccf3a357ba1694e9492972501da87279b82578c86d913540bb48c97bc5ae",
      "text": "Lahan gambut kering pada musim kemarau.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9972515f4bae2da84af731c036dab7ac0ad678e7305f77c2a0e0093135c8df8b",
      "text": "Situasinya cukup serius, tetapi masyarakat adat membantu melestarikan hutan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "99cdf210c8f74084e34b03441c21c83dfaf5e45ebc5a70f4f5a1b344bd79b741",
      "text": "jalan tengah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b9864bd8313df80fabc33ac919423da7c6b16f7d447da7038e9bd72b0cec6fe",
      "text": "Saat matahari terbenam, ribuan kelelawar terbang di atas sungai.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "9de47b7c438814eff26f1c1f4c9925d7eef5b26bbc590237cf024cc17295400d",
      "text": "atmosfer",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a06242ec5628ee8edf65832ff5d76c939f61727f5f2263109e54fa3b2c213450",
      "text": "Masyarakat adat ingin melestarikan hutan mereka.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a075e6057497154515f60d2c4191819d70ca0a8c98be6df0ef25613e6c2d63f7",
      "text": "Ya. Kami berladang di bukit, tetapi hutan keramat tidak boleh disentuh. Itu kearifan lokal kami.",
      "voice": "id_ardi",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "a17734ad75836623c39467c074ea39c2ae6e26640489bfda1808f180b3325e4d",
      "text": "Gawat. Api gambut susah dipadamin soalnya baranya di bawah tanah.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2478e11b1f32bec94ed5db96b0a3ca4571940e9dba306cdf32e8e6b9f56dcf1",
      "text": "Malem ini kita tidur di atas klotok aja. Sungainya terlalu dangkal buat lanjut.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "a26d28d05b084dd0dab4fb176b241469ab1cba02730b5b0bd0c75a38bb6eead2",
      "text": "sawit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3411123dc235e4aacb3241d7039408c581d039a90d3b6280ae54520ba9d457d",
      "text": "Kami memperjuangkan hak ulayat kami. Tanah ini warisan nenek moyang.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "a862e2611931920876853ed6cb872213ef6c45c90a34d93fddef7fbd8f5c1563",
      "text": "Persidangan ditunda sampai minggu depan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab8c2a5f294258f0ea0117004c5c1a63b183771661eb5e239ceb52bccb96287a",
      "text": "rawa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad487e83fe7f824341ee8fcd63f82186ce4979c7d7a227224c17eefb4195c729",
      "text": "Tapi dari sudut pandang aktivis, hutan nggak bisa diganti.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b02edbb56381be1d0603f01c511fcbd06762bb8de8d1f9fa3f51f72c795c6edc",
      "text": "gambut",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1c062c94aeb42b7211a0f85c866579594f42df0209f33b5cc1a6bff3d968ef4",
      "text": "musnah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c7b73d90ff99486b88f6b0788700a57313b59582ea8c77c3eb28885b1729d9",
      "text": "katak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b40821ebcc4161c1144402675b016653f006409be645c5b0de80f96349bab7fd",
      "text": "Gimana, Mohamed? Yang paling kamu inget dari Tanjung Puting apa?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "b616fa4a5020202f8f9965aa00019990cd9080991edecec6830a62cd16616b2f",
      "text": "moyang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b727f8328870ff983f768594f7a7bb6badf774b06cfb9169b7961291ddae88b1",
      "text": "Buat petani, sawit itu penghasilan. Bener juga, sih.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7b612b39261b1b0d68fe9b44c007f2b4e9c1f3701e9f11582558b76575a3681",
      "text": "Bagaimana kunjungan lapangan Anda ke Tanjung Puting, Pak Mohamed?",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7d656eafdbb1481539384e84507bdb85e859f08aefaf2c53ce9c005ff1e94f4",
      "text": "Udaranya lembab banget. Nyamuknya juga banyak!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b868267381d97823254cf7dcc97c31187e01f56f097ecf6b5f185d410d98f06a",
      "text": "persidangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9c8d169ae3924aee2b51990bd9ec646e9a9a84a214d804556fab6589fdd977d",
      "text": "Pakai obat nyamuk, ya. Di rawa banyak sekali.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba607e99dae0243cedd5fd9bb784a8561e157d05dee28c0edf97a3851bb8c410",
      "text": "Mas, kok rame banget di depan pengadilan?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb19bd91c253ab0309c33d5bce3635f920ccd59b6c1c75b13e262e883960da41",
      "text": "kesaksian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc4ff4b3efabdaaa1ed5252cce7749763fe0016cc278c820dfaf6d93b0414b89",
      "text": "Masyarakat adat Dayak menjaga hutan adat mereka.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd89dc1d66928b5fa86f6a9bb23ef61a4295d46fbdd0a2559be04cd41860cecc",
      "text": "Tanah di hulu sungai sangat subur.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfb9bc712e8d17ca06faade51a7789c8f653507fc1607d47b140d939e55727d9",
      "text": "sanksi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd693ac8e34473685848a72474c315de1d740f1ab6f824d6b38850cbfc468c5",
      "text": "Kadal kecil itu menunggu mangsanya.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0be4a831773bcd9dd58e29457a80d9ac72f4b8ae7b8521c7ded9e0d81363559",
      "text": "padam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c109e0916b7edb2a9053f6aafc7ff1822828ac88e13105132fe26fa79444d1e8",
      "text": "Iya. Katanya lahan gambut terbakar lagi. Sekolah-sekolah pada tutup.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ee3e693fb138000d73bcc379c6c2d70a9b951f270a92b26bc18e9b3db3b2a2",
      "text": "Pada tahun 2015, kabut asap dari Kalimantan sampai ke Singapura dan Malaysia.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4ff23b3ca35a97d9c0216f4d5561060a42a94c1af7ca551937672a4c8d74126",
      "text": "Apakah mereka akan punah, Pak?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7bce45ea62b9f45a19a621290a609f771f8bdd2884e247a0a198399a5e7c52c",
      "text": "Sebagian besar orangutan hidup di Kalimantan, tetapi jumlahnya terus turun.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "c944f0f9f2066d93215b8dbe5efa95dc3102c72e196735b13483cbddbfeba31d",
      "text": "Perluasan kebun sawit harus dibatasi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f5d1767e5e49238c9dda424f6ad1b6821bb3a3c49e888f136adf6f52774970",
      "text": "hal",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca1cf8e31425df7c893ff9200592b1e559b242da6b3a8316486d0e74608553fe",
      "text": "Sangat menarik, Bu. Saya mencatat banyak hal. Sebagian lahan gambut di sana pernah terbakar.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca85d6d1f560edcef6e9a0e251b5e3bc429d0dfc4e7bcb0766b05df27b622cbc",
      "text": "Selamat datang di Camp Leakey. Di sini orangutan yatim dirawat sampai bisa kembali ke hutan.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "caafe68832c1df80de1dac935d26cc878f572488fb55df8a0e338533276322c1",
      "text": "Hakim membacakan ___: perusahaan harus membayar ganti rugi.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "caebcd7a2ed5aaec8507d52452a9eefacb294700643822c34f865584b8a33f93",
      "text": "Menurut saya, pemerintah seharusnya melindungi hutan dan petani.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdf49916a3058ccb66b816fc038aeb3670c7bbd84e1a3d91385948ac146e02e7",
      "text": "macan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfcac95633f457af8383b76e1b381cacd8cc121a16a24a4930d5a156d02878f3",
      "text": "Kadal kecil itu menunggu mangsanya di bawah daun.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d529430b9d3ad7545ffb4e39184b3076bce6dcb1b2abbd51e08c0b68f4082ae7",
      "text": "Burung elang terbang tinggi mencari ___.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5677372d339824c4edeacbabd00c2b86b790d86b8c1fce2361f46cd88e5efa2",
      "text": "kelelawar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d65130c61eb1bed2b05bcc457c4078574507173da9d23436d476e07caaec6362",
      "text": "Gawat! Asapnya masuk ke sekolah.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6a9cb8116582e31e2bb6e78147aa70513c7a632f187a95eb1a0f9b3d69988d2",
      "text": "Penulis berpendapat bahwa solusinya harus melibatkan masyarakat adat.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8c819f74ec1bce288c89421a9b2d58574cc6e074f57423a7572ab83b0796f69",
      "text": "Terus asapnya bawa banyak karbon ke atmosfer, kan?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d91d3ebf02c67a25f6a66ee10a9d1e110ed7b3db3dfb094ff86f82a8710e1984",
      "text": "Mas, udaranya bau asap. Ada pembakaran lagi, ya?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd96f0453aa4b5228976a024c85174e3c85b748923877f96f08d7ef95fcb47f9",
      "text": "mangsa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dddd2a604a27b0b39c827ef108268e12d8f8472abef12fd9c2270dc2a8aeb052",
      "text": "Mohamed, penerbanganmu ke Palangka Raya dibatalin? Gara-gara kabut asap?",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "dea5200de59b054df1f46327d47a76c698fe8fc32b161b25888db649aa9fe183",
      "text": "Mereka bakal banding. Tapi kalau menang, perusahaannya bisa kena sanksi.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "e195334204c6828a82a388440cdd67cec84fbe4621e014277cac17b6f94d055f",
      "text": "Pantesan saya jarang denger katak di sini.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1e74748673d02098310c3e14f3d27f30ed9dc0695744e795d5387aa98a235c6",
      "text": "gawat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2546497c1d8372ae4f1220e8a21eda6dc704ae831bfb073c4abbedee9aab300",
      "text": "nyamuk",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e481705f94fa5f956dd8e8c8d78fb97b19ec238bd9d2b433799877b28205051e",
      "text": "Orangutan muda yang dirawat di Camp Leakey. Mereka terancam, tapi masih ada harapan.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5342ab44e64fce56f0d001204c224aac4306b0d5dacafc021b1fff03111f0af",
      "text": "Hak ulayat masyarakat adat harus dihormati.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e672809acf27f4e0c2c1e7a6c841837e112afe6fff8a4652bb75cde24d9dec7a",
      "text": "Ya, tetapi warga membangun sekat kanal, dan tetua adat melarang pembakaran.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9d283bcdbf8db6a9b469caa0d5abb5ddba62acde9969b11f50fc4e8490c88bf",
      "text": "bara",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea43965b716a5b80d0aa838d014e276f40547236d55322398855ad91c2f0cd41",
      "text": "pupuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed20344c6281ad3133c25b9feaa81321240c20173195baaa49e2332423ec5ae0",
      "text": "Gawat! Limbah pabrik masuk ke rawa dan banyak katak mati.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0010df05938ecd3a3d21bd4cdce2f2efa5567330ff749cf6c1265638e8a63cd",
      "text": "Sekat kanal membuat lahan gambut tetap basah.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f10b27ba138563572f9507b5439c06dd838a24fdaf2ad427e7dfb9a27dff2c8c",
      "text": "Itu biasa di rawa. Lihat ke atas, deh: ribuan kelelawar keluar dari hutan.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4c43ecdcb783fef4616f4313de20a901a909c15656f363f053595bbb3f72871",
      "text": "Tetapi saya ragu, Bu. Apakah saya boleh berpendapat sendiri?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7ec6d2bb670239828b22297a56abac150b3b0f25ccb124a950e1d844733e11a",
      "text": "tetua adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb091cb71643e3e916e6bfcb19765026f7d147a8e7983a74a8c2de7ec7d5699a",
      "text": "Gambut yang terbakar melepaskan banyak karbon ke atmosfer.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc3155952a4b4c934a4e47db51d75649aa0fba33c4ce2586e00203cecdd23d28",
      "text": "Lalu bagaimana dengan perusahaan sawit di dekat sini?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc7947d3f858ffc0724c6aa21060e41439f33b71aaa8847ff34cffffb5a5af72",
      "text": "Bener. Banjir sama api, dua-duanya bikin warga kehilangan banyak barang.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd87a9c63ee9b8d37784ad17b07539650e20b6530d71a21192d44569d857692f",
      "text": "Bagus. Tolong tulis laporan dari catatan Anda sebelum hari Jumat.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe6f8ea418514d96b4f576ad65e9842697f7c999a04db9ee5a23ddec0a9a8bad",
      "text": "Petani butuh penghasilan, dan hutan butuh perlindungan. Kita butuh jalan tengah.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7b4b468c01ca5d27389dbfbdc3040696ef764d12cd3e6ee727821e8822d906",
      "text": "sekat kanal",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff088c08613a01eb543f0b8bb5257acfe5e70ba87662d1c70113e2f34fbab1dc",
      "text": "kera",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffcb12398d6c686effd730300e549a82534e56376cf8fdcf18dcd3af31424e27",
      "text": "Tetua adat menjelaskan kearifan lokal kepada anak-anak muda.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
