{
  "format": 1,
  "id": "id/bipa3.u02",
  "language": "id",
  "unit": "bipa3.u02",
  "version": 7,
  "content_hash": "7761fdefe1473e3f05e6cca25792f72a83ecb19f0f497020e32f02d0678c5e95",
  "lessons": [
    {
      "id": "bipa3.u02.l01",
      "sha256": "3f878f4281a2f3f2d40c62766eecacb7c43212f9989463641d44897b519f9d63"
    },
    {
      "id": "bipa3.u02.l02",
      "sha256": "dcb4a5b2778e48ce298fd3513b1ffe0319791c71904b8fc15b65645ad340821c"
    },
    {
      "id": "bipa3.u02.l03",
      "sha256": "9b8ef4b308673fe0e05288f7cd72f6d0cab28dcf2b3f70836657977928b7f546"
    },
    {
      "id": "bipa3.u02.l04",
      "sha256": "20dcecd7a92587115076bae1ad660fb13b4301fde32dfcb53604694d35a78009"
    },
    {
      "id": "bipa3.u02.l05",
      "sha256": "799e0a642b0f084017d0dda0bf2effa7eaa153844efd6e0043672cf65b3c7a48"
    },
    {
      "id": "bipa3.u02.l06",
      "sha256": "7805834b30ca927f19f7a4a4a209c56766efef16d819c3c024b39bda3de15220"
    },
    {
      "id": "bipa3.u02.l07",
      "sha256": "f446fbdca4f23e2c0a3a4401c915174271bc55a8986efb864ec3d9a38caa75cb"
    },
    {
      "id": "bipa3.u02.l08",
      "sha256": "1a6657df5bbfb7c01f4f8924e2e2bb5877791e9bb01ac3bbe1fa3715c029bc1b"
    },
    {
      "id": "bipa3.u02.l09",
      "sha256": "d58474587c0df016af7af55cfe2dcce713941aa185bab31d8139ac6c4928a006"
    },
    {
      "id": "bipa3.u02.l10",
      "sha256": "f5eb6b4a432996b58ea2b6606f4c413eb8dec1bc29ea97e587718e11e38f26f8"
    }
  ],
  "audio": [
    {
      "key": "030f72e2c749b3cbb012e48abeddbab48297d9e8d5919bb392ccad97b88df10f",
      "text": "Selamat datang di tempat perlindungan penyu!",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "05d52b9e0a3c94407350850be667b7925532ebdb758bd10c6be3f0caaf1020f1",
      "text": "Sampah plastik itu serius, padahal banyak orang tidak peduli.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "09799db7b2d77c71ee61609e4ccb3b7b26b313c705890b6541129a2fe23e9e17",
      "text": "Katanya, di Gili ada denda buat sampah plastik. Gimana pendapatmu, Raka?",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a7e5573713e424f987862fb77c6fef86774c0e41184225b701c8a33f0b06d55",
      "text": "Nggak, makasih. Katanya, sedotan plastik nggak baik buat penyu.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a90ffc0a42a1f888600fc78b40e1d67862616f3a1e29d486fce355a07ab5aa1",
      "text": "Upaya ini untuk generasi muda.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b5ed0c13bd39ec9fb0844c7780f677fc5d2d72ab1b755c9130d59161074c22a",
      "text": "Walaupun capek, para relawan senang.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed755daec83f2af96a856d27020342ec4a9a563bd967bdc71bf575c8d2989d7",
      "text": "Pantainya bersih sekali.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ef6ef64b1746c74f587a54f0a227621e0a90c88cbde47ba010f4b369309456a",
      "text": "Bukannya di laut banyak plastik? Mereka bakal baik-baik aja?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "111b3654ce6ad9a20efde160f40fa4e699809440a87405fcf8bfbecb0cee7aa4",
      "text": "Ni Luh membeli kopi. ___ enak sekali.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "128bd011f47fede628e848865f8ae7b2469bdb1cb4861dca1470d2a8e0d377ac",
      "text": "daur ulang",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "12d7dd8d0abfb0b04f30e58ba16a7f9135d2085fd7602d74bbc0f3821b725d69",
      "text": "Lihat tuh, Mohamed! Ada asap di sana. Orang membakar sampah.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "187ea49f94dcbf0ee3bb19ca893f4ee474df2cb678299663877ee0b0a3ae21cb",
      "text": "Rina datang, Raka pun datang.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b189b82123c268c566f379908a6cc44642f97a92d9a1501758c9e1de57594ca",
      "text": "mengurangi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fefdf83d57f66ccf381985288196a755e114e9ca282f0615e1c2e92769912c5",
      "text": "Betul. Di permukaan laut juga banyak plastik.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "22503de352bf7030a0de34151c665bb54aa072ebfc63e1c9d34bd984f2791cd5",
      "text": "alam",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "27381fbc3d45a468b0ad62f1427a10db606c8a1cbe6f2938a21226d1e76cab8b",
      "text": "Kami mau mempertahankan alam kami untuk generasi berikut.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "27ff4cc7100d7c357fdd1214c88c7054c92f39d20a15b9cda255e4b971def705",
      "text": "pendapat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2857adadc7d7ea1309a8ed1cc65f597483abf6c19689b8c6a771451d0b2ec431",
      "text": "Benarkah para nelayan juga menjaga penyu?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "299b3953d62b5c2d8aac99c1ccf686a8ccd7b4251cdacd41a2e128dacc31988e",
      "text": "menjaga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e60d55f98fd7bca064ff31961747d35c1c988a6682997d312b950ebf72c5542",
      "text": "Siapa yang boleh ikut?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2efff46ce4333c68a9b0f4eb965e788d80595d4484d56d6089852494764cbd63",
      "text": "lingkungan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3352be07d8b42de81c346b4c1158d43e589f65cac273ac91853161aeba3c053a",
      "text": "padahal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34615719144ada3d9b54eee207e5d76002c1ce30aecd9dccb952cd71ff14ba38",
      "text": "Di sana ada terumbu karang. Kadang-kadang ada penyu juga.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "34c5bd8d4a0f5c109f6188cb50578837f0b2505d6a89a2b598a7750ff9297248",
      "text": "kurang setuju",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "368370d6b17500213f723b8c62d061a4adc720d5d7b3f612ec074f34447c5b31",
      "text": "Di sini menjual telur penyu itu ilegal.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "36e15043062601e929c10fbc744a2465f6af7cced0a903f3738779b09a0e8033",
      "text": "Ini kegiatan untuk semua orang. ___ boleh ikut.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "375bfaa1aba8c0f46184bfa7d81f5995176ab05ea2572272bb5dfd49ac94549f",
      "text": "Mau pakai kantong plastik, Mas?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "39307218bf3533fd691978e300bf7018766493ce76f7142c530faf5028db2cde",
      "text": "Penyu itu lucu. Saya ingin ___ lagi.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf18f66ab6254740d90e77a71869a5a39b518e9d2d6281f814edf8c75a89180",
      "text": "Jadi, kesimpulannya, kita mengurangi plastik pelan-pelan. Musyawarah untuk mufakat!",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c3d5593a3cd5f865a7619ec86b91f3e504df671b4029c8fd809ba162b9b6608",
      "text": "Jangan membakar sampah di pantai.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cfde5a7e1e5e0f2326993f232178eb2592e979a585676821f6f9ecff7abfe7a",
      "text": "siapa pun",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dd1c2fdc0b093ec921a0462878d03240c1285fb51515a373b63b97f597feefb",
      "text": "ragu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dd2a5198f034637d335225c13fc9a27cdef15e30a48d30f2699f5b012fba94c",
      "text": "Saya masih ragu. Apa sedotan kertas lebih baik?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f9288e01f1bb1b5f1a05665c156b8dea9f2e2aa3d090f7d4ed13bc760936798",
      "text": "Menurut saya, kantong plastik harus dilarang.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "408ba09cd40cb43f6ac3c0a998f7db75672a139cf027e37589a5d4e014d1e75f",
      "text": "Hmm, itu serius. Jadi plastik justru mahal buat alam.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "40f5d3904afdbbfedf18c087aeaa047bb499d9bfed86353c452785c8801038bc",
      "text": "Apakah kamu sudah melihat penyu di Gili?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "41025467e8051734c53b3188f8ba11f9e32be290fe2bd6f650b82a2a6011b916",
      "text": "Buanglah sampah pada tempatnya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4299e618b13c8e160c1f53a6c63e4cc7f9d029932ed019fc67924a9fecdf28ea",
      "text": "Siapa pun boleh ikut kegiatan ini.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d6c08cd423d47b9cbc2b3046fde0f2e8ef27b1138034a078f573bed810bd6a",
      "text": "Bagaimana pendapat Anda, Pak Hamdi?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4580fa4f5f41219caeca42f47bd95bebc2fce11601712d353b5c608bf5705d56",
      "text": "Sebaiknya kita membawa botol minum sendiri.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c9c4308c35a41fcd4f24ae831657d696132815a2f50fda053650ca352db37a7",
      "text": "generasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d14125f781a09e439efc9c147841189b82beba64b32c22b2850915bd723db4b",
      "text": "Bumi adalah planet kita.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d435cc4f43897cc8c2945704aef033a89775ed03c54f33896783f5d3d63589c",
      "text": "serius",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d89848f7fa9a86249eb22f0555f39b68d8ffb31e3489b275106c0626842231f",
      "text": "pandangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ed8b10475898fbcb9386590fbd4e5b5b03e7053b82f08959d6bacec145e6077",
      "text": "Bagaimana pendapat Anda tentang denda itu?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "50135b730bf2c99d03955d82af12f238a0907a4e2f9941636426eab72efdd778",
      "text": "Apakah kamu setuju? — ___ saya setuju!",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e6dadcd5e4f52902b39e572fadf5347c6b0f574157ae4404e64ff17c1ba5a2",
      "text": "Sekelompok anak muda membuka tempat perlindungan penyu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e7b79a117db1784e403929cd3bbe11bda25191227c78c3b437526acf64b598",
      "text": "Saya suka laut, sedangkan Rina suka gunung.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5362f6d07af8b50de5c978550d31bd4cedb9e4ff0f031c5f886afbdbbfe67dd5",
      "text": "mempertahankan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "5478cb711d20094e329bd8cea10f4ae562dab2b8482d8a857bd4c2bc0a4cccf5",
      "text": "Murah sih, padahal sampahnya ada di laut sampai ratusan tahun!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "55fad8f3797b36d7874a5e37d43a1d59b6506a88fb8757d234c20a4ce96410c0",
      "text": "Pandangan kamu jelas sekali.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "5632df06e522ce79ac358a0154c82db0f4891bf6b4e342f24d4f42027c9357cc",
      "text": "Terumbu karang itu indah. Kita harus menjaganya.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "59eaf46f310225228c57bcfb90aca96f2b4e88e6b43923a318d715392b7ae71b",
      "text": "berbahaya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b2f71ed9fd1ca1a0bd3cd2d9472343e8642447eb97b0330db78fa8ff51248c8",
      "text": "penyu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f49493cec3c280aff88c4f22b9de6dfad510bb08765c7fd8271243c7cdefd14",
      "text": "Mas Rizal, tulisan itu artinya apa? \"Buanglah sampah pada tempatnya.\"",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "603ae53ff5b8158ea04bf74d24565be506d86da94d4e1bdab9476558f25f67be",
      "text": "bukankah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "64d26c9954c64eea28ec2664b9fa6342622bda179f293cf564304f319d39ddf8",
      "text": "Penyu perlu ___ dari kita.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "67aff247d548fd91d00c4967ae484dc186950acb26ca60d3c0c83a95658b0b54",
      "text": "Mohamed, Sabtu ini ada kegiatan bersih pantai di Senggigi.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "67b4a5a9352ccc7f95844384549a5a917bd0cd4c1ce56c694a5954c04627aa99",
      "text": "peduli",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6862daa106cf7e2f90e9d6a8da0e0490c74ca76cbec6ac0449ed22f12dddae6c",
      "text": "Sebaiknya kita mengurangi sampah plastik.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "691a3277663cfb32b8f9c9a35145f004e578f191a04062e61b4e50726f503d69",
      "text": "tempat sampah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a119d1fa7d21231203473193f162f73bfc710c2449d2c3ffab9e43d8440a690",
      "text": "sekelompok",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a58f70d4096aeacfd0582d54f9f780206f1a8cf2e524ccc781a433880561182",
      "text": "Saya sependapat dengan Mohamed.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a8684627e92213e0f527a97f62f21c22004e670da6b9d3e59159260f2dffc1e",
      "text": "kegiatan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b0fe8b17fa05c36ceec5d87a7e6a6301b729985f575e31b414ec8cf6736c4c3",
      "text": "permukaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6de2cefccfe7c06f7999977509168d40f6e145e8570ebdbd679f32cce86d1fbe",
      "text": "solusi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "71de45a1ad070c85cd577a9d2547e131f6f2b0c4bc5b031c413635145d02a318",
      "text": "Apa pun pekerjaan kita, kita bisa mengurangi sampah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "7218a7e6659023a993e6c016d5fa17a5ce0cadbdfae15cd198a855a51b247afa",
      "text": "jelas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "72841f330ce3ec309369abe368ca2e027ca1532752329d0755343057f6a19411",
      "text": "sependapat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "734affa6b617a9c69f23599150bfa6d4c3c15b24c0e631ec1a21df4da1f88b88",
      "text": "Ada benarnya. Tapi bukankah plastik berbahaya buat penyu?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "77ab988cba3179e8eab47a783fb7bd147ab334ceb67026ef69fa978d7a9a11a2",
      "text": "Boleh, tapi jangan pegang karangnya, ya. Kita harus menjaga alam.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "7962ab5b68469ea6ff9b4d16767a0d597dbd6e08d1008818fa6533de4d60705a",
      "text": "Upaya komunitas ini sangat bagus.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a79656c17e306fa644b5fc4a02d11bb406716230013bd0e6a2b0ab0726ac0fd",
      "text": "Bagaimana pendapat Anda tentang kantong plastik di pasar?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a9d452c2114aaa9ff19d8af3a2c3ff15d03ac10bd34ca8a408e9dbf2bdfbbfa",
      "text": "rupanya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c5b4970753ae27f0e88d086651c25dcea32640e617bf4cacea0fa7bb22956d0",
      "text": "Aku kurang setuju. Dendanya terlalu berat buat pedagang kecil.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c79c43e021f28aedcfde41f1bee15a89cf2e23f60e4d95226875e04f095a697",
      "text": "Iya. Jual telur penyu juga ilegal, tapi masih ada aja orang yang jual.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d7ef41ba2cb24b16a9f9daf44b9bd5e2a855b39a86ff02e99b48bf3f1900646",
      "text": "Rupanya tas ini dari plastik daur ulang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e18c8130b9642f10d154cc5adb95997f1f9e0058923cf0c0658a473efe105ad",
      "text": "Tas kain ini harganya sepuluh ribu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef8e147d408847d74b62ed6fa73cfc39d26f1d2b3af8e30722a88e48e6450ed",
      "text": "Penyu itu lucu. Saya ingin melihatnya lagi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f569af2627fd89600dbd2b1fef2af96df5224ca86976933f3f0ea80bc45fc8f",
      "text": "kantong plastik",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "803e62ea3898a6752137599c6ad2b962bb64670f9f22f35f7a67ca24889170c0",
      "text": "Pantai ini panjangnya dua kilometer.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "81e0bc258ee310945c933c6b31d6661bad39500935a7c08d159eee971c0d4e8c",
      "text": "Aku masih ragu. Plastik kan murah dan praktis.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "83838d26cef92ed03409148c22a8eff8aee99777e79bcea4b8ad1326057dcd7f",
      "text": "Nah! Jelas, kan?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "83b10883e67b032cb0d82bf29c765032ba88cc20491c92408a962769da5c05c5",
      "text": "Lima ribu. Mau sedotan juga?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "83ba18d02893c9568222160faac5ff00463a9b4cda9225c372e439ca92e929b0",
      "text": "Katanya, di Gili tidak ada mobil.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "84d8722563bc3a084a50077d30d0621e4346af016b7f5016018fbb6ca86c2d1f",
      "text": "Katanya, sedotan plastik dilarang di Gili.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "857d119a61cd31f8fae43991123c551d01ec1b482909466d211f923c9be50935",
      "text": "membuang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8591c80cb102df413f39b91834ef6d4c54603478ee931e617cc3742297169645",
      "text": "___ hujan, saya tidak ikut.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "860e3478226bebee3897d2510b230eb1c68b13197bfa75da460b9c775f5f2579",
      "text": "ilegal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "88a90e92df2264c685ffb7ec68453115dab0e6f398f6fb899c5f97de05be6239",
      "text": "Plastik itu murah, padahal sangat berbahaya.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c32b7302eb911d7d4393458217a4aa5c52562c74dce0ab169235cc3e47697c8",
      "text": "Sebaiknya kita membawa botol minum dari rumah.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c4ed5f4c3067b6039928024721aca07af00d77bcc6b5add543b9b64a68989be",
      "text": "komunitas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d7dd5d0149cded4a6728ce4f5ffcd9fce514a4891df65450631620ef2e5d1f5",
      "text": "Menjual telur penyu itu ilegal.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d932cdb2373d6f7bf86d918540b6cb486116b5c9f42a9b407a305d1cde172b7",
      "text": "sedotan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8df6fede8d0a72978f23944e125318419477676e7f1d9492df5cb6635e1d3d16",
      "text": "mufakat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ee1ffed09592d40ddb16d2e838e194bac9b3c4383646047a1b0ea764b6872ad",
      "text": "planet",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ef1bc71a73e0ed7ab19f57ea00473b69bc622576608d433ad466c9c02ce7508",
      "text": "Katanya, siapa pun boleh ikut kegiatan ini.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f33918846fa39130e86252e069fc36d99a8d9cd9dd87369aa62582e56b44dbc",
      "text": "terumbu karang",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "90254a9183fab21baf9edef93e28675996d22aa29fb403964afed2e94cce53ca",
      "text": "Nggak usah, makasih. Saya bawa tas kain. Berapa, Bu?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9317588c38e3f5126e8d2b571ecc4950f584f57e7753ba34c322fcb837d2bde5",
      "text": "Banyak sampah plastik ada di ___ laut.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "93c7d5ad173fa2c163bfbfb4db012ce382f054065e34d29a073ea684c6a7811a",
      "text": "Di Mesir juga sama. Kita harus menjaga lautan.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "98f1ee55edb5c91469fa00b550bdda44e62cc6e7ec02dcdb91c68822d5502541",
      "text": "liar",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b77e92080b7830082a4eb9d0d860ae3d59539ad6862c8c088074e5509cc5153",
      "text": "Sekelompok anak muda dari desa. Kami semua relawan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9be321789bddf0699ec42fa8d899e41efbd3257c24ca4d5dbfaedbeb39e1461b",
      "text": "Terumbu karangnya indah sekali.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c955ebf3c045480e5dcd78e5f8f31cb1c3ce1c47260f52156554181b2e1ba8b",
      "text": "Inilah tempat penangkaran penyu di Gili Trawangan.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d0ea60cd98a0c22fcf56a575195c434efdb5fa693574535734a78c7b5f076db",
      "text": "Wah, penyunya kecil banget! Umurnya berapa?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d69b0ee2be4dd1a353489b73c3d1c54ab0e8cbb7296b040263cc3b61616d153",
      "text": "Makanya kita harus mengurangi sampah. Siapa pun bisa bantu!",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0da963aafbe0ae205b21c2729ab5bb7e351a1ebc59853ce34e8b0f9a5505155",
      "text": "relawan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0ea70e0814ce2eb2a0f4620b734bc6efd616f922ce3689e23ec245a5bc5da9d",
      "text": "Bukankah banyak turis bawa plastik ke sini?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a20e9f3945abb60fe02a427449fb2e93625832a0d80b7c1d46ee2558e41c238b",
      "text": "apa pun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2628030048a6ac57302e41e25edce185afcb69b3d337113cf6ed6f703641f29",
      "text": "benarkah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2ad0f349778f199d3cb115b068e09705eed5dee24effb2c69a839f4b2ba8b0a",
      "text": "denda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3039b0ee64fa6dc4caccb5a75661581e52c1d13349544d8d8a2c524c3b5fd10",
      "text": "Menurut pandanganku, kantong plastik harus dilarang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4401d2921edd969e9b28603998fb5bf267c23cebe1e5578304c8620b990708a",
      "text": "Menurut pandangan saya, ini sangat serius.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5b9d8d385b3f5834b5a4d0d3f7b4960ff7275f3030fb15aa2e520d111cd6c0e",
      "text": "Saya setuju ___ pendapat Rina.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a62de2738e8ce62807d00e1e8b44bc33eb35444f54c6bd0bdb7894f5bc5daf94",
      "text": "Kita harus mempertahankan alam untuk generasi muda.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a826f16a1a458cc1c6e459602a5118351e8ade380f9252300d061fe9ff18f205",
      "text": "Iya, bersih banget. Nggak ada sampah.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac6390a3c4f19964b2f1f3cf564cbe454ce71f3bebe1964fba19b6b7a259f1d4",
      "text": "Komunitas kami peduli pada hewan liar.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "acf02edf7f4f63b2c9325faf80dea4da77481d84a16d46b78e709b583990eaeb",
      "text": "sebaiknya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "aedf118f515cafb7390f05ce7eac04ee8ebe328eb2e03566b597134b81b5f7b2",
      "text": "Terima kasih. Siapa yang bekerja di sini?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b303d44d6a44a2fbd506b7cc9e5e7cc41216b9299add4630fcfffa7d406e5579",
      "text": "melarang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b46204e8dd10864aaa81e2d9a797a5c6a0abb3a861caf79ec02c3de5cb4f61f5",
      "text": "Jam enam? Walaupun pagi banget, aku mau ikut!",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b55343aa5e583c3a42e34ff018b50a53c19a227aea1f0127e7fc6ae2d499b2e1",
      "text": "Bumi adalah planet yang indah.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6ce39bb4f724e1fbb2403035353606626ef790278ddc56ffc26fd37e1bd0673",
      "text": "Inilah Gili Trawangan. Di sini tidak ada mobil!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c50f6fd6946879ae4e707711701355b7bad28f4ac260d80835f132675d5f9f",
      "text": "sampah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b88cf76a8dcd9289311ec70ed1eac18220b89a711091f0cb94c968e8fcd68dec",
      "text": "katanya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a4030706224345eaef3793c9c087c710b0eafedf3a43d2d421ac056f778b27",
      "text": "justru",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb9cf8dc502f87f2a9ba80f03eb2dea20df0fac098e490041337d2ef891d11ed",
      "text": "Menurutku, sebaiknya kita melarang sedotan sama kantong plastik dulu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc6ad3792e3513203ee23652c5f2848dabe0208b2e57a8149ce431390d908e00",
      "text": "Saya sependapat. Mari kita bermusyawarah sampai mufakat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcde050951f19888dd9923d80181394424d1d5ec12d115d96c051975684bf0b9",
      "text": "kalau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c319bf5494671202a3d80d498258387a40035a54b035e8f949461ad4000f7234",
      "text": "Sekelompok anak muda peduli pada penyu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4c76bfda31d400e3a8100cc03ec73669d7acce29d9cb242bb44999ca3af638c",
      "text": "Musyawarah untuk ___.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c5da9b3e49d6a4aa28f714c6f27bd9ea186936825a759a9988499c607cc244",
      "text": "musyawarah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5f8888f5b2515ca5615dabb28e7cdd918891ce9fbdd5a8e8302b9cd6b0fa6c8",
      "text": "gas",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c620d752847f721950e1521d9ee933accba940b6810b165de66959d16d33ef43",
      "text": "Aku sependapat. Siapa pun bisa bawa tas kain!",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c675d13c047561661e18fa15db03c6a5bf10960d2b178a9f182a88249e46b351",
      "text": "Artinya, jangan buang sampah di pantai. Buang di tempat sampah aja.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca983386c15090e897a2ceff0c3bc54a63410faf25cf77e4299d948acc3ce223",
      "text": "bumi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb32fa061cefc6e947c39f75e25d6ef019d435f5187fde2a82f267b420fd0ef0",
      "text": "nelayan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd4e1ec87097c425e113a80a0a61a0495196c32003e29c412c14b64443e685ad",
      "text": "Saya sependapat dengan Rina.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce53767fe811e0b8731f5e8bebe80fc9c58982c7ef7b106eb73c2221bd80d308",
      "text": "Walaupun hujan, para relawan datang ke pantai.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce7b88d4f88f8a876d59291d6bbe56c30865edda805e02d9475140260da4575e",
      "text": "kesimpulannya",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d201772b3445aa781e28d79921c6e19658461d153c39066fe4779befe9f074ab",
      "text": "membakar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6370631c00906e7ffc15034e3f027c551e9b6d15165d68b749c800350672d89",
      "text": "Baru dua minggu. Relawan menjaganya sampai cukup besar.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6da7405bd6b1fd8db29d9958ad72f18af2695b5706f36ef6e52dae488184eb4",
      "text": "Saya kurang setuju karena banyak pedagang kecil memakai plastik.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "d86fe9903d2c2c3757d3367f98d060aa3566831b99a33374b21376917d47e1e8",
      "text": "Iya. Plastik berbahaya buat penyu sama ikan. Nelayan juga sedih.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "df27af3bfdb7776861a13b4139e268cb0cc7b6c6210a880f874515fa2f0bd3ac",
      "text": "upaya",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "df7abb06e344e7cfe9e87a3c079a1c58918707947eb7e369fff10c47f5dceea2",
      "text": "Inilah Pantai Senggigi yang terkenal itu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e004047b576aaecf67e2d7afeb4c8be6e667513d4090ffc7b700ef5be751b8a0",
      "text": "Aku tungguin di pantai, ya.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "e09df24c89a5358f63498046917735a04792b7d3fbbdadced3f7b7cecbe330a7",
      "text": "Saya kurang setuju. Menurut saya, dendanya terlalu berat untuk pedagang kecil.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "e193a58339ee5215500b2bead6433240cad1a1aa2c27eaf168cc830d9ac8556b",
      "text": "Jadi, kesimpulannya, tas kain adalah solusi yang baik.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3325df798391adc4b4372a1b2391fcb24e38bc136f527a1e055e02d2a755f5e",
      "text": "Wah, aku pengin lihat!",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5d7f220d00670de7c802f06ddb183459f11d764d483cff6a7a952f873b3196b",
      "text": "Siapa pun boleh ikut! Relawannya datang jam enam pagi.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e75af9ddeb23d04b4133cb2acf629bbd4e96e6406387d0570a160f1a7e808dda",
      "text": "energi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7f823dfeba94fcdba6dc79f4caf94e8ad5207683d3b4f3f340e896282ad2aac",
      "text": "Kita harus menjaga alam dan lingkungan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e87b2e0e212051ecd9671fda5d527372812a08d9e1927a60919727ba59c444a5",
      "text": "Selamat datang di Senggigi! Pantainya bersih, kan?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9d509f2241ea6610bc4b2a404e0c2f2b321282fecddd4b3f1a828fe98d8764d",
      "text": "lautan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9d54099e832d431b41fb6cb42b1e1e64ceb7f79f90e7744e7700bc36e09cc97",
      "text": "Menurut saya, kantong plastik harus dilarang di Senggigi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaa4836aaaca3a4072aeb3f32170e7449eb9d3ffe3e42d1fba8b8088b18cb409",
      "text": "Saya kurang setuju. Menurut saya, denda bukan solusi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaa9c91bc4c762a414e7441116a038375cdea5d6be36fa92e4ab513fb5f45243",
      "text": "Jangan membakar sampah plastik!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0e3a8bab34ba61f7f085bc366a8e105039848f8098906ff61b282e18b27c7d6",
      "text": "Beliin aku air, dong.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0e7b81449040e60ff4f1d0d0c5bd137f2c56a6fc6d1f1475d4ca1aa0394ac3b",
      "text": "Benarkah? Kalau gitu, ayo kita jaga pantai ini!",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "f10c23711bcd16e800b1180046c51f1f5836b3d9168222631d10d1cc8556b819",
      "text": "Betul. Terus, solusinya apa?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1369e90bddb4df7436a8578f8386c31272d3b6db1fa07ee9d4ee9b059555acb",
      "text": "Sip! Kita semua bisa mengurangi sampah di pantai.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a6e30f68786b1070f78aff42766d58d63bd0b75d4e0c4bbbd5cdcbf095ecfa",
      "text": "Bukankah plastik berbahaya bagi laut?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f35392bd738a3d9633c3e0a106183da73d7bd164728c775e1fec8d577ae57929",
      "text": "Tas kain ini ___ sepuluh ribu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f57bfb6624469e86e7c4fe4da4f0f5cb8e4a4fb8ab06f6a20955eca0c3ca7f4b",
      "text": "perlindungan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5b5e706b9c95b20552ab9df59daff32d3fb58bc2a6da1bbe98122ed74385b6e",
      "text": "Ada benarnya, tetapi pedagang juga bisa memakai tas kain.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f89aeac033f1642a85f679b29422a8f613614bef110ede6324ef741c0afe5dc6",
      "text": "Saya kurang setuju karena banyak pedagang kecil memakai plastik.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8ff26173074a12cd3c0b431b7d4318b60cae0437ee1fe59cf92218e4375dc89",
      "text": "Kita harus menjaga ___ kita. Jangan buang sampah di laut!",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fafceb90cd23378ff77d2c542161489c8633664f62747bc8cafe3690ed5ca1b2",
      "text": "sedangkan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb9c4e62dd977799f98b404434af5e5bb8a90036d7f260a5f26491644ce033dd",
      "text": "ikut",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc53aac7e3e74604f4bbec768e96ad00258ef4e790a0248d6810baef15cd9d58",
      "text": "Jadi, kesimpulannya, kita harus mengurangi sampah plastik.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd7546b59674f6c64c0cf5128cf0c1380154456d1c5d7f8bc75ca2f9f7552ca0",
      "text": "Upaya kalian luar biasa! Kenapa sih kalian peduli sama penyu?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe2bb16d9b75a981f9506725af536e69e029e9036b6e0bf5e233d84155878597",
      "text": "walaupun",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff470836363a70f692b9f2eb7b4e45dc8a34ed9577d6d5614a75361bdd175836",
      "text": "Ni Luh membawa tas. Tasnya dari kain.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff69fc9c2ed73d66fbd67e86e6d8227b5569659c82b12e1bb7d212e26c0932e7",
      "text": "Wah, itu nggak baik buat bumi.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff741eda62f1ded034c4a39e08189cbe0a56eccbbe78d598b64836124338a354",
      "text": "tentunya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    }
  ],
