{
  "format": 1,
  "id": "id/bipa3.u02",
  "language": "id",
  "unit": "bipa3.u02",
  "version": 2,
  "content_hash": "bc05f2f5910ff9df4fcde3fc1efa08438fad9735125e270c174b4857c8e05463",
  "lessons": [
    {
      "id": "bipa3.u02.l01",
      "sha256": "8de1d86b2b1eae891f4b01660c9ac94120e11e4a01cebdd075a1877ee38bf72b"
    },
    {
      "id": "bipa3.u02.l02",
      "sha256": "0edede5c1989fcac23c4b35a05d0f9613adf478463bd772b6280988b0ca4d90c"
    },
    {
      "id": "bipa3.u02.l03",
      "sha256": "7ea4160e01e9dd073f659bfa4f29e4bde276d6b6a311ef72d7814b9f7019dfcc"
    },
    {
      "id": "bipa3.u02.l04",
      "sha256": "dee09b0fb88cd67ac42540d2077a258d37d4b5f19ab04634d75e30298d0e6da8"
    },
    {
      "id": "bipa3.u02.l05",
      "sha256": "c001c702aa2d93901acb830b4e1e692e7cade932773961bf2ca50a0375fdac64"
    },
    {
      "id": "bipa3.u02.l06",
      "sha256": "f7855aefd8bc9cc11836e074c69f4ff8ed499f5cf66a73705c4fb30ebb1aa7be"
    },
    {
      "id": "bipa3.u02.l07",
      "sha256": "f715e5784e89c3387ee46edd0d4f12f75c4615f9471e4533ae3acbb52b5ff407"
    }
  ],
  "audio": [
    {
      "key": "0b5ed0c13bd39ec9fb0844c7780f677fc5d2d72ab1b755c9130d59161074c22a",
      "text": "Walaupun capek, para relawan senang.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed755daec83f2af96a856d27020342ec4a9a563bd967bdc71bf575c8d2989d7",
      "text": "Pantainya bersih sekali.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "111b3654ce6ad9a20efde160f40fa4e699809440a87405fcf8bfbecb0cee7aa4",
      "text": "Ni Luh membeli kopi. ___ enak sekali.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "124464cd0968697ccb66301877dee2c54d3984f6ce45865c3718e781e75ae3dd",
      "text": "Siapa pun boleh ikut! Para relawan datang jam enam pagi.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "128bd011f47fede628e848865f8ae7b2469bdb1cb4861dca1470d2a8e0d377ac",
      "text": "daur ulang",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b189b82123c268c566f379908a6cc44642f97a92d9a1501758c9e1de57594ca",
      "text": "mengurangi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cda3a86a5be7c8c56fb0d976879e6689b9852e7924df2ccbccf996ab85a1300",
      "text": "Saya kurang setuju. Dendanya terlalu berat untuk pedagang kecil.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "209cd1cd312453fd145482473d41e4f7d27b67b9f76493faf079fcd744a868c7",
      "text": "Wah, saya ingin melihatnya!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "216e02633d16ba93cdf25da133a1c3610e173aaca615b5945d92903a254d93b9",
      "text": "Tidak, terima kasih. Katanya, sedotan plastik tidak baik untuk penyu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "22503de352bf7030a0de34151c665bb54aa072ebfc63e1c9d34bd984f2791cd5",
      "text": "alam",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "25125b6a1abf637b019d88b3b6158e7a577676e6f1654229b6bff6614b231021",
      "text": "Betul. Jadi, apa solusinya?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "27ff4cc7100d7c357fdd1214c88c7054c92f39d20a15b9cda255e4b971def705",
      "text": "pendapat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2857adadc7d7ea1309a8ed1cc65f597483abf6c19689b8c6a771451d0b2ec431",
      "text": "Benarkah para nelayan juga menjaga penyu?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "299b3953d62b5c2d8aac99c1ccf686a8ccd7b4251cdacd41a2e128dacc31988e",
      "text": "menjaga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2af803a7ba1ae58c65d69bc981ace4c003ef4c50ae001b239bbdbe67b97366fe",
      "text": "Selamat datang di Senggigi! Pantainya bersih, ya?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d7deeb0c3ab31b115e80af343a0b53b94eb470912e2aed7680ba7fd628e1770",
      "text": "Benarkah? Kalau begitu, ayo kita jaga pantai ini!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e60d55f98fd7bca064ff31961747d35c1c988a6682997d312b950ebf72c5542",
      "text": "Siapa yang boleh ikut?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2efff46ce4333c68a9b0f4eb965e788d80595d4484d56d6089852494764cbd63",
      "text": "lingkungan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "34615719144ada3d9b54eee207e5d76002c1ce30aecd9dccb952cd71ff14ba38",
      "text": "Di sana ada terumbu karang. Kadang-kadang ada penyu juga.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "34c5bd8d4a0f5c109f6188cb50578837f0b2505d6a89a2b598a7750ff9297248",
      "text": "kurang setuju",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "36e15043062601e929c10fbc744a2465f6af7cced0a903f3738779b09a0e8033",
      "text": "Ini kegiatan untuk semua orang. ___ boleh ikut.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "375bfaa1aba8c0f46184bfa7d81f5995176ab05ea2572272bb5dfd49ac94549f",
      "text": "Mau pakai kantong plastik, Mas?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "385ccada1f33f7486ca3eaa141657da07e884c4572c9e5d2f524e215a7fbbc0f",
      "text": "Bagus! Kita semua bisa mengurangi sampah di pantai.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "39307218bf3533fd691978e300bf7018766493ce76f7142c530faf5028db2cde",
      "text": "Penyu itu lucu. Saya ingin ___ lagi.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf18f66ab6254740d90e77a71869a5a39b518e9d2d6281f814edf8c75a89180",
      "text": "Jadi, kesimpulannya, kita mengurangi plastik pelan-pelan. Musyawarah untuk mufakat!",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cfde5a7e1e5e0f2326993f232178eb2592e979a585676821f6f9ecff7abfe7a",
      "text": "siapa pun",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f9288e01f1bb1b5f1a05665c156b8dea9f2e2aa3d090f7d4ed13bc760936798",
      "text": "Menurut saya, kantong plastik harus dilarang.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "40f5d3904afdbbfedf18c087aeaa047bb499d9bfed86353c452785c8801038bc",
      "text": "Apakah kamu sudah melihat penyu di Gili?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "41025467e8051734c53b3188f8ba11f9e32be290fe2bd6f650b82a2a6011b916",
      "text": "Buanglah sampah pada tempatnya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4299e618b13c8e160c1f53a6c63e4cc7f9d029932ed019fc67924a9fecdf28ea",
      "text": "Siapa pun boleh ikut kegiatan ini.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d6c08cd423d47b9cbc2b3046fde0f2e8ef27b1138034a078f573bed810bd6a",
      "text": "Bagaimana pendapat Anda, Pak Hamdi?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4580fa4f5f41219caeca42f47bd95bebc2fce11601712d353b5c608bf5705d56",
      "text": "Sebaiknya kita membawa botol minum sendiri.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4621d6943f74d997fcdcce5d4436ca31f095d458ba2555402d9f78e90bb4d18b",
      "text": "Menurut saya, sebaiknya kita melarang sedotan dan kantong plastik dulu.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "47985daaf186285a1bb2f4ea4d05e4c1ef5f05485cd652c7ff7b4b041ccbdaa2",
      "text": "Boleh, tapi jangan pegang karangnya. Kita harus menjaga alam.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d0eac77373b7feb315084fa68b77a7babc8dc1e0a04536be82f3a8f972faea2",
      "text": "Ya. Plastik berbahaya bagi penyu dan ikan. Para nelayan juga sedih.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d3a3440e2c274b6cf4e8d19201460ff93c3bd10bce399a09a98b819cbbc5f19",
      "text": "Saya sependapat. Siapa pun bisa membawa tas kain!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ed8b10475898fbcb9386590fbd4e5b5b03e7053b82f08959d6bacec145e6077",
      "text": "Bagaimana pendapat Anda tentang denda itu?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5632df06e522ce79ac358a0154c82db0f4891bf6b4e342f24d4f42027c9357cc",
      "text": "Terumbu karang itu indah. Kita harus menjaganya.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "59eaf46f310225228c57bcfb90aca96f2b4e88e6b43923a318d715392b7ae71b",
      "text": "berbahaya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b2f71ed9fd1ca1a0bd3cd2d9472343e8642447eb97b0330db78fa8ff51248c8",
      "text": "penyu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c89ccdfc122109977541cf4a0dcb83479349c6119f1110ef61e6edd6893b786",
      "text": "Wah, penyunya kecil sekali! Berapa umurnya?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "603ae53ff5b8158ea04bf74d24565be506d86da94d4e1bdab9476558f25f67be",
      "text": "bukankah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "67aff247d548fd91d00c4967ae484dc186950acb26ca60d3c0c83a95658b0b54",
      "text": "Mohamed, Sabtu ini ada kegiatan bersih pantai di Senggigi.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "6862daa106cf7e2f90e9d6a8da0e0490c74ca76cbec6ac0449ed22f12dddae6c",
      "text": "Sebaiknya kita mengurangi sampah plastik.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "691a3277663cfb32b8f9c9a35145f004e578f191a04062e61b4e50726f503d69",
      "text": "tempat sampah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a58f70d4096aeacfd0582d54f9f780206f1a8cf2e524ccc781a433880561182",
      "text": "Saya sependapat dengan Mohamed.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a8684627e92213e0f527a97f62f21c22004e670da6b9d3e59159260f2dffc1e",
      "text": "kegiatan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ddb73ea5670573cf07357f70650f2251d8c08abe823b920bf856672be75e577",
      "text": "Jam enam? Walaupun pagi sekali, saya pun mau ikut!",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6de2cefccfe7c06f7999977509168d40f6e145e8570ebdbd679f32cce86d1fbe",
      "text": "solusi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f33e2c261eeb32ff4ef406443eda76667563db44c92b3300e0688971e9cc625",
      "text": "Mas Rizal, apa arti tulisan itu? \"Buanglah sampah pada tempatnya.\"",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "71de45a1ad070c85cd577a9d2547e131f6f2b0c4bc5b031c413635145d02a318",
      "text": "Apa pun pekerjaan kita, kita bisa mengurangi sampah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "72841f330ce3ec309369abe368ca2e027ca1532752329d0755343057f6a19411",
      "text": "sependapat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "77742cbba24227aaf16644ad9b2b551dd638d22250d38f283a6333575d070247",
      "text": "Rina datang, Dimas pun datang.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "779cfc125d0d5b44fe81977c414947714087d618613c1508631d947c90e527f0",
      "text": "Bukankah banyak turis membawa plastik ke sini?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a79656c17e306fa644b5fc4a02d11bb406716230013bd0e6a2b0ab0726ac0fd",
      "text": "Bagaimana pendapat Anda tentang kantong plastik di pasar?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a9d452c2114aaa9ff19d8af3a2c3ff15d03ac10bd34ca8a408e9dbf2bdfbbfa",
      "text": "rupanya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d7ef41ba2cb24b16a9f9daf44b9bd5e2a855b39a86ff02e99b48bf3f1900646",
      "text": "Rupanya tas ini dari plastik daur ulang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e18c8130b9642f10d154cc5adb95997f1f9e0058923cf0c0658a473efe105ad",
      "text": "Tas kain ini harganya sepuluh ribu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef8e147d408847d74b62ed6fa73cfc39d26f1d2b3af8e30722a88e48e6450ed",
      "text": "Penyu itu lucu. Saya ingin melihatnya lagi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f569af2627fd89600dbd2b1fef2af96df5224ca86976933f3f0ea80bc45fc8f",
      "text": "kantong plastik",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "803e62ea3898a6752137599c6ad2b962bb64670f9f22f35f7a67ca24889170c0",
      "text": "Pantai ini panjangnya dua kilometer.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "804e3c3623dfff2c1cf1a8a56842428398335c7e89d81c1467cb9839d9b70511",
      "text": "Karena itu kita harus mengurangi sampah. Siapa pun bisa membantu!",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "83b10883e67b032cb0d82bf29c765032ba88cc20491c92408a962769da5c05c5",
      "text": "Lima ribu. Mau sedotan juga?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "83ba18d02893c9568222160faac5ff00463a9b4cda9225c372e439ca92e929b0",
      "text": "Katanya, di Gili tidak ada mobil.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "84d8722563bc3a084a50077d30d0621e4346af016b7f5016018fbb6ca86c2d1f",
      "text": "Katanya, sedotan plastik dilarang di Gili.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "857d119a61cd31f8fae43991123c551d01ec1b482909466d211f923c9be50935",
      "text": "membuang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "861ff054d685d2c4f4a3308779fc5cfee7db67d4bc1f2121c7effccf94297b23",
      "text": "Ya, bersih sekali. Tidak ada sampah.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b71443f43b6263bbece926ad6b973552c3067162b8f4a3a360258b626c8e4b1",
      "text": "Pantai ini panjangnya tiga kilometer. Setiap Sabtu, para relawan menjaganya.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d932cdb2373d6f7bf86d918540b6cb486116b5c9f42a9b407a305d1cde172b7",
      "text": "sedotan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8df6fede8d0a72978f23944e125318419477676e7f1d9492df5cb6635e1d3d16",
      "text": "mufakat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ef1bc71a73e0ed7ab19f57ea00473b69bc622576608d433ad466c9c02ce7508",
      "text": "Katanya, siapa pun boleh ikut kegiatan ini.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f1b82ed667e0f8ef8030a68533bc3befb56cc75d582eaa95bc415c8e2456c06",
      "text": "Bukankah di laut banyak plastik? Apakah mereka akan baik-baik saja?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f33918846fa39130e86252e069fc36d99a8d9cd9dd87369aa62582e56b44dbc",
      "text": "terumbu karang",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "97f5f0436ecc85cdcf42081da77837fa763f404d1dacb752c16d49f8d3a66095",
      "text": "Ada benarnya. Tapi bukankah plastik berbahaya bagi penyu?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9be321789bddf0699ec42fa8d899e41efbd3257c24ca4d5dbfaedbeb39e1461b",
      "text": "Terumbu karangnya indah sekali.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c955ebf3c045480e5dcd78e5f8f31cb1c3ce1c47260f52156554181b2e1ba8b",
      "text": "Inilah tempat penangkaran penyu di Gili Trawangan.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0da963aafbe0ae205b21c2729ab5bb7e351a1ebc59853ce34e8b0f9a5505155",
      "text": "relawan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a20e9f3945abb60fe02a427449fb2e93625832a0d80b7c1d46ee2558e41c238b",
      "text": "apa pun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2628030048a6ac57302e41e25edce185afcb69b3d337113cf6ed6f703641f29",
      "text": "benarkah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2ad0f349778f199d3cb115b068e09705eed5dee24effb2c69a839f4b2ba8b0a",
      "text": "denda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5b9d8d385b3f5834b5a4d0d3f7b4960ff7275f3030fb15aa2e520d111cd6c0e",
      "text": "Saya setuju ___ pendapat Rina.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "acf02edf7f4f63b2c9325faf80dea4da77481d84a16d46b78e709b583990eaeb",
      "text": "sebaiknya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b303d44d6a44a2fbd506b7cc9e5e7cc41216b9299add4630fcfffa7d406e5579",
      "text": "melarang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6ce39bb4f724e1fbb2403035353606626ef790278ddc56ffc26fd37e1bd0673",
      "text": "Inilah Gili Trawangan. Di sini tidak ada mobil!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c50f6fd6946879ae4e707711701355b7bad28f4ac260d80835f132675d5f9f",
      "text": "sampah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b88cf76a8dcd9289311ec70ed1eac18220b89a711091f0cb94c968e8fcd68dec",
      "text": "katanya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc6ad3792e3513203ee23652c5f2848dabe0208b2e57a8149ce431390d908e00",
      "text": "Saya sependapat. Mari kita bermusyawarah sampai mufakat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4c76bfda31d400e3a8100cc03ec73669d7acce29d9cb242bb44999ca3af638c",
      "text": "Musyawarah untuk ___.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c5da9b3e49d6a4aa28f714c6f27bd9ea186936825a759a9988499c607cc244",
      "text": "musyawarah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8c7c4ca9a03eb0073288bad9f4efe2872e644c7ef3e611747d1b8f96ca1b112",
      "text": "Katanya, di Gili ada denda untuk sampah plastik. Bagaimana pendapatmu, Dimas?",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb1cac41341cb1d6abc506a32cc0664623d04971da437d773c4f8b69ae0ddc92",
      "text": "Artinya, jangan buang sampah di pantai. Buang di tempat sampah.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb32fa061cefc6e947c39f75e25d6ef019d435f5187fde2a82f267b420fd0ef0",
      "text": "nelayan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbddd036657f272fd1e02a180c9e5ac9e44080e9985891c3f5369a47414b26c0",
      "text": "Tidak usah, terima kasih. Saya bawa tas kain. Berapa harganya?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd4e1ec87097c425e113a80a0a61a0495196c32003e29c412c14b64443e685ad",
      "text": "Saya sependapat dengan Rina.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce53767fe811e0b8731f5e8bebe80fc9c58982c7ef7b106eb73c2221bd80d308",
      "text": "Walaupun hujan, para relawan datang ke pantai.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce7b88d4f88f8a876d59291d6bbe56c30865edda805e02d9475140260da4575e",
      "text": "kesimpulannya",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6da7405bd6b1fd8db29d9958ad72f18af2695b5706f36ef6e52dae488184eb4",
      "text": "Saya kurang setuju karena banyak pedagang kecil memakai plastik.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "df7abb06e344e7cfe9e87a3c079a1c58918707947eb7e369fff10c47f5dceea2",
      "text": "Inilah Pantai Senggigi yang terkenal itu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e09df24c89a5358f63498046917735a04792b7d3fbbdadced3f7b7cecbe330a7",
      "text": "Saya kurang setuju. Menurut saya, dendanya terlalu berat untuk pedagang kecil.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "e193a58339ee5215500b2bead6433240cad1a1aa2c27eaf168cc830d9ac8556b",
      "text": "Jadi, kesimpulannya, tas kain adalah solusi yang baik.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7f823dfeba94fcdba6dc79f4caf94e8ad5207683d3b4f3f340e896282ad2aac",
      "text": "Kita harus menjaga alam dan lingkungan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9d54099e832d431b41fb6cb42b1e1e64ceb7f79f90e7744e7700bc36e09cc97",
      "text": "Menurut saya, kantong plastik harus dilarang di Senggigi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea3763d5e59aaf7ccfc1627b6580e2cfa20042fc8e82b65c17980e057b7b8ee8",
      "text": "Baru dua minggu. Para relawan menjaganya sampai cukup besar.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaa4836aaaca3a4072aeb3f32170e7449eb9d3ffe3e42d1fba8b8088b18cb409",
      "text": "Saya kurang setuju. Menurut saya, denda bukan solusi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a6e30f68786b1070f78aff42766d58d63bd0b75d4e0c4bbbd5cdcbf095ecfa",
      "text": "Bukankah plastik berbahaya bagi laut?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f35392bd738a3d9633c3e0a106183da73d7bd164728c775e1fec8d577ae57929",
      "text": "Tas kain ini ___ sepuluh ribu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5b5e706b9c95b20552ab9df59daff32d3fb58bc2a6da1bbe98122ed74385b6e",
      "text": "Ada benarnya, tetapi pedagang juga bisa memakai tas kain.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f89aeac033f1642a85f679b29422a8f613614bef110ede6324ef741c0afe5dc6",
      "text": "Saya kurang setuju karena banyak pedagang kecil memakai plastik.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8ff26173074a12cd3c0b431b7d4318b60cae0437ee1fe59cf92218e4375dc89",
      "text": "Kita harus menjaga ___ kita. Jangan buang sampah di laut!",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc53aac7e3e74604f4bbec768e96ad00258ef4e790a0248d6810baef15cd9d58",
      "text": "Jadi, kesimpulannya, kita harus mengurangi sampah plastik.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe2bb16d9b75a981f9506725af536e69e029e9036b6e0bf5e233d84155878597",
      "text": "walaupun",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff470836363a70f692b9f2eb7b4e45dc8a34ed9577d6d5614a75361bdd175836",
      "text": "Ni Luh membawa tas. Tasnya dari kain.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    }
  ],
