  "content_hash": "2e798f1e0971b1c20b3c9ec0b625dcc0fc2262bb3882bf8c36ae89323083a614",
  "lessons": [
    {
      "id": "bipa3.u04.l01",
      "sha256": "4f0c844e1ba83c33197d357379143c196e391877739a9e1bd4e6ff2a06e15070"
    },
    {
      "id": "bipa3.u04.l02",
      "sha256": "83adffd00d9148d3f0e893ab3fe95607ace3a06a426c582cf89b0c35fae78f5f"
    },
    {
      "id": "bipa3.u04.l03",
      "sha256": "474a5bf765211cb7fbd6dc11fbfead7efe27f36b4e280dbb15dd6d1320d224c0"
    },
    {
      "id": "bipa3.u04.l04",
      "sha256": "b9a4a06ea0269358b4507adb79989ecf91e4cd70ea1828b5ffd9767247a0ac87"
    },
    {
      "id": "bipa3.u04.l05",
      "sha256": "fab83a6bf23f199cb925ae115cfd801af1b562785099e5b45781294b033eb407"
    },
    {
      "id": "bipa3.u04.l06",
      "sha256": "c711ff8e9ec7961c41188f0bb857ead77df43596e6e2a71691b36d2406e00d9c"
    },
    {
      "id": "bipa3.u04.l07",
      "sha256": "70826d5bbec5b428b0c0d2cda62f20d4696c6a617febf83aac4de615d213171f"
    },
    {
      "id": "bipa3.u04.l08",
      "sha256": "1b2c987032ec04b66b0b444a575f7a0355553ae8776e227224eada2dee5857cb"
    },
    {
      "id": "bipa3.u04.l09",
      "sha256": "1aa70d4bc6aac14d7939479db42bcb18709a98256c1c82792c79aa8c2c7c8c5a"
    },
    {
      "id": "bipa3.u04.l10",
      "sha256": "652b85ee38a3b829f0aa99e0353c3cae639902ef4e86035b3d85f38f225db685"
    }
  ],
  "audio": [
    {
      "key": "0257906c7e12299ae475c83352a608e813e80362e34e50be0d4b66c1c7cb4474",
      "text": "Jangan lupa makan buah. Buah kaya serat dan vitamin, jadi buah menyehatkan tubuh.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "02bde6b8e79c28f2562485d04b94e99caab88df6f4d400c36aeaadfa68040415",
      "text": "Tahun ini produksi stroberi naik dua puluh persen.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0301e87200175c946d644c6c8bbc746778ed7b4876b835209de551d4cf9ff8cb",
      "text": "otak",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "04945a91c784c64d56f330a87ea9dda581a0bb835f739bbb3a1621f982595d57",
      "text": "Ya. Saya punya dua kebun, yaitu kebun sayur dan kebun stroberi.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "05b63d463f7636e52013d77e3518de55aa41d3aa7c7a0713f0f12d26f7d5f540",
      "text": "Kapan panen stroberi?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "05e6d08cc4be9677c4e5b4c035fdb569a102b0efa4895dd2ad4688395935cea1",
      "text": "penjualan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "071884394051f230882b44dc3743719ebc101180d2c5f8a4469c34a8aa3978b1",
      "text": "Sembalun merupakan daerah sayur dan stroberi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0aea1e2cc09f3070ad47d26aeec2780f4c2365a24c752ec415b75efb6dcff949",
      "text": "bergizi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d8b8d7b73e81ff434d3481f8b12f3e4470327d1465121f49028446dbf501061",
      "text": "Gula yang terlalu banyak adalah racun untuk tubuh.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "14a3e550d8a075bc7ac201ea6154b16fc630099d80a1e4a910dd92335e8096ce",
      "text": "cokelat / coklat",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "16db3d6216bba7e4e7ffc078a2b4b208d6e8591a5dfe107003bb419a6324e158",
      "text": "Buah ___ serat dan vitamin.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1993a150c421e5c7ce4d564c86c0e8cb177c5f66b8165f4141fea6a36df923e4",
      "text": "mental",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "19b5b3bf0abe647f2dd4eb877c8295049911d69f0e98cee174d8d1c87bac8ead",
      "text": "membuat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "19edfd0e04d2cf89ae30efd9cf77a6f69407d30b97cfce4b4d5ef5d8d7d84d61",
      "text": "Stroberi ___ buah yang kaya vitamin C.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ab91cd1616d71abe82777a8113bdb0de34f0f818460f5288997bad56ce6d7e2",
      "text": "Kebun Bu Rohani bukan kebun sayur, tetapi kebun stroberi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "2141100a5db1830bbde6b56043cd1170cb3bef80655c97768d2274167578b42e",
      "text": "Bu Yanti ___ nasi goreng untuk anaknya.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "22236dbe8fd1165a45b63d123648aadfcbf46b18e00226c621b1bdefd72f1185",
      "text": "Terlalu banyak garam bisa menaikkan tekanan darah.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "22e9fda33c33dd87a2c780e61d58c11b1bcda36c5692ba40a12aad5f26d2ac95",
      "text": "Jalan kaki bisa menurunkan tekanan darah.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "235e9a577d07ca0a4fae53965bbd668fa989f4ee8b0757fb234bd82bdbeb927a",
      "text": "Makanan saya di kota kurang seimbang, Bu.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "26932d40fa54f4e90abaac93aecb5318d8f0f57761fea372bfc5cb72b20a80f5",
      "text": "Boleh, Bu. Saya bantu apa?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f4edbe4544ec9ae7b92bcde8d18d0ceb1b33780a68bbefa3b3cda31d65e2b5",
      "text": "Bagus! Ini, stroberi dari kebun saya. Kaya vitamin C!",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "28c7232d721a773adf51a25ec9cf3eda5e1ff4532aa0f7f3730c322ff1148c26",
      "text": "Bersihkan sayurnya, lalu panaskan airnya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "28d717433ac4b79eb2fabee085ebf2f3299d98166a60b745afa6b0b2422d8a6b",
      "text": "diet",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2960cfed0cbc77168ad68c4ce6c48abef41ca29539a14a13e1794149b72bf1b0",
      "text": "alkohol",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "29a9c63b419c2b01ec25425c9280fefdabbec08d638464fd1dcedfdfedd752aa",
      "text": "kebiasaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cae55a57f30efda166ce73b2f3dbca846f2f2e7e7140beb35da814c5f8a3e18",
      "text": "Minggu depan. Datanglah lagi, ya!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d5933a8ef87d4c4a32c9cc3bfbe524db1c911f5954c5cf434853c276551e48c",
      "text": "kaya",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d9ac3245555e8e8a7a1016cb53f5537c105124cc9ff504b856785bb46f70968",
      "text": "Rokok bisa membuat penyakit kanker.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "3180452e70d6c6f396b6b1b34d15712551ef8524ae6caf61aea568a4b64a31af",
      "text": "Mohamed, mari kita masak sayur bening.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "32f28af11d3a7b678c3173d1c3f47a6c790ef037125445e8b1e03a38e2bd16d2",
      "text": "produksi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "337793676226f8a3427baff89e1b7624a416758adb4b591402a9095dc4a5ae36",
      "text": "Makanan sehat adalah makanan yang bergizi dan seimbang.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "33b965ea23a66b1f2aabf11473faa0e655b15f125ffefd6ed5083446d624b338",
      "text": "Ya, nasi. Tetapi dulu jagung dan ubi juga makanan pokok di sini.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "349291da0a0eea616af722d80fab580e43e984d9d8a2ee4453f49f25a3848f0a",
      "text": "mematikan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "373875d75149e24af01e036a5db4fed266f19e859c1e885d8e51f7f92a5a8cc2",
      "text": "Pabrik itu membuat jus dari buah petani.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "375f1c6b13f0a4e33d5f365f6c19e776a0d5f51ddddb0bf8c627f3c75bedaa11",
      "text": "industri",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "379ec6190cffc74d0e3586c20e0f950f75f5da0c868a48583ad688e307ca56f3",
      "text": "teknologi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ad8589426db71bb75e7f36406fe1e34184a0ade5838bca3a5b565651b17102a",
      "text": "Bu Rohani, ini kebun Ibu?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ec7289c5d87cd5403d14275bab6009e5490afcd7f1e7058e5cdc84ec530848d",
      "text": "Mohamed, tadi kamu dengar radio? Katanya, sarapan harus seimbang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fd72783d1abaccf24867e1c40ce018ab54157c0e55716c06b5a86fe19f938e9",
      "text": "Itu kebiasaan baik! Di kota kamu jarang jalan kaki, kan?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "40f943ac3d3314a7dc3bb5cc9345f88d43877c99c1b39c0737e5db7a16f61634",
      "text": "panen",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "426f97d800a1b31ebfbadebeaffed4e291eaa72d29a5258bbb5aaa6d18f81076",
      "text": "Ayo! Tunggu, saya mematikan HP dulu.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "439ebb2fed8ed401168350fd2df530ca1286d132c485c3825a613e99ae27ecf5",
      "text": "Panaskan airnya untuk membuat teh.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4597b71c86f17a94ec7a778e70db04749a753af35f7e16fcc624fd3c6434f304",
      "text": "Ya, Bu. Ada nasi, sayur, dan protein. Tapi saya biasanya makan nasi goreng saja.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cbd3f6c7a1b7ef46df75bcaa2bed9db2daab003e3ce302ab03276695b98f962",
      "text": "Sayur bening ini sehat, ya?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d3119207a7decfc791f9a3bf9b5f701a3eaaafe5141dae9394b3c15601d7a09",
      "text": "\"Stroberi mengandung serat dan sedikit lemak, jadi stroberi menyehatkan tubuh.\"",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d593f684209b9ca89b5c6a2ef1ce2571221a3b989e89a01d27beab24f627293",
      "text": "penyakit",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d5d8b8b8c411983830d4d350c4753ab8204e474bfbb8b3d2981489677ce1dbe",
      "text": "makanan pokok",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d6ee8f9c01644221ac6e7670d7cdc230316877078cab00a35b5d5b595871c88",
      "text": "gizi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dae699a146f72892cad20b945905079a8f202417e917aa8cb3e7fd7c8e40a12",
      "text": "Stroberi kering dengan madu murni. Bagus untuk yang sedang diet.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fff8a6d56f18440434a2114c2404e15981ca4ef6c1b01d25a847645e74fbd98",
      "text": "Buah kaya serat dan vitamin, jadi buah menyehatkan tubuh.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "51477793a27c23b8d2efa588456b48f1a0dbc4b3f7a45c5e772a6b29f701a091",
      "text": "Stroberi tumbuh dengan baik di Sembalun.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "523edf0cc7e13a31fad24ab8307170a17e467540ef9917451b5195fce465edbd",
      "text": "Mohamed, ayo kita memetik stroberi di kebun Bu Rohani!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "52fe21173ea1f6244825edf44baf1ee1a507a31754fc9c343df869c7bb0cec90",
      "text": "menaikkan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "554f7dbc17b60fe1f2be68b3ebe53eee647305c6bbaf5e30c69ef0b13496c504",
      "text": "yaitu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5660bd14aaf02b74b9eb271857c5c2459676ad0ec12cb24d754bb8bb7af00830",
      "text": "Ikan mengandung lemak yang sehat.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "58209829e3b4ca5e7463afb835ec1cae81dcc619b32b6b6ccd6ff0573c24ff53",
      "text": "Menurut dokter, ___ jantung bisa datang karena stres.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "59908bd00a4803f27e90cbd856ee7cb4f913e3d785e4b2f789d75d2371f300b0",
      "text": "Saya mematikan HP jam sembilan malam. Itu kebiasaan baru saya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b2052799a24314b3a41310fb5a374f3a67acccd33680b03c3b6a71ff35ea982",
      "text": "Ya. Jangan lupa, makanan yang seimbang menyehatkan tubuh.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c3a566d267c08a2eb945edf36006e2bbfc04f7de4844523ba217c1650a75a97",
      "text": "menghasilkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e91f7ed292f9ed029fd4bbb839826bfaf8320e287f37ce46cc7f4779d469d91",
      "text": "Kurangi makanan goreng, karena makanan goreng mengandung banyak lemak.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6064b2ec5066768b62182bde59889e41282c1a6652945de2438b3108f30fc852",
      "text": "Apa yang tumbuh di sini?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "645a9fe28eb48b9f3be58b64798c099ba9361bd865f3d0043fe5a3295ecbc43f",
      "text": "Stroberi merupakan buah yang kaya vitamin C.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "64a63cf2c739cd98d09210ed14c901ea7c52e2ed1032dbc28e3de3edd5edd94e",
      "text": "Mohamed, ini stroberi dari kebun saya. Oleh-oleh untuk Bu Yanti.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "663c83983c51d4881af93101d7aa660af9bef9e0afd4ec376ede355d0b32ae57",
      "text": "Siap, Bu! Di Mataram, saya mau mengurangi makanan goreng.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "668fd408d7691e98af73ab52bbb59301b8f992dd51f70dbd2a41b403eb4da746",
      "text": "Hati-hati, botol itu berisi racun tikus!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "68284913753b07e608e1b4ce0713e7da144f68248f3a6b3ea39031bb6fd4ab8f",
      "text": "Betul. Kata dokter, tekanan darah saya agak tinggi.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "699bf032783a152314f59ab57235f03d78288f6b03d0aea704b206db202f968b",
      "text": "Terima kasih banyak, Bu! Stroberi Sembalun manis dan bergizi.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "6be95bb17488de3b7a325b85ef02a2447d513027d021646a5ba12f1de09f3bc0",
      "text": "Ada tiga makanan pokok di sini, yaitu nasi, jagung, dan ubi.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d12450197435b13ba1330869535cc1f089a4eb56c18f9866f31c2372f1f4ce7",
      "text": "Bersihkan sayurnya dulu, lalu panaskan air.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dba80b75430a42d7d7586f8ee9559e18c9285927a40145310569e7c103d0a18",
      "text": "menurunkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f766f4edb2f79070a56fccf57d87fd78f055150ba002bd6447b744b5a9a556f",
      "text": "Jalan kaki bisa menurunkan tekanan darah. Dan memetik stroberi sangat menyenangkan!",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "70ab023109f9036c84f13417183956ddaf74a41091185a7c4c519284a8865107",
      "text": "Ubi bukan buah, tetapi makanan pokok.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "72afac2a9d9bc5a0708fd6f4ada5df4a9a5e269dcf2e9ef22aba6800c4e197c2",
      "text": "Mau coba cokelat stroberi dari Sembalun, Mas?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "742555b64128a1ed8ff8d602d9a11365b4762e8f320fcfd2ffd5cdd54dbe7b0e",
      "text": "jagung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "74e7d1a01ff4377469169495bb1afcec0c0512c55130c5465751602374bdac40",
      "text": "Industri kopi menghasilkan banyak uang.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "768b414727b75c546ef5d6aafecb8d9bd860c9063ed6d531d0c03f2927e92eb7",
      "text": "Botol ini berisi madu murni dari Sumbawa.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "77b6138edb2c5928a43ef4497a39319495ccc849c4564820d694d2446a9cf1af",
      "text": "Lihat, Mohamed. Hampir semua orang di sini bekerja di pertanian.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6574d31c772727864da9b132ca36e70f711c50049ed61038c4a5d8aca0f62c",
      "text": "fisik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a788e3c9b2b20f5d49b9daf1317c7846eecbf4ae291a6e76db3ad64d9dd5954",
      "text": "Buah merupakan makanan yang kaya gizi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b37534f8bc8e6d3e9b4a5dfb4703b026727143fc194fc3d4b7bcd0518f783ea",
      "text": "Stroberi mengandung serat dan sedikit lemak.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b9c7a26495310b6b4d15738028b002e49cb4306e5ba4f69b07249668ec07940",
      "text": "murni",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7baef6fc2047dfb0f84c41047280fd19dabab8cee6bb64d5cfeab624c99230ad",
      "text": "Tempe bukan daging, tetapi sumber protein.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cc391d3aac037a4df9f00673436ae78a2eaef427f5e2c12c26e468bda52cec5",
      "text": "Sayur Sembalun segar dan kaya gizi.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d708b4768af5b72064bbcc90df53e5e568c703c15f015039d37f92d9f39b4ca",
      "text": "Kebun ini menghasilkan banyak sayur segar.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e9a31c50819c3f04ea6f104f503ea47d08996ffd10e256a005d6f49a27410f4",
      "text": "Cokelat, gula dan stroberi dari kebun. Tidak pakai bahan kimia.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "8264468d94ace05c3b796aa055be751289a5480decb54ec1c42395c9377c7d55",
      "text": "Susu menguatkan tulang.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "82895b3633ec4b83932a48b3e8af8c5d5a019768bd56387063c25424e68c6562",
      "text": "Stroberi, kentang, bawang. Kebun ini menghasilkan banyak sekali.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "837ffde32ab05355abb13db602d143e6ac90fd551c674b8b45fa8fc55845ce06",
      "text": "mengandung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "85d4613893f10e7df387defb196fab76e68c53a51f001e9191da00d18319914c",
      "text": "kebun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "85de9fcdac855365aeee97d1e0d7b2566c2b13f433db961779df8632e8e5dc3b",
      "text": "lemak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "860f7616322f1859429f9fbde67098ebb480ee8b077f04ef7699f65c836d882e",
      "text": "Lalu stroberinya ke mana?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b78b33cfbcb635dd4da7be88db10ae557308b4580b334b1f4f0a4595ffe3069",
      "text": "racun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d0bd9cefa407465d6f8cfcab4e3f1fa7123471ca62abab92f8001be45ec7b68",
      "text": "tulang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8db9b8eb04fd3c65a933c276ace4e22116849f07232b9f4225ff1f5d1debda34",
      "text": "Mental dan fisik yang sehat sama-sama perlu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "908607596fbe4b7bb115cf6d3d529a4979ba6e559fc12ba6f97d077e7a8ab9af",
      "text": "ubi",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "91aeee1f716394da4563b2d767a669a903ee3e8ac1178a0b0a02dfbf78c27cdd",
      "text": "serat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "935260bb03da08c2dd7a95fb94f2f20721ea90056e50157b67d5e98c3bd34c18",
      "text": "Wah, udaranya sejuk! Sayurnya juga segar sekali.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "93d34e46f89bcae320611f68c5d5a4b664c9b642646d0be3df5e6d383627cde1",
      "text": "Pak Mohamed, tekanan darah Anda agak tinggi. Apakah Anda merokok?",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "966c8840ca0ce3d88fef1e95aacdc6265fb6e4bf804d3eb8bbbfefe5fe46ec85",
      "text": "tekanan darah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ea2e8a7f5a3c161af78040668083ea0a080d651afbe75bea309128ecb75522",
      "text": "bahan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "99574efa8e4de97d4a9e99f3ccc0461cb0ab1a25fb19b169af6bb0bab33cdc2e",
      "text": "Bu Yanti membersihkan stroberi sebelum memakannya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bfac6fdecdc5c156f7e3076427d168c72f5eed2a8086600f3adf4fed9baba20",
      "text": "Sayur dan buah menyehatkan tubuh.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d269d4a11065e5e2c5a65be28a7f1fc49f57eb456011ea9a992a5bb19400043",
      "text": "Rokok dan alkohol membuat banyak penyakit.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d286545fc5051364b32e38280fe25b33ce0eaf8be3a7107968072b22374ad14",
      "text": "Olahraga baik untuk tubuh dan mental.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9de1835c36d875e98833f753788f23e467504430a948c4b95b355b21fc7201ec",
      "text": "Musim hujan sudah lewat. Sekarang tanahnya ___.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fab89aaa03a161c182c66c584763ea704d041d9ec3c555607106050228f851b",
      "text": "Bu Rohani punya dua kebun, yaitu kebun sayur dan kebun stroberi.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "9feb33dedd034f9a19904109194aadeca0f0ee61f1c2249d8dc3f7649e8d1328",
      "text": "Pekerjaan saya berat. Saya sering stres.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0bcffd603b3c9d9a9f1e25e631d7f3ccb058ea626dd5338bdf80510d45243eb",
      "text": "seimbang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0fc1a8e2080901ed1e430a90d39f46accf506f817dcebbdec6a1b17f8a69fa6",
      "text": "Tempe mengandung banyak protein dan sedikit lemak. Manfaatnya, tempe menguatkan tubuh.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "a674b3040a67164b52c9e4c3ba67c9f83d0e5f3054eec652481b005253d831ea",
      "text": "Inilah Sembalun. Sembalun merupakan daerah sayur dan stroberi.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "a749bfd1e9c4d5f4cd5d065cb53855d061d943d0f234c8c9e249b22376c6c930",
      "text": "Saya tidak suka makanan yang sama setiap hari. ___!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac82b0597650f9388fda94d1c58dde9f86b8299ade414ab935d3eeabe1de4c20",
      "text": "Bagus. Apakah Anda sering stres?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "af8e8abeab24965428152e58a4b7ef3730f0b36cce0156f597bf9c57b8a9ee4b",
      "text": "Makanan yang sama setiap hari membosankan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "afe39d5b70559a1c50b36ea02b0f2d83f7057140e2a7c3dc4af1d690d3b860bc",
      "text": "Sarapan yang sehat adalah sarapan yang seimbang, yaitu ada nasi, sayur, dan protein.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "b559991e72c56f60696cf541080e9cc14247dc0db86d47345eb261a4a24465e4",
      "text": "\"Jadi, makanlah stroberi dari Sembalun!\"",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b68e8c133a94ba72ba4738abfed512eb3c90a76b5c9de8d58f780914bbf1fd6f",
      "text": "tubuh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7f35b0b7262d62e839a816f5d16062158f97d94b46ebb38b5701004993d1b45",
      "text": "manfaat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba0eec89f6303843a2f072ad96d0a8d3608f6903680ed96515afda72977e769b",
      "text": "Apa makanan pokok di Sembalun? Nasi?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb08dc89641c6fe08e049e3592533880732a5a024f19fdfd009d8b2fa48b0dcc",
      "text": "Bagus! Lalu, apa manfaatnya?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb3ab87e57ddbd8020df5d66017949bb098527c82d929cff70b346edd859fa3f",
      "text": "Ya! Sayur menyehatkan tubuh. Makanlah yang banyak!",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc39ab7598083e94fe232034b1479acbe57927361a99ab6d17df33106925793e",
      "text": "stres",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc5fb07b80ccb32d2932e18fbf9b1a4e1270bb88bf9c40a4452d9dbffb6046cf",
      "text": "Tidak, Dok. Saya juga tidak minum alkohol.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bec1beddd77633ae4bbe889b04f4defdaf5446a78f1838f148a5f4290db1f260",
      "text": "Kue ini memakai bahan alami, tidak pakai bahan kimia.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bed0886a66cc095535b9895b7700a559f7a07dfd566a3793e391f789f4ad5b20",
      "text": "tumbuh",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf32717b47d88f554d03be889f9fd3c1f2f692988bed1c1ff0eb44d9a06c9c0c",
      "text": "Bagus! Semoga sehat selalu, ya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf479b0471b74407d66473c39b57f5cc00b02515d0f0486c67162b0a3cfdacc3",
      "text": "sumber",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf67b63b5d5c88945a47416d6271676745d0da5e80aaeeb16c04dbc208dd6b75",
      "text": "Stres tidak baik untuk tubuh. Jaga tubuh dan mental Anda, ya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c26d227367117064d50d560dcff30ec9e2fb61c9a9d38ef68cc49051ff1ab4ac",
      "text": "pertanian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5f1426b8ab2ca20a235760ae661cdf751eefe1eee0dae5c8d2106c472019189",
      "text": "Ya, pekerjaan saya berat dan saya kurang tidur.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c67dfb21da4bbf2e6f87cda4858c8b6dcb62a587dc76b38c6529dfd62847f3bc",
      "text": "Boleh. Apa bahannya?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8be0684c80afe72937ed51bb720e5afd10f481072a8abb356319a5e6694a8a2",
      "text": "keuntungan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca6bf00c737f96070e7adc43dd868beb1a6dba86b3bcdba42adc06cb0d0eee24",
      "text": "Mohamed, teks eksplanasimu sudah selesai?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "cad9f0f9990bb3c7105baba21b2ce6f3039597bc1be2e2a1412d1d8a947da833",
      "text": "Sayur adalah sumber serat.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "d13701707c0b1ae3f91fb90558d6bb551466dad7a2c3be7049fd123ca9308232",
      "text": "membersihkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "d147f118a7e13b4e55c47bbb036b78199f6d91af177e7e79321465d1c4ee6802",
      "text": "kering",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d179bf83c2a775391e79a2282c5965766bd541dcb6d425784dba4ac360512be9",
      "text": "kimia",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2fe4ffb9844ef1d1dbededd1e2742d702d51011434af87ca1b98e7668325107",
      "text": "___ stroberi naik dua puluh persen tahun ini.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "dab96028cf133c497333cdd7b13dda616596c4742c9c63dcab0f4bc0be7af66e",
      "text": "Ke pasar, dan ada juga yang ke pabrik selai. Keuntungannya lumayan.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "de27e9d9444113afc2552509b1df3ca3c811af99be06f06ac90bf4e5f3e1b70a",
      "text": "menyehatkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2c9391807396da83c854aabe559a9f741ce531522c43f98a105290b2ca1b7e0",
      "text": "Kotak yang kecil itu berisi apa?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e358e51cc80eb1dde423627f37855617b667823b625ff038c4fbd7ba643ccb9f",
      "text": "Tempe ___ daging.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "e362c6a015181542d74363ebb4830dd41f2de0ceaf833803896fa308115e6cc1",
      "text": "Wah, makanan goreng mengandung banyak lemak. Kurangi, ya!",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e378f85192a743484107deebf15f30a4573307410d91c127ec2ddd0063410e31",
      "text": "Stroberi merupakan buah yang kaya vitamin C dan menyehatkan tubuh.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
