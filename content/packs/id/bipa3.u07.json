    },
    {
      "id": "bipa3.u07.l07",
      "sha256": "87bb9b3c69ff24991a846bc2d126be355833f3078463ca4b214d0bf6b323aff8"
    },
    {
      "id": "bipa3.u07.l08",
      "sha256": "b6c413cc20931195b8db75bcfa4745ff3b707502a57a1962373056a6cbd11aa6"
    },
    {
      "id": "bipa3.u07.l09",
      "sha256": "df235a667500a5ec6cb2b235949ab2aeec9993d74a8e606cbb2ec0a212b4ac10"
    },
    {
      "id": "bipa3.u07.l10",
      "sha256": "b88a76422928a4c12312f5e3f8fa7c8ea9da1439b90bc194ac92174543f5b376"
    }
  ],
  "audio": [
    {
      "key": "00292dc78c117322f446c949205698ff56bec4903f5918b35246a82c2be24cf4",
      "text": "wisatawan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0032422e985e39f55de6b576d7a9a107d56fb015f6bfa355d6eef79b3f69afa8",
      "text": "gelar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "01d51be4f08933f461ce06212d75ddeed2b46a4138239b781172b74d7169233b",
      "text": "Beliau berjuang untuk kemerdekaan Indonesia.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "0418e11e3b5ad23ed8d2f8f91b9252db89bd5cbe91a7a4fa386c694f289ae0a0",
      "text": "membalas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "04ebfa674f40a7165226c6ffc502c85caf36c8c86ea8720cd47bd036bcbcd7f2",
      "text": "mengalahkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "088f3e4a63333dba9815b98c7f7fe8b4ad1e22f6b2f815fb2c7072923ce1d04f",
      "text": "Semua orang bersatu melawan musuh.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "09f90563da3c585385b5590efa3d77771af367dbc0121741d874f5ae52ee2918",
      "text": "Banyak sekali. Pada tahun 2017, beliau diangkat menjadi pahlawan nasional.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c5c0189a2a7be5d6404ef3761eca5e7dfd834cffb00390f53d8e06617c76b89",
      "text": "Kartini ___ di Jepara pada tahun 1879.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c858623195c8a54997da0402aa3b92296b1190a12b0e9f1dde7077216b09fe3",
      "text": "Bagus! Dan buku itu?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e36d82792a663641fe66a709f61cfc9015f1cf6fe84cafa56be4d08842c6403",
      "text": "Mas Rizal, siapa pahlawan Indonesia yang terkenal?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f70373f20c100f031112f12409e0803f333d53ecaea89024ace323a5fa57581",
      "text": "Masyaallah! Murid beliau banyak?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f9a5a7b35c18918abff3d6d9aa27e49199d0699c083d65a3be233f7592a4a79",
      "text": "Siapa musuhnya?",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "114f8bd61059873604b898b7c2bd604544f49c6e7705d4518a92b50e2bba8b83",
      "text": "bersatu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "11500d0a4be3ebf452c6fa9bce4e2bc8e3164a46e0d2aca7441dc13b714df3dd",
      "text": "Silakan! Nanti fotonya kirim ke saya, ya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1178266951dff8311438103cc8a8794b2e24dc87ddc8ef72411c464ca48692ab",
      "text": "ulama",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "11c0da293cfc46b564c5c98f59f26a706546d88523ea9f7581709a817cce49fe",
      "text": "partai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "12c2eb199d60e5981a92129c113397c706fd0256ddb1ecfdeee825d6e787e939",
      "text": "Pesan Anda sudah kami terima.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "16c9eca427cb0d7385c68b6fe3a34553725e9a525d0b038485e5fe0309385a41",
      "text": "Pemimpin yang baik mendengarkan warganya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1838e03e774ecda16332a7a34a11007524147a989ee465dc4fdfc219ff074938",
      "text": "Tuan Guru Zainuddin Abdul Madjid. Beliau lahir di Pancor, Lombok Timur.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "19fc2567c4cb0fc968ff7beeb03dcbbe155c8fd7ae55ba156e45c1cc90b9ec3e",
      "text": "organisasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e06acbf47229d12b836ead8519fbea9a756d5d7e2eb8793a286bebab0edd8e2",
      "text": "Oleh-oleh ini saya ___ di Sade.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ef43a22c1d13f6ee43df6c8842c0e76583ef4ea74f60f3f8e7abcb72b8f206f",
      "text": "Perang Jawa berlangsung dari tahun 1825 sampai 1830.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f2bf44e9e97be517602695a39d04b10a61028aaccb9ccaea641ce6d0b860ee1",
      "text": "Jepang menyerah pada bulan Agustus 1945.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "200784d6daaa4dd48abe91f109439e651f08cb47f1fd81442e0353fa534d6244",
      "text": "Mas Rizal, saya membaca tentang Pangeran Diponegoro di buku ini.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2187f14ab57bb443f7e65dbe920d1d9b1ef5b0d853c92fdd8f72b8fa3439facd",
      "text": "Mas Rizal, kenapa 10 November menjadi Hari Pahlawan?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "289189227f282f0ccd203b712f6043c5c8aeb3b51ac751c86c83a8dbee392c5b",
      "text": "Beliau pahlawan dari Jawa. Beliau berjuang melawan Belanda selama lima tahun.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "28e60c8122a59a9552f1076a9e3105a2eae1c151019583c482c94a0efc35ba56",
      "text": "menenun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ac1dae064b350b4a343e7a0cbcba286bc3eaf18089ebc39468ec880dc2baab7",
      "text": "Banyak pahlawan berjuang untuk kemerdekaan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c5bbd85b5042a577fbbe4798e1b2fd527a38277e1bc3564cd86a0ad3becd1da",
      "text": "Pada tahun 1830, beliau ditangkap oleh Belanda.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d1f445404f4a06e8c9c45576a00a6d3bec836e04cf1fc56eefb10a5a8625459",
      "text": "Rumah adat itu ___ dari bambu dan kayu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d36f636a454815ad6824a805b6191ce750e1cb395e92b484f1685a616e7ca68",
      "text": "Kemenangan itu sangat mahal. Banyak prajurit meninggal.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f2a0bf666c426160cc8226faf66281da67dd9af8536f79d4594e75a665737a4",
      "text": "oleh-oleh",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fbc937c6e67d65e346119d4cd75f334265814ca75eeded8aa1a0549aad3376f",
      "text": "Wakil presiden. Dia juga pernah menjadi perdana menteri.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "33227527525609ebf7218d6417c37fc80266e21e3839be630f25225edf7b728d",
      "text": "Beliau lahir di Pancor, Lombok Timur.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "33b961633339dc1d61c8bd8ac14bd5dffd950d655adfeabc35db787c3636e4ff",
      "text": "perjuangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "345f58ca0d6b645c695aed121ef2ae69a30c92dbcb803157a1df5ee43c360881",
      "text": "Lantai rumah adat dibersihkan dengan kotoran kerbau.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "35490de91568da4db0baa90ed96074630fe733d285f8711902c5281fc4365aa6",
      "text": "membangun",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "37575354cfb4db35ac44e547e12b707397ee46f25d7be1183863ac1118945048",
      "text": "kemenangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3768b436c3eb75dc18051771492b65902560f65e63b717457e5f0a2a993fe2ca",
      "text": "Tuan Guru Zainuddin adalah seorang ulama dan pahlawan nasional dari Lombok.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "39614de71fc4b7b0bfddb95273afeee22f702178a0ee2a0f830ef5359b5c3e24",
      "text": "republik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a2c794b82d6ed87a39b77bcb2a1327dbe47d60a6f2044b07120109e0c4957d5",
      "text": "Surat-surat itu ditulis oleh Kartini.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a6a320fe62c7cd853f492fe3cffece51280ee44925bdc673ee29c5041811a26",
      "text": "Foto ini saya ambil sendiri.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3adcbb2181886498fa7f289274cee60e471b56fe7f4ee3640522893b77aea747",
      "text": "memimpin",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b3f465cadd209f29da34ed47e4d276ca5b12ba82219df7b65978495a2987901",
      "text": "musuh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bb053ea5f1715091c9850fb4469e227b78582bb53328aef1b7d7d88c82c539b",
      "text": "menteri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c451baae1547e813987feb3553b0e49bec1e68376388209ef65b48d17ae2426",
      "text": "pahlawan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c7a0b3be203582fa6cc9fa756ed48f7569033403280cd514ec9c96e6ec80a9a",
      "text": "Ibu-ibu Sade membuat kain tenun. → Kain tenun dibuat ibu-ibu Sade.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ede58a6d9c9f43bad6777c5fe715b51a18fc10a314b207f0e4e063c05c200c0",
      "text": "perang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "402c9e991c31e7c63ee11c6d917d72f5a3a104a36a9f9c5b1be655484169ba01",
      "text": "Wah! Kain tenun ini juga dibuat di sini?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "43789320997a7b755c1ac6964b9a0086c018368398c169e3f0fd19722272b387",
      "text": "Sedikit. Dia lahir di Jepara, kan?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "43a375e58f3a418d1d247f484a34235f2dd276996c15447e46cdc632ab70f857",
      "text": "presiden",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "46224a930859da69532a21db310e9c0632dd6587fc5eb9cb408b27010702bb50",
      "text": "merebut",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "477dd296bcb94c2a2a3391d8f0062e9fca6dbc2283708e195781baa57d98f3fb",
      "text": "tuan guru",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "490764d9ac967862b7795a82b1bb84b2ebdb344a3069f31655164cdec370bdd3",
      "text": "Foto ini saya ambil di Sade.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b5843bcd634e9f73a83fc60d09aba2ee3632bffb9bf80451b782311a2e2423a",
      "text": "wafat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cbde2a575ed4fa18015e2a591121157c1d0fdbd4948644c0ca2a7e14303e535",
      "text": "Sekarang Indonesia bebas dan damai. Semoga perdamaian ini abadi.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d1f6baa7b82b6c8ed2204699e160e673a30bf8d01b98e3de4374a0a0327c7eb",
      "text": "berjuang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d5068a827ee4ca18b99a061fa9c55564f200fb368b1f377cebac74b785ca9a1",
      "text": "Soekarno dan Hatta, pemimpin bangsa kita.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5072a8e859156e8f670da6e3a01fa1f6309078a88c09e48588296b2f80cb22eb",
      "text": "Soekarno presiden pertama, ya? Dan Hatta?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "511eb164afb36f40129f0e20fb1cd8cff7d5e035d7c845ba3a2da2847e5c18f4",
      "text": "mengambil",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "52a5d463de4709c039e1c8c70dca112434bea9555bdb45b97047aafeaa0d1e2a",
      "text": "penjara",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a0133a53a9778b8d9f33733e3d5ba95e28aaf2cc83ec262fbeafc00f6a845bc",
      "text": "Tuan Guru Zainuddin wafat pada tahun 1997.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e1cd7f5342372855e5b0f50909e8b65d59e8c673cc768527cd93f98b3e47bcd",
      "text": "Karena pertempuran Surabaya tahun 1945. Orang-orang Surabaya melawan tentara Inggris.",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "623fb81d0394b270fc82a075e62ac07cbd764d0cb5ac1f3993104a19d0880c01",
      "text": "lahir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "64100cfe5e720b5e0316c59d4c600c5afeca08fbbed68528ca4851686fbc9bb5",
      "text": "pertempuran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "66a76f56574d3947f74b8637d0796e85323d561e695552e741d05d632a50c274",
      "text": "kain tenun",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "675d5ab29ffd7ac787f07a34347dc8c396a10dd1200e95ffbeb68e8e97db3653",
      "text": "Ya, kain ini saya tenun sendiri, selama dua minggu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a70a5096514d4236e334b8eb04390b13ea0534f3cc8989eeabfb82e30fff734",
      "text": "Ya, kain tenun ini dibuat ibu-ibu Sade.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cfe867e081f1804afe0e0e3cf1436171c501c35842b70a8f20637d055cba393",
      "text": "Betul. Beliau wafat jauh dari rumah, di Makassar.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "72549564f79b1802f9d90ce1594640c225663f527e6dc69b53da7ac21a1a00b6",
      "text": "Soekarno pernah masuk penjara Belanda.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "7279d0c74412cf87a56bdf54420fa1edb7c06f11fe2f0f69dc83a97bd109d98e",
      "text": "sejarah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "732761526a099f138e67e9bebc745413b5311633b4991714c7455c32792010ba",
      "text": "Perjuangan mereka sangat panjang dan berat.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "74bd067f3a5c07c8e4218fc0d9ac7b85b4eddc1a55c96815475d0bdc0e389df2",
      "text": "Pahlawan itu ditangkap ___ penjajah.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "751fa09324d5d117182abb7535ab94a4a1bed0201c1f31413437ffe9167fe969",
      "text": "Mereka berjuang untuk kemerdekaan Indonesia.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "766c9c59463e8752d138858d24f8f6539cab7795a51cc9c1796d42bca22546d4",
      "text": "mengunjungi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "76b11855980bbed77d9e481e3a7c5ace6d4fdc9f5f48d1a5c495222830ec4088",
      "text": "Email Anda sudah saya terima dan saya balas.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "77b4269a8d1ea2e0423fd561926a7cb72eb5baaa2a67d5e5e91f11d2907cf7de",
      "text": "Kartini diangkat menjadi pahlawan nasional pada tahun 1964.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "7969c71bec09c82e78e6845eb3a6023450dcf568549e839689bb0914c289356b",
      "text": "Rumah adat ini dibangun dari apa?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ca72563f203199720956ec73ed6639128a47bb2945d50946cbe29647a801e10",
      "text": "Madrasah itu didirikan oleh seorang ulama.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d224a0f55f10479d39e13ca16d6048ff23eb7590acb43a029dfeda202883ecc",
      "text": "mendirikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "81a615153e4ffd29ba28abfd5ed711c30cf46ebb1d3a060574b31c38574f1ffd",
      "text": "Presiden pertama Indonesia adalah Soekarno.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "834a6c9c0ad0b25718aafc360ccfaac2f0ea8604abb8cdc928d5ab2b2982b3a4",
      "text": "Lalu dia ditangkap?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "8478a774291c4dc02ae56ab61961a51bbd98c3aa88370d39d9e69cd7e7df2042",
      "text": "Ya. Perjuangan itu panjang. Akhirnya Diponegoro ditangkap dan dibuang ke Manado, lalu ke Makassar.",
      "voice": "id_ardi",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "86ad21ab6f8bfe5dd8e6469d353b8171e9dc2c22ab8e4e416c3d46dafd7d136d",
      "text": "Diponegoro melawan Belanda dalam Perang Jawa.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a904f9a41f2cd8c1607030ecca444aefb8412ecdbb2d0794b2641c302df1aba",
      "text": "sendiri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b31a0f0b98667fe3fdfec9f3b0e9e3bae33fd2fabfdc0f23cfd5bd9494bec2c",
      "text": "melawan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf00ce693b95330ace629b47fbd21e3949ff45b219fd35d97537a57d96ceb21",
      "text": "politik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cac6832c5d0678b516c0e3fd92f45a38418030280629bf4c21d97859efdc031",
      "text": "Pahlawan itu ditangkap oleh penjajah Belanda.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8207e9592b610e7e221d33a8c04d57d90b52a81b82e267ee8dadf3d5f2eabd",
      "text": "Desa Sade ___ banyak wisatawan.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a0ed401f6ac29faded70421b179814ce4d6edaadfee07b2eb500906597e2d8",
      "text": "Wah, kain tenun! Dibeli di mana?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9109947694a378c1150506b3fe3bc69bbe45e617091d84a5b61e89d9af54eefa",
      "text": "Betul. Dia ingin perempuan Indonesia juga bisa sekolah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "94e6416ecf301e27cf87e82f11b62cd23cee48e7b6aeda150732b5d628d8a584",
      "text": "Mas, siapa dua orang di foto ini?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "953880f51a7268e1b89ee7a461ee571b31b5db25d42c295a4cef8126a5df71d4",
      "text": "Beliau berjuang melawan penjajah Belanda dari tahun 1825 sampai tahun 1830.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "96daa35555f1584e23146da42b915a253c60d7293fdf6443eb0d4434567501a4",
      "text": "Buku tentang Tuan Guru Zainuddin. Sudah saya baca setengah.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "989f3e825cd05ad287be926f9ff459bcd2fe5acde6622f03805ecf4647320a28",
      "text": "pasukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a0046c2fd54787682747b85671abb7520db3034a6ac6685c4add378c84bcac9",
      "text": "Ya, dia ditangkap oleh Belanda pada tahun 1830.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b3d22791983412a762405915251cc636af0490436b9417279341716e9bc9608",
      "text": "Pertempuran Surabaya dimulai pada 10 November 1945.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b51f9937a0e5d32956f043cea4536229762578fe6a22f6f4a89a2067db74328",
      "text": "Pahlawan itu dimasukkan ke penjara oleh musuh.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b52acb5b8167a8afd5ad9505c60925597217975ee1fd1b94a31a3b628ad067a",
      "text": "Beliau mendirikan organisasi Nahdlatul Wathan pada tahun 1953.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b9eeeb0a1e90c71febae45583e5d62e0636d3795dea6883c8a844d666ba233a",
      "text": "Buku sejarah itu sudah ___.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cd3f768365d4a8fcdc2bd31a145297b60b3ef19ba9b5d21756d978ee34e1237",
      "text": "Banyak! Misalnya Pangeran Diponegoro. Dia berjuang melawan penjajah Belanda.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d2526af0d3220573b4e11079ab933dde36e72bd615e7cbc3c86a239aff40bf1",
      "text": "Mohamed, kamu tahu Kartini?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9de8016c90e0e116326dcd3852aced5bb7fe79ff6d9f3ab3efc470c328fedfc1",
      "text": "Buku tentang pahlawan itu sudah saya baca.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eb375287b5425a5ce6ea50cf3944680c22947ad42992c429c11517635349187",
      "text": "Ulama itu lahir di Lombok dan wafat pada tahun 1997.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1af0aab5111e7e74d70c6cbd8b903e93671d48985e1b8223b489e30bdfbbdf4",
      "text": "bebas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1f9ffe04ce56c67d5e2ed03eb6619d3cf6f08c122a86cd9b59203f7898b0a8b",
      "text": "Belanda. Pasukan Belanda punya senjata yang lebih modern.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a20088174e4230890babde9c5cde22cc9f3e8f95ab4a6a8c483964fff814ff70",
      "text": "Mas Rizal, siapa pahlawan nasional dari Lombok?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a39d4a5205d14b41958dc178609ceb75efc125cf34090545f07779a39c5accd7",
      "text": "Kartini lahir di Jepara pada tahun 1879.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4b9979af26f785ccf1dce9a2d149efe569d2b31a790de75f869d802be7d32d2",
      "text": "Di sini tertulis, beliau ditangkap oleh Belanda pada tahun 1830.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a549c0995c832ac20c6fb9000950409b8eec78c544957e146bf1bf4eda2b2158",
      "text": "Tapi orang-orang masih melawan, ya?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa4d223b94806a4732090d71e1dc7f2a11bf67646f78ff90cf11f44128c7369a",
      "text": "prajurit",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf1e78edfbae74937e3b6bde460bc05f6f9fa69af26295f5b1be6ac97485aa7",
      "text": "Beliau seorang ulama, ya?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "abc6837c68a467b394e97aa0c154f4fc7f288e7e3a5e555f0e84cb7dc7e430ec",
      "text": "Pada tahun 1973, beliau ___ menjadi pahlawan nasional.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad7b29133c4bb65236b01dafebf584cafaac3a5254bcb02fbba3b3623265cf0e",
      "text": "Di Mesir, Gamal Abdel Nasser juga pemimpin yang terkenal.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae57d878920bca3b1c489cb0afdaf58cfd981f28265446ee7204d760050608fd",
      "text": "Rumah adat ini dibangun di Sade.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0153d2bb2907dcdd215fc3978cacc2598099851b3d81a0c00c80f3f7946315a",
      "text": "kemerdekaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0997019f729f83cb3e11b4761cc9fe852a754a58caada6ae048a8012aac4d1c",
      "text": "senjata",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24f3f455d45061e1564e4a527da3e785682a65914f87f3f58fd8c95d68af077",
      "text": "Para pemuda merebut senjata dan melawan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4d84f2cfb2528646e8e8d6eb91b476479bb25d77623c9a2a31bf3e5b3a29561",
      "text": "Kain ini saya tenun sendiri. Bagus untuk oleh-oleh!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b557da68ba8e4e113dde74ba735fdc631e54134336af72cfe06482806eb33293",
      "text": "Bung Hatta adalah wakil ___ pertama Republik Indonesia.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b67bc5228ede4e7ded56a623e5e9d6f6ceab80573118132e1b2360a1fa522885",
      "text": "Pangeran Diponegoro lahir di Yogyakarta pada tahun 1785.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6947e0da951ee52f0aabfd9cb86a54d1739a89fa75750cc18f1ce710c5fdba9",
      "text": "Apakah mereka menang?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "b856c20731e46c250535d550545ded52146821d99a6db980ccee1aa6377df246",
      "text": "menangkap",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8740b412f32d2d3b8f2d90029372928ffe8b708c7d79f5e9d04b240352ba976",
      "text": "Saya membeli kain ini. → Kain ini saya beli.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2c08777e6e2d1801dd80e7d57ec744ebeeeea05b630d8863a1f8226230d7d0",
      "text": "Pada tahun 1830, beliau ditangkap oleh Belanda. Beliau wafat di Makassar pada tahun 1855 dan diangkat menjadi pahlawan nasional pada tahun 1973.",
      "voice": "id_gadis",
      "chars": 144,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb798f4ecd5861ea8bd863e105bbf25a0c0966f1bffe5fe7918bf954f3f950ba",
      "text": "Bu, kain ini Ibu tenun sendiri?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc52b774bb2adf90afe2da858ffd3583f4e3483f4e1b46f3fbd5c12a35bd2f9a",
      "text": "Sejarah kemerdekaan dipelajari di sekolah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf3016d1241d95a6e057a002e1697c44baed3fd6c65e6fa500a86d3b550cd6fd",
      "text": "perdamaian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1423040dcd52f05de7add49af9ec0da4a4699e8bcb2c762548271e0b8e3497d",
      "text": "Sejarah kemerdekaan Indonesia dipelajari di sekolah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c274fc488d2bfa4f08bfa6cf795430d320b201f4309c1baa5fa0dc52c766c12a",
      "text": "Dari bambu dan kayu. Lantainya dibersihkan dengan kotoran kerbau!",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2c166d2f54179c8c02a515733ef21c21806ea147029271b88edc30270d27b24",
      "text": "murid",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3563b69d7994f51d7ea36c144397ed390dbe2e6068e06eba31eb0afb4ed8e29",
      "text": "menyerah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55bbf937768c3ede2c2f92b732516d7fb2a6b1429002fd32431f378ce4ec9db",
      "text": "Kapan dia wafat?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5baf2d3921611b3ab0819e95271e4157b41622544b5a482b7d3e65401c95e75",
      "text": "penjajah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6e7b8c7a9e0f919b39aa10fafcd3397788063f60501e2fa80f128a98c118eac",
      "text": "Pada tahun 1927, Soekarno mendirikan sebuah partai.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9a07a00baa5d7e786e0aedd17e0a6f116f70255612060268c7726cbde78e236",
      "text": "Ya. Beliau belajar di Mekah, lalu pulang dan mendirikan madrasah.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d231ac616865df2449d806557c37bcfd2f32a6a35db41e8594a370f9f2e94c28",
      "text": "Kartini wafat pada tahun 1904.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d80a4fef093e593f47a3d09152961bb751ed5a48d7ffe2400539ad17dbeceb60",
      "text": "menerima / terima",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d82f1b57302eb96e3a9d457c898658842e8c246c922f9d5c467111befbc5746f",
      "text": "Saya membaca buku itu. → Buku itu saya baca.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d90e357875a7957d294b669b6f125e923b4a822b8e185c39ba8ebb4ed268addb",
      "text": "Murid-murid beliau ada di seluruh Lombok.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d931194d7754de64806c3a93a462504f0ca33340da604127ac3f333e2a2a5c87",
      "text": "beliau",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d95a632b79d4592ed318147817732316bba94d913a841d6b18c1d11fa5c4452f",
      "text": "Soekarno adalah presiden pertama Republik Indonesia.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "db0f7539018652f28805b646a615af836f8bc19022d1496bd623616fd75e9284",
      "text": "kekuasaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc3ee50744eb5a7345abce951a222723f1274afae98d7e506f4046e4310a0afd",
      "text": "Sejarah Indonesia seru sekali!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc7313ddf206d8adf3be0183316fc3e0727988a2fddb4d2eccf0b81e3611749e",
      "text": "Sedih sekali. Tapi sekarang beliau dihormati sebagai pahlawan nasional.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcbb45b3dac175adf828c03e2499f3258221d112961b088942a289b726b387cd",
      "text": "Banyak wisatawan mengunjungi Desa Sade. → Desa Sade dikunjungi banyak wisatawan.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd82fd83a5bab3f6f51184987b49058a1cf2f425f8ff3a60ff855429d5215cfb",
      "text": "Rumah adat ini dibangun dari bambu dan kayu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "df7fa0d995d0e3c8cd992faff9cc3c30cff4efa11fcf2ef0c6986382076a18dd",
      "text": "Ini Desa Sade. Desa ini dikunjungi banyak wisatawan setiap hari.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "df8f3d2591237afb7bb3ba4a006f1414f4b6b4dabb700bca348db0f067bf59a0",
      "text": "Pemuda Surabaya merebut senjata dari tentara Jepang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0425cab639cdfd0424d16fca3fa16f82bf368f354385b53fcd4efcc03026773",
      "text": "Setelah perang, ___ Jepang tidak punya senjata lagi.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e12001d5203af2c8e68ed3b929941ae3c7c692280689da6b842f8f44ab61d7f4",
      "text": "Kain ini saya beli di Sade. Kain ini ditenun oleh Inaq Sumi.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e263210f19318ebefe7e1e464a2442e430a57f4d37c2a9fb53dc3db63e008e8c",
      "text": "Beliau pahlawan yang sangat dihormati di Lombok.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3040ffa05594facabb37c7c866eafdddc8ca7a16eba45144ea62f6d444f53db",
      "text": "rumah adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4d24c38e4fdfc98f7551e9715e914b0203aa6520ee19bd29697c632852fc832",
      "text": "Hatta juga pernah menjadi perdana menteri.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e74d0003725ad3ec14d7702f12e62782752c7642491d6263f1448610e546b675",
      "text": "pemimpin",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e807e6435e981c8784fec357c55d8714148b6c74b2597ef7a2e9f472eee89ea2",
      "text": "oleh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eafc4b3cd750faece6daf7543bd4cd921544fa8492eb0661bc0d8991290de020",
      "text": "Pahlawan itu ditangkap oleh penjajah.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee742a2046498e8343263c06dd85387198678ead6e7bc62316858d99bb38eeb6",
      "text": "madrasah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "effee848e0465ef4affb2a20cf4df908ddd2b7fbd400af30e2251d2cd4d00158",
      "text": "Pertempuran Surabaya dimulai pada 10 November. Hari itu sekarang Hari Pahlawan.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5dc70fb841b008355783f145f3b539c6ba77227f6c002814771e62d8d6e2dbb",
      "text": "Kota itu kalah, tapi mereka tidak menyerah. Keberanian mereka adalah kemenangan.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "f60b269b20f9efd43a90a0724fe398c84a1918cc510cbac7c5681cc7b87d97ac",
      "text": "Bagus sekali! Kain ini saya beli untuk oleh-oleh. Boleh saya ambil fotonya?",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6d46a443ccb2a67239181438dd370efd8da033668184a04f2b2448813d62a0b",
      "text": "Tahun 1904. Pada tahun 1964, dia diangkat menjadi pahlawan nasional.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8e9b03801f96fef9b2a40b70311aff59d82f86f4ee81e4571fef501c324ac3c",
      "text": "Merdeka! Sekarang ada perdamaian. Ini ___ kita semua!",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc16ad4ab78a5e5a90135082fe58dae9692322dadc38e5409353175e8a3438fe",
      "text": "desa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc4203f4ed211104ecb9e82fd7cfe3211bd254775311b306d462837a31ba21de",
      "text": "Pahlawan itu ditangkap oleh penjajah. Siapa yang menangkap?",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcd2caee392946aa2b3a53d43c2a60222088de1f17e3e603621c7282d1c2f0ee",
      "text": "Mohamed, ini lukisan Perang Jawa. Itu Diponegoro di atas kuda.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    }
  ],
