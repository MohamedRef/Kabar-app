    },
    {
      "id": "bipa3.u07.l03",
      "sha256": "5a64be59a82d008454a3c49504badda18401f8bae4e2e04cc8b7778c29b0361f"
    },
    {
      "id": "bipa3.u07.l04",
      "sha256": "9b189dbb28f3c89b23fb1bcb70d1db6533e509530fdcc1233bf780c1b8a776a7"
    },
    {
      "id": "bipa3.u07.l05",
