  "content_hash": "f4e1b8d469b5e6357931c3b1684fc868d3a806b02e29720fec0fb3d55babcaba",
  "lessons": [
    {
      "id": "bipa3.u07.l01",
      "sha256": "8ce1d45edc15ba568c75e4bd1c613b89d6593b0a02223eb8f5e04bb6601af726"
    },
    {
      "id": "bipa3.u07.l02",
      "sha256": "b5c6f2067bd4ca13d41853d71ecf99999df6f39c3606514d1973c8f1696c2c06"
    },
    {
      "id": "bipa3.u07.l03",
      "sha256": "6684a50b50d2fd47c4bf31030bc918380217e93d512a6033e5e2423a663161a3"
    },
    {
      "id": "bipa3.u07.l04",
      "sha256": "62ceab306ec45a0110c89c06f4a62ae2ca5c4fc4bd467fef8a83135b997abbb2"
    },
    {
      "id": "bipa3.u07.l05",
      "sha256": "fa12cd757210fe8c63564ae68757130387f771f7cc159a3f7038450c3cf6d398"
    },
    {
      "id": "bipa3.u07.l06",
      "sha256": "5e5b4169bf9056c25a60bc60ddfad4066fece9eb8f6a834e6d0a10331626be1e"
    },
    {
      "id": "bipa3.u07.l07",
      "sha256": "63170d1db0d55756aa96b3fd58bd90d0ed896d4d2a755b520787ab7e92070a34"
    }
  ],
  "audio": [
    {
      "key": "00292dc78c117322f446c949205698ff56bec4903f5918b35246a82c2be24cf4",
      "text": "wisatawan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0032422e985e39f55de6b576d7a9a107d56fb015f6bfa355d6eef79b3f69afa8",
      "text": "gelar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "01d51be4f08933f461ce06212d75ddeed2b46a4138239b781172b74d7169233b",
      "text": "Beliau berjuang untuk kemerdekaan Indonesia.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "0418e11e3b5ad23ed8d2f8f91b9252db89bd5cbe91a7a4fa386c694f289ae0a0",
      "text": "membalas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "09f90563da3c585385b5590efa3d77771af367dbc0121741d874f5ae52ee2918",
      "text": "Banyak sekali. Pada tahun 2017, beliau diangkat menjadi pahlawan nasional.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c5c0189a2a7be5d6404ef3761eca5e7dfd834cffb00390f53d8e06617c76b89",
      "text": "Kartini ___ di Jepara pada tahun 1879.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c858623195c8a54997da0402aa3b92296b1190a12b0e9f1dde7077216b09fe3",
      "text": "Bagus! Dan buku itu?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e36d82792a663641fe66a709f61cfc9015f1cf6fe84cafa56be4d08842c6403",
      "text": "Mas Rizal, siapa pahlawan Indonesia yang terkenal?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f70373f20c100f031112f12409e0803f333d53ecaea89024ace323a5fa57581",
      "text": "Masyaallah! Murid beliau banyak?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "11500d0a4be3ebf452c6fa9bce4e2bc8e3164a46e0d2aca7441dc13b714df3dd",
      "text": "Silakan! Nanti fotonya kirim ke saya, ya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1178266951dff8311438103cc8a8794b2e24dc87ddc8ef72411c464ca48692ab",
      "text": "ulama",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "12c2eb199d60e5981a92129c113397c706fd0256ddb1ecfdeee825d6e787e939",
      "text": "Pesan Anda sudah kami terima.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "1838e03e774ecda16332a7a34a11007524147a989ee465dc4fdfc219ff074938",
      "text": "Tuan Guru Zainuddin Abdul Madjid. Beliau lahir di Pancor, Lombok Timur.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "19fc2567c4cb0fc968ff7beeb03dcbbe155c8fd7ae55ba156e45c1cc90b9ec3e",
      "text": "organisasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e06acbf47229d12b836ead8519fbea9a756d5d7e2eb8793a286bebab0edd8e2",
      "text": "Oleh-oleh ini saya ___ di Sade.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "200784d6daaa4dd48abe91f109439e651f08cb47f1fd81442e0353fa534d6244",
      "text": "Mas Rizal, saya membaca tentang Pangeran Diponegoro di buku ini.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "289189227f282f0ccd203b712f6043c5c8aeb3b51ac751c86c83a8dbee392c5b",
      "text": "Beliau pahlawan dari Jawa. Beliau berjuang melawan Belanda selama lima tahun.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "28e60c8122a59a9552f1076a9e3105a2eae1c151019583c482c94a0efc35ba56",
      "text": "menenun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ac1dae064b350b4a343e7a0cbcba286bc3eaf18089ebc39468ec880dc2baab7",
      "text": "Banyak pahlawan berjuang untuk kemerdekaan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c5bbd85b5042a577fbbe4798e1b2fd527a38277e1bc3564cd86a0ad3becd1da",
      "text": "Pada tahun 1830, beliau ditangkap oleh Belanda.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d1f445404f4a06e8c9c45576a00a6d3bec836e04cf1fc56eefb10a5a8625459",
      "text": "Rumah adat itu ___ dari bambu dan kayu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f2a0bf666c426160cc8226faf66281da67dd9af8536f79d4594e75a665737a4",
      "text": "oleh-oleh",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "33227527525609ebf7218d6417c37fc80266e21e3839be630f25225edf7b728d",
      "text": "Beliau lahir di Pancor, Lombok Timur.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "345f58ca0d6b645c695aed121ef2ae69a30c92dbcb803157a1df5ee43c360881",
      "text": "Lantai rumah adat dibersihkan dengan kotoran kerbau.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "35490de91568da4db0baa90ed96074630fe733d285f8711902c5281fc4365aa6",
      "text": "membangun",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3768b436c3eb75dc18051771492b65902560f65e63b717457e5f0a2a993fe2ca",
      "text": "Tuan Guru Zainuddin adalah seorang ulama dan pahlawan nasional dari Lombok.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a2c794b82d6ed87a39b77bcb2a1327dbe47d60a6f2044b07120109e0c4957d5",
      "text": "Surat-surat itu ditulis oleh Kartini.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a6a320fe62c7cd853f492fe3cffece51280ee44925bdc673ee29c5041811a26",
      "text": "Foto ini saya ambil sendiri.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c451baae1547e813987feb3553b0e49bec1e68376388209ef65b48d17ae2426",
      "text": "pahlawan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c7a0b3be203582fa6cc9fa756ed48f7569033403280cd514ec9c96e6ec80a9a",
      "text": "Ibu-ibu Sade membuat kain tenun. → Kain tenun dibuat ibu-ibu Sade.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "402c9e991c31e7c63ee11c6d917d72f5a3a104a36a9f9c5b1be655484169ba01",
      "text": "Wah! Kain tenun ini juga dibuat di sini?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "43789320997a7b755c1ac6964b9a0086c018368398c169e3f0fd19722272b387",
      "text": "Sedikit. Dia lahir di Jepara, kan?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "477dd296bcb94c2a2a3391d8f0062e9fca6dbc2283708e195781baa57d98f3fb",
      "text": "tuan guru",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "490764d9ac967862b7795a82b1bb84b2ebdb344a3069f31655164cdec370bdd3",
      "text": "Foto ini saya ambil di Sade.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b5843bcd634e9f73a83fc60d09aba2ee3632bffb9bf80451b782311a2e2423a",
      "text": "wafat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d1f6baa7b82b6c8ed2204699e160e673a30bf8d01b98e3de4374a0a0327c7eb",
      "text": "berjuang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "511eb164afb36f40129f0e20fb1cd8cff7d5e035d7c845ba3a2da2847e5c18f4",
      "text": "mengambil",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a0133a53a9778b8d9f33733e3d5ba95e28aaf2cc83ec262fbeafc00f6a845bc",
      "text": "Tuan Guru Zainuddin wafat pada tahun 1997.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "623fb81d0394b270fc82a075e62ac07cbd764d0cb5ac1f3993104a19d0880c01",
      "text": "lahir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "66a76f56574d3947f74b8637d0796e85323d561e695552e741d05d632a50c274",
      "text": "kain tenun",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "675d5ab29ffd7ac787f07a34347dc8c396a10dd1200e95ffbeb68e8e97db3653",
      "text": "Ya, kain ini saya tenun sendiri, selama dua minggu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a70a5096514d4236e334b8eb04390b13ea0534f3cc8989eeabfb82e30fff734",
      "text": "Ya, kain tenun ini dibuat ibu-ibu Sade.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cfe867e081f1804afe0e0e3cf1436171c501c35842b70a8f20637d055cba393",
      "text": "Betul. Beliau wafat jauh dari rumah, di Makassar.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7279d0c74412cf87a56bdf54420fa1edb7c06f11fe2f0f69dc83a97bd109d98e",
      "text": "sejarah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "74bd067f3a5c07c8e4218fc0d9ac7b85b4eddc1a55c96815475d0bdc0e389df2",
      "text": "Pahlawan itu ditangkap ___ penjajah.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "751fa09324d5d117182abb7535ab94a4a1bed0201c1f31413437ffe9167fe969",
      "text": "Mereka berjuang untuk kemerdekaan Indonesia.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "766c9c59463e8752d138858d24f8f6539cab7795a51cc9c1796d42bca22546d4",
      "text": "mengunjungi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "76b11855980bbed77d9e481e3a7c5ace6d4fdc9f5f48d1a5c495222830ec4088",
      "text": "Email Anda sudah saya terima dan saya balas.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "77b4269a8d1ea2e0423fd561926a7cb72eb5baaa2a67d5e5e91f11d2907cf7de",
      "text": "Kartini diangkat menjadi pahlawan nasional pada tahun 1964.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "7969c71bec09c82e78e6845eb3a6023450dcf568549e839689bb0914c289356b",
      "text": "Rumah adat ini dibangun dari apa?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ca72563f203199720956ec73ed6639128a47bb2945d50946cbe29647a801e10",
      "text": "Madrasah itu didirikan oleh seorang ulama.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d224a0f55f10479d39e13ca16d6048ff23eb7590acb43a029dfeda202883ecc",
      "text": "mendirikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "834a6c9c0ad0b25718aafc360ccfaac2f0ea8604abb8cdc928d5ab2b2982b3a4",
      "text": "Lalu dia ditangkap?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a904f9a41f2cd8c1607030ecca444aefb8412ecdbb2d0794b2641c302df1aba",
      "text": "sendiri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cac6832c5d0678b516c0e3fd92f45a38418030280629bf4c21d97859efdc031",
      "text": "Pahlawan itu ditangkap oleh penjajah Belanda.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8207e9592b610e7e221d33a8c04d57d90b52a81b82e267ee8dadf3d5f2eabd",
      "text": "Desa Sade ___ banyak wisatawan.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a0ed401f6ac29faded70421b179814ce4d6edaadfee07b2eb500906597e2d8",
      "text": "Wah, kain tenun! Dibeli di mana?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9109947694a378c1150506b3fe3bc69bbe45e617091d84a5b61e89d9af54eefa",
      "text": "Betul. Dia ingin perempuan Indonesia juga bisa sekolah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "953880f51a7268e1b89ee7a461ee571b31b5db25d42c295a4cef8126a5df71d4",
      "text": "Beliau berjuang melawan penjajah Belanda dari tahun 1825 sampai tahun 1830.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "96daa35555f1584e23146da42b915a253c60d7293fdf6443eb0d4434567501a4",
      "text": "Buku tentang Tuan Guru Zainuddin. Sudah saya baca setengah.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a0046c2fd54787682747b85671abb7520db3034a6ac6685c4add378c84bcac9",
      "text": "Ya, dia ditangkap oleh Belanda pada tahun 1830.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b52acb5b8167a8afd5ad9505c60925597217975ee1fd1b94a31a3b628ad067a",
      "text": "Beliau mendirikan organisasi Nahdlatul Wathan pada tahun 1953.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b9eeeb0a1e90c71febae45583e5d62e0636d3795dea6883c8a844d666ba233a",
      "text": "Buku sejarah itu sudah ___.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cd3f768365d4a8fcdc2bd31a145297b60b3ef19ba9b5d21756d978ee34e1237",
      "text": "Banyak! Misalnya Pangeran Diponegoro. Dia berjuang melawan penjajah Belanda.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d2526af0d3220573b4e11079ab933dde36e72bd615e7cbc3c86a239aff40bf1",
      "text": "Mohamed, kamu tahu Kartini?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9de8016c90e0e116326dcd3852aced5bb7fe79ff6d9f3ab3efc470c328fedfc1",
      "text": "Buku tentang pahlawan itu sudah saya baca.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eb375287b5425a5ce6ea50cf3944680c22947ad42992c429c11517635349187",
      "text": "Ulama itu lahir di Lombok dan wafat pada tahun 1997.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a20088174e4230890babde9c5cde22cc9f3e8f95ab4a6a8c483964fff814ff70",
      "text": "Mas Rizal, siapa pahlawan nasional dari Lombok?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a39d4a5205d14b41958dc178609ceb75efc125cf34090545f07779a39c5accd7",
      "text": "Kartini lahir di Jepara pada tahun 1879.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4b9979af26f785ccf1dce9a2d149efe569d2b31a790de75f869d802be7d32d2",
      "text": "Di sini tertulis, beliau ditangkap oleh Belanda pada tahun 1830.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaf1e78edfbae74937e3b6bde460bc05f6f9fa69af26295f5b1be6ac97485aa7",
      "text": "Beliau seorang ulama, ya?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "abc6837c68a467b394e97aa0c154f4fc7f288e7e3a5e555f0e84cb7dc7e430ec",
      "text": "Pada tahun 1973, beliau ___ menjadi pahlawan nasional.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae57d878920bca3b1c489cb0afdaf58cfd981f28265446ee7204d760050608fd",
      "text": "Rumah adat ini dibangun di Sade.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0153d2bb2907dcdd215fc3978cacc2598099851b3d81a0c00c80f3f7946315a",
      "text": "kemerdekaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4d84f2cfb2528646e8e8d6eb91b476479bb25d77623c9a2a31bf3e5b3a29561",
      "text": "Kain ini saya tenun sendiri. Bagus untuk oleh-oleh!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b67bc5228ede4e7ded56a623e5e9d6f6ceab80573118132e1b2360a1fa522885",
      "text": "Pangeran Diponegoro lahir di Yogyakarta pada tahun 1785.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b856c20731e46c250535d550545ded52146821d99a6db980ccee1aa6377df246",
      "text": "menangkap",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8740b412f32d2d3b8f2d90029372928ffe8b708c7d79f5e9d04b240352ba976",
      "text": "Saya membeli kain ini. → Kain ini saya beli.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2c08777e6e2d1801dd80e7d57ec744ebeeeea05b630d8863a1f8226230d7d0",
      "text": "Pada tahun 1830, beliau ditangkap oleh Belanda. Beliau wafat di Makassar pada tahun 1855 dan diangkat menjadi pahlawan nasional pada tahun 1973.",
      "voice": "id_gadis",
      "chars": 144,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb798f4ecd5861ea8bd863e105bbf25a0c0966f1bffe5fe7918bf954f3f950ba",
      "text": "Bu, kain ini Ibu tenun sendiri?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc52b774bb2adf90afe2da858ffd3583f4e3483f4e1b46f3fbd5c12a35bd2f9a",
      "text": "Sejarah kemerdekaan dipelajari di sekolah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1423040dcd52f05de7add49af9ec0da4a4699e8bcb2c762548271e0b8e3497d",
      "text": "Sejarah kemerdekaan Indonesia dipelajari di sekolah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c274fc488d2bfa4f08bfa6cf795430d320b201f4309c1baa5fa0dc52c766c12a",
      "text": "Dari bambu dan kayu. Lantainya dibersihkan dengan kotoran kerbau!",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2c166d2f54179c8c02a515733ef21c21806ea147029271b88edc30270d27b24",
      "text": "murid",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c55bbf937768c3ede2c2f92b732516d7fb2a6b1429002fd32431f378ce4ec9db",
      "text": "Kapan dia wafat?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5baf2d3921611b3ab0819e95271e4157b41622544b5a482b7d3e65401c95e75",
      "text": "penjajah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9a07a00baa5d7e786e0aedd17e0a6f116f70255612060268c7726cbde78e236",
      "text": "Ya. Beliau belajar di Mekah, lalu pulang dan mendirikan madrasah.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d231ac616865df2449d806557c37bcfd2f32a6a35db41e8594a370f9f2e94c28",
      "text": "Kartini wafat pada tahun 1904.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d80a4fef093e593f47a3d09152961bb751ed5a48d7ffe2400539ad17dbeceb60",
      "text": "menerima / terima",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d82f1b57302eb96e3a9d457c898658842e8c246c922f9d5c467111befbc5746f",
      "text": "Saya membaca buku itu. → Buku itu saya baca.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d90e357875a7957d294b669b6f125e923b4a822b8e185c39ba8ebb4ed268addb",
      "text": "Murid-murid beliau ada di seluruh Lombok.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d931194d7754de64806c3a93a462504f0ca33340da604127ac3f333e2a2a5c87",
      "text": "beliau",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc3ee50744eb5a7345abce951a222723f1274afae98d7e506f4046e4310a0afd",
      "text": "Sejarah Indonesia seru sekali!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc7313ddf206d8adf3be0183316fc3e0727988a2fddb4d2eccf0b81e3611749e",
      "text": "Sedih sekali. Tapi sekarang beliau dihormati sebagai pahlawan nasional.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcbb45b3dac175adf828c03e2499f3258221d112961b088942a289b726b387cd",
      "text": "Banyak wisatawan mengunjungi Desa Sade. → Desa Sade dikunjungi banyak wisatawan.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd82fd83a5bab3f6f51184987b49058a1cf2f425f8ff3a60ff855429d5215cfb",
      "text": "Rumah adat ini dibangun dari bambu dan kayu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "df7fa0d995d0e3c8cd992faff9cc3c30cff4efa11fcf2ef0c6986382076a18dd",
      "text": "Ini Desa Sade. Desa ini dikunjungi banyak wisatawan setiap hari.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "e12001d5203af2c8e68ed3b929941ae3c7c692280689da6b842f8f44ab61d7f4",
      "text": "Kain ini saya beli di Sade. Kain ini ditenun oleh Inaq Sumi.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e263210f19318ebefe7e1e464a2442e430a57f4d37c2a9fb53dc3db63e008e8c",
      "text": "Beliau pahlawan yang sangat dihormati di Lombok.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3040ffa05594facabb37c7c866eafdddc8ca7a16eba45144ea62f6d444f53db",
      "text": "rumah adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e807e6435e981c8784fec357c55d8714148b6c74b2597ef7a2e9f472eee89ea2",
      "text": "oleh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eafc4b3cd750faece6daf7543bd4cd921544fa8492eb0661bc0d8991290de020",
      "text": "Pahlawan itu ditangkap oleh penjajah.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee742a2046498e8343263c06dd85387198678ead6e7bc62316858d99bb38eeb6",
      "text": "madrasah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f60b269b20f9efd43a90a0724fe398c84a1918cc510cbac7c5681cc7b87d97ac",
      "text": "Bagus sekali! Kain ini saya beli untuk oleh-oleh. Boleh saya ambil fotonya?",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6d46a443ccb2a67239181438dd370efd8da033668184a04f2b2448813d62a0b",
      "text": "Tahun 1904. Pada tahun 1964, dia diangkat menjadi pahlawan nasional.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc16ad4ab78a5e5a90135082fe58dae9692322dadc38e5409353175e8a3438fe",
      "text": "desa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc4203f4ed211104ecb9e82fd7cfe3211bd254775311b306d462837a31ba21de",
      "text": "Pahlawan itu ditangkap oleh penjajah. Siapa yang menangkap?",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    }
  ],
