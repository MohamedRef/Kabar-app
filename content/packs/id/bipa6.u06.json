    },
    {
      "id": "bipa6.u06.l03",
      "sha256": "19f7be2c694baa8400b6a9f6636f0f1b3fdbba25058076a224e894d21de7ae2a"
    },
    {
      "id": "bipa6.u06.l04",
      "sha256": "ddc6a3be7ac9e63fffb3ad5cdcb5f3a62ab819b9bef209cb35eaed893093f6fe"
    },
    {
      "id": "bipa6.u06.l05",
      "sha256": "eb8bf04d0d644b563ab14c5085ed0aec397e31222171bd86b74b39e7995d59ad"
    },
    {
      "id": "bipa6.u06.l06",
      "sha256": "ce4e6e827a3c23c8e73a16629a21a2121b53442f04404bf5dc2689b0902f7173"
    },
    {
      "id": "bipa6.u06.l07",
      "sha256": "dc857a49fc410970240f9a760c09d89df6827063284af0c6b0368422889ffd31"
    },
    {
      "id": "bipa6.u06.l08",
      "sha256": "ca0872c46c9d543a54f397aed65c7dfb831439b51172e82076acb4293cce4a24"
    },
    {
      "id": "bipa6.u06.l09",
      "sha256": "49fcb04d4e80902cfff53c84fc7d4689985da29bf34f22373c9ab0520696dc5f"
    },
    {
      "id": "bipa6.u06.l10",
      "sha256": "7c5098035d57e55a468edf22ba347706cb1dbbad604669ed827c1384468d4764"
    },
    {
      "id": "bipa6.u06.l11",
      "sha256": "7055146bba8f8e143dfb63075c9474a2efa1a4c5cc7373416125704b90d02351"
    },
    {
      "id": "bipa6.u06.l12",
      "sha256": "f7f64f2094f93637f040f0c1c6b6b1f9948c88891fe09c3164cc0ad137d80a77"
    },
    {
      "id": "bipa6.u06.l13",
      "sha256": "f8b2b0d483ab7ce1b2940eadf0d3b799a9be7afaa0dfd4d03454957f99ad010a"
    }
  ],
  "audio": [
    {
      "key": "00bd2908a2e2f5eb9208f8690c9181f36d58614a26bb34ac3b81719374f41990",
      "text": "Pisau ini tajam, tetapi gunting itu tumpul.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "02c4c9d182d26e8b3c07d4850082f650053a4ccf20e5fdefb1c754e2ce70ffc7",
      "text": "Lihat petinggi gemuk itu. Slogannya 'Melayani Rakyat'.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "039a4ca2bfb9b502dd2852e7091fdd29da5b8560628c07e726eb4349c6b72f7a",
      "text": "Janji kampanye itu manis, tetapi sering dilupakan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "04c72409132b9d1e857f6ffe9281f37afcd90c2445e221ebb77ca01b50cee34e",
      "text": "bicara",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0791b123ffa60e5660f9ec9b0dd2708f47bb8d1ab1375249344df4a4f74eaa07",
      "text": "Orang Indonesia biasanya menghindari lelucon tentang SARA.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "08dcfdbbca4afb06c6255019b923dc2c522c33f8bd53c1b3bf813f4474a73583",
      "text": "Warganet suka membuat plesetan dari akronim resmi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a93293474d69e7fdb67e5b2dc63f19e167dde5560e93050ad8701e8fe0835ff",
      "text": "Lihat meme ini, Lae. \"Gabut di Toba, tapi pemandangannya mantul.\"",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ad80c21c9961af837700554fb01f9c9bdf5fdbf1e4f532dd73a69a205f65a39",
      "text": "birokrasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c29229ddaf6aeec52d927fe20d0f6b07dc28f7c6ddebe472f31b8172e3b9c7f",
      "text": "Oh, plesetan! Warganet di Mesir juga jago gitu.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c35f2cb3d9b882139958de2ece45ebb91fbafd97c288616fdcc1487d3cc5e4a",
      "text": "Kakek terkekeh mendengar tebakan cucunya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0da47d82145bafd6b48cba2842e303cd7abf34554999ab2da13b319546504c8d",
      "text": "Dia galau, lalu curhat kepada temannya.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f2f31f8a7458e95518d69a0611bf2b40c83f7cdf81b03443f47b608f5e323ef",
      "text": "satire",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "10dc75f5b7d3563670fac44999108f4862219a18ab01e0882fe776d6c2d848ac",
      "text": "Aku nggak bermaksud menyinggung. Mending aku minta maaf.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "11151f38dc6bb534f3c934ecddaeaf774338f304bf629a64271dcf10a353c122",
      "text": "menertawakan diri sendiri",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "132123d578396770a8ac5f1dd5e680b4216b067656e8029537b31ef706c086d7",
      "text": "karikatur",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "132ee9ffd61409af753b6ca26d302f5a30fb2e37e1e0b5cdd3b5e0315b968acb",
      "text": "Slogan antikorupsi ditempel di kantor yang penuh birokrasi.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "16ec0471c58ebb59ce57b0389cb5c7865f8adc85b2350a177efd8e5b2ec5ecc0",
      "text": "Om Pasikom memakai jas penuh tambalan, simbol rakyat kecil.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "16fac6221504582b79a0640c02184fc5c4ea6d11963d8fcff8b55cf63cc4e2b2",
      "text": "Bang, tadi aku bercanda tentang suku temanku. Dia diam aja.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "17cab03167d7122e8b3c05656241c0b7d8e243c8754ba46d6b3a37d2035d97d7",
      "text": "koalisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "17e2ad390df2f24765056508535ef63840aa677d362a6b0928c899a7d3352602",
      "text": "Ha! Itu ironi. Kartunisnya pintar, lucu tapi menggelitik.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1946ea1a7a75a8624f134778aad3a89bb9d618915057c98cc06cbe8c55adbd9c",
      "text": "PDI-P, Golkar, dan Gerindra adalah nama ___.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b2d357d3419f4ba8c4f22d6a8b2de894a7e8026cee08b6f81c44153680ec0b4",
      "text": "Lelucon itu jadi viral karena plesetannya pintar.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1df3d0273ece89f5217627abed58214d3fd55b94aae6d5083c75a8414a6de8b4",
      "text": "bercanda",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e4d9740b015623ee1481915c081d19dc6d9280786e6f597829ddd89bc58b9b4",
      "text": "Jangan sentuh perutku! Aku ___!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ecb828de178003d20bd34d1b44c0d268ece6f938c58a1e357115532694b339e",
      "text": "Aku nggak tersinggung. Terus terang, aku suka cara bercanda kayak gini.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f5059606b083784e5bcbe1facc633e63361e5a0d8d7b24df60d3d65294a5a43",
      "text": "Lawakan Warkop DKI konyol, tetapi sering menyindir keadaan sosial.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f8ab743a808bc1d90f315d70ce94d337f225a6173d86dccd3db70a40b0ddd73",
      "text": "Batas antara kritik dan hinaan kadang-kadang sangat tipis.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f90e1bb75b80ca5e1a3d0e5d7a241d324b73e0c8d09bf5cd55ba395e28d1ea0",
      "text": "tumpul",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "20bc09223fe4df0cae9244e3cd682bccd6e827d8bd5f821a1555d645d632cbbb",
      "text": "Warkop itu grup lawak, kan? Kayak Tsulatsi Adwa al-Masrah di Mesir?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "2340920d481487cab89555ecabec88e49d24783b1300f1e22dce10325437118b",
      "text": "Komika itu memilih menertawakan diri sendiri supaya tidak menyinggung siapa pun.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "24d50e69f234831e54ad0c747dd5aeb692e831e307249bebfad5584cf6e53d2b",
      "text": "Lihat ___-nya! Seperti tidak bersalah.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2556d6015f5538d638b07b76de632fc20054a8922372089a9106275e04f9a503",
      "text": "curhat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "269b21a91920e4d9f955f4bda9abd9ee764fc4f259f5e875eb50ef5306c53a48",
      "text": "Berita satire ini heboh karena sangat ironis.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a14c4b5ec22484a4a4b4c7cde3bb9b32daa7ca435d29324d639660760b034d1",
      "text": "Terus terang, sarkasmenya terlalu tajam.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b690391600e06c4fe0987c58e3bf596f2f972743185a0262c424d9cc51503f5",
      "text": "sindiran",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bfe450ea14f317865a5a013ca1e801b96ab73f24ca9ab1bf9f8215b5a571161",
      "text": "bergurau",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d092ca42ebde059b295ff7c7c8af3724c37285aa3c97a5389f3906d4ad3d8f6",
      "text": "gelembung kata",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d5c449a9723c77bd9486f74f9d95e5e9156c368b0ea3db407c5156d7ee27788",
      "text": "Iya. Lain kali, ketawain dirimu sendiri aja. Itu paling aman.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f209eb466e86fb1dc48c25ac19393ba57ad61fd1747c41fb50b9184775ab5fa",
      "text": "SARA",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "30a130dd8f7b5c7d1611061c6121384162006b5c373cc2b30493bb90f57bb6a4",
      "text": "Berita itu heboh, tetapi isinya remeh.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "33301ffc7277d4723410dad7f7c3976791b7bda08432a0b2a087b35016c93868",
      "text": "Kelakuan politikus itu heboh, tetapi tampangnya tetap angkuh.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "33368e3c1dee61299e61b4eb480fcf7959fbb67d1de752a4e81970abf44161b9",
      "text": "Bang Togar suka bergurau dengan wajah serius.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "37db282872e98f94a62c857b1904275dd8b60fc156b263fbbe1ca9e6b3ec7bd8",
      "text": "Grup lawak itu menghibur tiga generasi penonton Indonesia.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "38cd2ddd00bed4842c702c459db87cc07b22f445954ec4a0ea21802ce3571a8e",
      "text": "Mohamed, tulis satu berita satire buat majalah kampus. Tentang apa aja.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b07d6f445d204fbc7e76e0c03bfd57e67fb89afabd43cfbe16a83ed7178cdf5",
      "text": "Saya lebih suka menertawakan diri sendiri supaya tidak menyinggung orang lain.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d214910efd755d709b506a0402d02c456b629592434317a0f330c34544c8a63",
      "text": "Ha! Itu satire. Dia menyindir pejabat yang malas.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f08fdf2f38fdefc78d5c1a677e980bc036580ffb9aa13921b97cea41fd02415",
      "text": "Mantul itu akronim dari mantap betul. Gabut artinya bosan karena nggak ada kerjaan.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "4125aaef4c5f86b203d3e4062f9e385413401b74196f35b0e272852612210076",
      "text": "Pelawak yang baik memang menghibur sambil berpikir.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "41eb53680c6ae592d4d03d09da3bdb0fb4fb8c901ae33acc2b7b6d1acfcab291",
      "text": "menghibur",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "434ca166c03ccdf75fb89588487530dd471ee8b1570a866ca6b942e010007ec4",
      "text": "tawa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "442f064e730b0e6592f36d44ca4767570bdb4f90ace2121b1747e5413ea60d37",
      "text": "Tapi dia duduk di atas tumpukan uang, dan rakyatnya antre.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "447d47b32b41d3b6a81c8de485bba7e13d77645506290ffece582ca9e46b6525",
      "text": "Hahaha! Abang emang iseng. Tapi orang Batak nggak marah?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "45e5b292baaca992965fab00c319e63535036d87ab40b2ddf39218b895700537",
      "text": "Ini berita beneran? Heboh banget!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "487c41a4edd430682f515131b78de2831d7c3973195e4ae005b1dbcbe73e40da",
      "text": "Pelawak yang baik bisa membuat lawakan konyol menjadi kritik.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "48d8d6c1cb9d97a223305a5f416583e01aeb1121d67865755522f99696d6d77f",
      "text": "Dia tidak marah, dia cuma mengejek sedikit.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a3ef47c02235ffc0765eaa546f63cc37a4b6eeadfd769d5e8af2153c05df1e3",
      "text": "Koalisi dan oposisi akhirnya sepakat tentang hal yang remeh.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a58e20d33fc6dbf19261d8ea392750be1bc96b85e8b59686769a508c7a424d3",
      "text": "Betul. Lalu di gelembung kata dia bilang, \"Saya dekat dengan rakyat.\"",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a5e7f49558abf10e95b2f9dab0311684b311b583a3257db4217f5e238592e5e",
      "text": "Di Mesir juga gitu. Kami ketawa biar nggak nangis.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ad5ff5de1f1a80216525a4278431515bdb346a52d3915b3e33cbff1ecafb2b1",
      "text": "tampang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b4934ddbb405850629532df5eae33650b2018c6b22227e4cbc6c168398911a0",
      "text": "Bapak tua itu terkekeh ketika kami bergurau.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c86252fbe8d0555e74820d9e17e41dc435f1e8f5ef713be3eeeffbb5d8610f5",
      "text": "Wah, rajin sekali, Lae. Kapalnya sudah berangkat dua kali.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d50050bcc4359f5854667ee83c5477e16482130f9d16dc87c9bb614b5d44526",
      "text": "Tawa penonton terdengar sampai ke luar gedung.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e929808cfd409b3899638d119eada329e8277c755837cc090c13b29bba08e0e",
      "text": "Politikus dari tiga parpol berebut kursi.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f5de60d9b3e35347f8bf825bd5f832c4b7ccc115e78aa5097b2623712f419a7",
      "text": "Kartunis itu sudah menggambar untuk koran yang sama selama empat puluh tahun.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "5235341612eb78180b46b0a1a2648b1ebfbd51947ff0b658d1802ee074b6fa47",
      "text": "angkuh",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "52960ef133266e16f8576e2d88c4431f42efb9aa23ae2fbab5a3e47ec951c1e7",
      "text": "blak-blakan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "56fee4ec8527d741ecfb77d71185b71578d150047845980cbbc58aaf91f49589",
      "text": "Ha! Kau melebih-lebihkan, tapi semua mahasiswa tahu masalahnya.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "58348e9fc9f11f0b83d48e30feab0a2bc118c17e843a79a53d957adcd04893e6",
      "text": "viral",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d754e6ffaf35826bc2f4e89ba5f038889d98899c432c64faff2c4963ad90704",
      "text": "sarkasme",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d86d3fc826f75c3665c698378af6751dab2dd562ef7fc1043e7642d80d4d42f",
      "text": "remeh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e62279791bedbd601817e48eb1ac57c5a6fad77f13d0b1014e18c549ff2c66b",
      "text": "Pejabatnya duduk di kursi raksasa, dan rakyatnya kecil banget.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f35fd4f84249b0afaffc6cb1a544df7b4edb2974970e410f17dcbefbc701e63",
      "text": "Hukum tidak boleh tajam ke bawah dan tumpul ke atas.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "604f16b250c2abecce3f5109be380da67aff4338a4c87245ce4e2b311ed8d6de",
      "text": "Tampangnya polos, kelakuannya korup.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6078ba1c92866076889ed21fcdd1f189406404515c7eb497499423922d6ba9b2",
      "text": "Ironis: aparat yang harus menjaga aturan malah melanggarnya.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "617f5f76598ae8be68778ec354355fd29a1fb32195beb8b318487fd6a891710c",
      "text": "Lihat kartun editorial ini, Mohamed. Apa pendapatmu?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "63c36d4cda70a5a416b9dbbbf5abf23c2c8ff70613ad1bc88fd09a6d644af836",
      "text": "terus terang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "63cf8147109d8cabd0e40c69bbe68f21c1bb1a07556c6d4e5c4828463ad9d302",
      "text": "Premis yang baik membawa tawa dan tepuk tangan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "653a55acfef9b427a010da3d7ca5ddac461d75df52dec74a150e4590f59021cd",
      "text": "komika",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65dbad30bea02e201526db5e2abe575542f09ed55a2a9ec0381b03fae53b8543",
      "text": "politikus",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "65dbc504a382b4a4edcdae5bc0ed3d2caa329a03e4bce910ac07faf911764d19",
      "text": "akronim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "66fa7ce0d99a9170d2fec623e32e2ef928b4cf7617e8672af77aa0efac8c0679",
      "text": "Maaf, Bang! Itu ironi, kan? Aku telat satu jam.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "679f979978c4909e64e822e17288e2a22f0bfb6a1236318a377bcf0304e8a92a",
      "text": "Jangan tersinggung, Lae. Di sini semua tamu dibilang kurus biar makan lagi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "6844c39789e1c0559e7c15e355d8b71dd83bb664ee1afdc72ace4b5a8191b805",
      "text": "Betul. Satire itu cara rakyat ngritik tanpa marah-marah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b837856928fbc29b513aec96ee24ca9809bfcef6b3b7adab28531c55045e13a",
      "text": "lawakan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d68e28b4ec8d898319eaa5840453d83aafe0ea28a80a76a855b2be4b0ccf2d4",
      "text": "janji",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e12c4331c6014e3001bffdc352b0b6518a59561668788d88266be459b1fab66",
      "text": "tersinggung",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fc90dba4514b252c5d371e87b6e79e0735f5ac2ec45e0e99ffa1a87bd72f2ab",
      "text": "Ha! Di Mesir kami juga suka mengejek gitu.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "72682546ecb1eebc67fe4f5a37fd2e2de3f63401082c879c64a200f278cac739",
      "text": "Kalau galau, curhat saja; jangan dipendam.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "738206637b37e466153c78c586e905cfa90058fcf9fd13bdfca74782d5daaf76",
      "text": "slogan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "76f3146bbada8d4b83cf207c5bac0726051947f8c72ea95bd23eff99c0b671d3",
      "text": "Bukan, ini satire. Tapi ironis, kan? Kayak beneran.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ab589f1c60cd5a3bea767b69f532dd72bdbda7b79411942fa922523fc3d2c40",
      "text": "Warkop DKI mulai terkenal lewat siaran radio pada tahun 1970-an.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cfcd4cfd41062c076b58517e2829b5ebe9493058a391843415b8269debbc4e8",
      "text": "Mohamed, malam ini ada film Warkop DKI di TV. Kau harus nonton!",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d23171ad6f78556ddeeab1bae59afe6cc8a125e15bf08de625898d52a9d1df0",
      "text": "ironi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e1ce7121e8c4b5f3fc620367aaba8057d1ce6c31e1f0f7773a9fe0319c416b9",
      "text": "Danau sebesar laut, dan orang yang bercanda tanpa takut.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ff52beb8b535baf0184168f072d96a770a9e2318a6feeff900afff35fc5876c",
      "text": "plesetan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8102ebe58b470e8e211d6f114e727d230290ea9ec7bcf8e46c704399ced58673",
      "text": "sensitif",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8267f0412cad6a99c9c43f05b505da2f6ea94bc5b986c949b5201c0a5e443ef9",
      "text": "Kenapa, Bang?",
      "voice": "id_ardi",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8723564ca04783a9fabb3d5acdf1459fe09b95f796da42d7967518d0a502d105",
      "text": "Hati-hati, Mohamed. Suku itu bagian dari SARA. Banyak orang tersinggung.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "89dfd6736bf3c8c3ce5e2abbc1fe5b7b07f924f1f24913fc1ea055b68078a17b",
      "text": "Dalam karikatur itu, kursi pejabat digambarkan sangat besar.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b7b3f5af183317a1bbeb54ea68df5f7af6c54e678a547f9494c4b3a1fe4ec4d",
      "text": "Horas, Inang! Aku kurus? Di Mesir orang bilang aku gemuk.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c3ca661c3f2483c1138e2b54c64e16376e3c5fb3e094c30d74c2054b03c5f8e",
      "text": "kartun editorial",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e2228c7ae76ec7c0dc5c11e1918bfaeb47f3b97c27d6d129f6b4969528013f6",
      "text": "Itu ironinya. Kartunis nggak nulis 'serakah' atau 'korup'. Gambarnya udah ngomong.",
      "voice": "id_gadis",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f9c1c9854251201081b4ec2ca694644d297a107315ff505d961d1c961863305",
      "text": "Penulis satire itu melebih-lebihkan masalah sampah sampai terdengar konyol.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fc030bfabac384b1da99ee55758830faa6909b548d7e8db138b2f97b6ebe106",
      "text": "grup lawak",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9280247b0136e652e0b12438f66e799ba1d59fabb918b461a0fbc21dad58da48",
      "text": "Nggak! Kami suka bergurau tentang diri sendiri. Yang galau malah orang yang nggak bisa ketawa.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "96a4f063488ebe3151b1fd0aed65fc257b71ee58893ec11cb265a95f8b1abe07",
      "text": "korup",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "981108c7ec76bbb5d42f2852901cf74b7a8eec61ea8f28a37ffed96316f55dd2",
      "text": "Horas, anak Mesir! Kurus kali kau, makanlah dulu!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eab531101ac671ec2976168ffb867bdc3d55cfbb9f74a940c2e4b4f30a3c178",
      "text": "tajam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a328b1d2bb09ae134ed784e027572c0c70a822150f5590120b5179ef8cd73cc1",
      "text": "Komika yang baik menunggu tawa penonton selesai.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a357436fb7ea7ae76032e0f0d647fc9908c576e5a426dc645de64c9535b147d6",
      "text": "lelucon",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a76f8d05a4ff945855c824de4edccd31970ac7a169ed9915b287aafdb91e11d8",
      "text": "Sindiran itu halus, tetapi semua orang paham.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8a2487971ec2756fc6caa9990c362e0d0c8b4a90878f7dc50c7b7e995018bd5",
      "text": "Karena itu ironi. Premisnya, jalan ke kampungnya penuh lubang.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "a926d107aa2778fa2d13b5ee1ad86ed778a5ec3652afa7903b0e32f8cf9451cf",
      "text": "Aparat keamanan menjaga gedung parlemen.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a98db9d2a18d3fe7f3e08afef6dccc5272ec9b4e82ec406e05fe64475ee8c75a",
      "text": "Mirip. Lawakannya konyol, tapi kadang-kadang menyindir pemerintah.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa98ff11086cb2d2e2d43921f666cfc38480fb73a768d084ce5a0ab68631b267",
      "text": "kau",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab2196e97098231bc3a7e1a5655b92103896e5a900c99ca980c8b552ce2eb663",
      "text": "Lihat video ini. \"Pejabat kita rajin sekali, rapat sambil tidur.\"",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca8280ea6a7276d23aec4096a0f25d75f1730d3ecf22392e2cbc7e9052f7aeb",
      "text": "Sarkasme bisa menyakiti perasaan orang.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "adf4ef58e28674a18488461b897018670b8e39dcf7fab629dc31842acd03b09c",
      "text": "Dan nggak ada SARA. Yang dikritik sistemnya, bukan orangnya.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "aefbd4b263c822f183c7250d656503a2d1f694f60754db49617a6a62e2cc043a",
      "text": "Di Mesir juga ada politikus yang lebih sibuk sama parpolnya daripada rakyat.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "afd531a67196d3be3cac3754fc0e9485c8457082efb4b5def79acd51bf32b123",
      "text": "Betul. Terus terang, aku pasti rindu nada keras Bang Togar.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0bb88a65d684bf55e862f323151169f86c536e0ca82ee2f93809b688038e70c",
      "text": "Oh! Jadi lucunya karena dia nyindir dengan halus.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b22da1d119cd599615ec848ec45403f07b8e23fec5269602cdf9f00caea8bb30",
      "text": "heboh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38c13e2abf6e1eb4e326c9f5af5f78ff805ada9be5cfd858c758246179d845a",
      "text": "serakah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b541a3dfc4bca171091576d056b2955e2709f8a0b9fe754dbde75125e423ed60",
      "text": "galau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5c544db662d9984b3f3f579ef2497eef6a8aad714bcdb4437f242682c2c72d7",
      "text": "warganet",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b694a7b8258f2357672fdd64b0dc509ae0d03ebdd88044e34533fd91c0e27f0b",
      "text": "pejabat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8ad297ea9ab84834d3e227a2fc071ffd217b3842fcda4e7ef72b944e2a30407",
      "text": "Nada bicaranya keras, tetapi dia sedang bercanda.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b952afe48ff39725a52e0348544d74ff3fa9ff27a680d7a1fe73a2a56c53b29d",
      "text": "Betul. Lain kali kau yang naik panggung, Lae!",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9df574489965006f73ab34b9bbb93ba4058116c29c6a94b84e721277eff54cd",
      "text": "Nada bicara orang Batak terdengar keras, tetapi orangnya ramah.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb9d86e66b2e66b70717c544a0fd756174c459896615f1516fa244b1c988d48d",
      "text": "Setiap Sabtu, kartunis itu membuat kartun editorial baru.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc55c3f1d664a853b9dd3611c67da3de0e8a98b8307cdf90d76b0e9c0cb52818",
      "text": "Bang, kenapa penonton ketawa waktu komika itu bilang jalannya mulus?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcb860c44b6a65315976447f881a1363e9aed08c3c9329f060c6dabb9dd3ebd2",
      "text": "Bang, kartun di koran ini maksudnya apa?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "be006c8074224bce268d16f538ee8b2d139d766acc4200b0c307ae6b57a93b49",
      "text": "Kartunis dan penulis satire sama-sama melebih-lebihkan untuk mengkritik.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfbabb2a5600e8788a10fe403aa7fdc19b19e3ed39b0cae144aae3c08a594a39",
      "text": "Pejabat itu berjanji memperbaiki jalan, tetapi jalannya masih rusak.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfc8edc48e5df43ee56bb151f4545008b8ebe499b0fa2a701e61460662d2af42",
      "text": "Ah, kau sudah pintar menyindir. Besok kau ke Jambi, kan?",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "c35f891a1af9798ad34b1efd93a487658474e419b8012ce8fb84bda58ab0212f",
      "text": "Kau memang blak-blakan, Lae, tapi aku suka teman yang terus terang.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "c46166846c7ee6cdf0a95942e4d386d8f54a91023af5cb7399da1e3bfbdf53d7",
      "text": "Kau ini, makan terus!",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4ed3f1cda47908814f9b9fe7b214ecd8def80b13852702f1d13fc9e7945ec46",
      "text": "Gimana kalau ini: 'Mahasiswa akhirnya bertemu dosen pembimbing setelah mencari tiga tahun.'",
      "voice": "id_ardi",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4f8e90420d412d5e5a114d3a6bd515fe3af5f79583dbfd1dd08c8a8c777f413",
      "text": "Baca judul ini: 'Koalisi dan oposisi sepakat: rakyat terlalu remeh.'",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5ec7f006a552446e6d2b597dc75ee8c48019b63376e94b43cd1c0544c374e9c",
      "text": "Pejabat itu sangat sibuk. Dia rapat dua puluh lima jam sehari.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8bcc6917adfb0071667140c10b7e2323a483b3c8a8ecd5cef4f04696038b7fa",
      "text": "tepuk tangan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa093227fefa15d04d92602b35aecef354e43da96be36c52a619936b272e60a",
      "text": "oposisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd261b83a3319b71f924c62ba40b8dd6aec77b688791ff0705883e2db3ac505f",
      "text": "menyinggung",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce45da37531a855dfdadf2192351638841f485a4690218406aa6be8ee2ee2d93",
      "text": "Bang Togar suka bergurau tentang petinggi yang serakah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d00b3c579de4b8776fbe45ba931c78584b1ca15805811c2f0610eeb2caece344",
      "text": "ironis",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1dc2fdeb07f070f5df58e88b16cbb5b07897c3bc56ab0bcb3cfe75450c5dfc0",
      "text": "Satire bagus membuat kita tertawa dulu, lalu berpikir.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5510ce4f4c48def4acdeb43726204819c432736dc79712f5f120ece8f4361af",
      "text": "petinggi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d58af82dd5a7c0b30a8a5729ae7bf705f96f6dafac072257b0b638e78d2f7d80",
      "text": "Lelucon tentang agama sangat sensitif, jadi komika itu tidak memakainya.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6576bb4654a497c922248b9085d5e3408b385dde7bf0a399c5b95956df23fde",
      "text": "Komika itu mendapat tepuk tangan karena premisnya cerdas.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9f64bf701602b5e4995c8ce8033f7de0c497f3cced1ddb85db5fd8700d47409",
      "text": "batas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "de883a3428fa901ec44f8a1edb4434e9fe0f682e193ab42a0ac8b966ccb26793",
      "text": "nada",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e05a9f3cbb71a7742bbbba0becb89f9a13dcb01c80fcb60d0fb90de130866a2c",
      "text": "iseng",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e06d79fd442f7177f13118815b933571523c83b54752cf23c96f950d4732a6f1",
      "text": "terkekeh",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e16f2e61a476063ee4c218b6c84fb1f4a1de359b9cb7fa7b508129d38dbee431",
      "text": "menggelitik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e188199319da7b5ec5077eef74b319ad8dc3eddd0b6d22c3e368fe93d3be1e0d",
      "text": "cerewet",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1bd2e0b76fdc47b8167399d81117dc659b53bcfa690c22dc523c8633b3a51ea",
      "text": "mulus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2386e820706532ca98a1c17904729c3c99263638a1cf0de0b8d42712b83c396",
      "text": "Kartun itu lucu: petinggi yang serakah itu tampangnya polos.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33e21ef79456c1954a4a3b21b8494c14e26ebe9b999bf9f21e078a89d1b9542",
      "text": "Slogannya 'Melayani Rakyat', tapi antreannya tiga jam.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "e358ab73451a3be71d50348c028ed74532d1428cb049412786028c4c238355d9",
      "text": "Satire yang baik membuat pembaca tertawa, lalu berpikir.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46a06ce6ac8b6edcaaa46d1c22552c7527e7ca7b7a61b3ffffa9fc3eee7b444",
      "text": "Jadi, apa yang paling kau ingat dari Samosir, Lae?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56350adebada1f00bd0a4db13ea8e9f9469e488120524ceaf5d162bbfc9381a",
      "text": "Mantul adalah akronim dari mantap betul.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b0d00bb074550facaac59f575fadf63bb399f4753e88ce387bfd25d1a92d73",
      "text": "Karena berbisik aja udah kedengaran sampai Samosir!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "eae22c9b5b286faec04d1c88d8a558d82e4b14f227029a5445fa7416110a04bb",
      "text": "Mohamed, tebakan: kenapa orang Batak tidak bisa berbisik?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "edc21613782aa5160cf387a891e840da7f38395c672fa4d95f0a15db04e21f93",
      "text": "Kenapa kamu galau? Ayo curhat saja.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee1fec50038e09d836f0190a0c295fa31fec8694952c796c66283b203beb0fe4",
      "text": "melebih-lebihkan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee5a3dab833d2c8469851ba4dcbd07e40c1cdce600e03df2c0c683d88fd2ef64",
      "text": "Banyak warganet membuat meme tentang macet di Jakarta.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeaad890faeea287eea47c197603a9767ef383172a631fcaf041c77f1f35baa2",
      "text": "Itu sindiran kecil aja. Kalau sarkasme, aku tanya jam tanganmu dari museum mana.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "f23c0a50cd89faf98ed388710de043cc64a9dd124945321156c2e5b7f0819409",
      "text": "aparat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3ddde6e01791b283889b83de7833198e2eb18bd5530af278b0ac63d8df64ebb",
      "text": "Dia mengejek saya dengan ironi, bukan dengan marah.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3f347fcab6acdffe5c9af7b06a15350e967671c085f79086391e8b07ccbd3f6",
      "text": "tebakan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f456aaf67264636c1be5097f7a376babe68ab51789d1385cf45a16ae0ef68b7c",
      "text": "premis",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f48683483d0caceaa69b688fdb162218f5d4d1ff64e05214fb358a58b8ae4c7d",
      "text": "Kartunis itu menggambar petinggi yang serakah dan angkuh.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f736f9ff43bb0308c7b3db2f1a8f6fc5f57c3d8caa2f219fa5ecfc64d2c47034",
      "text": "Karikatur ini lucu, dan kalimat di gelembung katanya menggelitik.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "f76e844f9af826c2e0c7938d677e5bef9363137b70ce3ac1b3727719f82069f3",
      "text": "mengejek",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7e3e0d35fd824f05f8c3432da89023f539fb248b9f864869f3faa63d0b7529a",
      "text": "pelawak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f83473c72e5e56252931b1a490932bca3d2c147ecd96057ec4376aedfde6d70d",
      "text": "kampanye",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8d264f3c723e0b6d277681242b435cfcc9211efe2264319608945f6e31fbaca",
      "text": "parpol",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8d986b252e478b3aa6326930d2a0b871e22040ddf97722f85dd0a5dae38e374",
      "text": "Mengurus izin saja butuh tujuh tanda tangan. Birokrasi!",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "f950e20730488baac1c4dc3aed7b702f2656bba2a2e4e2081bc6e7ba28e2fb13",
      "text": "Gabut? Mantul? Ini bahasa Indonesia atau bahasa rahasia?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f95b2f3c7021b928412a81331f71d91e813f2bd24c29b94189fa0bc4e79d8bdd",
      "text": "kelakuan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9a580fc224e092a9199674b25ec1048ff6a73cba3753aa02908078826103ce0",
      "text": "geli",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa275caea1dcfbab2d238bd5f10000d3eb34fee837d8cce3f1425cb040dff424",
      "text": "konyol",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbad0d3934585f949eeb9cfae25684d7265ec4443759ac78e3d9b075c40e44c6",
      "text": "kartunis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcf8ac41b79006081f1149d0a9fc4cf76bc47d75499b472dfa186030aee01916",
      "text": "Dan tampangnya angkuh banget. Aku ngerti!",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    }
  ],
