    },
    {
      "id": "bipa7.u07.l07",
      "sha256": "06ddc8d69158621b26e987e3dfca154e4c8f29216ec357edef1433479b5c3479"
    },
    {
      "id": "bipa7.u07.l08",
      "sha256": "e425d5ad56a65e0e0e6e5dc32f657a58ca561f877eb89d9e98adadb0fc1713d9"
    },
    {
      "id": "bipa7.u07.l09",
      "sha256": "7366fa19be706801dbbefcafb1ef386eb645e9c061a387d0a96ddc49b2b3b041"
    },
    {
      "id": "bipa7.u07.l10",
      "sha256": "2f7c0920f3ebdde42f5487a3ea23096d71fd9a28de27623c16aa4f8b747ceb10"
    },
    {
      "id": "bipa7.u07.l11",
      "sha256": "3a2fd06380836ca8ebdcd26f9c268f99ded5226bb4c63da6fda42baa11340699"
    },
    {
      "id": "bipa7.u07.l12",
      "sha256": "93def40f5592ea3d9111348064a7e5e1e866bd00d00ad24d6205ee81cf6134c1"
    },
    {
      "id": "bipa7.u07.l13",
      "sha256": "27ea2b95d8d5f021caa5483d75a80d142b91d47ec4a7bc88ca52fb8f85d29b15"
    },
    {
      "id": "bipa7.u07.l14",
      "sha256": "d839a7e57a168339ab22735f7d201a566e0193cbdead0515aa97ab336236fe90"
    }
  ],
  "audio": [
    {
      "key": "015db2ad3f8c8fcf981491d8bcccedc3513128e0bc05263ffe01883dd160f774",
      "text": "Kalo gini, orang lain bakal takut ngomong. Itu swasensor.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "060e048db01e1304f9316ab14ab20520cd09d9601f0f62877cdf0058af1ee0a3",
      "text": "aspirasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "065ddbb94878db897815aaeba2931ccc2df522c64015057a598b889ca9d4995d",
      "text": "Ya. Tanyakan apakah dia akan menolak pengesahannya.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "079eac50c07f6ddb33703e5b3aeef944ea5e4984aa8899b589ea16cceb6f949e",
      "text": "Sidang paripurna menyetujui pengesahan RUU itu.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "07df2cc063eb899e7272611ab05e93899f49040bce1c788e9cf844391d501e50",
      "text": "Pelapor penyuapan harus dilindungi.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "08c8d5bd222dbcefb4f6c9e2643bf0bfd6b297a574843ebc055d17e3ff940010",
      "text": "kabupaten",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "090207b4659e6ab7792a07623ed2ce638e01f877a5f296b11281a87602c70043",
      "text": "Pelapor kasus itu mendapat perlindungan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "0be9c152c0ca9d2a6e0760b1f5f81c24508b1a8730f94700062564a0f29ed9df",
      "text": "konstituen",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c3e80889e52556f6a8a74735b1a29a8419183e017400b21e467de3c02efb5f1",
      "text": "RUU itu akan dibahas dalam sidang paripurna besok.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c4979a08c49bc4397931284099c12505a14fd89452b04acb2ba6618a90d78e1",
      "text": "Setelah surat pembaca itu terbit, wakil rakyat menanggapi pengaduan warga.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "109000afeb2a4b26b62b12341745f5c293bfd560d546e11ed0252671c782a9dd",
      "text": "Sementara itu, TNI mengirim kapal untuk membantu korban banjir.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "10d50e84b677fed2c6b941b52c447469d3ce769fa2afcbc575acce4e7a80ff97",
      "text": "Betul, tadi siang. Habis itu berita TNI dan banjir.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "12f893b56e57db80ab1e7e5e9054e6a083c82ccdfb1fe4b3e1963a7cd428365e",
      "text": "Setelah mencoblos, pemilih mencelupkan jarinya ke dalam tinta.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1319d5a1b6ddd461ad93d0db2570e493ac24bb92ab2031f9531af43931b40cfb",
      "text": "Mohamed, pendengar kita yang mengkritik jalan rusak menerima somasi.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "1349791e0b90818fb62af720dc8800089c6092fc458e0fa6848123ad5c981617",
      "text": "pemilu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1743aa0bcd43181dc1e6dd2cfdd8da484411fef9854d6d9a7dd838c8942ef80b",
      "text": "vonis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "188fe518b9e35fdfbf58d22f996e072fd0ae5ad80c08c2e162ce6e337e8f3222",
      "text": "advokat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b68d03d98806fb354048220119b394f1cdf66916b2f7b992ac6a2e858dd4900",
      "text": "Setelah reformasi, Dewan Pers menjadi lembaga yang independen.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bc1cfebd71abe5f9843912dc8a4f893049af338145e4be2c251f348eb7940ae",
      "text": "legislasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e947a1e20d27feccf0e2e31aaba52448db06a30bf456856bba567074a0180eb",
      "text": "Iya, pakai UU ITE. Sekarang dia udah punya advokat.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "20f3ee926c76ddcf7981a81533e870175c28f86c32561d82845835e6a61fee6a",
      "text": "Bapak kepala kampung bilang jalan harus jadi prioritas. Tapi mama-mama di belakang minta air bersih.",
      "voice": "id_ardi",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "25465549b5cc41fe1e3128465dcc51ae2922520ea231860c725e986eaba5fdfe",
      "text": "Pada Pemilu 2024, jumlah pemilih lebih dari dua ratus juta orang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "26bfe3e54b59c4add2d525fb2e76c11e9cc3f259136850fa1e5fc4d243971839",
      "text": "Fungsi legislasi ada di tangan DPR.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "26c4d3113c984b2c489f4c3deee270976c9d6ff432fee8eeaf35a3deb35d5aca",
      "text": "Partisipasi yang tinggi membuat angka golput turun.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "27195f389815775e7a466544ec84bd890b5ad8a16036ad022b7937004102a478",
      "text": "Artikel opinimu buat kolom anak muda udah selesai?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "2796513f22d9dfd562fde6ce9b405d6aaab58d9ee447fe657998a47e80a7693c",
      "text": "uji materi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b24a2eedd30a5790b38e1f2b1fdf319f4e3683ade0d55528e13f7c8c860496d",
      "text": "Mohamed, tolong ganti peta di ruang redaksi. Yang lama masih dua provinsi aja di Papua.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b3d6471ec0ab2ac29a56d0e90db8fd370d24b5c90b0e1e45376dd2eeaa0fd29",
      "text": "kolusi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc6c0d76dc32b9ea431df65aafbfdda079b08fb56a36810ce86bcf4b699403e",
      "text": "Tentang uji materi undang-undang pemilu, Bu?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "33c6200144071cc150c5a79f5cd8fad9ba88d79cf87bd3c96349fd3aba5ea4ff",
      "text": "ketatanegaraan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3426f6c9bc00cb78c8059ad0343c0e47f5d29864801858eefe7a9304ec0a0f0a",
      "text": "Kebebasan berekspresi dilindungi oleh konstitusi.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3467a0613e38d4346fb80594e6f6774a95cb195ad458329cec0810c4a25a51be",
      "text": "Mohamed, berita kita malam ini: putusan Mahkamah Konstitusi.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "36797fd4a0b10f3bb78a4a1e5e951840c7dad0a192840fed81532b277e04dda8",
      "text": "Pembaca sasaran artikel ini adalah anak muda.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "368242edccb07b42d1a063eb8678e04cd17339a9296e9e9a92f76795b66b8252",
      "text": "Kepala dinas itu memakai hak jawab untuk membantah berita kemarin.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "38c84f533bd6f512ef6603a9f60b47387e5d19e5e09c18d315367c7a123dbb5f",
      "text": "Kita harus lindungi pelapornya. Jangan sebut namanya di siaran.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "394d8a7347764b673e907e5655824d3dc08be43cd6582838d6d0ebf3201c17e8",
      "text": "Sekarang Indonesia punya tiga puluh delapan provinsi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a258feddb3bb75948bc2699c7daf776c0946c20ef28bb8c6dc4c16c50ef5255",
      "text": "menurut hemat saya",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b4ac4157ea976f7d3db366b9ee0c27210682580a15142388b0caa48673b93c4",
      "text": "pelapor",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c1074f6a7cdd9aebf05ec0a83d249698852377ae309e6b59608ed9d696b2f45",
      "text": "Pembawa berita sudah siap. Saya pegang naskahnya.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f1cc59b3d93099acc1ea7c77c04bcf4727358a7cf2b51a5ad8989bb0cf92304",
      "text": "rancangan undang-undang",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "415b914c2f67c646eff293929f739e53d1d953d2a55ce38fcc49f51a6e4d2970",
      "text": "Berita untuk khalayak harus lugas, sedangkan surat kepada pejabat harus santun.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "41bef065f59874769ab712a2329b5c30c0c554f90e8cef76f7f58c6bfd2e703e",
      "text": "Betul. Sekarang tanggal 5 Februari diperingati setiap tahun di Tanah Papua.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "429b5325173f20bbee4b18ad79aeb807dae4e7c98ecdc62c35eb5fd551225b53",
      "text": "Mohamed, berita penutupan jalan ini harus kita tulis tiga kali.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "42c3502442fae611a1019479429f6e3aee0a1d123d4257c816a84a6ed8056225",
      "text": "Undang-undang perlindungan laut udah disahkan, ya, Bu?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4552e78f86b833809204f1264fd23f7f0b6a655becd6f088641fc255f1d4559e",
      "text": "khalayak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "46fab1d1da547a5cab0f67fd49d6adad200fe4dd039464cf65e7052064a6513d",
      "text": "Tulis kedua usul itu. Dana desa terbatas, jadi mereka harus memilih.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "47150870ed3e5298495d332537321a4465b4351e4b8e58b8a5658ad68bc61af0",
      "text": "kebebasan pers",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "47b7fc236048b28299481d5299cada0befff463c975f220aa907ae0ac31a0d6b",
      "text": "Tiga kali? Buat siapa aja, Bu?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "48957fc91cfb4f9598b2472a773ed2542fb0751e961e1e131f9b0d80af2a4eaa",
      "text": "DPR",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a50fe5735ca29c90db065b009a4ca8627f63b75a4582b04aea6fca62f84886",
      "text": "Berita untuk khalayak umum harus lugas dan mudah dipahami.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "49c4d656c0be22449bd1cbceeaa7bf1e80f3c141b9f376deb07ad8e666a208fc",
      "text": "Setiap orang punya hak jawab atas berita tentang dirinya.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a0c73898e94c3119a193a00b9f92491b0d1b04fb6505cea36ab3b9cf69a3a0a",
      "text": "Air bersih menjadi prioritas dana desa tahun ini.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a99568cedecf2a3329053ecbcabcbd1aaddcb021096b65d7c8fe15216cc1c0d",
      "text": "visi misi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b39b9e4a6713cf5de1e4d3a53dee1f15dd00772343fe550994d6f0ba98bffd6",
      "text": "Menurut hemat saya, partisipasi anak muda menentukan masa depan bangsa.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bd342260048fa65d39b445e61a6876661a28f3dc060c36cea23fe7d0ab989ee",
      "text": "Transparansi anggaran mencegah korupsi.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c8cd015355c994a3192a674b9089183c0a3da3acdae16e9c97f52c15d30ed37",
      "text": "kandidat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ccad9cb35b9acaf734a778fe719a0bffa42dd7e5ebe021ed3698d9183e8850f",
      "text": "provinsi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "511322da9577d57a4c062cf22129bf16b1f0e375db1af627da2da3c4dffdc0f3",
      "text": "sensor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "522931bcc54907a0a0caaab830aaeb7079fa351d8fe951b8f58cd3cf6ebb31c0",
      "text": "Dia dilaporkan dengan UU ITE karena ulasan di internet.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "5336cc1e549555f26e3d2bb70fdcb956f509b17be2ccfafb06acb16a3c2fc260",
      "text": "pembaca sasaran",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "538477179bbfa81842453f66cd762ac1a730ec5d7624e1ec514b986cc318b1eb",
      "text": "hak pilih",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "55e5510c770f73024552cdfd271fac50477d18ddfb37f4381ba70b42db11e56c",
      "text": "lembaga negara",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "56529bd78fe8e832ce1e4eff796bf58ab4dbddd40fb0fdccff39f2877c3ebcfc",
      "text": "Pada tahun 2022, wilayah Papua mengalami pemekaran menjadi beberapa provinsi.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "567051f65357efedb2679df0d11ce593ee89873f013c03eb86fe01dc62e7b0ba",
      "text": "Majalah Tempo pernah dibredel pada tahun 1994.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "56bc1425b8df9a18f1be0c38d366c70817f065718348aaa729d59227e3b10dab",
      "text": "Petugas itu meminta uang tambahan yang tidak resmi. Itu pungutan liar.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "57939e5b3f041c10caf98c4f8bbee0faa9ab6fde7fb630b22bec985ef2364660",
      "text": "warga desa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "59c812389fc4029cbe1327462d1c8eedb0b4e1e19c72cf0b36d72fd7a5ec677d",
      "text": "pengesahan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "59d052ea3239724c3c19a28e23b1af32cf4b9e98db556f064002e8f967597404",
      "text": "Angka golput di kalangan anak muda masih cukup tinggi.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b403b1aa860add1c07d1440133508c79d6eef9e983bd9d345aafcc84086d829",
      "text": "Mahkamah Konstitusi menguji undang-undang terhadap UUD 1945.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eeb2e536ad64d71fed9195f0be939d93676afa95d1dc7dc007ccfbb3953f355",
      "text": "TNI",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f843a73ca3ff234155049dfd4b9fedf78ea79527f5a0c59e8551beaa136a940",
      "text": "Dan setiap kandidat dapat waktu yang sama. Saya bawa jam tangan!",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "646bfc704786e051ac93371f2e4679c261ae8c8e821608cc857ccabe5742412c",
      "text": "penyuapan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "64bc604db9c400ec73e7af1f1f28358ddea0f1a4935d150e8f19da197aa14cfb",
      "text": "Mama itu baru keluar. Jarinya ungu. Boleh saya wawancara?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "64c894072dca31a8cfa04e70cf5276c45f7227bb8783f3a39e63fee23aaa35fa",
      "text": "legislatif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "67135ae59da467dd51529cc3b2b1c87c9ffc96d28ee933def46a18750e82997b",
      "text": "Ya. Jelaskan dulu untuk pendengar: apa itu kekuasaan yudikatif.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "684ca91bfe4b9329db8c8aa20e98550cf445287629dba25db11e09504ce7d41c",
      "text": "hak jawab",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "68ac68a1e7623131f6b2d717136be9b1ab92f524653336507e7a8cdb59e18677",
      "text": "mencoblos",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "69aaa088d2c70239e91fb71e3e11191e613adbee477f16fa95aeafb9504e89db",
      "text": "Lembaga mana yang menjalankan fungsi legislasi?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a587c90b6702be1db65ecbf80fbabd21501217343d6b3ad87b35b5bab0dbf49",
      "text": "Surat suara itu sangat besar dan berisi banyak nama.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b7d14ec8958a447111f9ccd2d8632a39616e29b7239b895e39a29ce34e75eaa",
      "text": "pemekaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6de208cbb0d24965f022a2ba55b65f8f85489fc22122427aa0d50562c356dce8",
      "text": "DPR dan TNI adalah lembaga negara yang sering muncul di berita.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e616997f3a62b95c9b176080e497b8f0dcd988575cad8aa9ce52f4aa2a4a3dc",
      "text": "Pemekaran kabupaten itu membuat rumah sakit lebih dekat dengan warga.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ea4180db5c6acdb904a99bf0bec6b629b64cc1e138b0ca36e3fc7bd05c060d3",
      "text": "Mahkamah Konstitusi",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "71cf321a7daa692c451a2d614bef3b1801e9178623391b8d975865e26411a7fd",
      "text": "Pelayanan publik yang baik adalah hak setiap warga.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "72ed8922d843597a1db8eac223bc69044e05a5758a84d0044b9da771e824bb36",
      "text": "Saya ganti dengan pertanyaan, lalu \"menurut hemat saya\" di paragraf kedua.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "74811920a4d095af0430daa7b1fc9af2f6060da4a1fb98bdb1ff0efaa31e3b6c",
      "text": "swasensor",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ff323a43c4ce9b41ac62bb4a7af6acc4b1051eac626a16415db7365f5b2dab",
      "text": "partisipasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "762d5c7b6474ca02800c8284a7db8adcdb6f86f59ef348a919fbf166442fcf04",
      "text": "Bagus. Tapi kalimat pertamamu kepanjangan buat pembaca muda.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "76d81838557922e80a5200cd11199aa0cd1195e575c0e0ffcab8f18fb3139153",
      "text": "Karena itu kita wawancara anggota DPR dari daerah pemilihan Papua Barat Daya.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "76f858ea57753b61e9e301d914d024c30b84547207d5d5ab76d570603de27156",
      "text": "transparansi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "77ed131749ea797deac93c6b0b072a1bc15f581038bc9afaac5f66a498ea6359",
      "text": "Kita liputan di TPS deket pasar. Pemilihnya udah antre dari pagi.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "78a3a5e99848abc957d13b8c097de6696ebefc320da0dff77da01e096cbbc099",
      "text": "sidang paripurna",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "798a289e00e395a9f258b6d1e5d4b57b272a606c3a0a858c9361b49bee83fd54",
      "text": "Malam ini ada sidang paripurna. RUU penyiaran mungkin disahkan.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "799b94af09abfd5a63a77425e9958a3a53ba0607dfeff6692a538ea28167f619",
      "text": "dana desa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "79eaa8823b8407284b5863767bb248d5db323029a32ab5065547589ac9f73bc5",
      "text": "santun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a7661f00d6202b987b8e4b2f6f45d50fce86c5f8293e825e9ae6fb54ec64f31",
      "text": "Dalam sistem presidensial, presiden dipilih langsung oleh rakyat.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "7abb4a5f5f9e3893e873ff6424451f03413947dcc008b6d4fade679ce33e47bf",
      "text": "Artikel opini ini ditulis untuk mahasiswa.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ac0ffdceaffbe3d406676b8372951842e6cb39fceea095108214f12a85cfb6e",
      "text": "Visi misi Ibu bagus. Tetapi dari mana dananya?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d1cb12e50b12a30b94642581bb91ecafb1756b93157bb0059d6ec41288dc9b8",
      "text": "otonomi daerah",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dd0633f0a1364fe2054d8c4307e1e19c0b8e56c902d9d8428d9232325286042",
      "text": "Pembawa berita mengumumkan bahwa DPR sudah mengesahkan undang-undang itu.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7df2507a2bf709b8e06d98421d3cb8a89d2dac4e2be8719b732c19e3ecd5fffb",
      "text": "Rancangan undang-undang itu ditolak oleh banyak mahasiswa.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7a99b3e034a3b821499238fcfb8a143b7de244edecc3e9af29eb557d1018c8",
      "text": "Selama reses, anggota DPR bertemu konstituennya.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8030e3810c9b110758b40a66bfdcf89336bad153a3e07d9bccd49595e597cf57",
      "text": "Mengapa beberapa pasal UU ITE disebut \"pasal karet\"?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "845250b8e81124026789761618f387d0f0e5400b0915ceaa7405d8b3674f166f",
      "text": "Baik. Kebebasan pers juga berarti adil kepada semua pihak.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "84c0c157118872808dbcfda75c018f701d3a29cdc61d46b2c3b98e212f1d34a4",
      "text": "Dengan tuduhan pencemaran nama baik, Bu?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "85da9993a0d871137be1f81935080f4d5d7744ce31682d5e30daa4e502505305",
      "text": "Karena itu kita liput dengan berimbang, demi kebebasan berekspresi.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "8648a09fa45cd6f0aacf5720e1d2e5d98468f41ebf51a444c1f8e386fd032393",
      "text": "Hari libur kita ke Mansinam, yuk. Pulau kecil ini penting buat sejarah Papua.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "873d82ea2ad50510600b71dc1c95d1ec9799a4193fb665d5202bf30bc96a45ce",
      "text": "Malam ini kamu moderator debat di radio. Ada dua kandidat bupati.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f6278fca30fcbf77aeadeded389ba26753045bc44ffc77ee73e25c52244e93",
      "text": "Tiga menit lagi siaran. Berita pertama tentang DPR.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "8931e4368c60ac9e8c8b6be081dc2af9f56e77113a9662fd7626f0392a59bdd8",
      "text": "yudikatif",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a5d52121c612634cc2c788e8b4d9f784936a5ac583b70f2c683aa2dc93faee6",
      "text": "Penulis yang baik menyesuaikan gaya bahasanya, lugas untuk khalayak dan santun untuk pejabat.",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b80ab67990476a480dda81817b0d75504f5a8bb13c05b5a4e7911e1c86dcd83",
      "text": "pungutan liar",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b8b3579dbef5cea4686a15326e87a11c0fe87fa699aad397766d9b160471644",
      "text": "wakil rakyat",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb489d20bd9b97647bc2dd2b8041a12dd7964a8b20c4f9055f5b30b4dde5d83",
      "text": "Warga datang ke kantor DPRD untuk menyampaikan aspirasi mereka.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d93b72f5cd2ddd5ea86c32961ab002dcd8139334e6095edcc7a9256a69f7587",
      "text": "kebebasan berekspresi",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9071388d946883656ac3c7328a118c6dde0fab033eb4de90edd35f075250eb78",
      "text": "Hari ini banyak surat pembaca tentang lampu jalan di Sanggeng.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "91f0fb1358cb02c27c1b19f8e0086cbeb18f0970549dbe76e8c9f32be762cbce",
      "text": "Bagus. Pakai bahasa sederhana. Nggak semua pendengar paham ketatanegaraan.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "92a4be7ac026202a0b489d19970894a7f17189d65fb95ec6dde246e4a4f3adc6",
      "text": "Hasil pemungutan suara, air bersih menang! Suara mama-mama terdengar.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "9415536d3c4b030747fe14282717933258079295f032567eb2efb33c2cdc4003",
      "text": "lugas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "95cc69a3bb1d2580b9305afe98ffaf8cbae01439278ef309ec620df172c6735f",
      "text": "Hampir. Judulnya \"Jangan Golput, Suaramu Berharga\".",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "96a0b5af44980a1da89619e35694aacf150315351a1e9e0b041d233348d5aab1",
      "text": "Undang-undang baru itu melindungi laut Papua.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "96b387fe4a1c22ef43f22d2ac3a756c69351981a676bea28170e7855ccf2a36f",
      "text": "Kritik yang sopan bukan pencemaran nama baik, jadi somasi itu tidak adil.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "992f8514ae62e72564c920092eccd0828f2cec868d04e4cc5a0e0bb011a4c92c",
      "text": "Betul. Manokwari tetap ibu kota Papua Barat, dan Sorong ibu kota Papua Barat Daya.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a945bf6331c784abf387236f802468ce0a84bf2760965affaa7df29d13b5855",
      "text": "Manokwari adalah ibu kota Provinsi Papua Barat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c83b62bccbf4ccfd84ff47829f3d0f3a0ac17d0121995ad1c534b37e631af6d",
      "text": "Semua anggaran desa harus diumumkan demi transparansi.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d287faaaa733bbbef48bb263e61f560612a5b2663db1cb74d399d4ed037babf",
      "text": "Pembawa berita itu menjelaskan peran setiap lembaga negara dengan lugas.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e893735091b0f4611dec6462f0da60381f91a524f67c4171545d0c31aaae470",
      "text": "Kita liput musrenbang di Kampung Arfai. Catat apa aja usul warga desa.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0f8387b390acf7bf4ade311674a4f2ff4a4b879114005ec2e6b813f29137254",
      "text": "Dalam musrenbang, setiap warga desa boleh menyampaikan usul.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a18a30717a1738a2d92dfd39dddbb92eef6207201aada39a850c787f26e43ca9",
      "text": "Baik. Saya mulai dari trias politika: legislatif, eksekutif, yudikatif.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "a566f1276e780b5dcd8e8a24d86099380119481f2b79b982debaf84562c13b3c",
      "text": "mengesahkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa789e8ca7f6efbbb85ff5d1664ca4b7a1ab35b337c2df173542f8ccd0c14ec4",
      "text": "pelayanan publik",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa7fbf11f0e2cfba97b48d081e014ed765ccb839eb304f0eb9723f45b7eb454d",
      "text": "Berapa yang diminta, Kaka?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "aac77585a465cb9111863df9a63fcda9743dbfb158b80e5802ad058ed81340e0",
      "text": "pengaduan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb65d677f2d069c87886e38bd6722e6d7ccc1be5d1be965b7e2760800a5a49c",
      "text": "Indonesia menganut sistem presidensial.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac41a72ddf89bddf596bcfa697dd6b0db3012f59178c7f4001ba965af523c0d2",
      "text": "artikel opini",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca115483eeece9a58d6ec1956f463a1211dadec9144fbfe23e44dc491cb2d25",
      "text": "Usul kami dibawa ke musrenbang kabupaten bulan depan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad6f5734a32b15f3f1633eb208649111872f7ed3612e6e75975661de7207818e",
      "text": "Hakim menjatuhkan vonis tiga bulan penjara.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "adee0cac34d21b31320483af670bcdd74b077029e697ee868dc5d4dfa45d7207",
      "text": "pencemaran nama baik",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08fa816187893aef4ed870cfa59ccd97317d636ab7605fba4cee362353e418a",
      "text": "Setelah pemekaran, Sorong menjadi ibu kota provinsi baru.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b133a1759a27f36be024e73833428e21d09bc73f21ca190805aebe3e79708617",
      "text": "Dengan otonomi daerah, kabupaten bisa mengatur sekolahnya sendiri.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "b13b8bd098d4154dc3e53a0a6e0d659d738ce0573fe2d94849354e04b2dbc572",
      "text": "ambang batas",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38b6e7707997fe48410a6cddf44c719f755b668c3781072b661ee1ebeb63634",
      "text": "Makasih buat semuanya, Bu. Minggu depan saya ke Jayapura.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4db9f71cd0472d9fa5488e5b1ca90b3a1caad9111f9d5bb32c2c0ffdb3925a8",
      "text": "Kebebasan pers bukan kebebasan untuk menyebarkan hoaks.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b59a55b27bff2977fedb15b713f8c9a24bc56f3d775e08ff7ae9591148b9b40c",
      "text": "Buat siaran anak, buat khalayak di televisi, sama surat buat bupati.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6514eaac35a91646a7ff36e1f9d96374d3b843a328c6ad1ae8fef6cbdb6f560",
      "text": "pembawa berita",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b684f5c8388ca457970fed317d6213579ecf116bb315f1d22a6c4202b678b9ab",
      "text": "Pilih satu yang paling santun dan jelas, lalu kita muat besok.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8d10dee4ab689d25c13d08cdce05a7b15aa3a8319c5a65f355f71517221d98e",
      "text": "daerah pemilihan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9084ca4925501452c9b79f0c671a29cf5c861d70118026e16f0e4fb22122915",
      "text": "prioritas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9482bf11b5f1535b1744b6f0645b01fcc60831b5cf015b9e627cc677a273a1d",
      "text": "Apa arti \"ambang batas parlemen 4 persen\"?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9517ecec20cb25ebae1e34b1d08697d39d0342977eac7af52cfcc4daad2d198",
      "text": "Banyak wartawan melakukan swasensor karena takut.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "bafae1ffa80f91e41711aa00ed54ae281e57ba0a94b6e45c998ffac2a3ba3ba4",
      "text": "Kata warga, pengaduan mereka udah tiga bulan nggak dijawab.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbc2dcf1c69d3f7c8c5fd6517ab7778cc4da3f57be2711549b1a246404ee9036",
      "text": "Tahun ini, warga desa memilih air bersih sebagai prioritas pertama.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce64d0901461683fe870d0066a433202252ad78624d2c8a5df3d1ea3792027f",
      "text": "Dana desa tahun ini akan dipakai untuk membangun sumur.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd1194d36e5e57e2bf9651c7a76ad36f72ebfa449991f3ef361e4f55d5e8f5f1",
      "text": "Seorang kontraktor memberi mobil kepada kepala dinas sebelum tender. Ini termasuk ...",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "be215afeb628ceeb729c94c6801eecfa52fec1fe98de4ec8026b8948dc6d72bc",
      "text": "Boleh, tapi jangan tanya pilihannya. Itu rahasia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf750cd9ae4d0ed827fce0927db510cd71576eb5b076fc09cd9a6fd04c9ff3df",
      "text": "Sekarang ada enam, kan, Bu? Setelah pemekaran tahun 2022.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c06445d525177c4c086b7585468a0cf98ae45024106eb1d6780c11c353fa4dd5",
      "text": "reses",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0adc1b8ea89ded53a130f65a5fe3069e2d9e52e0f8de52a169fc3b0520bf75e",
      "text": "Faktanya bener. Tapi kita lupa minta tanggapan dinas. Kasih dia hak jawab besok.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1f7a06a13b41691a7e6a0bae03dfd7ef062e2af3dc60b99604553f5fa3260cc",
      "text": "presidensial",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c302320fbf5952cd1bb54cbe805ff5b74bbf8ecd3b917c7f47dae0dc068548f7",
      "text": "Mahasiswa itu mengajukan uji materi ke Mahkamah Konstitusi.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4aa0010bebe3e05fd5667b5ac69f6b316a0b46857c9e617411a17afded7e64c",
      "text": "Para pemilih ingin mendengar visi misi setiap kandidat.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7a09eba295459b75989673a37e207b30bf7f7eb2cf164355004aebd2f22e42f",
      "text": "Jadi kabupaten Raja Ampat sekarang ikut Papua Barat Daya.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7abefa81868cdfcd72a639ac094888cf9a317f30317fea6cd8d41ff70497d6f",
      "text": "Banyak radio komunitas khawatir dengan RUU itu.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c90f5a5291d1203994d652253e58a05fb5c8068c2244cb6f76f893ad65db61c1",
      "text": "Lima puluh ribu buat surat yang harusnya gratis.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9b06bf6aab04f0953fa7c21d46cce7c59da8342b22568edf2dad7379f2186ff",
      "text": "Gunakan hak pilih Anda pada hari pemilu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce35a5b55265907c7a64e3635be07ad006d154d7433241aea812adccc3c882c6",
      "text": "akuntabilitas",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf0266214eaed2c6578646e7e1254dfc1eaa4f371c4cb9bfb5225e4d94887242",
      "text": "UU ITE",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf2aabb538a19ff7ca6ba78207f92e3b2d323c54793d21e900901dd65ced2182",
      "text": "Dia baru aja reses di Sorong, kan? Pasti udah dengar suara konstituen.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf4c97a725cc6ac4b75aba60488c291bd31e6b690d9ba66b2e71bc83817b160d",
      "text": "Dewan Pers",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf53d93f1eb94d16f11104c214c5e5bd375736e51bcfe2f1cd60e491d29dbcda",
      "text": "Siap. Saya tanya aja kenapa hak pilih itu penting buat dia.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d093dc3e3a7c9360b19be83e6c2e5116fa80effd035892b4d0564261c5af4b6e",
      "text": "Bagus. Terus tanya dananya dari mana. Pemilih suka jawaban yang jelas.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0b08797aaf170744a6bf0de7df64a59e9c603af05ee2bfc7da75f99dc6ac3a3",
      "text": "nepotisme",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d18d370ec082eb0504e95ae30f2fed878df15882e5d6136b097adc0ba45ccd1c",
      "text": "gratifikasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d22779b81821bf24a71f03b3904a7a576d2af5182acab59c1085e2da9bea04a5",
      "text": "Partai kecil itu tidak lolos ambang batas.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc203f2e6316a1a2beb6c43e6d59ffbf126ae70eb409f7629f73ea89e38d51da",
      "text": "Pejabat itu ditangkap karena kasus penyuapan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2c5d1b6bdedf348fa72643733cde0bc67bd89776ce1bca1ba3fb9b13d9151c1",
      "text": "interpelasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3cea1a61a7149e6c3534782e458ae5835093ef00b2e8b13396c04d41d1eaa32",
      "text": "Saya baca tentang dua misionaris yang datang pada tahun 1855.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3db64891a3753e742ca8796b2b1f7c0285979d14f6ab7309ce8048d0830cbb8",
      "text": "Beberapa fraksi mengajukan hak interpelasi tentang harga BBM.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e72a197d347b2c8c1990e380d71678d475c40002de2458825183e0037fa535e4",
      "text": "Baik. Yang untuk bupati saya buat lebih santun dan baku.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9f5e0038a30608bab82c58f124875ec92483ee311a36107960cc8c57b4c3285",
      "text": "Mohamed, kepala dinas nelepon. Dia marah sama beritamu soal jalan rusak.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb4acca09cb990fa01bbb4f1f8e81a3e661150d93c31b9b438037c2c114de4ea",
      "text": "Wakil rakyat menerima pengaduan warga tentang lampu jalan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebe3dace83b44349e20ff4c39c06895a64785145d5f494a1d823a9932da19b24",
      "text": "Terima kasih kepada kedua kandidat. Waktu Bapak dua menit.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec30eea5e583b819f2d6c9ff5d015dd566fcd0f9e1709333d8fb207fd0f83083",
      "text": "pemilih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed35e3845c35f219b87681c07fabf4c2529e9f1e5beb18498a36b349185b6a78",
      "text": "Pada masa Orde Baru, sensor membuat banyak berita tidak pernah terbit.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "edc014425a146140c0aae6ce4b71ce7ce08374f86dd87da16982f0da1014b4c8",
      "text": "somasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "edc4af5bfff691a68d9e25d28f7204e9b088e46b2ac82f4c38dbecd95d60fc8c",
      "text": "Kandidat nomor dua berjanji membangun puskesmas di setiap distrik.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef033128b80a2b3189997a8bc2e1f52e6b7a4ba20092bfe816e2311f9eb96b04",
      "text": "Mohamed, ada pendengar nelepon. Katanya ada pungutan liar di kantor kelurahan.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef1417e590ef98e02767c29a638dc790098e0beeabaa58b597326002b9f54f03",
      "text": "surat suara",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0370145d6bc6408ada6ac3a107001278dd5ea8bda47fa2e6781aa97ba393f44",
      "text": "Baik, Bu. Saya juga kirim salinannya ke wakil rakyat dari daerah itu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0e1d502768dce43a32d91879d8236ce6801f23c311ea1b6b81c33677f58b4d4",
      "text": "menyesuaikan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f322c062a802d5890c7f31f5f3d77e80594b2d6566b3a17138d198f136c9bd59",
      "text": "Wakil rakyat harus mendengar aspirasi warga.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f53cff5421f92f19d4c95fad6571e75e6b074aaa19d0e561128f3c2f7a93df02",
      "text": "Bahasa yang lugas membuat khalayak cepat mengerti.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7da33d5c34d5ec1df10510015558e3a3663d690ddc01c9bfe383f8da1799b69",
      "text": "Hakim adalah bagian dari kekuasaan yudikatif.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f91c42f190d19ec5f3b43076dbde076f177a3f0ce7835572f67be6d40066bd39",
      "text": "musrenbang",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9ce1b60afbec0b8737de175a23afe0a22ade9135ccc984e678bf569dcd4543e",
      "text": "Emang beritanya salah, Bu? Saya udah wawancara warga dan lihat sendiri.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9ea1ade540d4c599bd5b9442f91ae46c1a7db013787b53cd35df8a096712248",
      "text": "Setuju. Terus kita minta transparansi tarif dari lurah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa1044134bd0b9773e0572e60582a5265ea6ef3074e7c8186f938d4454018436",
      "text": "golput",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb6d9cb5152f7fc8c267a71095339dd094d3b9f5c039040dbddcfbb07c97493e",
      "text": "undang-undang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb976eb9b8520ea8ae361980d7f90c46090e1bd27d1ad52a51bdce2489eb7cc0",
      "text": "Pertanyaan pertama saya, \"Apa visi misi Bapak dan Ibu untuk kabupaten ini?\"",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "fba4bea5a80932f56e7139f1dd973c704116b5cf9ff07cdc3da72348961ec603",
      "text": "trias politika",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "fef7cdceeac05d2247f2d3512c508ea92da96683409f54e224ca5bf85c1acf32",
      "text": "Pengacara itu mengirim somasi sebelum menggugat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefa6c4670b7e7f0f05b555652118d1d62812caeac0d02405b3ccf78a097f345",
      "text": "kriminalisasi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    }
  ],
