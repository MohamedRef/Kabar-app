    },
    {
      "id": "bipa7.u07.l02",
      "sha256": "278025a99226a9927793b5f19b0f2a6272dfa920e9bd36de63147b4c8a56b9bd"
    },
    {
      "id": "bipa7.u07.l03",
      "sha256": "f6a890e48d16e80ff98b7de0feebd1faa72498ef14ab03e62094a306534e5407"
    },
    {
      "id": "bipa7.u07.l04",
      "sha256": "235918f24a1905761f0265fca4a047ebc0524852f3b4747d9c46cc1fda5287a8"
    },
    {
      "id": "bipa7.u07.l05",
      "sha256": "dbefa8226b06b0a76edbc58a0d2296aefb424e8e051a9f3af98787f267b3cc3e"
    },
    {
      "id": "bipa7.u07.l06",
      "sha256": "c0fd80ed4664ffacff486ebefbc4bbf95caca054e16b30ec3ee6d6399e12fdfc"
    },
    {
      "id": "bipa7.u07.l07",
      "sha256": "ab1f98d1a3cfd0ba01184172973a69082aca9970b37d3591f3854791d53ec04e"
    },
    {
      "id": "bipa7.u07.l08",
      "sha256": "5ced973a2a3bcc536f985eedaa99a0ca9b4d3c1356e4226e29024db29b9e8bb9"
    },
    {
      "id": "bipa7.u07.l09",
      "sha256": "bcfabcf81eb80c26c62a210895de5ad138275b3c8f778f2273978c90151cdc45"
    },
    {
      "id": "bipa7.u07.l10",
      "sha256": "607b0e139a8987b4d32a18e89ef430f5e2681297d9822d28fefaee09ebfdb3c3"
    }
  ],
  "audio": [
    {
      "key": "060e048db01e1304f9316ab14ab20520cd09d9601f0f62877cdf0058af1ee0a3",
      "text": "aspirasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "08c8d5bd222dbcefb4f6c9e2643bf0bfd6b297a574843ebc055d17e3ff940010",
      "text": "kabupaten",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c4979a08c49bc4397931284099c12505a14fd89452b04acb2ba6618a90d78e1",
      "text": "Setelah surat pembaca itu terbit, wakil rakyat menanggapi pengaduan warga.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "109000afeb2a4b26b62b12341745f5c293bfd560d546e11ed0252671c782a9dd",
      "text": "Sementara itu, TNI mengirim kapal untuk membantu korban banjir.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "12f893b56e57db80ab1e7e5e9054e6a083c82ccdfb1fe4b3e1963a7cd428365e",
      "text": "Setelah mencoblos, pemilih mencelupkan jarinya ke dalam tinta.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1349791e0b90818fb62af720dc8800089c6092fc458e0fa6848123ad5c981617",
      "text": "pemilu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "17e48c51c010b011bd4917af667a9a8d5a19b5c7a0002cad0e5a6defcdc7a326",
      "text": "Artikel opinimu untuk kolom anak muda sudah selesai?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b68d03d98806fb354048220119b394f1cdf66916b2f7b992ac6a2e858dd4900",
      "text": "Setelah reformasi, Dewan Pers menjadi lembaga yang independen.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1da0d956e692eb6eb052e794d0fc5ec3103f94cdd01cd09780b58a494c7fea4e",
      "text": "Tiga kali? Untuk siapa saja, Bu?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "20f3ee926c76ddcf7981a81533e870175c28f86c32561d82845835e6a61fee6a",
      "text": "Bapak kepala kampung bilang jalan harus jadi prioritas. Tapi mama-mama di belakang minta air bersih.",
      "voice": "id_ardi",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "25465549b5cc41fe1e3128465dcc51ae2922520ea231860c725e986eaba5fdfe",
      "text": "Pada Pemilu 2024, jumlah pemilih lebih dari dua ratus juta orang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "26c4d3113c984b2c489f4c3deee270976c9d6ff432fee8eeaf35a3deb35d5aca",
      "text": "Partisipasi yang tinggi membuat angka golput turun.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "290d3c39cb3a8f0500919ba3e1c313bf67aad63a0cc257ccb412073fe99d4d88",
      "text": "Hari libur kita ke Mansinam. Pulau kecil ini penting bagi sejarah Papua.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "36797fd4a0b10f3bb78a4a1e5e951840c7dad0a192840fed81532b277e04dda8",
      "text": "Pembaca sasaran artikel ini adalah anak muda.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "368242edccb07b42d1a063eb8678e04cd17339a9296e9e9a92f76795b66b8252",
      "text": "Kepala dinas itu memakai hak jawab untuk membantah berita kemarin.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "394d8a7347764b673e907e5655824d3dc08be43cd6582838d6d0ebf3201c17e8",
      "text": "Sekarang Indonesia punya tiga puluh delapan provinsi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a258feddb3bb75948bc2699c7daf776c0946c20ef28bb8c6dc4c16c50ef5255",
      "text": "menurut hemat saya",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c1074f6a7cdd9aebf05ec0a83d249698852377ae309e6b59608ed9d696b2f45",
      "text": "Pembawa berita sudah siap. Saya pegang naskahnya.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "415b914c2f67c646eff293929f739e53d1d953d2a55ce38fcc49f51a6e4d2970",
      "text": "Berita untuk khalayak harus lugas, sedangkan surat kepada pejabat harus santun.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "41bef065f59874769ab712a2329b5c30c0c554f90e8cef76f7f58c6bfd2e703e",
      "text": "Betul. Sekarang tanggal 5 Februari diperingati setiap tahun di Tanah Papua.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "429b5325173f20bbee4b18ad79aeb807dae4e7c98ecdc62c35eb5fd551225b53",
      "text": "Mohamed, berita penutupan jalan ini harus kita tulis tiga kali.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "4552e78f86b833809204f1264fd23f7f0b6a655becd6f088641fc255f1d4559e",
      "text": "khalayak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "46fab1d1da547a5cab0f67fd49d6adad200fe4dd039464cf65e7052064a6513d",
      "text": "Tulis kedua usul itu. Dana desa terbatas, jadi mereka harus memilih.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "47150870ed3e5298495d332537321a4465b4351e4b8e58b8a5658ad68bc61af0",
      "text": "kebebasan pers",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "48957fc91cfb4f9598b2472a773ed2542fb0751e961e1e131f9b0d80af2a4eaa",
      "text": "DPR",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a50fe5735ca29c90db065b009a4ca8627f63b75a4582b04aea6fca62f84886",
      "text": "Berita untuk khalayak umum harus lugas dan mudah dipahami.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "49c4d656c0be22449bd1cbceeaa7bf1e80f3c141b9f376deb07ad8e666a208fc",
      "text": "Setiap orang punya hak jawab atas berita tentang dirinya.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a0c73898e94c3119a193a00b9f92491b0d1b04fb6505cea36ab3b9cf69a3a0a",
      "text": "Air bersih menjadi prioritas dana desa tahun ini.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a99568cedecf2a3329053ecbcabcbd1aaddcb021096b65d7c8fe15216cc1c0d",
      "text": "visi misi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b39b9e4a6713cf5de1e4d3a53dee1f15dd00772343fe550994d6f0ba98bffd6",
      "text": "Menurut hemat saya, partisipasi anak muda menentukan masa depan bangsa.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c8cd015355c994a3192a674b9089183c0a3da3acdae16e9c97f52c15d30ed37",
      "text": "kandidat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ccad9cb35b9acaf734a778fe719a0bffa42dd7e5ebe021ed3698d9183e8850f",
      "text": "provinsi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "511322da9577d57a4c062cf22129bf16b1f0e375db1af627da2da3c4dffdc0f3",
      "text": "sensor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "517300cab78c051b8e42672620940d3c491e1a429439ddb830dbafc3f65957bf",
      "text": "Kita liput musrenbang di Kampung Arfai. Catat apa saja usul warga desa.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "527a18c20ff145ec224af22b97c8c890264e8903a432ed8722182a105b54e19a",
      "text": "Terima kasih untuk semuanya, Bu. Minggu depan saya ke Jayapura.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5336cc1e549555f26e3d2bb70fdcb956f509b17be2ccfafb06acb16a3c2fc260",
      "text": "pembaca sasaran",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "538477179bbfa81842453f66cd762ac1a730ec5d7624e1ec514b986cc318b1eb",
      "text": "hak pilih",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c6f07cb2c82f63e7f2cd979f8739828d44fb4fd2eda0aace32d962cef6d949",
      "text": "Artikel opini itu ditulis dengan bahasa yang lugas.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "55e5510c770f73024552cdfd271fac50477d18ddfb37f4381ba70b42db11e56c",
      "text": "lembaga negara",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "56529bd78fe8e832ce1e4eff796bf58ab4dbddd40fb0fdccff39f2877c3ebcfc",
      "text": "Pada tahun 2022, wilayah Papua mengalami pemekaran menjadi beberapa provinsi.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "567051f65357efedb2679df0d11ce593ee89873f013c03eb86fe01dc62e7b0ba",
      "text": "Majalah Tempo pernah dibredel pada tahun 1994.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "57939e5b3f041c10caf98c4f8bbee0faa9ab6fde7fb630b22bec985ef2364660",
      "text": "warga desa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "59d052ea3239724c3c19a28e23b1af32cf4b9e98db556f064002e8f967597404",
      "text": "Angka golput di kalangan anak muda masih cukup tinggi.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eeb2e536ad64d71fed9195f0be939d93676afa95d1dc7dc007ccfbb3953f355",
      "text": "TNI",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f843a73ca3ff234155049dfd4b9fedf78ea79527f5a0c59e8551beaa136a940",
      "text": "Dan setiap kandidat dapat waktu yang sama. Saya bawa jam tangan!",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "64bc604db9c400ec73e7af1f1f28358ddea0f1a4935d150e8f19da197aa14cfb",
      "text": "Mama itu baru keluar. Jarinya ungu. Boleh saya wawancara?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "684ca91bfe4b9329db8c8aa20e98550cf445287629dba25db11e09504ce7d41c",
      "text": "hak jawab",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "68ac68a1e7623131f6b2d717136be9b1ab92f524653336507e7a8cdb59e18677",
      "text": "mencoblos",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a587c90b6702be1db65ecbf80fbabd21501217343d6b3ad87b35b5bab0dbf49",
      "text": "Surat suara itu sangat besar dan berisi banyak nama.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b7d14ec8958a447111f9ccd2d8632a39616e29b7239b895e39a29ce34e75eaa",
      "text": "pemekaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6de208cbb0d24965f022a2ba55b65f8f85489fc22122427aa0d50562c356dce8",
      "text": "DPR dan TNI adalah lembaga negara yang sering muncul di berita.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e616997f3a62b95c9b176080e497b8f0dcd988575cad8aa9ce52f4aa2a4a3dc",
      "text": "Pemekaran kabupaten itu membuat rumah sakit lebih dekat dengan warga.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "71cf321a7daa692c451a2d614bef3b1801e9178623391b8d975865e26411a7fd",
      "text": "Pelayanan publik yang baik adalah hak setiap warga.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "72ed8922d843597a1db8eac223bc69044e05a5758a84d0044b9da771e824bb36",
      "text": "Saya ganti dengan pertanyaan, lalu \"menurut hemat saya\" di paragraf kedua.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ff323a43c4ce9b41ac62bb4a7af6acc4b1051eac626a16415db7365f5b2dab",
      "text": "partisipasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "799b94af09abfd5a63a77425e9958a3a53ba0607dfeff6692a538ea28167f619",
      "text": "dana desa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "79eaa8823b8407284b5863767bb248d5db323029a32ab5065547589ac9f73bc5",
      "text": "santun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7abb4a5f5f9e3893e873ff6424451f03413947dcc008b6d4fade679ce33e47bf",
      "text": "Artikel opini ini ditulis untuk mahasiswa.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ac0ffdceaffbe3d406676b8372951842e6cb39fceea095108214f12a85cfb6e",
      "text": "Visi misi Ibu bagus. Tetapi dari mana dananya?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cbc114721d0f13d6b013d2708a32697c3b14e325aecafe0dd182e879c08383a",
      "text": "Kata warga, pengaduan mereka sudah tiga bulan tidak dijawab.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d1cb12e50b12a30b94642581bb91ecafb1756b93157bb0059d6ec41288dc9b8",
      "text": "otonomi daerah",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dd0633f0a1364fe2054d8c4307e1e19c0b8e56c902d9d8428d9232325286042",
      "text": "Pembawa berita mengumumkan bahwa DPR sudah mengesahkan undang-undang itu.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f4a4ee70111f508708b8678c53f190ba5d50233d846c9d3b7a7414f7d3925a8",
      "text": "Kita liputan di TPS dekat pasar. Pemilihnya sudah antre sejak pagi.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "801d64064abc03e59ce7486130a08894e8fb44fda1e11d0e82c3493b2e037285",
      "text": "Apakah beritanya salah, Bu? Saya sudah wawancara warga dan melihat sendiri.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "82f7b46179ceea27dd0e67772c58e56111f0133308a9cbcbead1701e848a339b",
      "text": "Siap. Saya tanya saja kenapa hak pilih itu penting baginya.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "845250b8e81124026789761618f387d0f0e5400b0915ceaa7405d8b3674f166f",
      "text": "Baik. Kebebasan pers juga berarti adil kepada semua pihak.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "873d82ea2ad50510600b71dc1c95d1ec9799a4193fb665d5202bf30bc96a45ce",
      "text": "Malam ini kamu moderator debat di radio. Ada dua kandidat bupati.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f6278fca30fcbf77aeadeded389ba26753045bc44ffc77ee73e25c52244e93",
      "text": "Tiga menit lagi siaran. Berita pertama tentang DPR.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a5d52121c612634cc2c788e8b4d9f784936a5ac583b70f2c683aa2dc93faee6",
      "text": "Penulis yang baik menyesuaikan gaya bahasanya, lugas untuk khalayak dan santun untuk pejabat.",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b8b3579dbef5cea4686a15326e87a11c0fe87fa699aad397766d9b160471644",
      "text": "wakil rakyat",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb489d20bd9b97647bc2dd2b8041a12dd7964a8b20c4f9055f5b30b4dde5d83",
      "text": "Warga datang ke kantor DPRD untuk menyampaikan aspirasi mereka.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "9071388d946883656ac3c7328a118c6dde0fab033eb4de90edd35f075250eb78",
      "text": "Hari ini banyak surat pembaca tentang lampu jalan di Sanggeng.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "91dec8d1c4d2da0ed72ef8252a69b14727cf43089088ce4bf905dc1c61f44d29",
      "text": "Betul, tadi siang. Sesudah itu berita TNI dan banjir.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "92a4be7ac026202a0b489d19970894a7f17189d65fb95ec6dde246e4a4f3adc6",
      "text": "Hasil pemungutan suara, air bersih menang! Suara mama-mama terdengar.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "9415536d3c4b030747fe14282717933258079295f032567eb2efb33c2cdc4003",
      "text": "lugas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "95cc69a3bb1d2580b9305afe98ffaf8cbae01439278ef309ec620df172c6735f",
      "text": "Hampir. Judulnya \"Jangan Golput, Suaramu Berharga\".",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "96a0b5af44980a1da89619e35694aacf150315351a1e9e0b041d233348d5aab1",
      "text": "Undang-undang baru itu melindungi laut Papua.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "992f8514ae62e72564c920092eccd0828f2cec868d04e4cc5a0e0bb011a4c92c",
      "text": "Betul. Manokwari tetap ibu kota Papua Barat, dan Sorong ibu kota Papua Barat Daya.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a945bf6331c784abf387236f802468ce0a84bf2760965affaa7df29d13b5855",
      "text": "Manokwari adalah ibu kota Provinsi Papua Barat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d287faaaa733bbbef48bb263e61f560612a5b2663db1cb74d399d4ed037babf",
      "text": "Pembawa berita itu menjelaskan peran setiap lembaga negara dengan lugas.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0f8387b390acf7bf4ade311674a4f2ff4a4b879114005ec2e6b813f29137254",
      "text": "Dalam musrenbang, setiap warga desa boleh menyampaikan usul.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a566f1276e780b5dcd8e8a24d86099380119481f2b79b982debaf84562c13b3c",
      "text": "mengesahkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa789e8ca7f6efbbb85ff5d1664ca4b7a1ab35b337c2df173542f8ccd0c14ec4",
      "text": "pelayanan publik",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "aac77585a465cb9111863df9a63fcda9743dbfb158b80e5802ad058ed81340e0",
      "text": "pengaduan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac41a72ddf89bddf596bcfa697dd6b0db3012f59178c7f4001ba965af523c0d2",
      "text": "artikel opini",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aca115483eeece9a58d6ec1956f463a1211dadec9144fbfe23e44dc491cb2d25",
      "text": "Usul kami dibawa ke musrenbang kabupaten bulan depan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08fa816187893aef4ed870cfa59ccd97317d636ab7605fba4cee362353e418a",
      "text": "Setelah pemekaran, Sorong menjadi ibu kota provinsi baru.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b133a1759a27f36be024e73833428e21d09bc73f21ca190805aebe3e79708617",
      "text": "Dengan otonomi daerah, kabupaten bisa mengatur sekolahnya sendiri.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4db9f71cd0472d9fa5488e5b1ca90b3a1caad9111f9d5bb32c2c0ffdb3925a8",
      "text": "Kebebasan pers bukan kebebasan untuk menyebarkan hoaks.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6514eaac35a91646a7ff36e1f9d96374d3b843a328c6ad1ae8fef6cbdb6f560",
      "text": "pembawa berita",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b684f5c8388ca457970fed317d6213579ecf116bb315f1d22a6c4202b678b9ab",
      "text": "Pilih satu yang paling santun dan jelas, lalu kita muat besok.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9034450fad94140e26151950ce38a0f9a4fbcacc6b35562c4a92ec74ec4a3ac",
      "text": "Undang-undang perlindungan laut sudah disahkan, ya, Bu?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9084ca4925501452c9b79f0c671a29cf5c861d70118026e16f0e4fb22122915",
      "text": "prioritas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbc2dcf1c69d3f7c8c5fd6517ab7778cc4da3f57be2711549b1a246404ee9036",
      "text": "Tahun ini, warga desa memilih air bersih sebagai prioritas pertama.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "bce64d0901461683fe870d0066a433202252ad78624d2c8a5df3d1ea3792027f",
      "text": "Dana desa tahun ini akan dipakai untuk membangun sumur.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "be215afeb628ceeb729c94c6801eecfa52fec1fe98de4ec8026b8948dc6d72bc",
      "text": "Boleh, tapi jangan tanya pilihannya. Itu rahasia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf750cd9ae4d0ed827fce0927db510cd71576eb5b076fc09cd9a6fd04c9ff3df",
      "text": "Sekarang ada enam, kan, Bu? Setelah pemekaran tahun 2022.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4aa0010bebe3e05fd5667b5ac69f6b316a0b46857c9e617411a17afded7e64c",
      "text": "Para pemilih ingin mendengar visi misi setiap kandidat.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7a09eba295459b75989673a37e207b30bf7f7eb2cf164355004aebd2f22e42f",
      "text": "Jadi kabupaten Raja Ampat sekarang ikut Papua Barat Daya.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9b06bf6aab04f0953fa7c21d46cce7c59da8342b22568edf2dad7379f2186ff",
      "text": "Gunakan hak pilih Anda pada hari pemilu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf4c97a725cc6ac4b75aba60488c291bd31e6b690d9ba66b2e71bc83817b160d",
      "text": "Dewan Pers",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2f5c80767f2f304a66ea58a977a65d6b44d7b0374b8409bd3c996c63bf56845",
      "text": "Mohamed, tolong ganti peta di ruang redaksi. Yang lama masih dua provinsi saja di Papua.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1b3257ee11d20a079fba7c48fcec8ad498bcaa20bad264c60f11b9cd97f8188",
      "text": "Untuk siaran anak, untuk khalayak di televisi, dan surat untuk bupati.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3cea1a61a7149e6c3534782e458ae5835093ef00b2e8b13396c04d41d1eaa32",
      "text": "Saya baca tentang dua misionaris yang datang pada tahun 1855.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e72a197d347b2c8c1990e380d71678d475c40002de2458825183e0037fa535e4",
      "text": "Baik. Yang untuk bupati saya buat lebih santun dan baku.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb4acca09cb990fa01bbb4f1f8e81a3e661150d93c31b9b438037c2c114de4ea",
      "text": "Wakil rakyat menerima pengaduan warga tentang lampu jalan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebe3dace83b44349e20ff4c39c06895a64785145d5f494a1d823a9932da19b24",
      "text": "Terima kasih kepada kedua kandidat. Waktu Bapak dua menit.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec30eea5e583b819f2d6c9ff5d015dd566fcd0f9e1709333d8fb207fd0f83083",
      "text": "pemilih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed35e3845c35f219b87681c07fabf4c2529e9f1e5beb18498a36b349185b6a78",
      "text": "Pada masa Orde Baru, sensor membuat banyak berita tidak pernah terbit.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "edc4af5bfff691a68d9e25d28f7204e9b088e46b2ac82f4c38dbecd95d60fc8c",
      "text": "Kandidat nomor dua berjanji membangun puskesmas di setiap distrik.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef1417e590ef98e02767c29a638dc790098e0beeabaa58b597326002b9f54f03",
      "text": "surat suara",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0370145d6bc6408ada6ac3a107001278dd5ea8bda47fa2e6781aa97ba393f44",
      "text": "Baik, Bu. Saya juga kirim salinannya ke wakil rakyat dari daerah itu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0e1d502768dce43a32d91879d8236ce6801f23c311ea1b6b81c33677f58b4d4",
      "text": "menyesuaikan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f232b36e1dcf7bc05dbb207fc14e029a8d6df7e25880bf569349b7b3f8aae760",
      "text": "Faktanya benar. Tapi kita lupa meminta tanggapan dinas. Berikan dia hak jawab besok.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "f322c062a802d5890c7f31f5f3d77e80594b2d6566b3a17138d198f136c9bd59",
      "text": "Wakil rakyat harus mendengar aspirasi warga.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f53cff5421f92f19d4c95fad6571e75e6b074aaa19d0e561128f3c2f7a93df02",
      "text": "Bahasa yang lugas membuat khalayak cepat mengerti.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f69ca9499fc51ebe96dee90eeb7eab945a61ef08ede4cd909f2f7422f72977bb",
      "text": "Bagus. Lalu tanya dari mana dananya. Pemilih suka jawaban yang jelas.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f84988f2e69cbfca5f99f06446ad58ea1a7b8c269d60c9c708965093cf57c3a1",
      "text": "Mohamed, kepala dinas menelepon. Dia marah dengan beritamu tentang jalan rusak.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "f91c42f190d19ec5f3b43076dbde076f177a3f0ce7835572f67be6d40066bd39",
      "text": "musrenbang",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9986d01a16d8b7b79b82ee241de231468bca6530bf8674dbf315038be0ff4ef",
      "text": "Bagus. Tapi kalimat pertamamu terlalu panjang untuk pembaca muda.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa1044134bd0b9773e0572e60582a5265ea6ef3074e7c8186f938d4454018436",
      "text": "golput",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb6d9cb5152f7fc8c267a71095339dd094d3b9f5c039040dbddcfbb07c97493e",
      "text": "undang-undang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb976eb9b8520ea8ae361980d7f90c46090e1bd27d1ad52a51bdce2489eb7cc0",
      "text": "Pertanyaan pertama saya, \"Apa visi misi Bapak dan Ibu untuk kabupaten ini?\"",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 10,
    "clips": 123,
    "chars": 5614,
