  "unit": "bipa2.u03",
  "version": 13,
  "content_hash": "1f9b1d0ad41ad9bd006a6f8c7b13143d01007b44a76505cca4d19e551ae60b57",
  "lessons": [
    {
      "id": "bipa2.u03.l01",
      "sha256": "e3738691f5a270f5f0bc8f9f85379585d40f577c5970bf4352c95da76b216b26"
    },
    {
      "id": "bipa2.u03.l02",
      "sha256": "de61f340a3adcee3cfa3ca7d42a729f658379f4ed7c53a31f9d2ca66eff5e6ab"
    },
    {
      "id": "bipa2.u03.l03",
      "sha256": "e01ce14a994d4628e59a6cddf3381e3e577c2aeafabb4dc1e46c7817c2221b62"
    },
    {
      "id": "bipa2.u03.l04",
      "sha256": "4a9012e03cb8d798133eec058c101577819faa5c48f4be0f84368f16fe26cdc7"
    },
    {
      "id": "bipa2.u03.l05",
      "sha256": "679c5e35c2680cc866f44a99ddb9f912de2cdfb36a85e85b5e92ffe4c222a1dc"
    },
    {
      "id": "bipa2.u03.l06",
      "sha256": "f50611fce98c3d92820d6552374be2758373c220018e5220fc32b5bb32faf557"
    },
    {
      "id": "bipa2.u03.l07",
      "sha256": "44a1a08cd71fcc34e25b60c59c6ef6ef020ce41c5c71bac02c9b1f238c01ce6f"
    },
    {
      "id": "bipa2.u03.l08",
      "sha256": "a14f58c28bd1da8f944fcc02339d4b54a9627d3c204c8d3c2e12dde203a51572"
    }
  ],
  "audio": [
    {
      "key": "00674947cd34306d2ad92bcfce6fc63962ef993146bc351dc40f51a6757f6828",
      "text": "Penerbangan ke Jakarta terlambat tiga puluh menit.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "01496027364b7d8db97bb8d09fa4b257d17ffa9144d97dc683e8244dedc36d28",
      "text": "Di sebelah kiri, dekat kafe. Air putih di kafe itu gratis!",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "014b5680040993128ec1f91b565160046cf952b9777da5ffa4762be0c90dd374",
      "text": "hati-hati",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "02902583aba871a8c8309ec16e747b2c9a06d22fa8fbbf09ed3884c6dd0f8e50",
      "text": "bandara",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "02fda8b35cacc5c713e92abd8a4200107935e539883ec37d35c3c47af24bba15",
      "text": "Mohon perhatian. Penerbangan GA 402 tujuan Jakarta terlambat tiga puluh menit. Mohon maaf atas keterlambatan ini.",
      "voice": "id_gadis",
      "chars": 113,
      "mime": "audio/mpeg"
    },
    {
      "key": "0549e93fe694e9a6c3c744ad8835fd6d056fdf787e09ce8f4ab0dbe2d2801472",
      "text": "merokok",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "05bffbfdc6a33d4793ea781faa990dbc913521eec07e212f5b3bad774fc70d1f",
      "text": "Harap tenang.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "07546e5b2f2360d3697495461bf7dd251a58ffc68cdaf33ddbafbbf8af5e9931",
      "text": "aturan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a033a10548d21b101a9633ac8e37a08e894aced20e7be9bab67d46f736b2df7",
      "text": "pesawat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b7ba7e3f401397495c309f238d1354aed47fe306bef5d2dbcc8fd381059f2e4",
      "text": "Bahasanya resmi. Mohon perhatian, harap antre di sini.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c11dd913e1839478521a39e3908572cee3e24fa20137f46ecc44f89d4196aa4",
      "text": "Beberapa pesawat berangkat pagi ini.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d7c8bc70c86dd94ff2a352feba66752ed98dea0299db19839b9abba5b66e7f8",
      "text": "Pesawat ke Jakarta berangkat tiga kali sehari.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fff8469163a9d49b9e1651dee9a3f0b69ace22e73f6bf8c9a599304527ffb7e",
      "text": "Dua aja. Semua oleh-oleh dari Mesir ada di sini.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1078779a24770c1c7ced6294da4b38b3ba3b5f35a76fe72d930f35a34440790c",
      "text": "Awas anjing galak!",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "11ade0fb30d584e6fb676b42c8144b55f5839467a34c3372ccad637087fb7766",
      "text": "visa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9091950441e5d5bf33401ea03c00dfb2d8304752f9cc57ef594a9946464aa6",
      "text": "Saya ambil bagasi, lalu ke pintu kedatangan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cb3d58d26e38dff12729b1395f59b1119274f06b2a632a02ddce381c4db8d27",
      "text": "mohon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cd4685f2ad2f929e560e43fc9333785fa37c47086a2a8405d3616a958616e7c",
      "text": "Mohon perhatian. Bus kita terlambat dua puluh menit.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f1bd9ab074fae583092a091a83f5f69e31d73e5ca33a459663ae8a27a35e29d",
      "text": "Wah! Kopernya berapa?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fbb4363039b215efd74884eeeec20be309b60f96561aff7ede564d111d56572",
      "text": "Pintu darurat di sebelah kiri.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "21fa2759efcc5158c12220e8cc0a5c29daaf4f3775ca612e2a55323edb57a511",
      "text": "darurat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "22a5fd81bfd5a3798cd51951d25b2bf9eb49cb9634a00f6a1f39682f16346482",
      "text": "tepat waktu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "233536830f231a51d636dcef5704752c10b1850bbdcec8adf3c1902c711d85e8",
      "text": "Mohamed, coba baca pengumuman ini untuk teman-teman kita.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "260aa3ad84eccf8d403ae4b5e2f2e4f99b984a9e6bdac47e74b8065fe6acc2dd",
      "text": "Dilarang merokok di sini. Itu ___ bandara.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2859350f9d761d6caba8051d9656710d5ceb85a9c339fc109c3df7f78d789258",
      "text": "Seluruh penumpang punya paspor dan koper.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c0a87ed9efda1e8c72527b15b4a3c60dbdb2432e1f0b7652971e8b5d30d400f",
      "text": "Harap segera menuju pintu lima.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2db53ae3466bfa91f76f97bcaa47c17686d3abf21044088bf1482c89c6828fa4",
      "text": "galak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fbff2acab17fc481247507285c4b0875d2700da469476d2dbd7dba6bd1b1685",
      "text": "Dan itu? \"Harap antre.\"",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ff11a8aed15bc999f82b91e153cd11e3c1061a1c22643b109cbe9c8aa8ed0e9",
      "text": "Oke. Awas, Mas, lantainya licin!",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "33ef3e304b5ea1a38a8610e8d5b7e774fe8ea9534e7ee91dffd943580d4313f1",
      "text": "Oh, maaf, Pak. Saya tidak melihat tandanya.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "34c7104f9f26b3323fec758029ef79fb1ff0878eb178438c1c93b270498f0adf",
      "text": "keterlambatan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3860eae4207f754f45708319677c17e4c3825755445ea429ecd7d6bab279b1ee",
      "text": "paspor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "38c80c88a14b710a09482d44941f75a9e8bb7a1edc7f55af12937626a00b1cd7",
      "text": "lepas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "38d3baa0bb0115c37a5faab06bb7cdf0f1785a6e70756348806fc316be627fa3",
      "text": "Oke. Dan \"Harap tenang\"?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a85b022793564363c018d618a7ccda5055a668313c68c981d52cbe45c16fdeb",
      "text": "Harap tunggu di sini. Dilarang merokok di dalam.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b9ede1d378dd486dd73830bb4333afca3010132d9b830b50e8ca4d6b05d7393",
      "text": "Pintu pindah. Saya menunggu lama di pintu tujuh.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c840d52f990501d4817ff3dd354ec615b2a9612baf9ca3b6fa64359de1d223e",
      "text": "Jadwal pesawat ada di sana.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "41c9705700056364658b0d053b4fb88f6412ad5a01557559f3314d472b9dee43",
      "text": "Artinya kita nggak boleh merokok di sini.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ac78b1c1d5fcab46ab0d63c2c3b8e7b010b0800ab9597a878e57bd18eae295",
      "text": "licin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "43accb3b7550aa22caba1e963d55eaf9fe2702b8954b45079063c1811113986b",
      "text": "Saya orang Mesir. Untuk masuk Indonesia, saya perlu paspor dan ___.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "444e089653642a4a702b47830a78ce41a0e0bd82ab0482c1c5a2aa3bd216bc83",
      "text": "Penumpang ke Bali, harap ke gerbang lima sekarang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "459962443c17cfafce407b788152ec11b6bffd277a5300a19834869c8d23d1b1",
      "text": "Mohon maaf atas keterlambatan ini.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "463f4e02c0dbdcac18384d07338f5ffa71121c3dc451a900030420f47b5d2d5d",
      "text": "Mas Rizal, apa arti \"Dilarang merokok\"?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4834d5b03698637396787435eb2d0e0010a081af14c38bd9ce68526c997648cd",
      "text": "perhatian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "48ceb8e85180a46a764831ae32b5943e3dbe0f27d06eb0107befde2194e290e3",
      "text": "Kita harus tenang. Ini pura!",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "49f36c9fe66c0bd24c2cfb3d250e94cfb82ac6513133373af90cfc31673aebf3",
      "text": "gerbang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4db4154c6d0dd934dba30ef8a79ca215f00c86e7c08cb6da23e8bdf0acbf632b",
      "text": "jadwal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "526e2474af92855a40458fd85bb07e344c597267ec532ca2b0ffad9044f7bd47",
      "text": "Hati-hati di jalan!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "54fc7add0730a27f1e0f4065e1f7f8b31feef59146e0aa895e24c8732cd0ecf9",
      "text": "Kereta ini selalu tepat waktu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "578a277507af4d59ed7efea35ed9d94137532d088b7619b3c7dc0973b0d928b0",
      "text": "Aku masih di imigrasi. Antrenya panjang.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b6c1ffa02dca2b5847a908490923c0870a9efde0ee00c8759142f11ae43cf5e",
      "text": "Peringatan: pakai sabuk pengaman!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ea8840e872cfb5df125911ff7f92909a40dd78c082029da65b319aa526be4fa",
      "text": "kedatangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ffe8d19570151ae39dbde330473d008cdb3ba6226d58ee0e8bfb9aeb4fe9466",
      "text": "Terima kasih, Pak! Untung pesawatnya belum berangkat.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "64885fe2a163e33dac17cd262730dd8701f17fe7da507a5b41d7058cf65540c9",
      "text": "Nggak apa-apa. Visamu udah ada?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "680e936cfbcdcf8a1f9ff64afe4011fbbc203c613e2a2b45fdaa16dfd0568656",
      "text": "Awas pencuri! Hati-hati dengan tas Anda.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "68f12f96de142c4c549f5dc619171cefa44a9c832513a9847f5842c7392cf4e0",
      "text": "Lurus saja, lalu belok kiri. Hati-hati, lantainya licin.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "68fc9b869e55c4b77e43687538885e5179ba3da23514ed839f319290fc8d2050",
      "text": "Baik! Aku di sini aja.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "68fcf7d2415bbe807a1f64e97fbd595bfd817faeaab27dbf0e96cd89d342292f",
      "text": "Setiap hari ada pesawat ke Kairo.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b3e111854168f1751c6c04673e3f5f30336854959765058dac72a15c87b9df4",
      "text": "awas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c117fa8de95d6aa732ccbd82ab87829a71396afd5898a301548f1fb6a3b0904",
      "text": "Saya minta gula sedikit saja.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f8527add331dd092c2e05ab2dab5f6767bee6bd4ad5d2089108003fcfe94268",
      "text": "Nggak apa-apa. Kita minum kopi aja.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "713b53d3dcb0c0858ea993c3265243e481157dad46910137854aae2f0e7ad8aa",
      "text": "penumpang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "71dfafa7e1280a7295ce3634889c4f17186b588d3abe9d6463064cc3b749e262",
      "text": "Harap lepas alas kaki.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "722ce711045b31d500316896838ee28f32de1623ca3ddaa7f7baec2ab654b8da",
      "text": "Udah. Sesudah imigrasi, aku ambil bagasi.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "73975f2a4f4722a3039b0317a127429bd4c50ac4ed29580dbaa8e5a0cf46632b",
      "text": "Di bandara ada banyak orang.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "7712e6a972b3451e8498f4acefad76be8b1c4a9d7c14cf5707ced4bdde09ef40",
      "text": "sabuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "77db104d848a1b14369a99165b49f29c756a53ab9a6f80820801bf392212d761",
      "text": "Mohamed! Selamat datang di Bali! Gimana perjalananmu?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a1f9d99bbb19627e8212c0de635d5e1aa6dce45fcb9ee5c6fd65aac89fe1470",
      "text": "Lumayan. Tapi aku capek.",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d49eecd6f8fbbb8e1769037f358dc5c8baf262e9b08ce9ad6d934ff5abc13aa",
      "text": "Pesawat dari Kairo sudah mendarat.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e233d26ca7eba3f7885c18b64669027fdcc72a928f6df08bcaeab5a57712c40",
      "text": "antre",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8014d29087ef5d9ee1e5836e37980bb184fbfff34e4316958eae50b7cda6401c",
      "text": "beberapa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "81b42751bde29307aecb3261e59bf0853f08a41600c33d8aa850e798852f9bd1",
      "text": "Pesawatnya sudah mendarat. Saya ada di pintu kedatangan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "82bd6888587b5be8290f12c0b8cc416b3be25c97690f9dc34674a32ca44a1a21",
      "text": "tujuan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "83116f2d23c6adeb86bd1a970dfa5a109bbe116890c356c35a8ca4d6917ca7f2",
      "text": "menuju",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "84122dcafe717bdf48a4dc04590f7b25a2e5aa9a3f8f6b9c753e3d6e4f2a94f0",
      "text": "Hati-hati, jalannya licin!",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a8a961f46712eeecdc801c81b67454e3100403ec87905cf0a83370312efba61",
      "text": "Selamat datang! Aku di pintu kedatangan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f9e783b3710defd5d7722ca04a09f31065e117b8ef275716e1fda915528ab3a",
      "text": "gratis",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "92f2b21c79510ff7d302b29b5d32d4b40e7d8958ec771b3778ab6a7133bdd57e",
      "text": "Jadwal penerbangan tujuan Kairo ada di sana.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "93128932e7daf5e1a5d310d575dde62438ccf42ff917e302b9ce59bf6a14d729",
      "text": "bagasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "94bb2ed637a5bb8728417267f2c6d44e72174c6313fc799df0845267899cea09",
      "text": "tenang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95b8ddf83667ca787fed87d649cfb873172b103f5af8d7ee72b7951a5e17f5ac",
      "text": "Pesawat ke Kairo jarang terlambat.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "979991a40c0031a6e8e3720571d349a8d1a8dd2e0511e7badef6405903c31409",
      "text": "Mohon perhatian. Penerbangan tujuan Jakarta terlambat tiga puluh menit.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "997bc7d9d49a1872a31d7c407e3cdf50fe0bb0917347c89c6d1c1366856870cf",
      "text": "penerbangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ad57b09e6020e2cf4afa43cdb49eb00fd70b23cd9ce4a47ae2273c0cc723cf5",
      "text": "Mohon perhatian. Para penumpang tujuan Jakarta, harap segera menuju pintu lima. Terima kasih.",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b52c7b5f49570ce4765b50f3e344b0f8beefbb6297a2ab0594ae34c1055a1f6",
      "text": "Awas, lantai licin!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ebebb9bb81c546931984af81bfa1721e0aacabda2385be066dcb6e4f9e2fb93",
      "text": "Ada tanda: Dilarang merokok.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a199a396f447583af53e008b54d3475942d6338fa7554c851d62aa896512f626",
      "text": "Ya, ke pintu lima. Kita harus segera ke sana.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "a362c91341611cc8422b5a8d9c6bf1372264bed0121c6213aa4f1a8724090e08",
      "text": "Pesawat ke Kairo biasanya tepat waktu.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a42d9367db64087765b4846d3b01faf588ea8f178fbe8ad287ce279a719fab7f",
      "text": "Bagus! Kita pergi sekarang. Di bandara ada banyak orang.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5e40fd198d025c5cded4597628f0cb5b9baba473f39b39e93016edf65e6781c",
      "text": "alas kaki",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a855e0a246f6bdf1cbaf9c079ca9a0631dce4009520028752205ddb75deae6f3",
      "text": "Makasih. Bus di Bali sering terlambat, ya?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1b6dca7671fd454acdef21f72de535ac34d269fbffa6d3a2799175d1dadcfa",
      "text": "dilarang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa40dfecf8d21976d350f30efb60adab8996b78253eeb85b7d8339bf0fc6d943",
      "text": "Halo, Rina! Pesawatku udah mendarat.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac38de8f8ce54b95c0bc4ec5fd322c5ff2a7f3e0c84523c71a885b808ef465d2",
      "text": "resmi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b346e8b28b1f7a93a7d28a9b4a79597e59e19ea80971626d6b090d063b67a24d",
      "text": "Tidak apa-apa. Hati-hati juga, ada pencuri di sini.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbecb9e129a92579442416ff8f75d5a1102252164595ceed8532e0f4a4abe7f7",
      "text": "Perhatian! Ini pengumuman untuk penumpang ke Bali.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c12bdacd25bd7302c88ba77c417c4a169db6a20353325a3f1a6679029b3543d2",
      "text": "menit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13d0f320489d6d5974158decf478b40106dea3dfc76361f5b592b267d2817ab",
      "text": "Mas Rizal, apa arti \"Harap lepas alas kaki\"?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c37067442aa8a76671127db861fd1f6b21d7a7e9e401813dc4532cbeeb28de01",
      "text": "Mana yang bahasa resmi?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b67f21503f7e2d041f8bb0ae8b21fa407c4acd4a95a23ee01b38384d556b25",
      "text": "Bagus banget! Sekarang semua orang tahu.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca27e98e5dc6a31a50853438a2c67f68117bfcca6f2452d1275d0b62a3317af7",
      "text": "antrean",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb184cb064564ade7d226752e2c242eaa566766d0f91464b98a4d412495190aa",
      "text": "Ide bagus! Aku selalu minum kopi di bandara.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce0da37252265b1f4bb117b52fd4ee3381e04550a1fc9d117db461eac8028595",
      "text": "Mohon perhatian.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d40ffd6a27b38e342d6a7a508ac91057be0b626b326cbe5dc7e58ead8535e7e6",
      "text": "Mas, itu pesawat kita! Pintunya pindah?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d453c2170498555811cece89b02a31e800f2d333069a88dcaa803c92d9d5e781",
      "text": "Wah, terlambat lagi! Pesawat ini sering terlambat, ya?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d48f0f21444410dbf7d2161548f8d9c1da502f20b08df3d8acff2f2f4b0543c7",
      "text": "tanda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d48f9b9c60273a49b59b2d9da7dab7a4071279a2aa5fe3c17e6e4ef90123a38e",
      "text": "Permisi, Pak. Pintu lima di mana?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4a2565c5b15394fe345027443d91b525014b87deebca5932fc4ffc3e42fa342",
      "text": "menunggu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5de42565236e76308130abc7a81ddfd996e14f89ec1ba8154ca520f30bb05ee",
      "text": "Kita harus antre. Lihat, banyak orang di sana!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5fb6cf071d044e09927522f5f5d65e5e6d4de06b3e7e62a97173b6643f1b42f",
      "text": "Untung saya tidak menunggu lama. Saya segera menuju pintu tujuh.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7cd22520b059d111febc458af44d0174abf4a119966fb3de0c18f3dac14838b",
      "text": "Kadang-kadang. Biasanya tepat waktu.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d90c43fb927bb4d8c4468cf5d9fba278ad54225c14b5971ffd2f7c95d6c006ea",
      "text": "Pakai sabuk pengaman, ya!",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9395eb1dfe9b2d2c682aa6138df88d339b72f0fbbc77505b08fd11484fc25c3",
      "text": "Artinya kita lepas sepatu di sini.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd865c4d6e6363e9040aa7a9c900305dc70b66275c6ddf2bd1301934bcf3ace3",
      "text": "Kereta ini sering terlambat.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "df0b57b9b8d5a777fd155429a32a00a6fb4e48b7a6035e326c3d99aca362f6b8",
      "text": "pengumuman",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "df5884c72e1080d2b0e6476d74a6161fd7aee6b8be07213166f9ff985eb21fd2",
      "text": "parkir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2a4c643e4139b28c7730c1788b1ab63c3435fa950eaa8a21d46ba3d14c33df1",
      "text": "Mohon lepas alas kaki di sini.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2dc6b70dc00c71b59c7360c4f4f32ee32de54e322d31d83031f435931774721",
      "text": "peringatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35ee8424398fcee3011ef831a9493bf145ac4fb21aa2a624a706e9f1baccbcf",
      "text": "pindah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e75a2e9fe9751c05b10283618ed1f534704818df250691f9f763a40746261997",
      "text": "Kadang-kadang. Jalannya sering macet!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8c39ca3dfa5b2b6257aef7ccde87d997e9004c8560fd511a9c72596006a12b9",
      "text": "untung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8d0685c61683b402a9995fd859d3ee34cf6aade9368868dde275e72a27fb29c",
      "text": "lama",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaecf65088f6b624552ebc5bf352e89eece6f21e39cbd88b9d9323d9da20ebe2",
      "text": "Para penumpang yang terhormat, selamat datang di Bandara Ngurah Rai, Bali.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec98e6b1b9d737cc1ea36f41d2af56300c4f390a52b4908f5bf07dd8feb5fb9c",
      "text": "Mohon perhatian. Para penumpang penerbangan GA 405 tujuan Jakarta, pintu pindah ke pintu lima. Harap segera menuju pintu lima.",
      "voice": "id_gadis",
      "chars": 126,
      "mime": "audio/mpeg"
    },
    {
      "key": "edb35fa462587e393fe74ce368397c7e3f20ef9d747fa1cb76ef16b7b374c0a0",
      "text": "harap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef2d236fc68e4d093e189c1d7ef3d6703c9821a12b931a67f7ec02335b1a64eb",
      "text": "mendarat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5c18c23a3def9dd57dba257aae226c7e31b185e53707740cf62bf08f004429",
      "text": "pencuri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2838f8fd351af205cd6c11e15267b702b17114b4048a02862efa490a58a2381",
      "text": "segera",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4026a50928fe569e427963e29b7a78370f86e6350cd38289e752df97b86ee1e",
      "text": "koper",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f595b67c349068bfb74056b47c325e381d57e5f47558eaf7cb3d06f971d6e207",
      "text": "Permisi, Pak. Antreannya di sana. Ada aturan: harap antre.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "f62aaeb5bb975262fe0ab43f70521a061d7454464f4d634bb91d8277e724d4d2",
      "text": "Dengar pengumuman itu! Pesawat kita terlambat.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9370eb083605b68aff1b409bab056ee9164da3607c32a9a224413a6f01ae20c",
      "text": "Para penumpang yang terhormat, selamat datang di Bali.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9d61cc79f190fcea1be4c6f141f5946965822bcfabb603e9a8994ed31e9a396",
      "text": "Terima kasih, Pak. Pintu darurat di mana?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9ecb75d2c52f659c808852866416fcbcb4574cf19d259d481207b24c97f738f",
      "text": "Dilarang masuk!",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa98c596edd51f5564652c4ccb33d59b33786caefec599534cd240413dfac302",
      "text": "Dilarang merokok di area ini.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa9ee2c7d45e79d59fa18f4e42771a96e8d65daf68abbb889bb7c2d86f528831",
      "text": "seluruh",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbcbe0839efadec489a301cf18275cc9bf429d781a429d54a53f3e8a7e8af110",
      "text": "imigrasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc2f61eab7cf22d104fce3066b27e785fadc6811ce9276eacdbea3c4c5fb668d",
      "text": "Semua orang suka nasi goreng.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd3b5a37917bf08cb4c9a0ac595e4684577fd9a500fb6edd9acdd3a913eb9195",
      "text": "ambil",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdc2a1955d50de902a9658ca25a8351401d8e832a39d631b9485da4da4d6e2c1",
      "text": "para",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff1849f375a7a9190bed75a25d55be8a83bacf92d36fa6a31be89e7b791f1631",
      "text": "Para penumpang yang terhormat, mohon perhatian.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
