      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e405126568364829b14fc2797519c7ed3bdeabf454c89ea45a5099bc7a7b6c95",
      "text": "Dilarang masuk.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e75a2e9fe9751c05b10283618ed1f534704818df250691f9f763a40746261997",
      "text": "Kadang-kadang. Jalannya sering macet!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8c39ca3dfa5b2b6257aef7ccde87d997e9004c8560fd511a9c72596006a12b9",
