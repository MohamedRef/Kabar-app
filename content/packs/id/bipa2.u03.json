      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9370eb083605b68aff1b409bab056ee9164da3607c32a9a224413a6f01ae20c",
      "text": "Para penumpang yang terhormat, selamat datang di Bali.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9ecb75d2c52f659c808852866416fcbcb4574cf19d259d481207b24c97f738f",
      "text": "Dilarang masuk!",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa19bee3ce03fc9b160427031dbe6885049a41278e986d2740f8142557eea31a",
      "text": "Dua saja. Semua oleh-oleh dari Mesir ada di sini.",
      "voice": "id_ardi",
