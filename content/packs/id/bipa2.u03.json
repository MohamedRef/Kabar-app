    },
    {
      "key": "ebb7e275f70668c9512fd78a89211d17e38dc93e11fadeeb6577170f22f4c739",
      "text": "Tidak apa-apa. Kita minum kopi dulu.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec98e6b1b9d737cc1ea36f41d2af56300c4f390a52b4908f5bf07dd8feb5fb9c",
      "text": "Mohon perhatian. Para penumpang penerbangan GA 405 tujuan Jakarta, pintu pindah ke pintu lima. Harap segera menuju pintu lima.",
      "voice": "id_gadis",
      "chars": 126,
