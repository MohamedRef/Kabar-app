    },
    {
      "id": "bipa5.u02.l02",
      "sha256": "6efcfb1bcdccb47da8f966f90cec8d0ecb7ba1fc2787495172afed602b33bbab"
    },
    {
      "id": "bipa5.u02.l03",
      "sha256": "da35edfe3f2fff6d517203cd8e0b148b086f53cf1422e96fd6255499287202e4"
    },
    {
      "id": "bipa5.u02.l04",
      "sha256": "6698575b504d1a6464f601d32bb7e8c29630fa084ad66dcd01017a9137816572"
    },
    {
      "id": "bipa5.u02.l05",
      "sha256": "88e0d6fafd932dc23a6adb213a5d71662f446f8d4f18b5647b39cf7eb8f7d562"
    },
    {
      "id": "bipa5.u02.l06",
      "sha256": "b2d890610881ad78ef96a74308bd50f4c33f7ec6d58a08b5302628223cf178e6"
    },
    {
      "id": "bipa5.u02.l07",
      "sha256": "55006cdef2f29980e9bdafe859fac25888c36d38fe8feacb28bff7938ced7cf7"
    },
    {
      "id": "bipa5.u02.l08",
      "sha256": "966b22a36d6021db5a5b2c91c5c7fd59b90d2d32139eda8496b27c7d8cf7271a"
    },
    {
      "id": "bipa5.u02.l09",
      "sha256": "1032369e9a671416b29e2307ea499ce9987a7f10625576ef76d726844af5eea6"
    },
    {
      "id": "bipa5.u02.l10",
      "sha256": "d1f066c13c80e499d2c4ec0b01f18650ab32ef05a626135e3e92be448262aba5"
    },
    {
      "id": "bipa5.u02.l11",
      "sha256": "f30f7492fdf84c0c6c857d1816aaba086543073e771a34021d8f3709d6e68669"
    },
    {
      "id": "bipa5.u02.l12",
      "sha256": "e679b7a1ff98c9f7b82699a6dde7ce98f303922f7d8cae9f1dd496ea63512751"
    },
    {
      "id": "bipa5.u02.l13",
      "sha256": "73de1bf690176e1d0056b57d4d2d3a4838f7e40c744573fdd12c484c492aead8"
    }
  ],
  "audio": [
    {
      "key": "005c47ff23be69961e856fd4da20d9a74c528dda1803cbae69bea84c30be3b45",
      "text": "Meskipun begitu, pendapat Anda tetap penting bagi kami.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "00e57937c159bc3e04c951c103bfc0f35dbae0919696ef4cad95bd867308e055",
      "text": "menggusur",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "01c587288d4c4706eed909b60a640b83a24047f3877ebe353d98bc85378a1845",
      "text": "Air untuk kota baru ditampung di sebuah ___ besar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "022b426dcf5d67d56ef17adc68732a1f28dba30edb4bed3e81a5d99054db657d",
      "text": "Angkutan umum ke pasar hanya ada pagi hari.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "03dc66710ff995882e42d280b59d0aa43f379fe9fe5c0c5fd4c1389ea9c4eb95",
      "text": "Permukiman baru dibangun dekat pusat pemerintahan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0507e830a6eb96f05873542dfae640513793828f1aff89d32b9d550d96df0017",
      "text": "Bandara baru itu diharapkan memperkuat ekonomi ___ Kalimantan Timur.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "06354c040736282446da2e22c1e55b56474c67fac410e8815c7de24ea47e7cc9",
      "text": "Dalam pendahuluan, penulis menyampaikan pendapatnya.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "06b241518a15968288587d088bc4e02dc42ad2e7e9e1dfd693f2f7a1cc5b3c70",
      "text": "Sebagian besar wilayah kota direncanakan menjadi ruang terbuka hijau.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "073094bf323d46b7d6cd41278f070b1d0d990841d730221d3bd1a1b058463062",
      "text": "Pemerintah memutuskan untuk membangun ibu kota baru di Kalimantan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "073bc67311b383bebaf4fcdcd9a3969d56126c7eff6ee0f6bbe98a39c4391073",
      "text": "kritikus",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "082299edbac860180a571f943971598a5d3aa68b406685dfee6fb27b0d53e691",
      "text": "penampungan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0872f7a4c83a348c8a27980ac571ab2be9b0587f6d52a982f92eee92862f31fb",
      "text": "angkutan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0889a510fdf8dc1cc6fd6f2a99fa64a04431c462b9f6be8b5fbe0be80e3872cd",
      "text": "Pusat pemerintahan dikelilingi ruang terbuka hijau.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0acddf71b86ec49820f86a332958cd349fc87b079bab236a1ab2f3289764e380",
      "text": "Tapi biayanya pasti besar sekali, ya?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eb76fd4c32ce3d48f8f5eb231d83dc90c79e866e35ae999138ae224b5c1179f",
      "text": "Itu benar, tetapi Jakarta tetap perlu perbaikan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f332ecf42dd9b27b45d8dbd0f33cf4b8b5e5c1484453d84e07388a5ae203f7f",
      "text": "warga setempat",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f3403e53dd8046ac91e80c062c08e9b9444c865f357cc4e07760482bb2e9548",
      "text": "rintangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fe7933c1762fc1f1c66647eba2303bc006455a57ef08ed3524e76eff6a19158",
      "text": "biaya",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "10cc5980dfd983784cb3ce88e46f0b83208a192e68498edaa6738ae4d2686243",
      "text": "pendahuluan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1112d07bccf770828ffdc0d4d779db77b1baacd4327390ce8437bdaa0a8bb24a",
      "text": "Jakarta ___ pelan-pelan karena air tanahnya diambil terus.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1114c43d76cb932e8c7de4471234f49783d1147f9f203315cd45883c032df615",
      "text": "pendatang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1381edd718433285e76467575f33650a1e44987e77c1653d994ac610d1c075f5",
      "text": "Bupati ingin memperkuat perekonomian dan angkutan desa.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "13bd65270bfe9e6175db7f1e2ef71cb1ae4148a5326e9fa04ada8fa9223a4c1e",
      "text": "Pengungsi banjir tinggal di penampungan sementara.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "14760ec9c43a1ab92e152d20d4affa878042786b56fd7f83a69c0c3a54a42715",
      "text": "Truk itu membawa semen untuk jembatan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "149765d2bcdb974e0ce5e44d62c20a3a535c0d90d2513a550a01ae45fdd38462",
      "text": "Saya mengerti alasan Bapak, tetapi saya kurang setuju.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "14ea774be5babdcb5f4db0b9493948916203da803f9695eaf4eae25096081b02",
      "text": "Kota ini berubah cepat. Keramaiannya sudah seperti Jakarta.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "16d1e4acea0ff02d05cadf530ffc83eac36d2c3f86285ece2e6c4eefe075d475",
      "text": "Meskipun Jakarta besar, kotanya macet dan sebagian tenggelam.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "16d6147b67744e613f79da836e59413ab8d68bab39ce6e1ef552d4dbaee73aa2",
      "text": "Perdebatan tentang ibu kota baru membawa konsekuensi bagi perekonomian daerah.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "17b37ff5adf47d4875885e9b7487d2c5b0ec97dfb4b4fc7bed8c8458c2bf1020",
      "text": "Jadi hambatannya bukan hanya hujan, ya.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "18e206676e89ea1f60d16bc755c751cb94e703fe3a99139a38274615a6c385e0",
      "text": "Pemindahan ibu kota diharapkan membawa pemerataan pembangunan ke luar Jawa.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "19f4140f597b5cbfdca3f436ca245fe2a59aa0493d5fc9ea6481110721901786",
      "text": "kemacetan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c1c43ded00789f6155c4ed69d718cfcdb7384c310d090185ae0182c7acb994b",
      "text": "Penduduk asli meminta agar tanah adat mereka dihormati.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "1debc3e28f39c97149716f35a7b84f3bccc49daccea8b799139e5ba8ab137d8e",
      "text": "Rencana itu menimbulkan kontroversi di parlemen.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ea0713d0fdfbb320088c6e6430301d52dc0832b8ad811600ab0c1166d9dcdad",
      "text": "Di sisi lain, pemindahan ini mahal dan bisa merusak hutan.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fca8f1e58a1fa0b7c38cefe4373c5994b286fa13f3ebdeeee8d6b20773e97dd",
      "text": "Mohamed, sudah baca berita hari ini? Ada artikel panjang tentang Nusantara.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "202bdb3e4d0bbd72288b653631f91d2c07d71f7c8b7318a829774ee485d1bfc3",
      "text": "Mereka tinggal di mana?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2103ea0ec6a51c2ac1a97360c0b22d6386bad674cdcf40c8a0c0e0657d7d9ddb",
      "text": "motel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "23197f866bce672ba540b98389192cc2f715aed620ab1a00866211601731d24f",
      "text": "Katanya semua konsekuensinya sudah dihitung. Tapi banyak orang belum yakin.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "248dc42b205c9c41a987087be48cabe7297abf067d8c4aabaf2162408533fcab",
      "text": "Ya. Penulis yang baik selalu menutup dengan jelas.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "27233a853a4368a186eb6bcc293e76186df3d4d6c435fcda541111abe54fd086",
      "text": "Sedikit. Tapi kesejahteraan kami bergantung pada institusi yang dekat dengan warga.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "27d11b8c01920207da0f9e21eaed9dd9637801a9f677ea97e05c89a16acc38fa",
      "text": "Lihat ke sana, Mohamed. Itu pusat pemerintahan, Istana Garuda.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "28864899d4ab196705bca61eeddbcb067ef3e3313237f05a4c9974dccfcbd8d9",
      "text": "perdebatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d5a3ae55ad9da56220508be2a24923ef054156ca050d47edf4c57edd1989ec",
      "text": "perekonomian",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c2a2ab3d6ce44a31a148a8bdffd6d42e650afb0e2aa76917770ec016a0b70c0",
      "text": "Dari bendungan di sungai itu. Tapi warga khawatir proyek ini berdampak pada hutan.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "2da9bf1949369351e6d38b225540b57323f748429a6ff4e734da19ca1140b7fb",
      "text": "Saya mengerti pendapat Anda, tetapi biayanya terlalu besar.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "304544880217fe10b402171faed12ddec2f310e05fbf0709e8325a9ec22706a1",
      "text": "Perdebatan dan kontroversi ini membawa konsekuensi politik.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "31487c8ec18fe0f85072349dd7de54ad205f00ae8af150c7c306fa4a7c1a3592",
      "text": "Di satu sisi, kota ini padat. Di sisi lain, kota ini penuh peluang.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f5be318c7f2957d7463d5595d5e503a1736499a26e2c0b76055300da65c762",
      "text": "Para pengamat juga bilang begitu.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "35847e7286465dad8662745580d986b2416a08884f258f9692453c89d5d60f26",
      "text": "Lalu permukimannya di mana? Saya hanya melihat hutan.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "361ca072ece409a2da6f8fc4fdb3a8d5dd418cc3eec087be7313e851f721407b",
      "text": "Di satu sisi, ibu kota baru lebih aman. Di sisi lain, biayanya sangat besar.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "37452da134d822a5eb023ff1a7f50a5064ca6648ebca842250b5303366478dd2",
      "text": "Apa kata deputi menteri?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "38e58130ed042d1c9dce986f37591b7e0cbe3fa44e7a013323ecc90430004a9d",
      "text": "regional",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a3333935f28124b6f7842642ec70e8461f600f3b797186f5e170dfbe68e46aa",
      "text": "Bupati mengunjungi tiga desa di daerah pedesaan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a909585cd736f3476deef130fbb209561ee6b3274eea34ea17d257f13981d99",
      "text": "deputi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf63dc14e1921335179e043f7178b1016765b993574c98bee10f1331eb0f1f0",
      "text": "meskipun begitu",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "3efb72176241374985b4c623297d02ada47c1b13c6db0b000cc320d4781090b9",
      "text": "MPR adalah singkatan dari ___ Permusyawaratan Rakyat.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f97addbdb45c8176399db0146fc4f508a57704a2798cc38147f7bb3dbee78fd",
      "text": "Pendatang dan warga setempat harus hidup rukun.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f9920da24b696a2a998ab48dda5bae1218984a1341de9349ba934877f6acee1",
      "text": "mengerti",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "40144b04d5472455ba4b5cac5a7b8dd274a9f94d8711d921ca97a5a2b1d3417c",
      "text": "penutup",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "42b2c2ce3a5df02e26b4efff6a8dabf6dd2a151a408efee11d8e24e4244045bb",
      "text": "Menurut pengamat, pendatang akan mendominasi kota ini.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "433eb62292a97ffe0268f7329483b03eae5ce0c0640f2423b7a1b3c9526cb5f3",
      "text": "Kesejahteraan warga adalah persoalan utama.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "460f8444fd6aaa4afb6365a1e15fa92424c995a686d8de9d3f681e5b644f7906",
      "text": "Saya kurang suka keramaian kota besar.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a35ba868cfb4e6e09a621d87cc972209b05e2c4f2de85f5ee2b0dedebbae1b",
      "text": "Tetangga saya digusur. Ganti ruginya belum dibayar sampai sekarang.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "491f011d8656d447bb0b3e9b24daf886e0a2b4ac29bb915aa1954b62626d5494",
      "text": "Betul. Meskipun begitu, banyak warga Kalimantan senang ada pembangunan.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "498836f8a9c736d3a1502ee835097965be3d6c2c43dc46097b20d8081eda7935",
      "text": "Saya mengerti pendapat Anda. Meskipun begitu, saya kurang setuju.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "4af7654a509228fd838689f75548666da87ebab32252ec68a3ce49099a0136eb",
      "text": "Pak Yusuf, sebagai penduduk asli Paser, bagaimana pendapat Bapak tentang IKN?",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c1e000d7e0fb293e76025e0706b115513d51eaad7058fd034267b55f426ca74",
      "text": "Angkutan, Pak. Ke rumah sakit kami harus naik perahu dua jam.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e0d0d7faeb4c8a0f265ac0bd2a8ac522d64783338501c8a2a62e2a411cfb29b",
      "text": "ruang terbuka hijau",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e31c5211a2dc2979caf9606f124e3caff8802d5ce97f2bc9aed235d9c52cfc3",
      "text": "persoalan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "52b9b89ac533a8bc50dfacce7293e92ce914615dfcc04fc196207bdd22e726ba",
      "text": "Dengan demikian, kamu sudah bisa ikut debat IKN!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "532e7038b0364396589ebaf1b7040ec476319ed61d3b38a14fc7229577c73d90",
      "text": "Tata ruang yang baik membuat transportasi umum mudah dipakai.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "54e5437fbf08267af5ae8837087f544a3a13a663059d7a6afa913ec625167db5",
      "text": "Dalam debat, kita ___ argumen lawan dengan data.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "561b3ffcab72451c2cf3178a7f26f268d15d1c61fab660412d229dafea2e4ef5",
      "text": "Mas, kenapa hotel dan motel di Balikpapan penuh semua?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "586c1ea3adb4e06b34ebfea72e3726cf6fc211d41b6f54ca7fe4a99162c5531b",
      "text": "Apa persoalan utama di daerah pedesaan sini?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "599dff9b9af6881a5191dedb6138b80d239d9718a76c8790acfa87e093ae22ac",
      "text": "hidup",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cc2d5548623c440502ff939af26f325171a8b58cadb7fc35525654ceb7c27a6",
      "text": "Walaupun banyak orang menolak, kebijakan itu tetap berjalan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f58e2be1223f9578c62c77c0c1242e4f301c208f0dc98331f2583f73c8bcec2",
      "text": "Wah, banyak sekali truk semen dan beton.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "604086a9b2b361c31f26f72d21e0ac4bcb10304454c64961be8361219635c0b5",
      "text": "beton",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6295438aff3c2b865fc604bde12e54f974f35c4308c43b5de60e1213000aed7f",
      "text": "transportasi umum",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "640592c7e3492ea05fcd63619aabfcc02eda5c794a29cec1a56abe233ff9955e",
      "text": "Menurut tata ruangnya, hutan itu ruang terbuka hijau. Permukiman ada di balik bukit.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "674e800dc0f19bfbcf2f9e2cebd815c27c6a5e5920a6d1d036e9bdba3bb2d1ed",
      "text": "Tentang hutan dan anggaran negara. Biayanya ratusan triliun rupiah.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "67f2eabfe423732ff7ecee5f0d6a60dc8261e0ab3b4a6eec3c187a39bddd0497",
      "text": "Pertama, pendahuluan harus singkat dan jelas.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ab4047c8fec70139df39757383af5f3914fda024639eb417c72b5ee79b1797f",
      "text": "infrastruktur",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac34fdf0ee6963d4e20b743d2cd9e55c68a7a45d98d92740a2f5a71309cf701",
      "text": "Nah, Mohamed, ini lokasi ibu kota baru. Bagaimana pendapatmu sekarang?",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f8185959470913aa17ac529e95e7f59a67af057da0505bad4d68bd78e0061e2",
      "text": "Soal ibu kota baru lagi?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a57e2bfb526eda42e52be1772b2f10a70eb988ac061575a9d8864ebcea41a0",
      "text": "Menurut pengamat, rintangan terbesar adalah biaya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "70f785de5c0b788f0c3492947d741791eb8dd1d90a4f6e3fa5af952c6ef33650",
      "text": "hektar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "71af19d51dce8821efe8bf730090dd8214ca1610123fb97e8e4efc2873b957b7",
      "text": "pengungsi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7285647d19983e5830a7f923813d1c0a34c4c763d0c8fa219d998e0accf1311f",
      "text": "Pusat pemerintahan dibangun di atas bukit.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "729e6e4c4daff5e44a47adf4603b26f39ee9954af0df596afd0ded93ef9113df",
      "text": "Proyek bendungan itu ___ pada permukiman dan ribuan hektar hutan.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "73a7e23a0dd96d3c085fcd550b554e59a41039526422288e069c82730578eb9c",
      "text": "konsekuensi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "741a6442650e3cbf418227b5f927d4496736e20003f0622da71050263dc805f1",
      "text": "Saya mengerti pendapat Anda. Meskipun begitu, biayanya sangat besar.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "74fc3376139cd97fba7ded737c33839e11d1ea9fb6de6f0d08d77cbad069aadd",
      "text": "pusat pemerintahan",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "761b4de9ce8d92f50ee97d43f7e607bac9679c845ac3121fe1f8f01cee338842",
      "text": "Alasan utamanya adalah kemacetan dan banjir di Jakarta.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "770332c0343f4d68c40c6680ad38f02854a1e064ad5fa99e705cc90437d65061",
      "text": "semen",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "78317d8faa761db604315fba3899caa8e59e7ed5b9ff419d3e48a87d290c1ea2",
      "text": "Setuju. Maaf, tetapi saya kurang setuju kalau hutannya dikorbankan.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "783543588cff1811ee44a9ed23729747239931383afeca00970a4c2904405779",
      "text": "Mas Rizal, kenapa ibu kota pindah ke sini? Jakarta kan sudah besar.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "794e1eebd4402075b6e60447ae7b1f28540324c5041c1b1389bd73ead41c10ea",
      "text": "anggaran",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7952e4bcef44af3be83908be7f0353651c5b10363b7e62b3207d8bfb45b0cda1",
      "text": "tenggelam",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "79e41222eff40d314f3126842599a5567ebb817f699fc3587b4b167bb2333bb4",
      "text": "Di satu sisi ada manfaatnya. Di sisi lain, penduduk asli bisa digusur.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dca913f0bf98cc55ad28dc66fc152403eacbd8a1e26d3a837d93e0b2afa6caf",
      "text": "Setuju. Selain itu, Kalimantan lebih aman dari gempa.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e5f3055126999c1fca5bd456ce65c1ede6cbc6525064a398e3faae84d511727",
      "text": "Malam Minggu, ___ di pusat kota sampai jam dua pagi.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f0be1d95b4295e65f78e00eaa283c3375978fdccf312a63fe1fb70c9424fe14",
      "text": "mendominasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "810a85d502264d30c60c8fe2f7d2d79096f9a31a9e599c210c6caa02c30f3c6d",
      "text": "Ya. Ada kontroversi tentang siapa yang punya wewenang memindahkan kantor-kantor kabinet.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "812ea8d2a97c9345d57437ffe4abe66530b957201d4be02fefba02e9e66292f0",
      "text": "Kalau begitu, transportasi umumnya harus bagus sekali.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8332a48f78082e4ada1b20a70487217135b6bdca38c8171672716c390d718efd",
      "text": "Di satu sisi, kotanya rapi dan modern. Di sisi lain, hutannya banyak yang hilang.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "843519295e34c4b64c79f320ce532940fdec804cddf6e336050d087a3afce115",
      "text": "Proyek ini mahal. Meskipun demikian, banyak orang mendukungnya.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "87fb4e44a5e16597fda5be6438f4e2892d731f13c3624a2a4b6eb91ef9a63ad3",
      "text": "Mohamed, esaimu bagus, tetapi pendahuluannya terlalu panjang.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "893849b717090dba0047ea49043cb3b7250def910fc78636622d8fa8ac43ce35",
      "text": "Jadi, di satu sisi pendatang senang. Di sisi lain, penduduk asli khawatir.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "89469e0c56072adf443c1707c173a75da5c9a0999afb7b372f4385cc8841ccbb",
      "text": "Apakah perekonomian desa ikut tumbuh karena ibu kota baru?",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a922f4f754cceb9a0a0619e8e3be3195ae2aae561523f64b45cfe715c6df0f9",
      "text": "kerumunan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb15bb048a804608d08ac03aab9e0fb2d5a42efda990a451c1c5af346716188",
      "text": "Bagus sekali. Kalian menyanggah dengan sopan dan jelas.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d649e43369629b498c640a5ca0aec2e379803d9ca73b21e3a3ac5c29139efa3",
      "text": "Di satu sisi, kota baru itu modern. Di sisi lain, hutannya terancam.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "900a895ef34ae889010660d594d5a88fade8b92eab4ced4175683dce5362ed82",
      "text": "ganti rugi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "91b3a584aca0bf928806fbefa024ec71b6dca6a7294110ae7c26e3182cf646ef",
      "text": "Menurut saya, ibu kota baru itu ide bagus. Jakarta sudah terlalu padat.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "92312e9b76ca9b15f2fb9eb70365c42f884141045bb4650fcfd14fbd90f1222c",
      "text": "Pertama, Jakarta sudah terlalu padat. Kedua, Kalimantan lebih aman dari gempa.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "943463a8e29b83d2734ba5d4f015d6523b2bad8fbcae56a719aeff77e38f5791",
      "text": "Argumen kedua saya adalah biaya yang terlalu besar.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9506abe080ee540675b22557f8df45c72f9d87328f9bcf41711b050d6514a52f",
      "text": "Saya mengerti pendapat Anda. Meskipun begitu, biayanya terlalu besar.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "9586a4e1cd81cc3b1066f3c7b0fbc50b60e74e425dea6d58a64faa8e56b301c4",
      "text": "Bu, bagaimana pendapat Ibu tentang ibu kota baru?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "95f2363c28085f9e8bd0ac07d544f8b25e5b1c085ba6c83b479d09f241368b00",
      "text": "Pemindahan ibu kota diharapkan mengurangi kemacetan di Jakarta.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "97d95d55b67c6f86921b5103b3ed260077f81b7af5620a1d1b66480d60c6f469",
      "text": "Lalu apa dampak negatifnya untuk warga setempat?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "97fb64acc0521dfa18f4d1436cc6338381ec9dbaf5066af3d71fef86c575c7db",
      "text": "Betul. Lalu tulis argumenmu di isi, satu per satu.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "99a75155dde9157ca1ddfc882f88beb2c9dc09c34a563db72f9e92bd252ae7ec",
      "text": "pemindahan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a4b3e48ef22f4bee5fe1a764c902e8028685cc44642e9e4c2f6120d2e619094",
      "text": "Kamu sudah baca berita pagi ini? Ada perdebatan panas di parlemen.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c298f088265d4393f45c582832b4f103daf653c22cd15fc0df3ee8096db76eb",
      "text": "Menurut pengamat, pendatang akan mendominasi kota baru.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e13983a9d78893eb7b94559de58e93900d9949246b6c35b102bb3c797c73ce4",
      "text": "Ini lokasi proyeknya, Mohamed. Luasnya ribuan hektar.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ec83bab02d73aaea8bdace3bed10c56849d03e3423c5821a9c75479423afa68",
      "text": "Ibu kota baru itu modern. Namun, banyak warga menolak.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ffe528b1909bec281e328a39fd203d326569c5326716024cc06bf944d9e177e",
      "text": "alasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0958972814f53332da190772c104ba6eb243708e1516b1c41c2136b868b3836",
      "text": "Persoalan ini harus segera diselesaikan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4246b3af74947a83745ba94445cda27d85398426ef4f5c8630b719154c7cf8a",
      "text": "___ ibu kota ke Kalimantan dilakukan secara bertahap.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a44d71b152b99230f155dc0b0e5b627ffdc3366291b4210f5b9736aa34366dea",
      "text": "Dengan demikian, rencananya harus hati-hati, ya.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a699694dd279222905a6d37c05032886c0b8ffae06a039d59cd4a424241ad127",
      "text": "kabinet",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c1fd0c31a975af775bf531bbf52956ad2c5e5d3efe779d524dc0b51a4d93a2",
      "text": "penduduk asli",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9081e2fb42b2a712c3e485f01aa6ec49ce7431527ba1d084f95bb63f71b6424",
      "text": "hambatan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9f15a60e843820f038040f061c689ba445d328a8aa1e60c63353c1c0178c07f",
      "text": "Sudah, Pak. Alasannya jelas, tetapi para kritikus masih khawatir.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa2beded04e930316c25d759a1372ee7a40c9d26b103fe4290dbcf9bd03cfe72",
      "text": "keramaian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac8c8ae4720e011924bf3239d68bdc4bd79c380d98eae92b6421f44cf975153e",
      "text": "Menurut saya, Nusantara akan membuat Indonesia lebih adil.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "af524fa0f0d10e02a6375c3adb16fef58c129205ddc9460c785b15229e51aa64",
      "text": "padat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af52fc8d6eaed6b8611c9acb247ed7287ed797fe56771cd8d721c82236652f3c",
      "text": "Warung saya lebih ramai karena banyak pendatang. Itu manfaatnya.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa8d29b20add3ab46bf9584d0e10e56874ea00f885275bfea0b515f323dd261",
      "text": "Selain itu, Jakarta bisa sedikit bernapas.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b16daa57f556a25505e6ec3097baa3892da3cc88b1a9efcda44f111aef1826fc",
      "text": "dataran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1b32660835c751059794c5513821b577a0fe7d9e7266e942775b7438aa8fe8b",
      "text": "kesejahteraan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1feeb081bf073990c91bcb9ef215c6c5f4b3257f48ac9577380a4185a7d29f0",
      "text": "pengamat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b225ff49bd569866e3a881a7ef67054020abbc96295b8758e132cfcd5e4ca646",
      "text": "selain itu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2d876b2ca57fd21de068968af549fd4bcb37194fbfede358cb42f0a394ce66c",
      "text": "pedesaan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b34699195ef0b9788fd1520c98dfdd20999b47b1c600771420c2b86578afe455",
      "text": "Ada manfaatnya, tetapi warga setempat khawatir akan digusur.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4af85078d7bab635e03bf089f20440f95aa750f383a7d634950c115e0fdc441",
      "text": "tata ruang",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b60e0ddeb32d54ad75c5ba209427098bfc009698a15f629d7cae64d4f9ecbe88",
      "text": "Hari ini Bupati Penajam turun ke desa-desa. Kita ikut, ya.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7068da8e28ba48bd1556e9dcc339d715b61bd1de4d523dde7e0e7a899d66960",
      "text": "parlemen",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b75152ae1d371d30307e7883eee15fa1355282f476610cbd9f547129a3e473d6",
      "text": "Jakarta sudah terlalu padat. Dengan demikian, pemindahan ibu kota masuk akal.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "b817b935545e514ae56ffde323ea6f72c789e273091d6bb8f014fa894ac53f92",
      "text": "bendungan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b82f45dff2486198a7d3bb4ca2de10d23a5b594ca70d8af4ed064b9e3bb08417",
      "text": "Di sisi lain, biaya pemindahan ibu kota sangat besar.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8e57716436804c2cebfead8f5cf687096cfc5aea7683f55470abe4bbaaae948",
      "text": "majelis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba414c36aa6a6503700930836c48b294478e5e1a30deb44c1996e18aa3b204a9",
      "text": "berdampak",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba9255ffb93af81897b4c825c16ea95782e504fe4968b20855f69c35e0bac974",
      "text": "Para kritikus khawatir anggaran negara tidak cukup.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc54dc34e1bd4390ea3c2578a362b156f489c0734e7ada13cfd87f29ada72656",
      "text": "Betul. Kami tidak menolak pembangunan, tetapi kami ingin didengar.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd0b4cd15f851ed33395dd0770199df83f61b0c86e77270263b16b46269c6397",
      "text": "permukiman",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "bda4e0fa61c38ae1fbf7a9d89077bf23ea4ccccedd5b6923dde8777e7238f828",
      "text": "Khawatir tentang apa, menurut artikel itu?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bde1c2aca4d7fd6d1ef2ca77ce5b9543b2517a42fce9034a6e37e60aec381f3a",
      "text": "Jalannya bagus sekarang. Meskipun begitu, kami takut kehilangan tanah adat.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfc2f55905a9d94c7baf91460d17225e2333767c8f5e80c9b8bda20aba9d6e80",
      "text": "Siapa yang punya wewenang untuk memutuskan?",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0a2c6b7e41b3133ffc64980f1275ba18607176324e48281429316dcfdf78dbc",
      "text": "Bendungan itu berdampak pada sungai di hilir.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c181a5c19a32f7639b459802820b9d444915c4764cf600032109584972993c2d",
      "text": "Sebagian Jakarta tenggelam, padahal jutaan orang tinggal di sana.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c26c296ede1fa64507ca1bce0744a78e514649e0472bfca81fc18f0dc1795c5f",
      "text": "memutuskan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ab8af7a0a3951abaf56cfcc33d7b44cff7dd2feda75c513bc254dada4cce91",
      "text": "Lahan proyek ini luasnya ribuan hektar.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2dfb074ac834a607ad03ab85ec1d2ce1ed47713f96013d7f2ab6f61fc20a838",
      "text": "Ibu kota baru lebih aman dari banjir. ___, lahannya masih luas.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3ef0a667dc24ac85bcc2d4281863a63c5306293dbe83e3cbf9c14d1d7db60a3",
      "text": "meskipun",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5962bd339f8283b7ebb60c400833bb54ba32701ae6c93728e475eb325272236",
      "text": "Motel di dekat pelabuhan sudah penuh.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6db5e39887fc8cb19d87a13d089c5a02e3e09fd0fca7c0bf584f7e82a8629a4",
      "text": "Presiden mengumumkan susunan kabinet baru.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6e3325899377745f018a213aaadcaffc31e01f896a028efc3544502ce32784f",
      "text": "Maaf, Bu. Jadi pendapat saya cukup satu kalimat saja?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8bf07efcda83c1aa4c21e5050ee3ca58b68cf1eb0f9773f8446493d4064ae92",
      "text": "Itu benar, tetapi pembangunan tidak boleh hanya di Jawa.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3731b788bf6bc589623d39f8993506971549a6816626defcc0dfcf0e940a28",
      "text": "Saya pendatang dari Jakarta. Di sini tidak ada kemacetan, jadi saya senang.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca592edaaa7bdade41c3aff9883ef4048680568e1935e447c8ccea6378cd16a",
      "text": "Menurut Pak Yusuf, penduduk asli Paser sudah tinggal di sini sejak ratusan tahun lalu.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6bd12ad0eca259dc47d2729c27d8a83f3918048482bce19d1a22ddc60b8027",
      "text": "Presiden mengumumkan kabinet baru kemarin.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d06efebbfbaf367e94d0a897d3458eaaf6b7e96b22c7cee3a4bdb92ac0926ec0",
      "text": "Perdebatan di parlemen berlangsung sampai tengah malam.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2500841ec61343cebffcdf219d848ce9a8759748848ee2929866ebd108f263e",
      "text": "Menurut penulis, alasan utamanya adalah banjir.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d489d40c3d73d1fe3219ced1031333b9365850f8fdcb9b9ae149173fdb9425c3",
      "text": "institusi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d499bfa42e201268c4387c3dd0d284c42623b3e3087fc2a5039831cdd8663f7b",
      "text": "benar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5908cee05cccda74b710b876d55117f06a015e97586852f7a269cca5c607352",
      "text": "pemerataan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e769b9d2c88e1579d9ae66f9fcdec1e935e924d363ba4d3b321a8a2a596dda",
      "text": "Infrastruktur, bendungan, dan jalan beton sedang dibangun.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "db08a25c9c4fe6390b70c088c15469925349a388ee08a424200dc7af133a119f",
      "text": "Banyak pekerja proyek datang. Ada juga pengungsi banjir dari hulu sungai.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "df0ce6627e661549f484ad734ff73778a7b501d5933ba6587fd50c868a21ebb2",
      "text": "di sisi lain",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfb99abace8c73f184f31c9da951076d15a9d0a30ee0a0483eb0eb8c6dab8a1e",
      "text": "Dan penutupnya dimulai dengan \"dengan demikian\", ya, Bu?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "dff38ab58971446c09b9e506b3e76d6fafa7088a263cfb6fc7fbe532f4b1df6b",
      "text": "wewenang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e086e27887dc36b7eed7eae1df07ad0768c9452e0fc3b6449b354f05755b8cca",
      "text": "Pemerataan pembangunan itu penting untuk hidup warga, tetapi ganti rugi juga harus adil.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0c1be5b609c0f9ced25f5692b8ff73cf1350006e8c59bda4f59463dba53e5f3",
      "text": "Jakarta tetap ramai meskipun sebagian kotanya tenggelam.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2e586f50536ac3da66c848ab0d15c90375d436aff59b9c41e71ac75c10b6622",
      "text": "Di Nusantara, warga diharapkan memakai transportasi umum, bukan mobil pribadi.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3bb2910dd13b9244045184ce10219eb30239c4d2f3dd8a0a93125066d1014a8",
      "text": "bupati",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e784bccdec3680f6b4de24fb96d18e4639c3702a3f93e08a43508b35aea2bba5",
      "text": "Proyek ini penting. ___, biayanya terlalu besar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b960f32caf93755789b5b8f3256688f84a8adf6672a1fa2583167c71360f23",
      "text": "namun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed0199c5aba0d623f32ef2214f0e5ede7ee1907f1ca73f9e45d1a1c6b90f0651",
      "text": "Perekonomian desa ini bergantung pada kebun karet.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "efe6adefc17f25492272379d4deed031c7326a76fc420b26f13b6af6a983d64f",
      "text": "Betul. Banyak orang menolak, tetapi banyak juga yang mendukung. Kebijakan ini masih jadi debat.",
      "voice": "id_ardi",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "f004728992a0182dbe5364f0f048da3da520361e6cec18ac8fe8ab9459b2f751",
      "text": "Infrastrukturnya dibangun bertahap: jalan dulu, lalu air dan listrik.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f595429befdd0e3f553b3a55ef830185c6c96c1deddcf6066a2ad65c39f98671",
      "text": "kontroversi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f819cf41b36555d60f251564040b0d27ab90de88c63ffabc5768f062f766d65b",
      "text": "Kota itu dibangun di dataran yang luasnya ribuan hektar.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8372ead546cd0b57dacf2d03cac8b70a5d4485fe62943c682f5b4cde34c05b3",
      "text": "Jakarta semakin padat. Dengan demikian, pemindahan ibu kota perlu direncanakan dengan baik.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa3cfbb7814da719449b73e6aaae5f2057aefe5e0acdd953e98cf2d52615ee1e",
      "text": "Infrastruktur ibu kota baru dibangun secara bertahap.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "faad53ec282b47999d456432a2f8f1fdf3e4616627d0efc2cf460f4de32031e0",
      "text": "Airnya dari mana?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdcf7fddb49813f86d4fd2a80809b53eb8714607dfb44e9537e2e6256a1903d9",
      "text": "Di penampungan dekat masjid. Kalau sore, kerumunan orang mengantre makanan.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe00948224282b4ff559312be3e48e56600f3577aacf810bf5aaad331ebaabf6",
      "text": "Walaupun banyak orang menolak, saya tetap mendukung kebijakan itu.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa5e3902c3e2118ba6172e8420552a1fb40c5a122e9f6b9487f96c64578b237",
      "text": "menyanggah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 13,
