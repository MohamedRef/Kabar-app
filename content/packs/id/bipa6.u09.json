{
  "format": 1,
  "id": "id/bipa6.u09",
  "language": "id",
  "unit": "bipa6.u09",
  "version": 1,
  "content_hash": "ac9dccd3a5cd2363d9567a81f39745a9cd6ecbdc00fb3c76ce2a7f76e8dc47d6",
  "lessons": [
    {
      "id": "bipa6.u09.l01",
      "sha256": "a1a33ef85ce28c34dc7dcbbeef6654ed58e1ec855845a6642d4c74e206a7c337"
    },
    {
      "id": "bipa6.u09.l02",
      "sha256": "342cd947ee22311bf851bb6febb03095f0086f6539a7047f968dc8e87942b969"
    },
    {
      "id": "bipa6.u09.l03",
      "sha256": "00e99095376293f2a1039d6245cb8a48d0bfb746d9ffd16b2af3a79a71087ef8"
    },
    {
      "id": "bipa6.u09.l04",
      "sha256": "b0879e59110efffb807ed4e9c0231694b9f635dc244649bd0c406459c9856e30"
    },
    {
      "id": "bipa6.u09.l05",
      "sha256": "8ad19e2d7b590f7a23f166aeb3b69332a0c35d5e7013c57314de84965b1b951a"
    },
    {
      "id": "bipa6.u09.l06",
      "sha256": "55d40ec14fee3675fd90962f8e8580422f814a3f8432ff576b2ddbb4bb140d93"
    }
  ],
  "audio": [
    {
      "key": "01699327ab9f3c0cf8434c2f827e9e5f63ef6cca5d9a4060ab27b8d328de584c",
      "text": "menawarkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a7b263bb5c8011534b48aedfde1696e55c2af5318221d30365abe45c44d2234",
      "text": "Pemasok itu menawarkan potongan harga lima persen untuk pesanan pertama.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bea63d4cd5190e38ee8c5a587bf11b9c9f6f7875315810da2fdc4a965d7010d",
      "text": "Ini draf perjanjiannya. Coba baca Pasal 3.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d44beb88024430638bafa8b7761053b8e78633474158f3e42ac998873ea736c",
      "text": "pesanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eccfcf88ad533a0cb781bb217dd436b61d8f4d4e64a60fa1f229b737823329f",
      "text": "Terima kasih, Uda. Saya belajar banyak, terutama cara menolak dengan halus.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f23439c2d21a7001a7c93d160e16974ef5d2c222157af832d8d2a20a8b98f8c",
      "text": "Kesepakatan ini baik untuk pemasok dan pembeli.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1005576d3bb652cb77fc85799a1e46c628067bf769ee6860c23f27d13840eb67",
      "text": "tawaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1474c7d0426676ca8fce6eb50b07c9d93adadc74bcabcbd00dcd86c2572b9994",
      "text": "Jangka waktunya satu tahun. Kalau cocok, kita perpanjang.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eff3ebdb82a229f78492b2fcca9a73bcabf0b40fcfae77dcaf486005b4d8225",
      "text": "Pesanan pertama kami lima ratus kilogram kurma.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f759c571394dade86fead865c12deff4c74698a33983923bb353add89f21992",
      "text": "penawaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2645d3092339c58dc300a36921e0c5f49b73719f89d5cf240586bddf4ac17f25",
      "text": "Akhirnya kedua pihak mencapai kesepakatan setelah dua jam.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ffa60653ec6522d6a2222e28821a0a3d313b7d849c01480b4c42645f513b04b",
      "text": "Jadi Uda tidak mau?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "3018c3ac08c49df13db280148514ed2f952578c3368f1b7011bb9b64b4fe09fe",
      "text": "dengan hormat",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3181490e325b6a5b5049c13a701cf52f975a64c6ac75132678e012f6dcbac4f6",
      "text": "Mulai dengan terima kasih, lalu sebutkan pesanan kita dan harga satuannya.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "320b6905d69432c6940e48030c30c8a5830f6cde82465ae71d050589621a0047",
      "text": "Cara orang Minang menolak sangat halus.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "361d6bea276cba341f68f0589e6ab2d4662d59e4a6e299698287fe9a2c7bb202",
      "text": "Pembayaran dilakukan dalam dua tahap.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3965ac658cdd631a67f6aa4d4b4cc4e7be79007ab689aea83120b64145278da4",
      "text": "sepertinya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bbbab5dc03ac0d0fcfa17922b2aeff5bf48db2e8147c42a93cc99eff71410fa",
      "text": "Untuk bisnis, pakai bahasa baku. Mulai dengan \"Dengan hormat\".",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "41173c4ab11866b352f0a7b10d781c6ec9943878c8b618259e4629f069b00614",
      "text": "konfirmasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "42a9e834501f19c397dd4a43dff759c15c0fc6225d66d57962f21dcb2e1cb396",
      "text": "Ke Berastagi, di dekat Gunung Sinabung. Saya mau belajar menulis esai.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "4316c512a5674b4020ad630749f2b581e32112b802f1848b6d85fc7ecbac2223",
      "text": "menandatangani",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "478f2cffeb8cfe505396d7315869d35d2fe22e4409fca4be20b87563c6df8377",
      "text": "hormat kami",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cab77fe122026ff45a4534f1e933e627587f61cc36b780dc27d8b0e7b5bdc62",
      "text": "Uni, penawaran dari Kairo sudah datang. Bagaimana saya membalasnya?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "549af0ef2d4930e7e312279941c2eb021a857d5ec64d17703eece1bdcaa8bdc2",
      "text": "Baik, kita sepakat!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "54a3fae0ac6efeaa4273693d5173a11c089dbcdc31c22c56911ec1f7ccd7fabc",
      "text": "Untuk sementara, kami masih memakai pemasok lama.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a4edcf93720691dbc3bb153a248305c63f31f46dc904a40ceb7601b88ea2b33",
      "text": "Saya kirim ke teman saya dulu sebelum kami menandatangani, ya.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cd6369f8c4c91041480e156b1d4a5572c5f9484f9c366a2e58ad3c14de18f72",
      "text": "Untuk sementara, kami belum bisa memesan lagi.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f86778237766ce42acd66c11fcee2e7028d79e4306f8e02305b244a30a767fb",
      "text": "Sebelum menandatangani, periksa jangka waktu perjanjiannya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "63532a7813f049447fd9cd7bb0913aabbc9072f424dd86bc37f0012ade02ed6e",
      "text": "Dengan hormat, bersama ini kami kirimkan lampiran kontrak.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "694184887e158a5822297a68bf0962306deb1b7e6ffee056cfb93b256c10f927",
      "text": "halus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ad4abb59e5ced6abf1020da225e2d7080555cfaf377e7887bd08707c3ff9944",
      "text": "Uang muka tiga puluh persen, sisanya paling lambat empat belas hari. Adil.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "73ffc6e221fa44a0500786d267416ced0a99af3ffa590f7881e0d2f3db92ecdd",
      "text": "belum bisa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "79bfa607b876f3f08e4479d2b85c3fd86edc174c57e6a63db4b56dd397913c72",
      "text": "Penawaran itu berlaku sampai akhir bulan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ca21039e366f6715f134ba649bdf481ed5c75cf533272fc373622916514b2ac",
      "text": "pembayaran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7de114d4124dccd567183e74bca9779e160ca969a1385b78fce2637652470a90",
      "text": "Kalau kesepakatannya bagus, kami akan memesan lagi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ec8245873e9d8175d9659b1321334cccf4e9111ff06209ff48e35a73fc3c3cf",
      "text": "Atas perhatiannya, kami ucapkan terima kasih. Hormat kami, Mohamed.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "864ce288bddf27d6a8bfe74c0d6db9c4f8cdbe4c68e6b7d3bb7db0f313a76f23",
      "text": "atas perhatiannya",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8785dcd823facbf3baab35077bed30847a88cb126eec9854713a18b074b524ac",
      "text": "Bagaimana kalau pemasok kami menawarkan potongan harga lima persen untuk pesanan pertama?",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e9997850bd01fff88b8fb7a30ee2eddb52515d1974e0df84251ccc317c17467",
      "text": "Jangka waktu perjanjian ini satu tahun, dan uang mukanya tiga puluh persen.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "931af301b2e162061197eb85265cf07c7232a5a0d2fbc425614b3ae82cd9a597",
      "text": "Sepertinya tawaran itu cocok untuk bulan Ramadan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "958b33d10ec3927cb1f54649e3c73dd9ca669e891d94b96c45106fa9fb680af0",
      "text": "Uang muka dibayar setelah perjanjian ditandatangani.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9be5c81a6162158f586a7de19acaad6c1670817f7f7577ef75a9accdb1aae3e3",
      "text": "Bagus! Tutup dengan \"Atas perhatiannya, saya ucapkan terima kasih. Hormat saya.\"",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c77f8582bf525ffe9496eb64c7cbb724e0ec86c4fe34810e27197417ae22a97",
      "text": "Dengan hormat, kami ingin menindaklanjuti tawaran bulan lalu.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ce8c59efdbee3e71bdfe02f95c611b12aa6bfaef6af3aea73042d7f26ff9823",
      "text": "Uda, teman saya di Kairo menjual kurma. Harganya bagus.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b2e2e0997f349f516fe93e4b62a7e4d6f0c25fc1a978ad0ad9df8672ce6484",
      "text": "Harga satuannya delapan puluh ribu rupiah per kilo.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a70f633c1fcfcde744b3076acaca74596476e30834e6e56cf3c2345b47415dea",
      "text": "jangka waktu",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9d5e78d2b58866033f10bb743b117e5c2d380b0d5b08d45e4d633a4955ecb5a",
      "text": "Bukan begitu. Sepertinya bulan depan kita bisa bicara lagi, menjelang Ramadan.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "b060a69ba52e72cc7ee12f5c8e4f999f81fc6f08c91d744327b5ce63961dedb6",
      "text": "Wah, tawarannya menarik. Tapi untuk sementara, stok kami masih banyak.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52419331feb711099b9e35a1dde3ab22e2f5fb5953784b78a9192f8f930adc7",
      "text": "harga satuan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b578703245a980ebc5292285322dcd494dfa64a514a96ea031b070c20ed588a9",
      "text": "potongan harga",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd929c8bf57f92c4c66b231842698b23b2683cd2da671f398465d48fef4c8299",
      "text": "perjanjian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4b6897cc4259c221592fc135db368dd80e7451e2f78cc32654f0e987535d3f1",
      "text": "uang muka",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb8b03b224409cdfe879239739b93390a4433c4e4c9030f33e3bab4c3976d0d8",
      "text": "Hormat kami, tim penjualan Kurma Nil.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc4ead304ddc6e7863541245c2b3aaa0c48e895d2d24481de84181b2cfccab65",
      "text": "\"Kami bersedia memesan lima ratus kilogram dengan harga satuan yang disepakati.\"",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd7d3a29b443dd4caaa71f90b77c021736d65bcc509b724afbe4a087e517c5bc",
      "text": "sementara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf85410b6ab0f8ce01f9a0b0551bee4166087175c53f4e815ecb1bc8764abe82",
      "text": "Sepuluh persen, barangkali?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8dd530c71338308b0d52e84e96b4c02c8963f3c8cce8ac798572794c0d85c72",
      "text": "Untuk sementara, harga satuan untuk pesanan kecil belum bisa turun.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d229e27c4aea96fd452f0dce514012b5559893016d52c52370bc50a49a900b",
      "text": "Harga per kilonya masih agak tinggi untuk kami.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "db6bac075d82c4d03e064889444fc553d96efafcc51df3473e64fe75fce31d32",
      "text": "pemasok",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd9bf00e8aaedddf21b9c29127598c51e3ba3f4e333d0b475adf165b4f36577b",
      "text": "Pemasok kurma dari Mesir memberi potongan harga.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ded148e2bc4eb6d1d419576546bb581464f3e58bbb854aa0dac2cc998222c8e7",
      "text": "kesepakatan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e15dc79c2b492d011091e33f14e21e61fc675c9dafde761ffd8e7b0814a2d831",
      "text": "Bagus. Terakhir, minta konfirmasi tanggal pengirimannya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e25b727e7e79795a62d31ef2898d11f799f548aee650e3ae98309d366a0cf3e0",
      "text": "menindaklanjuti",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3aecaf1c1fb6e67e47643565c130a4a4e9fd0105d1655f57f193ace47bc1dfe",
      "text": "Sisa pembayaran paling lambat empat belas hari setelah barang diterima.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7acad6cc7206ada3115948e5c8ab11c7d0f209648a5614897113ee2478ed1a6",
      "text": "Harga satuan untuk pesanan besar lebih murah.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8c6e426735615426e505250018cfb3ca6aad5bb799c21a7db68fa449608476f",
      "text": "Lalu \"Menindaklanjuti pembicaraan kita, bersama ini saya kirimkan daftar harga\"?",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "e994ff1f1db82e77f6895a51659084af9aed7a3c5797fa8c38b2d6b255b032bb",
      "text": "Kesepakatan sudah ditandatangani. Mari kita rayakan dengan rendang!",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb469802aee47d3dae7134faeea504ed40b8adef6190eefbc915c1ba5c25a2b1",
      "text": "Uni, saya mau kirim email ke Uda Fadli. \"Halo Uda, nih aku kirimin harganya.\"",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee2629251333b437e54c8d61cefb25fde7df1eb573c9d83b96d03333d66de97b",
      "text": "Kita ambil jalan tengah saja, Uda. Tujuh persen?",
