    },
    {
      "id": "bipa6.u09.l03",
      "sha256": "00e99095376293f2a1039d6245cb8a48d0bfb746d9ffd16b2af3a79a71087ef8"
    },
    {
      "id": "bipa6.u09.l04",
      "sha256": "2c9440448747b1f043fb8f90483cff2d1be3d48f1d63627842ea134529fb85ae"
    },
    {
      "id": "bipa6.u09.l05",
      "sha256": "cf69ff60296626e417b63a806df029ee499df501910034f86612ac9a015c7a86"
    },
    {
      "id": "bipa6.u09.l06",
      "sha256": "994f324e04fc17348a443f4fca012816d06608599ca167f63e81ce14ace1d4b4"
    },
    {
      "id": "bipa6.u09.l07",
      "sha256": "c8d0de04105e2253f1cd5ab669f223d15b0341baca7ac6183459fd1c8fbe9381"
    },
    {
      "id": "bipa6.u09.l08",
      "sha256": "253a94a38a156047b7936706fd20a245c10b3fa5ac88aa765d400e7c1470187c"
    },
    {
      "id": "bipa6.u09.l09",
      "sha256": "577f7c663f2c314a86a4f86b4aed6f603d9a04c4a01818d8e779c04d798e7088"
    },
    {
      "id": "bipa6.u09.l10",
      "sha256": "3ff2fbf154f011f6dd448f3ad96975730494e8113a75d46b1821f4fff9cff8b8"
    },
    {
      "id": "bipa6.u09.l11",
      "sha256": "2b4605a7f727a269b81c5bce2d3eac82ccd05aa741db61af9e98583bb2a004c0"
    },
    {
      "id": "bipa6.u09.l12",
      "sha256": "f622c8241968c55fc77735043b46c702d639888f51289c1ead64f114de031151"
    }
  ],
  "audio": [
    {
      "key": "00b453d977f4a211fd1c117bbe077ba8f5077d67d56b5df8ba9c60c2c5c49b8a",
      "text": "Teman saya di Kairo mau berinvestasi. Mungkin kemitraan?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "01699327ab9f3c0cf8434c2f827e9e5f63ef6cca5d9a4060ab27b8d328de584c",
      "text": "menawarkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "04bbc966a9f1519267211b510a266e66a80730ee7109bae71a533bf1d49cc33e",
      "text": "Lihat, rendang kami sekarang dalam kemasan. Bisa dikirim ke Mesir!",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "07891cd5392dd1855ad664479edbcf6d453d408bd75bb32a1505bca95be5ad0d",
      "text": "Harga kami kompetitif: lebih murah daripada toko lain.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a7b263bb5c8011534b48aedfde1696e55c2af5318221d30365abe45c44d2234",
      "text": "Pemasok itu menawarkan potongan harga lima persen untuk pesanan pertama.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bea63d4cd5190e38ee8c5a587bf11b9c9f6f7875315810da2fdc4a965d7010d",
      "text": "Ini draf perjanjiannya. Coba baca Pasal 3.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d44beb88024430638bafa8b7761053b8e78633474158f3e42ac998873ea736c",
      "text": "pesanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eccfcf88ad533a0cb781bb217dd436b61d8f4d4e64a60fa1f229b737823329f",
      "text": "Terima kasih, Uda. Saya belajar banyak, terutama cara menolak dengan halus.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f23439c2d21a7001a7c93d160e16974ef5d2c222157af832d8d2a20a8b98f8c",
      "text": "Kesepakatan ini baik untuk pemasok dan pembeli.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1005576d3bb652cb77fc85799a1e46c628067bf769ee6860c23f27d13840eb67",
      "text": "tawaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "125872f9e9df609cb272aa2a1ba077031930e73e4e4a3629aaea230ee6bdb810",
      "text": "gratis ongkir",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "125d3ae3c29be41dd2efd00000256ad8f317ffcf4020634d5ffa05959274f1eb",
      "text": "Paket hemat kurma Mesir dan teh, khusus untuk buka puasa.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1474c7d0426676ca8fce6eb50b07c9d93adadc74bcabcbd00dcd86c2572b9994",
      "text": "Jangka waktunya satu tahun. Kalau cocok, kita perpanjang.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "15788437e6e2057e3c808b14a0e36eb78e08ba4cb28f5fedda1de4ac86a3d4b6",
      "text": "Kalau dia bertanya tentang risiko?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b5fabfa545c6836161ed7e22a2c19c159f5d00348ec2f895e66ce0a497c5201",
      "text": "Pembahasan cabang baru ditunda, tetapi promosi Ramadan disetujui hari ini.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eff3ebdb82a229f78492b2fcca9a73bcabf0b40fcfae77dcaf486005b4d8225",
      "text": "Pesanan pertama kami lima ratus kilogram kurma.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f759c571394dade86fead865c12deff4c74698a33983923bb353add89f21992",
      "text": "penawaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2125b553779c77d53e6e054dacd40f2bd1b05ccb90597c54c043c3ba5c614984",
      "text": "Satu porsi lima puluh ribu. Untuk toko, ada harga grosir di katalog.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "21cf534f4530efb54fb3d6e7a5ad0e7efd943cea1f0026cf4707c0cc9a0eead6",
      "text": "direksi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "22978b7d22f670aaeb99ef76e2f98b37f28e517be1eb831639b10812c025e34c",
      "text": "notulen",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "246a0942812e8df9200557f7b73f413548be2aaea2d688fb7fc4de9401bd1dbe",
      "text": "Sudah, Uda. Masalah, solusi, angka, lalu permintaan kita. Dua menit saja.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "2645d3092339c58dc300a36921e0c5f49b73719f89d5cf240586bddf4ac17f25",
      "text": "Akhirnya kedua pihak mencapai kesepakatan setelah dua jam.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d93258dc3e65b6e2ae90c9a0b176de74e5e746681364cd6ec9db44bb9722db1",
      "text": "berunding",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ffa60653ec6522d6a2222e28821a0a3d313b7d849c01480b4c42645f513b04b",
      "text": "Jadi Uda tidak mau?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "3018c3ac08c49df13db280148514ed2f952578c3368f1b7011bb9b64b4fe09fe",
      "text": "dengan hormat",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "307f7c217a51f3b61135b84af7d0ef774c393b55367265c8fb6e134e8192ce37",
      "text": "Keputusan besar perusahaan diambil oleh ___.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3181490e325b6a5b5049c13a701cf52f975a64c6ac75132678e012f6dcbac4f6",
      "text": "Mulai dengan terima kasih, lalu sebutkan pesanan kita dan harga satuannya.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "320b6905d69432c6940e48030c30c8a5830f6cde82465ae71d050589621a0047",
      "text": "Cara orang Minang menolak sangat halus.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "337ba7935305c8d3cfd7cc9ea13f3511085abcd284fe75d052a1721bddcfd063",
      "text": "proposal",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "361d6bea276cba341f68f0589e6ab2d4662d59e4a6e299698287fe9a2c7bb202",
      "text": "Pembayaran dilakukan dalam dua tahap.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "36f5af6e4980ab9925d6003ceeec22c702e2bed2ea5c1d7ccf3caaf265f96784",
      "text": "Bagus. Bagaimana kalau pelanggan setia mendapat gratis ongkir?",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "384bbb64007094fc20ca5add0eb1fca42dcbec499bb45582a9a35325298597f7",
      "text": "waralaba",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3965ac658cdd631a67f6aa4d4b4cc4e7be79007ab689aea83120b64145278da4",
      "text": "sepertinya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "39de05e8595e473d0bba31ea950d7f748ba47ff48700426d628c7fb26644ae5e",
      "text": "Mohamed, dua bulan lagi Ramadan. Apa promosi kita tahun ini?",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b7f509e5987e2e3c746618d89b23d6d65b9b56a27b3604fa779d3f471b4c2ee",
      "text": "Dengan hormat, tim kami ingin menindaklanjuti tawaran bulan lalu.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bbbab5dc03ac0d0fcfa17922b2aeff5bf48db2e8147c42a93cc99eff71410fa",
      "text": "Untuk bisnis, pakai bahasa baku. Mulai dengan \"Dengan hormat\".",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cd46e85f14925fcda0f2cc843db0604d7bc92166fbd384f68fc45eb95945767",
      "text": "Bulan Ramadan nanti kami buat promo khusus.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d2cd553cf589c3f388befa59b2b339659e9886404a81f9a243fdedb89d16b87",
      "text": "Semua karyawan di setiap cabang memakai seragam merah.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e2518de27a453bc85219e3a7468a665d4dcade641f2e2f0318bb1de1b05e119",
      "text": "Kemasan baru membuat rendang laris, dan harganya terjangkau.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4115c0cf6414a1c4c9b9b3a6da0e23d1401000698d08e02464f1e099980db23e",
      "text": "kemitraan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "41173c4ab11866b352f0a7b10d781c6ec9943878c8b618259e4629f069b00614",
      "text": "konfirmasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4250d0bb45f7672f10e21e2e00d1e6e869a9782f6b81d5b67a65e76b437ab95b",
      "text": "Menarik! Tapi kami perlu mitra yang paham pasar Mesir.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "42a9e834501f19c397dd4a43dff759c15c0fc6225d66d57962f21dcb2e1cb396",
      "text": "Ke Berastagi, di dekat Gunung Sinabung. Saya mau belajar menulis esai.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "4316c512a5674b4020ad630749f2b581e32112b802f1848b6d85fc7ecbac2223",
      "text": "menandatangani",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "478f2cffeb8cfe505396d7315869d35d2fe22e4409fca4be20b87563c6df8377",
      "text": "hormat kami",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "485ab719df11e84094f6b6e12a5a59bd875342458ff092c870abe1bb6792aafc",
      "text": "Investor itu membaca proposal kami dengan teliti.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c745a614364e4ac469f04a853fba57b3aef1a99a72d5346b7bad0ab59a1f6ec",
      "text": "melunasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cab77fe122026ff45a4534f1e933e627587f61cc36b780dc27d8b0e7b5bdc62",
      "text": "Uni, penawaran dari Kairo sudah datang. Bagaimana saya membalasnya?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eb1ef543a3237dc0bac3d036b06c067aaa6852f685d9e0481c23045cbe42bc4",
      "text": "pendanaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "50aa90cdef16582adf08e8bc389ade3f3f5e40bb6b2753ee52c99b5a3925e1b7",
      "text": "Uda, bagaimana kalau rumah makan Uda membuka cabang di Kairo?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "549af0ef2d4930e7e312279941c2eb021a857d5ec64d17703eece1bdcaa8bdc2",
      "text": "Baik, kita sepakat!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "54a3fae0ac6efeaa4273693d5173a11c089dbcdc31c22c56911ec1f7ccd7fabc",
      "text": "Untuk sementara, kami masih memakai pemasok lama.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "54beb56a78a1ef715cc4b001f80b816f3c6447ece75f2a14d3ff1080a138f53f",
      "text": "Penjualan kuartal pertama naik dua puluh persen.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a4edcf93720691dbc3bb153a248305c63f31f46dc904a40ceb7601b88ea2b33",
      "text": "Saya kirim ke teman saya dulu sebelum kami menandatangani, ya.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c3ad8ec004f67f45d4d8b019dcf51a291255d28d338d637b99912654e1bf3f9",
      "text": "Itu kita tunda sampai minggu depan. Kita perlu data dulu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca51c53f7d827a4c834c8c29b382d03d4b3c7a95651d6eb8a24f5f6e0d75548",
      "text": "Kami siap berinvestasi kalau ada kompromi tentang keuntungan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cd6369f8c4c91041480e156b1d4a5572c5f9484f9c366a2e58ad3c14de18f72",
      "text": "Untuk sementara, kami belum bisa memesan lagi.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5da63e67fa661c98d405de5340912341468653f25f38cb63ce000ee96e64e9e7",
      "text": "Setuju. Dan pelanggan baru mendapat kupon untuk pembelian kedua.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f86778237766ce42acd66c11fcee2e7028d79e4306f8e02305b244a30a767fb",
      "text": "Sebelum menandatangani, periksa jangka waktu perjanjiannya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6233271f2cf256aa1d33faf25e93ab0dc288dddf9285271cb96cfb064a107faa",
      "text": "Pelanggan setia mendapat kupon diskon sepuluh persen selama Ramadan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "63532a7813f049447fd9cd7bb0913aabbc9072f424dd86bc37f0012ade02ed6e",
      "text": "Dengan hormat, bersama ini kami kirimkan lampiran kontrak.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "662a05bf6889cf90f0b5257e95c3230e6bd63c88f3bc70b99bcf4bfa61e8ff4b",
      "text": "ditunda",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6798e4cb0e913f6c8241bf5579660fd451323d5e379d328f514940551f39fdc5",
      "text": "promo",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "694184887e158a5822297a68bf0962306deb1b7e6ffee056cfb93b256c10f927",
      "text": "halus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ad4abb59e5ced6abf1020da225e2d7080555cfaf377e7887bd08707c3ff9944",
      "text": "Uang muka tiga puluh persen, sisanya paling lambat empat belas hari. Adil.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aeb1ac374c2cb2a44cdaaecac4cc07408ceae61bdd584e940971f08d7d61ef3",
      "text": "Direksi akan berunding minggu depan.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cd98ad4c829b641ccfc28588e3df707fc7b5a6297715eb51aa79c0a8631cff8",
      "text": "Usulan itu ditunda karena biayanya terlalu tinggi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7160f23d17455bfebac3bbe1bb5f23544ff1c4ccaba5cb485921bb33204dc364",
      "text": "Itu terlalu banyak. Kompromi: tiga puluh persen, dan kami melunasi utang lama dulu pada kuartal ini.",
      "voice": "id_gadis",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "72065194b8d29830c3df7c4a77c22974a05931891f983c55d39fff89f5fe2e85",
      "text": "Saya punya usulan. Kita pesan dua ton dari Mesir sebelum harga naik.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "73ffc6e221fa44a0500786d267416ced0a99af3ffa590f7881e0d2f3db92ecdd",
      "text": "belum bisa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7577dea00e158e78e2cadfe760f2d03568f687c5c3f1513ebfb549a7b283fc05",
      "text": "Apa syarat untuk menjadi mitra waralaba Anda?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "76b41dacae67cd7bc998b0e4bd9ed12c07029dcf0282abaf5a392db1d484c3f6",
      "text": "Harga yang terjangkau dan kemasan yang menarik membuat produk laris.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "79bfa607b876f3f08e4479d2b85c3fd86edc174c57e6a63db4b56dd397913c72",
      "text": "Penawaran itu berlaku sampai akhir bulan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c44a9df422de895eab162f4a271bb72068c7177a51e6cbdc3f386fe77132f74",
      "text": "laris",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ca21039e366f6715f134ba649bdf481ed5c75cf533272fc373622916514b2ac",
      "text": "pembayaran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ced96b8ea4fb0bffd101bc2745e0d45371bca7b1239cfb36d4e84fb86e21c0d",
      "text": "Untuk pelanggan setia, ongkos kirim ke seluruh Indonesia gratis.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "7de114d4124dccd567183e74bca9779e160ca969a1385b78fce2637652470a90",
      "text": "Kalau kesepakatannya bagus, kami akan memesan lagi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fc5ff81282ef2f4b0ecc8e7a5feffa9715e4d5b4293c5f3b0248e17fe5227ca",
      "text": "Kalau tidak ada mufakat, kita adakan pemungutan suara.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ff8a5a31416c07c2051a82e67a74772ce19cb014447784474d76b6d1647a49a",
      "text": "Selama Ramadan, ada paket hemat kurma dan susu dengan harga lebih murah.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "81903193054ee98a2a61f76a8d65092fe95da4d91c085edf43820373298ae1fb",
      "text": "pemungutan suara",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "85e938ff5c177defcfb7cb2011b2160ff43752ed29db17ca0a02ad57b5ad44b3",
      "text": "Rumah makan kami sudah punya dua puluh cabang di Sumatra Barat.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "864ce288bddf27d6a8bfe74c0d6db9c4f8cdbe4c68e6b7d3bb7db0f313a76f23",
      "text": "atas perhatiannya",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8785dcd823facbf3baab35077bed30847a88cb126eec9854713a18b074b524ac",
      "text": "Bagaimana kalau pemasok kami menawarkan potongan harga lima persen untuk pesanan pertama?",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a32cf53fe4b9828a54c875ee795502a127d94b7a882294459dc1c8c5b5bb65b",
      "text": "kompromi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c8562ec2603f15e4b74f1dfff50a70aee00695c8680a0eae3cdc49162d58082",
      "text": "porsi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e9997850bd01fff88b8fb7a30ee2eddb52515d1974e0df84251ccc317c17467",
      "text": "Jangka waktu perjanjian ini satu tahun, dan uang mukanya tiga puluh persen.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "92685ac5369a94a0a16e2f2c4f7858deb88bd87ecd8f31ca8b55c2fd93551964",
      "text": "Kemitraan ini membuka pendanaan untuk cabang baru.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "931af301b2e162061197eb85265cf07c7232a5a0d2fbc425614b3ae82cd9a597",
      "text": "Sepertinya tawaran itu cocok untuk bulan Ramadan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "9536a23cb08b7ef3cb4c05b6d2344e0a4ccfd8ac02990fac0faf7c57b8690da1",
      "text": "merek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "955632b723f907328d98e4b85280439cfd452410c8df81db84e5d13e7d0b800e",
      "text": "Usulan Mohamed diterima tanpa pemungutan suara.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "958b33d10ec3927cb1f54649e3c73dd9ca669e891d94b96c45106fa9fb680af0",
      "text": "Uang muka dibayar setelah perjanjian ditandatangani.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "989692646fa0a3b7c57569945018bb85286fca4776d4941956e4fa0b9bebf867",
      "text": "Kami melunasi pinjaman pada kuartal ketiga.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "992258f9af83666fc06a2fdaa6f2990b8dd775d45da996362d3c22055ceb1f17",
      "text": "Kemasan baru membuat rendang tahan enam bulan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9be5c81a6162158f586a7de19acaad6c1670817f7f7577ef75a9accdb1aae3e3",
      "text": "Bagus! Tutup dengan \"Atas perhatiannya, saya ucapkan terima kasih. Hormat saya.\"",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ce8c59efdbee3e71bdfe02f95c611b12aa6bfaef6af3aea73042d7f26ff9823",
      "text": "Uda, teman saya di Kairo menjual kurma. Harganya bagus.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f9d09b99a85657953d2f8b23974ccb5f7b28b71028222afd9f6fd595a57fae1",
      "text": "terjangkau",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b2e2e0997f349f516fe93e4b62a7e4d6f0c25fc1a978ad0ad9df8672ce6484",
      "text": "Harga satuannya delapan puluh ribu rupiah per kilo.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a635e7bb09fb513a8bdf2f516eb8bf99034107f5e6c6c5763f4e713e1f5a6ef9",
      "text": "agenda",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a68078de9ef42b034d66110e5ce3e0d97fd095a0ceba91c5a47cec096f6bd201",
      "text": "kupon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a70f633c1fcfcde744b3076acaca74596476e30834e6e56cf3c2345b47415dea",
      "text": "jangka waktu",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9d5e78d2b58866033f10bb743b117e5c2d380b0d5b08d45e4d633a4955ecb5a",
      "text": "Bukan begitu. Sepertinya bulan depan kita bisa bicara lagi, menjelang Ramadan.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa6d0e34c15ee65d4de3a039772ff5aa9d3993748223930b4da9da86094a4f3d",
      "text": "Saya bilang, \"Pertanyaan yang bagus, Pak,\" lalu saya jelaskan dengan data.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "aed7f38890eba7bc96d1b4c07fe6630f2ca0bb096e3514f39de3fd2f5faf129f",
      "text": "Setiap pembelian di atas seratus ribu mendapat satu kupon.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b060a69ba52e72cc7ee12f5c8e4f999f81fc6f08c91d744327b5ce63961dedb6",
      "text": "Wah, tawarannya menarik. Tapi untuk sementara, stok kami masih banyak.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26f545c41040ed6180019ef4ae2f207d1f9664ce74ed6d9092e82f38e818fd6",
      "text": "Saya bisa menjadi mitra waralaba. Apa syaratnya?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3d7b2a6ebef709822aa439d4bb3bfdce6689414c35a4ef3c75eb134047012c0",
      "text": "Mitra waralaba harus memakai merek, resep, dan seragam yang sama.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b45b9b4a0425b9f5fc609670fd81454d27712ec8acc817b94bba63c3f1a7b066",
      "text": "Proposal kami hanya lima halaman, tetapi datanya lengkap.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52419331feb711099b9e35a1dde3ab22e2f5fb5953784b78a9192f8f930adc7",
      "text": "harga satuan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b578703245a980ebc5292285322dcd494dfa64a514a96ea031b070c20ed588a9",
      "text": "potongan harga",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5fe27fbc65bb414bc2462a07820cf9aa9f868da7779ffa2d973764e4c5f369c",
      "text": "Harganya terjangkau. Pasti laris di Kairo!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b733e14e836086fcea27dd2adbf72748629829df0a819ff4b8cb5328fb94f863",
      "text": "Mohamed, saya mau buka cabang di Kairo. Tapi butuh pendanaan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2896f4d24e9fc023c1c884f982542a4b80e4b5d075f139993cf14a1d5abe2f",
      "text": "Beli sepuluh dapat harga grosir.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc69feb1924a0aaf409f9634421f516f17c1b6e270d6c4888249d1eb0747b5f6",
      "text": "Atas perhatiannya, kami ucapkan terima kasih. Hormat kami, tim penjualan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd929c8bf57f92c4c66b231842698b23b2683cd2da671f398465d48fef4c8299",
      "text": "perjanjian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c260f778884705b0d739d0ab996227299de64d169e71ff848654af15b3175ffb",
      "text": "kuartal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c309cd8e2b845b5346d4834a210e77cd85e90172639cd695778e42f7fefbdf69",
      "text": "Direksi berunding tentang promo untuk kuartal depan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4b6897cc4259c221592fc135db368dd80e7451e2f78cc32654f0e987535d3f1",
      "text": "uang muka",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c596fbb317dc94b86bdeb76734cf75d2035430312d30243d548d1f2c58dbd148",
      "text": "investor",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c77492cb29d1a73d252170b2e3add19c53e2200babf3eef4a89e42be8cb5ead1",
      "text": "katalog",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7c5b6240ad132f17a70dfddc00255a76617f08f12d9eb2025b99e58adaec8d0",
      "text": "pelanggan setia",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9598df8f04ea1c59150c6bafd78a25cfc0605e5914080154482b27abf0630c3",
      "text": "Kami mencari pendanaan untuk cabang di Kairo.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9c264ee72776d12dbb3108ab48f747ed5a6506595580f5beb96832286633281",
      "text": "tim",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb8b03b224409cdfe879239739b93390a4433c4e4c9030f33e3bab4c3976d0d8",
      "text": "Hormat kami, tim penjualan Kurma Nil.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc4ead304ddc6e7863541245c2b3aaa0c48e895d2d24481de84181b2cfccab65",
      "text": "\"Kami bersedia memesan lima ratus kilogram dengan harga satuan yang disepakati.\"",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca78ef0e92ff1146089bd17fbf6d019cd403f076f823aceeaa5fc2f9bbcd10b",
      "text": "berinvestasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd7d3a29b443dd4caaa71f90b77c021736d65bcc509b724afbe4a087e517c5bc",
      "text": "sementara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf85410b6ab0f8ce01f9a0b0551bee4166087175c53f4e815ecb1bc8764abe82",
      "text": "Sepuluh persen, barangkali?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20d44ae8e40c3c7ab7f3078850e56ab920eec2bc245fccae8758c912a654ae5",
      "text": "Kemasan kecil cocok untuk satu porsi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d22955bca8440d88c2494741ef475bea71dd5eed498910f831d5ba7943699522",
      "text": "Merek kami sudah punya dua ratus pelanggan setia di Padang.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2aaaa6194a64a35e5c822a0f1fab37131396f61eab5e3699a86bb49f29009fe",
      "text": "Baik, kita mulai. Agenda pertama, kurma untuk Ramadan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2e18bc0c35da275423f747344b50e7fcce59f42df4c0ac8c619f652b9e41e30",
      "text": "paket hemat",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d65c0e590deecedd46e35a7337429d99a1cd6c5aa98705c75403194c9333f43d",
      "text": "Rendang ini laris karena harganya terjangkau.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d79915a2c47c5b20635bee5c3d9234873e45c5e99a868b4d42ecff05c0d41838",
      "text": "seragam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7d7c5bd07e7656e5039b5b3e212369283e35af601ee4af8c21805de7479279c",
      "text": "Dia minta lima puluh persen. Bisa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d229e27c4aea96fd452f0dce514012b5559893016d52c52370bc50a49a900b",
      "text": "Harga per kilonya masih agak tinggi untuk kami.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "db6bac075d82c4d03e064889444fc553d96efafcc51df3473e64fe75fce31d32",
      "text": "pemasok",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbb2e1d72194ca96c4c282f5e1d63edfe9b4b3c6e0b73fb58ed79bcd9a0bf282",
      "text": "Dengan waralaba, setiap mitra memakai resep dan seragam yang sama.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbfe86506484b265b4b380df4f2c1b70d2418a631c7f59e1cc432f334200cef2",
      "text": "Setuju. Saya catat di notulen. Bagaimana dengan cabang Kairo?",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd969793b8d20f2aa7b51e3b38effd7091a8227da3e67b908b550fb473407d41",
      "text": "Satu ___ rendang dengan nasi harganya tiga puluh ribu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd9bf00e8aaedddf21b9c29127598c51e3ba3f4e333d0b475adf165b4f36577b",
      "text": "Pemasok kurma dari Mesir memberi potongan harga.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "de3a3cedfe1d5bb39993939603b690e3cad96cb58b423995b33ed73b54255f12",
      "text": "Mohamed, investor dari Jakarta datang besok. Proposalnya sudah siap?",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "ded148e2bc4eb6d1d419576546bb581464f3e58bbb854aa0dac2cc998222c8e7",
      "text": "kesepakatan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "df85846cb9a06e3345e9bd084bcc105e77a5877a46df2ff2aa53fc77f69651ec",
      "text": "kemasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e15dc79c2b492d011091e33f14e21e61fc675c9dafde761ffd8e7b0814a2d831",
      "text": "Bagus. Terakhir, minta konfirmasi tanggal pengirimannya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e25b727e7e79795a62d31ef2898d11f799f548aee650e3ae98309d366a0cf3e0",
      "text": "menindaklanjuti",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d3d816d4e2da5778eef1a079584553239942f81f5188971b7e1f45f645a2fc",
      "text": "Merek, resep, dan seragam harus sama. Rendang di Kairo harus seenak di Padang!",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2faa4003d01b5a36bf5f57bbd8246272b1277a67bbf406334e71d9e8452b8c1",
      "text": "kompetitif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3aecaf1c1fb6e67e47643565c130a4a4e9fd0105d1655f57f193ace47bc1dfe",
      "text": "Sisa pembayaran paling lambat empat belas hari setelah barang diterima.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "e52d7cee363eb8d65955549bb77894c8f55f567652fd28a08395385fe42dfa5b",
      "text": "Agenda pertama rapat hari ini adalah promosi Ramadan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fd914cdcb5fe0c1a80fe6970cac580adb4b29945a4686237ff8b0701c63733",
      "text": "grosir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7acad6cc7206ada3115948e5c8ab11c7d0f209648a5614897113ee2478ed1a6",
      "text": "Harga satuan untuk pesanan besar lebih murah.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8c6e426735615426e505250018cfb3ca6aad5bb799c21a7db68fa449608476f",
      "text": "Lalu \"Menindaklanjuti pembicaraan kita, bersama ini saya kirimkan daftar harga\"?",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "e91b9226c350b49f2f40faf79a206d065a6d948109549b5a40025d99c9b413ba",
      "text": "mitra",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e94b93bbafebee693ac9e73a6121b9e98ab7418051cf0d8eeb1067d3cb188826",
      "text": "Boleh. Tapi direksi kami harus berunding dulu.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e994ff1f1db82e77f6895a51659084af9aed7a3c5797fa8c38b2d6b255b032bb",
      "text": "Kesepakatan sudah ditandatangani. Mari kita rayakan dengan rendang!",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb469802aee47d3dae7134faeea504ed40b8adef6190eefbc915c1ba5c25a2b1",
      "text": "Uni, saya mau kirim email ke Uda Fadli. \"Halo Uda, nih aku kirimin harganya.\"",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed325f7a45d8341ab8a3ed90d96721397b503328965a9888293ac6ae54405aec",
      "text": "cabang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed9e707d75cd1d483cf90e610a83bfa52317c4a8016cd1238694361e9c25d68f",
      "text": "usulan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee2629251333b437e54c8d61cefb25fde7df1eb573c9d83b96d03333d66de97b",
      "text": "Kita ambil jalan tengah saja, Uda. Tujuh persen?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f025eeda169a1006032c3424231de9f087d60e106fd2aa22cd534347542c09b5",
      "text": "promosi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4bacc7bb7187f4d9c4bd70b9f6f01c0841fb7a5c006bbb5a87ec3a0524ddb55",
      "text": "Bagus! Berapa harganya?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4c671e0121dc25b485b2a0eb9c54c257602d218ee9ed238b819b6e9c906bcfb",
      "text": "Ke mana kamu sesudah ini?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6f99c7b7bc430846c89c4b27329284cc14754ce8fe9b55c16999458026eee36",
      "text": "lampiran",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "faa9a3cd67ed0553096482c06bfe5f5ef7c12207b3cac6aca8f05873429282e1",
      "text": "Promosi Ramadan! Beli paket hemat, gratis ongkir!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    }
  ],
