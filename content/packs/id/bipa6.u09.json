    },
    {
      "id": "bipa6.u09.l03",
      "sha256": "22a5a7df57a09930bef23a92b32c81ebc9cb2d5eb41ace41584d914235cf85dc"
    },
    {
      "id": "bipa6.u09.l04",
      "sha256": "6ff056e4541f74cbcb36cf00cc34140b4154920975c2b924e106eb55ea73aaca"
    },
    {
      "id": "bipa6.u09.l05",
      "sha256": "8726a77c65c28ca736de7ee16f9fa17fe22cd1c7ef747bb05542c05c2125b90f"
    },
    {
      "id": "bipa6.u09.l06",
      "sha256": "bbce2dd7cb5ed7bedf341c1a24ff458a32a2ffc4326a80f7352c24df60a9e589"
    },
    {
      "id": "bipa6.u09.l07",
      "sha256": "d9b1751ebb58f563b20563dce1c6936602bfcb21044e1b69b0c479719fb3c3f9"
    },
    {
      "id": "bipa6.u09.l08",
      "sha256": "b8dbf23c0a3eca25d871f910dc76df417b1fa890d4aca00ecf7f9a455ad7121b"
    },
    {
      "id": "bipa6.u09.l09",
      "sha256": "dbe92d437b99934cd5162865d8bef53042f95b37468c482404a13fe2d28d3a42"
    },
    {
      "id": "bipa6.u09.l10",
      "sha256": "62ab7a3c10949b842f6d283eb09f13cb13ec3a36dab3ed095806a13f0e729bdd"
    },
    {
      "id": "bipa6.u09.l11",
      "sha256": "36fca149c3d88225de4ff44877957c4133e5c8b6f6dbccdf57bfd415e2b72cad"
    },
    {
      "id": "bipa6.u09.l12",
      "sha256": "afded345bbbc3f847db9333a2d2de18383a210e4cac237a6426bf6003137d80e"
    }
  ],
  "audio": [
    {
      "key": "00b453d977f4a211fd1c117bbe077ba8f5077d67d56b5df8ba9c60c2c5c49b8a",
      "text": "Teman saya di Kairo mau berinvestasi. Mungkin kemitraan?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "014fb8e8b2ccac34e684a5a29ad0562c34c3aecc12c1501529118b9e05779c24",
      "text": "Setiap pembelian di atas seratus ribu mendapat satu kupon, jadi pelanggan sering kembali ke toko kami.",
      "voice": "id_gadis",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "01699327ab9f3c0cf8434c2f827e9e5f63ef6cca5d9a4060ab27b8d328de584c",
      "text": "menawarkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "04bbc966a9f1519267211b510a266e66a80730ee7109bae71a533bf1d49cc33e",
      "text": "Lihat, rendang kami sekarang dalam kemasan. Bisa dikirim ke Mesir!",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bea63d4cd5190e38ee8c5a587bf11b9c9f6f7875315810da2fdc4a965d7010d",
      "text": "Ini draf perjanjiannya. Coba baca Pasal 3.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d44beb88024430638bafa8b7761053b8e78633474158f3e42ac998873ea736c",
      "text": "pesanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d9e7f72d19c4f71cd5e127d6f8d2893b223371738c58733f69091ac983940ac",
      "text": "Rapatnya panjang dan kadang-kadang panas. Akhirnya kedua pihak mencapai kesepakatan setelah dua jam. Mereka berjabat tangan dan tersenyum.",
      "voice": "id_gadis",
      "chars": 138,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f23439c2d21a7001a7c93d160e16974ef5d2c222157af832d8d2a20a8b98f8c",
      "text": "Kesepakatan ini baik untuk pemasok dan pembeli.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1005576d3bb652cb77fc85799a1e46c628067bf769ee6860c23f27d13840eb67",
      "text": "tawaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "125872f9e9df609cb272aa2a1ba077031930e73e4e4a3629aaea230ee6bdb810",
      "text": "gratis ongkir",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "125d3ae3c29be41dd2efd00000256ad8f317ffcf4020634d5ffa05959274f1eb",
      "text": "Paket hemat kurma Mesir dan teh, khusus untuk buka puasa.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "15788437e6e2057e3c808b14a0e36eb78e08ba4cb28f5fedda1de4ac86a3d4b6",
      "text": "Kalau dia bertanya tentang risiko?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "176bd3de49df96d99e32278a0372095fe8e8c04b67c7110530e2f7fb6250ed52",
      "text": "Kami lampirkan daftar harga terbaru dalam email ini. Atas perhatiannya, kami ucapkan terima kasih. Hormat kami, tim penjualan.",
      "voice": "id_gadis",
      "chars": 126,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b17a98073470c97abfb906b082d7d67423307fa0806d213b44b3f47cb90e42f",
      "text": "Selamat datang di toko kami! Selama Ramadan, ada paket hemat kurma dan susu dengan harga lebih murah. Paket ini cocok untuk berbuka puasa bersama keluarga.",
      "voice": "id_gadis",
      "chars": 155,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eff3ebdb82a229f78492b2fcca9a73bcabf0b40fcfae77dcaf486005b4d8225",
      "text": "Pesanan pertama kami lima ratus kilogram kurma.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f4d218add2e27b97ca8bd94cee377f83b95da4f9c0b080ccadd99a66f55b2b7",
      "text": "Jangka waktu perjanjian ini satu tahun. Kalau cocok, kita perpanjang.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f759c571394dade86fead865c12deff4c74698a33983923bb353add89f21992",
      "text": "penawaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2125b553779c77d53e6e054dacd40f2bd1b05ccb90597c54c043c3ba5c614984",
      "text": "Satu porsi lima puluh ribu. Untuk toko, ada harga grosir di katalog.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "21cf534f4530efb54fb3d6e7a5ad0e7efd943cea1f0026cf4707c0cc9a0eead6",
      "text": "direksi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "22978b7d22f670aaeb99ef76e2f98b37f28e517be1eb831639b10812c025e34c",
      "text": "notulen",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "246a0942812e8df9200557f7b73f413548be2aaea2d688fb7fc4de9401bd1dbe",
      "text": "Sudah, Uda. Masalah, solusi, angka, lalu permintaan kita. Dua menit saja.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a1d83c7f60db1b8847f95eb5d71b0d4889993bab5676bb841c9710b959632f1",
      "text": "Bagus. Gimana kalau pelanggan setia dapat gratis ongkir?",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d93258dc3e65b6e2ae90c9a0b176de74e5e746681364cd6ec9db44bb9722db1",
      "text": "berunding",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ffa60653ec6522d6a2222e28821a0a3d313b7d849c01480b4c42645f513b04b",
      "text": "Jadi Uda tidak mau?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "3018c3ac08c49df13db280148514ed2f952578c3368f1b7011bb9b64b4fe09fe",
      "text": "dengan hormat",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "307f7c217a51f3b61135b84af7d0ef774c393b55367265c8fb6e134e8192ce37",
      "text": "Keputusan besar perusahaan diambil oleh ___.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "320b6905d69432c6940e48030c30c8a5830f6cde82465ae71d050589621a0047",
      "text": "Cara orang Minang menolak sangat halus.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "337ba7935305c8d3cfd7cc9ea13f3511085abcd284fe75d052a1721bddcfd063",
      "text": "proposal",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "351d1d97d022108288f3df8b48040b029f8f8df75a3484d614569fbc0ef354ac",
      "text": "Sepertinya tawaran itu cocok untuk bulan Ramadan, tetapi kami harus bertanya kepada direksi dulu.",
      "voice": "id_gadis",
      "chars": 97,
      "mime": "audio/mpeg"
    },
    {
      "key": "361d6bea276cba341f68f0589e6ab2d4662d59e4a6e299698287fe9a2c7bb202",
      "text": "Pembayaran dilakukan dalam dua tahap.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "384bbb64007094fc20ca5add0eb1fca42dcbec499bb45582a9a35325298597f7",
      "text": "waralaba",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3965ac658cdd631a67f6aa4d4b4cc4e7be79007ab689aea83120b64145278da4",
      "text": "sepertinya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b7f509e5987e2e3c746618d89b23d6d65b9b56a27b3604fa779d3f471b4c2ee",
      "text": "Dengan hormat, tim kami ingin menindaklanjuti tawaran bulan lalu.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cd46e85f14925fcda0f2cc843db0604d7bc92166fbd384f68fc45eb95945767",
      "text": "Bulan Ramadan nanti kami buat promo khusus.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e2518de27a453bc85219e3a7468a665d4dcade641f2e2f0318bb1de1b05e119",
      "text": "Kemasan baru membuat rendang laris, dan harganya terjangkau.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4115c0cf6414a1c4c9b9b3a6da0e23d1401000698d08e02464f1e099980db23e",
      "text": "kemitraan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "41173c4ab11866b352f0a7b10d781c6ec9943878c8b618259e4629f069b00614",
      "text": "konfirmasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4250d0bb45f7672f10e21e2e00d1e6e869a9782f6b81d5b67a65e76b437ab95b",
      "text": "Menarik! Tapi kami perlu mitra yang paham pasar Mesir.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4316c512a5674b4020ad630749f2b581e32112b802f1848b6d85fc7ecbac2223",
      "text": "menandatangani",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "478f2cffeb8cfe505396d7315869d35d2fe22e4409fca4be20b87563c6df8377",
      "text": "hormat kami",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b79d476674dc7d62f4350913cb78c2196c80196354159499b649831e4d7c22b",
      "text": "Usulan itu ditunda karena biayanya terlalu tinggi, padahal semua orang menyukainya.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c745a614364e4ac469f04a853fba57b3aef1a99a72d5346b7bad0ab59a1f6ec",
      "text": "melunasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eb1ef543a3237dc0bac3d036b06c067aaa6852f685d9e0481c23045cbe42bc4",
      "text": "pendanaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "50aa90cdef16582adf08e8bc389ade3f3f5e40bb6b2753ee52c99b5a3925e1b7",
      "text": "Uda, bagaimana kalau rumah makan Uda membuka cabang di Kairo?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "52d37a0a9ee1ec164eb4cc7903cb663e50cc5445517e419f1eaaf4627215041f",
      "text": "Habis ini kamu ke mana?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "549af0ef2d4930e7e312279941c2eb021a857d5ec64d17703eece1bdcaa8bdc2",
      "text": "Baik, kita sepakat!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "56c4ac7d4f57680cfdf9ed552aaba5ce9b7561e33e7cac4a2624a0f82f11f641",
      "text": "Rapat direksi selesai jam empat. Pembahasan cabang baru ditunda, tetapi promosi Ramadan disetujui hari ini. Iklannya akan mulai tayang minggu depan.",
      "voice": "id_gadis",
      "chars": 148,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c66fc55444a2ead12d73c154ff9181ac1bf9ac8d408963d496d15c393e04f45",
      "text": "Kami sudah bicara dengan pemasok baru dari Mesir. Pemasok itu menawarkan potongan harga lima persen untuk pesanan pertama. Ongkos kirimnya tetap kita yang bayar.",
      "voice": "id_gadis",
      "chars": 161,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca51c53f7d827a4c834c8c29b382d03d4b3c7a95651d6eb8a24f5f6e0d75548",
      "text": "Kami siap berinvestasi kalau ada kompromi tentang keuntungan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cd6369f8c4c91041480e156b1d4a5572c5f9484f9c366a2e58ad3c14de18f72",
      "text": "Untuk sementara, kami belum bisa memesan lagi.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d3eb9dfb84409dc414d3ab8518f4a86e0a513906241752b2679ca4c13a32dea",
      "text": "Saya minta teman saya membaca dulu sebelum kami menandatangani, ya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f86778237766ce42acd66c11fcee2e7028d79e4306f8e02305b244a30a767fb",
      "text": "Sebelum menandatangani, periksa jangka waktu perjanjiannya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6233271f2cf256aa1d33faf25e93ab0dc288dddf9285271cb96cfb064a107faa",
      "text": "Pelanggan setia mendapat kupon diskon sepuluh persen selama Ramadan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "6309725bf2a6c2f1f01c0cda6bec0ae21c52b3c794a49fb9b5844cdbb61081fe",
      "text": "Uang muka dibayar setelah perjanjian ditandatangani, sedangkan sisanya dibayar setelah barang diterima.",
      "voice": "id_gadis",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "662a05bf6889cf90f0b5257e95c3230e6bd63c88f3bc70b99bcf4bfa61e8ff4b",
      "text": "ditunda",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "671f9568bf15c2ee2505a76c4334ed34f5187d3640805673bd006a2c3e81e0f0",
      "text": "Dengan hormat, bersama ini kami kirimkan lampiran kontrak supaya Bapak dapat memeriksanya sebelum rapat.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "6798e4cb0e913f6c8241bf5579660fd451323d5e379d328f514940551f39fdc5",
      "text": "promo",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "694184887e158a5822297a68bf0962306deb1b7e6ffee056cfb93b256c10f927",
      "text": "halus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ad4abb59e5ced6abf1020da225e2d7080555cfaf377e7887bd08707c3ff9944",
      "text": "Uang muka tiga puluh persen, sisanya paling lambat empat belas hari. Adil.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aeb1ac374c2cb2a44cdaaecac4cc07408ceae61bdd584e940971f08d7d61ef3",
      "text": "Direksi akan berunding minggu depan.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b29065af9a9b8afb1587dd8e7ac93e21982d47ff3b887a348d8463af8135992",
      "text": "Direksi berunding tentang promo untuk kuartal depan, karena penjualan bulan ini turun.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c7a9f2c00ca3fbde668577c761ffdb86df38604f0fca37a6d5b44feb41c2bfb",
      "text": "Kalau untuk kerja, pakai bahasa baku. Mulai dengan \"Dengan hormat\".",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f8b495b288e64484c62564dffb999597cf262368977afdb8b0e37c0f8085f21",
      "text": "Makasih, Uda. Saya belajar banyak, apalagi cara menolak dengan halus.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "707bd4d843138dfd48c3c257f7306b571cc6762bb5a301b4f1e29bd2c577cd88",
      "text": "Harga yang terjangkau dan kemasan yang menarik membuat produk laris, walaupun mereknya belum terkenal.",
      "voice": "id_gadis",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "7160f23d17455bfebac3bbe1bb5f23544ff1c4ccaba5cb485921bb33204dc364",
      "text": "Itu terlalu banyak. Kompromi: tiga puluh persen, dan kami melunasi utang lama dulu pada kuartal ini.",
      "voice": "id_gadis",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "72065194b8d29830c3df7c4a77c22974a05931891f983c55d39fff89f5fe2e85",
      "text": "Saya punya usulan. Kita pesan dua ton dari Mesir sebelum harga naik.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "73ffc6e221fa44a0500786d267416ced0a99af3ffa590f7881e0d2f3db92ecdd",
      "text": "belum bisa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7577dea00e158e78e2cadfe760f2d03568f687c5c3f1513ebfb549a7b283fc05",
      "text": "Apa syarat untuk menjadi mitra waralaba Anda?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b65ca327f8a0f111c6d0aad85499ae148ab4bf5fa7db7a668f9628936e0d892",
      "text": "Terima kasih atas pesanan Ibu. Harga satuannya delapan puluh ribu rupiah per kilo. Untuk pesanan di atas seratus kilo, harganya bisa lebih murah.",
      "voice": "id_gadis",
      "chars": 145,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c44a9df422de895eab162f4a271bb72068c7177a51e6cbdc3f386fe77132f74",
      "text": "laris",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ca21039e366f6715f134ba649bdf481ed5c75cf533272fc373622916514b2ac",
      "text": "pembayaran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ced96b8ea4fb0bffd101bc2745e0d45371bca7b1239cfb36d4e84fb86e21c0d",
      "text": "Untuk pelanggan setia, ongkos kirim ke seluruh Indonesia gratis.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "7de114d4124dccd567183e74bca9779e160ca969a1385b78fce2637652470a90",
      "text": "Kalau kesepakatannya bagus, kami akan memesan lagi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fc5ff81282ef2f4b0ecc8e7a5feffa9715e4d5b4293c5f3b0248e17fe5227ca",
      "text": "Kalau tidak ada mufakat, kita adakan pemungutan suara.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "805f686c461b8db46a6e25481b486d18adaf2864d239645c1001813005373bb0",
      "text": "Penawaran dari Kairo udah datang, Uni. Aku harus nulis apa?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "81903193054ee98a2a61f76a8d65092fe95da4d91c085edf43820373298ae1fb",
      "text": "pemungutan suara",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "864ce288bddf27d6a8bfe74c0d6db9c4f8cdbe4c68e6b7d3bb7db0f313a76f23",
      "text": "atas perhatiannya",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8785dcd823facbf3baab35077bed30847a88cb126eec9854713a18b074b524ac",
      "text": "Bagaimana kalau pemasok kami menawarkan potongan harga lima persen untuk pesanan pertama?",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a32cf53fe4b9828a54c875ee795502a127d94b7a882294459dc1c8c5b5bb65b",
      "text": "kompromi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c8562ec2603f15e4b74f1dfff50a70aee00695c8680a0eae3cdc49162d58082",
      "text": "porsi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c8e569a67cf09257f39cb8981e1ef08d6d255ba487a1f10a6da85b1ee763795",
      "text": "Itu kita tunda sampai minggu depan. Kita perlu angka dulu.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e9997850bd01fff88b8fb7a30ee2eddb52515d1974e0df84251ccc317c17467",
      "text": "Jangka waktu perjanjian ini satu tahun, dan uang mukanya tiga puluh persen.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "9536a23cb08b7ef3cb4c05b6d2344e0a4ccfd8ac02990fac0faf7c57b8690da1",
      "text": "merek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "955632b723f907328d98e4b85280439cfd452410c8df81db84e5d13e7d0b800e",
      "text": "Usulan Mohamed diterima tanpa pemungutan suara.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "989692646fa0a3b7c57569945018bb85286fca4776d4941956e4fa0b9bebf867",
      "text": "Kami melunasi pinjaman pada kuartal ketiga.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "992258f9af83666fc06a2fdaa6f2990b8dd775d45da996362d3c22055ceb1f17",
      "text": "Kemasan baru membuat rendang tahan enam bulan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9be5c81a6162158f586a7de19acaad6c1670817f7f7577ef75a9accdb1aae3e3",
      "text": "Bagus! Tutup dengan \"Atas perhatiannya, saya ucapkan terima kasih. Hormat saya.\"",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ce8c59efdbee3e71bdfe02f95c611b12aa6bfaef6af3aea73042d7f26ff9823",
      "text": "Uda, teman saya di Kairo menjual kurma. Harganya bagus.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f76c687d30a0c88505250224b49e6f77d4197ec474ce1c6d8f509614188fb6d",
      "text": "Setuju. Terus pelanggan baru dapat kupon buat pembelian kedua.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f9d09b99a85657953d2f8b23974ccb5f7b28b71028222afd9f6fd595a57fae1",
      "text": "terjangkau",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a423bb32966d64d431b02c33dcfd7d8425fa3a14a0d5cc6a8aca6730a9ae5e77",
      "text": "Saya mau menulis email ke Uda Fadli, Uni. \"Halo Uda, ini harganya ya.\"",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4cfa5f2e37eb5423179f78457bd074785af6abdc4870157d23280207791f4f3",
      "text": "Mohamed, dua bulan lagi Ramadan. Promosi kita tahun ini apa?",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a635e7bb09fb513a8bdf2f516eb8bf99034107f5e6c6c5763f4e713e1f5a6ef9",
      "text": "agenda",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a68078de9ef42b034d66110e5ce3e0d97fd095a0ceba91c5a47cec096f6bd201",
      "text": "kupon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a70f633c1fcfcde744b3076acaca74596476e30834e6e56cf3c2345b47415dea",
      "text": "jangka waktu",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c1f279fc25ed521656817c56b3c28b116cfcf018da8248735a45806a68216d",
      "text": "Mulai dengan terima kasih, lalu tulis pesanan kita dan harganya.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9aa41f12883e975b9714efa0f4cfcb0adbd6fc526f6fadc1ce2750c686256bd",
      "text": "Selamat pagi, semuanya. Agenda pertama rapat hari ini adalah promosi Ramadan. Setelah itu, kita membahas gaji karyawan baru.",
      "voice": "id_gadis",
      "chars": 124,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9d5e78d2b58866033f10bb743b117e5c2d380b0d5b08d45e4d633a4955ecb5a",
      "text": "Bukan begitu. Sepertinya bulan depan kita bisa bicara lagi, menjelang Ramadan.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa6d0e34c15ee65d4de3a039772ff5aa9d3993748223930b4da9da86094a4f3d",
      "text": "Saya bilang, \"Pertanyaan yang bagus, Pak,\" lalu saya jelaskan dengan data.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "abf5c29241558eb21d8c976dda30cb63b25ef9bea596407f76c8a272a2ac06fc",
      "text": "Rendang kami dibuat dengan resep keluarga dari Bukittinggi. Harga kami kompetitif: lebih murah daripada toko lain. Untuk pembelian grosir, ada potongan harga lagi.",
      "voice": "id_gadis",
      "chars": 163,
      "mime": "audio/mpeg"
    },
    {
      "key": "b060a69ba52e72cc7ee12f5c8e4f999f81fc6f08c91d744327b5ce63961dedb6",
      "text": "Wah, tawarannya menarik. Tapi untuk sementara, stok kami masih banyak.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26f545c41040ed6180019ef4ae2f207d1f9664ce74ed6d9092e82f38e818fd6",
      "text": "Saya bisa menjadi mitra waralaba. Apa syaratnya?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b29f4f983759ec0dfbcdb4d2eebdeac8bc347d0f56d26b359411f0db36b38516",
      "text": "Investor itu membaca proposal kami dengan teliti, tetapi dia masih punya banyak pertanyaan.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c6497a4bea3d7bc70a69e3cc430d27c6e33f2acd7a1e44cf238db793aeeb41",
      "text": "Ke Berastagi, dekat Gunung Sinabung. Saya mau belajar menulis di sana.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3d7b2a6ebef709822aa439d4bb3bfdce6689414c35a4ef3c75eb134047012c0",
      "text": "Mitra waralaba harus memakai merek, resep, dan seragam yang sama.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b443c75064d6a9b51f0f9628215a0e0488464c21bd8b026815e13c9eb037263f",
      "text": "Terima kasih atas tawarannya, Pak. Untuk sementara, kami masih memakai pemasok lama. Mungkin tahun depan kita bisa bicara lagi.",
      "voice": "id_gadis",
      "chars": 127,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52419331feb711099b9e35a1dde3ab22e2f5fb5953784b78a9192f8f930adc7",
      "text": "harga satuan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b578703245a980ebc5292285322dcd494dfa64a514a96ea031b070c20ed588a9",
      "text": "potongan harga",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5fe27fbc65bb414bc2462a07820cf9aa9f868da7779ffa2d973764e4c5f369c",
      "text": "Harganya terjangkau. Pasti laris di Kairo!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b733e14e836086fcea27dd2adbf72748629829df0a819ff4b8cb5328fb94f863",
      "text": "Mohamed, saya mau buka cabang di Kairo. Tapi butuh pendanaan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2896f4d24e9fc023c1c884f982542a4b80e4b5d075f139993cf14a1d5abe2f",
      "text": "Beli sepuluh dapat harga grosir.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba66cf96f91b38cdf0df54c57b01474635195203174163dca8c683c05a7882dc",
      "text": "Kabar baik untuk investor kita. Penjualan kuartal pertama naik dua puluh persen. Karena itu, kami siap membuka cabang baru tahun ini.",
      "voice": "id_gadis",
      "chars": 133,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc31d381fe94508f3b51d43ba97d59bdb2d26d93433a255a4ad8e48ec167dc01",
      "text": "Uang muka dibayar waktu kontrak ditandatangani. Sisa pembayaran paling lambat empat belas hari setelah barang diterima. Kalau terlambat, ada denda dua persen.",
      "voice": "id_gadis",
      "chars": 158,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc6db87a03f7a57cd12cdc67708bec327ec9a75545f2c20fc1a09f28e75233b7",
      "text": "Bapak tidak perlu membaca dokumen yang tebal. Proposal kami hanya lima halaman, tetapi datanya lengkap. Semua angka penjualan ada di halaman tiga.",
      "voice": "id_gadis",
      "chars": 146,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd929c8bf57f92c4c66b231842698b23b2683cd2da671f398465d48fef4c8299",
      "text": "perjanjian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c260f778884705b0d739d0ab996227299de64d169e71ff848654af15b3175ffb",
      "text": "kuartal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4b6897cc4259c221592fc135db368dd80e7451e2f78cc32654f0e987535d3f1",
      "text": "uang muka",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c596fbb317dc94b86bdeb76734cf75d2035430312d30243d548d1f2c58dbd148",
      "text": "investor",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c77492cb29d1a73d252170b2e3add19c53e2200babf3eef4a89e42be8cb5ead1",
      "text": "katalog",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7c5b6240ad132f17a70dfddc00255a76617f08f12d9eb2025b99e58adaec8d0",
      "text": "pelanggan setia",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9598df8f04ea1c59150c6bafd78a25cfc0605e5914080154482b27abf0630c3",
      "text": "Kami mencari pendanaan untuk cabang di Kairo.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9c264ee72776d12dbb3108ab48f747ed5a6506595580f5beb96832286633281",
      "text": "tim",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb8b03b224409cdfe879239739b93390a4433c4e4c9030f33e3bab4c3976d0d8",
      "text": "Hormat kami, tim penjualan Kurma Nil.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc4ead304ddc6e7863541245c2b3aaa0c48e895d2d24481de84181b2cfccab65",
      "text": "\"Kami bersedia memesan lima ratus kilogram dengan harga satuan yang disepakati.\"",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca78ef0e92ff1146089bd17fbf6d019cd403f076f823aceeaa5fc2f9bbcd10b",
      "text": "berinvestasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd7d3a29b443dd4caaa71f90b77c021736d65bcc509b724afbe4a087e517c5bc",
      "text": "sementara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf85410b6ab0f8ce01f9a0b0551bee4166087175c53f4e815ecb1bc8764abe82",
      "text": "Sepuluh persen, barangkali?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d01d7d7a5aa800e1a27e89dc41dff180cfd3e039dd215242ff471b0d0d6fa779",
      "text": "Pemasok kurma dari Mesir memberi potongan harga karena kami memesan dalam jumlah besar.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20d44ae8e40c3c7ab7f3078850e56ab920eec2bc245fccae8758c912a654ae5",
      "text": "Kemasan kecil cocok untuk satu porsi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d22955bca8440d88c2494741ef475bea71dd5eed498910f831d5ba7943699522",
      "text": "Merek kami sudah punya dua ratus pelanggan setia di Padang.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2aaaa6194a64a35e5c822a0f1fab37131396f61eab5e3699a86bb49f29009fe",
      "text": "Baik, kita mulai. Agenda pertama, kurma untuk Ramadan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2e18bc0c35da275423f747344b50e7fcce59f42df4c0ac8c619f652b9e41e30",
      "text": "paket hemat",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d65c0e590deecedd46e35a7337429d99a1cd6c5aa98705c75403194c9333f43d",
      "text": "Rendang ini laris karena harganya terjangkau.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d79915a2c47c5b20635bee5c3d9234873e45c5e99a868b4d42ecff05c0d41838",
      "text": "seragam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7d7c5bd07e7656e5039b5b3e212369283e35af601ee4af8c21805de7479279c",
      "text": "Dia minta lima puluh persen. Bisa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d92fa64eb59b2dd2391087b5e2109254a9130b2524e9a0dd5d25a227a2c7192a",
      "text": "Kesepakatan udah ditandatangani. Yuk, kita rayakan pakai rendang!",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d229e27c4aea96fd452f0dce514012b5559893016d52c52370bc50a49a900b",
      "text": "Harga per kilonya masih agak tinggi untuk kami.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "db6bac075d82c4d03e064889444fc553d96efafcc51df3473e64fe75fce31d32",
      "text": "pemasok",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbb2e1d72194ca96c4c282f5e1d63edfe9b4b3c6e0b73fb58ed79bcd9a0bf282",
      "text": "Dengan waralaba, setiap mitra memakai resep dan seragam yang sama.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbfe86506484b265b4b380df4f2c1b70d2418a631c7f59e1cc432f334200cef2",
      "text": "Setuju. Saya catat di notulen. Bagaimana dengan cabang Kairo?",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd969793b8d20f2aa7b51e3b38effd7091a8227da3e67b908b550fb473407d41",
      "text": "Satu ___ rendang dengan nasi harganya tiga puluh ribu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "de3a3cedfe1d5bb39993939603b690e3cad96cb58b423995b33ed73b54255f12",
      "text": "Mohamed, investor dari Jakarta datang besok. Proposalnya sudah siap?",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "ded148e2bc4eb6d1d419576546bb581464f3e58bbb854aa0dac2cc998222c8e7",
      "text": "kesepakatan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "df85846cb9a06e3345e9bd084bcc105e77a5877a46df2ff2aa53fc77f69651ec",
      "text": "kemasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e13e95437cc10e042f7f1b85a89cae292cfc03d7c6d979140de30f39d81c58af",
      "text": "Kemitraan ini membuka pendanaan untuk cabang baru, sehingga kami tidak perlu meminjam uang dari bank.",
      "voice": "id_gadis",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "e15dc79c2b492d011091e33f14e21e61fc675c9dafde761ffd8e7b0814a2d831",
      "text": "Bagus. Terakhir, minta konfirmasi tanggal pengirimannya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e25b727e7e79795a62d31ef2898d11f799f548aee650e3ae98309d366a0cf3e0",
      "text": "menindaklanjuti",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d3d816d4e2da5778eef1a079584553239942f81f5188971b7e1f45f645a2fc",
      "text": "Merek, resep, dan seragam harus sama. Rendang di Kairo harus seenak di Padang!",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2faa4003d01b5a36bf5f57bbd8246272b1277a67bbf406334e71d9e8452b8c1",
      "text": "kompetitif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e53be92ef2f1cbe418195d7d4d4671942f76df304c9156fa6072e09e37ab1c15",
      "text": "Semua karyawan di setiap cabang memakai seragam merah, supaya pelanggan langsung mengenal rumah makan kami.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fd914cdcb5fe0c1a80fe6970cac580adb4b29945a4686237ff8b0701c63733",
      "text": "grosir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e694c5b95c435c6a866992c155affbd10f76321e70878d02c63c31ff6dab0af8",
      "text": "Penawaran itu berlaku sampai akhir bulan, jadi mohon kirim konfirmasi sebelum tanggal tiga puluh.",
      "voice": "id_gadis",
      "chars": 97,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7acad6cc7206ada3115948e5c8ab11c7d0f209648a5614897113ee2478ed1a6",
      "text": "Harga satuan untuk pesanan besar lebih murah.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8c6e426735615426e505250018cfb3ca6aad5bb799c21a7db68fa449608476f",
      "text": "Lalu \"Menindaklanjuti pembicaraan kita, bersama ini saya kirimkan daftar harga\"?",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "e91b9226c350b49f2f40faf79a206d065a6d948109549b5a40025d99c9b413ba",
      "text": "mitra",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e94b93bbafebee693ac9e73a6121b9e98ab7418051cf0d8eeb1067d3cb188826",
      "text": "Boleh. Tapi direksi kami harus berunding dulu.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed325f7a45d8341ab8a3ed90d96721397b503328965a9888293ac6ae54405aec",
      "text": "cabang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed9e707d75cd1d483cf90e610a83bfa52317c4a8016cd1238694361e9c25d68f",
      "text": "usulan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee2629251333b437e54c8d61cefb25fde7df1eb573c9d83b96d03333d66de97b",
      "text": "Kita ambil jalan tengah saja, Uda. Tujuh persen?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f025eeda169a1006032c3424231de9f087d60e106fd2aa22cd534347542c09b5",
      "text": "promosi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1c5ebee781815cc0c0d5f49b1e1c7090cdd82867342d0248fafb2784971343a",
      "text": "Usaha ini dimulai dari satu warung kecil di Padang. Sekarang rumah makan kami sudah punya dua puluh cabang di Sumatra Barat. Tahun depan kami mau membuka cabang di Jakarta.",
      "voice": "id_gadis",
      "chars": 172,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4bacc7bb7187f4d9c4bd70b9f6f01c0841fb7a5c006bbb5a87ec3a0524ddb55",
      "text": "Bagus! Berapa harganya?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6f99c7b7bc430846c89c4b27329284cc14754ce8fe9b55c16999458026eee36",
      "text": "lampiran",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "faa9a3cd67ed0553096482c06bfe5f5ef7c12207b3cac6aca8f05873429282e1",
      "text": "Promosi Ramadan! Beli paket hemat, gratis ongkir!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    }
  ],
