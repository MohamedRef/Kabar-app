  "version": 9,
  "content_hash": "cea840d506a376bf73ec83988bfed005acf2ea18d76f1def47edea04f3173e03",
  "lessons": [
    {
      "id": "bipa3.u06.l01",
      "sha256": "05be8c85c4926854c58f02160425b3b3dc512af7caf3b5b265e7af811756e333"
    },
    {
      "id": "bipa3.u06.l02",
      "sha256": "aa7ce554bdae2e820df552e8673e9af81d69055c961f1d3cf03b631c1d61aab2"
    },
    {
      "id": "bipa3.u06.l03",
      "sha256": "9c1628c601807515794338e82a2f28b341a7cc94f5358a595680c6ab9a4e8014"
    },
    {
      "id": "bipa3.u06.l04",
      "sha256": "1aa9c0fcffc8e64b9562507d6618d3c2f6e290a8e2814a5ea430466fc378d3f6"
    },
    {
      "id": "bipa3.u06.l05",
      "sha256": "a5462aad93daeb22775f909ff586828e8b6326d9d6ce77146575ad7b1df17bac"
    },
    {
      "id": "bipa3.u06.l06",
      "sha256": "743e5e98796693f9e436d24eac8a6eb702ee720ea05fd146a1d7f0663b9c417d"
    },
    {
      "id": "bipa3.u06.l07",
      "sha256": "c7ab2171a97f5ee160956d601131abb53a1b26f942f843e7ba8f320975251190"
    },
    {
      "id": "bipa3.u06.l08",
      "sha256": "6a3cfe363fc60726341aba5d604f78d707866adb68cf5d8c8a1e159d8ebdcc4f"
    },
    {
      "id": "bipa3.u06.l09",
      "sha256": "70c5cc2d89380812eb21d7a1e9d4c207956b6f9ad13a41ce0b7e34cd8f3e12dd"
    },
    {
      "id": "bipa3.u06.l10",
      "sha256": "4183f9d0d7d2cb8834efa8926ceb3f5b7f68169af7ca8893399f7196ebe2de73"
    }
  ],
  "audio": [
    {
      "key": "00bec9ec9422e495b8d432acf74826722e1b2f307bbaad9861ced55e8f5e13dd",
      "text": "layanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "01019f37999ce2a6945dda92eb8f3f3cd2bff473546cf5574f8392505229c2e2",
      "text": "Sebenarnya ada masalah. Kamarnya nggak sebersih foto, terus AC-nya rusak.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "02d90aefb335a95fcf7ac027d520af3a81df0dfc249850e63a25b27335a3bb5c",
      "text": "Petugas sudah mengganti lampu. Kunci kamar saya juga rusak. Bisa ___?",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "0516a59e4c69873fd7ad0f27859069bf1122514bdf049286617fc83e692d22a4",
      "text": "Atas perhatian Bapak, saya ucapkan terima kasih.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "05e1c788e0fd097d50701e90d085b798e03a4e3e41193a18e272b85fc63790c3",
      "text": "Dengan hormat, saya ingin menyampaikan keluhan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "076679611522e061a5b3d4249789d913f1b64777b018a0ab4c5bcec8463c5e13",
      "text": "Mohon maaf sebelumnya, air panas di kamar saya mati sehari penuh.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "0864d7a40ffde51896dbaa79391f0425e1d5f574f54d2ed9f657815313656620",
      "text": "Staf hotel itu sangat sopan dan ramah.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "08e01fa9b850a8986b04cf5cd76864a936067318170725bdc47a7d4985af967b",
      "text": "Baik. Tapi kamar saya juga tidak sebersih foto di situs web.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "098522f4c68a4349d55c5d1e12e847fca21951fd6f2293c119ae66ae842aae44",
      "text": "melayani",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e214543ecce1e7366174f76fe186b5964a76d3ae6474f638721eac28d40b1e",
      "text": "Masalahnya, AC-nya rusak dan kamar mandinya kotor.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a5db30068e985924fc4c38b6a3bb1dc58d70e96076df6c533e75b03174f75a7",
      "text": "tersedia",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb2394dc4ec87d9a0021db16a340abc49ae5d3aa184a54b1df97952d46ec724",
      "text": "Kami sekeluarga menginap di sini selama seminggu.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f3f4e52e72028b13b513327f18ad0abc840da6993198555c5010a86e9ffc693",
      "text": "Terima kasih banyak. Sekarang kamar saya sesuai dengan foto di internet!",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f56394fcc6685ab23171603c12781a1112392417dbed5cf40c60a641681a303",
      "text": "permintaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "159fbf9c03d054acb443a715b9de0ba5600ff5573cf2f3e0c67d319bbf4ba7a4",
      "text": "Kami mohon maaf. Ada apa, Pak?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dd86f81b6b836a2e9ee6e61618987e64321b7a617850529a2e414d2f1be3d73",
      "text": "Saya memesan ___ kamar untuk tiga malam.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e0fc5b989993b767c92fa713aa850a9fbc79688a6235a013580313f0dc0d65e",
      "text": "Perihalnya “Keluhan tentang kamar 12”, ya?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "247b761a0427171610219f3547c665546dfaddc52cc53112592697b8e1cff80a",
      "text": "Selamat malam, Mbak. Saya tamu di kamar 12. Mohon maaf, ada masalah.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "285563560f174e0430fbeef9ad3ee0378e5c2234ffb401628e55c12a3ae5cd13",
      "text": "bersih",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a52e17aac1a5159571ea1baaa32915891b23eaa19db7e3fa59fe74ab8f676e0",
      "text": "yang terhormat",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a91402fa1cd2d547e1424ffc01efdda56d3ac324a6ac44e6555ba2e0aa23512",
      "text": "Kamar ini berisik. Boleh saya pindah ke kamar lain?",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e74b627b16876a30422ae59fe54e466899e3773edc350df34745551cc249874",
      "text": "Yth. Manajer Hotel Mandalika Indah",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e869dc6e93d42c2e71cd917975c1922ba8b86e81cd5f0771ade803dbf6f2e7d",
      "text": "Kualitas makanannya sangat baik.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f3ada0fca5e5a19edd33dcb891e6a7571616358c564001d89c7f2defccdec83",
      "text": "Kamar dengan pemandangan laut masih tersedia.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "346beb656bbc27463c1a461fff28ff6d52362cbbbca96d4ca43203e8f72801a6",
      "text": "kacau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "35d8ce9979190738aab54db4b09297579e01018bab84518fcf408ec813bd915b",
      "text": "Tidak apa-apa. Sekarang kamarnya sejuk sekali.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "361d5853b6ead4e2c5633ba07f8b18284781baae68f826e78eaa74f640d937e1",
      "text": "kabel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c3f78c5fd823a1c6d0f9494c90cb3b633cace52a4c6c71bca1a6336f522367",
      "text": "Mohon maaf sebelumnya, kamar saya tidak sebersih foto.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3808b78e47cbbb789385dd3cb3a665fccd54e8351f2ad7dfbcd80c73e1e92e4d",
      "text": "Perihal: Keluhan tentang kamar 12",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "384843550c275d30161f0b6f1c2b37669f2ea92b7e6c18cf8e8620e2dc4b1c45",
      "text": "Fasilitas hotel ini lengkap. Restoran kami ___ makanan halal.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "398b363f8eb5ffc0a6c5e075d6bdbc805d9d8d8aa891ea373e66da791d3c0c56",
      "text": "Saya menuntut kamar yang bersih.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "39934b2c8b01721571aa75f436c3f087d541c1d68cd6555d5f8707ce39cc2977",
      "text": "___ Bapak pindah ke kamar lain. Kamar itu lebih tenang.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "39fcf16077eb7d6054ef6ab069c9436feb49f5841c1f4d9d8f272b6da24979fe",
      "text": "Sebenarnya, saya sudah ke resepsionis kemarin.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fd3237398eced5a771a1b0a8eff644ce926ec7604f8f2649f2b37f516baff5e",
      "text": "berfungsi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "406e596d0db55c142e1b770ccf186a26ed83aa1c8aca1e969dd2301639af2669",
      "text": "Saya memesan sebuah kamar untuk seminggu. Nama saya Mohamed.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "419237676c114c2b786ac009ada1ceaa4fd17b862076915ff99501867ea95358",
      "text": "secepatnya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "422c2cd08a7236aa4770004282b704e8c51439a5fb1fffd8912ae014f0ccb512",
      "text": "sebelumnya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4907681e459dd5d682475b4df860b9c6afed15f2a15cae165a2888ae0afde94b",
      "text": "Wah! Udah nulis surat keluhan?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a6591105d511769d6ae41fb1447fdb6fc1a252734d7b5eafd760e3b5c64ed35",
      "text": "Maaf, Bu, celana ini terlalu ___. Ada ukuran yang lebih besar?",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ad7a50ee10cc84dd6a01b87d52a8da3fc7fe31aca203f408830e67534a148d9",
      "text": "pihak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c67cbc3edf51364333ffc172c45ee2132a372a1fa78ed56832785efdb894f94",
      "text": "Mohon maaf. Teknisi kami akan melihat kabelnya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d72a452d139814714c2c03ad7ad62629829fa4fb389628428083a8fe4a592c0",
      "text": "Mohon maklum, petugas kami akan memperbaikinya secepatnya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e344324ed87c6fa0158e19ba6949e49f56f1b7b369ef5fa5e976bb23cd9dd2a",
      "text": "menginap",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f00a2115cec12574118af5c31d45f9b0f12b32ccdd58108ede458a9fd2a93ac",
      "text": "Sebaiknya Bapak pindah ke kamar lain.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "5028bf381549df5919938db4918adea6951b2d560dcce3d93fca834f60d69c92",
      "text": "Maaf sekali, Pak. Petugas kami akan memperbaikinya secepatnya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5182a0ef8d2b0b4a6b6e626ae2b58483dc6f795c56d9bea1f3b5be9ac18948a6",
      "text": "maklum",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "532394d9b6b627915e4b3627cdd6a5f4a68c1bc8bc3585e5e3159513db4454ae",
      "text": "Pagi ini hotel kacau. Sarapan terlambat satu jam.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "54fefe771bb8af25b3536fd01e8c9f28b62042fec972dd25c5758a834a2975e6",
      "text": "Mas Rizal, aku mau nulis email keluhan ke hotel. Mulainya gimana?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "55082884159ac623798100d1cab6a22b39b9a06d61ec19908cf68a6d63b8101b",
      "text": "Hotel ini menyediakan sarapan gratis.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "59657532caf27665e92231fe2be5e4d2ba1bd56948c1cf2c5d7a77138e7f10ad",
      "text": "perihal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5db6bd57ee613345c41ae2588d3b5852a557953d397e6a97506672f4ea7b7738",
      "text": "AC-nya juga rusak, dan kamarnya berisik. Tidak sesuai dengan pesanan saya.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e19a3375aa65108c3814a04c029e9e5fb3da4f683d63757751987ff4f197370",
      "text": "ketat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f7ade2120c1de6b9feb6077fb4ad66c6435bef837f8fc2379a95300da9362d7",
      "text": "Kalau email resmi, tulis “Yth. Manajer Hotel”, terus “Dengan hormat”.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fdafb40d2a1129c8718e0f82728c88565060fffac8c9f4c8436a0e03cdf885a",
      "text": "Udah, pakai “Mohon maaf sebelumnya”. Pihak hotel ngembaliin uang buat satu malam.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "607710d28660055fa64856a5fc768d17c0b220db19e4db820e7a36444c5d1682",
      "text": "berisik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "60cf1a9de96ebca6ac99688a9ed4dc5d6625a6845d7c8cc7b977b9884119e6bd",
      "text": "mengganti",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "61c131ae0ebee393a2747042a47aa9949ffc0e15abe3e60efeddada669d76a0b",
      "text": "Sudah tekan tombol yang hijau, Pak?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "63cd04e04628ad407f1c2de961ca45914bf613a005caf946d66c0f3ee53f9959",
      "text": "Kamar saya tidak sebersih foto di internet. Kamar mandinya kotor.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "63e45d2d153999a63ca57648d115c8eef3e3ed007508d783807d791ab29288ef",
      "text": "Televisinya tidak berfungsi. Kabelnya rusak.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "63fb1a7296ae3f47074b63d644b1d82eefb56ba05ef8dd0d3a354ce4ec5058d3",
      "text": "Kamarnya tidak sesuai dengan pesanan saya.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "664b50718f4b2e91990f241c0a2de12bf4dcc029a25f914f24d7b9e8b21ac1b7",
      "text": "Selamat pagi, Pak Mohamed. Saya manajer hotel. Saya sudah membaca email Bapak.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "66c4cb9eb3e2b395fd6895eac6c27fdd26332549044c6d4ec14ad0e258d8b5db",
      "text": "Saya memesan sebuah kamar untuk seminggu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "671eae9c235c35d43a7f564f65eb9c2b78102cedb046e7326c53e36b24d7fb60",
      "text": "Kalau tidak bisa diperbaiki, saya minta ganti kamar.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "67d41e988f0a490a231c85ddc724dc9015f455ac6de1190123ba77e4f150dcc8",
      "text": "kecewa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b4484cbe74d8e88c788ff1cfddab1a56e30a3da6160b810b7c54623fbc5756b",
      "text": "Mohon maaf sebelumnya, saya minta hotel mengembalikan uang saya secepatnya.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c8887199b79d337072bc632725841b2615d682f6c76c73389085783ab29c08b",
      "text": "menyampaikan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e18ee48fd5a61358711cef013881a3d9374cebeb7ee24504483ae1f0cd45e8a",
      "text": "Masalahnya, AC-nya rusak dan kamarnya berisik.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "70082daba4c2705c949d39183d940f6a890a843f0d42729258ac805b79a7aa70",
      "text": "Mohon maaf sebelumnya, AC di kamar saya rusak.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "702e27a70be8be20b7f73ffb3bf749ca097387f5a1fba008e9e927d46172b8f5",
      "text": "menyediakan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "732798a6dd33cdfecbaac5784ce809fc09bf09144f034d26233a616bf2ba13c8",
      "text": "Gimana hotelnya, Mohamed?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "73da62e428b63d5a89431a2db34440c57c8f07d128c359d78f01bb69c92f421f",
      "text": "Pihak hotel akan mengembalikan uang Bapak untuk satu malam. Hormat kami, Wulan, Manajer Hotel Mandalika Indah.",
      "voice": "id_gadis",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "73e43ed0bccbef783a4b32d2a2ed7368df1cab76b47704fc5ef7d6689df35450",
      "text": "Masih. Permintaan Bapak sudah saya catat. Terima kasih sudah menjadi pelanggan kami.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "753745c98ad6d7b6299ec95ee5bfd84c91d9259df8f92c36491efc58b2f1df0d",
      "text": "Seorang tamu menunggu di resepsionis.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7657a80b0882f9dda673ecbdb5f4007dd8c565a32a5b188db794207d5f4b2aae",
      "text": "Selamat datang di Mandalika! Sirkuitnya terkenal se-Indonesia, lho.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "76bae9aa291650081e0927e6c5a2deb508a30a65a749daf3b42fff4c2b31249d",
      "text": "Kolam renangnya tidak sebesar di foto.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "78c483ba7ab568dfc2651e21d4c089af5bad0c1c77cee8111765859091c5d64f",
      "text": "Ada, Pak, tapi mobilnya terbatas. Kapan Bapak ke bandara?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "798c3f08461f17ba48e0af37da8e11d65e0fe2c10828b15dd9bc3ca3fcb75946",
      "text": "Terima kasih, Bu. Sebenarnya, saya kecewa. Air panasnya mati sehari penuh.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a4c424991d87b55a6bf721524ab82ab24266faa861bd350d65eb0d7b0b5d67c",
      "text": "rusak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c90c32fdf2f2c5c046821ca07f55eb135d5f7cf85f1cf43ab0b9757b0e0a40d",
      "text": "Sebenarnya, AC-nya masih rusak.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d308591df6ce9f6d814accb99214c9e9044b2976e4e16ed6b15149039b5d75d",
      "text": "staf",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d6ed798ac00c97dbb7a7099bc477f948f4f56c6b5cb07c840e663407aeac6ad",
      "text": "otomatis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7fad8a262eff15ef404325035cf757fe4960bf53b037309ed54e144faceafe",
      "text": "kualitas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ec7d550b4d28be397e134c8ad2f87bef0957ed286d0b0a9171bffe8c010c06b",
      "text": "keluhan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f3b6a78b39a15beeac4ae067a6377eb0cf1c5c51fe31747ca3cfa5b2c75868d",
      "text": "sesuai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f95caaeb3d6207073be277467188ba82982fa7f1e2db2d4811343cb7f785999",
      "text": "Saya ingin menyampaikan keluhan tentang kamar saya.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "84727ee10d4cf35f384bcdc2d7a2a3e9f62f13e9806349472083a13b500a5d50",
      "text": "Mohon maaf sebelumnya, Mbak. Sebenarnya, AC di kamar saya masih rusak.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "87f456d3ad10f7f8ace2bfa42d76bee2355f1388cf00789a01ea4bd228a3c01a",
      "text": "Itu tidak sopan. Aturan kami ketat. Kami akan membersihkan kamar Bapak sekarang.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "886470dea4ce8ca8413be5aeac2b367ff78bc2d17c88f8e1b1da217e06988957",
      "text": "Selamat siang, Pak. Saya manajer hotel. Ada masalah?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "916f8aa85a8496aa4a8cbbd0bce1c2280cc5ed2a1dd76bae6c0156ef380ff679",
      "text": "Saya sudah menekan tombolnya, tapi AC-nya masih mati.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "91a90f5852266c1a0ac089a55cf842c6806f833b9f6daa410de486df874a3364",
      "text": "Baik, Pak Mohamed. Untuk berapa orang, Pak?",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "920eddfaf3fa20a4fca38d5e1f03fe13af7ee00ee89de9aa1fd5e9e48b43f370",
      "text": "sopan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "92486f4b239996848eb3cef5c523b94715c46957ce2ec8c04347a2a20039eeb4",
      "text": "Sebaiknya Bapak pindah ke kamar 15 dulu. Kamarnya lebih tenang.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "93bc5d07c3c45c8f4f55b378b87a5ef35f92a2df590f0f50401131552d849033",
      "text": "Di kamar ini tidak ada sinyal. Saya tidak bisa menelepon.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "952c078255d0eb2b663a84633944aa998ab1e4e2f24e952e4120e9ab7b2c2bd1",
      "text": "hormat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d3e63aacd48dda2806dd7f892f1d97751e6349a3e234448cd3a4db5bd8f33d",
      "text": "Kami sekeluarga menginap di Kuta Mandalika.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "96ca33fad930b78dcc847ef817dd01de27dfc056b8d4ad990ac40cdda5e21fd9",
      "text": "kotor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9856e9fb9b90b6f555cd726389c698a4f739fbb89512508c1fccbe9d8cd3b164",
      "text": "Saya punya satu permintaan: tolong bersihkan kamar saya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d234594b72a13ab86fe5d71ab2f80dfd07373831453b2489216326ad2fc4466",
      "text": "Kamar saya masih berantakan dan kotor.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e570b93aba50f499858c2eb5ceb6ac9b8f8e208bc3411e0ad7dd67df48b4185",
      "text": "Mohon maklum, pihak hotel akan memperbaiki AC-nya secepatnya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fb578a6acff35d41b21b098f6e8953c5f96bf4b8ed5d63b917d27077d9fdf49",
      "text": "Selamat malam. Maaf, AC di kamar 204 tidak berfungsi.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6a99ca1c14d3c461e022a35ccd80c3913e935f4f35488fd935bb1b2475788d8",
      "text": "Sirkuit Mandalika terkenal se-Indonesia.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6da639d0d5367dffeb7837f50e071eb986ddb5c37b1fc368cb48e9f8df93948",
      "text": "Saya kesal sekali. Sarapan terlambat satu jam!",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85d9de9904ec56edab9ac5f22244ddb5d3e7a1e79ffaf0bf2b418a4d902a31a",
      "text": "menuntut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a86a2c787b2709e8e8f519eb813fd4a0b055b0a7f6f7a69f6878d3faa42d65ff",
      "text": "Syukurlah. Pihak hotel juga sudah mengembalikan uang Bapak untuk satu malam.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "aada0e77fb86d198d1a00e07c427a237b484c39d0524612f98cbb81bdcf432fc",
      "text": "Dengan hormat, saya ingin menyampaikan keluhan tentang kamar 12.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac861dd6052884470bc3bddaf7921f9c5b4c6a5d4d2beca0cac919c34c610344",
      "text": "berantakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae314e97773dfbc32919c09d38d137fde60c279cae0a59b246c6a76e412d739a",
      "text": "terbatas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b11fc5ab21be08817866b2b4e930c2504a24f9f0713b08081c2368a31795e6a7",
      "text": "fasilitas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b127c515340fe2bedaf33fd847429064bf803f6fd35d3343675de6fe249f657b",
      "text": "Maaf, kamar untuk malam ini sudah tidak tersedia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b29a93510ee64751b3d8e9986b07229b3e40ccec95695d5c8cc1eebe6a2357a8",
      "text": "Semua perangkat di kamar ini berfungsi dengan baik.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2b5ea33c47b5b72ee7d9a9096bbd2d3b864df75700c3e435834f376eb69ea2d",
      "text": "Dengan hormat, saya ingin menyampaikan keluhan tentang kamar saya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4fad6b18dbc5237f7ebcccc46794e101fccf67182631513f4cf89c27c64e1c8",
      "text": "perangkat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b542822eefeafc822c163460e34f262c63d2f4a95718503172dbb422c2d41cef",
      "text": "Satu orang, tapi besok seorang teman saya datang.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7b6d163d378cd3662d76be60b2821d6ee1984bd5fbe8b5dff9c745e26514eee",
      "text": "AC di kamar saya tidak berfungsi.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9d474261cf87d43fdca0b92bf0474d3bc800fe24db2e2c5f20fe3c6f4bd5606",
      "text": "masalah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bddd3961e0f277fbb2aae9b779c3032113d94c1ab2fc2cded7e90c80456444c5",
      "text": "seminggu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "be5562b7d5009dceaf1f0f2bcf75a7b9e4c4d8e21655620c5cbf621c6f32f04c",
      "text": "Kalau tidak bisa, saya minta hotel mengembalikan uang saya.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c27e48996b7e62a37d8dfcb601ab4d1bab7fc3a930b6994f6fddd6e5b005651c",
      "text": "Kami minta maaf. Pihak hotel akan mengembalikan uang Bapak untuk satu malam.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ba56c2a9bc52318058b470364c181e1a1b3149692e7331255b4aedc17530b9",
      "text": "Pagi. Apakah hotel ini menyediakan layanan antar ke bandara?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c459572b028926dfb575f21f3b54995054512ab0c77a06cd82a8c01d8de91a58",
      "text": "Yang terhormat Ibu Manajer, saya ingin menyampaikan keluhan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd71b70b6456e017fbe510f2c99963102265fc4357d7ad0068223d7aa1285b9c",
      "text": "memperbaiki",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14d2e6f76d3cbde16aa9e49fce49b5cf3e7933f1ee0fe81d51711a1d1cb58fa",
      "text": "Besok, jam enam pagi. Masih tersedia?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1b8a6305e93ddbaebda44900281c4c07e1fef1512b55b2a9aef2a8afb05ab80",
      "text": "Selamat pagi, Pak. Ada yang bisa saya bantu?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d28df1db201bd8d53655050a2865d9774aa847f3a3fbee23e3b5e1dd4c2644b7",
      "text": "Mohon maaf, kamar saya tidak bersih. (رسمي)",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "d77c668e1b631267a3960aae5eed882da73db5a729eeb8d1b6744ae816e4075b",
      "text": "Mantap! Sekarang kita jalan-jalan di Sirkuit Mandalika, yuk. Sirkuit ini terkenal se-Indonesia, lho!",
      "voice": "id_ardi",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "d81626c1d45ac5cc8e4a4ce023b950720c3e7b120140f9f5431243a37a0c8f2c",
      "text": "pelanggan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "da65178369c25f4f87877b46423eeb201d56b68067e7e22122e21294375ac7e5",
      "text": "Kualitas layanannya tidak sesuai dengan harganya.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc39b2ef6cd0e0219c173305afcd50dfffcc08805bd0c53aa70192045d151513",
      "text": "tombol",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc9080606957dbef0456393e0c662b5cd70ff4ef5e2896dee1aae644b96b4c60",
      "text": "Sebenarnya, AC di kamar itu rusak sejak hari Senin.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "dde1518b1a1f804a7307fbccedea6bc08330c4fcb953fcd7632a1118c3cf5fa9",
      "text": "Tolong ganti kabelnya. Kabel ini rusak.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33e4bf88b1e418b8ef8f63e041dd3dc61292b22884831ed66d4f2e2199aa1b7",
      "text": "Saya menuntut kamar yang lain atau uang saya.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e43e562400a146dc4f2c85fffcdcd45f3b5b686ea10912285ab22b2812023ce4",
      "text": "Kamar saya berantakan, dan waktu saya minta tolong, dia marah.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46b1632d7ea8426e60ea792ffabce554f16f06b91ea28cd1b85116c2dc5e7ee",
      "text": "sebenarnya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5e94c8248051f8c5416dfb018d087ae2360a08afafd893f9b2065e04c365e8d",
      "text": "tamu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e94fb78ebefd8aac1d0b49161b3016d2b1f80a1962cc55b35a54d8e48bb53fd7",
      "text": "mengembalikan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea3acc469581e58fa21fbae2229fd7bf13c658961179de35d09db67b1cc2bb44",
      "text": "kesal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec7d8b913602c6dabaa9c62730f2032c19b3838f85e7e01d5d245e94645d4f0c",
      "text": "Saya kecewa karena kamar saya tidak sesuai dengan pesanan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecb9d66168104a68698533ce0ca4a71710776e1a6f70862e755749a6a2e2dc29",
      "text": "lain",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb813e58113fdd955fb772bbcaf5e4bb477ee295dd1130cdd5723790d2b0981",
      "text": "Sudah. Mesinnya jalan, tapi udaranya masih panas.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "efaeb297ea51af65418fccb632c2157793d4720ce57b25972e47b33fe537e93a",
      "text": "sinyal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f06ae82558f0f9f5a8da6bd29f2fd326c1adc88225fe7cea7b3a2b74f4ce827c",
      "text": "Yth. Bapak Mohamed, terima kasih atas email Bapak tentang kamar 12. Mohon maaf atas masalah ini.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "f09554fa35629017a022dbcb81a7b461eb7bf99a4a645611f67b9139af0dfd27",
      "text": "Sama-sama, Pak. Sebenarnya, AC-nya sudah rusak sejak hari Senin. Mohon maaf, ya.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1f97fc216938f78f21a2defbffcad7792fd6d92eaa2abdff9d6348dd30761b6",
      "text": "Mohon maaf dan mohon maklum, Pak. Petugas kami sudah memperbaikinya.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "f256a7429bf063e3e95a45522e69eff572673cb64f67c298bf855e72a5d9f42c",
      "text": "Kamarku kotor banget, nih! (santai)",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2c7b14c4bdcfb254fadae7e8ee00d559ff2e655b40f55fa97047b711c3fecd1",
      "text": "Ya, Pak. Mohon maaf sebelumnya. Salah satu staf Bapak kasar kepada saya, dan saya kesal.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5f22f50cbf24af65b3d26c1df43ed78b42a5aaa8a6e52b82fccf1f2b96e7174",
      "text": "sekeluarga",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f690e592c441386656c094e23d6b76655ca465d8131430f5a499c6c5092c8d5b",
      "text": "Aduh, maaf sekali, Pak. Petugas kami akan segera datang.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f799cff129d7b28cd010d151db5d7381ff0b707dfa3f7095411c16d8fe9eac0d",
      "text": "Betul. Di akhir, tulis terima kasih, terus “Hormat saya” sama namamu. Jangan pakai bahasa santai, ya!",
      "voice": "id_ardi",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "f899131ab2705aa2896d9df6766e2a25a71c8b3902964501f751feee4f62a48e",
      "text": "Mohon maaf atas masalah ini.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8c1c04d319bc2cd72d76661c07791aabd3837595db223ba430129b403334009",
      "text": "Selamat siang, Pak. Ada yang bisa saya bantu?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa4e7b4de568cd5d52eb2c6638ebf5cfb3de1514f1519fbd8cc93c84ad8f2a95",
      "text": "Hormat saya, Mohamed",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa736be4957925e44827ee714f5e4a489cfab1099e461f77d94f3d8143256e33",
      "text": "Sebenarnya, AC di kamar itu rusak sejak hari Senin. Petugas kami sudah memperbaikinya kemarin.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbb3e93179ee990fb5a4858fff847f23518b01163afd8e9ee9890a468f73715c",
      "text": "Kamar saya tidak sebersih foto di internet.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdf556ab46738396b4247700b319eb9cbba0f9fac739bbc80e341ae029fc4b33",
      "text": "Mbak, saya sudah membaca email dari Bu Wulan. Terima kasih.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7665eaef702d9f40ac102f9366ef36437f32261576f1c4d4e9f4ce4efaa166",
      "text": "peralatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fead9abf393811391ef74f6eea3ef4a8f15f153ec2e011532429ebc6e95ad40b",
      "text": "Selamat malam, Pak. Masalahnya apa?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    }
  ],
