      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5cc7869117da4892d6edb0a079f96f5516e7024b7bbb61e5e0696ecba5a2868",
      "text": "Pagi, Pak Irwan! Bapak mau kopi?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5e028694d68191f34140182eb2239cc503daec6565c3eb398dd9800bf4e2fa7",
      "text": "Orang Mesir! Siapa nama Mas?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7fc351f914b3c8ccba06b61399a10e8d05188e32a87c975e6e187cd1743ec1d",
      "text": "Permisi, Pak. Pak Irwan di mana?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbc68d78d352c6bee2bfc61c73feb9668a21b362a0cdf9943e3b2be058b2fa4c",
      "text": "ibu kota",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd73098b189139066ba90df68a5d0a0874aae1863cbce88864365cf3a6931a6a",
      "text": "Jakarta adalah ibu kota Indonesia.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd79ff4d565bf38f383303f89e41838e1cca5cf7dbcb323ff2cb667bbb906615",
      "text": "dari mana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "decfe6fb31f011d0104e7cc8c871e0c7f64337460348fdf8c9524bb53a8eaff5",
      "text": "Ibu mau kopi?",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07f62682fe6e33f22e8d0ae34191c58a1c53846656548cfef3f3c4c60ea8989",
      "text": "Mbak, minta teh, ya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e18986c1242b2400871c4d9da15d332474a1dd3d010f6c0dc83968a858130d1e",
      "text": "Pagi, Mbak. Ya, saya mau daftar kursus bahasa Indonesia.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35df361d8239986f04fa534d9d8c520144fa29b4409a840538c329fbda5506d",
