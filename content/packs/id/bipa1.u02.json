{
  "format": 1,
  "id": "id/bipa1.u02",
  "language": "id",
  "unit": "bipa1.u02",
  "version": 5,
  "content_hash": "9c2f89711bf2744444a291955b8b8ce2071fcba5fc893062c3070b006fc087b9",
  "lessons": [
    {
      "id": "bipa1.u02.l01",
      "sha256": "d31206cf943969a26eb4fffe8d77e12dbd118f87c2646dffa387dce35748c279"
    },
    {
      "id": "bipa1.u02.l02",
      "sha256": "14f19015c7d9375eb2655c3a332a1096c4a9204c0094e0d78b2cb96e82a2e527"
    },
    {
      "id": "bipa1.u02.l03",
      "sha256": "0d73feaf966649017cc72e76693d6d15ee0bc338b3325b6e91bca580647fa70a"
    },
    {
      "id": "bipa1.u02.l04",
      "sha256": "2d41a3c3dab197cc85073a1ab81380f545aede784471492de28ca3d1e050a71c"
    },
    {
      "id": "bipa1.u02.l05",
      "sha256": "008b24a2a8c40603b02bc39bfe4e1df56c2860f1d26b566e8fb05a04b2ce3174"
    },
    {
      "id": "bipa1.u02.l06",
      "sha256": "81821910a5bcc396b4bf0a78e3ce9cb529ffd3402d2a40e5b822d1ef4a0c62cc"
    },
    {
      "id": "bipa1.u02.l07",
      "sha256": "ddf0655833e2d5d8e1a79784b27d82f0caccf0ad68b25d0ade70a66ed8a8fdf5"
    }
  ],
  "audio": [
    {
      "key": "04d8165c5b891e067fe5af2bab130015e5cbfa43ed6806605ec429d87a559a12",
      "text": "Ya, aku orang Mesir. Kamu orang Indonesia?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dd7ecb69cb639bebc74230a61c64a6f6e1f7b67eaf6ab9d667c907c96660162",
      "text": "Ya, terima kasih, Bu. Ibu juga mau kopi?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "106a34267f30fe18cae11dcf874db1137e6e9312c4dd2ad194f9b5b4ea03004b",
      "text": "Selamat siang, Pak! Bapak mau apa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "14561b68b7a1ae0b31d47c0ddfa846ba0b028fed267c59861143eabe14e0dc8b",
      "text": "Kewarganegaraan: ...",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "14b9690ce7809f957b8977f0e52f89cfc9341ee68d97767190bddde2cc709cf6",
      "text": "orang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1552b1e258d988766b61e65fb8fdd951f125888fee4c8b129f1e08227205a1ab",
      "text": "Nama kamu siapa?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "15fccc8b71ead61d146da79242a4f2717c8a05e4bf3b3db6c03eccf4f89eac17",
      "text": "Aku dari Mesir, dari Kairo. Kamu?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "183973daca7ee2b647e77cefb2458ae5bbfa28e0bc9812ac546c861eb743112b",
      "text": "Dia Rina. Rina juga mahasiswa.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c31ca8f9807257bcdc66ebb2850a39b67f4f52da5787d43796f61c18cafe5aa",
      "text": "Terima kasih, Kak!",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c75a49ba0bf3bf750495e1d8e190d9623434e6fe0259ff5d4ca260ed0e2784a",
      "text": "kewarganegaraan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1db52ef3f5ee40ac163dfb41cb4b75e68b822cf7a4d9ce49e34981e8edf80982",
      "text": "Rina mahasiswa, Raka karyawan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f15b85edd0abf248b2de734270f7033259125aaff3adb2b1b823c69280ddcbb",
      "text": "Nama saya Mohamed. Saya mahasiswa. Kairo adalah ibu kota Mesir.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "20321513bfc2f2399d50c0d76d916508922d0e8e5d88f2f290ca772c61c6ee04",
      "text": "pekerjaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "220803a1a9f8eab403d68af17618f4454ceffdd9f7ec1b3f7f035f385da4616c",
      "text": "Aku orang Bali, tapi aku tinggal di Jakarta.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2582af7f85ecba77a72d7cb3fd58919660d87e174cbaff2624b3b60217077ea8",
      "text": "Selamat sore, Mas. Mas dari mana?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "25a8917e837170efb9bdb6805207c6490571e82122e4726918151e4c7bfc6d9b",
      "text": "dokter",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "26bfb8bcd1b9d62d184d9a8a111b1a1b860dedaa289a322ddca7c0f151c64f37",
      "text": "Saya mau daftar kursus.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "31ec254a8843dc3a4565341f1b831ab1abea1c15be8d6e0259706f092ab1e782",
      "text": "Salam kenal, Mohamed. Saya Dewi. Saya guru.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "339a6a6a940e1bf2cfc9c5774607254d2b568c1bb24fb9379789c577d8016ad5",
      "text": "di mana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34e34d5788157a00b8598268254fc3fdf7868ca9310fce0dda4d922a9e9c3231",
      "text": "Baik, Pak!",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "357ff4eab12b9eb7d759286826ec9622feef727387edd18d2a772528bc85b1ca",
      "text": "Saya orang Mesir.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa21ae9fd8ce79846d746a8249f5da0e76ab845b2b00a4ef7ebc6deaaaae454",
      "text": "tapi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3afde4f4cb8454081b9428add0e17645ac5b92cf719d7b3165af5db11f1a6ca0",
      "text": "Kak",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "40864ca8eba292368ac3650dedf8fdcac1b2fef5263cdf1b164d70c5b610e099",
      "text": "Anda dari mana? — Saya dari Mesir.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4672d2a2e30ac091d7321ecbbb3c81d3d8775a09442e386a2243c895801d2fb5",
      "text": "Dik",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "47300079c9f2bd53c4b22a0966d11fa8de675fca7f1344b6751273e8100d8a6c",
      "text": "kursus",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "49b7d471bd0e979909b0f0a916a6a1b0359101e2e850aff0df9f726af9df245f",
      "text": "Nama saya Mohamed. Saya orang Mesir. Saya mahasiswa. Saya tinggal di Menteng.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b367e34d1353f9bf984287e446800340c69322f03461842b375683f60d361ab",
      "text": "kopi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d483ec66db5c0639d03bb1a956b8b6e59fb6443118a241292a0de6412f0da45",
      "text": "mahasiswa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e498a1b0748f4706f8cc6a77b6162bab8a638268e2d86ef3068010a0ece3075",
      "text": "Siapa nama Anda? Anda dari mana?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5210ee8440d1266c6731eb851f55e0acc694471f012ba3029ae817b111ed2c1b",
      "text": "Kamu bisa bahasa Arab?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "564c215afe68883bd83cb0828c02b06ced2c2dc7eba233942dac1e8544e835e8",
      "text": "minta",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a0217c96773c97d902cf40e6a2a3c525988b409ee39b9bbb518cc188e09e739",
      "text": "Ni Luh orang Bali, tapi dia tinggal di Jakarta.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ac740a5ddcf2097eda2e01ec7c81c17ec0f25867e9bb7f29e00304b02ff6a25",
      "text": "Saya orang Mesir. Saya bisa bahasa Arab dan bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c360eeb4c79ce589ddce9418cdf536fbc85d6d95d8591341f68206f10a75430",
      "text": "Sore, Bu. Saya dari Mesir.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f846de732b7e9d0c41df6345d52238466539c99964c8e39a2c13957225fe687",
      "text": "Rina orang Indonesia.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "62c93e995c3b2a0f163ffc538640a98d40413a5ab54c778540e3926f56d16f0b",
      "text": "Nama: Mohamed. Kewarganegaraan: Mesir. Alamat: Menteng.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6433c916084568e337ba1bce50a113ead4ff9b822c1eebba901da16079866067",
      "text": "Selamat pagi, Bu Yanti!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "65b1c1b81209f4e5fb3ad79d2866c29ebb249588a0adcf9ee1848e0c29308bb2",
      "text": "air putih",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "670e695ad5f0960d591c08a77a31de1dd3034a45d81113b921079d2eaa016d83",
      "text": "mana",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cefe0a8d90173d60d45c70b1b452895eed0b2a3a8ac70946a05ada5784c11a3",
      "text": "karyawan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "71201510c005da0afa08d75cdef30a869f2075b5e82d4768190c34a348a6f5dd",
      "text": "ke mana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "72bb6851a02ec02e75d878cd6c84eac15fbf34895f74b78246c1c4953499c1be",
      "text": "Kamu tinggal di mana? — Di Menteng.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6318b66d48f402477811142ef837db9e966e53fc7cb8197cc06231fef61461",
      "text": "teh",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b66da06f862a717b46435683fc818da8a9243166beca4d12a259046db5dc0e8",
      "text": "alamat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7beaa427df9eab919c7bf515b737b12f427cd4cfe9eac5629deb9cab11625ad6",
      "text": "Nama saya Mohamed.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ea01f97c4196f82f4d4809bef379e31037a2b5eb230bfe1be0a5b4658f5758c",
      "text": "Siapa dia? Dia dokter.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "801545f1656271b66ad77c2d4787ecf7e67b6d862c6808404fc33437d6c9fd08",
      "text": "tinggal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "81b8fe71fe03675821d8f5ee25580670f79ff811d651d2925e5735465cf6f84c",
      "text": "Ya, saya juga mau kopi.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "83a5e45a47ef8e6a7e12c0d66cb1e3fe24838e2234d8583281ca410c010f83c2",
      "text": "adalah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "850c8eec3d6267b901e2d5e1f10cad13735c871e62441824db690bc0c876540d",
      "text": "Selamat pagi, Bu Yanti!",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "86cb4d0031926540b86e74ee3d9833272986b526efe04ebe7ef017f1f1b4bb0f",
      "text": "daftar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "87c2be6eb8e54415b6e607e2a94933268b354f79323fcbf17683cc9851cdef61",
      "text": "formulir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8982a93c61844e9c4bb2516682cf9cdbb7ca40987bc0fe50ef27b8207f663092",
      "text": "Siapa nama Anda?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab96e69ed53bfdfd386c05eac5bcaac137c8bd5848ad5bee1b0206f816a44da",
      "text": "Sedikit. Aku bisa bahasa Arab dan bahasa Inggris.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d33e0064feb9a2ef0f41cc456bda26661eaf9d13ba576cf49d4a2e396a13e82",
      "text": "Pak Irwan guru.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da17763255cb4827ceeadaace3d6ef3bf7af8c47d68588e39d631d2dbaa8d28",
      "text": "Saya dari Mesir, tapi saya tinggal di Jakarta.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8deffe63415c543185c1607704554766d070acfb4397ff73b09d8cd078e34ad7",
      "text": "bisa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9061a2ce4ddf54280437f25d417e8c073e14d0138a8eb972bbb448254db6815b",
      "text": "Ya, sedikit. Aku juga bisa bahasa Inggris.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "94fbc6619d4187a8fa8d670e3bfac2e651a6e9d4438a0168ebf6ac521df994ea",
      "text": "Ya! Kamu bisa bahasa Indonesia?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "9959def67b80f7ee8c6cc70f159ec0d643fdeb855caf264ad01fdb07fc17e507",
      "text": "Saya bisa bahasa Indonesia sedikit.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9974bad592595fca3f6837ed132befacfc3da12befb84aa11fe7df98e59c6901",
      "text": "nama",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7bf79359e0992aa188578f09fbbf2e18c0a1d3f7ffc0a4ef0a4421144674dc",
      "text": "Mas dari mana?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a83c14fe65bc30d4cc8e99365027c2c8bbeb5d7b98184717fb7317b5e89abe2",
      "text": "Alamat Bapak di mana?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c4885be5682e7d872cd59698a1c01d14e71c1bb90664ade0c472e1a765dec01",
      "text": "Mbak",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f5b7ec4e9c436f84942157a02af3b2db3e98ee4b2d4ee03cff4152c95c7aa54",
      "text": "sedikit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a08935bd0c25ab52268b364552d3b2137830427267264c3a0be9f1f2c301db3a",
      "text": "Mbak, minta air putih, ya.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a258b22f73ffcba7764b223a3588f4f3dcb53a225f5d91f4d235b82bd236ddec",
      "text": "Nama saya Mohamed. Nama Ibu siapa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "abe8820fd3e4c0742e392c6be89071a183876e9ed1396d2e59d44ce733d427f8",
      "text": "Raka adalah karyawan di ibu kota.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac073e2f106cf3c22bae17578745a3aa513cbe41f0eb869ab4773b95da7f5392",
      "text": "Mohamed, kamu dari mana?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac8f1e9a3fc8033b7cb873f3380124b24384c0079dd38854a696abfa53a2465b",
      "text": "dari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae4f7a1905aefb2a99feb5cbc134a4dad34d4e90a0d5e6dd6de41c119850f17c",
      "text": "Saya bisa bahasa Arab.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae561f94bf330d58016c61edd6762cf9930f53558d7c12a1baba1b3f8c1cabc1",
      "text": "Mas, minta kopi, ya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae6a9307f250d464a4afe6bf5013535a18408df3be8d7e67039546e5a7ab1c7d",
      "text": "guru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "af1637b009cd796aa2976a7f1d04f603851a5647c8b7f802f8d19c144ffa6567",
      "text": "Sedikit! Kamu bisa bahasa Indonesia?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b20b140997faa7b1eba6078f0e303337d956b7e60522471ba85a42097549aba3",
      "text": "Nama saya Ratna. Saya guru bahasa Arab!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b244660b3ccbbcec5df5b6a93758e7c6208009600a2560eda6ee0b2ead815377",
      "text": "Saya mahasiswa.",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4c14a3776f9624399f1ddcfb50d5c34fc741d227e91200470e2746e521a8795",
      "text": "bahasa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b514898652625f6cff472ac71fa7ddfa79873360e3da7bdfae6c2f841ebd5990",
      "text": "Bahasa Arab? Salam kenal, Bu Ratna!",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6bf7b753f17c1a6859ff706e2d4e10d12d31358537725cabc8da0ae013938e8",
