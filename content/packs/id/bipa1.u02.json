  "language": "id",
  "unit": "bipa1.u02",
  "version": 1,
  "content_hash": "9bc43bb5d00bfa689334decb44e73d0f0f5c776e2f3496451bae9161355a3628",
  "lessons": [
    {
      "id": "bipa1.u02.l01",
      "sha256": "2ea1b4ca94f6b210e67e29bf01971c27620a377c1eae10ffd01665b924df3c95"
    },
    {
      "id": "bipa1.u02.l02",
      "sha256": "2cdbc14908a63213e98066d8ca920aaf7a7442c3d5942f57287855d99497d444"
    },
    {
      "id": "bipa1.u02.l03",
      "sha256": "61e9e0fd4552c87f92a426c0b4e3b3e4fe7b35917f330eeac5a421808d9757b7"
    },
    {
      "id": "bipa1.u02.l04",
      "sha256": "86396a9b35a30a625f22e5b24d1e8494acdc36749b5547747e4aecb20b56a6db"
    },
    {
      "id": "bipa1.u02.l05",
      "sha256": "7a68ff4e25154705e8fabf2822b7ef5e22519a21bb760cc26ff404631a35dffa"
    }
  ],
  "audio": [
    {
      "key": "07465569ccb017a595e4089409695622a789d1f6e0414db4be8a2f7bfd5b8077",
      "text": "Permisi, Pak. Pak Budi di mana?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c415bb5a03c63946ee6b9291256f33c0306c9103ec3d64f55798e844a3a188e",
      "text": "Dia siapa? — Dia Dimas.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "106a34267f30fe18cae11dcf874db1137e6e9312c4dd2ad194f9b5b4ea03004b",
      "text": "Selamat siang, Pak! Bapak mau apa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "14561b68b7a1ae0b31d47c0ddfa846ba0b028fed267c59861143eabe14e0dc8b",
      "text": "Kewarganegaraan: ...",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "14b9690ce7809f957b8977f0e52f89cfc9341ee68d97767190bddde2cc709cf6",
      "text": "orang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1552b1e258d988766b61e65fb8fdd951f125888fee4c8b129f1e08227205a1ab",
      "text": "Nama kamu siapa?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "15fccc8b71ead61d146da79242a4f2717c8a05e4bf3b3db6c03eccf4f89eac17",
      "text": "Aku dari Mesir, dari Kairo. Kamu?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "16e5baf15f8b4c8a2e952b5569d6583db18f24196f9277413c47243c460e7ef8",
      "text": "tanggal lahir",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "183973daca7ee2b647e77cefb2458ae5bbfa28e0bc9812ac546c861eb743112b",
      "text": "Dia Rina. Rina juga mahasiswa.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b99aa6eeb2673d3d32a0a2444116db3093a473c3532b511a88e7fef7caf6d2d",
      "text": "Pak Budi guru.",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c31ca8f9807257bcdc66ebb2850a39b67f4f52da5787d43796f61c18cafe5aa",
      "text": "Terima kasih, Kak!",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c75a49ba0bf3bf750495e1d8e190d9623434e6fe0259ff5d4ca260ed0e2784a",
      "text": "kewarganegaraan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "20321513bfc2f2399d50c0d76d916508922d0e8e5d88f2f290ca772c61c6ee04",
      "text": "pekerjaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "220803a1a9f8eab403d68af17618f4454ceffdd9f7ec1b3f7f035f385da4616c",
      "text": "Aku orang Bali, tapi aku tinggal di Jakarta.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "22ad4cfea6159d344a8c95697baa62281a2871d18e9fdb329b2f60ac334f989a",
      "text": "Saya orang Mesir, dari Kairo.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2582af7f85ecba77a72d7cb3fd58919660d87e174cbaff2624b3b60217077ea8",
      "text": "Selamat sore, Mas. Mas dari mana?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "25a8917e837170efb9bdb6805207c6490571e82122e4726918151e4c7bfc6d9b",
      "text": "dokter",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d779012a91fad2c1ab8d1ba5aceba8c32d993b5c1a8d5bc5cff15540cce047d",
      "text": "Saya dari Mesir.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "31ec254a8843dc3a4565341f1b831ab1abea1c15be8d6e0259706f092ab1e782",
      "text": "Salam kenal, Mohamed. Saya Dewi. Saya guru.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "339a6a6a940e1bf2cfc9c5774607254d2b568c1bb24fb9379789c577d8016ad5",
      "text": "di mana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34e34d5788157a00b8598268254fc3fdf7868ca9310fce0dda4d922a9e9c3231",
      "text": "Baik, Pak!",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "357ff4eab12b9eb7d759286826ec9622feef727387edd18d2a772528bc85b1ca",
      "text": "Saya orang Mesir.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa21ae9fd8ce79846d746a8249f5da0e76ab845b2b00a4ef7ebc6deaaaae454",
      "text": "tapi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3afde4f4cb8454081b9428add0e17645ac5b92cf719d7b3165af5db11f1a6ca0",
      "text": "Kak",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e086717cbc725ff75038ae7bda71232c896c6486331983e5c5268d8a6d15705",
      "text": "Nama saya Mohamed.",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "40864ca8eba292368ac3650dedf8fdcac1b2fef5263cdf1b164d70c5b610e099",
      "text": "Anda dari mana? — Saya dari Mesir.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4672d2a2e30ac091d7321ecbbb3c81d3d8775a09442e386a2243c895801d2fb5",
      "text": "Dik",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "47300079c9f2bd53c4b22a0966d11fa8de675fca7f1344b6751273e8100d8a6c",
      "text": "kursus",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "49b7d471bd0e979909b0f0a916a6a1b0359101e2e850aff0df9f726af9df245f",
      "text": "Nama saya Mohamed. Saya orang Mesir. Saya mahasiswa. Saya tinggal di Menteng.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b367e34d1353f9bf984287e446800340c69322f03461842b375683f60d361ab",
      "text": "kopi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b5031ce952fc11dfe3123e7c111110c99e66d3205348048f9e03492b185878a",
      "text": "Bapak dari mana?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b8c71a4f8f6b356e51001efaeef33e44a26b9898c053a39c62a92634fbb5179",
      "text": "Rina mahasiswa, Dimas karyawan.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d483ec66db5c0639d03bb1a956b8b6e59fb6443118a241292a0de6412f0da45",
      "text": "mahasiswa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e498a1b0748f4706f8cc6a77b6162bab8a638268e2d86ef3068010a0ece3075",
      "text": "Siapa nama Anda? Anda dari mana?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5210ee8440d1266c6731eb851f55e0acc694471f012ba3029ae817b111ed2c1b",
      "text": "Kamu bisa bahasa Arab?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "564c215afe68883bd83cb0828c02b06ced2c2dc7eba233942dac1e8544e835e8",
      "text": "minta",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a0217c96773c97d902cf40e6a2a3c525988b409ee39b9bbb518cc188e09e739",
      "text": "Ni Luh orang Bali, tapi dia tinggal di Jakarta.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ac740a5ddcf2097eda2e01ec7c81c17ec0f25867e9bb7f29e00304b02ff6a25",
      "text": "Saya orang Mesir. Saya bisa bahasa Arab dan bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c360eeb4c79ce589ddce9418cdf536fbc85d6d95d8591341f68206f10a75430",
      "text": "Sore, Bu. Saya dari Mesir.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f846de732b7e9d0c41df6345d52238466539c99964c8e39a2c13957225fe687",
      "text": "Rina orang Indonesia.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "65b1c1b81209f4e5fb3ad79d2866c29ebb249588a0adcf9ee1848e0c29308bb2",
      "text": "air putih",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "670e695ad5f0960d591c08a77a31de1dd3034a45d81113b921079d2eaa016d83",
      "text": "mana",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a07bd9950735d66aa8632ae2ff2ff2d166c790b0bc0e5539a3c20e7fa670e3f",
      "text": "Selamat pagi, Bu Sari!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cefe0a8d90173d60d45c70b1b452895eed0b2a3a8ac70946a05ada5784c11a3",
      "text": "karyawan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "71201510c005da0afa08d75cdef30a869f2075b5e82d4768190c34a348a6f5dd",
      "text": "ke mana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "72bb6851a02ec02e75d878cd6c84eac15fbf34895f74b78246c1c4953499c1be",
      "text": "Kamu tinggal di mana? — Di Menteng.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6318b66d48f402477811142ef837db9e966e53fc7cb8197cc06231fef61461",
      "text": "teh",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b66da06f862a717b46435683fc818da8a9243166beca4d12a259046db5dc0e8",
      "text": "alamat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7beaa427df9eab919c7bf515b737b12f427cd4cfe9eac5629deb9cab11625ad6",
      "text": "Nama saya Mohamed.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f4be6c9d81eb240be1de31e0db50fa8bf9ac16394f8bbbe817b8fd02ec5b9b8",
      "text": "Saya tinggal di Menteng.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "801545f1656271b66ad77c2d4787ecf7e67b6d862c6808404fc33437d6c9fd08",
      "text": "tinggal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "83a5e45a47ef8e6a7e12c0d66cb1e3fe24838e2234d8583281ca410c010f83c2",
      "text": "adalah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "86cb4d0031926540b86e74ee3d9833272986b526efe04ebe7ef017f1f1b4bb0f",
      "text": "daftar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "87c2be6eb8e54415b6e607e2a94933268b354f79323fcbf17683cc9851cdef61",
      "text": "formulir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8982a93c61844e9c4bb2516682cf9cdbb7ca40987bc0fe50ef27b8207f663092",
      "text": "Siapa nama Anda?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8deffe63415c543185c1607704554766d070acfb4397ff73b09d8cd078e34ad7",
      "text": "bisa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9061a2ce4ddf54280437f25d417e8c073e14d0138a8eb972bbb448254db6815b",
      "text": "Ya, sedikit. Aku juga bisa bahasa Inggris.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9892d672e5841a5a5b27eb29a77dca848206249f86573dfabf513152a550d815",
      "text": "Saya mahasiswa. Saya bisa bahasa Arab dan bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9959def67b80f7ee8c6cc70f159ec0d643fdeb855caf264ad01fdb07fc17e507",
      "text": "Saya bisa bahasa Indonesia sedikit.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9974bad592595fca3f6837ed132befacfc3da12befb84aa11fe7df98e59c6901",
      "text": "nama",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7bf79359e0992aa188578f09fbbf2e18c0a1d3f7ffc0a4ef0a4421144674dc",
      "text": "Mas dari mana?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a83c14fe65bc30d4cc8e99365027c2c8bbeb5d7b98184717fb7317b5e89abe2",
      "text": "Alamat Bapak di mana?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a9240d35f8e79bb4bb4d974026a735f093bfbb07e8b8b39db141389c2f96a7e",
      "text": "Baik. Siapa nama Bapak?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c4885be5682e7d872cd59698a1c01d14e71c1bb90664ade0c472e1a765dec01",
      "text": "Mbak",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d8ffba9006e14fc40f121673b82aad774a0fd6c0e322a92b807a7dcb0e8f76d",
      "text": "pendaftaran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f5b7ec4e9c436f84942157a02af3b2db3e98ee4b2d4ee03cff4152c95c7aa54",
      "text": "sedikit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fa00c21f0015cd6e31abe1b9f79d85fe3621ba76cf28fa78fac0ac35ee98601",
      "text": "Selamat pagi. Nama saya Mohamed. Saya mahasiswa.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a08935bd0c25ab52268b364552d3b2137830427267264c3a0be9f1f2c301db3a",
      "text": "Mbak, minta air putih, ya.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a258b22f73ffcba7764b223a3588f4f3dcb53a225f5d91f4d235b82bd236ddec",
      "text": "Nama saya Mohamed. Nama Ibu siapa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab5f5f997e8270d7f3fdc2b13feeec3d695867ab46b1cc3d7b75310269cdbaee",
      "text": "Saya Rina.",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac073e2f106cf3c22bae17578745a3aa513cbe41f0eb869ab4773b95da7f5392",
      "text": "Mohamed, kamu dari mana?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac8f1e9a3fc8033b7cb873f3380124b24384c0079dd38854a696abfa53a2465b",
      "text": "dari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae561f94bf330d58016c61edd6762cf9930f53558d7c12a1baba1b3f8c1cabc1",
      "text": "Mas, minta kopi, ya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae6a9307f250d464a4afe6bf5013535a18408df3be8d7e67039546e5a7ab1c7d",
      "text": "guru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "af1637b009cd796aa2976a7f1d04f603851a5647c8b7f802f8d19c144ffa6567",
      "text": "Sedikit! Kamu bisa bahasa Indonesia?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b20b140997faa7b1eba6078f0e303337d956b7e60522471ba85a42097549aba3",
      "text": "Nama saya Ratna. Saya guru bahasa Arab!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b244660b3ccbbcec5df5b6a93758e7c6208009600a2560eda6ee0b2ead815377",
      "text": "Saya mahasiswa.",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4c14a3776f9624399f1ddcfb50d5c34fc741d227e91200470e2746e521a8795",
      "text": "bahasa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b514898652625f6cff472ac71fa7ddfa79873360e3da7bdfae6c2f841ebd5990",
      "text": "Bahasa Arab? Salam kenal, Bu Ratna!",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b66d106828cbbfcdad2e9d422058a740c88ffacf5726f5a8188f6373c6e0c727",
      "text": "Saya dari Kairo",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6bf7b753f17c1a6859ff706e2d4e10d12d31358537725cabc8da0ae013938e8",
      "text": "Indonesia",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b788c477dad60fd795bdd821cbe426e8dc7a5299547584e4a5110f14fbf0248c",
      "text": "Ibu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8c4a0475a0da32efe0ab28fd2570ff9bd716111c4f0b2e6fcb3b7d779e44e70",
      "text": "Mas",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c03a13884f8b96a7ee9211d4890483dec056ff0711e185287fdeca842b8ee4e0",
      "text": "Selamat pagi, Bu. Nama saya Mohamed.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e105a75640cacbf44c1e4214b4b36487b5bf46302502c0ab4a5326e0009a24",
      "text": "Mesir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2b476811b1195942c68826fdf52ae89b05ff4b2b21978a63531cbb5a2707e47",
      "text": "Salam kenal, Bu. Saya mahasiswa.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c79f86b53796fc22c1b81c9b2f444cffe69e821fc5661729f79a988fc91c885d",
      "text": "Baik. Dan Bapak?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4b03b3c1f05a4461b17372340fef425023abb20c02f79cd06d5bff36e99e9c8",
      "text": "Saya bisa bahasa Arab dan bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5e028694d68191f34140182eb2239cc503daec6565c3eb398dd9800bf4e2fa7",
      "text": "Orang Mesir! Siapa nama Mas?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbc68d78d352c6bee2bfc61c73feb9668a21b362a0cdf9943e3b2be058b2fa4c",
      "text": "ibu kota",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd73098b189139066ba90df68a5d0a0874aae1863cbce88864365cf3a6931a6a",
      "text": "Jakarta adalah ibu kota Indonesia.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd79ff4d565bf38f383303f89e41838e1cca5cf7dbcb323ff2cb667bbb906615",
      "text": "dari mana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "decfe6fb31f011d0104e7cc8c871e0c7f64337460348fdf8c9524bb53a8eaff5",
      "text": "Ibu mau kopi?",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07f62682fe6e33f22e8d0ae34191c58a1c53846656548cfef3f3c4c60ea8989",
      "text": "Mbak, minta teh, ya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e18986c1242b2400871c4d9da15d332474a1dd3d010f6c0dc83968a858130d1e",
      "text": "Pagi, Mbak. Ya, saya mau daftar kursus bahasa Indonesia.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35df361d8239986f04fa534d9d8c520144fa29b4409a840538c329fbda5506d",
      "text": "Inggris",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3bc9f969fc26fc21422d8aae3a649e2f2c492928435b68d02210dd4754e003c",
      "text": "mau",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "e457b8941ca60dcdfe2014b43c84aa1572fa7304758c7809c67bc2942812314e",
      "text": "Teh, Mas. Terima kasih.",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6478e0be1c366cca057dd2715d76c84c8c562c9260ae10566ee567969d39997",
      "text": "Arab",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb3fcdcd3239c9a63c8e8edd9c00a7d74b868580152a2fb4a8ea43ebaedf5bb3",
      "text": "Nama saya Dewi. Saya guru. Saya tinggal di Menteng.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec1d378499e7b2a3d47a29a52db8d05fa581c61d7f4d8cdd7c2f2fcd2d3d591e",
      "text": "Bapak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef826dd967b91c155758f4c39b0ea5942190a779d8485a1567031ab3e9211ce4",
      "text": "Siang, Mas. Saya mau kopi, ya.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3aa825ba1659a389882cddebfe535df567723785ef6958c7abf780a9e46d1f2",
      "text": "Dia siapa?",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3ce025d1c26754aef181f715346c6d8249ec669cb96a039855c074f23af6d0a",
      "text": "siapa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f76f2a45ccfb7cd9155bbf2dfce7aa1a86f53b9199e42e7d8e5982767af74638",
      "text": "Saya tinggal di Menteng, Mbak.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7842bde5e0d1476e75ebadcdf16a7ca427280dd6d8d00ed6097a3403a628948",
      "text": "Selamat pagi. Siapa nama Anda?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9082f9f344c6daea8fdb5c6e8579083ea0540ed8ae2c283bbda9d662e57e66e",
      "text": "Pekerjaan Bapak apa?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd41fa74d3b6451ac2552eba8aa9ab237c0f1613c024bceab173cd1e05f625e6",
      "text": "Selamat pagi, Pak. Mau daftar kursus?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe62bd35df79b53bf80f877396c2a8d90a2da0346cb1dd82b2abe0da889276ff",
      "text": "Bapak mau apa?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    }
