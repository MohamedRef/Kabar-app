      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec1d378499e7b2a3d47a29a52db8d05fa581c61d7f4d8cdd7c2f2fcd2d3d591e",
      "text": "Bapak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee8dd6b43e88106ad749077e719016a954b704d72269292d569360cfeba621c3",
      "text": "Ibu mau apa?",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef826dd967b91c155758f4c39b0ea5942190a779d8485a1567031ab3e9211ce4",
      "text": "Siang, Mas. Saya mau kopi, ya.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f15e4153ebb2b96f031ea8005ec4d4f8d88ef7f0551bb9370d3ae3bc38b20e8d",
      "text": "Kamu ke mana?",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2e28c1692fe6bc30cf65f90c72c29f27337099d3da2d78ba348d72ada871a79",
      "text": "Mohamed, kamu orang Mesir?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3aa825ba1659a389882cddebfe535df567723785ef6958c7abf780a9e46d1f2",
      "text": "Dia siapa?",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3ce025d1c26754aef181f715346c6d8249ec669cb96a039855c074f23af6d0a",
      "text": "siapa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f76f2a45ccfb7cd9155bbf2dfce7aa1a86f53b9199e42e7d8e5982767af74638",
      "text": "Saya tinggal di Menteng, Mbak.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7842bde5e0d1476e75ebadcdf16a7ca427280dd6d8d00ed6097a3403a628948",
      "text": "Selamat pagi. Siapa nama Anda?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9082f9f344c6daea8fdb5c6e8579083ea0540ed8ae2c283bbda9d662e57e66e",
      "text": "Pekerjaan Bapak apa?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd41fa74d3b6451ac2552eba8aa9ab237c0f1613c024bceab173cd1e05f625e6",
      "text": "Selamat pagi, Pak. Mau daftar kursus?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
