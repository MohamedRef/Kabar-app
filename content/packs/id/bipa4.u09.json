  "content_hash": "04cd9cf0fdc008b44b8b748650302e151f997b5cce673ca4361efdcb2c69e507",
  "lessons": [
    {
      "id": "bipa4.u09.l01",
      "sha256": "0b0f6b69132f0cc7490b86a96adee0887ecb6d0b8e09936f4010aed3bffa4627"
    },
    {
      "id": "bipa4.u09.l02",
      "sha256": "6d1da3a08e20ffd9f14dbb42690fe50c7546469e52daea52ae71f659d8716e06"
    },
    {
      "id": "bipa4.u09.l03",
      "sha256": "23398bedb394cbfdd037f3c606437bce26a17fe1f7681e5119a8b805b69cdd68"
    },
    {
      "id": "bipa4.u09.l04",
      "sha256": "793f4bbea70c9b8d5f1921e40caa464049432d4425bd211f35af5469f5838f11"
    },
    {
      "id": "bipa4.u09.l05",
      "sha256": "87bc51936b181b26fdff5e809548eef0024dbcecdcd8974ae09564bf456ba098"
    },
    {
      "id": "bipa4.u09.l06",
      "sha256": "e43fdba7c83cc93e0692e5e2011570c9c353dc7d9c4f29fc38f31620f56225de"
    },
    {
      "id": "bipa4.u09.l07",
      "sha256": "a4cc7827ae5b0b06443a33fc69837c1774adc0a9de0fb6a87598506a1e770e26"
    },
    {
      "id": "bipa4.u09.l08",
      "sha256": "f13f815c36c9a2500b8f4100cb7c27a4c101bc205bc78e39c34e6bf898d92e6e"
    }
  ],
  "audio": [
    {
      "key": "01ef55af6f5a004eaa71144253b70329a28450abb29b33ed058431b9debc08f1",
      "text": "Hari ini saya akan membicarakan larangan kantong plastik.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "021150595d334d9a21c7443a15e74479d1fbef618f7cc1cfa6599d92fcb46599",
      "text": "Kami membicarakan kebijakan baru tentang sampah.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "026c0ce6bd6cebbcf9b5a19cc5d1ec98627c8dd7f44d4ca1f79b4b6ebab9380d",
      "text": "suhu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "06437443a85e7bffa6a3e9ad58a6e51290a5c9815f75cd33b8713a22e7e38131",
      "text": "dana",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "08cc16c1208b0278f7fec3af3b5fa9112629087fdb2ba33db1468e6719040797",
      "text": "Akibatnya, sebagian terumbu karang memutih.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a31b97e75830df27939cef63d445237e10d8909b3b4d807345ebda677849db0",
      "text": "Ya, saya dengar. Sebagian karang memutih, kan?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1427649ca9be07ca660f6e28cce52b3c572eac6ec12f53d4226f2661bc75aec9",
      "text": "peneliti",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "149403c2ebe6a4b38f410e54a98206137e9ef960a2f8ef7d7097261666be0566",
      "text": "mata pencaharian",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "195e3f71ca07397254b787dce484338ed713162f6d1851d3a46887b8f5b1e3df",
      "text": "Sudah baca papan pengumuman di pelabuhan?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a42bafa9aa29e02632f4aade7a5878e5a3297e9f0d76eb651209204a2e5ca96",
      "text": "Bagus sekali. Saya senang membayarnya.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b7e1cdaeedc4dfd2e959d093ca479e0644c2cc605c1772afdb4ba419d79d430",
      "text": "Bu, mengapa plastik sekali pakai dilarang?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c074df2ae9b4a61bf092fc2bd27ea2bc45310240db09a87a4154f14d5be9cdc",
      "text": "Karena suhu laut naik. Itu akibat perubahan iklim.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e73b4441be12bf972c4f476f3211874f96154e12e7df56b1f40c07aed077e0e",
      "text": "Apa tesis eksposisimu, Mohamed?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f6c64e87a9d0822e82a84e5a5738af043a2d1167116682badc3711bd8107c96",
      "text": "mengumpulkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "210c074bdbe7a677b886b0b0193906a22bacf51ed27241019ccb973a842b56e1",
      "text": "Berkat larangan itu, laut Bunaken lebih bersih.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "218b22e02510f2b524e8d5574ee862dde028177f71b39a006915dd27c5282101",
      "text": "Kita harus menimbang untung-rugi, karena banyak nelayan bisa kehilangan mata pencaharian.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "21b995a6bf366012428412937b578407c37de0dcd9e6cfd0190bf0ea2746e0b6",
      "text": "Kawasan taman laut ini mengumpulkan dana untuk membersihkan pantai.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "26a63a16a5d8551d79c525a031fbd9105753f3b7d8dc2d5b1d26e497b083cd68",
      "text": "Oleh karena itu, kesadaran warga harus ditingkatkan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bb5eb47d5f29a26ddd71c5e0d20e76fff9dd15b50247aba19048d9a54b7924b",
      "text": "Pertama, plastik sekali pakai sulit didaur ulang. Kedua, banyak sampah plastik masuk ke laut Bunaken dan merusak terumbu karang.",
      "voice": "id_gadis",
      "chars": 128,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dda8ae6cd0da0856d0a2a5945c8ca11795729c8a4a63625f93af59d9e609b29",
      "text": "Plastik sekali pakai sulit didaur ulang sehingga banyak yang masuk ke laut.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "3043ea0112cb450efc7217afa37000ba9f5a141da9bddcf4822099615121f2b9",
      "text": "Saya berpendapat bahwa kebijakan ini wajib diterapkan, karena kesadaran warga masih rendah.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "3616680678060959e68db923af9bb874c9b343e46192eeeb3f64fc52c5a8a0bf",
      "text": "Akibatnya, sebagian terumbu karang memutih. Jika suhu tidak turun, karang itu bisa mati.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "36bee4cd0906d5b6118a063c458466f703c3baa555a316383518d5f1b4cd2c04",
      "text": "Taman laut ini mengumpulkan dana dari biaya masuk penyelam.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d486e57d904499287cd3fb08483acf64d2e7d2dcf1ef251efc4a3ff65f963b3",
      "text": "Lalu, bagaimana dengan mata pencaharian kami?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f74964eb73c5bef4563e8c901c1063c78efce862b3e3545752b074c6d53674d",
      "text": "Para penyelam membersihkan sampah di kawasan Bunaken.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "424c10d2b8e94e4c086592a0b7a6c287574c06f03b3175ee1b22e02731906a6b",
      "text": "Mas, tadi di radio ada laporan tentang suhu laut di Bunaken.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4487b87134305ae9dab23e9b86c53e0aafe6cb700f8a388c52a966f43313a1b1",
      "text": "Sudah. Saya tidak boleh memegang karang, ya?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4716019a211c204601669340845d15f61b96d1a13121c86e1d0fce6886a24923",
      "text": "kenaikan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "482fb9fc6748a2484ceaaca490ddcbf0a564af1ef581ed3686090736f40d0b4b",
      "text": "Pembicara menjelaskan kebijakan baru pemerintah kota.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c2b459d861e31e5ce9227053b81cc380ed8eb1fc278c2196cd0198f8a832bc6",
      "text": "Plastik merusak terumbu karang. Akibatnya, ikan dan wisatawan berkurang.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d76f9e79b41c36c44a6105e34e363f752b41857a70c2a84b609a83e6276533f",
      "text": "Perubahan iklim menyebabkan kenaikan suhu laut.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e9f964f10a451bef9cb24de71dd78a410be624c796de50b896f2cd1f638276c",
      "text": "___ kerja keras warga, pantai itu bersih kembali.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fd53b9711b979d6adc17e50f93d5e704e1d243e76a45be60da2aaaee9209a6b",
      "text": "Larangan ini wajib diterapkan di semua kota.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "537d39e8f64f206d579755191f595a2d8ddbb7d9cd9e8202a5efc4982cf3c6f4",
      "text": "Oleh karena itu, kita semua harus peduli pada lingkungan.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "5448db56837e84a1439404cb98118153db564d7896201d7acf98ec7dbd8da0b1",
      "text": "Saya berpendapat bahwa larangan kantong plastik wajib diterapkan di semua kota.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e7c0bd6345e49d9c9436a384214ba11bd6a78cab0c75e7bf74f125df5b6cac0",
      "text": "Para peneliti melaporkan kenaikan suhu laut.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "617cb0da8a0587d81b1c17db3a7769f0d3a6afed36f792ace72b9eb26d982837",
      "text": "Para nelayan khawatir, karena mata pencaharian mereka terancam.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "62096ae46052c683918c99a5906494a14c1535dd4d8a432b4f233fafd73629d5",
      "text": "Cukup kuat. Dia juga menulis bahwa sebagian pedagang menolak, lalu memberi solusi.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b59824317f793d4d8dd049fe72f1de8dd6800cfad8f39afb3c2e9b9b1a19e6a",
      "text": "menyelamatkan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dafd74720b41dc0e94251a46f5fd1913794d8c1115cfa49a69dd6f254cecb5e",
      "text": "Kesadaran warga tentang sampah plastik masih rendah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ebb7f9e4dc11214a1f1f0107b10b344d71b7d281d3d5ef097729c69176ff659",
      "text": "Kota ini menerapkan kebijakan baru, dan warga mulai mendaur ulang sampah.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b1ab154978d2aade8675c87bb2b96b088c200860045eaf9efa82b51ffec1f71",
      "text": "Para peneliti melaporkan bahwa suhu laut di sekitar Bunaken lebih tinggi dari biasanya.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ee24f6ea8a2bff8019da7c8247056081d2da5aff3a0cefa67e59dd618af7901",
      "text": "___ perubahan iklim, banyak karang memutih.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "801fec99e10820197400da67b250fc33dff68c2b724ad5a265a4e71585241ac0",
      "text": "Hmm, itu solusi yang masuk akal.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "840d75f2599ff2ce7ca966865a836ab9ea2e78092cc7de862f16ee8225acfa9e",
      "text": "Akibatnya, nelayan kehilangan mata pencaharian.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "85826cdb4048dbc4b810c76630428fce6cb9a4f61700d7340a2ce39c05a1cf40",
      "text": "Akibat perubahan iklim, banyak karang memutih.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "89c11afff291c8da790be26944561daecf315461f29b03334cbd2f58db95ee9c",
      "text": "Betul. Karang mudah rusak dan tumbuhnya lambat sekali.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "90d67f2bfd766e8ee64923b5ca52e4ffd297f4905f24306df6f85cfb715ec32c",
      "text": "Taman laut ini mengumpulkan dana untuk menyelamatkan terumbu karang.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "9154267e2db364a8b4c8740ea49508e9221ea6e9d68d56792841b5aff038522f",
      "text": "Argumennya kuat?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "919f979ecc313a73199d36ad543c5c6f8fd573d736c5024dac26725241d6130a",
      "text": "Karena plastik itu sulit didaur ulang, dan banyak yang masuk ke laut Bunaken.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "95026b6b0a5bd1264bffde96c91f1105bdc7182a8de7d5d23d211c4b1815afa8",
      "text": "Suhu laut naik sehingga karang memutih.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9880895c40002ff61b7b053ad68ed57966f5020e97b8530bfbafc77479df7622",
      "text": "Saya berpendapat bahwa larangan kantong plastik adalah kebijakan yang tepat untuk Manado.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "98b5f00e2f2bf0879c810fa44d5b0486bced6f78d96744444375565d8277d17b",
      "text": "Betul. Kata peneliti, kalau suhu tidak turun, karang itu bisa mati.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b374ad409d85f8f7ef31cf5506e317b075f68e3039c2de24bdff6eb7b2343b1",
      "text": "Dilarang memegang karang, memberi makan ikan, dan membuang sampah ke laut.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bf8a1adc5534e456cba620e4352cb5069fc1881024e3fa3c847ea73dfa29a50",
      "text": "taman laut",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d9c79b675d567c3cede11063f6bc571e46a435d417f3d5cd4ee770cacec4119",
      "text": "Saya berpendapat bahwa larangan kantong plastik wajib diterapkan di Manado.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f4d60d17b34f896e8902e147fa0eb282c59a2bd8caab05fcf564000eed88f28",
      "text": "Sebelum menyelam, setiap penyelam membayar biaya masuk taman laut.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fee87be57a17d0c10a1130d123065f1272b0daf83ffe6e5ed543d94b98138dc",
      "text": "Dilarang membuang sampah ke laut.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0978eb92604137c0c97c78e1772df4c774505bade220ab376b9dade394ac752",
      "text": "Memang, sebagian pedagang menolak. Namun, solusinya mudah, yaitu kita membawa tas belanja sendiri.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "a240dde064688f56d71f04491a27ecfa891a92e0385232e62a00296acddde040",
      "text": "Banyak yang kehilangan mata pencaharian. Oleh karena itu, pemerintah harus menimbang untung-rugi setiap kebijakan.",
      "voice": "id_ardi",
      "chars": 114,
      "mime": "audio/mpeg"
    },
    {
      "key": "a39ade7a8d5b6392526d055b1be72a36f5385897b5b4b2699ba141bd9fc30c1c",
      "text": "kawasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6697efe5eabf73fa57671258863e373552902b56081cad103aacc1494b3297f",
      "text": "Dana dari biaya masuk digunakan untuk menjaga kawasan ini dan menyelamatkan terumbu karang.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "a813d37c0611249386e0fe11d84d07d7cf15000e00ddb46eb17da8ac2e7a1caa",
      "text": "Bagus. Dan solusinya?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8330e2e1a334d6e0c6861a52cf29ad6b7fc25d766a0d6b26e79ac452920a440",
      "text": "Larangan memancing di kawasan ini merugikan nelayan.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85d678a7740f35f1d9ebd43f7b5f397a428bb774292e9499bd4f405e50b101b",
      "text": "untung-rugi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aab50b669feb07e6f878268cfee66c2d252852a4ff3fc665bd42e527b18e901b",
      "text": "Selamat pagi. Hari ini saya akan membicarakan larangan kantong plastik.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "abad06e9d367cf6aced5c2527f55f858179fe7f4909cdc2f339962003164a5aa",
      "text": "Kita harus meningkatkan kesadaran warga dan membawa tas belanja sendiri.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "b135c71755b5446d969e04f73dd686349e066b841aab58a057e4837cf083cfb4",
      "text": "Lalu, bagaimana dengan nelayan di sini?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b305d941ff22f1efcb0f2b71a5e6812fad1e41695a4e55c78cf94cf2895bbfb9",
      "text": "Terima kasih. Dana ini untuk menjaga kawasan Bunaken.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b497e54d78d6c6575511d39a6f093bee6e81988f13a8a0aeee65e62d30581e75",
      "text": "sekali pakai",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b98a080f9eb8d2f9d33a2c911caa346b3b74717ec1c1bf09d7e947d979fc6abe",
      "text": "Apa argumenmu?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb85a779f58c4dca7abb002416eb8d72da07e4c578502c6f68eca5a1f473bc0d",
      "text": "mendaur ulang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbb3d5c3286a65fa60b0becacee43a1e039346169b6f2b035aeedd6f65da7051",
      "text": "Bagus. Eksposisi yang baik memang melihat dua sisi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "be233bdaa0163a7d3478a300eb2a6d2dc96664b95bf6f81b82cc7b0de2ff650d",
      "text": "Dana dari penyelam bisa digunakan untuk membuka lapangan kerja baru bagi nelayan.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf62c0cbb67eb7e0663e3ae81c061bce4edb8cb4735511690b26f3fe6e104f0b",
      "text": "Untuk apa dana itu, Kak?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c66ab5fa5a31e5b6e365374064eda766782f6c8bdd7ea5d627302f526a5e2676",
      "text": "Baik, Kak. Ini biaya masuk saya.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6edc86a2e9ef4484aaa190a090b103cdf64187852b5e252dd90950cebc21941",
      "text": "Sudah, Bu. Penulisnya mendukung larangan kantong plastik.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f4f75847609d279a35fd8b1870cb104f35249392a22c814540d072771436ee",
      "text": "Jadi kota ini akan menerapkan kebijakan baru?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc5cff163986df07aa89a10986184fe678fb320cc4913f2f6f9f3156a5cd11e7",
      "text": "larangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d039ad1584f118dff9cfcfd9c84cc84c994932523c748abd19c9af5f5a216b12",
      "text": "Kasihan nelayan di sini. Mata pencaharian mereka terancam.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d610c31a6a3fbdd1edad867d49390118ab126ae12aa67faf21c80e907c79557a",
      "text": "Saya mengerti, Pak. Tetapi berkat larangan itu, ikan di Bunaken bertambah banyak.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "d65ce7950371516031d8504dc5a88455cd7845e023004cc4bd759dc478d9bacc",
      "text": "Selamat datang di Taman Nasional Bunaken. Setiap penyelam wajib membayar biaya masuk.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddd6164ea36e661089f341c4f4487e2d5e8a302fefba19c1f35ea2d52a39403d",
      "text": "Mohamed, kamu sudah baca opini warga di koran hari ini?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e213d71bfed5cc724687a953805287a2d94f93e43c2d6626ecbd149c037f62f5",
      "text": "Kita harus menyelamatkan terumbu karang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4cc17f57c2e03898df9fffe3ab1eee2933e230ad226a4f330dce421430df14b",
      "text": "Saya berpendapat bahwa kesadaran warga adalah solusi terbaik.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fd8aa43bc2233d86952efeb9de7ab15e2a401c9d3826143f313f0e0fa1782d",
      "text": "terancam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6699a959b090babd19011bdbf96fa2bffb871c8b99164996dc50f9cf5246e22",
      "text": "Plastik sekali pakai sulit didaur ulang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc6305944610dd84cafc3d113a22b595bc62f9576148a0a42d244a3ebaaa227",
      "text": "Mas, kenapa sebagian karang di sini berwarna putih?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee08aa080efa0ff5749ac1f8d69efbbd8a74841bc074b8a95ee9a718ea1c64ac",
      "text": "kesadaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef0bc4e0aa7f610a0eae1bb606d89cb21cef62dbbdbe6e4e67f322b315146466",
      "text": "iklim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f66ebaf2e6bf6b1118a49e84ea4f443f246b3be94f286f16c289668d1dfb6561",
      "text": "Banyak kota sudah menerapkan larangan kantong plastik.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa89ed4a3e3d8b7d275059b622ba78a9591dc050ded9b2ca5079d6185960f30b",
      "text": "penyelam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fae2bd997d14778eaec143296072899d72a1f7e54056c826768cdaf62357808e",
      "text": "Untuk menjaga kawasan ini dan menyelamatkan terumbu karang.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc01777abeed8213768a4694e20376fc949592d30bb1dbad2168e65e0c194aed",
      "text": "menerapkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    }
  ],
