    },
    {
      "id": "bipa4.u09.l03",
      "sha256": "ed73949f73ad2e3acfc0f805bbf09c639130fedb639486914e80cfb26ba5058e"
    },
    {
      "id": "bipa4.u09.l04",
      "sha256": "f00e4cd5515873ee45cc5064467a28bd02651d04a5dd3895595831f5f4846cb6"
    },
    {
      "id": "bipa4.u09.l05",
      "sha256": "8a802311d586a944d3ae094809021205664c1937c8dde4e267f6bae388d549c0"
    },
    {
      "id": "bipa4.u09.l06",
      "sha256": "b34d19649b74b06efe1d5df56f2f3a9e18f4cea8ac0d8d0f4d9ff8973849db1e"
    },
    {
      "id": "bipa4.u09.l07",
      "sha256": "ecdea5927b413e9dc6f346251ee15b33df0e7138516428002ccda079961995eb"
    },
    {
      "id": "bipa4.u09.l08",
      "sha256": "c88b72ecbacb8cbef8e6525105fcf073ff100eb8120ca9ef7aa5183a0d6bbb31"
    },
    {
      "id": "bipa4.u09.l09",
      "sha256": "e34f6b9ab9c4735f498aff8c481c573912281b4296e46c945781b777a44a8218"
    },
    {
      "id": "bipa4.u09.l10",
      "sha256": "8c69a0b33f67ea112c7cd6b0704b55bf3ef03c50b2f97e17719a642246031e1d"
    },
    {
      "id": "bipa4.u09.l11",
      "sha256": "c8f3b45e19771995502bd7f5c8f5e9e172a275c7d42d74dcddfc626e5a842a92"
    },
    {
      "id": "bipa4.u09.l12",
      "sha256": "0f0173f43dddb185b8dcc3ab0cb8572d633355d86fd3740351ef648958603281"
    }
  ],
  "audio": [
    {
      "key": "01ef55af6f5a004eaa71144253b70329a28450abb29b33ed058431b9debc08f1",
      "text": "Hari ini saya akan membicarakan larangan kantong plastik.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "021150595d334d9a21c7443a15e74479d1fbef618f7cc1cfa6599d92fcb46599",
      "text": "Kami membicarakan kebijakan baru tentang sampah.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "026c0ce6bd6cebbcf9b5a19cc5d1ec98627c8dd7f44d4ca1f79b4b6ebab9380d",
      "text": "suhu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e40838dbe9acc8e9b4cdbaf6c7b2f760c5484aa906c8e6c0fa2dba00988bf5",
      "text": "Petani itu memberi makan ternaknya dengan rumput dari ladang.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "06437443a85e7bffa6a3e9ad58a6e51290a5c9815f75cd33b8713a22e7e38131",
      "text": "dana",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "08cc16c1208b0278f7fec3af3b5fa9112629087fdb2ba33db1468e6719040797",
      "text": "Akibatnya, sebagian terumbu karang memutih.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ee61964ae500738ca3e80fb79b1b0d1cc583a8c68cf28a4134356f168542232",
      "text": "populasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "108cf4458ef08cbbf54acaaf96ade2b90747d81b846ce8a6312652faeecbea9e",
      "text": "Bener. Kata nelayan, dulu banyak hiu di sini. Sekarang populasinya kecil banget.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "1427649ca9be07ca660f6e28cce52b3c572eac6ec12f53d4226f2661bc75aec9",
      "text": "peneliti",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "149403c2ebe6a4b38f410e54a98206137e9ef960a2f8ef7d7097261666be0566",
      "text": "mata pencaharian",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "15a3392d9551ad11b1398b939fba94ceb2cd3620cc83c170f7f871fe33ef8538",
      "text": "Keluarga Pak Johan punya peternakan sapi.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a42bafa9aa29e02632f4aade7a5878e5a3297e9f0d76eb651209204a2e5ca96",
      "text": "Bagus sekali. Saya senang membayarnya.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ae3a237805a2bf83dc5f8fbee45d7f390ead87f4abf3ac74b9482744dd1ae04",
      "text": "Bener. Karang gampang rusak dan tumbuhnya lambat banget.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b2fc83dc68d9e3c338eb0d2eabf43edb74abb4a9869df9fd2d761dd6153518a",
      "text": "Ada hubungan antara sampah plastik dan karang yang rusak.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b7e1cdaeedc4dfd2e959d093ca479e0644c2cc605c1772afdb4ba419d79d430",
      "text": "Bu, mengapa plastik sekali pakai dilarang?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c074df2ae9b4a61bf092fc2bd27ea2bc45310240db09a87a4154f14d5be9cdc",
      "text": "Karena suhu laut naik. Itu akibat perubahan iklim.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1db0174a9de1bcbd1b6a93805312668d0d39eef217531c288f7c3f510441fd7f",
      "text": "Cacing membuat tanah subur.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f6c64e87a9d0822e82a84e5a5738af043a2d1167116682badc3711bd8107c96",
      "text": "mengumpulkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "210c074bdbe7a677b886b0b0193906a22bacf51ed27241019ccb973a842b56e1",
      "text": "Berkat larangan itu, laut Bunaken lebih bersih.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2178f0d8c72f4fec58b475f352d24645c9cad2c8ebc3ebdf9589d3a681b6e2a9",
      "text": "Air sumur itu bersih, tapi banyak semut di dapur.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "218b22e02510f2b524e8d5574ee862dde028177f71b39a006915dd27c5282101",
      "text": "Kita harus menimbang untung-rugi, karena banyak nelayan bisa kehilangan mata pencaharian.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "21b995a6bf366012428412937b578407c37de0dcd9e6cfd0190bf0ea2746e0b6",
      "text": "Kawasan taman laut ini mengumpulkan dana untuk membersihkan pantai.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "235d1d820779cc8ef44c3b47836d02da6b37a200660edef1c5f1175adf7cae56",
      "text": "Ikan perlu oksigen di dalam air.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "23928817f136d3834010eeb053172bd35294ef0f48e74395079a5d7af3675492",
      "text": "Populasi hiu di laut makin kecil.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "26502e118f132c17e3c04fbdeebe21a4d851e73ca7d28b9690cb9f04ef57ad6f",
      "text": "Bener. Kata peneliti, kalau suhunya nggak turun, karang itu bisa mati.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "26a63a16a5d8551d79c525a031fbd9105753f3b7d8dc2d5b1d26e497b083cd68",
      "text": "Oleh karena itu, kesadaran warga harus ditingkatkan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2966d43bf850d34e7ae03a6cf76bdbf044e2e2aa1d0eaed64c59c3f55b6acb62",
      "text": "Itu ada kotak kayu. Buat apa, Bu?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "298a2cb46c1aa16c234b56d4e52ac5ff76502f4ac66babe05fc18c493a49ef8f",
      "text": "Makanya kita semua harus peduli sama lingkungan.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "2af54fd52939e6519a715ebf35429bd45eeeba57b229fb0b10a507b69296671e",
      "text": "Terus, nelayan di sini gimana?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bb5eb47d5f29a26ddd71c5e0d20e76fff9dd15b50247aba19048d9a54b7924b",
      "text": "Pertama, plastik sekali pakai sulit didaur ulang. Kedua, banyak sampah plastik masuk ke laut Bunaken dan merusak terumbu karang.",
      "voice": "id_gadis",
      "chars": 128,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dfbc09b40034b30014740eae01f3b40a1090f82bd6914253f31537622acca1b",
      "text": "Kebanyakan ikan hanya ada di tempat tertentu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "30284c795cfaf489e993b629694446603db73fe749aafd75864148483891bc04",
      "text": "Tanpa pupuk kimia? Kok tumbuhannya bisa subur?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3043ea0112cb450efc7217afa37000ba9f5a141da9bddcf4822099615121f2b9",
      "text": "Saya berpendapat bahwa kebijakan ini wajib diterapkan, karena kesadaran warga masih rendah.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "3052f3d720831fe36b64ec25ca975e8769e15acf5f893208d41553fc7ec231bd",
      "text": "organik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "30c7db6716fd77f2708a70b32b450adbee3e46d74edcf84e9e37b2cf579fa424",
      "text": "Larangan memancing di kawasan ini membuat nelayan rugi.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "30f4d1013f45f4e8898e8992d2a1c717bb098465aa924dd09766acb03669e49a",
      "text": "Iya, kecuali di dekat pelabuhan. Di sana airnya kotor.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "31208d42cecd86fc0167626f72f13dd6a3cc9080d2405db2bd28df417ec195c5",
      "text": "Apa tesismu, Mohamed?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "3299643fb7cf3e701b4ee447de6a7443538c3868f0e4445fa4d98bbb1106b807",
      "text": "cacing",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3616680678060959e68db923af9bb874c9b343e46192eeeb3f64fc52c5a8a0bf",
      "text": "Akibatnya, sebagian terumbu karang memutih. Jika suhu tidak turun, karang itu bisa mati.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "36bee4cd0906d5b6118a063c458466f703c3baa555a316383518d5f1b4cd2c04",
      "text": "Taman laut ini mengumpulkan dana dari biaya masuk penyelam.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "385e0cb44f2115d9191c6c9ccbbbb2a1011e44ad28530a6cbca83306ae0ffc52",
      "text": "Air di teluk ini kekurangan oksigen.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c787cab6143ca833c989a9159bd4029f03bd75c78ea576e3d3096d53cb89af3",
      "text": "program",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d486e57d904499287cd3fb08483acf64d2e7d2dcf1ef251efc4a3ff65f963b3",
      "text": "Lalu, bagaimana dengan mata pencaharian kami?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e7f3b4cfba2e28cb84dc19338ce474dfe9d2293278139d98b87f0502b6e3f04",
      "text": "Dari pembuangan limbah di daratan. Ada zat kimia dari pabrik.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f74964eb73c5bef4563e8c901c1063c78efce862b3e3545752b074c6d53674d",
      "text": "Para penyelam membersihkan sampah di kawasan Bunaken.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f7ff512f90eb73126b9436cbe9afdc8d9acb6c9a56624b6c76c23166594be1d",
      "text": "teluk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fa915cbea6d00e05fbb9a12c04158822e772a9d3b3668d811cf87141335c7f9",
      "text": "pengendalian",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "424c10d2b8e94e4c086592a0b7a6c287574c06f03b3175ee1b22e02731906a6b",
      "text": "Mas, tadi di radio ada laporan tentang suhu laut di Bunaken.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "42cfe2a37cbe0f9ebfda0b1eb0a3170a989eea147c0b7f4980c0b49799f8d716",
      "text": "Kok bisa? Kotorannya dari mana?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "438c29780f7a259664123a00af159895fb1f5a0eba2dfc0ee515eff021d6ef87",
      "text": "ternak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "43f85f9efcf50a0d9809547db3c3b1db7d261e6e8609813e36b0cc1620cb27d6",
      "text": "Makanya kita harus peduli.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "468dc9e61176041a892af4c03df0c8f641320a3b10cf6b8012d7ac3b7d2acdfd",
      "text": "Semua toko ikut program ini, kecuali dua.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4716019a211c204601669340845d15f61b96d1a13121c86e1d0fce6886a24923",
      "text": "kenaikan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "482fb9fc6748a2484ceaaca490ddcbf0a564af1ef581ed3686090736f40d0b4b",
      "text": "Pembicara menjelaskan kebijakan baru pemerintah kota.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "49f24fe57b81d330f9b372f04d5ec316461efed2a401a90600ae98f35fa59eed",
      "text": "Belum, Bu. Kebanyakan karangnya masih alami?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b74c1fd664fe83263ed9059f5061bb27dc2be29ffaeb67cacc30d281b591173",
      "text": "Mas, kok ada karang di sini yang warnanya putih?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d76f9e79b41c36c44a6105e34e363f752b41857a70c2a84b609a83e6276533f",
      "text": "Perubahan iklim menyebabkan kenaikan suhu laut.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dffc0c794c97202f220bdac28afddcf584e65fb8774e83f9ec6bb3d218415b2",
      "text": "kecuali",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fd53b9711b979d6adc17e50f93d5e704e1d243e76a45be60da2aaaee9209a6b",
      "text": "Larangan ini wajib diterapkan di semua kota.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "542ab2a68fff5aba3cd6c6b3cdee4ed3719937ba901f903952809e8b8cca86ac",
      "text": "Petani ini tidak pakai pupuk kimia. Pupuknya ___.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5448db56837e84a1439404cb98118153db564d7896201d7acf98ec7dbd8da0b1",
      "text": "Saya berpendapat bahwa larangan kantong plastik wajib diterapkan di semua kota.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "57bf7fd0f0e9f129590915ba656ad0d3ba8b1c479910181d082c415d83e69a53",
      "text": "Dari sumur. Listrik di sini belum stabil, jadi kami pakai baterai dan panel surya.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "5842d7c9e0cf25bcdba17ae42a1b87533575ba0ba0293b67f5b016816ba1cefe",
      "text": "tepat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "594fbf5732111c02ab309cba0950b241f1dcaee4ca105570519d5c1a58a12f23",
      "text": "Selamat datang di desa kami, Mohamed. Ini peternakan sapi keluarga saya.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d41416798e3c34ec06a1419770f1c2bc8ef2311462f03596128a03fafbd279e",
      "text": "Dana dari penyelam bisa membuat lapangan kerja baru bagi nelayan.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e7c0bd6345e49d9c9436a384214ba11bd6a78cab0c75e7bf74f125df5b6cac0",
      "text": "Para peneliti melaporkan kenaikan suhu laut.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef94656d0eae88dae756f16ff580e2e4b201fb617bac237cc92fe695cb7af53",
      "text": "Baterai bekas dan barang elektronik jangan dibuang ke sumur.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "617cb0da8a0587d81b1c17db3a7769f0d3a6afed36f792ace72b9eb26d982837",
      "text": "Para nelayan khawatir, karena mata pencaharian mereka terancam.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "62096ae46052c683918c99a5906494a14c1535dd4d8a432b4f233fafd73629d5",
      "text": "Cukup kuat. Dia juga menulis bahwa sebagian pedagang menolak, lalu memberi solusi.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "62c82a5635199c0d3fbfdbe02d70c1bc643d541d80b1091e0acc3abf035fbcc0",
      "text": "pembuangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "641a9d28466630e69187a10285c934a0237779e85fecbdd5ab23bac1ff88f2ee",
      "text": "Populasi ikan di teluk turun karena limbah pabrik.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6671ded1a294c8b06dc846388618ac6e24c8511ba055860632cd8f19b334d476",
      "text": "zat",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "697c1ea9c171297fe91dd514d444b716a78b4712107f0a17466590dd64d39951",
      "text": "Udah baca papan pengumuman di pelabuhan?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b59824317f793d4d8dd049fe72f1de8dd6800cfad8f39afb3c2e9b9b1a19e6a",
      "text": "menyelamatkan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bd233508779fde13a71c418995dc1b178cfb722ba655149dbcc2374b4361bc3",
      "text": "mudah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c3dac114af45cd0fdfe1a69072780972d92b5d60e25ea61a2f3bb34a2bf8921",
      "text": "Pabrik itu membuang zat kimia ke teluk.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dafd74720b41dc0e94251a46f5fd1913794d8c1115cfa49a69dd6f254cecb5e",
      "text": "Kesadaran warga tentang sampah plastik masih rendah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ebb7f9e4dc11214a1f1f0107b10b344d71b7d281d3d5ef097729c69176ff659",
      "text": "Kota ini menerapkan kebijakan baru, dan warga mulai mendaur ulang sampah.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f047dfc96484229a097ba6be0030c875dbf75f122d0b0f8e0a51dc0e258fadb",
      "text": "baterai",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "70318026df0d07a63d9228af4ef8a240a2da2d7c9c3f40cda54c982fb64dd6ce",
      "text": "Oke, Kak. Ini biaya masukku.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "704570216ee209e42b765c4936d5860066eb79542c00120598931bb70f856949",
      "text": "Semua warga datang ke kerja bakti, ___ Pak Johan. Dia sakit.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "70ad19f343e738529a4ecac4b6097c65787e97d2f563221c9766c131b8adbbd5",
      "text": "Banyak warga kehilangan pekerjaan karena banjir.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "70fed38c7da294de89a2d2f30dbddff0025a393e268f0bb0c44620069df87295",
      "text": "lalat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7327933f993085a1325ffc7aabee4fa5cf1b3e2a81d09e56c768c7eb3216480a",
      "text": "Hmm, itu solusi yang baik.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "760b97082cc260a3200cd2dd811761682d15d58bfc626f9c2fa7464b3fe6aea8",
      "text": "Saya berpendapat bahwa larangan kantong plastik wajib ada di Manado.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "796a6646793c781c1b5d3dce7bea898984c0b6e0a8a04f4d43dedeee8c21f715",
      "text": "Iya, aku dengar. Sebagian karang memutih, kan?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ab0b1f8ba7c624789cc9c7bc43c57d90886dd1b645201b7656aadef01448a75",
      "text": "jamur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b1ab154978d2aade8675c87bb2b96b088c200860045eaf9efa82b51ffec1f71",
      "text": "Para peneliti melaporkan bahwa suhu laut di sekitar Bunaken lebih tinggi dari biasanya.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d677b367b246be7ef6748dcb8a65c465e031a2bda00142c70a6b9ce2a54418b",
      "text": "___ warga, pantai itu bersih kembali.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e60f0b2a418f45fd78999b73f2242c9dad047bd9a84908c8312aa17ff9f374a",
      "text": "menciptakan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ee24f6ea8a2bff8019da7c8247056081d2da5aff3a0cefa67e59dd618af7901",
      "text": "___ perubahan iklim, banyak karang memutih.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fe96f314d3f63046aea958555a1bfb0ecb04bbfe087e0ec8bad8e2f7b1db581",
      "text": "Banyak lalat di dekat kandang ternak.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "80d060fa89ee77e6944ee34bb7c4e031a51386ed081c44711055bc8c56a9d765",
      "text": "kebanyakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "840d75f2599ff2ce7ca966865a836ab9ea2e78092cc7de862f16ee8225acfa9e",
      "text": "Akibatnya, nelayan kehilangan mata pencaharian.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "84ab9067fba0b3a3ff5af324473b7e5611a222e044090ae24e49eb25e5bc37c8",
      "text": "Barang elektronik juga pakai baterai?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8568bdef302d18db3f801097b3a4a0f7b30ad8e494863c1074d0cd9bd0a9d443",
      "text": "Saya paham, Pak. Tetapi berkat larangan itu, ikan di Bunaken jadi lebih banyak.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "85826cdb4048dbc4b810c76630428fce6cb9a4f61700d7340a2ce39c05a1cf40",
      "text": "Akibat perubahan iklim, banyak karang memutih.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8589654294529b3e9a19e5367dcd815da50717227472a63b851ce91d204a01e0",
      "text": "tertentu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "85ba7d93ebbb0590960064d75e44a01d8e6b05851a7569c1390ca84a85b4749e",
      "text": "elektronik",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8848e1dac6712c783306d843cf604d129281d22929f854be105be0a4712e86a6",
      "text": "Mohamed, kamu tahu berapa jenis karang di Bunaken?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "89fa43845f9b7195f4554c523d95585b421ac05846e3841d3609ad19e15ce75a",
      "text": "sekitar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9154267e2db364a8b4c8740ea49508e9221ea6e9d68d56792841b5aff038522f",
      "text": "Argumennya kuat?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "919f979ecc313a73199d36ad543c5c6f8fd573d736c5024dac26725241d6130a",
      "text": "Karena plastik itu sulit didaur ulang, dan banyak yang masuk ke laut Bunaken.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f40a4a5cce3942da21be03277ef64fd724b0737fae43ba68ffbfc3d7897905",
      "text": "tumbuhan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "95026b6b0a5bd1264bffde96c91f1105bdc7182a8de7d5d23d211c4b1815afa8",
      "text": "Suhu laut naik sehingga karang memutih.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "967c7c1e20f0cd4d90582a802aa86482a19d44c75f0dde5b04be21a3e698b901",
      "text": "sumur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "96e0182156c088b78fb573557495948c1b1ac5e2de6191adf026d6bc6142823c",
      "text": "Plastik merusak terumbu karang. Akibatnya, ikan dan wisatawan jadi sedikit.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "9880895c40002ff61b7b053ad68ed57966f5020e97b8530bfbafc77479df7622",
      "text": "Saya berpendapat bahwa larangan kantong plastik adalah kebijakan yang tepat untuk Manado.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c1ca0c2642421688317a9065745f5a00cefd89e140988a645210b68df7bb94",
      "text": "Ada sekitar seratus peneliti di Bunaken.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a15036e6283a8ec3eb868f6f839e536ade8a4689b719fc16982df9603d1e472",
      "text": "alami",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9af146b7f8d92a8df1f86d051493853436740e0f4319517d2306a8175e642ec9",
      "text": "Setelah hujan, jalan ke ladang penuh lumpur.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b0b919adcb78bc1bf91cb1d30e7e6a7aa51dd467fc4b81c7919d1ec5ef49636",
      "text": "daratan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b374ad409d85f8f7ef31cf5506e317b075f68e3039c2de24bdff6eb7b2343b1",
      "text": "Dilarang memegang karang, memberi makan ikan, dan membuang sampah ke laut.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bf8a1adc5534e456cba620e4352cb5069fc1881024e3fa3c847ea73dfa29a50",
      "text": "taman laut",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dab57b6989fc4a2662b634aef1feabe31da119a33abe4d14aab8bbb8d1db09a",
      "text": "peternakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f4d60d17b34f896e8902e147fa0eb282c59a2bd8caab05fcf564000eed88f28",
      "text": "Sebelum menyelam, setiap penyelam membayar biaya masuk taman laut.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fee87be57a17d0c10a1130d123065f1272b0daf83ffe6e5ed543d94b98138dc",
      "text": "Dilarang membuang sampah ke laut.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0978eb92604137c0c97c78e1772df4c774505bade220ab376b9dade394ac752",
      "text": "Memang, sebagian pedagang menolak. Namun, solusinya mudah, yaitu kita membawa tas belanja sendiri.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "a240dde064688f56d71f04491a27ecfa891a92e0385232e62a00296acddde040",
      "text": "Banyak yang kehilangan mata pencaharian. Oleh karena itu, pemerintah harus menimbang untung-rugi setiap kebijakan.",
      "voice": "id_ardi",
      "chars": 114,
      "mime": "audio/mpeg"
    },
    {
      "key": "a39ade7a8d5b6392526d055b1be72a36f5385897b5b4b2699ba141bd9fc30c1c",
      "text": "kawasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6697efe5eabf73fa57671258863e373552902b56081cad103aacc1494b3297f",
      "text": "Dana dari biaya masuk digunakan untuk menjaga kawasan ini dan menyelamatkan terumbu karang.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6ec8f045836fea550c08651c78eca75a55331c1c8dced2dd1def114661d2ef9",
      "text": "Ternaknya banyak! Airnya dari mana, Pak?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a813d37c0611249386e0fe11d84d07d7cf15000e00ddb46eb17da8ac2e7a1caa",
      "text": "Bagus. Dan solusinya?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85d678a7740f35f1d9ebd43f7b5f397a428bb774292e9499bd4f405e50b101b",
      "text": "untung-rugi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aab50b669feb07e6f878268cfee66c2d252852a4ff3fc665bd42e527b18e901b",
      "text": "Selamat pagi. Hari ini saya akan membicarakan larangan kantong plastik.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "abad06e9d367cf6aced5c2527f55f858179fe7f4909cdc2f339962003164a5aa",
      "text": "Kita harus meningkatkan kesadaran warga dan membawa tas belanja sendiri.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac6bb75887d106a1afccea9f36c0658430856ea0eec73f6d90b792d0aa2e5a21",
      "text": "ladang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "accf42f0e18b4ea2e6e05d5c2283d22bb0e70443fb687cd80ffd821e9162f98f",
      "text": "Mohamed, ini kebun keluarga saya di Tomohon. Semuanya organik.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b00759994aca67f773a7d58cd7b4d0ce72795eb55ca7beaf1a2b7c597a32094c",
      "text": "jenis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0a256e145c02374c0636385b90bcc296e5c113b56d4157c105e718ce8ceab8c",
      "text": "Ikannya bisa mati gara-gara kekurangan oksigen.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b27a6e8c6e93bce00dc4509e82dda26ffb5357deb21721909a17b73583e89b8d",
      "text": "Menurut saya, larangan ini kebijakan yang tepat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b497e54d78d6c6575511d39a6f093bee6e81988f13a8a0aeee65e62d30581e75",
      "text": "sekali pakai",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4b4532a498b88e366be48f2c35526e98cf4cf12050569f9197f991195bf7f0c",
      "text": "Rumah lebah! Madu kami dari ladang ini juga.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b89108af1855e09ca7dcdb56ab86f8a21ff718e5eb86e65d6984715e36aecbc1",
      "text": "Kita perlu pengendalian pembuangan zat kimia ke teluk.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b98a080f9eb8d2f9d33a2c911caa346b3b74717ec1c1bf09d7e947d979fc6abe",
      "text": "Apa argumenmu?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b998627c0baa249683a09ca6ff9061db79f6a37bbbc1ea1ddade58f5afdee1c1",
      "text": "Iya. Nah, ayo makan. Nasinya dari beras kami sendiri. Awas, ada lalat!",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9a9ae2dea4b1d9de05365eb1c944b1a9f920473411667132f4902fb567bc9bf",
      "text": "kehilangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba0b4a7043c7174720084de40ef8380aead699a89835c30ec5c99f72fc1969fc",
      "text": "lumpur",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb85a779f58c4dca7abb002416eb8d72da07e4c578502c6f68eca5a1f473bc0d",
      "text": "mendaur ulang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbadd49eba360eb40c577959f02b451d2b390ebb187ba19e821b2a0179725133",
      "text": "hiu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbb3d5c3286a65fa60b0becacee43a1e039346169b6f2b035aeedd6f65da7051",
      "text": "Bagus. Eksposisi yang baik memang melihat dua sisi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc3bc2f5b4b1aef3b3961674a0ac009dfcee2e8a71e6c83989ae6dfdffa3f065",
      "text": "Mohamed, lihat air teluk di sini. Warnanya hitam.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcaf40d4182abe4ebb7dcbc9deb9f2e7ab2c19f0ad29b27e0341406dc5f53b42",
      "text": "Akar pohon itu sangat panjang.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf62c0cbb67eb7e0663e3ae81c061bce4edb8cb4735511690b26f3fe6e104f0b",
      "text": "Untuk apa dana itu, Kak?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf86509b4e0ae94500d4ecb926a8d2727ca5a1b06dd9e02f47f6fb84f8117c1c",
      "text": "Kami pakai kompos. Cacing membuat tanah bagus untuk akar.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "bff25fd1e4b04ea5781aa687cb5cf4889f0f3949c3864c018bec4a10ac12b299",
      "text": "Di Bunaken ada ratusan jenis ikan.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1daed20e4048a1121e6eea5f9ae711fc3ec5d152c7633ca65494211e20f69ab",
      "text": "hubungan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2cc76e44c35fd81e80c699c4ef92a5af4e9511d213e29c2e24f8bbfc93fe507",
      "text": "lebah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6edc86a2e9ef4484aaa190a090b103cdf64187852b5e252dd90950cebc21941",
      "text": "Sudah, Bu. Penulisnya mendukung larangan kantong plastik.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f4f75847609d279a35fd8b1870cb104f35249392a22c814540d072771436ee",
      "text": "Jadi kota ini akan menerapkan kebijakan baru?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb9c837922a2c329fb4dd4b88e6c28232524cc88d5738cf12b2afde47d96ce1c",
      "text": "Makasih. Dana ini buat menjaga kawasan Bunaken.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc5cff163986df07aa89a10986184fe678fb320cc4913f2f6f9f3156a5cd11e7",
      "text": "larangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdf37c930f059306ce9da3a987d1fb0881080cfb59c2e30d1d058477f2fd082d",
      "text": "Pemerintah perlu ___ sampah plastik yang lebih baik.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d039ad1584f118dff9cfcfd9c84cc84c994932523c748abd19c9af5f5a216b12",
      "text": "Kasihan nelayan di sini. Mata pencaharian mereka terancam.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1b485de622b9ab57742aa67dcddfe83bbf21dd9496e8d7c57c842888150b3d1",
      "text": "Kebanyakan petani di sini memakai pupuk alami.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4d8bd3f0b30d23fcf2e8dbdcf962ae8db4e898881ae1b049621d79cb386331c",
      "text": "Sup ini enak karena ada ___ segar dari hutan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5a16db8d686186358bf99ebc3c79414ebeb7c06835332fb9ab96dc56b4b412a",
      "text": "Betul. Karena itu kami menciptakan program bersih laut untuk anak sekolah.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "d65ce7950371516031d8504dc5a88455cd7845e023004cc4bd759dc478d9bacc",
      "text": "Selamat datang di Taman Nasional Bunaken. Setiap penyelam wajib membayar biaya masuk.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b21dab5696a92625fb334487df01e622b96e14db1cbbf71d58876ebdd3651b",
      "text": "Pak Ferry punya sayur organik di ladangnya.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddd6164ea36e661089f341c4f4487e2d5e8a302fefba19c1f35ea2d52a39403d",
      "text": "Mohamed, kamu sudah baca opini warga di koran hari ini?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e03d21e1d502dc4c259d97ec69837c5020fe0e6bdb39d54d602a9b81e47bde26",
      "text": "semut",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0c03e57bbb79b9715995074294359b789c3af88b58dd07d7666665006cab6af",
      "text": "oksigen",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e17b658922bc3992cd04ef10e82b8f45bf3614812cc0b2d53d875ce4a1097cc7",
      "text": "Udah. Aku nggak boleh pegang karang, ya?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e213d71bfed5cc724687a953805287a2d94f93e43c2d6626ecbd149c037f62f5",
      "text": "Kita harus menyelamatkan terumbu karang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e21915a0d4ebf34fac495f834c238ef667c52f8ba428ee3aa8b6121c22b472f3",
      "text": "Kami mengambil air dari sumur.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4cc17f57c2e03898df9fffe3ab1eee2933e230ad226a4f330dce421430df14b",
      "text": "Saya berpendapat bahwa kesadaran warga adalah solusi terbaik.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4eacc3e3d3e2fae546f48700de34ccdeb48d374e4311bfa090d625c569f0607",
      "text": "Hubungan manusia dan alam harus seimbang.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fd8aa43bc2233d86952efeb9de7ab15e2a401c9d3826143f313f0e0fa1782d",
      "text": "terancam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6699a959b090babd19011bdbf96fa2bffb871c8b99164996dc50f9cf5246e22",
      "text": "Plastik sekali pakai sulit didaur ulang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea1f4a65e9be470acc8a892cfcdd0b40dc7aebade2c27451e10addad180c5032",
      "text": "Tumbuhan di ladang organik itu tumbuh tanpa racun.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee08aa080efa0ff5749ac1f8d69efbbd8a74841bc074b8a95ee9a718ea1c64ac",
      "text": "kesadaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef0bc4e0aa7f610a0eae1bb606d89cb21cef62dbbdbe6e4e67f322b315146466",
      "text": "iklim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f31d2afd3f937f00b60b62188b5298b14426608a6a69c3590e9b8e7a55b6680a",
      "text": "Lampu ini pakai baterai, bukan listrik.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3dd17ed06f3eb8cc03c31b98e9fe3229f8890cdc9265750bd1cc5a2050b7c86",
      "text": "Aku nggak boleh pegang karang, ya?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5330a175374f6e0797cbcaf69d0c78b7a28c561037f4ae41efe09ba1727cc7c",
      "text": "Di ladang organik ada cacing, lebah, dan jamur.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "f59bceab6f0c8cbf196fbe7f62fc2fa5d98f607688b28a2890324c5ad0ce57ac",
      "text": "beras",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f66ebaf2e6bf6b1118a49e84ea4f443f246b3be94f286f16c289668d1dfb6561",
      "text": "Banyak kota sudah menerapkan larangan kantong plastik.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f783371ba1e0cc1087efb3949df4692312abbc49d53b89018fd056fd1dc105c0",
      "text": "Jadi ada hubungan antara sampah dan karang yang mati?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8352b4a858583db95f418bcd137edf8fd1b969d4b32231900e865b96dab922a",
      "text": "Toko itu menjual barang ___: televisi, radio, dan ponsel.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa89ed4a3e3d8b7d275059b622ba78a9591dc050ded9b2ca5079d6185960f30b",
      "text": "penyelam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fae2bd997d14778eaec143296072899d72a1f7e54056c826768cdaf62357808e",
      "text": "Untuk menjaga kawasan ini dan menyelamatkan terumbu karang.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc01777abeed8213768a4694e20376fc949592d30bb1dbad2168e65e0c194aed",
      "text": "menerapkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff65fc6fb21fb06c7c26aba74fa18674f425c108a7884b347ffa46e9f7f53ca2",
      "text": "akar",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    }
  ],
