  "content_hash": "0bbd830329d3a6ab854f23be3645befe91dd781103223db0292abb0782b5bf87",
  "lessons": [
    {
      "id": "bipa7.u03.l01",
      "sha256": "b9a63919e00f3028ef806fc4799fe8427db74c667db9d2c81a740e29a1872e5a"
    },
    {
      "id": "bipa7.u03.l02",
      "sha256": "f30082e14dad355719e8c19195c8ece5b98332fc0713566a4589cc1a8a1e1c19"
    },
    {
      "id": "bipa7.u03.l03",
      "sha256": "aa953396d33e7a85fbc114fba842ae03fb0e8a8dacbadc3e2f8967b012c931b6"
    },
    {
      "id": "bipa7.u03.l04",
      "sha256": "9c9772a37e43cfefe5bab3762309a3cedfb710cdd25e75a42ef0137ec4217ce7"
    },
    {
      "id": "bipa7.u03.l05",
      "sha256": "0f589fe09a9cbde898320951761bd8dca7103f15689b46e66a2425fa30bab0a5"
    },
    {
      "id": "bipa7.u03.l06",
      "sha256": "cc3c13d869b17192aca97d632cec9094bdbcdfb8c51c40ac3e59238110d2f63c"
    },
    {
      "id": "bipa7.u03.l07",
      "sha256": "b72a0b80b03d336ea7150f6d701a3d9171f5195c82cfdf55400519384c6a4aa8"
    },
    {
      "id": "bipa7.u03.l08",
      "sha256": "58c27e0496af6ea65b160f9ab4c80e4bce8c7433a3d8fccbe9e3ab5e0cf7882d"
    },
    {
      "id": "bipa7.u03.l09",
      "sha256": "4595b7f1d231c5e07a62723bdcff10f874a7705bd376449bcec0a8035d510613"
    },
    {
      "id": "bipa7.u03.l10",
      "sha256": "1caf60aadf25ce70387dd396f539fc5f96ceb5f677f20300eb51d964b71790ab"
    }
  ],
  "audio": [
    {
      "key": "034c651a39412fb387a312870b22d9f181bcd9247454cbd31c71af09222e2d74",
      "text": "Sekarang giliranmu mendongeng, Nak. Cerita dari Mesir, ya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0536167f68296e3f0bbb6f3218a6b93168519b8eef943519befc0d6f3e5c53d9",
      "text": "keturunan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0890772930987fccb96b5bdff64ef861f08df2f8b47505266d8ca3dde870bcc7",
      "text": "Ke Piaynemo. Kata orang, di sana saya akan mendengar banyak logat.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "09501a226f15d9f4b8d816122432b75fc4b2d813eabb42eaacfec021d8ff3293",
      "text": "hikayat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d454f3fd0d57f0e1b38e1988e5d1ca0b06ea1b9fd4af6841ae69fe3a7373f2c",
      "text": "dongeng",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d6ecdbe6bda38588bf6180a012b8ef0926339a941f7e03abf14a49d7ef87614",
      "text": "Tiba-tiba… jala nelayan itu menarik sebuah botol tua!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d9e31a5d1ed65a7d826655b101dd8ce3ef57231f79a3bc42337602b345b15cf",
      "text": "Jadi ada dua cerita, mitos dan ilmu. Dua-duanya menarik!",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "10125858dcbd4395c7f0320b19238d0e3351a06fc603b5dd1249d5792438b65f",
      "text": "Itu namanya litotes, Nak. Orang Indonesia suka merendah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "104959beef9609bc4799db202a2b715d2298b0cbef2eb37c6a9dbd0ff95e3e96",
      "text": "alkisah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "16d361a95aa8440e7ebab5f895f14e4edcc83a84c1101cf51f7642f62ad580b6",
      "text": "Sudah tiga hari batang hidungnya tidak kelihatan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "17a1944e06eca1e4cafc2c77d5bc3382e66f98beaa5f60d3569f6a58d76e8dd8",
      "text": "Dongeng ini adalah alegori, dan pesan moralnya sederhana.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "195d0e5b8cb5ce562307066632aa64d086e794541e4d94eac56508ef0dec57a1",
      "text": "Dengan akalnya, Kancil menipu buaya-buaya dan menyeberang sungai.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "226b59b055d1b6335ed1c0467260bf7b94981ae612acd018ffa2e13ee78e9f2d",
      "text": "kawah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f18b43c47021b370a50f6b57e5acc17e369752761329f8f670e02174958ddf",
      "text": "Makna yang indah. Di Mesir juga ada mitos tentang asal-usul Sungai Nil.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "24ece4aa73a908bffa8e60e47e209f21dbe12c5249d76a4b1a3d82b3cabfe0f3",
      "text": "kiasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d60d2d5c7efb2a95983acd735981e7a5b1b64cd3131cb01408a23457643532",
      "text": "Dongeng Mesirmu kemarin membuat anak-anak tidak bisa tidur. Mereka minta lanjutannya!",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a651030b5290d01e85169423366ad3ccba3b00d5c55c170591a762003d2068",
      "text": "Sebermula, ada seorang pengembara yang mencari petualangan di negeri jauh.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a66ff9d38dcaaaf056c3bdccebb71a4d7f288ce67cfaca8599b23cd8871ef5d",
      "text": "Mama, mengapa dongeng penyu itu diceritakan berulang-ulang?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c21bb85bb318b8a8c0cb624d51de3d1da19a69c05b7b1915dad5a59705d9c70",
      "text": "Dan buayanya jadi hiu? Tipu dayanya sama?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3048a9ebc133634dd891923685af2c904e2c0f0a11533d13288f4ee4278eeae7",
      "text": "Betul. Itu terjemahan. Kakek saya suka membacakan petualangan Sindbad.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "335f7c4e84013e3156d8b883bc1e8f650367e86dc84702cbba839ba3faecd422",
      "text": "Setiap danau bisa berubah warna karena mineral di dalam air.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "341d20d112aa451b5eead58463a01b281c760fe2e293dee464efb4317996aa3b",
      "text": "Kancil berkata, \"Raja ingin menghitung kalian. Berbarislah!\"",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "34c0e94ef0dd768e7628451ed0a8cc77815e81826dd22bdbeee1cb4224ef88b4",
      "text": "menirukan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "351a87ff59679880a5a7498b6aad3d2386a1f13ec5f2a4822cdca7a778f93c43",
      "text": "Petualangan pengembara itu berakhir di istana raja.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "35d2d42f82a8e369984467dc608e1baac54a531670cfd95d6c46807a8b0ec4cf",
      "text": "Hatta, pengembara itu tiba di sebuah negeri yang jauh.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "393e7e3d8cf24294a05196569eeb1f5fb189af45fa1ebed2eedd3c93f7166944",
      "text": "Pesan moral cerita itu disampaikan lewat kiasan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "4003b4bf9b739a7acd7d973ba8a315a16fd9519ecc4b5ea816f8cfebe6fcc73c",
      "text": "paradoks",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "42353b0bdd53e4de22c1257e773d7949f5b4652d86d987697d339d57f8b709f6",
      "text": "Jadi ini alegori, dan sasi adalah cara menjalankan pesannya.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ae2327597fbdf3ed2efa45d77f864b4ebbfcd7ff23242b391a2bdc4b8439dc",
      "text": "mendongeng",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "439f748dc75a9d8b18d3643246f4a4de262f0e2559779de374a9e69fd954f161",
      "text": "ketegangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "493acfb8c4e0456d8a2823981ac0bc069a4c3e6e0c05bcfeb80a7c8dbe9e5422",
      "text": "Danau tiga warna itu ada di dalam kawah Gunung Kelimutu.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a9a030eefd5ac2710a531c51591eac414fda2ce05e97a8de9876e800197455",
      "text": "Menurut kalian, apa yang terjadi selanjutnya? Kancil takut atau tidak?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a0bc6d6b3c47761558f499ad5006f807a88b1beae7548b28c4398f050abf21b",
      "text": "Kancil adalah tokoh hewan paling terkenal dalam fabel Indonesia.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a70fffaa27e7242e0ae25a649d4e3ccd57a020e72620f4107575a7bd3397ef9",
      "text": "Ketegangan naik pelan-pelan sampai klimaks cerita.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "506e6da9a12de01f825b09ff0e44406b76ab99e88547e5ee3fb63c4cb7397ed9",
      "text": "Di puncak Kelimutu ada tiga kawah, dan setiap kawah berisi danau.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "520736408753a174792ea61b47a829162cd70b7caaf1480b7b363c1f6d61adf6",
      "text": "metonimia",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "540b8086fcf11f42a7534bedd811bde20b152526ce569f429d12d54c362af5d9",
      "text": "tipu daya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "58c81ee8cec5f57a1ae3c19c64cb079e11a883ec2a47fc49a357010c4482ed66",
      "text": "Menurut orang Lio, arwah orang tua beristirahat di danau ini.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5956fd9463f11ca478651a7ceb73333f532ad0784db74c02b51f5b68a78e1666",
      "text": "Lihat foto ini, Mohamed. Adik saya kirim dari Ende. Danau Kelimutu.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "59e7cf1de52a92859bfc6dc367b605b9833a81ad832c6cd494525e2ee56616aa",
      "text": "asal-usul",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d4c00261a3b6f2e814697d4cbed70c143d2eeceeb5c7ae7cc25c9ab51ba9747",
      "text": "\"Hmm… baik… kami… berbaris.\" Lihat, Mama, anak-anak sudah penasaran!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e06e0337afd8508a852a72725a0f216ab02574cba8108bbb2880248c59d67ca",
      "text": "Litotes membuat pembicara terdengar rendah hati.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fafde2dec5fe8d2b93d8f6c4da3a715d4dd4cc19c8d5d2ad17331f98e0c0d71",
      "text": "Apakah orang di sini percaya mereka keturunan raja-raja itu?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "63bd3632c8138b2ee555500bd8804c3520d786d6747aa6c7b9998c4ea2e7b6bb",
      "text": "akal",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "642f0e252d3be8d707d0f9a8f540846bae1b10a97d216807b0eebdec517db4c6",
      "text": "antitesis",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "666db49cbb5b2492bc5fff24f9409156b2dd080778787d14e2609b7ececf90a7",
      "text": "Buaya itu kuat, tetapi Kancil menang karena akal dan tipu dayanya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "66b42abeb059787cc13beec7d034f6cb29252110567fb69a0d422c8fa74666f1",
      "text": "Metonimia memakai nama penulis untuk menyebut bukunya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "66dc9969b561c18844882ea46f0fdd2848964103625818f6005d0137f7d3a580",
      "text": "pesan moral",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "69377d526760b4a454bed57bc852f4d97bedf91b256976aa619326c6d159e685",
      "text": "Pendongeng tua itu selalu memulai ceritanya dengan kata alkisah.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a3a966dcf1f3b97027a4951ab21f019819c3914fcf67891f206f476013b5826",
      "text": "Cerita itu terjadi pada zaman dahulu kala.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aa3ae037a4ccd7dafcd576c7e2e7c0c9f08e884eceeace19dd3e15a7d109b27",
      "text": "Hikayat Amir Hamzah adalah terjemahan dari cerita Persia dan Arab.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c88d05cf7979f6079c23ae8e28b79e401fa51249d01b741ee8f39efd046d06d",
      "text": "mineral",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cb2ffe2772eb8b6bd2176bd18bc5c3a4b2d7f05b30714959f8636ad7b6aaa74",
      "text": "Di Mesir, Sindbad juga terkenal. Pengembara laut yang tidak pernah takut.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "73536f80274a6de54c5babd72beb30cf32dce3a52827205f32f2c19795c10d7e",
      "text": "Pendongeng yang baik tahu kapan harus membangun ketegangan.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "745b4115820ace22e763d04888b4b94b782a4fedfba9c1f55e422b5c9bf0349f",
      "text": "Alkisah, ada seorang nelayan miskin di tepi Sungai Nil…",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "74747e81a05c4a5083e19f4da39ab308a5d5d1d347dda0c9c1ebe1d9843a33ba",
      "text": "Cerita ini sebenarnya alegori tentang hubungan manusia dan alam.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ace788a6ba905882ab2a1f5329d0d46f547ca6c9ec537877aeb08b0cc69e9d",
      "text": "alegori",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "775a4a520e263441d4b00033f0a5bfeb438a8459c57d833b1e8fe29618315e2f",
      "text": "Telur ketujuh tidak menetas, dan itulah asal-usul batu keramat di Kali Raja.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "7851f5302bb82e05c9a38a3c1fea8b7231bd41ed6ded0bb4a421d7bc96cc4727",
      "text": "arwah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a7fdf3d117bb4cd661f2c77b20ae4d4d09a6d3d3f6054d8974584f7e5246b95",
      "text": "Alkisah, Kancil ingin menyeberang sungai. Tetapi sungai itu penuh buaya!",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f3d3df8919ece2995ba24c72f9e7b7e10932bae4a25f40b06ef096373cad22b",
      "text": "litotes",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "81d8ac2ad0a1a521a696f04628d0d3e7dff89d2e0217b3b511946eb935268d0c",
      "text": "Baik, Mama. \"Raja ingin menghitung kalian!\" Begitu suara Kancil?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "82209bf8fd9bfaed75337a2d6f160e2147609605acc5e039159e072e29695356",
      "text": "telur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8292dfc800ebd5b1601ba70f464cc1bde768eef75662b3bd115c2b47cef299ab",
      "text": "Jadi hikayat ini sudah berlayar dari Bagdad sampai Raja Ampat!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "85084b1cffaf1a61b3a1877afad142a87d1f9666e41c5ddbd3c9d70583f3ef86",
      "text": "Satu telur tidak menetas dan menjadi batu yang dihormati.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8550302191410e48c44f1b53a7bf66a00209e90b3df9db7503a353d1bff32263",
      "text": "Anak-anak di sini suka fabel Kancil. Tetapi saya suka menggantinya dengan ikan kecil dari laut kami.",
      "voice": "id_gadis",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "87aad0e3c396ebb85e4125cdc5ec6baa5b79011409d1386b5742078b98ca6f97",
      "text": "tiga warna",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ce3a20c57c76a439ae12a6265c2e9d29d9870e2c2996315df9d8278808aaaea",
      "text": "Empat telur menetas menjadi empat raja.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da2042d2872ef2e9d2f986c1f0ed8d07a0cd1ba4ae722244d9da97501da70f1",
      "text": "Alkisah, di sebuah pulau kecil, hiduplah seorang nelayan yang jujur.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "90ce8ddd85eecbd02f4faac0d461b78efb7852cf59d7e9a95e3039ac36f524d7",
      "text": "Selamat datang di Arborek. Silakan masuk ke gubuk kami yang kecil ini.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "931637652c1d27f5eef4cea09baa0332001393b2ec4bcfebe436e89a3c8ba92b",
      "text": "petualangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ef1f7eb4252019203e91df37d8d7e3231d21a620ea031c6e393a15768d10e0",
      "text": "Dan kalau di grup WhatsApp, \"Eh, dengar cerita seru, nggak?\"",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "95114fdc619bc84ea82b14ae7fac2874cb228477df04818327a003b10afcc2b0",
      "text": "Setiap malam Jumat, Mama Ruth mendongeng untuk anak-anak di dermaga.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "9828f4eac76355c41d4b7bc8f76e6d85e3d1537a7abb963a206f96f255587bc7",
      "text": "Dalam konteks dongeng, kiasan dan paradoks membuat cerita lebih hidup.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "98bec55f7f90adc5d6a85ea247a8c22f82b7472eded516f999b4ae419786037b",
      "text": "menyimbolkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b14aac5b55a68844ebf3d6133309e68c8fb9cc172b7a79be7102791eff54de6",
      "text": "terjemahan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d6fa3b671642ae1f68a7aeacc5b6cd3c636475faebfeaee384975f844eb8c34",
      "text": "sinekdoke",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1edeb2f8d61452425a51f156db55ca71462fc3212d88bd611038aca4a458778",
      "text": "fabel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2c689a05d186c4ac79750560246ed775df2e6d16056a6b39e01b73073fbbbff",
      "text": "Ke mana kamu sekarang?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3d92ce24486e7360a98a82af98167d13c6ec1cc05d7151fe6ebbd3c9a7285a6",
      "text": "Pendongeng yang hebat mengubah gaya bahasanya sesuai konteks.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4cd61f0f4d07990bda263cb7412f81effb1d5433448efad64ec3bcf9e678460",
      "text": "Anak-anak penasaran sampai akhir dongeng.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a67a720ef37eaebbc5b28a02ccd0b8cfdb6a4e6fa85f5880e8f2e60203dc6ee7",
      "text": "mitos",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a73f1d6a733d46694db852718d37081e60b9ba6163b09077c73724b9a88ab217",
      "text": "Mitos tidak harus benar secara sejarah, tetapi maknanya tetap penting.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7e4059cf29894c8060b019c023cbbbef80401ccd4b716abe1b1f51741211969",
      "text": "Bagus! Pelankan suaramu sebelum klimaks. Lihat, anak-anak sudah tegang.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0449007e361f668ee509bce4bf4bee14bde050c26ce75af0d7d20eee6be4e47",
      "text": "klimaks",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0f6917457bf9a404dcc7a576b3d5ba20621bfb024a501850859a74769ab95b3",
      "text": "Mohamed, malam ini kamu yang mendongeng Kancil untuk anak-anak.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1a2d366948801019f1f8bc08d0095af1519d7143298785501b51f29e374ad25",
      "text": "konteks",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b35c9dc36912cb64472ba85752f85c34076402024019c62bf64700afa5fedd7c",
      "text": "Mitos itu diwariskan kepada keturunan para raja.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b50f11bb34537059c05e52a08ec173a23610b118f3f17d39e5c9fee6818e03b0",
      "text": "Ada danau untuk arwah orang tua, dan ada danau untuk arwah anak muda.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7b35261efa9aeb2bd00937747c0af8b75749653ad244074ed5249fbdefc6dbc",
      "text": "Sebagian percaya. Tetapi bagi kami, mitos ini mengajarkan bahwa pulau-pulau kami bersaudara.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8c67b386e5548d23fdb74b50d5f71fc86fcd3bf3df2be496ba9608237ee3705",
      "text": "Warna putih dalam cerita ini menyimbolkan kejujuran.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfdf6ea84099225a0db4ffbe99f3124eb9a2f2de396a42f746117845daf66b34",
      "text": "Alegori ini menyimbolkan perjuangan rakyat kecil.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c348c9b1986d3d6f41a8f3176560c305e9074d885398f551de12500cf6d32a1b",
      "text": "Kalau Kaka Yohana di radio, pasti beda lagi.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c491359eb5908ed7d126f650bc8a9e048bd8f85e1c94591f9ea045d24fbb1cc8",
      "text": "Mama, buku tua ini judulnya \"Hikayat Seribu Satu Malam\". Ini dari Arab, kan?",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "c81ccfd66cb0340872bd26a860e42b0d63d5913a1f28e90c92fae15626f7798d",
      "text": "Sama. Ikan kecil bilang raja laut mau menghitung hiu. Mereka berbaris, dan ikan itu lewat.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca1c4a244985dfe9d7ac77ad8e8d9ad6c96df92c5181bb530b4d0890c9cc5fd4",
      "text": "Betul. Konteksnya lain, bahasanya lain. Pendongeng harus tahu siapa yang mendengar.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdb6bae3eae3e9062d9c6415eb48151fc41b0cb45785dc15872d0d6ca63fcc6b",
      "text": "Karena pesan moralnya penting. Penyu itu menyimbolkan laut yang memberi kita hidup.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceeb09d5eafa677672b4f3de35b54e8105265417cab606b003dc1d50919032c6",
      "text": "penasaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfe9b536a82eabb3e34bfd77ceb81c08d600a75f2350f24a82256f55fa68e42c",
      "text": "Anak-anak diam mendengarkan dongeng tentang penyu raksasa.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d267c29cfd01ccf56a27c8f376780ae9f3b3b0c8d974b235d423a27311a9dced",
      "text": "menetas",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3256db0764c009d81aab81995e6e5ef553acb4f3fb03171e1166f5758e6d1ad",
      "text": "Orang Lio bilang, itu rumah arwah. Tetapi guru IPA bilang, itu karena mineral.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4dbf01b7993303b694d3e2b531bccc99a2f85711b1190b61ad52040e6611c3e",
      "text": "Malam ini anak-anak minta dongeng. Saya mulai, \"Alkisah, pada zaman dahulu kala…\"",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59cfb28dfd703369af78a90e8f626a0980500b7d3631944b99f901084802506",
      "text": "Gubuk? Rumah Mama besar dan indah sekali.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9715c6a7364acccbfede93079abdebe68767806de604ed7021d9d130aad1257",
      "text": "pendongeng",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "da5106d2dc28de6d1e9c353ff3e496687d9985feea21db02e9020c127f1275cb",
      "text": "Tokoh hewannya berubah, tetapi pesannya tetap. Akal lebih kuat dari otot.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "de17015e8919593b0f0cd1648c1c39a5454a2eeb7f3addcafd8fbb22dd49ba12",
      "text": "Mama Ruth menirukan suara buaya yang berat dan pelan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0505a64f1a5e874d9e9800480f888bcca2e46e1c79ea213864a6b1d30c7fd1c",
      "text": "pengembara",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2465d71772e872e1653a9181f356ed5648322847770978f9cdf428e169579eb",
      "text": "Seperti orang Mesir yang bilang \"Ini tidak ada apa-apanya\" untuk hidangan yang mewah!",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2dbb8eec57e630e449fb33dad8590f6446c3f318585f69e4a69adff9e8ee573",
      "text": "Bagus! Sekarang menirukan buaya. Lebih berat, lebih pelan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4cb100a7ba64e7b94bbdc587fea813af3ca19e4a8f8b927db4a47627dd2749d",
      "text": "tokoh hewan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e566de9950bbcaa14e89a457bd51deaa87702c538523af228a9687fe663a03f6",
      "text": "zaman dahulu kala",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "e742fb11476324502acc93a78c9d95fd53570f25abdc8eb50ca7905a0dc0bf85",
      "text": "Kenapa warnanya beda-beda, Mama? Yang satu hijau, yang satu hampir hitam.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "eadb6fe25a17667617c70a91b6a31f1be866e4c1683fe148d6fbde4857ed0e84",
      "text": "berubah warna",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "effb43e50c4d4350330d4b3b11ae08e731ecafb4d92dbcd0d9b62643e7184ffc",
      "text": "Keturunan raja itu tinggal di empat pulau besar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6410d6cc7005a42fcb9ae7628f4fc21a4cf9849909d77d40991136ee9af70bd",
      "text": "Dalam fabel ini, tokoh hewan yang kecil mengalahkan tokoh hewan yang besar.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "f775ddfeea502fb42500908b4baa40432d2e4222636156a95b0c179f840b07b6",
      "text": "Banyak hikayat Melayu adalah terjemahan dari bahasa Arab.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "faf5630c8d7c3356ab9e5c5081c02b3990a00eb8f5a8a3949b8a7c75358bc73c",
      "text": "Klimaksnya terlalu tegang, ya? Saya kirim lanjutannya lewat Kaka Yohana di radio.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb784595d8680b4047e6cf06251bfe5d69214e15da1bf96ec965fd68893f87e4",
      "text": "Pintar! Dongeng dan adat saling menjaga.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "fea6843d896c12b849416e534d3e05da0f0a497e451fea7b64550009c97dcddb",
      "text": "Paradoks dan sinekdoke sering muncul dalam cerita rakyat.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff4455cc5cd01694e586e46827ec6bc7a25960791f7f57670e545412cf36c364",
      "text": "Itulah asal-usul nama Raja Ampat. Empat raja dari empat telur.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 10,
    "clips": 120,
    "chars": 5498,
    "audio_bytes": 0,
    "missing": 120
  }
}
