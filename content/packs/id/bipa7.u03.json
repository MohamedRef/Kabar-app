    },
    {
      "id": "bipa7.u03.l05",
      "sha256": "30de8b7b238c14438a35fecdb5eb9764aff53a1500421b8f52ce2fdf159d6127"
    },
    {
      "id": "bipa7.u03.l06",
      "sha256": "ea6800614a73ce21719a9db238350e67c40fce47b0a28059d59d5a121ab91944"
    },
    {
      "id": "bipa7.u03.l07",
      "sha256": "c2961f672adc00f7666495b609999ee1fd7839c38acc4b26d4e3422250a483fc"
    },
    {
      "id": "bipa7.u03.l08",
      "sha256": "3378e9f79065feab332cc126e793a532404e36d441c58322587c16c12c62a8e1"
    },
    {
      "id": "bipa7.u03.l09",
      "sha256": "b9804363b0dd075598845ad70ed560a4fc96eda67e2c4f88df6179431ceca149"
    },
    {
      "id": "bipa7.u03.l10",
      "sha256": "a2a6a3459fca40355621538bb5251a04799434898fa7391ac61742c8dd61af31"
    },
    {
      "id": "bipa7.u03.l11",
      "sha256": "929192b80ef71dd524d34d012379d7256ca57f2eb06d06425453eccd04bd3dd9"
    },
    {
      "id": "bipa7.u03.l12",
      "sha256": "4d790c09d9d269a6157530778bfbe6a56c2df755684217e345f5708c4a9d4b43"
    },
    {
      "id": "bipa7.u03.l13",
      "sha256": "1d9ee6ab45a995cdebca3fbb2de2ac3b025def1021ecd368e53d07d907e51ad5"
    },
    {
      "id": "bipa7.u03.l14",
      "sha256": "279a396e7872360af0f0663a2f903af7507aae8457db357e8791d0e476d35973"
    }
  ],
  "audio": [
    {
      "key": "0338a6c3edaf1f31040b5d621eee1f1dbd67e8ed7375bdf9e2dcdaa60791ec36",
      "text": "Saya akan menghormati aturan itu. Tempat sakral harus dijaga.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "034c651a39412fb387a312870b22d9f181bcd9247454cbd31c71af09222e2d74",
      "text": "Sekarang giliranmu mendongeng, Nak. Cerita dari Mesir, ya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0536167f68296e3f0bbb6f3218a6b93168519b8eef943519befc0d6f3e5c53d9",
      "text": "keturunan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "086c96f4ddffc3e3c8eca0c4622dd9e39d3744819dd1d5056d0f488b6f84de77",
      "text": "Dia juru cerita terakhir yang hafal kisah asal-usul marga kami.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0890772930987fccb96b5bdff64ef861f08df2f8b47505266d8ca3dde870bcc7",
      "text": "Ke Piaynemo. Kata orang, di sana saya akan mendengar banyak logat.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "08df3e8f0bdc36362d8c5f4b1098c17de965bf072d611a08e154f985072d5511",
      "text": "keris",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "09501a226f15d9f4b8d816122432b75fc4b2d813eabb42eaacfec021d8ff3293",
      "text": "hikayat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bf57be716bae8c30e13a150e3545a2b779622b9069af359f289ebc0fa0408d7",
      "text": "pertapa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c2c7f699d220aa1327cab0eb229ce2ccf5db19d1597b4ade652a47140c72a73",
      "text": "wangsit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d454f3fd0d57f0e1b38e1988e5d1ca0b06ea1b9fd4af6841ae69fe3a7373f2c",
      "text": "dongeng",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d6ecdbe6bda38588bf6180a012b8ef0926339a941f7e03abf14a49d7ef87614",
      "text": "Tiba-tiba… jala nelayan itu menarik sebuah botol tua!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d9e31a5d1ed65a7d826655b101dd8ce3ef57231f79a3bc42337602b345b15cf",
      "text": "Jadi ada dua cerita, mitos dan ilmu. Dua-duanya menarik!",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "10125858dcbd4395c7f0320b19238d0e3351a06fc603b5dd1249d5792438b65f",
      "text": "Itu namanya litotes, Nak. Orang Indonesia suka merendah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "102c80a81aefaf2adbcf89deee5f884e857018ed31f12a956e96eecf987701bf",
      "text": "Kura-kura itu ingin balas budi kepada nelayan yang menolongnya.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "104959beef9609bc4799db202a2b715d2298b0cbef2eb37c6a9dbd0ff95e3e96",
      "text": "alkisah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "10f4e3f25e179d355ee52552e08c928faed8b05779abedf2078a5734a474b6cd",
      "text": "epos",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1618c27717b69dc112fc64fb3510381d37e73b7a4c818b6c81a73b9db66cf9f2",
      "text": "Dongeng Mesirmu kemarin bikin anak-anak nggak bisa tidur. Mereka minta lanjutannya!",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "16d361a95aa8440e7ebab5f895f14e4edcc83a84c1101cf51f7642f62ad580b6",
      "text": "Sudah tiga hari batang hidungnya tidak kelihatan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "17a1944e06eca1e4cafc2c77d5bc3382e66f98beaa5f60d3569f6a58d76e8dd8",
      "text": "Dongeng ini adalah alegori, dan pesan moralnya sederhana.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "195d0e5b8cb5ce562307066632aa64d086e794541e4d94eac56508ef0dec57a1",
      "text": "Dengan akalnya, Kancil menipu buaya-buaya dan menyeberang sungai.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ac1999ccf4c49ececa059f2930d701704889f873910e495d99f6fcc7bc87954",
      "text": "Di sini juga ada tempat keramat. Kami nggak boleh teriak di sana.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "1daa6fc1eaab3870c7f2c094808e8b0e16160796aaad3719e705b3a327b1a306",
      "text": "Raja mengadakan sayembara untuk mencari menantu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f69ffdb9f24ec4e6d68b8aa9f9ad1dcb8ee6e8a946ecbdcc34827a878f229ab",
      "text": "Menurut cerita, raja itu tidak meninggal, tetapi moksa.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "20714b80bb9124b38332daafda00d55206bed032e28d59261455d3f7426b9850",
      "text": "Pertapa tua itu mendapat wangsit dalam mimpinya.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "226b59b055d1b6335ed1c0467260bf7b94981ae612acd018ffa2e13ee78e9f2d",
      "text": "kawah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f18b43c47021b370a50f6b57e5acc17e369752761329f8f670e02174958ddf",
      "text": "Makna yang indah. Di Mesir juga ada mitos tentang asal-usul Sungai Nil.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "24585e03205f16daa0993f236eda7779cf63ea570f0a834f15eef1d8e515da0d",
      "text": "Jaka Tarub menyembunyikan selendang bidadari itu.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "24ece4aa73a908bffa8e60e47e209f21dbe12c5249d76a4b1a3d82b3cabfe0f3",
      "text": "kiasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a651030b5290d01e85169423366ad3ccba3b00d5c55c170591a762003d2068",
      "text": "Sebermula, ada seorang pengembara yang mencari petualangan di negeri jauh.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "28fb59c1459245dbe268f644ebf563e8cfd93bdb1e0ee046cf6e35ffe9b0da55",
      "text": "titisan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c21bb85bb318b8a8c0cb624d51de3d1da19a69c05b7b1915dad5a59705d9c70",
      "text": "Dan buayanya jadi hiu? Tipu dayanya sama?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "31efb102ae837fa890e4e8536f23b9c5dfbfa33c2e1bf920eca38e6fb01f70cd",
      "text": "Burung itu datang untuk balas budi.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "321f1416812356f1762d7e68c8f80d706ab2e4acb3d710628352738df8c8c0ca",
      "text": "protagonis",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "335f7c4e84013e3156d8b883bc1e8f650367e86dc84702cbba839ba3faecd422",
      "text": "Setiap danau bisa berubah warna karena mineral di dalam air.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "341d20d112aa451b5eead58463a01b281c760fe2e293dee464efb4317996aa3b",
      "text": "Kancil berkata, \"Raja ingin menghitung kalian. Berbarislah!\"",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "34c0e94ef0dd768e7628451ed0a8cc77815e81826dd22bdbeee1cb4224ef88b4",
      "text": "menirukan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "351a87ff59679880a5a7498b6aad3d2386a1f13ec5f2a4822cdca7a778f93c43",
      "text": "Petualangan pengembara itu berakhir di istana raja.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "35d2d42f82a8e369984467dc608e1baac54a531670cfd95d6c46807a8b0ec4cf",
      "text": "Hatta, pengembara itu tiba di sebuah negeri yang jauh.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "393e7e3d8cf24294a05196569eeb1f5fb189af45fa1ebed2eedd3c93f7166944",
      "text": "Pesan moral cerita itu disampaikan lewat kiasan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ad57202fa4dc19051a49ce68ee8f1fdb064a2511e6b3fd0d8db24e3c235a7e1",
      "text": "Bukan. Seorang laki-laki muda mengambil selendang salah satu bidadari.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bca93173fbefcf12762a3b54b491b2ce09ec58eed25c78ae2c09bdabc965d11",
      "text": "Sebagian percaya. Tapi buat kami, mitos ini ngajarin kalau pulau-pulau kami bersaudara.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "4003b4bf9b739a7acd7d973ba8a315a16fd9519ecc4b5ea816f8cfebe6fcc73c",
      "text": "paradoks",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "40d0d6c8c78b32c61edeb70c69740259439ed1034fb2c81c791ffc03dc2bcda4",
      "text": "bertapa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "42353b0bdd53e4de22c1257e773d7949f5b4652d86d987697d339d57f8b709f6",
      "text": "Jadi ini alegori, dan sasi adalah cara menjalankan pesannya.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ae2327597fbdf3ed2efa45d77f864b4ebbfcd7ff23242b391a2bdc4b8439dc",
      "text": "mendongeng",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "439f748dc75a9d8b18d3643246f4a4de262f0e2559779de374a9e69fd954f161",
      "text": "ketegangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "46a7e47daca207f25a27eba2abc177baf9d5f185b71b3921f5b0c0e135c1cbe0",
      "text": "Ceritain satu cerita dari Jawa buat anak-anak, Mohamed.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "493acfb8c4e0456d8a2823981ac0bc069a4c3e6e0c05bcfeb80a7c8dbe9e5422",
      "text": "Danau tiga warna itu ada di dalam kawah Gunung Kelimutu.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a9a030eefd5ac2710a531c51591eac414fda2ce05e97a8de9876e800197455",
      "text": "Menurut kalian, apa yang terjadi selanjutnya? Kancil takut atau tidak?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a0bc6d6b3c47761558f499ad5006f807a88b1beae7548b28c4398f050abf21b",
      "text": "Kancil adalah tokoh hewan paling terkenal dalam fabel Indonesia.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a2ef1e5c50371b89b552332960c83d621bf11e374197153e9dceaafbf1bd1c0",
      "text": "lakon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a70fffaa27e7242e0ae25a649d4e3ccd57a020e72620f4107575a7bd3397ef9",
      "text": "Ketegangan naik pelan-pelan sampai klimaks cerita.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c6a1734f6abf297319503505edce60acd0978fc801c18008d8e2cf50b41b9fb",
      "text": "Budi pekerti yang baik akan dibalas dengan kebaikan.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cdc93caa503c7f4277b065b3aa436bab4aaebcbf0ca9f0febe941c0b664c463",
      "text": "selendang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f620aa5143fbd31bfd75b33cc65dddf8a85f90974c36a215bb568159e5ce0b4",
      "text": "Wah, itu nggak baik. Pasti nanti ada petaka.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ff2921cc398598cc975b848b004afac9e9d342f09a814e17a1834837b26c4ed",
      "text": "Betul, Mama. Tunggu bagian akhirnya, ya.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "506e6da9a12de01f825b09ff0e44406b76ab99e88547e5ee3fb63c4cb7397ed9",
      "text": "Di puncak Kelimutu ada tiga kawah, dan setiap kawah berisi danau.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "509bb37c578da97eed6d2c5e645cd55945dd6b9980e87d4896533752f0b99695",
      "text": "Kok warnanya beda-beda, Mama? Yang satu hijau, yang satu hampir hitam.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "51cf4cf6e1e8169ac95106a6133ebe0d08043c7da71b5de7e9b175c260a18010",
      "text": "juru cerita",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "520736408753a174792ea61b47a829162cd70b7caaf1480b7b363c1f6d61adf6",
      "text": "metonimia",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "540b8086fcf11f42a7534bedd811bde20b152526ce569f429d12d54c362af5d9",
      "text": "tipu daya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "55ed27c4c3c99cbbf6c48bb2cb1c9aba2b91506594b1a7904e1700c2acbb246a",
      "text": "Ular itu menjelma menjadi seorang putri.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "58c0e4432bd253c03696967541d51bc8b71fa10cae6acaea98cacd0c9b4e313d",
      "text": "Pangeran itu bertapa di gua selama empat puluh hari.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "58c81ee8cec5f57a1ae3c19c64cb079e11a883ec2a47fc49a357010c4482ed66",
      "text": "Menurut orang Lio, arwah orang tua beristirahat di danau ini.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5956fd9463f11ca478651a7ceb73333f532ad0784db74c02b51f5b68a78e1666",
      "text": "Lihat foto ini, Mohamed. Adik saya kirim dari Ende. Danau Kelimutu.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "59e7cf1de52a92859bfc6dc367b605b9833a81ad832c6cd494525e2ee56616aa",
      "text": "asal-usul",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d4c00261a3b6f2e814697d4cbed70c143d2eeceeb5c7ae7cc25c9ab51ba9747",
      "text": "\"Hmm… baik… kami… berbaris.\" Lihat, Mama, anak-anak sudah penasaran!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e06e0337afd8508a852a72725a0f216ab02574cba8108bbb2880248c59d67ca",
      "text": "Litotes membuat pembicara terdengar rendah hati.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "60736b2ea0198e0de4c33290d57e4e1df025f68f503e32d6287086c8f4d51f00",
      "text": "Betul. Itu terjemahan. Kakek saya suka bacain petualangan Sindbad.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "62a8ed17454813f8b8dbed0ec2dd4c1970ca783fdc88b9522046c44091769613",
      "text": "balas budi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "62b796528a2efaea5afed48e9f08411208dccaa4adbb929afa4c5ebaa9f10a07",
      "text": "Di Jawa, katanya ada cerita soal raja yang bertapa, ya?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "62e9a4ff905571f14fcd8e3a906381303d5585c6df41bcde63b6b9c982d552d4",
      "text": "Kucing hitam itu ternyata jelmaan bidadari dari kahyangan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "6306c6b35cf9dadf61e2f81f6521fc50d92a4497977f6b2886e5a286a278daac",
      "text": "budi pekerti",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "637b58a1721a4d176f4d7145f21f53a08da66370242d3f41e937e484b81a40d0",
      "text": "antagonis",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "63bd3632c8138b2ee555500bd8804c3520d786d6747aa6c7b9998c4ea2e7b6bb",
      "text": "akal",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "642f0e252d3be8d707d0f9a8f540846bae1b10a97d216807b0eebdec517db4c6",
      "text": "antitesis",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "666db49cbb5b2492bc5fff24f9409156b2dd080778787d14e2609b7ececf90a7",
      "text": "Buaya itu kuat, tetapi Kancil menang karena akal dan tipu dayanya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "66b42abeb059787cc13beec7d034f6cb29252110567fb69a0d422c8fa74666f1",
      "text": "Metonimia memakai nama penulis untuk menyebut bukunya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "66dc9969b561c18844882ea46f0fdd2848964103625818f6005d0137f7d3a580",
      "text": "pesan moral",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "69377d526760b4a454bed57bc852f4d97bedf91b256976aa619326c6d159e685",
      "text": "Pendongeng tua itu selalu memulai ceritanya dengan kata alkisah.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a01237a6d34a3f7c45b27c8c9ffd0cc2ba8832505f35160f5e429736d9bf6a6",
      "text": "Bawang Putih adalah protagonis yang sabar.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a3a966dcf1f3b97027a4951ab21f019819c3914fcf67891f206f476013b5826",
      "text": "Cerita itu terjadi pada zaman dahulu kala.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a649159aa477e5a2725c6cda3ac5092235f43bfc381540c0398b1a2e403d42c",
      "text": "menjelma",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aa3ae037a4ccd7dafcd576c7e2e7c0c9f08e884eceeace19dd3e15a7d109b27",
      "text": "Hikayat Amir Hamzah adalah terjemahan dari cerita Persia dan Arab.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "6be8908c741ee392f630193a14de9b2176c6189753811e6fa2292311c5eb4ea2",
      "text": "petaka",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c7420e78249037a5f426f09403e2fa7929c3640a414ddf9c60857cb6a2e0eab",
      "text": "Emang orang di sini percaya mereka keturunan raja-raja itu?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c88d05cf7979f6079c23ae8e28b79e401fa51249d01b741ee8f39efd046d06d",
      "text": "mineral",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d5076b12348baf8525eaeaa5e273481dee9831202ee1a6dfefbd008617ac54e",
      "text": "babad",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f29b34f2673f85f9d354e395935c0f00ab40c02e996fa6c9acdac412968751e",
      "text": "Bagus. Cerita boleh beda, tapi rasa hormatnya sama.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "73536f80274a6de54c5babd72beb30cf32dce3a52827205f32f2c19795c10d7e",
      "text": "Pendongeng yang baik tahu kapan harus membangun ketegangan.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "73885137092fa9f9fe1c7bb3fec654f777cfe4ec705d29fe968ef71f99dedb9e",
      "text": "Buat siaran anak, kita bahas cerita Bawang Merah dan Bawang Putih.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "739332933f29bebee15830d5fbd85cad1f9421c4a19fa4f84e818e529f79c0ef",
      "text": "Mengapa Nawang Wulan tidak bisa terbang lagi?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "745b4115820ace22e763d04888b4b94b782a4fedfba9c1f55e422b5c9bf0349f",
      "text": "Alkisah, ada seorang nelayan miskin di tepi Sungai Nil…",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "74747e81a05c4a5083e19f4da39ab308a5d5d1d347dda0c9c1ebe1d9843a33ba",
      "text": "Cerita ini sebenarnya alegori tentang hubungan manusia dan alam.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ace788a6ba905882ab2a1f5329d0d46f547ca6c9ec537877aeb08b0cc69e9d",
      "text": "alegori",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "775a4a520e263441d4b00033f0a5bfeb438a8459c57d833b1e8fe29618315e2f",
      "text": "Telur ketujuh tidak menetas, dan itulah asal-usul batu keramat di Kali Raja.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "7851f5302bb82e05c9a38a3c1fea8b7231bd41ed6ded0bb4a421d7bc96cc4727",
      "text": "arwah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "78a0ce4402bce563892e6d69f61916d064918ea5528f76d20d04c9e276d6f884",
      "text": "perangai",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "79c42b75fdb7f012bc79da44b7f5f744c1b7461bdc20b076f6384d123b0939b1",
      "text": "Cerita ini adalah sastra lisan dari Biak.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a1937d594b483338d843d4d9fab775e9fb757ae9fc7d9bbdc74879162ce99f5",
      "text": "sastra lisan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a7fdf3d117bb4cd661f2c77b20ae4d4d09a6d3d3f6054d8974584f7e5246b95",
      "text": "Alkisah, Kancil ingin menyeberang sungai. Tetapi sungai itu penuh buaya!",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f37b97ebea74770257f6b6c096e8e4941a7c165e4b9cf784a6d56fe0f8ce493",
      "text": "Ramayana adalah epos yang sangat panjang.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f3d3df8919ece2995ba24c72f9e7b7e10932bae4a25f40b06ef096373cad22b",
      "text": "litotes",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "808b59c7205c80e09a5b6b935138dca2f3a74625a6789524808afd703aaa52d2",
      "text": "Bagus! Pelanin suaramu sebelum klimaks. Lihat, anak-anak udah tegang.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "809d2196edb7dcba321dead52bd570c693950f91d269bb82ce1aa02dcfbc856d",
      "text": "Orang Lio bilang, itu rumah arwah. Tapi guru IPA bilang, itu gara-gara mineral.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "81d8ac2ad0a1a521a696f04628d0d3e7dff89d2e0217b3b511946eb935268d0c",
      "text": "Baik, Mama. \"Raja ingin menghitung kalian!\" Begitu suara Kancil?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "82209bf8fd9bfaed75337a2d6f160e2147609605acc5e039159e072e29695356",
      "text": "telur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "85084b1cffaf1a61b3a1877afad142a87d1f9666e41c5ddbd3c9d70583f3ef86",
      "text": "Satu telur tidak menetas dan menjadi batu yang dihormati.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "87aad0e3c396ebb85e4125cdc5ec6baa5b79011409d1386b5742078b98ca6f97",
      "text": "tiga warna",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ce3a20c57c76a439ae12a6265c2e9d29d9870e2c2996315df9d8278808aaaea",
      "text": "Empat telur menetas menjadi empat raja.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da2042d2872ef2e9d2f986c1f0ed8d07a0cd1ba4ae722244d9da97501da70f1",
      "text": "Alkisah, di sebuah pulau kecil, hiduplah seorang nelayan yang jujur.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "90ce8ddd85eecbd02f4faac0d461b78efb7852cf59d7e9a95e3039ac36f524d7",
      "text": "Selamat datang di Arborek. Silakan masuk ke gubuk kami yang kecil ini.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "931637652c1d27f5eef4cea09baa0332001393b2ec4bcfebe436e89a3c8ba92b",
      "text": "petualangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "935cee60d5b1584c2399ecf84d9e624c15749ebf443d3a93b43d8d8fe0a74d9c",
      "text": "Teks mana yang mencampur sejarah dan legenda?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ef1f7eb4252019203e91df37d8d7e3231d21a620ea031c6e393a15768d10e0",
      "text": "Dan kalau di grup WhatsApp, \"Eh, dengar cerita seru, nggak?\"",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "95114fdc619bc84ea82b14ae7fac2874cb228477df04818327a003b10afcc2b0",
      "text": "Setiap malam Jumat, Mama Ruth mendongeng untuk anak-anak di dermaga.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "965407e5c1bbba73035b2626649da33fe46e4b40ebb230011254500f2228836a",
      "text": "jelmaan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "98323ce78b14ef639e5462005306d6eeedc49450e89e6ac5dc17cdcdce31efff",
      "text": "Ibu tiri yang dengki menjadi antagonis.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "98bec55f7f90adc5d6a85ea247a8c22f82b7472eded516f999b4ae419786037b",
      "text": "menyimbolkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "98e5f5b90576d14fafb384ebef8ba1ef650ac48de5b1cecaf5d6a204d7f8f65f",
      "text": "sayembara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b14aac5b55a68844ebf3d6133309e68c8fb9cc172b7a79be7102791eff54de6",
      "text": "terjemahan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d6fa3b671642ae1f68a7aeacc5b6cd3c636475faebfeaee384975f844eb8c34",
      "text": "sinekdoke",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ddb751eb47bf0e44da7551ef9d0116b4ce154bbcac0f08a05f0b30ec2d495e2",
      "text": "Jangan melawan orang tua, nanti kualat!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1edeb2f8d61452425a51f156db55ca71462fc3212d88bd611038aca4a458778",
      "text": "fabel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2c689a05d186c4ac79750560246ed775df2e6d16056a6b39e01b73073fbbbff",
      "text": "Ke mana kamu sekarang?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a32bd105333c47868b583eee8b934486d5c92467470bfc0bd1a26b202057e628",
      "text": "Bawang Merah dan ibunya. Mereka dengki dan tamak.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3d92ce24486e7360a98a82af98167d13c6ec1cc05d7151fe6ebbd3c9a7285a6",
      "text": "Pendongeng yang hebat mengubah gaya bahasanya sesuai konteks.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ecc78d0b1726de280e39c38849c012984364737bd30a147b44133e27dca854",
      "text": "kahyangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4cd61f0f4d07990bda263cb7412f81effb1d5433448efad64ec3bcf9e678460",
      "text": "Anak-anak penasaran sampai akhir dongeng.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5a9127b2245440e3452711ca4307d98ca352149be9b2bc681fe49adfa1e5816",
      "text": "Mama, kenapa dongeng penyu itu diceritain berulang-ulang?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a67a720ef37eaebbc5b28a02ccd0b8cfdb6a4e6fa85f5880e8f2e60203dc6ee7",
      "text": "mitos",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6ba8508fd1765f2b8594944a7e1588dcba2d90b0b231fea1ac4358b2e69bd3a",
      "text": "Terus antagonisnya?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a73f1d6a733d46694db852718d37081e60b9ba6163b09077c73724b9a88ab217",
      "text": "Mitos tidak harus benar secara sejarah, tetapi maknanya tetap penting.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "acce3b604b1757ea7e5c31a1539433931b3f58d04f3bf5a459be3f712086e896",
      "text": "Tokoh yang ingin memiliki semua emas biasanya bersifat ...",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9a06388a9ad5e299144060abc08e331293f0d509d06afde792194aad07d6ef",
      "text": "tamak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0449007e361f668ee509bce4bf4bee14bde050c26ce75af0d7d20eee6be4e47",
      "text": "klimaks",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0f6917457bf9a404dcc7a576b3d5ba20621bfb024a501850859a74769ab95b3",
      "text": "Mohamed, malam ini kamu yang mendongeng Kancil untuk anak-anak.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1a2d366948801019f1f8bc08d0095af1519d7143298785501b51f29e374ad25",
      "text": "konteks",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b50f11bb34537059c05e52a08ec173a23610b118f3f17d39e5c9fee6818e03b0",
      "text": "Ada danau untuk arwah orang tua, dan ada danau untuk arwah anak muda.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "b769b9f1c49ddacb906e000ca2dc0073277767b4af8d1f401c20240e67d9bd38",
      "text": "Jadi hikayat ini udah berlayar dari Bagdad sampai Raja Ampat!",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8727431497ea95da3f381b3bcb453f82fc39d576952180a3f1ea5c42c719b5a",
      "text": "pujangga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8c67b386e5548d23fdb74b50d5f71fc86fcd3bf3df2be496ba9608237ee3705",
      "text": "Warna putih dalam cerita ini menyimbolkan kejujuran.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba01b2d07335be04feb29d94e88299af554c65f841d24b54308358a9d8e736cb",
      "text": "Hikmah cerita ini: orang yang tamak akan rugi sendiri.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab5723304cd81eef7caddab65c7a9a71bef998e613e47bf53c0832c0b80a7e5",
      "text": "Terus? Ada yang menjelma jadi burung?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdaa9bff11cf1b683d9116c2f8bd392390a22d7c595b52af4db2d52aa2db0dab",
      "text": "Siapa pun yang menang sayembara boleh menikahi sang putri.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfdf6ea84099225a0db4ffbe99f3124eb9a2f2de396a42f746117845daf66b34",
      "text": "Alegori ini menyimbolkan perjuangan rakyat kecil.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0038f38f79aa6113eee31367bd4fa17e0c59e2b169eeec69646a5057511d06b",
      "text": "keramat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c01a28dd55e5c598add764b0f6a8f384e82db78a85822cb13588751c05b86195",
      "text": "Kayak orang Mesir yang bilang \"Ini nggak ada apa-apanya\" buat hidangan yang mewah!",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2fa11838b8b0a565ff7bf286b1087ffa1e6fdc3bb26d1bd04795cdcef122d18",
      "text": "Dua-duanya. Seperti epos kecil, ada bagian yang dinyanyikan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c348c9b1986d3d6f41a8f3176560c305e9074d885398f551de12500cf6d32a1b",
      "text": "Kalau Kaka Yohana di radio, pasti beda lagi.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c42038e655d3213d144bb0d75c89f904b5f444c3f9d654bd2a317753e5dd73dd",
      "text": "kesaktian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4723d138a71b8906cc5152f3fa46ce53a8651248d42664594788d6396b10eb7",
      "text": "Tentu, Mama. Sastra lisan seperti itu harus disimpan.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "c491359eb5908ed7d126f650bc8a9e048bd8f85e1c94591f9ea045d24fbb1cc8",
      "text": "Mama, buku tua ini judulnya \"Hikayat Seribu Satu Malam\". Ini dari Arab, kan?",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5db2cb5cc0a8ee7a8311ac4b362fc7599635647b4e7e285e1c4b41a74774e0f",
      "text": "moksa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7839372e19294adf04d3de3b767b9c3cb39388d4a8da72edbc78e871b49c091",
      "text": "Sesepuh kampung adalah juru cerita terbaik.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7d6a9c4fc0c837f4c16497001f42c7f2b2b939e10283cd5e772e309beb053a1",
      "text": "Ceritanya bentuk prosa atau nyanyian?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c81ccfd66cb0340872bd26a860e42b0d63d5913a1f28e90c92fae15626f7798d",
      "text": "Sama. Ikan kecil bilang raja laut mau menghitung hiu. Mereka berbaris, dan ikan itu lewat.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "c84eab13d2f099313448e67fdcf19fe5adc0e96687977795d100aa669bfbd203",
      "text": "Terus apa hikmahnya buat pendengar kecil kita?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c90303207196d5bfd61a3941fd67c2a57aa734506d36cfec409ea7b06b2ed802",
      "text": "kualat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca1c4a244985dfe9d7ac77ad8e8d9ad6c96df92c5181bb530b4d0890c9cc5fd4",
      "text": "Betul. Konteksnya lain, bahasanya lain. Pendongeng harus tahu siapa yang mendengar.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbaa57491c07b04f6836de4dbe5644eeeaa81a700b136d6876b96b99c9e40649",
      "text": "Kami merekam sastra lisan dari para sesepuh.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccbb062f4799255fd539a324d80346c4a4eaa7033482475170c8df527f952ba9",
      "text": "Babad itu ditulis oleh seorang pujangga keraton.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdb6bae3eae3e9062d9c6415eb48151fc41b0cb45785dc15872d0d6ca63fcc6b",
      "text": "Karena pesan moralnya penting. Penyu itu menyimbolkan laut yang memberi kita hidup.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce90605dbf8677a6f8941389337bd20d61f6494b82f9631476ae223e4fedf68d",
      "text": "Keris pusaka itu dianggap keramat oleh warga.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceeb09d5eafa677672b4f3de35b54e8105265417cab606b003dc1d50919032c6",
      "text": "penasaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfe9b536a82eabb3e34bfd77ceb81c08d600a75f2350f24a82256f55fa68e42c",
      "text": "Anak-anak diam mendengarkan dongeng tentang penyu raksasa.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d267c29cfd01ccf56a27c8f376780ae9f3b3b0c8d974b235d423a27311a9dced",
      "text": "menetas",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d293ea40854d8a147c306ebfee8a2bad2cd267f949ecb01ed1b0a93470ff876b",
      "text": "dengki",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d333306aa403cfdbade6a6e52a83c1db0c4fb73bbb1eec788fb95caebcf5d233",
      "text": "Tokoh hewannya berubah, tapi pesannya tetap. Akal lebih kuat dari otot.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3a2a5d950052ae7b3d6b6b586feb06288988ad67112109effb275a6a0f41b0b",
      "text": "Siapa yang biasanya mendapat wangsit dalam legenda Jawa?",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3c82e77efdf7b9bb07efb95299e32676b3e7d9856dcfb7aa32d726214e9c6cd",
      "text": "Di Mesir, Sindbad juga terkenal. Pengembara laut yang nggak pernah takut.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4dbf01b7993303b694d3e2b531bccc99a2f85711b1190b61ad52040e6611c3e",
      "text": "Malam ini anak-anak minta dongeng. Saya mulai, \"Alkisah, pada zaman dahulu kala…\"",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52960728a4cc19f97da71280785fed3432b8a352802a628db8f241ce93a49c0",
      "text": "Dalam legenda, kesaktiannya datang setelah bertapa bertahun-tahun.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "d73f43c3b0741822cd70e345549d1b55cc4dc493283eee3b1a632e2b354980cf",
      "text": "Pertapa itu menyimpan sebilah keris tua.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d81aef87ffcd18b2e4f205434e981c40ae6d5195f64c62223591399c8eb17153",
      "text": "Anak-anak di sini suka fabel Kancil. Tapi saya suka gantiin dengan ikan kecil dari laut kami.",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9715c6a7364acccbfede93079abdebe68767806de604ed7021d9d130aad1257",
      "text": "pendongeng",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dabdeb4dd1a3b6b566acfa8403121de3de099b67d502d9d33c895832b3abdae0",
      "text": "Baik. Dulu, tujuh bidadari turun dari kahyangan untuk mandi di danau.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbcd7e43b901f202aee0812c9f3102ba3b83c2f452477ecaae4a4f8d12c04e99",
      "text": "prosa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc95da9efdbbd37f3ef0e456848af6bd0ebfc653c39cd330d8da829f9962de6d",
      "text": "Protagonisnya miskin, tetapi budi pekertinya baik.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "dddba059c620ad6c93318760e9cad219fa1e712d660026f2a5f679fc8d53dde0",
      "text": "hikmah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "de17015e8919593b0f0cd1648c1c39a5454a2eeb7f3addcafd8fbb22dd49ba12",
      "text": "Mama Ruth menirukan suara buaya yang berat dan pelan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0505a64f1a5e874d9e9800480f888bcca2e46e1c79ea213864a6b1d30c7fd1c",
      "text": "pengembara",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2dbb8eec57e630e449fb33dad8590f6446c3f318585f69e4a69adff9e8ee573",
      "text": "Bagus! Sekarang menirukan buaya. Lebih berat, lebih pelan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4cb100a7ba64e7b94bbdc587fea813af3ca19e4a8f8b927db4a47627dd2749d",
      "text": "tokoh hewan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e566de9950bbcaa14e89a457bd51deaa87702c538523af228a9687fe663a03f6",
      "text": "zaman dahulu kala",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "eadb6fe25a17667617c70a91b6a31f1be866e4c1683fe148d6fbde4857ed0e84",
      "text": "berubah warna",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb22d52fc086d824e9d4ddf14bc77a05e43dc70f524bc6b0ed82eabc438949af",
      "text": "sesepuh",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebb1a9f9728dffe8c9bc39204eebe695dacd72c4f35f5529e46b98fb2be85d77",
      "text": "Gubuk? Rumah Mama gede dan bagus banget.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec90f076b58c4896900b10da7216930d14accf84f652a6b0fdf2f239ebf6c347",
      "text": "Mohamed, besok sesepuh kampung mau cerita. Bawa alat rekammu, ya.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeff5ac95ab83cb8cd94061db46cec0282c8fb1afc28a04bfd040e72e6628728",
      "text": "Protagonisnya Bawang Putih. Perangainya lembut dan sabar.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef02293305217b5cc53b6e8e9c859d786871105c5f6e5da2a865276c522005ff",
      "text": "Dalang memilih lakon dari epos Mahabharata.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "effb43e50c4d4350330d4b3b11ae08e731ecafb4d92dbcd0d9b62643e7184ffc",
      "text": "Keturunan raja itu tinggal di empat pulau besar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3579cefb25bba895c0b1ddf87c73231df0b30a1a1a901a436a783d52a891be6",
      "text": "Betul, Mama. Seorang pertapa bisa mendapat wangsit atau kesaktian.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4a4cb13dd782e2cbec08dd44c087e83b522e7ea3d18958ba5071cd0f1919468",
      "text": "sakral",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6410d6cc7005a42fcb9ae7628f4fc21a4cf9849909d77d40991136ee9af70bd",
      "text": "Dalam fabel ini, tokoh hewan yang kecil mengalahkan tokoh hewan yang besar.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "f775ddfeea502fb42500908b4baa40432d2e4222636156a95b0c179f840b07b6",
      "text": "Banyak hikayat Melayu adalah terjemahan dari bahasa Arab.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "faf5630c8d7c3356ab9e5c5081c02b3990a00eb8f5a8a3949b8a7c75358bc73c",
      "text": "Klimaksnya terlalu tegang, ya? Saya kirim lanjutannya lewat Kaka Yohana di radio.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb784595d8680b4047e6cf06251bfe5d69214e15da1bf96ec965fd68893f87e4",
      "text": "Pintar! Dongeng dan adat saling menjaga.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "fea6843d896c12b849416e534d3e05da0f0a497e451fea7b64550009c97dcddb",
      "text": "Paradoks dan sinekdoke sering muncul dalam cerita rakyat.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff4455cc5cd01694e586e46827ec6bc7a25960791f7f57670e545412cf36c364",
      "text": "Itulah asal-usul nama Raja Ampat. Empat raja dari empat telur.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 14,
    "clips": 200,
    "chars": 8110,
    "audio_bytes": 0,
    "missing": 200
  }
}
