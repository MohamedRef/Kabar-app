  "version": 8,
  "content_hash": "80a2d726978f79f345acd5c9ad586f26d2649d37e6963cf8d207e408a04f2fa4",
  "lessons": [
    {
      "id": "bipa2.u08.l01",
      "sha256": "89a0aa3d458a0972035ec563389bd3027b7942ed8870634dde0033f6d173ad08"
    },
    {
      "id": "bipa2.u08.l02",
      "sha256": "91707f1b04f5f306e099c9384b72dbaae9359310884e1a657086f4836c3b92ba"
    },
    {
      "id": "bipa2.u08.l03",
      "sha256": "426daa527ca91b6704ad19a0e6bccfff6bae8e1f7cc37023b49534e2bc6aa997"
    },
    {
      "id": "bipa2.u08.l04",
      "sha256": "5e4b99f099a894c268ffc266aa276426c749677521d0aabea00d96b23d6c63cf"
    },
    {
      "id": "bipa2.u08.l05",
      "sha256": "f7fc7b9134d04662db117ef1ddd663f53426d38edf43d467e43ce1aa789984be"
    },
    {
      "id": "bipa2.u08.l06",
      "sha256": "d8266445284a19cf139390182a75295f6fd682700daa22d231eef8a14fe3c944"
    },
    {
      "id": "bipa2.u08.l07",
      "sha256": "810e9c4cffece7710b8639242ad430c1dd22277a49b89534e9e02e135c7e4c7d"
    }
  ],
  "audio": [
    {
      "key": "0089e9819bacaf269e950a033794d3d49d94b72f295e6510ac76bb199bccd1f4",
      "text": "SIM",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "031b0d21fe54be7cfffd735cb9483b9a4e324458c4a8de7d1c0d3a22b33eea49",
      "text": "Lalu?",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "035a40c3d083e5dc1f242bb5e23f44ee865c9610f06fcfe5c5d98c850eb7c301",
      "text": "Akhirnya! Busnya datang.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "04599d90f91087c01350262ddc07d99bf198129abcc5d07784bd260f79a55f75",
      "text": "sayur-mayur",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0597fb202ce513a841d777f69e7a44a55426b33c2afdfd73528e489291d6839f",
      "text": "Tidak apa-apa, saya lihat-lihat dulu. Kapan-kapan saya datang lagi.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "0764ddd17fca438d8ce5e61f8ea9b7da74b04ab5eaba03a8d5ae19b66099afc9",
      "text": "mula-mula",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ae31842bed33885557b99a5ac0a255bc6940edb9577f5303decec0dc8ed467b",
      "text": "Selamat sore, Pak. Saya di depan Pura Ulun Danu, pakai baju biru.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "0efcedfa80962df6a704e2b1f8d3665977933255a3b8aaf76f28cee1972091d8",
      "text": "Pak sopir menyetir sambil bernyanyi.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f4b5767da4db5868a9d1b631a401ccf974f793b52a285fbd36390c35319cda6",
      "text": "Tidak. Saya melihat pemandangan sambil mendengarkan musik.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "10a53736bd94980675a70f33ded14c63da557693d6456acb6a0edf418b144e69",
      "text": "ojek",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c718e0587df631e2b302c7c0b5d44971b2515e3d125924637692b780275ab7",
      "text": "Pertama, saya naik ojek. Lalu, saya naik bus sambil mendengarkan musik.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "160e1cb1ce853122d8998e324c7c4c3471f5ef25c303eb873efc3584c10f5f7c",
      "text": "Pertama, saya naik ojek ke terminal.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "16c0215c92a12de0d07a95104ba6b200e438666ec7a03b05c78543ad775a5e99",
      "text": "Setelah itu?",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "17cd1a6f9b62b14ecd830e63b0ad0b86562d7bf8ccfa61ebe3a2873953541865",
      "text": "saat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b542c097e5e50f769d267bfd601106ab73693ee7fd1d19023801e656507f3b8",
      "text": "Mobil saya mogok di jalan tol.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ed386627b42cbbffcafc027fe8a0894fb40f0d35db54c3b607348fe9f4a40ae",
      "text": "Mula-mula, saya naik ojek. Lalu, saya naik angkot ke terminal. Akhirnya, saya sampai di danau.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "201abb5efec9fa3d2091cf26695f04bf1b5f84a7d06b78b5f781f6b528a34adb",
      "text": "Baik, Mas. Saya sudah dekat. Tunggu lima menit, ya.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "23e6711900b51cf281dfe7c2229dddf56bd12f17a6371a90c7a89543135a5c4d",
      "text": "Ban mobil ini bocor. Ayo ke bengkel.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2443d28f5be349e36e0c235153971f57ca6930ee4b3afd0d05f128bf309e23c1",
      "text": "Pertama, saya naik ojek ke terminal.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "24c778ff10a35bdb845de8c99ff320a6d68d91a0a0048adfd793d44e04601722",
      "text": "Ini helmnya, Mas. Tolong pakai, ya.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b5686d81e1baf02e030f7c105cd2c62b0372d5cab00e539f4cde4b90e330a1",
      "text": "angkot",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "25fc21c0edb7bcd118743e2125e53566a815ced7c20abbf0ed7e1fd59a0c390d",
      "text": "Mula-mula kami naik ojek, kemudian kami naik bus ke Bedugul.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "261150cddd4c53f836ba02f4539c013a6e8654ce47421d68309dc991504f20cc",
      "text": "Oke. Lalu lintasnya ramai sekali hari ini.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "261e38a816e59386b8c5a82f64f9f33be4de87453e2324204281513eaf197708",
      "text": "Mohamed, kamu sudah makan?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "27beca431b6498bcf2842ef8dd645a19bea9f2c39908ff8391bb9a8078046886",
      "text": "Baik. Jalannya licin, jadi saya pelan-pelan, ya.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "29fd0d9f4fd2377e96a444bdbef744ed048d2a8e20397feb7dea52d4ac427a7f",
      "text": "Motornya mogok. Bensinnya kosong!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a78c15d201929f2da4d9bcc6453a185b5f4ca01142ed10c7e85387503c38612",
      "text": "Akhirnya kami sampai di Bedugul.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cad46a60b7defde98476722f627b44589e092b141184e8a9ad3e1056dc8b605",
      "text": "Ketika saya datang, kamu sedang apa?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f2ef689d779017c338750e6e48286f5f3114606091a673e388771a258d212b4",
      "text": "Oke. Saya juga sudah bawa jaket.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "350df1635bb4c5f63517fc17fb2b33f6ecd0f782e98556e07351613620d8a668",
      "text": "Setelah itu, saya jalan-jalan di danau. Ketika saya pulang, hujan turun. Akhirnya saya sampai di hotel jam tujuh.",
      "voice": "id_ardi",
      "chars": 113,
      "mime": "audio/mpeg"
    },
    {
      "key": "37edb3fa11cc72d80a4bda4703fb04594197fc17c19fe20cad432f186397625a",
      "text": "Yang biru, di sebelah loket.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3913150839adec7cdb103f8b88949c9236d0449026563b74c2af2721b9dd879d",
      "text": "aplikasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa7ce1c3af29170ae1ab26bf94c11486a830fc948f204b3107f203ffec3e7e8",
      "text": "akhirnya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aef83d314d8e1a02fdfa86373d42f8d8b6fa453fbb178f23d0d56b6fd3e87d6",
      "text": "Kapan-kapan, Pak. Hari ini ke danau dulu.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d3553958d8adac766357a5028b4bc89b4f152643ba7d48358753f0dd386da40",
      "text": "Di Bali ada pura di mana-mana.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4014d93d573700778f0a54d36b32b131a40db3ea1c488a2835cdc389a0254dea",
      "text": "Busnya bolak-balik dari Denpasar ke Bedugul.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4020a98e2cafd0595831b55f64624a4bf2091e53ec4feec8a4ca68a723674492",
      "text": "Motor saya mogok di jalan.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "42d719eea1b7e62b460e2d6a910e9a77b2df59cbd0d56afb58a204d17cdb530d",
      "text": "Kamu tidur selama di bus?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "42fcd0bafb8222c787d45357a9aa374fff86c180fe59cca21d9afb0821696095",
      "text": "Bagus! Di sini dingin sekali. Sampai nanti!",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b96af22e34fdf3eac3b19552c13b099be33ee29cde5a65f9f7d3a30046c1747",
      "text": "tunai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cfd1282d08e9bfd22c118dbe814deffea072714e4b799d184ac6fefbe185e66",
      "text": "Setelah itu, kami makan siang di dekat danau.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f612ca3c5124b0e963a0057697817a85df51b4c2b19a4d6d954cbf29fc7696f",
      "text": "Bus itu bolak-balik dari Denpasar ke Bedugul.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ff331f5b46173931235cca33ee2e9fa1ba5d765a7d02fb3382a008d94118c04",
      "text": "Selamat sore, Pak. Saya di depan pura, pakai baju biru.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "5007347c8709db0781429a80a1b5e3bccf26daf3bbb2cfe5f016e35bd7bf6355",
      "text": "Bagus! Sekarang naik bus ke Bedugul, ya.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "528cd2e8b3da55d399ccb7fe4359a40cb375cc556ffa8e0d09954dad4d69734b",
      "text": "Ibu memasak ___ Bapak membaca.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "531d91fe8d3329d35092279bcf6bea03d20bca15c442195207342d83e2b8a965",
      "text": "Banyak kendaraan di jalan raya pagi ini.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5411887c66dc12e1becb84a1885ffd3e96d9e3d4d9cf4adaa9c7ef8bc50ba7b3",
      "text": "di mana-mana",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5677f8e906f53c4c49d51ea1d2d25a6014a41c7f8ced369d472ce0dc11f0d981",
      "text": "Mas Mohamed? Ini helmnya. Ke terminal, ya?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bf1be99aefefc2e26e9ada93b52b407684ea02767851c5ba8dd568c6409bf65",
      "text": "Kami jalan-jalan ke Bedugul hari Minggu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ccc21015efb07ec647d6ff4fd6177a992863501d8349374379a27375f2f6d86",
      "text": "Lalu, kamu naik bus ke Bedugul. Busnya bolak-balik dari Denpasar ke Bedugul.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d045f82db1f0b87c10fbd8dcc2b49bc71a4cad505c9b1838e1080a5b7b54dc3",
      "text": "Ke Danau Beratan, Pak. Saya mau jalan-jalan di sana.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dcdcb8b2050162e3a57823984470ab459092333269ee9a55b7afa7a5a7283b1",
      "text": "mogok",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e32246fcb4f1a5b1ee20659d505e5249efdab7602c9d61a64e66210461eb13c",
      "text": "bengkel",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fca5b33f919a4a2815d5c1956273c76bf5b457227fd90dedf7d55d3d511a1a3",
      "text": "ban",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "639653012b2d5d98b0ad00cf54885e334a2a1a11577c31ec599baf3f6b190b87",
      "text": "Bagus sekali! Mula-mula saya naik ojek ke terminal, kemudian naik bus.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6645fc6da70390ab6a0c37f406c19a6b877e675376349455b26facc19d14bf02",
      "text": "Halo, Raka! Saya sudah di terminal.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "676fb17513073e29945f7b7b93e9becab1313a7a4b6674c66ba0275bc8010b44",
      "text": "Lalu, saya naik bus ke Bedugul.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e892c19ce88c69e104ab42ef4c62850024a571dcdfcd2c59112b0d9df713595",
      "text": "Ni Luh, motor saya mogok di jalan!",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e92a2cfeb60e0ad96338cdff2ad389b76d622a98320399a25d57c438f2f1762",
      "text": "ketika",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "71a5c97c3458e7711891ddc783384b9b5cab0c1600858856cfbf403e5df614d0",
      "text": "Di sini banyak bus. Yang mana?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7403413914bd2bd5b50ebd66cdf02ffff58e07f84ab9e35e665ff8a604c4c909",
      "text": "Pertama, … Lalu, … Setelah itu, … ___, kami pulang.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "757aa6020d11c4f5a027d92891bf181605679447df61a8e07869d2a141358653",
      "text": "selanjutnya",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7804c7cceec372ecfdb71ecde8b20418feb69c76ce4f0a09c5f785918804a3c3",
      "text": "Waktu kecil, saya tinggal di Kairo.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b2cefe5af0f3deb9c53e4033ae4df362a9ae46a744718ba0aae344349df522c",
      "text": "Sudah sampai, Mas. Bayar tunai atau pakai aplikasi?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d24fa18b232251707c43fa5ad377884fc58ab12ce190676440d84219d464bf8",
      "text": "bensin",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fe0d056d9d5ddc74a4050d1489b76e681cfd147eca6e4973e1a986aef88eb84",
      "text": "Jalan tol ini bayar, tapi cepat.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "85bc04fd55c2dd2112f223d38268a43fc6530178efd57d27852181c120c6e7a5",
      "text": "sambil",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "87dc2ca01b6b0f3ea57d6bc4591d50e68d73d3e8951eda955b66bfa22ea64ca4",
      "text": "bolak-balik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "87fa3055e485e3cfb96d78b2e3b99d52d9a211df22b72601a6fc9ea9917c30da",
      "text": "jaket",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "89bb6ef5cc126fec956e6fab22370fe8acf3c3b58877058cc52ea7fcee2674f4",
      "text": "kendaraan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a7d1a321b980e5636ebef87403628a05b5a1d72d27fc12b17051cd567b05938",
      "text": "Betul, Pak. Tolong pelan-pelan saja, jalannya licin.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f850b12262bf699da0efcd5b0bbe2a37a5308b56a9805902fb793f88f22397c",
      "text": "Pertama, saya naik ojek. Lalu, saya naik bus. Setelah itu, saya jalan-jalan di danau. Akhirnya, saya pulang.",
      "voice": "id_gadis",
      "chars": 108,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a354218f0ccdefc37aad23b71ef9cce5b9dd6c48f32bc3fca16116b340cb59",
      "text": "danau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "913bb5808d01169219288c3e9272870e647c307b11451cd52db1b6487be13803",
      "text": "Ibu memasak ___ ayah membaca koran.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "91e91e296754eb963adc81543b41099ae562f8da7e68b4b05b4b75766d512fcb",
      "text": "Angkot ini ke terminal, Pak?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "9795db09a47fe5bfa21ee856de81a0503d1b5989db68e65fcd52684b235e0bb8",
      "text": "Bensinnya kosong?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "98d1b9740e4cc0a83de1d258f747c91c679e8636485411077e23f45c2e6e948a",
      "text": "Tunai saja. Ini uangnya. Terima kasih, Pak!",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "992b69414ecbf1f66cf3813347b4151cc4daa539d319f5808331cda024a05d2b",
      "text": "lihat-lihat",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1ab26d9bc613caa8aa834c1324952089fdc6e0b2a20cfb70688f6691c35ea56",
      "text": "Selama di bus, saya tidur.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2396126055ae8927c2a4c7672ae1984658390fac40b8e81c07db192aec842fc",
      "text": "Lihat-lihat dulu, ya, Bu.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a81ebdcf646f013a6261747223940b9a76ece788a2ab1674d5a2754dd01fb9cd",
      "text": "dingin",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad9f660a43ee5c1164e34dff6279fa0274d5c0677d3f90a07fe743c38f50d5cd",
      "text": "Mohamed, kamu ke Bedugul naik apa?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b03cd5ce40a250b384c839edf0d65b5b2c3ed205ae1274773d37bb468e43f0f7",
      "text": "Saya membaca ketika adik saya tidur.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b13fc141b82ae5ed55bc19e6dd893f31e2a1d8ead800952e22580325efa895a7",
      "text": "lalu lintas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b195b0a3e4a5b94936ec8361853113181b5f77746da44c698b62a0cd81dd0fe3",
      "text": "Pelan-pelan saja, Pak, jalannya licin.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1f8aee835a37f198a15ec89b57e60d35d4bc834bae49171623a4b91a19b7542",
      "text": "Akhirnya kami sampai di hotel jam sepuluh malam.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b22a11a36ed78e88a53e7eae0e07b472a53177de4f1e951d056698ce4b39b07c",
      "text": "Mas mau ke mana?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b36af9aff265d25b31b3a486a7fbdc635cfb0333f48b39f9b2726550e357353c",
      "text": "Tidak apa-apa, Pak. Pelan-pelan saja.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5376912afeb085aad1bb30729148b92cb179392ad3c72473a0ff7227606b11e",
      "text": "menyetir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8510f2c04af9f3b6df931a2648d6aa4ce5dda67b17d9a674397cb2b45b945eb",
      "text": "Ketika kami sampai, hujan mulai turun.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b97359de8fba97d0457a112c431fc912a8ef14f01078ba3520cf7f0e9a1afe2d",
      "text": "Saat Pak Sopir menyetir, kami bernyanyi.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9e1c27e16e5fa2435592ba7583cc4e3283f57acc5a378c4a822e1c62c0c9c06",
      "text": "Tiga jam. Akhirnya saya sampai jam dua belas.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd32a3815a7e30219f57584be93237e492f5e996044a410100cd74c34847e127",
      "text": "Halo, Mohamed! Bagaimana jalan-jalan ke Bedugul?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf599457e8a364af80531ee211cd79237d055d2c28dbbfb8a905dbf1dcf6ab68",
      "text": "Saya mendengarkan musik sambil naik bus.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c239f820e377ed6f0f47f5fdb06f12b42273153c70c5ec600825fc7194cc0852",
      "text": "Lalu, saya naik angkot ke terminal.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c25a0674bf951c7f40cc727f323314ba1669b97678ba9eb1f65b9b758e38f25e",
      "text": "Selama di bus, saya mau tidur. Boleh?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2edc60ccacfb00ecdd46f53131f45aba64bc542c91489a92c06693e9c6dbbf4",
      "text": "Mobil minum ___, bukan air!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c31f40d9fceb9e8f08280d87921b6cce6be2ee2139ffb18f6ed477992c0a1886",
      "text": "kapan-kapan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3c83ed1d6e81a18faf30cdefec5ac55ac3b84b3ba71490e189b915c768640fa",
      "text": "Ketika kamu sampai di Bedugul, aku tunggu di dekat danau.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3fd7bf22ebced0c30619d49f01ca8409147b43959be30e83f9304c091005371",
      "text": "Lalu, saya naik bus ke Bedugul. Setelah itu, saya jalan kaki ke danau.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9cde01219bafd5275f6b1b315b18ac395033bbb3acd538b483bd8d9dbba6992",
      "text": "Saya mendengarkan musik sambil melihat pemandangan.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb9626a2b1f9e4694df21dc545eee72ec46eb8a055543eec370ae079189c425f",
      "text": "Pertama, kamu naik angkot ke terminal.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca67e231412714fde03abd6c8806766d7d9b8595fe2d8c42a83cdfcb292620c",
      "text": "helm",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdfa6df1baec1bd0854743ebf66e6dc4536fd88e81bdfe230df24cc54416755d",
      "text": "jalan tol",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2310804fdaeae7e8bbe3914af76b8d6e1e41950936f711709240a611a89e962",
      "text": "Tidak. Bannya bocor.",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2ecdcbb98b5088be982123b28342510dabc122370b994349fb371631d405816",
      "text": "Saya baik-baik saja.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d67046845cb955171fe392f54accd404f05e2c53d8afa61f2dac95147ce2e76b",
      "text": "Jangan lupa bawa jaket, ya! Di Bedugul dingin.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d966c952ebe5bd758d0e1e5edaae02aee3afb96845a6d341cdd03650be04afaa",
      "text": "Ada bengkel dekat kantor pos. Bawa ke sana.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbc98f1628b057a9545c33a93ddd3e27eeadea10b5c41c8bee0fa95760e6f99f",
      "text": "Di sini ada pasar sayur-mayur dan buah. Mau lihat-lihat?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "dffa14be69b872027d18257f59c950ab1ce8ee94bed3f14e8a299aee2c2c11ef",
      "text": "Hati-hati, ya! Jangan lupa SIM-mu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e25deace395de1bc462b4c96700cda00e48559d16ac90fcafcaa646dabe5749d",
      "text": "Berapa jam di bus?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e32a23d1eebe9ba7fc8f6700147fd28e961c3d40dc4c072fd0fb2c102c8e7d0f",
      "text": "Selanjutnya, silakan beli tiket di loket.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e53347c4f0d96093054b2aa59ccf50c5eb597b1cb176f829336c33a90a32c1a7",
      "text": "Tunggu lima menit, ya.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea8dadf0f6d9e651bd6513a892828f4e9adfdf9ca2b543707ff793f515abaf2b",
      "text": "sopir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5c5f7eb7d2c48393f6c402bbd36e2c16414a1d748ab438d2900fc9e1675250",
      "text": "Maaf! — Tidak apa-apa.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0d1adff2eae60228965300578a7d3de9c84fab54dcbc1cd7b1a0354f1e3eaf8",
      "text": "Saya di depan pura, pakai baju biru.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f10a83ee67aaaaf027c7ed37ff6e05b217280cfe40d999e4e313d6768885e5da",
      "text": "Boleh! Ketika kita sampai, saya panggil kamu.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f113e0c48f52cbb590fe215c2d38c0f275402ef97c9e7c44ded5e5a241de04e2",
      "text": "Saya bayar tunai, ya, Pak.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f44eedffaa900ce5ddabb451ce2fb8e2410b36a92d86b5d1f7b106e7de91efd7",
      "text": "terminal",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa9f155d3c90578e5b82100b6bb8cf27eed1d6362c0a57c209f794327a843c4f",
      "text": "Kapan-kapan kita jalan-jalan ke pasar, ya.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fee82c609e12028978a313428ccb0b9eb256ae559c114f956adaa2e0a0484d54",
      "text": "Sudah. Saya makan roti sambil menunggu bus di terminal.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    }
  ],
