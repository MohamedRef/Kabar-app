{
  "format": 1,
  "id": "id/bipa4.u04",
  "language": "id",
  "unit": "bipa4.u04",
  "version": 1,
  "content_hash": "ea05cbd057a15b80ccdad1909e49f607e7a0c92cd3fb00bd2b87afc1ecaea4ba",
  "lessons": [
    {
      "id": "bipa4.u04.l01",
      "sha256": "9d002fc5fdf90f11d76717a74d1654db44635345bf7843fd05e7c0f68d093969"
    },
    {
      "id": "bipa4.u04.l02",
      "sha256": "55ac1ee82900773c7ccd324a9d490a298fdff888acce87599e8230aaac6054cb"
    },
    {
      "id": "bipa4.u04.l03",
      "sha256": "93034a6ab5986091f0d3091212d93ca706fccdfdc894060c7ea1052581163c57"
    },
    {
      "id": "bipa4.u04.l04",
      "sha256": "cc7af4017f475222692ad97c4574e070170d958e621b5a1cb49544c1128e7920"
    },
    {
      "id": "bipa4.u04.l05",
      "sha256": "25343178ad0ca3f7b7dc605b46b5bfe2f9ebfce14b00da56a938d65a72852326"
    }
  ],
  "audio": [
    {
      "key": "0065911baabb6546e5e55979f4488a04dd6fbadb398f554b18a7cf3c5ab55a61",
      "text": "deras",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0308b80ba71328c2420f5720c5eab8c235d7385a0373e4f1041a70571aff7e47",
      "text": "Iya. Semoga kebijakan ini berhasil.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "036090861d1873f2f34843c8062b172a6eb3d58eef4deec3382f8d9823372df1",
      "text": "Apa yang terjadi, Kak?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "06ec73c81e0ff9dfd7c71cdac1a46a0c76f14345fcee00495a0c910d24c826b2",
      "text": "Tanggul rusak. Akibatnya, pasar terendam.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0894b58ed84ff4c42ac8b3596c53441e774d185af44cad83cf3dff3ca80c0ebd",
      "text": "Gara-gara main HP terus, adik saya malas belajar!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "08c3f3e2cb0c99f138ebddc257fc2859ad69ec057524d1c7f414d3fe3fc14263",
      "text": "Mohamed, coba baca berita daring ini, lalu buat ringkasannya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a0b8ad38e52e343538fd43014cb53bb1c3cd66b43d6db6bc4a26e2173aed007",
      "text": "menolak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d6550d376dc99d5db67e0a02f840def7af0d1b915a7b151b9b650358e31595d",
      "text": "Sudah. Menurut wartawan, saluran air tersumbat sampah plastik. Akibatnya, jalan terendam.",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "0de85274b23fa379e96fa45e1c1bc505e3f9922f87b2bb4c3767d63064664c7f",
      "text": "Kebijakan ini punya kelebihan dan kekurangan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eaef62936eaad6e210003a8f31acf698cdee2db67a792f89312075e6f998963",
      "text": "Gara-gara macet, saya terlambat.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "123151c83b98b737d9b597336315993639662ffb0292c0797cf577517557dc74",
      "text": "Sekolah di Parepare melarang siswa membawa HP. Bagaimana pendapat kalian?",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "14610a5794f89a8d8ecc2a3c7fdc1fa56cad89e526345170a0b6f98436714d5e",
      "text": "Tanggul di dekat pasar rusak. Oleh karena itu, pemerintah harus segera memperbaikinya.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "161c4aa831c3d8d77981acf0fdfb7629326f0da19916e79f38930c7bb7b60514",
      "text": "mendukung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1667809acbc4a56fb95cb2d1c055dde1410c07ae710364e2d215702fc3aa1e34",
      "text": "Itu kelebihannya. Tapi ada juga kekurangannya.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "16e645aeeb8d3873aa7997f3be8fcaf12508c8536c107fe59349ecf7bf9d9d81",
      "text": "Menurut narasumber, banjir terjadi karena tanggul rusak.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "19a0b2bd8e603070e6e5a02e14863eb7bfe7fb7f6867c596dd079ca81d8b7bc4",
      "text": "mengungsi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7169c2621751d44acfa790dfefb39331cf756e0186e076d253813c946b4d50",
      "text": "Berita hari ini, pemerintah daerah membuat kebijakan beasiswa baru.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fa29154572946a0f06959dbcb89dbbe25d4ce319cb9c20701f7d828ecb95e34",
      "text": "Jadi biaya sekolah menyebabkan masalah besar, ya.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "2431070df4000cafad74e4ffae5a9d1b17df3f6fe4580e1f1c66b5a19e86cbd6",
      "text": "Berkat beasiswa, Andi bisa kuliah di Makassar.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "28f9c0705d6bbc0cf135b44f0c52cd3d29d60963fc528a33978fa019a41ed183",
      "text": "kekurangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ae6a464a63820d41c975da16da01f20c63cf6d617dfcc4cf1dd681eda7f4c8d",
      "text": "Apa kekurangannya?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2be937ca396f2b9e172e75ff1151bbb85b1fdd1bd36773c9b401180cf97bc682",
      "text": "Tanggul sungai rusak. Akibatnya, pasar terendam.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cf0b8b5f42408ba02839fecea577aa9d5b20383986c34b9282949c9873c005d",
      "text": "Akibatnya, rumah-rumah terendam?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "32f24fedc4ce32157d29536a68e582e3229c7aa7d300ebac122b7696e7210d3c",
      "text": "Saya mendukung. Berkat kebijakan itu, siswa lebih fokus belajar.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "33d14639f1bac52b41d6c89b9a91b6b326999d6b5b774d4e5d6b93fa88f30bab",
      "text": "beasiswa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6645e9fc6c860383f37e442b6fedda233d59ff2d22bde221a0afbe214d66b3",
      "text": "tanggul",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c612d4ca921e1f1974847976d085a27c8eac00f5bbbbcb30ee238776782e044",
      "text": "judul",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cc28adae75b1756410c49c094306f89e198a9e943c41a2ff738fbcafe4c21dd",
      "text": "Karena hujan deras, acara itu dibatalkan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "41ab2444fed8fa49c9fa51bf9545922700a56dc7bf8e19babdbad6ba9362c97c",
      "text": "Wartawan itu melaporkan berita dari lokasi banjir.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c5ce3d957f7e1bcc0cacaadf162b9401c74d301b2cae61f72a75a894693fe6",
      "text": "Saya mendukung. Tapi pedagang kecil mungkin menolak.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5694e240c719dbde02c12f44fe123010df6f612c32c423db975dd823bc798878",
      "text": "dampak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bdc10749841b446f21a5109115149077726d525f1e74f1890b52f3bcfed659a",
      "text": "terendam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6444b7b72e03f1d9fe8901976fccaabd0b53c9138b6cfb6f1ac286ad37c7bdb1",
      "text": "Wartawan melaporkan banjir di Parepare pada hari Senin.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "64d0aaab47a93957f9337a73d37c578d175884d89d514ae79b77029a577fd24a",
      "text": "Hujan deras turun semalaman. Akibatnya, puluhan rumah terendam.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "6794009a6d510d1c805db77803958b027e7c9d62c0aaf8f1bd11ad2c19676a0e",
      "text": "Ketua RT dan seorang warga. Wartawan kami melaporkan dari lokasi.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d6737fed2edc3345c4227e025f0976f58827d59bc51bf4a6e8cbe17db8499ee",
      "text": "Baik. Hari Senin, puluhan rumah di Parepare terendam karena tanggul rusak.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "787f9d8c06bb9d7cc37e6fc249f87e9da85f3908713af3df0c8f143b2de6fa55",
      "text": "Oleh karena itu, pemerintah membuat kebijakan baru. Kantong plastik dilarang di pasar.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "794cc8b229dda8b6224aa16a158d6163470a191ae91983bae7ca99ae291e67bb",
      "text": "Kemiskinan menyebabkan banyak anak putus sekolah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bee82e7e75a93ba1c734ae1f12974783f1afa4ed8ead841bbb0ffb279ae3272",
      "text": "Di satu sisi, kebijakan ini punya kelebihan. Di sisi lain, dampaknya bagi orang tua cukup besar.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dd287e07b048d0261d589a00f5f8a57b802e9de33b46059abdfaff441635acc",
      "text": "Kebijakan baru itu punya kelebihan dan kekurangan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fed4e8b5613203ad87a027b34900dfaa28bd3a81a71472871c950100436aaec",
      "text": "Di satu sisi, siswa lebih fokus. Di sisi lain, orang tua sulit menghubungi anaknya.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "80745904d54f011be929a345a413f35551af60c0d2c01fa93822663d273d0061",
      "text": "Air sungai terus naik. ___, warga harus mengungsi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "86038ea2677def07ae3709f3dc320606fc048b95fb584679d5db06ad1ea55923",
      "text": "Judulnya \"Banjir Rendam Puluhan Rumah di Parepare\". Siapa narasumbernya?",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "8af3a0d40a5cf3cbbd785fa2e56ed8f67cc9a2a93891c344f008ebda18c486c4",
      "text": "melaporkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f798c6a90b002819b026f2a7de0bcaae2d14e5d798933d72082de2649efb59",
      "text": "kelebihan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "95714e37573099af79c3f7a995880709d18696b9e1e8e293f6623efb05a058c5",
      "text": "Di satu sisi, saya mendukung kebijakan ini. Di sisi lain, dampaknya harus dipikirkan.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "966d67e4a55af75690be1bc14f16a82d45f74399e65a74ec3d09ebd9d183fe62",
      "text": "ringkasan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ebe32a9c6d0e08351f097dcfadd82331daad26d8b50a1b97eac2fe776b1baa5",
      "text": "gara-gara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b4d3e1ea45cf5d12f53885f44b1527430fbe352f0c17c131e8de3bb97b89d5",
      "text": "daring",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a488ea2b91f0fe51282ccaad89073606aa6947a67a8d46f7181535318f49b0ff",
      "text": "Orang tua sulit menghubungi anaknya. Akibatnya, ada yang menolak. Oleh karena itu, dampaknya perlu dipikirkan.",
      "voice": "id_ardi",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "a73d407b86cb9684469acfb79b588991125529e14980f37e7fa6ae57d01d9802",
      "text": "menyebabkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8684dc3786fc0cd6fa1dc270786986f7d7e531059b849210326cf3f08702b79",
      "text": "Itu dampak yang harus dipikirkan. Berita yang baik selalu melihat dua sisi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac5fd9439bf4dc71f091eb37a100c7badcfe0fb5ee96f0aae910d1b8ffdad8c1",
      "text": "Air sungai terus naik. Oleh karena itu, warga harus mengungsi.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b079ebff478e35aa26c41c3633ca17be14e3e0bcaf058dfa5c30b72d6f0bf578",
      "text": "oleh karena itu",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b30caccbd300916b8345b5cfaa959cbc458c0ef757e311bde6988f466d62bab6",
      "text": "Betul. Dulu banyak anak putus sekolah gara-gara biaya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b39b1e30678ffdd56983895d5b782d9abab6faa6bb8fdbec4126766384b2960e",
      "text": "Oleh karena itu, saya mendukung kebijakan ini.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b41685a85cc2553228b09ac4219c4905b27a725dc56dfacfd14d2dd9d44b17f3",
      "text": "Menurut narasumber, ratusan warga mengungsi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8249ac75dd2e4377dd308f8ac975a59a6087206ae8f0ab8aab7351a30048438",
      "text": "Hujan deras turun semalaman, dan tanggul sungai rusak.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf090279bac46f16a7f0341d45fab8c28d8d7fd221ecb02a7e02de542e0841e",
      "text": "Bagus! Berkat beasiswa, anak dari keluarga miskin bisa kuliah.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "be9777ebc8fdaff32c584d1b2bece4227b1938ff894a256b9a4329a2d67db57d",
      "text": "kebijakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c10e0cf21a916a492538d4aa2689ebec73dfb9caf26629975707475125c878e6",
      "text": "narasumber",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3c93d46c622ee80e94dd5fe44dbedeb48eca5ef171a83b633b226960c37ad90",
      "text": "Mohamed, sudah baca berita banjir hari ini?",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c50ad9f1893ef3d02380d4bc7860caa133fc9e51326e271bfae4133abf3e29c4",
      "text": "Mohamed, ada berita banjir dari pinggir kota.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c80012affc5f3de202805e9cc163a87f129e938bb6404310056beb1b2e077db2",
      "text": "akibatnya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccc8c26f1e74d3adf7cf8c84593fa67e9a948f0ff2013cdb383d2e741de5a693",
      "text": "Judul berita itu menarik, dan ringkasannya jelas.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5f89742d4feaa0cef26a3a6c5a2e410aa95c4a18de0b6c5bc986fa6637bb8c4",
      "text": "berkat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "de37fae4e4c0284764f6e3a7b39ff688b5fb1c21df0b3efb029c1b7c354539be",
      "text": "___ banjir, sekolah ditutup.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e76bd5c72233c5fee44307495b3ccd0ac870e2993bb86c80b7350169695a60b7",
      "text": "Banyak orang tua menolak kebijakan itu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f75419af6ef498850818073788157d95bc7b741350717af2540631ebc38a197a",
      "text": "Ya, puluhan rumah. Oleh karena itu, warga mengungsi ke masjid.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
