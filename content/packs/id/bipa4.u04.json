    },
    {
      "id": "bipa4.u04.l02",
      "sha256": "8d5bbc7027a9aa78b3cb6c3f6cb8290e1edbe291fac0fb609f559571aafcaa70"
    },
    {
      "id": "bipa4.u04.l03",
      "sha256": "d0c36dc21e7f592803844f719dff0471752324506dd0a45ec72c04ca986fe4d0"
    },
    {
      "id": "bipa4.u04.l04",
      "sha256": "7288dc019f8fae9d89065d544747bc85130b9a735b50c3187f0cc71dbf058036"
    },
    {
      "id": "bipa4.u04.l05",
      "sha256": "8b9ff3c952cc238d69ec0f99ffefc4f8ddadffd1f49c5798ed3235229cb1760b"
    },
    {
      "id": "bipa4.u04.l06",
      "sha256": "9decbdb845248031cf3f92c6e72f556864a96282f1c53c18a634bb7ab116323c"
    },
    {
      "id": "bipa4.u04.l07",
      "sha256": "17e940b863ad9d2060bbeba3bf7d26fd2da855e3bda61043a62d59e911760efe"
    },
    {
      "id": "bipa4.u04.l08",
      "sha256": "883900d9d317f99cff9d24f1431887e3019f30d3d02627fa39551d7c9f6a5a63"
    },
    {
      "id": "bipa4.u04.l09",
      "sha256": "ca7d7a3873ab48ffefa006ca0fd2f3a9f6b27c950027ed4ac54a7f86176f6960"
    },
    {
      "id": "bipa4.u04.l10",
      "sha256": "33b22a4b8e237a8196a4c23bea1446537759dbddcd2aa2906282629f62e317ea"
    },
    {
      "id": "bipa4.u04.l11",
      "sha256": "42b793b3f648455a82a56b52f237b470d10d0ee2840bc165e7778d4a0acc2692"
    },
    {
      "id": "bipa4.u04.l12",
      "sha256": "673b6d884b5089d63c651fb5918c270617365b8713e73fea4146961843767c16"
    }
  ],
  "audio": [
    {
      "key": "0184fd6879777e966ebb242c8ac378347b484b4bc42b0f5d39615aece64ffa2b",
      "text": "Mulai tahun depan, pemerintah daerah akan memberikan beasiswa kepada seribu siswa.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "0308b80ba71328c2420f5720c5eab8c235d7385a0373e4f1041a70571aff7e47",
      "text": "Iya. Semoga kebijakan ini berhasil.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "035237e9ff288d2dc5515d3be8e3954d75f271c4086b6148326bdcc4a96d35a1",
      "text": "Mohamed, coba baca berita daring ini, terus bikin ringkasannya.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "05b4e10814e3df9e80b835786f8e64435c23faa970631eb1aba530e5cb0837be",
      "text": "rumor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "06ec73c81e0ff9dfd7c71cdac1a46a0c76f14345fcee00495a0c910d24c826b2",
      "text": "Tanggul rusak. Akibatnya, pasar terendam.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "07d0dec59166730f6d45815c96e52897dd2f268312b23b76fc95bd161c5b329c",
      "text": "Ada apa, Kak?",
      "voice": "id_ardi",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "0894b58ed84ff4c42ac8b3596c53441e774d185af44cad83cf3dff3ca80c0ebd",
      "text": "Gara-gara main HP terus, adik saya malas belajar!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a0b8ad38e52e343538fd43014cb53bb1c3cd66b43d6db6bc4a26e2173aed007",
      "text": "menolak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bb0bd31e3059723f5b254e1c80bcaad44c09ac1b20582ea048ca0d3e65a1fe0",
      "text": "Setuju. Pembaca yang baik melihat dua sisi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0de85274b23fa379e96fa45e1c1bc505e3f9922f87b2bb4c3767d63064664c7f",
      "text": "Kebijakan ini punya kelebihan dan kekurangan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eaef62936eaad6e210003a8f31acf698cdee2db67a792f89312075e6f998963",
      "text": "Gara-gara macet, saya terlambat.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "10f0994b51dccb9e30306ad41e5bc59b47548be6d6bcd1e922a705662f5f4414",
      "text": "Wartawan itu menyelidiki insiden di pelabuhan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "11e4554dce300d84e31707e540ab7d927800d4035bab5ca213bf44f7996ab7fb",
      "text": "Mohamed, udah baca berita banjir hari ini?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "123151c83b98b737d9b597336315993639662ffb0292c0797cf577517557dc74",
      "text": "Sekolah di Parepare melarang siswa membawa HP. Bagaimana pendapat kalian?",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "130ebbec1abd15161bb6cf49687cd65eb9dec45fa69afccbe411f15842fb45ec",
      "text": "Iya, lebih dari dua puluh rumah. Oleh karena itu, warga mengungsi ke masjid.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "138be4df48b8422d79b79c9efb048a890adbc10cc76bb03e36d6abac4c0899a6",
      "text": "Ada. Mereka akan memberi pernyataan jam sepuluh.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "161c4aa831c3d8d77981acf0fdfb7629326f0da19916e79f38930c7bb7b60514",
      "text": "mendukung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1667809acbc4a56fb95cb2d1c055dde1410c07ae710364e2d215702fc3aa1e34",
      "text": "Itu kelebihannya. Tapi ada juga kekurangannya.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "16e645aeeb8d3873aa7997f3be8fcaf12508c8536c107fe59349ecf7bf9d9d81",
      "text": "Menurut narasumber, banjir terjadi karena tanggul rusak.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "18db6719b4c5d79131e4b613dab0ec54237d9de378379a9fb58b9073030af315",
      "text": "tuduhan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b96eca1e3a3166515dcc607014658bfc9530427225a76b4b342fa7ea03dde28",
      "text": "topik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7169c2621751d44acfa790dfefb39331cf756e0186e076d253813c946b4d50",
      "text": "Berita hari ini, pemerintah daerah membuat kebijakan beasiswa baru.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e1b16047916498d7acfcf38522aae8629ea3e87df6559fe7094ea5e682e851e",
      "text": "Wah, adikku bisa daftar! Dulu temannya putus sekolah gara-gara biaya.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fa29154572946a0f06959dbcb89dbbe25d4ce319cb9c20701f7d828ecb95e34",
      "text": "Jadi biaya sekolah menyebabkan masalah besar, ya.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "20bb61ba7cbacbc72b51b6dadbd1645ce94eb612ebfbc543a62625385c69d816",
      "text": "menyelidiki",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2431070df4000cafad74e4ffae5a9d1b17df3f6fe4580e1f1c66b5a19e86cbd6",
      "text": "Berkat beasiswa, Andi bisa kuliah di Makassar.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "26e053a13737ac879b279976845a86da760b4223260d22aad57fd7f5a9e0833a",
      "text": "Ilham: Saya menolak. Gara-gara tidak membawa HP, anak saya tidak bisa menghubungi saya waktu pulang terlambat.",
      "voice": "id_gadis",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "275d65787fb79e17fcd3b5f5acc14b8d26e2b49cfbf8d324f8e93da860bd39a1",
      "text": "Kementerian Pendidikan dan komite beasiswa. Nama-nama penerima beasiswa baru dirilis.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "28f9c0705d6bbc0cf135b44f0c52cd3d29d60963fc528a33978fa019a41ed183",
      "text": "kekurangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ae6a464a63820d41c975da16da01f20c63cf6d617dfcc4cf1dd681eda7f4c8d",
      "text": "Apa kekurangannya?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2be937ca396f2b9e172e75ff1151bbb85b1fdd1bd36773c9b401180cf97bc682",
      "text": "Tanggul sungai rusak. Akibatnya, pasar terendam.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cf0b8b5f42408ba02839fecea577aa9d5b20383986c34b9282949c9873c005d",
      "text": "Akibatnya, rumah-rumah terendam?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "32075eaeb16b720c786789be7d05fbab4a8c88752f269a31fc51afb4a655aa6f",
      "text": "Selamat! Tentang insiden di pelabuhan itu?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "32f24fedc4ce32157d29536a68e582e3229c7aa7d300ebac122b7696e7210d3c",
      "text": "Saya mendukung. Berkat kebijakan itu, siswa lebih fokus belajar.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "33d14639f1bac52b41d6c89b9a91b6b326999d6b5b774d4e5d6b93fa88f30bab",
      "text": "beasiswa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "346e4dd8503938d2f4d018896d254640f9b9415dd7b7a2c99fa44294d5426613",
      "text": "Investigasinya dimuat di website koran.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "348d2ae71ab8499f139e9a0acf606717152889b522a07eca16e6739245ef0bdf",
      "text": "duta / duta besar",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "35a5d709812f35e3e0815aa7e7b900bd7e28d09c69174f2f377c38205655d4b9",
      "text": "Topik apa yang paling kamu suka?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "365be2502f7324b32df81328f54d09a50ce9e48b57df3fec4c01406bff70420c",
      "text": "Menurut pemerintah daerah, setiap tahun ratusan anak putus sekolah karena biaya.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "37788d689dbf475c22e79131e4cf6503cd7085c110e056a576432b5e818d4d30",
      "text": "Aku mendukung. Tapi pedagang kecil mungkin nggak setuju.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "39956ee03ca039e0be235da241dd2218d17e9d55b4d595a9cca9973cdfa93851",
      "text": "Tanggul di dekat pasar rusak, maka pemerintah harus segera memperbaikinya.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b79e21d3c381a0332a92e2a57d9a1b1a77d70665136d185a1314fa85aaabe7",
      "text": "Berita soal HP di sekolah dapat banyak komentar pembaca.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6645e9fc6c860383f37e442b6fedda233d59ff2d22bde221a0afbe214d66b3",
      "text": "tanggul",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c612d4ca921e1f1974847976d085a27c8eac00f5bbbbcb30ee238776782e044",
      "text": "judul",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ca093446ec823f7f5a6f594d113147e23407614caf95ed29af89305ab90ef25",
      "text": "terus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cc28adae75b1756410c49c094306f89e198a9e943c41a2ff738fbcafe4c21dd",
      "text": "Karena hujan deras, acara itu dibatalkan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f46eb64b20efc287372c4139a700fbb1b59f1fb0ea5cf1195b342103e2d054b",
      "text": "Berita yang baik harus akurat.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fb94a9bbc666971549f74d26afbda5c7f6cec0adc6275df03f2f7e9d73d1b2e",
      "text": "Duta besar Mesir membaca pernyataan untuk mahasiswa.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "41ab2444fed8fa49c9fa51bf9545922700a56dc7bf8e19babdbad6ba9362c97c",
      "text": "Wartawan itu melaporkan berita dari lokasi banjir.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4277b214eae45978d9de82e51bb063891d996c979003ec7c31309affcbfcd0aa",
      "text": "pers",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "42fea836bce6be9f96dc1ec20b7bd0d6b26c52e9c8ae8d6d209ef25246cbd81c",
      "text": "Rumor itu beredar di grup WhatsApp keluarga.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ff7c02abee138b705fc569c046bc33c75310793044b083497092a3d1ae9b6c",
      "text": "Otoritas kota mengumumkan pernyataan penting kepada pers.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "431668786f98b697f01c6390e1afeccc9ad46a2da614bcf2391ba2d822134948",
      "text": "investigasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "4455610d411df968763be036b3bf52199d632a9ff1ef451c965c75316a42b504",
      "text": "terungkap",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "49450b174447a054823bf4b7b7d2e985555b7dc1220557792fbfb6f2f6d1b20b",
      "text": "Akhirnya kasus korupsi itu terungkap.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ad0ee42999424d395a22c2661fa6b4996c0f8cd1225a58f588674e2af3570a3",
      "text": "Berita insiden itu dimuat di website dan blog.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b4ea0a02708e6529d012ae4ae02859a6487cd37c0176a341103ece74ff8970d",
      "text": "Pak Yusuf: Di satu sisi, siswa lebih fokus. Di sisi lain, sekolah harus membantu orang tua menghubungi anaknya.",
      "voice": "id_gadis",
      "chars": 111,
      "mime": "audio/mpeg"
    },
    {
      "key": "526b830340242270707381e760b96d28f712b1f4d9b1ece5b3ccfde08c965565",
      "text": "mengumumkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "530cd66aad4944cda2851aa72accec711c8828e8d67f2946e32f18aaeb9c5185",
      "text": "akurat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5694e240c719dbde02c12f44fe123010df6f612c32c423db975dd823bc798878",
      "text": "dampak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "57db221826e83c110c0eb3efec4699aa9a5dbcd9277da5b356e588fe131cfe2f",
      "text": "Mohamed, ikut aku ke kantor kota yuk? Ada pengumuman penting buat pers.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bdc10749841b446f21a5109115149077726d525f1e74f1890b52f3bcfed659a",
      "text": "terendam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c03fbe805e0aec28eb5da82cefa9d0da87c6c8c37b24576fba92949a9cbf584",
      "text": "blog",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c07082dd3268ef0c70d70400b306d71223a9029908602d30237e772f41f7b67",
      "text": "maka",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c0a800d704618955a6728314228bfa965e5f0915a0ed29ca1fbe8d6b90d9f5a",
      "text": "Jalan banjir, maka sekolah libur.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d69d21d2394399a347d61e55ba297dc218de03984a53a76896da593d2be227a",
      "text": "Faktanya, tidak ada gempa kemarin.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ddd74bab4f91828177797af48199675f77f21e889788bb289997b9f2b138d20",
      "text": "tersebar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ffef0ba991a0e46867710539dfa9622e3bce655356904d9fc3c3ff56bbcd7ae",
      "text": "Berkat kebijakan ini, anak dari keluarga miskin diharapkan bisa terus sekolah.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "6444b7b72e03f1d9fe8901976fccaabd0b53c9138b6cfb6f1ac286ad37c7bdb1",
      "text": "Wartawan melaporkan banjir di Parepare pada hari Senin.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "64d0aaab47a93957f9337a73d37c578d175884d89d514ae79b77029a577fd24a",
      "text": "Hujan deras turun semalaman. Akibatnya, puluhan rumah terendam.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "64f247439371fe0f1c7b23958bf67dbea318b9b11511833f9ced02ff46482e56",
      "text": "otoritas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6794009a6d510d1c805db77803958b027e7c9d62c0aaf8f1bd11ad2c19676a0e",
      "text": "Ketua RT dan seorang warga. Wartawan kami melaporkan dari lokasi.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "698a1523b1ac498f248129b6193ed8ba5488d563dd62f4facd95d8c79b19584b",
      "text": "Komentar Pak Yusuf. Dia melihat kelebihan dan kekurangannya.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a0f63e05ccb2e4b433e63af18905f9dca7751182f632ae20ff3974fdcc1fa6f",
      "text": "Isu lingkungan sama pendidikan. Tapi beritanya harus akurat.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c6d6981a277d6f7c2446b60550289b1f8842162851e7e1b68689693a0861fad",
      "text": "Mohamed, udah baca berita Pasar Lakessi?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d6737fed2edc3345c4227e025f0976f58827d59bc51bf4a6e8cbe17db8499ee",
      "text": "Baik. Hari Senin, puluhan rumah di Parepare terendam karena tanggul rusak.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ef0b7f9bd9f4081edf9fdc8f2367e8e5fff1db26f4d09efb87ed81247081e85",
      "text": "Mohamed, kamu dengar siaran radio tadi pagi?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "708e2a58265f754fda58c4ccc3a12a6042b0e46e950ada57041f3046404b7618",
      "text": "Hujan deras turun sejak Selasa malam. Akibatnya, Pasar Lakessi terendam air setinggi lima puluh sentimeter.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "70abd95c46397924daa5f7ceeeeff5807be721eec08983af4bea03bd90aeb7af",
      "text": "korupsi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "73c45483b3c70c26cfabc7ea6c82a16e945ebc7662ac2e0074e0fc0d4f484256",
      "text": "cetak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "75991795af662a1ff77c17d0384f9c0ffc818f00bd0be30406a8eb69b8f85fb0",
      "text": "Koran cetak makin sedikit, berita digital makin banyak.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7775479fc08029ddd932e19ee403cf3b136df202877ccdbedc01f46751d3b8f7",
      "text": "Air sungai naik lagi. ___, warga harus mengungsi.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "787f9d8c06bb9d7cc37e6fc249f87e9da85f3908713af3df0c8f143b2de6fa55",
      "text": "Oleh karena itu, pemerintah membuat kebijakan baru. Kantong plastik dilarang di pasar.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "794cc8b229dda8b6224aa16a158d6163470a191ae91983bae7ca99ae291e67bb",
      "text": "Kemiskinan menyebabkan banyak anak putus sekolah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a45aa496b6cffb600d0e198399ea54b59ddc38006ea4a97d26b3f9ddd15e822",
      "text": "Di satu sisi, siswa lebih fokus.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bee82e7e75a93ba1c734ae1f12974783f1afa4ed8ead841bbb0ffb279ae3272",
      "text": "Di satu sisi, kebijakan ini punya kelebihan. Di sisi lain, dampaknya bagi orang tua cukup besar.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d1459b9ec3295a8942f234932f5e896365d16222562ceedcafb39072f67ce1a",
      "text": "Iya, Kak. Ada yang mendukung, ada yang menolak.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d5612456c46d26768dc8d69851e5806345b8b56a7f072e94bb17ae63db205ca",
      "text": "dirilis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d99b3aa20c4021a5bb1b7723068835650dc4437d98becc48f4892b59fa13d8a",
      "text": "website",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f2ca37b1ced97b47c0e736293ef5adb8c026557a9774707dd98ea53ea6aaad1",
      "text": "Saya membaca koran secara daring.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fed4e8b5613203ad87a027b34900dfaa28bd3a81a71472871c950100436aaec",
      "text": "Di satu sisi, siswa lebih fokus. Di sisi lain, orang tua sulit menghubungi anaknya.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "819f2f8bc175965063b3ebff00627bae9c87168e315f874c4858650c23e1fbb5",
      "text": "Saya membaca koran harian edisi digital.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "842bdc962658d1e76ebc3695aa05067a9044ccfce5fc37cf7c49966b9d487568",
      "text": "Faktanya, berita itu belum dikonfirmasi.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "85162c396068c1c8c9e750c7fd4fdd3c349ea2e0dc1f9f480fc532d9bfe6973d",
      "text": "dikonfirmasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "86038ea2677def07ae3709f3dc320606fc048b95fb584679d5db06ad1ea55923",
      "text": "Judulnya \"Banjir Rendam Puluhan Rumah di Parepare\". Siapa narasumbernya?",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "8af3a0d40a5cf3cbbd785fa2e56ed8f67cc9a2a93891c344f008ebda18c486c4",
      "text": "melaporkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9279d6b8c77fc63c47bb6f63c2b06e6426d3a29a7c1a138b8ce46aea9a9b0eac",
      "text": "insiden",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9293e19a881bcdc348fcc1c945b1af831e4de847255104822c74f2642693d1a5",
      "text": "Siapa narasumbernya?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f798c6a90b002819b026f2a7de0bcaae2d14e5d798933d72082de2649efb59",
      "text": "kelebihan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "95714e37573099af79c3f7a995880709d18696b9e1e8e293f6623efb05a058c5",
      "text": "Di satu sisi, saya mendukung kebijakan ini. Di sisi lain, dampaknya harus dipikirkan.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "96089f4f85e3dfd8a6eb3de258d7f2d1359e11749a01ab45155bdc75f48e62d4",
      "text": "Akibatnya, Pasar Lakessi terendam air.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "966d67e4a55af75690be1bc14f16a82d45f74399e65a74ec3d09ebd9d183fe62",
      "text": "ringkasan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "978961c7ee02220decd82cd33655737abb5f7f2ffc8389c99bf396a42037a82c",
      "text": "harian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9859ec086d32d4efa95d532ed44a43c1a9dc425f1dafc27feecb5a8e740a4cd3",
      "text": "Mohamed, kamu masih beli koran cetak?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a26f6612f87aab613af6435abd876aa64bea88350f95232a9bd68012cd13617",
      "text": "Investigasi ini menyelidiki korupsi di kantor pelabuhan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a736ce62316ed8c31710b86e5b3eafcc4474b47eca1ac9b3d798e8706994f25",
      "text": "Ayah saya masih membaca koran cetak setiap pagi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bff3ebfb68850c6b984869a5a1192cfa91b205c3f961014b619c1e547d28434",
      "text": "Setuju. Pers yang baik selalu menghubungi narasumber.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c8bd72ef63b627de21b031a9b20558cc13617a190108eae7ff30675e361d3b4",
      "text": "Selamat pagi, pendengar. Mulai tahun depan, pemerintah daerah akan memberikan beasiswa kepada seribu siswa.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ca9aa7c5ba510998b3e325dfbb18c6e34dd9a1b883cd412690e1f91b293b2d0",
      "text": "politisi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eb70b2932ba72808e746304fc7700165e37961bbc6b0e0233677a32997f81c1",
      "text": "Belum. Tapi pesannya udah tersebar ke mana-mana.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ebe32a9c6d0e08351f097dcfadd82331daad26d8b50a1b97eac2fe776b1baa5",
      "text": "gara-gara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fe450133774014609e08a07c9711dc087778aef5037abca60374e4e2e9c9f9d",
      "text": "Dia menolak ___ itu. Katanya dia tidak mencuri.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b4d3e1ea45cf5d12f53885f44b1527430fbe352f0c17c131e8de3bb97b89d5",
      "text": "daring",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1ba57eabb2ff30f4eac4ac5c42ed0177eda159ede6abd51a9fc7f56351cec5a",
      "text": "Hujan deras dari malam sampai pagi, terus tanggul sungai rusak.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1d96ffcef19e18c35740165b2ca56c7977217143de71001f393a9ba9a15ba51",
      "text": "Udah dikonfirmasi sama dinas pendidikan?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a488ea2b91f0fe51282ccaad89073606aa6947a67a8d46f7181535318f49b0ff",
      "text": "Orang tua sulit menghubungi anaknya. Akibatnya, ada yang menolak. Oleh karena itu, dampaknya perlu dipikirkan.",
      "voice": "id_ardi",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5089f79eb17544241c1816b0307d09298988f63192a834a4f3fa18b09769ab0",
      "text": "Cuma edisi Minggu. Tiap hari aku baca koran harian digital.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a56e86abad1df0d429a1b2674d7168f8b8469641d25948516ed7578f49c1d03f",
      "text": "Kabar itu sudah dikonfirmasi oleh sekolah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6aec9c2237469be1ef792de1ae5ac4d3602b553df597846bfc975329a8ac391",
      "text": "isu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a72bab8b6a4255612cd180220a36652c43b211d5d6081da947f5a9c775a1daa2",
      "text": "Banyak anak putus sekolah karena biaya.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a73d407b86cb9684469acfb79b588991125529e14980f37e7fa6ae57d01d9802",
      "text": "menyebabkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8684dc3786fc0cd6fa1dc270786986f7d7e531059b849210326cf3f08702b79",
      "text": "Itu dampak yang harus dipikirkan. Berita yang baik selalu melihat dua sisi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8ce9a26d3a2db7ba18c63056f0f023d103af9779cc58e57077cfda67c273cf9",
      "text": "Udah. Kata wartawan, saluran air tersumbat sampah plastik. Akibatnya, jalan terendam.",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa0588f07164cd25960a38abc80c01b7db831f2fb22eb2e9c45af9fe0e86c6c2",
      "text": "Jangan cepat percaya rumor dan tuduhan di internet.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab587e1c0ffe696362617d9fa74d5a7b356517dea4b66dfa88caf9abbc928b2d",
      "text": "Mohamed, ada berita banjir di dekat sungai.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab97282dbf2bca668579027cd1d083f170e564bdc1d1af6dd8fa705a69226e61",
      "text": "Ada politisi juga nggak?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac5fd9439bf4dc71f091eb37a100c7badcfe0fb5ee96f0aae910d1b8ffdad8c1",
      "text": "Air sungai terus naik. Oleh karena itu, warga harus mengungsi.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b079ebff478e35aa26c41c3633ca17be14e3e0bcaf058dfa5c30b72d6f0bf578",
      "text": "oleh karena itu",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b39b1e30678ffdd56983895d5b782d9abab6faa6bb8fdbec4126766384b2960e",
      "text": "Oleh karena itu, saya mendukung kebijakan ini.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b41685a85cc2553228b09ac4219c4905b27a725dc56dfacfd14d2dd9d44b17f3",
      "text": "Menurut narasumber, ratusan warga mengungsi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4b86f5c5ad30f867d0abfc9684495bbde15fdf9c732ed1163aa8179e61d2cc6",
      "text": "kementerian",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7e976281111d12aecdbcf8a14c0aaade511245dd45745a7992eda658368275e",
      "text": "Berita itu belum dikonfirmasi oleh polisi.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb3ba6e527054f78bc8e8dac9e160ed26ef99f903618aab53f12fdeaf2a1f649",
      "text": "Koran harian ini juga punya edisi digital.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf090279bac46f16a7f0341d45fab8c28d8d7fd221ecb02a7e02de542e0841e",
      "text": "Bagus! Berkat beasiswa, anak dari keluarga miskin bisa kuliah.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "be9777ebc8fdaff32c584d1b2bece4227b1938ff894a256b9a4329a2d67db57d",
      "text": "kebijakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c10e0cf21a916a492538d4aa2689ebec73dfb9caf26629975707475125c878e6",
      "text": "narasumber",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2b1c46eefc928ae04d64037083a932e97880274ba46838ffe86369d87f94431",
      "text": "Amin. Berkat beasiswa, aku sendiri bisa kuliah di Makassar.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3e5176ed480eec1851255cd3a0ced0ece368f1afe74732ce48c4d0b2b5ede31",
      "text": "Menurut saya, kebijakan ini punya kelebihan dan kekurangan.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5acf1063118f5c226ba2900e581c3cee56d4bdf27d9bf8988cff89b9add0cd4",
      "text": "edisi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6f4c2e57688c41208c247bae95ab564b92b6d6b30ba41312d5ed5809c33ed35",
      "text": "dugaan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c80012affc5f3de202805e9cc163a87f129e938bb6404310056beb1b2e077db2",
      "text": "akibatnya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c961b672b6f83c0eb67fe8fcefa52cd50e6d6e5e0893f84ba9c7457695dccafd",
      "text": "Mohamed, katanya sekolah di Makassar libur seminggu. Rumornya beredar di grup.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccc8c26f1e74d3adf7cf8c84593fa67e9a948f0ff2013cdb383d2e741de5a693",
      "text": "Judul berita itu menarik, dan ringkasannya jelas.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdd6c7978bf2070f145e2f07572b6175b3a204a73307e69aaf5d1bcb9eeed265",
      "text": "faktanya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce1e19e2d7c26fc4c131d89fdfe432e57947b0cb7d85f417a7ef4f48d52365d4",
      "text": "Semoga kebijakan ini berhasil.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d013eeae6833f70827e670f6ecd5d028529c1d66aa1f5c7346e936a76f5d6d55",
      "text": "Tragedi kapal itu terjadi tahun lalu.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4cb64be2823f327d20acd0d0f6473230c415f29463e7ea311d14997e47146a8",
      "text": "Menurutmu, komentar mana yang paling bagus?",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "d56207cc024a938cbeb2e15e27c52b7d34dd881640e2482fbe9ae106fa6e8fcb",
      "text": "tragedi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5f89742d4feaa0cef26a3a6c5a2e410aa95c4a18de0b6c5bc986fa6637bb8c4",
      "text": "berkat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b46e57381f5b35f512ceabe1427758887825841c7fd5361310f2f3c0ddeb89",
      "text": "Nah, jangan cepet percaya dugaan kayak gitu!",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "da6f7440dc892c4f149da5526d53321a8da94545149e836dbbb5dac9c9abb925",
      "text": "Pejabat itu mengambil uang rakyat. Itu namanya ___.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "da8848a3971b37eeb7ed981b6d8f4201372921a60beb8b11d63e20d6fcde64e2",
      "text": "Udah, Kak. Hujan deras dari Selasa malam. Akibatnya, pasar terendam.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "de37fae4e4c0284764f6e3a7b39ff688b5fb1c21df0b3efb029c1b7c354539be",
      "text": "___ banjir, sekolah ditutup.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e06611f82b8874a40e4c19e818a9e5f85a0f92d98b97f9f731faca0240165ba9",
      "text": "Aku wartawan. Faktanya, sekolah masih buka. Itu cuma gosip.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3ac267e79df17f8d41b319fde654f03ecd28ce2f06dd37ef8944046fe330c33",
      "text": "Wah, akhirnya semuanya terungkap. Kasihan keluarga yang kena tragedi itu.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "e610f543fca257cd659b75e99e3d48b0555189b24ada75976c3f6c888dcfd290",
      "text": "komite",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e76bd5c72233c5fee44307495b3ccd0ac870e2993bb86c80b7350169695a60b7",
      "text": "Banyak orang tua menolak kebijakan itu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7779c13449cf89212f5b334088f7522ab438a398f2d74403abd55084f2b4325",
      "text": "Bener. Dulu banyak anak putus sekolah gara-gara biaya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7c308425162a133d88a43bba381c60c5cd7e7ece38ba45b9d226eec1330dd7f",
      "text": "Seorang pedagang. Katanya saluran air tersumbat sampah.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9d1150ff70a4bc184d4b8bf6694c438eb93218b8bb0d52dd4bec406b3e8d15e",
      "text": "Dengar. Pemerintah daerah mau kasih beasiswa ke seribu siswa.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec0ca8fe912726458385835da971e4ab1737a45e23027f89977374bd383d91e1",
      "text": "Mohamed, artikel investigasiku udah ada di website!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec1fd00cb69d5957c69c7aba0b5aa82fb9e163d1aca4fe040e02b1115c9a18b0",
      "text": "Edisi Minggu punya banyak artikel budaya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec407d6e84a0ac49f8af5194e27cfdd456cb494ad3a8475d1131b6c612a8fae1",
      "text": "Keputusan komite itu dirilis kemarin.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee3dbfbf8dbbdf3107f45a1b9310be285127bffd1302aaa86320b528c7865966",
      "text": "Sebuah ___ dibentuk untuk memeriksa masalah itu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeefe7ef631852021d3156f83cbd30b06838ee58147828032854a0d360570b5f",
      "text": "Harga beras terus naik.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f19e4e257e189b603ecb8dda146e120f8a394a4471b19a9a066eabc98fb188cd",
      "text": "Pengumuman itu dibaca oleh duta besar Mesir.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4a9c9fa84a5852b1810a4cd1a2edb090961739cb3e1eec313d42adb807cef9e",
      "text": "secara",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5afa4999b61813ebb240a010e4093ec1651ab92e93cbfe2b26f3650c6daf7e3",
      "text": "Boleh. Siapa yang mau mengumumkan apa?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f61853a9d45b5cbe5f9acfcc27da84a6428c2e4a6df9e8961d574bfb5dc4c3cb",
      "text": "Otoritas bandara mengumumkan penerbangan ke Kairo terlambat.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "f76688859013d5f2990f2ecdc137486575c7804b17f581133a2fffe9141240c1",
      "text": "Kebebasan ___ penting untuk semua orang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f789da16c07f0d5c02fe0a2c0f460a9a2f98b9459d9fd200498a6e5c3cbbd413",
      "text": "gosip",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7936920eca702c8a09bd5d5fbee790194654f2d5211c406a4846092905b8aad",
      "text": "Hujan Deras, Pasar Lakessi Terendam",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7ab403998981fb9921644e6023c3fcf45cbf63542ab190e745761a1c3d83230",
      "text": "pernyataan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8874eccca24d3c2c4310a19f0c6454d4b57c149f7398a2b75b082fdb2a703e9",
      "text": "Bagus. Sekarang tulis ringkasannya dalam tiga kalimat.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9cc5ed5e7d243391583a91e3777af2527ac9c50e11043fad66878dde25d4893",
      "text": "Menurut seorang pedagang, saluran air di sekitar pasar tersumbat sampah. Oleh karena itu, para pedagang tidak bisa berjualan pada hari Rabu.",
      "voice": "id_gadis",
      "chars": 140,
      "mime": "audio/mpeg"
    },
    {
      "key": "faf591fee795e577c1656916ece2c2004ce5ab73fd13d1b60ed56be4b04295c8",
      "text": "Iya. Aku menyelidiki selama tiga bulan. Ternyata ada korupsi.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbd74163485b38dc61bb36d03dd5a6f65b660f71417194f631c915deb9983db7",
      "text": "Rahma: Saya mendukung kebijakan ini. Sejak HP dilarang, anak saya lebih fokus belajar.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc55a8760ce7900e7b2f1715a78bc2d0e1cac433cffb509fb467624782a4cf8d",
      "text": "Kementerian Pendidikan mengumumkan program baru.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd37830a6969ed95a3268a94e04be20e08fcba72aabcce7bde8079eba5f6d38b",
      "text": "digital",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd65a990ef38c761c05bc2f9d66e8492b7488abc8bccc2a508b20f85f8f3787d",
      "text": "putus sekolah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe8e124cecb15d4a72f05e1d31b0ae9100ffbd0c3d157ff3cc1affa40fede85e",
      "text": "wartawan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "feda455c37053ff22bc92794c7f3fab4fe6e57f56b5d4603bf22d9f93d7a8c0c",
      "text": "beredar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff8e5e9de48db0e96f89f514a8582d9b4cc3010eb4bb23d6e0b0866b33cbc365",
      "text": "Bener. Aku juga nulis cerita mereka di blogku.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    }
  ],
