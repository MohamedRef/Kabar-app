    },
    {
      "id": "bipa4.u10.l05",
      "sha256": "bbdfd59ad9216b35881525b1a107e4a56859f22e0e354ce55ab27e8c77133bb8"
    },
    {
      "id": "bipa4.u10.l06",
      "sha256": "08b17eedd14643a8be6cade73e8abe4b55013ef7bad6d5a6a2031dfa7a303404"
    },
    {
      "id": "bipa4.u10.l07",
      "sha256": "ae7ae01a2ce7a4b8d57bd44fd2992c0d26adc0289a247dfee46a19288baecf7e"
    },
    {
      "id": "bipa4.u10.l08",
      "sha256": "bf9e4f4be5d87103fe3cbbe233d274eb06a9c6f2da3db8d16fe0e36a628a97cd"
    },
    {
      "id": "bipa4.u10.l09",
      "sha256": "891269bd856623758a1ea28fd99e65ee4489eea3121ef152b7a20299dcb8a057"
    },
    {
      "id": "bipa4.u10.l10",
      "sha256": "b6bdd7feadf89f693343d770c2d0e624536f7bae6cc379196ebe638b981cad30"
    },
    {
      "id": "bipa4.u10.l11",
      "sha256": "683a76403e1267034179aad907ede4c56df146acdd71ac18e147d178f184c00b"
    },
    {
      "id": "bipa4.u10.l12",
      "sha256": "b0e93232532e6572763a766397ec04c4d383ddb5288af7597dcd309bf3fa512e"
    },
    {
      "id": "bipa4.u10.l13",
      "sha256": "242b36e86d6f36de82d190d796427861f9166869d75218cd6d566c3acd54ac57"
    }
  ],
  "audio": [
    {
      "key": "00429d8a182260177eb4ee8f8af1cac8efa66137c1df356306067775189b6880",
      "text": "Selamat menikmati festival bunga Tomohon!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "010a2aaeda413bc8e0a773c840c537070cdc53fe6355c2557e023a3fc9ad3035",
      "text": "reputasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "040613f5811084eb593ab71c169a98e45b58cc3d514f62de3b98d56626b487ea",
      "text": "Kisah tokoh itu menjadi buah bibir di seluruh negeri.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0413b91c1e2effc6c6df9b31098a70dba766722c092321af7e1cfa7449eea5ff",
      "text": "Sukarno pernah dipenjara oleh Belanda.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "073d00c036cf5d7df3cabf4ad68661160f8b17e3b7f3a00105723c902dfc966e",
      "text": "Pidatonya penuh inspirasi tentang kehendak dan kerja keras.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "07a3c9a875b79ccd106fd4245b9bedeee33f2b4b0de5a6d60bf5184a9619144f",
      "text": "B.J. Habibie lahir di Parepare, Sulawesi Selatan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "07e12f2fca4ba2a2a7dd84708de4b5489026291df45fd0ec8734d7b5c11d6391",
      "text": "Bapak tua tadi juga ramah dan rendah hati.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "08385b10e07f170891a9112fbe408d441110cae9eede71f693370c9357849425",
      "text": "Pada tahun 1945 terjadi revolusi di Indonesia.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a81660e3d629bb2b3c0ef934f03db7eb4599534d63ade45253e23d80a0423f7",
      "text": "Ya. Beliau wafat di Jakarta, tetapi dimakamkan di sini, di kota kelahirannya.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d208803a5d569936c998c33a04dbbdfe30b3ede1c71078d32127e8a4f603599",
      "text": "musisi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eb4603092592d0c9686eab6a4260320988afcc0ed4057d8a37c9d9fc83ba1ba",
      "text": "Guru menunjukkan setidaknya tiga contoh mengenai ungkapan itu.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "10be7da593bac1a5d5ec8ce0038189dfbd056b451eb24315c810c5ece696b734",
      "text": "terutama",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1104d1a4eb087e81b6ede6ecb902f5e29e632e84f49655c5ef6a6803d2930579",
      "text": "kepemimpinan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "120570eb246b4c7c41ea8bc70925a0790e16f64d92060655eae951812573a695",
      "text": "Beliau wafat pada tahun 1949 dan dimakamkan di Tondano.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "13430d83322c6139bcf41ac908d9b168411b05fcd61c7a1911474d04d3ec861e",
      "text": "Yang terhormat Bapak Wali Kota dan hadirin yang berbahagia.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "14f7c14d6ebb6b674ab5fb974f01948fe95b34c7ad707dc8d865e869c4421e2e",
      "text": "Aku mau nulis riwayat hidup beliau buat blogku.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1685b306f5854a4e78a06390d2a0794905afdcbcc5032eeaae0dc37115172c58",
      "text": "Mas, aku mau beli novel Indonesia. Yang bagus yang mana?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "16d3f568eacddfa2feab5182c926199604c97af72a1714f5a20d2cbcae3837a8",
      "text": "Bukan. Begini maksudnya: oleh-oleh untuk teman.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "17b62b742ed10317332c8c4341f0397a9786474db10dc2fb6e269fe5bff04f04",
      "text": "Yang terhormat Bapak Wali Kota Tomohon, para tamu, dan hadirin yang berbahagia.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "17da413f6e04fac1f26ea7f7286e1fdeff836b1fafd53e6550513e094d72b079",
      "text": "Pantes bandaranya pakai nama beliau.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "19333d573516f5b576bb301ad78d5ac7594b8c873039e621c76156c932c3ae95",
      "text": "Saya membawa buah tangan dari Tomohon untuk keluarga.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a4006269b9e52a6b270c424b226fb79d0f352887a937c8fd5bd5370891687f0",
      "text": "Hebat. Namanya pantas tercatat dalam sejarah.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1acbb6c3da6d3d7be9267b0da8b20c51c9582a97c08d1aa939e1d7e914516f7a",
      "text": "Riwayat hidup beliau luar biasa. Beliau belajar di Eropa dan menjabat sebagai gubernur.",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "1be908a34fecec7191f88955ada59e55c33e592c0f344b3665873b5430babdaa",
      "text": "Telepon adalah ___ yang mengubah dunia.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c1938de4d08ee6f4c5bc8f2b1063f2c96266cd8d605640a433f3017a6d73577",
      "text": "menyalahkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d5d34c7d56545b039cb65f29cfd95bfedc266cbfe98727878d95feaf34a15cc",
      "text": "Pantes bandara di Manado pakai nama beliau.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e8a39dfa67ef27e79220354d402a16b05d1bad213614211bc54609aafb6984c",
      "text": "Pada tanggal 10 November 1945 rakyat Surabaya melawan tentara ___.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "204ec0ec20e3e337560e623279ee6969c30b783fad661f0f4737bc2e64da8093",
      "text": "Dia memimpin pemberontakan melawan Belanda pada tahun 1825.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "21383afe608e0aeb00421b7475c29df09093bbd9e4a95f6f940643bad115e703",
      "text": "Bagus sekali, Bu. Awalnya lengkap, semua hadirin disapa.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "21aa9c1928277e6f8d7d91d74894f23665b72b3e934d900041836bd8f0455873",
      "text": "Pak Mohamed, bagaimana sambutan ketua panitia tadi?",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "234afd2d14605a2b2b204c07c1e55da3182a8a895abe8a6930ba3e6b9b777a90",
      "text": "penemuan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2819373d9060e6bd40af5e99cc72aa7e09083d42e2608fb240dc16372a472a32",
      "text": "Asal jangan jadi kambing hitam kalau bunganya layu, ya!",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "291a6e4a123954bc556e21f59720ade80c389be1a4076d32596046cd98db5aea",
      "text": "Mas, ini makam Sam Ratulangi, ya?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a4a2d22d0b9677e3e20f43b00f3f83c5afe0528ed3cd1bb7fedbba3b09a7da1",
      "text": "Semoga persahabatan Indonesia dan Mesir semakin kuat.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b76a2b6830fa2d17e95e84e4059e0c1f9ef38bd83b77db5f3c470bfffcfb111",
      "text": "Walaupun sudah kaya, Pak Irwan tetap rendah hati.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c30148ceb106bf941c6145ed736fddd60c34886d053ed1d61fa06d832819c34",
      "text": "Terus dia kenapa?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d63f3cdf8ecd78891ce384e437495535f2ac48fa6441a2864bc67bc870acc3c",
      "text": "jenius",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dddf9450a5873ee5bd6aff82edd54e232e389466a90f1da9d07e4c7e482a7c3",
      "text": "Dia belajar keras dan akhirnya ___ cita-citanya.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e4e052e7843bb994b644842194343d0b958b6b9e7463da4886cc23fd9e32195",
      "text": "pemberontakan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f410ad55dab14779e942af221a0dc6dc1af758451988e97dc2c5e6b9470e360",
      "text": "Dia mampu mencapai gelar doktor di Swiss.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "324fc54a814445eb972e0957924a48b7d010c2767b1cf79bed8ebb0101411604",
      "text": "Tokoh itu keras kepala, tetapi dia tetap membanting tulang untuk rakyatnya.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "3564cabb5fed27e75747752947cb6d326e4858b84ad92d5c0e947aa10aedb9b9",
      "text": "mewakili",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "36af08280d5e6aa6e3743e4fcc8c39981d7397be42a02fc349718b8a0f6acec6",
      "text": "Hadirin yang terhormat, hari ini saya akan menceritakan riwayat hidup Sam Ratulangi.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "3824c6c3bf437c60ea7102697f347959b6a461e762b341441c3859e76b0ac17a",
      "text": "sambutan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "39a93d89aa4aed14d91c174c37b79499318a0a3b1b355d9346c1656e0cb1efb1",
      "text": "Sosoknya jadi inspirasi banyak mahasiswa, termasuk aku.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a258ce472b10fefa707dba4e993ba73f2ed62af3d83a88047d4258154d6a94e",
      "text": "sastra",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a8b875032cd3727e9e464462baef6cb36650bc09d4f1c8cfbb3a8fdb9272bf3",
      "text": "Iya, beliau udah banyak makan garam. Udah empat puluh tahun nanam bunga.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ad66ccdb65a2b05c14187713775064c789d46589d31cb325a9ae6d3c1707888",
      "text": "Pemimpin yang baik tidak menyalahkan orang lain.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b21fe45f7c099f9743e69e22acf043d4170b7b24531542780cc5683422281ba",
      "text": "berbakat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b3b1a564013191eb4d04fe9ebf4ba5baec66ada91f729d23ed3f79105825b96",
      "text": "Kamu beli apa di pasar tadi?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cc34d3b6a9d7e3a8a8be67e23d7030d3876dc8e48f3493b974bbf75bf56b037",
      "text": "mengenai",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d78d1ff94b2c0c2b690cd6a7c8802128c5b7f50478571168316dc5e7cce520a",
      "text": "Peta ini menunjukkan jalan ke Tondano.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f70bc8b2f325b8a28289a3e42ed3149ccb8720d8ddb2ad3336a1ab7a8c8ce5d",
      "text": "tercatat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fe15ce037b076475ffb3cbff02fa858838b0939a0bfc71f6de4652b0872ecf1",
      "text": "Tapi beliau tetap rendah hati. Karena itu namanya jadi buah bibir sampai sekarang.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "40b94a133ccac66a3363a074ddf4db5af3e4a37d112c111356934f55f3372d47",
      "text": "Beliau adalah tokoh yang rendah hati dan dekat dengan rakyat.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "41b810f990ee6b02cf2921b3b83ce861a10c2448898e5a05d9cbb6bdb6099902",
      "text": "buah bibir",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "44390d9a47fc3b22d4226400521978e0ee9341c4e30a882bbf68eff3340a715d",
      "text": "buah tangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "457c15440fd16ff49fd0b6affdba58552db38dbfc1f45b426bfd6fe40898d197",
      "text": "Artinya, manusia harus menolong orang lain. Bila kamu mampu, tolonglah orang lain pula.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "45e0a7fe7896cffaf481822b9997c371f396f5db10c0ac3b15e032eb1f1f0df5",
      "text": "Yang terhormat panitia festival, hadirin yang berbahagia, saya bangga mewakili Mesir di Tomohon.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "4682abf8704234e45274096917998e08d4c40da4ebb0af2e1dacedd1d1a6b498",
      "text": "Akhir kata, selamat menikmati festival!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "468e65cfea848103ffd26dfb72d14ae15e1c09455e8428393961d54fd9f41284",
      "text": "Novel itu berisi gagasan tentang demokrasi dan keadilan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "4690ff67b104c04efb8f3af5719ca6e7d9474a8da38dfcaf6eb79badbfbd65af",
      "text": "persahabatan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "46b01e2aa0d8e8314f71b635a6ca46d99f004c050cad5b5c77aa931d9b66b62a",
      "text": "B.J. Habibie! Insinyur pesawat yang jenius itu.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "473374857ae899ffc3cf7626619908aedf7ce34991478b8b484704177229f198",
      "text": "Meski jauh dari keluarga, dia mampu belajar di Swiss.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "47d1f51dad80b15408ec3a6c7a99994acf5cdb388e1218b12d8f74aad7df66ca",
      "text": "Wah! Gimana cara bukanya?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "47ed4ce2f432d1010d770721dd739b940fac239f72e08adfea9edcb980cf4714",
      "text": "Petani bunga di Kakaskasen membanting tulang dari pagi sampai malam.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "4848ec4cb2c72521e9dce543eef888fa8772271863b7a7adfac4e67cea9cdf86",
      "text": "inspirasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "48d804f297b2f0bbe08de093fef1176815de623d07a14e34c70f3e3a42a60c68",
      "text": "meski",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "490ab0a82f0d95ae4b0a4594d3aed7c768da5f6bb64b13d955ffe711f7a9971d",
      "text": "melukis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "498d53c53e7c57218b080ab54832a7828c5f77015396ba040b94ddd9572f7114",
      "text": "kesempatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bd6b4d00c2fc4e6c97f90db18edf77a2b71f1a10b001474d49e1f10ee633e32",
      "text": "akhir kata",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c2c58ad003ff481bc97ca9f8093d9b59058e45ffeda2eb6300316e99cd19269",
      "text": "setidaknya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d4ac883c244e9a4159c9169542dee9746625c2f810c4a00f698ca00db5e4693",
      "text": "\"Kambing hitam\" itu ___ ungkapan. Artinya orang yang disalahkan.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d8a9c8278a911644a9352f9dceb5c10deca8fdf65f84453c6c053a991048e40",
      "text": "novel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e6192fd1e9763af1923198dfbac8dfc68dbadd55b44d0d3fdeef6aa8f9d9fb2",
      "text": "Dia sosok yang berbakat dan peduli pada kemanusiaan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e8e1d5076191b3699af3361822d4ae1500c900214f4a624e0e9dd34e19f6d55",
      "text": "Beliau bekerja sebagai guru di Tondano.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5323e0cc8d6ae45b1abc787bf78887d87c0d97695a084f3b3f6d6a2622494a88",
      "text": "Ahmad Urabi. Dia memimpin pemberontakan tahun 1881. Di sini ada tokoh kayak gitu?",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "536b5500225e6842bbde5ba84224b81a20631e421da563c45f8816fe8f436259",
      "text": "Hadirin yang terhormat, puji syukur kepada Tuhan atas festival yang indah ini.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "53e1b36d7219077a7d8e6ba1df3f953e2554fe628ef6372847d1fe948384db19",
      "text": "Beliau menjabat sebagai Gubernur Sulawesi yang pertama.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "54165862246c5b19d448069c602f3053a09bf7ddac97cc41a5a44f0cfea8f7be",
      "text": "Wah, nanti kamu jadi buah bibir di kantor!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "544854ff4be8eef0382b1b118466a931376c42eaf796ec7a7141ca780d3c68d4",
      "text": "Panitia festival minta kamu memberikan sambutan pendek.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "560396d4175943cba0ab03a07455b82c3cbce1deabd97edae998e4cd77e70a85",
      "text": "detik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "560b19243679e93b7d58a1839ff15624fa877581fed514ca5d977bf45ceff968",
      "text": "Asal saya tidak jadi tinggi hati, ya!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "56c999a896ee6367929c9a8377cec3092c1639e5225f06ee0477fccadaaf600b",
      "text": "Ya, katanya mereka membanting tulang setiap hari.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "573d9269887c05b7a7b1d78522d7fee46920f6f9de7217c184e0893e33613a56",
      "text": "makan garam",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "579dbff4403ec61de285d115aaa741e00a786c02c912e0d33444aaff46ceee34",
      "text": "Beliau menjabat sebagai gubernur pertama Sulawesi. Semboyannya, Si Tou Timou Tumou Tou, artinya kurang lebih: orang harus membantu orang lain.",
      "voice": "id_ardi",
      "chars": 142,
      "mime": "audio/mpeg"
    },
    {
      "key": "58fb1e6c21046bffb475338bfad7da40eb7df6bae0f75ede3573fe7c6f7bc738",
      "text": "serta",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b89700790c528a15190711d170a9125204ac4cdaec68b1d99c4f359443c2e07",
      "text": "Tidak kelihatan! Cerita tentang persahabatan Indonesia dan Mesir sangat indah.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d6add0aa0fb86d84cb7ccf6e0dea8f01a2034d9c3b77c0f9ede38bd504886e4",
      "text": "Jangan jadikan dia kambing hitam atas kesalahan tim.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fb4275a31a6cbc8c3ae4519cefc030fb0bb9dabd1c8e614639bc427fcbe0f4a",
      "text": "Bunga, buat buah tangan teman-teman di Jakarta.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "601e512ba5f710c369511fa945aeaccb1bcb50b1fd142801c4a402bd7f4450b3",
      "text": "Hebat! Lalu apa maksud kata-katanya yang terkenal itu?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "612cf81504557e72110698bac17086e3559ab6bb299df14f31e5653d014a1e13",
      "text": "Beliau menjabat sebagai gubernur dan dimakamkan di Tondano.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "647a85c6033be41d68fdf7d15182fd582bd2562c897e99b6ca4406210879974e",
      "text": "Bila ada waktu, kita ke Tondano serta Manado.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "647ec1e1245be7089ca373db528af07c6bb21f2609cb5f678419ae4db02fbc81",
      "text": "Terima kasih, Bu. Sebenarnya saya agak gugup.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6638037be94b756b7f7acfb10fbe68db0739504f221410883419638650f226b6",
      "text": "Apa jasanya, Mas?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "6700b264941c59d85e3846436e3d8c2f2159558f819eebd36196baf842aaa34d",
      "text": "Sam Ratulangi lahir di Tondano pada tahun 1890.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "68f2768a6d05a522f68833c44d6e726322841ca872f22eef708720b9a0b57591",
      "text": "gubernur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "68fa8a1d5990f1ba5a7d93fdf391129e704528597131cb2c4b23e7b17ce47254",
      "text": "Mohamed, kita udah dekat Parepare. Kamu tahu siapa yang lahir di sini?",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6950ada27a2931bb9f55a0cbb9f0b543ed28ff3931bd66fa0dd224ef1c599935",
      "text": "Kakaknya pintar, adiknya pintar pula.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6974f02638d9aff3111ec7c18517859666a27043c05281255d3df9b5cfbecc15",
      "text": "Sosoknya menjadi inspirasi bagi anak muda.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a740abc3bb1a07db3cf83367afb129f5af45658f066833660cbe1eb752641b6",
      "text": "Dan beliau tetap rendah hati. Namanya menjadi buah bibir sampai sekarang.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f8007132301a5138a28eb05e35d2702951978c2b648d719903fd740dbe68247",
      "text": "Di negara yang baik, pemimpin harus mengikuti ___ rakyat.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "716cdf249deae52f296b4da219c334319e4111c8678683ed26fd048efcbff798",
      "text": "Begini maksudnya: orang itu sudah banyak pengalaman.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "733b253390075bd275a08c25bb3d1d17165b79b9850e0d5554fbf6cb39044ff6",
      "text": "pemberontak",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "74f900a7367015f402ce51938d5d20f48864471784242585ba7061c356ddc46f",
      "text": "Sam Ratulangi lahir di Tondano dan wafat pada tahun 1949.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "75e33c8d0cce297503f21c2b43806ece59f2a11afb21ca59c66f2653d23c0a71",
      "text": "Sam Ratulangi lahir di Tondano. Dia suka belajar, terutama matematika.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "75f2daab94dc60cc2b00d014737ee540aa6545694d025c882f9f0a5e6ba7eb2c",
      "text": "Saya berdiri di sini mewakili teman-teman dari Mesir.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "76789d6eefa6b73927b46c114f16ea8dcc645d67853b57999d264522f6640d8b",
      "text": "Semoga persahabatan kita semakin kuat.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "76bec6c22c24c8ac5b605d66528e1ae3b00215ec20cf975b1e0924b1f8289e9a",
      "text": "Dia ditangkap terus dibuang ke Makassar. Makamnya ada di kota ini.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "77a22e6297fcc05e50e2013bd2388a33be8f45701050a932f48681e91e9a1bee",
      "text": "Namanya tercatat dalam sejarah Indonesia.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7890ee3e2659aabe580e8f1bdfe6c014917fdca7afde6a879a82555c66579fe7",
      "text": "tiap",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7970e13f9d4888f7647e00b621be7f80a1484fb228dfd1700d129eeab92c07fc",
      "text": "Puji syukur kepada Tuhan Yang Maha Esa. Bunga-bunga ini adalah hasil kerja petani yang membanting tulang setiap hari.",
      "voice": "id_gadis",
      "chars": 117,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6fa2fc4f29184144dee4d7e7131e9653ac45a5b97b495f8990f4835106698d",
      "text": "Bagus. Kamu udah tahu beliau belajar di Swiss?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ae7659cf77f2885f96cdbad61cd7c0a026d7899681d58b999be197d64e135c6",
      "text": "Semoga Anda membawa pulang buah tangan dari Tomohon. Akhir kata, selamat menikmati festival!",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aecd8d4e47919a290a97c855a976f0f55d0eda6e9590d59f027be5976affdb9",
      "text": "Dia insinyur pesawat yang jenius dan berbakat.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cb38975d7d7ed87239b20cf335f1ff0118514671df0855c1b8af63a4fba4216",
      "text": "gagasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cc59e184a5df39c180951c03f1fb835bb9972ffaf44689bed1f2b13fa21dc35",
      "text": "Gerungan Saul Samuel Jacob Ratulangi, atau Sam Ratulangi, lahir di Tondano, Minahasa, pada 5 November 1890.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "8111067b3e2b3f2479faf0503a0b3c68092d5dc8b973a4da6a46647443dd50f5",
      "text": "Belum. Itu semacam buah, ya?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "830a68776634b66f0bb228f9467757e9d5c83d232ac067117c81534414173769",
      "text": "Aku mau nulis riwayat hidup beliau.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "85a657de60a0855f1f7583608826df08641a55256ce78f1ffe1f881609dbd3f4",
      "text": "Oh! Sejauh saya tahu, di Mesir juga ada ungkapan mengenai hadiah.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "85be9ca4f90c6a965e528a82ccaf7a9e7044700cb6c91cc01728c08540ab2db6",
      "text": "menjabat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "870d73d9ebb2d59c01a2a7844cebfda139e0f2c0c3fc1477cb8b5cff98308cf1",
      "text": "rendah hati",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "87a9dc4ac2b3686ddf70cdfc4fb79a705dd4941fdbe2ff155b244722b0662944",
      "text": "Dia suka semua pelajaran, terutama matematika.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "884a66df5048d685667dcd9b29a4997b88957ee6de18ca411d5108a99f5f5046",
      "text": "dimakamkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "884bc4a12c9f1f16e3b0d3152f71ba537edfcb41c855ede7f28f286a989542ab",
      "text": "Raden Saleh suka melukis binatang dan alam.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f9b782fdec6dfad44bb4b4b2b054f151d789e0bb575f1fb73ee714fe6fedcf",
      "text": "Pramoedya Ananta Toer menulis novel Bumi Manusia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "89eda7a80318cffa1cff8b7c3578e515f63c048098ed3c5016356457cf70c156",
      "text": "puji syukur",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b266e14b07284ec5d456e377e66f60d3f85a8ae5d489423c9568d35e6018a14",
      "text": "Pidatomu bagus sekali, Pak Mohamed!",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d9a7d9b6ba3ec1701b4d2f623937b1b809a8b8a43bc20fe8feb1e683e7411e5",
      "text": "Beliau rendah hati dan membanting tulang untuk rakyat.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d9d9427d46e4498e59a59c59fe0a363f9831bb8b5949cdb7d331b1401e707cc",
      "text": "dipenjara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8efc6aa8eca77ccf5c20aead37922c052c9a3ff5fc80b0bd7558e2fd4cb2dece",
      "text": "Dalam riwayat hidupnya, beliau menjabat sebagai gubernur dan mendapat gelar Pahlawan Nasional.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f12c558d99557dd7112a671e89bb1006df0a1b73bbb7d8fce7325767e3dc709",
      "text": "Mas, aku lagi baca riwayat hidup Sam Ratulangi.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f6e650c29e5a9627a03a84bd081e0e80ba59e31474986095a22eb8018c898a9",
      "text": "sejauh",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f86d16c5d2bddc6e3c2717425a5e1320e00ae0e52341aef2944969ad3102769",
      "text": "demokrasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "92fbaa33a63953ed60f8fccecb2580e1c3f9f4544b618d563c536d81888212c8",
      "text": "Mas, siapa Sam Ratulangi? Namanya ada di bandara Manado.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "93c17ab9e4863828ead4de80ba7c4c4b4de90d06e9559f891164b47ddd7a16c1",
      "text": "tinggi hati",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "962f47de5db9d4fcd345f7e4f5dd6b1030d411cf31357299dccf4a1bea53a4f6",
      "text": "Pada tahun 1945, beliau menjabat sebagai Gubernur Sulawesi yang pertama. Beliau wafat di Jakarta pada tahun 1949.",
      "voice": "id_gadis",
      "chars": 113,
      "mime": "audio/mpeg"
    },
    {
      "key": "98e8860d31cde48de6579ac5f1f399c8cff7634d311ad47f5bf3e6a5dd2dfae0",
      "text": "Para pemberontak itu ingin Indonesia merdeka.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "998b3d1b3780a3b7e782b68062dd4f0e4c22215cda72f68a1b2f58f9dd4667c5",
      "text": "Puji syukur kepada Tuhan Yang Maha Esa.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c91ad0431bcced8524d2cf27bb978645f6b1ddcb35c250807f1c0a8b9a3cc7",
      "text": "Bagus. Tiap minggu tunjukkan padaku setidaknya satu ungkapan Mesir, ya.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c9ee51713176341dd10e0d12bbb0e1902792fb67667480c4ccf6161469e2481",
      "text": "Beliau juga bilang terima kasih kepada para petani bunga.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e0697473d33a68f1dfb7bae53d1894ec24de62f1aa5eeecfcb47103f885e809",
      "text": "Novelnya tentang apa?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ed642629a3b77bba57c274f0e97733a861a1137a2026384de6cfa8541b0af29",
      "text": "Bener. Dia belajar di Jerman dan punya reputasi besar di sana.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1c77c6c5cb651f9cf7612429929acfebd0e1916df74f77156829aeadbaf4758",
      "text": "Wah, besok kamu jadi buah bibir di Tomohon!",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a208fb115f52de199327e61cffed6f888fab56a9257243a86a81703ec7d7f0af",
      "text": "Mohamed, kamu tahu ungkapan \"buah tangan\"?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c6116da5a6b3dc70b4c08334287e623a8646cd034bb16b30be6d21942c76d9",
      "text": "Terima kasih atas kesempatan yang diberikan kepada saya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a87b20d1546530486e4abbb106c9e7e441a5ba8857300e1b38262408dd1ce6f2",
      "text": "Anak itu memang keras kepala.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa10c0899008dc239e0abb5ae739f85b78d3ccbc5e25004bb3d992e85d0e8dd0",
      "text": "Terus aku tutup pakai akhir kata dan terima kasih, ya?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa8a0ac83e168057b4484d9feb595ac7d9b435b6a7bd8f38acda70071cd9b40c",
      "text": "Sejauh saya tahu, ungkapan itu sudah sangat tua.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab297a8ac34ce6d7b72ff3b803868e729c9a88dd62e130f565dc01a26361281d",
      "text": "pidato",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab8f0151b2ed3317d64af55f37185dd49c3ccd0f080409873815981fe755caa6",
      "text": "Akhir kata, terima kasih atas perhatian Anda.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad7e5687a040d059a3471b627a6f09dc5348362a7f8369bcd7621d3e125fff3a",
      "text": "Tuhan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ade05125cc803313eb11aca7c78b54e2743879b97a7ed417e23cda758ac25844",
      "text": "Bunga-bunga ini adalah hasil para petani yang membanting tulang setiap hari.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0715da1b2955d3375a76d238eb58357c92403302dcb2f2d08513e385392ae06",
      "text": "Tentang zaman Belanda dan gagasan kebebasan. Dia nulis itu waktu dipenjara di Pulau Buru.",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12948e22d8f424e12d8fee6417045ce39122c2f9427519f21c9f4ff3d1acc7f",
      "text": "Tiap hari saya belajar setidaknya lima ungkapan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3356f3fbdcfc77702fa50580faffe0d3bcdfc1943e7228a071281f602e442d7",
      "text": "banting tulang",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b37b58b3bb6a567210333ce5e4cfb31d4fcec6c14afca389184949cecf50ebf3",
      "text": "Pada tahun 1919, beliau mendapat gelar doktor di Swiss.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c5f0b84c962a806d99952a544dec8a943b0d0feb78b5fb4761e2415155791f",
      "text": "pula",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7baaa5c45e56b0d1ac1e62e234d7d3f5c328ed1c0e1185f00dfff13d86425b1",
      "text": "bangsawan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b87bced3164f26cf3a4ac14c291165d52ab7e418e1fc55b080a358f0ff5a5f3b",
      "text": "Pangeran Diponegoro adalah seorang bangsawan dari Yogyakarta.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9520297e5c3fc7a600b6e97bb9efc90854e713318dbdabe781174730cb5ca60",
      "text": "Ada. Pangeran Diponegoro, seorang bangsawan Jawa. Dia melawan Belanda yang memerintah Jawa.",
      "voice": "id_ardi",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba0affb7cf01bb464ad6ef1936cdd9b8bd42538f3e5f40743bc003ae7b64451c",
      "text": "Penulis, pelukis, dan musisi itu tercatat dalam sejarah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1ca1ca7a76793552433a07049a18d1abf86ab86975140cfd5394b58d8d42b5",
      "text": "riwayat hidup",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf997ba47f1f0d30f72447a1025f801168224fa82dd794ad306176b2371daa0",
      "text": "sebagai",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdc26622f587afbc2da018305b18147b54c49ce8d4e35a4c0c40894b35b4c347",
      "text": "Para petani bunga membanting tulang setiap hari.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "be56fec55a493b535de3e52d1d99eedb2006c1ab87904bb2ddcf7ef7fcc1059f",
      "text": "revolusi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf8057a2bb6354f52494830b73dc4abce1e427ab543df6729487460c25bf557b",
      "text": "kemanusiaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0e25d6ab0c8a58344bc73a477557b6c3ff22da3fe7902fa955df40836957d59",
      "text": "bila",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1ef7131fc123bd87d2f8760399798523caa3f796fc3573847f330b7c69131fd",
      "text": "Tapi kata beliau, anaknya agak keras kepala!",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3ab3d7aa0003e6c0567f9e6271e9bd8ce15afc565b50a562cb2b723f5283348",
      "text": "Mulai dengan yang terhormat, lalu sapa semua hadirin.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3c9b7b46464ff43e254d8226ae1295c8cd8540829a2df95cffff08a7b5a0530",
      "text": "Beliau belajar di Belanda dan Swiss, lalu mendapat gelar doktor dari Universitas Zurich pada tahun 1919.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4d66d16031d859192ea7764141484961d28bf783838594e1bdde93b7ea6d83f",
      "text": "sosok",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5125c159fe16a91d9f9b1864aebb7b0dff09fc99fabf8b29ebe4e03ed8535be",
      "text": "mencapai / capai",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c62d42225c3c7836628f033f432e268aae9dfbfc4c4ec78e161aecc01d8cb1f2",
      "text": "sekutu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c89d4d97c4c286e6fbd49d32ba85e0ade053049b3d08b9678261f3fac489075f",
      "text": "Udah. Beliau dapat gelar doktor tahun 1919. Luar biasa!",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8b54c629ab53d7afc41ff7c860064281b71001bbace3d3708667c1e6873b670",
      "text": "Yang terhormat Bapak Wali Kota Tomohon, hadirin yang berbahagia.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95753d2b7c7ad2445e1f43217686ab69d98a0d6ca973e8ae6b54f0afa2e6cb6",
      "text": "memerintah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca29501b7120eb8163c3a7f4bc9f35b371cf27e7446ec1b3aa969649abd976db",
      "text": "Tiap pagi saya membaca koran setidaknya sepuluh menit.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "cae6194bd2f9face008b35e977e00c3f7bc203b08180800695f78d765114fee2",
      "text": "Mohamed, pahlawan Mesir yang kamu kagumi siapa?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc971f5bc2badfa20d0455fb37a8a2f8b608a020723a696cb58a41433dc4870d",
      "text": "Pidato presiden itu didengar jutaan orang.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2b12c29fc721c2d76576131ead6674ee2b139a0ba74f79228f159c8ef9c0e87",
      "text": "kehendak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2b17dad07d560b5a3b0762e142de5bd06a391751a84fad7ca3b381b36f4fcb2",
      "text": "terhormat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d31f7c8c87008b648adc878853b37f8cdc852112246daf15513c886475cedc04",
      "text": "Beliau Pahlawan Nasional dari Minahasa, lahir di Tondano pada tahun 1890.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "d33b439af2e3f7eb00e993e546d648fd98153ad0822c2c4fc7e97b5533921b31",
      "text": "Bumi Manusia karya Pramoedya. Itu sastra Indonesia yang terkenal di dunia.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4bc1ee5e0b34c264df91381aa26faa97fafe9dcc05714e7df76ffd90b60f3b7",
      "text": "maksud",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d616aa1d9d289dcfb73a9c0eb5d53c4552f74bcec0316a9c10751416c4266847",
      "text": "W.R. Supratman adalah musisi yang menciptakan lagu Indonesia Raya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "dae0c4787d952d6dc8e14c526fb83509e2e957043b62c674de2a193303baa0ab",
      "text": "Betul. Jangan lupa beli bunga sebagai buah tangan, ya!",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc1697ec330fa43c7b05d8ff1290447c14f0f539ecd13f616242cd0c3392c86a",
      "text": "Beliau wafat di Jakarta pada tahun 1949.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "df6fd22b248be7881ef479d44c4cedc0f38f56473289fcccff0f54216a4f2c0b",
      "text": "semacam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3c460bc1e5956559e6caded116ebc352f1b6e524390d17172cef1fe08acc788",
      "text": "Bangsawan itu memimpin pemberontakan dan akhirnya dipenjara.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3e1e01c451f90eb981667735f2fd77cf46d319c40560aaa7a1aa48ca2d285f9",
      "text": "Meski sakit, nenek saya mampu berjalan ke pasar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "edb0cb8fc8999d8141ff37e7baa4838c205e0f2cc09db731d410f5b0d8fd9c5f",
      "text": "tetap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eea946e8d9cf31e991ef8ad0e0002169b97a379d196a845f56ddf239994cbd78",
      "text": "kambing hitam",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb0105f9395ceac0c40147e32a795d7063e8c1bb90bfce6ef41ac22f971f379",
      "text": "Aku suka pidatonya tentang teknologi dan kemanusiaan.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "efdcf90cb194406461b39eb3300e4e9672695d375f3e9f1718fbf022e731e027",
      "text": "Di Jawa, lalu di Belanda serta Swiss. Meski jauh dari rumah, dia mampu mencapai gelar doktor.",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5c3e65496931c414e87b183624429ce25065134103f34256b6369f130b92203",
      "text": "Para petani bunga di Tomohon membanting tulang setiap hari.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7a71d6be7200e5510a7c538c2074d5819b73ea50f46c73f63a3ccac481dd9a9",
      "text": "\"Makan garam\" itu ungkapan. Apa ___ ungkapan itu?",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7e43c3a17661225630ed4038d3d0fe651cf9a9409d6f4351df7f8038d3daa97",
      "text": "keras kepala",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa59913cb959325df5b8959db3bf8c77b89cbf48fc6a066e48ab3cf9ddd6861e",
      "text": "mampu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb6a63dd26884e404b4e1bc0af1981623f0cbc310d99ad839b5eb3cefd8a3d54",
      "text": "Dia sekolah di mana, Bu?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbee89c23583732977cef9cf86415624fd75e123585d928ac1773c8057a0c285",
      "text": "hadirin",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd78a5563dc8cf12372159664da95ed0b145df1e2dc6e9eb70b251ec2030818e",
      "text": "menunjukkan / tunjuk",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe9225bc40e7ba35ec6b8399d2c0fda45cf63662dbd502497d46f299ad9a5573",
      "text": "begini",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    }
  ],
