    }
  ],
  "audio": [
    {
      "key": "00b70430fd117ace56216ca409aa9c2b3a91ce17bc75ab0d3129d3a3d95d1c60",
      "text": "Penyu betina naik ke pantai pada malam hari untuk membuat sarang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "00df81d5948b61f3b2537d07a64365a9f7da1ad1ee5176eb8cbf9dfd46d339c0",
      "text": "Pasti. Dengan bahasa sederhana, supaya Aisyah juga bisa membacanya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "01fff88d7cd3c0adc52ef9928a44d86b287d07c69f55d8f345bcd3b25c9f459e",
      "text": "Bagus. Mulai dengan pernyataan umum, lalu jelaskan prosesnya tahap demi tahap.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "0297c62d8eccc31a8eeeb7c69b81e5faf30a642a1a9faabc1e813be3025049f4",
      "text": "penangkaran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "02d6bd5901e9ff42060692a2db08d4a809e46149228645ba8d578edfca96051a",
      "text": "Gurita punya tiga jantung.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0335cf79759f40d5da6fac3961a5dcfb79e53166e3c7bafd1e3a00cc57f891b1",
      "text": "Abu vulkanik bisa mengganggu penerbangan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e9ffe0e99f5483a91ca0281b494b1bff11607e6ccee62085e5bb466691afe6c",
      "text": "Bisa lebih dari seratus. Petugas konservasi akan membawanya ke penangkaran.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f2263679acb6107e1f0761afad16ce31f2219716c911240b49591ae7775dedf",
      "text": "magnitudo",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fbcb7ec313da23a2c2515352caad6ef89b16c776001b78f50857312e8fe5b30",
      "text": "Setiap pagi kami mengukur tinggi tanaman dengan penggaris.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fcc4419d4e8a0cc731c31b0796f3c35fc6da66754718b4a3df76417cb36d957",
      "text": "asteroid",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fd09c8acca43095ecb8def615540ca3082645057b64de97245d948c53ab3867",
      "text": "Matahari sebagian besar terdiri atas hidrogen.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "11e61b359992e347b7c68bf9d61f334b25175c63b854f0a29d7abef6bdddd9c6",
      "text": "teleskop",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "12712fd69e8d0fc2fb89ee1f4bb4e49903e37c597ef195cbb8a590deae3dadd6",
      "text": "Pada dasarnya, Rafflesia adalah parasit yang langka.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "12bc001c2c2d978d72d31d1e223bb63d3b2b7ee7979f4ff4ba79c5efdb8a5edd",
      "text": "Di kota, polusi cahaya membuat bintang tidak terlihat.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "143ab7bae89764e445cdd0bf777f0a7539b90adaf9a7dc5a2a528c9c17ca7e98",
      "text": "kepunahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "159f37ad1c0b0f784931268b1976952cc3305b747abf41ea8f88b7badb319d5a",
      "text": "Kalimatnya panjang. Dengan kata lain, baunya mengundang lalat?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "15df37dcc09175ba6984243e5ecd20aa890d578e87857fff7a48e55be8251e33",
      "text": "Ssst, Aisyah. Itu penyu betina sedang membuat sarang.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "17ed0d4f57fa25a1d536ff3e5117364fca698251eb84dafdc5ee9c94ec4d12a0",
      "text": "membayangkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1824c2ae04ec34fdf7a4dec73ad92f81b8691a648e2db2cbcafaccc3a1c00f4f",
      "text": "Iya. Kata BMKG magnitudonya 5,1. Episentrumnya di laut, jauh dari sini.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "1aa0af388e78373bcc48f00d260b22b7b9d2b3da5274e9f86601943584f91cf3",
      "text": "Kelenjar di leher saya juga sakit.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bf9eaa2dc304d33e98354f7ae35d6f25b123514615f2b46d4b94f28b0b64feb",
      "text": "hidrogen",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c01d9e3a627341a44e06d54b985f9eb22275ecfc3bbdfd4a0d1d98481e101fc",
      "text": "Diameter asteroid itu sekitar satu kilometer.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cc5b35a3b9ff93de6303e428b9831af3dc50b514b6bf24e2cf90959036465a8",
      "text": "Dokter memeriksa denyut nadi dan kelenjar di leher.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cf19de5ed25394608f7c2692fab7eb2c5af1c6f782edf04da2f752eda52f787",
      "text": "antibiotik",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dd11079f546ddd36937db907858f3a66dbbc1c6abe8292d9a47a12da14379c5",
      "text": "Rafflesia yang kita amati mekar pagi ini. Kamu beruntung!",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f95457e5c6298cd1878964159b32f4f31329e139aa6759f27d4b8daa19e576e",
      "text": "Jadi Ibu ilmuwan sekaligus penjaga hutan!",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "2108dc3bdbd288e8b230083a48f5b49e63e7c248ed7e700fba00ac5f160bf06d",
      "text": "sederhana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "215443ff494325a155d0bd4cd88e45f6b8b94cb40a0f9c6c8896e4a5e40a91fd",
      "text": "Warna mata kita ditentukan oleh ___.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "223c0b5776ed6e6a6da5c28ecc6d07c5e7272b5f1a166da1eabff7d5cd077e9d",
      "text": "berada",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2407ea9b73e1a0cc14219889161a83e9b06de5acda16648dca73101dd2d5d650",
      "text": "Antibiotik tidak bisa membunuh virus.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "27606b57144cc39f3d615d15b3861187b8dafe4f5be9602db2ee7bd48b184e24",
      "text": "Tepat. Fenomena ini disebut penyerbukan oleh serangga.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "27c1fa101fe64815232ad1f764fd115ff78ff93ef6708dc27592df368fb57d89",
      "text": "Antibiotik ini baik untuk radang, tapi bisa mengganggu pencernaan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ca68efbbab551da6f84035980e98b0d4c196213b0584a421056ebf8cc6ee942",
      "text": "dengan kata lain",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ce6a23ab2d13bb9c3a77426423ddc4489ba55ba372875426c6da2c60777fcba",
      "text": "mengukur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "31bb05993280891bf969ed3e0abb1f051ad22bb8f13f7ea7cb27af47fcffada4",
      "text": "sirip",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "322fd6dac50fe2068980441b4e3df3b77cf7b58a2ee9ae7682bd3ab7db8dda33",
      "text": "Itu normal. Denyut nadi Bapak bagus. Banyak minum dan istirahat, ya.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3306e33fb698d8a4fa210da0ab1879d290b46c1b2b957d80748fc86cb9e662cc",
      "text": "Yang besar saja. Pengukuran diameternya dilakukan oleh observatorium profesional.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "344ec72a7da79b50aafdef8420650cda1f2217afe8c547f8d44723a8b5d42496",
      "text": "Proses ini bisa terjadi selama berminggu-minggu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "37f5a5a2704335a2288be021e0d27eea5f5f6c3c96101adf747ecf6abf8d5b64",
      "text": "Pengamatan Rafflesia. Kami mencatat pertumbuhan kuncupnya setiap minggu.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "391141707232359fbf26daf0811214e9555988c97dd1147f437ebe45d8cf6b96",
      "text": "Peneliti itu melakukan pengamatan setiap pagi di hutan.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "39dc81e60b8fc5f33302b41b1b3b0b51a57fc72661ba79aa5bbc68f301fc7db4",
      "text": "gempa susulan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b031888cea3febb6a93b685cf9eeb076d9230c86a3febe4a3698d44836ffb00",
      "text": "Anak itu membayangkan bunga sebesar payung.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "412a140e1fdccd378f72371c0dea59cf640791307a4e5f516acc7ed734128d70",
      "text": "Astronom itu memasang teleskop di pantai.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "41ab9661c5e2995bb186d0b02a10e063ca5029ae6ee2b9e709103715b6cddb7e",
      "text": "Penelitian Ibu tentang apa?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "43012f690dfeaadfe37e8e1ef32bc74c59321ca203bef8fc99b90c9fe1bcdd63",
      "text": "Malam ini cerah. Teleskopnya sudah siap.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "43575b7d142a5759a88f1b8b67c0bf1201526200abe4c2f11bfa6e30412ab483",
      "text": "Tanaman di kelompok kontrol tumbuh hijau dan kuat.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "437b84dddea924f5819c571a907008ec5cc0a37c1df1d8b911388bf7c7e589ef",
      "text": "Peneliti itu menemukan jamur baru di hutan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d6e3f4e73751e7a2e96c1643059e6e35beb21d88917d716aedad83a28ae8e4",
      "text": "Besok kamu ke Padang, kan? Jangan lupa tulis penjelasannya untuk blogmu.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "45556942b367a8a24b777df387f8e324730228266af358c2ddf4016a6bb2a393",
      "text": "percobaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4666c11889c4a518d37e0fcb9ed76d9d97d5de8c434d5ba720d850bc2f3e7782",
      "text": "Jadi ada dua raksasa yang berbeda. Saya harus memperbaiki catatan saya!",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "4737b2cf23bbb657f18c9d00bbdd08d28fccbcdb4bb4094de9ccff74d00ca68f",
      "text": "Akhirnya! Setelah semua pengamatan itu, saya melihatnya sendiri.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "4789dac11a1f87cbd9d969abca072deea62eafa4901650f5bc7fcf98d76adf22",
      "text": "kuman",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "492d9f43553b26f7dc82b9d726410261a97d4deef39da0ab35042b71ea892ea3",
      "text": "Banyak serangga tertarik pada warna bunga yang terang.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a0497e471efb107bef73f7859c7baeb39981938c77d4540d5e9fdcde7e1ce3f",
      "text": "Tahukah kamu? Badak Sumatra tinggal kurang dari seratus ekor.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a929c972d26a260a60f4a863565e2b651912dff53e4670b36a32b022c5addbe",
      "text": "metode ilmiah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d145908cff60ef2d5727f50fde2c81aa3809b8ff84d559d9da2ac495d13b329",
      "text": "Proses letusan dimulai ketika magma naik ke permukaan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e38ae913ad9edcf00e35ad44c309533c3054b94fe3d6c97a55437216c517e6d",
      "text": "Ya, migrasi penyu bisa ribuan kilometer. Alam selalu berevolusi.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f03499790fe588160a48a8b0f0449d7401f7056b3097dbd54107d78ebd0317c",
      "text": "fenomena",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "501ecb3c0666dedd89cc2b8d6d3c8e60879db821f54493c0c15633f183001e4b",
      "text": "Paus bernapas dengan paru-paru, tetapi punya sirip seperti ikan.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "50512aaab38c18a7bccdb12513c978b431d53b565ddaf562d6f4a0f42a959132",
      "text": "Hasil pengamatan kami sama dengan hasil percobaan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "55082d06d48e79a8aa85be37a0572e71427d947402b830154565eba02b68a4eb",
      "text": "Karena baunya mirip daging busuk, lalat datang sehingga terjadi penyerbukan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "561756cf6a46c9697db36b940b87131650af4d66fe5443daf1299ac2515ec93d",
      "text": "Tumbuhan langka harus dilindungi.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "578c0d3a2c545e57a2db644d55be43949daf4da6d8d0e9c2482ee688f99a0a64",
      "text": "Episode tentang gempa susulan didengarkan oleh ribuan orang.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "578d484f893ed3fb127566e7a132df545c5bd5be5571ff100640f6ad9fae7066",
      "text": "Apa saya perlu antibiotik, Dok?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "57c6ac53d6796554645fbd5068f1873f551c2e65e94ad68f3f06ddeb0dfc1f22",
      "text": "Kami beruntung melihat bunga raksasa itu mekar.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a1e8fdfb2f7712fc59fa4ca4502a34bd35a822bd14b332d5c8bd6d790d51e60",
      "text": "sarang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5afcfa56e203a26813c2b3a7dadb4e041b3eaa9c179e77ce606986dd294342fc",
      "text": "kelompok kontrol",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b28edb94d9f343d6261ff5403fde824046378dadd735fb0795d161a5b733110",
      "text": "Belum tentu. Kalau penyebabnya virus, antibiotik tidak berguna. Kalau kuman bakteri, baru perlu.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b8f85574667a112fce9e51c2e0eb14859bfbff1a20e8492068a505c905684f3",
      "text": "Tenggorokan merah dan sakit. Itu tanda ___.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca86c85e6643a23654066501c581ae7915c8a3782206ded012856d2d160fb9d",
      "text": "Cuci tangan sebelum makan supaya kuman tidak masuk.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ce9780f5b59c1bbae70f039c073cb63d971601e8a5d40e1e3a0c9294aad9597",
      "text": "tukik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d5d5258b3d07e2580a69974ed45947e50d1ffa89373ce4ac0ec9d25d076fa09",
      "text": "serangga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "604a6059047108b0f313202f7a531e70bfe1f4e2be9d3ee68dead6648c353785",
      "text": "mamalia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6600dce9f49ec7becc9a99def0a2943350eb29c73f636f9512c44e6eb7620b38",
      "text": "astronom",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "66bd0a6a9a83ea5b90195ccb7e44cb25d82d689cadc3791be39bef5f587f2cbe",
      "text": "Pada dasarnya, perumpamaan membantu kita membayangkan hal yang sulit.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "67c037b39cac1a7a8e498aecc1e09645ce08b20e2822496d4f078ac079750eef",
      "text": "Selamat datang di Bengkulu. Saya peneliti tumbuhan langka.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "67e6ac3295509f8c3728f481aacf6dd9a6cff2110f41b3be96d172a40ce98d92",
      "text": "episode",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "68503c152803c425614fc08a41c11aa73f3c7c969ac93a43d838ada5c8230b5d",
      "text": "Apa kita bisa melihat asteroid?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a32cea00b3b051f8604f68c2c1ede707b395850935febbf8636a34e78bf6522",
      "text": "genetika",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d0c9eeb479a5f292955f8c4518a86a68471d3aed892ea7de74a13e1c7b56e47",
      "text": "Banyak orang bilang begitu. Tapi bunga bangkai yang asli lebih tinggi dari manusia.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d17bf2b2406f496246cf6a442c751b3ec6ed55ccd419fceb73afb13b77215b2",
      "text": "Setiap tahun, burung-burung melakukan migrasi ke selatan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d677e4f9954ee9fb649c26b9810b60de5491e10744d96d1fe4a9781c572cf25",
      "text": "Setiap sore, relawan di penangkaran melepasliarkan tukik ke laut.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "6db9de23759d77806458c12310e79b731366cc6bfd35b7ae9f9a595323da517d",
      "text": "Indonesia ada di Cincin Api, Aisyah. Lempeng di bawah kita selalu bergerak.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fcd98623a390e130ca75ac34f209920f5eea9be3a0b210a588f4a7885d72939",
      "text": "badak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "703a4c492e9cb2a4e246c251c8a6f24f7241d4a3f1f64ce6d2a14d8b0b2527b3",
      "text": "sehingga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "71908f5be15b1ec2304c3687ce101977e290bcd7b525f9a73bf0b361307d8f76",
      "text": "dilepasliarkan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "71ebdfe23375e7adfc5a049f86906db1e6aca8d400e8c95ae82d1a4439d4fa2e",
      "text": "observasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "745a7067552f1b53a643b4be1b915bd3bf22180f026c6c49dfc4deae2caaa114",
      "text": "Pada dasarnya, gunung api adalah gunung yang bisa mengeluarkan batu panas.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "75e9551049c7f49a9d79bdf28872a38567d7a57ba56c4d7d4272fe8b7bc6a68b",
      "text": "raksasa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "77992713bce389c3fa5a0518d18f060a746c94e090a6275d3c3629d31e31e16d",
      "text": "Di episode kali ini, kita membahas kenapa penyu selalu kembali ke pantai yang sama.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "78ff3a6906bc165f7127ff546c818e8f14f09cf87dbe50e3738f23daecb8037d",
      "text": "Kenapa Indonesia sering gempa. Saya pakai perumpamaan kerupuk yang retak.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e1c82195e8a818ada2101b2b3f24605df65e24a2d590c67fe169590c4563e82",
      "text": "tahap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "83695efbc3d479c8b8fb1c6ee02268ecfe63ff39fe90a381e10b3a74a112bd78",
      "text": "Badak Sumatra terancam kepunahan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "83f4d4e19ce038cddc42afaf3e0131ad4f0b6cae07308203ad700fd3f336b928",
      "text": "Para ilmuwan memakai genetika untuk membantu perkembangbiakannya.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "85cbd04009a740c9c424d27305282bbdc27b3b35c6919b799eee9da0e4e8f43b",
      "text": "Om, kok kacang hijau di lemari tumbuh tinggi tapi kuning?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "85ed52e44bd81335723f4002b788172c7c96ac9693019a7cd989db96045920b6",
      "text": "Pada dasarnya, ilmu itu sederhana kalau dijelaskan dengan baik.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "881787903a87d75b8d77293dc6ec8c0674aed670e91543d2f2497342c33f35e2",
      "text": "Program konservasi ini sudah melepasliarkan ribuan tukik.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8854f814b93ea42e8ac1e78d3f6eb15bd722fa64473688925070457dd4439096",
      "text": "Penyerbukan oleh serangga adalah fenomena yang umum.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "898e760cc33730ac50f2958ac774e65fb1ea9d7364f67d0425c06a9860ca50c5",
      "text": "Setiap tahap dalam proses ini penting.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b244a724fc35d62add9d534a443a334885b9a91753fccaa22facb4bf6dae669",
      "text": "Tenggorokan Bapak merah. Ini radang.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bc777e98e89b01b7279a5966ed0f910081f4dca4325144af39be7bd1dfdbf27",
      "text": "Jangan menginjak sarang penyu di pantai ini.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "8be09671b65b7231160a58753e017045ac6fef40275ae79c52ce40c6b4f457d1",
      "text": "pengukuran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ced6a8be73f5032f7a6c2ce70c78596d6df390ad4959573287e581d7f8e3d2c",
      "text": "Kelenjar di leher membengkak karena radang.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d5dafdd357721de10648fe6a78603cbb92bddc910cf6f0b15045b6dcb46a001",
      "text": "Seorang ___ mempelajari bintang dan planet.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "903e961aa61bf2b2629c1bac01db86f71b41a07324df55089052c1222ed42e92",
      "text": "migrasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "911fd3b3107acd68c6ca73e478ece3bca6fe28a87eae07c93443ba0f51d027e7",
      "text": "konservasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a4ebfa716f45671c32aa8b317bed6055721e1bb3812627e81f0b165c7458d1a",
      "text": "gurita",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ab53f98a6c542d91da407eb035ae1a5543228e0b55e164c9faa84d2317b6781",
      "text": "pencernaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bfb12041e537e4a4e14d52ef657df59dd71987a62a68e336c3bec5ff53873c7",
      "text": "Peneliti mengukur variabel yang sama setiap hari.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ea7f538435ce4b2fab24a73454603b13d96721c4244a5e8a2dfd8e35735c406",
      "text": "Om Mohamed, kenapa bunga itu bau?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0fbcabc1bb6d3f1befb00313b57d0b1d9adaffe55ba8c617e1bfb0b331a5442",
      "text": "proses",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a22e2ce345ed4ffc641c24ce7cfa7c3a941122edb8b8f5e13202b92f1e7587fa",
      "text": "episentrum",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2b6159b0bd6321addf3071c5f59d1212fe79f04b2d085113732d209af43fbd6",
      "text": "Aku boleh jadi pendengar pertama?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a393684e2e82622418b59c563b976a07ab9ec56fac19fba02335264d6e6e8997",
      "text": "Wah, besar banget! Telurnya berapa, Bu?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a411f5f6aef38c9cf0165c4fa24325ec05c65e4174c9cf52d4abb18edb78d445",
      "text": "lempeng tektonik",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a41334385dea50a955766835d4a7325c6f26a1190ce0f6096dfc4024969503f0",
      "text": "Dengan kata lain, fenomena ini terjadi karena serangga.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a41af7049360ba58d22f988de7794b3210ed42109bbee4ee94bab2faa754dd03",
      "text": "Radang tenggorokan ini disebabkan kuman.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5fb6e2aee89f0d2de49641d5470496efb6256e21237382503182279e407ff6d",
      "text": "pengamatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a65cf977462605678b1361951efd96688e92dd89a5558b2367fcd4948272e34e",
      "text": "Di episode kali ini, kita belajar tentang tukik dan konservasi penyu.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8207514b4e6ee99521e230238f9fe28a783f52d74e91c035653b7938d2002ba",
      "text": "Om Mohamed, tadi malam lampunya bergoyang. Itu gempa, kan?",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "aae7a0a0b941d82d50baa8f26aa7a8d382e6444286430627e49f7a54fdade817",
      "text": "Dokter memberi antibiotik untuk radang di sendi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad7dd85ae53c2d7b33c62a71199dd9b49fc082cbf91e7911fb2e0e486c0711d6",
      "text": "Astronom itu mengukur diameter bintang yang terbuat dari hidrogen.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "adbf7d11c5a5de714e9a8c9f291734cb8285e6fb74dc31f7be27ac59bcc87743",
      "text": "Dan kacang di jendela adalah kelompok kontrol. Kita bandingkan keduanya.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "afe11c8ede73430f9a1bcbe868d5671118e252a5aac58f0e3044ec4f98007115",
      "text": "pada dasarnya",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "b261048f592367441aa0349bfdb5d74893a0b8e295ec6f97aaf88af3be9b07f1",
      "text": "siniar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b297d99a502613872b345b08f35bba7f31d574fc8f45d17ee69b3a64a056d666",
      "text": "Rapi sekali. Tambahkan satu kalimat tentang abu vulkanik dan bahayanya.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "b447ce9ed96b2a529d546ecad10b3d413d06ba6f6070aca99911e742aadd898b",
      "text": "parasit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b668cd9c1d98d0fd5aae5c63694d0d1004c53aac1fb38d42f35397d082a89d80",
      "text": "Di kota ada polusi cahaya. Di sini langit gelap, cocok untuk astronom amatir.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7a224c5e2ad296d47551c85a461478b03dcb6281c1f1fc0418fcbfd3faaf878",
      "text": "Bu, saya menulis penjelasan tentang Gunung Kaba untuk blog saya.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "b965d2baffbb112c21d8cdfe8390dce015f8a70478020534969327a1ebffc562",
      "text": "kelenjar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b97fbb88052d52bb0b3b0c3716b096986b5a6382f45938dbebadcaa7ba9a2f8c",
      "text": "Pada dasarnya, lalat itu tukang pos. Dia bawa serbuk dari satu bunga ke bunga lain.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb5fcafcb4e6d82056a8276f09baf2a69b5211a4a8297cf96e5689e0480384b4",
      "text": "perumpamaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdacd42d49108cae1344cb8d155fcccbdac792c544f9cddf974bf5742b282f22",
      "text": "letusan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "be1f07cc71ba0bc1ba837cb9bc1b7911e5f7784c71b203bab7b335a7682cc2ec",
      "text": "sendi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "be4069815d42de1d8f4f48efb862411151e772c1ba72c9cfe23e8a791cf9060a",
      "text": "Para ilmuwan menemukan spesies baru setelah pengamatan selama tiga tahun.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf325724158eed249dca8370d0f1e8749b155f5eecae9664b840b39db03ec62d",
      "text": "nadi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0073818f3e58dff983566abea7ef12a133387cd14bc71ad053fda28bfe54780",
      "text": "Bayangin bunga itu lagi manggil teman. Temannya lalat, dan lalat suka bau busuk.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0200bd08149fe1d61f52905064186be3070b7ef26c51af56c3cdf92e89edac4",
      "text": "variabel",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40bbd16a9f800770789cd1d321acbc3852c5f32933a47c770a972182dd8afdc",
      "text": "spesies",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c463d0d5291b282d698991ce836c6e169cb625f50bef1a426b99513b9c645c70",
      "text": "Kelompok kontrol diletakkan di dekat jendela, sedangkan kelompok lain di dalam lemari.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9a2693464f1830182bc4e46ef8cc3f3efcc2452fbdaa83239f37b543006921c",
      "text": "radang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc425b62393b709a01f1222a85a86627f1c3f09b698d0a768c5a5ef6d64f103b",
      "text": "Makhluk hidup terus berevolusi, dan kepunahan adalah bagian dari alam.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceea6236fa4d4e6bf5f78794fae81908b669d0d9c26d3c9c7100a793820558ad",
      "text": "mekar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf3f01a2953d82ab765d607e11a442885288ad9dc4f34854cdc6acd353a82bfa",
      "text": "diameter",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf40a2df7dcb5ef7a2ac18b6ddda27727b53f35adffe722ecb1658e9b19f62d5",
      "text": "Sedikit sekali! Apakah kepunahan bisa dicegah?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2b3f80ed61d75fb156ce866911dbf8eedfd7cd3e3ad9237956d0946f98c6fe6",
      "text": "menemukan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d331da69eb61599b3c2aff6394b4ac81c316407408bcd76d404b24e715df85c8",
      "text": "mengulang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d591aafe0f33a79e03d6c92a7d260406aa226eba709ac7159ef7bbdba133a5bb",
      "text": "berevolusi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5d064e70d05125e515a6e1015b8b9417ef4b50dbd25076f7e1777c24687be3f",
      "text": "Para ilmuwan melakukan pengamatan terhadap spesies langka.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5d34e4889a962f082db2116c80aa797b6b8ae0e07ddcd5d546bbdbd82dab2f4",
      "text": "polusi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6eaf2fb3d175753da6b0c76947071ee052361f798b71c019fb624719d4c07da",
      "text": "Pertama magma naik, kemudian tekanan bertambah, akhirnya terjadi letusan.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f76cb16d608024414de0e18a613634dbf70f2bbe8bfc04ea5843cbca6dca55",
      "text": "Bunga ini hanya mekar sekitar satu minggu.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d74b3ad1168e6bea22314f10530099a92a818e50da92c141275d8c7fd77e8675",
      "text": "Lalu lalatnya ngapain?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8cefc2415ca70542eeb798d1cf96c5c2052fb6c25f6e380532fe632e47d0c7c",
      "text": "sindrom",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9437d3b6e8357a449d241fed6b6200c469520227f929dfa84a33f07099db084",
      "text": "Indonesia berada di Cincin Api Pasifik.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "db2dd1116e474089f227a636454ad61ba3beebdf54446d55800b53254ae2ce96",
      "text": "Gempa bermagnitudo 5,6 terjadi dengan episentrum di laut, tidak berpotensi tsunami.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "db9757fe51ee4f061935cec18e4687927641de440ca4f0a363afb5b4bcd3cd1b",
      "text": "Paus bukan ikan; ia mamalia, walaupun punya sirip.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc1e363139407d30fa47b46ea07fabf5ac530858e44f3cb97b622cb5ff47b3a7",
      "text": "Bu, kenapa bunga ini berbau busuk sekali?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "dea341eb6dbd085adb6c4f794e591938f8f4fb860f6858507e82a571114e2233",
      "text": "Boleh dong! Kalau kamu paham, berarti siniar kita udah cukup sederhana.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "df2799c13c9b8848536aaa2c6538da1c7a93af2b12ed5bad27fe9fa0a9637f72",
      "text": "Cincin Api",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2498312255b29af27e8fb9ad525eda55bcfd43094a74928f0a66c879999d0b4",
      "text": "Astronom melakukan observasi dan pengukuran setiap malam.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e49c40b95f55f9f6fc49e2ecbb9b895c496c040ab4b954e5035b0c94a4183c15",
      "text": "Kenapa observasi harus di pantai, Bu?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e832e8a18af1d7e5039460126ed097d3ecb869823a93f3c58578ecc5467cad33",
      "text": "Asteroid itu lewat dekat Bumi, tetapi tidak berbahaya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e833b8150fbbab61ea151fa83765edb410f4ae2dafd0dcb3a945c90bf3000be3",
      "text": "magma",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e886aa119fe734ed41d2345704cd04ed9c13d25cb9d84ea427e2cf42defeefe6",
      "text": "inang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e90f5439b53456f735798ca43d90170025b130d13fad83faba305ae3fe250a6e",
      "text": "Mohamed, mikrofonnya sudah siap. Kamu mau membahas apa di episode pertama?",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "eac0ab84c76d813013503bb4ffbd1c15245fd17fbcbae84c96f8731a63d303ad",
      "text": "Besok aku mengukur lagi, terus kita ulang percobaannya, ya!",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecf77fef8fd75170e9b6295d2cf6f2e2c4206bb23369ee95a64fda4f5b35630d",
      "text": "Karena nggak ada cahaya. Cahaya itu variabelnya.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed1738e410652ac2aeab10c4202e374187224766efba6ac40cd35bc5082f4f29",
      "text": "Peneliti muda itu ingin menjadi ilmuwan terkenal.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed64a96640026337797cd60b598560bbd7354cbbe535b4cb62642e66ca4efac7",
      "text": "Di Laut Merah, saya pernah melihat penyu yang bermigrasi jauh.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed779aa5e472b05ecf846b78b834d18653b869b6e039b17a556b212d96d5b8c6",
      "text": "langka",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04ce3cbee8d9fdc87d2d549101b7d7ff098adc449e3dea525a5d112b7a71bfb",
      "text": "penyerbukan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f30228814b46d1db441a105795681cb5075de8ae0d82ee9a542e1b6beb06a164",
      "text": "abu vulkanik",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4cee09434da8bab0be4b6b6b021af4aeda2a35af064f3001934696fe5ee46c3",
      "text": "Indonesia berada di pertemuan tiga lempeng tektonik.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f74b8587ad5038cbd9183823565874613323e383803ab6a6ec31d1e63e7b1b90",
      "text": "Gempa terjadi karena lempeng tektonik saling bergerak.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7b1996f262a19bdc62645dec3c0f37b698be1b8a1d458cd4b2eea8e2008df38",
      "text": "ilmuwan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbf669f35382b3d1d7f5ea145de677834c58ec3fa37bd02ee4bdb34d50234c68",
      "text": "Kalau ada gempa susulan, aku lari ke luar kayak waktu latihan di sekolah!",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc14dca1c9fbd1eec89210d3ec39a5effa0679be5bbcc109df78f69f66ccd472",
      "text": "Halo, pendengar! Selamat datang di siniar Sains Santai.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd44a9773f5d68ad0dfd0bec77e95fa25b460607becf96b488c46994acca4256",
      "text": "Warga diminta waspada terhadap gempa susulan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdb0a8523e64d65173dc64378e87bae57159276e307a1011880c34e6a9944041",
      "text": "Besar sekali! Ini bunga bangkai, kan?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe1e4b933c56d2343d54b3e90796c09c3d2dcf073f0d7017b1c5460dc23bb26d",
      "text": "Dan nanti tukiknya dilepasliarkan di pantai yang sama, kan?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff2bd16bb4a0876a892a400952b7fa61941216dc2b12f8ceb5b43bd1de7bc160",
      "text": "Lihat, kuncup itu akan mekar minggu ini.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
