    },
    {
      "id": "bipa6.u08.l06",
      "sha256": "28a17274b845831a644c4d41180ffddb9be23ac866ee52d7ecb05e6028d0493c"
    },
    {
      "id": "bipa6.u08.l07",
      "sha256": "f24a4132e102191d89826912357b0268152bab551c8b2f5129e795fec85b18f6"
    },
    {
      "id": "bipa6.u08.l08",
      "sha256": "3b6d125e2f5ce8120307ba35984b0c72f1922e2bb62f15c1f8438978c154fab9"
    },
    {
      "id": "bipa6.u08.l09",
