    },
    {
      "id": "bipa5.u07.l06",
      "sha256": "a254f8779de986897387813aa5dfb631ee1af5d80568cfb6e69db4625bbb4a51"
    },
    {
      "id": "bipa5.u07.l07",
      "sha256": "a8fa85cb86eda59810a58d0a243c54827adbdcc6eb631d9bfb51f46b3564d28c"
    },
    {
      "id": "bipa5.u07.l08",
      "sha256": "290ffb99a7dffb60df89345fc7fffd5a946f7fc00f75a64551c8bb9c3f8fbf80"
    },
    {
      "id": "bipa5.u07.l09",
      "sha256": "7bc44a41d463e1c14b8fd39f233c911215c1b38955a2b4a290d57963a59d3c1c"
    },
    {
      "id": "bipa5.u07.l10",
      "sha256": "c01e4e13a9ead7de300a2622c1c092348a5fb429466bc4188afb8989c76d3d42"
    },
    {
      "id": "bipa5.u07.l11",
      "sha256": "8cdbd064e5eb092bd5059179e1f72d4c479370fdccd8d26073c7eda419e10daf"
    },
    {
      "id": "bipa5.u07.l12",
      "sha256": "85c64c87e86652a8ca469633afc67611ea4de91a0313c65bb6c8d5898ef68d83"
    },
    {
      "id": "bipa5.u07.l13",
      "sha256": "871192ea7a2a33d95102dc140522b8b5c28cc61709993c4ddb3fa7aa0764ff6a"
    }
  ],
  "audio": [
    {
      "key": "01bae302d9be867734973b52383a3e2941c8e54eb2ebe239ead0d4d918ac8dbc",
      "text": "mertua",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0282f80fcb234fd49ec1b071d8d272ad4ffead4cf5254d4d370577863587c55b",
      "text": "Wah, seperti kunafa di Mesir. Kue ini bagian dari identitas Ramadan di sini, ya?",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "0458659755e730dc4e65b85b89135bcd8fc8c735ca845976b63d0b5196568796",
      "text": "Bagi orang Mesir, koshary ___ makanan, tetapi juga kenangan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "05627a3b9e57894bf5d851a7ce6a831fb84e718c552f3780affe3b259b7b49f6",
      "text": "Ini ketupat Kandangan, Mohamed. Kuahnya dari santan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "0579fb6dd33359d18cbb82a94c5a24fa2b8abf0dfe451521ee4c8bcee6cd4c62",
      "text": "Wah, wangi sekali! Itu kue apa?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "05e1aa02497ccbe3d1bee02fc2ff8056a6daf7b781280f62dc105987cfb881b6",
      "text": "Udang hari ini sedikit. Pasokan dari laut berkurang, jadi harganya naik di lelang.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "065ceb0b3e9c85512ada17e915ee16a22020f47a983afc9423fc548ecd720b1a",
      "text": "pengaruh",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "06bf032df0747cd70db778c3d44954410399001226356c4277bcfb34db450c57",
      "text": "salad",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "09744a528f5faba65720578a15c6adc6545a187e09a85156939d832c48316e8b",
      "text": "Tidak apa-apa. Yang penting nanti kamu kenyang.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "09ec06077de678332b9dae393bfd29ff2f5626f0a47d70e2f4eb64437fd4037a",
      "text": "dagang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ae01a6aa87175cdfa6153a32d3428171448f21c907c5929ef9459d5a8ce22dd",
      "text": "perkampungan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b78cf4cda27de432725ad88ac7f912fc2a2daa89bd86feba6501cf4e032b887",
      "text": "Pemerintah membicarakan ketahanan pangan di Kalimantan.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bd4194427acbfaf4aafd1e69e56e2d3bdf9d07aa7717fed859af6d8273b4c3e",
      "text": "haram",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d5553e4cd7e4e185db86871b79c344d8f95f807871ee8bb1dfa85823132b15a",
      "text": "rempah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e65014e954a7f10b893298736fdd90414991c1089b316ff1956d76d66d5d7c5",
      "text": "Adab makan di rumah nenek sangat ketat.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "126359c426d90c372cc76b5f6e7b6a6c0d2e8ebf1c5383188d7cc3ba0071e783",
      "text": "lada",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "126e5a2e7f7320ba571fb49e284c2d6ee34d0afa6ca4ddd912dd6c2ecaf1ed70",
      "text": "traktir",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1540fec88da18f62fe1d64b25a89b3b2193bee51a72e91cdf212c30766529dd9",
      "text": "mentega",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1795634ecbb0b8d0349314737a4cd90801f1909f280708c0f7b3bd86e071cc14",
      "text": "mencerminkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "17f50c385a9d826113aa7042ed3d70252adc2d52af5200f1f6f7f2b04f7361df",
      "text": "lemon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1864a6f8b674d719a1dcd5079bd7d0785c3589bdf7568dce21ec9b00cbd49f83",
      "text": "Ya sudah, kalori dihitung mulai Senin!",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "18cf5f103cab7fbada19a2e96d476624eed6c486185e16296d02524406d76f44",
      "text": "pangan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "194a16942692234a151d6cbf0a0c45c796b4d6d58c41b66b833cfe277870888d",
      "text": "herbal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a646c8a60a698959dc378ad4245ea00af2213f11fe650e884b607c9160036a6",
      "text": "Apakah mereka juga tertarik pada makanan kaleng?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9d4f1c42c6ba07f1bcf53725defd3f22f2ba920511dedaf6ccce980a6219a2",
      "text": "Konsumsi gandum di Indonesia terus naik.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f1ace95762d954776cdd29a34721efc5e4967a488391dd62a70d0995357c435",
      "text": "Ini soto Banjar. Coba cium, harum, kan?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "20d33f9096c37424e102adccae579723a1d2ead63998f2dc3c1711d2075df3f7",
      "text": "Mereka mau melihat gudang di pelabuhan?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "22b4228c05dc175aecff550c13652c7463cb3f2ccad1a0b2a45ca046a67f0bde",
      "text": "Silakan masuk, Pak Mohamed. Hari ini kami mengadakan selamatan untuk cucu kami.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "2462cf4b7e3d38be67656cad85c904f6f9b3fd69d78faa4ba7f6151fa1cca6fc",
      "text": "Pedagang di Lok Baintan berdagang dari perahu sejak pagi-pagi.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "26286246d7cbb5d986427af58d47f741ef32ad50b9ccbb4e83ca40e350df147e",
      "text": "bakso",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fb6bd5a3ab4c77017771265a5dc6aa44493c3f215b62887177e2a5fbb32f400",
      "text": "Waduh, saya agak jijik dengan kerang... tapi kepiting saya suka.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fdb435bafaaebda0071d80924f432fb07d0594a970c71575c3d09749a6f2bbb",
      "text": "Menarik sekali. Besok pagi kita ke pasar terapung, ya?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "31a9fa08b1dd496f0e99a10107191ad5f638d5807da80a34d96791db1eca2b9d",
      "text": "Maaf, stok kue labu sudah habis.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "326fb1dd8479fafd1e80906b0320047b4a63a34a82e99c52a789913e1d108e7b",
      "text": "Barang dagangannya sudah habis sebelum jam sembilan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "33cec91f322040bb1a7afcb334c1de057893a03ca23bcaee7ef4a79738c25852",
      "text": "Sama dengan adab makan di Mesir! Ternyata kita punya banyak persamaan.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "37a5a67fe6caf3104f3989625a2572e38705b61e87a6c52bc442b7a6db18fd8e",
      "text": "Terima kasih, Bu. Semoga cucunya sehat selalu.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "37f7610979c60f326698eed1cc7a5b0db10e85bc23cc9b9ceacc831ef10cc18c",
      "text": "Kargo tepung dan sosis kaleng sudah tiba.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "39f7e06824ca1d3aecae0e95ea3aef32d716b04c236c18e3bfdf8b51b86a759b",
      "text": "pertemuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a50fcbc4f4fe5becc2791079f246eeaf936b17e374df848b3b3b3c378464daa",
      "text": "Pak Mohamed, besok ada tamu dari perusahaan distribusi Mesir.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cf73882efa3f75b8ad607ea47e7d4176f0336bb4637a4c490bd07b3e45c8646",
      "text": "Ini kue bingka, kue khas Banjar. Biasanya dimakan waktu buka puasa.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eb19332e46ad92253f3e0ccc6c5f8e1a990a990037c192c5058964eb4c91cc3",
      "text": "Sebelum membeli, saya selalu mencari label halal.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3edb23e789e4c349c565ee59b673d256609d61f00138e6561f9c883af97d3005",
      "text": "pasokan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f6c4670747f97b8715e0e4389a4fd7b281b06fab8dcb54de21bbf7afc52f421",
      "text": "piknik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fa04f7cb433c05e0753ed8f25a4779b1b63959b17210ab8d60bdbb0980c4403",
      "text": "Ibu saya mengolah ikan dengan bumbu kuning.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "417b65dc848c6fd21ce868fee05766d564577745c8c3882681e2e9d0edf82739",
      "text": "Terima kasih. Mereka masak apa?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "41c8bba6ef908cddcd6ea2344d2f57c96a77c3e009fc9c28ed7972a6a2b9233c",
      "text": "Tidak apa-apa. Di Mesir, makan roti dengan tangan juga kebiasaan.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "42a3b315dabc4244f63b7799fead85f904378b7846c60ce38e328564113759dd",
      "text": "Dulu orang menukar sayur dengan ikan, tanpa uang.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "42b19b5ec6f9b54f80c07787ffe50440e9d982b8fbed9798097930da1e5a33f7",
      "text": "Bu, saya mau beli kue ini. Namanya apa?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "453cfb771537f93d56738422a2d403e0aa94964b0d6e609ffc87e9e1c52acb85",
      "text": "Tradisi pasar terapung sudah ada sejak zaman kesultanan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "45973e77dce128586a881a55052b67c0ff88827c130e0f3cdee8e506b62db577",
      "text": "turun-temurun",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "47fd6b557ba078d7678b88b16a0495657f690b46ef561e6cc05d2131d31dc875",
      "text": "menghidangkan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "49668f95fd06157e9166cfe1c0e3424c61105b077e6877fdca6514d1c34711b3",
      "text": "Soto ini bukan sekadar sup, tetapi juga sejarah.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "497483f5e8e5eada03972191b7f184958d3b9d79c4d02482394650fee0672625",
      "text": "Santan dan sedikit pandan. Tapi nenek tidak pernah menulis takarannya.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a7238db8fae56df716599391171e95e50ca1b6a13812bb89fedf1e5e0838835",
      "text": "Mohamed, ini kue bingka buatan nenek saya. Resepnya turun-temurun.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a8a3840504dc28dc0951c37e931bed5efc36e9c342e9fc753943a9837fbf1f2",
      "text": "Tapi di dekat sungai ada penjual bakso terkenal...",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c89146ed66e2c25399eeb9e582fe6a5b5946c27abc146e71a8e06e1d53cfde7",
      "text": "kepiting",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d892468cdcf55f229c0841e671f64f134f4591350b25f0964f2e0c6d3e5192c",
      "text": "Soto Banjar memakai kayu manis karena pengaruh pedagang Arab.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de21c3833bb7dd185c3cc987c62aa2a3664a277b70c10cb5b807d806dd10989",
      "text": "Di Mesir dan Indonesia, makan bersama keluarga adalah kebiasaan yang indah.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "50d40ea66ea8d1f3225d0d68178f887f8502127cd0869c4f2ee7da7fdb56f3e3",
      "text": "puasa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "51df46e8bcb43d11e95643ea1ee6b9f7062cdd64feb4cec445740d5c29c7e510",
      "text": "bursa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5314646b084df0d1efae0aceb1c08ce6f21176938bafa23d5dfcd63903dbcedf",
      "text": "Makanan ini lahir dari pertemuan banyak budaya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "54cf282b2a4f86c356f8a1c0097dd93dba3e767830bd54655dd6de9d10cc7800",
      "text": "selamatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "552a16f3f2680667a11ca348b9080cd3c78608538077ba06f064b89f758360b8",
      "text": "berkumpul",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c79a98522935f70eddd361bf427404aad37e13e04d7427a54d1f2f8d131e65",
      "text": "Bumbu rahasia nenek tidak pernah ditulis di resep.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "5650443f3bfe6fd73965271aa1b462371536f65fe1d5ec33528bf79961e5ada4",
      "text": "lelang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "56aea676e64ba9c7b403bca659624dca4e3d402997778059f82de4e1c418925a",
      "text": "Saya suka soto Banjar karena ada kayu manisnya, seperti masakan Mesir.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e61690cadf060dc5492be5916d6f9b908550dd49c6726df224ad1a06a85da50",
      "text": "Banjarmasin dulu pusat perdagangan di Kalimantan Selatan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fc3a3a9044147fc4baba8fa61d2d2f403131dd2fcec7a8fb695747319fb4a3c",
      "text": "Ayo makan. Semua yang kami hidangkan halal. Apakah Bapak punya pantangan?",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "60ff7c9bc9ff2e75f8d2673f8447502ef832ac35c2f05c04a8888364fd6eb48f",
      "text": "Setuju. Makanan keluarga mencerminkan siapa kita.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "614f616165ef7bdd1edfca0474bb90f88b8707cfca58b3fab7f8da04fdbd3e1b",
      "text": "adab",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6186bc04a7a74e4f33d9507f18a08a4b032fc91338984644ce1f4b1dcfe48eee",
      "text": "Kargo tepung itu didistribusikan ke seluruh Kalimantan.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "625d850ecd23c30e39429cffb691810b8d57f17b9d901c13e6819945a2171c2d",
      "text": "kaleng",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6284c0c50f3ca3470a2f52cfced5ebf9dec986333bd696240822edd06adb8339",
      "text": "Tidak ada, Bu. Saya hanya tidak kuat makan yang terlalu pedas!",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "62c5744bb8aa083d01531139c6b53d9af2e1bdd687f6966610847df36cf6c99d",
      "text": "Ada ulat di dalam sayur ini! Saya ___.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "66d9e85eeb7d4f88cb6276be283eaaf6086c65ac44e60d3d00f00240708de544",
      "text": "Kue bingka biasanya dihidangkan saat buka puasa.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "66e46be446c80e39607babbce4849a740df707aaddc4f94564c98af6a6046a61",
      "text": "Kalau begitu, saya siapkan juga data harga di bursa komoditas.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "689dba30f67dc2e4208c04607b0fd8056ad0b204cdf276315305dfc934686855",
      "text": "Pasokan udang dari laut berkurang karena cuaca buruk.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "68af1f4dd0f369a91122e8c04c5f1a6e2a80073ac44e7e64619a0158884636d9",
      "text": "Ayo naik klotok. Pasar terapung paling ramai pagi-pagi.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b4db633fefdfd44b075800e14e20a087c091c0ffd0328a097bc022c14bd4b05",
      "text": "Santan membuat kuahnya kental dan gurih.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccc57855167f81613152377e9fe3b441c28d054c52cf0f4be154e3a499fe45f",
      "text": "perkebunan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e28b44aaec5e2e8c81ea66146492b55b8ee4ecdf56c4b39c8a5c05bb51f20d2",
      "text": "jijik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6efbf0bbe64d6867b5f3184061f7215e621a6296db8d38945830d7bb0647a23b",
      "text": "distribusi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "700aeb59c137ec8ebc2a29e7f9b31a568d174e240521b427e3aa3e9e0ebf5969",
      "text": "Betul. Makanan adalah bagian dari identitas kita.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "70ba8d03f6cbf02d1148b75dddb9dc3f8eb444045cc3ce4462ce7f857dd9b150",
      "text": "menukar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "716d9ceb87741b84e223381750f66024e672ee40fcc859075bd11b80e2038284",
      "text": "Tuan rumah menghidangkan nasi kuning dalam selamatan rumah baru.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "72a0c12e627d549815881e6ec48b96e7f49a917bb5d5242cec279ce72a4e0436",
      "text": "bumbu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "742bc9b87ced1fc34cf50a03ff89ae5060fbe736971f658bed5c599cdbc8afe3",
      "text": "identitas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ea43fc7cc385c43e86999ebbc0febcb093c7ec2e5797766aa24bef51eb3b99",
      "text": "Kue labu, Pak. Tinggal tiga, stoknya hampir habis.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "757624b1127f36eed301475e1bcdc4b281a8eed7b84eecae04393ee19474c6e1",
      "text": "stok",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7589e2b86229bc1ed8c74e72b5e06bd8fc33eff76e54f59ae045a30c90c15faa",
      "text": "Kenapa banyak perkampungan dibangun di atas air?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "76a6b3b7031a894911c41961a227a28e8d273626c6c5e3f8b5e3b6a14552fd4c",
      "text": "Sama dengan ibu saya. Resep mulukhiyahnya hanya ada di kepalanya!",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cf510049aef9d311cc298f0d82e6cec7bf7c45cf473071aea60d3be8e960149",
      "text": "kargo",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ea59befb34fee93d4ae479141b558cc07c7a686734901ffc0ffe3b77323b2d9",
      "text": "Masakan mertua penuh bumbu dan santan. Setelah buka puasa, saya ___ sekali.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ec49d31c1e8c3e486587392a356155b02fa45c034396dac51eac236675537a0",
      "text": "Sebagian besar, ya. Tradisi ini sudah ada sejak zaman Kesultanan Banjar.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "83d6a0b51a0ac9d65386352f57ce3780983b6f48b1c1d6e0d1c49d55292b3629",
      "text": "kayu manis",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "85a5d46c828b18e3698c88cfb9202c43bc2264e8e93a99cbf2bec7b44a940b05",
      "text": "Cara memakai rempahnya dipengaruhi oleh pedagang Arab dan India.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "86b15448d87f2a12bc597a61c0f6a729f64e2a54e011efc32acb1caa4ae1ce29",
      "text": "Salad buah ini banyak vitamin dan rendah kalori.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8723ee515e47a8f0d8a0f60c8914aa22726dd55c361face04d3720a80be9f5a7",
      "text": "Resep ini turun-temurun, jadi rasanya tidak pernah berubah.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "889b66df4a77a81322e5af3e35ca577f55cdd158b64e6b29dce61db6ecd8f71a",
      "text": "Malam ini saya traktir semua orang!",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "89b7d15b613a27cddb213f00e42c9d008a924c060e25af9ba64340b2c03c3b40",
      "text": "Di Indonesia, makan dengan tangan kanan itu biasa.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "89bece54b7b65bb95907b4f855c9947fca2614701ee686f7d9bac0860042a901",
      "text": "Enak sekali! Apa bumbu rahasianya?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a3fc070655be1ee3812716fed1b84bc4a9e1d753a7dce6406b8aec13f69a847",
      "text": "kapsul",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bd0cc4d0da84efb435a822af1922d0254e633cb6f8deb8a474bb849399faddc",
      "text": "Perdagangan dan perkebunan membuat kota ini kaya.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bd97a9f64e64c1fa5d9d23a86365009f7da5032f9882169051a30b6e381e33a",
      "text": "Petani itu ___ beras dengan ikan dari nelayan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bdb38719e29fce40544c63b9ab9b144f2502819969870b6e95c8d0715d62e21",
      "text": "Pasokan udang berkurang, jadi stok di pasar terapung cepat habis.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e5182b628f3b6f958ceb16487986e2c2aaf57d9fda7779919d1bb051b7648aa",
      "text": "santan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eddb137ee04b63365d50b8dcc61028a87b8c3da6cea0f7f4e8e4c0b8166844e",
      "text": "bukan sekadar",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ee6a3b1ddc8e000c6e68bf113557a8aa0aff19f5ae502f9ef13846d8bb3c274",
      "text": "kerang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fac2769a7136a301bd8f07a926c753ba71853891f61e724d0170d9ef68aadd9",
      "text": "Wah, ada kayu manis! Rasanya seperti di rumah nenek saya.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9083c678b698db5ff9c090f1e41d120dd947b915c5e1bfb74416f3bc32a124f3",
      "text": "konsumsi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "910b2b1207bb46ce30f5047aa94b7be87c0020064c565db46265dab9df33ac08",
      "text": "Harga ___ naik, jadi rakyat kecil makin susah.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "914dd2090af702b60f2c79fb75522bfe68b13c2e978a1117e1596d40a93c44bf",
      "text": "Mohamed, makanan apa yang paling mencerminkan Mesir?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "938bf4dc46057200ca631c0ba22f6acf4e69483ff944fd90ecd30bcc0b89e9e4",
      "text": "Saya puasa, jadi saya makan setelah azan magrib.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "94a0c8976bdd996977461b714b338eabd8a7943eef29136007118a5851a670c3",
      "text": "Cita rasanya gurih sekali. Bumbunya apa saja?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "951c622a21ca12aafda7adfb02a2d94402c882b268fc056f0a01d88d2c8ba00d",
      "text": "biasa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "97abcf612f4f9514711f6231868621d43931a65b45fcc8838919b29da9159aaf",
      "text": "Setelah piknik sehat, kita tetap makan bakso!",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "987ba2ae6b6e4d8c8d7bf6eef46326cf5c58c7022f8c70c60138c5e423334713",
      "text": "tradisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "98e39baf326f7c97a47b9af3d237500badb90f2618c457347982ffe829f6c269",
      "text": "sosis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "98f0e4bf487a7a349dccd34142eb8c3d0b0bd9432fa58a190b0e280beaec7d02",
      "text": "Selamat datang di Banjarmasin, kota seribu sungai!",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bc154f1762ba9ce1b7d09cf919c8c9c20710bb7d6bc101f473e00f0061d2180",
      "text": "Di Mesir kita jarang memakai santan. Ini pengalaman baru untuk lidah saya!",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d4b92ed9e3771611eda91c94eac46ae5f7bbe26f14d5d282dd6b30b560661fa",
      "text": "resep",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e75358f63df8898a0a541b2437515d50b6684c049d557ca3286879cb07ed2ae",
      "text": "perumahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3194666024f5b7701acb0e32b5cdee2661ada694b0b773b7f7802cac2f012bb",
      "text": "Stok udang menipis karena pasokan dari laut berkurang.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3752905f41e0852adbf545080ab977d98f818248cfa655594db6ea3132f128d",
      "text": "Karena jalan rusak, ___ sayur ke kota terlambat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a777fae321131cb2847515d207a53c4818b83a3d0e7bafe719d30b7cbd6a2ab9",
      "text": "Hari Minggu kami piknik di tepi Sungai Martapura.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7d9bf7dfbe455d484b487422f6aec4fb2eefe4edb86e89e5f83e6f119069577",
      "text": "Bawang, kunyit, dan sedikit lada. Ikannya dibakar dulu, lalu dimasak dalam santan.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "a94c8715ac0647c5f60a6c7ea2a7282e1a1b009b9313bda41e31138c6f8550b7",
      "text": "tepung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "adc2d521885c2ef76f09a30028cdc6362a880dd7e208b85688dc29770430b375",
      "text": "Biasanya, para pedagang sudah berkumpul sebelum subuh.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0016c04df9b6e34abccee463504e4f678f31cab380f7dc95fd261490512e827",
      "text": "Kalau begitu, kita harus mencatatnya sebelum hilang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b001c581317685f23ef66131547adad48ab2b2e76c182e66320ef91279ae2106",
      "text": "Resep kue bingka ini turun-temurun dari nenek buyut saya.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0a0edc74d31c59b7c4ff81e849cf506eed778efc749813a63e63525437f6783",
      "text": "Minum kapsul herbal ini sebelum tidur.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b71e6e11b1977d437962bb7ff258c83b9c73b7117394bde52f52a2ac3e436000",
      "text": "Malam ini saya traktir, ya!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7a7d8b34ce8e2588cce93d2c48558d9d30d9e283e8b46a70b28a128442bfbe6",
      "text": "Pagi-pagi, perahu kecil berkumpul di tengah sungai.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9177ce2937ed240d35bb9c35314038780b4b0993377b904a1765f78bc0746c2",
      "text": "Ikan segar dijual lewat lelang di pelabuhan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba05006d07c40fa0ef980852c669a60a6e93abb4d62c8a5d0666baea45fc2b4f",
      "text": "Mertua saya memasak kepiting saus mentega untuk berbuka puasa.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc66c3bcf9f6f17427e228789865bc554c0800b96378ab5d59a5ee6699488209",
      "text": "Saya ambil semua. Ibu juga jual udang dan cabe?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc7b852be270f0ab14933586d645e150c1601f0e91938f8a8550a66f454156b0",
      "text": "Mungkin karena pengaruh pedagang Arab dulu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd08a229c9fcfc973614e64b866e04fc295938d52ec595187ee415879352805",
      "text": "label halal",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdb7e826e98a64e5befb38ec375b2eb71918435a44dbc28115a28c3f11d03e24",
      "text": "Ya, ikan kaleng dan sosis halal. Konsumsinya besar di Mesir.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdc3ecd1645f30a9acafd622a6e94d0e693e8ed7bdbbd7bce673f49d3f87d67a",
      "text": "labu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "be0615a6bcfc3f7d6834e2f561d6b02bbe1cdd1c1ca00e2bbd51c9ec5d311c07",
      "text": "Supnya harum karena ada kayu manis dan cengkih.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf30b9d047a2caf32a3e8823d66aed3f9e1b628788f4877467c7a7c43461f893",
      "text": "mengolah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c09ad2f22754b16429a2f8f03587512fee6fffceb6fb505407c85f8b50ec50e7",
      "text": "kalori",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e8533fa0406ef5cf96e638069095baa52f7bdb445c053c053930ec5d6413e1",
      "text": "Adab makan di Mesir dan Indonesia punya banyak persamaan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c357ccc5722b641ac1bf06e42adab10e134bb78b992e0e73ff76998269344f4f",
      "text": "pantangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c386b1427db95be0627b67c7afc19055de50f1df726f71847031180b6c2a1e81",
      "text": "Masya Allah, banyak sekali perahu! Semua penjualnya ibu-ibu?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6f459b9e6bd60cf30d40fe34b2b3904f8279f973548d18e9d6cb8ec81eb1709",
      "text": "Mertua saya memasak kepiting dan kerang untuk buka puasa.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8e4cff0e8a5da9bad93b6f361b69a5ee5714c90dad3506a829dc5a4ce245fd2",
      "text": "cabe",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9aeb028d41f1838245e984b9566bb44c75df9ce8eff5f840c94b712d195c7b9",
      "text": "Karena dulu semua perdagangan lewat sungai. Pasar pun ada di atas perahu.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9ef2ba0c8fac57fff233a14e4ffa0539e53fb43316c685c7bfcbd24f13d6dd7",
      "text": "Indonesia mengimpor hampir semua gandumnya.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb07db3db8a6a31014a9d941426a0605b8cf331a88655afa5809b15c14488514",
      "text": "cita rasa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbac43258129d7e80d945e2d7bfe2e9742612ba8f8c0bdbcd79d4215d64b6c6c",
      "text": "Sudah menjadi kebiasaan orang Banjar makan bersama di lantai.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccabd4cf1dbdd6496c825d0368671be80fbb3a00c7c976f1d1c441b0a6365753",
      "text": "wangi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd03b279f3171ac8e6e7a4442cbc52c1e729fdc6e048bcf3f0b5debede5d2d5d",
      "text": "dianggap",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d194918fd7ca36965346f70bd3c5d930a2ae79e5a97b96de0785d5eb6725709e",
      "text": "Kepiting saus mentega dan sup kerang. Ibu mertua saya jago masak.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2af769fa6ca2f8811de12b060c293bac5b1891a6291808ad79ae39e4f8a826b",
      "text": "Ya. Kargo gandum dan tepung dari kapal masuk ke sana, lalu dikirim ke toko-toko.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "d32871f34553f6f4499d0af3dec5add0146ee2ff566e597ebe08eacbfe0c5c58",
      "text": "Kapal kargo itu membawa gandum dari Australia.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3da8179e6b37c3846c90efcbfdcf6ab971f31b05f7e1952cbee2b3ec06f2f45",
      "text": "terapung",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d56bbe52623dd8ae56e8e7b6a45b270542a9e5bee098cd6af782f3a8e3c7c9f9",
      "text": "Begitulah dagang di sungai: semuanya tergantung pada air dan cuaca.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d82d97712e7418f17cf2769d5e66047a5e2013584c905f0b29d9d0c03ad8e184",
      "text": "Silakan, Mohamed. Di sini kami biasa makan dengan tangan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d902f7a57362b3187eef6030b29193e4c90d8eb3b03fc25e4b17946fcd8504fb",
      "text": "Anak-anak suka ___ ayam goreng untuk sarapan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "dac3e547951656df2198b4c13c73d8ab869eb62526182199984391c8047f2e4e",
      "text": "Mungkin koshary. Isinya nasi, makaroni, dan lentil. Lahir dari pertemuan banyak budaya juga.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd5c27dd4110f2cfe79bc73af4fd9dbf32e9e5b745aef8ee6809c4489af00b24",
      "text": "udang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "df66a80cffa0fe44a89ab343f4be875edc95369f27a3f3ba765fb6c4d8200d52",
      "text": "Seperti soto Banjar! Jadi makanan bukan sekadar makanan, ya.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e04000918c4497bf52ff6e479e26fd82f0d5b8e3bd4edde6609c611a59106ae7",
      "text": "Keluarga kami selalu makan bersama setiap malam.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0e6b79b561b459f138142adb5e107a6fb1413de7cfc7abd02ecd3052401e881",
      "text": "perdagangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3c88e851be34a5f82599c8c3f35fd29cb58091176f92e6df202c3117e995d9d",
      "text": "Apakah orang masih menukar barang?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4948bf359d055a54b073d8ecb16ada870f32091bc464928b709e823bc627cce",
      "text": "Lada hitam memberi cita rasa pedas pada soto.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4a7a34fe8eff2c259ed7a5f5ee37ce0f39c4584dfbc2d561da7342b2d8ef08f",
      "text": "Kalau tamu punya pantangan, kita menghidangkan makanan lain.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e59d8d33b81be11ef159be8e4b63437acd0ab507ce5209f493a263c3e0380eba",
      "text": "Salad ini banyak vitamin dan rendah kalori.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6ef731c5098fc135305d196b3127465605ebc565e4057acc28116b2cd1c3dbb",
      "text": "Pedagang Arab membawa resep baru ke Banjarmasin.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e968995c09610686b5bc31c7c017672e94ec740d624954d136298ccd6b3bde39",
      "text": "Saya bawa jamu herbal dan air lemon. Banyak vitaminnya!",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb292013bcd75f9b16eccec4be398159ee2ff6f1263572e066b87d274b514e3f",
      "text": "Terima kasih, saya sudah kenyang sekali.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb879df6845cd80aa93138e1fbece1dabfc1286a028bf837bd56b2d97521deb6",
      "text": "Tradisi pasar terapung penting karena menyatukan warga sungai.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed0fd4d3808580837de6635c70408a2e665583234450e0150edd67f4a4c05008",
      "text": "Jadi resep ini sudah jalan jauh, dari Timur Tengah sampai ke sini.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "eda1f98bd3169d771205da0069dbfb05f819b956ff4ffdba8cdbf7445dec2da5",
      "text": "Ketupat Kandangan punya cita rasa gurih karena kuah santannya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ede78abfa584bde69ac6a7b74a7a1aa0dedda6d23eefb9677680943e7f96bfb0",
      "text": "Hari Minggu kita piknik di tepi sungai, ya. Saya bawa salad buah.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee32212fab256e5b2131cc597cbd3b843ddf11895c85632f3d202d1f79b1b988",
      "text": "Kadang-kadang. Kebanyakan pakai uang, tetapi semangat berkumpulnya tetap sama.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1007090464e4bdbaea71ab6125d237901b58018963512d3cb6b826f8a22d241",
      "text": "Tetapi pakai tangan kanan, ya. Tangan kiri dianggap tidak sopan.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "f19ad1dfa46fcd4bd0d8c04f17e56c3b0a694e8e9054e584e5d647ecc9852aa4",
      "text": "Kue ini lahir di Banjarmasin dan menjadi bagian dari identitas kota.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2a7073834fb5f6372f3f76ae561b160bc13947e2b56d24749857ba9dfceb02f",
      "text": "Perkampungan itu dekat dengan perumahan baru.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f32c7ba9a4c16ecec17b7bacd8aa95fa866d9dbd405e60c30e9a04a0fcbcefce",
      "text": "kenyang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3fc23b1303568f8e4d2c5934a0887ba253c2ce14b1581aef7910cf5d96f09b0",
      "text": "Kakek saya punya pantangan. Beliau tidak makan daging kambing karena darah tinggi.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4d33709c298f793ee57ffc7b1df1441d3631dd3087c3ed2080d01badeb129f5",
      "text": "Ketupat Kandangan dimasak dengan kuah santan dan ikan haruan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "f70e87e5ebceabda6606942bba6750389bde8d342ee64ce0aa01d66564fae4cc",
      "text": "Konsumsi mi instan naik ketika harga beras naik.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f71c9677cd679538f5dca37ae5e7de0168147e85b0536e148e1bc05e036d6761",
      "text": "Wah, sehat sekali. Saya sedang menghitung kalori.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8f34dbb27fb73e30c06ee05f6838cc50ee42f70414bb997bb5446fa6b5353e7",
      "text": "Pertemuan para pedagang dimulai sebelum matahari terbit.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f94809ad04c9f1e4437c355524902e8ef2d460bfd8a0a73bad8b73e1d69e3245",
      "text": "Soto Banjar mencerminkan sejarah perdagangan di Kalimantan.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa2226dfe8d65c42f8689ca2b44144340831961b3d0b4fb0091a3fde213cb028",
      "text": "Kalau begitu, besok saya yang traktir es kelapa muda!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb4b6d02d9ac56daca062be53afdc0629508e153a01fd780e98c7464428534b9",
      "text": "gandum",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcf342dc9d02b09171bce6dc927cc3b46144c338e7149291302609932fb6713b",
      "text": "Betul sekali. Makanan memang bukan sekadar makanan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd5e38f62dd84c038d1449b5420f0911da4caf5442ca2ca00f3870c8598211dd",
      "text": "Mohamed, buka puasa nanti di rumah mertua saya. Kamu ikut, ya!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
