    },
    {
      "id": "bipa5.u04.l03",
      "sha256": "556741ea39adfa2d9dbf5f5e1e91baab2ea2799956d09a6b54e5ee1eec48b213"
    },
    {
      "id": "bipa5.u04.l04",
      "sha256": "20ac1fd00d1762d6d3d62bfdede5bb60233cee89d9e25b29c7f6078ac2a203d9"
    },
    {
      "id": "bipa5.u04.l05",
      "sha256": "7e16112490090460e12909bb223769b06c22b5418921c170440f0f172dbb4170"
    },
    {
      "id": "bipa5.u04.l06",
      "sha256": "16fd9c3ac7cac0f7b88d5ac8c47dc71f087e57c1f89dd52f6d9240108552157d"
    },
    {
      "id": "bipa5.u04.l07",
      "sha256": "0ca020c31b51cf369087f845dd76374128d2a82504692263a9d6c919abfce415"
    },
    {
      "id": "bipa5.u04.l08",
      "sha256": "1cfcb75de94a6e28c46002942565422d60105170724fbe7484abacbcf5755b95"
    },
    {
      "id": "bipa5.u04.l09",
      "sha256": "6eb9079d255e497dff4077f6a8563beb7b8cde9b01525bea5a0de7bec105cbca"
    },
    {
      "id": "bipa5.u04.l10",
      "sha256": "1ff4e2a32b3767ca09ad0e226089f8bf0e5ad7a011a3e8b34159c4a084c8f995"
    },
    {
      "id": "bipa5.u04.l11",
      "sha256": "02247001ec5b0001fa4c127c827b96b85f88662cd687eb38cd5379e12348f1e1"
    },
    {
      "id": "bipa5.u04.l12",
      "sha256": "340d326f66e8e1d82403a1bfad3d734bd2b235b079108dd5eb428c697b7eadbc"
    }
  ],
  "audio": [
    {
      "key": "0024ade2cc9c262745fd1b5e2d72528adec72f61061ad83ae92da2efad9e2729",
      "text": "Berbeda dengan Mesir, tahun ajaran di sini dimulai bulan Juli.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "019426b4e5005cd34c492101bc24f8f559d996e89f95e63f09818f53152cf929",
      "text": "berkontribusi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "03699e737bb0a5d47a0cb1ef07a9b625cea403e8daf076de0e56ed28833c345f",
      "text": "Rapornya gimana? Di Mesir, nilai penting banget buat masuk sekolah negeri.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "09d68b228e841e4c01723291f9dba8f8b4d95fdd39eebf1ab965482ca87ef9ae",
      "text": "Bener. Terus sekarang banyak santri dari daerah ini kuliah di Kairo.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b651d8323a02b00630ba6d1a52d17ce776b5bbfa69a6f4ea8d0871dbf18d1e8",
      "text": "reuni",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb840f62a615add56dfa81cb54210fd8aa67f553fca69077f752f7fc5e0a1ca",
      "text": "Bu Lestari mengatakan bahwa banyak santri belajar di Kairo.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d2985a0eded19391c24e7a6c6b1b5e3e6b987629acb668b5b3950ba8ee699b0",
      "text": "Bacaannya udah aku siapin. Untungnya nggak ada rumus!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d3d99b5f54f1e6c84057294d06419f07d3706710491816b82edb92a46e1f793",
      "text": "dilampirkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec4977265fa0acbd0e051c95171f27c347287030749eee491ce9e691e8dc639",
      "text": "Terima kasih, Bu. Ada berapa siswi di sini?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f2863361bf95a8ad0b2e6a6d863625d98d6989c77a67fee1bf018ff4d58a714",
      "text": "Mohamed, bedanya pesantren ini sama Al-Azhar apa, sih?",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f32c36c4841f8460421467d8e2ea467be4b799cd865c84be0c38c1afe81dbf2",
      "text": "Bacaan minggu ini banyak sekali rumusnya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1031ecb5374780eb37faccbf93fc60c230f7cc3b478d728b00f73a271cd3dcb8",
      "text": "ilmu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "170b0adcdbdb97ed9b04f7952b8fa9aeb2ca0b1e30fec37020624a9e1253565c",
      "text": "Ustaz, ini draf surat motivasi saya untuk beasiswa Darmasiswa.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "19f3537714d9d88f88bebde493b1423702d75d549342c101fcbe0787f1c486e1",
      "text": "Nasehat terakhir dari pesantren: walaupun ada gegar budaya dan kangen rumah, jangan lupa salat.",
      "voice": "id_gadis",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b4f3d65c93b1f2f800589addde2cf89a4f83b2d2ce3ec16df61b2b742eaccad",
      "text": "Itu mudah. Yang sulit biasanya bulan pertama: mereka pasti kangen rumah.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b68cd51c2c7d5b6f9e38ab54a2b309c523ef6b97a1bb893059fb326769612ce",
      "text": "Katanya, santri di Tenggarong belajar kitab setiap malam.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dd946aa4901c06465453224ffa5e79ee50d856ce644208b710f27160c7c9fe1",
      "text": "Luas lingkaran dihitung dengan ___ πr².",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "20a6fd491780023f873ecff974219aa77c7d9c1375aaca11181d413dcd287b64",
      "text": "Tahun 2015. Saya tinggal di Hayy Asyir selama enam tahun.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "222f0e9d39c7d60669be8fbfafbc4c91073f1a13b021b453857cee43714cc560",
      "text": "Boleh. Tulis aja, kata seorang guru, kurikulum baru lebih fleksibel.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "224749fa7de5b06121f05157536a32e18c05d88bfff6f0c10946722786becf66",
      "text": "jurusan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "24aace9ccc2e6d5f27f6b9795b80c95275a1116031bb9133d5cb6b11be541cd7",
      "text": "Kurikulum baru di Indonesia bernama Kurikulum Merdeka.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "276fc65bf48fc25864be02bc4741a74052fc416d05fb9931804f47ccf84a7bfe",
      "text": "Wah, menarik. Jadi beliau meminta agar aku cerita soal Kairo?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d0fd8972236df83a3b4f3fbf56563b128b6a0dd4163d3c9d7e4ba9b567f83f5",
      "text": "Taruh tasmu di loker, terus kita ketemu di kantin jam dua belas, ya.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3093d8dd7e4125b5dacfb885251c205f933dc69adb7f41d7fcbfed851895a37e",
      "text": "persamaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "342c430cd930a589209d92bb162e9cded39a81a9034c33a6324c42a1a6ea2bc5",
      "text": "Rina bertanya apakah Al-Azhar menerima mahasiswa asing.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "35721226c7e7a14a82a3ee6173b1af62a68479950dd1669348672deaa830eaeb",
      "text": "pelamar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "372c7eefb1c156c7b045349103772a7d536532c98070300814c1cab3935d4719",
      "text": "Sepupuku kuliah di Al-Azhar. Katanya tahun pertama berat banget.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "37ef3f97789dcd642e8b009c0aedaa03b5a3a1e6294eedcf476e4880d363c69b",
      "text": "Pendaftaran beasiswa ditutup minggu depan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d27685273e3c1af826dabccabd9dc4cb44d1a2bda8d0e5d1bb4154d2a77c321",
      "text": "Pasti gegar budaya, deh. Orang Kairo ngomongnya keras dan cepet!",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d2bddb707f2cd904fe51d8a4d241d9f6aed6441c91e71615c48f4b7714caacf",
      "text": "Ikut. Temanya seputar pesantren sama Al-Azhar.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f602050138b88a10250d513d9c532f3a8fab8abbbadbcb82e6c0eeeb61f5bc6",
      "text": "loker",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f7f8beea85ac9ca6ee20d97287885a97d345d1940399ab420829be61d65e1d4",
      "text": "Menurut banyak mahasiswa, biaya hidup di Kairo lebih murah daripada di Jakarta.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fbc890ace753c22beb704c8a886346eaf185d7b1ea859020bfecc46049adb1f",
      "text": "Semua dokumen beasiswa sudah dilampirkan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4035e541032615ada072ea263f8af16bd57f894bda567ec1899edb5c7ac356d3",
      "text": "Selamat datang di pesantren kami, Pak Mohamed.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "412532e5caf72a7c2fee2955c90fbcd8509e5b974f360e7279c86dd086ddfb30",
      "text": "Aku perlu nulis pendapat seorang guru juga, nggak?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "41dd0cfe842bf0ffe565294476b2d0a532b451d8a023f2a121e3d59680d4b9aa",
      "text": "perbedaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4373e4a131055e7c90a1abb94fd3409fc57a30201979e0bd1c114d1d90e553de",
      "text": "Sudah. Mereka cuma khawatir soal bea cukai dan karantina obat.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d34cfce0dc7a7c94694b7278dc7de5c4a1952614268435432c3b2920bdf5a8",
      "text": "Tapi alumni kami bilang, setelah itu mereka betah. Banyak yang ikut reuni di Kairo!",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "44e2191c71accfd001ef0778b09aa825edb6d032ec75f9d747167c81258b160c",
      "text": "Visa dari kedutaan sudah ada, tinggal urusan bea cukai.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "47d9088cfe3d899d2ba8fcc1738de01b494536bdb8d8e7657caeb53c33aa5fdb",
      "text": "bertanya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "49360b865b10ea331852c4b5e733f51c25a896d89ab058b8f6c21c79dcf22d38",
      "text": "Kata Bu Sari, ujian akhir dimulai bulan Juni.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "49e574e8dc8c2372b38bd09c40d54aca001657040e9b2d48b5dc44446d7a94ec",
      "text": "santri",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "49ed3f0409fc226d7c2fb8c9527034d7fb18d362c7169954ca3f4c387f5383ae",
      "text": "Bulan pertama saya kangen rumah, tapi sekarang saya betah.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a9717a0255c2b217a6343a140d82bd10769b166f7c013cad31bf925f564743f",
      "text": "Para alumni menyarankan agar kami belajar bahasa Arab.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eb5c0cd78b00c8e31012a93eb77cfac12e74e7963a6e4864d4c18f27f241e12",
      "text": "intelektual",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ee1e240458cc332a55e5bfac92d4b31c51bbf74919b152e5014861ad6ea5481",
      "text": "Dokumen apa saja yang wajib dilampirkan?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "51d8518945673b3cc4562247b5fa4c5e8aae3d282a01f5ace591caa98775d950",
      "text": "mengatakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "543d9cb5698cd9aefa64f6941979d0d5b37c019e705785218d9adb8045179159",
      "text": "Belajarlah bahasa Arab dari sekarang, dan jangan takut berbicara dengan orang Mesir.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ab698349a913e292b22b6f20e1c9265b28c46b32408c6e60659138afede475",
      "text": "Visa pelajar saya sudah keluar minggu lalu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5717878b63072008c14f0d45cc3101c9f0447bcdff4fb5137af5fd8e05586edd",
      "text": "Dua-duanya ngajarin kitab sama ilmu agama, terus dua-duanya udah ratusan tahun.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "589148b2ef4a222928a55a03644cb64270ba159bcd167b0e77e1a109efab3d47",
      "text": "Nah, tulis kalimat itu. Saya sarankan juga Anda menyebut pengalaman Anda di kedutaan.",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "597079013e0b608fa7bd093f32d8cd689816c13d01dec42c1c8b7e29004f11c6",
      "text": "dokumen",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c332ad5b4c9589c2ebfd3227e1e636aee8210fb508591b567b10c016652b201",
      "text": "Para alumni menjelaskan bahwa ujian di Al-Azhar sangat sulit.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c95732245976d580f26d4d5c904bfc6199c39df91565212b724a766c321d075",
      "text": "beragama",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cacfddc4a185f2adf24abc21f0d86e6272ce3afaf2f6044802f730d410cd201",
      "text": "keduanya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d0bd1c6ec39b43164ac98a20d8bfd2a1b607c07d6b1f6d851a9254188b92d1c",
      "text": "kedutaan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dd062f70091bd94ab4eb7334e653c13d30ccdaaf98c1d8f1f58cb98e8cf07ab",
      "text": "Ribuan mahasiswa asing belajar di Al-Azhar.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df5322a01c53ad2452d12c8f26ee966a72fcb1222cc2d8043c4de8a9e9aab6e",
      "text": "Bagus. Tapi Anda belum menjelaskan apa yang akan Anda lakukan setelah lulus.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e968fec68ac0427ab90a20aa51644e40426562eb8010efa3afe048917ee613e",
      "text": "Katanya, ribuan santri Indonesia belajar di Kairo.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6069a939befc7b71870ae6a3717fe54275f8e4798c1abd701792dc53e3f22c8e",
      "text": "Ini museum keraton Kutai. Katanya, kerajaan ini yang paling tua di Indonesia.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "60a2f327ebc34a01a9d11fd63ea1b8078237eba93bc6662a93fe841cfb5bff7f",
      "text": "betah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6163dd957caa210e38bbdce1034686d4e1e79bb4e6516281d66fae4d6762c5d0",
      "text": "akhirat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "64fc65c31d6f3cddd6fb40de7e7b95a81621b26fbdf884b93d8bcc95bafb3d97",
      "text": "alumni",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6716b80bd325fc3d50fcbb68858cae0622d9b4484abd7454bd6a7eff04ac4523",
      "text": "Al-Azhar jauh lebih gede. Ada fakultas kedokteran sama teknik juga.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "696b1e27e7a2f2e2f3909a8841afa2784c256e1bd7b00897fa2ba8d221ff6ac2",
      "text": "Beliau menyarankan agar saya membaca kitab setiap hari.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b7c7e33a4e259bbbdf62f8c798fd29f3f6b8360b164d30865bb6c7ee393fedd",
      "text": "Batas akhir pendaftaran beasiswa adalah tanggal 31 Januari.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bb7780f67c09959a9725532ccbc58d8da802c98d9fcf3b671e5d6a824db5704",
      "text": "kurikulum",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c55c85a8c52980bf2546894f555d70ac6ecf899a908e8880fd84816359e5b8c",
      "text": "Tahun pertama, banyak mahasiswa asing mengalami gegar budaya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dd68f03f2e397f7a0077674b3f06e34661b40f544762543349d1394bfbd630e",
      "text": "Ada seminar seputar pendidikan pesantren di aula.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6de5eee4df9bc4b1bfa9134127e2e33fd1f8229b206388ebff3f89dc0f434844",
      "text": "Nasehat terbaik adalah teladan yang baik.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f142fd6481dcbbb9dd773ff5ab2ef3a933b0270f683dc5b3d0ede439a21f7ef",
      "text": "Berbeda dengan Mesir, tahun ajaran di Indonesia dimulai bulan Juli.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fc3e7d2698cbe006c3caabf300e3f55aeee6f823c06d5f65efea3af590bfe6c",
      "text": "Pembicaranya mahasiswi S3. Katanya intelektual banget.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "744864154bc05edd147416009ee931735cc6327aa35132d93565a11402f21c80",
      "text": "Mohamed, kamu ikut seminar di Universitas Kutai pagi ini, nggak?",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "747bc536f3ad0fa84586fc96575385e2ccdac9367c61f34f937f40e4c92160d7",
      "text": "Beliau menjelaskan bahwa hidup di Kairo tidak mudah, tetapi menyenangkan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "74c91e0b4cb6f0329bc91d3ae6ca4e5b2123adc1f683759fb839914944615dcc",
      "text": "Katanya, santrinya banyak yang pengin lanjut kuliah ke Kairo.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "770baa15f6e1b3a13d160ad5faaaf778527e3a9a138409ec0b570be8acf78590",
      "text": "Pelamar wajib melampirkan surat rekomendasi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "77e09aea37fdb8e527588ef7d34156331f419002a12e2d2c487d1811f7345604",
      "text": "surat motivasi",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "783e4dd0da5ba06b184d21692ce0e1d294922ec807d86743f75d85b168f34e1f",
      "text": "Setelah lulus SMA, dia masuk jurusan Sastra Arab.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "788f7d96b383a9e8ef96d9293110f10bfcd7fd12289f977ef401e0e1095e23de",
      "text": "batas akhir",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "78e9c9ec922d5654282c77756124f8fde3c78afadaec65a82f689e4d6b0cb497",
      "text": "Paspor, ijazah, dan surat rekomendasi. Batas akhirnya 31 Januari.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a77582a9d222a8c3cc484b6996447e0998156a18c480395aecff8b7a00a11c5",
      "text": "Upacara kelulusan diadakan pada bulan Juni.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aa5da5e93261df215e3932c22caada5dd27d48cbcdd0f8653b47185c0ee5530",
      "text": "teladan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bcfa150fd774803a1f768a507b375b89783572557e1d926a3dda06d39c681e9",
      "text": "kangen",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e24e6dd2188089975e31465698ce2ed52bf3cabda703467701d9b4db9140ab0",
      "text": "Mahasiswi itu menyimpan buku di loker.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8064620fea7eb7bbc0ec8d629d80bd93afb14376cd04a74b3a6e9179562c179b",
      "text": "Di madrasah, siswa belajar ilmu agama dan ilmu umum.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8397536181ec0bebb631640b4cb488708fd69249ca903b0d1f4595601215a267",
      "text": "Persamaannya, keduanya punya banyak alumni di Kairo.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "89bf168bc456b5672eb26ae373aca02022eb6d168379a78168eed39441f8d31d",
      "text": "Mas Rizal, tolong bacain paragrafku soal sekolah di Mesir sama Indonesia, dong.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cc8ae1f9bf6bba239bd71f3436dcc04be92c14f0f2775d0ed1309b561a44c96",
      "text": "biaya hidup",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d7792960efa56f3f8708561cde0bba9dda94aacdde0c9b89947eb24869bf502",
      "text": "beradaptasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f21c52f6c9cafc72804166ae78eb7e865a7974c49a940d77467881d3fed91ae",
      "text": "pembelajaran",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "902f9469e342b2eb3e61f2122db6c2e3212785023571484e612e6d77ed4ee084",
      "text": "Nasehat guru itu masih saya ingat sampai sekarang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "90e61a5e69ff280fca49f269932faf9c87d9b0265120a9eee47999d92251c370",
      "text": "Apakah pembelajarannya hanya agama?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "920f235978ac9a020b744e2384e8ef6cfe661759ca2e5f473dad0b3b5931c1bf",
      "text": "Masya Allah! Visanya sudah keluar?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "92154197703f7a30c70c77fae5f393289864b54cf2c9e90b5a1f1a9340d133b7",
      "text": "Jadi, beliau menyarankan agar kami berani berbicara. Saya suka itu!",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "92c1322f897c3142003c9b3d5f93dc22d5b9c86f3b4d05f641fc73f5d22ee099",
      "text": "Banyak kata di sini dari bahasa Arab: nasehat, wahyu, akhirat!",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9509f7be95617835e4144fcba96c6a9463d1adb7d69412a0b44cdc1955a18c6e",
      "text": "Awalnya saya mengalami gegar budaya, tetapi sekarang saya sudah beradaptasi.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "96337082ff96cbb6bfd323103f6e581c84e61d76a2692fc4a264ad373b44a38a",
      "text": "Bagus. Kalimat \"berbeda dengan Mesir\" itu jelas banget.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9683e84dfff6cde18ac4fbbc9ed8c4685308e3adf351b7b59c697e089b661475",
      "text": "Mohamed, kepala pesantren tadi bertanya apakah kamu kuliah di Al-Azhar, lho.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "96873e20d501b446dd41bb5ac01180ed7794336b5c897f4a0a329f3a8a2937c3",
      "text": "Terbuka, Pak. Pelamar dari Mesir cukup banyak setiap tahun.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "96c2bbd0294c7d1b78eac65a6467adb70659eeac90ec2f1d8da27a9ae88c0042",
      "text": "Terus persamaannya?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "97c345ad2dae2f043df5fe70faa3a0c7d2e367fb8c85e3040624b0553ab1daa2",
      "text": "Sesudah seminar, kita ke kantin.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9817de22912f931002cbcea95d1353bc0e1bc8f50359651351581005bcc611e7",
      "text": "kantin",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ef5c2048f069b530c016fa561be51dc07f2fcc08c425f0ac476247add24abf",
      "text": "Semoga aku bisa dateng ke upacara kelulusannya, ya!",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c7a6209bc1e77432a5839f0eb0a57eab8d14ced3e24da62e03a45ea06f451a",
      "text": "gegar budaya",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "99e7602929a1b40cfb5236fb814bf7c26b47c55af85499f508e96b9f081c7a33",
      "text": "Permisi, Bu. Apakah beasiswa ini terbuka untuk orang Mesir?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bf2883ad2af080a41221ad4d4f744e142320fa4d92e4736306041d16b58fcc7",
      "text": "rumus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a06d29a475f3f31bd389161101377d95e0bb09e81e0810807b39110ef47b550d",
      "text": "Dari kerajaan kuno sampai Al-Azhar. Bedanya gede, tapi semangat belajarnya sama.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1a237a7a33d0433a4705d6333b7f0a20554da57c6d9bb8aed8694674f45db78",
      "text": "Metode ___ di pesantren itu sekarang memakai tablet.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2b9e2ef260472711924a215dc90c723c71b34cea54d998a0b0e27f93b8a8240",
      "text": "Setelah banyak pertimbangan, saya memilih kuliah di Kairo.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2db13cc14ef40169d673dc84b411fb1a2b76de5af64cbfdad978bd56777df2a",
      "text": "Saya ingin berkontribusi bagi hubungan Mesir dan Indonesia sebagai penerjemah.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3e4e161cdae1ca334505afe38614c21e1ba74c1321a2886aa2f2f80c491be38",
      "text": "Dalam surat motivasi, jelaskan mengapa Anda memilih jurusan ini.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a567180f50f7fcce766050e80ebf9030b1fc3fcb7a392aaed46086a1c7a5b4d5",
      "text": "mahasiswi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a725410fdc13ccbb01f4dc73c9585fe690fb5b1f8d2de48ac1ba2221ce2b6493",
      "text": "Kiai itu menjadi teladan bagi para santri.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7b26328283aba308b484d3f6b557fc21dd5a8fd1210f480154a7519d698b0d8",
      "text": "Saya sudah menulis surat motivasi dan melampirkan ijazah saya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8a86d8b357eee0dd73c3933314ac04f74e5c0f99718c75a26f971a28ee657c5",
      "text": "kelulusan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a95c2434dccae4c80cb4874775ed82987797297a80071fa294e3e59e53abc9a2",
      "text": "Para siswi belajar tafsir firman Allah setiap pagi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9e37c5a74437dda7e478599200c75cce705c31da258ea26b96c8a4b53e61db0",
      "text": "firman",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1698f9d60337acde3c48cf3fcea1d65dd1c10ada233876c3c69045e0c0012c",
      "text": "Sekitar empat ratus. Kami mendidik mereka untuk dunia dan akhirat.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "aae49907b4e572dc84897bdd3559f095f13a3797a03a42e5545bb4611a048b05",
      "text": "Kurma ini harus diperiksa di bea cukai.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "abd860a5287e59f4020ba4e88c3e7f67a860c16019b1ae7b6d7cfd821ec1fe4f",
      "text": "Terima kasih, Ustaz. Batas akhirnya minggu depan, jadi saya perbaiki malam ini.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad37c7201735c4d41447c810d65d7fcf951cb65824728c82ef51c07276314077",
      "text": "Mahasiswi itu sangat intelektual.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad81513d3a5bf8670d023cbbf4d986c89af481ce780fb49b42ba1dd4b3560b23",
      "text": "Masa, sih? Pemandu tadi menjelaskan bahwa ada prasasti dari abad keempat.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae650a8e0ad419161f2b747f08d941e54d61a105b3abb0c9dbe545db5937a912",
      "text": "menyarankan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "afd2f55a9672d3b260db4756e76c0e5c9fb35bf2b67ab288ef447bf21f651ca5",
      "text": "nasehat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "affa2cc206022e018720c016293d620b3eba1c1a8d6228c641a7e300ea90377c",
      "text": "Pesantren dan Al-Azhar sama-sama mengajarkan kitab. Itu ___ keduanya.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "b17f9658b91f6f07d63c0ef23998d2b1ac679a8b94c7d51f1d0c4904e446d72b",
      "text": "Di Mesir maupun di Indonesia, guru sangat dihormati.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b374a92e1a5abbf61d9c11b00a7e5c573781c604fb46f96902798c0dca31464f",
      "text": "sekolah swasta",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6e9948ce3db4fa533c7ba669a97d2add68e31fe50ef89f571a95fc5b4281e46",
      "text": "berbeda dengan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c004994898db7da1b5deb021f41187443640dcbfb2a2fcd36890795d7c453461",
      "text": "tahun ajaran",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c077e56b1d4c2b336e8d5043ac61d9633decde44829bea692749d28354b32968",
      "text": "Iya. Tapi sekarang dia udah beradaptasi. Dia tinggal di asrama bareng mahasiswa asing lain.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0b19242ea99767b00d3b4105cba886baac8d8e74ada209e200d9fd13833f5a3",
      "text": "Persamaannya, keduanya punya sejarah yang panjang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4cfca051a69dcaeb96d7b865daef071530d5edf9a0e2d5541d9f721675cf6e0",
      "text": "siswi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5d4098a05dea90cfac521abe810f34b9fd92844ff5736bc2b0c1d351b6f48bf",
      "text": "Di sini juga, kok. Nanti abis SMA, dia mau milih jurusan kedokteran.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "c70144250dc67c75e58e34ecad7535c97074de144ad32870496102cbce8fa83e",
      "text": "Pak kiai ___ agar kami datang tepat waktu.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c715c7f75eddb1d6e9b01d4e1042b63517ac5a55cc0c929b5991d4ef094a9df6",
      "text": "seminar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c912543c8545200d0f5369b7ce95d1ed781cfea9c68677e008b5f2badc076d30",
      "text": "___ Mesir, sekolah di Indonesia memakai seragam setiap hari.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0d4ae85a5da3cf0e7a83962e39843b553b6f6cd0b67f780577e5e5605a861a2",
      "text": "Pak Mohamed, tiga santri kami akan kuliah di Al-Azhar tahun ini.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0f3e7683c9e7110023a6b29af3fb7ab2fceea13ccc1575f151e89c441e28f52",
      "text": "mendidik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2e8bf3985f54b5541233edab1215f523c2b70323898958d469ddcbc89b25031",
      "text": "Setelah banyak pertimbangan, dia memilih Al-Azhar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8552e719814f258aa8e431efc2a750219ef43f09900560f7bcf06cfd01334ad",
      "text": "Beliau menjelaskan bahwa Kairo kota yang ramah.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9b2aa2ae1f91acf4f76122bcef57d8470e8c79b01f58a4f0fc20ebb81b2541a",
      "text": "sekolah negeri",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "da12179f584a11fbc79f32499a306f0005b42a2e748dce606947d14296625d1c",
      "text": "bea",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "da7da73dbe674e64453d422431d40ccfcdf1eea6bd307cc9d8869ea7d5686569",
      "text": "Orang tua yang baik mendidik anak dengan sabar.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbac4344c66599ab2b977666251458ea9d254c45b20fe5df895585e44d38d11a",
      "text": "Keduanya mengajarkan ilmu agama. Sementara itu, Al-Azhar juga punya fakultas kedokteran.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd3c58467531ad62d3db548d448ac399ead085905c887e4c8228faed2475b4ce",
      "text": "Perbedaannya, santri tinggal di pesantren, sementara mahasiswa Al-Azhar tinggal di kota.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd69c82330035a6fb1dfe039277f79acf09d599413715e8f9c38bed837a15aa0",
      "text": "Jangan lupa batas akhir pendaftaran, ya!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "df637415036c8affebdc673dc3d6a86269c02233d19a173f67522553ef5eab19",
      "text": "Tidak. Ada sains dan bahasa juga. Tapi nasehat pertama kami selalu sama: jadilah teladan.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1dd9cddb7b6ecd5141f0336f569586c07bb7835bcccaf4430ed158c3d0180e6",
      "text": "Sekolah swasta itu lebih mahal daripada sekolah negeri.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2da2b0c2548f3dcebdd0c4d905f5e867c19222c6d85c7570ee310945209b06a",
      "text": "rapor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6012fd65f6e67434a81fc34491aacefe6c6bc9ba4d31c1f938b5579fb36831a",
      "text": "pertimbangan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e68c7b1e177d1671d605f5a5ba5fe25fc92ab67586f2c58f0feae4cd2d27b1b7",
      "text": "Setelah kelulusan, saya ingin kuliah di jurusan hukum.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e771ddf30013f94ae4af75f43fe75024bbefecccb44c4fe400cf96aa402cb0c8",
      "text": "seputar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7cedbb3d5adc4ff7d28aed712edc8dd9bc0fe1af495817711d3d106456ca68f",
      "text": "Dokumen apa yang harus dilampirkan?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8829c274e637a04f878877b66be33c463c894354af286e80bd9e793f958f19b",
      "text": "Anak saya belajar di sekolah swasta karena dekat dengan rumah.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea3e23e707501307d1d3c56ff114463ebdbe4fac40d17151bba2308e6b81d3e2",
      "text": "Ustaz, kapan Ustaz lulus dari Al-Azhar?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea6401c800b272286a96e39c2ef1370c355647db74b7c22fb49055d2983f8ffd",
      "text": "Apa saran Ustaz untuk santri yang ingin ke sana?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f236b8f205add2b50e7946406f799b6625db8a318b3d12054be97e967b07c3db",
      "text": "menjelaskan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f33bbac2c80e75dbfa33accfc419145a2ba21f0392ca8957db6a3e72e40d6062",
      "text": "bacaan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4cc62544fee515cf21b473207fbe8b640a4c97120e78df5c0c1c106c9b04f07",
      "text": "Indonesia adalah negara yang penduduknya ___ dan beragam.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4e918ba6107951392cdacf5ed00a0ad1b5b3f06aed392332abd24430286b8f2",
      "text": "kata",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5453c62a1cf5b360d248266f153884a7678b93c5e59779cc6f5535d14f91548",
      "text": "meminta",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f71ce742228e136e4f692879d0d6ace31890b65c1637dfc9e4f3af4c15a5e329",
      "text": "Firman Allah dibaca setiap pagi di pesantren.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7dc717cf7929da6b0186d81cd5da56ff4af9f2beb9f3a8c59b7100327bfb868",
      "text": "Para alumni sekolah negeri itu bertemu lagi dalam sebuah ___ di Kairo.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7fd8c375d26d340ef43a84cf94267eb35158bae66c665a39091a830d9d1ab20",
      "text": "mahasiswa asing",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "f809651a21359c9b6014bcd47f3b4db63b496717bc2b3a6d816c8a82a7ddd9e3",
      "text": "karantina",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb9705d4b932db8dd360ff9a07225cfab1355d00b1672cbca38c158b89337b79",
      "text": "asrama",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe1079811936cc2c61ac6a5cdc2e5a8118b66e4d3f2d85ff402b8eab14c0b960",
      "text": "Bagus, deh. Biaya hidup di Kairo juga nggak terlalu mahal, kok.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe8fa730d7a761d07227342decd1cfd407dc75cb8dad32f6077553ee277313f8",
      "text": "Katanya, santri di sini bangun jam empat pagi.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "feafaae6f2da67e7ab97d2d6d60ea887ca5f8c793d9b54e0e9134b1a986c313c",
      "text": "wahyu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "feda202a3ef03ce956ee06d29a5eb510cf40272b178981fa1830a3dc0c760161",
      "text": "Nggak, aku cuma tinggal di deketnya. Emang kenapa beliau nanya?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff434fd2283be0a5cb398968ffccae32f242b330a5b2b7c5638cdbbe71e04806",
      "text": "Keponakanku baru lulus SD. Sekarang dia masuk SMP negeri di Tenggarong.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff9c6befb1ae669163bf221c54217daed48f771ecc59940c3c6f46267459b8eb",
      "text": "Kita makan siang di kantin saja, ya.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    }
  ],
