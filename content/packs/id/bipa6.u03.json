    },
    {
      "id": "bipa6.u03.l04",
      "sha256": "9917f80fb38b26b6f2af0d642a6f26b5eeb58241ea25946d7e92868d5f2d1f12"
    },
    {
      "id": "bipa6.u03.l05",
      "sha256": "90997f9ad06dd425a73ad57b9f46d06700c752b2b057a2dc09135d1e6150f2fc"
    },
    {
      "id": "bipa6.u03.l06",
      "sha256": "ca78e44c9c5b986439c5ab7df5a09bda8d8b6e5b8904ce35ec32782c5a3cca80"
    },
    {
      "id": "bipa6.u03.l07",
      "sha256": "4ce9a39b12cc1547bbb89a0bdfe60129ee9764d89a935299a9a2d518e3dad67b"
    },
    {
      "id": "bipa6.u03.l08",
      "sha256": "240fa295ed2967a3bb17992b084ba7dfc39e33131dbc8f2edfe55e326059ab93"
    },
    {
      "id": "bipa6.u03.l09",
      "sha256": "4221d37399d0d6fdb9bd863b029a126d3d448a887933457b35c52095926b0688"
    },
    {
      "id": "bipa6.u03.l10",
      "sha256": "80276bfbb004a5a4b4113d0f237735b890e37515e1dabd50d9edcb7237ce86f7"
    },
    {
      "id": "bipa6.u03.l11",
      "sha256": "cf541d82043788dcdd17754b52faeb1718902b7f13c64843aeed3fd8ad68062d"
    },
    {
      "id": "bipa6.u03.l12",
      "sha256": "f387d67a943f83540529cdadba59fee6af8dd44ec28775ce7c1082aee9035771"
    },
    {
      "id": "bipa6.u03.l13",
      "sha256": "ed88ca6fabf96c87d079cfdba20097dc3a204365f56d1641d609b116b3520455"
    }
  ],
  "audio": [
    {
      "key": "008394bf0cf1c724b12687ad411ee9aae989069d65fadd9343c104abf1e3c64a",
      "text": "Menarik! Calon suaminya anak sulung?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "02286258f43a71cb772eba080dd15af48167ffc044b9b50b64c017a4e18111d3",
      "text": "Dan peribahasanya, kan? Ingat, di mana bumi dipijak …",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "03ecd402ffcd61be61c47841960e1e6b576d93a7e8b16fbca8094c86f835c0d8",
      "text": "dilantik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "04247bdcb87a922f194a42cb035a48bc9b7308fda1072cc173f64130284c42fd",
      "text": "patrilineal",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0554fa439d33cb8141c7b3c82c12030eb74b0dbfcb33c49178989cc939c19311",
      "text": "mamak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "079d54942fa143b561cc15c63da73a6d000d0c8914fa77ad5bbce80d8a836b24",
      "text": "lingkaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a95254d5fe2fdb0f259852dfba1248c39192becd600e1e7306b38f59df8d377",
      "text": "Menarik sekali. Ternyata ada banyak cara untuk menjaga keluarga.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca5388b9e57d37d274318c35d3fa8a3bbbae2437d39196d7e0053ab1dde688d",
      "text": "syarak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d68e202226c36bf2d67a5a3bc1d49e0d009b0dddab8c1b663215dd9d913a6af",
      "text": "pesilat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0db4db24dd91c4e2b3fb7aee7b9d891ca2e1f225159b4fccf4d7521539182133",
      "text": "mengasuh",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e50b73837efe01de0eb0c8922f0c99cc971fe5bbeee788e5f3254cf579e33e8",
      "text": "Saya belajar bahasa Indonesia sedikit demi sedikit setiap hari.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ffa5d2d8cbc4b3d24750050d92b30d09c06565a533bab07be94ce08ccf7589e",
      "text": "Anak sulung pamit kepada keluarga yang berkabung.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1152aaa6c379839a43fd71217cd0fbee162cbe6e42dfa04a02932eebdbf8ff58",
      "text": "pertunangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "11cdc4c3d08e16c29499348dc1dad414ee22d2aa6a882a0ab666ddc29db061b7",
      "text": "Kalau kita bersatu, kita akan tetap teguh.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "131892943b5b5962d1e20a680b11f53cf2bbd1329defadbe1dbec61fd1f4c8fa",
      "text": "Kedua budaya serupa, sedikit demi sedikit saya memahaminya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "16c59d383f069f367a23f830aeede5017297b329b0210fd2576972f7e9b47657",
      "text": "Pertanyaan bagus. Pusaka ikut adat, tetapi warisan pribadi ikut syarak. Itu hasil mufakat para ulama dan pemuka adat.",
      "voice": "id_gadis",
      "chars": 117,
      "mime": "audio/mpeg"
    },
    {
      "key": "173023e71b0c9c3b82c38eb9ba7a2b94d724d96ee31cd5de088f4ab665a424fb",
      "text": "datuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bf4c74b9727d8d15e321625fb9ad089730e7d69e3de2e986579707883bbc06a",
      "text": "Itu keliru. Dalam tatanan adat, keduanya menjaga martabat keluarga.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dff50668829dce8f7892b5981057406550519d4a707b9d9e3bcd3cf3457a938",
      "text": "Orang Batak mewarisi marga dari ayah.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f535201421f8c5dbcde054a3dad351d01fd78b7a557ad9551821f7c9afec60d",
      "text": "Gelar datuk diwariskan dari mamak kepada kemenakan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "208b3e508f57feec9ae448921e9d8e5497a1c2d5e3092b63f71b090fe0d9ecd1",
      "text": "Resepsinya di rumah gadang, tamunya ratusan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d0997964ce9f2850fe213911467d46e16671c19c727ef11bb781de25696e13",
      "text": "Seluruh kampung datang ke kenduri pelantikan penghulu baru.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "22e495ddab59d82d64839ab418de2259fa422715fc8d4ebf8a2c261cbdfa46a5",
      "text": "Masyarakat Mesir bersifat patrilineal, tetapi peran ibu tetap besar.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "2379d53bacfa30796b3b0bdf9127db4362b3c07b24b9e21702fcb7fd8d328ffe",
      "text": "Rumah gadang ini milik nenek saya, lalu ibu saya, lalu adik perempuan saya.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "2392273f7657248ce4620e519adee591132ac41ee60f0b9fbea9c02834114e05",
      "text": "dendang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2397fd66e1a64dc604e2a75e2dd25f7ec4443d168ad23781fe6df07161f8f4d5",
      "text": "surau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "254320f3df39c336f1e98bd5c807837ccbb6c40ccb6cb45a6c9a28db776aa8d5",
      "text": "Ibu dan adik perempuan saya. Saya hanya tamu di sini, kata orang Minang.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "269a732b8aaeb4f5cbdc5365ecd497fbf41da218ac93ec03eabead6841251600",
      "text": "Jadi Uda tidak dapat bagian?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "272971beb244d5eb57463d568bfe7af2308b19ce5662c34a1904dd7b57faf32d",
      "text": "Biasanya kakek dari pihak ayah. Sebaliknya, di sini mamak yang penting.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "27dc931ec18fc32056c2741d5c0db1b528035b30e4ea855088d25c6f0d1561e4",
      "text": "Di Minangkabau, keluarga perempuan yang datang melamar.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "29756083aca10e47125d0e957a57e8f1f603a83491ad1fb06e981ee50b63838d",
      "text": "Keputusan itu diambil secara mufakat setelah musyawarah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a07ec13b56c6c8cdc6366379d663ed2e2961a6736dd8f567d13aa45125ec001",
      "text": "Syarak bersendi Kitabullah.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d6416710cfb3d3826da7c7bc077f0d258bdeb2460cb65a15478348a1426ed72",
      "text": "tak",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f8d08dfa38922fad705ab1a7720680f247ea41c04b31f7505c0c521ec026e0d",
      "text": "Gonjongnya indah sekali. Siapa pemiliknya, Uda?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "303f60bb5098c71e589514f645977fbe758334dbb6467668b43dc4fa668a24d9",
      "text": "Anak bungsu itu masih lajang, tapi tidak ada yang menganggapnya pantang.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "31756eba2652663e9a62fc49b2b9edb984c51154ba30c0b9578173c8f5689844",
      "text": "Datuk senang, Mohamed. Silakan. Beliau tokoh adat paling tua di sini.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "33e243084f4f7b6c598d720eea1e1815e78f54adb1c1bc61a3857f96aecedf94",
      "text": "Jadi adat dan syarak saling menjaga.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "343eb35cd82c8eefc86a958b03cd4873309ab936390510fef8d9e86d05031e65",
      "text": "penghulu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "35860e612122cf3197975610a2323b160105234a6c09cf551c003eed3f08dbf3",
      "text": "Ramai sekali. Pengantinnya anak bungsu, ya?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "392377dbccbd212b9e573c513f943692012ab33c759eaac90764634419094e00",
      "text": "wasiat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a90763df8ae934f9ad23fcbc5c91f4d802d58d7a3968d08d9db0c16613108c6",
      "text": "Tokoh adat itu menjelaskan bahwa pewaris rumah gadang adalah anak perempuan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b612042568974360fb0e94e328f6060bcefcc2a6c13de4a9a5cd932e5b2d2d5",
      "text": "Karena saya sudah menikah, jadi saya mendapat gelar. Kecil bernama, besar bergelar.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b768cb4a581dbc4690ed2c7cac12f25cb62c7e91fab3e340217be751c2b5e2e",
      "text": "Seperti kata pepatah, air beriak tanda tak dalam.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bc1d5ccae675a71ef3ff32a6865078369a9c68f4bb5dbc064166b22445b92c1",
      "text": "Harta pencaharian dibagi menurut hukum waris Islam. Harta pusaka tetap di garis ibu.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c8e00c7694fc9dbda429ad6ce48b35ab175fa3aa6901b81a7b4b3b9e23f7aee",
      "text": "Randai itu seperti teater? Atau seperti silat?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d277d1476d6af9faca0ad32f5841ab9323e905f1696766e96a0573311963061",
      "text": "Gading yang paling indah pun bisa retak.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4142ddc4c03c37eddddfae8b595398d301aae8baaec4823443a235728af4c0f5",
      "text": "Kenduri itu dimasak bersama oleh perempuan dari seluruh kaum.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "41817a7956c5c7052ec5129a6e1377951113e28079fefb383541475b94a05e26",
      "text": "anggapan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "41a048ae6b306014eed1307bf23eff19159bc119885bfc32bb081bf00db85e7a",
      "text": "etnis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a6fe3eb326a8c9bb76fbbce71ceca89a8a0d69c8023238a4246077e1e002a8a",
      "text": "Mohamed, malam ini ada randai di lapangan. Ayo kita nonton!",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b404ab1cbd5867bf9bbbea5bc0c0729c13715e388f4c27499ee51dcfbaf0cb7",
      "text": "Dan dua bangunan kecil di depan itu rangkiang, tempat menyimpan padi?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c41c6f692572b48e212b3ed20e7235153872ced10a9e9e23e723f10203f8b00",
      "text": "Setiap kaum mempunyai rumah gadang dan rangkiangnya sendiri.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c964a7f79db1c956341117cda174c5dcce52e01b9499a8645ebab7838a8a931",
      "text": "Dulu anak laki-laki belajar mengaji dan silat di surau.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e5d3aadf104583538989b5df5f0acc25d65ed154c048d660f020463069150d5",
      "text": "kemenakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5139d501e84dd396218cd811e9018293351a26666b48227669ecb94fc7d19311",
      "text": "Betul. Lain lubuk lain ikannya, tetapi airnya sama-sama sungai.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "51f9da77740ec9cbc0d9d04c73f80f72e1e626f48c22eb659e02692ffd95878c",
      "text": "Air beriak tanda tak dalam.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "529946822ffcae64a022959457482c587e1c4aa57259ed618b0e82cd0045a4ab",
      "text": "Keluarga yang berkabung membaca wasiat ayahnya di depan semua ahli waris.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "549e9021d6163376cb6b7985173c91a763bc8ee56ec173fb5240f4271a72fdf4",
      "text": "Melamar? Bukankah laki-laki yang melamar?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ad83b617673283b8f35ca9e22080255f5f56081ffe2716f21bf975f647a203",
      "text": "Apakah suatu hari Uda akan dilantik menjadi penghulu?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "575b4960e024f5c993ebbf1a8a075983435890122ce4c955bcf2e472e33fc7e4",
      "text": "pepatah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a3bad8fb27af9d98e17fa1e7c09ac29f43d97266c83e0657fea37ed3751141d",
      "text": "Tak usah menyesal, nasi sudah menjadi bubur.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c31589290b68568c8dfcfa6b850934fb25e61a2bcfcc9b1ddd88e4914badde6",
      "text": "Medan adalah kota banyak ___: Batak, Melayu, Jawa, Tionghoa, dan India.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca0352898d3f58741e0071c61340c56a3a016e392ea427003106a611e478740",
      "text": "Ya. Saya mamaknya; saya ikut mengasuh dia sejak kecil.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca65b5187f8fb9b7dca66b7cdb70afa8448050487cee6b2f60716341730843f",
      "text": "bagai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d7aba7d4e30557eae50854393c116200c3b393d4452d5e59563c43d328cb3df",
      "text": "Masyarakat yang beradab menghormati tamu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f7f27f44878a74d2ba4ff816f3272dd589a7123f468ac7a82d0b108338ff954",
      "text": "pemilik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "609be3db3a2985ea977b664a45b6a28d879f999a76f317a2b1480728dc789235",
      "text": "Tidak apa-apa, tak ada gading yang tak retak.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6112a6727b02130ef105e6e849ccd00c498dbd508810b19ab2795c175e2ba445",
      "text": "Mungkin. Mamak saya Datuk sekarang, dan saya kemenakannya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "64594d01c288606dd2ee322341711c32a853f36cd149b257ec6fc472f110184e",
      "text": "sedikit demi sedikit",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ab7feb6bbe4c234cedd718e8f8da0d9bb29ec9fd21ce669b7ea981350bfb6a",
      "text": "Atap rumah gadang berbentuk gonjong, seperti tanduk kerbau.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "68228b93393c544c76fc7d1fdeb54b612aac06bdc4bcf50fad426f617eeddc02",
      "text": "resepsi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c9126ef664185cc3cb815ff8adac12ed8f64eda5092d7a941ed1e43467fc75",
      "text": "Di sini lazim mengasuh anak bersama keluarga besar.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a6e58322d79b0f91226068205fe7407d630458332934e692fc5c7c957b7d386",
      "text": "Besok kamu ke Palembang. Apa yang paling kamu ingat dari ranah Minang?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ab02b7c08ba6561e33a9aa09d7673fc5331b5793c48fc7d101813064afbb1e4",
      "text": "Tentu. Di Mesir kami bilang, \"Ya gharib, kun adib.\"",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b2d635b53779393915046c316da23052861a431a1431386358cf17e883ae072",
      "text": "Ya. Dia orang beradab, tapi agak segan bertemu keluarga kami.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b4b97533bdee3a4fa2cffd9009c04a4c39d33e449dd67bc536e131d50a3e863",
      "text": "Kata Datuk, kemenakannya. Itu adat kami sejak dulu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "708f72a616a50f4af5fbc8108efcde082a157198a86e3d95ea1a87519c81541a",
      "text": "Aduh, maaf! Saya salah menghitung harga rendang untuk acara besok.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "70df002bf270e6be836a3f513dd413d1323ee2c85e7abce892d35dd16390f8ea",
      "text": "teguh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "71c30046a4677bd8998d14473a5a0caafbb0fd7e3b8593a66b9e5897262c3c13",
      "text": "Ini rumah gadang kaum kami. Umurnya hampir seratus tahun.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "7248347edcc51dbc39ded624de61567a066db20e696202b2ee4e2d44da0c8f2a",
      "text": "Kemenakan itu adalah pewaris gelar mamaknya.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "738ebe141870f3e75e6bb52e765fd3c690c58c863399be60fbd421b2571be545",
      "text": "lazim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "73b2b2128aba1fdde96433e40d5f3a8eceb21863505bc0b2193945a5e39487a1",
      "text": "Mohamed, di Mesir, siapa yang paling dihormati dalam keluarga besar?",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "741513c58e6769c188b533472051a7a9ad6f432ff20217afaa09692c33b93d5c",
      "text": "kaum",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "74b7ed3bfa417572e5d0dc6c22f24b51df56a44905e65817b504b67f6f0c66a8",
      "text": "peternak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ddb1657acfea31b0e52c1a97dd7cac5713723de64b8e4a3e19bf993ff5248d",
      "text": "rumah gadang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "752bd67f582cbfee96553603775b30cbeffc866f63206f0d812df9d3551651ce",
      "text": "berkabung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "77801b48b69938ef3fe8610f9e08275e06f3b2af91fc7e99d1e51e324ab0ca2e",
      "text": "Selamat datang di baralek! Resepsinya sampai malam.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7e20248830d873703b0f87a5250d8fc456844e35ad5b29707e8b38ffe730bc",
      "text": "Seperti kata pepatah, di mana bumi dipijak, di situ langit dijunjung.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "807bdc82099551330f7b15d2ff91e793e12361129ca8ce743418de0a81c7a9b2",
      "text": "menjunjung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "82bc9dcb49fa66abfaf6ef53cb99fc11db0e81a9ba4920725974425b32fd5598",
      "text": "Uda, kalau orang Minang meninggal, siapa ahli warisnya?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "837355eed363306836fa768009dbffd37287540834f45d3d0f71fd20e557acb8",
      "text": "Jadi mamak sangat penting. Ada anggapan bahwa ayah tidak penting.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "847404623f42aea1f8294cdc5bad81df2e86165d410fc98d033d66af401431b1",
      "text": "sebaliknya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "84f9d54aef6735db65bf2657a24327e2a016345c507b7060b7c67a193ccc44c1",
      "text": "lamaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8623a85859774bf4b991951abbc291085a4b4b4dab77e7c320e2808812891368",
      "text": "dikenang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f43a2b7227405fb4ed4cbe5e3296ca8afa1f6c07072bc88bb436391f56be49",
      "text": "Dulu saya tidur di surau ini. Kami belajar mengaji, silat, dan adat.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "8906fecc31cbaaaf92db337b79d88413dfe2f09f0f8b2ffc02fff3dca384bfff",
      "text": "Saya segan kepada mamak, jadi saya pamit dengan sopan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "89133275fed5193abe28310c3d6eb4ec283eb34551a7a49fcaccaa7aa0a51880",
      "text": "Mamak saya selalu memberi nasihat tentang suku kami.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b11b967d115a4d98b83858d4781a6436d0da2f9ee0b24763fa11fa5080174ef",
      "text": "kenduri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d6a119e1d725844c17d6dc0cd9a62bca1f41c893cad2539f237b7d0fd06e9d8",
      "text": "silat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e0f78018ff9a5cac25fc9a008c54bf899b9e0d28a52ea26e8f501cfee99aade",
      "text": "Dan semuanya ingin dikenang dengan baik.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fd0356eb922fd03aa551b418e3c6de35e0d895610361de4313deb2faab6d1d7",
      "text": "Bagus! Jadi di rumah gadang nanti, kamu harus ikut adat Minang, ya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "93967604332da83170c60d1d0df5d72323528d2df92426696e98dab1f22a0d2c",
      "text": "bubur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "94a41dcecb1d492453b6cf31977e0f77d253784b2a4dffff2625c4de23e36518",
      "text": "lajang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9849c5f4f6b6729ae54c87db64f837aa6e13bd20aa11a59989c5ea409a6a2801",
      "text": "Siapa pewaris gelar Datuk nanti?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "988f7db368d90303386711adfbdddcfa9bf24af57ec1951b181fb4ca4b965613",
      "text": "kerabat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9932c766cab9ed0ce39ff2f9fdad8d13560f90f8e9c78b6a726c6e70c62ac0ad",
      "text": "Silat bukan hanya bela diri, tetapi juga seni dan adat.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b67440c15a439ec56da056f3f82120cffd1ddad604e41003dc58a6d1d30bd99",
      "text": "Terima kasih atas waktu dan petuahnya, Datuk.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c9e670e6eb560dd33c8acd8e4edb90ba8b9290bbfe1d22cc2ac07e757bec39c",
      "text": "Tatanan adat menjaga martabat keluarga.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d8cebacad25b1cd9bfe12ac19c88fbe2ddb12244997e4f67f1ca284377fed28",
      "text": "Uda Rafi. Saya belajar sedikit demi sedikit.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a392b2e91f275bdca736b2cd5cd17b51fea98fb8db65d7a6ac401337fcdaffdd",
      "text": "Kami belum mencapai mufakat, jadi kita bermusyawarah lagi besok.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a40a07309153634bed4dd7654a0f67d1d1b6cd3b5e24357430ce955dc4a4b7f3",
      "text": "Randai biasanya dipentaskan pada malam hari di lapangan kampung.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a43112355ab8c4bf97554e44f2058f142af22bd849457ccd217aec65398d808a",
      "text": "Minggu depan keluarga adik saya datang melamar.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a59f49f0043c1413dd03b9bce187169b491791fb803596fe38c3ac5e8e83a032",
      "text": "Neneknya yang mengasuh dia sejak kecil.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8b678b2e5ad1b9b475b8497de0854e77d713489af7052e9212b2ef571603cb4",
      "text": "beradab",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa67575d7c3ce578c365c534616376859bc6d918bbdaefc132e87e277000a97f",
      "text": "Di surau, anak-anak belajar agama dan juga adat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaa966d21d665fd4677d20f24b9e3dbc89ee2fa3181a09ab41b75bd4d053167f",
      "text": "Tetapi kita serupa dalam satu hal. Kerabat selalu datang saat ada masalah.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab262d7e0d8f52121b1e8293fb7a216b7cdb505e03a483130a32a79dca0b8ea8",
      "text": "Rumah ini pusaka, bukan warisan pribadi. Tugas saya lain, saya mamak untuk anak-anak adik saya.",
      "voice": "id_gadis",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac35198aa7f46859e1f175749bb80ce54e7476119826e3e39c10753655b0fbe3",
      "text": "bungsu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "add03ae3b45cbb1bdac3729619cb39d9aa3276cd59fb9471ab6c99b77f3e38fb",
      "text": "Mamak bertanggung jawab membimbing anak-anak saudara perempuannya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "af62d9221cb29408990ea06cdeb332e3e8f1d5bef1c4051c294c53d4d4272000",
      "text": "Adik paling kecil dalam keluarga disebut anak ___.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3d10b6730f4b4c6d89655f49c5fc13da735abdf0f35d5c8d0c13a4648b4f4b2",
      "text": "pun",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3df12661294b16e44b2e7167474593cf811a55a1080eba40f0cb05117798e71",
      "text": "Sebelum meninggal, kakek menulis wasiat.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4717ecc6dbe8f038c8d123a13fc4c164fa4f986975af90425c3ae37add0f0cb",
      "text": "Saat Lebaran, semua kerabat berkumpul di rumah nenek.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5931956fb7b407e763a10e9cc10cc7e7d62aa81ec6f59e5d9d467a7b484deaf",
      "text": "Suku saya sama dengan suku ibu saya.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5ba8b4aef021cafff6b85f59c7d644b1546c3f166e6edeb5c29b512fbf3c18f",
      "text": "Kemenakan Datuk Rajo itu dilantik menjadi penghulu yang baru.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b60f8b0aae8bcc530008e2c94541c98dc110df3dab540ad57729c2fbce15b784",
      "text": "waris",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c94657bc8b904831ad2b9889cbc5645fa94482662b000e55bbf4b5725ea0c0",
      "text": "pewaris",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b804ff09e7432f9a9df23b92cb4d5e37cd4b8c478383ba6647c8782a3cbd3f91",
      "text": "Dua-duanya. Para pesilat menari dalam lingkaran, dan ada dendang juga.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8057d7b67738f1de835dac08537456feaed82048e48547a7e2d2e0842ae7f58",
      "text": "marga",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8cef306c8ba0ef58e02cfef7bc08cbd80d1eecaac4fd607993da1f189561074",
      "text": "Tanpa restu mamak, pertunangan tidak bisa dilanjutkan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba019ce701c6bccdcea2b622fa21622fc58bb7bcd955be04f131919ca714074d",
      "text": "Rumah gadang diwariskan dari ibu kepada anak perempuannya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba7ed2ca85afc78462900a0ae58a0e30aa6f6cf7df04112235c4e26d13df0505",
      "text": "Peternak itu dikenang oleh seluruh dusun.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bae89a9a89e07f77c4cde942dd2457016b77392d734cd5b00726e496c7e64e25",
      "text": "Betul. Sumatra punya banyak etnis, banyak tatanan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdc7f9656e57a7b2fc90ceb6149185f7a30ca57d58c5ebc3ba75e86a7981c914",
      "text": "garis keturunan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "befc642cf2d5e6057d2d21eb9fb741c9713b8ebd0c430db9f40b7195233abc2f",
      "text": "Pesilat itu bergerak pelan, lalu tiba-tiba melompat.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf3d4947b1c9cf89905bf94f238557a437b2d78e2b7fd8970aa8daee8467803f",
      "text": "Pantang pulang sebelum pamit kepada tuan rumah.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "bffb81ea60508442f059a812d52ef92f34817f5a8f4996eda5175fbcff855a59",
      "text": "pantang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3499f1469965e52d252a1534a4911f6abfeed020debf935b96878eee6815c09",
      "text": "martabat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c579192debb28bd69f47387d4838d90b33f14ec6fae77f83b96f22ba0ae7678f",
      "text": "Pak Amir dikenang sebagai peternak yang jujur.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c593da09770c1c6cca842ded0e65c2d3c043933d2afc620f39205bee496179d7",
      "text": "Atap rumah gadang yang seperti tanduk kerbau, dan adat yang bersendi syarak.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63c9677a6b670a7e8e3b4203d8d0c987ddb4451019c1e2da8d853468978f60b",
      "text": "randai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83534e83cb174f746c33b2ae07cf36353adfb8665d958e4c25b4025494ea320",
      "text": "Seru sekali! Di Mesir kami punya tahtib, tarian dengan tongkat.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9cdb20aa5b906bc75fbc5f21ffe1c56978acab34e1b2fe75b54d2241bdcaa74",
      "text": "Rumah gadang itu pusaka yang turun ke anak perempuan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca7a283ade21f706079f87a1e4bcc1688a55b69dcf6387e6be86d3d1a5a4525c",
      "text": "Seperti kata pepatah, lain lubuk lain ikannya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca9c7626a03ea35f3d49cf5a8883ecde5e3eb8de60ac4b0375bee5f79555c9f3",
      "text": "pusaka",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb98bb56900253e72f3fddea397bd345ffd84e013950ce047b0243567406ac5c",
      "text": "Seluruh dusun berkabung selama tiga hari.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd2f20a94ba50cccae28ee41d9b4dd3847b5953ed5bd4ddd7563c265f31be516",
      "text": "Para pesilat bergerak dalam lingkaran sambil menyanyikan dendang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd8a3e4f80bc3dff7689b88f2f3c5cd180dd4782a18fa58b1b55899dae45c6f7",
      "text": "sulung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce64e7f1ba18c7d03c6e5a2ea1392ea017b3b34245337a1519785620902ac658",
      "text": "tokoh adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf2040866ff56a5b7614b8c4f4afcace483c9460101dd0377dfb8a0f333e9c7d",
      "text": "gonjong",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d045fc82c46416a48894f75a54c6040e39ca27447c8ffe12ef1429b18ee60d9d",
      "text": "Wah, Mohamed sudah pakai peribahasa! Siapa yang mengajar?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0f872c3c44190e36bffe7f39bc5780717be1bc4173a49e88415d6aeffeb850c",
      "text": "segan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d694e5e24bc4179e351bf1e4a3f2ebdb03466a6a0302ff2dd5bf9c0f4ae6af6e",
      "text": "Orang pintar pun bisa salah.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83bfa823a6bb9a40e6e69976f97f227ce58e6c8004864f51e2c221b3ef45448",
      "text": "Rumah gadang ini mempunyai enam gonjong dan dua rangkiang.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e0c8130561018d4d4b7b7af1088f62d6897d4835b42f8b05c2af52b798b25d",
      "text": "rangkiang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "db7f7767220a53151b90479c1efe3029566ec4b4fe4cf94e44ca2b6721c2aa88",
      "text": "Selamat datang di Bukittinggi, Mohamed. Di sini orang suka berbicara dengan peribahasa.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd91059bd4fe671b5f926ec0a3d6fac7fa485208792b84a650a16b61797d6631",
      "text": "Mohon maaf, Datuk, mengapa atap rumah gadang berbentuk gonjong?",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "de2517e3e31b1289cb42a50ce5435c5119c8a5654c97d3a8668c49a715c293d0",
      "text": "bersendi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0906cd6d43a3b616480345ad0757cd929e9c3f213ff28d108e6b02d77685723",
      "text": "Mohon maaf, Datuk. Boleh saya bertanya tentang adat di kampung ini?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0d991d286a1f2a0c2ee7d09a93b764f67ec2f5e318db6df802710859587cad4",
      "text": "Tidak apa-apa, Uni. Tak ada gading yang tak retak.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e16b4f94f8cdcefe60c3930cc36aa827ab4f31ea5b186e63acc005d2e44f53ff",
      "text": "gading",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1e1b3348b9921cc7c97f0aabd525519dc9c3c3c201abc565e5a02d03cd2e20b",
      "text": "Uda, kenapa orang kampung memanggil Uda dengan nama lain sekarang?",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2485fba5a9ac18e35c9c6fc2ccae3b098f2f5141a9663cd7320bd3931ae0490",
      "text": "suku",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e542700dafe44a24ef4aab853265da72addaee1eab5abe5978c6a82f55b2e4ef",
      "text": "Bagi orang Minang, makan sambil berdiri itu ___.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6b181c206c5ffff9c29b34775e8d88a6573a8822b874b2c69a186552f4e7751",
      "text": "Tanah pusaka itu milik keluarga ibu.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7ede885ca642818cab5b4b4863e844fb7a22f976cb8ee35e0eb3d1c246b2cb7",
      "text": "restu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e90b04fe6fca39c632703e33ebf176148f16d4198d3d113e797a3d404fe11d78",
      "text": "tatanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea7bdd442575a4943d356682b64686dc8b69d3b9d6965a6649ef09dcb7c48856",
      "text": "dusun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc69df20eae21b9fe9250b8a0ce2007efd2f5f06d1706907d991fa29b9ba91b",
      "text": "Anak bungsu itu masih lajang.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef72807b36c189c7d25d31dfdd8d21daaa38b99037ca5095c84317dd3e1cef59",
      "text": "Dia anak sulung, jadi dia yang menikah lebih dulu.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04254dab5890a9f7e3185e3afb21fdc0f39e589d0dec476c327d33d9e0feebd",
      "text": "peribahasa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0df48d62e0c730a11d5114b8abd5679b8d9b54a6a6c58f0444951c4fb68c3c1",
      "text": "… di situ langit dijunjung. Terima kasih, Uda. Utang budi saya besar.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f548f49e20a3494f7019a8fe236e58983bbc20c761407fd84dc62eb9cb019afe",
      "text": "Saya tahu satu, Uda. Di mana bumi dipijak, di situ langit dijunjung.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5ecc02233e847910e57684e630cbf3e5f46f8c053c69c83bd1cbccb19d5e1a6",
      "text": "Kata teman Batak saya, marga turun dari ayah. Terbalik!",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "f66f85bf61ec38f4b0f134196b1bee1967cd9e52c7d322beaf6d3e6db5a028cd",
      "text": "Resepsi itu mengikuti tatanan adat yang lama.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6ff57fea5e7a2b864ff649dc240d2cbfbf334a527ad580aca71dd9e77a4d3c6",
      "text": "pamit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8e93b1eb7c6524c8c44b48453a0e96b9ac349247824e1a9a5d1f91bc6aa3d57",
      "text": "Seperti kuttab di Mesir! Tetapi bagaimana adat matrilineal cocok dengan syarak?",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc3ad6d3ee3db9b04c47f34b77b0aa91b4781b2a78c80050ab6854d09158a230",
      "text": "Di Minang terbalik. Perempuan yang melamar, dengan restu mamak.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe9b34dd201fec2ba70d378a0dff22178bd36659caea48ccc2a773a7d749b3d1",
      "text": "serupa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    }
  ],
