  "content_hash": "c8fa437d75cae526d7d99237772443066fe6b92fd220b3b08c9adaaac74d9037",
  "lessons": [
    {
      "id": "bipa6.u03.l01",
      "sha256": "55b6b24de632e6d3dfc8ff0f11f9bb97435ac3b5c5ca5f705ca285e2c23ddaba"
    },
    {
      "id": "bipa6.u03.l02",
      "sha256": "0ec5f3c717bb03c705c8b0cecb2e8e4d659f139e663baa655487b21df397a8e2"
    },
    {
      "id": "bipa6.u03.l03",
      "sha256": "08e924304a0ac090796cbf441a3f1d460dc3b53a7813fe745437e15ca76370b4"
    },
    {
      "id": "bipa6.u03.l04",
      "sha256": "9917f80fb38b26b6f2af0d642a6f26b5eeb58241ea25946d7e92868d5f2d1f12"
    },
    {
      "id": "bipa6.u03.l05",
      "sha256": "90997f9ad06dd425a73ad57b9f46d06700c752b2b057a2dc09135d1e6150f2fc"
    },
    {
      "id": "bipa6.u03.l06",
      "sha256": "a9147eb68dbb2a1c01e6b788c6c01e41c1f86de2e22dde32f62db5a416e1d4e3"
    },
    {
      "id": "bipa6.u03.l07",
      "sha256": "666667c053279a24c3991a815a1c89d20d7c9ed2d3fa00354f1c4c49ff4eed81"
    },
    {
      "id": "bipa6.u03.l08",
      "sha256": "80634f1ae726e762b04b192bd7d176b18eeb3cca42f377ce6b3a051b28feeb55"
    },
    {
      "id": "bipa6.u03.l09",
      "sha256": "0afccc68807cd5778d9a95d38dc161fe2378d4a323cabb20abfd7c09863f68a1"
    },
    {
      "id": "bipa6.u03.l10",
      "sha256": "adef65ed6bd891a47f76c0cccc276c7dd166625b85d643ecc2947c0097a19575"
    }
  ],
  "audio": [
    {
      "key": "018fba5d636797c60ac0a97d59676c9d6462486d3aa6397c010c39a36704be13",
      "text": "Warisan pribadi dibagi menurut syarak, tetapi pusaka menurut adat.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "02286258f43a71cb772eba080dd15af48167ffc044b9b50b64c017a4e18111d3",
      "text": "Dan peribahasanya, kan? Ingat, di mana bumi dipijak …",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "03ecd402ffcd61be61c47841960e1e6b576d93a7e8b16fbca8094c86f835c0d8",
      "text": "dilantik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "04247bdcb87a922f194a42cb035a48bc9b7308fda1072cc173f64130284c42fd",
      "text": "patrilineal",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0554fa439d33cb8141c7b3c82c12030eb74b0dbfcb33c49178989cc939c19311",
      "text": "mamak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "079d54942fa143b561cc15c63da73a6d000d0c8914fa77ad5bbce80d8a836b24",
      "text": "lingkaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a95254d5fe2fdb0f259852dfba1248c39192becd600e1e7306b38f59df8d377",
      "text": "Menarik sekali. Ternyata ada banyak cara untuk menjaga keluarga.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca5388b9e57d37d274318c35d3fa8a3bbbae2437d39196d7e0053ab1dde688d",
      "text": "syarak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d68e202226c36bf2d67a5a3bc1d49e0d009b0dddab8c1b663215dd9d913a6af",
      "text": "pesilat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e50b73837efe01de0eb0c8922f0c99cc971fe5bbeee788e5f3254cf579e33e8",
      "text": "Saya belajar bahasa Indonesia sedikit demi sedikit setiap hari.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "131892943b5b5962d1e20a680b11f53cf2bbd1329defadbe1dbec61fd1f4c8fa",
      "text": "Kedua budaya serupa, sedikit demi sedikit saya memahaminya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "16c59d383f069f367a23f830aeede5017297b329b0210fd2576972f7e9b47657",
      "text": "Pertanyaan bagus. Pusaka ikut adat, tetapi warisan pribadi ikut syarak. Itu hasil mufakat para ulama dan pemuka adat.",
      "voice": "id_gadis",
      "chars": 117,
      "mime": "audio/mpeg"
    },
    {
      "key": "173023e71b0c9c3b82c38eb9ba7a2b94d724d96ee31cd5de088f4ab665a424fb",
      "text": "datuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f535201421f8c5dbcde054a3dad351d01fd78b7a557ad9551821f7c9afec60d",
      "text": "Gelar datuk diwariskan dari mamak kepada kemenakan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d0997964ce9f2850fe213911467d46e16671c19c727ef11bb781de25696e13",
      "text": "Seluruh kampung datang ke kenduri pelantikan penghulu baru.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "22e495ddab59d82d64839ab418de2259fa422715fc8d4ebf8a2c261cbdfa46a5",
      "text": "Masyarakat Mesir bersifat patrilineal, tetapi peran ibu tetap besar.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "2379d53bacfa30796b3b0bdf9127db4362b3c07b24b9e21702fcb7fd8d328ffe",
      "text": "Rumah gadang ini milik nenek saya, lalu ibu saya, lalu adik perempuan saya.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "2392273f7657248ce4620e519adee591132ac41ee60f0b9fbea9c02834114e05",
      "text": "dendang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2397fd66e1a64dc604e2a75e2dd25f7ec4443d168ad23781fe6df07161f8f4d5",
      "text": "surau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "254320f3df39c336f1e98bd5c807837ccbb6c40ccb6cb45a6c9a28db776aa8d5",
      "text": "Ibu dan adik perempuan saya. Saya hanya tamu di sini, kata orang Minang.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "269a732b8aaeb4f5cbdc5365ecd497fbf41da218ac93ec03eabead6841251600",
      "text": "Jadi Uda tidak dapat bagian?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "272971beb244d5eb57463d568bfe7af2308b19ce5662c34a1904dd7b57faf32d",
      "text": "Biasanya kakek dari pihak ayah. Sebaliknya, di sini mamak yang penting.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "29756083aca10e47125d0e957a57e8f1f603a83491ad1fb06e981ee50b63838d",
      "text": "Keputusan itu diambil secara mufakat setelah musyawarah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2989e4fd72c88e71ddde7660f299359d5087a091fdcbe7be70c119152dc4574c",
      "text": "Setelah penghulu baru dilantik, seluruh kaum makan bersama di kenduri.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a07ec13b56c6c8cdc6366379d663ed2e2961a6736dd8f567d13aa45125ec001",
      "text": "Syarak bersendi Kitabullah.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f8d08dfa38922fad705ab1a7720680f247ea41c04b31f7505c0c521ec026e0d",
      "text": "Gonjongnya indah sekali. Siapa pemiliknya, Uda?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "30ddec3670b6161cc002e1b1f5eb3d00414afb4199f164e3ee14d35c7145bee5",
      "text": "Jangan menyesal terus, nasi sudah menjadi bubur.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "31756eba2652663e9a62fc49b2b9edb984c51154ba30c0b9578173c8f5689844",
      "text": "Datuk senang, Mohamed. Silakan. Beliau tokoh adat paling tua di sini.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "33e243084f4f7b6c598d720eea1e1815e78f54adb1c1bc61a3857f96aecedf94",
      "text": "Jadi adat dan syarak saling menjaga.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "343eb35cd82c8eefc86a958b03cd4873309ab936390510fef8d9e86d05031e65",
      "text": "penghulu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a90763df8ae934f9ad23fcbc5c91f4d802d58d7a3968d08d9db0c16613108c6",
      "text": "Tokoh adat itu menjelaskan bahwa pewaris rumah gadang adalah anak perempuan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b612042568974360fb0e94e328f6060bcefcc2a6c13de4a9a5cd932e5b2d2d5",
      "text": "Karena saya sudah menikah, jadi saya mendapat gelar. Kecil bernama, besar bergelar.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b768cb4a581dbc4690ed2c7cac12f25cb62c7e91fab3e340217be751c2b5e2e",
      "text": "Seperti kata pepatah, air beriak tanda tak dalam.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c8e00c7694fc9dbda429ad6ce48b35ab175fa3aa6901b81a7b4b3b9e23f7aee",
      "text": "Randai itu seperti teater? Atau seperti silat?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d277d1476d6af9faca0ad32f5841ab9323e905f1696766e96a0573311963061",
      "text": "Gading yang paling indah pun bisa retak.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4142ddc4c03c37eddddfae8b595398d301aae8baaec4823443a235728af4c0f5",
      "text": "Kenduri itu dimasak bersama oleh perempuan dari seluruh kaum.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a6fe3eb326a8c9bb76fbbce71ceca89a8a0d69c8023238a4246077e1e002a8a",
      "text": "Mohamed, malam ini ada randai di lapangan. Ayo kita nonton!",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b404ab1cbd5867bf9bbbea5bc0c0729c13715e388f4c27499ee51dcfbaf0cb7",
      "text": "Dan dua bangunan kecil di depan itu rangkiang, tempat menyimpan padi?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c41c6f692572b48e212b3ed20e7235153872ced10a9e9e23e723f10203f8b00",
      "text": "Setiap kaum mempunyai rumah gadang dan rangkiangnya sendiri.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c964a7f79db1c956341117cda174c5dcce52e01b9499a8645ebab7838a8a931",
      "text": "Dulu anak laki-laki belajar mengaji dan silat di surau.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e5d3aadf104583538989b5df5f0acc25d65ed154c048d660f020463069150d5",
      "text": "kemenakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5139d501e84dd396218cd811e9018293351a26666b48227669ecb94fc7d19311",
      "text": "Betul. Lain lubuk lain ikannya, tetapi airnya sama-sama sungai.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ad83b617673283b8f35ca9e22080255f5f56081ffe2716f21bf975f647a203",
      "text": "Apakah suatu hari Uda akan dilantik menjadi penghulu?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "575b4960e024f5c993ebbf1a8a075983435890122ce4c955bcf2e472e33fc7e4",
      "text": "pepatah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c4e927e8004c177a3317f5f02ff1cba23d0387f8ec29279988520d8014717f5",
      "text": "Setiap bahasa punya peribahasa tentang kesabaran.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca65b5187f8fb9b7dca66b7cdb70afa8448050487cee6b2f60716341730843f",
      "text": "bagai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f7f27f44878a74d2ba4ff816f3272dd589a7123f468ac7a82d0b108338ff954",
      "text": "pemilik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "609be3db3a2985ea977b664a45b6a28d879f999a76f317a2b1480728dc789235",
      "text": "Tidak apa-apa, tak ada gading yang tak retak.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6112a6727b02130ef105e6e849ccd00c498dbd508810b19ab2795c175e2ba445",
      "text": "Mungkin. Mamak saya Datuk sekarang, dan saya kemenakannya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "64594d01c288606dd2ee322341711c32a853f36cd149b257ec6fc472f110184e",
      "text": "sedikit demi sedikit",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ab7feb6bbe4c234cedd718e8f8da0d9bb29ec9fd21ce669b7ea981350bfb6a",
      "text": "Atap rumah gadang berbentuk gonjong, seperti tanduk kerbau.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a6e58322d79b0f91226068205fe7407d630458332934e692fc5c7c957b7d386",
      "text": "Besok kamu ke Palembang. Apa yang paling kamu ingat dari ranah Minang?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ab02b7c08ba6561e33a9aa09d7673fc5331b5793c48fc7d101813064afbb1e4",
      "text": "Tentu. Di Mesir kami bilang, \"Ya gharib, kun adib.\"",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b4b97533bdee3a4fa2cffd9009c04a4c39d33e449dd67bc536e131d50a3e863",
      "text": "Kata Datuk, kemenakannya. Itu adat kami sejak dulu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "708f72a616a50f4af5fbc8108efcde082a157198a86e3d95ea1a87519c81541a",
      "text": "Aduh, maaf! Saya salah menghitung harga rendang untuk acara besok.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "70df002bf270e6be836a3f513dd413d1323ee2c85e7abce892d35dd16390f8ea",
      "text": "teguh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "71c30046a4677bd8998d14473a5a0caafbb0fd7e3b8593a66b9e5897262c3c13",
      "text": "Ini rumah gadang kaum kami. Umurnya hampir seratus tahun.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "7248347edcc51dbc39ded624de61567a066db20e696202b2ee4e2d44da0c8f2a",
      "text": "Kemenakan itu adalah pewaris gelar mamaknya.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "73b2b2128aba1fdde96433e40d5f3a8eceb21863505bc0b2193945a5e39487a1",
      "text": "Mohamed, di Mesir, siapa yang paling dihormati dalam keluarga besar?",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "741513c58e6769c188b533472051a7a9ad6f432ff20217afaa09692c33b93d5c",
      "text": "kaum",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ddb1657acfea31b0e52c1a97dd7cac5713723de64b8e4a3e19bf993ff5248d",
      "text": "rumah gadang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7e20248830d873703b0f87a5250d8fc456844e35ad5b29707e8b38ffe730bc",
      "text": "Seperti kata pepatah, di mana bumi dipijak, di situ langit dijunjung.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "807bdc82099551330f7b15d2ff91e793e12361129ca8ce743418de0a81c7a9b2",
      "text": "menjunjung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "847404623f42aea1f8294cdc5bad81df2e86165d410fc98d033d66af401431b1",
      "text": "sebaliknya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f43a2b7227405fb4ed4cbe5e3296ca8afa1f6c07072bc88bb436391f56be49",
      "text": "Dulu saya tidur di surau ini. Kami belajar mengaji, silat, dan adat.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "89133275fed5193abe28310c3d6eb4ec283eb34551a7a49fcaccaa7aa0a51880",
      "text": "Mamak saya selalu memberi nasihat tentang suku kami.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b11b967d115a4d98b83858d4781a6436d0da2f9ee0b24763fa11fa5080174ef",
      "text": "kenduri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d6a119e1d725844c17d6dc0cd9a62bca1f41c893cad2539f237b7d0fd06e9d8",
      "text": "silat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fd0356eb922fd03aa551b418e3c6de35e0d895610361de4313deb2faab6d1d7",
      "text": "Bagus! Jadi di rumah gadang nanti, kamu harus ikut adat Minang, ya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "93967604332da83170c60d1d0df5d72323528d2df92426696e98dab1f22a0d2c",
      "text": "bubur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9849c5f4f6b6729ae54c87db64f837aa6e13bd20aa11a59989c5ea409a6a2801",
      "text": "Siapa pewaris gelar Datuk nanti?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "988f7db368d90303386711adfbdddcfa9bf24af57ec1951b181fb4ca4b965613",
      "text": "kerabat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9932c766cab9ed0ce39ff2f9fdad8d13560f90f8e9c78b6a726c6e70c62ac0ad",
      "text": "Silat bukan hanya bela diri, tetapi juga seni dan adat.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b67440c15a439ec56da056f3f82120cffd1ddad604e41003dc58a6d1d30bd99",
      "text": "Terima kasih atas waktu dan petuahnya, Datuk.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d8cebacad25b1cd9bfe12ac19c88fbe2ddb12244997e4f67f1ca284377fed28",
      "text": "Uda Rafi. Saya belajar sedikit demi sedikit.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a392b2e91f275bdca736b2cd5cd17b51fea98fb8db65d7a6ac401337fcdaffdd",
      "text": "Kami belum mencapai mufakat, jadi kita bermusyawarah lagi besok.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a40a07309153634bed4dd7654a0f67d1d1b6cd3b5e24357430ce955dc4a4b7f3",
      "text": "Randai biasanya dipentaskan pada malam hari di lapangan kampung.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa67575d7c3ce578c365c534616376859bc6d918bbdaefc132e87e277000a97f",
      "text": "Di surau, anak-anak belajar agama dan juga adat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaa966d21d665fd4677d20f24b9e3dbc89ee2fa3181a09ab41b75bd4d053167f",
      "text": "Tetapi kita serupa dalam satu hal. Kerabat selalu datang saat ada masalah.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab262d7e0d8f52121b1e8293fb7a216b7cdb505e03a483130a32a79dca0b8ea8",
      "text": "Rumah ini pusaka, bukan warisan pribadi. Tugas saya lain, saya mamak untuk anak-anak adik saya.",
      "voice": "id_gadis",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "add03ae3b45cbb1bdac3729619cb39d9aa3276cd59fb9471ab6c99b77f3e38fb",
      "text": "Mamak bertanggung jawab membimbing anak-anak saudara perempuannya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4717ecc6dbe8f038c8d123a13fc4c164fa4f986975af90425c3ae37add0f0cb",
      "text": "Saat Lebaran, semua kerabat berkumpul di rumah nenek.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5931956fb7b407e763a10e9cc10cc7e7d62aa81ec6f59e5d9d467a7b484deaf",
      "text": "Suku saya sama dengan suku ibu saya.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5ba8b4aef021cafff6b85f59c7d644b1546c3f166e6edeb5c29b512fbf3c18f",
      "text": "Kemenakan Datuk Rajo itu dilantik menjadi penghulu yang baru.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c94657bc8b904831ad2b9889cbc5645fa94482662b000e55bbf4b5725ea0c0",
      "text": "pewaris",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b804ff09e7432f9a9df23b92cb4d5e37cd4b8c478383ba6647c8782a3cbd3f91",
      "text": "Dua-duanya. Para pesilat menari dalam lingkaran, dan ada dendang juga.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba019ce701c6bccdcea2b622fa21622fc58bb7bcd955be04f131919ca714074d",
      "text": "Rumah gadang diwariskan dari ibu kepada anak perempuannya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdc7f9656e57a7b2fc90ceb6149185f7a30ca57d58c5ebc3ba75e86a7981c914",
      "text": "garis keturunan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "befc642cf2d5e6057d2d21eb9fb741c9713b8ebd0c430db9f40b7195233abc2f",
      "text": "Pesilat itu bergerak pelan, lalu tiba-tiba melompat.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c593da09770c1c6cca842ded0e65c2d3c043933d2afc620f39205bee496179d7",
      "text": "Atap rumah gadang yang seperti tanduk kerbau, dan adat yang bersendi syarak.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63c9677a6b670a7e8e3b4203d8d0c987ddb4451019c1e2da8d853468978f60b",
      "text": "randai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83534e83cb174f746c33b2ae07cf36353adfb8665d958e4c25b4025494ea320",
      "text": "Seru sekali! Di Mesir kami punya tahtib, tarian dengan tongkat.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9cdb20aa5b906bc75fbc5f21ffe1c56978acab34e1b2fe75b54d2241bdcaa74",
      "text": "Rumah gadang itu pusaka yang turun ke anak perempuan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca7a283ade21f706079f87a1e4bcc1688a55b69dcf6387e6be86d3d1a5a4525c",
      "text": "Seperti kata pepatah, lain lubuk lain ikannya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca9c7626a03ea35f3d49cf5a8883ecde5e3eb8de60ac4b0375bee5f79555c9f3",
      "text": "pusaka",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd2f20a94ba50cccae28ee41d9b4dd3847b5953ed5bd4ddd7563c265f31be516",
      "text": "Para pesilat bergerak dalam lingkaran sambil menyanyikan dendang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce64e7f1ba18c7d03c6e5a2ea1392ea017b3b34245337a1519785620902ac658",
      "text": "tokoh adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf2040866ff56a5b7614b8c4f4afcace483c9460101dd0377dfb8a0f333e9c7d",
      "text": "gonjong",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d045fc82c46416a48894f75a54c6040e39ca27447c8ffe12ef1429b18ee60d9d",
      "text": "Wah, Mohamed sudah pakai peribahasa! Siapa yang mengajar?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d23be193a6d0b28cc6c432dfae7bdc01335a97017d4f92dcdb4884466ae8c032",
      "text": "Kalau kita bersatu, tim kita akan tetap teguh.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83bfa823a6bb9a40e6e69976f97f227ce58e6c8004864f51e2c221b3ef45448",
      "text": "Rumah gadang ini mempunyai enam gonjong dan dua rangkiang.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e0c8130561018d4d4b7b7af1088f62d6897d4835b42f8b05c2af52b798b25d",
      "text": "rangkiang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "db7f7767220a53151b90479c1efe3029566ec4b4fe4cf94e44ca2b6721c2aa88",
      "text": "Selamat datang di Bukittinggi, Mohamed. Di sini orang suka berbicara dengan peribahasa.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd91059bd4fe671b5f926ec0a3d6fac7fa485208792b84a650a16b61797d6631",
      "text": "Mohon maaf, Datuk, mengapa atap rumah gadang berbentuk gonjong?",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "de2517e3e31b1289cb42a50ce5435c5119c8a5654c97d3a8668c49a715c293d0",
      "text": "bersendi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0906cd6d43a3b616480345ad0757cd929e9c3f213ff28d108e6b02d77685723",
      "text": "Mohon maaf, Datuk. Boleh saya bertanya tentang adat di kampung ini?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0d991d286a1f2a0c2ee7d09a93b764f67ec2f5e318db6df802710859587cad4",
      "text": "Tidak apa-apa, Uni. Tak ada gading yang tak retak.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e16b4f94f8cdcefe60c3930cc36aa827ab4f31ea5b186e63acc005d2e44f53ff",
      "text": "gading",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1e1b3348b9921cc7c97f0aabd525519dc9c3c3c201abc565e5a02d03cd2e20b",
      "text": "Uda, kenapa orang kampung memanggil Uda dengan nama lain sekarang?",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2485fba5a9ac18e35c9c6fc2ccae3b098f2f5141a9663cd7320bd3931ae0490",
      "text": "suku",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6b181c206c5ffff9c29b34775e8d88a6573a8822b874b2c69a186552f4e7751",
      "text": "Tanah pusaka itu milik keluarga ibu.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04254dab5890a9f7e3185e3afb21fdc0f39e589d0dec476c327d33d9e0feebd",
      "text": "peribahasa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0df48d62e0c730a11d5114b8abd5679b8d9b54a6a6c58f0444951c4fb68c3c1",
      "text": "… di situ langit dijunjung. Terima kasih, Uda. Utang budi saya besar.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f548f49e20a3494f7019a8fe236e58983bbc20c761407fd84dc62eb9cb019afe",
      "text": "Saya tahu satu, Uda. Di mana bumi dipijak, di situ langit dijunjung.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8e93b1eb7c6524c8c44b48453a0e96b9ac349247824e1a9a5d1f91bc6aa3d57",
      "text": "Seperti kuttab di Mesir! Tetapi bagaimana adat matrilineal cocok dengan syarak?",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe9b34dd201fec2ba70d378a0dff22178bd36659caea48ccc2a773a7d749b3d1",
      "text": "serupa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 10,
    "clips": 116,
    "chars": 5031,
