    },
    {
      "id": "bipa6.u03.l07",
      "sha256": "c093a5c3bffece5cd52cc69b987424b704c004cff0a1280556d59ffda57c502a"
    },
    {
      "id": "bipa6.u03.l08",
      "sha256": "d80f12f3b723c1ca49644ffbadf9510efa10418dcebaf1442386c78d2637abd8"
    },
