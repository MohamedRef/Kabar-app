    },
    {
      "id": "bipa6.u03.l12",
      "sha256": "13e195423c898ed9c9849f183ba356510868a68b918df01facb3605d7fce2d96"
    },
    {
      "id": "bipa6.u03.l13",
      "sha256": "25b530cca6389f2dc511e7d0da6186fc9523c2e48c5193e05bba6fc6d9a970cc"
    }
  ],
  "audio": [
    {
      "key": "008394bf0cf1c724b12687ad411ee9aae989069d65fadd9343c104abf1e3c64a",
      "text": "Menarik! Calon suaminya anak sulung?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "02286258f43a71cb772eba080dd15af48167ffc044b9b50b64c017a4e18111d3",
      "text": "Dan peribahasanya, kan? Ingat, di mana bumi dipijak …",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "03ecd402ffcd61be61c47841960e1e6b576d93a7e8b16fbca8094c86f835c0d8",
      "text": "dilantik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "04247bdcb87a922f194a42cb035a48bc9b7308fda1072cc173f64130284c42fd",
      "text": "patrilineal",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "05252684f540e998dd25f9a6aa96000685cae24331ca4bfab2ef2614c1a81dda",
      "text": "Melamar? Bukannya laki-laki yang melamar?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0532fcaef368656e0b4090e2f130e36fa543c028a3ce403f5e9a590c6492f008",
      "text": "Wah, Mohamed udah pakai peribahasa! Siapa gurunya?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0554fa439d33cb8141c7b3c82c12030eb74b0dbfcb33c49178989cc939c19311",
      "text": "mamak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "079d54942fa143b561cc15c63da73a6d000d0c8914fa77ad5bbce80d8a836b24",
      "text": "lingkaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a65bac781ffbba01fc69373841ee46aed2ad38e242cbc1711c72f511ad1d6e7",
      "text": "Kata teman Batakku, marga turun dari ayah. Kebalik!",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca5388b9e57d37d274318c35d3fa8a3bbbae2437d39196d7e0053ab1dde688d",
      "text": "syarak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d68e202226c36bf2d67a5a3bc1d49e0d009b0dddab8c1b663215dd9d913a6af",
      "text": "pesilat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0db4db24dd91c4e2b3fb7aee7b9d891ca2e1f225159b4fccf4d7521539182133",
      "text": "mengasuh",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e407b32a6698e5ab2c17f97bd05c024bb3431a175c366fd29dfc42c76708014",
      "text": "Randai itu kayak teater? Atau kayak silat?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e50b73837efe01de0eb0c8922f0c99cc971fe5bbeee788e5f3254cf579e33e8",
      "text": "Saya belajar bahasa Indonesia sedikit demi sedikit setiap hari.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ffa5d2d8cbc4b3d24750050d92b30d09c06565a533bab07be94ce08ccf7589e",
      "text": "Anak sulung pamit kepada keluarga yang berkabung.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1152aaa6c379839a43fd71217cd0fbee162cbe6e42dfa04a02932eebdbf8ff58",
      "text": "pertunangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "11cdc4c3d08e16c29499348dc1dad414ee22d2aa6a882a0ab666ddc29db061b7",
      "text": "Kalau kita bersatu, kita akan tetap teguh.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1524450dd3fda1a65879ba7d9067581ca83e7696d970aa58df0b79e654c20861",
      "text": "Uda Rafi. Aku belajar sedikit demi sedikit.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "173023e71b0c9c3b82c38eb9ba7a2b94d724d96ee31cd5de088f4ab665a424fb",
      "text": "datuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a062790b2ea39fe151356b1df8fce93ded9c21b445fedf16089a52db53328d3",
      "text": "Suatu hari nanti Uda akan dilantik jadi penghulu?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dff50668829dce8f7892b5981057406550519d4a707b9d9e3bcd3cf3457a938",
      "text": "Orang Batak mewarisi marga dari ayah.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f535201421f8c5dbcde054a3dad351d01fd78b7a557ad9551821f7c9afec60d",
      "text": "Gelar datuk diwariskan dari mamak kepada kemenakan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "20085cab1a2fefcafdeb87b3e43525160bc2a61901c241b1c8441660c9212f09",
      "text": "Di Minang kebalik. Perempuan yang melamar, dengan restu mamak.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "208b3e508f57feec9ae448921e9d8e5497a1c2d5e3092b63f71b090fe0d9ecd1",
      "text": "Resepsinya di rumah gadang, tamunya ratusan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d0997964ce9f2850fe213911467d46e16671c19c727ef11bb781de25696e13",
      "text": "Seluruh kampung datang ke kenduri pelantikan penghulu baru.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "22e19d88f7df8fa7efc30db9e42211b3defdc287095e5a5c097001f436007106",
      "text": "Karena aku udah nikah, jadi aku dapat gelar. Kecil bernama, besar bergelar.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "22e495ddab59d82d64839ab418de2259fa422715fc8d4ebf8a2c261cbdfa46a5",
      "text": "Masyarakat Mesir bersifat patrilineal, tetapi peran ibu tetap besar.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "2392273f7657248ce4620e519adee591132ac41ee60f0b9fbea9c02834114e05",
      "text": "dendang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2397fd66e1a64dc604e2a75e2dd25f7ec4443d168ad23781fe6df07161f8f4d5",
      "text": "surau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2709f579e7f6198ac6b8839c8e32c3313d6856ecdf0cba009b4dc501eba8c3c6",
      "text": "Besok kamu ke Palembang. Apa yang paling kamu ingat dari Sumatra Barat?",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "272971beb244d5eb57463d568bfe7af2308b19ce5662c34a1904dd7b57faf32d",
      "text": "Biasanya kakek dari pihak ayah. Sebaliknya, di sini mamak yang penting.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "27dc931ec18fc32056c2741d5c0db1b528035b30e4ea855088d25c6f0d1561e4",
      "text": "Di Minangkabau, keluarga perempuan yang datang melamar.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "28d37dbdd339906bfeaa9bf9ebd995983e081845e13401e3e84ab1633447d4d0",
      "text": "Terus dua bangunan kecil di depan itu rangkiang, tempat nyimpan padi?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "29756083aca10e47125d0e957a57e8f1f603a83491ad1fb06e981ee50b63838d",
      "text": "Keputusan itu diambil secara mufakat setelah musyawarah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2989e4fd72c88e71ddde7660f299359d5087a091fdcbe7be70c119152dc4574c",
      "text": "Setelah penghulu baru dilantik, seluruh kaum makan bersama di kenduri.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a07ec13b56c6c8cdc6366379d663ed2e2961a6736dd8f567d13aa45125ec001",
      "text": "Syarak bersendi Kitabullah.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b6e177384b5064ffffbb51d3f657194e75457ffec159a1f853f2145534de23d",
      "text": "Itu keliru. Dalam tatanan adat, dua-duanya menjaga martabat keluarga.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d6416710cfb3d3826da7c7bc077f0d258bdeb2460cb65a15478348a1426ed72",
      "text": "tak",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f2314223b058ca2f5e352d946299b519c7f95c53c09fa98b817d5e00388c895",
      "text": "Aduh, maaf! Aku salah menghitung harga rendang buat acara besok.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f4b7ea163a34547ffccd7e2a23a79e0afe7c65cadb9d0ca8cbb9a85a42b32e5",
      "text": "Kenapa orang kampung sekarang punya nama lain buat Uda?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "31756eba2652663e9a62fc49b2b9edb984c51154ba30c0b9578173c8f5689844",
      "text": "Datuk senang, Mohamed. Silakan. Beliau tokoh adat paling tua di sini.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "343eb35cd82c8eefc86a958b03cd4873309ab936390510fef8d9e86d05031e65",
      "text": "penghulu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "392377dbccbd212b9e573c513f943692012ab33c759eaac90764634419094e00",
      "text": "wasiat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a90763df8ae934f9ad23fcbc5c91f4d802d58d7a3968d08d9db0c16613108c6",
      "text": "Tokoh adat itu menjelaskan bahwa pewaris rumah gadang adalah anak perempuan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6a6b6fce391ef63279b45a3807eae54c76cb7f6f3581f934bbe091bf3c870e",
      "text": "Rumah gadang ini punya nenekku, terus ibuku, terus adik perempuanku.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b768cb4a581dbc4690ed2c7cac12f25cb62c7e91fab3e340217be751c2b5e2e",
      "text": "Seperti kata pepatah, air beriak tanda tak dalam.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3baf48a6c3bdb618d0ca279db7a61d110ed76b3424dfba18b1de41cec2ff538c",
      "text": "Tapi kita serupa dalam satu hal. Kerabat selalu datang kalau ada masalah.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c55289ebd1e0a5354c2f21c283418b10c29415ee7797ab8612e6207aec83670",
      "text": "Rumah ini pusaka, bukan warisan pribadi. Tugasku lain: aku mamak buat anak-anak adikku.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d277d1476d6af9faca0ad32f5841ab9323e905f1696766e96a0573311963061",
      "text": "Gading yang paling indah pun bisa retak.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ebd10bf77dd361049e24df1b65efea20f512b604a86b7a6bbf204ba5109b719",
      "text": "Bagus! Jadi nanti di rumah gadang, kamu harus ikut adat Minang, ya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "4142ddc4c03c37eddddfae8b595398d301aae8baaec4823443a235728af4c0f5",
      "text": "Kenduri itu dimasak bersama oleh perempuan dari seluruh kaum.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "41817a7956c5c7052ec5129a6e1377951113e28079fefb383541475b94a05e26",
      "text": "anggapan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "41a048ae6b306014eed1307bf23eff19159bc119885bfc32bb081bf00db85e7a",
      "text": "etnis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c2a361363bd175001aed5101012ea35ffe7f82ceaa43bb627ea0fc3ae18aa0f",
      "text": "Mungkin. Mamakku sekarang Datuk, dan aku kemenakannya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c41c6f692572b48e212b3ed20e7235153872ced10a9e9e23e723f10203f8b00",
      "text": "Setiap kaum mempunyai rumah gadang dan rangkiangnya sendiri.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c964a7f79db1c956341117cda174c5dcce52e01b9499a8645ebab7838a8a931",
      "text": "Dulu anak laki-laki belajar mengaji dan silat di surau.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e5d3aadf104583538989b5df5f0acc25d65ed154c048d660f020463069150d5",
      "text": "kemenakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "51f9da77740ec9cbc0d9d04c73f80f72e1e626f48c22eb659e02692ffd95878c",
      "text": "Air beriak tanda tak dalam.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "529946822ffcae64a022959457482c587e1c4aa57259ed618b0e82cd0045a4ab",
      "text": "Keluarga yang berkabung membaca wasiat ayahnya di depan semua ahli waris.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "575b4960e024f5c993ebbf1a8a075983435890122ce4c955bcf2e472e33fc7e4",
      "text": "pepatah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a3bad8fb27af9d98e17fa1e7c09ac29f43d97266c83e0657fea37ed3751141d",
      "text": "Tak usah menyesal, nasi sudah menjadi bubur.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c31589290b68568c8dfcfa6b850934fb25e61a2bcfcc9b1ddd88e4914badde6",
      "text": "Medan adalah kota banyak ___: Batak, Melayu, Jawa, Tionghoa, dan India.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ca65b5187f8fb9b7dca66b7cdb70afa8448050487cee6b2f60716341730843f",
      "text": "bagai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d7aba7d4e30557eae50854393c116200c3b393d4452d5e59563c43d328cb3df",
      "text": "Masyarakat yang beradab menghormati tamu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f7f27f44878a74d2ba4ff816f3272dd589a7123f468ac7a82d0b108338ff954",
      "text": "pemilik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "609be3db3a2985ea977b664a45b6a28d879f999a76f317a2b1480728dc789235",
      "text": "Tidak apa-apa, tak ada gading yang tak retak.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "614ebbba3c8d2592c18e81e8214ec3ee77ce0a3c8a71d7a79f582b3c42ce53ba",
      "text": "Selamat datang di Bukittinggi, Mohamed. Di sini orang suka pakai peribahasa.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "64594d01c288606dd2ee322341711c32a853f36cd149b257ec6fc472f110184e",
      "text": "sedikit demi sedikit",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "64751d59fa5cf9204627e3777320bc6600e4858959bf837c5c133baa26b0d18d",
      "text": "Atap rumah gadang yang kayak tanduk kerbau, dan adat yang bersendi syarak.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ab7feb6bbe4c234cedd718e8f8da0d9bb29ec9fd21ce669b7ea981350bfb6a",
      "text": "Atap rumah gadang berbentuk gonjong, seperti tanduk kerbau.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "68228b93393c544c76fc7d1fdeb54b612aac06bdc4bcf50fad426f617eeddc02",
      "text": "resepsi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c9126ef664185cc3cb815ff8adac12ed8f64eda5092d7a941ed1e43467fc75",
      "text": "Di sini lazim mengasuh anak bersama keluarga besar.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b4b97533bdee3a4fa2cffd9009c04a4c39d33e449dd67bc536e131d50a3e863",
      "text": "Kata Datuk, kemenakannya. Itu adat kami sejak dulu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "70df002bf270e6be836a3f513dd413d1323ee2c85e7abce892d35dd16390f8ea",
      "text": "teguh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "71c30046a4677bd8998d14473a5a0caafbb0fd7e3b8593a66b9e5897262c3c13",
      "text": "Ini rumah gadang kaum kami. Umurnya hampir seratus tahun.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "7248347edcc51dbc39ded624de61567a066db20e696202b2ee4e2d44da0c8f2a",
      "text": "Kemenakan itu adalah pewaris gelar mamaknya.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "738ebe141870f3e75e6bb52e765fd3c690c58c863399be60fbd421b2571be545",
      "text": "lazim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "741513c58e6769c188b533472051a7a9ad6f432ff20217afaa09692c33b93d5c",
      "text": "kaum",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "745adc3351262bc908d08353fd7b96b5a84d62bbd779a189712b4fad26d17990",
      "text": "Jadi Uda nggak dapat bagian?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "74b7ed3bfa417572e5d0dc6c22f24b51df56a44905e65817b504b67f6f0c66a8",
      "text": "peternak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "74ddb1657acfea31b0e52c1a97dd7cac5713723de64b8e4a3e19bf993ff5248d",
      "text": "rumah gadang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "752bd67f582cbfee96553603775b30cbeffc866f63206f0d812df9d3551651ce",
      "text": "berkabung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "75646a5437473c95f71688b66603d531375ee43b6828c6b6ed0721cd7ca52798",
      "text": "Dua-duanya. Para pesilat menari dalam lingkaran, terus ada dendang juga.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "77801b48b69938ef3fe8610f9e08275e06f3b2af91fc7e99d1e51e324ab0ca2e",
      "text": "Selamat datang di baralek! Resepsinya sampai malam.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7e20248830d873703b0f87a5250d8fc456844e35ad5b29707e8b38ffe730bc",
      "text": "Seperti kata pepatah, di mana bumi dipijak, di situ langit dijunjung.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "807bdc82099551330f7b15d2ff91e793e12361129ca8ce743418de0a81c7a9b2",
      "text": "menjunjung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "847404623f42aea1f8294cdc5bad81df2e86165d410fc98d033d66af401431b1",
      "text": "sebaliknya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "84f9d54aef6735db65bf2657a24327e2a016345c507b7060b7c67a193ccc44c1",
      "text": "lamaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8623a85859774bf4b991951abbc291085a4b4b4dab77e7c320e2808812891368",
      "text": "dikenang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8906fecc31cbaaaf92db337b79d88413dfe2f09f0f8b2ffc02fff3dca384bfff",
      "text": "Saya segan kepada mamak, jadi saya pamit dengan sopan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "89133275fed5193abe28310c3d6eb4ec283eb34551a7a49fcaccaa7aa0a51880",
      "text": "Mamak saya selalu memberi nasihat tentang suku kami.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b11b967d115a4d98b83858d4781a6436d0da2f9ee0b24763fa11fa5080174ef",
      "text": "kenduri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d6a119e1d725844c17d6dc0cd9a62bca1f41c893cad2539f237b7d0fd06e9d8",
      "text": "silat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dbd3a60da70c8e2abb59e9b3de742ead8ca616d27948c52547accaeccd7e948",
      "text": "Minggu depan keluarga adikku datang melamar.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "92f00a99d34d85776bab658e26a73af06d6e11b22f9b58b5709a3ea94272bff1",
      "text": "Pertanyaan bagus. Pusaka ikut adat, tapi warisan pribadi ikut syarak. Itu hasil mufakat para ulama dan pemuka adat.",
      "voice": "id_gadis",
      "chars": 115,
      "mime": "audio/mpeg"
    },
    {
      "key": "93967604332da83170c60d1d0df5d72323528d2df92426696e98dab1f22a0d2c",
      "text": "bubur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "94a41dcecb1d492453b6cf31977e0f77d253784b2a4dffff2625c4de23e36518",
      "text": "lajang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9849c5f4f6b6729ae54c87db64f837aa6e13bd20aa11a59989c5ea409a6a2801",
      "text": "Siapa pewaris gelar Datuk nanti?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "988f7db368d90303386711adfbdddcfa9bf24af57ec1951b181fb4ca4b965613",
      "text": "kerabat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9932c766cab9ed0ce39ff2f9fdad8d13560f90f8e9c78b6a726c6e70c62ac0ad",
      "text": "Silat bukan hanya bela diri, tetapi juga seni dan adat.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b67440c15a439ec56da056f3f82120cffd1ddad604e41003dc58a6d1d30bd99",
      "text": "Terima kasih atas waktu dan petuahnya, Datuk.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c9e670e6eb560dd33c8acd8e4edb90ba8b9290bbfe1d22cc2ac07e757bec39c",
      "text": "Tatanan adat menjaga martabat keluarga.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a37aecf4995e9aef4efcdd7ea36224bc57c00c675db27f9ba2defc4675738204",
      "text": "Dan semuanya mau dikenang dengan baik.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a392b2e91f275bdca736b2cd5cd17b51fea98fb8db65d7a6ac401337fcdaffdd",
      "text": "Kami belum mencapai mufakat, jadi kita bermusyawarah lagi besok.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a40a07309153634bed4dd7654a0f67d1d1b6cd3b5e24357430ce955dc4a4b7f3",
      "text": "Randai biasanya dipentaskan pada malam hari di lapangan kampung.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a59f49f0043c1413dd03b9bce187169b491791fb803596fe38c3ac5e8e83a032",
      "text": "Neneknya yang mengasuh dia sejak kecil.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5b77fdb3ab582608bc8423b023709978b64ba485de4f94023dc2aad61dc2951",
      "text": "Nggak apa-apa, Uni. Tak ada gading yang tak retak.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a826483387c9b694e4693e4890259068782877f6f7eeed47ec8014e016d6dd4b",
      "text": "Pasti. Di Mesir kami punya pepatah yang mirip: \"Hai orang asing, jadilah orang yang sopan.\"",
      "voice": "id_ardi",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8b678b2e5ad1b9b475b8497de0854e77d713489af7052e9212b2ef571603cb4",
      "text": "beradab",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8e6fcc1b828965e5b8c91d8634e2dbb953fd6795b496e4d670044855c9ac8a6",
      "text": "Kayak kuttab di Mesir! Tapi gimana adat Minang bisa sejalan sama syarak?",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa67575d7c3ce578c365c534616376859bc6d918bbdaefc132e87e277000a97f",
      "text": "Di surau, anak-anak belajar agama dan juga adat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac35198aa7f46859e1f175749bb80ce54e7476119826e3e39c10753655b0fbe3",
      "text": "bungsu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "add03ae3b45cbb1bdac3729619cb39d9aa3276cd59fb9471ab6c99b77f3e38fb",
      "text": "Mamak bertanggung jawab membimbing anak-anak saudara perempuannya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "af62d9221cb29408990ea06cdeb332e3e8f1d5bef1c4051c294c53d4d4272000",
      "text": "Adik paling kecil dalam keluarga disebut anak ___.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0f62f6a67659be5f6e54a1ac70cc7237ca094f0ad1bffbad0ffec6fc79b2128",
      "text": "Resepsi itu mengikuti tatanan adat dan restu keluarga.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3d10b6730f4b4c6d89655f49c5fc13da735abdf0f35d5c8d0c13a4648b4f4b2",
      "text": "pun",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3df12661294b16e44b2e7167474593cf811a55a1080eba40f0cb05117798e71",
      "text": "Sebelum meninggal, kakek menulis wasiat.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4717ecc6dbe8f038c8d123a13fc4c164fa4f986975af90425c3ae37add0f0cb",
      "text": "Saat Lebaran, semua kerabat berkumpul di rumah nenek.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5931956fb7b407e763a10e9cc10cc7e7d62aa81ec6f59e5d9d467a7b484deaf",
      "text": "Suku saya sama dengan suku ibu saya.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5ba8b4aef021cafff6b85f59c7d644b1546c3f166e6edeb5c29b512fbf3c18f",
      "text": "Kemenakan Datuk Rajo itu dilantik menjadi penghulu yang baru.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b60f8b0aae8bcc530008e2c94541c98dc110df3dab540ad57729c2fbce15b784",
      "text": "waris",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c94657bc8b904831ad2b9889cbc5645fa94482662b000e55bbf4b5725ea0c0",
      "text": "pewaris",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8057d7b67738f1de835dac08537456feaed82048e48547a7e2d2e0842ae7f58",
      "text": "marga",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8cef306c8ba0ef58e02cfef7bc08cbd80d1eecaac4fd607993da1f189561074",
      "text": "Tanpa restu mamak, pertunangan tidak bisa dilanjutkan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba019ce701c6bccdcea2b622fa21622fc58bb7bcd955be04f131919ca714074d",
      "text": "Rumah gadang diwariskan dari ibu kepada anak perempuannya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba7ed2ca85afc78462900a0ae58a0e30aa6f6cf7df04112235c4e26d13df0505",
      "text": "Peternak itu dikenang oleh seluruh dusun.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bae89a9a89e07f77c4cde942dd2457016b77392d734cd5b00726e496c7e64e25",
      "text": "Betul. Sumatra punya banyak etnis, banyak tatanan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb1416daca0baae627729aff8be011d6209050cbfd31b6a42c3a6bb88d69d27f",
      "text": "Mohamed, malam ini ada randai di lapangan. Yuk, nonton!",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd32158796cb920eaf7863925e5ecd403d7bdffef637aba58dec560a7ab8361b",
      "text": "Mohamed, di Mesir, siapa yang paling dihormati di keluarga besar?",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdc7f9656e57a7b2fc90ceb6149185f7a30ca57d58c5ebc3ba75e86a7981c914",
      "text": "garis keturunan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "befc642cf2d5e6057d2d21eb9fb741c9713b8ebd0c430db9f40b7195233abc2f",
      "text": "Pesilat itu bergerak pelan, lalu tiba-tiba melompat.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf0bdaad707af3896ca44cca73a69bfebf96ea54fdf11226e6009cd46bd0e125",
      "text": "Iya. Aku mamaknya; aku ikut mengasuh dia dari kecil.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf3d4947b1c9cf89905bf94f238557a437b2d78e2b7fd8970aa8daee8467803f",
      "text": "Pantang pulang sebelum pamit kepada tuan rumah.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf78f62167da3807be4e52bcf0d8dfb461ef2dc4f511beae1f9c0d931806c7a9",
      "text": "Ramai banget. Pengantinnya anak bungsu, ya?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "bffb81ea60508442f059a812d52ef92f34817f5a8f4996eda5175fbcff855a59",
      "text": "pantang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3499f1469965e52d252a1534a4911f6abfeed020debf935b96878eee6815c09",
      "text": "martabat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c579192debb28bd69f47387d4838d90b33f14ec6fae77f83b96f22ba0ae7678f",
      "text": "Pak Amir dikenang sebagai peternak yang jujur.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63c9677a6b670a7e8e3b4203d8d0c987ddb4451019c1e2da8d853468978f60b",
      "text": "randai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9cdb20aa5b906bc75fbc5f21ffe1c56978acab34e1b2fe75b54d2241bdcaa74",
      "text": "Rumah gadang itu pusaka yang turun ke anak perempuan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca7a283ade21f706079f87a1e4bcc1688a55b69dcf6387e6be86d3d1a5a4525c",
      "text": "Seperti kata pepatah, lain lubuk lain ikannya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca9c7626a03ea35f3d49cf5a8883ecde5e3eb8de60ac4b0375bee5f79555c9f3",
      "text": "pusaka",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb98bb56900253e72f3fddea397bd345ffd84e013950ce047b0243567406ac5c",
      "text": "Seluruh dusun berkabung selama tiga hari.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd2f20a94ba50cccae28ee41d9b4dd3847b5953ed5bd4ddd7563c265f31be516",
      "text": "Para pesilat bergerak dalam lingkaran sambil menyanyikan dendang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd8a3e4f80bc3dff7689b88f2f3c5cd180dd4782a18fa58b1b55899dae45c6f7",
      "text": "sulung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce64e7f1ba18c7d03c6e5a2ea1392ea017b3b34245337a1519785620902ac658",
      "text": "tokoh adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf2040866ff56a5b7614b8c4f4afcace483c9460101dd0377dfb8a0f333e9c7d",
      "text": "gonjong",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0f872c3c44190e36bffe7f39bc5780717be1bc4173a49e88415d6aeffeb850c",
      "text": "segan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d373678bc8f45b226e779f53d18e9ddb1d59e9f8c87140200a317a77315aa6c4",
      "text": "Gonjongnya indah banget. Siapa pemiliknya, Uda?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d426502e6598a60aad19a3f13733f54e597091c2e0ad05c246bf539a82d839c1",
      "text": "Betul. Lain lubuk lain ikannya, tapi airnya sama-sama sungai.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59f0b51fa00e66f7c26c984e218ae0a907050fe552661fa315d77a607eaae05",
      "text": "Jadi mamak penting banget. Ada anggapan kalau ayah nggak penting.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d694e5e24bc4179e351bf1e4a3f2ebdb03466a6a0302ff2dd5bf9c0f4ae6af6e",
      "text": "Orang pintar pun bisa salah.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83bfa823a6bb9a40e6e69976f97f227ce58e6c8004864f51e2c221b3ef45448",
      "text": "Rumah gadang ini mempunyai enam gonjong dan dua rangkiang.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e0c8130561018d4d4b7b7af1088f62d6897d4835b42f8b05c2af52b798b25d",
      "text": "rangkiang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "dca994134c21c81b2d2dfeb6c9beea9cc4ffb033fb6351950dcbcc0d33bd0f33",
      "text": "Aku tahu satu, Uda. Di mana bumi dipijak, di situ langit dijunjung.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd58ef686b226d3be6a7a019c1e80d4aafe67d59b2dea4a863c2f9510464ea01",
      "text": "… di situ langit dijunjung. Makasih, Uda. Aku belajar banyak dari Uda.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd91059bd4fe671b5f926ec0a3d6fac7fa485208792b84a650a16b61797d6631",
      "text": "Mohon maaf, Datuk, mengapa atap rumah gadang berbentuk gonjong?",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "de2517e3e31b1289cb42a50ce5435c5119c8a5654c97d3a8668c49a715c293d0",
      "text": "bersendi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0202fc5100751fec2bf7a8db470fcf21230efae7bd151ea4227c2ebd931e666",
      "text": "Harta yang dia cari sendiri ikut aturan waris Islam. Harta pusaka tetap di garis ibu.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0906cd6d43a3b616480345ad0757cd929e9c3f213ff28d108e6b02d77685723",
      "text": "Mohon maaf, Datuk. Boleh saya bertanya tentang adat di kampung ini?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e16b4f94f8cdcefe60c3930cc36aa827ab4f31ea5b186e63acc005d2e44f53ff",
      "text": "gading",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2485fba5a9ac18e35c9c6fc2ccae3b098f2f5141a9663cd7320bd3931ae0490",
      "text": "suku",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e24cd226e829cad0b756bc223e71cfc2aaa741133f5846091c33fb66231af541",
      "text": "Seru banget! Di Mesir kami punya tahtib, tarian pakai tongkat.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4628d0e67277c8cd4e4efcee635b83b77aca3ee285385ce4477f019ea1da860",
      "text": "Ibu dan adik perempuanku. Kata orang Minang, aku cuma tamu di sini.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e542700dafe44a24ef4aab853265da72addaee1eab5abe5978c6a82f55b2e4ef",
      "text": "Bagi orang Minang, makan sambil berdiri itu ___.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6b181c206c5ffff9c29b34775e8d88a6573a8822b874b2c69a186552f4e7751",
      "text": "Tanah pusaka itu milik keluarga ibu.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7ede885ca642818cab5b4b4863e844fb7a22f976cb8ee35e0eb3d1c246b2cb7",
      "text": "restu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e90b04fe6fca39c632703e33ebf176148f16d4198d3d113e797a3d404fe11d78",
      "text": "tatanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea7bdd442575a4943d356682b64686dc8b69d3b9d6965a6649ef09dcb7c48856",
      "text": "dusun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc69df20eae21b9fe9250b8a0ce2007efd2f5f06d1706907d991fa29b9ba91b",
      "text": "Anak bungsu itu masih lajang.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee3abb8ee6d00ead60bec0e508dd1ec189313e92212fd1da0297de8f4c4f9d92",
      "text": "Menarik banget. Ternyata ada banyak cara buat menjaga keluarga.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef72807b36c189c7d25d31dfdd8d21daaa38b99037ca5095c84317dd3e1cef59",
      "text": "Dia anak sulung, jadi dia yang menikah lebih dulu.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04254dab5890a9f7e3185e3afb21fdc0f39e589d0dec476c327d33d9e0feebd",
      "text": "peribahasa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0caf49b8480f7dcdf6687153e47555150b8e06bba60e6177b727eb40b215f6f",
      "text": "Dulu aku tidur di surau ini. Kami belajar mengaji, silat, dan adat.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "f66f85bf61ec38f4b0f134196b1bee1967cd9e52c7d322beaf6d3e6db5a028cd",
      "text": "Resepsi itu mengikuti tatanan adat yang lama.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6ff57fea5e7a2b864ff649dc240d2cbfbf334a527ad580aca71dd9e77a4d3c6",
      "text": "pamit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbf07740ad0545881a29269c7e571a2d64142600118eb1f0ec1f8c0f13e5f77a",
      "text": "Kalau orang Minang meninggal, siapa ahli warisnya?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe192d10e3c0e24a8246aac28c7f328a1879dda63b36a8fba973fa1a2b6c9ec4",
      "text": "Iya. Dia orang beradab, tapi agak segan ketemu keluarga kami.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe3fd879b0dbc464b00f7d5f131b11bd4837524fea0cb93849674d89f73062e3",
      "text": "Jadi adat dan syarak menjaga satu sama lain.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe9b34dd201fec2ba70d378a0dff22178bd36659caea48ccc2a773a7d749b3d1",
      "text": "serupa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    }
  ],
