{
  "format": 1,
  "id": "id/bipa1.u08",
  "language": "id",
  "unit": "bipa1.u08",
  "version": 8,
  "content_hash": "52f0e3a3c0998c2d87995886a80181106bf246344486806328de20aaeace4347",
  "lessons": [
    {
      "id": "bipa1.u08.l01",
      "sha256": "17b007b2c7073907903386a9b2736bb7f8cbe59016a798e15379ac7b4ed21279"
    },
    {
      "id": "bipa1.u08.l02",
      "sha256": "97eb79f8d0caefb6afa5e2d6f34cfda43fb510c444a4e710755c541469c821c0"
    },
    {
      "id": "bipa1.u08.l03",
      "sha256": "d679a812aca3835f4587b155e7e799fce0a715cb8be158292e70878ca911e8d4"
    },
    {
      "id": "bipa1.u08.l04",
      "sha256": "a223b916816a42896311a13bff2eef1d48fceee7e0b0ce7374da431f9e7b901b"
    },
    {
      "id": "bipa1.u08.l05",
      "sha256": "9f4a9bb8b5279739567de0c66397aa84a043ea43afc1a50d811706844cefec43"
    },
    {
      "id": "bipa1.u08.l06",
      "sha256": "7b033028ea174aa139583a65e4f81594e3735d908b2008f629a61c9aaa8c6331"
    },
    {
      "id": "bipa1.u08.l07",
      "sha256": "fe9018b84faaef13b39fc2b501f30634aa3daf97b34c8a13774e7defbef3d984"
    },
    {
      "id": "bipa1.u08.l08",
      "sha256": "033bb75797d575dbde92584691976dc6598a12cd35adc407e5681b1ef10cdc48"
    },
    {
      "id": "bipa1.u08.l09",
      "sha256": "933fea46c29d0138454f8bdbf2fbee50fde612fe6ce05fa84da110c71d8e4eb5"
    }
  ],
  "audio": [
    {
      "key": "0107278fb2685418a8ae31c90c9675c9e5cba3adfdd0bb9b8d602c53fac0cf24",
      "text": "salah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0283834cbdfe0dbe706d643e7553bd7af1a8c6c96e5198b04942d3663a1ca184",
      "text": "Bukan, Bu. Dia bukan mahasiswa. Dia sudah bekerja.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0701ff9c4927c6046f3ce9615d2c231f0a24176896f6e10536983e2fcf67aaf7",
      "text": "Bayinya gemuk dan lucu.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "0741c058bdf73b415544d51496e78263427ce34a44ee22aef1934e5dfc7b417d",
      "text": "Saya mau yang itu. Terima kasih, Bu!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0750b248b327a3dd1668710672d208f09d8e3cb3d4c4191dfed5e7994b7b78d7",
      "text": "Dan sekarang semua tertawa. Filmnya bagus!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "091b8013f1a74a0445d9c9c3585a18d0da8754fd26d3a9c0b7a547d862cec77e",
      "text": "Mohamed, ini foto teman baru saya, Bima.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a9cca978b499963501dcdfcd13a5e39a567aacb549d37a44ced33747f3ce3f7",
      "text": "Dan ini bayi siapa? Gemuk dan lucu!",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ae05c391ac7a1f78b0f000015b6be3b20dfd5caabe32d052b79ffdb4e90f5d3",
      "text": "Yang kecil, Bu.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bd890866be9519c9d579ba4895409dae048919e992665929c3c3d516e9735e8",
      "text": "lampion",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c7bee60629c58e08a6bcb79b0d378304d14619b03df099c7173f20b3f6c96df",
      "text": "nggak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ce3d3b6b201182674b7dd30a228a9001e4ad2a5d1655f431508571c7b04836b",
      "text": "Ni Luh cantik. Rambutnya panjang.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cef36ea42963a70811d17e8e4dad1c88b9bd394e362d87403f0af60009cc2c0",
      "text": "Bukan, Pak. Saya bukan orang Malaysia, tapi orang Mesir.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eb8a5cc411b5f3e826f83a175deb4c3fbd207cef9e1fdd50ed271d4ef4eec68",
      "text": "Oh, dari Mesir! Teh ini tidak mahal, Mas.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1132c8ebdf2d2b476365096608e3d42789b1b5297daf624f1f829089f1849174",
      "text": "aneh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "13e500fa0566b4666c6e224ee9839fed92cc1769d79e4db40d4e51145a5e1830",
      "text": "gemuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "17813e23d261ad90e45f2ee9e3b72570da35e3a4000a41582f15c59145c00e02",
      "text": "Tapi ibunya lembut. Sekarang dia tersenyum!",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9a2fd59690de0f3b927425c2f0dcfd6f72900c0b54375a191c550b5eaf5957",
      "text": "Ya, dia guru. Dia yang pakai kacamata.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f4a6c63c4d2dff28500e6885f5b866eb968a3b8606208a6959e84368037b4ac",
      "text": "Dia bukan guru, dia dokter.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2203e79ce65ea7fd3c32e0c318ded4e7077aded810c7567ea7dda78032c1043e",
      "text": "Tebak, siapa dia? Dia tinggi, rambutnya pendek, dan orangnya lucu.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "23539138919375a149537ca98d337f2d5e4003a8bf66f83f7d6c8ced6b50acbb",
      "text": "Mas orang Malaysia, bukan?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "23f88e4a37ec873cd2c57f3f29288928c274be0b31e7e47a1567ab48d2f96f43",
      "text": "Saya haus. Minta air putih, ya!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "246140c3cd13dd34b4110acfe41b7a8e6149de52ccd5f4276d47040e9c897e7a",
      "text": "Dan anak kurus itu? Dia pendiam.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "24a3111ec0ac113989e2e7a8d002fb18b2eaf70d2c093864d6b196ea661d99ee",
      "text": "Dia agak malas.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "25576508020fefe4870f8bb22af326f3ff4b0822387560d1d5acdc10add8e9de",
      "text": "merah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2767e7df9a6d94c416dfd930bb2a6bb84b28b74d933e6959c2290da963abeb45",
      "text": "Rambutnya panjang.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "28fce6912fe533da22226ea4e54d152e130fbf621069b17aa687d9f822eb86f1",
      "text": "Bukan aneh, dia lucu! Dia tidak jahat.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "297f0c91911dec1b3663d17877e5cfb3d8f45fd9cff51e44e56a87100732c0c3",
      "text": "ramah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "29a840a9e1d0eeb16fe8771cd023d305d04ef6b155de727d9536806b3ce846d9",
      "text": "Mohamed, temanmu yang mana?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b636d9fd2fdba3713f810da1106638656b8f953a692871825cef2714fd0148f",
      "text": "Mohamed, kamu bosan?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e4d63c494d861c784b0eea7d2561614ec1378f69c1e77f00b2cbd3a30184735",
      "text": "pintar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "31c3e1c656cc957fcda9781b32bb801a55937a4c3560a44d7a44780dc690baad",
      "text": "menangis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "32a55d5f797e10d385f9dbc80d9e36c50910a5bcad8545ebd649747cab05e7f6",
      "text": "bukan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "34d331cd805c95396bfdfa36e2c5e50c64f2820edc328f81c4f90a7b33e2fd68",
      "text": "Teman saya yang dari Bandung sangat ramah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3627d7fbe12bb5953e050d1ef3df39ad6ae10f5a830ee939d222c56fca5f73d2",
      "text": "Saya ___ makan daging.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a244b10941e6bfef18148ce800d9981b367f5b29bbb2c7af27dfdc49791bb26",
      "text": "Dia bukan orang Malaysia.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c03b2701efdf963e2d993b44a2bb92c04f36dd38cfa46f50e5dd63421802e30",
      "text": "jujur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e5197f2e4945fd50956ccec9c24e45e39bb586abf660e3f4b75a92d1f1b4d60",
      "text": "muda",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f05d9047f8aee735a836e08338d697766f675ce0853e8ee7e99c57d3829c2b8",
      "text": "cerdas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4200d45c707e9a82dcd7222fac7dfcf788cfd58617ea56a56a46d1584d89a211",
      "text": "Tidak. Tapi saya haus! Ada air?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "43815f6e1abb929707c65d78631567e92f27709b1f0842b255d15850310f4501",
      "text": "bosan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "43e9e0f7dace44f4f2af78e7f082722ea5aae9de6c359e0d7163f644399775e0",
      "text": "Mau lampion, Mbak?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "49c1978635f6ddf8db60a0b2ec39e338122269a9a4218534dbf6d07fb728c1b1",
      "text": "putih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc377b4cb920fa7a7a54a538df5197e703168eaf1a287fccd0193452d24b614",
      "text": "Saya nggak tahu.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dfc5694a49a502f2fa04622df1abced0f778102fc69bcf6b2581e0b8a1af0f4",
      "text": "Bukan kopi, tapi teh.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e652416ffcf1eac36f760de47269ef3b3b1d85274a35b128f14c21c5e11fcb1",
      "text": "sedih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fc99578da6f8eebe4ea343ec2366b19c0ff71053f3db4be421c3453b95b1e42",
      "text": "tersenyum",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "513f7c82e1d1627eba4b6a16e50a7cb79e54ad3365a59849535d0172acc95f07",
      "text": "Kakak saya ganteng, dan istrinya cantik.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "51410eb7cbeae978279eb772f3300950bbb2d535046dd78b9c4f950657972b75",
      "text": "Saya tahu, itu bukan daging.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "516c014ee4d110598e9852c252b0dda925acbde3b723c4ce96e0e95f563f7a0b",
      "text": "kurus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "52840765c61e8e0168d5c9eea1953008a05afef84ae48fda8e2a0b774e57c41b",
      "text": "daging",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "53cbe459b918cf93762db664f6a3c887b03a97f93e0e2222b8b82fe61a61dbf2",
      "text": "Dia sedih. Ayahnya marah.",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "53ef8bd28257c905b6fb7a2a0a47a3d6bd0d7071b7f937ecef19986ee95abab7",
      "text": "Itu adik Bima. Telinganya kecil sekali!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5477948c3e9b14d15b935387c1a861970eccb62678dfafbd981238a62b65b9df",
      "text": "Raka, adikmu tinggi?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "56299391effebce83c782e2155a0c1fa4c0e88cd93de73515f11d0414c5060c1",
      "text": "Ni Luh yang rambutnya panjang? — Betul!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "59d859c45f6cfdcf5d97893be3916959080496e5ff8dc15d650e970136b9bcf2",
      "text": "Orangnya bagaimana?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a1744eb4719dae924e6bb8601af8ec6eacaf5a6670ebd81c586b4d44b1c8ddb",
      "text": "Ya, Bu. Yang merah berapa?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a22bdf197fe07325c1351e57ed8bd32fa131737c6241917f97d5f5a6a025b18",
      "text": "Rina, siapa guru baru itu?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a48b860b5b990a79b8547500b27e251a9bf614b7b0f8d24860e2b93af0c4a10",
      "text": "mata",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5afb04ff96a90aec476a6594126692647d8e368d01fe60f8c110b40d23e17639",
      "text": "Fotonya tidak jelek!",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dd49ccbe2987c3d5ec56352be2346153c752bb198c5cf1b7d73eed8b50d86d7",
      "text": "Orangnya bagaimana?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "60cd93147fa3885491c61e62493de5c9983057c388e6e1b2e03f0ae98fedbbaf",
      "text": "Rina makan sedikit. Dia ___.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "611a86ad90f0820281920ae4c6ab1d258ba114390a90214355f0a31eb23224bf",
      "text": "Ibu saya orangnya lembut dan selalu tersenyum.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "63e4b619fe26456cf36eaef1cddcfde017db953ee3f684ab6eaeec35969440e9",
      "text": "hidung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "67fb47a996dc66a0f733d14ae71060345d562fcda893b364b5db6917962e8aa3",
      "text": "Dia ramah sekali dan lucu. Dia juga pintar!",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "68d019f9197df223e072f230392b6611987238a2dc724773e3a63a02f77ac8e4",
      "text": "Dia ramah.",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c4e3eeccc2eb19c20226ce22bdff0e8f1ae9c7a7579f88f0271faa49a7736b3",
      "text": "Saya mau yang putih, bukan yang merah.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ca4742548d5dcb65e95967d0c763924a47f303b159997380d40f2cb55254fc4",
      "text": "Tebak! Dia guru. Orangnya sabar, dan dia pakai kacamata. Siapa dia?",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fdac6cbe446ad0d1b558149b38638b64fd1baf9b1f47a3ff10f11d9cfc7ffd2",
      "text": "Itu Dodi. Dia pemalu, tapi jujur.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "770bf00f7b11150f1a9fc62379d998fcf889a24d1f88803f6502a7805cde9159",
      "text": "Dia cerdas dan jujur.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bfcca17694a73968f01491957d881332feb74fa0ec7857ebe1b1ad444f9b4bb",
      "text": "Gadis Bali itu pakai bunga di telinga.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "81ce4de18f0752e96b24a60d6d047602fd5f970033a26ea2f0c4b407e2cd762d",
      "text": "Orangnya ramah.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "81d9a43a6f7a1fa0b5c4e14624d49ae727b23a9c11a0f2d96808592e763fdf32",
      "text": "malas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "827ee43c9f32cdd94f005a163bd1566a48e5acc8034f44848706133966d9ae19",
      "text": "Pria itu tampan dan agak gemuk.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "829f48c02219ee2d6a23e20b4bb27622d35579cd4b047d2c7f128093daa7538b",
      "text": "tebak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8308c28469d09194bf488cd8fbb72389cdd38be16eccf3f1cb5629bb0878516e",
      "text": "Pak Irwan sabar sekali.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "833250b56fcbec458fe61fe3abf4bc51c0bd407bc63462f1251b55363a503b35",
      "text": "Saya sedih, tapi saya tersenyum.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "83827b3b49fc10a57d765c14afc323ff2ba4001cd5294a895d47d9994cee51d7",
      "text": "Sifatnya bagaimana? — Orangnya sabar dan pintar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "83ce8b0d1dc438865fbdfb68a28932c55e23bad500eb5aa930c8d5e72bb123a6",
      "text": "Wajahnya ramah! Dia tampan.",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "84253c87faf5c1d84353d1ee05bed1fc1ba6fd0bf0568bd153224500a8b9b56f",
      "text": "Bayi itu menangis. Dia lapar.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8528a638c4b90064378257c90ea4b564a1c64ae7f95f737444793ca9c9203218",
      "text": "Ya, rambutnya agak panjang.",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a9939cd30c3b270285d4c70400f1c7fb7a1370b7b2b8f9fc1417dc4da63d8da",
      "text": "Silakan, Mas. Mau minum apa?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b9c2fcdf05ad30535640f17c63e939745ea772011dac8ce7542a6392835f96e",
      "text": "Rina, siapa itu?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ca1a2785b4534cb68fa6d6f055ec56c52794c4744f6b88c749c73a25d6440ee",
      "text": "Rina tersenyum, Raka tertawa.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d8a4050e435e47f7243a51e65cb011739bd188bad7eaf0a31c6e37c81b2e403",
      "text": "Anak itu nakal, tapi lucu.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ea4b94178ad6565426b9ed4ee7162fcafea53dd5ac7b1cc681f300d94eb3df3",
      "text": "Teh, Pak. Hari ini saya tidak mau kopi.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f28645bf35bf767442483fb5e45390f6406f0eeee93805e7151ad8f19925a4f",
      "text": "ganteng",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "907454bcc3939b36c5e7fa45ed51255cc9176fe74319d43ab343a594037a0be3",
      "text": "Rambutnya panjang?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "922a82063ceb2f2552f6aecfdb97481f4c60bd5d05a978804ac2ddd5b125481f",
      "text": "jelek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "926a70f10c4175970392c5c4d95f9c224c8c7b02e09f5593066b7296cc2c2bd6",
      "text": "Dia guru?",
      "voice": "id_ardi",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "93e632a000f6b9248ac7c93f9556689b97dfa14ffb09dc6564ca42bee55c1770",
      "text": "Saya mau lampion yang putih.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "95b7167651f1627999b177f3e821a1d0a170ffcb644284ec0a679593a6e48846",
      "text": "marah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9664f85339c6253f2cc10b507d181bc07bbafbd0b5e0e7988f3ca35ad91b3177",
      "text": "Salah, dia bukan Raka.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "96afa32772f63aaefebeac88a9e63c7d36a09e61f50273a5bf8f18838576eadc",
      "text": "Itu Bu Sinta. Dia masih muda, tapi cerdas sekali.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "977d4f653108f43a218b1f03adf4dafed41d6f93c109be619ad4f35e137d16fe",
      "text": "pakai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "97aaf049b45690d7e1317fd735a6e4ef72db436c05a36ae7419a73872a013ecf",
      "text": "nyaman",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "988ac0ceaf4730e0d982744d3467d3052c6defd65cae063162b3ad037d20ed99",
      "text": "Dia mahasiswa, bukan?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a1c8abe70578ea1d979800f8d7314e365e1b4457846a3f7208bf082ea866b09",
      "text": "leher",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b160a19da3196a0d8ee93131e06b2f1dfee41701c32dbcd5bd0588f3ad4349c",
      "text": "Ini halal, bukan?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cdb2251c04e9333605b5011e1ca5527a2e79fb5c54005403f7cc5e331789d19",
      "text": "Ya! Matanya besar, rambutnya pendek.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d29247fabec8dfba0bba6fdf8450b8030beede6463df8d26543ded6c3cb2db9",
      "text": "Teman saya yang pakai kacamata.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ddd0e36010c76d0f8b7523e520ce8a4274c9f94237143c03b05424edbabb243",
      "text": "Dia yang pakai kacamata.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1ac6d7eede890ad0cb6742e23f3d9de1f195383fda7392484f97a014a3f3154",
      "text": "Rambutnya agak pendek.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8181312dc55c4e5a5dc5c68957347ad61efdebce7fd159ffaf0de75ce4708bc",
      "text": "Ada. Gadis di film itu menangis.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "a92a63d43fa491eccb4b22d2efee86d0ddc168d0d7a7ed2e87e6ce10e343a776",
      "text": "lembut",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a965a520dfc0fda80f532250472cf0c65e642d6d2464eed19733c7633a77a8e3",
      "text": "Kamu tahu rumah Rina?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9ca1fee5352eeb5a97e81f9f9341bf90326d06b04af9b6f612ea17a05dcb3ce",
      "text": "wajah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa479cca6e33af489c8129a5c43f8a70bd77d940fce05534af9b70f5b9e717eb",
      "text": "pendek",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "abe56555f21910df47c2c435895951d1f25aa683317dc5c7e5949647c798eb2d",
      "text": "Raka agak tinggi dan ganteng.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac40d8c67d35932759db96cf5218a1e375a5ead50f5b6e859b35a15a635bdc3c",
      "text": "Rumahnya tidak besar.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "adf2178cff841d97d149ed33973af850eba7c0acdef7b3395b1918965b78aa3d",
      "text": "Tidak, dia agak pendek. Tapi dia ganteng!",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "af903438de31dd9521b092a8012e5b9ccfd1b46a7d46f3e7f2391e1314bc2774",
      "text": "Saya haus. Minta air putih!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1a9cedba5f4dd803c61f1306ec910b82221f01538e2fea56b551d25f7a3800a",
      "text": "haus",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2a6d927e0632acdeeb12a8f22e938ad2d87e109502ffa4ea01a284c2b98a811",
      "text": "Dia orangnya jujur dan cerdas.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b71c9167f4a2d5b35c704a23005f17e0a7942cb54ad92f5264bfac032b786e58",
      "text": "Mohamed, coba tebak. Siapa dia? Orangnya sabar dan pintar.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b75ae79f07ca0c2a45fea5b45712b3419d4deb6c97f0fc69366da229682a7db7",
      "text": "Dia bukan Raka. Dia yang pakai kacamata.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9baaa4d3366210d8103b3ca4514951e4bdd8f17a5e7caa6e94e6701f0a7c360",
      "text": "cantik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2bb01e906bcae93a52239afdfde4005bc71038e1cd6d12867edbbf314bad86",
      "text": "Saya tidak suka kopi.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bac6ce13e5f77907133a2009335c1848c740a151c1292570517983edf035fc62",
      "text": "Oh, Pak Irwan!",
      "voice": "id_ardi",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbb2c6b27ce2f6b27d8156a7dc430895e4817de6d9727b3a3e08a97f06dc3c57",
      "text": "Rina tidak suka filmnya. Dia ___.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd2ac01dc4284a078490bbe84af5ef68d48147fe59fc80cc1ec7130330e66c22",
      "text": "Yang kecil dua puluh ribu.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "be1960e6095d814ce0f72fc3a80d5d123bf81d4dd22b942b42e8c48224049bd0",
      "text": "Hmm… Raka, bukan?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf40b03507956226fb6295539db1e61757196f0b4cd0da50998ae61ac0f7e99a",
      "text": "Lucu banget!",
      "voice": "id_ardi",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf4fe26e7ba3baba318ac4bbf260053e46852a8532bd1754228db074841751e3",
      "text": "telinga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c227978a3a0afd56d99b68350ab73f37dac2e808c55bfd5838165969ebc66fd2",
      "text": "Dan anak itu? Dia agak aneh.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c53f3e2070d9ffea867cdaef5a7a2ec0432fc9380409352d5052fb8507636e13",
      "text": "Saya mau yang merah.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "c66b71c69e15b405f6a9efd41f38befe981ee9b385e3fceb3093abd1db0cb9d1",
      "text": "Teman saya yang dari Bali cantik, ramah, dan pintar.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c80674fd63537d1b9639b2f75254444b41fcb0eae5f9871c1070d0acbf77bc5b",
      "text": "Itu Ni Luh, teman saya dari Bali.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8e34ffe522f8f9cad5218addce84e462a1fbf9382b60f5e91627422c991eec6",
      "text": "panjang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca25b9555a105b57b5534d590084b6065a7b7311f210c976aaf4834372012514",
      "text": "Itu ___ teh, tapi kopi.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc0dc6d2c8f051c71ac15ba22c089b3b2d0b4ed47beaadff74ce43d6316a6731",
      "text": "rambut",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca6750d47ddab2debfcd932bf767bc77ddf0d231886198776aab2d3d484f849",
      "text": "Rumah ini bukan rumah saya, tapi nyaman.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdb837ee6ff92a82ce1d07b617c9bfe431df7b3ef639707e4e3ee3b29ae14335",
      "text": "sifat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf48845f398417eec353378cd3a929c893ffa7f50ef5d6dcbadc64e261675611",
      "text": "agak",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf8ba418d4b1cfb08e088af43f6dbd338cb9126bbf653e6962cc516ab4e80516",
      "text": "Matanya besar dan rambutnya panjang.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfc46a03382de57e62e934fa07d5e845797328418fad0103fc6adb6fe3598544",
      "text": "Yang mana? Ada yang besar, ada yang kecil.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0c0168e8814770d6b636c5cf50381d77d8e0a6825ba2ae54a0a91243be39e8b",
      "text": "tampan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0e6a7e9a2ea36b934cc45333e6ef61cc54a58e2b49e1b8cc90ee0dd610ea987",
      "text": "tertawa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20427a3e5603de586ee37d360b5a43f8f2873f5e747a098469af72c66f77c83",
      "text": "jahat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3a6611dffd5cb24236bcdf1f1433f5de1589e399584e223a723b4ac9e8f8e57",
      "text": "Raka yang mana? — Yang pakai kacamata.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5fc2d059e98dde9402e138c0ef0a45bca83623e83b51384a9c0614e91ab1450",
      "text": "Raka tinggi dan ganteng.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7893b862dbc084f7586720a5a2a9cb9a7c2c9b705d42fa97061c72c1a975a93",
      "text": "pendiam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7e75986308e352bc3cf29739df35043a76f734a7d6ecc0929f54cb702bb2413",
      "text": "Rina rajin. Raka agak malas!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcad959b07929bea496b951710f2715d23e554bc4b105b476520d00019103644",
      "text": "Wajahnya cantik: matanya besar dan hidungnya kecil.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfcd586f59ae828f1e9d1fa40a4caff1c46a7282d128a71c8fdfcf997aac746e",
      "text": "Di film itu, ada orang jahat.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e36c95654887f32fb553b13bee1fa8c3d4b65877a4d89ef7a184808ce3138ab4",
      "text": "Sifat adik saya: pintar, tapi malas.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebc5a6289e730b28d780311de39ac563b4a1c7739515aa3d20b280a0244de320",
      "text": "nakal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec19dd81c029eeed0cfe0075e2cb55971c5aa2eb6353a3b52761469e0437c444",
      "text": "Yang tinggi itu, Bu. Namanya Raka.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed3d535add9a15d19a3e8a1ad3d6181f693d59429a211c4f450d7423aad7195b",
      "text": "Guru saya masih muda.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee0433ac56277a7d3a1137d166ad4fc80787b3c26af3ed6a836ddf589acf5693",
      "text": "Teman saya pintar dan lucu.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef28d7c89bc128567b841df4b23561c8e1799ad271a38f703511c9fab5423fef",
      "text": "Bukan! Raka lucu, tapi dia tidak sabar.",
