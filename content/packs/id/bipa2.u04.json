    },
    {
      "id": "bipa2.u04.l06",
      "sha256": "43c5ec0627cb339f146a3af3deaf1a9e386ab45e8284ada8fe4f21567edb8fcd"
    },
    {
      "id": "bipa2.u04.l07",
      "sha256": "350c6d84d3d3039d86751b7eff6de442f56c33bddf20400ab879f8338d2b83e2"
    },
    {
      "id": "bipa2.u04.l08",
      "sha256": "8510410117622805ebe30ed04d8bed39563266696b5d7b95aff26513ffc20031"
    },
    {
      "id": "bipa2.u04.l09",
      "sha256": "c86fd055094755b6abe8983f2ae08d656fe6b37ff1c9d143f763d9864f0e7ec7"
    },
    {
      "id": "bipa2.u04.l10",
      "sha256": "0e725a1f6b5f8584c1fb81952d7bab88af6017737ff36f199511805dd378d50a"
    },
    {
      "id": "bipa2.u04.l11",
      "sha256": "822094a7ccf80aea5e08fba36a141d3f35c32dc18cc919224508b5991a183f88"
    },
    {
      "id": "bipa2.u04.l12",
      "sha256": "0324e22038bc39037dbe1f566ad001d58dbf38cb172d9ded18d5ba9d742f6155"
    }
  ],
  "audio": [
    {
      "key": "0033296120d88e29b3a313363339fe358d082327faa77527537d4f2d7d3cdfbc",
      "text": "pegang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "01cfbc3fee0aa42cbc2e86a598ebab08b606afac05a4877f2a918acf0f42e0bc",
      "text": "Aduh, saya rugi. Tiga ratus, harga pas.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "07004ace62a32bce7a2c33d869d1fb0f55b97c70f2e3e8ace7a058124c532453",
      "text": "buah",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0792905f2c14aed60b27614d329784928af72a918129e1f0ccc1a964c6fdee80",
      "text": "Mau yang biru atau yang merah?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "07c737af49355687cddbeabde59c8407c8b9bf8094c2671a853510e40e131619",
      "text": "Ayo kita langsung ke Sukawati! Jangan lupa bawa payung, ya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "07dff4f4444eac05539b971c4941aaabca378f57f36c4f8ce2ec055b6e229477",
      "text": "Anggur di Indonesia mahal.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "090ee2d30f07a52713b0f524e1f9f1932da5b6cfa8dade64a7a0cba9aef47ce0",
      "text": "gelap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "09158a68df60442e6b28b625233312459212e247ce4ae6c0e0caf78ec142ee89",
      "text": "Saya beli selusin pensil.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b02cab88b1a527480ed96f65dc952a3122fb205d8f3a7dfe226308154f3bb8a",
      "text": "apel",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b4d1c6ab5275d913e1b038d4453c702111a290b66ba040eb9e28e28441d0199",
      "text": "Jeruknya dua kilo, dan sayurnya tiga ikat, Bu.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e6bf4694179c87c086a0e013d827823c4e7185b019c417341540005b4ebce68",
      "text": "Minta segelas teh manis, Mbak.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eb015330b171ac543eea677574eecb7999df6b662630fad031fd797461af238",
      "text": "Saya lupa payung saya.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "101596d28dd9ebb64e8ae2119527f3ef4e8de6a3fbf98af49f69bcdff0579b66",
      "text": "liter",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "11831ae3a4075408f4b2141a60e3852d771fc37a1f0c0102d8fb4d7e67bd4138",
      "text": "ungu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "11a63858bd9deb84317a5d557ed935c169a860bc7461b9ec584167f21bd3d6e1",
      "text": "Saya beli sebuah patung dan sepotong kue.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "153278cc3cd65dc4aab839ff45684f57525d701735254a83064976a320b43dcb",
      "text": "Mohamed, ayo kita ke Pasar Seni Sukawati!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "17a01c72490d10dc4cd3f207cc147dfaad9729e65f5c993f19fa7dfb9abd869a",
      "text": "Baik, Bu. Ada lagi?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "17d5e1b9457b3e5edd590c813e975d0be35fd5fc1effb94e6ed011c9d2d1a9fc",
      "text": "Dua ratus ribu, Pak.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "181a3152aeac634aac260fca249bdff798588b8d08529cf6219ff9d7a3fbc1ca",
      "text": "Boleh, tiga puluh lima ribu. Mau pisang juga?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "184489e5755f746a1225926ad7e687e18e2717cc7c5c23dd966ecc85469272dc",
      "text": "merah muda",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "19d86e62f5acf727de1f1aad8d985c104076fcebe46e560e09f3f50960e15040",
      "text": "Ungu tidak ada. Ada merah muda, hijau, dan oranye.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "19fddee82b3b7bc3d2c15775f10b0a14bc846987b6031638bb3d76ccdfc84bd1",
      "text": "Nanti dulu, Raka. Saya masih belajar.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b1032a5e6abf2475ea96ecdb5249a1179fc9da3ad95cf2d6e6e1c3dbdf224b7",
      "text": "Harganya juga sama?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f8633d7b3b557680ac8ff97b03579bd8c54bca66f6532ad8c83dc2011acb47e",
      "text": "patung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "206d23c86ce9221b5636150f49223d845c78d263a15c55fc26d4e98d420ecde4",
      "text": "Ini kembaliannya, lima ribu. Terima kasih!",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "20d5aa9d0f713d2be6aa5d52eb238be96d0198f4815c6e2d0772a78f33ce4b6c",
      "text": "Ukurannya sama, warnanya sama, dan dua-duanya semahal ini. Sama saja!",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "239ddd5107be73d6d3b87a44db75de007c2ba83554c5b63382fe043449bd4416",
      "text": "harga pas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "241f4354e5f2d2a41809c0ec761ad096f3ef437f63962845604ec87235d58a12",
      "text": "semahal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "242a3396c93c163ef6308f4a1487d44bd8cc42b38a7427cc291fa1108f8b89de",
      "text": "Jangan langsung beli. Menawar dulu, ya!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "266d28a59e1c008849ef25daace2406d35fefab3dd24f8b3ad5606eea56a2c80",
      "text": "Ada diskon hari ini. Bayar di kasir, ya!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "26b984b90f1d90fd98f85b98cc39d76b83ad086b18c4aa5363c5acc0a31c3e31",
      "text": "Saya minta dua ons daging, ya.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2732cb09b24c904ac772fdcb3f83a4cf6d36c639a83f88ab524e7912d759d8ae",
      "text": "Ayo kita ke pasar!",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "295ccbab98b646053024aaab15d43c381fd4ec353fb868fde91ccbaa9e94b407",
      "text": "lupa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2967848e5aafc460adc018c46663cf49877355bd74e04513e79e522c4580f5ff",
      "text": "Mari, Mas! Buahnya manis-manis!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "296c444332f4e1d6238921a69ae764462cfaf735ed65e96403e2ee5aa5ef7a77",
      "text": "cokelat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "29b515126ea29935b711f3dd5d6d30a6e092f8827de6d40cbce4c112d24e300e",
      "text": "Ada yang ungu?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d7ee3a6223f2bf0f8fa0ebf129761725cac79575417532627334ed9969a305d",
      "text": "Mari kita mulai.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f1ed108790045b29561924767fa81e8194abb795bb8bd2f2d4957dad4f80391",
      "text": "Aduh, saya rugi! Ya sudah, boleh. Jangan lupa datang lagi, ya!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "308d4b6aede3864e5bb90f3f1406b742d216c6b18e299c9d6639c9be56219e8d",
      "text": "Jangan lupa menawar, ya. Jangan langsung bayar!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "312818e6ef2dd50b6e05e70620332928b4647528c8527f7e88c526b882c2e9c5",
      "text": "kentang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "357eb14f570663b26e0146ea7ff0b6129d5966ea4b5ce3ca8d13cb21fb6b90c8",
      "text": "Ayo, sebentar saja!",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "361e056e69ddf25a171068ad9035ce56c196190d03361640f2a4fc28406f2e99",
      "text": "Ini kembaliannya, dua puluh ribu.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c3d65c2bf471a5786f863efc9833fa72dfb4e102425985eeba6f8ffba2b58d",
      "text": "terong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "373388f665dd81138261c3f53ce870876026956554b70a37ca9a50ba128f893b",
      "text": "Pisang ini enak sekali!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a057297735096b149466c77b3743bc9874543d74fa34af388bf36217058346a",
      "text": "Dia ___ guru.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6b194dcd8ca23b9f13b64f86619b2da5bb8566a4d9321b9ba4667909a38cd4",
      "text": "payung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c302e1b649e3a0b79dd36b0b549a4017c46aca1ec1d9f2cbb09bc97b3d29478",
      "text": "rugi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dabd179199fdab02c41b466f207bf6cb700fd66c8947150919cdade67bbf927",
      "text": "mangga",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e52daeaa6ac29726955999768230badbf9290b0ce8135fbabb17c8968e5dc4b",
      "text": "gram",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "40185e1824f076670a2dbd8d16e45a754791189d393b9590a353d6eb44992d5b",
      "text": "Mohamed, kamu beli apa di Ubud?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4071dd8e6d4b0cd764e8f6fa6da56a0be79156f63b1c6b9207a3d1274646280e",
      "text": "Jangan mahal-mahal, Bu!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "416cdd6d67cc64343d4aff80c72cb8ead86940dbf1d4d053ec9ae9520e5d8f59",
      "text": "Pepaya, nanas, dan pisang dari Bali murah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "432fd463f3d951b30bf2e8f2885c450c2da16d30301765a42c9de8f060f9f544",
      "text": "Kamar ini gelap sekali.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "435469759737e26dc2864a28381f3a56cfd0563b59844c6137a8c6b25fefe3e9",
      "text": "Nanti dulu, saya masih capek.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "43963a4ff7c549b88940118f1f064d322eb907a583422e84a44466e2684e79da",
      "text": "ekor",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "454eeb2166603166014d46bfe262b7d6bcc0f84e623e7d3dcde0690dd95cc234",
      "text": "nanti dulu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4553e2a92b5b1b132d44c439c53e80b35201e395e4661e6f6d328b12b8432ad3",
      "text": "Langit malam gelap.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4752dbc95062f452053ad3a6fea4fa891157646f202fac920638cb4afd00150c",
      "text": "Jangan pergi dulu!",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c31ea25abd798ec49e35e71893e86cd3e372440b69eacbd1647337382e4a16a",
      "text": "kilo",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c461acd85543ac0e0232b9a9c0b104448d8af21677bcece71d9b8393057b72d",
      "text": "kembalian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c682f6c7f215eb2128b1e76f13350bc8414f85e06235ed40ebc7e1c666113a3",
      "text": "Bagus! Terima kasih.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d2e478d5e3d4b495b8c2bef8b8b4a7b484a85fa9ba3c1f97734a1ae9f6fcfe7",
      "text": "Ada! Ini, hijau gelap. Atau cokelat?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eedfb96e8b89b2d3261f146c4cb7c85d64d7e1b76569f81c9cdab0fef53a555",
      "text": "Mangga ini hijau, tapi manis.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fbca794de6ff82e558a331e7805c36d57742ee8c1656fd54ae2580d0cebf2f9",
      "text": "Ayo! Saya mau beli kain dan patung.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "52c09af93a93068180ec5c351bdbb3a73a8fb2e94e89fa7b34fd1c21a7185f59",
      "text": "Mau kain warna apa, Mbak?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "53c8a3186e805fcb1246d3ca8a681d8e61d891d7aff8e92d0350c28d80555ce4",
      "text": "Patung apa? Patung kucing?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "55fdf2dcd5a6b248a994a0d42f0c385950d0aef8740c05d8930699b374f36efd",
      "text": "timun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5668cdc23237a6b0e39843f6b8a9630fbc48411e9f908bee4844dbf1c6c9b21d",
      "text": "semangka",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "568271fc44dba1c9dc82157e0e4e2e225b4722b23b29fd370048f6c98cb0c2f8",
      "text": "Mohamed, ngopi, yuk!",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "56d6c97c26113af21afeca4be8ce43f58494d81ca2087ce93d82a4a7a86af739",
      "text": "Ngopi, yuk!",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5825dcd055533fe4e1349245423d3e8ccd83a360df98e6436125d787b19b3070",
      "text": "Saya beli selusin pulpen.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d11a9b836945f5f8d4aea48ceabb5a20a33a7ea04cb8714a10da4f77a2d6a9b",
      "text": "Selamat pagi! Mau beli apa?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dad9ceb1e912f8926e675fd68166ca990bd6d824bb74ee6ed5438f97db70192",
      "text": "Pisang ini warnanya ___, sudah manis.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa6b1f05da197586be88d9aea01634b321996a3c888f5f79a15c019842b2e94",
      "text": "botol",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fc7efb322c62eb700154f7f7a3fca6bbfb4453b76b2fffcc9242d231dce73fc",
      "text": "Bukan, patung gajah! Untuk ibu saya.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "634655a2a2659fffc9db50f1c0a9ca760c7f89fdea88b3c601bc4f0da432241e",
      "text": "Seratus tiga puluh ribu, dan saya beli dua lembar.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "635854c76439b31d07f22c32f9dfc7e235d7c291c0114e9e798321973c81e481",
      "text": "persen",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65346fc6baaf19ac9facd1242ad45a4788648651154780dc335a6f592d6fa4ea",
      "text": "Jangan mahal-mahal, Bu! Dua ratus lima puluh, boleh?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "65d3bb7e64169495b23c257d1953e7f485db894a07485aed8df033403593e432",
      "text": "hijau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "67d16823e1c88442d319b8996be71c5bd24f53fe3a2bb0407343ea686023f5dd",
      "text": "diskon",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6835b4f32657b8ce0e50dfe8e8ec9fb2f79ae57a82c05046b3a02db0cf14f033",
      "text": "Adik saya setinggi saya.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "684e2a4bf4057b647ea829850117d08f1b44d27459e552a673e27cf1b167f0bd",
      "text": "Ayo, kita ke pasar!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "69217b15ef257ac34da31cc940430f4a3f6552e4d7463f8098751e578583163b",
      "text": "nanas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6928d5a14ff7e15c3a13e405c36db77e8674090fce9872a718bf7025a286752e",
      "text": "Mohamed, ayo belanja! Ada diskon di toko itu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a28dddc7efae06a9ecf5854460c8c8365536aeb13b31b02e21dbf74ed4d7093",
      "text": "Satu kilo mangga dua puluh ribu.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b1812936432b0839033d3b5ca06ffa4dbbacefc2bc6c226bb6d7385d3a1766c",
      "text": "Ayo! Ini keranjangnya.",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c68a838f13627dc2642b095181e61be57af9a49a5088d6f571910cd57bf6701",
      "text": "Boleh, dua biji. Dan sebotol air, ya.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccea5c32473869ea5dc9953ae5c12483d72cdca44e1c85c9cf55c2a639538a0",
      "text": "pisang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d1c3a159ee473e3fbd2b3e99e632341c4df5e2f350450955873688638dd26c3",
      "text": "Semuanya empat ratus ribu, Pak.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e8187943220bbfd67446daa40d623659bfe634cf60675d322c08339783d6748",
      "text": "Saya beli dua lembar, boleh kurang?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ecce2d2c96eccfd8837d51b7878d8868c353fd7f9ca16a9d9b5aaf76ae85941",
      "text": "Satu kilo mangga berapa, Bu?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f0d394f2f9b366e85782c9908a8c9299fa4741679a8ff6798bfc04a0c8a8934",
      "text": "Tomat, kentang, wortel, dan kubis.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7058b34554450da47e0644df5f7a852e9391744e99e89b660745c118f53b5c05",
      "text": "dua-duanya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "71e44d72482ff61911e8ff6395d427a37f2ab4fbeca0db141927033f6900336a",
      "text": "warna",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "73eec7b20b0739f337d6d9579c2d2eea519de2366745577c0e1f555e70e7eec5",
      "text": "kertas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7412319f6a298caa20737f090f1d6c6879821715623a860298fef8d788be9566",
      "text": "Kubis di pasar ini murah.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "7448953aa2b2d429301f35f43dbab7c720825ef370a91e483798fab0944ae583",
      "text": "Seratus lima puluh. Itu harga pas.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7714fe9048bee53e2b6426733067c032b4376721cfc2438297193b5a2c451448",
      "text": "khawatir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7892fdfba2d8ee606f132a0df5dd29a7ed3e5ffe87120cd9f63a6c8c3ebc3d6a",
      "text": "Saya beli dua ikat sayur.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b89764ae3b2de066df726665981ac36f14db04c0c1bbba61727c978b02116d2",
      "text": "Jangan mahal-mahal, Bu! Boleh kurang?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c2ed3335f7e29ff2f4310aa0fc6eb7bd30ab803bd5981d6281ad908bde4ce89",
      "text": "pepaya",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e1979186c3b043b8f8e08295dc784cbd6c76c0367cb0a484bb5660c3c5b5156",
      "text": "Ini kembaliannya, Pak. Terima kasih!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eac9b33e78c7b67380868c0d1e89d320de6a72ae24ace747cf7997c2890fb97",
      "text": "Ya sudah, saya beli dua lembar.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f140e72d5e03daa4d9768ffe2191027ad02887017e829d8e0cbe01a46d39c67",
      "text": "mari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fdf611d39f95855b8db4ca63e8ce5081067caf06f8b84ec70b087e554127ca4",
      "text": "anggur",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ffbc6287cebbaa090a7de59b0cf6847e1a30edf33b3d69f7305fc30bd0abf3a",
      "text": "kasir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "80c91a77177cbb084a96524da2e20b3d355145b78e196ee699c28afdf9d1c671",
      "text": "Mau yang merah atau yang biru? — Sama saja.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "810aba0ff8054706ec27543434e3eda8a3ac4b4c06e6411ac4dd6509c036a12f",
      "text": "ikat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8116a911b271fb525e32ee1bb3aadd83d7939dca9c5044bba4154da55bb3ad89",
      "text": "Semua segar, Bu! Baru datang pagi ini.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "823870d0635882b77c341542a7a03c1f43b5e3d6f30e837d7285f068aa3eeac5",
      "text": "Tawar-menawar? Ya sudah, boleh.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "83df71c52c29d31aa07b719558cedd93cc43c0bf845f018842da7b14ef143612",
      "text": "Ya, dan sebuah semangka!",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "8591f8d9f1984aded59c8a9ed7722dfc43c774cb5c59da54096899704eb80d5f",
      "text": "kubis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8624b41f2e40682c7c6a4e3847e4fb48458653fbaef6ea4e591cf9738eaa26f6",
      "text": "Saya mau kaos yang hijau, bukan yang kuning.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "87a6002601200c44458761f16ad547ae162b2d669688c15f6fd9b7ad8ede4be6",
      "text": "lusin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "87d8989956bfa7497602f751e674dd5ce32c6ba84c7401f3db6a8b7c2affd068",
      "text": "Kain ini sama bagusnya dengan kain itu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "88aed07281632e5fa066ccb28e8d5bff9e9f4e31ffd1824bb7699f8832193f06",
      "text": "Tas biru ini semahal tas merah itu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "89fbc0a9b0ef009a3ff7656fecc99868669a82f0ffd90cf99f4d24a78803f9dc",
      "text": "Dua puluh ribu. Jeruknya lima belas ribu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a1c136e0de00ca0dee88e0d0f933c14402f29c5d216521c7456bdd30eb8e502",
      "text": "Jangan khawatir, saya bisa sendiri.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a7af1bffdce5680353e1f69b90f08d044e9f68db3ddde190ae23eb961eb96f6",
      "text": "kantong",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b473aaa93214d8a0a6d501b0fce3e1b36147c07a9b0b569841e0295a8532eb5",
      "text": "Boleh kurang, Bu?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c093d6357c7e7cef1b9fa613f64636e3ee29227144c22d6c98f558a114a9e3d",
      "text": "Ibu belanja di pasar setiap pagi.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dc9fc65d0447c5fc0bd2aca815aa44137e98df0d869bb096998216bf41f3d97",
      "text": "Saya beli sebuah patung kayu.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dca35c6e7cec384195c41d0c9181dc206205b888c7eaef64582a0e0c006710c",
      "text": "Hari ini ada diskon sepuluh persen untuk pensil!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e3d82b80ff10f7c8ee687774f939c0034dca2464f90b80d585c4336c871e568",
      "text": "langsung",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f197b14501539b285f831b8ab51e8b6ac1445b88c68c9254f52b7de323cc875",
      "text": "timbangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9353e13534beeb3b516d49e0ae824b208f97c382aeae3c3c041116778eafb4e3",
      "text": "Ada seorang guru. Dia minta selembar kertas dan sepotong kue.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b6c94c53892ba49b2dd5f96a807e86765141334f4123ed8a2f8b9835255667",
      "text": "boleh kurang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "94ccdab1cef101dbcc8b3d631aaa7f71388bf65799613d99c007c91d7987c3aa",
      "text": "tawar-menawar",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "95974ec4ceecdfe029d7327f597848c2fdfb04b7764195830fd8dce7847b238a",
      "text": "kuning",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d3da65a203e558b9855da5e99d69a4eb6d653083a8331590c5d46fa538f63e",
      "text": "Saya mau belanja di pasar.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "95ed974872d84d1684e8f5b301eed7baadb395d1e4a7fd3d49f5e0f957e1bda9",
      "text": "Harganya delapan ribu, uang saya sepuluh ribu. Kembaliannya ___.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "97a21067b06f5a6497bc4b36e8013b4159936faf6f5815444435f374986a5044",
      "text": "Bu, saya mau sebuah patung, dua lembar kain, dan sekilo kopi Bali.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "97de875dd57ffa4bafbbd4d46bf9580e452180ac51b12709765030714a69f86e",
      "text": "Jeruknya mau berapa kilo, Pak?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "982cb79d233164b43eb87909d3a78eb9f049b62a0ecd7ec6952b02bcb370041d",
      "text": "Satu ons sama dengan seratus gram.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "991b2f4655a072a7f6a58e6c4fbe445c7c5cf8912ef88455d2c908aaaf1f7e9a",
      "text": "ukuran",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d29cd04f88eec31c16c7d95ab05ad431205ec9c9f83eaa7aa48df8824c0f734",
      "text": "Saya beli dua ikat sayur dan sekilo jeruk.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d2dd845de8002d0ec0eaed45c2b91c5f0c3105cd803e0ad5b450c007ffeea7d",
      "text": "Yang hijau gelap ada?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f15880462b3ed15997e56c9c8ca722fd8c8834077b9e035c72dce3ebf10116e",
      "text": "Jangan khawatir. Orang Mesir pintar menawar!",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ffd91bc598a7fd3e542a05ab4555a7e2e2cee295455ca0f1199eb78bb1295f9",
      "text": "jeruk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a002af9c54af2a6ed7f0492eea0ae830504aee33a9c7db3036f1b0b2199e4b1d",
      "text": "potong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a03d0a2b0fb7b6b3674c4027fd3109a7e7541166903421f0c82c0400aa667ab6",
      "text": "Ibu membeli kentang dan wortel di pasar.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0d79399fb315338c756b329162d5eb67f04d2aa165b54ee9a7a21087b0fe01a",
      "text": "dulu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0fbd278051fae107ea9e49d6307aed2f5fa88981938d766371b40a7699e4586",
      "text": "Oke, ayo! Mari kita ke kafe.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2a4c5a5823ed60fa1ab8307893129a6adac49fefc8c188ee56a2a5d21916fcd",
      "text": "abu-abu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a46763e3204961893eb05c1b3a524f7dac3e76d6d146523cba1d92c8fcd0f843",
      "text": "sentimeter",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ffb31da0aecbbc8617d0f55cccc15efa501d1a151b109bab9b937c80851b89",
      "text": "Berapa harga kain ini, Bu?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51a7c3c4936e70d450f175b076625103ac98c40b57371266e59feab6c1dedc5",
      "text": "biji",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a56d10446a51d8e347377d12b052a0f8a57a5666d5c8fe9ee96b4808ab6fed39",
      "text": "Timunnya berapa sekilo?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c9196d1d14196ff3d6cf9fe0a5635cf49f55843a754fc350cb12909de04dbb",
      "text": "Saya beli sebuah patung, dua lembar kain, dan sekilo kopi. Boleh kurang, Bu?",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7e57a55ccbac8367b0bd72a8d8e257ee95884f28c5e1bcd276b2c2cd366de8f",
      "text": "Ibu membeli kentang dan wortel untuk makan malam.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f784f4e49a5b88602ceb302045d16d6119217a110bac6cf713a565afb82f80",
      "text": "Aduh, terlalu mahal! Boleh kurang, Bu? — Ya sudah, boleh.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad9c387aabeecf57e69db75b1a9e38ef56be67bbf0f494740d063eb6266706bc",
      "text": "lembar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b043e203ffbe79e64499edd4afd3c3ec15037b076e9a69ec5490821f4d886c39",
      "text": "Tomat ini segar dan merah.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "b05b03347ba13ed75cc21ca1e2e0e9cfbcf9d41cd1cfe8e6f01bb25e76ba3312",
      "text": "oranye",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b21e167bb1c851372a40c0072ed66e2eed87e084d27bcdf691f48e0128231b86",
      "text": "Saya beli sebuah patung dan dua lembar kain.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2909afb776f7576238d015e5569cb3917ebddbbc0045e8dc50a6ec9aaf38705",
      "text": "Yang hijau gelap. Berapa semeter?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b379c01616401e064a03df488ffbcc0f1b83c256baa5d14fa24d133c84604ade",
      "text": "Delapan ribu. Terongnya juga murah!",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3b433c36e3c4b9d15981afb97c7c040ffa1933b2b223a635cb62fc6211b2fdf",
      "text": "Saya suka cokelat, warna dan makanannya!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b42ca769c17d1b8f7b932f6dd89049a483dde1b63b2f0d69f37ef8fa714eb647",
      "text": "kacang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b47cc4d29273a2b3e18c97471304ab606954b1631c2e591807f3360468de9427",
      "text": "Ya sudah, boleh. Terima kasih, Bu!",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4a83a5fc8b3bdac241dfcd314e0db3353b9794691b0fbee950cb34a8722868d",
      "text": "Ini. Kelapanya juga mau? Satu biji sepuluh ribu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5ea3a1c4c4620e341b40cc3eb321deecb82b9a4624005e0f2afbd87da5a594c",
      "text": "Ha-ha, bagus! Yuk, berangkat sekarang.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b922b5513834c3bdc24da559b362527cd1f8fec1e68873d8e7ef0b10909f3300",
      "text": "aduh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b96be2d56d4aeccfcdc83098d3fb5f520c462b3b35e419e0db297612307d6ebc",
      "text": "sama saja",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9b1bc5044d05d0d55e81fadc5dea0edffe44c91c09ddffb875126aeccad1328",
      "text": "menawar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba4f88111506f77d2cc3fedc7cc57d5a7cfc888075f952d888366b0ec671ac47",
      "text": "seorang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb1a667bb5b87b460c22a6149708c71f39ddb4241b6ae25f325e5b0bafef5c5f",
      "text": "sebuah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc616182ade4b5a25036651bc42e58f47d63c9fbd0616c654f4801f89f96c582",
      "text": "Wah, terlalu mahal. Seratus ribu, boleh?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc868dfebda9ec284cdb56891563005791772f030887968dd45945f399d40e98",
      "text": "Diskon lima puluh persen!",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf3fb096846e593fc0e74d5d865d269616d29659a72e2d6363577fc10a9d578f",
      "text": "Satu kilo jeruk, dua buah nanas, dan sebuah semangka.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf62e28098cc4d47ddc3341068a26bb546fe447f23e67350d5da274991125063",
      "text": "bungkus",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0281283065d54ce2a84ce7b4e5601c21d7b85bf8879f675719ec87594c22777",
      "text": "jangan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2e9e39355d0b04440b738c75dab4567fd8b3db162b0603a2e8a46684fa7dfc3",
      "text": "segar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c54a30a92f842ec0620bf266351f48a6dd43031056ddd2623f89ce33677f2f7b",
      "text": "Baju batik saya cokelat dan ungu.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6d20d84ace2b3e6cf746e94a911cf17fec907f4b0a3b1fc36988f97bda6a594",
      "text": "keranjang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7cc8fa5c2b70321ec669a70618937623dc19b79c62c407f88e3c0622dbaa232",
      "text": "Hmm, sama saja. Kain merah sama bagusnya dengan kain biru.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8086854d3d4fcdd84134d3039b0ff1bc507b142ba6f6c53e7df43db63f9aa5c",
      "text": "wortel",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c88fe12ffa0e00ee9135084b67270aab17bf8a2725ee31637981ad0ea25a97ba",
      "text": "tomat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c915719a3eebd0cfd8910ab5889497d6f1d017ee97841d0b1af0f502100e1e65",
      "text": "Mau beli apa, Bu?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbe7f8a2a7ab5712bf79835d257957498f123d6cd2dde4ea58957d41e5dc09fc",
      "text": "Mohamed, kita ke pasar, yuk! Saya mau memasak untuk makan malam.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce41e267ffd2425257ba15ff757fa44375db9b1f8d3c8bf39442183af0fb0042",
      "text": "Semuanya lima puluh ribu. Terima kasih!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2d67700b6483e61b04c524766a841d929654157b9a9e4869f1706085635e59f",
      "text": "Saya mau sekilo jeruk dan dua ikat sayur, Bu.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52c0f8ac446890460f6006ec1a9c0833de1a90757265fcd16e7963bdc74d38b",
      "text": "Ni Luh minta selembar kain batik.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b7c22dfb76133b42df4ba205ed1543201f99946377d9734b9e1341db8c98ce",
      "text": "Ibu itu membeli dua biji kelapa dan selembar kain.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5ff56fc20e7ffebdf8a42540a1090e8005d9e446c73198c6dd0d54f97593fb0",
      "text": "Boleh kurang? Saya beli dua kilo mangga.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8eb418d30db3d269fe95d2ce938a12da5d803786db9a8397cfa1515f542f20b",
      "text": "belanja",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d98ccaac91f1506945add411813289b39142e3965ac199f2447778d62a87c9d3",
      "text": "Kacang ini enak.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "da5b6baa43e4c88934bc4639d7e19e09d8f59e0cef10156a1ebe9eda03301277",
      "text": "Pak Irwan punya seekor kucing.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc499ce6ddf06f2fb34e589fe50dfa26b769fd626b2add9844c2ade4699fab0d",
      "text": "Semuanya delapan puluh ribu. Pakai kantong plastik?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddd4ffdb1af295a91702252c39281585ba4298d3f1ef5e7a15c9bb6eb9cbf560",
      "text": "Seratus sentimeter = satu ___.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "de266da2e7ec9c13e9b833688b98b76225a52dd3c9b39d568eedafd5d9aa7b81",
      "text": "Harga di sini tidak semahal di Kuta.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "deb2e369a31445f1ccbc07c2d6017a3204d92c2e6970c69822b71267389e5891",
      "text": "Ini sudah harga pas, Pak.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e146e9f56cb989d01e34acb35d958cadb002c7b6346cddd38e64ecdf442e12d6",
      "text": "Ni Luh, mana yang lebih bagus, kain merah atau kain biru?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1638e0d94a104823a29baac0153da79cc367203cdca1be67e6eaf4d18032e29",
      "text": "yuk",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1e0f2c7273942015cfba6d0f38d5e458613ccbe9a3c6b16f48002ec878e2865",
      "text": "Dua tas ini sama mahalnya.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35781f022a1a3ec7106a6c0dec66aefdcfcdaf4884ca80dda9f1f0c31165a42",
      "text": "Saya mau setengah kilo terong dan sekilo kentang.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e438dc42717524813eb2ae71aa3c2368ed5f064535be9bb192aba3d448b20b54",
      "text": "Bayar di kasir, ya.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "e843b9cfd66c6ebbdbfb73396735aab8da3de7c708124238921704e3d6e20b9d",
      "text": "Bu, minta setengah kilo daging dan dua ons kacang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea675f883e043607573e3a7434ecde0e8c4ea75a6d6f785b5710a2c95b0c61a1",
      "text": "Sama-sama. Mari, Pak!",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaaceb9356aa029dbf76e06a22549ad7e51b10293e4e91a282293c116f50e436",
      "text": "mulai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaaf1d198e11eda2bb1121cb184ba1ff496050012dbdca2e9859655d6a1f16a8",
      "text": "Ya, dua-duanya seratus ribu. Tapi ukurannya tidak sama.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "edb8a6122537b9587d8584ab6f2aa9b82a19ad252be048ac73010afa21776304",
      "text": "Selusin pensil untuk cucu saya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee508a636b2a0af5c58d1700387e2a43babfe7b79e357e091a3b551f937cf286",
      "text": "ayo",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeee77f20f064220a161c9afc5d0d3b8c132f9e5bd24954900edec5c372c8cae",
      "text": "Saya beli sebungkus nasi dan sebotol air.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "f125d5029cb2d45bfb96535571962265fbde399bec7c1da4e44bd98eeb73d401",
      "text": "kilometer",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f271f46b496fb1171df227ef0e5aabebcc8aba57474c0eaf4fb31fc103cfbd89",
      "text": "Jangan lupa bawa payung.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2c942694e968df4420533e12f33faab84f37dd018afa8c991cd2ff84214b374",
      "text": "Mangganya berapa sekilo, Bu?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2fb5c02f3eb1c0b6948987c3f8d89dfd0b5af5f8e3691d5812c143d6c696b87",
      "text": "ons",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f383acd7685280d73b9034e4ef5589acb8de5b25bdc2b259ec8d661d19696616",
      "text": "setinggi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4855aceccdbc9d5cb0ea109bdc0201a29668fc453489607ed82d401e8034e97",
      "text": "Warnanya sama dengan baju saya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5233abd35dcf40725083d5e2f03721cdeb64cefe160d005331df47ca32f4728",
      "text": "Di kelas ada dua puluh orang mahasiswa.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f557642a6330352e05cb6497460aa7480001ef07eab28bf35abb4bc4ff79f2f2",
      "text": "sama",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5a2fe1e7a80b4f90c0790e92abee04ce992f3d13a91ad59695e6c725e8637b0",
      "text": "kelapa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f80a7fd238240ca6e956978c883979219744b20edf145329cfee014d17d59124",
      "text": "biru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9081ede5bf1ce88f848335d83dd831af044715b34f937f94b5c5073fb7b7c9e",
      "text": "Minta dua bungkus nasi, Bu.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa83eb1dd144fee4d48bb815ec76c5d4e3b5c8d6f49c99cac6b5a53c6628ef5d",
      "text": "ya sudah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb0bba05aed9bd65626cb1ec6985b28c19ca004143e911280e53bdf9b7e484ca",
      "text": "Saya beli tiga buah patung.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb2827af9f0eafc4c679de78e6c91556db8879f86d874be3f56d6837fd8e33c7",
      "text": "Tidak usah, terima kasih. Saya bayar seratus ribu.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "fca232ac7a1d163cd2e130ded98dcb69259fc46ac610c67b6a5260aadfd67012",
      "text": "Patung ini semahal patung itu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd1b922121d6005e173648a0bfedcdafb69cae5fc043a83255091210a5c1b47a",
      "text": "bayar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fea63a2795b3202c016573dceb394c9c9b16aac11ab9cbd0624939edddea7224",
      "text": "Yang biru lebih besar. Saya beli yang biru!",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 12,
