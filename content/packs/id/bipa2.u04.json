    },
    {
      "id": "bipa2.u04.l05",
      "sha256": "6886cf3a051017236019eca3397127d4f56ded42d352b88df4db6a4563ee54e9"
    },
    {
      "id": "bipa2.u04.l06",
      "sha256": "fc6156b5d1083d2e9c0801d6b899e86e918a256b98cc7292b732b2744c62be7b"
    },
    {
      "id": "bipa2.u04.l07",
      "sha256": "0edd0242319ab18bc2660570378d62fcdd9bb85e01ad90309e6a70412ce7ed25"
    },
    {
      "id": "bipa2.u04.l08",
      "sha256": "1edc6f129323241bf09aa8a2b87a60c059cb8163afdad0d8f192a7ffc30288a5"
    },
    {
      "id": "bipa2.u04.l09",
      "sha256": "f97fcc1f9ca429a110df7e0d536bda133db76f1556c49167f9714855d7339470"
    },
    {
      "id": "bipa2.u04.l10",
      "sha256": "4262d1241c05a9e7bde6de45aa101696758952205fafa64263b694bc5b1c4252"
    },
    {
      "id": "bipa2.u04.l11",
      "sha256": "b8b6eb50c2c5e0329dbab8fd34813fe251b18e9115ada31f7ea6a3cecc86031a"
    },
    {
      "id": "bipa2.u04.l12",
      "sha256": "eb8f652d08980e31db66fdd0955b1576d79c6474432b4a7ec718aa48c7c0311c"
    }
  ],
  "audio": [
    {
      "key": "0033296120d88e29b3a313363339fe358d082327faa77527537d4f2d7d3cdfbc",
      "text": "pegang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "01cfbc3fee0aa42cbc2e86a598ebab08b606afac05a4877f2a918acf0f42e0bc",
      "text": "Aduh, saya rugi. Tiga ratus, harga pas.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "07004ace62a32bce7a2c33d869d1fb0f55b97c70f2e3e8ace7a058124c532453",
      "text": "buah",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0792905f2c14aed60b27614d329784928af72a918129e1f0ccc1a964c6fdee80",
      "text": "Mau yang biru atau yang merah?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "07c737af49355687cddbeabde59c8407c8b9bf8094c2671a853510e40e131619",
      "text": "Ayo kita langsung ke Sukawati! Jangan lupa bawa payung, ya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "090ee2d30f07a52713b0f524e1f9f1932da5b6cfa8dade64a7a0cba9aef47ce0",
      "text": "gelap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b02cab88b1a527480ed96f65dc952a3122fb205d8f3a7dfe226308154f3bb8a",
      "text": "apel",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b4d1c6ab5275d913e1b038d4453c702111a290b66ba040eb9e28e28441d0199",
      "text": "Jeruknya dua kilo, dan sayurnya tiga ikat, Bu.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e6bf4694179c87c086a0e013d827823c4e7185b019c417341540005b4ebce68",
      "text": "Minta segelas teh manis, Mbak.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eb015330b171ac543eea677574eecb7999df6b662630fad031fd797461af238",
      "text": "Saya lupa payung saya.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed5973382281a73b3004e71efce46bbe878f66d8f6c12100cc16fcde1acaed5",
      "text": "Terima kasih banyak, Bu!",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "101596d28dd9ebb64e8ae2119527f3ef4e8de6a3fbf98af49f69bcdff0579b66",
      "text": "liter",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "114db42e712bfd91c9530c6c41f848681eef32e0f6f1d171656913e29e31f063",
      "text": "Es jeruk ini segar sekali!",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "11831ae3a4075408f4b2141a60e3852d771fc37a1f0c0102d8fb4d7e67bd4138",
      "text": "ungu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "11a63858bd9deb84317a5d557ed935c169a860bc7461b9ec584167f21bd3d6e1",
      "text": "Saya beli sebuah patung dan sepotong kue.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "12122e643ad54247f7ae5549e4051830a28b085985c76300ef6b81e3a6291e08",
      "text": "Jeruk ini oranye dan segar.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "153278cc3cd65dc4aab839ff45684f57525d701735254a83064976a320b43dcb",
      "text": "Mohamed, ayo kita ke Pasar Seni Sukawati!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "17d5e1b9457b3e5edd590c813e975d0be35fd5fc1effb94e6ed011c9d2d1a9fc",
      "text": "Dua ratus ribu, Pak.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "184489e5755f746a1225926ad7e687e18e2717cc7c5c23dd966ecc85469272dc",
      "text": "merah muda",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "18bd3443e7d42874ee83ee37fdc0619431032f38302a7d6614a3841ad6b13e2f",
      "text": "Nenek suka pisang dan nanas.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a102b05ecbae1bb2ff578d1717927a6a558264b8a98196ad83f4e5ce320b387",
      "text": "Kentang, kubis, dan dua ons tomat.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b1032a5e6abf2475ea96ecdb5249a1179fc9da3ad95cf2d6e6e1c3dbdf224b7",
      "text": "Harganya juga sama?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f8633d7b3b557680ac8ff97b03579bd8c54bca66f6532ad8c83dc2011acb47e",
      "text": "patung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "206d23c86ce9221b5636150f49223d845c78d263a15c55fc26d4e98d420ecde4",
      "text": "Ini kembaliannya, lima ribu. Terima kasih!",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "20d5aa9d0f713d2be6aa5d52eb238be96d0198f4815c6e2d0772a78f33ce4b6c",
      "text": "Ukurannya sama, warnanya sama, dan dua-duanya semahal ini. Sama saja!",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "239ddd5107be73d6d3b87a44db75de007c2ba83554c5b63382fe043449bd4416",
      "text": "harga pas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "241f4354e5f2d2a41809c0ec761ad096f3ef437f63962845604ec87235d58a12",
      "text": "semahal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "242a3396c93c163ef6308f4a1487d44bd8cc42b38a7427cc291fa1108f8b89de",
      "text": "Jangan langsung beli. Menawar dulu, ya!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "266d28a59e1c008849ef25daace2406d35fefab3dd24f8b3ad5606eea56a2c80",
      "text": "Ada diskon hari ini. Bayar di kasir, ya!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2732cb09b24c904ac772fdcb3f83a4cf6d36c639a83f88ab524e7912d759d8ae",
      "text": "Ayo kita ke pasar!",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a5a81b1b1a7956c519a0cff2a00a6e1ccc3ae9a86fc6f9a36c510fabfb8598",
      "text": "Ya, tiga puluh sentimeter!",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "295ccbab98b646053024aaab15d43c381fd4ec353fb868fde91ccbaa9e94b407",
      "text": "lupa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "296c444332f4e1d6238921a69ae764462cfaf735ed65e96403e2ee5aa5ef7a77",
      "text": "cokelat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d7ee3a6223f2bf0f8fa0ebf129761725cac79575417532627334ed9969a305d",
      "text": "Mari kita mulai.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "308d4b6aede3864e5bb90f3f1406b742d216c6b18e299c9d6639c9be56219e8d",
      "text": "Jangan lupa menawar, ya. Jangan langsung bayar!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "312818e6ef2dd50b6e05e70620332928b4647528c8527f7e88c526b882c2e9c5",
      "text": "kentang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "361e056e69ddf25a171068ad9035ce56c196190d03361640f2a4fc28406f2e99",
      "text": "Ini kembaliannya, dua puluh ribu.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c3d65c2bf471a5786f863efc9833fa72dfb4e102425985eeba6f8ffba2b58d",
      "text": "terong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "38920d153961b15b8ad29ceba8872c5c93fdfed1e30628bf155a66b461e88432",
      "text": "Terong ungu ini panjang banget!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "38a1c6cfc3ccaa05f28a423d251545a30565e6ad90b8261e129d105ea7204e33",
      "text": "Mari, Mbak! Hari ini ada diskon dua puluh persen!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3992c4cbba807f9754cb8177a1a330ac3943e60de086995126cfd455937a3366",
      "text": "Saya beli semua. Dan kantong merah muda itu, untuk Nenek.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a057297735096b149466c77b3743bc9874543d74fa34af388bf36217058346a",
      "text": "Dia ___ guru.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6b194dcd8ca23b9f13b64f86619b2da5bb8566a4d9321b9ba4667909a38cd4",
      "text": "payung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c302e1b649e3a0b79dd36b0b549a4017c46aca1ec1d9f2cbb09bc97b3d29478",
      "text": "rugi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dabd179199fdab02c41b466f207bf6cb700fd66c8947150919cdade67bbf927",
      "text": "mangga",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e52daeaa6ac29726955999768230badbf9290b0ce8135fbabb17c8968e5dc4b",
      "text": "gram",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ebe64332bfd2ef4045d86e6629872d7c5d676d93b2c639f9838e44fd32b1f5c",
      "text": "Satu es jeruk dan sebotol air satu liter.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "40185e1824f076670a2dbd8d16e45a754791189d393b9590a353d6eb44992d5b",
      "text": "Mohamed, kamu beli apa di Ubud?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4071dd8e6d4b0cd764e8f6fa6da56a0be79156f63b1c6b9207a3d1274646280e",
      "text": "Jangan mahal-mahal, Bu!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "435469759737e26dc2864a28381f3a56cfd0563b59844c6137a8c6b25fefe3e9",
      "text": "Nanti dulu, saya masih capek.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "43963a4ff7c549b88940118f1f064d322eb907a583422e84a44466e2684e79da",
      "text": "ekor",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "454eeb2166603166014d46bfe262b7d6bcc0f84e623e7d3dcde0690dd95cc234",
      "text": "nanti dulu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4752dbc95062f452053ad3a6fea4fa891157646f202fac920638cb4afd00150c",
      "text": "Jangan pergi dulu!",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b564c998c378bbc6c209f903c5d13faaa061203b84d6847048891419deb3593",
      "text": "Es jeruk satu, Bu. Segar, ya?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c31ea25abd798ec49e35e71893e86cd3e372440b69eacbd1647337382e4a16a",
      "text": "kilo",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c461acd85543ac0e0232b9a9c0b104448d8af21677bcece71d9b8393057b72d",
      "text": "kembalian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f641664cfe1f938e4faaf6cdec230b83eba005370cdcbf9a06a7e87a59d149e",
      "text": "Saya beli selusin apel dan sebungkus kacang.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "51a8579b76c7264fe352ef295bfa10b2bc0815e3555103b61a7f0d54f7196e34",
      "text": "Aduh, saya rugi! Ya udah, boleh. Jangan lupa datang lagi, ya!",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "51e2895c25651a4840757fff3ea34608f3579bc8d5c0156fb0348ce39230d8e3",
      "text": "Saya mau belanja untuk nenek. Ada pisang?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "520b0c82d056e248f2a9692c9b6de6c4f93faad66df33cdea5a9638916aaa8e5",
      "text": "Ya! Pepaya hijau enak banget.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "53c8a3186e805fcb1246d3ca8a681d8e61d891d7aff8e92d0350c28d80555ce4",
      "text": "Patung apa? Patung kucing?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "548e44001d7f3d8d2766f1802d605221f8f551e3078dbaba4a9d2067d6e5fe71",
      "text": "Ayo, sebentar aja!",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "552b8809639f24b8ac0de1a621be01b1d4e48a422020651b14aadbbcf4173ecd",
      "text": "Aku beli sebuah patung dan dua lembar kain.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "55fdf2dcd5a6b248a994a0d42f0c385950d0aef8740c05d8930699b374f36efd",
      "text": "timun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5668cdc23237a6b0e39843f6b8a9630fbc48411e9f908bee4844dbf1c6c9b21d",
      "text": "semangka",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "568271fc44dba1c9dc82157e0e4e2e225b4722b23b29fd370048f6c98cb0c2f8",
      "text": "Mohamed, ngopi, yuk!",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "56d6c97c26113af21afeca4be8ce43f58494d81ca2087ce93d82a4a7a86af739",
      "text": "Ngopi, yuk!",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5abbcfe97d83aba0b22ca0ce98c1856d68ea6952399a156d774ee855fb4f7e5d",
      "text": "Saya minta sebotol air satu liter.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d11a9b836945f5f8d4aea48ceabb5a20a33a7ea04cb8714a10da4f77a2d6a9b",
      "text": "Selamat pagi! Mau beli apa?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ee182348edea6ee83026632c51fb9b62705ac97ee0cc4170f846e434414914a",
      "text": "Mohamed, kita memasak, yuk!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa6b1f05da197586be88d9aea01634b321996a3c888f5f79a15c019842b2e94",
      "text": "botol",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "60305fa05f857b7accdf0bac8cd25b5875470de4bd0fd5903c94e99571dc98fd",
      "text": "Enam puluh kilometer. Aku bawa semangka, apel, dan anggur.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "60f6e7b587926bdad1ed23e6cf5d84cd3e24711e695e8bd679ee1acb0a7389ec",
      "text": "Kentangnya cokelat dan enak.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "634655a2a2659fffc9db50f1c0a9ca760c7f89fdea88b3c601bc4f0da432241e",
      "text": "Seratus tiga puluh ribu, dan saya beli dua lembar.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "635854c76439b31d07f22c32f9dfc7e235d7c291c0114e9e798321973c81e481",
      "text": "persen",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65346fc6baaf19ac9facd1242ad45a4788648651154780dc335a6f592d6fa4ea",
      "text": "Jangan mahal-mahal, Bu! Dua ratus lima puluh, boleh?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "65d3bb7e64169495b23c257d1953e7f485db894a07485aed8df033403593e432",
      "text": "hijau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "67d16823e1c88442d319b8996be71c5bd24f53fe3a2bb0407343ea686023f5dd",
      "text": "diskon",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6835b4f32657b8ce0e50dfe8e8ec9fb2f79ae57a82c05046b3a02db0cf14f033",
      "text": "Adik saya setinggi saya.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "684e2a4bf4057b647ea829850117d08f1b44d27459e552a673e27cf1b167f0bd",
      "text": "Ayo, kita ke pasar!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "69217b15ef257ac34da31cc940430f4a3f6552e4d7463f8098751e578583163b",
      "text": "nanas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6928d5a14ff7e15c3a13e405c36db77e8674090fce9872a718bf7025a286752e",
      "text": "Mohamed, ayo belanja! Ada diskon di toko itu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b1812936432b0839033d3b5ca06ffa4dbbacefc2bc6c226bb6d7385d3a1766c",
      "text": "Ayo! Ini keranjangnya.",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccea5c32473869ea5dc9953ae5c12483d72cdca44e1c85c9cf55c2a639538a0",
      "text": "pisang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d1c3a159ee473e3fbd2b3e99e632341c4df5e2f350450955873688638dd26c3",
      "text": "Semuanya empat ratus ribu, Pak.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e8187943220bbfd67446daa40d623659bfe634cf60675d322c08339783d6748",
      "text": "Saya beli dua lembar, boleh kurang?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7058b34554450da47e0644df5f7a852e9391744e99e89b660745c118f53b5c05",
      "text": "dua-duanya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7165b78ee027e4d1c82db3bc6e34d3e3a5a98cace5df47e8b2c0e68e6bda5f72",
      "text": "Ya, gelap banget. Nanti hujan!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "717be421b4718edc1608704a249f654b05b24ed0917ce35d8ec90c07748c2d3e",
      "text": "Ibu memasak pepaya hijau.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "71e44d72482ff61911e8ff6395d427a37f2ab4fbeca0db141927033f6900336a",
      "text": "warna",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "73eec7b20b0739f337d6d9579c2d2eea519de2366745577c0e1f555e70e7eec5",
      "text": "kertas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7448953aa2b2d429301f35f43dbab7c720825ef370a91e483798fab0944ae583",
      "text": "Seratus lima puluh. Itu harga pas.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7714fe9048bee53e2b6426733067c032b4376721cfc2438297193b5a2c451448",
      "text": "khawatir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7892fdfba2d8ee606f132a0df5dd29a7ed3e5ffe87120cd9f63a6c8c3ebc3d6a",
      "text": "Saya beli dua ikat sayur.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "78a48b2d22861747a9d6ebeee3d7b56cd64bd416c8157615e9dafc852833199c",
      "text": "Ayo! Aku mau beli kain dan patung.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "79284c752cfa170dc4951353b9d8bf749186cced9362888caf43f449e618daee",
      "text": "Tomat ini belum merah. Warnanya masih ___.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b89764ae3b2de066df726665981ac36f14db04c0c1bbba61727c978b02116d2",
      "text": "Jangan mahal-mahal, Bu! Boleh kurang?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c2ed3335f7e29ff2f4310aa0fc6eb7bd30ab803bd5981d6281ad908bde4ce89",
      "text": "pepaya",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e1979186c3b043b8f8e08295dc784cbd6c76c0367cb0a484bb5660c3c5b5156",
      "text": "Ini kembaliannya, Pak. Terima kasih!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eac9b33e78c7b67380868c0d1e89d320de6a72ae24ace747cf7997c2890fb97",
      "text": "Ya sudah, saya beli dua lembar.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f140e72d5e03daa4d9768ffe2191027ad02887017e829d8e0cbe01a46d39c67",
      "text": "mari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fdf611d39f95855b8db4ca63e8ce5081067caf06f8b84ec70b087e554127ca4",
      "text": "anggur",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ffbc6287cebbaa090a7de59b0cf6847e1a30edf33b3d69f7305fc30bd0abf3a",
      "text": "kasir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "80c91a77177cbb084a96524da2e20b3d355145b78e196ee699c28afdf9d1c671",
      "text": "Mau yang merah atau yang biru? — Sama saja.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "810aba0ff8054706ec27543434e3eda8a3ac4b4c06e6411ac4dd6509c036a12f",
      "text": "ikat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "823870d0635882b77c341542a7a03c1f43b5e3d6f30e837d7285f068aa3eeac5",
      "text": "Tawar-menawar? Ya sudah, boleh.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8267b249ab065eaac8dc61e45138b61259cd5bc7a578c4a49ae827024c574c57",
      "text": "Langitnya abu-abu dan gelap. Nanti hujan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8591f8d9f1984aded59c8a9ed7722dfc43c774cb5c59da54096899704eb80d5f",
      "text": "kubis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "86c6f1bc25ab31322a298944c8ebb86edfcc546bb42ebb8ec8866c1bcfd8ab33",
      "text": "Pepaya hijau ini juga?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "87a6002601200c44458761f16ad547ae162b2d669688c15f6fd9b7ad8ede4be6",
      "text": "lusin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "87d8989956bfa7497602f751e674dd5ce32c6ba84c7401f3db6a8b7c2affd068",
      "text": "Kain ini sama bagusnya dengan kain itu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "888c0bc611b94d82f37c5a080c4c884ff558ee7e6bff0979b713aae3cc2033c3",
      "text": "Ya, Bu! Kita perlu apa?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "88aed07281632e5fa066ccb28e8d5bff9e9f4e31ffd1824bb7699f8832193f06",
      "text": "Tas biru ini semahal tas merah itu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a1c136e0de00ca0dee88e0d0f933c14402f29c5d216521c7456bdd30eb8e502",
      "text": "Jangan khawatir, saya bisa sendiri.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a7af1bffdce5680353e1f69b90f08d044e9f68db3ddde190ae23eb961eb96f6",
      "text": "kantong",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b473aaa93214d8a0a6d501b0fce3e1b36147c07a9b0b569841e0295a8532eb5",
      "text": "Boleh kurang, Bu?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c093d6357c7e7cef1b9fa613f64636e3ee29227144c22d6c98f558a114a9e3d",
      "text": "Ibu belanja di pasar setiap pagi.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dc9fc65d0447c5fc0bd2aca815aa44137e98df0d869bb096998216bf41f3d97",
      "text": "Saya beli sebuah patung kayu.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e3d82b80ff10f7c8ee687774f939c0034dca2464f90b80d585c4336c871e568",
      "text": "langsung",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f197b14501539b285f831b8ab51e8b6ac1445b88c68c9254f52b7de323cc875",
      "text": "timbangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9353e13534beeb3b516d49e0ae824b208f97c382aeae3c3c041116778eafb4e3",
      "text": "Ada seorang guru. Dia minta selembar kertas dan sepotong kue.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b6c94c53892ba49b2dd5f96a807e86765141334f4123ed8a2f8b9835255667",
      "text": "boleh kurang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "949432fcdf5df323800831f1c8a932dcb87bc698ffad9339d567810705fb7f0e",
      "text": "Saya mau sekilo mangga dan setengah kilo wortel.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "94ccdab1cef101dbcc8b3d631aaa7f71388bf65799613d99c007c91d7987c3aa",
      "text": "tawar-menawar",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "951ea9894d11dd07c2dbb456bda0c2f897474f272243a0e4cc271bde16129d24",
      "text": "Bukan, patung gajah! Untuk ibuku.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "95974ec4ceecdfe029d7327f597848c2fdfb04b7764195830fd8dce7847b238a",
      "text": "kuning",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d3da65a203e558b9855da5e99d69a4eb6d653083a8331590c5d46fa538f63e",
      "text": "Saya mau belanja di pasar.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "95ed974872d84d1684e8f5b301eed7baadb395d1e4a7fd3d49f5e0f957e1bda9",
      "text": "Harganya delapan ribu, uang saya sepuluh ribu. Kembaliannya ___.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "9666ee05e082ff83e5f22d87a4d23c41ea261334a7db0d07149686c1d22b3201",
      "text": "Boleh, dua biji. Sama sebotol air, ya.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "97a21067b06f5a6497bc4b36e8013b4159936faf6f5815444435f374986a5044",
      "text": "Bu, saya mau sebuah patung, dua lembar kain, dan sekilo kopi Bali.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "97de875dd57ffa4bafbbd4d46bf9580e452180ac51b12709765030714a69f86e",
      "text": "Jeruknya mau berapa kilo, Pak?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "982cb79d233164b43eb87909d3a78eb9f049b62a0ecd7ec6952b02bcb370041d",
      "text": "Satu ons sama dengan seratus gram.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "991b2f4655a072a7f6a58e6c4fbe445c7c5cf8912ef88455d2c908aaaf1f7e9a",
      "text": "ukuran",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bee9475e9042c5c643a352b01d508e32c2d7e4dd93d366e8e3c06421767635c",
      "text": "Saya mau dua ikat pisang dan sebuah nanas.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bf0cee4ed0d1fcd6da4a8ab4f8e9b38f66ce5b4e7d448d9e4731b8ccb7312db",
      "text": "Mohamed, kita ke Kebun Raya Bogor, yuk!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d29cd04f88eec31c16c7d95ab05ad431205ec9c9f83eaa7aa48df8824c0f734",
      "text": "Saya beli dua ikat sayur dan sekilo jeruk.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d3c0006c378e42f47d90e465c530c4353494aa78567aaaa307bc2a4886952d9",
      "text": "Ya. Dan mangga kuning itu berapa?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f14566e6ed8201a47e5b89afb38e216cc2dd20e2dc7a151727478949c0d08b2",
      "text": "Hari ini ada diskon dua puluh persen.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f15880462b3ed15997e56c9c8ca722fd8c8834077b9e035c72dce3ebf10116e",
      "text": "Jangan khawatir. Orang Mesir pintar menawar!",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ffd91bc598a7fd3e542a05ab4555a7e2e2cee295455ca0f1199eb78bb1295f9",
      "text": "jeruk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a002af9c54af2a6ed7f0492eea0ae830504aee33a9c7db3036f1b0b2199e4b1d",
      "text": "potong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0a6513bdd5d7be85299c718b1429c6a42b92be49bc0aa9e0df2c2b89e0168b1",
      "text": "Jauh? Berapa kilometer?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0d79399fb315338c756b329162d5eb67f04d2aa165b54ee9a7a21087b0fe01a",
      "text": "dulu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0fbd278051fae107ea9e49d6307aed2f5fa88981938d766371b40a7699e4586",
      "text": "Oke, ayo! Mari kita ke kafe.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2a4c5a5823ed60fa1ab8307893129a6adac49fefc8c188ee56a2a5d21916fcd",
      "text": "abu-abu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a46763e3204961893eb05c1b3a524f7dac3e76d6d146523cba1d92c8fcd0f843",
      "text": "sentimeter",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ffb31da0aecbbc8617d0f55cccc15efa501d1a151b109bab9b937c80851b89",
      "text": "Berapa harga kain ini, Bu?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51a7c3c4936e70d450f175b076625103ac98c40b57371266e59feab6c1dedc5",
      "text": "biji",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a67fd7ebe06b2b7f05c104c6f8c34fb5767364e29f56dc09ef302020a054e05e",
      "text": "Wortel warnanya ___.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c9196d1d14196ff3d6cf9fe0a5635cf49f55843a754fc350cb12909de04dbb",
      "text": "Saya beli sebuah patung, dua lembar kain, dan sekilo kopi. Boleh kurang, Bu?",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f784f4e49a5b88602ceb302045d16d6119217a110bac6cf713a565afb82f80",
      "text": "Aduh, terlalu mahal! Boleh kurang, Bu? — Ya sudah, boleh.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad9c387aabeecf57e69db75b1a9e38ef56be67bbf0f494740d063eb6266706bc",
      "text": "lembar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b05b03347ba13ed75cc21ca1e2e0e9cfbcf9d41cd1cfe8e6f01bb25e76ba3312",
      "text": "oranye",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3b433c36e3c4b9d15981afb97c7c040ffa1933b2b223a635cb62fc6211b2fdf",
      "text": "Saya suka cokelat, warna dan makanannya!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "b42ca769c17d1b8f7b932f6dd89049a483dde1b63b2f0d69f37ef8fa714eb647",
      "text": "kacang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b477a84671332b18c5aa5834814cb2338fff5692bb90fbb5a5ead7a615ce9837",
      "text": "Hmm, sama aja. Kain merah sama bagusnya dengan kain biru.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4a83a5fc8b3bdac241dfcd314e0db3353b9794691b0fbee950cb34a8722868d",
      "text": "Ini. Kelapanya juga mau? Satu biji sepuluh ribu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5ea3a1c4c4620e341b40cc3eb321deecb82b9a4624005e0f2afbd87da5a594c",
      "text": "Ha-ha, bagus! Yuk, berangkat sekarang.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b922b5513834c3bdc24da559b362527cd1f8fec1e68873d8e7ef0b10909f3300",
      "text": "aduh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b96be2d56d4aeccfcdc83098d3fb5f520c462b3b35e419e0db297612307d6ebc",
      "text": "sama saja",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9b1bc5044d05d0d55e81fadc5dea0edffe44c91c09ddffb875126aeccad1328",
      "text": "menawar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba4f88111506f77d2cc3fedc7cc57d5a7cfc888075f952d888366b0ec671ac47",
      "text": "seorang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bacf547278b845048dfc9d1b54ac78d18fcb31af6b859add145eb063789d257c",
      "text": "Ada diskon dua puluh persen untuk nanas.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb1a667bb5b87b460c22a6149708c71f39ddb4241b6ae25f325e5b0bafef5c5f",
      "text": "sebuah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc616182ade4b5a25036651bc42e58f47d63c9fbd0616c654f4801f89f96c582",
      "text": "Wah, terlalu mahal. Seratus ribu, boleh?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "be439e46ac7efc00163fc635747fc742e9177fac748929f6ba6c5cf1b03728d8",
      "text": "Sepuluh ribu. Timun dan wortel ini gratis!",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf1f78b9af928d2740c3dc67404d933808142715dc1e4da1261bd35cd1a27281",
      "text": "Segar banget! Mau air juga? Ada botol satu liter.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf62e28098cc4d47ddc3341068a26bb546fe447f23e67350d5da274991125063",
      "text": "bungkus",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0281283065d54ce2a84ce7b4e5601c21d7b85bf8879f675719ec87594c22777",
      "text": "jangan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2e9e39355d0b04440b738c75dab4567fd8b3db162b0603a2e8a46684fa7dfc3",
      "text": "segar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c49f7addee00d137b2b0ef3ce04827f002f432398463ffa43c60d37898fa6316",
      "text": "Langitnya abu-abu dan gelap. Kami makan semangka dan kacang.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5fc482cb65eb1825003675512bcf3282466f811d6f6ff54af984e05fd861702",
      "text": "Bogor enam puluh kilometer dari Jakarta.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6d20d84ace2b3e6cf746e94a911cf17fec907f4b0a3b1fc36988f97bda6a594",
      "text": "keranjang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8086854d3d4fcdd84134d3039b0ff1bc507b142ba6f6c53e7df43db63f9aa5c",
      "text": "wortel",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c88fe12ffa0e00ee9135084b67270aab17bf8a2725ee31637981ad0ea25a97ba",
      "text": "tomat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c93e400b2cf88a93a37d9a0a4017b3ec039827d3d93b847e3fb1e83ed29ed49a",
      "text": "Mohamed, langitnya abu-abu!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c945887ccac20d9d72a0e5ba320fa0bd34b7a4c87d554c1fc4460857f9141866",
      "text": "Saya minta dua ons tomat, ya.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce41e267ffd2425257ba15ff757fa44375db9b1f8d3c8bf39442183af0fb0042",
      "text": "Semuanya lima puluh ribu. Terima kasih!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "cedf6da2c60891c261b96e6219a2b2d8b1bdbe0f7848cb380040f7f99c388340",
      "text": "Bu, kentangnya udah cokelat!",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfec9a90be6a4303df6c93009c56f304db0b70a7f4b528c1f53478bd6b83ee9a",
      "text": "Nanti dulu, Raka. Aku masih belajar.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0fcf51e41d3ae5f2a75ddf2f62d283d1f931247a10706114fde3f006ad477c8",
      "text": "Ya udah, boleh. Terima kasih, Bu!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2d67700b6483e61b04c524766a841d929654157b9a9e4869f1706085635e59f",
      "text": "Saya mau sekilo jeruk dan dua ikat sayur, Bu.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d5693d54cfd5d160eb9ad791adb489035bb37b3895ab827f77d43374373ec1",
      "text": "Saya mau lima ratus gram tomat dan satu pepaya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52c0f8ac446890460f6006ec1a9c0833de1a90757265fcd16e7963bdc74d38b",
      "text": "Ni Luh minta selembar kain batik.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b7c22dfb76133b42df4ba205ed1543201f99946377d9734b9e1341db8c98ce",
      "text": "Ibu itu membeli dua biji kelapa dan selembar kain.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7299795fe602259c751a1c811780876edb3a0620a69683b866e00c74b14967b",
      "text": "Kami bawa semangka, apel, dan anggur.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7df87b1c367ec7d77e14d8815b6f690f3fd46693dffdda3caeca87c18a347d2",
      "text": "Mangganya kuning dan manis.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8eb418d30db3d269fe95d2ce938a12da5d803786db9a8397cfa1515f542f20b",
      "text": "belanja",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "da5b6baa43e4c88934bc4639d7e19e09d8f59e0cef10156a1ebe9eda03301277",
      "text": "Pak Irwan punya seekor kucing.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc499ce6ddf06f2fb34e589fe50dfa26b769fd626b2add9844c2ade4699fab0d",
      "text": "Semuanya delapan puluh ribu. Pakai kantong plastik?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "de266da2e7ec9c13e9b833688b98b76225a52dd3c9b39d568eedafd5d9aa7b81",
      "text": "Harga di sini tidak semahal di Kuta.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "deb2e369a31445f1ccbc07c2d6017a3204d92c2e6970c69822b71267389e5891",
      "text": "Ini sudah harga pas, Pak.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0e2d0c541037b8578e00cfe32a0e39fa9346af6561f17771534e3a8b9daeff9",
      "text": "Ada. Ini pisang dan nanas, manis-manis!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e146e9f56cb989d01e34acb35d958cadb002c7b6346cddd38e64ecdf442e12d6",
      "text": "Ni Luh, mana yang lebih bagus, kain merah atau kain biru?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1638e0d94a104823a29baac0153da79cc367203cdca1be67e6eaf4d18032e29",
      "text": "yuk",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1e0f2c7273942015cfba6d0f38d5e458613ccbe9a3c6b16f48002ec878e2865",
      "text": "Dua tas ini sama mahalnya.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e438dc42717524813eb2ae71aa3c2368ed5f064535be9bb192aba3d448b20b54",
      "text": "Bayar di kasir, ya.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea675f883e043607573e3a7434ecde0e8c4ea75a6d6f785b5710a2c95b0c61a1",
      "text": "Sama-sama. Mari, Pak!",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaaceb9356aa029dbf76e06a22549ad7e51b10293e4e91a282293c116f50e436",
      "text": "mulai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebdead45353d56070bee04bc8c44b629504077a9ef7f7dcc0dc5775ef9bda1dd",
      "text": "Ya, dua-duanya seratus ribu. Tapi ukurannya nggak sama.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee508a636b2a0af5c58d1700387e2a43babfe7b79e357e091a3b551f937cf286",
      "text": "ayo",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeee77f20f064220a161c9afc5d0d3b8c132f9e5bd24954900edec5c372c8cae",
      "text": "Saya beli sebungkus nasi dan sebotol air.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "eefaedff6b5f4ff79aa70973535e07d82424e8ef81da3fbb68da6352e40c4e60",
      "text": "Yang biru lebih besar. Aku beli yang biru!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f125d5029cb2d45bfb96535571962265fbde399bec7c1da4e44bd98eeb73d401",
      "text": "kilometer",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f271f46b496fb1171df227ef0e5aabebcc8aba57474c0eaf4fb31fc103cfbd89",
      "text": "Jangan lupa bawa payung.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2fb5c02f3eb1c0b6948987c3f8d89dfd0b5af5f8e3691d5812c143d6c696b87",
      "text": "ons",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f380a59ac8953c112c1607a67ab5626e2efe1b7232e16fee46f9f48ed91078d3",
      "text": "Mau minum apa, Mas?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "f383acd7685280d73b9034e4ef5589acb8de5b25bdc2b259ec8d661d19696616",
      "text": "setinggi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4855aceccdbc9d5cb0ea109bdc0201a29668fc453489607ed82d401e8034e97",
      "text": "Warnanya sama dengan baju saya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5233abd35dcf40725083d5e2f03721cdeb64cefe160d005331df47ca32f4728",
      "text": "Di kelas ada dua puluh orang mahasiswa.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f557642a6330352e05cb6497460aa7480001ef07eab28bf35abb4bc4ff79f2f2",
      "text": "sama",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5a2fe1e7a80b4f90c0790e92abee04ce992f3d13a91ad59695e6c725e8637b0",
      "text": "kelapa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f80a7fd238240ca6e956978c883979219744b20edf145329cfee014d17d59124",
      "text": "biru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f85b2edf35a3a85ff55e8fdd1cd252cb34607e7eeb656bd5b71f7d0c9ce78e7e",
      "text": "Terong ungu ini tiga puluh sentimeter!",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9081ede5bf1ce88f848335d83dd831af044715b34f937f94b5c5073fb7b7c9e",
      "text": "Minta dua bungkus nasi, Bu.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa520064d0b6ad5d6f8cd35fdd1fc4a586ee8b24f218034a2cfe6d32e88fa3d3",
      "text": "Nggak usah, makasih. Saya bayar seratus ribu.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa83eb1dd144fee4d48bb815ec76c5d4e3b5c8d6f49c99cac6b5a53c6628ef5d",
      "text": "ya sudah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb0bba05aed9bd65626cb1ec6985b28c19ca004143e911280e53bdf9b7e484ca",
      "text": "Saya beli tiga buah patung.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "fca232ac7a1d163cd2e130ded98dcb69259fc46ac610c67b6a5260aadfd67012",
      "text": "Patung ini semahal patung itu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd1b922121d6005e173648a0bfedcdafb69cae5fc043a83255091210a5c1b47a",
      "text": "bayar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff7d8ce72fae5386a5a59e85c0c0a38e1f142a5efdc34b64904847532e9bb782",
      "text": "Aku beli selusin roti dan kacang.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 12,
