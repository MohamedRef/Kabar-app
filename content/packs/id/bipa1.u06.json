    },
    {
      "id": "bipa1.u06.l02",
      "sha256": "2846475b97098477ea4f27b78c8246ca2c2c086529bf93808b95d74ebb4b6c6b"
    },
    {
      "id": "bipa1.u06.l03",
      "sha256": "6870a5b2de2895f8dba2d3423d597f10e0357249af2c42cc33df9adec6f46e45"
    },
    {
      "id": "bipa1.u06.l04",
      "sha256": "fc65eba2c3231bc6c5d2d1114dc383f386f113d74130753532eb057d48bc02c9"
    },
    {
      "id": "bipa1.u06.l05",
      "sha256": "3b79a89fe2f10d297ede38a0d3e02dc8707f60344402623f8a15e7fe857a4ef4"
    },
    {
      "id": "bipa1.u06.l06",
      "sha256": "daf16a9bf4b4e0d593b4bc6225090d9043f58e57bdf11877be70b1480298a9c5"
    },
    {
      "id": "bipa1.u06.l07",
      "sha256": "ebe4543b71a779aa8f91b34535207855e09353c762ec9b254803ce5ed1408a2c"
    },
    {
      "id": "bipa1.u06.l08",
      "sha256": "5b1d06fa33895b853e4cd97bed020463f871a0c9ab618a280970ee360f7d03cc"
    },
    {
      "id": "bipa1.u06.l09",
      "sha256": "32ca8cb7cc94ec10651e719be6654e8ca11e66c6820d5b23a6523f90299f2474"
    }
  ],
  "audio": [
    {
      "key": "01279d58c85f9e2f6129bb4c1a671a343127d35a425a4d85d24ba58e67d4807a",
      "text": "sini",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "01c1a29a108ac0f418ea15fed3cbd295a7f6eeb6ea8180a26db1f3a469245adc",
      "text": "Ya! Saya minum kopi dan makan nasi.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0322848d35178b68f85c3cd4d85f57589e241d0878172819ee6d4c891eff51e5",
      "text": "mencuci",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "082ab0d90d9531ece7034bfe5e9b97a722ef67ef1a5820b3150e9e595f28e552",
      "text": "Dimas menonton TV.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a1a8ec7d03ff3c3fedb033f3bae8eceae716300891b9b9d9a6dbe555011d931",
      "text": "nasi uduk",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b1b7e8952b6172b330e26369811702c81205e1e65ac1f8117ad13b167b6204d",
      "text": "mandi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d87bfc266ed8696d5af9c546b13f254d666735d3fdec546f1c8db2e51d76eee",
      "text": "Rina mengajar bahasa Indonesia hari ini?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "0da80b2532501b0ae074a1308a4baa2ef3f7ce7b157aae5696c5934d5e9cd8cb",
      "text": "Kamu sudah makan? — Belum.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fdcc04789e29c27f62d73ed44fb94fd4a6c6ebbc3625804b2378fd70949f5b9",
      "text": "sampai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "103d5f5e39aa4a20f382430237d4e4adc7daba6669ccad2041372114ed15b388",
      "text": "tadi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1075fc0b2e25cc513d51b1d1087f6e1bcdbbb23858c95bb9ae9b5c85f820d128",
      "text": "menulis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "114a4b71fc2bf4f1bb10c8273d3e0a4b560e90cb7659aa62aee3e074d17f77b4",
      "text": "Saya akan pergi besok.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "12600ed4db952cf10b0ccbb7df7b562b89efe134658de20a13679b4844b40741",
      "text": "Bu Sari memasak nasi.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "168e66c1c011edfcf96e313b8a2d568be115a325c990225e71c9ce4df1492b47",
      "text": "mengirim",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "18ed6f4bd5fe90b61a0532b0843f9a0a6cdd0da9910a8b6630e81f28ea3067f0",
      "text": "Dia masih di kantor.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "19137174ce8f5f31bddd8b90f0baf8dd8461580f3c277b470f53f8cf788c4669",
      "text": "Mohamed, kamu sudah makan?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "19e2a5c1090c2ead09083019ee2c131ec39221d89f70e2653c9d74143d4807b3",
      "text": "lagi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b09d3f467c5a4978855d75cca42e8e39ef9be3600fbca67367272509188498c",
      "text": "Hari ini makan di sini, ya.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c1cdaf5e726da978d4f8e1ca31a616ac7750e6a89a08f4becb7750920e1065e",
      "text": "Ya, setiap hari! Kamu?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d0ab58e5e0e9de6827ef2d9061049a28f8126c7c0f34bf4dfad572bb69d833f",
      "text": "Aku lagi nonton TV.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2310519b7f5eabe01a81e91ba1f9096fcaf5fec2d1c6c0d95622faff33eb9cf0",
      "text": "biasanya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "234c118f7f87947e63a6d797ffb9526e3ac634cf68db51eca136011833afbfc9",
      "text": "subuh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "238c9fcaa1e7eac5a3e256837cf2706013971a8f56c9f1eb2707df68f06130f4",
      "text": "pesan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "268602d122f0d8243397f94f97adb2494440c2b1befec4383af1cf686be3e92b",
      "text": "Hmm, enak! Boleh saya melihat?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "279337665ef27f9846bf4c1333d1667a72be141d76be9ba3b16254312155b1a9",
      "text": "sate",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2adbbc137034fafe5c00b78771ef656b5bf178480d20e43590685248687e3b07",
      "text": "Mohamed, tadi pagi kamu ke mana?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c285e012846a15ec1722cc782ad1d565f11843f03a7eb9ac3a3ed18f0b0341b",
      "text": "Ya, Pak. Sesudah makan malam.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ed8bd9a1a18a4efbebb76c87d5ee648c8e523a46bbae4c0181f18d9c371e999",
      "text": "Nanti malam kita makan di Blok M.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "313ad8d23f5fdc8bd58dc58a58d0283ed428fb5c08378287fc9a278a1b6ca56c",
      "text": "Sebelum tidur, saya membaca buku.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "31bb244ca91889b3bf1fe784017ac4d19b46d1f34f771fd6c120e363ab24e18e",
      "text": "Saya bangun, lalu mandi.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "32d7e18e498907c360b5e78028a6be1d899bc27211e1fe16384b104f3503d52f",
      "text": "Pagi, Mohamed! Sudah makan?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "3457b3ff8054226711eb008701a59fda592b6a6587771901ce7c8738db3cb646",
      "text": "Saya bekerja sampai jam lima sore.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "357407309264bccadc4bf118e7148bc263d49821a1b2aad86a3ba9d933667927",
      "text": "pasar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3888abf12d15f22206c8772073b4e28a642c104cec792b35ffc6bfff29fc1ca4",
      "text": "Saya sering makan di sini sesudah bekerja.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "394adc56b77014dde8489e4f9da6cbf4b656d6e7c9ee0e49b5060304b55a4b11",
      "text": "sarapan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bc94182d81c942f55f1ae1b8eed3d7091c1f5ac9a4e3fef6a0ac3e0a825ec6f",
      "text": "melihat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3be729def7c59747ef3e39085b506051a41da56be6ad45ab48c5138beb05cd07",
      "text": "Saya sedang membaca buku.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ec6f8fc6cd3eab8eea4e441513026988c2834c4e78ee6abdb0b30f928301a74",
      "text": "Saya selalu bangun jam lima, Pak. Lalu saya salat subuh.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "41343985feffd12b2b6bbddab04624ec7151aeada3445a185f287731b5a86899",
      "text": "Jam berapa kamu tidur?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "429c5d09dfcc99a62017277c1e3cf4c990c687f96ddae80339c7c4cdc5ec7c7c",
      "text": "situ",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "49e31a1dbad2e73ae800f9715d9a732892a7a6ea6b8ff5b82d62e205a681e13f",
      "text": "Ya, jam empat sore.",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cab6bdd58a0fdda8b03df9dbfccbbfd1ef9c1fc71599cb67852e258b8eae9bf",
      "text": "Rina sudah pergi.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cbf5ea646a4bde2233b2bfa5658254b847b1816eb3ef3149a016c13f0e012c0",
      "text": "Dimas mengirim pesan.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "4df57a7034f9bd496f1d7ac18771c0d4c7df95cf5cd0cf137a93ce7a4f483834",
      "text": "Wah, bagus! Ibu memasak nasi goreng.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f64c9afb313cf1b56daf892e0be1d4bf4f1dc469bbbfc6f1156cb9cf184c38c",
      "text": "Boleh! Silakan, Mohamed.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ffe0014e9f7d0618d82025dd7a79bd9506c63d98d81a2cf93d71452f5b0ab58",
      "text": "Mohamed, biasanya kamu bangun jam berapa?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5058edffc144f2f6cb7970f1616aa195ab107d102dbc91dba1a61834da0cc56c",
      "text": "lalu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "507dbe0cb7bfc8f44742d0d4fd6406872327bb7892f6431bf1c5c38490a1af68",
      "text": "pedas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5268d2e023e6e4bbee70ad43b0429e1ab4929ebd51cf1d9aad697c05265c3e0f",
      "text": "Belum, Bu. Saya baru bangun.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "52adc39472c2d7b46430101175405860300ebc175a78fc290666f06163091c98",
      "text": "Pagi, Bu! Saya membaca buku bahasa Indonesia.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5354176947ec99b32d38706926e3aac3f6c3998013c5e73aceb2e9b4f935ba21",
      "text": "membaca",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "535a5a07f8bdcf1e3174eba2c8c224033947bc92a49d890a63dedee10c227ae7",
      "text": "menyapu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "54785c8d5652ba96bc5405a32645d1e5d33ed17118f8f7a7dafcf0d9a37e6913",
      "text": "Jam berapa kamu ke kantor?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ec2f4b05846541835db5ae4323db11abcab9e57201ea26c36fdf61953c8abc",
      "text": "kadang-kadang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "592befc1b53b45eb472f18e4bcf2563761a1f87a9cc82f829a701a2d68a22161",
      "text": "menonton",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5962b81f8a03fbe949814bbba15f135370af78740756c0bf72dc2f54ea8b1f9d",
      "text": "enak",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "59a5021791b1bc6817b772a82dcda7f6dec188734b4cdc69f1c4eb94968df14d",
      "text": "Tasnya di situ.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d5b36c9b7045c43f1823b3b4f53a913e49246d51a3cf5d190ccbde333d39130",
      "text": "Saya memakai baju batik.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "612f6082ae88db0009371a594bd7fd96d27204d03a131cbcd1999527c414ca38",
      "text": "pergi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "63c84b063bde573a02e4a2d9a30ae5235d4f53e142d7a6e46e78573352a95b3f",
      "text": "Saya selalu sarapan jam enam.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6583a9537ff88000095a19299e9587d399db96051da5411eef234b81a7ff1608",
      "text": "Kadang-kadang. Biasanya saya makan di rumah.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "65c2ac478fe2e822c6845b1646ac8d2eaec70999c97dffe634cc98497e6fb669",
      "text": "Jam tujuh. Saya bekerja sampai jam lima sore.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bc2f689b2fd5ea52170706d24166df972a01dc266c9ddd96052836a60b7a25c",
      "text": "Dia masih tidur.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c9c702bf8994a8ba99076002e7931cc01ef38b06aba849981f91ab76c36b40d",
      "text": "minum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ef555e8aa81685f1d1306bbb61d215b2aecbd1841ac043afd68bef13d0fcb5d",
      "text": "sebelum",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7003aa3a47bd1b72a1bc3a2bcd90bda637610920f5f66698182c5c5a4efd8dbe",
      "text": "Baik, Bu. Sesudah sarapan, saya akan menyapu lantai.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "715c07e72b91ce70de8087eaa425ca5051644b5f99305849f2f877923c47ed79",
      "text": "Wah! Saya akan datang jam tujuh.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "740278d1b0243a8040da9b7cfa81b74538cc9c0576b83f82bb941673d00b80ca",
      "text": "Mohamed, kamu sering minum kopi?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "74f55a939764daa8b4e01227388f56af54be626dfd8cc951c4d1b68e631b3a0c",
      "text": "salat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "754833e55fb0cea530dd3357a06d303799a9fa7b36390b99db558a2a6074d7ed",
      "text": "sesudah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "766a4350a8d8f078c5bd558a44828cffba6d2a10b1b4284b697b749f0e351f43",
      "text": "sesudah itu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "79580dd64949bc4ac07c225a12f28030543e2d30604d6a5aec5622ffcf572690",
      "text": "setelah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d4b7a30d3efa3d1fe09554abc786edaafb7396081c3ff51d3019946329f9505",
      "text": "bangun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7da0833cd6c5678deb6783a3e55e69f0808a7988fa24f2baf46d1ab3656d7580",
      "text": "Saya mengirim pesan.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "80b25cd8525935a2001359009d6179b7a9b28f8c48e5e25ac86f056aa5c2a9d9",
      "text": "Nanti malam kamu belajar?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8179ddd0bcf053b71936b7a8f31634f78533fc348f90314182e1910cdad135d7",
      "text": "Saya minum kopi.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "820d8658cbb4825da484b687bdcd177edbd71ce4cf3f0340d757b6df4e09bafc",
      "text": "Saya selalu bangun jam lima.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "82ebbfacdc83dcd1947d327e2f7c70576f2e8743642b47d929466179a3c14272",
      "text": "Saya bangun, lalu salat subuh.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "83a3d2e6366e0aa8c52de906c02a85af2f58273a899f3f64e338a6d0e456caea",
      "text": "sedang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "852294c256c61e3d6ba12142e705e975d4cddb089dd6a72bd9f9d7c6bef7f06f",
      "text": "Sudah menikah?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "8689263613f1b957c1517abace45c7a71202eebaaacd9bad66429740eec7b002",
      "text": "Jam sepuluh malam.",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a0ad5a36fcd4f0438dc2177fa817a2279330e67b1c9cefc0afc095cf6940a7a",
      "text": "Sate di sana enak?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ae8464a7eccc7655babe4d7140e2659febae658549d023ee8f531e8cc23c5ba",
      "text": "Masjidnya di sana.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8be55f7889427b8d85b2d70ee427e9796c3f43adcc9252cc37e0e16bfb57ad5c",
      "text": "Aku lagi di Blok M. Aku mau makan sate.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e66939a0b1f2b0a36743f5fe6532cf752e40fe8f53430d8cbca143f8117e8bc",
      "text": "memakai",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f6d41f8070a0640b393a01c23261474f5c434d73386ce0fbdb37c56ced65400",
      "text": "Ibu sudah memasak nasi uduk. Silakan!",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9072f9e96a71727fab81f75dfcf366c9cd2be0045788b00815c2b656bb098315",
      "text": "Pagi, Mohamed! Kamu membaca apa?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "912181037fdcc2d72ddc24bbacc2f8663dfed01f7449acdd7c4e38043e7b7092",
      "text": "Enak! Tadi siang saya makan sate di sana.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "917280f43cefd29884b40c3f8e0f15a337e8fbcb5742cf6686e7d7b297962877",
      "text": "surat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "91db6166247a866675983b7db90a7177f999d526eeb212d9b5845aed643a36c3",
      "text": "Saya tidak pernah minum teh!",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "92a63dbf70d64f425b889642b7ea2620a2e42c2aae915feb1236e13745f1a35e",
      "text": "memasak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9358ac0bf7b75a53cd645d3bd43ba94a82fbcb1b21608c2d9810faaf4387d5e2",
      "text": "Rina menulis surat.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "9883779fedf3d3f35e3491d2c484aec7330192de8df947860b519ca24e2d3fbc",
      "text": "Dia sedang memasak.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a8550cf4ef6eda15ed9ee8d5aa409dde8b560fce1671cdcdea6bb23839d7785",
      "text": "Sesudah itu, saya sarapan.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0c09dffbbce4965c0c5d4185a8bdb458e0b2c0dc82d0481055072acd67001ea",
      "text": "akan",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2dd93cfae018577c101f2f9311a2182c1e4f07256cfc364c581016b39f57b5c",
      "text": "tidak pernah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a34bf23ea53b2634eeec8c8cbedbee5a199eddbff5d6887cf9c556b957855732",
      "text": "Wah, rajin! Sesudah itu?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "a601a848c43bc05e203b62a600ac3d8b1910ef0d1999c59c9c5a8afe20884fa9",
      "text": "kemarin",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a74149a9c9252853abfef0f39e886fb7441baec910d709de8a802cf5a1d40e4b",
      "text": "Saya mencuci baju, lalu saya mengirim pesan ke Rina.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a778ab12ac4a105483558f670fdcfe8d229da8dc5515a8edd22acf03550bd35d",
      "text": "sana",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "acd8438dc53d9157bff2e3f7f5c09d81a14e46dd8af664afda3decc040c7a279",
      "text": "Saya jarang minum kopi. Biasanya saya minum teh.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "af692b21df73799777815664df313c487665d0bb5554e50e957cf5a02be4e117",
      "text": "mengajar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b000709970fedfa5a2f713b04ead969133ebaf9bb227926b7029b800d1a03443",
      "text": "rajin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b014f7c3ec69696a9ab8a1dc180d8433659034df2b4310ff0c02f4962cd36d2f",
      "text": "Saya membaca buku.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "b341d74e67ee21d993cda7246d9118f720a0ac6529e5bbdfd1383a66cb16aea0",
      "text": "Saya makan.",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4bacd98d455e10312dd3393e2ad08795d2c285c17288e62da9df94011fe10d8",
      "text": "Mohamed, kamu sering makan di Blok M?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "b56d2137c8df5e3acf07de57db86f4f016298dd3c517881f4c47763b693defd6",
      "text": "kali",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5c2ea4e59a876a94e5a2f9f31532ce224b3cb0c2e494804cb8135adedb6c26f",
      "text": "Saya bangun jam enam, lalu mandi.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b617f68a3da774b0b58416dc226f315c8e099b4a2885409565de64a0f8d9ae10",
      "text": "Setiap malam saya belajar bahasa Indonesia.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd5a5d6016dbd8148e77ccfcbfb4bef4f424264dd4646baa2b9d14d85b79c222",
      "text": "lapar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd90ceef44e6f522dd765e2a634f17570d229f715c13d3aafcfbbf1170f903ce",
      "text": "sering",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0f27456802c05e1060978d2a3fc2f5cecaa9d7ed20487faa310228a96ebfc29",
      "text": "Saya kadang-kadang minum kopi.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c18bab2aac3faeb6fc6aa82acbf3c7dcdad3daa21c40e0fca03586a4b78ce9ae",
      "text": "Dia jarang makan pedas.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1ad17ccb1dfddfd79cfa78f9cf7104a09947b2632933695f81aa1fe29c7f5af",
      "text": "tidur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1e0ce99255ddec91edb3ed24127dc7581626fe2bdd5de81364ed48a6ae7ea98",
      "text": "Pak Budi mengajar bahasa Indonesia.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4aaf895ed578158e930ffe044ebca8ffa7d7d16c981adf7c3fbe501b1ff6bc7",
      "text": "Kami akan ke Blok M nanti malam.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5239ed267ba70cc86444a7521a244e99b08fc675203e32960104aec7446c39e",
      "text": "makan siang",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6f54521da8e612471dd2953b651d4440798c4dd94e54f9c12aaea498bc714b2",
      "text": "nanti",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c86dc34214f21a02c6c9829077c91f1e4a7a35575da3c9096eccaf811639a953",
      "text": "Bu Sari menyapu lantai.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "cab14f7a86390df15c549b45bdbf6eeeb283a3eb2def5425371a57c002064cd0",
      "text": "Saya salat lima kali sehari.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceb62d0b942a2cf29e7d671f96b7bebdce9330262433381fdd02adec28237010",
      "text": "jarang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d033c2b00e6e0a25aff302b29ca83feb280bb3c0f7e41edd3f027c8fd001ae8a",
      "text": "Belum. Saya masih di kantor.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3b4bf85062f7446ea007ee8ebd486fc40454d26717af48e9ceeb6cbbfc87e9c",
      "text": "Oke, nanti malam kita ke sana!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d42379f3f4a2682a7007b06c383a10cf94c385191b286ecb3d92f4d16a25ac0d",
      "text": "Kamu minum kopi?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7e9c6f274d56df22183f6c399e7cc8c94d269d63bc06a05f62748f14e086dd1",
      "text": "Mohamed, kamu menonton apa?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8c163bf6440a326ec5533d4c164a1f97640a3736a84b5b6193cfa4ce6778c52",
      "text": "lantai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "da2de58b078b90486d292a01ed388b2ef272b639a14ef940a7ddd4e9a97a6276",
      "text": "Sesudah mandi, saya sarapan. Biasanya saya makan nasi uduk.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "df5c79864fcd807eeeb7ca6dd5fc7fbade10fa883175712f29b99e9219d51509",
      "text": "Terima kasih, Bu! Biasanya saya sarapan di Blok M.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e136cff2f0d2b902b1befb53b8ffddfa7706f49fca325231ccc96f5e68f59508",
      "text": "menggoreng",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d2bf8b9709978dfa1cac934b7bd9cc1a668ef50d144cfc42715e08513e3362",
      "text": "nasi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3177fa70499a507053cea6ff163d8af0e23b7e523dddac0da5b9bc35a499a4b",
      "text": "Saya menonton film Mesir. Kamu?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e54967b52a6a2c491e32faf916da89e64148f3e1d4098e0440df55a3aff3aa5e",
      "text": "Tadi pagi saya ke kantor.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "e63f23ca5616b988066c37bb9927140eb9056ab0d3545025685ba2d91474ee8d",
      "text": "Aku lagi makan.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e74f3e5833f482422fe6b250ec72b0ab0aaaa75a190df4417c9a56dd6c2168eb",
      "text": "masih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9cb6cf705ca31c51599edf02fe6f003fc1cab72dda7d8a11cc30f76441cf64f",
      "text": "makan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee7786211867713e0a218e038eb947aa3e143c39bae8d083d28672ac4b89e669",
      "text": "Mohamed, jam berapa kamu bangun?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef23591345a9b8e3515d34807c12c591e51ee8ddb7067be340cebacb71ab17e5",
      "text": "Setelah makan, kami jalan-jalan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2c54238ad477bf5754493ccd061b8e4460221057b0b0335bdd61b04c96a9a1c",
      "text": "Oke, sampai jumpa!",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "f34a93f9cbed8261051f75ffbdf9c8b3fa3eb32694a8773483ae45a03ba7d08e",
      "text": "ikan",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3973936a62f6d0219e034d0667f2ac7d47557212d4111647a9596fcaf634fb6",
      "text": "Sudah menikah? — Belum.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "f582bc78b0467f623dd95ddf6f08870592e021eca2bf02dc77e4568f701d02c1",
      "text": "setiap",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7aa932ac9cee1a71d145a6ccf287d5e6dddb7159ae12d59f780d790c989b25e",
      "text": "Tadi pagi saya ke masjid, lalu sarapan.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8d6d40e9a891885e04e8e5731b9344d2b964712733ed5d27f9443163e1ea764",
      "text": "Saya bangun jam lima, lalu salat subuh.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa636d27851a05faefbe9be0392af6654cb0c26f77744fc49de7ad1e7e3d41d7",
      "text": "Kemarin saya ke pasar.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbe639afadd97f535d67a2edcbf2aa0d8e47acf0496617d001395ff4c4b9f7aa",
      "text": "selalu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd8c6a09d4a9e121b77cce11fb07d076de6e88dd7bab6cabccc2875ca4bd52ed",
      "text": "kantor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdc6ad3c211165f79566e9979c66fd84b1f4dfbf54c6a9eaf8916cde73cfa30d",
      "text": "mendengar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "feae7301547af4c77313ac72bccc85f467bdec6385a80aa9a1ed9e3887fe1556",
      "text": "Sesudah mandi, saya sarapan.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    }
  ],
