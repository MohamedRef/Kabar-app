  "lessons": [
    {
      "id": "bipa3.u05.l01",
      "sha256": "58aa51233563199168ff503849355cdcd32b0070394f0be2179019b9811a3933"
    },
    {
      "id": "bipa3.u05.l02",
      "sha256": "26867f67c28b7d87333795dc4ca7e72f04c1ecaf89b2901d8c9f2779f16186f6"
    },
    {
      "id": "bipa3.u05.l03",
      "sha256": "afe17c022f8df8090fa952817996edf44a3715e800c5d960ea00d4fbc8f1bf37"
    },
    {
      "id": "bipa3.u05.l04",
      "sha256": "10f286160a37a43136d2a68288e2029c4ba9d3d3c8cd19096340a5a750fae12d"
    },
    {
      "id": "bipa3.u05.l05",
      "sha256": "589c973567daf92e3c6d5e6bba58a094a50df0a2ab4621b94ed51fcfecc0247e"
    },
    {
      "id": "bipa3.u05.l06",
      "sha256": "898b07a462319c8f8c74a936851419fce279c8f2de85d8bbffe813c6aacaa48a"
    },
    {
      "id": "bipa3.u05.l07",
      "sha256": "c67887c7ab646f642fd5398be1d3bc86b528f38f0e7424f993c37fcc9b07eef3"
    },
    {
      "id": "bipa3.u05.l08",
      "sha256": "c933adaf1fc1d4917561d6a9c6247b88cc4ddf32aafa2c3a06a9d3c30960df6f"
    },
    {
      "id": "bipa3.u05.l09",
      "sha256": "50fd8e62133564e5a875c24f8a313a907319093bd56a425c35d2e97bb49f44ad"
    },
    {
      "id": "bipa3.u05.l10",
      "sha256": "9ced3f957bddc056b9aa75b9fa91597aad413c305275923ab4383457bcf1fe7b"
    }
  ],
  "audio": [
    {
      "key": "00f446d82715240e395b6110811e734c0ff579534bd2c72ee6563bb605212004",
      "text": "Pada hari ketiga, sesampainya di puncak, kami melihat matahari terbit. Pengalaman itu sangat berkesan!",
      "voice": "id_gadis",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "030e446ab95c8b78d46e10c8540fe118f328d59c8354d0a8e7c538c1d9571bad",
      "text": "Siangnya?",
      "voice": "id_ardi",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "03345cd359a3caa521551575719e2f3de0e37587ef5d3e56557f59c691707b92",
      "text": "Istrinya memberi kami bekal nasi dan telur.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0415a796fb7a4f5112544467c9c18acb68cb9f805032eb260e6d4ba2cb432101",
      "text": "membayar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0487c2a366ce066f8bfcb056d1021f4079d02a247716f386a5fb0bd64510bb04",
      "text": "Yang bawa tenda siapa?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "097262a880ce634620889378e314888ad17cade98fb6b56115eda784b091bb3a",
      "text": "Seseorang memberi saya sesuatu yang enak.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ce42bcb9240dd4c021c6dfd7f07ca606fff48be50c84a84c50200c8574364ef",
      "text": "Simpan aja. Aku mau menghapusnya dari HP, memorinya penuh.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec7e97f5cb95dc99958a50375a325a30857a9a0a41e1f262d5da13ed2d61db5",
      "text": "Hampir. Aku masih mengerjakan tugas kantor sedikit.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "1032eda1c294dee1dcd07d63109f3e5bdf6fcb99d28659f5d407dd368c42a9e4",
      "text": "pengalaman",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "120ecb1699c0b704aff3c7f33b4d809fe501bb6f1dab1e8423197d765c5d3ccd",
      "text": "Mohamed! Kamu berhasil sampai di puncak?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "13f2d74144f8b5ef0590bca5ea6976419e8740b8651521a33f5bbee47f5f713a",
      "text": "beristirahat",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1607eb3076df89e0ae3135cca18494f722326c8472db7953c6dac149ab28f311",
      "text": "Pak Sahdan. Dia porter. Porter-porter bawa tenda sama makanan.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "17ef1166b415b3236a689903b20d75bdb8fc916a9cbcf0d1ee3ad7c18f7a1654",
      "text": "Mohamed, gimana minggumu di Senaru?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "18d8c48ff908232a3f6f53d7bb2c436a5b6da345bec694778340092c1973653e",
      "text": "Rina menjemur cucian di belakang rumah.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "18ea03cb6a82c73148e06b1c339d43942f340340519791602aa07dd0951f8b77",
      "text": "Keesokan harinya kami mendaki Rinjani. Pengalaman itu berkesan banget!",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b48d246ded7e896ad6f6603ed59b44a386854f6af2082aaf2ea51e86bcce111",
      "text": "memang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c363aa1f6e1b5ac06c8d199d9cf32c81cf9bf95151a752bd90e8072fcc90edb",
      "text": "Siapa yang bawa tenda?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d29d0212d7a5909b6894e2268dd29d2bb6b83ca4d455b9b33dafd86a8deb750",
      "text": "Kemarin saya takut hujan, ternyata cerah sekali.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f0aa63c4c8e974a3a5e354e8a6c6590c40c0988db1e8a3fb67a96f5cb45cf7f",
      "text": "Kami pergi ke Senaru. Kami mengunjungi Senaru.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f1161478a1393c8081660cd79356eaaad4cfc7f6009ab88f32896214242854b",
      "text": "Persiapanmu udah selesai?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "2138b4bd166a76e51a6cd31676450630b8356861e106de834b29c1e4ffc219c0",
      "text": "Jangan menghapus file itu! Saya belum menyimpannya.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "21751a2601f5dd1fa7e784611d7193c53ff0fc1cbdc57912c44fbd60a96f628c",
      "text": "memberi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "21b5f7410ced5a679d768832190f29642f7363d4812a7bc5472354fe12f549b4",
      "text": "Bu Yanti memberi kami bekal nasi dan telur.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "246e16056278ca2743fd42ec8bc57585f082f00fff9e01919114b1c74b29eff0",
      "text": "menyetrika",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2489178704a2553853a007aa97d3bd71b528d4b0793ac796a751eebfec922331",
      "text": "Jurnal mingguan, Bu. Saya mencatat kegiatan saya tiap hari.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "2498f9bd427c5f74b95faab6697b9313843c569a8a281df111d47c3ff6c16abf",
      "text": "menyimpan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "25add73c753fbda708e817e329fca088e6afaddf51a32ad8aa484febefb29830",
      "text": "Berat, tapi ternyata porter kami bawa sesuatu yang enak: kopi panas!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "25e0f0bd2fd4a46107212a5cfa6d3c7c4831d13d9190946f94c9183692f30cfe",
      "text": "Pengalaman itu sangat berkesan!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "25fa0e5eb7a48408354ff3cb563db59ca647e19dc254a77e1ad81467eaa616ab",
      "text": "Malam ini saya menelepon keluarga di Kairo.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "26fd126adcaa72f2e733d5a520d7ff01bbc236ea2eccfef2559746c2bb2f40dd",
      "text": "berhasil",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a1e0e0d1219af64fe2d22c751daf4adef680f521eb3b100088c7242c430cf2d",
      "text": "mencatat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a66036e6eb0fcf6db18589ccc3028d7795c0604150f3024315a8b057e6029e1",
      "text": "Udah siap? Belum, aku lagi pakai sepatu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b8f21930928be73b5cd8f721dcffb31bfa72324a4cad7be51fd3c4de0c25e09",
      "text": "Saya sudah menyimpan file ini dan mengirimkannya kepada Anda.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c5ebfbd09df87c9e536720ca924e0198e6893b415b9843d0693153f691315fc",
      "text": "Iya! Dia bawa tenda kami, terus istrinya ngasih kami bekal juga.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d7b1fed21b45f92b00fe31e377ed32f86e7196e13874926bf46067ca96d17f0",
      "text": "Makasih! Kamu juga mendaki sama Pak Sahdan, kan?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e8b337e1969340c8336783e57524e6b9c173ca3d6790d97488d849cdde80c79",
      "text": "cucian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f1861658a743c5451c13f1876abe3526fa220af3573849edaff5c9b3a62ad47",
      "text": "Klik di sini untuk membuat akun baru.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ff6bbe6ac4c446c3f0217dad99547b69bb70498404abd31e2940d157a016ef1",
      "text": "Boleh. Pak Sahdan, tolong beri Mohamed senter, ya.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "38d9dec81bd3a7c589674af4bce1b5fb4db609afda1c6b5b9bf412e7a844b5c4",
      "text": "Jalur ke ___ Rinjani sangat panjang.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d0260f29abd5b50ac1a499eeb27db4158c834948aa114c070ff66710b405ae9",
      "text": "rutinitas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dcb96233df721b12d30425075d256ecf1545990b72c4950b79b5546ad15ad47",
      "text": "Persiapan untuk mendaki Rinjani sudah selesai.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e6e2a9800b7ab9fe17134879c11f988e3b9d6e6e4051c201e15d0c05d36aeb5",
      "text": "Kamu lihat matahari terbit dari puncak?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ffa33a3367c82b44d701d44f5e8d8c8ef536c79178fef728337aa88cdfeaf0c",
      "text": "Makasih, Mas. Aku boleh meminjam senter juga?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "40cf4a63f6e430d1370e2abfa144742a6379fcf4800fd096e5ccedef5ae8514b",
      "text": "Kami ___ air terjun Sendang Gile.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "414764265c57ef99f672328dc475cfb778b667d05f4e5dc43df6dcf9e16453a7",
      "text": "Mohamed, kamu sibuk hari ini?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "414950aae5f7e98de2b5eda17f1c59d0494436ffccd2e4301d2aab4bbdd6bbe2",
      "text": "mengerjakan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "419eec8cb67b27af532cb288a714fce973956f227cb862758052fecb04c4032d",
      "text": "Bagus! Coba bacain satu hari.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "421fd987921ea65e2083cd0c52eab4072b642314fc96fa64adceff2f34efaa72",
      "text": "Mas Rizal memberikan peta ___ saya.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "43c699c8a1229c39107a1a0ecd2a9d122498333140bd42f1d454ee36f5c7e5b5",
      "text": "Pengalaman itu sangat berkesan bagi saya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "45ca0d739888e6d8993fadd990a13a33a58473352873a5705cc135fc4a67c956",
      "text": "sesampainya",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "46cfc2887a2908ebee6b021112b22c7acb524286944cad344cd0f0181f654529",
      "text": "puncak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "488df6f1c4aaeb45c50da9dab36e8f31074c3dc12f6066a3ba29b30ebdf036d5",
      "text": "Terus?",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1efbd703726f1fb3686b07a07b423768e2350d11d325bcbd56cbc8afa76346",
      "text": "Raka menyetrika baju setiap hari Minggu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de06787c5a4ea0357675e788683bfd867dc26daf4f9855d5e94bda819fbbc12",
      "text": "Siang saya membayar tagihan listrik di kantor pos. Sibuk juga, ya!",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f254a577d4b23bf22721b637b16213bc67f2306f8f043863b70ee319bf3ae27",
      "text": "Malam itu kami tidur di tenda.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "502ca17ca397a096fe7c53573e02f3ab2c71123aa2f868d39cd356f3e8684295",
      "text": "persiapan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "535509761983e08cf1f931dfeca3c668439e2b09b5c71b4364a346658c3d1ea6",
      "text": "akhir pekan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5712a84c9a9b410e80d815974407a28212bba7e209de67e7e804267ec8a1c5cf",
      "text": "Sesampainya di puncak, saya melihat matahari terbit. Pengalaman itu sangat berkesan!",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "57bc4e57c2987f16e2accb408efd127f1cca1533b5b7421cd6991dd47ea5afad",
      "text": "Hari Jumat saya mengantar Rina ke stasiun. Keesokan harinya saya menyetrika baju.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b7d2587259b9d56fe37dd31a410af9df29cd12133c10a9b25d4b055145f82ab",
      "text": "Iya. Keesokan harinya, aku lihat matahari terbit dari puncak.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bdb4772087fa17b61adb1159e68a4ec75f3e6b9f82918b321541a886652ccf5",
      "text": "ternyata",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fec8a327a221c9f9542c35d6a6914cbdc2c914bd716a1b1ee813c0ffabcbf26",
      "text": "Setiap pagi Bu Yanti menyapu halaman.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "62909c518207310fd8c7a88bb7b0c53816489a1da14a0a3237a2c201d5bcbecf",
      "text": "menelepon",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "65bf1f2c5fec227cc1936cd35e18d2c3f5543a48d2f52597e80e368303575f76",
      "text": "Asyik, kita siap mendaki!",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "66a974179d804de42aad0bbbf78e6438e21a30c88839f7115793a3051fcabe20",
      "text": "Ni Luh, aku baca blogmu tentang Rinjani. Bagus banget!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "66acbc18f96d61fdf3f6f29af52e7cb16d5498c56df62087def5a3373351b7fe",
      "text": "Akhirnya kami berhasil sampai di puncak.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "66d428cb4ead7792b739875c6b9d7be4131193238188da57a6b54e7165d4a79f",
      "text": "Wah! Aku pengin banget lihat puncaknya.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "66d740aa69ff50ae8b2e9f9eee45b982a0a5ca63e6e5868e59b038401f47e38c",
      "text": "Hari Sabtu kami tiba di Senaru. ___, hari Minggu, kami mendaki gunung.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "66ed8bb3515d99465dae5abf04d79562c4342c313bc91a6e8aeb3571904b4c35",
      "text": "menyelesaikan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "67656287dff7d5ae3c085c27c26ea96439296e6e4ac9ce4dc17cc7905158ad09",
      "text": "jalur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6882bbca9ab9a12aa5c228c13ef0ee483db11b7e42d4f185d30ba5741b646ed7",
      "text": "Iya. Sesampainya di puncak, aku diam aja. Pengalaman itu berkesan banget.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "703c7c42236d13b67e12852740bca7f67872a2f7da6a09f1c1cf111a2579e96f",
      "text": "Keesokan harinya, saya mengantar Rina ke bandara.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "73dc65e1f941aec6100c6656259015f5807b598754c344718c92635ce38ba1fb",
      "text": "klik",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7415365c42399a51d103ea41dca0bac91541644e40b4e49a0b67f03d678d265c",
      "text": "Pak Sahdan memberi saya senter.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "764127858ad782addd642994d74bdf955d60241ed89a183cbadb02537ff23417",
      "text": "Sesampainya di Senaru, kami makan siang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "76f7906ef38bb59f267326b2e388797abf873a90296ec2c6c0d0eb4b6954b8d7",
      "text": "Saya menelepon ibu saya setiap hari Jumat.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7826a71041362d3450c5c4385f78411e26f8b26677928b4e8a98b96776abd1fa",
      "text": "Mas Rizal memberi saya peta.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "7883426cbafecb9c54620bda6d3e7614040d75385fcdc9a45d669496384b97f1",
      "text": "Nah, ini air terjun Sendang Gile! Gimana minggumu, Mohamed?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "7888e90acce678c4dd01fbcff3b031d6af80e829439c518d7bee93293e6dfe5e",
      "text": "Akhir pekan lalu, saya mengunjungi Senaru.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b7da052cf44723312b1fa4e61541858bdb328cbd5a88b02553a4d9daccdc486",
      "text": "Seru! Hari Senin aku tiba di Senaru. Sesampainya di sana, aku ketemu Pak Sahdan.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cb4cc16da71eb2c43c58a74f6105bd77ccfc3a05a4a5e5b5d19618a33658a1e",
      "text": "Nanti malam mampir ke warung, ya. Terus beristirahat!",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d26f589c4dc94b10164412da901c4da155ec05f02e000f19c212db83bf44f00",
      "text": "Mohamed, kamu nulis apa?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "833d07205c3bc6ee65f80266cdec3272f1c2fad23858cd4449a6c0008bab22c0",
      "text": "telah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "83833eb71f73512f22eafd2aa9440a46ddb83e764a5e3667652593bf6f0a9a63",
      "text": "Saya menyimpan foto-foto itu di laptop.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "85ee0f8ace638038fc65f8ca7a6c231abb2b2aee15837b8f5fc6f1405830c29e",
      "text": "Pak Sahdan, porter kami, membawa tenda. Istrinya memberi kami bekal nasi dan telur.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "88ce7647647dbaa4c864e98863e1fedcc030687c3481e7efb3d7ee2970522f40",
      "text": "Kami beristirahat seharian sebelum mendaki.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a7d862c7c7de969ff89081220314b15802e8488019ec0fd64e5a8e40d3cb127",
      "text": "Rutinitas saya di kota sangat sibuk.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b94cde704b6851fb695a3b3d8c0565a20c04afdcaa00495311d6dbdfa166dcf",
      "text": "Keesokan harinya, kami mendaki gunung.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf316dc60ebf3bccc702029351f0e1e1b0dd02cb9f2af621b356224ac5d23b2",
      "text": "porter",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c3ea0ba34461c8b12dd7df78a32e8c5cad5c1281b4c7946a72ddc15512cc7bd",
      "text": "Ini senternya. Bu Yanti juga memberi kita bekal nasi sama telur.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c7028701385b03b50aabd939cc453a26eb7f75f1f6a488791ecf42fa864b063",
      "text": "Nanti sore saya mampir ke rumahmu sebentar, ya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e406bf1f7a951b11310e13503b0b0f48b89504aa8b105d5cc2c5a95b2ecdbe5",
      "text": "menyiapkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ebbe0bb33105ca509eb99017799c8a6cc7f6d315bf5a4112b15121ff1197bd2",
      "text": "Saya nyapu halaman, istri saya menjemur cucian.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "926ae59783f8e94b0675bafcc3cd2caeda7a0e1cc72791adc196cd96992444fe",
      "text": "Porter itu ___ senter untuk melihat jalur.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "93034c1e3d329957a7375b3c8c13a73469a492ea0896a769c616ade42ab08e9d",
      "text": "mampir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "942f891b1d668d5c4b1e5fd6d02d842d70d5b29d96624b7beb1724b16c48db7b",
      "text": "Terus?",
      "voice": "id_ardi",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "954252c11e89e6ee53d8fbff8220c5f1a494525dc4795c9b4ca30edbf363b208",
      "text": "Para porter membawa tenda ke puncak.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "95a95c948ac4de58fa6be7f6bfc739a4c86d9d7a0f6444921972ef57ca771341",
      "text": "Pak Sahdan porter terbaik di Senaru. Dia yang bawa tenda kita, kan?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "96d93bbbc8daabbf08abad12efe90b783618248c13b1c98e66072048e522d799",
      "text": "tenda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "983e774f453728b19954169794469c7d89a6eefe12abec47f471fbb42b57fafc",
      "text": "Udah, tadi pagi. Dia minta dibikinin akun juga!",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "993b8c2580818fd543a70677fe9d2a1101c6a29f08b807fdf3be8c00e6d659cb",
      "text": "Para porter membawa tenda dan makanan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c4d6217086aac6a6de3a639d3581da129a63561e31f4ec4f3d66e9a139893ab",
      "text": "menggunakan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cb11f6ae1867e0d39756ef70672fee657f9c89123c1e6b4c086e08c511c547e",
      "text": "seseorang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a038c2d448f81ef1ef7c48d692ebe2c921229c2ecc1d0c15756f5e12cf76af8d",
      "text": "berkesan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2606e418d59b9b3d9c690e0d2121af00cff07d63e289759a663557e52d0dfe7",
      "text": "Boleh saya meminjam senter Bapak?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ea0ebce1dcc7519e4a7851f7d35a2decb1f867ce93a3d0b5e2fe7f6de7b3c1",
      "text": "Mohamed, ini peta jalur ke puncak. Aku kasih peta ini ke kamu, ya.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "a960c5a05675dcee9b6528ba8e65ef08ffb4978bc91ef6276f0f23455b826ed3",
      "text": "\"Hari Selasa saya mendaki Rinjani. Para porter membawa tenda dan bekal.\"",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "affdd37f6a1f656e16580ecc17366d0ce4c91c946d2acf4dc3bc666921785b75",
      "text": "Luar biasa! Hari Selasa kami mendaki Rinjani sama Pak Sahdan.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b281e78417a222b1a474e23e0e68145eeaf24237b9f03a6a1a49b0218ac8ad84",
      "text": "gunung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b41ff7baa219f7ba4747d28e578c4f8845d8c939baf0ee7b311f64287915d8dd",
      "text": "Ternyata jalurnya tidak terlalu berat.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b439e42b7b18c6e44121d845a122d42edd6738ceb47719946e8a94913e74f51d",
      "text": "mengantar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4ea2221eb53cb3964417bd852912ce1dc830e076a4225b8bd71389e7a65bc26",
      "text": "Pengalaman yang berkesan! Sekarang, yuk berenang!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b54b1b0ae5bdf02e97d83947462998fcad7b213aa923493fac38447944e7bdb2",
      "text": "Rina, aku udah mengirimkan foto-foto dari Senaru. Udah lihat?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5a50775eb6953d3213af0d741ed63000b680586e84dc8420dc3486bb0203a7b",
      "text": "Mas Rizal memberikan peta kepada saya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b62f694a6264690de0afea68e4e67ebebc1f50e18eb56371c29cb66afc1ab576",
      "text": "Mau membuat akun baru? ___ di sini.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6d24f2d3d34fa5e13eef625cb27f60eb58f44f4f23cdf49a0fcc68907e7e855",
      "text": "Saya mendapatkan sesuatu dari porter itu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7cefe48a9e700bc9ddcff38209436b22f316577efe0da40bfb57df47c1c81f6",
      "text": "mendapatkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b935740768465f636fb2ccc47d71b587a78b17e5095213a54ab3c6fb7c4d01a0",
      "text": "Oke. Kamu udah menelepon ibumu?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c05b95983ff4373c53b5a0c846fad2fe9d206ed4947b3c8c7eebcb8c861a4076",
      "text": "Kami mendaki Gunung Rinjani dengan Mas Rizal.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1c90447543f000279249e904f9612dc971c01e2ba0571dbf29517a4e8158717",
      "text": "menjemur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3460355721caa97629226fce10c403817fcad48c21765e8cdc42b7a615f2252",
      "text": "Iya, seharian. Pagi aku mengurus izin mendaki, terus menyiapkan tas.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4b56416e20de0af9a61481c85e025c433e13f9e21071ab3444c428cb76b1971",
      "text": "Iya! Kami telah sampai jam lima pagi.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c65610e3f16e441236fad98ea94195a34a4bdc9d403305f316ae986036153cee",
      "text": "mengirimkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c79470ffe2f29c4227319e3bc7f9d6663f736a9449a3c9ff0950a617776a548a",
      "text": "Senin pagi saya menyapu kamar. Siangnya saya membayar tagihan listrik. Malamnya saya mencatat semuanya di jurnal.",
      "voice": "id_gadis",
      "chars": 113,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83cd00a55f11d2e695771e40d45d51620b7ca8cb75bddc3819f43fc10fc9847",
      "text": "Hari Sabtu saya menyetrika baju dan membayar tagihan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "c958a6aa8b23756ec1de07aabfc539e7e3da840c861900767a81815511a62f2c",
      "text": "seharian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9c464c61cb4e4ff6ebadd86a4dd48afd2209a251bb99d0d6b6a0d7c284b124c",
      "text": "Kami berhasil! Kami telah sampai di puncak Rinjani.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca48ad85ef665f7315a719fa1a47eefcd42cc447c323e8f788fe64237fdb1bf8",
      "text": "Jalurnya panjang, Mas. Kita tidur di tenda dua malam.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "caebcbe2f530ec9caea75d17b692c3d4c9b70a36d27067176b138dcd599456e4",
      "text": "Boleh saya meminjam senter? Besok pagi kami mendaki gunung.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbbc396f7bfb311c188fbbcad3bcd48045a8c3a896b7ffd2ff8d54c56a4c71c2",
      "text": "akun",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc393278c30b309c49f365a280c4b4da62630acb800a8efe1ff00ab4cb4be535",
      "text": "kunci",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd9e77dc710a5a2148d53130acdc65e1f631b7e26aa43121e6d5dfc670960b4a",
      "text": "Pak Sahdan, kalau nggak naik gunung, Bapak ngapain aja?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce001f6107159bb108b3083c959875c11f1642947b8c584f3906e4b94a2b0cb6",
      "text": "Saya membayar tagihan listrik kemarin.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce57d0e390786eddb5615e7d97c32b8773e18716e1c63dc7bc4ab5026c645da4",
      "text": "sesuatu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf2b3eeaa7e960f813596f0378000beabe3871be1db035da5bfdbe4ecd060cbd",
      "text": "senter",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d141ea9721f344007f83e834256b5540656982cf03230df26cd10f28240bb26b",
      "text": "Belum. Aku baru online. Wah, air terjunnya indah!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9cb5706fdc69b8087d7c529f7969608d0b27c98bf047f4329fc9cb970b9acdb",
      "text": "mendaki",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "daea589f0458c3055bdc13ade871632de5fc7289065cfdb0286c6691ceb8cda9",
      "text": "Setelah menyelesaikan pekerjaan, saya mampir ke warung.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbdbd6c288f85acdef0447660594bfae96fbd7de02b8658d50c877aeec4220ed",
      "text": "Setelah menyelesaikan semuanya, saya mau beristirahat seharian.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc038841f09870b4219a3f75b10eef6f31a4c5fd10429e08652a34bc6eb9b71a",
      "text": "Pagi-pagi saya mengantar anak ke sekolah.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e019ebdfc90153d66f3e950fef64aea23ead39247b9ea12ae948d5d4949793d6",
      "text": "Pagi ini saya mengurus izin mendaki.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e381d5de061adfea757e0402e90b11cc4ec61b5913927c74f1c6bffbd19faa71",
      "text": "Ha ha! Seseorang di sana pinter banget.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e547e4b9ce2eda3ecd63b7bd55bf8e7d9a3d7d94df274235aff32e1bb6299fc4",
