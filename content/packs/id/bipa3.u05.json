{
  "format": 1,
  "id": "id/bipa3.u05",
  "language": "id",
  "unit": "bipa3.u05",
  "version": 3,
  "content_hash": "51ce515df540a3b6c167db48358fa6a54e13410566415d2dd6f4be688f7d9378",
  "lessons": [
    {
      "id": "bipa3.u05.l01",
      "sha256": "2064615f4d01ed5c2dbb52cec8ba9eb4407421f7a6a14f0faef1071dd745dd84"
    },
    {
      "id": "bipa3.u05.l02",
      "sha256": "ea5af55683e3af59f73668fa31fa5eaa5fba450d1adf39351b59d92c60ccdbb4"
    },
    {
      "id": "bipa3.u05.l03",
      "sha256": "2bf23e17c60d2060e212df5e17c34b0e71c9559274487a1c4a81dc52db12481f"
    },
    {
      "id": "bipa3.u05.l04",
      "sha256": "dfad83d9d707d2d52e157892dd870162c066970b32d27d97946b035fe4e77074"
    },
    {
      "id": "bipa3.u05.l05",
      "sha256": "b58ca1a63066472afa838273c190a34771ed5771c7b258cfd40482db403f642b"
    },
    {
      "id": "bipa3.u05.l06",
      "sha256": "4bd9f0d1bd2a4b624a64d7f413939f57732b57f9812e86384c0dbf1b445773d8"
    },
    {
      "id": "bipa3.u05.l07",
      "sha256": "76356ea2688142946958fd5946c499a60f52f6caf3fe7fb892cdb00652d904e3"
    }
  ],
  "audio": [
    {
      "key": "00f446d82715240e395b6110811e734c0ff579534bd2c72ee6563bb605212004",
      "text": "Pada hari ketiga, sesampainya di puncak, kami melihat matahari terbit. Pengalaman itu sangat berkesan!",
      "voice": "id_gadis",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "0124dbdc970036032db37d32494c2176b56dd0f661f9cf6391e0ba59a44abb12",
      "text": "Bagus! Coba baca satu hari.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "030e446ab95c8b78d46e10c8540fe118f328d59c8354d0a8e7c538c1d9571bad",
      "text": "Siangnya?",
      "voice": "id_ardi",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "031b0d21fe54be7cfffd735cb9483b9a4e324458c4a8de7d1c0d3a22b33eea49",
      "text": "Lalu?",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "03345cd359a3caa521551575719e2f3de0e37587ef5d3e56557f59c691707b92",
      "text": "Istrinya memberi kami bekal nasi dan telur.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0415a796fb7a4f5112544467c9c18acb68cb9f805032eb260e6d4ba2cb432101",
      "text": "membayar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1032eda1c294dee1dcd07d63109f3e5bdf6fcb99d28659f5d407dd368c42a9e4",
      "text": "pengalaman",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "10dc119c5ce6bc98157e587ff6cf431b50b513b9a9b6e99d38040c3e7f881cd6",
      "text": "Inilah air terjun Sendang Gile! Bagaimana minggumu, Mohamed?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "154f64e27238e6514dfcdb03161e4edaa6b13cfc7bfb2383b2cb69092dd02452",
      "text": "Jurnal mingguan, Bu. Saya mencatat kegiatan saya setiap hari.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "18d8c48ff908232a3f6f53d7bb2c436a5b6da345bec694778340092c1973653e",
      "text": "Rina menjemur cucian di belakang rumah.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f0aa63c4c8e974a3a5e354e8a6c6590c40c0988db1e8a3fb67a96f5cb45cf7f",
      "text": "Kami pergi ke Senaru. Kami mengunjungi Senaru.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "21751a2601f5dd1fa7e784611d7193c53ff0fc1cbdc57912c44fbd60a96f628c",
      "text": "memberi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "21b5f7410ced5a679d768832190f29642f7363d4812a7bc5472354fe12f549b4",
      "text": "Bu Yanti memberi kami bekal nasi dan telur.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "246e16056278ca2743fd42ec8bc57585f082f00fff9e01919114b1c74b29eff0",
      "text": "menyetrika",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "25e0f0bd2fd4a46107212a5cfa6d3c7c4831d13d9190946f94c9183692f30cfe",
      "text": "Pengalaman itu sangat berkesan!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "26f647dac932c2a3451374645fa2e580f5126a374c2a974b697b2872674085c8",
      "text": "Pak Sahdan, kalau tidak naik gunung, apa kegiatan Bapak?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a1e0e0d1219af64fe2d22c751daf4adef680f521eb3b100088c7242c430cf2d",
      "text": "mencatat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a7c6f6c6f8fbe1b871f1a135fdd20f91f1622e7e645bd76fd563fe1bc2309eb",
      "text": "Ni Luh, saya membaca blogmu tentang Rinjani. Bagus sekali!",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e8b337e1969340c8336783e57524e6b9c173ca3d6790d97488d849cdde80c79",
      "text": "cucian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2efa0bf1c39b7544a5bf2ce5427e1a9bf51a2fd8c6c850ec8f3e072f41ec585e",
      "text": "Wah, kita siap mendaki!",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "311213666054887758006a58f0614c2a5be16758d8bbddc8ae594ca2d1035a88",
      "text": "Terima kasih! Kamu juga mendaki dengan Pak Sahdan, kan?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "34fc1e01703487a3d433d7b464f5f005bc2ad75a9820f5c28819476a6c41bc37",
      "text": "Pengalaman yang berkesan! Sekarang, ayo kita berenang!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "38717015a1e3980bbc1ed4d3bf21f5f9f01ed55a01b0055569cee9a55264f5a7",
      "text": "Pak Sahdan. Dia porter. Para porter membawa tenda dan makanan.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "38d9dec81bd3a7c589674af4bce1b5fb4db609afda1c6b5b9bf412e7a844b5c4",
      "text": "Jalur ke ___ Rinjani sangat panjang.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c1cbd09bf264b562610ded63682b05744ff0d0a0bd51089d1ae57768efd972d",
      "text": "Mohamed, bagaimana minggumu di Senaru?",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d0260f29abd5b50ac1a499eeb27db4158c834948aa114c070ff66710b405ae9",
      "text": "rutinitas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "40704a6dfabba8bdef2d44e5c2ebc0e845afcbe1ec84f25277e73c6f7ef9cb09",
      "text": "Luar biasa! Hari Selasa kami mendaki Rinjani dengan Pak Sahdan.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "40cf4a63f6e430d1370e2abfa144742a6379fcf4800fd096e5ccedef5ae8514b",
      "text": "Kami ___ air terjun Sendang Gile.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "421fd987921ea65e2083cd0c52eab4072b642314fc96fa64adceff2f34efaa72",
      "text": "Mas Rizal memberikan peta ___ saya.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4360895eb33071334e21fade756b54e3a5f5ed4fa4ac8179da8cab72079fd867",
      "text": "Mohamed, ini peta jalur ke puncak. Saya memberikan peta ini kepadamu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "43c699c8a1229c39107a1a0ecd2a9d122498333140bd42f1d454ee36f5c7e5b5",
      "text": "Pengalaman itu sangat berkesan bagi saya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "45ca0d739888e6d8993fadd990a13a33a58473352873a5705cc135fc4a67c956",
      "text": "sesampainya",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "46a53b73326aa97cb2feda5cd83f4f5fa1b6a2e3da177cf0f43ca9418e11db3c",
      "text": "Lalu?",
      "voice": "id_ardi",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "46cfc2887a2908ebee6b021112b22c7acb524286944cad344cd0f0181f654529",
      "text": "puncak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1efbd703726f1fb3686b07a07b423768e2350d11d325bcbd56cbc8afa76346",
      "text": "Raka menyetrika baju setiap hari Minggu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de06787c5a4ea0357675e788683bfd867dc26daf4f9855d5e94bda819fbbc12",
      "text": "Siang saya membayar tagihan listrik di kantor pos. Sibuk juga, ya!",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f254a577d4b23bf22721b637b16213bc67f2306f8f043863b70ee319bf3ae27",
      "text": "Malam itu kami tidur di tenda.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "535509761983e08cf1f931dfeca3c668439e2b09b5c71b4364a346658c3d1ea6",
      "text": "akhir pekan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5712a84c9a9b410e80d815974407a28212bba7e209de67e7e804267ec8a1c5cf",
      "text": "Sesampainya di puncak, saya melihat matahari terbit. Pengalaman itu sangat berkesan!",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "57bc4e57c2987f16e2accb408efd127f1cca1533b5b7421cd6991dd47ea5afad",
      "text": "Hari Jumat saya mengantar Rina ke stasiun. Keesokan harinya saya menyetrika baju.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fec8a327a221c9f9542c35d6a6914cbdc2c914bd716a1b1ee813c0ffabcbf26",
      "text": "Setiap pagi Bu Yanti menyapu halaman.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "66d740aa69ff50ae8b2e9f9eee45b982a0a5ca63e6e5868e59b038401f47e38c",
      "text": "Hari Sabtu kami tiba di Senaru. ___, hari Minggu, kami mendaki gunung.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "67656287dff7d5ae3c085c27c26ea96439296e6e4ac9ce4dc17cc7905158ad09",
      "text": "jalur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "689dc32506739575b9eaae41a6d894f04c986839aa38675f85eddf12503b17ec",
      "text": "Terima kasih, Mas. Boleh saya meminjam senter juga?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9b41b1b9ff6242c45ca8a2d0b7930d334ab051c494aa439dcb93fc0a8de69d",
      "text": "Kamu melihat matahari terbit dari puncak?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fa75fa844336ee17827dadbdafb187072d6c47c836456d9720eea53f8399bdf",
      "text": "Pak Sahdan porter terbaik di Senaru. Dia membawa tenda kita, kan?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "703c7c42236d13b67e12852740bca7f67872a2f7da6a09f1c1cf111a2579e96f",
      "text": "Keesokan harinya, saya mengantar Rina ke bandara.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7415365c42399a51d103ea41dca0bac91541644e40b4e49a0b67f03d678d265c",
      "text": "Pak Sahdan memberi saya senter.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "764127858ad782addd642994d74bdf955d60241ed89a183cbadb02537ff23417",
      "text": "Sesampainya di Senaru, kami makan siang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "7826a71041362d3450c5c4385f78411e26f8b26677928b4e8a98b96776abd1fa",
      "text": "Mas Rizal memberi saya peta.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "7888e90acce678c4dd01fbcff3b031d6af80e829439c518d7bee93293e6dfe5e",
      "text": "Akhir pekan lalu, saya mengunjungi Senaru.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "85ee0f8ace638038fc65f8ca7a6c231abb2b2aee15837b8f5fc6f1405830c29e",
      "text": "Pak Sahdan, porter kami, membawa tenda. Istrinya memberi kami bekal nasi dan telur.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a7d862c7c7de969ff89081220314b15802e8488019ec0fd64e5a8e40d3cb127",
      "text": "Rutinitas saya di kota sangat sibuk.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b94cde704b6851fb695a3b3d8c0565a20c04afdcaa00495311d6dbdfa166dcf",
      "text": "Keesokan harinya, kami mendaki gunung.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf316dc60ebf3bccc702029351f0e1e1b0dd02cb9f2af621b356224ac5d23b2",
      "text": "porter",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f6f562a6d3c188710b86eba20914def6bcaf32551be1561610c196680ed6156",
      "text": "Ya! Dia membawa tenda kami, dan istrinya memberi kami bekal juga.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "954252c11e89e6ee53d8fbff8220c5f1a494525dc4795c9b4ca30edbf363b208",
      "text": "Para porter membawa tenda ke puncak.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "96d93bbbc8daabbf08abad12efe90b783618248c13b1c98e66072048e522d799",
      "text": "tenda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "993b8c2580818fd543a70677fe9d2a1101c6a29f08b807fdf3be8c00e6d659cb",
      "text": "Para porter membawa tenda dan makanan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fff9f1d58028267af36cef98bef57f5ad88b00f5cfe5bd3448c71448008c31d",
      "text": "Saya menyapu halaman, dan istri saya menjemur cucian.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a038c2d448f81ef1ef7c48d692ebe2c921229c2ecc1d0c15756f5e12cf76af8d",
      "text": "berkesan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2606e418d59b9b3d9c690e0d2121af00cff07d63e289759a663557e52d0dfe7",
      "text": "Boleh saya meminjam senter Bapak?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a63ba85f915cd64492681daafee5d809c98d970f10c964eab44569c4966dd1cc",
      "text": "Ini senternya. Bu Yanti juga memberi kita bekal nasi dan telur.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "a960c5a05675dcee9b6528ba8e65ef08ffb4978bc91ef6276f0f23455b826ed3",
      "text": "\"Hari Selasa saya mendaki Rinjani. Para porter membawa tenda dan bekal.\"",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa9f58aed25affdc62f4874e10afdd2c2451c7c605811d35e3a66c74edeb3b1d",
      "text": "Mohamed, kamu menulis apa?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "b281e78417a222b1a474e23e0e68145eeaf24237b9f03a6a1a49b0218ac8ad84",
      "text": "gunung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b439e42b7b18c6e44121d845a122d42edd6738ceb47719946e8a94913e74f51d",
      "text": "mengantar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5a50775eb6953d3213af0d741ed63000b680586e84dc8420dc3486bb0203a7b",
      "text": "Mas Rizal memberikan peta kepada saya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b80dd54cc27838a32a594ad117f30b0756d60f6958235bda5748863d17b0643f",
      "text": "Wah! Saya ingin sekali melihat puncaknya.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c05b95983ff4373c53b5a0c846fad2fe9d206ed4947b3c8c7eebcb8c861a4076",
      "text": "Kami mendaki Gunung Rinjani dengan Mas Rizal.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1c90447543f000279249e904f9612dc971c01e2ba0571dbf29517a4e8158717",
      "text": "menjemur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c79470ffe2f29c4227319e3bc7f9d6663f736a9449a3c9ff0950a617776a548a",
      "text": "Senin pagi saya menyapu kamar. Siangnya saya membayar tagihan listrik. Malamnya saya mencatat semuanya di jurnal.",
      "voice": "id_gadis",
      "chars": 113,
      "mime": "audio/mpeg"
    },
    {
      "key": "c83cd00a55f11d2e695771e40d45d51620b7ca8cb75bddc3819f43fc10fc9847",
      "text": "Hari Sabtu saya menyetrika baju dan membayar tagihan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca48ad85ef665f7315a719fa1a47eefcd42cc447c323e8f788fe64237fdb1bf8",
      "text": "Jalurnya panjang, Mas. Kita tidur di tenda dua malam.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "caebcbe2f530ec9caea75d17b692c3d4c9b70a36d27067176b138dcd599456e4",
      "text": "Boleh saya meminjam senter? Besok pagi kami mendaki gunung.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc393278c30b309c49f365a280c4b4da62630acb800a8efe1ff00ab4cb4be535",
      "text": "kunci",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce001f6107159bb108b3083c959875c11f1642947b8c584f3906e4b94a2b0cb6",
      "text": "Saya membayar tagihan listrik kemarin.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf2b3eeaa7e960f813596f0378000beabe3871be1db035da5bfdbe4ecd060cbd",
      "text": "senter",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9cb5706fdc69b8087d7c529f7969608d0b27c98bf047f4329fc9cb970b9acdb",
      "text": "mendaki",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc038841f09870b4219a3f75b10eef6f31a4c5fd10429e08652a34bc6eb9b71a",
      "text": "Pagi-pagi saya mengantar anak ke sekolah.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e547e4b9ce2eda3ecd63b7bd55bf8e7d9a3d7d94df274235aff32e1bb6299fc4",
      "text": "Minggu ini sangat berkesan. Saya mencatat semuanya di jurnal.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e77c7f57779860475c9a6ba8265a4593d9c9fda0be93254b549a1e5d608e483b",
      "text": "tagihan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e795fb66c4fab77c41be778025818482c9261a67da8ba671a91d3dccc46ba283",
      "text": "\"Keesokan harinya, saya melihat matahari terbit dari puncak.\"",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e86037723b259857333560211a334993e13ff4fa2ebadd8f6d0307dc9c1d6bd5",
      "text": "bekal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee9b0e0246fdf3e39fc01b4ca5d157202697fcfff31215d07b47104fe5327625",
      "text": "keesokan harinya",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f00b0236646988c9eb7bb811f40dc73fd4a84bf474559d0c25a02bca54d2231f",
      "text": "Boleh. Pak Sahdan, tolong beri Mohamed senter.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0913417049c790bf5fb07ae2d0ef6f55fa4bf3996e92fc7ad1f280899fd0d04",
      "text": "Keesokan harinya kami mendaki Rinjani. Pengalaman itu sangat berkesan!",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1d3fc8989387d932b923d2e90ed2edeaa8f3edc319317b43a9e3d6c88e17271",
      "text": "Saya melihat puncak gunung dari jalur ini.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f200cce6fbf89631fe2b93efc02df643962bd8a7e255b8f04ab71a0ddb97fa1c",
      "text": "memberikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4995b441749ac9256e9a2767f167234c9ea9d4e456e870ad7b8c37f3cc39911",
      "text": "meminjam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f650ede8ef2303a558dbb80bbcfafd76f0f55d0a2460686b9ac5d86d8bb5cc2d",
      "text": "Selamat datang di Senaru! Besok kita mendaki Gunung Rinjani.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "f66d4be52ca44c077732c0f8e0c5a6c9dade5c986b12115dfc85751247284d97",
      "text": "Siapa yang membawa tenda?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f975784562e1b2254888b28dc2f0fb79e91bcc74d9bddca8809fe820f6cd726c",
      "text": "Ya. Sesampainya di puncak, saya diam saja. Pengalaman itu sangat berkesan.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa70792283b541560f9fa20babb2d1b5452260a2f496f3be2d2a01191ac61b3c",
      "text": "Ya. Keesokan harinya, saya melihat matahari terbit dari puncak.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc2eb2b026a4f3825437c7f1dd50337881ac3820b26c7f3a0692df5aba6d14e4",
      "text": "Kami ___ Senaru kemarin.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe64687bd431958ff13f521e371caa6f863554091007212a287203da89861450",
      "text": "Pagi ini saya ___ adik ke sekolah.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "fea7477baccc0af7032b4529280d2b719a97b908d387ccb2483a1468c6c24838",
      "text": "jurnal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff20e32928c98396044067a74ff6947822aacc6d5a703a40b514cb832459ed80",
      "text": "Akhir pekan lalu, saya dan dua teman mendaki Gunung Rinjani dari Senaru.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa981189c0852a5862a605061a06c527286907a3a6a31d78a1b8e30ccebe652",
      "text": "Seru! Hari Senin saya tiba di Senaru. Sesampainya di sana, saya bertemu Pak Sahdan.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    }
  ],
