    },
    {
      "id": "bipa4.u06.l03",
      "sha256": "d1ce6721bfd6fd70d1f965258d6edf74a5efaac33d435eb4d85a8f3d871d28ee"
    },
    {
      "id": "bipa4.u06.l04",
      "sha256": "0d5029cadf19d6f4eb21fd478d3f2fe194622d46b2722981d6fbfb7f309eb46a"
    },
    {
      "id": "bipa4.u06.l05",
      "sha256": "44de46cad14c5b3cc07391848d8d75c931f36ece24ed6eba46549bf89fe94835"
    },
    {
      "id": "bipa4.u06.l06",
      "sha256": "63b8f10969ad6c96466da01882482dcb65964df64fc0ffb18b420a3110630a3b"
    },
    {
      "id": "bipa4.u06.l07",
      "sha256": "a67c751af4f6713e0f1abbbd6eb0fd0235e5cf43501c0f77e2fd4f81a093680e"
    },
    {
      "id": "bipa4.u06.l08",
      "sha256": "1133385f0bef60ca89701cd655c25c4b32d572af911e49d13d23993f512f094a"
    },
    {
      "id": "bipa4.u06.l09",
      "sha256": "0a1f048cb69c0a9c8b388b8b2fa9bbd3f39bef96ff9c276a66bfb8e7e00196d8"
    },
    {
      "id": "bipa4.u06.l10",
      "sha256": "1fbfa5aac12be8d9063b233927cb6233f3eb3835810effc98c9b36b7a24c3aac"
    },
    {
      "id": "bipa4.u06.l11",
      "sha256": "a4d608482f2665fae80cc0e10293ed17cdaa0ccadafafcf8c9a491cce83793ac"
    },
    {
      "id": "bipa4.u06.l12",
      "sha256": "0a0c8a0c2c9483357a75af408fccd44e68bfb08a7513866d981e38b6fb13f733"
    }
  ],
  "audio": [
    {
      "key": "01484584d2750e78bc593809c77d56a1f684dd14fc41a8b6dd96f70d0418bc0a",
      "text": "Kami berkeliling kota dengan becak.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "01488584a42a0ca3bdf45ec4bb12e96bf6afd31d3a4aa85d99e5243ef85a9130",
      "text": "Saya berpendapat bahwa pariwisata penting bagi Palu.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "02264796ff18652fd640cf6f2c580898f5edba883ed50d458b4c014fd97ee35b",
      "text": "Panitia mengadakan pertunjukan tari dan musik Kaili.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "02dc9413a02531608bbd5c7b8772aafea199cb4fe8d42758a1263774c3a01270",
      "text": "menabrak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "030ed0c1ab1aa96cbc4b0f5b40ad9a3761b0a3130e102d10879144e10d7f86d2",
      "text": "Dengan demikian, pariwisata harus dikembangkan secara berkelanjutan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "03eff3f47b04aeeb06fd8c07153a8b2a5c905d20e075d1c7384fc721a5957a36",
      "text": "Udah. Katanya airnya bersih, tapi kadang ombaknya tinggi.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "0407537395131c8f9c3585d681450d415bc0c76ce0e35b707e0a8ad6f5385570",
      "text": "memecahkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "05cb8f2396062bc0eb2dcd2a6e60155949f21603a7131575c5560b94bb6f888c",
      "text": "Sayangnya, hari kedua angin kencang dan ombaknya tinggi, jadi kami tidak bisa berenang.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "0771532363985fa38f9e7b032be66b591e714dafd29d0d4f99abba2483a88451",
      "text": "Pemerintah kota dan panitia dari warga Palu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "08f404ebc0b8427b41bbf566009a0583dcbdba97442d781d5aed61f55d098681",
      "text": "Festival budaya menarik wisatawan dan memberi manfaat bagi warga.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a59696f394e996f3fa2e1561f559b49e3bde60eee354e6adfbe6d2e4296e471",
      "text": "Wah, hujannya juga deras banget.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d74c01f7cd71889e59040cf33c623690f75f1c06901a985a3c4ba6d09b57db5",
      "text": "Pariwisata meningkatkan pendapatan warga.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed0f1559dfc4c6cf80f05526addf88cfa1894f0f3d8cc00809f9b4bc072a34e",
      "text": "Betul, semua orang boleh datang. Panitia ingin semua warga ikut.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "11ea8fe0895a8e1755c8853babf925c3513594cb7f5a0e5d1060a34cfe98ad46",
      "text": "Ada diskon buat mahasiswa?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "158eeff24ca31122915220690a63887f837e07deeb7aa2e12114de5ce7b48d7a",
      "text": "berkendara",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "172fe8ee39316bd7f8fe73aa0255dbdc0085a32a06a40f21423ecb92261e5f2c",
      "text": "Kemarin hujan deras, jadi pertunjukannya batal.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1aff2f3c43a55a991c3e022c084ce8d98b6d2d9a32ec3ba573bf9de53bfffc81",
      "text": "lembah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d143123bd88eefe7b3a1664134a55b2df22576d3c83b7b01f9574bf54492499",
      "text": "Pedas atau tidak? Sesuai ___ Anda saja.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dbd165d4d93096fadc084b1bf9b7a74c0d9a879aee01eeb68eb6722e709ce8d",
      "text": "Karena festival dan pantai di sini menarik banyak wisatawan.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dcd1034ca0e9172dc0caf71cad76520bbc6bd73ba77eba4fad531f01a75e212",
      "text": "rem",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f86ec937ee5290f5e04f59cd0af2c4b64da3547b9ed2f985cd582920a8924c8",
      "text": "Bensin hampir habis. Kita berhenti di pom bensin dulu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fe628ebede8957243c8abda5bc579f81cb8197fb5f13c3e894a6c451d977e6b",
      "text": "Pariwisata berdampak positif bagi ekonomi Palu.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2331f7a63c4cf51ede4190fec8d07f8bd3c8f8f0cb4b9fce3bc9da0911aaf8e3",
      "text": "Di poster ada kaledo juga. Itu apa, Bu?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "249959d1888d0cd8bb55b22790f7395dc6db31f506d010be41b79d23c5e9fc32",
      "text": "Bisa, tapi di Indonesia mobil di sebelah kiri. Aku takut.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a150e4fe0305d9571cb16d942542bc13f18f7b261984cd686ad499147355525",
      "text": "berkunjung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc7a0bc6e95e85600841804b211dcecca765a9ea504564a700d02c59273c74f",
      "text": "Kamu udah dengar ulasan wisatawan soal Tanjung Karang?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d86425be35f1cd5e295cad3b593f86e3722efeac9f36ef314bbadb162f908a3",
      "text": "Festival ini melestarikan warisan budaya suku Kaili.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e82452da43f2e26f0f639189e0e4ee05f9aca456a0145699c3f785bd1badc80",
      "text": "Mahasiswa dapat diskon sepuluh persen.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "338d130e81fcc9ae6e0c558693062d1c050f112040c3e42076636255977566bc",
      "text": "negara",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "379019a6b84432e82739f8bff4cd0404bd782563a8d262d8408b76275cc349b1",
      "text": "Mohamed, besok kita berkendara ke Toraja. Kamu bisa mengemudi?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "384a14a786054e5a985db146acda79b4da0c515fa081361aa67499a791108833",
      "text": "Nggak apa-apa, aku aja. Kita lewat tol dulu, terus jalan gunung.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b06e96e5ef76282588310e5aa96973080f69483b0e68370a2c5fffec92078ad",
      "text": "Ide bagus. Aku juga mau makan di warung warga.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c7fcc4283f33f817b3798266b2a6b02f6291a1cc6a47034913c12ec3250121d",
      "text": "Di sekeliling pondok kami ada banyak pohon pinus.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d6c28d05c04394183a18a07c6e081819702b916251ee58ae30607802c09de54",
      "text": "Mas, kita jadi snorkeling di Tanjung Karang hari ini?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eb7ace4177c66e0bdc524afc99a7a9c4d2a07f88d112d70c4df71a02f1dcb73",
      "text": "Anak-anak pramuka tidur di kamp di dekat hutan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4012ca84bdfa56ed9c55346be02afb43112cc6316ce6924e2aa3c7bf41ce1f29",
      "text": "Jadi kota ini menghadapi tantangan baru, ya?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "432bd07818862d731fbe7786349f4d1442daf56e215dbfa6beaf14edadef26fc",
      "text": "Saya suka bepergian, tapi saya juga perlu kenyamanan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "434abdce54e5ef989f8c78467635f03eeb988b45ef005a1638e45bc231a8502d",
      "text": "seharga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "455ffe719fbfcd0fddf8f09d67da2ccda2a11f5a61323845050c3d0cde7f7a96",
      "text": "bersantai",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "476db89c5981c7ba662b89b480459bcd7dece7fe65afc10653306a66f4360e2d",
      "text": "tur",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a12c8ee1d173c94987d42fc5fed4c743a98fc4c2f6375f261cdcd02ea262421",
      "text": "Warga juga dapat manfaat nggak?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b542991d73a28c4e7f144f7704ebc41dfc244869b90f06a3819c9baaca26a6d",
      "text": "Konro panggang ini sudah matang dan aromanya enak.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cf01b44c1395c70429fb25303e5c4477febe7a912ceb8229b650bfef8728568",
      "text": "Hari ini ombaknya tinggi.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "516851a48759161b0fa9fc65f69f200c4d7140ad260761d5cad76c3d42b43d5d",
      "text": "Konro panggang. Iga sapi dengan saus kacang. Aromanya harum sekali.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "520550d23af26b69301a4794b2a2e56932423ded68b4479726637b7fc5dedf60",
      "text": "Festival budaya menarik wisatawan dan meningkatkan pendapatan warga.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "532b5be7ad3a7bf0c69e35923632fe927f451c76a101e373a7657fae5705b757",
      "text": "kamp",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "57b0a6ca590fa6134d5f7d6ce42d3324e72876aa51d686918b17aa8367c176e5",
      "text": "Mari bersama-sama melestarikan warisan budaya Kaili!",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "57cbc738e75889b383c8d3e822ca2b4b57a4fe5465e0dcd87ce9ae96fc604639",
      "text": "Boleh saya lihat menunya? Saya mau hidangan khas Makassar.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "59156c994dc22e32763f5985c23fe01f888ba23367ce02dfc51e211ffbbc4eed",
      "text": "Dengan demikian, Palu harus mendukung pariwisata berkelanjutan.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c5c232111c6122f534022b538ec18b3a2fe8c7348ccd01656d5479f6555500d",
      "text": "kental",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d76a4cb72d7fcc2e512216b74448f6929c272edaa8b441804c8e73c982641c6",
      "text": "mengemudi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5efe63eaab8eb749873da228cabb2312c24ad45c706527ce1bf20c6daf99fd6c",
      "text": "Hidangan ini pakai saus kacang yang pedas.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f39020c6a2b7415434ca33966477b81f1bf2b3d967e7c44b83883e067da5203",
      "text": "Bener. Kita cek cuaca dulu sebelum berangkat.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f99cc05540d20f699854d8ec18a68951f8aeb20e04a1186140af9e41333135d",
      "text": "Ramai banget! Siapa yang mengadakan festival ini, Bu?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "600fad2d84295dba09ace3b072c7ffa5b17f110b2efdcb5df26cce3bb99e9c95",
      "text": "Pariwisata meningkatkan pendapatan negara.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "629ebe329942f1e9bd91d9de3bc9d6c83fc23ab849db439a6e2e5fae49890848",
      "text": "Tetapi dampak negatifnya juga besar.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "636e5f9de7bd5115d3a48ed23c1501a90361446ad759fd73af184dd5ad85f7d3",
      "text": "selera",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "63dd3ba6af1926e58736cc2578457286566b0882f15c9b8ec8d2f449ef0d82c9",
      "text": "Akhir pekan lalu saya ke Pantai Tanjung Karang di Donggala.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6508c6781f0d6ae32b1297a7486ad94ec082c5142b818c21e3a4c1ebac054d57",
      "text": "Bagus! Tesismu apa?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "668461d0bb6d7b26b3ce27bfc0e637e0cb6c581a8f54c07d27c7bb5a958a63e4",
      "text": "Hari kedua angin kencang dan ombaknya tinggi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "67f2e7d5247b36413837b37e4c9e58e879bf4f40fc41f6cf6433e43914c2454a",
      "text": "ketenangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "68a3d72e1108d915f9e3430bd53770300eed45f71142263a678d2b6c596b2693",
      "text": "Dia belum bisa ___ mobil. Dia masih belajar.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae6f6de6a233933f3e479695e3aae09daf5a75efa63f1a7fcb0069c8d0519d2",
      "text": "panitia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cffe4006d5aff254aa8b5d231d88b357863cc51675978bf570baabf62af8ebf",
      "text": "Pertunjukan tari Kaili menarik perhatian wisatawan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e09c442eff0d74cc46e9d44ed223b6ae42ceac1c513028e9425431c945fee46",
      "text": "Dampak ekonominya positif, tapi sampah di pantai bertambah.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e7cfcad003f9bf6b4fde4020878cd8b49d2d894475c2c12c58753c3bdd8e2cf",
      "text": "Menurut saya, wisatawan hanya membawa sampah ke pantai.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f33ff3923f56165190919d4b12c9c097b667f93f83406decfc1500f050889a6",
      "text": "Toraja hampir tiga ratus kilometer dari Makassar.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f3c580289d983ea54d559813f170cbf5fab5106baf851a5c20c8f558f8b2138",
      "text": "Terus, kalimat terakhirnya gimana?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fc8e4e89e882c8f3f90241e650e11272945bbf42eb603bd8bf7d7f55177d79b",
      "text": "Sektor pariwisata dapat meningkatkan pendapatan warga.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "711b188f3b080ae6af9df0a4127563c77fcdebee331e778c596ddf59160b9263",
      "text": "perlengkapan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "712a04d11b87da8d097fbbcab0122210434678dc3a73a99d9fa0d6b82abf547f",
      "text": "panggang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "71402287af68a86d7858915da52655729df24d8a84c936a05a69ed81759d0326",
      "text": "Dari sini lembah hijau terlihat mengagumkan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "714f2000ca2ab959e48393586530d75a93d80743627af57b59785062430ace95",
      "text": "Busnya mahal, tapi ___ penumpang nomor satu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7410e3a4ffefe46caae187046862af3e315b237d9dca7571d7fe7bdf079d2d20",
      "text": "Akhir pekan lalu saya ke Pantai Tanjung Karang di Donggala. Airnya bersih dan biru.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "74292a6517912a2498ea37f4270821822f0a17ce0d64dd8872c97c447f144f1b",
      "text": "melestarikan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "76374a1c216b04b30bc396023c040604c8499eecf41f1b7ab6d04a6b524f2a3a",
      "text": "pondok",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "789eb2af0eb9f6e4edb0cd4bce8daaac53667cbaa8b2d7c485b3564e142f5b4b",
      "text": "Terima kasih. Hidangan apa yang paling terkenal di sini?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a6b2e92aaaa7d3ba6e39fa32f0d0ec614e5e5237948defbbe32be17cee62996",
      "text": "aroma",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ba49e580dcca2b90c871c1ed478c866abd12197a89bc16d2ddd525af14303d7",
      "text": "Anginnya kencang dan ombaknya tinggi, jadi kami minum kopi kental di hotel.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dc1b4dcef4d1a2c7689162bfd3dbf8cc707dcffe18088d5261a04406efe1d5f",
      "text": "pertunjukan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f0958882fe6421119b820ca83572032117dcd4c14b9fc3cb6fabfce7e486fe0",
      "text": "Saya pesan satu, dagingnya yang matang, ya.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "80f4bb95d2c15e294e7fc74a517825cdbad08fe8f823bc091c824bcc1d62f863",
      "text": "Pariwisata berdampak positif bagi warga.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8533450bd39938fa155b94bade7625a88e13c8dc28fe99b512cf7d4b1b2f7d02",
      "text": "mengadakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "864d39c2ce824447d7d75adc192353e4e1a52702c5016fec05ebe7998b013c68",
      "text": "Betul. Kami ingin melestarikan warisan budaya Kaili.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8679524963a2aac1976e8ff8916d9cfd5eb9dac392dedfb1a1347aa324cda88e",
      "text": "Festival budaya menarik banyak wisatawan ke Palu.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8adee6d36b8dabc66c41fa1121200afa1c43b8e43093a5d94428e7552bc6af13",
      "text": "Selamat malam. Ini menunya, Pak.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dc922e979d0b10b69032084f69c0b41189b280a654f789d562471cb3390e0d0",
      "text": "bonus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f77f4ca1f2ec53a73ee6bb97d49e36f6873c6bbad091ab1609655f5aa4e7dd6",
      "text": "Ayah saya mengendarai motor ke kantor setiap hari.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "90e9542aca8fe6ef83cb603c70e3a75c05821cfbd9277ef7a746fcd673de3a1b",
      "text": "Aku tulis: \"Saya berpendapat bahwa sektor pariwisata memberi lapangan kerja dan melestarikan budaya.\"",
      "voice": "id_ardi",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "92f063a1d341c54d12d0e8529b52bb9a1ec82503b49293b8d924f0bf3e707d60",
      "text": "Kemarin hujan deras dan angin kencang di Teluk Palu.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9393be516d0cfd0d13d6c43f4a6575e66892c7fd9daa654c6df2fd0067eb8383",
      "text": "Pemandangan dari puncak gunung itu sangat ___.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "93d99ca36255134c79c3615aeec40d9444044d4fbb2be9de25a71c6f01673322",
      "text": "Berapa kilometer? Bensinnya cukup?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9411e49d226919b32de3ee6988d832e5410eb1b30690f7b564704bef8ca0a537",
      "text": "Wah, saya mau coba!",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d986ae1a6cbf49f731f0702add3bcbdba8d49677554a7d6d04f3a6a0f53bac",
      "text": "Selamat siang. Mau bepergian ke mana, Pak?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9747f2d7fb29ef8164b57aad9647f5b66a6387ff7b68f197a761ec8df2175198",
      "text": "Dagingnya sudah matang. Silakan makan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9872937a91612fb662dbbcb061f24bc991bbd545fc7c4c6f93794652e2485e6f",
      "text": "Saya minum kopi kental supaya tidak mengantuk.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "99902347f66ef17a3cd2c3e7e9dbe94bef1c03695750dc6a6e7d63bd428f7d92",
      "text": "Kita menginap di pondok itu, di tepi hutan pinus.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "9af77f36a264bddb59e7135acdd253fc1cb9693766c417d3b07956f2b97e6451",
      "text": "Pertunjukan tarinya menarik perhatian banyak wisatawan.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cb24c84bc28d73353138b6db74a51fe820ed02ecbba9e719236fad176770b5d",
      "text": "Kami lewat jalan tol supaya cepat.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d2d5de990e42818dabe37ab6a58d8e4f6e1204eb757b125bc8215fdbcea509c",
      "text": "Selamat datang di Malino, Mohamed. Udaranya sejuk, kan?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eb7be1bceaf3b24404f43567fb6a26102182cec30d498700d8e5a400b321bfc",
      "text": "pendapatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fb86b1a8745dcd82d7664adb298912123c2ffcd4051d5e1942e63adb20783a9",
      "text": "Panitia mengadakan festival budaya setiap tahun.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1d6f4164cbc2a9a1f0ddcc4d4923a2c23acadcd6eb34d9a4ecb2bd98cb04144",
      "text": "Sejuk banget. Pemandangan lembahnya mengagumkan!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2c7e8eef24217b7cd34c1674e40a60c8dc6d3496d2793fb6cdf735c8e5a2d9b",
      "text": "Hotel baru itu membuka lapangan kerja bagi warga desa.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a510790bcd75c21e716adf1545a604f98c46819b3285be906cd36540ba822296",
      "text": "Tentu. Pariwisata membuka lapangan kerja dan meningkatkan pendapatan warga.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5445a63fb9a0ed829dabfe60dc10c00fc9478d8844e104758c37a5e6cba7b7e",
      "text": "Festival Budaya Kaili kembali hadir! Panitia mengadakan pertunjukan tari dan musik Kaili di pantai Teluk Palu.",
      "voice": "id_gadis",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c0e01cd647691ff6ac0c9adb621f8514a30c4bad17984e1af3318ea53e1683",
      "text": "tantangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7200b32296d6e39ce276069770d819c51313e111eac02da5f7e507ef76b6444",
      "text": "Anginnya kencang, jadi ombaknya tinggi.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8be747b66c69d92dee8895e09666b569b0daa702ca02af7dc9e1a4ba41da1ac",
      "text": "Iya. Pariwisata berkelanjutan bisa memecahkan masalah itu.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9ab251b79724ae81a43e5d6649af39f429fa77dbed42a1bbab2947216293830",
      "text": "ketinggian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa9ec6b53ad956583e1fe2960c264c039498fed147dae0d7532cdbd99555501e",
      "text": "mengagumkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab7e2de495d6f4e59cb510a01004fa9bde26274d3a95652f9fc6434e9bcd14ea",
      "text": "Pariwisata dapat meningkatkan pendapatan warga.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab7e3a67b2feec511faef9ba5dfded0e170e3f4b83580f89d42b3765d6c023a5",
      "text": "Kayaknya nggak.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac31326b423aefb2f1957c2c5564a4abaeafdddbf19c4294e64a0547974fe0af",
      "text": "Saya kurang setuju. Pariwisata membuka lapangan kerja dan meningkatkan pendapatan warga.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "acaa2470fda3c341cb893485ae1cdb2a0c2d304426aebc20eb6ea796efe3678a",
      "text": "Saya mau bersantai di tepi danau.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b31704f580d02577c3bdfffc22c4f3c684895f83ee1c4945ce84fb79437bb9b7",
      "text": "Betul. Karena itu, kita perlu pariwisata berkelanjutan untuk memecahkan masalah itu.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c0f2ab6815dd5c71cc25d7c5f1974f459b6fb6e36302b47b038c8e724cfe8a",
      "text": "Pariwisata berkelanjutan memberikan dampak positif bagi warga.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b41884e92b211ac8375cb203faba4cca99fd25de6c62bc5446230521eda743dc",
      "text": "berkeliling",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b58ab07f999bba11890810c46c087926d440b181479ffd5f57b083cad4fe2e8c",
      "text": "Besok ada kamp anak sekolah di bawah. Malam ini kita bersantai aja.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5c1045b657e952245a3b2aac3191b9c284e37ce740c8af635072ca210c50e75",
      "text": "Pertunjukan tari itu menarik perhatian wisatawan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8f68fe714359e838f9aa4fcbc815c809663e1fe1f099dcf09e8abb6180cab33",
      "text": "Saya mau berkunjung ke Toraja. Ada paket tur?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb18a948068576d2750dc7620018ad36b2bf84edcd99d04d9524bf78ddb19bbb",
      "text": "meningkatkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb6361d4c15dde75fa2e2cca463c2f43aad39703069a8be9c663176cf8756c8e",
      "text": "Pariwisata berdampak positif, tetapi kita juga menghadapi tantangan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "bda2ec2e73fb8b101887d5b324392c3c6c69c3ce90a2b226ac6d4043a9960cc2",
      "text": "Mas Rizal, kok banyak hotel baru di Palu?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bea36088ef25df21b8dcd34314b94d1e53d206c8ace762cb611926a243eed588",
      "text": "Desa wisata menghadapi tantangan baru.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfbea3ee53777b852f8cfec1bc1e21ef520ef214d1054ca812f72ff6aedb5483",
      "text": "kenyamanan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0045757deedced3085019ca7cff891ad3c575feaaa90c7414fca6df3e216539",
      "text": "Dengan demikian, pariwisata harus memberi manfaat bagi warga dan alam.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "c034d73686e0b71a6a726828a89eaf316af542977846342b7a710e8276758aab",
      "text": "Aroma konro bakar tercium dari jauh.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c03cf479382ac7ed8788eb787278b472c0184d8c24cbed7f532eff76a9cce836",
      "text": "tersesat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c079ee45fc13508b967acf77bd44e79c4741ab156c80cd4c84bc055e6548a70e",
      "text": "menghadapi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c189f88dbc37f5b019d226d87904acee1cf7b579f2c22138ae287b0982a4cfed",
      "text": "busuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c194d70a36f3661f1a2641255cb16b7d6a242238a659bbf5e1ef3b99c84ca97b",
      "text": "Tur ini seharga satu juta, sudah termasuk perlengkapan.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2cdc4815e38185d4296bd47868c430ac2c326b1bce48bb1280bfe44081ec3b8",
      "text": "Tanpa peta, kami tersesat di jalan desa.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c518be577b00f5491f35b05c3ef368713dbeadd3033c5a969c8df068daea7f09",
      "text": "kencang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5314bf1d354b642aa79d776d3a5ed1094901085c6b8b85ac9fb9ff3e2c1e10a",
      "text": "Panitia ingin melestarikan warisan budaya Kaili.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c599f73efb5f126db8ffca9cfd42916c60339aef0b1cc490820280ce7fc7a84d",
      "text": "bepergian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c669fa7834f73ff0a4f5e8b97de3b6ea53f77d5b20730863654fdfcef14e1830",
      "text": "Sup kaki sapi dari Palu. Enak sekali kalau hujan deras!",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68d69ed56e4368245c4a22407353fa11311c9a84e63b31a0b614613d504262d",
      "text": "masakan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c70e34ed93e4237a56cda4c4f2cc912343890b57090ca9501451373d8792be64",
      "text": "Kalau berkendara jauh, periksa rem dan jangan menabrak!",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7de8a60ab0b361f691fe7f3551671e9ea51ab74bee9dba2ae6e0895a9ef62cf",
      "text": "mengendarai",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c81a5a8596e83a42fd6f5b62d885089bc6162aa52b528c75ceb67edb04d84f12",
      "text": "Mending kita minum kopi kental di sini dulu.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c87a1a35d7be08bded590661012de0e86afc92ac777dc2a7c80b720987f32ad8",
      "text": "Kami menginap di pondok kayu di Malino.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca6844be651bca45e40cb01f5f7317f5552afec01988b5663cc735ae253cb13a",
      "text": "Festival ini terbuka untuk umum dan gratis. Wisatawan dapat mencoba makanan khas Kaili, seperti kaledo.",
      "voice": "id_gadis",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca8580d0be1146241dc3650f94d4a64df5c713b633a2c2552777fcdce03da732",
      "text": "Hampir tiga ratus. Kita beli di jalan. Yang penting kita nggak tersesat!",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb60d2696f2b7f5c53957cf880b2bdb78d9825b8c87fa60a729712dc9616e67b",
      "text": "tepi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cda9bc8547646c6cfb5786909ffa51e5d57d91c20033aa1989f9cd08141bb9f3",
      "text": "tol",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdf8fcae74803646ef1054854a6efa13edd862f5c9cf954f8722a4998502685b",
      "text": "Baik. Sambalnya sesuai selera, ya. Masakan Makassar biasanya pedas!",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce201cbc1912845a2379a70ff5437f12da71397eda3ad007cbf47d63433b032d",
      "text": "parah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ade4df42a32021a9ea63e91010cc2f929bc7ee2a40246158c2411e6931c7c2",
      "text": "sekeliling",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d24a8d718b47682a0654d6e2a53ada57b0127b9435b36bbf5cc8a1bf88fe803e",
      "text": "menu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4d0721a453d47622b16f595fa80361921b810aad629f08920fcbb0cdf60df2c",
      "text": "Sayangnya, hari kedua angin kencang dan ombaknya tinggi.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d57fe8d16cdf9cf5fb02d7c9564cf1277648be8b957e76ec051a9e0cb32a4a5a",
      "text": "Di sekelilingnya sepi. Aku suka ketenangan kayak gini.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7b84a279b4657ae4fe3343f128c375c9a89d793bf9c82123435cbf7b5623275",
      "text": "Mas, aku lagi nulis eksposisi buat lomba blog wisata Palu.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "da832d8b6d8362d4743d6caf9f29ce7703cf4af0397d7f45346cf53bc4df7ef4",
      "text": "Ada, sepuluh persen. Busnya juga nyaman. Kenyamanan tamu penting bagi kami.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbf448ccc4c51a506ed4f837338ee6ae2c5032ee665c559ac26a67dd2349d7dc",
      "text": "Warga desa membuka warung dan penginapan kecil. Saya senang, karena pariwisata meningkatkan pendapatan mereka.",
      "voice": "id_gadis",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "dca057be72ea9cc881850a3cd8df7992c8e8772f1a544e7d24dc90909da02d92",
      "text": "Menurut Mas, dampak pariwisata buat Palu apa?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e181d604a5bcb967b5e2d8bf56277ed62bd519254f7758752c29cdef9d97f7bb",
      "text": "Ada tur tiga hari ke Toraja seharga dua juta.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e30d5c45aa6c087933bc0ea5813c796e4091bb408cf4331234682e6ffb9f2905",
      "text": "hidangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4c51cd04ef8df5bdc05cf60d0d318f1e128f3fc5c1c017cff1719e3b2e9c1df",
      "text": "Saya berpendapat bahwa festival budaya berdampak positif bagi Palu.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8102b3b9d0b49f7a08f8ee6d5414b96751ab37261c1e7cf35e7e521f19f5fa0",
      "text": "berkelanjutan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec2baf501faf8fad86baf61db608f70c30f2f703efe4397b2f0ef57e02e227c2",
      "text": "Sip, biar warga juga dapat manfaat.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecf0e366b3c502417954a34d4d0b351b0d631513d8933542799216e601ddb19f",
      "text": "Panitia mengadakan pertunjukan untuk melestarikan budaya Kaili.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee2a2e3b2af363ce6bd830c9bf4291017d87ed05e4327830c8a4bb0953c6d36e",
      "text": "Ada. Tiga hari, seharga dua juta. Kita berkeliling desa-desa adat.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee8207d72cc3f71cefccf70874bd3658baa3abf09a3b5932754202f522d399f3",
      "text": "Kita harus memecahkan masalah sampah di pantai.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "efc846c42eab44c932c9953ce5ce5a9a2bf0d2f1c60ae7c8f16a13c5358daea3",
      "text": "Sektor pariwisata membuka lapangan kerja bagi anak muda.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f00310b975035722da7873396e427caaf7eed262a0e0f72b760abd9ec5ca1cc8",
      "text": "pariwisata",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0b4db17a4de4063cf06bf56d63194536b460be9605c7d151f3b5f0ed9271b21",
      "text": "Bu Ratna, saya lihat poster Festival Budaya Kaili di hotel. Festivalnya gratis, ya?",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "f199f8ef27bcc93b8ff8c0767e8bad191dda4cca6f2bb030a9c352070cc86b9a",
      "text": "sektor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f22d4e83f65a40735c923a7a28c23bb24b89efe0267576c693afca3f4b637992",
      "text": "lapangan kerja",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4f4b908015172002a6c6f90eb02de95cc773c677228bb00060f19ca348ff7c9",
      "text": "Harga tur sudah termasuk makan dan hotel.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7dceef6402cf5d79047aac11bf092002371f24db7590d4157e1c1f370aea89c",
      "text": "saus",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb4d83f7bf2ad4e4439c88b578376500e5db2706a597fc0578b20732b4dbbbca",
      "text": "Setuju. Dengan begitu, warga dan alam sama-sama mendapat manfaat.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe4001523d7071aded1b91babbb1f282608dbd2bf24a67921899832859cf74ca",
      "text": "Coto Makassar adalah masakan khas kota ini.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe9aa52ece025a369b8cc4d290a116eaa3e61316c5ce21087b838370cc5703d3",
      "text": "Pondok di tepi lembah ini memberi ketenangan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "fec067dd73b45d6b20a3da925e0305a8d8ce60ee5e48b621205b14de7ccb2d73",
      "text": "Kayaknya nggak. Anginnya kencang dan ombaknya tinggi.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    }
  ],
