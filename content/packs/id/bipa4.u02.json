    }
  ],
  "audio": [
    {
      "key": "011de9f33d993d05dffb0cfb2004dfdb4afd22b58610d234449c72b06d01a2c6",
      "text": "respon",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "02450d18b4a1c5ad00c84fe890a0a7b922837f366fa6131b51c65e7163b5c1b3",
      "text": "tanggapan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "02da2c035303689543aa214489e59c2408b1f6bc1309b5045956d5f3b7b7b56e",
      "text": "dikembalikan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "03a36bed61f3d5c78b1e1620620376bdfc06af858b6b8bee8287ad139ddcf279",
      "text": "komentar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0471017df6ffa7b7b27a9a5edabaa6a6c551927029804a6361a714ce1292d73f",
      "text": "keliru",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0579b6fa75a3d7a57c6cfed73ea42592c2a8aa99fab727509183ae1564f0de8b",
      "text": "pujian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "07c5eac20502726c5601bba65fb097ef7866968fcfd4284dd1721ad3e1d7fee9",
      "text": "Permohonan izin pedagang ditolak lagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "087ee557a66e4facdca9891fa1fc78ef0f516521567e0d1205efa3e8c0bf4930",
      "text": "Mohon pemerintah daerah segera memperbaiki jalan ini.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "09522e05d9a5e8f877d03b99ce9ee0556c444395b540417f3f32d2f1291c33c5",
      "text": "Mohamed, kenapa kamu kecewa?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ab2501e0928118d96a1c13bf9ba3ce0a7e599a9f3777e880fe9adfaf4ddb3b5",
      "text": "Kami mohon jalan ini diperbaiki secepat-cepatnya.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d6db5af97a73f9e4a63745bf3a32ffa05158eed01ae2a05508f4b87242d01c1",
      "text": "Komentar pembaca itu keliru, tapi sopan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "111fc878636d2f5ab846378d8e60f92d4fe30f5e4bca1cb5eef90580c91349dc",
      "text": "Masalah ini penting bagi masyarakat Maros.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "112ef8c2322a1b5d93a6e59c3d009ad82cec4c4da4e418e1d52d1eae40227270",
      "text": "Terus, maunya warga apa?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "122235a2c9dd3d2a02ea033505252a6e0a1d19eca937cd8df6dc2578f5791e36",
      "text": "pepohonan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "12eabb20e9d55eb23b458537f403115cb27a4deedbb5a365fe21387909c0c196",
      "text": "permasalahan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "137901be8267ca8ce3fd6ac7b8b6257a19b2b5b8e9d91a1fa3fc2da21bc8a481",
      "text": "rincian",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "15797d507fe0ec19fe1cc18326f8d28681b96dfc1930e2780dde6cf9753fae5a",
      "text": "Sampai sekarang belum ada tanggapan. Mohon jalan ini diperbaiki secepat-cepatnya.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c19dac5f1884e347295c67702299f28166db0b9040113b6d798212e4f750892",
      "text": "Jalan desa kami berlubang dan membahayakan pengendara. Bulan lalu ada dua kecelakaan.",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eb0c47b0ef9553bb0e94d80c18fde0257d8fd68abea6513093ddd3b7641a666",
      "text": "kerja bakti",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ee4973fd0491c1f24c73f70641ae6b70f24e519e22c4334805569700cc8d153",
      "text": "Kami mohon pemerintah daerah memperbaiki jalan ini sebaik-baiknya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f14f6b4e01979962338f10882dd3419fc23830650ad4bd02699cc21c3334d46",
      "text": "Alhamdulillah! Ternyata surat pembaca kita dibaca.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "200ebdf29fac636845da9400085d7ac003363bdbdead10f2874d5899c8e61e66",
      "text": "Jalannya berbahaya. Tolong perbaiki ___!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "202cb5077541403f3f8544e4a2be6547ac0921e36fcab30522cb63e1a376e812",
      "text": "Kami sudah membaca surat pembaca dari warga Desa Salenrang. Terima kasih atas laporannya.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "24184ca1c31a4c174c934d04d0d202f9af9f4ad0d8980d1fc74be8e014c10ab7",
      "text": "Mohamed, surat pembaca saya udah dimuat. Lihat deh komentarnya!",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ec571a5076152841f58dc16cb3db45232da7facdc89ecbd25d7544b6cbd52b",
      "text": "Wah, cepet banget! Isinya soal saluran air di depan sekolah, kan?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b4015f8a39798ff876681ee67a293bdd22fc9947b01448c1f0ded8f665082ee",
      "text": "perbaikan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bd79b4c871466bc919bbe4858fdddd79f255df11250c526d8366b9894786a69",
      "text": "Saya tulis bahwa pelayanan pemerintah lambat dan jalan rusak itu berbahaya bagi masyarakat.",
      "voice": "id_ardi",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bdc0130ce3d86cc0e333ea4dc3d69c79d6704535a3e18cac00fee14ff82e5c3",
      "text": "Waktu kerja bakti, kami mengumpulkan dedaunan di bawah pepohonan.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fc688203774ab686d69238f52304732b9927a599813aa035ec1fa2c5ecaa9d2",
      "text": "Warga membantu memperbaiki jalan desa.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e2b6df44352dee2953c37756b57ff208c0c37f812eecc91fc4cb9de3d1cd2f",
      "text": "Saluran air tersumbat oleh dedaunan.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "329d9cbe7bfce3a557684a3c5155e074a6ec80c8b7425bdb4e804b8347c69abd",
      "text": "berwenang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "333f03189357d5c589e790ad4ea080d89d51b60e2ddf9b2389625d040aab0760",
      "text": "Banyak debu, Nak. Truk tambang bolak-balik dari pagi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "33e4b25220dbf20c879e0b62ae6307119c34ef4dbb3f44a8d6d69fc27f8ef8d5",
      "text": "Warga protes karena pasar akan ditutup.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "3596433b355021f96a95301dc67c6283d96f78507ef5cce153f0c8152d92fee9",
      "text": "Mohon saluran air ini diperbaiki secepat-cepatnya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "35bf582648e291901769c471edb451a128a6d87a6abe628c8bb2ca6fea8880b2",
      "text": "debu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "364749e90fea8e2fb5af059593c1076d25aeab95b275d8dc6a27153ba53a40c1",
      "text": "Iya. Anak-anak jadi susah belajar di rumah.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "37de854d00e4f404fa18f61c7aedd62602b56f51f22241400a97aa9dc08d50c8",
      "text": "Iya, saya salah tulis. Saya nggak mau mengabaikan komentar itu.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "385f566b1d3335355a2ea1a8d476bb73ee654cf5dbdca800cc6ddaeb21ace613",
      "text": "Melalui surat pembaca ini, saya mohon pemerintah daerah segera memperbaiki saluran air.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f280fd3ce46405024213684c1bbd640beb5bd41bf4a604dd41197701c462682",
      "text": "Warga sudah melapor ke pemerintah daerah, tapi belum ada tanggapan.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "42e7d77343da7d90ba12901c70d7a1e275edb2df4255fdcc22ac20d59f5b32b0",
      "text": "Banyak pujian, Pak. Tapi ada yang nulis angkanya keliru.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "45845444da2eb146fa413b47a3905c620cb2db9ebd2dfdeb23a8a9117b0aa530",
      "text": "Barangnya tidak berkualitas dan sangat mengecewakan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "463b6476fb2097017afc5fe21e84d9090fd5181d0b9239fe755e20a7a23513b8",
      "text": "Pak Amir, surat pembaca ini saya mulai dengan \"Yth. Redaksi\", ya?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "4654903120dee017e3d6eb58f5eead2e9b4b04e567861fa7238a4637b83de108",
      "text": "Setiap Minggu pagi, warga ikut kerja bakti.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "491ebd8dc084f0579d45f1d6b264d80198964aa0c653e52eedff7fa45e4920ba",
      "text": "Bu Hasnah, kok jendelanya ditutup?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a9df5c88c3c2a47ef5f4fd86cdede5133e0c0ed70f3b331448bfe25ec645908",
      "text": "bising",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc6066e2695a7bb1ce9e705559b3b384b901c1b913359e3d24095b06d71c38f",
      "text": "Selamat pagi, Bapak-Ibu! Hari ini kita kerja bakti.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e24a42eca408c2f04a24816bef5edb7723598cbfff7c9b6eafa586323b0c449",
      "text": "Menurut kami, jalan ini harus diperbaiki sebaik-baiknya, dan truk harus pelan-pelan.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f47e70d9a4a9c3f511311938d2d2edc05cbc343896313e7720cf95eb4dd8573",
      "text": "Saya akan menulis surat pembaca dan mendesak pihak berwenang bersikap tegas.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "5046f38db5959a94699c4e59c65420978c406843e16a5b652b79ae20d92b5394",
      "text": "Warga Maros masih hidup tolong-menolong.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5052ecf6748b5b30a60f6884bcd13092f5a0d5ced0b8f039d288e222fe234d55",
      "text": "lalu-lalang",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "529dbe1ca9fc2f06c1e68210759ea71c1e11eeb648fed6617482b440f70810e4",
      "text": "Saya minta pesanan dibatalkan dan uang saya dikembalikan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "553f6cf3a4758ab303ffcd8fb47c9e2071956bb8c8c238f625abefbed3feffd0",
      "text": "Maaf, angka dalam berita kemarin keliru.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "569639e0a5c0322da4a3842ca50ed98f1cd8baa7bbce98352efe133533e1e8ac",
      "text": "Atas perhatian Redaksi, saya ucapkan terima kasih.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "571826b56ec18e9b990819f9b124467ba7b7ce63845cccf2cf1f108530957088",
      "text": "ditolak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "587530ba44539beac0a2a41c315c7fe84815a88dbbd8892adb6a207f08995d8b",
      "text": "tegas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "58859ec12fdfe07eacfa701d0f31953c22d062a190cb3333cefb503483e297f9",
      "text": "Kenapa sih kalian nulis surat?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "58ca99042138a5b9a591cdd86d6e06ea35efe6e6db7f9a3f1111fb84aa026b21",
      "text": "Udah. Saya minta jaketnya dikembalikan, tapi tokonya diam aja.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bcbd20183ea12a06c4b442d4cc31dada9c0e803d65eeb29c47b5a390b70d675",
      "text": "Uang Anda akan dikembalikan dalam tiga hari.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6190f8cbe09d24e195a6d2ac74012124fddf7405f1860258ef48a89148b80be2",
      "text": "membantu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "66e1cf50cf10619bbbffcdae47ad3151f92a1650a31ae00daba4009ac01c6e4b",
      "text": "Setiap hujan, jalan di depan sekolah banjir. Warga sudah kerja bakti, tetapi saluran itu cepat tersumbat lagi.",
      "voice": "id_gadis",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "6884a9296ac698a134963f2ddb924a4bf65dac0e3243d19b542e945c23d346f0",
      "text": "Betul. Semoga pemerintah daerah segera memberi tanggapan.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a344178a5f3b38be6961a620c6967150e0a65de1ba67e8959c09e4d6806e55a",
      "text": "Suara truk itu sangat ___. Kami tidak bisa tidur.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bf49ad8412843f2cb867314b8aafc7d62ab06db22b7cfa0dfa9414e655d354a",
      "text": "Truk tambang bolak-balik di depan pepohonan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bf824f23e9db197468691d97acf104e7e68d343001391a241b842044e718e59",
      "text": "dibatalkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e18aa94b057717f186b1364349ddae441f50a21450a3d0af1e2ea4e32f63aeb",
      "text": "Yth. Redaksi Kabar Sulawesi, saya warga Desa Salenrang, Maros. Saluran air di depan sekolah kami tersumbat oleh sampah dan dedaunan.",
      "voice": "id_gadis",
      "chars": 132,
      "mime": "audio/mpeg"
    },
    {
      "key": "71a5805f209ff31f23fffcb0386346db8690292d16f6c723277f2acf8a20e5b3",
      "text": "Mohamed, lihat! Surat Bu Hasnah masuk koran Kabar Sulawesi hari ini.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "71dde20750a09175e294c2330adfdeeea6ecca0853bd5d20278bd9d2c4aa25d0",
      "text": "redaksi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7398ddf9deaa64644ee680396bc1d489d38df46e4063e1d5fcb67c7a9c6fa232",
      "text": "Dan sebaik-baiknya, supaya tidak cepat rusak lagi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "73fb98e12d1f946b3c94fea43fb0b0a50da1c507b14f899b6c5efff1b1b0e0f1",
      "text": "prihatin",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "74b85b98356ff0952f3afd07a64aef1ac0d9db80141677f29e3b79faca5781c5",
      "text": "Bagus. Jangan lupa penutupnya, \"Hormat saya\", lalu nama dan alamat.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "7504db2ec6aff6d9b3793c7574f819acd3634e6c2b58d1f326390a888cdf3ef7",
      "text": "Pesanan saya dibatalkan oleh toko.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "772f89bd7f63c710afd3ff3ac0d008236d399b59a12cadcf150e2bf78ca04936",
      "text": "Kami nggak melarang truk, Daeng. Tapi jalan desa jadi berlubang dan bahaya buat anak-anak.",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "78827910d06dab8928ee95686333d107d1d26b0f4ba23e71a441ff0f2e725412",
      "text": "berkualitas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a2bd0774e1323e98c8927ab48bbe43634cd615704ee3807c00d8a5debb339e5",
      "text": "Itu gara-gara dedaunan dari pepohonan ini.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b490c53ad3e130824277a3ce31ac0beb62b2188b4ba870cc328ea30dbf2d1e8",
      "text": "berlubang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dbcd8c04aa21ff2f0cec2941ce6687bae2eabdcde9c22e48649f09c6f3b41c3",
      "text": "mengabaikan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e45e8a570ca0629a87611c91440dd198e81f0acb406d5d69aea96b937a889eb",
      "text": "Kasihan. Saya prihatin sama mereka.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f8aeca8d6d7cae5921d573673ef7e4e1d5c40de05a855cab6a5e6177b7eac3a",
      "text": "Gimana kalau kita nulis surat pembaca di koran?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "8015ca5ce48db8a78f5eb7d149a1caf6cc9258a1e6f354c24a7bca93dd24df46",
      "text": "Oke, Bu. Di akhir saya minta jalan ini diperbaiki secepat-cepatnya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "80b9619fececec293e2dc95ea28b56de87a732ed72b7cd36c95d280850c9323f",
      "text": "surat pembaca",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "818dcdce98dff88bc888e1f2b8f9b52561d0e4d9f867c95a302eb9120f1436a4",
      "text": "Lihat, Pak. Mereka protes, ya?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "81d3bc1f73bda98eee990897a802fdabcbc2c4335b4f380c24a40eb8b833a568",
      "text": "alternatif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "86639ecbddf4958319d00317a4d173b4b84f6c6f4dd64bec03d12e558647f14f",
      "text": "Bu Hasnah, ini draf surat saya. Boleh saya baca?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "86b69f60ae91f9b9a39dc8c17057d13c430d1687f296b05d9f2fa0704d71e4f2",
      "text": "Kalau belum ada tanggapan, kita kerja bakti lagi aja, Pak.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "888eb7e074613dea4dfca680eb2b490e828d6961050d6ae6fb46d63ad4afb2d9",
      "text": "Kami ___ dengan nasib para pedagang kecil.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8897be3927ea72cfc259a6b4aa650e0bc784187ed42543f0e644f868afdbe9d4",
      "text": "Jalan ini ditutup untuk perbaikan sampai Jumat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "89330ad108e0646f615e2f7ca9fd30b4208cde7b5b71495702752cd9d7d00455",
      "text": "Tulis aja surat pembaca. Toko harus mengganti kerugianmu!",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a783d5c744b6ba09fd1b05f31ef9d09233b00fa6ed208e9bdfc91ae1730e945",
      "text": "tambang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b78e1a8b483a4e62e2e107900603941fc73034ea731bfe894c40d53b37b4589",
      "text": "tersumbat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c5c5c226950ec2150e12287469c8ae2990b683aac32649caa8f6f5c0eaf0e83",
      "text": "Kami juga akan membersihkan saluran air. Kami mohon warga membantu menjaga kebersihan.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cb4b01636488d577e2ef754566e753190062a0353891203d8677a9796d1d640",
      "text": "Boleh saya ikut kerja bakti?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "90690ea1be8fbb2e90491a159d840b1085e4d553bd28ab0b0585eab4c7aa9d4e",
      "text": "tolong-menolong",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a1f4ee02363294991a92532d2d17cac415816e8a68bc4707c7fc9488300da9",
      "text": "Permohonan kami ditolak oleh kantor kota.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "92e3bdbec6b2c24bc8136d3f5617831bdc864288d156ab29bf036f5ae5b98335",
      "text": "Warga sudah kerja bakti, tetapi saluran itu cepat tersumbat lagi.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "959f1afa3c8e74c31afe65b052c820292915f56341bf77df3acdaf5d86b810d9",
      "text": "Terima kasih atas pujian dan komentar Anda.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "992799bd49c838b462029a7ba86c9b70a6a30c63aba9d7077d394b178301feed",
      "text": "Jalan di depan sekolah berlubang dan membahayakan pengendara.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8446a35883dbd43ff982e31ce9a98f7c610ab74d58ff992c4323d91235357e",
      "text": "Minggu depan, jalan desa yang berlubang akan diperbaiki. Selama jalan diperbaiki, truk tambang tidak boleh lewat.",
      "voice": "id_gadis",
      "chars": 113,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c4ac4235955e7326e6648fba88a50b240c71616dd6a660e0ee29f5ef2c4eb9d",
      "text": "pemerintah daerah",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f32e0591b9754925d49e1f3a240885fee70cb24aee4ff5c531aa7e2dcf8ac60",
      "text": "pelayanan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fce5b2280da0c4dde758ba57ce1548838a3f258f49b2b65e0f94cee2e4d583f",
      "text": "Kami mendesak pihak berwenang bertindak tegas.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0de9c179f0150d0e11c10dfc44de7e1492a9e94fc73ca5155150b276c48e72a",
      "text": "Yth. Redaksi Kabar Sulawesi",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a10dd44c805f6ef6bacd182634fbb884f92df5907f1a8cd02a6cfdeeaa7a35cd",
      "text": "Kami menerima pujian dan menyiapkan perbaikan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a145c82986fc81b2b5b696ce637b46b69fe2f03acf52e15c72699c50204a2d20",
      "text": "Selama jalan diperbaiki, truk tambang tidak boleh lewat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4251f5502bdf78d77e3291bbd42a54b58fcedecd164b55dbf13afd96abdb333",
      "text": "membahayakan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c0e6585ac18283a228e52ff2b48ce79ddc3f042070d1973d2793767c408951",
      "text": "protes",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6c3eae6bc841317aeb64fec6d8fd0bba82e93dee1cd23b65515ca215e94f0e1",
      "text": "Kami mohon warga membantu menjaga kebersihan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7023844e07da21634fb18ecfb14399d042222941c45a5f9a93225971635a5c1",
      "text": "Atas perhatian Redaksi, saya ucapkan terima kasih. Hormat saya, Mohamed.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7682b466c1a7ba77aa2d4d079263a43aa66e2181d7f2d25e761720c37fe7447",
      "text": "mendesak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a93b6e800c597b3854c6a97cef60eb4a581a62dfe8be1e750a2de418ec9b3ad7",
      "text": "Terus selama jalan diperbaiki, truk tambang nggak boleh lewat.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa448333653f3a0b0bb0222e98ea8c6b8942e9a725ccb1040957897f07f1bf35",
      "text": "Ya udah, itu masuk akal. Kita emang harus tolong-menolong.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb8cae7c8d98e926a08f6db1403524af2b2bb52f767ad70a399550689134549",
      "text": "Truk tambang bolak-balik di depan rumah kami, jadi jalannya penuh debu.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac475738b777bb19d8345442acee127e9423c33d81ea549228617cfb1d15c7ed",
      "text": "Minggu depan, jalan desa yang berlubang akan diperbaiki.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7f4a4e505033f27095a7079060ba8ac0bf1c4e72a996700e2108e769465f6d",
      "text": "Wah, mengecewakan banget. Udah cek lagi apa yang kamu pesan?",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "acb1188f2c1ada184103d1711291e70828040dd9c0a4044cc1bc7d6ddc9fd61b",
      "text": "Mohamed, tadi kamu dengar tanggapan pemerintah daerah?",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae7878aebd76ff4cfbd5f7fb8d1430b24e1252ea35a00f59817058eff912883f",
      "text": "Kendaraan lalu-lalang di depan sekolah.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "af4997f252c7de444006288adbd4a0479af20dc447e19559c76fc30650f3dbf0",
      "text": "Kami menunggu tanggapan dari pemerintah daerah.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26f3dbeda11d9d63cfe9d790299b2ee1ee534659e35e1b49de4124699b96b76",
      "text": "kecelakaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b29141aca53ffd61f12db0e18a2f1dd19f3485814d1318681dede6f7b0911005",
      "text": "Kendaraan lalu-lalang dan suaranya bising sekali.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4da7e6d54cd89e0bf7e91a5254aef8374cd1e6d74e8ad4c96d1a7c3d0f9f150",
      "text": "secepat-cepatnya",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "b909ed6793162d2d3de952357bd829cdb5a6c1c6d9aaf7e4f1a10fa231cebb93",
      "text": "Betul. Lalu \"Dengan hormat\". Jelaskan masalahnya dengan sopan.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba5a68db4132c74a05661b1cf65f442af1f6ee471773e7585c5f0b3990c0384b",
      "text": "Sepatu ini berkualitas dan harganya murah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab5aa2f7d2a567529b2d42f37f80e137c147863eef86ff4979db9b3544b48a8",
      "text": "memuaskan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbaaa29766aa46a15a4342195d57363bcce6de8bde63153ca9506ee3a111b530",
      "text": "Warga udah mengeluh belum, Bu?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc8f15fe62e9b0ad06451bfee15b1993c741011ce5fb635e60ff83c1f05cdf19",
      "text": "Pelayanan toko itu sangat mengecewakan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdf82bb9d29d324076db15249c3c5cc9db748f4b3a64e381d45a9b8a23864aaf",
      "text": "Pak Amir, saluran air di depan masjid tersumbat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "beef86c45f0c8e27351e2c3c8c811a9616255cea89d84b56e7085178b8565df0",
      "text": "buruk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2a152f1e712ff831b4c39fff02006c19a1292e6546493bb6cf3e4be423d045f",
      "text": "Masyarakat banyak mengeluh tentang pelayanan rumah sakit.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c32c1cd8dd0951e08514265a576fb6e08b3144764dd016632bf771f265b150d9",
      "text": "Saya prihatin dan menentang keputusan ini.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8e735136975e76a4824ce6fdda33c658f0650ef06dbbe079983f72f12d8f738",
      "text": "Saya pesan jaket lewat internet, Bu. Yang datang kecil dan nggak berkualitas.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "c91d52d13207a10611b79eea668080e8dad977517e3aba37b1b4948b12abda63",
      "text": "Pihak berwenang tidak menerima permohonan warga.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9c2dd969764db5a137ea5cf54472b5ab2fd1dca49d737bd7217e64015aac127",
      "text": "Barangnya rusak, jadi toko itu harus membayar ___ saya.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "cafdaf28e6e02c5dfa17b38a5751ec60a4757881b237704db60047c9b7cfcb7d",
      "text": "Mohamed, kamu lihat ramai-ramai di depan pasar tadi pagi?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdee2ea211d3d68c9ebec3587b2a2b8184d5ac0fb2c0fb16511649cce1bd4c8b",
      "text": "Jalan di depan sekolah berlubang.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce72b241830f820fd00d249e4e95966f40b99debf2ac0750625a14176512b1be",
      "text": "Terima kasih atas ___ yang cepat dari redaksi.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "cecbf3635dd77d8a99040f0824efe999a2d34fd55e554883e4cf8432ee18618d",
      "text": "kerugian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "cee0b070059929fdf289e1f43197c23fd175ef4980c6077825dbf41b8f55acf6",
      "text": "Silakan, Nak.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d33cc094c980f3c6b01e76d53588dc54472307855e6b41ba123f99bd4aed634e",
      "text": "Kami mohon jalan ini diperbaiki sebaik-baiknya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d38f9eb6eec1a1db24fefde320ca7119ace04167023450e2e7ef5b66712ca8ef",
      "text": "Ada respon dari pemerintah daerah?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3b128d09976b4a968a4c8d454e10a83d16ab6fcea82cd6cf41304970baf53d5",
      "text": "saluran air",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d58a494a88db1a9f94b0189e41a43729e57d120834476d9f046a74d82f5e0770",
      "text": "Ada banyak truk tambang di jalan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8bb9ed648f7dd9f0c277c374584be2837b2227a583a2f165652545a599e5763",
      "text": "Boleh dong! Di sini warga selalu tolong-menolong.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e52921b5fba3ff1285f19e73431acd05bf1be929deeaeedd082b0a8e48bca9",
      "text": "dedaunan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9eec0e542dcbf7ca560689837ed92f927cacdb24ab62b8b37afc2bdbeb06e2d",
      "text": "menentang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc7a132f3905702097c0dd27721f1db5490615f3b0aecaa00f9ea08ac614d81e",
      "text": "Jangan mengabaikan keluhan pelanggan.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd3648f79d3382b16072f6ba25e115f03debc49d4a82e7518c87d9205c9865a6",
      "text": "Dengar, Bu. Minggu depan jalan desa akan diperbaiki.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd9cf504d6ccfd9104772a39c9d94c119a6ba0199943da4125341202b8f8b138",
      "text": "Iya. Pedagang menentang rencana penutupan pasar. Permohonan mereka ditolak.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddbbde23164c1584e1bdbcac543fa9b51eaf26f75788b4f4f3c909622170973d",
      "text": "Ada. Mereka menyiapkan perbaikan jalan dan jalan alternatif.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "debd2b3a95d66e468e3d0926db464abbb9b5ea46f24b0dd16594862202491be5",
      "text": "Jalan rusak itu membahayakan pengendara dan anak-anak sekolah.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "df2ff8aca0e824913ab201c23f3184974d1b78e6ec67c67266b76538ccb2a5b8",
      "text": "hormat saya",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0d80ce46ce61a537c19f66b1633144329d0775a2a5aad3d2921c217a7ed8448",
      "text": "Saya ___ datang terlambat, jalannya rusak.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e14c7fa8ff477d7495949efb6ce7378b64774e15537daa7b73197b62bcce00c1",
      "text": "Kendaraan lalu-lalang terus, ya. Bising banget.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4884f0ac7a1defeb95e6b928718588b230ee838747760578a9689505199b281",
      "text": "pengendara",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e55a2cefa229982701e5ce55d48381e6515d46fe99bce03802abb2ad8f8e098c",
      "text": "Bagus, jelas banget. Tulis juga kalau truk tambang bolak-balik tiap hari.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed029dc2eb675b1e77d8ba5b298c13b5ce80255dc9da877a8b36c0d02bed5c28",
      "text": "Pelayanan rumah sakit itu buruk. Pasien harus menunggu lima jam.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed4313b23db24ce0cec8c5921d6aecae9c29126b7e7a89fdcdf8106d6884cb76",
      "text": "mungkin",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "eda8c4b9654c9a37fce40fa13c04ebd673a685bc11f4a446528823947ccf447b",
      "text": "mengecewakan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ede4b81870405dbfd9f1acb34617e3d678c523e87320a290cd8703eca1054e71",
      "text": "Kendaraan lalu-lalang di depan rumah warga.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee7d876b087ff9bfcedc7f14e5d67bf29a2d1aadf4b52758488a786e174f1ad7",
      "text": "Truk pasir bolak-balik di jalan desa kami setiap hari.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3699ee4a8249ae0a87cf0a3bf2aa91111ab4ab5998cdaf53ed5aafc2f06f34b",
      "text": "Kenapa sih kalian nulis surat pembaca? Truk kami kan cuma kerja.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6149e39cf6ecfff74dd51fe14057db824aab251433d56b02db31dd62e151506",
      "text": "sebaik-baiknya",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8180bb18f82d1076e6c14bedce06308c39fc70b71745da7154b7e7aa3ad7ff3",
      "text": "Sudah tiga bulan jalan ini rusak. Harus diperbaiki secepat-cepatnya!",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "faa09f9459f8fe56dbe541c000226f7a1533b3739270dca2190b3f3932be68f3",
      "text": "masyarakat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb9518a0a980b44a8b390eab64df3d7fecea56c375c02fc3fdaa9d1770c17135",
      "text": "terganggu",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbc54c8c145fcfd7fa6756a03d843bcefac02068fa62b9758a9812dacaf69991",
      "text": "Ha-ha, iya. Di sini warga emang selalu tolong-menolong.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcf01d97cdf4205309a31c7fc175b047f0df1bfd66fb7e8b8a619b20fa930146",
      "text": "Jalan desa yang berlubang akan diperbaiki.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fda0a43cd1be98873bc47148e1db89accf389c19ed0239673257745158259259",
      "text": "Ide bagus! Kita minta pemerintah daerah segera memperbaiki jalan ini.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe794a8b9e6e02fd55557a89915e38a9a53702ee05ce28998bb3a31cba48e808",
      "text": "permohonan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff1a0efc2f3c5ec10c7405902598499a57222852849c089f5a8b2dc616c91deb",
      "text": "Bagus. Anak-anak bisa belajar dengan tenang, nggak ada debu dan suara bising.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff8bc21bf57bd59c0e152a9db4fb87c0b41a1e8f191d122042c18c346768711c",
      "text": "Lihat deh komentarnya!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "fff6d8e73fcb24224d5cac4f4dd5b51dc0bc2542f95693af0b0f532fa7cd4661",
      "text": "Kami mohon pemerintah daerah segera memperbaiki saluran air ini sebaik-baiknya.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    }
  ],
