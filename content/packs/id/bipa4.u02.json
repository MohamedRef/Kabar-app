    },
    {
      "id": "bipa4.u02.l06",
      "sha256": "a105a0fc30f60264b56b13702511e67d44da579a4e3d1e28eef2e0fe34797758"
    },
    {
      "id": "bipa4.u02.l07",
      "sha256": "80ba32ffef23ab19d964aba55ec3ec4bccda26bc085a902fa5ead18adf2e51a8"
    },
    {
      "id": "bipa4.u02.l08",
      "sha256": "9cd2ccc7d20c312f32847d8d1807e85251593f8e444210c5869d35241bce9285"
    },
    {
      "id": "bipa4.u02.l09",
      "sha256": "8b07ce83a97deb15d1fc743f39287149cd6c97125f26aaaf9248cb47618d173f"
    },
