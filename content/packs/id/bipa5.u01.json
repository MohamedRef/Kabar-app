{
  "format": 1,
  "id": "id/bipa5.u01",
  "language": "id",
  "unit": "bipa5.u01",
  "version": 5,
  "content_hash": "bb7a4b9ddd65091696be66a13b0b4e6ca8409a7c5fa1123f00ed7645744115a6",
  "lessons": [
    {
      "id": "bipa5.u01.l01",
      "sha256": "ceeaabd7f4de156fc4f092d9d393834d6d330b19ccd26eb5b2d1dd3af4fd12a6"
    },
    {
      "id": "bipa5.u01.l02",
      "sha256": "343b4281b798c080ee80312ff050bb26cfd2d2d2eae56cf82f2129ee92e36bae"
    },
    {
      "id": "bipa5.u01.l03",
      "sha256": "a6444cbe832ec663337707d2e491bb931921b144b4cb4372bd308ebc546337de"
    },
    {
      "id": "bipa5.u01.l04",
      "sha256": "54d2b32e8a965e28772b9099b7a7aa3d9f90c467b85a6156a85989f543291a42"
    },
    {
      "id": "bipa5.u01.l05",
      "sha256": "69e02834834ccbcca0bfde04b26e11ef2c4d6349a34930a36e32ed1004530160"
    },
    {
      "id": "bipa5.u01.l10",
      "sha256": "0ba5c0d2dd1b65efdd10ef595b56707b014f60c51fea612a7c72c0c1177930b8"
    },
    {
      "id": "bipa5.u01.l11",
      "sha256": "37b4fdf896865db44358d4f386af9c9511392ad7b6907daa02e49776ff393a97"
    },
    {
      "id": "bipa5.u01.l12",
      "sha256": "671ae2e81280114694919c00ea6d3d43696c75c625d8e9ea2dba4da7576951a1"
    },
    {
      "id": "bipa5.u01.l06",
      "sha256": "250467a64237bb2edf753c5c3789bf7d36918035cedfbeecc73fa456aad90db2"
    }
  ],
  "audio": [
    {
      "key": "00e6ed0259d1b1a174946da9b4900e092dba8a30d3284fe3bdb692fdc1624658",
      "text": "pendidikan terakhir",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "02be1b243b2dfc947e863dea7e63b22d6d3414ccbea28e24475a6c339645cab6",
      "text": "Perusahaan menulis bahwa syarat utamanya adalah bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "07720b686d032ea6b1d77b50b364768af026744e32a6b3bbd347d49860f8e123",
      "text": "Selamat siang, Pak Mohamed. Kami sudah mempertimbangkan lamaran Anda.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "07b7e0c2785a48f8a9c65938313c0386fd53bd1494630f83e1bdd70f1e1461c9",
      "text": "Saya bersedia ditempatkan di Balikpapan, karena saya suka kota ini.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "092eaf1377fc25ecf914ce306e334e8ed9b2c827dfe457d843107cbd2e6a3d8f",
      "text": "Jika gajinya sesuai, saya siap mulai bulan depan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "115dbf437be0c72dfb4ef76834982bcec59961496c5f18bc9ea573ffdefb1eca",
      "text": "Suratmu bagus, tapi kenapa ada kata \"nggak\" di sini?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "145b8b5c0e3d14c7d3109b8b3ab2330c63e13a3878fb7c1691cc894b5cf7c057",
      "text": "Nanti siang kita makan bareng, ya. Santai aja!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "16047f04774b75603fb4b14f82f79875ba1d65ce5e023e18e595a43cdc3dbf32",
      "text": "basa-basi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1695217d9f73812da2ba6c91b0277caf3ac819724f857336f2f61e0ed514036a",
      "text": "Dibutuhkan segera: staf administrasi, minimal S1.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1738a5859a43a2bae3781ddfd77881510d4348392873fb379b10026b80a70d22",
      "text": "syarat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "183e4c819fd8211fbe0684089ee23cb9256c87f2c0eb42db8c30798d4978f23e",
      "text": "Senin depan. Rekan kerja Anda sudah menunggu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "18eb0ad346916330326984c599e02887dc82469053e5f6a05235a6a45cd8e954",
      "text": "Selamat pagi, Bu Lestari. Apakah Ibu sudah menerima berkas saya?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b83492907a4fb8c0f4c7f7e80042ddaee67d641678d1ba1de841394264d2bb8",
      "text": "Baik, Bu. Apakah ada masa percobaan?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bd6083606d7046422e00606998bdf63c29f2e33d8fa7a82dcf39cee755feefe",
      "text": "Dibutuhkan segera: guru bahasa Arab. Kontrak satu tahun, ada tunjangan rumah.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d5978fcc5b4947afbe00bc8dc5ed589024634125f3539f6791ec764ccc0093",
      "text": "Aku makan siang sama ___ kerja dulu, ya.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "22600d4afd192dd53a07c42c41adf9deb859b1e2bc02f4b554b00ca693dcf4dd",
      "text": "Lamaran dikirim paling lambat tanggal tiga puluh November.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "233edf605f92d543b8857448af6e3ac93c7a764352bfe40f11eaf9fd628bd9a0",
      "text": "Pasti dihitung! Banyak klien mereka dari Timur Tengah, sehingga bahasa Arab penting.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "23628e6693d5135fdeba85198d35beb1579f8cd190e8bda3b1efb775d7b6cee7",
      "text": "Apakah Anda bersedia ditempatkan di Samarinda?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "25e50d5896ba72297d96c93d6e26bd461eef03c2d2213a864ac3f9f91714614f",
      "text": "Saya melamar posisi ini karena saya punya pengalaman di bidang pemasaran.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "279287e3e5caf2877f199627b4db90571f8ebaa6e12d84ccc13a4d50e9109fc5",
      "text": "Baik. Saya juga tambahkan magang saya di Kedutaan Indonesia di Kairo.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b413f19569355464bfb116226d3b3f675f89e00abf1165d79ca29c0d057f372",
      "text": "Apakah lowongan itu masih dibuka?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c0225518c9d2143b6de45917eeb7efcc343818144584bcc29bfae7dadd11a6d",
      "text": "Betul. Lalu tulis pengalamanmu, misalnya \"menangani klien dari Timur Tengah\".",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "301f197c3e47618fb9305e62b5cbd078453766e8f2ae6779d37f66e4ef3e008d",
      "text": "Saya sudah melampirkan ijazah saya untuk wawancara besok.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f9fdfd8397e5aac5350faf2473a626930100b86deb4ec37064c36d55bb3b02",
      "text": "mempertimbangkan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "38b5e82f73b61ca55bce51f67e1ccfbec9f1c9675064fbcb317ea225710fe4b7",
      "text": "Terima kasih atas perhatian Bapak.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a318b2cf37e3be35e64460a57afba1831b20d797a17770072ec1c79a8fb43b9",
      "text": "berminat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c0918cd77506fc649f8066d9e2e80d09da09ef6771f70e75406e2d3cad5b2f8",
      "text": "Tapi saya harus melampirkan ijazah. Ijazah saya masih di Kairo.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c684f580cb0c0bf69b1096e72a7cbe7c18701acd15b6ef2d541a21b99e84fa3",
      "text": "Basa-basi itu penting sebelum rapat dimulai.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ed10a8b02ba1626a4ec96d9f7efaa862a38691ec187c87860709b127c95f792",
      "text": "sungkan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f25944108f2e35ab27a898df887f8cdfdfc422d3493a6824bdffa1e5c874c8a",
      "text": "menangani",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "407393ea940680c93ab55608d04416fbfbb300455df00d462e806b66586bfaba",
      "text": "Minggu pertama ada orientasi untuk karyawan baru di ruang rapat.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "46da8aa831d663206bf3200e7b36a228a047468e89883fe6f82218f012c26a61",
      "text": "Kelebihan saya adalah saya cepat belajar.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4717d729b589c289a051ac71bb02a81e47e71aa5fa38ae20bef5c8434d62fb65",
      "text": "Sehubungan dengan iklan lowongan di situs perusahaan, saya berminat melamar posisi penerjemah.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "47edf81425b3c043933c408e93e610001ce6a242409b9f9eabc7a7d1814afde4",
      "text": "Kelebihan saya adalah saya teliti dan cepat belajar.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "489b76984fe06af5a6d5359b5e76c57067e716a34703323faa81ad92ff068281",
      "text": "Mas Rizal, apa syarat lowongan ini?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b54d9f52072b560d046d6402ea5c436529f953a33b2dfb30f380cc06659a1ac",
      "text": "Lalu kenapa bawahan Pak Hendra tidak pernah bilang \"tidak\"?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e3ed15d240f9d4b49510fce7672b35227b4240ee80b44134fe5cf2b8e8da84f",
      "text": "Hanya pelamar terpilih yang akan dipanggil untuk wawancara.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "526d7b471daa51a9303ecfafefb0a01b989bd99696e8437a4aad30f241c06f28",
      "text": "Fasih berbahasa Arab dan Inggris, lisan dan tulisan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f613deb433c007d2c96e8c643402bca8c847293c14c1ed0fc6fb4181fb294a",
      "text": "Diutamakan yang bisa berbahasa Arab.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5504582ee6fd138ce8fcc009d1a233d3b58b9cf781aee6acdf53a7c69600c4f9",
      "text": "Apa kelebihan Anda dibandingkan pelamar lain?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5af94bb18742fdca6367a8b10236b2147c639d02eabdd6ba7a5ede05fd18c84a",
      "text": "Saya menguasai bahasa Arab, sehingga saya bisa membantu klien dari Timur Tengah.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e5b7e7f7f53f17df77d4b5f2ee012d8a9201c6a7f26ed52fe0311f362fa41c0",
      "text": "Mohamed, di CV-mu tertulis \"saya bisa bahasa Arab\". Kurang kuat!",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e670eb2d266c5d2f9e50d12759660a72335dc0642f87a5e3d88bf6346823b16",
      "text": "Waduh, saya lupa. Harus \"tidak\", ya?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f3ba11f1474f5792cc2cb53784584e03c1d9ca3df649bc606c6af581e1ed6c3",
      "text": "Saya dari Kairo. Setelah saya lulus, saya bekerja sebagai penerjemah selama empat tahun.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "6230be9e48c679c2cf4f19043db615e88d8551ac7353f1060703894048b0d212",
      "text": "Gajinya kecil, sehingga dia mencari pekerjaan lain.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "668046a6d1803471dda5e25e331da0fb9c0f0692670de9a6d3bab1ef55f80fb1",
      "text": "Bagus. Apakah Anda bersedia ditempatkan di Samarinda?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "67eda382092c3869dba7452b197e568ce4acdcf27ee75f7be79b3a0cef5a00a2",
      "text": "ijazah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a1fafdfe006db2af2126f4471c8fb041def77e7086b010791401ac56d47843a",
      "text": "Betul. Lalu tambahkan kalimat \"sehubungan dengan iklan lowongan\" di awal.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d308c7ff678458426a6dc82ce5a42333ca451c99d521fc81dbb1a3266f3f4ae",
      "text": "Kirim fotonya dulu. Yang penting kamu dipanggil wawancara!",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d6caacc826fa79f66e8c8b8f8615c94e737c1975767edc68db3f26319b69bd2",
      "text": "lowongan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d8cf5c113a13648a9ac9767e689118edd6ec1fd53130acad97187b6f69dd8b6",
      "text": "Terima kasih, Bu. Apakah ada kabar baik?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a87c2387335af66f12df19b621e15fcdde17c97964cc933f99dd566d2013a2",
      "text": "Dengan hormat, saya ingin melamar lowongan itu.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "73d1e7f74a52900356e6647c9fbf59c3f0f65a43db84e2dc0c3c61c5fbe11d95",
      "text": "Dengan hormat, saya ingin melamar posisi staf administrasi.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "73f2018a0b2caf1252712bbdf66b0b8b53298c07cc0c1fc77d4c61b751c5018d",
      "text": "magang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7411b00594bd6dcc4a9bf987043e572b2bdef1e288f32c83c82ca678195f0dac",
      "text": "lulus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "74f074ab90567047c0d3c8358f5070bcebb45496c793b9ce057710f40dc18b3c",
      "text": "orientasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "760475f29860581a716b3d815c142c12eeb0ead17107aa75258a064bf6f80d2d",
      "text": "Pendidikan terakhir saya S1, dan saya punya sertifikat BIPA.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "7631d9799729938e1db750f027ee67025d84bfb5c1e99f4dd74ccc069c7ca7b9",
      "text": "Mohamed, ini Bu Lestari, atasan di kantor kami.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "76965470a6ef17f331b02046aa397eede94ae9ded284b13631ca0a61f41e1dd9",
      "text": "Dia sungkan menolak karena yang meminta atasannya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "76baafead0a4139d54f93a6063fc49304bdbbfa5a800ac84552871fbeb16c50d",
      "text": "Atasan yang baik mendengarkan bawahannya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "76ce1576b75d212dee5ac47573ee08070bd2920cc679c130657e51b54b707e33",
      "text": "Saya bersedia ditempatkan di luar kota, karena saya ingin mengembangkan diri.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a31fd3bef4facd76cfbd3d9ef1aa225d0f79cf41435ed3cc4651d4bc689eeac",
      "text": "dibutuhkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "81552ef670212f19fe2da3853a0fe118e3e1223f244e3bf0d2244132cfb41488",
      "text": "Besar harapan saya Bapak bersedia mempertimbangkan lamaran saya.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "82dc21d0fe5208939dc9815272d8339a06bb4c9e4e88838dc5394327766e6e25",
      "text": "Setelah saya lulus, saya bekerja di bidang pemasaran selama lima tahun.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "88e21aed9f3e8674af0858addcd9c899ab23bc6942d3b9ab3442c75a0d3b7b83",
      "text": "Kelebihan saya adalah teliti, sehingga laporan saya jarang salah.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "8db081bbac3b275c72c4a356d93db2ba6ac9b026273efcb6aaaa3060578b59a2",
      "text": "berkas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "90ce72ae8bd2cb723d85648beb867bfa7b89402a9a2ac27a94c21ce17e69e779",
      "text": "Alhamdulillah! Kapan saya bisa mulai, Bu?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "90d98b92820a1a2945b7ba1555541f38e072a5b73e49cb31452fd9d7c7c03273",
      "text": "sertifikat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "96b0d1419cffa32d81eb051c45dfc43f3b4df50a28998b528cae94b4d13440f7",
      "text": "sehubungan dengan",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9775ac3ba13fc0cb610f8f19bebc9f9a71103f4ba9152ae230c2644abd9bee09",
      "text": "Siap. Semoga mereka mau mempertimbangkan lamaran saya.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "980dfce8161f7d848392bd70c63da7296e704e00b2f47ba7b721d8559cff34ea",
      "text": "Tenang, Bu. Saya selalu datang tepat waktu.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7bd888afd8589d1dd38886ea3ac4074a6c3d90458dc59d2b6383d971a00b20",
      "text": "Jika keahlian bahasa Arab dihitung, saya mau melamar.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5942078781bc2a4114847628dc8a6700cb35383d5aedb15601297c0913297ff",
      "text": "bertanggung jawab",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9fc75db37d02dd4278f6382a0013cba4b075fb084356aa42a03e2b164316185",
      "text": "Mas, kenapa rekan kerja selalu bertanya \"sudah makan?\" sebelum rapat?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa3654d6ab0e079e32936559263045b1743fd251091bf17b92306fade48437d8",
      "text": "Lampirkan CV, ijazah, dan foto terbaru.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "acb2e510939e8a8edc022d19ee39147c8011854134d6e812973faffa367b56a4",
      "text": "jam karet",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad01b58ee68897f33f4c9ff9e4a81c746f5805140ba50fdad62e4856a7946a5a",
      "text": "Saya berminat melamar posisi penerjemah di perusahaan Bapak.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "aef2dbc6984f981114e11aa02d8344260c4d1fcff618a95300156c339c320084",
      "text": "Masa percobaan Anda tiga bulan. Setelah itu kontrak Anda bisa diperpanjang.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5909fdfd1ac61754bfffb8da353bc38aac7260b27285dcde0c124963faf9494",
      "text": "Kapan orientasi untuk karyawan baru dimulai, Bu?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b98fabad5806c4edd71a886a88e8eb2d3bbc45892a4baded2cca3db5d828b005",
      "text": "Karena saya punya pengalaman lima tahun, saya berminat melamar posisi ini.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd12b746b6c87bdc89ed05a024d0f3412ff3d3a91cbadb7ade924101e2c4921",
      "text": "Kamu udah kirim berkasnya belum?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3555e0aa28ff8c9908cf2342c5306205d18f114d67752f2074de6ac8e54be45",
      "text": "Selamat pagi, Pak Mohamed. Silakan ceritakan tentang diri Anda.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c37840973e135e2cb76ecb839ab97210e89324ef5fd5df97aca61c77d5386f39",
      "text": "Rina, lihat iklan ini. Dibutuhkan penerjemah bahasa Arab!",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4d3d7cac344afd38ad7b449c3b09c75672c59f9a7239a37d99ab8f2ef600cf1",
      "text": "Wah, cocok buat kamu! Ada tunjangan rumah juga.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c5b82926b7455f11ad7f7de9219d1f33eac4f169e3d52e0eadc0868020066a",
      "text": "Iklan itu menyebutkan bahwa ___ utamanya adalah pengalaman dua tahun.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9110b23b92490d7ffedaa525c44373abff407f162b0539a99b50eebcd293c49",
      "text": "Pak Mohamed, ini wawancara kedua. Saya ingin menjelaskan tata tertib kantor kami.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "c920358443d6208f61335c9a9376a8847f90d9d3a0f3fa38eeb5613e3da27dc3",
      "text": "Saya pernah magang selama enam bulan di sebuah bank dan menangani arsip nasabah.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9e1718d80edfb36b0aeaf3b20764f0746c7cdd27b89989444a4c2c2beeec230",
      "text": "Menurut tata tertib, karyawan tidak boleh pakai jam karet.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa8a4c75c4838975b619379f5b7dc2d7ce1d979a9cc2b658949a03b7fc2b7f7",
      "text": "Silakan ceritakan tentang diri Anda.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "cea5fa69b417d995338147c7a9b42c1daeb143f721ec421bccac8d3abbacc8a8",
      "text": "melampirkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf8db5ebcb94f0fae24c170eaf68a07cf76104e0795b1c87d4d74a25d82ff550",
      "text": "Saya bersedia. Siapa yang bertanggung jawab atas orientasi itu?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "cff054f47346d7707518dde979967f749eff18681f60d3f2e915115c90f17f26",
      "text": "bersedia",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0e5e8dd916be166b3b647e5bd86912e9a71791ab5094d94b12d0209ce033624",
      "text": "Selama masa percobaan, saya tidak pernah pakai jam karet.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d32b8023b1770f1bdf848a5be6be36d1f17d20fa7ca7a2a0d73a8ebbd6154661",
      "text": "Sudah, Pak Mohamed. Terima kasih. Rekan kerja Anda menunggu di ruang rapat.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d475898bfa442390b6ca03c5dc2a59570862b2ee214041aaeb6784800d62329d",
      "text": "Pak Hendra, calon atasan Anda. Beliau tidak suka jam karet, ya!",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "d606fd6da5d878b5cebff41e12585b984cc0a2383269fc09600446248ba03101",
      "text": "fasih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a1ecd45a8d750617f33e8b16afa5328969de262ab93c0f19dfb70e5593632f",
      "text": "Bertanggung jawab atas terjemahan kontrak dari bahasa Arab.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "db239b70efd0ac2ec074249c9bc6a226fb70e188bc4221a165cb2f247bfe61b8",
      "text": "diri",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07d2a7e4f7477b1aed1e92780ae61b3fc76f7fbb6fbf3edf8baec3f3c043e45",
      "text": "Jadi saya tulis apa? \"Fasih berbahasa Arab\"?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d85c3bb109f523423407bb5f3e9c52ee17da4e8535704ae0f80da1e01b5aba",
      "text": "Mereka sungkan. Mereka bilang \"akan saya usahakan\" saja.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2964c0f867f2182115930a2418a2a10f93208306bb021be385312b72e534870",
      "text": "Pasti! Kamu pelamar yang berminat dan berpengalaman.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e39fdb01a78223650e147476241adf66cac15d3d911f712864e725edbf17f515",
      "text": "tata tertib",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5b3817936f65d337024bf51228e7325df3a01adc23768ee2fa548378c0bcba8",
      "text": "Saya bertanggung jawab atas semua sertifikat dan dokumen karyawan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fff8618f1960be67dcabdaf9c268bc00824af023cf67f920095b022d33a3e1",
      "text": "Ada. Karena pengalaman Anda sesuai, kami menerima Anda sebagai penerjemah.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "e606e5ce1c69178f93299dee59237048011059e2dff18bbc1fbc5969f7d4a209",
      "text": "Sehubungan dengan iklan lowongan itu, saya melampirkan ijazah saya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9f57b8686f3ba24eef00d7cbbbbf36df62cf63b8f7332566b21717d7941a54d",
      "text": "Apakah Bapak sudah menerima berkas saya?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebd76ffd1404d6d56bf3cf2f263918dc53afbd66f761dd338c47ff03a16d288b",
      "text": "tunjangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec9a4fe841708ccfa5621b38ecd250f4513606529ae92d0d93db82e4fbd42f66",
      "text": "Mereka mencari orang yang punya pengalaman, karena proyeknya besar.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecfad34105d30dc6274e11a102761800f225bd183f7de7e6e870e42b6a53bcdb",
      "text": "Ada, tiga bulan. Minggu pertama ada orientasi untuk karyawan baru.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "edd248864461f5938b230928448e33082e64ecf42014c5444ca084fcd9588d1e",
      "text": "Itu basa-basi. Mereka tidak benar-benar menawarkan makanan.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f00d6447ba5f6b708d267c0fb79b6e6aecaf08f74bdfe0cf81efd96d52402381",
      "text": "bawahan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa36e52153ff3c39542bcbb2331e2325367774d95514a2332737f4ce8ec868fe",
      "text": "gaji",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb0249425a2099bc637a20c42cc5e681f661ee0f4bc141d347a634843097cbbf",
      "text": "melamar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdf78decd5d04333efc260016651fbf39b780f972deda34a872cbdffbc48c7b0",
      "text": "masa percobaan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
