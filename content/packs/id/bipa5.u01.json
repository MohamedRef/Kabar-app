    },
    {
      "id": "bipa5.u01.l07",
      "sha256": "c29f56e6d8d9252c2bf8f15e0114d42177d94d1857a08d47561e30a2cb5f0b30"
    },
    {
      "id": "bipa5.u01.l08",
      "sha256": "f0e81c45d769ce2fd0fcf78d9db843b3c058855af86bfcb7baf8ae310001dffe"
    },
