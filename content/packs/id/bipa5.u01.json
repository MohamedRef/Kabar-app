    },
    {
      "id": "bipa5.u01.l10",
      "sha256": "14d84666845e329d3a5ec5887ea95627f0268eea8d71b4d46c1b474383b45e9c"
    },
    {
      "id": "bipa5.u01.l11",
      "sha256": "58ee9f82ecbe44a562ff70d4d6568a5e8af9ecc0bb8107dc1f154be994acf6f3"
    },
    {
      "id": "bipa5.u01.l12",
      "sha256": "fa9972d518ec91e6fd6a93ea428cc7bcb56a38eb44fc663056592a0afa9bfed0"
    },
    {
      "id": "bipa5.u01.l13",
      "sha256": "22fa15d1bce80be9af20660ed3e7b8731e01c26b571cab6b73512d6e8d28feb4"
    }
  ],
  "audio": [
    {
      "key": "00e6ed0259d1b1a174946da9b4900e092dba8a30d3284fe3bdb692fdc1624658",
      "text": "pendidikan terakhir",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "02be1b243b2dfc947e863dea7e63b22d6d3414ccbea28e24475a6c339645cab6",
      "text": "Perusahaan menulis bahwa syarat utamanya adalah bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c9a21ca879a5a6bef479924ab3bc0f1ff6fe12bc31429905a8d6f004e1e3e8",
      "text": "kompensasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "056b4ef6484d214c89177bc3f095dce83a9d47be7f7d7c5a330e35760600a5be",
      "text": "persaingan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "072a3cd3b41609c66b0d6f69cadfafcb59cbdea251f767c13313092e39513184",
      "text": "Mohamed, kamu udah mulai menabung dari gaji pertama?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "07720b686d032ea6b1d77b50b364768af026744e32a6b3bbd347d49860f8e123",
      "text": "Selamat siang, Pak Mohamed. Kami sudah mempertimbangkan lamaran Anda.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "07b7e0c2785a48f8a9c65938313c0386fd53bd1494630f83e1bdd70f1e1461c9",
      "text": "Saya bersedia ditempatkan di Balikpapan, karena saya suka kota ini.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "092eaf1377fc25ecf914ce306e334e8ed9b2c827dfe457d843107cbd2e6a3d8f",
      "text": "Jika gajinya sesuai, saya siap mulai bulan depan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a13184036fafb0ede951c852a2c3266c2f58b7f6df1b2a91556735ddad113e7",
      "text": "Kontribusi Anda tahun ini sangat besar.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a994417c5d4743e4972f29129df0ecf80f73707af95a0b04c115e812801aca9",
      "text": "Sebelum menandatangani kontrak, tanyakan dulu kepada ___ hukum Anda.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ac6ab171e69292fe12d882d5a52c1c6aa734d827b2ecb69a48081044ae4d03c",
      "text": "Kualifikasi: sarjana teknik dan pengalaman dua tahun.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d15f6b8364a647157ef7a87882914dfa239972e86ca7f01eaf5d1386426a7c4",
      "text": "berkomitmen",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d430c1765822617e3299639fc8c176f91ca53f82eab9f7713fa9de4aaba7c00",
      "text": "pengangguran",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e6941cefa41074d4dbfc5c8e19365aa572aa341e2c35c6890f000fa44f7d87f",
      "text": "spesialis",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eb21c4d6b173f7c73c2b260fcbec3a7340a208d2dd1e496eb3805687b20dce9",
      "text": "profesi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f444827717040dda9cb98529610a165451d5bb06e7cfa3afa456de777149cbb",
      "text": "Oke. Aku tambahin juga magangku di Kedutaan Indonesia di Kairo.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1072f3ce4065e667b7f8c730556b694e09802bddfc41b564803371aa123ceaef",
      "text": "Evaluasi kinerja dilakukan setiap bulan Desember.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "12747f56a5d6c9e2f28068abcb0e77ddc884267e0ac3b2eb453331dc10f7e275",
      "text": "konsisten",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "13701c52bfff1ccf0b537f7cdca4c37e1bca9df3c6f1faddb0b062d498c4b824",
      "text": "Udah, dikit. Tabunganku buat tiket pulang ke Kairo.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "145b8b5c0e3d14c7d3109b8b3ab2330c63e13a3878fb7c1691cc894b5cf7c057",
      "text": "Nanti siang kita makan bareng, ya. Santai aja!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "16047f04774b75603fb4b14f82f79875ba1d65ce5e023e18e595a43cdc3dbf32",
      "text": "basa-basi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "167b9b7bed9b72c5597a735beac85c9eb3ff87a92b57b9f9532a0947f15ddb4d",
      "text": "analis",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1695217d9f73812da2ba6c91b0277caf3ac819724f857336f2f61e0ed514036a",
      "text": "Dibutuhkan segera: staf administrasi, minimal S1.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1738a5859a43a2bae3781ddfd77881510d4348392873fb379b10026b80a70d22",
      "text": "syarat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "182cafac2aa61895d392166b654a408ea4e789e131e678f22960ead6e7bbd403",
      "text": "Saya berkomitmen pada pekerjaan ini.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "183e4c819fd8211fbe0684089ee23cb9256c87f2c0eb42db8c30798d4978f23e",
      "text": "Senin depan. Rekan kerja Anda sudah menunggu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "18eb0ad346916330326984c599e02887dc82469053e5f6a05235a6a45cd8e954",
      "text": "Selamat pagi, Bu Lestari. Apakah Ibu sudah menerima berkas saya?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "1947f2b7c426f7aa5527dcbb9052e8ecedd49ebbd4c5439a60c759a3e375be8e",
      "text": "imbalan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a1943a4e18f7e7598137780e4f3b428ed9499b6355d790f192aa67ee3d56597",
      "text": "Pakar geologi. Dia rapat dengan kontraktor dari Jakarta.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b83492907a4fb8c0f4c7f7e80042ddaee67d641678d1ba1de841394264d2bb8",
      "text": "Baik, Bu. Apakah ada masa percobaan?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bd6083606d7046422e00606998bdf63c29f2e33d8fa7a82dcf39cee755feefe",
      "text": "Dibutuhkan segera: guru bahasa Arab. Kontrak satu tahun, ada tunjangan rumah.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c41fc551c1da14bec9b1322960e22dcd7890c9b79dcbad68c809d7bdedbafb6",
      "text": "merekrut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d21c2d68ae017efede868bdd99e588a30f142bf184679e9c03754630beeab76",
      "text": "Upahnya disebutin nggak? Terus ada kompensasi kalau kontraknya dibatalin?",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e5d8c171a739217191bad75fada65ea60a1e7d6a4b80319fce786d790eb49a9",
      "text": "Persaingan untuk posisi analis sangat ketat.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f9422fc7f0924621b50fa0b454c5f765b187f10221499f844cc36a7744b2b8f",
      "text": "pengunduran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d5978fcc5b4947afbe00bc8dc5ed589024634125f3539f6791ec764ccc0093",
      "text": "Aku makan siang sama ___ kerja dulu, ya.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "22600d4afd192dd53a07c42c41adf9deb859b1e2bc02f4b554b00ca693dcf4dd",
      "text": "Lamaran dikirim paling lambat tanggal tiga puluh November.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "23628e6693d5135fdeba85198d35beb1579f8cd190e8bda3b1efb775d7b6cee7",
      "text": "Apakah Anda bersedia ditempatkan di Samarinda?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "25e50d5896ba72297d96c93d6e26bd461eef03c2d2213a864ac3f9f91714614f",
      "text": "Saya melamar posisi ini karena saya punya pengalaman di bidang pemasaran.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "29835fa072d3a10e75a2ab5ffabe222155869e807421b281c4b3a6359364b6a2",
      "text": "Ada. Tapi hati-hati, persaingannya pasti ketat banget.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b413f19569355464bfb116226d3b3f675f89e00abf1165d79ca29c0d057f372",
      "text": "Apakah lowongan itu masih dibuka?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d02540ce8787bf7c87acea209369743d84730892ac97033f2b361ca6edb5a1d",
      "text": "Dia membuat jadwal rapat tanpa disuruh. Dia punya ___.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "301f197c3e47618fb9305e62b5cbd078453766e8f2ae6779d37f66e4ef3e008d",
      "text": "Saya sudah melampirkan ijazah saya untuk wawancara besok.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "32dcf4f0f02ac67ef40a4026ed09e6a8e41fb003e204645177b9b4c34ef65854",
      "text": "Bagus. Setelah pengunduran diri Pak Rudi, Anda jadi penasihat bahasa untuk tim.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "3308a4f482029380307fd2649ce0a946862c45b439c2010ad9f87957559ed91c",
      "text": "finansial",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3414c626688f589afa94508106185a97f3ed2abd49e0e2fb02cd8aaa714f0ffa",
      "text": "desainer",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "34f9fdfd8397e5aac5350faf2473a626930100b86deb4ec37064c36d55bb3b02",
      "text": "mempertimbangkan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "37624a35c1653221c95177ceaef64e69e2ea8407054a16d281560acb0773387e",
      "text": "pendamping",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "383dcd8b4041fe30bce5cb0b97eecdf393e643033fa1df84d370d9bc5ea73653",
      "text": "Kantor kami kecil, tetapi produktif dan efisien.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "38b5e82f73b61ca55bce51f67e1ccfbec9f1c9675064fbcb317ea225710fe4b7",
      "text": "Terima kasih atas perhatian Bapak.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a318b2cf37e3be35e64460a57afba1831b20d797a17770072ec1c79a8fb43b9",
      "text": "berminat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c684f580cb0c0bf69b1096e72a7cbe7c18701acd15b6ef2d541a21b99e84fa3",
      "text": "Basa-basi itu penting sebelum rapat dimulai.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3da9c7de2a493ada14b59df8b819480d726a63e36cb102c222ba51cf7cbf406e",
      "text": "Dulu dia kerja harian, kan? Majikannya baik nggak?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ed10a8b02ba1626a4ec96d9f7efaa862a38691ec187c87860709b127c95f792",
      "text": "sungkan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f25944108f2e35ab27a898df887f8cdfdfc422d3493a6824bdffa1e5c874c8a",
      "text": "menangani",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "407393ea940680c93ab55608d04416fbfbb300455df00d462e806b66586bfaba",
      "text": "Minggu pertama ada orientasi untuk karyawan baru di ruang rapat.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d0a69c2b642ca3a6839438ec39441135f236be0dec14f1a7af4361d269caf8",
      "text": "Kami merekrut spesialis keselamatan kerja.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "456d5f95c74308319181b2b37a6b471a588c42675ea902604f420dcaa7a9bb4f",
      "text": "Perusahaan itu bangkrut karena masalah ___.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "46da8aa831d663206bf3200e7b36a228a047468e89883fe6f82218f012c26a61",
      "text": "Kelebihan saya adalah saya cepat belajar.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4717d729b589c289a051ac71bb02a81e47e71aa5fa38ae20bef5c8434d62fb65",
      "text": "Sehubungan dengan iklan lowongan di situs perusahaan, saya berminat melamar posisi penerjemah.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "4895f3910713dabfff379d51cd4dbb35eeba72c195e1212802f145b80f79ef0b",
      "text": "inisiatif",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "489c6532f5efc918dd9413aaa6a84dd0c83210413acc5316f76d940670df7aa3",
      "text": "Iya. Terus tambahin kalimat \"sehubungan dengan iklan lowongan\" di awal.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aeb6d9d345529924fd32a27e6345e7eba87ce0643b1f2cf0935ebcd097f5416",
      "text": "Mohamed, lihat iklan ini, deh. Perusahaan pertambangan di Balikpapan lagi merekrut penerjemah!",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b45ff0d0a1506f89f6cb9b2b792ce930128a2e4fa8c9002ffe2e77ab7df04f3",
      "text": "Tapi aku harus ngelampirin ijazah. Ijazahku masih di Kairo.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d1277d7390950c3a3646a2f2e7ee646efaf7ec58cf4876cfd711ef8708479af",
      "text": "Bahasa Arab sama Inggris. Mereka juga nyari analis sama spesialis keselamatan.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d5ac0a0ebec196b8dab5ec24bbce25543bdb6332c873c208038541aa374b3b7",
      "text": "Nggak apa-apa. Aku kirim lamaran malam ini aja.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dd10f31913548ed85499af030ff57406eb2ac09972f5c0cef85557d36ed397c",
      "text": "Rina, lihat deh iklan ini. Dibutuhkan penerjemah bahasa Arab!",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e3ed15d240f9d4b49510fce7672b35227b4240ee80b44134fe5cf2b8e8da84f",
      "text": "Hanya pelamar terpilih yang akan dipanggil untuk wawancara.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e7138a4d84940717399bbd2408487588317e6e0065bf2357ab24650fa805886",
      "text": "penasihat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "511c049e8ff592d3a6a1d0b861ca16ef95e769c73c9144878360605d51a21f04",
      "text": "Baik. Saya berkomitmen belajar cepat, Bu.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "526d7b471daa51a9303ecfafefb0a01b989bd99696e8437a4aad30f241c06f28",
      "text": "Fasih berbahasa Arab dan Inggris, lisan dan tulisan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "52f613deb433c007d2c96e8c643402bca8c847293c14c1ed0fc6fb4181fb294a",
      "text": "Diutamakan yang bisa berbahasa Arab.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "540834cae1fd681974cf6590af95fe77632b6cee21bea97c1bceba405c759c40",
      "text": "Menurut konsultan itu, kita harus mulai menabung sekarang.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "5504582ee6fd138ce8fcc009d1a233d3b58b9cf781aee6acdf53a7c69600c4f9",
      "text": "Apa kelebihan Anda dibandingkan pelamar lain?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "57fb8f81aea00f554ef097241a0996deb287402f6a80f092b89a17d1cd512118",
      "text": "produktif",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5af94bb18742fdca6367a8b10236b2147c639d02eabdd6ba7a5ede05fd18c84a",
      "text": "Saya menguasai bahasa Arab, sehingga saya bisa membantu klien dari Timur Tengah.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c07fcecadbeb2b7fefbe43aba0cc3886e4842555df173f178266974de704a1f",
      "text": "konsultan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e769f73849dd39196b7a09f6581e8677cf533481ba101c37bc7ac2bc9442872",
      "text": "Bawahan saya mendapat ___ setelah kecelakaan kerja di tambang.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f3ba11f1474f5792cc2cb53784584e03c1d9ca3df649bc606c6af581e1ed6c3",
      "text": "Saya dari Kairo. Setelah saya lulus, saya bekerja sebagai penerjemah selama empat tahun.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "6230be9e48c679c2cf4f19043db615e88d8551ac7353f1060703894048b0d212",
      "text": "Gajinya kecil, sehingga dia mencari pekerjaan lain.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "6464023935857344ee570ae189431f8518f6184badc54c52e4a1e454d38264f1",
      "text": "Pengangguran di kalangan anak muda masih tinggi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "65132c1a8512a7f8694f8fc9ddf707b64785253bb80d360301c3ae11b7b9603b",
      "text": "Suratmu bagus, tapi kok ada kata \"nggak\" di sini?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6662b413f82dca08b86b02d41faf9aebebc173bf117f69671180b67ff29d36da",
      "text": "Semoga masalah finansialnya cepet beres, ya.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "668046a6d1803471dda5e25e331da0fb9c0f0692670de9a6d3bab1ef55f80fb1",
      "text": "Bagus. Apakah Anda bersedia ditempatkan di Samarinda?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "67eda382092c3869dba7452b197e568ce4acdcf27ee75f7be79b3a0cef5a00a2",
      "text": "ijazah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d6caacc826fa79f66e8c8b8f8615c94e737c1975767edc68db3f26319b69bd2",
      "text": "lowongan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d8cf5c113a13648a9ac9767e689118edd6ec1fd53130acad97187b6f69dd8b6",
      "text": "Terima kasih, Bu. Apakah ada kabar baik?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ea0e2af6ed4986c1cabf9cb3818f6bcf9105c981f498e4542df23d8e37ce7f5",
      "text": "Mereka nyari orang yang udah punya pengalaman, karena proyeknya gede.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f64cfe3f54bc7a7f6793e34cca4316e538dff7cd9f9b154284e0b377c19b8ad",
      "text": "Pasti, dong! Kamu kan pelamar yang berminat dan berpengalaman.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "7007b596e3c66f5753a03ffae4bdbbce8b00b178763a88d3690bcc459834536d",
      "text": "Pengunduran dirinya mengejutkan semua orang.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a87c2387335af66f12df19b621e15fcdde17c97964cc933f99dd566d2013a2",
      "text": "Dengan hormat, saya ingin melamar lowongan itu.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "73d1e7f74a52900356e6647c9fbf59c3f0f65a43db84e2dc0c3c61c5fbe11d95",
      "text": "Dengan hormat, saya ingin melamar posisi staf administrasi.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "73f2018a0b2caf1252712bbdf66b0b8b53298c07cc0c1fc77d4c61b751c5018d",
      "text": "magang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7411b00594bd6dcc4a9bf987043e572b2bdef1e288f32c83c82ca678195f0dac",
      "text": "lulus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "74f074ab90567047c0d3c8358f5070bcebb45496c793b9ce057710f40dc18b3c",
      "text": "orientasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "75d0bb4ec8f6ec0a705d6173778d9d09be71313b474a5cbcf3a3471134c6f995",
      "text": "Perusahaan pertambangan itu merekrut lima puluh orang.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "760475f29860581a716b3d815c142c12eeb0ead17107aa75258a064bf6f80d2d",
      "text": "Pendidikan terakhir saya S1, dan saya punya sertifikat BIPA.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "7631d9799729938e1db750f027ee67025d84bfb5c1e99f4dd74ccc069c7ca7b9",
      "text": "Mohamed, ini Bu Lestari, atasan di kantor kami.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "765f10a42c19f7eab3d33e89f3b3df25714ab15889497f66d4d29bab1dc1d14a",
      "text": "Siap. Semoga mereka mau mempertimbangkan lamaranku.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "76965470a6ef17f331b02046aa397eede94ae9ded284b13631ca0a61f41e1dd9",
      "text": "Dia sungkan menolak karena yang meminta atasannya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "76baafead0a4139d54f93a6063fc49304bdbbfa5a800ac84552871fbeb16c50d",
      "text": "Atasan yang baik mendengarkan bawahannya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "76ce1576b75d212dee5ac47573ee08070bd2920cc679c130657e51b54b707e33",
      "text": "Saya bersedia ditempatkan di luar kota, karena saya ingin mengembangkan diri.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "796f7418cdb973ca49bbbd02b71e9cafe50731934507f539a1f481c1a655ff68",
      "text": "Surat pengunduran diri saya sudah di meja Bapak.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a31fd3bef4facd76cfbd3d9ef1aa225d0f79cf41435ed3cc4651d4bc689eeac",
      "text": "dibutuhkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b6b0c3c8b895548d43d63e5377d8361c6e865392b1936c8adaf0a4e9b3a8b3e",
      "text": "akuntan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c818afa501639d87dccaf756137a875da37c3bf5018ca4acc83e02017bdab62",
      "text": "keunggulan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e5dc6880e885e133d785a628b7836c7673dc5882ad08d3639150c49bb34a562",
      "text": "Karyawan baru mendapat pendamping selama sebulan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f7f5629566d49b43157893e010a510afe6af58209446d9faed9aa5cf485144d",
      "text": "Bagus. Adikku masih pengangguran, jadi aku bantuin dia.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fd8b66badfbdf4b57df4494be213aadf2b394d6ed8d0c2dcafe0029b46ee49d",
      "text": "Terima kasih, Bu. Saya butuh bimbingan Ibu.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "81552ef670212f19fe2da3853a0fe118e3e1223f244e3bf0d2244132cfb41488",
      "text": "Besar harapan saya Bapak bersedia mempertimbangkan lamaran saya.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "8224e01c7d2273ef09e864ea50db09cf48356ac7d5db1fe159817af787f59bf9",
      "text": "Terima kasih, Pak. Apa ada yang perlu saya perbaiki?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "82dc21d0fe5208939dc9815272d8339a06bb4c9e4e88838dc5394327766e6e25",
      "text": "Setelah saya lulus, saya bekerja di bidang pemasaran selama lima tahun.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "86b28e7ec7e5662005a912068c42cb56bd9f25154276fffaac08f89c482b5ec7",
      "text": "upah",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "88e21aed9f3e8674af0858addcd9c899ab23bc6942d3b9ab3442c75a0d3b7b83",
      "text": "Kelebihan saya adalah teliti, sehingga laporan saya jarang salah.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "8db081bbac3b275c72c4a356d93db2ba6ac9b026273efcb6aaaa3060578b59a2",
      "text": "berkas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e1d0cf9dbde3c57b2b3d0566b9fc15fbf775ee4aec732a1c2d6ac3887792cb6",
      "text": "Wah, cocok banget buat kamu! Ada tunjangan rumah juga, lho.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f657b051b86e770b3d9e701ca836998cdab7bb20cab40791b93a827508b48d3",
      "text": "Saya menabung sedikit setiap bulan.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9081527c130d83e04d36c9e6726b6b4c1a0b5572c8353bd813c79b237080d0ba",
      "text": "Dia membantu saya tanpa minta imbalan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "90ce72ae8bd2cb723d85648beb867bfa7b89402a9a2ac27a94c21ce17e69e779",
      "text": "Alhamdulillah! Kapan saya bisa mulai, Bu?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "90d98b92820a1a2945b7ba1555541f38e072a5b73e49cb31452fd9d7c7c03273",
      "text": "sertifikat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "96b0d1419cffa32d81eb051c45dfc43f3b4df50a28998b528cae94b4d13440f7",
      "text": "sehubungan dengan",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "979c49c6dd8e83de1da89d0bb32d057cea3712ca06aaa999cc5d8f6756c0c7f2",
      "text": "kualifikasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "980dfce8161f7d848392bd70c63da7296e704e00b2f47ba7b721d8559cff34ea",
      "text": "Tenang, Bu. Saya selalu datang tepat waktu.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "98b4f9adfd50eae8784a8eca8aa22120586fd98acda249352baa437bf9dcbeb3",
      "text": "kontraktor",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d2622b9357c7661e7ffed2bc68139737bd421f0e567861dcc7b433985d6b8d3",
      "text": "tabungan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eeb1a858e3194c5db3bda1c5ce5fc5c43dd32d975de007f5a99557620173117",
      "text": "Timnya kecil, tetapi sangat produktif.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f1f384433047d5d792012a3a3795ceb8ba8d8b6f2c6f8fc758bd8ed198a3e21",
      "text": "Itu basa-basi aja. Mereka nggak beneran nawarin makanan, kok.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a124903489c2f74c1a513ac6b558b826dbd89e969bf66a5fd41d89c943d795a6",
      "text": "Kualifikasinya apa aja?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1f6a91e2ee2b753892a5786f6566d998bfc93558e7d09d92527b4a2a66c3131",
      "text": "Mas, kenapa sih rekan kerja selalu nanya \"udah makan?\" sebelum rapat?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2048a9d957e2d391a0af360d25539b6947121015cb0307d64a4c9a0a5e8d9be",
      "text": "bimbingan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a52a1d72d2a581ef181745b47f9dde853f7a8e805866b0c3346d04a5514eb992",
      "text": "Mereka sungkan. Jadi bilangnya \"akan saya usahakan\" aja.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5942078781bc2a4114847628dc8a6700cb35383d5aedb15601297c0913297ff",
      "text": "bertanggung jawab",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa3654d6ab0e079e32936559263045b1743fd251091bf17b92306fade48437d8",
      "text": "Lampirkan CV, ijazah, dan foto terbaru.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "aae97b392888aa7e4f7de523043b00d9f81261f26c31ab1dd137426bd68e711e",
      "text": "Persaingannya ketat, jadi tunjukkan inisiatif dan kontribusi Anda.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "acb2e510939e8a8edc022d19ee39147c8011854134d6e812973faffa367b56a4",
      "text": "jam karet",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad01b58ee68897f33f4c9ff9e4a81c746f5805140ba50fdad62e4856a7946a5a",
      "text": "Saya berminat melamar posisi penerjemah di perusahaan Bapak.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "aef2dbc6984f981114e11aa02d8344260c4d1fcff618a95300156c339c320084",
      "text": "Masa percobaan Anda tiga bulan. Setelah itu kontrak Anda bisa diperpanjang.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "af651c186a208a1f1f191ce69087d3ee3728ddbeecb4360d8f3146262ef4654e",
      "text": "evaluasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b29aa3548e9f4331d1eb11a7d1a4f0152260457d27b28df8b53dbdd587b3d270",
      "text": "Pelamar itu tidak dipanggil karena ___-nya kurang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5909fdfd1ac61754bfffb8da353bc38aac7260b27285dcde0c124963faf9494",
      "text": "Kapan orientasi untuk karyawan baru dimulai, Bu?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7873348126949935c9702373dd740f995e77a5db622846182aa8256977bc456",
      "text": "Pak Mohamed, ini evaluasi tiga bulan pertama Anda.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b98fabad5806c4edd71a886a88e8eb2d3bbc45892a4baded2cca3db5d828b005",
      "text": "Karena saya punya pengalaman lima tahun, saya berminat melamar posisi ini.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd12b746b6c87bdc89ed05a024d0f3412ff3d3a91cbadb7ade924101e2c4921",
      "text": "Kamu udah kirim berkasnya belum?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c125e830189329c50d47ee688cda6ac68d4a4481282b6f0f0ff25ec04c80e095",
      "text": "Terus aku tulis apa, dong? \"Fasih berbahasa Arab\"?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3555e0aa28ff8c9908cf2342c5306205d18f114d67752f2074de6ac8e54be45",
      "text": "Selamat pagi, Pak Mohamed. Silakan ceritakan tentang diri Anda.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c40cf55696f8fc2bc0385e17a15e985ba745ed70ef437d666771b0d5eb4165a9",
      "text": "menabung",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4c45aed126ac5938998020c50e1ede2860477dad6728fb13568ab5a730b9f4d",
      "text": "kontribusi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4caeda62a0bc66d44e4579414ae54c02a2a2dc2089889fb74e00094a54f10f0",
      "text": "Terus kenapa bawahan Pak Hendra nggak pernah bilang \"tidak\"?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5c5b82926b7455f11ad7f7de9219d1f33eac4f169e3d52e0eadc0868020066a",
      "text": "Iklan itu menyebutkan bahwa ___ utamanya adalah pengalaman dua tahun.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6bd0ad85f8e0b28167283967f7e0ab11edacca8455d8ad33adc288ea52b3b41",
      "text": "efisien",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8a1ed2b96f014ddd8f9f6eb166ad242e4af548a58f63fce102429d6df1db1af",
      "text": "Itu Pak Yusuf, akuntan kami. Di sebelahnya Mbak Wati, desainer.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9110b23b92490d7ffedaa525c44373abff407f162b0539a99b50eebcd293c49",
      "text": "Pak Mohamed, ini wawancara kedua. Saya ingin menjelaskan tata tertib kantor kami.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "c920358443d6208f61335c9a9376a8847f90d9d3a0f3fa38eeb5613e3da27dc3",
      "text": "Saya pernah magang selama enam bulan di sebuah bank dan menangani arsip nasabah.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9e1718d80edfb36b0aeaf3b20764f0746c7cdd27b89989444a4c2c2beeec230",
      "text": "Menurut tata tertib, karyawan tidak boleh pakai jam karet.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca954b8679ea55d9ca88b6bec13fc213ae7f873325973d139697b5325822efe3",
      "text": "Akuntan kami sedang memeriksa laporan pajak.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa8a4c75c4838975b619379f5b7dc2d7ce1d979a9cc2b658949a03b7fc2b7f7",
      "text": "Silakan ceritakan tentang diri Anda.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "cea5fa69b417d995338147c7a9b42c1daeb143f721ec421bccac8d3abbacc8a8",
      "text": "melampirkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf8db5ebcb94f0fae24c170eaf68a07cf76104e0795b1c87d4d74a25d82ff550",
      "text": "Saya bersedia. Siapa yang bertanggung jawab atas orientasi itu?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "cff054f47346d7707518dde979967f749eff18681f60d3f2e915115c90f17f26",
      "text": "bersedia",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0610ab32e5829799348ab2590098d604f3e2a8053397d8a4cb385cc591a37be",
      "text": "Pasti dihitung, dong! Klien mereka banyak yang dari Timur Tengah, jadi bahasa Arab penting banget.",
      "voice": "id_ardi",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0e5e8dd916be166b3b647e5bd86912e9a71791ab5094d94b12d0209ce033624",
      "text": "Selama masa percobaan, saya tidak pernah pakai jam karet.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d312c4c17ef5916aae03b6bfbd895904d0d131b1eeae8d872a8bab39d2fa2cca",
      "text": "Mas Rizal, syarat lowongan ini apa aja, sih?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d32b8023b1770f1bdf848a5be6be36d1f17d20fa7ca7a2a0d73a8ebbd6154661",
      "text": "Sudah, Pak Mohamed. Terima kasih. Rekan kerja Anda menunggu di ruang rapat.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d475898bfa442390b6ca03c5dc2a59570862b2ee214041aaeb6784800d62329d",
      "text": "Pak Hendra, calon atasan Anda. Beliau tidak suka jam karet, ya!",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "d606fd6da5d878b5cebff41e12585b984cc0a2383269fc09600446248ba03101",
      "text": "fasih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a1ecd45a8d750617f33e8b16afa5328969de262ab93c0f19dfb70e5593632f",
      "text": "Bertanggung jawab atas terjemahan kontrak dari bahasa Arab.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9bb989e29d75bc195450ed55d39674c413c7f4fd3058319636b9cd24ba2e579",
      "text": "Kalau keahlian bahasa Arab dihitung, aku mau ngelamar.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d862c87b77ca6d7569950f756e222d7217c898dec1010ae2ccf38fcf5cb0f3",
      "text": "Tabungan saya cukup untuk tiga bulan.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "db239b70efd0ac2ec074249c9bc6a226fb70e188bc4221a165cb2f247bfe61b8",
      "text": "diri",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "df008c89a4e5589016bea48d4fae89fcbab57fc82569d6a967c486c69fb6a3f0",
      "text": "Persaingan di dunia pertambangan makin ketat.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfc5d1645332767c9dd16a44da7af0c77cfb36816dd2562bf31f95352334654c",
      "text": "Terjemahan Anda konsisten dan efisien. Kontribusi Anda jelas.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0b0ac334f1315f91a4321c683cc4fb7731bfaa7471f72642bfce5b9c337da56",
      "text": "Selamat datang, Pak Mohamed. Saya pendamping Anda bulan ini.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e12c913767a55daa8447b1ee29332b1faa72037ccf8953539c1474030617fc48",
      "text": "Dan bapak di ruang rapat itu?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e132c431db9e5162f7b8fa1b8b4f55e745d5640c5e857092fa2d6355090574b7",
      "text": "Pendamping saya seorang pakar dan dulu kontraktor.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e14f76351ad860ec5f42eff3a94297fbb97f50961703a5297d3c75f33c680679",
      "text": "Nah, betul. Terus tulis pengalamanmu, misalnya \"menangani klien dari Timur Tengah\".",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "e19d0085a9bee1f4aff55e49c3bdc6504133ebdf86ac2121cc8572c8ad520a52",
      "text": "Beliau pakar energi, bukan sekadar akuntan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e39fdb01a78223650e147476241adf66cac15d3d911f712864e725edbf17f515",
      "text": "tata tertib",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5b3817936f65d337024bf51228e7325df3a01adc23768ee2fa548378c0bcba8",
      "text": "Saya bertanggung jawab atas semua sertifikat dan dokumen karyawan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5bf8b2a20eaab8688fcd4a16e7bf2626c050dcec7b04507782e411258c60a4b",
      "text": "Itu keunggulan saya, Pak. Saya siap.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fff8618f1960be67dcabdaf9c268bc00824af023cf67f920095b022d33a3e1",
      "text": "Ada. Karena pengalaman Anda sesuai, kami menerima Anda sebagai penerjemah.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "e606e5ce1c69178f93299dee59237048011059e2dff18bbc1fbc5969f7d4a209",
      "text": "Sehubungan dengan iklan lowongan itu, saya melampirkan ijazah saya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e65e6f2c7d37b607687216ca7deed9c6181f6708eedd51ba6e727a74b293783b",
      "text": "Nggak. Sekarang dia lagi ngobrol sama konsultan karier soal profesi baru.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "e683740f3b726f4d47fc9b55588e3a9e18446b80e0c8883380d14e5c17262c8c",
      "text": "Kami mencari orang yang berkomitmen dan punya inisiatif.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e907a664dc2dd699715da3e9dce8d4dabb64785ffe0318113a05424db4e71ade",
      "text": "Waduh, aku lupa. Harus \"tidak\", ya?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9f57b8686f3ba24eef00d7cbbbbf36df62cf63b8f7332566b21717d7941a54d",
      "text": "Apakah Bapak sudah menerima berkas saya?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebd76ffd1404d6d56bf3cf2f263918dc53afbd66f761dd338c47ff03a16d288b",
      "text": "tunjangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec7120b984dbcf9f448a5de19af91dff5574c111a63fc180476f41ad8a149de9",
      "text": "Mohamed, di CV-mu kok cuma tertulis \"saya bisa bahasa Arab\"? Kurang kuat, tuh!",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecfad34105d30dc6274e11a102761800f225bd183f7de7e6e870e42b6a53bcdb",
      "text": "Ada, tiga bulan. Minggu pertama ada orientasi untuk karyawan baru.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee8c59f240f86946da9ab7ddb62d8fd676854944fb91e7272741f2b3efc81a5d",
      "text": "pakar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef096afa0814466a2fd42021ec4b96cca2498e9b8382925951f3673736151582",
      "text": "pertambangan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f00d6447ba5f6b708d267c0fb79b6e6aecaf08f74bdfe0cf81efd96d52402381",
      "text": "bawahan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f04470663d4df7c9f2a73e9fc54d4bda1a1ffc0348880233f0c88e4b74467e34",
      "text": "Konsultan keuangan membantu kami membuat rencana finansial.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7bd7d0537115739a6fb81cf5418e119f60ca555c6d8ea1a2d1e6e828acbc16c",
      "text": "majikan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7eebdd84e7379667c5a618a79b93754657fe7cb54e17009f9ae8c3eb35ce88d",
      "text": "Saya senang mendengarnya. Saya ingin lebih produktif lagi.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa36e52153ff3c39542bcbb2331e2325367774d95514a2332737f4ce8ec868fe",
      "text": "gaji",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb0249425a2099bc637a20c42cc5e681f661ee0f4bc141d347a634843097cbbf",
      "text": "melamar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdf78decd5d04333efc260016651fbf39b780f972deda34a872cbdffbc48c7b0",
      "text": "masa percobaan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff50d8a98813ce67fc593ecb326b787aa17f13ceeef779d1509c761e932e03ab",
      "text": "Kirim fotonya aja dulu. Yang penting kamu dipanggil wawancara!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff621981f9d940571fdc7c2a581bd1925a7fef98d82da494f2550a488bfa231b",
      "text": "Saya punya kualifikasi sebagai analis data.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 13,
    "clips": 199,
    "chars": 8258,
    "audio_bytes": 0,
    "missing": 199
  }
}
