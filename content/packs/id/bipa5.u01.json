    },
    {
      "key": "e5fff8618f1960be67dcabdaf9c268bc00824af023cf67f920095b022d33a3e1",
      "text": "Ada. Karena pengalaman Anda sesuai, kami menerima Anda sebagai penerjemah.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "e606e5ce1c69178f93299dee59237048011059e2dff18bbc1fbc5969f7d4a209",
      "text": "Sehubungan dengan iklan lowongan itu, saya melampirkan ijazah saya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
