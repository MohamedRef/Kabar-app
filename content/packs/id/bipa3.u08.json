  "unit": "bipa3.u08",
  "version": 5,
  "content_hash": "6cdae5b05cb2b69daa17a80b5ae131aa0f0009360e0e0742f35dfa6b67b26356",
  "lessons": [
    {
      "id": "bipa3.u08.l01",
      "sha256": "b93a4dd03168902908a726c2fcf108c461d349070227d021857839b320ded5e7"
    },
    {
      "id": "bipa3.u08.l02",
      "sha256": "90e06e4b313c5a03086d6d3cb1adcf5b0b2dea5b539a6387ff5113d3a7dd333f"
    },
    {
      "id": "bipa3.u08.l03",
      "sha256": "ee59cef1ca3ca9a57b43278d4fdd48f7f1d4b0a38ce469a3a6c5316504623d44"
    },
    {
      "id": "bipa3.u08.l04",
      "sha256": "756a529be1f71f6ca6f802a94202b88d5468384765c8d7b76e509994d217c9ee"
    },
    {
      "id": "bipa3.u08.l05",
      "sha256": "36d4ef1e508da3bce00adc2d8db655bcd1150bced9df31969a11843222bc1ded"
    },
    {
      "id": "bipa3.u08.l06",
      "sha256": "c2f931b06befa1bcdc198f283ece3f1051cd602948f9a2a1c06e99540edaefd4"
    },
    {
      "id": "bipa3.u08.l07",
      "sha256": "70c14c0fe5c62b826d53d79ac5e46382d91f640d1fa4840d8cba938dc69e313e"
    }
  ],
  "audio": [
    {
      "key": "00200f249604dee456d60fb9ad0118b1fddcad1e642d45ba963ee416d26fad85",
      "text": "Bawa tas siaga bencana, dan jauhi jembatan supaya selamat.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0065911baabb6546e5e55979f4488a04dd6fbadb398f554b18a7cf3c5ab55a61",
      "text": "deras",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e86a193f4d4eb5eb798e19fe965d503970206e35843266530a865363aca2152",
      "text": "asap",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "18ec0bc6acbf8c79c78ba50a3a44f9f18d2bad8fb320aa0b472820cdc3fb710f",
      "text": "Mas, ini poster tentang apa?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "198886444d09a532f0f05653f961d10f4f4d3aa223bea6d134295f9cc3b72e8b",
      "text": "Gempa itu tidak hanya merusak rumah, tetapi juga sekolah.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "19a0b2bd8e603070e6e5a02e14863eb7bfe7fb7f6867c596dd079ca81d8b7bc4",
      "text": "mengungsi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bfe857fe21757f5c5e15774742b51309ca58be4a8d4b6cd4edc69023401b645",
      "text": "Itu bukan asap, melainkan awan di puncak Rinjani.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c90d83b206a916a7a84d07edac5b79be0ed4a57690aafe1ec5cef8ab532da70",
      "text": "Baik guru ___ murid ikut latihan gempa.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2121214eecaaebbccbf6b44d0a2a9b01bf4ea5a6d8d931ea8b0331bc9d76ecd4",
      "text": "Bawa jas hujan supaya tidak basah.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "23b883eedadfd57a047fd1c45f9775c2f759148fd51a88cfa71a507c706b8ad1",
      "text": "Kemudian, jauhi jendela dan lemari.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "23be5dec7f7af4c2ff23f1a232223bf847421633c2bfee86ea9e850a102a1dda",
      "text": "Rumah di sini juga dibangun agar tahan gempa.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "24de35a4c5889d9c5665609519127a5d38d8fb913b883f8c2835b11d154f05e8",
      "text": "Warga belajar tentang gempa ___ tidak panik.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "27e9f0fb2610ac3ee6853069c2fc436233ab26e6eb2ee568e094052cc094c3ae",
      "text": "Setelah gempa berhenti, semua warga pergi ke ___.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "28f68a1386194b173d12dab058fef4ca1be41da510c66e51d4aeb3f6ca2c6621",
      "text": "lapangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "28f8b05361ed307ddae9795c18a4d5a246fb50c705fb3cbb6194cdab7a23118f",
      "text": "Setelah guncangan berhenti, keluar ke lapangan. Kalau rumahnya retak, jangan masuk lagi.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "295c5af6914bfef8a6bd9abb5428009c19ef8c29af65b0b7d7365e55b9d04b14",
      "text": "Setelah gempa berhenti, bawa tas siaga bencana dan keluar ke lapangan.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d8bdc40747333110ba1e39ff907d8d69068cccf04fbd20f3125bd29c08b1222",
      "text": "Baik, Bu. Saya bawa tasnya sekarang. Ayo, kita pergi!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "318d6af9549c8e6fc27642371c9648a74fe30406787abc031579602b2bb8d24a",
      "text": "Sungai meluap sehingga desa itu banjir.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e779420fc5a74d1593b585c70b01ce4d57f761bd3682459c981466e0ff710c",
      "text": "Seandainya saya tinggal di Tetebatu, saya akan bangun pagi untuk melihat Rinjani.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "32ae9ee20f81908a2bcd1511ae5af19b8a9547bec89db7020f68fc7b6c333cf3",
      "text": "Perhatian, perhatian! Hujan turun deras sejak tadi pagi sehingga sungai meluap.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "3463905f8c8639e90111494374ecf1357b302d5c030d86b30af48b28277ad904",
      "text": "Pertama, berlindung di bawah meja. Setelah guncangan berhenti, keluar ke lapangan.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "36e5a2e5f9338ed2fe4fd3b021ffd5627eadf1058b3d5dc138ff2d2282f9b067",
      "text": "Selanjutnya, bawa tas siaga bencana.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "40c40e5b67737a1295b22efa6e0ec049f57409f58ea2c4182696984c6421533f",
      "text": "Lihat, Mas! Ada asap di puncak Rinjani!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4245084eb2d64ac5721e040cf137c40c11f5beb733f8cd45add4be01c82e3e7b",
      "text": "Akhirnya, tunggu di lapangan sampai gempa selesai.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "462c9a0409c0c7346678298c3af731913b5728d0914965665b369ce7ccd0b85e",
      "text": "Setelah itu?",
      "voice": "id_ardi",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "46bf0c4999576681bb66540255c60ad625f0c1bdc25f42f1bb770a915d4f3c12",
      "text": "Pertama, berlindung di bawah meja.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "46cfc2887a2908ebee6b021112b22c7acb524286944cad344cd0f0181f654529",
      "text": "puncak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "48eb2e91f4f3da61f146bcb25950c7528211d9945e8c6b264866db45c6c99dc1",
      "text": "tas siaga",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4953fe94a3af26740280e13633983cd8b149ed78728ca7b48926c3b3f953b15f",
      "text": "maupun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d6489699d47b2ba6dc688dcc9291588ca9a05225d85261c164d0ab9d715abdb",
      "text": "Hujan turun deras semalaman sehingga sungai meluap.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e2a9a84744fb96dad77454ccff5020fcb0179931095b3dc20b062cecf057e56",
      "text": "Kalau begitu, baik turis maupun warga harus selalu mendengar petugas.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eeba3e3bf849eae6f50743d54e2a6b82b203a3b40f0f5d8bd9391f70bddec03",
      "text": "Kalau terjadi gempa, segera keluar dari rumah.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ba73ff3e185012e41fe2c1699908738ff68029fe9d34224aa18757a519e312",
      "text": "retak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "50d91a309113d4216b732d8ddcb8660dfc81cf2d859aaf704936088f787f4702",
      "text": "seandainya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "50df88ea10e0af2183b35ad4ddf77016896d55266e45f88377303c590f070ae3",
      "text": "banjir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "545aa519730380d3d5608c573603edf9b59e2dc54589191f55c026f947ae0282",
      "text": "Rumah ini dibangun agar tahan gempa.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a72d5a599674ba5518c576efb34ad595b1fde17721cba6e7b2020b1b424f3e0",
      "text": "Hujan sangat deras ___ jalan banjir.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e87b54fa88779b6625522bb2e14a21e2ed20f805b9f30fad6824ba1a77d7fa5",
      "text": "panik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "60148d10c3ff7159ad22f112611db2fdc277ab53ac3aae4b68e9283a243e2b94",
      "text": "Ha-ha. Kami sudah biasa.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "61a0ae6dff64ebb5a06e2dd702e83f6214f774474aeb631c4352c9febd2495a7",
      "text": "Bu Endah, kalau terjadi gempa malam ini, saya harus bagaimana?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "63f33de57a97b1018bd2c2a70368fd9dc0bbcb0e7d204bb4203bbeb47ff19b09",
      "text": "bencana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "64eff46f30b3d5e956f67721bfee264b12bf3ab4ff63ddb7c0e270d62ff066e1",
      "text": "Apakah desanya banjir?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6756705d3e7b7ad385861c1f510f2af21ddb71f66daef53281dc5dcb9ec0a741",
      "text": "Kalau ada guncangan, jangan panik.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6799c03769066bc03030c61f22eb2e727868fe8ddf80d9ff3946aa95a4245e77",
      "text": "Bagaimana kalau Gunung Rinjani meletus?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6913d52fd556e8d59e5acbf2142b1d261d748b97f0e5f752fbe6d45d5ce3e6c7",
      "text": "Danau di atas Gunung Rinjani. Bukan hanya indah, tetapi juga sangat penting bagi orang Sasak.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b3979ee4e7e8dd00429ceb56ba44b2c525dc178799ac028557680f47cbad236",
      "text": "Sungai meluap sehingga jalan banjir.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "704826810a46a3aec74f47c80eb32a5997e779fab2da322aa60afecd129427c7",
      "text": "Rumah kita dekat sungai, kan? Kita harus ke mana?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "751c185e6a199cd0f324834ba4237e197b8886a2d485b8d453e3f11f1ae6db47",
      "text": "Tentang gempa. Pertama, berlindung di bawah meja. Kemudian, jauhi jendela.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "77cf980d0ad296f13a7a3d5da93cb79a837996b2a00540a64e6571216ab706a3",
      "text": "Seandainya saya tinggal di sini, saya pasti sering khawatir!",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "78e0777732a487e8eb120625c6031f5c6d8861cfe1b5be79d6957c260a2a3942",
      "text": "Tenang. Kalau ada guncangan, jangan panik.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c8f3e13da0c71f6898367db29b8e532589b7e39c99fe6733d3d2144c615bea3",
      "text": "Baik turis ___ warga ikut membantu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e6f9922432270942116cba1163edef3cd4d56469310c48563cd814a2255cc86",
      "text": "Bawa tas siaga bencana supaya kamu siap.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8658601f90d35feef06b5215715b3dd8566670210cbbcf5a198fd00e729d3757",
      "text": "___ terjadi gempa, segera keluar dari rumah.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "883cc62d08fa7433e3205d7439571322c84f772b7a7f355de4f67bdb9b5b20ce",
      "text": "Jika gunung berapi meletus, warga harus mengungsi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "8929b1136c81f51c5478f29af837a0254a25f6cb17870861b571ed1f14bcd7c9",
      "text": "Baik warga Lombok maupun orang dari luar Lombok ikut membantu.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b3077c313b81d5cfff240e78d83e0c56bf6d12ae0919631819cd2259870d372",
      "text": "warga",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c60056bd9132a1cab192f10fabb4746c64d0ecb75267e41b28c10d7c4c7c0a0",
      "text": "guncangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ecadf0ac0910b583366b6edb2203c2bfe1f7ea1c14d52d84361151d8ca364b1",
      "text": "Seandainya saya tinggal di Tetebatu, saya akan melihat Rinjani setiap pagi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "90429479edb59fbe3289569ca739ebf303406bff2b13f02826769a4b7cf5e308",
      "text": "Ke masjid. Bawa tas siaga bencana, dan jangan lewat jembatan, ya.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "906407d33fe678446e3e7c19efe92b7413ca5e3c429fbfdf0134784dd80e15fb",
      "text": "Pertama, berlindung di bawah meja. Kemudian, jauhi jendela.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "909520e99952a16859534a88055a4857860ce474674c0c4f0e0755388e3d3928",
      "text": "Di dalam ___ ada air, senter, dan obat.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "90d807f5ad49878498b27092e152a086b1a9039ff19551f15ee12e1d3a0e2298",
      "text": "Rumah sekarang dibangun lebih kuat agar tahan gempa.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "938c60a00ffe75a481de08845c6a2a93d027e7687a402d8b3503cb2c44db2761",
      "text": "meluap",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9651c854a50d04bc88aeb0fa1077be733050867e1b542d414aa5808e05ca67fb",
      "text": "Ya. Kemarin hujan semalaman sehingga sungai di Tetebatu meluap.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c4a89be0542594408b003a43193e42081088757d26427be2561b78e9e9daca",
      "text": "Hujan turun deras sejak tadi pagi ___ sungai meluap.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f010301ad7b7e1141389b2d1cae7dabd3031fdfc9697eee44a720dc2a8fb6a",
      "text": "merusak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab54c510c28d329301a5cd009939f958e24548e6408114d83b3bea26aea466df",
      "text": "Warga yang tinggal dekat sungai harus segera mengungsi ke masjid.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac24b38ee1e1f8e9b0a459651bfb75dd10c0fe2e300487ed0a4562bae4694e71",
      "text": "terjadi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0859201eee2b0149376fb46ed43e4802764f1e86199d65d59cdfc4eebb464f5",
      "text": "meletus",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b314c9631374854bbab9b7f9ed92399e1fe6ba45d16f55fcbf3a6017df3af5c9",
      "text": "Bukan hanya warga Tetebatu, tetapi juga turis ikut membantu.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b77ba7967d72935d96928401d6a4244a1802c1b3d0643848cc1f4b111f11b849",
      "text": "menjauhi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b947c73dcd2329ea426a70775c8f1ffd534e027a050ee5eacb6ffafbab2535d1",
      "text": "Lalu aku harus bagaimana?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab419ccc4c97b6ac4db1ec28429f824bfdb486ef6567df464d477a62259df83",
      "text": "Tenang saja. Segera keluar dan pergi ke depan masjid.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "badd4aca199aed6e62747563743ee45294028505da872670977d7e144a639b1c",
      "text": "Kalau terjadi gempa, jangan panik supaya kamu bisa berpikir.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd33db944afc491a5aeaa946cbf989314dc2df980c71be1fed20ebb367603a0",
      "text": "Rumah itu ___ karena gempa, jadi jangan masuk.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf23e676c694d4e0e1fb1c19180bba903ecb36d673d2e8935b72c1339810834a",
      "text": "Apakah Rinjani masih gunung berapi?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd5248402fdade83e0a2289a47244682ef8ee36cc10a44db70a08b2bab15fba",
      "text": "Itu bukan awan, ___ asap dari gunung berapi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c06e21777902c39be7e7495ae33e8bd66593a2d6eaaf9fc98b4be09f8ac2a51d",
      "text": "Ya. Gempa itu tidak hanya merusak rumah, tetapi juga jembatan dan masjid.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8f5b7d9b5c534a3d435f2cd8b08f1bce1f2bb362fa2c99f5161281e0ad6c59e",
      "text": "basah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c903ea94b40ff488330ace9d5f360317575e33985456ae2240bb8b4bfbc32e88",
      "text": "jembatan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9316d5b4bc7493de8b8c5fd92cc1ec4e184011455e251d303b33020c1a62459",
      "text": "Mohamed, ini pertama kali aku ke Lombok. Aku agak khawatir soal gempa.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "c97c3d3601d76aef33dd6cb1b9a112cc412a4fa8bc0dad41e28ce7d2025694eb",
      "text": "Oh, syukurlah. Apakah gempa tahun 2018 juga merusak desa ini?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbf8a2a31d0a553bbebb18a2eb7c7b4c6986dc0d286fa6c9389ba19e856a5cb2",
      "text": "Jika gunung berapi meletus, semua warga harus mengungsi. Tapi jangan khawatir.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd006bbf5d2949ca24ea068540e009ae51b08782396ec5ccab50f865d4e6d383",
      "text": "Hujan deras sejak pagi sehingga sungai meluap. Warga dekat sungai harus mengungsi.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd144bc27e2da58ca7e90d1245f45783c495a41c955411e57c9ef71d40ee774b",
      "text": "berlindung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cec5e27394a1547b989e767513395f9639b13051c941d5bd3a99bb764bd5afc2",
      "text": "Gempa itu tidak hanya merusak rumah, tetapi juga jalan dan jembatan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf4adf578ad2bf9568c61ae063fcb3de8ffe67e9ff7502fb13dff0732c39a44c",
      "text": "Itu bukan asap, ___ awan.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3089c74d19dd5cc52b3617ce869152897ac1982e0fb7c8cf015c3e449582425",
      "text": "gempa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d39d5ebca6efce8f88c99c167da538d462b2af3d56b05c33a79577b2e3a15ee9",
      "text": "Seandainya saya tinggal di Tetebatu, saya akan bangun pagi setiap hari.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3eb0857b5fbfb468c56d750012e6866795c4318bffe95273920471bfc43b82f",
      "text": "Bu Endah, ada pengumuman dari masjid. Apa katanya?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d56f67977a7d7a00e428813b24cf5fc1972dfac9341b65f3b9944c3be73c97dc",
      "text": "Baik anak-anak maupun orang tua harus tahu jalur evakuasi.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7d4641ed2be6704b08f3775b403bda49997751aa606bd651481d192ef992cb9",
      "text": "Ya. Gunung kecil di tengah danau itu kadang-kadang meletus.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "dda572a9af03c8632f7ab190c5fa11b7e8fc4c92d1a7eebb14b57db003d81bba",
      "text": "Mas Rizal, hujannya deras sekali!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2b4f2428ccd20f4c74d905fd98294210061bdcd11eaf8f79d5209850c9ef47b",
      "text": "gunung berapi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e597182ce9c0925be023e7d1e32f4b173422e46dfd669a8c903bb1bf5e1a7a",
      "text": "Itu bukan asap, melainkan awan.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e628bf230ca72df7dc34626486c6918484a0f9dbafd0b70e924ec54325efacfa",
      "text": "Baik jembatan maupun jalan rusak karena banjir.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "eafdaa4d58c896df238d4fb63ced41e2206955c0f2d4d7693a9d1892516eddf2",
      "text": "Pertama, berlindung di bawah meja supaya kepalamu terlindung.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed1a0910bf417147d7093aae0a68f1d6eafe5eb8427200b9644a8b98573d0ecc",
      "text": "awan",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eed36a30ce10554839244dad01c9ab5b512bb0a2c8a1d6b37a4a806b99658a75",
      "text": "tahan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f42b208f32a0e340c0689368faa678f6ebc4b8b9ce5ddcd56fbc475d1ad8223f",
      "text": "Mas, apa itu Segara Anak?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9e25db210ad145fc71cec329e6930806b4128ed78225fda4afe96cd08d52bbe",
      "text": "Sedikit. Pakai jas hujan ini supaya kamu tidak basah.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc84783b585a9c2e3e1cb9341d81cdda6694609876ddb308bf0cf668325c4281",
      "text": "___ saya punya rumah di Tetebatu, saya akan ke sana setiap liburan.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    }
  ],
