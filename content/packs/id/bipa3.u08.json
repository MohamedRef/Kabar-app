{
  "format": 1,
  "id": "id/bipa3.u08",
  "language": "id",
  "unit": "bipa3.u08",
  "version": 10,
  "content_hash": "b1fca852f404351febf58a2f66e56fe351f89542116cc72fb14f03f0f54a3408",
  "lessons": [
    {
      "id": "bipa3.u08.l01",
      "sha256": "8129d042d1484d59e68c86720e8f709819fe068ce914e2784968ed6096cab025"
    },
    {
      "id": "bipa3.u08.l02",
      "sha256": "8060d96fdb0e238ec6b1570d770c87f4971c8073fdf0c7f977922bfa5a1da4e1"
    },
    {
      "id": "bipa3.u08.l03",
      "sha256": "5c660247f7ec88ae0d5baa35d819c3955e7c16fe374fcda2f02255e74e133641"
    },
    {
      "id": "bipa3.u08.l04",
      "sha256": "d4f988318fd8956414832853fc28830ea5f0430ee43564a316c76852e6587bf4"
    },
    {
      "id": "bipa3.u08.l05",
      "sha256": "4444b8a66fc0f3334b4680e30c40c482dd1e93bfd095426d602ff04a35584d60"
    },
    {
      "id": "bipa3.u08.l06",
      "sha256": "6a584b5a043997ce2322949bec2884033ee30ead0775c4ad01d6e464db54e439"
    },
    {
      "id": "bipa3.u08.l07",
      "sha256": "343a1aba6dc8c517cf621d6652da2a9232179bf7f4d0144832af2e01db74dddb"
    },
    {
      "id": "bipa3.u08.l08",
      "sha256": "b8d13ce8517edf886093b7f47fca76712a9fc8cdac5c82411423a908eb991c88"
    },
    {
      "id": "bipa3.u08.l09",
      "sha256": "9de2ce18836ca7ba4205e88c0239f1f5190a176849c977d774b81e81e69e7444"
    }
  ],
  "audio": [
    {
      "key": "00200f249604dee456d60fb9ad0118b1fddcad1e642d45ba963ee416d26fad85",
      "text": "Bawa tas siaga bencana, dan jauhi jembatan supaya selamat.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0065911baabb6546e5e55979f4488a04dd6fbadb398f554b18a7cf3c5ab55a61",
      "text": "deras",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "01985b4b582691cf84f91adf362a4788a4fdf89c8741fd321102e865e32d6de3",
      "text": "Ke masjid. Bawa tas siaga bencana, terus jangan lewat jembatan, ya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "05e399c20f2292d305e102a90b2f1adf7a1b6de66f3916ff50891a4e8dae058b",
      "text": "Iya. Kemarin hujan semalaman sehingga sungai di Tetebatu meluap.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b9789ef9aa2ad80f9ac027d9e04c7797ec22f68ac9b6eef00bfcedbd24dcf39",
      "text": "akibat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c5ad95f8a768dce14b89f7f868d7b506c2cde2114e97e9a3285514064ae083a",
      "text": "Pastikan semua orang sudah keluar.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dd50319ede5d24e95cb1b6ad23bbad9e29630c87fb9d6f3deea83c86e9d17e0",
      "text": "kegelapan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e7a5d0d01dade243de019da434a7db01cfdf6fa69ac3ddccf3af22f077cf3b8",
      "text": "badai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e86a193f4d4eb5eb798e19fe965d503970206e35843266530a865363aca2152",
      "text": "asap",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f8b9178fb47310f1888abc3589231f1c52311e552975e0ec6dd0d435523682d",
      "text": "Terus aku harus gimana?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "126da1f29d979c79ded6d646cc43c270854dcb07b8385439f935a26eae96b1e5",
      "text": "Ada ledakan di gunung! Semua warga harus mengungsi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b0dec8fa9ea88974387e9e6ed7f4c454df931a73b6490fd021370d0608b582",
      "text": "memastikan / pastikan",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "198886444d09a532f0f05653f961d10f4f4d3aa223bea6d134295f9cc3b72e8b",
      "text": "Gempa itu tidak hanya merusak rumah, tetapi juga sekolah.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "19a0b2bd8e603070e6e5a02e14863eb7bfe7fb7f6867c596dd079ca81d8b7bc4",
      "text": "mengungsi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bfe857fe21757f5c5e15774742b51309ca58be4a8d4b6cd4edc69023401b645",
      "text": "Itu bukan asap, melainkan awan di puncak Rinjani.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c90d83b206a916a7a84d07edac5b79be0ed4a57690aafe1ec5cef8ab532da70",
      "text": "Baik guru ___ murid ikut latihan gempa.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2029d57abdd7f04d23417b3696932f20efceaed916b730ad7f0ffcf350df4d89",
      "text": "Setelah gempa besar di laut, bisa terjadi tsunami. Warga pantai harus segera mengungsi.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "21054228c7687a67eafe23caafaaed59741c861f6e6d1c693553a5c055cc2097",
      "text": "menghancurkan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2121214eecaaebbccbf6b44d0a2a9b01bf4ea5a6d8d931ea8b0331bc9d76ecd4",
      "text": "Bawa jas hujan supaya tidak basah.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "23b883eedadfd57a047fd1c45f9775c2f759148fd51a88cfa71a507c706b8ad1",
      "text": "Kemudian, jauhi jendela dan lemari.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "24a68862179ec8c370b408e6111d801266e3bff245a788312bf9ac1dfbbf3430",
      "text": "tsunami",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "24de35a4c5889d9c5665609519127a5d38d8fb913b883f8c2835b11d154f05e8",
      "text": "Warga belajar tentang gempa ___ tidak panik.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "27e47e6086b977255c9050a0993a76349db390536bf6ffee32e6fc2d8d77f48d",
      "text": "Rumah ini kuat, bisa bertahan. Tapi listrik bisa mati.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "27e9f0fb2610ac3ee6853069c2fc436233ab26e6eb2ee568e094052cc094c3ae",
      "text": "Setelah gempa berhenti, semua warga pergi ke ___.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "28f68a1386194b173d12dab058fef4ca1be41da510c66e51d4aeb3f6ca2c6621",
      "text": "lapangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "29478a76da67a7b7ed2c9951e2eb6926d2a6dafc8c54bc6916d48ef050971e94",
      "text": "Mas Rizal, hujannya deras banget!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "295c5af6914bfef8a6bd9abb5428009c19ef8c29af65b0b7d7365e55b9d04b14",
      "text": "Setelah gempa berhenti, bawa tas siaga bencana dan keluar ke lapangan.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "29c6da724420063d65d68232f526172cfb0ee7a600dcca2c1d324eef9cadec33",
      "text": "Kerusakan akibat banjir itu sangat besar.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b7b1135cfd21776e4a5783ff3f734e0a0f941838f4dbaf19d38b0bb21458650",
      "text": "Selalu waspada! Ada peringatan banjir.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d8bdc40747333110ba1e39ff907d8d69068cccf04fbd20f3125bd29c08b1222",
      "text": "Baik, Bu. Saya bawa tasnya sekarang. Ayo, kita pergi!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "30e6b023c4fcfd2a7b5d938c585990d7c3667eb3f6dd887031d0d88388b57a6b",
      "text": "Kalau gitu, baik turis maupun warga harus selalu dengerin petugas.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "316ab370de83910bbf6f7a609ea2bdb839d2da2da2f44932425985a91b56aa95",
      "text": "Katanya, \"Hujan deras sejak pagi sehingga sungai meluap. Warga dekat sungai harus mengungsi.\"",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "318d6af9549c8e6fc27642371c9648a74fe30406787abc031579602b2bb8d24a",
      "text": "Sungai meluap sehingga desa itu banjir.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "31e779420fc5a74d1593b585c70b01ce4d57f761bd3682459c981466e0ff710c",
      "text": "Seandainya saya tinggal di Tetebatu, saya akan bangun pagi untuk melihat Rinjani.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "328543524deb3cf073fb24ab0f838aab905be8d907c7e0ab61251d93555c840a",
      "text": "hanya",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "32ae9ee20f81908a2bcd1511ae5af19b8a9547bec89db7020f68fc7b6c333cf3",
      "text": "Perhatian, perhatian! Hujan turun deras sejak tadi pagi sehingga sungai meluap.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "3463905f8c8639e90111494374ecf1357b302d5c030d86b30af48b28277ad904",
      "text": "Pertama, berlindung di bawah meja. Setelah guncangan berhenti, keluar ke lapangan.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "36ab125e8fd7ad70ec6f860b8499963b1060c7f9ac105994f4e17d049c060200",
      "text": "jika",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "36e5a2e5f9338ed2fe4fd3b021ffd5627eadf1058b3d5dc138ff2d2282f9b067",
      "text": "Selanjutnya, bawa tas siaga bencana.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ee7ebe55bbe4c56d29dedc3613bee0dacdbca43d4bdf40ea8823994f44475da",
      "text": "Pastikan semua orang waspada.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "40c40e5b67737a1295b22efa6e0ec049f57409f58ea2c4182696984c6421533f",
      "text": "Lihat, Mas! Ada asap di puncak Rinjani!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4245084eb2d64ac5721e040cf137c40c11f5beb733f8cd45add4be01c82e3e7b",
      "text": "Akhirnya, tunggu di lapangan sampai gempa selesai.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "43315739ede05f67e0909a809c82d840376ee1c3fb3d2d2b1ed8234cd992e753",
      "text": "Jika ada gempa, kita harus segera ___ dari rumah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "45c736740eccd7c59599e6a92313f255fc2590d7e30b5cfbf92e5ce96a741baa",
      "text": "ledakan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4642ff9b45ae91295422c96912ac7e8f510b3441a8ab06c6b7f82e98c693ebc7",
      "text": "Kami duduk dalam kegelapan sampai pagi.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "46bf0c4999576681bb66540255c60ad625f0c1bdc25f42f1bb770a915d4f3c12",
      "text": "Pertama, berlindung di bawah meja.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "474228c304c7236d104694f6748bae7d3cc4eb60322c7586718f2f985829d925",
      "text": "terluka",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "48eb2e91f4f3da61f146bcb25950c7528211d9945e8c6b264866db45c6c99dc1",
      "text": "tas siaga",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4953fe94a3af26740280e13633983cd8b149ed78728ca7b48926c3b3f953b15f",
      "text": "maupun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a4367a29ff21475fc4c07615c376975a78cb334d87c83ceb1bcf7248ca6cfd",
      "text": "Listrik mati, jadi rumah gelap.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d6489699d47b2ba6dc688dcc9291588ca9a05225d85261c164d0ab9d715abdb",
      "text": "Hujan turun deras semalaman sehingga sungai meluap.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eeba3e3bf849eae6f50743d54e2a6b82b203a3b40f0f5d8bd9391f70bddec03",
      "text": "Kalau terjadi gempa, segera keluar dari rumah.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ba73ff3e185012e41fe2c1699908738ff68029fe9d34224aa18757a519e312",
      "text": "retak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "50d91a309113d4216b732d8ddcb8660dfc81cf2d859aaf704936088f787f4702",
      "text": "seandainya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "50df88ea10e0af2183b35ad4ddf77016896d55266e45f88377303c590f070ae3",
      "text": "banjir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "51a322f358c227853328d83f33aa3043b14e1137f244296a3607e62882c30e96",
      "text": "Saya punya senter. Kalau gelap, kita pakai itu aja.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "528c312f63e2ba19dd846268d3570f677c758d342758ae11f822a20eea4e7b2c",
      "text": "Sedikit. Nih, pakai jas hujan ini supaya kamu nggak basah.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "545aa519730380d3d5608c573603edf9b59e2dc54589191f55c026f947ae0282",
      "text": "Rumah ini dibangun agar tahan gempa.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5555b088c0827bb49dddf2ec6d8b07a5a5496c5905f7a291202ff69699689d91",
      "text": "hancur",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "57d85b611717c8bbab7aa3fa8f89fc30602b2da19cb6af7899ca0861cc1153c3",
      "text": "Rinjani masih gunung berapi, ya?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a72d5a599674ba5518c576efb34ad595b1fde17721cba6e7b2020b1b424f3e0",
      "text": "Hujan sangat deras ___ jalan banjir.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e87b54fa88779b6625522bb2e14a21e2ed20f805b9f30fad6824ba1a77d7fa5",
      "text": "panik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f191d14ea05b3b50936a8a5d7127815e0e6cd8eaac2d134aedb5c965bc069d3",
      "text": "Bu Endah, ada pengumuman dari masjid. Katanya apa?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "63f33de57a97b1018bd2c2a70368fd9dc0bbcb0e7d204bb4203bbeb47ff19b09",
      "text": "bencana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "65fafb619ea60f8713e92dcce1a0b3dd2dc8bde8f8ecef4f6527c6bca94e0f48",
      "text": "Rumah di sini juga dibangun agar tahan gempa, lho.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6756705d3e7b7ad385861c1f510f2af21ddb71f66daef53281dc5dcb9ec0a741",
      "text": "Kalau ada guncangan, jangan panik.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aeb4d10969c8146c28b48246146200f55665b68a2c108044c2f5c84b828ccab",
      "text": "Baik warga Lombok maupun orang dari luar Lombok ikut menolong.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b3979ee4e7e8dd00429ceb56ba44b2c525dc178799ac028557680f47cbad236",
      "text": "Sungai meluap sehingga jalan banjir.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6be9c56a8c4303d63af8d8c4894d2d6f11b433b4085c3158d166beb449e31889",
      "text": "langkah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c3ff810642fcad5000c74312aabf3871e717e866ce9a65ecffad72f27d49436",
      "text": "Kami bertahan di masjid sampai pagi.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dc89b41c7f9a20baa3a78caa84da7ea44fac3fa58712f75c3db529413b912e0",
      "text": "Banyak ___ hancur karena badai itu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "704826810a46a3aec74f47c80eb32a5997e779fab2da322aa60afecd129427c7",
      "text": "Rumah kita dekat sungai, kan? Kita harus ke mana?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "751c185e6a199cd0f324834ba4237e197b8886a2d485b8d453e3f11f1ae6db47",
      "text": "Tentang gempa. Pertama, berlindung di bawah meja. Kemudian, jauhi jendela.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "768f784a94d3fe696b137724a84e34cd9bbeae97e75cee21c4c5cf1930b945a9",
      "text": "Kalau guncangannya udah berhenti, keluar ke lapangan. Kalau rumahnya retak, jangan masuk lagi.",
      "voice": "id_ardi",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "78512ca8c7aa3567284b953146526da7a00b50fb61fb52a6c83cc5750f7eb68e",
      "text": "Iya. Gempa itu nggak hanya merusak rumah, tapi juga jembatan sama masjid.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "789677d66e2488679c8e22d7bd1ff6443ac74d88a96f71b0f601af04368b0ae0",
      "text": "Iya. Gunung kecil di tengah danau itu kadang-kadang meletus.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "78e0777732a487e8eb120625c6031f5c6d8861cfe1b5be79d6957c260a2a3942",
      "text": "Tenang. Kalau ada guncangan, jangan panik.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "79f4620890cbc7ef3f3ad7d16f9cbd882f7b527ef51a2f406b7fab4cc6ef2404",
      "text": "Pak, apa langkah pertama?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e0d5a504419e25d7a64f89c875930e44cd6ac35e7b4d40d27c6749e3553ceb0",
      "text": "Desanya banjir nggak?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e6f9922432270942116cba1163edef3cd4d56469310c48563cd814a2255cc86",
      "text": "Bawa tas siaga bencana supaya kamu siap.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "83ea1d4c960d6a4912ff2616f6304f61bd4e48a76ca76ad2534b317a33ffc6f4",
      "text": "Badai menghancurkan banyak rumah. Petugas ___ jembatan itu masih kuat.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "86125a2c76b3016221dbdfa4aee7439eab63dadea8cc0e32a01f9de1dcc27ba9",
      "text": "Kami menghindari jalan dekat sungai karena banjir.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "8658601f90d35feef06b5215715b3dd8566670210cbbcf5a198fd00e729d3757",
      "text": "___ terjadi gempa, segera keluar dari rumah.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "8659d3c2852d109f2ddb264c4b948c5de1e8be354e28f0c40543d358e63fe41c",
      "text": "Danau di atas Gunung Rinjani. Bukan hanya indah, tapi juga berharga banget buat orang Sasak.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "86eed2c632d481b70ad4392598e200e006bb3fb464a9ec65f30aca9bf580f058",
      "text": "Mas, poster ini tentang apa?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "883cc62d08fa7433e3205d7439571322c84f772b7a7f355de4f67bdb9b5b20ce",
      "text": "Jika gunung berapi meletus, warga harus mengungsi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b3077c313b81d5cfff240e78d83e0c56bf6d12ae0919631819cd2259870d372",
      "text": "warga",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8be54689ff8c4ef99b03341e811e1401b266425be7957b5bab6a38427a04ccf8",
      "text": "Saya hanya minum air putih.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c60056bd9132a1cab192f10fabb4746c64d0ecb75267e41b28c10d7c4c7c0a0",
      "text": "guncangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c61b8aa9a6958df1cf63204ff3a7e45e6bedb60057e5c7d606d193a981b628c",
      "text": "Bu Endah, kalau terjadi gempa malam ini, saya harus gimana?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ecadf0ac0910b583366b6edb2203c2bfe1f7ea1c14d52d84361151d8ca364b1",
      "text": "Seandainya saya tinggal di Tetebatu, saya akan melihat Rinjani setiap pagi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ee76e20b1658e8f3cd640691707aca0caf629270c5ac7b0b548a84e78a2be9b",
      "text": "Akibat gempa, banyak jembatan rusak.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f3111109597ef2cb8dd1e7ad24d2d74e77a0d3402a92593af39e528b9c8b11b",
      "text": "Bapak-bapak, ibu-ibu, ada peringatan gempa susulan. Selalu waspada!",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "906407d33fe678446e3e7c19efe92b7413ca5e3c429fbfdf0134784dd80e15fb",
      "text": "Pertama, berlindung di bawah meja. Kemudian, jauhi jendela.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "909520e99952a16859534a88055a4857860ce474674c0c4f0e0755388e3d3928",
      "text": "Di dalam ___ ada air, senter, dan obat.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "90d807f5ad49878498b27092e152a086b1a9039ff19551f15ee12e1d3a0e2298",
      "text": "Rumah sekarang dibangun lebih kuat agar tahan gempa.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "938c60a00ffe75a481de08845c6a2a93d027e7687a402d8b3503cb2c44db2761",
      "text": "meluap",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b8aacdfa10d11cfe041297528c53966ba360a2352ed124f49c9b5005cf136c",
      "text": "Hujannya deras banget, tuh!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "94dd1c2bfbabec2eaa62c1a05a4ade719d8f9ca7ebeec3079684b753fd31cdeb",
      "text": "Kalau Gunung Rinjani meletus, gimana?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c4a89be0542594408b003a43193e42081088757d26427be2561b78e9e9daca",
      "text": "Hujan turun deras sejak tadi pagi ___ sungai meluap.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b1fb50b8dbef0bb18fdef43536335b0998ebb8533f1d12f16b645669bdeadfd",
      "text": "Tenang aja. Langsung keluar, terus pergi ke depan masjid.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a47765febbb1188a8e4fd502cd178d15480abdb3c0fbc18c4943dd8c9ec33a59",
      "text": "waspada",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f010301ad7b7e1141389b2d1cae7dabd3031fdfc9697eee44a720dc2a8fb6a",
      "text": "merusak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9a5373353caf73e3920f0313e1d8d62f6129136d6a6b62ee344c52fa592266e",
      "text": "bangunan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab279db8fbb028ccbc69b73eae41f8db7d546e3020125881246bf139b7b90a9e",
      "text": "ancaman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab54c510c28d329301a5cd009939f958e24548e6408114d83b3bea26aea466df",
      "text": "Warga yang tinggal dekat sungai harus segera mengungsi ke masjid.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac24b38ee1e1f8e9b0a459651bfb75dd10c0fe2e300487ed0a4562bae4694e71",
      "text": "terjadi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7d92dd2472a569961456c9800089d3af1cfaffe8178da5240aa1622cab110c",
      "text": "Ha-ha. Kami udah biasa.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0859201eee2b0149376fb46ed43e4802764f1e86199d65d59cdfc4eebb464f5",
      "text": "meletus",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b15d9641acd49a75d977a392727dcc08aed8811413c026d1d48f303c75393474",
      "text": "Apakah ada yang terluka?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2c0973070e137bf63de82fbdebbf308d172cd3ffa7aab9acbea8eb27b49af15",
      "text": "menghindari",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b314c9631374854bbab9b7f9ed92399e1fe6ba45d16f55fcbf3a6017df3af5c9",
      "text": "Bukan hanya warga Tetebatu, tetapi juga turis ikut membantu.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b77ba7967d72935d96928401d6a4244a1802c1b3d0643848cc1f4b111f11b849",
      "text": "menjauhi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "badd4aca199aed6e62747563743ee45294028505da872670977d7e144a639b1c",
      "text": "Kalau terjadi gempa, jangan panik supaya kamu bisa berpikir.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "baef0902dae8784ab85b3110fdd4277e09aeac42e88bc85f41c3d29823587187",
      "text": "Seandainya saya tinggal di sini, saya bakal sering khawatir!",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd33db944afc491a5aeaa946cbf989314dc2df980c71be1fed20ebb367603a0",
      "text": "Rumah itu ___ karena gempa, jadi jangan masuk.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd5248402fdade83e0a2289a47244682ef8ee36cc10a44db70a08b2bab15fba",
      "text": "Itu bukan awan, ___ asap dari gunung berapi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c06524f6a5bd40edd33721a9add7ce2e7e17945a6287b3cc09b76c87121d7952",
      "text": "Keluar dari rumah dan pastikan gas sudah mati.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1bedd2106d907518fb062a6d9a97f11c699a8a155b9ab3c01758f5b571d9c92",
      "text": "Malam ini ada badai. Jangan keluar rumah!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2f418c42d926000571eea706b147eb8b5c4289bbd7ec0aa3bedcfdef999892a",
      "text": "agar",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8f5b7d9b5c534a3d435f2cd8b08f1bce1f2bb362fa2c99f5161281e0ad6c59e",
      "text": "basah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c903ea94b40ff488330ace9d5f360317575e33985456ae2240bb8b4bfbc32e88",
      "text": "jembatan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9316d5b4bc7493de8b8c5fd92cc1ec4e184011455e251d303b33020c1a62459",
      "text": "Mohamed, ini pertama kali aku ke Lombok. Aku agak khawatir soal gempa.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbf8a2a31d0a553bbebb18a2eb7c7b4c6986dc0d286fa6c9389ba19e856a5cb2",
      "text": "Jika gunung berapi meletus, semua warga harus mengungsi. Tapi jangan khawatir.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd144bc27e2da58ca7e90d1245f45783c495a41c955411e57c9ef71d40ee774b",
      "text": "berlindung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cec5e27394a1547b989e767513395f9639b13051c941d5bd3a99bb764bd5afc2",
      "text": "Gempa itu tidak hanya merusak rumah, tetapi juga jalan dan jembatan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf4adf578ad2bf9568c61ae063fcb3de8ffe67e9ff7502fb13dff0732c39a44c",
      "text": "Itu bukan asap, ___ awan.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d033faf2a4624253a5c43a9287ccf525779c220c07690eddda5eb49b60a99ff8",
      "text": "Habis itu?",
      "voice": "id_ardi",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d074ba51dbfda949aa70c409f33f0eaa63784351d7703d31bcce081caed7d948",
      "text": "Ada dua orang. Kerusakan akibat gempa ini cukup besar.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2680d818b8fb0a9efd67a6e3f7e6b7394d24850ee287472cb16cd5c46f5d20c",
      "text": "Beberapa orang terjebak di dalam mobil.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d39d5ebca6efce8f88c99c167da538d462b2af3d56b05c33a79577b2e3a15ee9",
      "text": "Seandainya saya tinggal di Tetebatu, saya akan bangun pagi setiap hari.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "d56f67977a7d7a00e428813b24cf5fc1972dfac9341b65f3b9944c3be73c97dc",
      "text": "Baik anak-anak maupun orang tua harus tahu jalur evakuasi.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5bbcb744277cc59e7c92b72a5aefdba6c09fbd0bae95636ef83e7a216afe855",
      "text": "terjebak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8a25b1bb138e45695ac4baecd8261bcbeb2c1c6674ce28eff89b67e0e0e0aba",
      "text": "keluar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d976aa297daa8f082bf84e3f7bb094a9a83f13faa4a19f04a0447453a7c3bb37",
      "text": "Mas, Segara Anak itu apa?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc5a6e9b60410f57fed6700082964754a8802513bb458396372a9919eab7c47d",
      "text": "Nih, senternya.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2b4f2428ccd20f4c74d905fd98294210061bdcd11eaf8f79d5209850c9ef47b",
      "text": "gunung berapi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "e48a3389c2db7ae397998f3ce39cf5e29b786db48ad230e7f1801df92ef38e3a",
      "text": "Oh, syukurlah. Gempa tahun 2018 juga merusak desa ini nggak?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e597182ce9c0925be023e7d1e32f4b173422e46dfd669a8c903bb1bf5e1a7a",
      "text": "Itu bukan asap, melainkan awan.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e628bf230ca72df7dc34626486c6918484a0f9dbafd0b70e924ec54325efacfa",
      "text": "Baik jembatan maupun jalan rusak karena banjir.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e730891b34010771c17f94c1fe22c287fcbea19601f1dc19bc3b46270da0fc12",
      "text": "Baik turis ___ warga ikut bekerja.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "eafdaa4d58c896df238d4fb63ced41e2206955c0f2d4d7693a9d1892516eddf2",
      "text": "Pertama, berlindung di bawah meja supaya kepalamu terlindung.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed1a0910bf417147d7093aae0a68f1d6eafe5eb8427200b9644a8b98573d0ecc",
