    },
    {
      "id": "bipa5.u03.l05",
      "sha256": "64be15c9d7b9db7ccb200fa24e78ea48e21ffeb139e0d3755b8f81c76b1dab06"
    },
    {
      "id": "bipa5.u03.l06",
