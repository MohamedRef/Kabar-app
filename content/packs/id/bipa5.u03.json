    },
    {
      "id": "bipa5.u03.l07",
      "sha256": "9cb47f084a2176dc9712121fab46ee6aa79aac81236cbe46030afdaa0178ddbc"
    },
    {
      "id": "bipa5.u03.l08",
      "sha256": "103e37457d9796071b771bc9935b13a28215d67218a7f1e4adcdbbe4007ba192"
    },
    {
      "id": "bipa5.u03.l09",
      "sha256": "431848dda576fac753ed67b39be81202698d3e7597b833bc1d0e42bbb808fcb6"
    },
    {
      "id": "bipa5.u03.l10",
      "sha256": "2554cbe79ceaef2a7ecb334524b8ba7f1d1dd92651fd2aa0d9e4ec3088081193"
    },
    {
      "id": "bipa5.u03.l11",
      "sha256": "98b02e1f2f57b039c8f83594480a60b0f441138719ddae11fde7e267e5292f40"
    },
    {
      "id": "bipa5.u03.l12",
      "sha256": "8e9405dd05df5dc36bd1747bc83785ae030bbe81f63b3be6ae5b144cb7ee9e4b"
    },
    {
      "id": "bipa5.u03.l13",
      "sha256": "4e5dbf4f99973f83e8ba16fde8498222a3c9da88fc041aca3ab07f5637a27d9d"
    }
  ],
  "audio": [
    {
      "key": "007a302c144dd87ff68d11ba6faed4d4fa6f3fe52ad4014a28c3df6ab6f523d4",
      "text": "terobosan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "00a5c5275a687f5b626baaedc88a442720fe0fd746782842a827ea504d8aa701",
      "text": "Hari ini kita membahas penggunaan AI di kantor. Siapa yang mau mulai?",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "04710bcdc226ab1c2268067e1bf3778a8f2f3854b0013ff1c704dee800ab9618",
      "text": "Terima kasih, pemirsa, dan terima kasih untuk sponsor kami.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "0476713c2d79bc4217dbf466a141690c1ed3738061a39a3d7d2504d6b910cd0f",
      "text": "Hati-hati, banyak penipuan di siaran langsung.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "04d564b2dfdde9ce12b9eea2a9a898b1f3957496532270698b2d957a4128a81b",
      "text": "Terima kasih atas perhatian Bapak dan Ibu sekalian.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "08216ce2dbdbd0bf6fa43edf2372b16a2b9f101a56e0079124960ab855db743a",
      "text": "Kemudahan belanja daring menguntungkan penjual kecil.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "082b19759e2d67fde9692e9ebc39bcc1a18397adbd538c55235ba9f6b9ee7dbf",
      "text": "Secara singkat, perubahan teknologi membawa kemudahan dan risiko.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "0884f11cb4da2a20249b337f1ff993724f7feb1b9d33bc475ccab6baa48b22c2",
      "text": "Lalu komputer membuat simulasi dan prediksi longsor?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "08b80fb456749b80f6341bf0aab6e425b49494bfec033466ac7e4b439b28879b",
      "text": "Gagasan utama artikel ini adalah keamanan data pribadi.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "095b63240d1c2dfbd006ae65146d3edd37085b36fb77f471062270b628a2848b",
      "text": "pesat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "09d6170b4572dbd90e3900d794d943d301c6ada75d1f723031f13d86706b3f91",
      "text": "Hacker itu mencuri password dua puluh karyawan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bde88b0db63f4650ebae116a695670632e76c2e99dcf9873b89812797b7f113",
      "text": "Menurut saya, kecerdasan buatan lebih banyak menguntungkan daripada merugikan.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d4f4e9767c4562bcea0d0f17e26cd210f47db23c3fdd0b73fc563c65f810182",
      "text": "Simulasi komputer membuat prediksi longsor lebih akurat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e8dfb13791f5d25540532d379737d83dda70ec59205e7a1435302d5db98548b",
      "text": "Betul. Mekanismenya sederhana, tapi rekayasanya rumit.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ecf02170c09477295fee0eb74100f0d83b86e98ffcd80c9f6e49f2bb7339e74",
      "text": "Ini terobosan besar dalam rekayasa tambang.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "10851cddf9b9535983af9d1147854055b5b0c232762efb1ec7c2b0bcedbeb1be",
      "text": "Jangan! Itu pasti penipuan. Penjual asli tidak pernah minta kode itu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "11bb7f5611f542bda3f79cfa896040df04137231a96148fe2a1c73d30d0ac5bc",
      "text": "Kecerdasan buatan bisa menerjemahkan teks dalam beberapa detik.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "11d52c0f32bfc5b7ff0c61993f3999ceaf4e629ed94a2d75a9489e9e4330c9a7",
      "text": "Pertumbuhan belanja daring sangat pesat.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "12749e719fba8e6b48d1aa3dae3e4fe081d58106413d168b4bd51332e5773728",
      "text": "Bagaimana kalau kita kerja sama dengan idola lokal? Kontraknya eksklusif.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "128fb0dc47f553fe52f883a2a6f6c7e9001449946e4633438e0e18aad3d3080d",
      "text": "Betul. Kebocoran data bisa merugikan perusahaan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "12ef699c6b6c2a5dc2cd8f1ddbf3eb679489eb4abe15030617b478769f0a186e",
      "text": "Selebriti itu siaran langsung dari perahu di Sungai Mahakam.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "13950e8d28d360d9adb280ec316f49a34ab1af65661befcc147d84017dfb8ec2",
      "text": "lensa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "143187f8de3eeebb6bab8839a2077cfdd52652fb51eb6aa87501f3c73af41d6e",
      "text": "kebocoran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "16aeeb06c9d1e549d657fbbf4e2dca8c6b3a845aa2e3655d9f4d620e443f9887",
      "text": "Wah, perubahan yang besar. Kemudahannya luar biasa.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "17dead162dc8c3d12a7b5dca23a436723e6246bd424a4123da8c959e98572bbe",
      "text": "update",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "19213f8b0c22947855d1575d34fc69fbc12114448f678671ea12105071600ef5",
      "text": "keterampilan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "19ca8841f4ed6ad6232c1eca951e87ffa49e9b5d64e38bba25bc8e311986b75e",
      "text": "siaran langsung",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bd52eb1f1b498218f2c139e66ce39911a3dbf9728b26e182be54978346bbc54",
      "text": "Ekonomi digital Indonesia tumbuh dengan pesat.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c1493058d8e954855033d7f3e9c3de4546c571aeebc54bae142b5b591704134",
      "text": "Akibatnya, kita harus lebih hati-hati dengan data pribadi.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c20e2e06def3b060dd5705c1312fe886754b7018e394f933b5f0306ac775d5b",
      "text": "otomatisasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d2f3e065d684d8a4d0505d0948c94c6cce45dc28c768329cfb143b12e6dd131",
      "text": "Kebocoran data itu sudah dilaporkan ke polisi.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ee351aabe53a83faca8fcbcff76d0769a2a4e38df0e9d3f67c8c2599783a962",
      "text": "Memeriksa hasil mesin dan memahami budaya. Itu tidak bisa diotomatisasi.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f662da0887db604a331b9579ba63c6e24796c2ec13d89b67978428f8c52510c",
      "text": "secara singkat",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "222b652789cb70963856151275de49601df66bd93bd809fe675ad31b239a27ad",
      "text": "Ongkos kirim gratis untuk pembelian di atas seratus ribu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "254eb83c1da6b84d1dd8a4558f316f07b37a859c48ce40946461197343e54ac7",
      "text": "prediksi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2760dc1bedaff9dee63f5d76f587107d1ea819be0c80bf2618718adb4c286932",
      "text": "Perubahan teknologi sangat cepat di Indonesia.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "27b1c9bc1f12d21a807d59148734706a953d7e822575a120232d6ee2d741d568",
      "text": "Secara singkat, gagasan utamanya adalah perubahan cara belanja.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "28fa5e6ba3513e768d3cec624285888a7aab6d68ee9ddbdd804d77f65e4c8d63",
      "text": "Semua data dari antena terlihat di monitor ini.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2928a593e207397a7fd56cc4a3bc30afc029e1b4f7b4e0876111c7799757657c",
      "text": "Betul! Jadi penggunaan itu seperti istikhdam dalam bahasa Arab.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "2977520b1f77fd91485d4793c105aa7617f0802b5bb4d599b75652780e695ace",
      "text": "Betul, tetapi penggunaan aplikasi juga punya risiko.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "297e32637eeb07953950ec40f64bab2d49a6053919db1d5d96c1a978388aec3e",
      "text": "Tapi anginnya kencang. Audionya pasti jelek.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d77e190bc1b26974ab173173cb6a0d6ab07e1a1212a29b8a8586250ff5cfe84",
      "text": "bayar di tempat",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fe074e6b9ecb7f76631cc92825deba06d0d54fcfc54a10e9455c7105a8f3dd3",
      "text": "Pertumbuhan ekonomi digital membuka lapangan kerja baru.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "31411a42e6b0aea7b27462dec3f2c3f948b9ac031755e949336efe37e59a6cbe",
      "text": "Otomatisasi di pelabuhan mengurangi jumlah tenaga kerja.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "31605ae9498b02858464095b8886bdce6e8a7877d02aaaabe76ae1b4afb84e0c",
      "text": "Saya juga mau posting foto sungai ini!",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "31c40eed90c58f06ef8503808ad44632a3109c4ec2e15f76e7e7734d973a5fa7",
      "text": "Secara singkat, artikel ini membahas peningkatan penggunaan aplikasi.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "31f2c7b791e8b91f84e406b5e226e749c8e3725ca3dee86add4bba56c464e6af",
      "text": "Video pendek sedang tren. Kita pakai platform yang disukai anak muda.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "322e76b32827845ec2481ff1fe99c762f3f8b48cae0fe633fffc156219602dbe",
      "text": "eksklusif",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "33a94e930d5f326c9c4a7e3ab32ecc14c6ec7e633490744f9c44ab2e67e7f111",
      "text": "upload",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "33b932de31ab66db58aa011297a2d7790e25f2dedfd501ac10c3d5014bcafb27",
      "text": "idola",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "33fb21767fdd58747a94e2e5a29e850fbb55368ee82aabc0e9428cc98290a710",
      "text": "Saya setuju sebagian. Namun, ada risiko kebocoran data klien.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "373cbf392eff035f98ac365977127a85b1d07b5b63940c4d587b17417cae484d",
      "text": "Setuju. Mesin membantu, tetapi manusia tetap bertanggung jawab.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "37de9b182958ac9c104e5d47c9b30b7d9989a09a1de0ba8acc3b2b4f94580b00",
      "text": "jaminan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "37f2e0f043148de6174721d28da25223bffa802d51a13277c010e00f66d99e84",
      "text": "Ongkos kirimnya berapa? Dan bisa bayar di tempat?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a8c8a38e0cc14cfd0c3b261d13cb2a3ebdf95d948182efe135b0237ff061a86",
      "text": "Mohamed, ada pesan aneh yang minta kode OTP saya.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d4d67e402e963a7bfa9a67d93f488dfa10ab0c2aa40b22dde50171f24bb4a57",
      "text": "kemudahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ddacd0cc16bdae3b2b32a7b54da20bebc662503f355899f50b136902b6ecbdb",
      "text": "keamanan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e4d35f62a43b344b84a46821b72f18941bddfffe2e2499a37d108abe2e108aa",
      "text": "ongkos kirim",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e929537cf678a2a93a770de1c5b2ea790b043818dd9a0c0cc8bd68c40b52fa7",
      "text": "Pertumbuhan ekonomi digital sangat pesat, tetapi pekerjanya perlu jaminan.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fc54034a5ae562b7b39621b837aee45c7a77eb81168472b1614216e0691b9db",
      "text": "drone",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "425cc1da749b42d7d80e620b8752bc43b8e42eda5e8acbdd56a0e8fd1c55f4fd",
      "text": "monitor",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "47c9ec8b7f47beeee6bbbbade758cae665cbb1380ef321f3292d1329f953af99",
      "text": "Ganti password Anda sekarang juga.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "48255a074550b0e2c364a560026f0eb681f69abc5acfb3d8dcb5754e7b245ea5",
      "text": "Tren ini datang dari platform video pendek.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4921aad5cf0641ad682045cebaef5d39cee1da588af85c8193f239250100fcc6",
      "text": "sponsor",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a05d28a018d4dee16526a5f7bfdac42a566202c6d67c4bd857fc0eb0e31140c",
      "text": "Ya, data bisa bocor. Untuk mencegahnya, saya pakai kata sandi yang kuat.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b3afe2093fb63eea8b6e2885baba62f8b9c9824940f8e294190481dfa2ea1eb",
      "text": "rekayasa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c2bcdbd21ea5b1dde2e2d015c1eb4f6c16481613f41634cd5a8e8937f3c97f3",
      "text": "Saya lebih suka bayar di tempat supaya aman.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d3d2eadefcbbc399b7c24c499aa81b344c96dcc56051018150ac3fc6636fdba",
      "text": "Penghasilannya lumayan, tetapi tidak ada jaminan kalau saya sakit.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "512023c4e85f5bca2619de87fd7fd15710bdadb031a89ad73c7562a21f36cc7c",
      "text": "Saya selalu belanja daring karena lebih mudah.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "51442c9d4ac57d8ab31bd196d9a1fe204355aa1bfed2878616f5d7721553a6ed",
      "text": "Videonya diambil dengan drone, tapi audionya kurang jelas.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "53b93376f0809e94c7abf34b34a5e216e795c52aace0b19b2c4d523032186a8c",
      "text": "simulasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "55c42f3441e2b3338629e6cae877eef4e56437d3b5b6e34046b5241ed5a31ab5",
      "text": "Mahal, tapi nilai komersialnya tinggi. Kita juga bisa buat pameran virtual.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "570e33b8033a22c6ab9ee5e7902d20e40eb827e9056743756a2c1254f0c6929e",
      "text": "Selamat pagi. Pada kesempatan ini, saya akan membahas perkembangan dompet digital.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "58dec437782f8347cf514d0b032a435401b157827dd83192f53d7e950d93124f",
      "text": "Menurut prediksi, hujan akan turun malam ini.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5909ad1410a80e6214786c836d77b002f94f58cf07dd01adba77d783eca340de",
      "text": "posting",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a1eddabf942e549a2a15a1c57d3898798476faaacbba44da3486acc2d487839",
      "text": "Keamanan dan kemudahan sama-sama penting bagi pengguna.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ebea3ad79d97d6633b0854311e60581f6af17f3bf7cedcac9fa493b0d3b3ef9",
      "text": "asumsi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "610ac64d3c480d803152b49e76a95ac28e84b0f05725045588614c1f32321ec9",
      "text": "antena",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "63bf32bb4322515e11e3a1895a6bfbbfd09a9bd5665110e2d455ce1ff7e4d075",
      "text": "Asumsi yang logis. Kita lapor ke admin sekarang.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "64eb1b63a939dde78b9676c8b0d53417badee9607768683d1aefaf8001f38181",
      "text": "Otomatisasi membuat pekerjaan lebih cepat, tetapi tenaga kerja harus belajar lagi.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "65e8319d80933ce8d841a8b63e52e41f4afaf6c3e253746cafe6194347747fff",
      "text": "Penggunaan ponsel di Indonesia naik setiap tahun.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "67ec28dd544d7ffea41875d90df358364c03746fcce341676f6d69d6e416d91f",
      "text": "gagasan utama",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "67ec653b0d9b38e7b2c7c1bd378e3141af0e2697a5eaefb13cdbff299a6066ee",
      "text": "Ringkasanmu berapa kalimat, Mohamed?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "683e41fbf49dc49a53d6c2299c3f1e63bfd8e622bb2b23826eb8bbbaddf414d2",
      "text": "Lihat, Mohamed, kapal-kapal di Mahakam sekarang dipesan lewat aplikasi.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "68858cc8ce36fe89223f6ba115c1e52f65852012ce5db06e1ae57e151044ae37",
      "text": "audio",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "688d58d858ee3ae1c3871fce7d0fa6ee1809bd785ed59d103bc5512771855090",
      "text": "menggantikan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac5b73602d5a2e76b5a88372fd8f9654c38fc0ff634305b095dc0c7d49ed208",
      "text": "Pak Mohamed, besok ada tamu dari Mesir. Tolong terjemahkan presentasi ini.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f3c037963715ba686be35ed6d95293bb7395c0dee241171363f8d2ce5278e12",
      "text": "pertumbuhan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "708367006555c7a0f5e305bcefb39353a3e10159865ff58edb749b56a42e7882",
      "text": "Penggunaan kecerdasan buatan merugikan pekerja yang tidak mau belajar.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "735837db83bed8f568d32cacae152fa317156f53e8eb73593e897e987a14c4be",
      "text": "Asal jangan seperti kopi instan. Ini kopi asli, harus difoto dengan lensa yang bagus!",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "758f97c5454f001351a5ba13944870c7c8ac1c515f27f721fd5a6745679a0f98",
      "text": "Mas Rizal, kenapa koran selalu menulis pembangunan, bukan membangun?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "76f9f66d04a3756353055fdc305d63849e21cf9516da37dde73348414115b0ab",
      "text": "Sebagai penutup, terima kasih atas perhatian Anda.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7755f5319ddf58ecb7b7ba806ee2bc2c62044e9deb3810a2d488ab8fa839263f",
      "text": "Ya. Pemirsanya ratusan ribu. Sponsornya perusahaan kopi dari Samarinda.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "7855280b7ff85695ea9d4e928cd0001a7899b8f75fac26c0e128466c86b2691c",
      "text": "Sensor ini adalah terobosan dalam rekayasa tambang.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "788cbc50f2fc6a8262c9719176a5d4968cebe7ef9ca8870103427598d3f3f820",
      "text": "Jangan dikirim! Risikonya, akunmu bisa diambil orang.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "790d5fd68c3b75e622d07a2b5141d3a9c4421de27b1c114c5c538aaaabcf9665",
      "text": "pemirsa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7922c6b00d71f0abb50aa5f767e74fab583e7efaa077246f1792f5d2660c6a68",
      "text": "membahas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "79399c8b6cdcaa599a896a849642b6c67591e7b61505a21650d8b30593627202",
      "text": "Mas, saya bayar pakai dompet digital, ya.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cf85fd8de37b12091c53989abdcc8bcc48d63b0db494d4c587ff732aa39bbae",
      "text": "Sebagai penutup, teknologi ini mudah, tetapi keamanannya harus dijaga. Terima kasih atas perhatian Anda.",
      "voice": "id_ardi",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e8b7bfb70b82d23ab92e3824bd02d9948dd052104c508a926d37ce454d94f67",
      "text": "admin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8077534c60c4a1eaf1a172c1c272fa50dc6d54a75d2cda94040b3d1f23fe8f37",
      "text": "Bapak suka bekerja di aplikasi?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "810dfa7eff15945f7413d1df2291cbf14d03e2c4da4d8583bb9c959c8d08612d",
      "text": "Mungkin akunmu dibobol hacker. Passwordmu apa? Jangan bilang tanggal lahir.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "811b49af5010e520437486a8cb883df9f789fce479899bb683b510cddc5a5df5",
      "text": "mencegah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "86271dd1d6974b0eb9d86747803642f5b95580cce7183f823256369b3a1e1fe4",
      "text": "sebagai penutup",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "86e586df8c7aeda2d2ddd0d45c5d78dc644640b7986195dd17d3da37e249308b",
      "text": "peningkatan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "89a8018be3c816a24f884d760f3fe0d73e4ffe3884552317e0f1011e37b29b4e",
      "text": "Mohamed, lihat! Siaran langsung ini menjual batik Samarinda murah sekali.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b25f0f3de52fde4c8ab3befd3f8f4f73f3f0727259d796875fc4344614f230e",
      "text": "Mohamed, email kantor saya mengirim pesan aneh ke semua klien!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9158725b085504759e81adb2fd9a1f262f3a2fcbf971a81cb339b06b51f6b170",
      "text": "Kata sandi yang lemah membuat data mudah bocor.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "926448b96ec092c73aec98b3ea25757aa0a381df2da9f12ccd6f486d13dd36ad",
      "text": "Mas, kalau kecerdasan buatan bisa menerjemahkan, apakah saya akan kehilangan pekerjaan?",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b450fec38370bfda212695596f0e76529007301202566c07f833b553a51464",
      "text": "Bagus. Pembukaannya jelas. Lanjutkan.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9888b50f297bf5a4298db89f5e2d437ae904e3733415340d666ce34316d89b74",
      "text": "Video pendek sedang menjadi tren di semua platform.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aab54442fd5860e9819552dc032f599f5b8443e0153d7624c162e3f889da8bc",
      "text": "Popularitasnya naik setelah dia posting video itu.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "9af1750dc87b436e46aa7561dadf7cf553b2f9bfd1996369b9ace80b00393623",
      "text": "Hacker mencuri password admin, lalu terjadi kebocoran data.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e077e4232ffb4eedaf0f2fb913bbf39ed0000fbd7f9881909f974580ebc187b",
      "text": "Data pelanggan ___ karena sistemnya lemah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a09638708336fe097642a39b8753e4e560bf6fa25042f223c25d9d40dd3c1187",
      "text": "Akibatnya, data jutaan pengguna bocor ke internet.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a125d8fee200bda01537267af6b551bbfd37c0df04a52d433448876721c2cdd5",
      "text": "Ya... tanggal lahir. Tapi itu cuma asumsi, kan?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a22033f004baed5294fe5572064117fe57f654d11532f79d87800a6fa2f119be",
      "text": "logis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2c3c79161fc1d68a9839d435836814b0638fd6e7bed7660f2eae13e1f0de49c",
      "text": "menguntungkan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a479e5dd3a4a2f26db610ada68086ec07e57a05f59f419da80b354dc37be93b2",
      "text": "bocor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4dc958d833553bf618e947f22da86fc91933a365adb8882522e38cae4a6da3d",
      "text": "Suaranya putus-putus. ___-nya bermasalah.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5111ad952cc9a27948270c56b38f21b17e56f979144ce2ed8fe95b343395cee",
      "text": "virtual",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5d2032067d9bafcb6c45ee8ab92f82a62315df15d19a35cde0b1a5cd9edae7c",
      "text": "Pada kesempatan ini, saya akan membahas perkembangan ojek daring.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5d6a0631dd25bb9f539b44acdad7486e44f7790c7b8a5f322a9b55eff84eb92",
      "text": "Bagaimana ___ kerja mesin ini? Tolong jelaskan langkah demi langkah.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "a83ee74e62066d459fd74ca163247fcba998ce3ec16e242487a91938b965ea99",
      "text": "password",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a848d2829755a6c8edbc30ad953d35d55774c440ebcd39fd7d8e84d0fcd87203",
      "text": "Boleh. Sekarang hampir semua penumpang bayar secara daring.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a84f5784e0aeee51ca52f59dbc0ff9c99080cdaabe550400913cc9db7794ab08",
      "text": "Jadi keterampilan apa yang harus saya pelajari?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8daa0930f53326dfbba3a0819523c35f87408289195eda67156cbb881b45778",
      "text": "Admin meminta semua orang meng-update software.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f7322bcb0e42414bc53492a424119e8256322bb9425bc9c245f79a55c4d72c",
      "text": "software",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a965fc0ce765e316c27ef0fc29604192678a818e83a54a3f3e845cf7aaa6b843",
      "text": "Kami punya kontrak eksklusif dengan idola remaja itu.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab9281f178ec36aee83f9e5c40f21ab1b81a5823f0228be2584d67f4be77bf19",
      "text": "Kita mau mempromosikan kopi Kalimantan. Ada ide?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "adaf2148fd3a5ab4f44d51b2db4d965c5fb6eb0892dcce7b65f1db113c8a7314",
      "text": "Ada kebocoran data? Semua harus update software dan ganti password hari ini.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "af3aed6aaeb4e130db31b4ffcf931cbe75720f8247939983d736d532c0907376",
      "text": "instan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1107a9848d2da0590c9a396db017f387336db5e071c612f218e4f2213bea281",
      "text": "Wawancara eksklusif ini hanya ada di kanal kami.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2e6045727c814d75122153829c87567f991d615f81a0f5d4abc93bae191c978",
      "text": "pembangunan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b39e38723e127c2b5aeb18cdff87651d7c1607690c262d73426a3b00e4e5cc3d",
      "text": "Kalau begitu, kita perlu aturan dan keterampilan baru.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4356170cceaf13618b4c68fa77f6f92ae99bf05d3b6085773e40c7c9337c654",
      "text": "mekanisme",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b64225e5d62a858e22404425b16ea263d6454a3604490057891fa0506b0d1d01",
      "text": "hacker",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b85f5817022fc0d1635a2e7a2ff7ca66b248e45e778e9c7f51e2ee7897273ab4",
      "text": "Ongkirnya gratis kalau bayar di tempat?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba435aacf7c3eb088d218a55c8625b713fae8229126cd818dc4a5babd4308a0b",
      "text": "Karena bahasa resmi suka kata benda. Seperti masdar dalam bahasa Arab, kan?",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "be3c4a351839370aabb338df45a8d7435edefce57ce6b8caec7499f27f4048ca",
      "text": "tren",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "befeda6d6c7ba0fd0711102f2a142dffc9953fd16014286d916397cd4ab2de35",
      "text": "Saya membayar dengan dompet digital.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf8b3fba9bb36c32633f31eb9a88829b6d07dcc3658bc4d6840d87036a176b9c",
      "text": "Simulasi ini membantu prediksi yang rasional.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c17be44464a546bf70daafdc85898c24d336109080d022500997ab2a46aaa84e",
      "text": "Kebocoran data ini bukan asumsi, tetapi fakta.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1d95cbe69e0343596f551f71ee911e04beb53d2b0dd4fef2cec0ce846ea8b5b",
      "text": "merugikan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2dd744c340913ce5bef55d4fe436ce3970f72ae48164528d2d79783f8781d2b",
      "text": "Popularitasnya naik setelah posting itu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2ff069f36189b5a2b85450b9b3adaf20c7c6c4a5b509863cd2f48affb2d7c3c",
      "text": "penipuan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5daab0c970018da544a3ba3a2d5b88c60e950e15b17217531f4c79c0e9be5b5",
      "text": "Jangan dulu menuduh orang. Itu baru ___.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c602e66728cb6b1745acc630da565c137d4a7698e9a3945c6e1e0756da6355b6",
      "text": "Untuk mencegah risiko itu, ganti kata sandi Anda secara rutin.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ced005049739dbd886b33f894413893794b8e2256f02eb6d63e91ac1630855ec",
      "text": "Pertama-tama, penggunaan dompet digital naik pesat sejak 2020.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1662ea612145b4d1988236d72cfdef92446d2f6161eae79338c1d52efdcb049",
      "text": "___ data pribadi sangat penting di era digital.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2a62a4c4eb52736386abf454be055a3900f46c0b66f5171319ae5a51ee36378",
      "text": "Menurut admin, hacker itu tidak tahu password baru kita.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3a861d7f6ee85da07b8f60ca31481ce8b3d9d2f4a126ac532fc264dfda35e19",
      "text": "Ya. Dan keamanan data itu topik besar di sini sekarang.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d75f24105dfed11efb81417202c4a2841131f9a817613f1a8db2507eaeebe50d",
      "text": "kecerdasan buatan",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7e9f8b4ac3f921a8d8761e240573d86ae67db0bbabc30d4174b4511be508f45",
      "text": "selebriti",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8f5cc3fd41b3b84f32ce664f80da2e2bb7273a488c73aab31d76dacee91418e",
      "text": "Menurut saya, AI menguntungkan kita. Laporan selesai lebih cepat.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9afe90b67006029dcc18901ffe18a2b4e18adbf407ae74465a02258f1cca0be",
      "text": "kata sandi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "da7b3560f47725f2bae12853be60c6311fd96e5ebc44063db43c48c487a3ecb6",
      "text": "Pemirsa, kita sekarang di tengah Sungai Mahakam!",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "da944a0284b4937ee6afa96d345ee6456936bd7d2627f6dfaabf0b0ea6008621",
      "text": "Saya akan menjelaskannya dengan bahasa yang rasional dan jelas.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "dde2f5a6051a77d47a8b0cc08058f95cd3b597731e930ee93e15a2a7792efd86",
      "text": "Gagasan utama artikel itu ada di paragraf pertama.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e065c6ee13f00d1f61d3a22b75a19235deaae90cdd42ff42b48aae7fdcdbeac0",
      "text": "tenaga kerja",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e06b4ef0454fb70eb7e6f37fa9bd1bf255470d2484daba69f9770cfa17cae632",
      "text": "Penjual itu berjualan lewat siaran langsung setiap malam.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07bdca22aeec7ce4cf38e426e97d7f448ef2186261f1d3de86e720653099a28",
      "text": "Pada kesempatan ini, saya akan membahas keamanan data.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1da403f97102fd2d171b3e1c835a746026cd5980e109eec4c0e1f6c86d3487d",
      "text": "popularitas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1ef49b19d790ef50ef6b1205dea009a688e92417e87271c07f3d92e3d14ab41",
      "text": "dompet digital",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e483936e614b4687d4f7c904455a0652a79da33082d617e1688e21b40e9287f7",
      "text": "komersial",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e49100e26c20aa45005c70530995c77bbb02e86e014c1c47939ae91755255df4",
      "text": "Baik, Pak. Isinya tentang apa?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e7684b73c6f74596846563f3f3186da73599915d0cb68376120e7df1ad781b",
      "text": "Rapi sekali, Mohamed. Penutupnya juga sopan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7166f5cdbb7ba5be20df456fdc7b89f1744105748fc3b0978b9898214d39977",
      "text": "Dan drone di atasnya itu punya dia juga?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e792cde50ae0255c9c728f057f9b89faaf30b841b27ff5493468fbd250f7d98e",
      "text": "Oke. Secara singkat, artikelnya tentang peningkatan belanja daring.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e93cc42461d578e721af158d4cddcd309941b94f565b48295dbef812cb35f399",
      "text": "Wah, untung kamu bilang. Bagaimana cara mencegahnya?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb1a36259787953b3433e7e853ac51b0e87b8219f6233029c4f299bec79a909f",
      "text": "Lima. Tapi saya masih menulis semua angkanya.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebbadb9fbcfcc9b8263e4d2f228783abc4522f647cdcdc9eaf6765f527df3aa6",
      "text": "perkembangan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebed4a6d3f45d29b0fe4892f4f4e13f56c1f9c818ddd9ecb0b74de6190bdfb22",
      "text": "platform",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecb4c1b3468b723f5985052d3620bbaa893b66884489e8448c1d350ce6180965",
      "text": "Bisa. Tapi penjualnya minta kode OTP saya dulu.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecdb1ae9b5a6cb1a52241858bdfe52e074903746bec1e250663dc16a98d40c10",
      "text": "perubahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed13e586f23efc6f18308ed5ca56a43f3df0f8020615c18eb80badfaa4c9f98c",
      "text": "ojek daring",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "edde522c39bf750b51de109c41f0a4dabcb494bacbf016b55922a47dafdc0956",
      "text": "Terobosan kami: sensor dan antena yang mengirim data ke monitor di kantor.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee9f84dcb8bcccce3e2ad67c8dca0f947a5a65f0db9fa3ea34a3b9989adb3ba8",
      "text": "Lihat perahu itu, Mohamed. Ada selebriti yang sedang siaran langsung.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f140f05436ee86e3626d2057ee6dd3a8f74c34a0876059e6f878e564f615d446",
      "text": "Kemudahan belanja daring membuat toko kecil tertekan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a30708ee164df7f7037e84f8498772dd9f61912753b82e9183ba59276fd26d",
      "text": "Kecerdasan buatan membuat ___ sebelum mesin diuji di tambang.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3687c6529eabcee88096ef262cc6c103a2632f264c42519ec3b3188ecc34bcd",
      "text": "Otomatisasi mengubah kebutuhan tenaga kerja di pabrik.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4b9ba6630f0a541f77c41cf6db28ad459c4fb5eaf8e39e2b59bea45e7bdff44",
      "text": "Hapus saja. Tulis gagasan utamanya dan dua poin penting.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7313401f883499475e3490758daec5d80b01e44a31bb79f4198d7ea826c451c",
      "text": "Rapat virtual ini dimulai jam sembilan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f75badb8e79463914aab7fbc9ab031afef2cd8fd0eb9795cefb14c65692d0aa7",
      "text": "Secara singkat, kamu sudah ahli teknologi!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7fb39d5a247610c0fb243210db08a4d55f92c4685180279da2b294456c5ffbc",
      "text": "Mesin bisa menerjemahkan kata, tetapi tidak bisa menggantikan rasa bahasa.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8b44cbece3a057d75b2d436977cdbb148613317e19e8dc53ae4414c63c04f6f",
      "text": "Tidak apa-apa. Nanti malam dia upload versi yang lebih bagus. Itu rahasia popularitasnya.",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "f93b180890d1df660bec15775256b1d3f7322e4f4420cc289e5be18542fb2ef6",
      "text": "Pameran virtual itu gratis, tetapi tujuannya komersial.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc6525df18575a2b99b3db759005e50b99340b3f341c888e822c7845732a10d6",
      "text": "Ganti kata sandimu dan jangan pernah membagikan kode itu.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd805b70152555902f436ff520b8d570abe77454336237a2de4304f393e980bd",
      "text": "Penipuan daring merugikan banyak orang tua.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdacb7ac0c17ded870297d68329a8e54a401aa679df5d4114bd8a22aa53e5fd2",
      "text": "Penyanyi itu ___ jutaan remaja di Asia.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff356374cbdf330fa5b68d4d7ea9e9f3710bf06f865a94830671c2247b7dd84f",
      "text": "rasional",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    }
  ],
