{
  "format": 1,
  "id": "id/bipa3.u10",
  "language": "id",
  "unit": "bipa3.u10",
  "version": 11,
  "content_hash": "1abb6dc80c899647f7961dc528200566ba339120bbd0b57b8b8ebf5b812b3565",
  "lessons": [
    {
      "id": "bipa3.u10.l01",
      "sha256": "6410629e62e10aa3660672aa0516435cb80446fb5ab2163cadd54f743e6f0178"
    },
    {
      "id": "bipa3.u10.l02",
      "sha256": "3d47c02c1390d214881275ee6654efa005afa8048448e436e698183c83ce5e44"
    },
    {
      "id": "bipa3.u10.l03",
      "sha256": "45df1d83da6832acbfde88dff1d03c78802f82d79ea57918774e3fceaefebc74"
    },
    {
      "id": "bipa3.u10.l04",
      "sha256": "02d3ea168252fd89c2877382ba3e8c5845eaa6a8596c3b12d7ac97bbad6ad70a"
    },
    {
      "id": "bipa3.u10.l05",
      "sha256": "def5127478a6fe9bf39f2403d17642d8109f717cfc8cb29d0303ec10b8caae64"
    },
    {
      "id": "bipa3.u10.l06",
      "sha256": "b849af51b7a14e33948bb73298963968eb497639ce7fe2692e0ad335240a5764"
    },
    {
      "id": "bipa3.u10.l07",
      "sha256": "6b567b446a2ea6ade80484ec91ec857896db51370aee76bdf1886e62c6c56721"
    },
    {
      "id": "bipa3.u10.l08",
      "sha256": "38764261f137ee8cf1f0956b58773fd89c256a0e83c90da27feff3de17cc1757"
    },
    {
      "id": "bipa3.u10.l09",
      "sha256": "eae3f50004aaf7115c7b12d51559f063b32af635b8cd094ea3a4c331ead92858"
    }
  ],
  "audio": [
    {
      "key": "00fec500cdb3b909978f570d704f548680f4501431e18ec51cc5d454309c1861",
      "text": "Setiap 17 Agustus ada upacara bendera.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0168a9d2fe6e0c89dfded408efe3e14a1a515381463c972335547aa73e9c2aec",
      "text": "Rencananya, lusa kita menyeberang ke Sumbawa.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "032d9e056f8a72df930a46112395b7b055fa2ed01e65e2d43f8e2da8b6dc307d",
      "text": "nantinya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "03cffc971f91286cabfa4c6020efb950e3e80461b0fb4e20d7726526229c93bb",
      "text": "Saya ke Mataram, ___ membeli oleh-oleh.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "082c0cf2c897bfafb17594ee27d9438489d6dac5f46c483aa2c95d12c56cd3f2",
      "text": "Dengar! \"Feri tujuan Pototano akan segera berangkat.\"",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0986943246ea54a023316a63e0a5058d1dd0d8818e548808ebf7133e33a1184c",
      "text": "Anak-anak sekolah ikut ___ bendera pada 17 Agustus.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a527e6b067f4218d5e2aa48ff2ac364269e48922b522f3556090ef5be573018",
      "text": "Asyik! Nantinya kirimkan foto, ya!",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ae3005abed26cf6e7379e0583d4fc8a9609694c21d19f4f76d3356c073f0ce4",
      "text": "Suasana malam tahun baru sangat ramai.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0af81b51855833d232a673149976198737080deae5a93e69e0e0797728dbd7ad",
      "text": "Lokasi hotelnya bagus, dekat pantai dan pasar.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1009d39f09d7c72af0b4d57ca230b2ef3dda544e430258ece9865d7344786daf",
      "text": "berniat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "106f062738079aa59273fca8354eeb89eb7646fc4b3a35a12963d3b2c970c0bc",
      "text": "Insya Allah, kami akan berangkat lusa.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "11e21cda1474bf009586f3cffb0ae1874f8ba487efc3f4c047055f03ccb43f9b",
      "text": "tahun baru",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1511ca6ee48082d58c29ae83a2ac1d8c4a2713abe4ae8ce9c23a854fb896c9f8",
      "text": "Pesawat kami mendarat di Bandara Internasional Lombok.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a588323a8c25fef9b53e0140b631f57832ab14ad719acd03df25e312458723f",
      "text": "Satu tiket pulang-pergi ke Sumbawa. Saya kembali minggu depan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1acb4e54fcd14bda397af907c6de8b462a6dad48492d1de602de5371ff60f9b3",
      "text": "Hari ini hari Senin. ___ hari Rabu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c4cda3f5771f2f86182f9fd1401c6f972b203b7f30567d97588482f2f40c89d",
      "text": "Bulan depan saya cuti seminggu.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c917fee1b4b79a7c1dcb91ebf4ce069536fe2eb2459fc3a3901a79e5d0646d2",
      "text": "Kami ke Sumbawa sekalian mengunjungi keluarga Mas Rizal.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e3f6c1dff29b4d40a366dfab83aa7cf489956582b546217fe4f45bac516abbc",
      "text": "Idulfitri dan Iduladha adalah dua ___ besar umat Islam.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd2933c4283adec67d940096afee1fdcdab2fa56b1cf4d2c738f81f5860964a",
      "text": "Soalnya aku pengin lihat pulau yang lebih sepi. Sekalian, aku mau ketemu keluargamu.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fe1f11bf2d76d7cb6ab74e62761a15d61027ea1a8c2ea36649778e82f0baaef",
      "text": "Iduladha adalah tanggal merah di Indonesia.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "2056d97f220338ed24d13aaef9e6f9983a096e921e936bf085f46a0297c3e612",
      "text": "hari raya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "24969e3ea692629966802728c842a95912be7fded61e7855e7bfd3cf8be2edb9",
      "text": "berencana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2618f5c01b865033f5972be06edc68d067835fe522a7d9f2133cb8965dece5a8",
      "text": "Maaf, feri jam sepuluh sudah penuh. Keberangkatan selanjutnya jam dua belas.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "27c36f3eb6cddcd04d46d56cebcc374adc2dc026e8f131c91b593f45490a0311",
      "text": "Nggak, aku udah memesan taksi. Lokasi hotelnya dekat pantai.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "27f7fed2c4bdfd4e79b26db3f72be61ae54e46641dab55d8ffef4cf003713196",
      "text": "Wah, ibuku bakal seneng banget! Kita berangkat pagi supaya nggak macet di pelabuhan.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "287f27c61dcb248bd86e68ce0f687ce35c7ab8f0c02ba93c4d5f5e2ae67595b3",
      "text": "Rencananya, kami mendaki Rinjani minggu depan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2936bed527164c3b6fd7f9e8df5e23217f6ff2a65af939d361177449ca27e331",
      "text": "Mohamed, kamu udah di Lombok?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c34a1a95ce2695ac7d42a081c196b6ef4f01f3414f80459d7bbc106c2197b97",
      "text": "Iya, ke kampung halamanku di Sumbawa. Tapi pelabuhannya bakal macet banget!",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f1baeaf99c6ec2025306720b085be1f4ca15a4400b9eb4bf623b246e323375d",
      "text": "Lebaran nanti, kami akan mudik ke kampung halaman.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3275194617bfa7a2cc102c877cf6fad57ba05164372ce5808fd91e71b7eaed1c",
      "text": "Kami menikmati matahari terbenam di pantai.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "357106e54b98428d751ebb3797f2d2fcbc69cd391ba568f9a56fe2cf69860723",
      "text": "Insya Allah, minggu depan kami akan mudik.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3588c8a8bef480fa17db7dc3e2eecf272a0df312813f96e5d05bf40e487d9cac",
      "text": "Kapal feri ___ Pototano akan berangkat pukul dua belas.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "36d920e6b932f7c7388075d3afcd2fbd31424f515e4fd7e83a13ac5e4f14ced8",
      "text": "tanggal merah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3771f32acf5560e4fefd4e1dc0c51deb1ca8ce086da1342b3c98f2797ebfc436",
      "text": "sekali jalan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "3957e758e27210a321d05c219cd790042af1c61167ad97c48d46ee335a4a067d",
      "text": "menikmati",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b27cc1a58c2299c048d2f0862ca496ecc321f188e86ce16402244cd0d9e3719",
      "text": "lokasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ddd1e8f6ef8d317f154e486893e6462abc11a509d414e10daecd48a6c2b5e1f",
      "text": "sekalian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e646cd9a3a5a77f850550e48ec8cd9c13282582db9b92ff9e9f043714f300af",
      "text": "Kami menyewa kamar di hotel ini. Hotel ini punya kolam renang ___ untuk anak-anak.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "40e694b79bc1494813d4a78278203ef1bfdf4aa45ea0733ca183d4f676cc5cab",
      "text": "minggu depan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "41402b4ebe41b96e7b84846cbdc3a63b5a42ccb73ea8f4d13b8807d51fd17927",
      "text": "Setiap Lebaran, jalan ke pelabuhan macet sekali.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "4306144e3a29470dd7e1514643de33f27c1d7993732752e644a2ba50aceedcd3",
      "text": "Sebentar lagi kapal feri akan berangkat.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4330cf6aaaffa782de24613ab2e59b91c81eb2dd4fda3f7f9ed4d140c8dd03ec",
      "text": "Wah, seru! Aku juga berencana ke Lombok lagi, tapi aku belum dapat cuti.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "437340f2a9180ee14b403a1e9dd6b0273150fc0e98b7b5b87768a3081fc079a9",
      "text": "Sip. Kamu mau menyewa mobil di bandara?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1466e07ace5615b0c98b035d84df51545f542e8322294fa91998a58add2e76",
      "text": "Setiap Lebaran, jutaan orang mudik ke kampung halaman.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cddb710e1e88e842de4be50448df7364749e174a623c6258d7231aff77e3ce3",
      "text": "Tapi kita belum punya tiket! Ayo, cepet ke loket.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eddd8ec9c27baba340b67599c23437692329dd8dc78c56c444fdcb0caa84a68",
      "text": "Natal adalah hari libur nasional di Indonesia.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "508c224211b7ad46c589a5c770465fe912a7283fe39c82421918ea72f0769c00",
      "text": "Iya. Kini banyak orang juga merayakan tahun baru di pantai.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "52819026de9514d3f0e31138d46ddf865553e85e2bdc76557528c57e1ce198f4",
      "text": "Insya Allah, saya berniat cuti dan mendaki Rinjani.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e2cbf8c7a5afc558a16c99dfba1772612cb9dff2b569bd8bcfa29732466c58",
      "text": "Besok kami akan menyeberang ke Sumbawa.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "533a0d9a6121b7f64cf880ef72e7bfc0870d2026ef3986b5016078c4a751304e",
      "text": "suasana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "53c3d9393ca6c1451ac3fcef944708ba2378b7f30ae6e2ec395409fd268f1b38",
      "text": "Saya sudah memesan kamar dan menyewa motor.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5432a42a9ea40286b5ecbe0c66fea0e5c1f01f0157f3195ad1c429fb56af68f8",
      "text": "Rencananya, kami naik feri ke Sumbawa besok pagi.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "55f425f210d264dc048975455d212627030b2afb8f75ea99579e70ca60572ca3",
      "text": "sebentar lagi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "57b09e912d752ab5595e3b8717550f4bc88f99df330a97af7439d68ac98929e0",
      "text": "semakin",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "58288a71078dc27f8b846becc2fc8b56e1244b46b656303a23a1431671ccb9c5",
      "text": "Semoga kamu dapat cuti, ya!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "585e31a71e505bc2d89e04034b5bc90b89afcb14381152f76bc3535098e0dbb9",
      "text": "menyewa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5911a45c8c1fc40dba48a2847f939ef147ffde61892fa8349e85bd1e146d2d8e",
      "text": "Akhirnya! Rencana kita besok apa?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "597a7a30a6344ae38d53f58a13b3116f20309bc9fcee024909f4ca86c055c555",
      "text": "Saya ___ pergi ke Sumbawa.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "59eb20804f83a04ac4924d1c77b921b8625a233147b22f82e66b75d6ec10acf6",
      "text": "keberangkatan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c1bd76e4da6a20dfc6636bb79bf4774cbb5d51bbbc66fb9928d8acfbbc27b11",
      "text": "Jadi, keberangkatan selanjutnya jam empat sore? Dua tiket, ya.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c6ee1a38e658c85df98f8c5df2c08a4e531b9cbabdba8ef34a1451780bae208",
      "text": "Menjelang Lebaran, jalan semakin macet.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d5a8ad2ac265407da162d29d8fd3b4413e38e3f31199e8ae7be7d282a91de80",
      "text": "Saya mau memesan dua tiket pulang-pergi.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eadbb81c810bc6d6fd60f2e90f7d8063f7a27e93ff8643ec52a450f5a181dc4",
      "text": "kembali",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ec7f795f4aa8f87d04ac64d18d388998cdc3e608df9e98256e43140b54c062f",
      "text": "Feri pukul dua siang sudah penuh.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "667b8c7c8ba11757d666877d42ee309c0637991bc172615a994991b595db6a47",
      "text": "Bagus. Kok ke Sumbawa?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6850b6f38d45663fb45d8153feb83b0feb2880564bd00a3c4f9dbbab92651b8d",
      "text": "kini",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d47b68f3396afada2cd9be33d5606bfb00b3190f36166de9cc775ba8b329afb",
      "text": "Bagus banget. Suasananya rame, ya?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6df1a8d4c087ca8652faba7ed883d465a63d238c61b96477f2d03c87b3b1f039",
      "text": "Insya Allah, tahun depan aku datang lagi.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e2b3c2608301c6794769505af41db4c4d8f4f5fa6106451f9c55c836fee642c",
      "text": "Maaf, Pak, feri jam dua sudah ___.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ea98bed8a39785a19c2c25f125ca3531b2034b1b82b86d77e02031f2f2ce054",
      "text": "kampung halaman",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f606b1fd7d50b0a4564d8e2161f17c5fdec9ca9c2d6b3727de7f76ef897a660",
      "text": "Siap! Insya Allah.",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "7717ffb0c60c7f7192ed1cc39315d2af7ebc31e96c81e4a2906024fed0bb63be",
      "text": "rute",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "788f82d5ef6ac43f42d1ea5df84b4ab6126836e292f13c6b179be589120d1c49",
      "text": "Feri pukul dua siang sudah penuh. Keberangkatan selanjutnya pukul empat sore.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dce8bffedec6b7c44f3ca275e40e5451a3f48d5c59381e307eed4a5748576c2",
      "text": "Tahun depan saya berencana belajar di Yogyakarta.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "83d13654f9a12babb0ec59768660eebcfa5c120ff2d184423b41dd9e7fd63086",
      "text": "Di Mesir, Iduladha juga tanggal merah. Kami makan daging kurban bareng keluarga.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "844ab9af9f0931d34216fc19dd67b50ef81d826452fbdbfc2916326fcda71280",
      "text": "Amin! Rumah kami selalu terbuka buat kamu.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e3f02cd7218425278080be30c44fbdafe6e8b0d822d54f64db66a68a5d35be",
      "text": "wisata",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "852616351deb33fc0d789c9639f5821d6a644b97ab35b6aea4ca4b3b4e484f6d",
      "text": "khusus",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "89207339e8b2ef8a6856767dff56fd905a09764053f4d49505600a3968ce0645",
      "text": "Sebentar lagi kita sampai di Sumbawa!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9095aa3fca738d2267bece6628607d8e6c3905e430c732d55ac92c181e2186d8",
      "text": "Mas Rizal, kita ke Sumbawa kapan?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "942e836aed899011315f927daf713061b578b2ba55ee944de9e3c332d660ae34",
      "text": "Iduladha juga disebut Hari Raya Kurban.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "94a2bd7348a1885562c80bb53504051801c63fb775f442648b700b68a05569bd",
      "text": "Sekali jalan atau pulang-pergi?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "95cfb07fbe617941c8c30f6e2cc180c0d65923a3ac9c006152f48985a2afdce9",
      "text": "Saya menikmati makanan khusus Lombok: ayam taliwang!",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8190cfe8cded227567806ab30efacb46f48ed7e2eaca7dcd56fcfd79058f8e",
      "text": "Udah! Pesawatnya baru mendarat di bandara internasional.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bc9833dbeacbc05e8bbd61f96bf58d0bb2161ac683c42509729852d8228c2d3",
      "text": "Nanti malam kita makan ikan bakar, yuk!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c9163c609902e595fcc25984b2c829ba9c798c388bb4a5d0223e9667b10c4b0",
      "text": "Sama! Di sini hari raya juga buat keluarga.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a19af8292d9b629c54ea70efffe9a18f93d55ecf4cdbf9d3d95ab52425678682",
      "text": "sekaligus",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1a8595e1d543497d04f07acc6d2dc658a964a199f12250a3f336341758c3c99",
      "text": "Kami akan berangkat ke Sumbawa lusa.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2b02377395fa467b6ffa0c4e16e2c7aa2c1729ec1b22c811830e1b57112a977",
      "text": "Rencananya, kita ke rumah ibuku. Lusa kita jalan-jalan ke pantai.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3cf2746f4f55293fae1ed02be7dd34c26d2d6cd2b27a3a4c83f7e1256e90084",
      "text": "Feri udh berangkat? Blm, aku otw.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3f635baf5914a5eb284a95245f3c5a02c8110cfec6b5872538be87aac006736",
      "text": "Rute ini lebih cepat ke Senggigi.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51833f6e652ab9f8a19142892530ce80ceb991c53b691b31ab12952089a84b7",
      "text": "macet",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a84f658b71eeeff57b5a3c57d4488bf6c3aa8695833f5bf839cad9b46157ba37",
      "text": "Nggak apa-apa. Nanti siang kita makan ikan bakar dulu!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a929e56d60712afbce77b777132ba7ed11555c2082fde17cdeff57787559d55b",
      "text": "Keberangkatan feri selanjutnya jam dua belas siang.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "abb547c4f5bc4c44cd1b0fc72ab3e08eeefecf6ac573ab97c4ea3e4fe2917aef",
      "text": "Jalan ke pelabuhan macet sekali.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "adf6b6d35f54c6a41621d00efc98ea870233789afda39962e6239c5568256970",
      "text": "rencana",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1e62f6bedd7e37d7b941b014b9c4cd5589eff19dd81dbe33a306f5908389228",
      "text": "Ke Pototano, Sumbawa. Saya mau pesan tiket untuk lusa.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b49d311c45f60bae49ca0a5acd855a5777e652647b86f10c9af8430df83c9a55",
      "text": "feri",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b81b0ac389dfd1286c7bdebd05982ecdb41958d844835d3d7b1fc4297417bc20",
      "text": "menyeberang",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8a30020785ba5374d40f66f69422d505fb1b739a74264817e4543af73d2cc04",
      "text": "upacara",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb66789d06c2d47172df6ad57573b5b2e043d6ca44c7b6888d9eac6aed80643d",
      "text": "memesan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "be226e0e32be4c3bd868df9e49e0191c39edd658c45c583e9b66ea52ad327278",
      "text": "Jalan ke kampung halaman kami macet sekali.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0a1d1267e85513e04162986ce07ea4475585096b9b3f0397c756ce1e377c4c1",
      "text": "Insya Allah, saya berniat menyeberang ke Sumbawa minggu depan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "c12eb1edcde842fc8d099a3b4293a4378d22d61a101f92fc4840080083864965",
      "text": "Natal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1f4c62ad742851e80a5871d4f1ba817aeaf6f795b7edb98dcadc788d2076dee",
      "text": "Mohamed, kamu tahu nggak? Di Indonesia, Natal sama Lebaran sama-sama tanggal merah.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4919396580aa8a867adb46a590e304f674f21dfba16465a6642808853a559c8",
      "text": "Feri ke Sumbawa berangkat dari sini?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c617172865381ecb83b8c409c1bb64c41e42b40d0bc08c960daf7dd0a045a014",
      "text": "Saya berencana ke Sumbawa karena ingin melihat pulau yang lebih sepi.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "cae2625859e20c3e1169b87f0d2ba856a20218d9aa319f02f07cb3694eeb8fd1",
      "text": "Mohamed, rencanamu minggu depan apa?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb757f926a282d80b18062b0e90f33e6ad9fa912ee221d2741c2481792f1c084",
      "text": "Selamat pagi. Mau ke mana, Pak?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd1be35c8bb35ff437c5c02fcb4775a69277c5c51054a4366f94a33728975849",
      "text": "internasional",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfc0cb9a58575dc05303ca1c92cf489c46e0db964526cbd00f1eab657b46cf13",
      "text": "Pada Iduladha, ada daging kurban untuk semua warga.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "d05bdf73148a8c0a4d54051137c863a19f8e783f31d847b307f62e504e2bfeca",
      "text": "Iya. Lihat tuh, sebentar lagi feri itu berangkat.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1fcc5a9a45b2639d523a32c689315616b4704b94238caf899752501c10c6ebd",
      "text": "Setiap Lebaran, jalan macet karena jutaan orang ___.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7b0a84a084c2bde7697f3762bcf258da8d07d01e02bf81ce17d5938b05f9763",
      "text": "Maaf, Pak. Feri jam dua belas dan jam dua sudah penuh.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b710c4c6fdc56009b7953418a497b90a22cdd74d65fd53fbf127eae05d250b",
      "text": "Selamat tahun baru! Semoga semakin sukses.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8da6bd17e9d74efd384ac3b325f3f11e85d7b986db474364ba4d8e039b0cd62",
      "text": "Akhir Desember aku ke Bali, sekaligus lihat kembang api.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d932b0606c9451389d6166f6650de0391dd9db3598e8e877d7738bb9fb56ae90",
      "text": "Para penumpang harap segera naik ke kapal dan siapkan tiket Anda.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d95b1b61ad99c9d1b336983bc75def8802363b1047239a92a1a58b0b6bfbbc4c",
      "text": "Hari ini hari Jumat. Hari Minggu adalah ___.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "da71d149914e4b7641ea23b5a550255743f01a60c7c0664b4852fcece0bfa3b2",
      "text": "Besok kita jalan-jalan. Aku punya rute wisata khusus buat kamu!",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "da9c174c89155b13fe70c9ab8571e1d5249c92f189b20dc1a25029d43a20bcda",
      "text": "Aku mau naik feri besok.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "daca56c6722df89d4c5d03e747d89b24f33c47636f31423bc7324c1731e8b2ea",
      "text": "Saya mau tiket ___. Saya kembali ke Lombok hari Minggu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "db5e8a13da8470e7ae70562036914913f6f373365f50884f36e82ca57f06eee7",
      "text": "Saya berniat mendaki Gunung Rinjani.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbda61b54ce914709345e68d7857b6c076eae9603d405053690437441a9de521",
      "text": "cuti",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dea7616c4324f43ab80645958f242a07ebf3c3c86b4a6243869c02d379d9e89a",
      "text": "Jadi, rencanamu buat liburan ini apa?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "df0fbcb7f15deb68a955c3c2b74ce795350a1ca588bd8789a39cb27cb8938340",
      "text": "pulang-pergi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfda4e7721aca666edf685342c90ef976cb57500ee84d685bca0e07a746810a2",
      "text": "Lusa, insya Allah. Hari ini kita lihat pelabuhan dulu aja.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e06119c4b1bfe34e7db1856b5305210a42c50a518ee32249c035a02af8a58642",
      "text": "penuh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e072e9c4a13b04e99e9c6bbb6f866a59b9e50ab98454b6793ba2e27c5f70e553",
      "text": "Rencananya, aku ke Sumbawa. Terus aku berniat mendaki Rinjani lagi.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e09131bf0430a950bae0d429b547740f9f23b9a5c9bbefb9a12b356d80a6545f",
      "text": "Amin! Kalau dapat, aku ikut mendaki!",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e392af1f64234b6a819de1df7f48cd04329656b0f79d673b593ae01c2d1cf0b2",
      "text": "Perhatian, perhatian! Kapal feri tujuan Pototano akan berangkat sebentar lagi, pukul dua belas siang.",
      "voice": "id_gadis",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "e48fbb237fa7a2321476b181336bd51eee6eeb25e6893eec1efa32510b847c85",
      "text": "Mas, Lebaran nanti kamu mudik?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4dbbe72baa6ea8380e89c68e3696426381be3c5f373feabdb629fe5ba9c7752",
      "text": "Saya mau pesan tiket pulang-pergi untuk lusa.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e51b3bd6dcf4672883b3dd507fdff01a6840c4f311a502fa489d4686f75952f5",
      "text": "Pulang-pergi. Saya akan kembali hari Minggu. Feri jam sepuluh masih ada?",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56fda65a4f7e55de7541ed9927ff3feaf32e3b364221f4ce2a3890117665908",
      "text": "Nanti malam kita makan sate, yuk!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e698f8f2eacf4dc8b21a1c12f321a3ba70e8d7f5c9e32efded50e280c8378860",
      "text": "Nantinya saya ingin tinggal di Indonesia.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee679e8493d2f698b5f6d05e6614fbb219dc36f6de767738e01a8361d432473d",
      "text": "Baik, jam dua belas saja.",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef6181b81e0fc1b36ef1f53c686b0de2650a02f1ad52ca4c2d4d829313ad3404",
      "text": "Iduladha",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f27d6149ad067c5fd3b9534e43c39a795d10ec09e771fb002c0413b5e634dc6f",
      "text": "kurban",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6640768b221d4a579aa30590595c0d96eae6f4bf2e1f0021798ab40223c28e3",
      "text": "berangkat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb418a1f39a1c9f9c088a17d6e50c6dc96b32fcdeaa64969457a1a3b9ae2035e",
      "text": "lusa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc729d5cf61d91cedc9d9f1e3a69a307ce75b350280e8ba367f21b8ce9e58243",
      "text": "Maaf, feri jam sepuluh sudah penuh.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
