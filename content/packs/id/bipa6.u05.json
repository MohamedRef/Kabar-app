    },
    {
      "id": "bipa6.u05.l12",
      "sha256": "11c08cad47a54951a79800e1ac66239c915d58ddca2e9756dd18efa5607a8817"
    },
    {
      "id": "bipa6.u05.l13",
      "sha256": "fd01f7dbeda46053bd8b8169b3892b47c3976781d9d9197072166c77ce62cdf5"
    }
  ],
  "audio": [
    {
      "key": "001e18b9f7cec32bc8af3ac0d085a3fea34ed4b251f3bc0c879e631f82936d43",
      "text": "Tadi ada bapak dermawan yang mendoakan aku juga.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "028a5d669a943f8d032909c97f74ef04a39e5ca8565780e33fa9e1ed7f805c5c",
      "text": "minoritas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "02928fe2740e0564ceb2ec7db91e392c3df6ee56a3a754a2520c1af745bbc031",
      "text": "zakat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "02eef669468967859a8a54d3507696a1d6729d4b6cb9be849b1d1e9e27167318",
      "text": "tradisi lisan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "043813ec7ea925c22602249adf55ca3b2e47cecf65aeae3d81dada8e1c7d1570",
      "text": "Setelah bencana, kita harus bangkit bersama.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "04f0393a66b70dec9cdc25c898187e29eab67bf0fd63a25f62d1272628e6a2dd",
      "text": "kompak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "05af264af07747e2e2350dd1000fc8eb54ce52a9c97b943dc8ef46f5352802eb",
      "text": "Oke, Kak. Biar semua umat merasa disambut.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "05c3662075d6f4e9d9a6782fb4a081c3e72459708091f68e41251c251110dfcc",
      "text": "penyintas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0899017f578314e05392a2a1c615ac3f57c71f35582d70543cc135175fda0f00",
      "text": "Bencana itu mengubah hidup banyak keluarga di Aceh, karena mereka kehilangan rumah dan saudara.",
      "voice": "id_gadis",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "093f8c2512190d32606c02bab60ad54706952419843e0fe15df18c66ab4f4ee3",
      "text": "Terima kasih atas bantuan dan doa dari seluruh dunia.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bb31ea03dc873cdca0c78bdb152f257a65a41e69ea1324c03f3a3242604bacb",
      "text": "gotong royong",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bc244b5789e30d39332c8acab1f2204b624beded283a31d380705733c3fedc3",
      "text": "Saya ingin menjadi relawan kalau ada bencana lagi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d9121fe9b8b9f7b792d6f6c7d65e6ed037aa82de1cb3ad59f34997b7d2c009a",
      "text": "Para penari yang berlutut itu berasal dari dataran tinggi Gayo di Aceh. Mereka bertepuk tangan dan menepuk dada dengan cepat. Tidak ada musik, hanya suara tangan dan nyanyian.",
      "voice": "id_gadis",
      "chars": 175,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dd57ca80f404744ab230e635196520c427b2e351e4e39e8eedf9250c74da721",
      "text": "Terus \"ulama\" bisa satu orang? Di Mesir, itu jamak.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e3aaeafb7d1fd25a728fbc9c28ada1e87bd4a07938868ab586dda22544e502b",
      "text": "Setiap kebaikan, sekecil apa pun, ada ___-nya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fde0a571aefb36700ab34cf9e325ebc3c77380c015081552d4e6d0f886f41b4",
      "text": "mendoakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "10ac8fd7d80692a71d8e6995a14183993ff91cfc5a8549cfe21012f44e43e77a",
      "text": "Anak-anak ngapain kalau sirene bunyi?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1139986bce1c24f2d36861d11e8a2997d357d0aa61a65bc83ed31661ed972b1e",
      "text": "Di mana titik kumpul terdekat dari hotel ini?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "12904e85957f104eaaf8d2ba0d34fdc8ca473ea65b7d533515fcc438c0dc7e2c",
      "text": "misa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1446ac05c042dfbef204f09bfc982393e58dda62818d80f3565099ecd1c296e9",
      "text": "Ada aturan berbeda, tapi kami berbaur dengan tetangga Muslim.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "14882fb7c4183b602cf542935060cb798b5ca4603eb747a27d54613eba20676f",
      "text": "Ketika air surut, warga Simeulue tidak menunggu sirene. Mereka langsung lari ke bukit. Hanya tujuh orang yang meninggal di pulau itu.",
      "voice": "id_gadis",
      "chars": 133,
      "mime": "audio/mpeg"
    },
    {
      "key": "1693535a93c0ce6fd355a105915cf6452b3c03d6d18c12342f04f79907198e9e",
      "text": "Saman adalah warisan budaya takbenda, dan tepukannya terdengar seperti satu suara.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "169a94ce271983feb572254ca4d67148bd1cffcd53b2a1b5dd54571e4823f2ae",
      "text": "Iya. Terus sebut para penyintas. Banyak dari mereka akan hadir.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1796cbda5a5673f5b97640611a4f2614dce291588e369ee97d092e2b1b3778a5",
      "text": "Keyakinan kita berbeda, tetapi kita tetap bersaudara dan saling membantu ketika ada bencana.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "1de5684973bc1db3c3fa1a9b799a99d19afeeb37dea3cc23177d28af940800a8",
      "text": "sirene",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f7033e003b870418845944e30c696b58e95f5f880373c1b17b15fb82a0e8029",
      "text": "Relawan sedunia membersihkan puing selama berbulan-bulan, supaya warga bisa membangun rumah mereka lagi.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "227ca5b581e82347d73e1225812d73b2793fead6b84715a9efb01e3665f12e28",
      "text": "penganut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2471eee61a54563ce4eeb65cec007270f7e8f2c1cc3c82de226987be9322a5a0",
      "text": "hukum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "24c6a0fea9773edf8144323c70d4a1f30172cb51e8085ed15bd8607a2a5b61b0",
      "text": "Anak-anak sudah tahu jalan ke bukit sejak kecil, karena nenek mereka sering menyanyikan senandung smong.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a1dc45cdb17c4e3f0409895cb994833cebb27325ccdfe5f964fae6286a78e3",
      "text": "Boleh saya bertanya? Bagaimana rasanya tinggal di kota syariah?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ab80f3ac16148acde9dcf6e445ccfc85cc8742cf8436f80864c76b0adb387af",
      "text": "Pengajian, misa, dan kebaktian adalah kegiatan ___.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2abb5ebf63e111921ec406b81b0d1650da90570424132b64fa0a6abe29da26c3",
      "text": "Mari kita mengheningkan cipta sejenak untuk para korban. Silakan berdiri dan menundukkan kepala. Kita mulai sekarang.",
      "voice": "id_gadis",
      "chars": 117,
      "mime": "audio/mpeg"
    },
    {
      "key": "2da10dcec6a8efecb0152049d0f0e3212d7970b21d3902d0f5c9a7e28fab859f",
      "text": "Iya, dan kompak banget. Dengar syairnya, ada kata \"Allah\" dan \"salam\".",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e22cb9a45ecf6abb536824394cfc0185aa8788ab956a970127f9166baa7d84d",
      "text": "Zakat adalah ibadah yang membantu orang miskin, supaya mereka bisa hidup lebih layak.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e8dd82e0d900bd3ee11a033f2870736be73bbf08bbb76b51f15c9c810c392e4",
      "text": "Jangan lupa mendoakan orang tua setiap selesai salat. Doa anak yang saleh tidak pernah putus. Itu pesan imam setelah salat Jumat.",
      "voice": "id_gadis",
      "chars": 129,
      "mime": "audio/mpeg"
    },
    {
      "key": "314e735e1354b11a9639ea5c77fec8e6d4e0be5b52b782de8843e49875cadc6a",
      "text": "Warga desa dievakuasi ke masjid sebelum air naik. Masjid itu kuat dan tinggi. Setelah air turun, mereka melihat desanya penuh puing.",
      "voice": "id_gadis",
      "chars": 132,
      "mime": "audio/mpeg"
    },
    {
      "key": "33b7d7c1c9adecf587f493ce7cbf5f12431679e58d64385abe47a76b3031db41",
      "text": "sedunia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3507f407e83293152958945a92173f1c148b9a2fa7f0cd55467879c8f9fdf1f8",
      "text": "Dan sekarang seorang mahasiswa dari Mesir salat di sini. Alhamdulillah.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "353f3a8cf4283f498b19d500d1baf57d56e37d4639f8d981dd8fe818a792b5b5",
      "text": "Selamat Hari Natal untuk seluruh umat Kristiani di Banda Aceh. Semoga damai selalu ada di kota kita. Salam dari saudara-saudara Muslim di Aceh.",
      "voice": "id_gadis",
      "chars": 143,
      "mime": "audio/mpeg"
    },
    {
      "key": "360d30ed390ff1b3d0f8502f0d511f46a70afe5c4c9049fb6d1b73dd9e7c5317",
      "text": "Smong itu apa, Kak?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "3943d642032ee3023f1b2df59d1c70f2dbfc803dd05df5f881ecfdc183f38403",
      "text": "jalur evakuasi",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cb0428a9ade105341cb38bac1d6255a31f53feb9894c02c91973f7a3145fb05",
      "text": "smong",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3e77ad2cdc8defa14150a04fb3f0d3d781a269d59ba645e3dd44cc6417a4f5",
      "text": "Saya ikut berduka. Semoga beliau mendapat rahmat-Nya.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "42830a06d13c7370dd52f891de7e2531eea3b22d15ecd1c4d18987596a9ee1c8",
      "text": "Aku mulai dengan salam, terus kita mengheningkan cipta. Gitu?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f9d4579077f914dbc81ecc0e3bb1ce7a20c7146a554b45dd247c841a59358f",
      "text": "Kita mengenang almarhum dan almarhumah dengan doa, bukan hanya dengan tangisan.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "459d3bb4a799ffca7c39f5112054ff7bf49c78842b8b17e0025cee305c5b42f7",
      "text": "Habis Jumatan, banyak jemaah kasih sedekah di depan masjid.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "475074362011efb9492320a4191434b9b0c254f4404747706718d7e2d6a44095",
      "text": "dermawan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "47bf3c9729c4e195b1277b673effec5b96cefadcb46e725e7191feb162a0e23f",
      "text": "Tradisi lisan ini menyelamatkan ribuan nyawa di Simeulue.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "48975a5fd461c9dccd421715f158eb78755e2cded74a4f1b4f5c1f8afd73a36e",
      "text": "tepukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c2875ed5f11d63efb50f7489efc7d0a8a281d93743cea296260bc2f81560f6e",
      "text": "Assalamualaikum warahmatullahi wabarakatuh, salam sejahtera bagi kita semua.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c401428d1016fbb8e0da8cdf16b099504cf0aae27111153c6680ea43834c97c",
      "text": "Kalau sirene berbunyi, ikuti jalur evakuasi ke titik kumpul.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cf4e16d29f163fad56bc3924204f10b8b5c2dbb527e3dd2929130a4fa43d3d4",
      "text": "Misa Natal dimulai pukul enam sore. Gereja itu kecil, jadi banyak jemaat berdiri di halaman. Polisi dan pemuda masjid ikut menjaga keamanan.",
      "voice": "id_gadis",
      "chars": 140,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e36e3dd44292fe252acf54cdd2898f79381ebb26dab2657666a74a2953f9969",
      "text": "bangkit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "516eda2996239d1030b09abfbce09c25f5d0cf478572bd30d5f8b007c0e1cf94",
      "text": "puing",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "51f434897dc2ce1d1591b08cfe3a9e607570935f144bb5ce4094d23b404ffdd5",
      "text": "senandung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "537fb96132521ad0460639d0f854db5e7bb0127b5bee6997eeb4d48e55f99bd3",
      "text": "Ribuan relawan datang membantu setelah bencana itu. Mereka datang dari Jakarta, Malaysia, dan Jepang. Ada yang memasak, ada yang membangun rumah.",
      "voice": "id_gadis",
      "chars": 145,
      "mime": "audio/mpeg"
    },
    {
      "key": "5862e659f611b26d9f00abf522d26aa1af8456ba776a5b88191f2270b43768fe",
      "text": "rasul",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "587151301602641d6c86ac2d8c9435217cabb2cc963b33e2ba9f5433727439d3",
      "text": "Bagus. Peringatan dini nggak cukup kalau orang nggak tahu jalannya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "59557f529b73ca59204d48cf9584dcf0277ed3be4b543e674684ffff74b32f81",
      "text": "Anak-anak muda Aceh membawa harapan baru bagi kota ini, walaupun mereka kehilangan banyak hal saat tsunami.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "597300dfc1af1ed2524529dd0aa9e12f9a56562c5bbfe4cb01d03063b0189580",
      "text": "Setiap rumah ibadah harus kita hormati.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "59abedc8ceafda692a0f760999ab3dd54d4da165ce353b8ccb1a190f3f18e99e",
      "text": "Bantuan datang dari relawan sedunia.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aea2b9a87e42ca68fbcda2840d814722f4e937424d9d3133bf0e3f7ae344d71",
      "text": "Gelombang besar itu datang pada pagi hari.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dcd6c1ea0ba51542487f0702774dc08a0407f2e95e2f0852f9cbd2857a04b66",
      "text": "rumah ibadah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "61e04dbaf6993e2f29ad58513e8ca455afe67e9bc6a2ea26c418ebfce6e4ff94",
      "text": "Ribuan rumah roboh; jalan penuh puing.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "63a477d22a317c862b4c8a7e068082932b50304eb0884ecd568aab5e40f92504",
      "text": "Jemaat masjid dan gereja kerap berbaur dalam kegiatan sosial.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "6435d6c4afa7c7fad959665d9ee48f084d574dc422bd276ac1e79a6acaa81b93",
      "text": "Tsunami. Senandungnya bilang, kalau air surut, segera lari ke bukit.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ac8fa46d0bdcfea75dad8c83c644dcad20beeb6e52a7aee2ba5a370e5dfd7b",
      "text": "korban",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6595e4d26b03563380141259854676855d57aef0776503bec5bd37744eb72e9d",
      "text": "Para hadirin diminta berdiri untuk mengheningkan cipta, karena hari ini kita mengenang para korban tsunami.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "65ee0943fc694d03f628124c7800e02171318348eae4aa7b2643272476c073fb",
      "text": "Para ulama Aceh menjelaskan syariah dengan bahasa yang mudah.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "65fa0477f6ac4dd2ed0362cbb011d43e57938d775f7339f6d46d15fe04633de1",
      "text": "Ketika air surut, warga Simeulue berteriak \"Smong!\" dan berlari ke bukit.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "67bafc8c12362ab3403f027e165dd98ccb7644634cc5332200460f34347d0907",
      "text": "keagamaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "69577d7a5f11961b500d77e8e0e6bc96281558a25358aae1c7ec45d9c5e69042",
      "text": "serpihan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b39c9e818745c1177d3313127e374a74619106353dbccdf8560a7afb7e08a0e",
      "text": "jemaat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c228810290ea0009bd38ca46110792ff51dc7f683f5896d1bbcb29342634538",
      "text": "berbaur",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e1ef4d2312428d3d4f3db657604cdd39201db7a929a5a5bd9ab6be8d246f2f8",
      "text": "Kapal sebesar ini sampai ke sini? Aku hampir nggak percaya.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e87eaa38bb4544164263ecf072dd60aff0f050de22f68561fa380839d78688b",
      "text": "keyakinan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d9335d2da62e7f46eb4a96b7ba01893c372c2eaa0b7b82d990215fdabca1a0",
      "text": "mengheningkan cipta",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "7106e9fd9ceadf0e5b5fedde0b1ae6c146299abda6c352256973b43b02c0f487",
      "text": "Sepuluh penari berlutut dalam satu barisan yang rapat, sehingga bahu mereka saling bersentuhan.",
      "voice": "id_gadis",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "74092f428883d6db259322b5a624b73eae812fbeb996198604729eb8b014e530",
      "text": "peringatan dini",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "74505ec9f0cb6deb7d7cbd2d3970c4fb867bf797d6f561228312b08c98b4da02",
      "text": "barisan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "75ede14e5fa7eb2c7b76c1b0b73ca9f0cc667c55ad6f03f4dc9ff75a9f2e7232",
      "text": "pengabdian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "78078f520aaca65f8a8f320886ddc5213b15d42e8588362fa82e0e44853c29ea",
      "text": "Relawan sedunia datang, dan warga memberi sedekah dengan ikhlas.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "78eea45db6c8c2a65937427c2fb579187b3b3548767486a2d3220f2c22d8f665",
      "text": "Selamat pagi, Mohamed. Jemaat baru saja selesai misa.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "79188342b2333c16b86758f698dbd1a511e8ba324c07e3911dee44dcc4de1a29",
      "text": "titik kumpul",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d8d38ed4d75da16b1042e1df77359282057034420e70d4c6844065aea1b230",
      "text": "Ada. Almarhumah nenek saya. Waktu itu saya masih kecil.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ebad991fdae9cfda7ea20bda512ebe41bf2fc6d7c718a9efd10b6fcb8b4ff90",
      "text": "Tambahin \"salam sejahtera bagi kita semua\". Ada teman Kristiani dan Buddha juga.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef9e9e29e2cd888982ca62336bc4b288ab97219973a4581ad77b2f447bce710",
      "text": "Mohamed, di Simeulue ada lagu anak-anak tentang smong.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f582cf360068d8111bb367790065463b1c622c81f77ab8efd6360a9534e9614",
      "text": "Itu kehidupan rohani yang sehat: saling menghormati.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "804f00c9352f3ae7643602ecb709a3be8beaa0645fd923da2cdca1bac092ce86",
      "text": "Kota ini dulu hancur. Sekarang lihat, sekolah dan pasar udah dibangun lagi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "813799dc6ebc7bc0b2ad52020eaf7444be44feab98d33e469c18d63c64ccb220",
      "text": "salam sejahtera",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "866d8a4c7abf0cf16ed0d0f4fa0c88e7a102ff925ecb4a4efc447edcecc1c2a2",
      "text": "Semoga Allah memberi pahala atas sedekahmu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8705452f812dca006be4e6829113b8b43894788f9d361d7b7c2cd3f0ecbd5f11",
      "text": "Setiap Minggu, jemaat datang untuk misa pagi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8810967699e80951734676926d06cf8b117ca51b713d0ff01d0f233e734e8b5a",
      "text": "Keluarga Kakak dievakuasi ke mana?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8939073f78e85eea65aab9e24b3c441bfb9775b672d70bc519dd82522d3f91ff",
      "text": "Di Mesir juga ada penganut Kristen Koptik. Kami bertetangga sejak lama.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b7b6c411b39cf9377f85af3a18032c276111bda364532da69c47a5e51e2ac9f",
      "text": "Para relawan bergotong royong membangun kembali rumah ibadah itu. Ada warga Muslim, Kristen, dan Buddha. Dalam dua bulan, bangunannya berdiri lagi.",
      "voice": "id_gadis",
      "chars": 147,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d538f8ee1780608f6e8cce3508f0d232f9cb8fedd31798f697b7c1f4f186833",
      "text": "Pagi, Pak. Bagaimana rasanya menjadi minoritas di Aceh?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da51cc567a2bc64d231318f1d554a6ee43d02763d15b38334a22ff81e6b05af",
      "text": "rahmat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dd4225798212f9effa185511228f8d9459b57768e28a4e7c6344d42df9594c7",
      "text": "Saya orang Batak dan beragama Katolik. Sudah dua puluh tahun saya mengajar di Banda Aceh.",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e2bbb00a2106b87c2f7f047ea08fd6b0a1d345e74aeb4b9b5aef62508e60091",
      "text": "Kak, ada nama keluarga Kakak di dinding ini?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "91832e321b089c354526f35b922b1a20d34e0a0849e09f420d21e799c533a142",
      "text": "bantuan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d422ee2f85fabfcc6bb893db13e614415516b242d8c8f6431ec4cde42ec8c0",
      "text": "Jangan menunggu sirene kalau gempanya kuat, tetapi langsung ikuti jalur evakuasi ke bukit.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "97af482670d7d32e87ec465051069696cbf0f604201e9f446a2f2a0f7e8cd5b9",
      "text": "Hati-hati. Kata \"hukum\" di sini artinya undang-undang, bukan cuma kata hakim.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "981993ef2cbebcbc5e30dc1cc3b6518103cfe7e266028c32dd83df4c17d03a58",
      "text": "Ada aturan yang berbeda, tetapi tetangga saya menghormati keyakinan saya.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "9953ac5b1dc3aa9cea83a4774dea6c93c384671509aad42e86f73ccb4603e50f",
      "text": "roboh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ac2baa3e4f270b83883c567f8503c1912a72b55a2ab41803e0297059a58a329",
      "text": "Dulu dari pelabuhan Aceh, jemaah haji berlayar ke Mekkah.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ad57e54956f8aa93ad6a8f65828619a80028c8ea871e45c3d0468fa5137e81f",
      "text": "mengenang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b5d3f8b26fb84c47c69b93593a63d48c071166f35475802a4566ffd13712df0",
      "text": "rohani",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c774ee703eaa5f750c8cba6afb09ed4409ca21cb1b126d8e40cabcef49f4066",
      "text": "Kalau gempa besar dan air surut, larilah ke bukit. Jangan turun ke pantai untuk mengambil ikan. Gelombang besar akan datang beberapa menit kemudian.",
      "voice": "id_gadis",
      "chars": 148,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dcaf9c4ef5b443a0bf2e3f0d2411a66943d138d60b8e5cccb3b7983aaf023c0",
      "text": "kerap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ee8ac79068259d17026366fde7748aaa7cafd30c0392ef4098de6090a30f839",
      "text": "antarumat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a29e62675f4d8d1805487d5c562a7ea925f3328b4ec378fdaa3cbc3171b4e966",
      "text": "harapan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2c24632ff1b2dd963651c1d95fec3f28c267c90d02c0abbdcbd897a6ac2c9fc",
      "text": "sedekah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3589c3b6efcae4160bf8079dd59af57a85a93fdb691cc51138262acc222a009",
      "text": "Besok kamu memberi sambutan di kampus. Pembukaannya udah siap?",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "a45a406f2f4e60bd3e3d81f27b174a9c8121ff821abe895b894156dc5698a4b9",
      "text": "berlutut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4af71ceaebaa831662462d86f2d9060131ee44dbd2fc94c77bfefe678898c14",
      "text": "Bantuan emang penting, tapi yang utama gotong royong dan iman.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8be81df61699b00cdfd692e04eb021bb4dba3c86856d8b66056835f66fb27b3",
      "text": "syariah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9b5077223c7f45391cc15855d24328b593a8f346183a1f5b5fee6d5238a105f",
      "text": "Mohamed, panitia minta kamu memberi sambutan pendek sebagai relawan dari Mesir.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "af8aa0021a137da0bdbc76029ae25b8448d92496a541bcd5831d6b429f083962",
      "text": "Hari ini ada latihan kesiapsiagaan di sekolah adikku.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08bb2c96cd12ad6e22e6cc7aa5e755730aa0d413ab629d23af7964f4584f1be",
      "text": "Itu namanya ikhlas. Pahalanya lebih besar.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b090fb7da64a05cceec3319f2f53da125d1a540d3a46f648f03ddf4159cb6324",
      "text": "Di Banda Aceh ada masjid, gereja, dan vihara. Semuanya rumah ibadah. Warga yang berbeda agama hidup berdampingan dengan damai.",
      "voice": "id_gadis",
      "chars": 126,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0d4da739c57354f65cb4e3c48134bbc0f552e3a8e4a3b2468e1b76ae473d50f",
      "text": "mendiang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b39494f94cd5f9343496dc74f2508b27b2ed5ea7b77ff2cddf78df6f653e1387",
      "text": "Pagi itu, setelah gempa, air laut tiba-tiba surut. Lalu datang kepanikan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5318d96bb2db84969b830138bb06ba9e10a97f1748ac8fdd1ea2b1d04d1228a",
      "text": "Jadi tradisi lisan bisa lebih kuat daripada sirene.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b657cb6d2ab90d694aa6d5887e225b1be78f60fdfca2e32249d61eeab83d636e",
      "text": "gelombang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b89a43144fbb9f2ef4eb431e80f72468afc14e7db72ffbd8594e1fbe59170bb7",
      "text": "Di Aceh, tamu itu dimuliakan. Itu juga sunnah Rasul.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b89b93e1e9c3af5197c93bfd21c8d9f3b2f7487d0bfd1ffdc0a3f6ab2f4cd9a8",
      "text": "Kak, tulisan ini mudah banget. \"Pembayaran zakat di sini.\" Hampir bahasa Arab!",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba7463b357afaa364f5d8bd69c01f56a43b9b7121370efb5feb63b7918662942",
      "text": "Penganut Katolik di Aceh adalah minoritas kecil.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb67e31e33af6a5f44ebc724333ff59962361e020cc47631cd45eee5a50c2d9c",
      "text": "Jangan panik. Kepanikan membuat kita lupa jalan evakuasi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb778e07a53c04431cf01f2e29e6e4b775013ef16ec3cf6e1d9ac667ab82b7a4",
      "text": "Anak-anak mereka berbaur dengan tetangga.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc14ed3fb48a9b71f0e243b2cba677e744ccb3932e128b2fff4329eda49bfcb3",
      "text": "air surut",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf0c14dbe5c97e7ea0de356ae2c9beb7193800bed1229bf706c67d0600546f4",
      "text": "Pantas UNESCO menyebutnya warisan budaya takbenda.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd273c8f3af98c9117c39fc4bd0f93cb50a1c3cb8d484e48e56d740e79567ddf",
      "text": "Di Aceh, beberapa aturan daerah didasarkan pada syariah. Aceh adalah satu-satunya provinsi di Indonesia yang punya aturan seperti ini. Provinsi lain memakai hukum nasional.",
      "voice": "id_gadis",
      "chars": 172,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdb4d510fc1c9781981e12f48948696c45098a52d04ab1e690eb2a47f2a61c87",
      "text": "Para penganut agama yang berbeda berbaur di pasar, karena mereka sudah bertetangga selama puluhan tahun.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "bece5059cdd3426cf79033a90d74abeb53fa1949f7f60c013fd0ea558ab9575c",
      "text": "Masjid Baiturrahman tidak ___ saat tsunami 2004.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf2f664b5c8557637096ed4f980b4009275662ef09e5b20448857773d95cb9d2",
      "text": "Udah. Assalamualaikum warahmatullahi wabarakatuh. Cukup, kan?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2b62e9c9b32cc431c16b414ea4efbdb2353eeb15121db202c9c4f6138aaa977",
      "text": "Dan aku tutup dengan harapan. Aceh udah bangkit, dan akan terus bangkit.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "c30b77cf0a2cf18d69acf151d9619f7e7b05f5ce0756f145fe02fa318596d842",
      "text": "dievakuasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4643d3ded0d49da4952d2509cd1daf834a7312496652d24cd19fc0274cb7df6",
      "text": "Mereka cuma berlutut, tapi gerakannya cepat banget!",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b5fe326a0b58f5fce923f1bf6e80fb1d4ab3cda10f3d88be5cbee5c789d049",
      "text": "Para penari berlutut dalam satu barisan dan bergerak sangat kompak.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7cd344e9b7c8980a409307fc7d9f0ad47e85f0b6748036eac4591b3391bf491",
      "text": "pahala",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3c31a613f9cd634b98a523b2f5e487f6c793013131b76eeb1472058d3f766a",
      "text": "Waktu Natal, mereka datang. Waktu Lebaran, saya yang datang.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd31759f0ea638b3871af245db463a740397c3e2849aa34ab30902106b7dffd1",
      "text": "Salam sejahtera bagi kita semua. Mari kita mengheningkan cipta sejenak.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd93904c4767eb6ec92a1c45d6ab71b747833821c077505a501f60517ca38f63",
      "text": "Masjidnya tetap berdiri, ya. Pantas Aceh dapat nama Serambi Mekkah.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdd7976c8e12f0a7768cff2c9e92d82865244b54c3157231733c283481b484b1",
      "text": "bukit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef9e49e5e18b93200950f0e37aa2f2c3bdb0daaf2689c8233cca0e8f7c5be52",
      "text": "Mereka berjalan cepat lewat jalur evakuasi ke titik kumpul di lapangan.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf751485d4a64f5bdfc0d617098beca3aeb8e4cde1f65b3e5f8cf1772a573900",
      "text": "Terima kasih, Pak Haji yang dermawan. Saya akan mendoakan Bapak.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfaf95072ec8cedd211804f5989357b1a87023a1e2d63f839e5b3c2d74d54527",
      "text": "Apa rahasianya, Kak?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0e8d9d79b40af6e1f07bb1b8996e3d818a4812600f7966f4eea0b9de7389718",
      "text": "Bersedekah pada hari Jumat itu sunnah.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d451053f89650aeb0525a15988780bddc65362cde91a3a6b3333e3bf6c600084",
      "text": "Mendiang Pak Simon dihormati oleh semua umat di kampung ini, karena dia selalu menolong tetangganya.",
      "voice": "id_gadis",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4aa0dd4ee88a3ea8937472e72c59911e932a2bec460249cf8df76db7aae1a1d",
      "text": "Pak Haji itu dermawan; dia kerap membantu anak yatim.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "d71ec62346bf17efb7245a11b46173e117fc1cd9812b363bc4dcdcb5ad60edbc",
      "text": "Kehidupan rohani dan pengabdian kepada sesama sama pentingnya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8772d433b5294b042475ae5c4c61b4b9cf2955e706f33a5e451cd69600f198f",
      "text": "Mohamed, malam ini ada Saman. Penarinya dari Gayo Lues.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d993fc51c372630881172df2922b04885e42e622ca3b9552abb6db9fa4fdd1e8",
      "text": "tergeletak",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "db5f299eb1c22bc66be44eb02e55a3a2e79de7bba6d0669873337ed14467698d",
      "text": "Kita mengikuti sunnah Rasul dengan ikhlas, bukan supaya dipuji oleh tetangga dan teman.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "df88abb97affd6b20ba3b5941b30005750b164ecb4f2d683dd3d729c3f8dab7b",
      "text": "Itu di Lampulo. Dari puing itu, kami bangkit dengan bantuan sedunia.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "e14e7d94f6a791b7fb710c510da7007c0e2621e5a90f9349b8655b1183dcd60e",
      "text": "Setelah gempa, kepanikan terjadi di mana-mana.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26a6e0b26fbb63cbb6836b5134e3b378bc46835e3c82c5d18a45718f80fe93f",
      "text": "Peringatan dini memberi warga waktu untuk menyelamatkan diri.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e29ecddcde152fa0ece1889d637406f000c208eddf789a673dc60de1238a289e",
      "text": "Waktu tsunami, banyak orang berlindung di masjid ini.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3554147d537af992b736280f21b587a39cfbe8a23a0254adcfbdf6db84a2229",
      "text": "sunnah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3d0bf239f3d475f57bd184d3cb6bfc1acdaf892a24ce802b7bcbbd5141afa7b",
      "text": "ikhlas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e41578b018ea844c6c63b87286f4b15b94a7eed588bdcbe24e1368a7fcb93d02",
      "text": "warisan budaya takbenda",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4c5bef6519b3dc259265622c2dedab3238b98f3b6ad77a0f021a673d081015e",
      "text": "longsor",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e94dff924d9ae21f6bb59ed577cf3089ec75c31f4d14c4834c2cc66e35d008",
      "text": "Saya pernah melihat foto kapal yang tergeletak di atas rumah.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed6c2bb4e89ff39280631ee5fd74a7e22217a5995326e3751c53165cbbd1aea3",
      "text": "Betul. Kata pinjaman sering pindah arti di perjalanan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f001cf1aff0b39c34f315524964c03bdb1531b6bc81ade3d8365cd9410a54de8",
      "text": "ibadah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0441703a5d50e78a0c122ad7b53ea48e946f978a4013486520ec4bd7340a835",
      "text": "Ke Masjid Baiturrahman. Rumah kami roboh, tapi masjid itu tetap berdiri.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "f049df052d19b1159e71587116c0fb5eb730a294764a9e0e6f3207a85e000081",
      "text": "kepanikan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f31db9d93905ea07080d91870e6df083c2014473345fed0d73a70a036c1c86af",
      "text": "Sistem peringatan dini mengirim pesan ke ponsel warga dalam beberapa menit. Pesannya pendek dan jelas, yaitu tinggalkan pantai sekarang. Sirene di menara juga berbunyi.",
      "voice": "id_gadis",
      "chars": 168,
      "mime": "audio/mpeg"
    },
    {
      "key": "f683e7531bc286ad3796413e7b6449dcd71e448b4328b78f5f5991c8fe996a84",
      "text": "Di Kairo juga. Orang Mesir kerap memberi tanpa banyak kata.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7a138d4b12c9cf89248bea5d1b41c1df6dfdd343989671aea4d59abc769449a",
      "text": "Di Aceh, sebagian hukum daerah didasarkan pada syariah, tetapi aturan itu terutama berlaku untuk warga Muslim.",
      "voice": "id_gadis",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "f93cfdf41bb039b58c2b7d223f068d2dd11291e728dc81e3bff53445d68d09ee",
      "text": "Bantuan dari luar negeri mulai tiba beberapa hari setelah bencana. Pesawat membawa obat, makanan, dan tenda. Bandara kecil di Banda Aceh menjadi sangat sibuk.",
      "voice": "id_gadis",
      "chars": 158,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa199d7ad7503d4e1735b35c16be23abd679a030d8805583fbd6d90e5b39952b",
      "text": "kesiapsiagaan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd457fa8deccafd576f5b206bb0107d8377697e68d7739997dc4946497aae630",
      "text": "Amin. Kami datang ke sini bukan untuk sedih saja, tetapi untuk mengenang.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
