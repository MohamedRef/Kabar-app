      "sha256": "84c861f391317528ca1019884d71895c34508896892c682453c03bc81a1d4adf"
    },
    {
      "id": "bipa6.u05.l12",
      "sha256": "57256bb2eb2c8dae1120e2a9779d9810d553fa5abd2dabe488160bb045976d7f"
    },
    {
      "id": "bipa6.u05.l13",
      "sha256": "fdf7a00c44700bd9a07695da5c0f4744f4532461708e17ab7eceaccc3c88f4fd"
    }
  ],
  "audio": [
    {
      "key": "012741a7486f9805b727ab015ec664a566527abe7c87eb3144bb80e17c0ce351",
      "text": "Zakat adalah ibadah yang membantu orang miskin.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "028a5d669a943f8d032909c97f74ef04a39e5ca8565780e33fa9e1ed7f805c5c",
      "text": "minoritas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "02928fe2740e0564ceb2ec7db91e392c3df6ee56a3a754a2520c1af745bbc031",
      "text": "zakat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "02eef669468967859a8a54d3507696a1d6729d4b6cb9be849b1d1e9e27167318",
      "text": "tradisi lisan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "043813ec7ea925c22602249adf55ca3b2e47cecf65aeae3d81dada8e1c7d1570",
      "text": "Setelah bencana, kita harus bangkit bersama.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "04f0393a66b70dec9cdc25c898187e29eab67bf0fd63a25f62d1272628e6a2dd",
      "text": "kompak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "05c3662075d6f4e9d9a6782fb4a081c3e72459708091f68e41251c251110dfcc",
      "text": "penyintas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "093f8c2512190d32606c02bab60ad54706952419843e0fe15df18c66ab4f4ee3",
      "text": "Terima kasih atas bantuan dan doa dari seluruh dunia.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "09482d045f8934f1db6a076a14b6c0d2ad303798d3ca2db569f80e2b5eb6c7db",
      "text": "Hari ini ada latihan kesiapsiagaan di sekolah adik saya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bb31ea03dc873cdca0c78bdb152f257a65a41e69ea1324c03f3a3242604bacb",
      "text": "gotong royong",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bc244b5789e30d39332c8acab1f2204b624beded283a31d380705733c3fedc3",
      "text": "Saya ingin menjadi relawan kalau ada bencana lagi.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e3aaeafb7d1fd25a728fbc9c28ada1e87bd4a07938868ab586dda22544e502b",
      "text": "Setiap kebaikan, sekecil apa pun, ada ___-nya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fde0a571aefb36700ab34cf9e325ebc3c77380c015081552d4e6d0f886f41b4",
      "text": "mendoakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "10504efb1b74388b70937b4daab26cbdc46b60d46df39f68ed2c55fa452f0a1a",
      "text": "Selamat Hari Natal untuk seluruh umat Kristiani di Banda Aceh.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "1139986bce1c24f2d36861d11e8a2997d357d0aa61a65bc83ed31661ed972b1e",
      "text": "Di mana titik kumpul terdekat dari hotel ini?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "11b6ed46bd08bcf2c057e4cab848be1807917ecca6bf562da24cbafc377e1830",
      "text": "Jangan menunggu sirene. Kalau gempa kuat, langsung ikuti jalur evakuasi.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "12904e85957f104eaaf8d2ba0d34fdc8ca473ea65b7d533515fcc438c0dc7e2c",
      "text": "misa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1446ac05c042dfbef204f09bfc982393e58dda62818d80f3565099ecd1c296e9",
      "text": "Ada aturan berbeda, tapi kami berbaur dengan tetangga Muslim.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "1693535a93c0ce6fd355a105915cf6452b3c03d6d18c12342f04f79907198e9e",
      "text": "Saman adalah warisan budaya takbenda, dan tepukannya terdengar seperti satu suara.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "179dc0a2d6c0eeb0bbe45ce2f75d94ad795078df2036964cb9b1bb00462b09a7",
      "text": "Kapal sebesar ini terbawa sampai ke sini? Sulit dipercaya.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c98ccf6ccf1efd704824872418d9b03b54f13623b6697848147f8f42559e015",
      "text": "Misa Natal dimulai pukul enam sore.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1de5684973bc1db3c3fa1a9b799a99d19afeeb37dea3cc23177d28af940800a8",
      "text": "sirene",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f7e6390431271bf9af908104aa79e39b1f813755ac8542475bb8185edef47bd",
      "text": "Ribuan relawan datang membantu setelah bencana itu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "20d5a3f5669a5bd295466cba26532644ad0db682492182c36b49023b5341f078",
      "text": "Bagus. Peringatan dini tidak cukup kalau orang tidak tahu jalannya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "227ca5b581e82347d73e1225812d73b2793fead6b84715a9efb01e3665f12e28",
      "text": "penganut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2471eee61a54563ce4eeb65cec007270f7e8f2c1cc3c82de226987be9322a5a0",
      "text": "hukum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "24b059bc648a5ab8c9444abcfd097e194a376113cd8a1e2cb2d450ef07f914e5",
      "text": "Saya mulai dengan salam, lalu kita mengheningkan cipta. Begitu?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b425c1dc51c0179558b28fdd3434f7f7171ba130b350ba15152ba25f6f9ee1",
      "text": "Ya. Lalu sebut para penyintas. Banyak dari mereka akan hadir.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a1dc45cdb17c4e3f0409895cb994833cebb27325ccdfe5f964fae6286a78e3",
      "text": "Boleh saya bertanya? Bagaimana rasanya tinggal di kota syariah?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ab80f3ac16148acde9dcf6e445ccfc85cc8742cf8436f80864c76b0adb387af",
      "text": "Pengajian, misa, dan kebaktian adalah kegiatan ___.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c6eafdb8c6a21076dca413612a997952a8d13e2d3792b452e4a99aea1a259c7",
      "text": "Keyakinan kita berbeda, tetapi kita tetap bersaudara.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "33b7d7c1c9adecf587f493ce7cbf5f12431679e58d64385abe47a76b3031db41",
      "text": "sedunia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "360d30ed390ff1b3d0f8502f0d511f46a70afe5c4c9049fb6d1b73dd9e7c5317",
      "text": "Smong itu apa, Kak?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "39017d8a718a0d0cb3ded57186c385f18b62999ee4ec64897372d018958eb623",
      "text": "Tadi seorang bapak dermawan mendoakan saya juga.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "392ef6b1a333aedab804bb312f179424a3bab4de16a0f20f8d36b6d6658ed445",
      "text": "Dan sekarang seorang pelajar dari Mesir salat di sini. Alhamdulillah.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "3943d642032ee3023f1b2df59d1c70f2dbfc803dd05df5f881ecfdc183f38403",
      "text": "jalur evakuasi",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cb0428a9ade105341cb38bac1d6255a31f53feb9894c02c91973f7a3145fb05",
      "text": "smong",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3e77ad2cdc8defa14150a04fb3f0d3d781a269d59ba645e3dd44cc6417a4f5",
      "text": "Saya ikut berduka. Semoga beliau mendapat rahmat-Nya.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "4311caa411f5d496183564783caf44b07c6f2b7434c3f61d968e4eecaa0c505a",
      "text": "Jangan lupa mendoakan orang tua setiap selesai salat.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f9d4579077f914dbc81ecc0e3bb1ce7a20c7146a554b45dd247c841a59358f",
      "text": "Kita mengenang almarhum dan almarhumah dengan doa, bukan hanya dengan tangisan.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "475074362011efb9492320a4191434b9b0c254f4404747706718d7e2d6a44095",
      "text": "dermawan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "47bf3c9729c4e195b1277b673effec5b96cefadcb46e725e7191feb162a0e23f",
      "text": "Tradisi lisan ini menyelamatkan ribuan nyawa di Simeulue.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "48975a5fd461c9dccd421715f158eb78755e2cded74a4f1b4f5c1f8afd73a36e",
      "text": "tepukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c2875ed5f11d63efb50f7489efc7d0a8a281d93743cea296260bc2f81560f6e",
      "text": "Assalamualaikum warahmatullahi wabarakatuh, salam sejahtera bagi kita semua.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c401428d1016fbb8e0da8cdf16b099504cf0aae27111153c6680ea43834c97c",
      "text": "Kalau sirene berbunyi, ikuti jalur evakuasi ke titik kumpul.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e36e3dd44292fe252acf54cdd2898f79381ebb26dab2657666a74a2953f9969",
      "text": "bangkit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "513cd60bc2a40df49e6c5d81f95b4a6e1db2967a878a2ae4f3d4b0495e644b4b",
      "text": "Kita mengikuti sunnah Rasul dengan ikhlas.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "516eda2996239d1030b09abfbce09c25f5d0cf478572bd30d5f8b007c0e1cf94",
      "text": "puing",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "51f434897dc2ce1d1591b08cfe3a9e607570935f144bb5ce4094d23b404ffdd5",
      "text": "senandung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "548ce92c46b6b9a62fadcf0688fb741a0f77b9cadb5fe5460f59e8412edaca09",
      "text": "Hati-hati. Kata \"hukum\" di sini artinya undang-undang, bukan keputusan hakim saja.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "5862e659f611b26d9f00abf522d26aa1af8456ba776a5b88191f2270b43768fe",
      "text": "rasul",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "597300dfc1af1ed2524529dd0aa9e12f9a56562c5bbfe4cb01d03063b0189580",
      "text": "Setiap rumah ibadah harus kita hormati.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "59abedc8ceafda692a0f760999ab3dd54d4da165ce353b8ccb1a190f3f18e99e",
      "text": "Bantuan datang dari relawan sedunia.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aea2b9a87e42ca68fbcda2840d814722f4e937424d9d3133bf0e3f7ae344d71",
      "text": "Gelombang besar itu datang pada pagi hari.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b4f280d95a54f9c1bf3879761fb660570eb523f048fffd9e43210f746285ca1",
      "text": "Relawan sedunia membersihkan puing selama berbulan-bulan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bc99d2e78e26bfd2f82de0f0fe46ff67c8241976027a335ffa8423eb06a9e00",
      "text": "Di Aceh, beberapa aturan daerah didasarkan pada syariah.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dcd6c1ea0ba51542487f0702774dc08a0407f2e95e2f0852f9cbd2857a04b66",
      "text": "rumah ibadah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "604cda42ac35a10cd35888ba5a0fee4fe97ea35d32f8c11fb803862cda71c44e",
      "text": "Habis Jumatan, banyak jemaah memberi sedekah di depan masjid.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "61e04dbaf6993e2f29ad58513e8ca455afe67e9bc6a2ea26c418ebfce6e4ff94",
      "text": "Ribuan rumah roboh; jalan penuh puing.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "63a477d22a317c862b4c8a7e068082932b50304eb0884ecd568aab5e40f92504",
      "text": "Jemaat masjid dan gereja kerap berbaur dalam kegiatan sosial.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "6435d6c4afa7c7fad959665d9ee48f084d574dc422bd276ac1e79a6acaa81b93",
      "text": "Tsunami. Senandungnya bilang, kalau air surut, segera lari ke bukit.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ac8fa46d0bdcfea75dad8c83c644dcad20beeb6e52a7aee2ba5a370e5dfd7b",
      "text": "korban",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "65ee0943fc694d03f628124c7800e02171318348eae4aa7b2643272476c073fb",
      "text": "Para ulama Aceh menjelaskan syariah dengan bahasa yang mudah.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "65fa0477f6ac4dd2ed0362cbb011d43e57938d775f7339f6d46d15fe04633de1",
      "text": "Ketika air surut, warga Simeulue berteriak \"Smong!\" dan berlari ke bukit.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "67bafc8c12362ab3403f027e165dd98ccb7644634cc5332200460f34347d0907",
      "text": "keagamaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "69577d7a5f11961b500d77e8e0e6bc96281558a25358aae1c7ec45d9c5e69042",
      "text": "serpihan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b39c9e818745c1177d3313127e374a74619106353dbccdf8560a7afb7e08a0e",
      "text": "jemaat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c228810290ea0009bd38ca46110792ff51dc7f683f5896d1bbcb29342634538",
      "text": "berbaur",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e87eaa38bb4544164263ecf072dd60aff0f050de22f68561fa380839d78688b",
      "text": "keyakinan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d9335d2da62e7f46eb4a96b7ba01893c372c2eaa0b7b82d990215fdabca1a0",
      "text": "mengheningkan cipta",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "74092f428883d6db259322b5a624b73eae812fbeb996198604729eb8b014e530",
      "text": "peringatan dini",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "74505ec9f0cb6deb7d7cbd2d3970c4fb867bf797d6f561228312b08c98b4da02",
      "text": "barisan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "758b2e8161c332062c59d4fec84dfa4d0cb9bea914d8026151a496fef443121e",
      "text": "Tambahkan \"salam sejahtera bagi kita semua\". Ada teman Kristiani dan Buddha juga.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "75ede14e5fa7eb2c7b76c1b0b73ca9f0cc667c55ad6f03f4dc9ff75a9f2e7232",
      "text": "pengabdian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "769538e9b5ff014d81a9170cef6aab92aff32584467c47713adb3473e46e59bd",
      "text": "Bantuan dari luar negeri mulai tiba beberapa hari setelah bencana.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "78078f520aaca65f8a8f320886ddc5213b15d42e8588362fa82e0e44853c29ea",
      "text": "Relawan sedunia datang, dan warga memberi sedekah dengan ikhlas.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "78eea45db6c8c2a65937427c2fb579187b3b3548767486a2d3220f2c22d8f665",
      "text": "Selamat pagi, Mohamed. Jemaat baru saja selesai misa.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "79188342b2333c16b86758f698dbd1a511e8ba324c07e3911dee44dcc4de1a29",
      "text": "titik kumpul",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d60ac35055f658a873e0a36a12104a9fd961531d14acda14a6da7af308a444",
      "text": "Mereka hanya berlutut, tetapi gerakannya cepat sekali!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d8d38ed4d75da16b1042e1df77359282057034420e70d4c6844065aea1b230",
      "text": "Ada. Almarhumah nenek saya. Waktu itu saya masih kecil.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef9e9e29e2cd888982ca62336bc4b288ab97219973a4581ad77b2f447bce710",
      "text": "Mohamed, di Simeulue ada lagu anak-anak tentang smong.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f582cf360068d8111bb367790065463b1c622c81f77ab8efd6360a9534e9614",
      "text": "Itu kehidupan rohani yang sehat: saling menghormati.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "813799dc6ebc7bc0b2ad52020eaf7444be44feab98d33e469c18d63c64ccb220",
      "text": "salam sejahtera",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "866d8a4c7abf0cf16ed0d0f4fa0c88e7a102ff925ecb4a4efc447edcecc1c2a2",
      "text": "Semoga Allah memberi pahala atas sedekahmu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8705452f812dca006be4e6829113b8b43894788f9d361d7b7c2cd3f0ecbd5f11",
      "text": "Setiap Minggu, jemaat datang untuk misa pagi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8810967699e80951734676926d06cf8b117ca51b713d0ff01d0f233e734e8b5a",
      "text": "Keluarga Kakak dievakuasi ke mana?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8939073f78e85eea65aab9e24b3c441bfb9775b672d70bc519dd82522d3f91ff",
      "text": "Di Mesir juga ada penganut Kristen Koptik. Kami bertetangga sejak lama.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "89bfb8802dc47f73ff327e5e7cfc4706f331977a6f3eb4427e0730aee0035353",
      "text": "Sistem peringatan dini mengirim pesan ke ponsel warga dalam beberapa menit.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d538f8ee1780608f6e8cce3508f0d232f9cb8fedd31798f697b7c1f4f186833",
      "text": "Pagi, Pak. Bagaimana rasanya menjadi minoritas di Aceh?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da51cc567a2bc64d231318f1d554a6ee43d02763d15b38334a22ff81e6b05af",
      "text": "rahmat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dd4225798212f9effa185511228f8d9459b57768e28a4e7c6344d42df9594c7",
      "text": "Saya orang Batak dan beragama Katolik. Sudah dua puluh tahun saya mengajar di Banda Aceh.",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e2bbb00a2106b87c2f7f047ea08fd6b0a1d345e74aeb4b9b5aef62508e60091",
      "text": "Kak, ada nama keluarga Kakak di dinding ini?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "90885590273959db5d0afe8301e1f98f44b5f2c2124932e82b034c5a339ce689",
      "text": "Mari kita mengheningkan cipta sejenak untuk para korban.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "91832e321b089c354526f35b922b1a20d34e0a0849e09f420d21e799c533a142",
      "text": "bantuan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "981993ef2cbebcbc5e30dc1cc3b6518103cfe7e266028c32dd83df4c17d03a58",
      "text": "Ada aturan yang berbeda, tetapi tetangga saya menghormati keyakinan saya.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "9953ac5b1dc3aa9cea83a4774dea6c93c384671509aad42e86f73ccb4603e50f",
      "text": "roboh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ac2baa3e4f270b83883c567f8503c1912a72b55a2ab41803e0297059a58a329",
      "text": "Dulu dari pelabuhan Aceh, jemaah haji berlayar ke Mekkah.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ad57e54956f8aa93ad6a8f65828619a80028c8ea871e45c3d0468fa5137e81f",
      "text": "mengenang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b5d3f8b26fb84c47c69b93593a63d48c071166f35475802a4566ffd13712df0",
      "text": "rohani",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dcaf9c4ef5b443a0bf2e3f0d2411a66943d138d60b8e5cccb3b7983aaf023c0",
      "text": "kerap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ee8ac79068259d17026366fde7748aaa7cafd30c0392ef4098de6090a30f839",
      "text": "antarumat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a29e62675f4d8d1805487d5c562a7ea925f3328b4ec378fdaa3cbc3171b4e966",
      "text": "harapan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2c24632ff1b2dd963651c1d95fec3f28c267c90d02c0abbdcbd897a6ac2c9fc",
      "text": "sedekah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a45a406f2f4e60bd3e3d81f27b174a9c8121ff821abe895b894156dc5698a4b9",
      "text": "berlutut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8be81df61699b00cdfd692e04eb021bb4dba3c86856d8b66056835f66fb27b3",
      "text": "syariah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "abbcde2f4f6ea77df4fc4b389ea786e5362f92f4b226779db9ba6382c4546b96",
      "text": "Masjidnya tetap berdiri, ya. Pantas orang menyebut Aceh \"Serambi Mekkah\".",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "ace8255512a46181d6180144994ca0e7c8019401ae4ff6246726542a9030bcb8",
      "text": "Kak, papan ini mudah sekali. \"Pembayaran zakat di sini.\" Hampir bahasa Arab!",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "adb7d6e40162080c1f448e879061678e47aa9873b98fe3263978e40e146900f0",
      "text": "Warga desa dievakuasi ke masjid sebelum air naik.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "af4961352434c054a316c17014fa5dc3333660330295eca665d698f9d5d17e58",
      "text": "Di Aceh, sebagian hukum daerah didasarkan pada syariah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08bb2c96cd12ad6e22e6cc7aa5e755730aa0d413ab629d23af7964f4584f1be",
      "text": "Itu namanya ikhlas. Pahalanya lebih besar.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0d4da739c57354f65cb4e3c48134bbc0f552e3a8e4a3b2468e1b76ae473d50f",
      "text": "mendiang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24e4e1cb947fb4967453f48e7376d69aa39e0ba41acaf545496a7807bbd5f78",
      "text": "Mendiang Pak Simon dihormati oleh semua umat di kampung ini.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b39494f94cd5f9343496dc74f2508b27b2ed5ea7b77ff2cddf78df6f653e1387",
      "text": "Pagi itu, setelah gempa, air laut tiba-tiba surut. Lalu datang kepanikan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5318d96bb2db84969b830138bb06ba9e10a97f1748ac8fdd1ea2b1d04d1228a",
      "text": "Jadi tradisi lisan bisa lebih kuat daripada sirene.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b657cb6d2ab90d694aa6d5887e225b1be78f60fdfca2e32249d61eeab83d636e",
      "text": "gelombang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b70d439e571105f8f96128da3cad2498eefc2957cd0afcb9a31e20700199218b",
      "text": "Di Banda Aceh ada masjid, gereja, dan vihara. Semuanya rumah ibadah.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "b89a43144fbb9f2ef4eb431e80f72468afc14e7db72ffbd8594e1fbe59170bb7",
      "text": "Di Aceh, tamu itu dimuliakan. Itu juga sunnah Rasul.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba10eb38b2a48cc65bb77b70ae38163d6fb39301e83826e03614b7d4c1672b02",
      "text": "Dan \"ulama\" bisa satu orang? Di Mesir, itu jamak.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba7463b357afaa364f5d8bd69c01f56a43b9b7121370efb5feb63b7918662942",
      "text": "Penganut Katolik di Aceh adalah minoritas kecil.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb67e31e33af6a5f44ebc724333ff59962361e020cc47631cd45eee5a50c2d9c",
      "text": "Jangan panik. Kepanikan membuat kita lupa jalan evakuasi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb778e07a53c04431cf01f2e29e6e4b775013ef16ec3cf6e1d9ac667ab82b7a4",
      "text": "Anak-anak mereka berbaur dengan tetangga.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc14ed3fb48a9b71f0e243b2cba677e744ccb3932e128b2fff4329eda49bfcb3",
      "text": "air surut",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc43576fb61339c3622b213515fc19eabb9954dfb9e4605d132b0c173400a705",
      "text": "Bantuan memang penting, tetapi yang utama gotong royong dan iman.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf0c14dbe5c97e7ea0de356ae2c9beb7193800bed1229bf706c67d0600546f4",
      "text": "Pantas UNESCO menyebutnya warisan budaya takbenda.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "be8210c59c60d0db102905111414d4f047851580344b0d76e6793e2b5ea1610e",
      "text": "Kalau gempa besar dan air surut, larilah ke bukit.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bece5059cdd3426cf79033a90d74abeb53fa1949f7f60c013fd0ea558ab9575c",
      "text": "Masjid Baiturrahman tidak ___ saat tsunami 2004.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c30b77cf0a2cf18d69acf151d9619f7e7b05f5ce0756f145fe02fa318596d842",
      "text": "dievakuasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4109fe08a2b8df2c82cade9ad4c4e850a5e79ebd5346bbafdf1ed4b8d058a66",
      "text": "Anak-anak sudah tahu jalan ke bukit sejak kecil.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b5fe326a0b58f5fce923f1bf6e80fb1d4ab3cda10f3d88be5cbee5c789d049",
      "text": "Para penari berlutut dalam satu barisan dan bergerak sangat kompak.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7cd344e9b7c8980a409307fc7d9f0ad47e85f0b6748036eac4591b3391bf491",
      "text": "pahala",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c90411677ab4ececdeb66d6cc1d722d5e0ab15dc8a20e0a6d3b3ab01f1ef44d1",
      "text": "Anak-anak muda Aceh membawa harapan baru bagi kota ini.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca0abb35b847578a6f25a6b5068238bdcf082d0d74ea24379e3d2a583536616b",
      "text": "Para penari yang berlutut itu berasal dari dataran tinggi Gayo di Aceh.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3c31a613f9cd634b98a523b2f5e487f6c793013131b76eeb1472058d3f766a",
      "text": "Waktu Natal, mereka datang. Waktu Lebaran, saya yang datang.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca83cc2c7df5d82af3a0c744a0565d459cf710cd5bd5f206d678401fe223ba0",
      "text": "Mohamed, kamu diminta memberi sambutan singkat sebagai relawan dari luar negeri.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd31759f0ea638b3871af245db463a740397c3e2849aa34ab30902106b7dffd1",
      "text": "Salam sejahtera bagi kita semua. Mari kita mengheningkan cipta sejenak.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdd7976c8e12f0a7768cff2c9e92d82865244b54c3157231733c283481b484b1",
      "text": "bukit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef9e49e5e18b93200950f0e37aa2f2c3bdb0daaf2689c8233cca0e8f7c5be52",
      "text": "Mereka berjalan cepat lewat jalur evakuasi ke titik kumpul di lapangan.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf751485d4a64f5bdfc0d617098beca3aeb8e4cde1f65b3e5f8cf1772a573900",
      "text": "Terima kasih, Pak Haji yang dermawan. Saya akan mendoakan Bapak.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf86cbb00198112bbe61b0d1ab5bd76c82be2c2ab13e821463b905fa617cfcc5",
      "text": "Sepuluh penari berlutut dalam satu barisan yang rapat.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfaf95072ec8cedd211804f5989357b1a87023a1e2d63f839e5b3c2d74d54527",
      "text": "Apa rahasianya, Kak?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0e8d9d79b40af6e1f07bb1b8996e3d818a4812600f7966f4eea0b9de7389718",
      "text": "Bersedekah pada hari Jumat itu sunnah.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4aa0dd4ee88a3ea8937472e72c59911e932a2bec460249cf8df76db7aae1a1d",
      "text": "Pak Haji itu dermawan; dia kerap membantu anak yatim.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "d71ec62346bf17efb7245a11b46173e117fc1cd9812b363bc4dcdcb5ad60edbc",
      "text": "Kehidupan rohani dan pengabdian kepada sesama sama pentingnya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "d75be76ced0b134430a405f76ed5c8c2b4bd33af36dfd02b22c73996171b1bdf",
      "text": "Kota ini dulu hancur. Sekarang lihat, sekolah dan pasar sudah dibangun lagi.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "d799740107c94abb26242568c7617616f6195e1d086365d538a047c42a9dbeb9",
      "text": "Ya, dan sangat kompak. Dengar syairnya, ada kata \"Allah\" dan \"salam\".",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "d83b2f82bd59da7d1e6d6c5f73117d0a603e7124532af1d76db0ed07578accbf",
      "text": "Para penganut agama yang berbeda berbaur di pasar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8772d433b5294b042475ae5c4c61b4b9cf2955e706f33a5e451cd69600f198f",
      "text": "Mohamed, malam ini ada Saman. Penarinya dari Gayo Lues.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d993fc51c372630881172df2922b04885e42e622ca3b9552abb6db9fa4fdd1e8",
      "text": "tergeletak",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9ce9215c4ae0157828c7f2f8555511f28e017213fbe9810573b6659b794d20a",
      "text": "Ketika air surut, warga Simeulue tidak menunggu sirene. Mereka langsung lari ke bukit.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddcfee99472d5f38c2b08c55be6aaff2dc9190df1ba037646131543bef3802ac",
      "text": "Dan saya tutup dengan harapan. Aceh sudah bangkit, dan akan terus bangkit.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "df88abb97affd6b20ba3b5941b30005750b164ecb4f2d683dd3d729c3f8dab7b",
      "text": "Itu di Lampulo. Dari puing itu, kami bangkit dengan bantuan sedunia.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0121736cb55c5b257ff139df1d0a9c558d5f3484908718e99bc58636f1474b8",
      "text": "Para hadirin diminta berdiri untuk mengheningkan cipta.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e14e7d94f6a791b7fb710c510da7007c0e2621e5a90f9349b8655b1183dcd60e",
      "text": "Setelah gempa, kepanikan terjadi di mana-mana.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26a6e0b26fbb63cbb6836b5134e3b378bc46835e3c82c5d18a45718f80fe93f",
      "text": "Peringatan dini memberi warga waktu untuk menyelamatkan diri.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e29ecddcde152fa0ece1889d637406f000c208eddf789a673dc60de1238a289e",
      "text": "Waktu tsunami, banyak orang berlindung di masjid ini.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e339beb75233e5cf325865f17b533cf82db568a3139da6f12be57dcd6d2e43e0",
      "text": "Apa yang dilakukan anak-anak kalau sirene berbunyi?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3554147d537af992b736280f21b587a39cfbe8a23a0254adcfbdf6db84a2229",
      "text": "sunnah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3d0bf239f3d475f57bd184d3cb6bfc1acdaf892a24ce802b7bcbbd5141afa7b",
      "text": "ikhlas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e41578b018ea844c6c63b87286f4b15b94a7eed588bdcbe24e1368a7fcb93d02",
      "text": "warisan budaya takbenda",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4c5bef6519b3dc259265622c2dedab3238b98f3b6ad77a0f021a673d081015e",
      "text": "longsor",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e94dff924d9ae21f6bb59ed577cf3089ec75c31f4d14c4834c2cc66e35d008",
      "text": "Saya pernah melihat foto kapal yang tergeletak di atas rumah.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e626359c7119cffa8e4b192711641488b3cf98837ce862cddbc81180ea2c882d",
      "text": "Bencana itu mengubah hidup banyak keluarga di Aceh.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7b3abb5b2202e41de006d8640e6bbb409d2e725c94f706f5fc15b31954b8e71",
      "text": "Para relawan bergotong royong membangun kembali rumah ibadah itu.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "e92dc0da6bb14156896a77e9e7c0e333dce355c7fff42d94c220f3f24f612f1f",
      "text": "Sudah. Assalamualaikum warahmatullahi wabarakatuh. Cukup, kan?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed6c2bb4e89ff39280631ee5fd74a7e22217a5995326e3751c53165cbbd1aea3",
      "text": "Betul. Kata pinjaman sering pindah arti di perjalanan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f001cf1aff0b39c34f315524964c03bdb1531b6bc81ade3d8365cd9410a54de8",
      "text": "ibadah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0441703a5d50e78a0c122ad7b53ea48e946f978a4013486520ec4bd7340a835",
      "text": "Ke Masjid Baiturrahman. Rumah kami roboh, tapi masjid itu tetap berdiri.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "f049df052d19b1159e71587116c0fb5eb730a294764a9e0e6f3207a85e000081",
      "text": "kepanikan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1fd71565058a8d99113b15d735524236ece4bdd78bc2656ddb0fc8dbc725b79",
      "text": "Baik, Kak. Supaya semua umat merasa disambut.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f683e7531bc286ad3796413e7b6449dcd71e448b4328b78f5f5991c8fe996a84",
      "text": "Di Kairo juga. Orang Mesir kerap memberi tanpa banyak kata.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9c01dd14f09847f8d7fa55c5179c2f866180f1d0cd01c13b2faacb44d490b05",
      "text": "Besok kamu memberi sambutan di acara kampus. Pembukaannya sudah siap?",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa199d7ad7503d4e1735b35c16be23abd679a030d8805583fbd6d90e5b39952b",
      "text": "kesiapsiagaan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd457fa8deccafd576f5b206bb0107d8377697e68d7739997dc4946497aae630",
      "text": "Amin. Kami datang ke sini bukan untuk sedih saja, tetapi untuk mengenang.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    }
  ],
