      "id": "bipa7.u10.l10",
      "sha256": "36c1bf0793688e4579aaf2f0567dd624964ad548013d630d24c183cb5059dc8f"
    },
    {
      "id": "bipa7.u10.l11",
      "sha256": "b45afc351d9b2dae852e6f6b01d6b98d5a135e813b56cfa38c7ce17011d7479b"
    },
    {
      "id": "bipa7.u10.l12",
      "sha256": "14055e491e01ce871f878815d900e5bc644941ac4de482585313d81f2b8c6da2"
    },
    {
      "id": "bipa7.u10.l13",
      "sha256": "afd5377a2743cef7e39757dd19ba71586d077e62b63456082cda6bf218e44a08"
    },
    {
      "id": "bipa7.u10.l14",
      "sha256": "dff8570fa82b9300a36ae52fccaa2d152d1ce6622af0e6396bdbd9d8ae6f6ea1"
    }
  ],
  "audio": [
    {
      "key": "018d08fea0f54abf73fe75d8ae0d720a2374dc601779d24e86d90f5661b7331c",
      "text": "Komite etik meminta kami memakai nama samaran untuk semua informan.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "01a338f2dd470773d482b646b0ceda2b1c77954357f14b499b32bc1dbcec7160",
      "text": "wawancara mendalam",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "01a542f2a004af1135e7f5aab8dad73d404da07f8eb4ca9345d0b562fc760fd2",
      "text": "Data kami hanya dari tiga distrik. Penelitian lanjutan sangat relevan untuk itu.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "0346426f16c25efa44e7f74d9bb4cebcfad748da4ddd81d9e6f705316bd61bbd",
      "text": "sesi tanya jawab",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "034837ea4abc3a4cb3a3aa151c73df1009a518f6aadc52c12dc6609d2f508636",
      "text": "Artikel saya sedang dalam tinjauan sejawat.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "035f27ca5a548243719f353a44867e8b259caf0e3a412e40318672ecdf96407e",
      "text": "Pak Elias, tangan saya dingin. Bagaimana kalau penguji bertanya tentang hal yang tidak saya teliti?",
      "voice": "id_ardi",
      "chars": 99,
      "mime": "audio/mpeg"
    },
    {
      "key": "03cc1a539d64abb3ea1fe9691ece9732568728a51565fbd4487e7b2664d9faef",
      "text": "etika penelitian",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "03d645ffe9c634519ac781a8440c204a0c05cd4f71c716fbdb29aece361f1f7f",
      "text": "Bapak, nama Bapak tidak akan ditulis. Kerahasiaannya kami jaga. Bapak juga boleh berhenti kapan saja.",
      "voice": "id_ardi",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "04328462da5dcffdaff1c807a619eb04e7f57b5a03f312d0b5b962fa671d7582",
      "text": "Triangulasi meningkatkan validitas data.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "04f8efbc091f17be63264d6fdcd94325a3983d40eb804f2788de4cb89cdae30f",
      "text": "Kalimat efektif membuat temuan penelitian mudah dipahami.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "0566de5b6115a7ebbd7e43f33903275e1bc583face9126fc184e88bf7f8bbcd9",
      "text": "Dua koma empat juta. Itu lebih jujur.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "066233a1ab6c24eb7fca2a6131ece351c81b65941990e086ac44072edae862f4",
      "text": "median",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b07df68ac3ae8a938b9f0ab1e3baae10037086a2d20b81554fccebea7eebb28",
      "text": "Pak, apakah artikel ini sudah melewati tinjauan sejawat?",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b14db5012af8342c6efacf6d37628ae76c6b219ec41ad7a7b55bde6dadb601c",
      "text": "temuan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d6a60a291d215be0186c98b0e3641d9834123bd9b73213c003ffba2777c6b8d",
      "text": "tinjauan pustaka",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ead8a2e269e82df147bc4f1a7140cf52d6deb23395cd2b94a979c5a4c2b39b2",
      "text": "reliabilitas",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1061d37621ea1ec8b9598dbab74a5edb4e97dbaa30743c62a0e4ff25b203d056",
      "text": "Promotor saya ingin disertasi saya selesai tahun ini.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "109ceb8a635909912f96930aefc2acfda8fd8ed5874651f5b950b3c51821b3da",
      "text": "Terima kasih atas pertanyaannya. Belum, Bu. Itulah keterbatasan penelitian kami.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "11979234cda38c931d054f983b00814042535d76e8af9761f87bcf8501a7d371",
      "text": "empiris",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "141369a76c30827ff5181c36df53cec3f623c26290a485c1e93fbdc698dd5284",
      "text": "tinjauan sejawat",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "153187a9cb5353c4347ac834801c3bb9f506244a2cfd2c26cddd419714133190",
      "text": "analogi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "159a3b2c5ac347b335e8f1f85db84ede9bd0e05a6d68f725f67df35fb22fb0e2",
      "text": "Terima kasih atas pertanyaannya. Mohon klarifikasi, distrik mana yang Ibu maksud?",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "16066c9e4ddb1cc84993f57d8d786f4328070d0309c674be2e33a0c32448ff7d",
      "text": "Jujur saja. Katakan, \"Itu keterbatasan penelitian saya,\" lalu usulkan penelitian berikutnya.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "16bb1065544fd7d8d8ee0eb1688b4b36521a8f9578d48cc271aa346ba2e675d6",
      "text": "Koran Wamena minta versi populer dari makalahmu.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1717a4b146acc0d3d13dd76258445b3fd286c6ad386e80a4bbd703c5e43573d0",
      "text": "ragam ilmiah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b8204c935c3fcbb50a946c86dce8ae0973676a9624a7610ab627b05f9f4fea6",
      "text": "pemakalah",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d743aaea82102b91e6b574e7b8823f5f59f02fd8bd698320a6c87a2f9ddc845",
      "text": "Poster saya punya empat kolom, dari pendahuluan sampai kesimpulan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e94f7de31e242d074e0a1ded0bf2d24f05be6b33e556396c1bc78439811194d",
      "text": "Betul, dan cari analogi dari kehidupan di lembah ini.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e967b5eb917fd2507fb7f17563a99ea4a25098d6384141559cf4925771519d6",
      "text": "Bagus. Dan jangan buat generalisasi untuk seluruh Papua.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "230e9801e61697284d80d43662afaa58844c38aa877e2b75d6d4e41e9d5192be",
      "text": "Metode penelitian ini menggabungkan data kuantitatif dan kualitatif.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "242bc2106fe427caa3a7c38141f8ff5967d49b0c96d6e9cf1b0859575381eccc",
      "text": "Abstrak makalah itu hanya dua ratus kata.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "24f3d4d6ddba656cf415fb2de2147c5b78e0b8cb391868baf20e429ce3e3ecf0",
      "text": "Penanya kedua bertanya tentang harga ubi di pasar Jibama.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "252cc3d8eafdeaa94b5ec5dc20bf89d77ce4372bb324424e0b10d68bc1e47895",
      "text": "Setiap penanya mendapat waktu dua menit.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2746a4d53df76239b560a13706885ec8c646165dc4fe71e63ae9e25a3683af42",
      "text": "Penelaah pertama menerima artikel itu dengan revisi kecil.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ba3f72b9623689fcf98d5dbac708487d68f219f72f271e6f014c74d0471a33c",
      "text": "paradigma",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bf8038fe937744d6e77cffa90158947a83c03c203f7151542b28e8741c6bd86",
      "text": "Kita buka sesi tanya jawab. Silakan, Ibu di belakang.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c37fa2d084a0743b2d14da494eec191e1609a7ec7364dd84dcf4f9840afcc6d",
      "text": "akses terbuka",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d613047d10fe3eb350ec0f5f1e10005867cf9026b288a4c2692e62f38a46fc6",
      "text": "penelaah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dbd9a1e5e79d5edb11bbbf869d4506dc6a40e48541a62857f1eda73d62e27fb",
      "text": "persetujuan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e0aea7d159057ecc936a120ae119d79f40476d822b3b1dc8733cc67d8aee36a",
      "text": "Apakah temuan ini berlaku untuk seluruh Papua?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ff4e864f08d8435c2972e851dfffa9f1f930b3df0fa1b2bb6663981b948f71c",
      "text": "Siapa yang membaca artikel dalam tinjauan sejawat?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "316cbc2df7d45a32badd0af2c72de3077560af433dc5b768de7698689de1d1ba",
      "text": "moderator",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "31bc268991d99c4c40c837d811dcc98b2b6db2e4eb450c32c4125d7572f20d65",
      "text": "artikel ilmiah populer",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "32d00e9d9c5b78ed1e616b88811222550a2612cb0e09275baa977b00814ee7a0",
      "text": "Skripsi saya membahas pertanian ubi jalar di Lembah Baliem.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "36d73673fb82663873e466bd67bc1ce516ef6cca15b1ee190473b98f97722f98",
      "text": "Terlalu banyak jargon membuat pembaca berhenti membaca.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "370ff3be6d883f54496536528ede2aca8aa3f72c2841eeb36ec9b97bf03fe1ea",
      "text": "Bagaimana latar belakangnya, Pak?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3872e8de2543843eb895836436a51dc9ddff9f1213edcecc4d34539a06a310ce",
      "text": "konseptual",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "38aa7a92489a9f6ba4c69143cb0445b93ee9f45ec95396165a5eca2a3a832a65",
      "text": "jargon",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "394f7439eb4800e93c7be0a9ba4d6cc002154b06b8fe85a8d26a43f59b52ac8a",
      "text": "Bagian metode penelitian menjelaskan bagaimana dan dari siapa data dikumpulkan.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "39bfcca6bf37d2e7d308b3e8981ea669babce1455d291678f8f72e85a34f9e68",
      "text": "Peneliti itu mengakui keterbatasan datanya dan mengucapkan terima kasih kepada penanya.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a0bd1edcff97f69c10cd18d4a65055618432ce4f77b5ff29c1fabf78760265e",
      "text": "Suku Dani, Lani, dan Yali datang dengan pakaian adat. Luar biasa.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a176602d4a5f97389343de5d7103b8f577bca56fc9645be3ebddaa2014d4fd1",
      "text": "Lihat tabelmu. Rerata pendapatan nelayan tiga koma satu juta.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a81e53dfc1512e71e5e9ede27aa4776c669bb9a6be9f2d859685b6737a60695",
      "text": "Sebelum wawancara, Mohamed meminta persetujuan setiap partisipan.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d1d16ad92fff9123a93cf9434206b009bf67300d8fb752c14ad772eababb7ec",
      "text": "Dari Sorong sampai Wamena, kamu sudah belajar bahasa berita, sejarah, dan ilmu.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "3daf44ba919c5194a7e16bc1af9073e6ceac5946f410d77f1c13d48742c2ba52",
      "text": "korelasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3deb000e59fcea1cdef62d3d81314d9d347671ca98166f61aa860f75bcfd846d",
      "text": "Betul. Ganti dengan hipotesis yang jelas, lalu tunjukkan temuanmu.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "42e13f6b7c229bc28deab70564ba47e515d78e96347b221f3bf8029da19a06c8",
      "text": "skripsi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "43fcd9dd55044bf28f22f262b6876cc7f069a0348a6d213f81bffd40103149e1",
      "text": "Postermu terlalu penuh tulisan, Mohamed. Pengunjung hanya berhenti dua menit.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "463d6281f7b3bb6b213e4c378462adb366c0aca090b8621fc2e06a36bfd6094c",
      "text": "kuantitatif",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "468222b9e6f4d57e0abdae2695278a6aa6297f03ca6e13832a0c68538435a890",
      "text": "anomali",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "46dcb5456ee83fe49ae1a4d7bf1895a6a9a5af22d6936b217f9d74bab0705e0d",
      "text": "Untuk data kualitatif, kita wawancara Bapak Kogoya di honainya.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "475b236c306a912f5227af6ef908549cde9605d4cc94187224f02245938e7eb4",
      "text": "Untuk membuktikan kausalitas, kita butuh eksperimen.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "49ed4d9bc6f4c83d643a130a7a2f9f5b84f1594298edb5bb7970f9e177550f6c",
      "text": "Kuat. Tetapi rumusan masalahnya masih terlalu luas.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a197ef7fd4c5b5fc4580ffeef73a870a66ddf12150af6f420c79098dddcdb94",
      "text": "tabel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a2f1443e24f46be97f2a9c0f4c08eb32f284b8dd1ff28cdc47f1481a3ec73d5",
      "text": "disertasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bf4c9a09b4b39809d3c0eed76885fbd2930175c49167da93ce69d985e382535",
      "text": "Artikel itu sudah mendapat seratus sitasi dalam dua tahun.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e43ef7b0b5a98e376490baef10e36c4d814db1500034a5216abc2c4ec7d4257",
      "text": "Jadi saya ganti paragraf hasil dengan diagram batang?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "51e6b21cdbc126c5332ae6a8c37d77c204a274ee7a881f768fb2f8ad31fc1bfd",
      "text": "Median dan data empiris mencegah generalisasi yang keliru.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "51ec5d2c3a434c4737a15a71612e2ea291e8963e031492171baf104a6a11400f",
      "text": "Latar belakang menjelaskan mengapa rumusan masalah ini penting.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5216e3b49d50d4342b7a22699d478be2074dc18a2619be71266d101724cb9f97",
      "text": "sumbu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "52a6c500211ce6f9b2d943beee822dd5fe783610e780c2b68f7042cadc3a709c",
      "text": "Apakah perbedaannya dengan distrik lain signifikan?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "551fcb8c96e0456ce49a01498537ac57645fbe50e2a555476a2418d55f50bb61",
      "text": "kalimat efektif",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "55ed8fc2905de8a350db6b9c651f3c46f09885d9f27266cb83c21eab8baed9ea",
      "text": "Baik. Saya juga pakai istilah \"ubi jalar\", bukan \"ubi\" saja.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "55f9b5cf052a7893a8d50e5ca17875332ad94fb76ca12fd73442e5184ac04f84",
      "text": "Saya pindahkan diagram batangnya ke tengah supaya tata letaknya seimbang.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "56955c96b57250b6ad2b9e609eb2bea5b3b9e38fba9e5174d2a35f80f14a13f2",
      "text": "penanya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "56ea754a7c861bcf161680f9ceb29bdd66c2ec15cb6d5283e3e6763fb6a47a38",
      "text": "Temuan utama penelitian ini berbeda dari hipotesis awal.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5836d38d5bd05848208b8ea4c6ce3d38fce72aa62a8e65cc677a0209d1674bb0",
      "text": "Bagian mana, Pak? Yang \"saya rasa\" itu?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "58a1e77092a870752c418fbffd5cf4e7d8a09db4904a06fba47027ea326c1bb7",
      "text": "Apakah saya perlu membawa kuesioner juga?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "58efcb0896fd00647cd8ffdc9febd664a8f4a843d6618a2ac3036bcb11312fea",
      "text": "Moderator membuka sesi tanya jawab dan memberikan waktu lima menit.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "590b3b9a09577ef8a01144b41e29a04e981b19d997761f48f9f1b16031dac79c",
      "text": "Sebelum mulai, bacakan formulir persetujuan ini untuk Bapak Kogoya dalam bahasa yang sederhana.",
      "voice": "id_ardi",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a587e0429456d2f6b4f0ced5130981d8bb37d53b17ff854a78554d50df6de7c",
      "text": "Rumusan masalahnya terdiri atas dua pertanyaan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ac67784d685504defb6259e783ed0c9523bfea468cc24f19960242bb0b7bb79",
      "text": "Selamat siang. Penelitian saya tentang ubi jalar di Lembah Baliem.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef8fbb6d5e3393051fad22550f882a15e0afca51a8e8e97e5c45e37adbcb103",
      "text": "sidang skripsi",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa6ed8e98d5f4a750b086e57055dda068f5263abab3ebf0a204b5ff956bda62",
      "text": "Etika penelitian dimulai dari sikap hormat kepada partisipan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "62814f7ff2f61cf68e015e6c781d54b1ebef2ee29cfc3f02844baf8e19ac80f9",
      "text": "Baik. Terima kasih, Pak. Bapak dosen pembimbing terbaik.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "6545e3da3bd13a5e8d0a3ed92d1851c8b0ec0c9715fcad2a6c4f0ef9e1139cc6",
      "text": "metode penelitian",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "654dbe57d17a3170b130a276a48da6aee490d4e3745441d4e3c1f51bcc2aad33",
      "text": "Kerangka konseptual menghubungkan semua variabel penelitian.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "661b8bdab9cfe817c995981516510011a4162f4121c279f19266a9b15e1caa5c",
      "text": "Artikel ini akan jadi bab penting dalam disertasi saya.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "66d39e68c8ef719a8d45bbf06094dfb13a6cf940425e8caad88e970b53f43427",
      "text": "nilai tertinggi",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "67d18f2c53396b3c63bca320681d0d982b7da5e2faa6054af8097104fa544e22",
      "text": "Saya moderator hari ini. Kamu duduk di depan, ya, karena kamu pemakalah ketiga.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "67d8c9311f5287abc369f86048d6de0ae28b581fa514bcf88e6bb178c03faac5",
      "text": "Sebelum kerja lapangan, kami menunggu izin komite etik.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a1f0590519a29b14d8baeff9d5af3c630b5dcef04174b2c9165cb452fa247f6",
      "text": "Tidak. Kuesioner untuk data kuantitatif di pasar besok. Hari ini kita mendengar cerita.",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a38d41e569b60675f1ab3318708cee3ef6146aab2a26b3a00e7138cfbbc318a",
      "text": "relevan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a7f03e932aecb07ea87150e20948085cc3fab15a6ce8da078dcbce3fbcfcb31",
      "text": "Perjalanan ini selesai, tetapi belajar bahasa Indonesia tidak pernah selesai.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a99d13defa2f57713e0768275d50335c639dcfed772c3cb48380e8860d3b9bc",
      "text": "Tabel satu menunjukkan bahwa nilai tertinggi terdapat di Distrik Kurulu.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cf366b6f20b1758880fb3f1ce8f28f5b4f11f89b639ffbddc9e674253695dda",
      "text": "Semoga sesi tanya jawabnya lancar.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d3536208c1818fc867d9e00dc90431e9a5be2e68566d7caeefabb487ee1c887",
      "text": "generalisasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d7735f822a77b02732204f45e212fa204848b4746e575f92d50aa4186e06823",
      "text": "kausalitas",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f54994709ffdf6c82a50c4f9cbd5fe5ea24c4fec1bc59fcbfe373e3d81ab654",
      "text": "klarifikasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f771a77cd96c242e3c67f72ec2098b9fc3adad504ab056d5142240f55d19be6",
      "text": "Setelah izin komite etik keluar, Pak. Mungkin bulan depan.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "70c208737ff02b991712b320160325cc0ba61f4370a6f1e2763b57192f6c6599",
      "text": "kualitatif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7478c80e619adc253699390daeab5a7f2159123149fd55f41cd006c23ce7af29",
      "text": "Dalam ragam ilmiah, hipotesis diuji dengan data, bukan dengan perasaan.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "77b136d22eefb4b3c6b7ab3f74b2c1adefee00728240f3084143a689751848fb",
      "text": "\"Orang yang punya telepon lebih kaya, jadi telepon membuat orang kaya.\" Apa kesalahannya?",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a08d578038205a4bacd36b6ca9fe09c2edf4149496fbbd5656e8c8f5f2bffd2",
      "text": "Pemakalah berbicara sangat cepat, jadi saya mencatat kata kuncinya saja.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bf2b354e3e3aa8d20c38ff1e3899473bc367310e6f190049031003d028dd6dc",
      "text": "Mohamed, coba jelaskan tabel hasil kuesionermu.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d291f047b6e32344d4ba017621b3d12b1b816f893f3268041b08a62bc4897ff",
      "text": "Korelasi tidak sama dengan kausalitas.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "7efde10c89a436313bed6d55452dcfab0b1a2cd9fa0164dd316f3ac91e3c1875",
      "text": "Apakah Bapak memberikan persetujuan untuk wawancara ini direkam?",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "804053bb99f0f30b4a315ebd088e614bdfaadf8f0d8b3e1c082cf670ba7dad3a",
      "text": "poster",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "81f7137220ac6b2df9887b36b2e3913c3b5d1675f758f4e09468814add76f6ec",
      "text": "promotor",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "853068d24e15f8afedafa7008294ac0dcb1f586d8d3c8bfbe1764dfdd7fcbf37",
      "text": "Selamat! Sidang skripsimu lulus, dan gelar sarjanamu sudah di tangan.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "865dcec1f7793186f7416cb76855891d536f30ea4599c47882ef4e744fb13567",
      "text": "Istilah ubi jalar lebih tepat daripada ubi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8693c7aa1c589da5c24a303c68af717c9e40aa1fff1ea7f5a6c9a16249e6734a",
      "text": "Tetapi kebanyakan nelayan bilang mereka dapat jauh lebih sedikit.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "88191b480aee180181a9fe92f07338098e43fe6bf7a88b589d1b0e16532d02aa",
      "text": "hipotesis",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8863ac6c22afe87015d4856da7b54453bf84fa9c87c4f33702be8937a168ce1a",
      "text": "dosen pembimbing",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ad2b26a9280676fd6c6e35551e21366d7f043d9e619ab933824cc0aafeb7250",
      "text": "Ada anomali pada data bulan Maret: penjualan naik sepuluh kali lipat.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b06de441a181fcdb4a56982e2346102fc6d179d737ab3740ae8b4f0ff275ddf",
      "text": "Sumbu Y menunjukkan hasil panen dalam ton.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b461b278313be049f14030a344e383f4e317edcb5f59607020315a4bbf198ae",
      "text": "Ubi jalar betah di udara sejuk, seperti ikan betah di dalam air.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ec26cf0d7fa1dba287375948b21e257ee0844b9859884e924311950088a54f2",
      "text": "Analogi itu mudah dipahami anak-anak.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eefb832c44cc6cb415310d68903e5f096ac96ac9c87fb6e0ecf3727fe3ace29",
      "text": "Karena ada pencilan. Coba lihat median-nya.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ef2a810407bff36a608a0606b2a14d3e4f8fb7eb28d2291a21e24ca7af449fb",
      "text": "Sumbu Y menunjukkan jumlah partisipan, sedangkan sumbu X menunjukkan usia.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f660695289ac31bff090bb31ce1c53ba590da3d7bafa7bf5bb6308e2f6f97c6",
      "text": "Pertanyaan Bapak menarik, tetapi kurang relevan dengan makalah ini.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "90355672e33542f54cf8b8886bea07b652452f58c2e4ba3ec919fa0cde11485a",
      "text": "keterbatasan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "90e4a56b6274fb95701e7eb4bc5d2765e8cde0f684d8d5498eae32a939338fa4",
      "text": "kerja lapangan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "926a844c4dbfba941123faae20beb591b07263eadd777b561542e69d0cbcccbc",
      "text": "Penelaah kedua meminta data tambahan.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f285a1ad30b389051af2d15bebce4c2fdf2e51c831070dcf93ac0d2d537146",
      "text": "Tidak apa-apa. Penonton sudah membaca abstrakmu. Mereka tertarik.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "94fc611864db9e301aba13a81b483cd519ec2178027b2929befb774f270f9087",
      "text": "Baik. Saya minta izin dulu sebelum merekam partisipan.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "968b80e14ce588da0a784614f4d7c9fe50ed3a057414065a0f3dd6969fca0b52",
      "text": "Sidang skripsi biasanya berlangsung sekitar satu jam.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "96c4ec22267edeb842e81a34dd1cea4ccbece94cf8f03e0c024f45a7c8805973",
      "text": "validitas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "97e2a6e6936c16157b9c132eb8662aed7fb57b572563cc302490e9eaf04955e3",
      "text": "Diagram batang ini memperlihatkan bahwa nilai tertinggi terjadi pada tahun 2023.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c57f0f614ac1cb6c7e09641fb9695cc9634c063a0322d5b36032945515f1377",
      "text": "Terima kasih atas persetujuannya, Bapak. Kita mulai sekarang.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fae3cab8d079b87bffa89db25993118cd99888193fc01fc587c22d384201ec1",
      "text": "kerangka teori",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "a18220e0acb8b596d536588e22668739ecc98bdd574f5427e2c5e2d89f2fc3e3",
      "text": "Apa yang paling meningkatkan validitas temuan etnografi?",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a336df8bd3f18f42c04ccb4ded3673a8c8e8475c651568c52a115120cd2c6213",
      "text": "partisipan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3d546139e84247333a872bbe44bd3aeecdc6cd1b8f3e44b578724dc8022643c",
      "text": "hibah penelitian",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5b90e5898b5a276b120dde6e097b3f8ec84360f9231078b68017a4662f6e169",
      "text": "diagram batang",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "a632bba059acbf640b9570264b4f21e97bbadc739cef91398bba8ba9e461b636",
      "text": "Pendekatan kualitatif dipakai untuk memahami pengalaman para petani.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "a68309085adcb228a84cbeddcb9843578ad2984b4e8c35723b718a3e3bdc8e18",
      "text": "Kapan kamu mulai kerja lapangan di Arborek?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a75e1ebf68dae36c3022b26addd6661724039d65a99b04036f23e21f47fb1d09",
      "text": "pracetak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8897ee6f7f34ce08ff95aa9cef810284147000820e80564f3635e1754212fe8",
      "text": "Median lebih tepat daripada rerata jika ada pencilan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "aadbdaf60d0a2410a2eba9fafeae0de2d36d2c3d87944c29ad3bbe0c82ec24ff",
      "text": "istilah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "abd9680ea2ea1ba7e190fa46697be174c8acb6f7e1be3aacd80a6b35adb003ce",
      "text": "Tambahkan kerangka teori yang jelas. Lalu kita ajukan untuk hibah penelitian.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac3adaf05eb12ff8a87d5bf0961c7febb98a6611e7a2ec968ddd00c9a92b099c",
      "text": "Bagian mana yang biasanya berbentuk pertanyaan?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad1e02b41ed1c70b6978421e550f04ce7663c7c433f494273b35ecd1a374f38c",
      "text": "gelar sarjana",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae6be6c128627f82f2410b48bd7d77c9fbc27c379ffa93a33376f23a445cec23",
      "text": "Ya. Dan perbaiki tata letaknya. Judul di atas, kesimpulan di kanan bawah.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "aed2b16c0ba720d12ef9e02229d93b22dd838f4fb16d8cf01e30a289ae547d1e",
      "text": "triangulasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b11247693ed80e05d7822a8bea581a275dc2cd89dac7d2d0effd677378274230",
      "text": "Makalahmu sudah dipertahankan, dan sekarang kita menonton festival bersama.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "b21c6d156e433fe53d0a1dc7366e632642c196e043ad6c44463e1ba8b4ce9b01",
      "text": "kerahasiaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2d27fabdc867aef5f45a4a21110c65fb24e1a0c897b6444264277235737fbbc",
      "text": "Bagus. Tulis catatan lapangan setiap malam, sebelum kamu lupa.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2fdb706609522e4eaa107484d301adb1821813a1aa82d1ce55dcfaeeb128d56",
      "text": "Proposal kami mendapat hibah penelitian dari universitas.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3e63c263c98d32c9142477682af2dbbd3d98ac5d9afbdb7634a110e67342b7f",
      "text": "Tata letak yang baik membuat poster mudah dibaca dari jauh.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5dc201d3c835e22c5e5aa5f3bcc517ca3e013d380aff5e8a8e2e26dc071d2d8",
      "text": "makalah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6f99714d973c56d0548fa31474cb200cef982f154b2195ae058af1ca7fa5bc3",
      "text": "Tinjauan pustaka saya mencakup tiga puluh artikel.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7395c3791f2e065afb20c070b90457d9e009a4126008217f609760fd35b7aa6",
      "text": "Pembacanya pembaca awam. Saya harus membuang jargon, ya?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7bcd3100a30d66232e3dde09ea437442e68c5cd7fbdeb6c2b838ce67865416e",
      "text": "Rencanamu wawancara mendalam saja?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc607c18dfb8aa8da268ef7152993ec44ce96caea6000daf4d385eeaf5cc6d48",
      "text": "Tidak. Saya juga observasi dan mengumpulkan dokumen kampung untuk triangulasi.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "be8f3be07954d80f484d7eb05ed8671cf4ea6e4fa7ca4653aa60dad98a00e301",
      "text": "Semua partisipan setuju untuk diwawancarai.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0b4f5ea231a9206516f76bc6818cf7705addd76a12c9c57efb485984f2f065d",
      "text": "Belum saya uji, Pak. Saya buat diagram batang dulu, lalu saya uji.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "c342a5a4877d5d9d7e4de9b9f7a6d8f8318b4259c148f400a7dbe3d94cbed206",
      "text": "Saya agak gugup, Pak. Pemakalah pertama bicaranya cepat sekali.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c41589e8c0c19aa79b6431da0ee685f76d7587eb09ef708aa8e80fd9e37e3048",
      "text": "tata letak",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4546690da463aa84a8dee8b9ad315ba29640978bf6f37a4ea8c29b125001057",
      "text": "Catatan lapangan membantu peneliti mengingat detail kecil.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5ffd299642ad5ba0adb5a9456cecc2bd30400308a6689e8f364d9aeda85f811",
      "text": "Bagus. Bapak Kogoya bilang dia setuju, dan dia ingin cerita tentang kebun ubinya.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7926e6774e2b5636198201ad8da912e20c99c8b5c9d26694dd171bdaedaf951",
      "text": "catatan lapangan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95491b1e7667b39f873b4ca3efb08b0dd9f4795279b08d38d5b7c4e053a8c91",
      "text": "Setelah sidang skripsi, Rani resmi mendapat gelar sarjana.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca590a74d096a511d940342770bfdde438ce16246054410cdd66e37e7a7ba716",
      "text": "abstrak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca697aa0285ba5a3437dae9a740222176642e75c88a548a6212ed928432866e7",
      "text": "Mohamed, proposalmu tentang Melayu Papua sudah saya baca.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc8f8e980b7026cc331446c3ece41aab80633457307767cae292e64f14dfd637",
      "text": "Setiap malam dia menulis catatan lapangan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd948091e5a89278940ced3bec09af47f3e5f4f3e0bfa3d7f827968bb0adf7a5",
      "text": "Kapan akan terbit, Pak?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce340d29ab5018aba26d31a4417301e116dea727ba04008441c411709d5bdae5",
      "text": "signifikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cedc708765cfaf813fd748116eac0db5f6e56b0af3b164f8af0aa6608a1c2f1c",
      "text": "Kerja lapangan saya di Kampung Arborek berlangsung dua bulan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6984ff5a1b54e2ba8b355a6f07b16e90b2ea5a7e24b83e3c24f1ba8b6dff206",
      "text": "Untuk pembaca awam, peneliti memakai analogi, bukan istilah teknis.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8e2939398512e4edd7bac7d9d9cfa5b973f4f0a431a48d793fe8e4b0f6c5c48",
      "text": "Latar belakang penelitian ini adalah hilangnya bahasa daerah.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e10f798d3e7f0e615f84c59fbf0a5c186103ea2a98844eaf0f17173d76c676",
      "text": "Promotor saya membaca setiap bab disertasi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "db47be5dc9fc1c2d2b30ab86a58e891c4ed2636171ebcdbadd620259d32f823e",
      "text": "Analogi yang baik membuat ilmu terasa dekat dengan kehidupan sehari-hari.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc4346707b60accefc9910105df0569a3bd55c9bc2463c6de6c7a1ea37c25c4b",
      "text": "rumusan masalah",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc5412408140c6b6578bdbacfd32eef23e3365c69e82a54ea487694f876052ca",
      "text": "izin penelitian",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd91ede56e3e5f7e7b8cbe5344be111fd67b35b9c2932005f78f6c1a11c811b0",
      "text": "Belum. Ini masih pracetak, jadi hasilnya harus dibaca dengan hati-hati.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "e084bf21f57acb431a27baae6bb103e816b1ad5c353215466ad776868a1d5200",
      "text": "kuesioner",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6a387792cc234880afee25deff33bb9aaf4a16f1c31dd95ea2da10372b0cfcc",
      "text": "Setelah semua pemakalah selesai, kita masuk ke sesi tanya jawab.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9e73ad7852d75fe460116aa13f920f61ba52bc55a66e6c1ce2ce7f6c73d6516",
      "text": "Kesimpulan itu harus didukung bukti empiris.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb6158f9073f648a246e3a84d1a3c6f191966edc62da2ace3d8f233c80931ece",
      "text": "Siap, Pak. Besok poster ini akan bercerita sendiri.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee2f959becc42513204d187678f7a225cb5bb299240f187ca196925d1a53868a",
      "text": "jurnal bereputasi",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee76e730f6520f61a2985bfb741772732368a1dbd674b6f6f946771bfc328dcf",
      "text": "Tabel satu menunjukkan jumlah keluarga yang menanam ubi jalar. Nilai tertinggi di Kurulu.",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "f08d59b2248c39a2d099b69382531fb9ac1be077222bda8249fdc19b84863559",
      "text": "Simpan terima kasihmu untuk setelah sidang skripsi. Ayo masuk!",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1e4bf613a8b88aada0bcddabc3df16171b8235f57b0eed1dce30b4fc0774151",
      "text": "Drafmu menarik, tetapi ragamnya masih seperti obrolan.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2518c1196131122fe8490357260d4903e25c45d42acd5d6d797d6cd1f83e6cf",
      "text": "pencilan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f319ad05ce80a3a3c2d6804fa306be89745385cf07fd35487c947979973b4354",
      "text": "komite etik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f347b788a31fa7ec99515be0ba174683651a1aaf652820d593dac60e09c3ef60",
      "text": "etnografi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f54cdb9f6bd0e31d492c7ac5842ce82901b86bb9dbc1716dc9e3e232145dcae2",
      "text": "Artikel ilmiah populer menjembatani peneliti dan pembaca awam.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5aa2464f8874b02e1682e8def09444c06460aa8557943ee9f9dd63567d52e89",
      "text": "pembaca awam",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7fc80b2eed95bd07d54024637290672f3e2200c69aec8c23bc3a94a2767335a",
      "text": "Dua penelaah sudah setuju. Jurnalnya bereputasi dan akses terbuka.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "f81ff2fb1af2791fbb9a7a109be8ebb4b0cd02f8f127ec647c680a9081f6989b",
      "text": "Izin penelitian saya sudah keluar, dan kepala kampung juga sudah memberi persetujuan.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa1293e42dd280dc7aa185088d53f266245e21b5be46ad60b06f84c80da3329b",
      "text": "rerata",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa6d76c87fa83a7be40e726a122a240e83f79660a9b79c04ba207ab9f61a4cf4",
      "text": "sitasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "faa46a1610f283a14fa1fd7c3578102400bafbba4f77fff446e8f6d3dc629271",
      "text": "kata kunci",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc1d063fb3329b4c547f95c031c10c4c5b8d8d54ad346e577e52427e02355a45",
      "text": "latar belakang",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd27db41c2b0820d5ffaa2122c181046c9f6f964181c4faf3e359ae454e613d8",
      "text": "Partisipan boleh berhenti kapan saja tanpa alasan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdf444be00290ce1156026bbbfa2f4724411d8ab90dbd805605e4388373a698d",
      "text": "Saya akan mempersempitnya. Apakah tinjauan pustakanya cukup?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe7e70b57eeedad697a51da2c8e4f54c91d34bab7722f4787898da2217586fae",
      "text": "Sidang skripsi Mohamed dimulai pukul sembilan di ruang seminar.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 14,
    "clips": 198,
    "chars": 8503,
    "audio_bytes": 0,
    "missing": 198
  }
}
