    },
    {
      "id": "bipa6.u01.l06",
      "sha256": "02352e3d1028ecfeae42f47acbd1709d77cbc388953751f03095820bce97c1e4"
    },
    {
      "id": "bipa6.u01.l07",
      "sha256": "1815dec0827435672d1e70db08c19ee78a9d9b17512ed25b50b299951a952b2b"
    },
    {
      "id": "bipa6.u01.l08",
      "sha256": "370c8f07e529448e2b04aba8cc814bb0d89e41ab9ca93985d00fc04300d27c75"
    },
    {
      "id": "bipa6.u01.l09",
