    },
    {
      "id": "bipa6.u01.l10",
      "sha256": "b01290ce19d8d3cdb5c4277ff693a6d8a521e14cab5c0b2ec1153546d4534ac3"
    },
    {
      "id": "bipa6.u01.l11",
      "sha256": "630318eb921a6ddc7dce342edd454cb4ca5b888edf40e4db3b7536debdb9decf"
    },
    {
      "id": "bipa6.u01.l12",
      "sha256": "6e1e8f705e2bd0e3094cda7d0858f1ca011a149db69509f6445666546c6825f1"
    },
    {
      "id": "bipa6.u01.l13",
      "sha256": "201c964afdd7ff1d5facdb96100b2a0bd2f998c03cfbe410dc2160caefbe36c0"
    }
  ],
  "audio": [
    {
      "key": "011bf7c0f1f2eb77b03d50f553e6eae97a6a16d71132d10b95bcf4b20daf472d",
      "text": "Setiap hari Minggu, satu cerpen diterbitkan di koran itu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "0329759e44e45a02e66ca4a6ef316d0aae27078ee43e8f517136087263140d90",
      "text": "Betul. Lalu di tengah cerita ada kilas balik ke Danau Toba.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c63dcaa7a8aeb53dc03edf5cb2063ed3ea6e5d0f43e4fb250150985d13d268",
      "text": "berbisik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "04a8a5b3ec25fd704f9f0a1145af63233aa2d3b784df467a16c2be854aee99fa",
      "text": "Di tengah keheningan, dia teringat suara riang anaknya, penuh kerinduan.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "05f90a4cbaf13b93753ead24173d4b68e5e2ef40a4f0d8203146fe25c1a8deac",
      "text": "cerpenis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "07cc3d585f8870c642ce7de58c8944d20c8c71b354bfc4dcc217caedb1200e0c",
      "text": "tangisan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a2602d1903abb7e500d1b9eefd2607b7f4b46feac4259040f06a87b57a110ab",
      "text": "Dari kamar sebelah terdengar tangisan seorang ibu.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec7a0ae6efde875df831030682bf5f249e1090cc468c3c7cadd1d2eee97bc7b",
      "text": "Hebat! Redakturnya suka cerpen tentang kursi kosong itu?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f8f9f7038b0f09c732c42c550a5cf34733ca2cf193489248c7e57b47071be01",
      "text": "Maaf! Maksud saya, enak sekali. Saya belum paham makna tersiratnya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fc28fa39f6809def9fefd1ced60a42cb673b6fbb08ab0d94dec4e4ba5abc31f",
      "text": "Gaya bahasanya sederhana, tetapi akhirnya sangat menyentuh.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "107ea1a414cbba04bb3345b13db7d948a2ac32133785d565e9c30c1a11100b9d",
      "text": "Cerpen ini punya akhir terbuka, jadi setiap pembaca menafsirkannya sendiri.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "131cda1b27980b45592d12f2718f375a6132e589b46fca5ef009d8f82c7a554f",
      "text": "Sejak kepergian anaknya, rumah itu terasa hampa.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "145be80b603e3f4b087c164baff1ab98c5838f79c9caffed28711c321f8355e4",
      "text": "menoleh",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "173dd32695a2b0ba072f863c4fbdf62a4182bb61cb53b89882b3362a718d1ebe",
      "text": "redaktur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "19134101afbecb7442ba676dbfa7a1ea4df61462e3ff7e9ed1ee42772b832fce",
      "text": "terserah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1963874752a1671de6d2f34618d0f3da83ae27defb2ba635d8e38a222cbd43f0",
      "text": "tersurat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a9d94b8ced8cc26c41b4da286e0be67e375e7572e4b9cddd4c8729c607fb1cb",
      "text": "pagar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba44d36604ce941f429e8b1cdfba36a7131b0f706b5c8cb3f6b127db64dc19d",
      "text": "Anak itu merantau karena ada konflik dengan ayahnya.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d3fd27f2d232d826e06a125444c5ae04d7895bc88e0b3da6e543df448c735dd",
      "text": "Tapi ternyata dapurnya kosong. Itu bukan hantu, itu kekosongan setelah istrinya meninggal.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "207b8a0575e7ff8c4beab7a2e16197b2ea74e709fecc49ac52f5121f82363fcd",
      "text": "Dua cangkir! Jadi dia sudah memaafkan anaknya. Itu makna tersiratnya.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "22699a8e0fd4224a7580a848160406fe26c517f54d14bc75620794210d03de69",
      "text": "Ya. Katanya, pengarang muda jarang menulis makna tersirat sebaik itu.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "24522512a7d295388c2357b183122a3202898fe24888c767c2e1309d6bccd57f",
      "text": "Dan setiap malam dia menghela napas di depan jendela.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2507576cd9b368c29465a86c36834224b730ec517ad51d29280da03df46f22da",
      "text": "pengarang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2609f60069082456895c912a9c7a323c8390d9fe944a45842ab3d9b437fff482",
      "text": "bisikan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "28d6e743f29315c6751f4c848a46f09972281b49ba5c861e68c7ba92aca176c7",
      "text": "Tidak ada suara sama sekali. Hanya ada ___.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "294da3417903a8a5f6c9b143e91f435a479f826d367451e71e4f882d41c2b481",
      "text": "Penulis tidak menangis di cerita itu, tetapi isyaratnya jelas.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2994804ad3d62173579b7f53e48e471a50f34e9844f56d1bbf334fda8bb7fd32",
      "text": "mengesankan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2aa6de1c57c5da8662c16ef845572263a4a6ad3c79351bf3c5556c2343f9b6f3",
      "text": "Hujan dalam cerpen itu adalah simbol kesedihan, menurut saya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c15d9fe7c1f6243fc949abd246c1c3762635ac1fe307402ce2e97f4e8dedf16",
      "text": "begadang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c5a84849ca08fa992ffc080a3ec7a8e5a05abd3070f465fab44713e2e861da5",
      "text": "Betul. Kalau pengarang menulis \"bentak\", maknanya lain sekali.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e1c805b02bfcae81128eac918fdcc3f919e3aa550272f1573dabd898fb12f7a",
      "text": "nafkah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "327ea9655694df23b395bfa292ea12a7c97e2f32d71ad08a425efdb0ff33d721",
      "text": "kerinduan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3382c6e1796e18987786fc62e1804dc449b0f24c59d7b5606faae18f06632fb4",
      "text": "Seno Gumira Ajidarma adalah cerpenis yang terkenal.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3399799e208cf52a45e81d5fc27644c3300adc083d1c3118ffd67a6b87064be4",
      "text": "terpaku",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "345978f2170fa228058d9f1806e80133b798f1c57f45c7333e74e192d7908798",
      "text": "Nenek bergumam pelan sambil menjahit baju.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3516b0810c623bcdfc6bdf2622d8c7a565fe6b224200aaec81f24b0cc441234d",
      "text": "kelam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "355eaefe027acc62928d9266ce89ef90337425797dc6989908ab493840ff089b",
      "text": "Kepergian anaknya meninggalkan kerinduan yang panjang.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3581471a618f50b7876a7395231913f1971385cb628119a76f8109e99bfe257c",
      "text": "Barangkali dulu ada konflik. Dia takut ayahnya masih marah.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "382a044562980550a5facddff73c70d9fba1656d1760e7f61e06602bc642191b",
      "text": "bergumam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "39ec0cc0bed822f0e771e77c61a8af2cb19fa88d46a01488c169bc3065d02e0e",
      "text": "gemetar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "39ec1df5e6ae9a01819981e17bd9800be38d8a7f34c3bde298288b0c20a84c83",
      "text": "Ada yang memanggil namanya, tetapi dia tidak menoleh.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ae9b2c53ca807e4e7a0d7bbbe37970093350de0308b7b49ec2bb260d145a3a5",
      "text": "Dia tidak marah secara tersurat, tetapi dia menyindir.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b0dc92c3c5c21c5e7b9df6f3a1227a08df42db3245eeb6c3bd0a44f247f9c3f",
      "text": "Anak yang lugu itu menyambut ayahnya dengan riang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6125acd5e2484ef1bf9e0e9f04ffb4b64b0f8dd7d335a5ac6411d30452e063",
      "text": "rindu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bc45ed4734f49809406f65584ff1cfd1fc499a0d4bf2b814c58d0ec14cb517d",
      "text": "membentak",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e459ca0a0c7fcbcec38f015db544d4cf8567d39daa39f0840d704c11362f3d6",
      "text": "Rumah besar itu sepi; hidupnya terasa ___.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "41943b1c45246996b9789ebbf5e1c2380ad7a9c9dc1a03f7745d6d832b499810",
      "text": "Redaktur suka kalimat pembuka yang pendek dan kuat.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "43360b9f8241d18461fe6fcfe874a4370e1a651b909a6cc79b6c5e0f04c7528c",
      "text": "tanda petik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "44e6d11f96e12a5dbac24d0e5c0a3d2a8d01830ad6dfe6e198ecb4e26386173f",
      "text": "Dan monolog batinnya penuh rindu. Pengarangnya pintar sekali.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "456ca118fbdc0252720a22d46f870c8914950854f8751210e37318b91d07c3a4",
      "text": "Ayahnya begadang di kantor. Ada kekecewaan dengan pekerjaannya, kan?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "464934b0ad122a2372e2f5a46b653c25a5915ad02c483fdfbb8fe7d894973569",
      "text": "Ya. Pilih satu pencerita, tambahkan sedikit dialog, lalu berhenti.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "46c6669719fa4446cb030e60cc374bd4036d61cf906cb7037ae5aeca98a71773",
      "text": "Anak yang lugu itu menyambutnya dengan riang.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "47266b9c8b9cf9d90ab216caa27107a6c2c3bf92f9bc2325f256626e4eb61f11",
      "text": "Semoga suatu hari cerpennya masuk kumpulan cerpen terbaik.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "474af7927cee5aa3341db52301fa04a3be63b3e76331c0407b0651b291451a7b",
      "text": "Amanat cerpen ini adalah bahwa keluarga selalu menunggu kita pulang.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "47a28e4b485eab207a5bcd9b258b94c4fc8958334e27170c002efbf39769e636",
      "text": "keheningan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "47d344f0c9b4ecd9d4abd946f85c922d90742e9f3cdc50048c6bfac3831fc667",
      "text": "Anaknya merantau ke Jakarta sepuluh tahun yang lalu.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a251693e75657e6950e1b65c56265f43abedb25c77448abbfaed565e53cbc9c",
      "text": "Lumayan saja? Wah, nenek pasti sedih mendengarnya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "4af08bb433ee763bc31b5085e343e665062e4b8e0fb08513664aefb9a45020ee",
      "text": "cangkir",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b5078d3d447e25db953728596e963875db629a95b7da1d54fb09ab19c89701a",
      "text": "Bagian favoritku: ayahnya pulang letih, anaknya menyambut dengan riang.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bf8af1257155089ddfd6da5511b700aa17d8a9d75959e187394df15ac012043",
      "text": "Gaya bahasa cerpen ini sederhana, tetapi sangat kuat.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c82f8c7a47329ce3240374bd5e021dd68e934b4741d38fcd08a04983866e05d",
      "text": "menghela",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4da35025aaca5c6c0bdde9832f1123db6556f769ca93c3464a65afc843738544",
      "text": "haru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ea6fc7601378cc93b957dfea08c80cfbca7ce0055fe1668a030ebcbd079212e",
      "text": "Keheningan malam pecah oleh sebuah bisikan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fa8c798cc9508fd08c8ca405cdb1f2a011b7607541bad3a75c90da78d887380",
      "text": "Ibu hanya diam, lalu kembali mengaduk teh yang sudah lama dingin.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "504fbeadcc4ffe38c8d0b186cc826e71ef866fd3fb7ba1e2c839c8e4b3602d10",
      "text": "Cerpen ini diceritakan dari sudut pandang orang pertama, tentang masa kecilnya.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "52541459d120f8e31acedffd6835341314c15d40e1ea131690e705a011355d58",
      "text": "orang ketiga",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "527672ed07c66e00338c0adb0355ad3544c220dd2507761d25ca4933fe4494d5",
      "text": "Jadi, Mohamed, apa tema cerpen \"Kursi di Teras\"?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "53614cb6d8bc70e1d6d291d895269fa900b32f12967c84074fb6610be40675d6",
      "text": "Gayanya campuran, ya. Ada Tionghoa, Melayu, dan Eropa.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "54cfac5d4f30fde312205536090532ece6a8944ffcaa7e04a9f58a337a53ba5d",
      "text": "Kalimat \"akhirnya terlalu cepat\"? Itu kritik yang sopan. Tidak apa-apa.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "55062b0f3a588c130a5f0919d414bacf1ef4bbf7efd6464d0d414936252b58ad",
      "text": "Tangannya gemetar, lalu dia menghela napas.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "59ba3c09ac081831f52ca57a8cebf7a8f27b1a238d55555aa02131af6b215de5",
      "text": "Anak Pak Lubis. Jadi kita hanya tahu pikirannya, bukan pikiran ayahnya.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aa400c9b647cf0dd2cf39807be444475ab5da16f43ace7e02945b4a8dee204c",
      "text": "Betul. Tapi dia bertahan demi nafkah keluarga.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aa66cffc5c3daf3e08039c357d15f66617c47cc8c0d677ce4eb2284afe64400",
      "text": "Setiap pembaca bisa menafsirkan cerpen itu secara berbeda.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bc3fe6ca8f1dbe5490cd8829e0e4fa7931b231c5931e0dff1a7eccb7a4a47fa",
      "text": "orang pertama",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c8036704c58c99be957dc759b566167be3c54ac86d7fe4cd8fd09787c1bc715",
      "text": "Terima kasih, Kak. Saya masih ragu dengan kalimat terakhir saya.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cd4731f6bb01e188ee305d49e4ab136f65db0c6c7ad56936670045fb607d966",
      "text": "cerpen",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d7dd35ca3f00d52a7610abc771f9afdbc237bc5472e50e2d9470dcf4f538ddb",
      "text": "Latar cerita itu sebuah kampung kecil di tepi Danau Toba.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "62308e3a2120e9644d310d5c4349b3140076a199a967eb595aea25f59510120d",
      "text": "Dengan akhir terbuka, supaya pembaca terus berpikir.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "639e1c7f9ab3608395bac4b05efef46e2e9e63668875dcacd849ed7c8c74c228",
      "text": "Lumayan, Kak.",
      "voice": "id_ardi",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6420238f67ef3cf5dac733a7b800cbccc27c335f649edba9730e22d4561a4a38",
      "text": "Ayahnya tersadar: anaknya tidak lagi riang.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "64c9f2f8352bc9a97d4eeee5a491ccf181fbbbadb8ee07b43c580a04271f6f2e",
      "text": "tersirat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "67374e6e2386b2619778323ecc92b960a032cb8475d6259746037f85c41f0305",
      "text": "Banyak orang Batak merantau, tetapi mereka tidak lupa kampungnya.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "67cd51e433ce44c48682835ae76a59868f60c1b2b7397ceafa3434beb4b8d954",
      "text": "Tangannya gemetar ketika membuka surat itu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "68356fa7bbcbad1a02a162eab42aa53a5e06fd3ef9a203f836787d55a9d5e417",
      "text": "tersadar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "689d3ba3a3616222205af80092278ff8e1b30df680b8f6b0e456cbf096e630f7",
      "text": "kekecewaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b588b7391da78d962c68227d939dfe08c1dd77e8377ccc841a3dd803118d9d4",
      "text": "Langit kelam membuatnya merinding.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bb74d56c751edc698d457a7e3ada60683d5a82ca5dbeef02dcc10ed12c0e057",
      "text": "Mohamed, saya baca ulasanmu tentang \"Kursi di Teras\". Bagus sekali!",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ca53157d94a322659e46615e9a847305d6b32394b7e094fb4b6c4bd8510e106",
      "text": "Mohamed, cerpen baru ini memakai \"aku\". Siapa pencerita sebenarnya?",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d5152c50391a16da43165930fa52824cd0e501ef4fb225e804366ed7ca52635",
      "text": "Ibunya tidak pernah berkata bahwa dia sedih. Tangannya saja yang gemetar.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d5d85a2007099e53f42fcba725e5c58e93fe1af535437adf0c096a8ef9657d6",
      "text": "terdiam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d5ee9c9050f9c3ccf8160fbd92885ebe83fb9a72dfb9be81c35076300ebdad5",
      "text": "diterbitkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ef984a2745b09f813e8f9d606c5a32af4db8a715e45ece957c29e477ee29333",
      "text": "Dia menoleh, lalu terpaku di depan pintu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "719162566cae329c0e3c7ffdb69d5e3199ab2cec2ebed624517b28040085a150",
      "text": "Ya. Cerpen ini selesai dengan kehangatan, bukan jawaban.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "735069ca1496994f0ce5b5ae6e3fabe4c3a1f4cff3fe680669d3218978503c1f",
      "text": "Dalam cerita mini saya, pencerita bergumam tentang masa kecilnya.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "735fdcde767f9a0eabff6ed25f8fe08e5ff1cff2a3c336fb633b3e707e7a2610",
      "text": "Ulasan Anda tentang cerpen itu sangat mengesankan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "75e13a7fb137938609f7d622c08827ec341c38482d6ffa0239c962a2f45d32c9",
      "text": "isyarat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7893a67089673f61e3741f9c34ddb56aeb3447f5db61ac8b87f3215453f51d07",
      "text": "Dalam keheningan, dia menoleh, lalu terpaku.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cc605968478a7be5b8253f7859497b96702b6767f07a9a055afb80ba0b17064",
      "text": "monolog batin",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "7df21384e95d00765c578d0b020c030fd8e68c02dea619e984db6be991f7bf49",
      "text": "digambarkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8124b6309009ace6565a0b36da15206e1639cfb4373c4f188141245e0552bd11",
      "text": "kilas balik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "83a07d0f43f50cdb02add2eb91d175dd876d4fccb454ad4d94a8d88fdd6d5c73",
      "text": "Mohamed, cerpen Bang Togar akan diterbitkan hari Minggu ini!",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "86a15257e122fe844c36ce8a2ea14adce9e3c6d7985f3a30aee6282d6cae17c1",
      "text": "menyahut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "87468c8a30f86e315ab4a94f4ec29ca0d044002d0b179b88f1af26d22d98dca7",
      "text": "menyindir",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "87b8a5e77597a3da6d8a44766d5943a33c4e463ccf66cffae9edccc114ced1ff",
      "text": "Pelukan anaknya memberi ___ yang sudah lama hilang.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "88cf43a30e8d4accbfb4fc98eb47b2bf5409b972f8e8ec8231c1bcc13087d632",
      "text": "Lalu ada bisikan dari dapur. Tokohnya menoleh...",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a917783446eded9979fb6befaf848471ee802854458a705f0664aae263ffa59",
      "text": "cerita mini",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ad697bae0cde2a81290f59ee1d6fd1b73284358c44be4a8c17573425c50e6b3",
      "text": "akhir terbuka",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e4fb15f94248929e00b49a2f39b2ad151865279be409ccce5de5aa72e1456ec",
      "text": "Rumah ini dibangun oleh Tjong A Fie, saudagar Hakka yang kaya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f0bf186806e28a2eb9d839294876dcaa63e5bc12e2028ac7022a3fe3569afa3",
      "text": "Alur dan tema cerpen itu sangat kuat.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fd36f25233344bfad690980b67832e5215d4bedbf95c84ec7e730a43747fa34",
      "text": "Pencerita orang ketiga tidak selalu tahu perasaan tokoh.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "900aeab77c0a62188b1947749f9f01ec771025b357cda453f035f98d5c1cd690",
      "text": "Cerpen ini pendek sekali, tapi aku hampir menangis.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "92286ced1673e7292873f4059e16a390668ae9e30611eeac526a7a5b98e53ef3",
      "text": "\"Pergi!\" bentak lelaki tua itu, lalu dia menutup pintu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "93420c090a2d78d31492a21d0aad9ff136e07859991bdbf444534ef96d1f4f87",
      "text": "Wah. Saya terdiam membaca akhirnya.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "9347f2f69d8578e5e55dff3a2b772f5120acae117b6c5dd5829067c1cbbedcc9",
      "text": "menyentuh",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "94174b437d2e3f6d1fe736634497a1d27deecb0017ae3ba8d05e48df518c7297",
      "text": "menafsirkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "95041c0f962a9acffc37ebeb2f56d6283c35425954b2be1b83b2d6d839f19aab",
      "text": "tema",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a116e85d478f1ef333191a1e5e5e9778cfe7f086671d5732380e4ae00f8b965",
      "text": "Dua-duanya bisa benar. Akhirnya kan terbuka.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aef2bbbb50c91b7cf98fab7ca6b52154a80ea195639665b46a9730e2605f496",
      "text": "Kalau dia berbisik, berarti dia tidak yakin. Dia hanya berharap.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b4e8ef6804c14720cf88a1fea88601fbf5346c14675547cd1fdb69e37278c21",
      "text": "Dalam monolog batinnya, Pak Lubis bertanya apakah anaknya akan pulang.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b6636a47fb71bd86f7d9fc470918f586ca1342e063ce817b5420950b18df893",
      "text": "lugu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bbf70608889872b4a62fdad89ade676c73f7f1a4654c9d52dd733d6394ba992",
      "text": "Lalu kalimat terakhir, \"Pak Lubis menuang teh ke dua cangkir.\"",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f9126614b3be09c44854e733cf8da880bd5c6c31e1128a286cae20361a66420",
      "text": "Dengar kalimat ini, Mohamed. \"Dia pasti pulang,\" bisik Pak Lubis.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1789ff91e228f36125cbc732dcacc451a5cb7029ae2cbd4fde7aad000544fed",
      "text": "Betul. Dia juga membantu membangun masjid dan kelenteng. Seperti cerpen, rumah ini punya makna tersirat.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b1fe5784dd57b0aab1ce3f8b66df12ed5c373b9c7b05c8cf35571e09268fb1",
      "text": "berkelana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a296859dd02a9e29e884e456f1328054ab674440445ee9d9b105a46649480fe7",
      "text": "merinding",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3a6d5466afcf41e99705773ec087fbc49eac66e22801403495ed4c087c70543",
      "text": "Lalu anaknya yang lugu bertanya, 'Ayah capek?' Dan ayahnya tersadar.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51acf377f30018e66226fdec3d1c26b00914e21d92f54c655405f2b246aad37",
      "text": "Itulah orang Batak: kepergian sudah biasa, tapi tetap berat.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a521098ae4c30f322b6c63d5d372b6bc17bf14dde7ebce1dfa0df4314e403148",
      "text": "pencerita",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a524f3fe477191f3931b264c014babbd52f473adb452e77e8c37be35393d3758",
      "text": "kepergian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a61b66668a7dfff6c5bdf0351969e63d0fa5a09a169a853dfcdb846241f32379",
      "text": "Silakan, Mohamed. Kuenya enak? Ini buatan nenek saya.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a684a2c7eda72633da74a3a0ea0f3a40f1432e6cdea263556b5fb5da4d4e70a8",
      "text": "Jadi kata kerja di luar tanda petik juga bercerita.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa172772c2a9ade175e1a59b31a3dd81cae4bf8c80f6b07fcc3276b97978b3ba",
      "text": "Dia menghela napas, penuh kerinduan.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac017730551c43d16c588c25a92e6dd04e483b3f12f16907b88648c98ef1c1d6",
      "text": "Anaknya berdiri lama di pagar, lalu Pak Lubis menuang teh ke dua cangkir.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "afab8abf1dfc9d62e3e1a896acd95cd80ede9f2c73c35fb1787c9c97954d4a97",
      "text": "masa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b56acaad3d7260ad8614304041d5fdafdf78c4dcccd309863e38f8f9d7bbdf9d",
      "text": "Ayahnya begadang setiap malam untuk mencari nafkah.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6b15ae9a56c0293a1d73e57351498365f4a3784bcebc0843ad8ade78293167e",
      "text": "Kalau begitu, telepon ibumu malam ini, Bang.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdf3d2d51467899000ebc2b36f310c9912848ab24d53ef02ae618b0d9487c8b1",
      "text": "Syukurlah. Saya ingin jujur, tetapi tidak menyakiti penulisnya.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0349168fde4b98798e93b97158bf270e8699146d9e053c34388aecbcb85c3ac",
      "text": "Seratus kata? Kalau begitu kalimat pembukanya harus kuat sekali.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "c22d5b47255d86fb244d84b63185a20c74b50e7b76f1a37df823301c0ff1d475",
      "text": "\"Jangan bangunkan Nenek,\" bisik Bang Togar.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4208b0502dfe8fb789402ecb351a29bdc23da98e2811ff84abeeb587811e88a",
      "text": "Pengarang muda itu mengirim cerpennya ke koran Minggu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c76edebd535c34f5ab0866bec70d623fb50548418920d2e3928d3d896907ca3e",
      "text": "Betul. Saya juga anak rantau. Ibu saya di Samosir masih menunggu.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca8b6a4f9f73619463af037ccdf7f5a4ef480c7bb6f4d4a8a19ebd55fa50ce69",
      "text": "gaya bahasa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc4599591a7b1d5094f2d3f16dec55a3760aee004674f1aed7edccd7b2acd63e",
      "text": "kalau dia menjawab terserah, jangan langsung pergi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc4d5b0fb9982c74e61e7fb8635ffd47e79435638916421bb5b2d86f33c18160",
      "text": "Setelah bekerja enam belas jam, dia letih sekali.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd268eba8a96a6a88f8231d733bce5766f6c89fcdc573b7a855a3700c4e20aad",
      "text": "Kursi itu sudah sepuluh tahun menunggu. \"Dia akan pulang,\" bisik Pak Lubis.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd3cecb51ebc9ce7e7c638018937d3286b20c59232a84757c6ddbb622e91f5a6",
      "text": "Menurutmu, kenapa anaknya berdiri lama di pagar?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce71948fd5dab9fd986bfeef04509bb47bfab79b9026441f7a83136637077aa7",
      "text": "Cerpen ini dibuka dengan langit kelam dan keheningan. Seram!",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "cec031367fc0cd957dc7e8a9d2902745fa5ecbc5a2c88d93a8bbfb0557a5d6f9",
      "text": "letih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1bb7f6d05e95bc83333b5eb1e1a972419b0ca59fd8da712a3865c6607cb638b",
      "text": "kekosongan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1c472619728e80e697dcf999c9c5e131395f6511fa9d92ceaa4a7294f2aafad",
      "text": "kehangatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d28074e047b63619639cf16ca1d9578bc7eef5924587e9834b1d8ec7a6135dc8",
      "text": "Mohamed, koran kampus mencari cerita mini. Maksimal seratus kata.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5c80adc0200777ba24e95d12a8326d04a87967d936cf317ba651c2b08d535c1",
      "text": "Amanatnya, Medan adalah rumah bagi semua orang.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7bf37ecdb0c702b7b34a1c003353f1d72050c5ea275fd382ec1f72b32188267",
      "text": "hampa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8256a2fe3344245881f43da1450f0f607ece6857e365f7d18a1d4302246e9e4",
      "text": "kumpulan cerpen",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "d955e63721d7d56aa27863d88c853678861e8ea5ab6df5633417c180932f15b3",
      "text": "Dia tidak menyahut ketika ibunya memanggil. Dia hanya berbisik kepada adiknya.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "da5f621f18a4bf73042326e1f8bcdbae3a58954676325b44ea6369ba2d67b214",
      "text": "...dan terpaku. Saya ikut merinding!",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "e122d0784fb4ca0ee142336213bf5cdefc9beb3190cd40fd5564d588a9284cbf",
      "text": "Dia berdiri di pagar. Ayahnya menuang teh ke dua cangkir.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2c2e7594693183e2d71ac11fd032b974a1c80d570a5be3dd5aae7d243c186df",
      "text": "Konflik cerita ini adalah antara ayah dan anak.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e367c7b842bbea64b2a3c3a09edf63d09a9f2152e717bd7fce10b2ab0fc88947",
      "text": "Setuju. Amanatnya tetap sama, keluarga selalu menunggu.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e577f21b134cf25f2fce4b598e48e30666e9526137135d27ec6b33fad78164af",
      "text": "Cerita mini ini hanya seratus kata, tetapi ada kilas balik dan akhir terbuka.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "e76b8d772017980fd3f12c67944fcdf0c1a22e8e04577eecdf3840cf9629029e",
      "text": "Tafsiranmu menarik, Bang. Tetapi bagi saya, hujan itu membersihkan, seperti awal yang baru.",
      "voice": "id_ardi",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "e79cfdfee9368e73944444fcfec68027e7fc62e32461bab0baca5dd37830cff0",
      "text": "Ayahnya pulang letih; dia menghela napas, lalu terdiam.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7e83a2e0e4edacfa3578d23ea38e9a44460d162e7efcc86064f995b9ece32a1",
      "text": "Cerpen itu diterbitkan di koran Minggu, lalu masuk kumpulan cerpen terbaik.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8a6a28721a8d6e26653079bf0da5b7f6cec4d15a22bfe32102be6494966ad13",
      "text": "Cerpen ini dimulai dengan kilas balik ke masa kecil Pak Lubis.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebbef1ec59d75e87ac6913f32fa50b12837a803ac4e70e5dd0ccd42d2f9b0c66",
      "text": "Anaknya berdiri lama di pagar. Lalu Pak Lubis menuang teh ke dua cangkir.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2f2cc73bd622db31bce6e7a7e0502cbf00650a42e8a992063776b41a3de2f71",
      "text": "Menurut saya, rindu. Penulisnya tidak menulis kata \"rindu\", tetapi kursi kosong itu isyaratnya.",
      "voice": "id_ardi",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3134b380496c4b45ba50f47418a65d955cafd5e6bb835f942cec52e51603c1d",
      "text": "Pak Lubis bergumam sendiri di teras, tetapi tidak ada yang mendengar.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f337334aa71c21233f206da39d020f3794ee7ab5adcc16b9b327dcc357269896",
      "text": "simbol",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3ffbc3d7987aaafee784f43f44588d3e785fcfbc024785c27440cb256f253da",
      "text": "Langit kelam, dan dari jauh terdengar bisikan angin.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f491f88beaf6656177efe7e2f8ddfe316c87a696fce5d9e4a5531914c184aadb",
      "text": "kalimat pembuka",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "f67da47aa0203f1eac5ff248126bf3aec978659522a3f99d3a639ed5a11fbfba",
      "text": "Saya menafsirkan hujan itu sebagai simbol kesedihan ayah.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6c13d8d92d75bac24ec8b4cacdcb4b2fd03af20dcbc8359a635396bcf18e2d2",
      "text": "merantau",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd9205d89b0e1693c203a41bf2b1b8ef50950daa81400c2fae3c29c1ed9c0bfd",
      "text": "riang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe2f5a6becb1a4a2c25de4edf8ff0d151e60088b81a452e148747ceab6a9767d",
      "text": "Anaknya berkelana sepuluh tahun. Kerinduannya terasa di setiap kalimat.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe3b4e3443e7a42fdffe7c5ad0f66c7c6ad16282f7657c6650ee8397ac171269",
      "text": "Dia tersadar bahwa anaknya sudah besar.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
