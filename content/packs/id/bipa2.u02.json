      "id": "bipa2.u02.l06",
      "sha256": "85f8f5b94696fc28f9cda5d0daa7a52571d985dc62cff694401ed80b11321911"
    },
    {
      "id": "bipa2.u02.l07",
      "sha256": "3a20ccdbc2539d75c2ee962629ce6c35cc811cddaedfe05a752d28819949f6d1"
    },
    {
      "id": "bipa2.u02.l08",
      "sha256": "51b1415d809e1844f87ca87510cd0f4722fa75611f4db8fca5a22ea536983b17"
    },
    {
      "id": "bipa2.u02.l09",
      "sha256": "8a7e950565379a82d39517e3d21c0a85f2952b3821854ca68ef2958d092b8678"
    },
    {
      "id": "bipa2.u02.l10",
      "sha256": "48b237732518e28404236437e3182d75f922763f09a4b75bd7309afef66711e6"
    }
  ],
  "audio": [
    {
      "key": "03c33ec8a5f4d19d083870102711ab95b86ace248f31923241d70ec6b5e9dd2e",
      "text": "Sepatu ini dari ___ di Bandung.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "04aacecb4d9b188987aa75faef7305da70857249b609f3c83e641d77be977bee",
      "text": "Kalau azan magrib, kita berbuka dengan kurma.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "054d411d955bc2243ada951d51675da67b2d894ef8a83a945d3f6d04cf463829",
      "text": "Oh ya? Kenal di mana?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "06048637d17d324dca8e91678a18bfa36e81880d52f568aadf6a55f2ac3e315c",
      "text": "Pengacara itu bekerja di pengadilan.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0658eaa2df776d1f4c9832d159f4d1f9b9dca70d0e80222accd6c040ec429a20",
      "text": "berbuka",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bb8b61955dc5da38ac1d5355f8cb91fba7999aedb2d00970c6fd4c04bdf5ca2",
      "text": "pekerja",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d7c3f60cf938b20e13ac10644c8028b03997c067e595193563edc4394e5eb81",
      "text": "Makasih banyak, Luh!",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dc9d8abdf7704726fcf8644c81ac6f51c04f6e16e3955fcc238d8f408fa053c",
      "text": "sebab",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0edb9fef748b2ef961fd769d27fcd52b39a6a4cd0d9170b8702b025122c5fef9",
      "text": "aktor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fe8789a3a27acab787f632a525c11aaecaf578686e4e4b64620708d445bb365",
      "text": "soalnya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "108a85e8171b4a6e0d7a088fe502e030228e43b68a6020a67cb9dc652123c4ca",
      "text": "Nggak bisa, soalnya sibuk.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "12aad0e2d4d3592005e9d67c8526b5f67922679b3a63f07d3fdbb8488fe17e31",
      "text": "penari",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "13a50a07a44a058db35d8ca649ebbf93490ad6d0d6c0b5a7d6331bc663434317",
      "text": "Montir itu periksa mesin mobil.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1442128cb7b196c22fd8c9448992bc5d7862db617ea5b342fd234ee8d63d5cfe",
      "text": "pengadilan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1780d96ba589ac05e3c68514763e16cf4824ec18987d6e718190f872ca7cae75",
      "text": "alat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1790b6f9c5a36d77cfd3ffc8a411d5d24d69b4285036b5132ed94d0ee1218b76",
      "text": "tukang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "17e2eeecdde8dacdcc34a88ac934f1cd0527e19b5c8f4e3b192610480759acef",
      "text": "Mohamed, ini temanku, Wayan. Dia pelukis.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b2b6bf7bb5439b09ac2ec78bf158537bff863673a902caab6f7bdc96bff2dc1",
      "text": "manajer",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c54437f713d7bcc3e50f3f8b93fb050db80c45ef536f11347938d9b6f027f2c",
      "text": "pedagang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c83e3022c3592c8ea32c9a4dddad9e7fb94a5a50359f74452e242d765991a2c",
      "text": "Hakim di pengadilan itu adil.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2186cee03b67a30f054dd3f8a69f34e2033ff8527668afea4f3bf0bae38f2a06",
      "text": "Pertama aku baca email, terus rapat dengan rekan kerja.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "24772ee4cb1f982a9e5ae0cbb08ced958c08170ebe20d10ae2008933057d169f",
      "text": "penyanyi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "267857d4c331509e076e502e34f759635a5f57a22445239ba44d805172c36376",
      "text": "Penari itu cantik sekali.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "268413ce6fd56c4f091f221a1c4e324365642589535b3548d8459af084ed5241",
      "text": "Montir bekerja dengan mesin dan ___.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2867a31ee2a1bd4ebb7c2e674dc16bba012f5b061407f9048d10bb95fee9824c",
      "text": "Mesinnya panas banget.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a62f9a86a54f2928559f82fdc5e023c8e5c1e40a90939459ab52afa43821fe",
      "text": "Kamu pulang jam berapa?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "29bcc4106d3128bc260b84ffe9476167f3321e6a77f3fde3076bc51a168d1b01",
      "text": "kenapa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "29f91b2ed855017b0c7c4c0f526a3e9abe2ae41bb90636518317c839b1c73b91",
      "text": "Film ini di pengadilan. Ada kasus besar.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ae6106941a7e171427df5e89012beb0b2bc2ea7de8d02c406c2ed6c728c6f1c",
      "text": "Ni Luh, kamu bekerja di mana?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b5ecf4f158f7912b42ddf90b0a9ec68da105aacd1161fbc1f0a5be87dd524ba",
      "text": "bertemu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c4a1c2e9a688e05e1741d0778a335dc59cbcaf37e95a48d78178ee03db25d5e",
      "text": "Jam sepuluh ada rapat.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e1cbd45f81ee130713d66289b4c7fa4932618103e510a27ad2006fb0f7be9f6",
      "text": "Wah! Lukisannya bagus?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ea46a615b2f92b287037e451c92dd388c652b23ff1a74065ec10d4750bc0a00",
      "text": "sekretaris",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eca4817d9fc22993b73ad10f7afb25ac50b6e31e45f92c0a0e1a9ef486c3151",
      "text": "Pagi banget! Setelah itu?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "320b87e762d8021e9617fcea2f7bd74d177b6b3b785768eadca47d0269bc5251",
      "text": "Saya periksa alat-alat di gudang.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "327c68e5e99a1f534e0f4ac7826f642d5d85d0572d49a37aaba73db913caa9a0",
      "text": "Nanti aku beliin takjil, ya. Kurma dan gorengan?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "32880e679ce8ee682a76f5059db37ecfcdfc8eb34c7bebf161f06f8726bf650c",
      "text": "istirahat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "35165b4b8509751e1070cfcc05dfd0b3422cb4cb80cda74cf7dc9c547640ca0a",
      "text": "pelukis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "364500ad2286533902f5cedd56e679a39ce03a8fd5be142c3abf8938e73df9db",
      "text": "lukisan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "37b7d05ee2f5da2ff9b72af1e7224625fe65c4c0c9087dad12084881173e5b9d",
      "text": "penjual",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "38d71d07045efb1ffe3562a84247be78d8a8439cb90e09739baf56205a192286",
      "text": "penerjemah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "398ff92f34cc59508a94f024645f56f992f432974be5e30081545d89a2b4349e",
      "text": "mengapa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d5c56ad99c29ac1df623e77db618227a78bc8137b557b8d411dcda106ed556a",
      "text": "Wah, kuat banget! Kamu buka puasa jam berapa?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ee7b08d4ee337b8bde5d8ba10dcb7bbe074c25250543227124b8df843a69e70",
      "text": "takjil",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4039d9f46c003d9a3bd16d5917862f0e978fae4f646d523f0c971c4134bfa65f",
      "text": "Kenapa? Sebab saya suka bahasa Indonesia.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "40cddd8dfea741285ad14cd0a17555dc32c5f60dad34cec19d49cf0ca9112683",
      "text": "Selamat pagi. Silakan duduk. Saya manajer di perusahaan ini.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "40ce800bd488644ba653b43316df33fde7468ff57412b57a68f43fc25eae249d",
      "text": "Kamu bekerja setiap hari?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "40eaea03c6ef8f8cbefb71cd13476c43806f25763a3c66e03119a7858ab230f8",
      "text": "kasus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "42fcbd1d651925f299c27546c85f51df55479bca0dd9842e87613abbdd5fd401",
      "text": "Banyak pengunjung datang ke Ubud.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "43dd00ba5536f06cb9961b42cc7d1106b0f8751ad9f8a8d6934bedd270218911",
      "text": "Pekerja pabrik itu sering lembur.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "44537b2278946fdbdfb0952ca468f6a388a792cdf399a3941fbc8bd4956d9445",
      "text": "Siapa pria itu? Dia tentara?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "486a70634d82aae86702bbb1d738b3c401a729ef8f8568d2029f60fb29418d37",
      "text": "Dan kamu, Raka? Apa pekerjaanmu?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b3ec3e5f76447c0263724b24f5edcea9ebfb18182cd1448e753efbc3247070b",
      "text": "Dia bermain di film. Dia ___.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fd83bd4d8149152621f006380b4cbf3ae72fdc57d81c5237b5e5933871bb1a7",
      "text": "Kenapa kamu memilih pekerjaan ini?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "50d40ea66ea8d1f3225d0d68178f887f8502127cd0869c4f2ee7da7fdb56f3e3",
      "text": "puasa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "517ed4ab36a04c8f50c48ab48650686174813c28c8fad68dc354af89980ece35",
      "text": "kurma",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "522d324ce9c889695fdf83be221460ac2453dd5c0d57b60f84cf1cce7dd0dcf9",
      "text": "Karena banyak temanku orang Indonesia.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "52ba5b86e0a6b64dbb2c5391f6b2d82713c7ed5e3c7747a0f54019a05a4b9601",
      "text": "Bisa, Bu. Tapi hari Jumat siang saya tidak bisa, karena saya salat Jumat.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "54565372bc7ddb414f031c832855ed7a170a6ccbee99d76ebc82af027cbf6246",
      "text": "masuk kerja",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "546dc27b54c8582fed9e5fcc37d21ca0e180ede8cfc258d76a02ae03a9f2a327",
      "text": "Ayah saya petani, dan ibu saya pedagang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "54a5b201ae13a33bb3c39c33c8a8971ed411b6a683861e51570dda924d36b48f",
      "text": "turis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "565e5a5b0a6ea9469ec820aefa3574cf6b0ae2d2fa05ce5264c98046b45ff72f",
      "text": "tentara",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5664ef63ea6e7e9c7db56cf6b6518074b489021493a149f5abd49408e3476d2c",
      "text": "Bisa. Alat saya ada di gudang.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "56e377e0dc81df3791347a1b95ca01e67d1ba97bb7d8fc59bcc71602d2a41d28",
      "text": "pengacara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "582cfa6eb31ac70a0b05ad8b2faf471a34667895e2066a469e03eb3a86200d13",
      "text": "Pelukis itu tinggal di Ubud.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a03da37f40ec38a77356cb3aae487cfdbf8eae7154a5541c1f7b690df0d3f66",
      "text": "Ada kasus besar di pengadilan hari ini.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b856f23e93bdfd9260d7ba107771b9f6fc16688d737a60950a7bad3fc8103be",
      "text": "Saya pemandu wisata untuk pengunjung dari Mesir.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5be9a480bdeb9749468a714bd21ce4436cc54ac1f13f99dc104493f4d90e5d26",
      "text": "mesin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cb83dc67f98fb0144183da2cf3e742b1cf4f38e2c97491c3a7b9ea60ff1dd6e",
      "text": "wawancara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df27802aee42443feb5959ac91a80c90f03facbd24bf59e950e2eb5b6b142c8",
      "text": "Kami perlu asisten yang bisa bahasa Arab.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fb85db728b4a158955d2c51e6cd35f9e035245d2921e9b11fd775fee89a0b5b",
      "text": "Aktor itu jadi pengacara di film baru.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "600613849a861624a6487457b32493523ec9b6ca9b39c75106d1323d46d1605d",
      "text": "petani",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "606dc7c11c8bd84c58835b0bd16d497e79bd7e2948476f92e10ea68ac0580571",
      "text": "Sesudah rapat, kami istirahat.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6081934eb0c8dab998345df114dce5ec9d4f47ec14e49f2da2043ac2eb10e699",
      "text": "Bagus banget. Istrinya penari terkenal.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "646f1dbe6f33d47a17f673b3049038e741f8ba8ba379ed36f690c92db66c6772",
      "text": "pembaca",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "64c80f8742768a06ec92368e104068b15205dc06aa5d6715973f823cced3f0ea",
      "text": "perusahaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "650a1df43a59402af126d9723ebc3b2c3ffa779ada56c03bcef262c1a412dd02",
      "text": "karena",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a6ec42aa47baac510b807f3e186a91b17823507a3ec4b99fd9a15057c3ab4a4",
      "text": "pemandu wisata",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b5454439fe4b6796f1b332312e35788d74ebbb85965959083bd401ca6a158aa",
      "text": "Lukisan pelukis itu indah sekali.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b6a0fd1bc7f020d9c2fa6a5786ceba09564cd506f912a5ec1f565bba67e7d1b",
      "text": "Ibu Wayan pedagang di Pasar Badung.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c18537586f8357416ed92b2c7931dec998fece5a2fc90b6b93072344f2616ca",
      "text": "Saya masuk kerja jam delapan pagi.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d5466c864bdf71cc53577e5054ff9541a63234a849ccc64ab128af4de5a19e5",
      "text": "Saya belajar bahasa Indonesia karena saya suka Bali.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d9e6340a53a71001d2810cbe139d2e8096b947c3bc9619cadf5365bcd570fc7",
      "text": "Mohamed, kenapa kamu belajar bahasa Indonesia?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e62de738d71faaeeace505b3b8ef5a1cf428e80e9599c4515049425867674ed",
      "text": "Mengapa Anda mau bekerja di sini?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e649a5266f5f9684fbb999abca4fe3665a8fe8b04f642d51630ccfdf6ccdf51",
      "text": "Wah, kamu pelukis dan penjual!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "702cbc42488912fdcbf049a8eb6381d8e80fd08b58f7f0deac5176671866c460",
      "text": "gudang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7060ba64c29342ec2ceab0a632b4f381595d37db998fe0aec0befbe79ea0ec92",
      "text": "Saya masuk kerja jam delapan. Jam dua belas saya dan rekan kerja saya istirahat.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "71455b69d099935626b926a54e83d562fc7f248481347db24300b802ff51f5b0",
      "text": "Setelah rapat, saya istirahat makan siang.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "72d37f2ff3eb5c9105f0dbf189aaa6090ddcc6545853248bba65b3c65112b415",
      "text": "Kakek sudah pensiun. Sekarang dia berkebun.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "73dc6062cbf8f6ba1403506683798d33f4cb6e4557cbf895020dccef8e1892c8",
      "text": "Sudah azan magrib. Kita berbuka sekarang!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7698a1a196b1b3e4dd2344c811d62ee651222e5e292a127d299cdd109a069e05",
      "text": "Bagus. Nanti sekretaris saya mengirim email.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a422f4df940701cdd9ef0a2cc12e8154f410d568ad64655e15128727bc7857c",
      "text": "Ayah saya kerja di perusahaan besar.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b3c3272db9dcca60d5803f950c7d2e0a8693b873b6bfca80c495315d49062f2",
      "text": "Kami makan sahur jam empat pagi.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "8065b1cfa11e0fa6b7c03d19a19ee9748c08bf5f523bad0e88ece59f8d937859",
      "text": "Saya puasa, tapi teman saya makan gorengan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "81230d6c88a307d387b777a33885eafefc4115a961a3858e7cbee2cfba5735e4",
      "text": "Saya suka lukisan itu. Pelukisnya teman saya.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "81927cd93fc6028e496693cd64664022258ff89bcd3111114deff52a3973bd4f",
      "text": "Kami perlu pemandu untuk turis dari Timur Tengah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "81aebde10fe544d9eebdac1343ad3604ee7141ecc67492446f44ca4a3e948960",
      "text": "Di hotel di Denpasar. Aku masuk kerja jam tujuh pagi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "83c79fe9207b6567c34ae7a1e14603b1a9bcc1180954403bde999200fe80f5bc",
      "text": "karier",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "849a887584a4ebc91e6d9865b124c0d08c58ea06918a23aa2d22ea1771f5fa8b",
      "text": "Bisa hari ini, Pak?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "870032d11ba12892ad0610ebb50d4e0b19f025506ebaf44c69f84b849faa4bcc",
      "text": "Rina, film apa ini?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "89cffd7ab38ab0e94e81e41f3f2e9c93b91555ebd6fcfbf828b932542c1dcbe7",
      "text": "Ya. Pagi aku melukis, sore aku di pasar dengan lukisanku.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a08df6d0f9415f438378709c1edb70492f09bec6662bf75600c7a92adb58896",
      "text": "periksa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ae3d08c6a70496c085082c6b65108f61fbdd6e76298628a04573d3162573b3d",
      "text": "Selamat pagi, Bu. Saya Mohamed, penerjemah.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b7e9cac12476db1bac701d9a9725fc88a81d28997a67c8fae2de9ea31d4912b",
      "text": "hakim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bda65ae089097beac61451fe49dd22f4d27e9a8f009c72938827397fa9491eb",
      "text": "Karena ayahku juga pelukis. Aku belajar dari dia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c3e1f7113c5b3ec8cb2a8ac34f6e30731bd47852412ad28a7cfb6df4ed38f44",
      "text": "Saya ingin karier yang bagus.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d133b847a1882ac93925aeee2ee24ba3eb4c8ac3556a01cdf41a4f199964e50",
      "text": "Banyak turis dan pengunjung di pasar.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8de2e274844df2fe532cfcdae614dfc37b02c592fda2961fa2beba38fee15b27",
      "text": "pengunjung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e051dc9bb09f538fd850d2253f338e99a98c4f3678aab1b95bb8619ec661b0c",
      "text": "lelah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f263a5d7ac48883c00e1cd9462e1986d8c17af6c4189ea79fd21145f43ed86b",
      "text": "arsitek",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9062a274782b1044ea575f755120abff4d08165dc219e758cb16678e884c427d",
      "text": "Saya memilih pekerjaan ini karena saya suka bahasa.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "93aaca1ed12ba4ca9f0174aae99d9697a35ce3afb1a7a88e7834ff644e6bbd7c",
      "text": "Apa pekerjaan Anda? — Saya pemandu wisata.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "94bad12f69a5a551eb8ab8069431350fe9ca73afb3aa15afba7a162492be1703",
      "text": "Saya periksa, ya.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "98297fa97e7d39a87be7bb9ae426c14b2031a5abced5c6685bf7bf7e3f2fc240",
      "text": "Hakimnya adil. Dan aktor itu terkenal banget!",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9923f019f7359ab901b57f574f464a98ede4d291f12979ac96d4f9a72aa179b9",
      "text": "Ya. Dia nggak bohong! Pengacaranya pintar.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "99e758dd0d0b46b55909fae34f7ae7dcb22f30eb7b2c7486ddac6b3ca3a47f42",
      "text": "Kenapa kamu terlambat?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "99fe71ccc97955760c0c2c94dde3f11617beba202c6500be134985db9945b27e",
      "text": "Ayah saya petani.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d4ed96ebb2726fafe5b12d93782c32bc70ab7741c3e9c29c63965f9ac7db7e1",
      "text": "Kakak saya penari, dan adik saya pelukis.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9faa9ce74957b437980b229a4cd40cb09bd2e1361de787b1233d6f28c9432c79",
      "text": "Mengapa Anda memilih pekerjaan ini?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0c0d5ec28fc9917b3c87b29d818efcf76028583a7c4f4d410a217fad21a0c0a",
      "text": "Arsitek itu orang Bali.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0d56dbf3b4e3873896273fced5d97d298446fd89c858571da3c05d48700583b",
      "text": "Timur Tengah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1525260dde28347c757a8ca21815fd0191e59e90380ea53acdffa8ecc2ec03c",
      "text": "biro perjalanan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "a22e238b9d8a4e318ec0a4a8c8a7ded04caa7874730b6a5f32a05dcb60a32b75",
      "text": "pulang kerja",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a309beb53a437f0aadc1ed7fe29456c9dba6b8ba8625523e4fae6cfc71b11c2f",
      "text": "Pas azan magrib, kira-kira jam enam.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3659c58cfcd9354f7f317eb3842e2c447335b598cc031b831caacea3bb9a82f",
      "text": "Ada rapat jam sembilan dengan manajer.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a39f210a96f5c840b955390cddb76985ca9241cf1a84088118e6636d6521f516",
      "text": "Di Kairo saya penerjemah. Sekarang saya belajar bahasa Indonesia di Bali.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "a634d04456a8896ee1e4ec39c7ad8e0c4e5d7f412eb840bd5f92c20ab90a69cc",
      "text": "Di Kairo. Mereka mahasiswa Al-Azhar.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a79f4f52cdc91cb4d6630a615b821ff4b24ac03392b999fd28eb9b383f4993ca",
      "text": "Kamu kenapa? Capek?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a80afd80758d2168036427af89b0863c0381d029a3020b1305c23e9a9ec866f1",
      "text": "sahur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a80f16be8883ade08ff45b30657a6af7f782fd58a5da1f08943d567a1fea98ad",
      "text": "azan",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a93477fe6c244a08abd2cd894fa5b9163455ff962c36cc2c5025b2ce66e6629b",
      "text": "pensiun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1e23f44bb5f980de8b15fe16baf4f670f82b67a09d561d428ff065f9496b77",
      "text": "Mohamed, kamu nggak makan siang?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae01a3c12b13114bff5fe69786517071990cc7032c3e4231d224159685b5c14c",
      "text": "adil",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "aea646359d723236ba1e3fa9fa51e9e6579c02336b67011cd7143f8422526d5b",
      "text": "Mengapa Anda mau menjadi pemandu wisata?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "af67b3cb37b1486de104cbb9a9f9f96983a05def3eb1f4e9e7a78e5c2d65e486",
      "text": "Terima kasih, Bu. Ini awal karier yang bagus!",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2537bc0cf1156c8fedf84a25fd54e2fcaeab06ffe51d57e180a0fb5b4e8ec01",
      "text": "gorengan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2e5152fbd863574a01c4210c73fabc2c7ee231eab4566c7216fcd4c1eff91bf",
      "text": "Mas Rizal pemandu wisata di Ubud.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5e17f024016d2476d86980e3719ba9254f877c3aca22d80db365da8f617136e",
      "text": "insinyur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b66a09a42c83f57cd389124daebabff4fec828e4bcdcdecd089ae209b0c72a72",
      "text": "bohong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7854a1499179ad5cb0094f392f9424a8d0c7b122f9af43031f232cb168fd14f",
      "text": "Aku pemandu wisata. Banyak pengunjung dari Mesir juga!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7ca6468d35337ccbffa8082212c1346bf4dbc93f6246ae680f69a5f7b17cb36",
      "text": "Kenapa? Soalnya saya capek.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8ab1dd6f58f0cf7d02f4bf9dedc0f15581814c408d15d8cb518a74b0459992d",
      "text": "Biasanya jam empat. Tapi hari ini aku lembur, jadi aku lelah banget.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9ec90fe07bbb13bde5caab4c2a2d9ed901f828b82d542448c6b8b2444da54d2",
      "text": "Rina, siapa penulis buku ini?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba37912c4029744785ee78f7ed336b865b8d122e7b2b41d221e511adaf4cefd3",
      "text": "Apa pekerjaan Anda sekarang?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba47b001392ec1c4fbc5b17a24cff76deea2572b8d9625fcc96716501ed62f99",
      "text": "Karena hujan, kami di rumah saja.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "baa6ce6b850ede8a0bba810b430a4ae8dbeacd991f275fc475e1d39f82325409",
      "text": "Bagus! Kami perlu pemandu untuk turis dari Timur Tengah. Apakah Anda bisa bekerja hari Sabtu?",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "bca51ac5f2158ecc0b116e8d58b5332c9cf91557051194fad91c200741781dbd",
      "text": "Kakak saya insinyur mesin.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "beb3062e7e8777d1abe9310ec5f60614aedcf5b0e8fb3b77d39e0f03b4a336ae",
      "text": "Ayah Raka tukang kayu.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf14bf4a82e40a25b31350414f85189fa3a41095c38898e8b820034f102730c1",
      "text": "Saya puasa, tapi saya tetap kerja.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3c54aad3f057fe9ac78a4514ca188bf1014c4a894d66d9598b359ec92c7f2d5",
      "text": "Penulis buku ini orang Bali.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3f42f77e76616194b1ed23e69a888dc590e06058194afd76335be62ce55de5d",
      "text": "Saya mau menjadi pemandu wisata karena saya suka bertemu orang baru.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "c682ab5d37649a7177d2cc5c6459de7aeadf4ce71a1ed73fd13a30c085ad9783",
      "text": "Karena saya suka bertemu orang baru, dan saya bisa berbahasa Arab dan Inggris.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "c81ad9b6ac4233c4e029e32cead8ae7f413d2129886913626ff9ee7846d89c20",
      "text": "Mobil saya tidak bisa jalan. Saya perlu montir.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9c8a84a8821489c1b0bc72a1290bf304522830b1fcf971ba25f364d5a69956c",
      "text": "Tentara itu tidak bohong.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbb7b863ae70afa4d00ba62366fb8ef5909b01f0a6ae2568f063b562a3339969",
      "text": "Wawancara ini untuk penerjemah dari Timur Tengah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd1a63ae4c3abfffac09f2ce06a27f099c340ba352ad2977c8c95330a980a3f8",
      "text": "Hari ini saya sibuk sekali.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd2bb75e45fd6aac3d60bd0bcefae5f065e008dd0007acb8651858dc2500a9e6",
      "text": "rapat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd9aafeb71ad76801a68da9f82e03d7141cf4c56e49dbf5f162850bc8db0c4bf",
      "text": "Saya bisa bahasa Arab dan Inggris.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdcb8df7c328be2cb5928df96ab23e8a3479b8fd17cdf11f702acb68fa4edd68",
      "text": "montir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf0c2f404f7ec01eb6d3d145feefce845706ceab2525f2e8c6537c14dfc06b8e",
      "text": "Ya, sedikit. Soalnya aku jalan kaki dari pasar.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14d7fcc1dc81595d481e81cbaad3890d9ea96c258d5044be96ea3c83b7f8601",
      "text": "Kurma, gorengan, kolak... semua ini ___.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d160a6ad1f54adfd5480f5227e76c05c5faa9291282dd2a71690c47e5aabf20f",
      "text": "asisten",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1c5d256c601416f256599c031e9832705211f8ce97501f49da1689c2282a948",
      "text": "Selamat berbuka puasa!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1fd13594bd88d38ff9c0de700fc83c8fbdc71403033f3c0f73b27d24079db69",
      "text": "lembur",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20382e3a4a8381ac37115cee41c78ed72af37f1a86c188c07229db0fd5da558",
      "text": "menjadi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d60e8c88b5afdf777fed67243182b38654ee1c8658af797524f6e14e3eb64ee2",
      "text": "magrib",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6d2e6fa1e70803afdef1c3397ab63aaa4bbeb02ba536c7918dbdd0c70b57b84",
      "text": "Terima kasih, Pak. Saya datang lagi jam lima.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8f8bb450dc98e0447fe3f7db60f7f98c4c0f7d379e5d32085685a9809cecde8",
      "text": "Saya mau menjadi pemandu wisata.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc028f9a076b297ade06bf7ed57bffb7afa8ae497bc9faa7de2769ca895221a2",
      "text": "Wah, pelukis! Aku suka lukisan Bali.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "deccd3b4ae513d89f2b41bbdefe89f267fff970531af0c5634d87d9b59599836",
      "text": "memilih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9e55401992ad92a6cc8f7881806eb20a4a72d4abc70ab22f866a9ff7504fd0e",
      "text": "rekan kerja",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed5787abd9438c4d5e4de7358219c168d8a47bd28e5d5b52f9984bb0557f5b00",
      "text": "Ni Luh bekerja di hotel di Denpasar.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee0f83aa55aaa6af10ce680b30329169a9c72e95a53c495b305aafa0b23ae8c5",
      "text": "Wayan, kenapa kamu memilih menjadi pelukis?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0107473781611ca97f54664db1e853505e748d3397c0a2db9cd19ba3955cb5a",
      "text": "Kantor saya dekat pasar.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "f01e2671caa42f4d70423ac229d8c157e65d29954fcbe6c0397c3a426a0deab5",
      "text": "Aktor itu terkenal. Di film ini dia jadi tentara.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0533573e2bce60835b2de46bd30e7fd3ec224a8a9bf11b6928cfb2341bec96d",
      "text": "Penulis itu bekerja di rumah.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f09b0e85a16d9faa49cc8ffcaca4f81c486dcaba7d9e12cc8024436ffc03d650",
      "text": "Mengapa Anda memilih Bali? — Sebab saya suka pantainya.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "f44e560759b6784f9836ce635bb205dec74109c9b9b5a69a6e931d5fcce56e81",
      "text": "Makasih. Ibuku pedagang di pasar ini.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4ff474d50b679b56c28d7639ef6add7a1e734a36dd93153442d182f0a792945",
      "text": "pabrik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f54e4fdcf2fd255b40701942a300d25794511e782cc99a7fb8010aecae0ffa09",
      "text": "Dan hakimnya?",
      "voice": "id_ardi",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6d60d1e0a3099aca5e67dd5d23a11a3fed1cb6fd5ed9fe11a80855a5cd22eb5",
      "text": "Dia asisten manajer. Kariernya bagus.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f70c46ac33e4ec88befa0939e5d4be02d18895d884abb0ea5593d4609011b6f2",
      "text": "penulis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7d33f8f8cabb6898c6f7ec001a2068f1c3b1eb9d42b425d0d92b7553c3a76df",
      "text": "Kamu kenapa? Sakit?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbebb30014555e34c8c93dcaecfacdc69ec41684382f80739f4f95ef5dfe592d",
      "text": "Pak, motor saya nggak bisa jalan.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc29fcfb02a6f50088b57894e9fb47cf846d802841e5ff70c16e6351b5b67943",
      "text": "Nggak, Luh. Aku puasa. Tadi aku makan sahur jam empat.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "fccee82db9de6b5846b08e8687f2bc2494d4df0ad82278e49693c1d7fba0a04b",
      "text": "Ibu Wayan pedagang di pasar.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe2a5d002015d312d1dcc149fcdc9e4f6f20aa7161c224f088cd5f70d09cfd2b",
      "text": "Penulisnya orang Bali. Dia juga pelukis.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
