      "sha256": "393b770f39ddb27a2ef4bb5007798ae701a2cd5b67cbd51921a58a39142e3977"
    },
    {
      "id": "bipa6.u02.l03",
      "sha256": "b6e8e1e51809790045e110a05bee4c28d06780a6bd413c1a863ac0e58d59da2d"
    },
    {
      "id": "bipa6.u02.l04",
      "sha256": "30781084cb3cfc33a8295e4938e69e8a4b8e12bc8e301dbff32cd0d84d4799eb"
    },
    {
      "id": "bipa6.u02.l05",
      "sha256": "d0ea1f39a829935361d1aff90b0ff9b81625d842aaf24af7f032c3778ae7afdb"
    },
    {
      "id": "bipa6.u02.l06",
      "sha256": "5e12d9ef334cc101a087ef2d15ceda9c3c71dacd53a5ec835ea77e78492382f6"
    },
    {
      "id": "bipa6.u02.l07",
      "sha256": "b6ae19eb182d97a8053855e47fb59a184197de0f6eaa28cf4bd646de5dcf63e4"
    },
    {
      "id": "bipa6.u02.l08",
      "sha256": "ef6ad119948424b6492f5c7e09ad0e3d18a41aa17eab55c165de862bd2a3de04"
    },
    {
      "id": "bipa6.u02.l09",
      "sha256": "811de3f5dc7d77db6c979ec077433d4ea0a67ed2f202fc4dbb6f5166480bc03f"
    },
    {
      "id": "bipa6.u02.l10",
      "sha256": "c53b8d24b2a8c06aaa9fe8c34fb0d25d008725bc1295a98202f9abe25ca6c52c"
    },
    {
      "id": "bipa6.u02.l11",
      "sha256": "e0ee65278433d1b096eea066c5dae357af30715291ad49ffe5b01e6746f14d7e"
    },
    {
      "id": "bipa6.u02.l12",
      "sha256": "43bd9ddc4e42b95192baecaf5ea306c3da870584893939c6dae0e3f85fb39ec0"
    }
  ],
  "audio": [
    {
      "key": "01ffbd89e2ca3cc9093c104e3e129307dc199e95552733e84a8e1b9a62d2f2e1",
      "text": "Malam itu kota terasa sunyi, seperti hati sang penyair.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "032ff539a9ef530646cdb3d00311c4cceeccedbb02e0f8d6e7c5df2dcf0d03ff",
      "text": "Betul. Di akhir sajak dia menulis, \"Aku mau hidup seribu tahun lagi.\"",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "034d887c47e569713657893e3632f7c51a8994cc85030a7e4aaea7ea1cfb4e02",
      "text": "sepatah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "039bb8719e1b681f4f8e1a1ae4771769202c87c83df42d04139198505ee5b778",
      "text": "Dia meninggal muda, tetapi sajaknya masih hidup sampai sekarang.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "0576cdb97c7422fc343fbfe0c1467a6d3c554b0dbf6f12817c376f0e71de7af6",
      "text": "Mari kita berbalas pantun di depan pintu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "08509b84a66c9b87e466a96322a11c1220497d09b9829a3a37576fa10431d910",
      "text": "Dengar! Juara ketiga... Mohamed dari Mesir!",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a3839b72b04b5fdb1987e95844039fc4f78a47261f34e0f26ddb6477129fc4e",
      "text": "angkatan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c1e4d79ade69ea4340e0dd5613cdb62e28eda12c32dd696bdc740051b7caae3",
      "text": "Dari Kairo naik pesawat, singgah sebentar di kota Medan. Kami datang membawa hormat, mohon pintu dibuka, Puan.",
      "voice": "id_ardi",
      "chars": 110,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c9ae1d93e2dcfe2b190e4485c62df0a4eba9761351ff4bd90a1982443f134f8",
      "text": "berkilau",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d56205d717ebc26699d162d3da80b86b8ea788949db26955db140d9ecfbde43",
      "text": "Kami berbalas pantun sampai pintu rumah dibuka.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f827b7ed567b1d1970874589c3d8f022ec2fd2d0838101c602ae5dd6954aec9",
      "text": "Angkatan muda membaca sajak Chairil dengan penuh semangat.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "120cff8bf34d90d27bd707c3543cab94bf84ee9396463c6aaadbfde3842dc49a",
      "text": "Mawar itu punya lima ___ merah.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "121e6531f8c747855db93e3f2bfc3f09021f642aa9ca5e08b78ac87935821fb8",
      "text": "Isi pantun itu adalah nasihat untuk anak muda.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "124e753d784ea7e1c426e6d928b9f1fcd19ca2db5f234588ccde9a8e8636797d",
      "text": "Deklamasi puisi Chairil Anwar membutuhkan penjiwaan yang kuat.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "12dd0a7ff55fd461ae2c45a0c1709f721ac9043ad6d17ddf26219fe12fd4780a",
      "text": "semangat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "15f2efbd716403cbb72e3fa687614bf3ac7b3cb768ddab0f2bf73f684b787339",
      "text": "Petuah gurindam ini sederhana, tetapi saya membacanya dengan penuh penjiwaan.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "16275a592f497864033dbc406c5435620a8e809aabb853d8e100b661d9b67ebf",
      "text": "Encik, boleh saya mengucapkan sepatah kata dulu?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "162a89d5cc6bedcfa72a005bf3c40ea76be8e30c05c6c8c5f90a30ed892c8b61",
      "text": "eufemisme",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "165be2a0864007e12799368da474a8846609ce2a6e12aae53c570a455daa50fd",
      "text": "Dunia ini fana; hanya Tuhan yang abadi.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "176678b406c7a220b07bacab95c6e9121ee67445bca48f88162f776296e837a3",
      "text": "jenaka",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c82f9efa936b7339ce4e2e0bc04fc12b63a5d240e59893dea01e2f3bc683bb",
      "text": "Walau jauh di Pekanbaru, hati saya tetap di Kairo.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "18cbed8bbec5f255b9ba8d5f9bd7b7d7a2a1e3c9dd22a3123ca1eb4fc665c4bd",
      "text": "Terima kasih. Malam ini ibarat mimpi: jangkrik, lentera, dan puisi.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "19fbfeac01004d6c344b4bfcfe993ba372b93144cbebd600854f16aee1021fdc",
      "text": "berima",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b4fec630b8300594e2d3161a90ac1de1f9935f342c71ca1d3e10348f1f090f6",
      "text": "juri",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cf0f6c189abe3b91c5f159f05e595bf47b2c17bad161b0d820bad2939216377",
      "text": "sunyi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e07a5751af43ec3800c50c5fbf7fa5b80e4f377f9ceb2bcf031fa1fe1235fe9",
      "text": "Bacalah dengan lantang dan hayati setiap kata.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "202946b8d7e4fec1fb465a07fb3171c3b9ceae4bb721236afd0c68292b789dc9",
      "text": "Dan bunga yang layu itu tentang umur, ya?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "211875ebd65d4aa34f6cb0fd053ffbb079fc941334fec6eb80d775cfb1721380",
      "text": "Bagus! Kamu sudah berbicara seperti penyair.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2334c3ebe84ad23e5347e043a9421912ee853edb1302cf8daff046ab5e6c256d",
      "text": "Bunga di meja itu sudah layu karena lupa disiram.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "235331309a3fe1bdc33ebd54e9588442373df9ebb01d4607c9e17b92379cd616",
      "text": "puisi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "23ba48b8023a9d3533bafc9fdb992a25bc69c09028a3df365b53d929e7b6d0ea",
      "text": "menghayati",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ef4ab580d6e8e0fcc349fec38dbca2fb8483a408bae79399e5cd8ddfe84cd96",
      "text": "Juara lomba itu menghayati setiap larik dengan sungguh-sungguh.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f9164528a7ff964b76652fc4225caecae885d0ca37344eb4dcf243c17b29e86",
      "text": "Rimanya agak bebas, tetapi isinya sampai ke hati. Selamat jalan!",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "3129fbde80633905d2ece2eb606cc280248fdd4c10561783d115c5c62be4f1fa",
      "text": "sebab akibat",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "339b4749304bc2240030dd2a869599fa1425df814973f8b9ae1e316f2b9baa95",
      "text": "Bagus. Sekarang cari sampiran yang berima dengan \"baru\" dan \"Kairo\". Hitung juga suku katanya.",
      "voice": "id_gadis",
      "chars": 114,
      "mime": "audio/mpeg"
    },
    {
      "key": "37408d731427533df6ef182f22819322a7b61cb28711981477f23630e9a6a98c",
      "text": "Gimana, Mohamed? Kamu suka puisi tentang Sungai Siak tadi?",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "394fc4f4969e915ef01eeec52f9026675cef4c5ffb703e970269ec69eedf6476",
      "text": "Kata \"berpulang\" adalah eufemisme yang sopan.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "39d93f87d52cc6685432e3424328999dc972750c8ce0ca14c521a5810e7ba6af",
      "text": "personifikasi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c193c241860f873422a8546e90dd3ebe4e4f482d1ed021c94bbbe0cc1c5b19b",
      "text": "Mohamed, cobalah baca sajak ini. Minggu depan ada lomba deklamasi.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dcb026af03f598756c84691341b0bc01f6fc9cf493d96684d0ae454c56befc9",
      "text": "Pada waktu petang, kupu-kupu terbang ke cakrawala.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "40d3e43b2275dd2b8cefa76665a0a45dff1408b992075fa8549d5d14ef74a2f2",
      "text": "Sampiran pantun biasanya tentang alam, seperti sungai dan bunga.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "420a5de8d5730cfb42a73c94a1dd3e790ed50c9276401a3bf5e3a24758704e70",
      "text": "sampiran",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "44602f379f8d2de2c22a6a3998deff60f77944fcf89e6fc747b6647236a25e9d",
      "text": "Wah, pantun dari Mesir! Silakan masuk.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "46ca41c07075f3bca03081dbfc103b2e2502b3d0a1a75872010b9a113e2ed1d6",
      "text": "larik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a82b7bbd5e809e012bc7ddad93c570941a7c2b5f657fbcd5fa76b820c8ce26c",
      "text": "Penyair itu menyusun puisi tentang angin yang berbisik.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bd0de9ebb2676f547ebe894e625217cdf9b826daf227fb5857d056cfe7a8b15",
      "text": "'Mentari' lebih puitis. Lalu: 'Sungai berkilau, angin bertiup.'",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c6af204b15ae9a654b40d0e79937261acd98b2a2f09fe9de987e46573937de7",
      "text": "jangkrik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ee5db93172c752ea05ab01e5ad7334c36b85c7ab9894e77946f0c9a751bd5fa",
      "text": "Cahaya lentera menerangi bahtera kecil itu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4efd0ac2a85a9dc412aeed91c983bb2898a50056ca30546bf371e14931406f66",
      "text": "Ha, \"coretan kecil\" itu litotes!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f04e3e447901712e1d29bfefd36f16612be422429957db296ccc348f0cdb9a6",
      "text": "Empat, dan semuanya berima sama. Tidak ada sampiran seperti pantun.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "501c1d78bed4299d271c5af8ee5ac49f4ff0f4dde8dfa6d1977e7add7b501061",
      "text": "Alhamdulillah! Ternyata penjiwaan lebih penting daripada hafalan.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ee5be54c76b8e5ae9c8191b2bde92dd729730d5e11832cd3b8a69ab0aec3bd",
      "text": "Dunia ini fana; hidup ibarat bahtera kecil.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "531e2ce33f9d19784ff001c59d68daf057ce9a6e2f74bd2f85a8ed05480f581b",
      "text": "Sungai Siak berkilau, angin bertiup pelan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "54114ebf58ff50e59990ce2d6d2595693272f4708178b873fd53244418ad6847",
      "text": "gubuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "56e9e6b7407a2e46d1ac0840c18879de5e60d585acb262b764b130b9c15dae4b",
      "text": "karmina",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "590d6314f82ca6431b96dc6af3f0e046d8eef2aca055885deb65f483211ba40a",
      "text": "Encik, saya mau menyusun pantun tentang Kairo, tetapi sulit mencari rima.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b01f2f1f8183ecc9c057966890b5a6752fd69c7363ed08f6f0fe167fc0506e3",
      "text": "Penyair yang baik membuat pembaca melihat sungainya sendiri.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b81d89d44a240ff914698d2a90dad51d0dd1186658b658735db9c3bdd2861e6",
      "text": "Pantun jenaka itu membuat semua tamu tertawa.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c042e73d82c86f04f0175f243b69d1b5d6b40976224fb32066253e693753adf",
      "text": "ekspresi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cfa4377a2a439e7798f7956b1fafee8e839a97ee2833cd5d57d08b8c1e06581",
      "text": "petuah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ed43267783bb6636f016aa24f285f275c0f8fecce6d3d71502d7c87836fa64a",
      "text": "mentari",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f9fb502e1b02c298c873e97dbfe9c4cccb0a020979b29b56a62500188728166",
      "text": "berbalas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "612c7e5846701ccfc28048a06d9df6595d4820b607934b6504112425a4e10ac5",
      "text": "Sedikit. Saya baca gurindam dengan lantang, tapi saya lupa satu larik.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "6321e61c9fc61d055561db99ba605857f4c9e5d95eacae2cd8eab2f222dac1fd",
      "text": "Indah, Encik. Kenapa bukan 'matahari'?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "64d7ae211485246e7900eca5246d67bdcd0553e1ff4f1e2b1cdf4ea9e18c0937",
      "text": "Burung dara terbang ke kota, hinggap sebentar di dahan jati. Siapa gerangan tamu kita, apa maksud datang kemari?",
      "voice": "id_gadis",
      "chars": 112,
      "mime": "audio/mpeg"
    },
    {
      "key": "65593ace36e942366ac0bb49a2af2fbc349ce80234b979e4aa81281a7d0d9fd6",
      "text": "Terima kasih, Bapak dan Ibu juri. Saya akan membacakan sebuah gurindam.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "66720bd3212bb8a427869f328b18c9c9a3bbe07a41f54b1d2ab808b415b2d99b",
      "text": "Gurindam Dua Belas penuh petuah tentang agama dan budi pekerti.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a857ac7c0133f5c485d92f5d16209cd18abf15aee5f284ea1fecd712e1b0744",
      "text": "Puisi itu bercerita tentang ___, waktu yang tidak pernah berakhir.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d308fcc3f18d4ab81d4e62d2d1f63500070a1a86b9b09ecd4651fc561ef8db8",
      "text": "lantang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dc0056c85f8245c09f15c37953de900d26ab79e95dc6f8279910464f431cf95",
      "text": "petang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f78961124366fdc4d2ad561a446a5f61b116e7dd261fdd1b093caabaf6af196",
      "text": "Eufemisme membuat berita sedih terdengar lebih lembut.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "71fd1bc3b29673ac3918ada1bf03414a48f30c0473c153d04fd7eb6f754914ae",
      "text": "ibarat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "720dc806631d57be0554e34aa50502f8ce9a8c37252483488f4f8273c2022ec3",
      "text": "Mohamed, di dinding ini tertulis Gurindam Dua Belas.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "7400193d54b659555467e6422fec223d7aafadadc0d4211773feff5d785b1778",
      "text": "isi",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a35efa6e83f77f030071bef5ac2a9353d6afb21baf8ab62870b761001793b91",
      "text": "Pikirkan kampungmu di Mesir. Penjiwaan datang dari kenangan sendiri.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ae4ce8536aaecfb853f2aa67314e43926bf6d9aaaf5378e5123c7117a4d4dde",
      "text": "deklamasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d59fd82e64b59e924ef7f8eb026c11d2ef39972eabc0209ad3bba6fbd9af615",
      "text": "Juara pertama lomba deklamasi tahun ini adalah siswa dari Pekanbaru.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e25b7ac0034ff951b6d31030d74bf4a7cc770f9e390fecd4a6efbd513fa6c6e",
      "text": "Mulai dari isinya dulu. Apa pesanmu?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ebddccb6ab9def6b022d805b3080a35d3eff6fe367be7afd1a3b91b76a8b910",
      "text": "Saya baru baca sajak \"Aku\". Semangatnya keras banget.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ee373d112fc3cf2e050f1cd812108fafbca27ddafa8df958bc3bb8d6a8aa8dc",
      "text": "Mungkin karena itu puisi tidak perlu banyak kata.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8279f5badfcac60ce2b253d4613a79759276866258fb51ce791eeaea10cd8194",
      "text": "kupu-kupu",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8665f09221b2d699752f8e8abe113f11b84dc5f8fc2585489673bada81b28566",
      "text": "pantun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "874020e945ed8a8ae901aae4536e2390df4680dee75099b2bf9ce6a816c5f6b6",
      "text": "Baik, Mak Cik. Saya coba lagi dengan ekspresi yang lebih jujur.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "88a98c5a409320a9ed6e840614cbd2b214c258d3cc7e62b2ab334153c128be7c",
      "text": "Kenal Chairil Anwar, Mohamed? Dia pelopor puisi modern kita.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "901ead7bc425dfe576f36e2b0465d0b3cbfd0185e839cbcea5329250ba5f04fa",
      "text": "Mohon sepatah kata dari tuan rumah.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "91570867a5ba82baf03aebc54b44cac40e680881c541d712e3060d1ea67b2ca7",
      "text": "Perahu kecil di Sungai Siak, membawa ikan ke kota baru.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "91bd431e6a4e45656de042770eddcbceba214bb68065a12086160bcddc25f6cb",
      "text": "juara",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "92842b3a37f5411f5a06856042057b0308f1748790c1f42097990de94e7104ea",
      "text": "penyair",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "950fea85925ece2015da4f5293a70c458ac2f24319cba2bb738f25fe3a310714",
      "text": "Bagus! Sampirannya tentang sumur, tetapi isinya tentang perpisahan.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "95934d6910afa9319282f00055ef7909d8e891d1a7b08554fa095c58cc54d83a",
      "text": "Hidup ibarat bahtera; angin bertiup dari cakrawala.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "96629ae2b8d80814b891c69dda8eb27a75b88857e1087a7f419779b76dd65d26",
      "text": "sajak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "97a3e7183bd39a82e9dc5c8213b95c58b7fa02d1491320e9754b949b617a66a0",
      "text": "berpulang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "981ea0ac11afb6eeec5c68c07d64606de1a1d692a9a1dec0b6a4ebf8a0fefa9e",
      "text": "Dengar baris ini, Mohamed. \"Sungai Siak bernyanyi untuk kota yang tidak pernah tidur.\"",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c89e7085eef5ac302de71fc8fb0190975f601a9dcc3458b0320e9864878b761",
      "text": "bahtera",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0daaaa5458facc2057074c58f7a4349cdfe69b666640d3221caf50c89e5cb7c",
      "text": "Puisi ini terdiri atas tiga bait pendek.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a198eb6f01b418fef8eea72f0aba3f91c4224b6de27602ab99e988a5e9b32d02",
      "text": "suku kata",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3a2ffcfa3372a77e914e4a18fbe80f04381c15f828d6d2ae96fa1a5698c9ec8",
      "text": "Mohamed, kamu masuk rombongan pengantin pria. Siap berbalas pantun?",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa0d99eb34441325b4e1106e30d63a85923374e93dc470bc577ec44f00c81a9c",
      "text": "Dua baris pertama disebut sampiran.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa58a5b2ae7d3f187496b2565ec774c215acb4bcd9a85b916dbd9c1d5d3f49b6",
      "text": "Nenek saya suka memberi petuah dengan gurindam.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "abd1fd731c04b5f05a7b6ca27ec0fb440e1865eb3ee1dd054ba4e8eafc2e9917",
      "text": "cakrawala",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad240211d1a82e7098b9aa368824f006de6a3ad9b82580dcb27e5d058d74b31a",
      "text": "Kupu-kupu hinggap di kelopak bunga, penuh sukacita.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "adf63f703d7ecbb85dba4aee1c88b9064c76ccf1b8f125472a14ec5b9eacdd5c",
      "text": "menyusun",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae31470e530d564780aa9cc8e1c15fc586019ddcbc76d7b7bb5cb5af134523b9",
      "text": "Jadi sumurnya hanya untuk rima, ya?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0916e12c5aeee3e65b7a461f28e231218efb8254d60a5c1552ed92d5ba26d05",
      "text": "Mohamed, dengar bait ini: 'Mentari petang jatuh ke cakrawala.'",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1175d242d56e4512c37e766b3fc7b45498d1f36386f3657194f2b0168359306",
      "text": "Selamat datang di malam puisi. Lenteranya sudah menyala, kita mulai.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "b173ef615968d52042a55182e0ef4db2fc99dec093a99d77cb48491b41d4140b",
      "text": "keabadian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38ae2714850bf6581da479578a080b4bc099def3ec7cffe42552892fbc49306",
      "text": "Bait terakhir puisi itu sunyi, tetapi sampai ke hati.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38d706fb903c905fa4d5809da53d8bd6cd1bdf954acb784f11e3b3d4b4cea00",
      "text": "Pendek, tetapi petuahnya dalam. Larik pertama sebab, larik kedua akibat.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "b475c700f036da162144dbd526180394715f1164e3f858e9ae98bae7bff3adb4",
      "text": "baris",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6a6ddc2c63630e3899db5ea51c5d7ca74f271aa85d3530c66a465456c94e267",
      "text": "Selamat datang di Pekanbaru, Mohamed. Di Riau, kami sering membuka acara dengan pantun.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "be2b5c306c2fc53bc610b6e3e4e54b8fdee9baa9e0c3b6175450bc7287f739be",
      "text": "Angin bertiup, dan kelopak bunga yang layu jatuh ke sungai.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "be47759cd4d279289f87cdd3f4c56e11a8277b07841f3e9244d4e37fb571770f",
      "text": "Menyusun pantun itu seperti bermain teka-teki.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2c4733b1be864534a70fb51663ba9ab8c335370f7ae77d9f2cb52fd843b6640",
      "text": "Sungai bernyanyi, itu personifikasi. Kota tidak pernah tidur juga, kan?",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4559cf24b1ace8764a98d67ba85207af95ee654dc2aa9ed634f71da20cd67eb",
      "text": "jalang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c57c0b9ee4f59bd7ca77499d36f54886617046e7c15a298420d6c977d5132f92",
      "text": "rombongan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6d32c60967b1ba6e1cfad7d150d855a82ca81da5a2c7935332c6128b36b11fd",
      "text": "Suara saya udah lantang, tapi saya belum menghayatinya.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c82fb95eba57bd091f3c7031aa61397c9dfdc64075e2bc5fb4d508dbc780924d",
      "text": "Suka sekali, Encik. Bait terakhir bikin saya ingat Sungai Nil.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca2693a7f0b6df1caa0569b60c2924593fcdb18ed48872bf0a09c318b97db543",
      "text": "Besok kamu ke Bukittinggi, Mohamed. Tutuplah dengan pantun.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb27d49dda93edb3c7680aa1d44fc533605c6b9a7d28a99070511d6bb7bb61fb",
      "text": "bait",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb37b28caaf584d9f895239b692aee3a03c6a8f39baefb430b77e97de4ca3cc7",
      "text": "Terima kasih, Encik dan Mak Cik, budi baik kalian kuingat selalu.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "cce462f05818640e1a95dc78defd76bfae569fd603729ff790a790cfa37c0d56",
      "text": "Setiap larik dalam syair berakhir dengan bunyi yang sama.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d052afe65657f915393740cc370c417c01f80f7e842b5f7e384b65a624810a97",
      "text": "Mentari petang tenggelam di cakrawala.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2f6fc73d0abdf1bd26487c77f6c3d3d6b9c32b40244ab6d39267ca877163605",
      "text": "pelopor",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3136ce58a2031b97960783ad26e89c9d3359c133ff5f2382cfb774f41bfda23",
      "text": "Hidup ibarat bahtera di tengah laut.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d39b66eb026d4e299d3e5a6c8eeeca7112624f5b0673a64e02f630da7f6c460f",
      "text": "bertiup",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8ac25d1430d1590c6a04e530a5f97bb2c66da0c6f32d6ceed0552c747ef3a9b",
      "text": "Sajak \"Aku\" penuh semangat bebas dan berani.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "da7f3102594fdbc730f6d8c8419d63542fe0f248d2c5aaf5820e8422d1238722",
      "text": "rima",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddda43716cb07a0bd4e019b48535ef6fa8c3b122c08f5dfd7309cae3593eec3b",
      "text": "Betul. Penyairnya kaya majas, padahal dia bilang puisinya \"hanya coretan kecil\".",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddf3105eb78987bac6de09a156bf3addb2ee537400cdf82c4f31e0a457de1297",
      "text": "sukacita",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "de20fe319e4b543d13ca1553b0b0b3f0a1c66112e77055b1d2a3454b5626327b",
      "text": "hati",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "de9d374adc8571df09493b81c1b9a55c5766bf1443567812b16a17c817776835",
      "text": "Saya punya utang budi kepada guru saya.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07ed98c88602fb6a6053f31bf9428c304be8cc08b984316a2cb17467d35f5a9",
      "text": "syair",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f0df9dabce8079e39b767ebcbd39f8b0220ca52b9f5bb4aac9d809e2862b2e",
      "text": "Pantun jenaka dari rombongan pengantin laki-laki membuat tamu tertawa.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1577690728fddccdc5fb42ba96ab1abbbd1b1c92ff1a49fb4a1bd10a29e1f4b",
      "text": "Chairil Anwar meninggal pada tahun 1949, ketika umurnya baru dua puluh enam tahun.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "e272ffdd7dc5b13244e1b337cc1b246c20e91c907ec5e0fa33951e4ee2e18063",
      "text": "fana",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2b49c5da69ff1341aaa661d733b24513e4b774d326e75d13cb118e6a5155a0a",
      "text": "Jika hendak mengenal orang berbangsa, lihat kepada budi dan bahasa.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33a5991400e393b1c1d2173c3119209aeed382325d069162f024b9a20015fc7",
      "text": "majas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5c7f18a6601b8e709e297caf2199936c3d47b241eb63f63b14964b54a6d5f7e",
      "text": "Dalam puisi itu, bulan tersenyum. Itu personifikasi.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e64530e1aaffb126d9918b1a53f8b6b3a49e15eea7c5c5cc066fae7f38304eb8",
      "text": "Mohamed, juri udah selesai menilai. Kamu gugup?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7c89ce2adc7fd3452feedd0e98a36101784e39430d431b86efbe777804cdff6",
      "text": "Kalau ada umur panjang, boleh kita berjumpa lagi.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e86febe7d559adcd674ef97ce80957b89033ba7a8ce8a9f6f57a1bc1ab7ab8c4",
      "text": "Saya tahu satu, Encik. \"Kalau ada sumur di ladang …\"",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "e88fcabdc981146b66d6e3ed27fc7dc3ed71e4c43fac1b7fb7ad7eee562084d5",
      "text": "lentera",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9710923669318f37e48ac4de8f11a915690dd601ddd15660034ec8423875107",
      "text": "Aku ini binatang jalang, dari kumpulannya terbuang.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab632cd5bad88f039ee07f75a6b0ef9a36a2d77b7b705c89c02e4d524f3a000",
      "text": "Gurindam Dua Belas ditulis oleh Raja Ali Haji di Pulau Penyengat.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "eca8b7c9a01de6b36f4fc1e8f2543995ea863a0224225de06536cde8662a1ee5",
      "text": "Baris pertama dan ketiga harus berima.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecbd8c402efb3c790995ba4dbd823d673a66f0ce213dfdb1746127c5e6c353f3",
      "text": "Malam itu hanya terdengar suara jangkrik.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "edc480facf8c5997474599e9b37f9639147e887a71f809a29dc07659570fbd7f",
      "text": "Seekor kupu-kupu hinggap di kelopak yang layu.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee4bbbc29bc1c74672e4981ca060d24e1a735a87d61d14986f63033f9f172f0b",
      "text": "Penonton memuji penjiwaan dan ekspresinya.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1bc106a9a78a397f46c40ef554104148b93d165ca9a0f99f187d45bcddeeaa6",
      "text": "Tepat. Tapi kupu-kupu masih datang. Harapan tetap ada.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f28366870a2c6eb00a909e5cbc1fcfaed930c197888d260048786685fc61e4c8",
      "text": "Sudah gaharu, cendana pula; sudah tahu, bertanya pula.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "f35f5073fdeced8d98f33d773e9bd7d1c30fd02aa010798d02e676da1b9232a8",
      "text": "Kalau syair, berapa larik dalam satu bait?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f375b0c1d79d32bed0761606e5677b9b00cc29952931cf17e2ab8dd92506a8f7",
      "text": "Setiap pasal hanya dua larik, ya? Pendek sekali.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4185b30d0d62f0728c11110be14388eb33b6352ef9b19937aedc434f41ab1d6",
      "text": "layu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5ac670004d4f8c0347008fefce6d0254dfda9b4b297d5b3b27e73a564b1aa0c",
      "text": "Suaranya lantang, tetapi ekspresi wajahnya datar.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5ec2b1ffb842f75b017a2c94419c56796d00636801492d01ce69adeeac200cb",
      "text": "kelopak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f694671adb6a03783625dbdf43ba53529d9bf780fa9d3a582e150441e89622ab",
      "text": "utang budi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9dff1ffd609c0ecae2809b40d5e7c54739d1c6b2eb4d802dcb13ebfc7f16a44",
      "text": "Silakan! Kami menyambut tamu dari Mesir dengan sukacita.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbf821955baac44815e669a1df16adc2072acef2debc520afb9e23985e7202c1",
      "text": "penjiwaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd8e1eb16359e858f40fa432810ab0b3b27d03d7ae41fbb3e6f98b5853294134",
      "text": "gurindam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa571ad2e103fd4c388d5229c5946ec4933288c537bcbd1e23e64fe217a6c6d",
      "text": "Penjiwaannya bagus sekali, sehingga penonton ikut menangis.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    }
  ],
