      "sha256": "17abd446cae243bebea0681e0ac23a6277cb4d3198fcfdfca91e5b4d426a75ec"
    }
  ],
  "audio": [
    {
      "key": "01b396de6d173765398f2c0c70e17b76dc5e527f852813c0e3deea59c82ade1e",
      "text": "petisi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "029e03fef257947d045b5f61f7b6e95541cab4c45fe0cba544e60be20c94ab47",
      "text": "Undang-undang melindungi hak setiap warga negara.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0349d7a313be382d9390da5a90fbbe04577e8ee0efc21e389883a3bc939ec6dd",
      "text": "peradilan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "039357118dab35f302c0a4c872924037ea31156e07c59796a04245c946862d24",
      "text": "label",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "057c37a116fd903deb1831fe554ef381d921ceafb23f03c46ed6318c278ccde3",
      "text": "standar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "05b5906b548191df9c89bb11cd29d561d91081113f5d2c9b45fc9510a7ce07c8",
      "text": "Undang-undang dasar adalah hukum tertinggi di negara ini.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "05c87e098606c960ec396ba1f978630b055cc7ca6db9b68ed5a8e3883b03f56a",
      "text": "mematuhi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "05d6be10aa5fd7f3d2daab50c5124004bacaec5948e68a3cdaf9ab436ea09ecf",
      "text": "pembukaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "05fdbb986b416d24400df839db3ff3d55ce5e26d91a10759a55240e34fedeb0d",
      "text": "Kak Intan, ijazahku udah jadi, tapi aku harus pulang ke Kairo besok.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "09f3a22505b5f6b781563d7817f6781f1f1d8fc847c29d12d0c6c7bd130f87d0",
      "text": "Artinya, kalau kamu nggak datang. Sekarang lihat Pasal 4 ayat (2).",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a1cca1e14c512bb62ae3becaaba99d7630457392f3c9f68b07d85d0156d4c50",
      "text": "diadili",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d960aeacefd1dd241fdfff4d3664247fd9b4e686214de82ddcc67788c64672a",
      "text": "Pemohon diwajibkan membawa paspor asli.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e224ce4d7cadc35ca3a7daf72393342c7ab45d05f983eca88be02b785b94178",
      "text": "Ringkasan kebijakanmu harus satu halaman aja, ya.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed6538e6a87a1b32862a71d4d5e1c59278ce3e7fe5914cb07708173fe7079a2",
      "text": "konstitusi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ef0384a3413f81ea1731e3f13ff352bfe3c30ecbf8f1b77339dd6142662dacb",
      "text": "sengketa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f9cbaeb48b4fa1ac3fa2499ed4fb64d51d05fcd11d08f7d5fabfe2c80f8db25",
      "text": "mengatur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ff8b4b9ddf0fdb7f4c934375bfded59d3f06d61c79ac05a07dcb33aca79fea9",
      "text": "Peraturan ini mengatur persyaratan izin tinggal bagi orang asing.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "117c5c0dea4b2d6e18b84591a0ea28f3ea26923d332804489f730a50a41e410f",
      "text": "penerima kuasa",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "11ca69d52a83c0c7ff78c78754c7663d1636b5ae257acd7faa75093c18e01637",
      "text": "pembatalan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "124d3825e22cb59d891cfd3f822b4390932b751fa2536dbded7f943e3a6bdf7e",
      "text": "Saya datang ke kantor imigrasi untuk perpanjangan izin tinggal.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "140f11e7de21e9b74a30bfd4a66e7c29ec141ee5f9c31d53505a8be82ead19f5",
      "text": "Betul, itu kewajibanmu. Tapi kamu juga punya hak, misalnya dapat penjelasan dari petugas.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "146452469c54d35deacc7cfe0fe08c60ccadb68d53c5763ca46ab1a9ac01b6b0",
      "text": "Dia diadili karena memalsukan akta tanah.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "17ef68f26bb9ccf86f941b4bfe97ac8e653c96900e1f34f5dca590ef0edec467",
      "text": "Aturan baru diberlakukan mulai bulan depan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "199ea7842f8d4f0b6bf70876c3c6c504c6f037631f0d32f1a4ee40813ccf4658",
      "text": "Ada tujuh level. Aku sekarang di BIPA 6.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a2b28289cc19f43f840846585fc19e24098d45ebe224e0fbff090456dc32cae",
      "text": "UUD 1945 sudah mengalami empat kali amandemen.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ac784d653398f3b242a85d95953c924b060c8b227672e2a13f79a686e5d84cd",
      "text": "Yang bertanda tangan di bawah ini memberi kuasa kepada Raka untuk mengambil paspor saya.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b9449d3cf04424a7b17b86ac9e1330234fb068b22b63a91ca06862ae0e8dedb",
      "text": "bersyarat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cccfcc82c0cfb7a4894cae7864cd77c24d10c5af97901644a95f125a01a30ff",
      "text": "amandemen",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dc5aa2ca39c19ec3afa3181510bda9588169ffb3675b8101fd8b13542483490",
      "text": "Selamat siang, Mas. Ponsel ini mati setelah dua hari. Ini struknya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e6902962291f82dd7b372b17ce5bc35d3fc4d9c15a6f304a22a357df37a15e9",
      "text": "Apa dakwaannya?",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f367b6f516759f2150166973b1a9c33b8b8f52f5b4f63ec5ac19f6299477310",
      "text": "Dua napi kabur dari lembaga pemasyarakatan semalam.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2187b1be41d095947dcd98eb8c51e79b897f9a92e5ef1db4ae27408f130f0491",
      "text": "Pembatalan registrasi bisa dilakukan secara online.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "219e3c9526c259f926500ba16203d29e41a3461e77d4cd176128b6bd7dc7abfc",
      "text": "Benar juga. Karena baru dua hari, kami tukar dengan yang baru.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "25611527bda0ad35859910761a44b3e788c6b22b48cbb3c2c2706485e814b57c",
      "text": "Terdakwa datang dengan tangan diborgol.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c477422077702c00f77f8b88513b0485c0172e291a63731c99a3d601d07eb0",
      "text": "Warga desa menggugat perusahaan itu karena sengketa tanah.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a880f3a908ab8a07fdb569529dc14840e295fa37e550aca555807b39df1885c",
      "text": "Menurut Pasal 31 ayat (1), setiap warga negara berhak mendapat pendidikan.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "307e833f3772ec39fff08c370129f4ca162cb7d65140bc6985bf857eb70421db",
      "text": "Menarik. Di Mesir, konstitusi kami juga diamandemen beberapa kali.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "331dbfbb672dfed0c927f50c2282925f04a5086fd42f2f3e77170a59cd0d4fc2",
      "text": "Penuntut umum membacakan dakwaan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "339bde36e33f97f3c4fac9726e61fa84004f1eb0cc191b1e53b07fbbd7e73a5a",
      "text": "struk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3450c3eab5a7fc7a3edb8851196d1bea4d5e3d40c4bfc868d8e24d055f814ae1",
      "text": "undang-undang dasar",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "34a5095ec0dcbc77d5e184470b8229e6240f99813b3a4a598daa6d76a96560f2",
      "text": "Bapak diwajibkan membawa paspor asli dan surat sponsor. Registrasinya online dulu.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "38553ddd7b3271fecb8752deac68b061ba828489134068c905b2674a029d314a",
      "text": "dakwaan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b8775b23437ee28e1b098eb6d6a3e0af1f0e04a31210fe1a6648603395349d8",
      "text": "Ada peraturan untuk pengunjung juga. \"Pengunjung dilarang memanjat candi.\"",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d33e31a42b6145633b40aeed9b6a65334600acb167ef47a3c50a93ffa820a30",
      "text": "Saya mau perpanjangan izin tinggal. Apa saja syaratnya?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea158009310d564f785d1eff6f56e7c9e04d8bc09ee8ab778e84e9f0bb26a30",
      "text": "melindungi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "416fcf1310dae572b5235a47ab2bcb114f9fc4e33f1617970bdbd8a1241155a6",
      "text": "Surat ini belum sah karena tidak ada meterai dan tanda tangan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "41dad076da41ae185def7132f2af89c1f65ee20f44c5260d71ada94b6d587df4",
      "text": "Ah, semua orang langsung menyetujui. Nggak ada yang baca.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "44c30b0876e18f17463245ac77cbc0260baf6261e1ec766882364a8a66287cd3",
      "text": "Mohamed, cepetan klik \"Setuju\". Motornya udah nunggu!",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "44ef20d7567259e630579856cfd9762b55ea77968441b7bc4f381f68523b12e4",
      "text": "Polisi memasang ___ di tangan pencuri itu.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "456706e2ff33191548b27ce58557a4a938938da0c50a8cca687f058e7fe665db",
      "text": "Intinya, peraturan ini mengatur kompetensi lulusan BIPA.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "45e5ea80c5f8cfff5a7088ac2e14c8c4433f50dc484c8cdded3bc7dbf3b3626b",
      "text": "konsumen",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "45f421b67d5b67f79ef3b0bd00b8592947c1816e56d58c0aa00581a121925fb7",
      "text": "kompetensi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "463e0d2e0f4d6bbe1ea224f1767a1fd7e94030d5d94bd16afac69ea6c3c457e9",
      "text": "Ribuan orang menandatangani petisi melawan ketidakadilan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a20a1943509c43a21a25ab44a6fb1a70e3e7927656ddc6e95dca6ee32879072",
      "text": "Persyaratannya hanya dua, paspor dan foto.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e3f3ec841885f973aa243f18ef279bc54fa57aa41a6d9bc46dca7757f8c3aab",
      "text": "disahkan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fd587a00729c6301ea3c4717658f3487f50c37d27dadf1f9e0ce0f99534ea2e",
      "text": "hak",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "517cfdf9fabbefe385ebdd6145e7cce642d096ec692bf2b90d8a1db6c9c57cff",
      "text": "Lembaga kursus wajib memenuhi standar yang ditetapkan menteri.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "51b85516e3326bf2c5dc5d4ba07a9121a1ab1515963eac00322734a3f4a19154",
      "text": "lulusan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5456b73715790c9317c9a735e0499d081ab460f2dd71cb3a5bc08968b90e7d52",
      "text": "Saya tidak menyetujui pasal ini, karena data saya akan dibagikan.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "569bf568bc3525eb926122e911d1f992fd8533964a110030df5426f7e1cfe84e",
      "text": "borgol",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "593247df00d5d91bcf562b6d2c6b20352d80a03973786d46a5917a26b521c6bf",
      "text": "Sasaran utama program ini adalah mahasiswa baru.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b403b1aa860add1c07d1440133508c79d6eef9e983bd9d345aafcc84086d829",
      "text": "Mahkamah Konstitusi menguji undang-undang terhadap UUD 1945.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b82e1533b0befe78e9e089e7098ba883f7bba9a56ea9141a981d5bea26b7e28",
      "text": "Tinggal satu lagi. Lulusan BIPA 7 diharapkan bisa membaca dan menulis teks akademik.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c3c6439f22421a85a257d78b962e31e2a9a3630275e9d2ac3baaa6e140d4d61",
      "text": "Perlu meterai?",
      "voice": "id_ardi",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e1c8bd677b5e77247c728216ade8164cb5b352a5466a53f13e86aa680ef0a93",
      "text": "Desa nenekku lagi dalam sengketa sama perusahaan sawit.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f035127a1268e306e012d1e46c9da3c5db2b421e2119612a6dece81ec835e20",
      "text": "Sasarannya pedagang kantin. Rekomendasi saya, kampus membantu mereka membeli wadah baru.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fd0a916befa605a622f4c7aad09d41b0e192cf1e145059e77134ace4b29ed9c",
      "text": "Saya memberi kuasa kepada Raka untuk mengambil ijazah saya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "60644c4c9080195164374b65471057e7dfcaaeb60db8d759b3133e997c445a7b",
      "text": "Pemohon diwajibkan melakukan registrasi sebelum aturan baru diberlakukan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "63d7019785ce6afe9e99212c87dbcce55b1d751cc5a8f9382e906afc5a13c9b9",
      "text": "Pelanggaran lalu lintas pasti dikenai denda.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6408413aebb7b0cd878e6542f895737ea64086f4dcf106898422b8cecbfa8ed3",
      "text": "pedoman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6413fe04354b725af6c76d9cf64b2379894e57af82914893aca678735e9305bd",
      "text": "berlaku",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6834dfdc9f7790d905a32aff48a2680c3012d32864aca6636483eb66bddccf81",
      "text": "garansi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "68f176d9e727e9b8f6d429022a24a625827a4403b033c68c7f17dc9289c33168",
      "text": "ketidakadilan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "695832c30b709d1e3c321987d4309d3afd7155fc790b2028e371cdcc4cfd5edf",
      "text": "Memalsukan akta tanah dan stempel. Penuntut meminta lima tahun.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "69dca3ccce2ce16c31f1122518cef2505e521db8a71b93c4db2184c9f3997fc5",
      "text": "Pegawai itu diadili karena memalsukan stempel.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a19f3c333751ef5b91f0220c400c10ac2af781cbb38f068c320a9e951eb5f39",
      "text": "Terus sasarannya siapa, dan dampaknya apa?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ca733f160f06f6214d0295943b39126cf4c969f1e23f9698dd50bcef3f08770",
      "text": "menyetujui",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6de758ce05cf1edb1d60b7011986cc66c25a0e8695779ce879d711c1d33a5ebf",
      "text": "Iya. Sebagai orang asing, aku wajib memperpanjangnya, kan?",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e6968a94728a5bb79d24dc2ce516a120a7f0a2c3ef4e1d40f4758b3469539f7",
      "text": "Artinya, aturan ini pasti berlaku untuk semua orang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e718603e7cd7d69e7a6b5b3627db426372b3e6e445d324f9c44bd1604d2a15e",
      "text": "Perpanjangan izin tinggal dilakukan di kantor imigrasi.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "70799e799260639672faad537e3e0b9a1cfa7dc5df9cda92531240105b1e58f1",
      "text": "Siapa pun yang memalsukan akta akan diadili.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7106a8e666662a710b1b0d2f1cbd999d507a4646ecb5481f420e960f2b2723be",
      "text": "Maaf, sebelum saya menyetujui, boleh saya bertanya tentang pasal lima?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "719035c5051e4b6ef6d77867006af39d87c8ec351b953082bb5bfa020785281f",
      "text": "Semoga peradilan berpihak pada yang benar.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7355ccff26da3e9a2c71646043b45a30b58d9a144caf612d600750d3878dd230",
      "text": "Di foto ini tangannya diborgol. Kasihan juga.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "73c2c8533331b87e569a6fb3a487b6912b7320c19c69b4e376f9701e18d7f6a6",
      "text": "diberlakukan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "73f989b76f7c643565c61f9a896f7e80abbc412ab7750b59e446df21585e6c02",
      "text": "Betul. Permendikbud 27 Tahun 2017 mengatur standar kompetensi lulusan BIPA.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "74871300ed6129aa249fc92eb9ab6d7b505f9acd161c96af7b878aac66b56aa0",
      "text": "Susu ini sudah kedaluwarsa sejak minggu lalu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "76389ca0a18647fce2acece1f5593789967f32f8a91d66754cfe26216e66373e",
      "text": "Udah baca berita ini? Pegawai kantor tanah diadili kemarin.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "77f2555cccfd52dd0355dcb919071cc9e0291db763c42f7f7553eee6043455e4",
      "text": "pasti",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7acc2ca32eceae2a289dee2a89786a1f87932ab6606a85e76edda122240a84da",
      "text": "sasaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7efc650f3f1c92aec676630daaf19df44157ca8f15656358578130451e11e47e",
      "text": "Paling banyak lima ribu rupiah sehari. Jadi balikin tepat waktu, ya!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f7e9b6092834e4f035becba521cb670a8851f8dd4890103ca3caee38de3aaec",
      "text": "kewajiban",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fa1c446f315123f05622abfe4b6b4f0640b0ae18e9990d4052a86ded79edd06",
      "text": "Persyaratan beasiswa ini berlaku untuk mahasiswa asing.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "809108b9cc3eaee793ce70ca4bd261c91fc69ceafe5c3868efab4899f9726b69",
      "text": "stempel",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "810d77bc3400914c5c681b7c2b14a529306a2074b6a3ab8c722aa16ed767c2f0",
      "text": "Hak dan kewajiban. Dua kata yang saya kenal dari bahasa Arab!",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "82409579bff25da73d3d4bc996b957d7604ac2c2e041f591d61e1ea8798fe27a",
      "text": "Tidak ada, Pak. Aturan itu diberlakukan sejak tahun lalu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "825610e72180851bfa98c4b3021dfe5c39583c18ce50e1473fd175731f7730d4",
      "text": "Nggak. Setelah Reformasi, ada empat amandemen. Pembukaannya nggak diubah.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "825f9de09ae3c43a44e7ff7266dcc0edac37b6dfffbf9c8878fa42cd5b91e236",
      "text": "Mereka mengumpulkan sepuluh ribu tanda tangan untuk sebuah ___.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "842af0c704707ad8cfb837bb639ec7e16bee9ec5f59b61e136015f585030e388",
      "text": "diwajibkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "870d78f78fa5c5ad7737311b0d34d67e7234b2112e21c3b6ce4313d983ccf7a4",
      "text": "Kalau terbukti, dia jadi napi. Tanah yang dijual juga harus dikembalikan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bc003285a2f661bab2406d2f7f34ea258402f56d8b8a72a4453fd81821bce4c",
      "text": "memalsukan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d2c8277663a63e8f918797f7286d41985fd4ed9803dc23612956433978395f7",
      "text": "pasal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eeee360cd70adf1e46368b5097ad60585a1f01bcf57898e174eb822ff2e6bb6",
      "text": "Izin tinggalmu habis bulan depan, Mohamed.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f60a2e0dd2c68160849946be9b2140bd0809eae8d1f4715197a01843f423a85",
      "text": "Peraturan ini mulai berlaku pada tanggal diundangkan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f6922afcd39508ad77919da74d24db683d089cf876a09877ee5622b59a6ff79",
      "text": "Dendanya berapa?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "91c2ded70d79268c42d63a82de00d6221fe02ed0e808d4b9810e38993524211b",
      "text": "ketentuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "92ec3164ac8b8d0e94bded8e253a573f8b48ff41224ac4836e4296e3eacf43e9",
      "text": "surat kuasa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "940268472d232a70cb2498bf04f7dff8118013ff0ed19cc6d349d6ddb7f7eb62",
      "text": "asasi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "94bb977832717cc2d52e1150a9fd1dff3fb11a6155a62f952da6fe8f517cb964",
      "text": "Terus warganya ngapain?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ecaf74a69360a6d23230afbff3481a10af4f8ce4a4dd4365da16bc977a11de",
      "text": "Bang Mohamed, papan ini bilang apa? Bahasanya susah.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "995eca5ab96d99999a7e1f0094df35fb61a6426960ad7aaa9c9001d16286db00",
      "text": "Bentar. Aku baca syarat dan ketentuannya dulu.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c3726c985a996c91d7d35bc8035fb8cb6dd5e7f4b00873912fe673b9d31d880",
      "text": "warga negara",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a20e8db8f88e9b53187fcf83602446148d196f374fefe4cb743cf021f0d55bf0",
      "text": "lembaga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2235099c94ad6c4163ef20b5960241abb58af610dbe7d6eb9536cf41a3bf5d1",
      "text": "Hak dan kewajiban harus seimbang.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2ceb1f215b6c49950a09396cb36e9f5a0b068dd12d3db6a982fd93983d21bb7",
      "text": "Dalam hal hujan, acara dipindahkan ke aula.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ad2c13a43da27402e5ec3670a798d2ec0a726928b5ffd11ca5571e56a56b22",
      "text": "rekomendasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f7274d94f94216492dbef5fe081b800251a2b1a9671b03c16dec60f195c56c",
      "text": "Penuntut membacakan dakwaan, lalu warga menandatangani petisi.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5fa03b242782adbd146d3cb563f2f4c8cd717a9dd3af895c1e9ab2ecfac3276",
      "text": "Kalau permohonan saya ditolak, ada pengembalian biaya?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6b27d212bd76b020ed95cdf95acc06bc17e7b87dfa54f1a0f40b5da0ffbb87d",
      "text": "Lihat Pasal 3 ayat (2) dalam peraturan itu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7540e2ad6fe6576e1a2441bc056dde3a65652efbebd620b5ff8b499a172fb4b",
      "text": "menggugat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f7758ef37580b6705d74f1b976a0619459dac60d697ec4a0f39ac2f27e09d2",
      "text": "Konsumen harus membaca label sebelum membeli makanan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a97cc4030d98acc72efeef7fb004646873709afc53b1b9395abdd54f891b5f66",
      "text": "Kecil banget buat sebuah konstitusi. Isinya masih sama dari 1945?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "af695ccc1c64adbd199c00a6f2213217712884cecfae28d6a35a46c814c93e7f",
      "text": "Pemberi kuasa harus menandatangani surat di atas meterai.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "afb0e555b3b4a14a294ff68c77e14269cde8a6090ca06b64e34e997b44cf6d9a",
      "text": "akta",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b019560938fde69dbca2d679f9a6fff9b7d63f55c69f63095bb95a1e28520e0c",
      "text": "Hak asasi manusia berlaku untuk semua orang.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b09b89ecd768614613ca5df6f2d6d6f5c7a139830a2dff9075dc6f59b4e15c2d",
      "text": "Kaku banget. \"Dalam hal penerima beasiswa tidak hadir …\" Artinya apa?",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c4885e7e47bd586bd8f7b0d1aeec88a5e84413d9e2e53bb9de38e693050637",
      "text": "berhak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b480f6877d40c21cde9108d98102f0b595986faf799698d187ecfc685270730a",
      "text": "Setelah amandemen, presiden hanya boleh menjabat dua periode.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b501c086f8f3650c56b4e346c6596041a6db5679e08d462895f8e9e4d804a382",
      "text": "Mohamed, ini buku saku UUD 1945. Setiap mahasiswa hukum punya satu.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "b643227201d205e0dec3d6e9829f30fbf4940f91525542f23925cf5db8a0d41a",
      "text": "Konstitusi itu disahkan pada tanggal delapan belas Agustus.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7a124e676bb7cd58df54f180cf2b9e190e4cda4c65d56615e59c3c8b8d08739",
      "text": "Ini Candi Muaro Jambi. Kompleksnya luas sekali, ribuan hektare.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9a1bc62c3e3b2d48e585bc1cbd89499cfcf08331cc34631bfede82da50a21db",
      "text": "Sasaran kebijakan ini adalah semua pedagang di kantin kampus.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9f08d5cb53914b59a1ae12b31269f9794d2dc9212738ecfb8f4a6a7c7d87c22",
      "text": "Artinya, kalau bukunya telat dikembalikan, kamu bayar denda.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "babf7dcf53dafc2c432848237a0595783056c91c52602867d89bb9d5a43f533e",
      "text": "pelanggaran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "badb68d7e1f9147b2035891cfd990fa6559f9d2b449f8284be407734d9b6f157",
      "text": "Registrasi online dibuka sampai tanggal tiga puluh.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb427f5337fba9bb3c3b5c06f6046247ce6966b78baac638eaef3fdee1c267a4",
      "text": "persyaratan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd8ffa15a278bb8d572c7d0b5f6b8556bc7480e4118163cc2d88506d36bcec97",
      "text": "Rekomendasi kami, standar ini berlaku mulai tahun depan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf27ce06fd4d0b18f41c497d91e49d7bba62a35985a17f335e556fec43817384",
      "text": "Betul. Artinya, kita boleh lihat dan motret, tapi jangan naik.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd560c197dd61e7f12e6f5673c8cfa81a490d924be15a61b30a61a47c893535",
      "text": "Baik. Ketentuannya, kantin dilarang memakai plastik sekali pakai.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c113fd02eac086d35da6d5074f7d443cf0ca730ae7cbf4216604c631f9303082",
      "text": "Sebagai tamu, saya wajib mematuhi hukum di sini.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c15abd29b73a949d45d09db1ff4ebe49f65c69ca2b1ac6071c60df9926fee243",
      "text": "Sistem peradilan harus melawan ketidakadilan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6219980f78c03858d022f33c79ce8ec1269d94ac079ae908d2df0fc6bf6fb51",
      "text": "Setiap lembaga harus memenuhi standar nasional.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c645cb507e35c22d6c492cbe8639a46b745097f634d587952aa3f9d78de422be",
      "text": "Kak, ternyata kurikulumku ikut peraturan menteri!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8046d229491b941943cbf61bd0b6c831ce637c013ad10ac506f7e547e197e4e",
      "text": "Iya, meterai sepuluh ribu. Tanda tangani di atasnya biar sah.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95caf48b4af6f40bb61419e7795aae6ae3b858765959730a01fc6c80ca165df",
      "text": "penegakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9d0cd0a28422efe34ea6f7b2f5cfd1eacd39b41c4792085cff14584885c61e7",
      "text": "Maaf, tetapi barangnya baru. Sebagai konsumen, bukankah saya berhak menukar?",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca6d0df346adf0c7f08770ae82ee90bce1a28b562e75f5de025b854cb39e0f11",
      "text": "Maaf, Mbak, roti ini sudah kedaluwarsa. Bisa ditukar?",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc44f7a857b7fa6e16e28ea1a5bcb30780e7865a97097f497ac84e1b1aab89b2",
      "text": "Mereka menggugat ke mahkamah demi hak asasi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccc5531548b9c1e11cc6e6c3bd365bae9e64a27141e985c37af074dc3dd76bb5",
      "text": "Apakah surat kuasa ini sudah sah, Pak?",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cffb79bb01b3585585478188c9d49d27b924eb772a1a60f9cf075c0bafea4756",
      "text": "Negara wajib melindungi hak semua orang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d27754109700458be7ed1524c19cf9d63ea34c8d0e178b2b1de6b5b520f48a5a",
      "text": "pemberi kuasa",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4fd7e61c0f9dec89e773a5902c329427c03b13ee01704fb81b7289130ffa549",
      "text": "Hak saya memotret, kewajiban saya menjaga. Adil!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d530a4ef7a0c7fb665b440530eda89da1de36210929b7563de37b519ec8feae1",
      "text": "Setiap warga negara berhak mendapat pendidikan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b1ec02dad90a5885c4ad3d1d9fb12f7c3cd88f0d404cb058e3017b13d7fbca",
      "text": "dalam hal",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d847eb68c5e6072b1b36ae614f6ea9d3bd73c36625e2d60bbf0e5faf1ea9d056",
      "text": "UUD 1945 disahkan sehari setelah Proklamasi Kemerdekaan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8c18b7a2fa451ab4bc92f53acf45ffaeab057c4fdfd024984973484dbacbcf3",
      "text": "sah",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8d77ec5a7fd7c9dd3ae92a081197a41d49e851f158e36505de48a51c150f7fe",
      "text": "Dengan mengklik tombol ini, Anda menyetujui syarat dan ketentuan kami.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc06bd0c3a1fdea3d1077901eb27e39cfe6a34598159fcadf143589a1ef88288",
      "text": "Selamat pagi. Ada yang bisa dibantu?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd94abb64ce4911fe641f8f516408613d135fc69b50a7611d5613340d618b3c0",
      "text": "perpanjangan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "de70dec57e7c6e6752c0990f38fae7666c0367f7ad63adf36a63d8d30598573c",
      "text": "mahkamah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26829d27ae323ad00b8b93e8f5a88e6084f484edba8be6f0697ccdc27d61ae3",
      "text": "Syarat dan ketentuan berlaku sejak tanggal pendaftaran.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26bfd404aa62fefdbf5e2ab34ec3548e068aea77e82b37c9c480133b695baad",
      "text": "Baik. Ponselnya masih ada garansi satu tahun. Kami bisa perbaiki gratis.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3a0423b973fde9a7cb0f91ce213f93fd9703a4fbf180c4bfacce687e8730b10",
      "text": "ayat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e404aff0b404d33cd3705a35c09d67fc2631828664fb9cffce4fcaa8b69b2cdb",
      "text": "Oh, di sini tertulis aku berhak dapat tiket pulang. Bagus!",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46cc4c973d5e9675e0ab11dd4843850c5ff3a64df852b3bcf3ee57376289898",
      "text": "Konsumen berhak mendapat informasi yang jelas di label produk.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "e83a2d02bed291dbd336a7cf650ad80e7271036de5cfcb43243abe34b01d8db9",
      "text": "napi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e84609433369dfcd4325302d1e05513d530975a2698c4399ffe5821f42652b30",
      "text": "Biaya ___ tiket adalah dua puluh persen.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8ea24c34b7b898a333c347a1051cd6399e163083561d5617bc5260a257ed364",
      "text": "Laporan itu berisi tiga rekomendasi untuk pemerintah daerah.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e98d4ff323dd837ea27364d680a333f0add119b143afd2d7591937a7d3cd1e49",
      "text": "Amin. Ketidakadilan seperti ini sering terjadi kalau penegakan hukum lemah.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9d6adaff05ef169bf1598e8458ca26cb8407c628db4763b8af09f355ab0ca24",
      "text": "penuntut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaf76c35b096b14921787d69bfb08bbd3a6def1fd21e27dcb37178da14b827c8",
      "text": "registrasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb0331fadefd9c9725e21fd61383ee378ac08679154de55e1fb027f9971baef6",
      "text": "syarat dan ketentuan",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb3e6000562a3edadc42e977d2b56a20b798a72459ce4adb8d01ea08fc565690",
      "text": "kedaluwarsa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f205dc8cd722defcc890749071c52378be3663cd22ea9bad5a87ed3f7c1b4415",
      "text": "Mereka membuat petisi, lalu menggugat perusahaan itu.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3cea90f98a3b7b8de31d14b552dcf5c6e8e8467d2884e59ecb15ab8ce3ef12e",
      "text": "peraturan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f64db04c1c55bd1a9d3be1e1bb6c37291619d9e484abdd81f5a05e5ad82b2c8d",
      "text": "Ini peraturan beasiswa kampus. Bahasanya kaku, ya?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f897315c894d84d9cd9a292b31a4565bb8eca14b0829f786afc0f96c922df9ab",
      "text": "Surat kuasa ini sah karena sudah ada meterai dan tanda tangan pemberi kuasa.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "f92f5f9caba0e7fb8bfe5401cd963851b06af84901d84b4146cf35c8f84f866c",
      "text": "Lihat pasal tujuh. Dalam hal motor rusak, kita wajib membayar semua biaya perbaikan.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9a2e347993a8cc62999081937c22970faa3aebded87ea4d11c0c15b04ea825e",
      "text": "Tulis surat kuasa aja. Kamu pemberi kuasa, dan Raka penerima kuasa.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdcf2c3888c900f5c1ebd1a5d03d9f702f06df37e814d0da9f270b828b5d2239",
      "text": "pengembalian",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe1616bb96b1dcbc4a74d2e98c43f8b61cba5abeb81e55be8354ddc9903e7312",
      "text": "Rekomendasi kami, ketentuan ini dijelaskan dengan bahasa sederhana.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe23e8bf587d5ff25eaa463bf110230926338ca67321af890f03de2b11bdf3a5",
      "text": "meterai",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    }
  ],
