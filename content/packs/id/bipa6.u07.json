    },
    {
      "id": "bipa6.u07.l03",
      "sha256": "85e4c7afe9ae25573230d4d79abad87741a5c9eeb22aa26aa29a84f62420049d"
    },
    {
      "id": "bipa6.u07.l04",
      "sha256": "56f85d97be9ada66c9929fcc07ed70050701ffed73473b9cb919d9f9188fdb14"
    },
    {
      "id": "bipa6.u07.l05",
      "sha256": "edec0d0c2af41fb229ee98afc791176bf39fdaa5a930f4fd2e722d11d54c4fac"
    },
    {
      "id": "bipa6.u07.l06",
      "sha256": "8610e27f6390d5b29fa2d218655879a85ecfcf520db175cebf05057bdf263fc9"
    },
    {
      "id": "bipa6.u07.l07",
      "sha256": "a0fbbe6eb264143dd54e22a48262b021a776d7b9c53668dea68c22fec51e1381"
    },
    {
      "id": "bipa6.u07.l08",
      "sha256": "8c5e617caddc81ade78fa4f03757d1d4e5d3e4be12de4bc664afe34f0bc276fc"
    },
    {
      "id": "bipa6.u07.l09",
      "sha256": "78005742cb7ae745ffad5dad6b5e9aac4d6ec9f323e727c0342662fac4ae8ba6"
    },
    {
      "id": "bipa6.u07.l10",
      "sha256": "5e2bce5eee46d5c05219166c77619f4904e37088e4239fa0802903d797467b68"
    }
  ],
  "audio": [
    {
      "key": "029e03fef257947d045b5f61f7b6e95541cab4c45fe0cba544e60be20c94ab47",
      "text": "Undang-undang melindungi hak setiap warga negara.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "039357118dab35f302c0a4c872924037ea31156e07c59796a04245c946862d24",
      "text": "label",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "057c37a116fd903deb1831fe554ef381d921ceafb23f03c46ed6318c278ccde3",
      "text": "standar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "05b5906b548191df9c89bb11cd29d561d91081113f5d2c9b45fc9510a7ce07c8",
      "text": "Undang-undang dasar adalah hukum tertinggi di negara ini.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "05c87e098606c960ec396ba1f978630b055cc7ca6db9b68ed5a8e3883b03f56a",
      "text": "mematuhi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "05d6be10aa5fd7f3d2daab50c5124004bacaec5948e68a3cdaf9ab436ea09ecf",
      "text": "pembukaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "09ca440be249fd6f29a8bdc23f24f555fd3a632f51967b4b268d5ec5759967d7",
      "text": "Kak Nadia, ijazah saya sudah jadi, tetapi saya harus pulang ke Kairo besok.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed6538e6a87a1b32862a71d4d5e1c59278ce3e7fe5914cb07708173fe7079a2",
      "text": "konstitusi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f9cbaeb48b4fa1ac3fa2499ed4fb64d51d05fcd11d08f7d5fabfe2c80f8db25",
      "text": "mengatur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ff8b4b9ddf0fdb7f4c934375bfded59d3f06d61c79ac05a07dcb33aca79fea9",
      "text": "Peraturan ini mengatur persyaratan izin tinggal bagi orang asing.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "117c5c0dea4b2d6e18b84591a0ea28f3ea26923d332804489f730a50a41e410f",
      "text": "penerima kuasa",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a2b28289cc19f43f840846585fc19e24098d45ebe224e0fbff090456dc32cae",
      "text": "UUD 1945 sudah mengalami empat kali amandemen.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cccfcc82c0cfb7a4894cae7864cd77c24d10c5af97901644a95f125a01a30ff",
      "text": "amandemen",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dc5aa2ca39c19ec3afa3181510bda9588169ffb3675b8101fd8b13542483490",
      "text": "Selamat siang, Mas. Ponsel ini mati setelah dua hari. Ini struknya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "219e3c9526c259f926500ba16203d29e41a3461e77d4cd176128b6bd7dc7abfc",
      "text": "Benar juga. Karena baru dua hari, kami tukar dengan yang baru.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a880f3a908ab8a07fdb569529dc14840e295fa37e550aca555807b39df1885c",
      "text": "Menurut Pasal 31 ayat (1), setiap warga negara berhak mendapat pendidikan.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "307e833f3772ec39fff08c370129f4ca162cb7d65140bc6985bf857eb70421db",
      "text": "Menarik. Di Mesir, konstitusi kami juga diamandemen beberapa kali.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "339bde36e33f97f3c4fac9726e61fa84004f1eb0cc191b1e53b07fbbd7e73a5a",
      "text": "struk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3450c3eab5a7fc7a3edb8851196d1bea4d5e3d40c4bfc868d8e24d055f814ae1",
      "text": "undang-undang dasar",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "36ff2bffa4e7d27446c590298b1bbbaecfe437fd7ff08d7c98712ea1935b498e",
      "text": "Betul, itu kewajibanmu. Tapi kamu juga punya hak, misalnya mendapat penjelasan dari petugas.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b8775b23437ee28e1b098eb6d6a3e0af1f0e04a31210fe1a6648603395349d8",
      "text": "Ada peraturan untuk pengunjung juga. \"Pengunjung dilarang memanjat candi.\"",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf0a988d59409ac11c50fad120cb8f4ff5a293f95dd5d2b3dc60a73aa9d78f3",
      "text": "Betul. Artinya, kita boleh melihat dan memotret, tetapi jangan naik.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c3ee61ec9dbbfc62e4bf97475613edb72e9e49aaf52345180d3e1fe94739eb9",
      "text": "Tulis surat kuasa saja. Kamu pemberi kuasa, dan Dimas penerima kuasa.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea158009310d564f785d1eff6f56e7c9e04d8bc09ee8ab778e84e9f0bb26a30",
      "text": "melindungi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "40b2ee9f21ce55742c8f7017c6b694f957ab42eb2e741a44afa07e29e86a7e73",
      "text": "Artinya, kalau kamu tidak datang. Sekarang lihat Pasal 4 ayat (2).",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "416fcf1310dae572b5235a47ab2bcb114f9fc4e33f1617970bdbd8a1241155a6",
      "text": "Surat ini belum sah karena tidak ada meterai dan tanda tangan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "456706e2ff33191548b27ce58557a4a938938da0c50a8cca687f058e7fe665db",
      "text": "Intinya, peraturan ini mengatur kompetensi lulusan BIPA.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "45e5ea80c5f8cfff5a7088ac2e14c8c4433f50dc484c8cdded3bc7dbf3b3626b",
      "text": "konsumen",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "45f421b67d5b67f79ef3b0bd00b8592947c1816e56d58c0aa00581a121925fb7",
      "text": "kompetensi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a20a1943509c43a21a25ab44a6fb1a70e3e7927656ddc6e95dca6ee32879072",
      "text": "Persyaratannya hanya dua, paspor dan foto.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ba1152b7862f46be59d784e507ee06d5aa49c0f6fd21e2ec1289e6d0708fb08",
      "text": "Tidak. Setelah Reformasi, ada empat amandemen. Pembukaannya tidak diubah.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e3f3ec841885f973aa243f18ef279bc54fa57aa41a6d9bc46dca7757f8c3aab",
      "text": "disahkan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fd587a00729c6301ea3c4717658f3487f50c37d27dadf1f9e0ce0f99534ea2e",
      "text": "hak",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "517cfdf9fabbefe385ebdd6145e7cce642d096ec692bf2b90d8a1db6c9c57cff",
      "text": "Lembaga kursus wajib memenuhi standar yang ditetapkan menteri.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "51b85516e3326bf2c5dc5d4ba07a9121a1ab1515963eac00322734a3f4a19154",
      "text": "lulusan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5456b73715790c9317c9a735e0499d081ab460f2dd71cb3a5bc08968b90e7d52",
      "text": "Saya tidak menyetujui pasal ini, karena data saya akan dibagikan.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "5694e240c719dbde02c12f44fe123010df6f612c32c423db975dd823bc798878",
      "text": "dampak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "58178ecd42b6bbb8ed04e7fba569ddc4592dddff24aa06732e01015ac4b39c1e",
      "text": "Artinya, aturan ini berlaku untuk semua orang.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "593247df00d5d91bcf562b6d2c6b20352d80a03973786d46a5917a26b521c6bf",
      "text": "Sasaran utama program ini adalah mahasiswa baru.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b82e1533b0befe78e9e089e7098ba883f7bba9a56ea9141a981d5bea26b7e28",
      "text": "Tinggal satu lagi. Lulusan BIPA 7 diharapkan bisa membaca dan menulis teks akademik.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c3c6439f22421a85a257d78b962e31e2a9a3630275e9d2ac3baaa6e140d4d61",
      "text": "Perlu meterai?",
      "voice": "id_ardi",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f035127a1268e306e012d1e46c9da3c5db2b421e2119612a6dece81ec835e20",
      "text": "Sasarannya pedagang kantin. Rekomendasi saya, kampus membantu mereka membeli wadah baru.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "6413fe04354b725af6c76d9cf64b2379894e57af82914893aca678735e9305bd",
      "text": "berlaku",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6834dfdc9f7790d905a32aff48a2680c3012d32864aca6636483eb66bddccf81",
      "text": "garansi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ca733f160f06f6214d0295943b39126cf4c969f1e23f9698dd50bcef3f08770",
      "text": "menyetujui",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cd12b53ca109bc8676dbd59b0ff35667d54509bf798c90151caabf8f7fdf072",
      "text": "Lalu sasarannya siapa, dan apa dampaknya?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7106a8e666662a710b1b0d2f1cbd999d507a4646ecb5481f420e960f2b2723be",
      "text": "Maaf, sebelum saya menyetujui, boleh saya bertanya tentang pasal lima?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "73f989b76f7c643565c61f9a896f7e80abbc412ab7750b59e446df21585e6c02",
      "text": "Betul. Permendikbud 27 Tahun 2017 mengatur standar kompetensi lulusan BIPA.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "74871300ed6129aa249fc92eb9ab6d7b505f9acd161c96af7b878aac66b56aa0",
      "text": "Susu ini sudah kedaluwarsa sejak minggu lalu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7acc2ca32eceae2a289dee2a89786a1f87932ab6606a85e76edda122240a84da",
      "text": "sasaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bd298d32de489e4b2684961f5e9724b1d43181fa1a8585288919abe834aea06",
      "text": "Kaku sekali. \"Dalam hal penerima beasiswa tidak hadir …\" Apa artinya?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f7e9b6092834e4f035becba521cb670a8851f8dd4890103ca3caee38de3aaec",
      "text": "kewajiban",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fa1c446f315123f05622abfe4b6b4f0640b0ae18e9990d4052a86ded79edd06",
      "text": "Persyaratan beasiswa ini berlaku untuk mahasiswa asing.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "810d77bc3400914c5c681b7c2b14a529306a2074b6a3ab8c722aa16ed767c2f0",
      "text": "Hak dan kewajiban. Dua kata yang saya kenal dari bahasa Arab!",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "889c09c0989c8c0a5581e09bb7e2cd69aa92fb4805338a1668b0837df35ec34d",
      "text": "Pasal 4 ayat (2) melindungi hak peserta.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d2c8277663a63e8f918797f7286d41985fd4ed9803dc23612956433978395f7",
      "text": "pasal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eeee360cd70adf1e46368b5097ad60585a1f01bcf57898e174eb822ff2e6bb6",
      "text": "Izin tinggalmu habis bulan depan, Mohamed.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f60a2e0dd2c68160849946be9b2140bd0809eae8d1f4715197a01843f423a85",
      "text": "Peraturan ini mulai berlaku pada tanggal diundangkan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "9012ccd93907ea0bfdd933d25892370a1fb79843cb06fa33634b3e4ec95c688b",
      "text": "Saya memberi kuasa kepada Dimas untuk mengambil ijazah saya.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "91c2ded70d79268c42d63a82de00d6221fe02ed0e808d4b9810e38993524211b",
      "text": "ketentuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "92ec3164ac8b8d0e94bded8e253a573f8b48ff41224ac4836e4296e3eacf43e9",
      "text": "surat kuasa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ecaf74a69360a6d23230afbff3481a10af4f8ce4a4dd4365da16bc977a11de",
      "text": "Bang Mohamed, papan ini bilang apa? Bahasanya susah.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a8749211b2ca67e3433500d043ff4f799b05e6a749fbb06b142b4a1625b1532",
      "text": "Kecil sekali untuk sebuah konstitusi. Apakah isinya masih sama sejak 1945?",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b4b03b548b90c859e9c66b4851626d1ccd188f4275a3955b6daac49eec58926",
      "text": "Paling banyak lima ribu rupiah sehari. Jadi kembalikan tepat waktu, ya!",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8e32d11c5a173ab117f2c7a0b90a5253e1cfac8b7441624890a53ff0ed4684",
      "text": "Pelanggaran lalu lintas bisa dikenai denda.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c3726c985a996c91d7d35bc8035fb8cb6dd5e7f4b00873912fe673b9d31d880",
      "text": "warga negara",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a03dd9aacca6b0baeb4b20801943b2930132deb76adff762f4ee5ad8096a70b3",
      "text": "Sebentar. Saya baca syarat dan ketentuannya dulu.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a20e8db8f88e9b53187fcf83602446148d196f374fefe4cb743cf021f0d55bf0",
      "text": "lembaga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2235099c94ad6c4163ef20b5960241abb58af610dbe7d6eb9536cf41a3bf5d1",
      "text": "Hak dan kewajiban harus seimbang.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2ad0f349778f199d3cb115b068e09705eed5dee24effb2c69a839f4b2ba8b0a",
      "text": "denda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2ceb1f215b6c49950a09396cb36e9f5a0b068dd12d3db6a982fd93983d21bb7",
      "text": "Dalam hal hujan, acara dipindahkan ke aula.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ad2c13a43da27402e5ec3670a798d2ec0a726928b5ffd11ca5571e56a56b22",
      "text": "rekomendasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f7ae7292db5eedf3d75eef1c0159a96f14ac32ece0d4a5dfd0c949721a902c",
      "text": "Iya. Sebagai orang asing, saya wajib memperpanjangnya, kan?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6b27d212bd76b020ed95cdf95acc06bc17e7b87dfa54f1a0f40b5da0ffbb87d",
      "text": "Lihat Pasal 3 ayat (2) dalam peraturan itu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f7758ef37580b6705d74f1b976a0619459dac60d697ec4a0f39ac2f27e09d2",
      "text": "Konsumen harus membaca label sebelum membeli makanan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "af695ccc1c64adbd199c00a6f2213217712884cecfae28d6a35a46c814c93e7f",
      "text": "Pemberi kuasa harus menandatangani surat di atas meterai.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b13856e3fa55b69e9ba615acc9694ae640c142177600a69d5e75c95b00f0a1ae",
      "text": "Kak, ternyata kurikulum saya mengikuti peraturan menteri!",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2c3120eab46355d312834bb19f3c9328cc17c2d83fd294dfe54ea1c069706f0",
      "text": "Ah, semua orang langsung menyetujui. Tidak ada yang membaca.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3c4885e7e47bd586bd8f7b0d1aeec88a5e84413d9e2e53bb9de38e693050637",
      "text": "berhak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b480f6877d40c21cde9108d98102f0b595986faf799698d187ecfc685270730a",
      "text": "Setelah amandemen, presiden hanya boleh menjabat dua periode.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "b501c086f8f3650c56b4e346c6596041a6db5679e08d462895f8e9e4d804a382",
      "text": "Mohamed, ini buku saku UUD 1945. Setiap mahasiswa hukum punya satu.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "b643227201d205e0dec3d6e9829f30fbf4940f91525542f23925cf5db8a0d41a",
      "text": "Konstitusi itu disahkan pada tanggal delapan belas Agustus.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7a124e676bb7cd58df54f180cf2b9e190e4cda4c65d56615e59c3c8b8d08739",
      "text": "Ini Candi Muaro Jambi. Kompleksnya luas sekali, ribuan hektare.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8e786908830584d91832b99d71f12c9fa22dc11e94b2be1edd4e856e0bbd233",
      "text": "Yang bertanda tangan di bawah ini memberi kuasa kepada Dimas untuk mengambil paspor saya.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9a1bc62c3e3b2d48e585bc1cbd89499cfcf08331cc34631bfede82da50a21db",
      "text": "Sasaran kebijakan ini adalah semua pedagang di kantin kampus.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "babf7dcf53dafc2c432848237a0595783056c91c52602867d89bb9d5a43f533e",
      "text": "pelanggaran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb427f5337fba9bb3c3b5c06f6046247ce6966b78baac638eaef3fdee1c267a4",
      "text": "persyaratan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb6f893e4a88709ecddc1d5d5b078a681baaefe8fa055dd2626d8c5bf0354fcd",
      "text": "Berapa dendanya?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc1558e8952b3ebfb830e90e5154afe951ed02a6648de2768864c3d648e9dd28",
      "text": "Artinya, sasaran peraturan ini adalah semua lembaga kursus.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd8ffa15a278bb8d572c7d0b5f6b8556bc7480e4118163cc2d88506d36bcec97",
      "text": "Rekomendasi kami, standar ini berlaku mulai tahun depan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "beea9a0be3b07827739dfe4b46adee5b23f95fbf704bdb96655e8da82b31a563",
      "text": "Artinya, kalau bukunya terlambat dikembalikan, kamu bayar denda.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd560c197dd61e7f12e6f5673c8cfa81a490d924be15a61b30a61a47c893535",
      "text": "Baik. Ketentuannya, kantin dilarang memakai plastik sekali pakai.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c113fd02eac086d35da6d5074f7d443cf0ca730ae7cbf4216604c631f9303082",
      "text": "Sebagai tamu, saya wajib mematuhi hukum di sini.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6219980f78c03858d022f33c79ce8ec1269d94ac079ae908d2df0fc6bf6fb51",
      "text": "Setiap lembaga harus memenuhi standar nasional.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9d0cd0a28422efe34ea6f7b2f5cfd1eacd39b41c4792085cff14584885c61e7",
      "text": "Maaf, tetapi barangnya baru. Sebagai konsumen, bukankah saya berhak menukar?",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca6d0df346adf0c7f08770ae82ee90bce1a28b562e75f5de025b854cb39e0f11",
      "text": "Maaf, Mbak, roti ini sudah kedaluwarsa. Bisa ditukar?",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb95383975a5348e60beb911c39029913809f8b0cd6b85f89ff7709d6d36e0c3",
      "text": "Oh, di sini tertulis saya berhak mendapat tiket pulang. Bagus!",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccc5531548b9c1e11cc6e6c3bd365bae9e64a27141e985c37af074dc3dd76bb5",
      "text": "Apakah surat kuasa ini sudah sah, Pak?",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfa609cd77149bbc7fc2bc8f148d8fa04ae3a63ba0b3de1b07c0787b6668351c",
      "text": "Ya, meterai sepuluh ribu. Tanda tangani di atasnya supaya sah.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "cffb79bb01b3585585478188c9d49d27b924eb772a1a60f9cf075c0bafea4756",
      "text": "Negara wajib melindungi hak semua orang.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d224d351eb94a00720534d71e0074e410139bfb2c7d39ae24955b99eb63cdfd2",
      "text": "Ada tujuh level. Saya sekarang di BIPA 6.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d27754109700458be7ed1524c19cf9d63ea34c8d0e178b2b1de6b5b520f48a5a",
      "text": "pemberi kuasa",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4fd7e61c0f9dec89e773a5902c329427c03b13ee01704fb81b7289130ffa549",
      "text": "Hak saya memotret, kewajiban saya menjaga. Adil!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d530a4ef7a0c7fb665b440530eda89da1de36210929b7563de37b519ec8feae1",
      "text": "Setiap warga negara berhak mendapat pendidikan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b1ec02dad90a5885c4ad3d1d9fb12f7c3cd88f0d404cb058e3017b13d7fbca",
      "text": "dalam hal",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d847eb68c5e6072b1b36ae614f6ea9d3bd73c36625e2d60bbf0e5faf1ea9d056",
      "text": "UUD 1945 disahkan sehari setelah Proklamasi Kemerdekaan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8c18b7a2fa451ab4bc92f53acf45ffaeab057c4fdfd024984973484dbacbcf3",
      "text": "sah",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8d77ec5a7fd7c9dd3ae92a081197a41d49e851f158e36505de48a51c150f7fe",
      "text": "Dengan mengklik tombol ini, Anda menyetujui syarat dan ketentuan kami.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1f34844df0c788658fa0a210fc08c9cea10e444f060311e2571b7e4c7ae06be",
      "text": "Mohamed, cepat klik \"Setuju\". Motornya sudah menunggu!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26829d27ae323ad00b8b93e8f5a88e6084f484edba8be6f0697ccdc27d61ae3",
      "text": "Syarat dan ketentuan berlaku sejak tanggal pendaftaran.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e26bfd404aa62fefdbf5e2ab34ec3548e068aea77e82b37c9c480133b695baad",
      "text": "Baik. Ponselnya masih ada garansi satu tahun. Kami bisa perbaiki gratis.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3a0423b973fde9a7cb0f91ce213f93fd9703a4fbf180c4bfacce687e8730b10",
      "text": "ayat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e46cc4c973d5e9675e0ab11dd4843850c5ff3a64df852b3bcf3ee57376289898",
      "text": "Konsumen berhak mendapat informasi yang jelas di label produk.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8ea24c34b7b898a333c347a1051cd6399e163083561d5617bc5260a257ed364",
      "text": "Laporan itu berisi tiga rekomendasi untuk pemerintah daerah.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb0331fadefd9c9725e21fd61383ee378ac08679154de55e1fb027f9971baef6",
      "text": "syarat dan ketentuan",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb3e6000562a3edadc42e977d2b56a20b798a72459ce4adb8d01ea08fc565690",
      "text": "kedaluwarsa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "edf4d976eb0e66a128c7ed07c82431c976c9f10a59f1202a2681ab6194bde33f",
      "text": "Ringkasan kebijakanmu harus satu halaman saja, ya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3cea90f98a3b7b8de31d14b552dcf5c6e8e8467d2884e59ecb15ab8ce3ef12e",
      "text": "peraturan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f64db04c1c55bd1a9d3be1e1bb6c37291619d9e484abdd81f5a05e5ad82b2c8d",
      "text": "Ini peraturan beasiswa kampus. Bahasanya kaku, ya?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f897315c894d84d9cd9a292b31a4565bb8eca14b0829f786afc0f96c922df9ab",
      "text": "Surat kuasa ini sah karena sudah ada meterai dan tanda tangan pemberi kuasa.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "f92f5f9caba0e7fb8bfe5401cd963851b06af84901d84b4146cf35c8f84f866c",
      "text": "Lihat pasal tujuh. Dalam hal motor rusak, kita wajib membayar semua biaya perbaikan.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe1616bb96b1dcbc4a74d2e98c43f8b61cba5abeb81e55be8354ddc9903e7312",
      "text": "Rekomendasi kami, ketentuan ini dijelaskan dengan bahasa sederhana.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe23e8bf587d5ff25eaa463bf110230926338ca67321af890f03de2b11bdf3a5",
      "text": "meterai",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 10,
    "clips": 123,
    "chars": 5203,
    "audio_bytes": 0,
    "missing": 123
  }
}
