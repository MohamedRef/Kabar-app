    },
    {
      "id": "bipa6.u10.l06",
      "sha256": "929bc938e35d3174953bbaff7dba519bcd5b0af6ed24d17e3446329083bfaf52"
    },
    {
      "id": "bipa6.u10.l07",
      "sha256": "840d386b7b63b657a2092c503fd5ea50e3cb7c8f7c99b0abfb68ee46f2462f82"
    },
    {
      "id": "bipa6.u10.l08",
      "sha256": "58f606606ec0bf2d3df175a3b846c42a4074cdd2d691ea83c9ce352f8b58313f"
    },
    {
      "id": "bipa6.u10.l09",
      "sha256": "a5bbb2046753b7dbfdcf09dc89732eb977c177486d0e08649488c7de49370c7f"
    },
    {
      "id": "bipa6.u10.l10",
      "sha256": "96b339d0fa9489dcec5db4a0e902e60cfb4e125699f73cf35a8eb020af257ad2"
    },
    {
      "id": "bipa6.u10.l11",
      "sha256": "2a1cf62725c391a785cfb6feccb0de66a55bbf120f845e8f708b3ed51225bd99"
    },
    {
      "id": "bipa6.u10.l12",
      "sha256": "91fe8cec9ca4a34d2757e52f2a31f816ee371f505cacf97fded95724450b276c"
    },
    {
      "id": "bipa6.u10.l13",
      "sha256": "92607091a31cde3b2deecf31a4d20c242fc33d398533c63baae749e7efb0b1ca"
    }
  ],
  "audio": [
    {
      "key": "016524e5527f3ceaa3a9660e65e832a5e960772df1ba94b48070846e261991c7",
      "text": "situs",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "055c2cd80bd1223c6785a1de6d126aa59a8f50aa7e797c8a207bda5636ac8809",
      "text": "Terima kasih. Penguji bilang jawaban saya meyakinkan.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "07cfe4e6375077442c63172717bd75565e04d3fa1202d964db2ce83d7fbd98de",
      "text": "Proses penerbitan buku ini memakan waktu enam bulan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "0912417435f302a11101313aa425295ff54f3e514fc1191a0546eb9e1af4bacd",
      "text": "Secara keseluruhan, esaimu meyakinkan. Masukan saya hanya satu.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0951e6ceb64d824104b927a01ce1cc3bbf43177b0b1a7d8f9c4be9ad851029d5",
      "text": "penulisan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a61b310ed95faba62929a26791afb16627ad2d0c5e9b714e55a9931093b0e5b",
      "text": "menyatakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c09dcd3a21ca3fe6e9c5e80b8cc13db4f3dff7959c5437f2e894fac7c167e0d",
      "text": "Sulit. Persepsi kita dibentuk oleh keluarga, agama, dan ideologi.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c904370c23f7c2262f4315cbb1ca60076c22e94b91b68a224a28e5f800cd780",
      "text": "kajian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d55a522f1f7c99d46d3c237c0261f6b1b7e244693898a324df122b2537d1b36",
      "text": "Artikel di jurnal ilmiah itu lebih terpercaya daripada situs tanpa nama penulis.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec9bb260b41bc063c99774651af854bf05e9844ee90c25ac02738848978845e",
      "text": "Mohamed, esaimu dikumpulkan Jumat. Kamu sudah mulai?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fdaf849c576ef3b710870ff3498ccebde7b1cea12266ddbd6465484eb514744",
      "text": "Tidak ada nama. Jadi saya harus memeriksa di sumber lain?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "14d74686a71e6171fbaebf66b62ff873889a0abf47dc599db11fea9f07ac5a26",
      "text": "di samping itu",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "1636755363ecd18544c9d96cb83f905aaf82267b3dbeeac5685dd5e90d53ce15",
      "text": "Namun, dalam wawancara saya, warga yang terlibat merasa lebih cepat beradaptasi.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "189719a6508f3537bd4075b78df3e396d9bb6d1dbbdaa0abd6c448526f718fb7",
      "text": "Lihat, Sinabung kelihatan jelas pagi ini. Selamat, esaimu lulus!",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a5106ffeed48a8c5be0d53c9d3f69eac669cfe65e756ba5e312dace59df2139",
      "text": "butir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b62722d1f24da29823e0d721c40a1a052cb1efbed793270456b2ffe5a5e94f7",
      "text": "Jadi, BIPA 6 selesai. Ke mana sesudah ini?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b827aa9364ae7489115cc21114f0b366d6c2bd2438e047ac28993bd80314a30",
      "text": "revisi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "20af2783965c14624cdb2a411025ed0668e4f775569bfa55ce9aa9b5d610351e",
      "text": "Penerbit itu menyukai sampul dengan ilustrasi sederhana.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2114f96383a42d10ea0e76f329dbe9fc840d015e922bd0c56cb8b2fcce601012",
      "text": "Wah, filsafat Arab di kafe Medan! Ini tidak konvensional.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "21f1d2797f95c07ad84664c9b6659852268550970c734789b127ef6bd6949400",
      "text": "kalimat penjelas",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "22cf557c39bc869f2ffa6d91d5ee4d6a721f60c77ce2783569f8f86fe2ec4073",
      "text": "spekulasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "22ffc0d4cb4388b954902f6dce88aff190aa6f5837a14754c4d0f9eedfe91bc5",
      "text": "Ya. Cari di situs badan resmi atau di jurnal ilmiah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "252eb9afa30b68a8c96ef13d9ce5cfe05b383f8414a2458e7be251ef49883c37",
      "text": "Di samping itu, kalimat penjelas memberikan contoh dan data.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "259e3933a73bb1d163d1789e9ed6fac545352f9668b9d49a37ab930beefbc0de",
      "text": "cermat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2871aaa66ed172557c09015ca203961b767cb4b1303095369ba7e1e8b55872dc",
      "text": "konvensional",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2948cd5623fb4525fdc0f309114160237018f86a750fe458a6590ca6a9cbb5c2",
      "text": "Membaca dengan cermat menambah wawasan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a5680aece063736b1cd5cf07df5da26578418efd582e425eb364296e7601278",
      "text": "Kalau begitu, pakai tanda petik. Atau buat parafrasa dengan kata-katamu sendiri.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cf952bffb1e3ecd84ac9d9fc5092a49a99f4d6f2f824b4264b1a97f5f351e4e",
      "text": "meyakinkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d108b86137d69da0efa24c686cb1a38034aa41181985e52b660c82479944e9d",
      "text": "Pertanyaan malam ini mendasar: apakah kita bisa berpikir tanpa bias?",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d120d1aa443fbaa3a2e3bc9475ec3401f3dc78ede7a3780a984f6367009cddb",
      "text": "Jadi apa yang bisa kita lakukan?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d2a5866efd23a406c7087e3a1161ba707bbf7b4f838414367efa9ad6bcc9aaa",
      "text": "Kampus memakai aplikasi untuk memeriksa plagiarisme.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fbaea50fdb78984b15ef38311c96963844ea47d9dc8d8b35ee8ab4a6c6e7dbf",
      "text": "Ia mengutip sebuah rujukan yang belum terbit.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "315f9c9941456831d179acf6acf0cdbd162ed9f7e74d64d4686f88f30fac08b6",
      "text": "mendasar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "323ed2f01359e9b89ef0c155a9eb2d93da2e19f2e0c925f07319379bf5df47b8",
      "text": "Penerbit kampus menerima naskah saya.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "32a06a9a4abeea287d691a0f77acb5411da59fbe274bea05da475969c2682982",
      "text": "urutan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "32e5ece906f5d2c550c50baaded7a6a236e4d16bc0d2a9521a78951554faf4f2",
      "text": "Kutipan yang baik memiliki nama penulis, tahun, dan halaman.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "3599a70e16d3cecaf161f935f42018b7beecc918b125d2c3cea1ad3d679c3502",
      "text": "Surat kuno adalah sumber primer; buku sejarah adalah sumber sekunder.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "3840f828d70e3f24077e990d7c6d503b7e1c559cb7183a3935712e6608680d05",
      "text": "Ia menegaskan bahwa parafrasa tetap memerlukan sumber.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3847f652c48b2cc9cd6d8ac5c0dba96a5afa5b325100760833924cb247199ece",
      "text": "Subjudul pertama saya adalah \"Dampak letusan Sinabung\".",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "39434f2c7c7d5122216170fe3e4e326d3ebd29ccd1b4508e0111cbabd7d2d412",
      "text": "Penguji meminta Mohamed menanggapi kelemahan datanya.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3986401d4028202b1accbaa525d1cddac9350b2a077cae5cebc789f349224969",
      "text": "Singkatnya, letusan itu merugikan petani, tetapi tanahnya kini lebih subur.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ab8674f8f6b0b4c3624a9d6f0eaa087301a433cb1c19b5f636cda9be214b53f",
      "text": "Belum menulis, tetapi kerangkanya sudah ada. Tiga subjudul.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c4b507c15263b58e07aa58ac3790f98dff244aa87fa7ff817781bb338018a8a",
      "text": "Kutipan langsung harus ditulis di antara tanda petik.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d1f8868812e7359f2283f4f34cde109488586f3467c91fc7a32f67f34b8b195",
      "text": "Kajian ini menganalisis bahasa iklan di Medan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d77482bbf8c0c1d0819134a810a5b157a63ab907986d478339996eec4b410c0",
      "text": "kutipan langsung",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d9d598cc51d52698d987beffa9bc0afa8f47cbb13b9df9f8facf4eb21dc712c",
      "text": "Baik, Pak. Saya akan menulisnya sendiri supaya tetap orisinal.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "413c7441ea4d21c581dc2d10d29e923e4632c5a903aaf5c803fd0fe1334985ac",
      "text": "Artikel ini memakai sumber sekunder saja.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "421ead0b6d453169ca711a9d564228250d5611187435cd3172334cdf97513cd8",
      "text": "indikasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "424d5f8337d337867e9fedeabba7462fdf2759aad0571b05eeeec58f01fd847d",
      "text": "Warga desa mengungkapkan harapan mereka untuk pulang.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ba5ed0c6fd4a39df0ec771690f3662efb7641c2a6d34c43726e47cfed61cc9",
      "text": "Tesismu menarik. Tapi apakah warga benar-benar ingin terlibat?",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "4809a5e52a23a05acba2e59a53f06008df42b60ec3061a33d6d6200018d229e0",
      "text": "Penulis merujuk pada data BPS tahun 2020.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "482d8da2ad42c80a11817ca920511b683ce15917f3fe18ce2ed5c0edcb61fd56",
      "text": "Terima kasih atas masukannya. Esaimu meyakinkan, tetapi satu sumbernya anonim.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bc085ade35e23c4a75857becdbe831ac71bed8ed0bc1dc1a90418d7f9846bcb",
      "text": "Dua-duanya. Paragraf kedua perlu revisi, kalimatnya terlalu panjang.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e4469b74f04f6131159a61ed276336bc60cbedca0b6914ec788ccefcd37439a",
      "text": "Jawaban yang meyakinkan. Silakan lanjut.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "539e77080a677abe7fc78f07f286c8fe304e594433a0c6c1447f1309cd50199b",
      "text": "bias",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "550d924275798b2438006dfeef060f507c8ecd3f42f5d989dee774e4f5e97f3d",
      "text": "Kamu mengutip Sitepu, tapi namanya tidak ada di daftar pustaka.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5660733b34cebf57568dcb666e13a7a97046da345f4df677fe8fd326e58c814f",
      "text": "menekankan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "5771d4d0e0f8abb64bab8bfe27b96f70d93543bc7dd152321b8abbfbe1c4913b",
      "text": "Saya hanya memakai sumber yang terpercaya.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "57cc221de31e32823c2f7cb065f36b68371c0500606607521ce255b23d5a292c",
      "text": "kerangka",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "57cedc599d74dd9b19a1cd4c15b89f6d4012bb123c424666b797cab425f6050d",
      "text": "sampul",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a4f21e19f771ed8cd1c22d2fd4b6d7a964ad1e58c7fb37f9a89ef41d7a26b83",
      "text": "Siap. Untuk kata baku, rujukan saya KBBI saja.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c139913828d1ef63d03d336513c0c5416dc174b0282214579e3fbc1a39dc240",
      "text": "Singkatnya, kalimat utama memuat gagasan pokok paragraf.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e16c627d95bf894ba7affbcff4e7b90cb6b632f12706415d7e0b137fcee0395",
      "text": "Kerangkamu bagus. Mungkin urutan butir kedua dan ketiga bisa ditukar.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "5edb9cc04a56d5f81ce22e7a232651d00b03762cd2ba31b8d0f39211f64c57ba",
      "text": "Dan di bab pembahasan, hindari spekulasi. Tulis 'ada indikasi', bukan 'pasti'.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef9cba548e967f5c30e9734e33e9d91590221a5314dc6ae8cd4a92f9e34e635",
      "text": "daftar pustaka",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f500d254520fe0cce2f8ff5a0eaf13a7da7cc75d8270fc1b717114b7d0e37de",
      "text": "ilustrasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6039741211555476457aa80e59a752c42bebea112ec3814f2ea29f9783ac232b",
      "text": "tesis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "611b925e0a413714a69b0eafe62fdd7a3d0732c82e15a46dedf665968fc99b7d",
      "text": "Tidak ada indikasi kuat; itu hanya spekulasi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6549b08b80dda674669520fc3e5c30227c92a69c22129146d76af7577a620a24",
      "text": "orisinal",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "659146790ceb310c2edddaafafe7244ca6b567fbe021f3b0ec05e31b55a07f47",
      "text": "terpercaya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "664b42e4e6457f4acf4995f08332aa01c13f2f6a0276a4dffdf0e68a2dacdf02",
      "text": "Pembahasan harus menganalisis data, bukan spekulasi.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "691684feaa87c715d034262e74393d07eeb919322d4d7725c3d0cff848c54f8c",
      "text": "Kerangka yang baik membuat urutan tulisan lebih jelas.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "693d20bcd839620d703917c89fa171a9d23e751c8d6ce593c86f189a73abed15",
      "text": "Menurut data tahun lalu, lebih dari dua ribu keluarga sudah pindah.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a01c049bcabd7e0c3da52712a6319b85fa74753416bdbcf0c5cefc7c5a7f11c",
      "text": "Bacalah pertanyaan ini dengan cermat sebelum menjawab.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a1eb7f1a1811b7195370be3f0fc05918c5bbe2cd1c09b3face37eb4b423e28d",
      "text": "Betul. Saya juga menulis kriteria untuk memilih sumber.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac0a762f7c18aae8baeec4c4ce2d2ceca655a9abb95830bfc7686577c48bbe8",
      "text": "merujuk",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aef6ec301dba7bd257be2f346c6ff2e46209208441e46f1afb07d24fc4e2199",
      "text": "lebih lanjut",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cf23b0d9f17d2d7c4f5ce436b48efebdf4a5b00f77ddc6f09787db6880773d9",
      "text": "anonim",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e0a3c17d616cc8c8674020837b80b10fe9f4ad39d30a00c10c08295a0bcb950",
      "text": "kriteria",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e31513f53a4626d0dd5aaa670db312800a2af2bd299a3b17ab9c00018a2fc0a",
      "text": "menyunting",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e5f43a7dcad5938bc76711e5bc715215cba1f705d3d4708c84af47fc5c81f3c",
      "text": "Mohamed, kita tukar esai, ya. Kamu baca punyaku, aku baca punyamu.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "7027e3f15a5cf6417009ae8a55442b6ed809e8a5a0bfc905a1858dff2ae8e918",
      "text": "persepsi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "71bc522cf9fe2a1d14aa1ead61385d6c919249541a2fb43109bb4180a87753dc",
      "text": "menganalisis",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "7545542437fb196b01ded54582b35c2ab966aec04499e3d5fb27ee850ec7091b",
      "text": "mengutip",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "75af8c07c4245c7673eef79e93f0ff36359bc2bb24061a68956ccd4c3e90098f",
      "text": "Ke timur, jauh sekali. Raja Ampat, Papua!",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "797a6e7d2667eb501b2d394ac6f73a18b204f575186661188037f4f284bc3710",
      "text": "Perbedaan antara keduanya sangat ___, bukan kecil.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "7be0900f3ceceb3b8194f3ff3eea77d42e3a227488f9a517d187b320a9dfb466",
      "text": "Penyunting koran menyunting berita itu dalam sepuluh menit.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d0d775b4b732df7744a3317883b53901049015efa10a9159ea89865536a2996",
      "text": "wawasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f881c852489fbdf9bd50ffabcadb2504bdd04eb9df3ced87e12544b7c46daee",
      "text": "jurnal ilmiah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fa43a3b6e31be8023928e9c8798499c17dd1fcdd241431780c9db57729ee920",
      "text": "data",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "81a1f4ab039f8fe20698d3150f6d11417ed2ad5f80b091adeee768b58ecb4534",
      "text": "Kerangka esai saya punya tiga subjudul dan sembilan butir.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "83f35f76bb7b4a7a3a9ec958add329ded928cd82ee602affa330839e08431b0d",
      "text": "Terima kasih atas umpan baliknya. Saya akan merevisi paragraf kedua.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "8417fb43576e2480000a10f2e768e3319fe48049e7bc8e3556cfe449ef8ce663",
      "text": "Ya. Tapi penulisan bab tiga perlu lebih banyak sumber primer.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e64401e91663cec03e06e7b630f906f51fdca21d3af31585da0efcf24f713d",
      "text": "Esai ini orisinal, dan semua sumbernya ada di daftar pustaka.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "888aa03c593b453e5e90e61b13bad616a2f1d33ce33c915a72dee52e2b683b31",
      "text": "draf",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8891f20115fca83885ec4cd873a3b1d45346fe2ae1944ed52d991585ce1ff4f2",
      "text": "Setiap artikel ilmiah memiliki daftar pustaka.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "88b6ce43b628f04912cb7babde8779b84c2fc83f1fdbfc663000bd8e12d66d59",
      "text": "Argumen yang meyakinkan tidak menyembunyikan kelemahannya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8948c4f0ab8535b2ebfb606d454738837965dec21abfa443ed2712699df6a775",
      "text": "Filsafat mengajukan pertanyaan yang mendasar.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8aaf0a2095acdeb6d02b90effab7c89dd3df676f79633615d35a3d10abc5f9a6",
      "text": "Sebelum mengutip, saya selalu memeriksa angka itu di sumber lain.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b6bc83d66ebbc0ddc11470b97a6ee2505a11b8e2347db0e7a42d21763043578",
      "text": "filsafat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8beec130aba7a295ade2593d5c2823f53c619a8ad6f1d3934431928f476841e1",
      "text": "Hampir. Kajian pustakanya merujuk pada dua puluh sumber.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d2a771620335e921a7325c998fe8a883de2b44b9ade16b5414f1677f1c356cc",
      "text": "menegaskan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8df45bbe330dd8844f87697c142154c3d8f0f882d5a2b04c8b6700d4630341ca",
      "text": "Penulis mengungkapkan harapannya, dan datanya cukup meyakinkan.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f9c77cdbb1d33018df5f32a57f6d644cf4c48dff074a84ee821f1c161f57e54",
      "text": "penguji",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "927bce7e3f4821849084837805aa435ace54dd9ef9ec97d7e64b82145e5dde40",
      "text": "Penguji kedua menanggapi esai itu dengan pertanyaan yang tajam.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f0515b33b67e60eb09a98fc4ea2d2c8948d9b36e1a8877c61e092b71d5f1e0",
      "text": "halaman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "950a1e9489570fb9e9380b35742a3ea19e40d251978742e5fda11cb9b1de4910",
      "text": "memeriksa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9597cb24e62bda9330a8522f82afab756d892d05af2cb54cd3bdf1283c1da29f",
      "text": "Buku ini terbit pertama kali pada tahun dua ribu dua puluh satu.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "975a1177271b93e3a8ffa6d5c0da83d73796993b11949684c3a230769f667303",
      "text": "Bab dua skripsimu sudah selesai?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "977de9b23ad6767571dc17f43d9dffa4978652da30603c0a1bc0510e3508fe33",
      "text": "Bagus. Tapi dosen menekankan: jangan hanya meringkas, harus menganalisis.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "999b9ceeef79613c673ac380dfc782f2c4b18d9a9834507ab247eab79cc1526b",
      "text": "Bagaimana kalau \"Relokasi warga Sinabung perlu melibatkan warga sendiri\"?",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "99b369cfded96ae82faa820cb5f0e22f9d148f1bcbc46402de020fcfa9101159",
      "text": "Coba lihat. Hmm, butir kedua dan ketiga sebaiknya ditukar.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "99bdc1d4d086debe70eeecf3be43a998733d7c081e171bdf14d21f02cb7b5814",
      "text": "ideologi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ba02f9c05a760dd99e639b9ddb9583bc9b866a3158624f8269e89f9123106fd",
      "text": "Aduh, lupa. Bukunya terbit tahun berapa, ya?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f1c21f5c42477ecaf98b7c793317b6347ebaa876f198a00ecb265312ddb1097",
      "text": "masukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a051dcb4f288f1fd6159c7d9aca86b4be521df1470b9c4d1fa073c50999c89f6",
      "text": "Rani, saya menemukan angka korban Sinabung di grup WhatsApp.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a09ab5e71c1949e2ba2593dfd257a80d31606e701eb8a753200a515237403945",
      "text": "Tanpa data, tesis yang orisinal pun sulit dipercaya.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1f916dbf1689480cd853821215f4d7ea0b3040756753d3410a39961c8dabd6b",
      "text": "Cara berpikir yang konvensional sering penuh bias.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2339c1401c5513ba980dbafb33f4cd353747856622dc96b5411e7e9777a6c67",
      "text": "plagiarisme",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a43e098922088284ba35f2dc7bf3551a006fcaa3bc28f88c7bd3172bdb32dc01",
      "text": "Membaca dengan cermat dan menambah wawasan. Ibnu Rusyd juga berkata begitu.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "a61232d676f33d4780287120dcd8439bc18c4ba42cbbe4f34fd0536930ebf3a6",
      "text": "mengungkapkan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a67265e86244e64247ba1af4704dba42ca022730e92331a6605ee6585c5635d5",
      "text": "Saya ingin menanggapi pertanyaan Bapak dengan data terbaru.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a768607d095ad4bfd87d1c7133723af6961e929b29dfffeaf0b5dfe5cc623db6",
      "text": "Baik. \"Sitepu menyatakan bahwa abu gunung api akhirnya menyuburkan tanah.\"",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa31a138a6c8a1d0edb5c9b9d00cde0d89c59e48f619b410a2dedb312e34cacf",
      "text": "membaca ulang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa44566d47bcf19d35b3c851445733e37ff7ea9032d74fa5116ba7323276d014",
      "text": "Benar. Saya ganti dengan jurnal ilmiah. Umpan balikmu sangat membantu.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "abdc10ac26c8d2bbb346e604e34ed228d8881377554288b2715c65802335eb3a",
      "text": "Aduh. Salah ketik, atau masalah yang lebih besar?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "acae68c5b38e7586f43abc283e5c441b671e2dabb1120f29a4458ed46d14508e",
      "text": "Jauh lebih baik. Sekarang cari data untuk mendukungnya.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0c99c05a30d1e38b37de679fbdd0906a3bb4bcc468429e38783ccda17762330",
      "text": "Artikel itu terbit di jurnal ilmiah pada tahun 2016.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b365edb70ef18b2fbd6a9ab2176c242eb2bf4b44e31b94d63885369c2d4c8fbc",
      "text": "Mohamed, aku sudah membaca drafmu. Banyak tinta merah, ya!",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b38fbcb9b5d6b1ce727e30ecd2954a1d2edb414d132562e49a531894f8b27b95",
      "text": "Umpan balik dari teman membantu saya menemukan kelemahan esai.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b49b4cec22755a50cc3894cdaa1dc24dbb229ab937d6658fb8c6caae20a4b814",
      "text": "menanggapi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5407dc1999240943c57997fe2a5d89f186174589bb5701e339aba2f0767a80e",
      "text": "Hmm, tidak ada. Kalimat utamanya tentang tanah yang subur.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b562ac34b522de75c194f9fcad142cf33451e56e1b3391d8ce129a19a04cdad7",
      "text": "penerbit",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b84e3057434b8d201d46743cddbaab7a3e3a84777d5e3c12e90019377cd4ece5",
      "text": "Terima kasih. Malam ini saya sunting lagi, lalu saya baca ulang dengan suara keras.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8b0faf39066b91ea5260bc7b8bfa1bfb7c8908beaad2653f5a80db2e6a0907c",
      "text": "Betul juga. Urutannya jadi lebih logis.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba66cd43cf4f6ae6bb25f62e2542ab8cd5693d1b02893167912a99c5acdd807d",
      "text": "Maaf, Pak. Saya kira itu kutipan langsung.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba967c656ff6557f1daa852313fee0aabbc8c8e4793875c077a0707aa1dffc53",
      "text": "Ketiga penguji sepakat bahwa jawaban Mohamed sangat meyakinkan.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab98129014acf74657e396ceb5b465e9bc6c9db45913557fa6c5f963ec5ef8a",
      "text": "Kenaikan harga beras adalah ___ bahwa panen gagal.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd10173a31d30db4d62e2f03a9eaaa9f77fa3e32e648e4ad76d298570f98732",
      "text": "Naskah Bapak tentang kata serapan Arab sudah kami baca.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdceb2f44cc4852739e8233cd20349a69bbf18628fbfe596636ad033a86a3089",
      "text": "publikasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf72214a8086bc53f9b66e5d859ed800da34d5d43f8d4922a3d34c5a7dcb4304",
      "text": "Persepsi kita bisa dipengaruhi bias.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfe134f2a3cda0a06a26c62f8da1789b8b1e96156f9108a5a96694df2d080e73",
      "text": "Mohamed, paragraf ini sama persis dengan artikel Sitepu.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "bff5a2b7fad8d492e1f69089202bc5b16a3ee5bd1cc3237c4982cd1b1141f371",
      "text": "Sampulnya memakai ilustrasi kapal Bugis.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c08c0f6651c57201d112aa94b1c708774fd659e49979bb14ab2e818fcd1d5ad9",
      "text": "rujukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0e840e6b91bbbbb197c760d2d799a7164c220938fcd7bddfcea4945b194a5f1",
      "text": "penerbitan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2025252132666b5021fba0ff8c45765477a9bc345264c054162992a3920820b",
      "text": "salah ketik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c30a064354d40f917999ebf77da4346bd070804060d570fce718b45aa9593d40",
      "text": "Penulis menekankan pentingnya membaca sumber dengan cermat.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c88696d6bfc1a18f2440e19dd9423313609358dcc435e01a36425752b5bf0974",
      "text": "Saya sudah membaca ulang tiga kali, tetapi masih ada salah ketik.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c953516d50c359d54ff9e23c025c3ea20f1a6fb1eec1d53cee47aef2f3f25d3d",
      "text": "Bagus. Untuk sampul, kami siapkan ilustrasi. Publikasinya tahun depan.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "c992b26e1d09920aee4ed331173517fe0a5e07cf22ade976010bd6f87b7727c3",
      "text": "terbit",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3b184b6cd4db818da163aab7d383f6771d7d77f17564185d525cc8d5509cf3",
      "text": "Terima kasih, Bu. Memang, data saya hanya dari dua desa. Itu kelemahannya.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd5a0853dfaa0b1ccb5ce1eff6eabb040b566c2adaeacc2a34652ae4aea6f765",
      "text": "kalimat utama",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6973d027293ce1816035cb92256ffd6d6fea891a3ccd9fc38a57fe66d443cc",
      "text": "Lebih lanjut, penelitian ini menunjukkan bahwa hasil panen meningkat.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "d226331e806f67938b7b26063b53a9227d546eafc96bc85d8ae03024fa9edc92",
      "text": "Peneliti itu menegaskan bahwa desa di zona merah tidak boleh dihuni lagi.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5e1aac2c75c44ea9f01a65d549e3be14d5ce6ee2136a01b506fd035020dab9b",
      "text": "Penulis merujuk pada tiga sumber dan menekankan sumber pertama.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6c2fec9d703c839b9a7352136ad50dbba08955150661dfc1987fe721088d285",
      "text": "Buku anak-anak biasanya penuh ___ berwarna.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "d705c00131cb235b247f378b7fc21ac863f673074186917a11d0962767cd137d",
      "text": "Ibnu Rusyd menulis tentang filsafat dan agama.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7474843b5a290e1801921b4184933c7ffd35a2ac8a13187c6b6e70ae68676a4",
      "text": "Setelah membaca ulang draf pertama, saya menemukan lima salah ketik.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a29b5001b9df57895897308a3e7f15ef86fcadf383698376f20c1a1ff418a0",
      "text": "parafrasa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "de056e8efe4ea7ee167157e590e7b77b97ac7e7ed78bc36df49d221d3a41e90c",
      "text": "Terima kasih, Pak. Apakah penerbit tertarik?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e12551526366a11e5db12a568b77baee714fe3359abab91cdf1e0276f435b049",
      "text": "Pak Ginting meminta kami membuat kerangka sebelum menulis esai.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5ad2ee6a9ec05580645162d91e839154f6b4543ebeb30ab1b0f924cb03ff6f7",
      "text": "umpan balik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e90247f27566f4162c62c3bca0b45aadbde4f8d4b0a5d4afd1ef847c50d954b2",
      "text": "Dosen meminta revisi besar karena urutan paragrafnya tidak logis.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9ae2c56b3258b0af70e2426fcb4defca9bf7d032f7376b5de6311a1daae40aa",
      "text": "Tesismu \"Gunung berapi itu berbahaya.\" Terlalu luas, Mohamed.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea9737cf44c3b08ae00526e5d9799c2ba676821ebdce4b3cbb8cbd5a45146db1",
      "text": "sekunder",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec3219bac6c02de519aa4c0197eb49a63192b3b7613f3a7bf037162190ddd523",
      "text": "Dan saya tutup dengan \"Singkatnya, …\". Terima kasih, Rani!",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec44f331ad7ecd900a482f39547b1cdb3c3947772b32d17e0b722a8750fc67eb",
      "text": "subjudul",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecb759a034e4c8db8c003c1cfb14b5f42df184ed2541bfecf156b12d8ab0bdbd",
      "text": "memiliki",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "eecdf0660c357604293f8b22af5d34dbd9f843a5609db08299125db4c33f2c76",
      "text": "singkatnya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef31cb0283fb348c890d041fdfac6e64030208fc33e9dc3669d1273e54d6a066",
      "text": "primer",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1b808f7252fe9673206477105730f2ab150f4ece4be3700830aed21fd48e69c",
      "text": "Tahun 2021. Dan jangan lupa nomor halamannya di dalam teks.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f27100845cecf46b1ba201ca19c8081e3e6f40afe86037ac0ee7c514a0302525",
      "text": "Baik. Tesismu jelas sekali. Masukan saya, paragraf ketiga terlalu panjang.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3a193237d1b6e5688f3e830ab3382b4031a9d80e71197949484c8b0494b639c",
      "text": "Rani memeriksa semua rujukan di daftar pustaka saya.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4ce51bf445ead933ab410af90fc974ef0afb47af8eabaa1e8e5a3dd6cd1f93c",
      "text": "Siapa penulisnya? Kalau anonim, itu tidak terpercaya.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f672894313129c30541c05b64e4c8ecf49241b6691415222fe055b21d3c125f8",
      "text": "Jadi buang saja. Lalu tambahkan \"Di samping itu\" sebelum data curah hujan.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7e1568a61929175ea4ad802463d6405e2b38807d23833e9b2bced04df98d880",
      "text": "Paragrafmu bagus, tapi kalimat ketiganya tentang kopi. Apa hubungannya?",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "f865f42fa92ffba35f25ed0cd7f1a623c7beed589c38ecf13678eda2875b49de",
      "text": "Kajian ini merujuk pada sumber primer dari penerbit kampus.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f92df5e1d465cc016b70e1b3f84966d26baee60d1ddc005804f6ff7eac0ae4c7",
      "text": "Baik. Saya bisa memakai manuskrip Melayu lama.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f934d98ebc01592f3a1efc68fa32b1b6acfa307578bffe7b8201f1396a3e194f",
      "text": "kelemahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffc61641818a4f2a30373ec5e234cb792b45a1613cbfa3da86a4799ca09ef12a",
      "text": "pembahasan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffca8fff9b656cddf4496fda54fb2ee603a1b9b11fb2bd220a53c810f8172f06",
      "text": "Bab empat berisi hasil dan pembahasan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    }
  ],
