    },
    {
      "id": "bipa6.u10.l05",
      "sha256": "3fa3a29fb2fb494c0fc925ccd88b63f82dd3db0a0e0e4f7a5696af3441f3d1f1"
    },
    {
      "id": "bipa6.u10.l06",
      "sha256": "c290d0d0d9858649d6b17fb1cabab1267a37f868a78a832067154a29abc02fd5"
    },
    {
      "id": "bipa6.u10.l07",
      "sha256": "90d71406e4f9269f76baef1831e076e3b596550aa3814c18d9b48b983631fa2d"
    },
    {
      "id": "bipa6.u10.l08",
      "sha256": "2ff7b3f34051ea5f2f51b92ed445abd8f041b76ba719fa516012f1650617f983"
    },
    {
      "id": "bipa6.u10.l09",
      "sha256": "827386c1569f5e2b9613d5985459c9bc17e65ffe9dac24ae94818f9f98502a69"
    },
    {
      "id": "bipa6.u10.l10",
      "sha256": "d4a3de2fca2dc4f7c9a0b7d59851c9d2c22d2c979d3658a8fe5739a5feb08698"
    },
    {
      "id": "bipa6.u10.l11",
      "sha256": "d21b1b76138e1792638b62a226e9a0f5cd5902ee74132d5f411b3a9a63393562"
    },
    {
      "id": "bipa6.u10.l12",
      "sha256": "27f18ac55b797ce8459b266615069ff7f1195cffc486e89ed93bff6d798adc4d"
    },
    {
      "id": "bipa6.u10.l13",
      "sha256": "8f81763898709580b44769c0548c065972fe76a7a76622ea06d5a9ce3f124e0a"
    }
  ],
  "audio": [
    {
      "key": "00abcef15b0018de6146eb7f0f5479e61ff6eaecad3d85425f58fbad9f0bba30",
      "text": "Penulis menekankan pentingnya membaca sumber dengan cermat, karena satu angka yang salah bisa merusak esai.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "016524e5527f3ceaa3a9660e65e832a5e960772df1ba94b48070846e261991c7",
      "text": "situs",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0912417435f302a11101313aa425295ff54f3e514fc1191a0546eb9e1af4bacd",
      "text": "Secara keseluruhan, esaimu meyakinkan. Masukan saya hanya satu.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0945cbf6d595b35d19f0f7d5b771bc7ee57a06a0cb2d804c27c04901285d74ed",
      "text": "Terus aku tutup pakai \"Singkatnya, …\". Makasih, Rani!",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0951e6ceb64d824104b927a01ce1cc3bbf43177b0b1a7d8f9c4be9ad851029d5",
      "text": "penulisan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a61b310ed95faba62929a26791afb16627ad2d0c5e9b714e55a9931093b0e5b",
      "text": "menyatakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c904370c23f7c2262f4315cbb1ca60076c22e94b91b68a224a28e5f800cd780",
      "text": "kajian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d55a522f1f7c99d46d3c237c0261f6b1b7e244693898a324df122b2537d1b36",
      "text": "Artikel di jurnal ilmiah itu lebih terpercaya daripada situs tanpa nama penulis.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f3de7f8496ba578f69ca7d4e7521ba1b25ca8d151809ca5414287ff86e80dfc",
      "text": "Ujian filsafat hari ini hanya punya satu soal. Bacalah pertanyaan ini dengan cermat sebelum menjawab. Banyak mahasiswa salah karena membaca terlalu cepat.",
      "voice": "id_gadis",
      "chars": 154,
      "mime": "audio/mpeg"
    },
    {
      "key": "14d74686a71e6171fbaebf66b62ff873889a0abf47dc599db11fea9f07ac5a26",
      "text": "di samping itu",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "14f4803c97a32ccbe38be367e4ce96d716ce00569cb26d8cf9e05e21dcf53602",
      "text": "Jadi, BIPA 6 udah selesai. Habis ini ke mana?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1636755363ecd18544c9d96cb83f905aaf82267b3dbeeac5685dd5e90d53ce15",
      "text": "Namun, dalam wawancara saya, warga yang terlibat merasa lebih cepat beradaptasi.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "189719a6508f3537bd4075b78df3e396d9bb6d1dbbdaa0abd6c448526f718fb7",
      "text": "Lihat, Sinabung kelihatan jelas pagi ini. Selamat, esaimu lulus!",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a5106ffeed48a8c5be0d53c9d3f69eac669cfe65e756ba5e312dace59df2139",
      "text": "butir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b10b994d9171dece7bd1a6158ff64e595bd76c0fd93f9e782352d8b56d67c5f",
      "text": "Makasih. Penguji bilang jawabanku meyakinkan.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b827aa9364ae7489115cc21114f0b366d6c2bd2438e047ac28993bd80314a30",
      "text": "revisi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "20af2783965c14624cdb2a411025ed0668e4f775569bfa55ce9aa9b5d610351e",
      "text": "Penerbit itu menyukai sampul dengan ilustrasi sederhana.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2114f96383a42d10ea0e76f329dbe9fc840d015e922bd0c56cb8b2fcce601012",
      "text": "Wah, filsafat Arab di kafe Medan! Ini tidak konvensional.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "21f1d2797f95c07ad84664c9b6659852268550970c734789b127ef6bd6949400",
      "text": "kalimat penjelas",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "22cf557c39bc869f2ffa6d91d5ee4d6a721f60c77ce2783569f8f86fe2ec4073",
      "text": "spekulasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "22ffc0d4cb4388b954902f6dce88aff190aa6f5837a14754c4d0f9eedfe91bc5",
      "text": "Ya. Cari di situs badan resmi atau di jurnal ilmiah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "243506cca2a857b0271e13fe08e9ce2c5878c06ab9496bab9afa2e50eaec3f34",
      "text": "Umpan balik dari teman membantu saya menemukan kelemahan esai, walaupun awalnya saya agak tersinggung.",
      "voice": "id_gadis",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "254d862b8530c064d7a6e7595c4c1ae7c7bed5b9f5dce65ebda3228144bfb546",
      "text": "Mohamed, tugasmu harus selesai Jumat. Kamu udah mulai?",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "259e3933a73bb1d163d1789e9ed6fac545352f9668b9d49a37ab930beefbc0de",
      "text": "cermat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2871aaa66ed172557c09015ca203961b767cb4b1303095369ba7e1e8b55872dc",
      "text": "konvensional",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2948cd5623fb4525fdc0f309114160237018f86a750fe458a6590ca6a9cbb5c2",
      "text": "Membaca dengan cermat menambah wawasan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cf952bffb1e3ecd84ac9d9fc5092a49a99f4d6f2f824b4264b1a97f5f351e4e",
      "text": "meyakinkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fbaea50fdb78984b15ef38311c96963844ea47d9dc8d8b35ee8ab4a6c6e7dbf",
      "text": "Ia mengutip sebuah rujukan yang belum terbit.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "315f9c9941456831d179acf6acf0cdbd162ed9f7e74d64d4686f88f30fac08b6",
      "text": "mendasar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "323ed2f01359e9b89ef0c155a9eb2d93da2e19f2e0c925f07319379bf5df47b8",
      "text": "Penerbit kampus menerima naskah saya.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "32a06a9a4abeea287d691a0f77acb5411da59fbe274bea05da475969c2682982",
      "text": "urutan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "32e5ece906f5d2c550c50baaded7a6a236e4d16bc0d2a9521a78951554faf4f2",
      "text": "Kutipan yang baik memiliki nama penulis, tahun, dan halaman.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "33cccb95fa0ecdda6b049ce73ad907c3d9185d2f26543d76c2efd98f0fb8dba7",
      "text": "Siap. Buat kata baku, rujukanku KBBI aja.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "345c16ec098356a256b973d017848713d74509f515556a35bb133f63fc5d2e7b",
      "text": "Baik. \"Sitepu menyatakan bahwa letusan gunung membuat tanah subur.\"",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "3599a70e16d3cecaf161f935f42018b7beecc918b125d2c3cea1ad3d679c3502",
      "text": "Surat kuno adalah sumber primer; buku sejarah adalah sumber sekunder.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "3847f652c48b2cc9cd6d8ac5c0dba96a5afa5b325100760833924cb247199ece",
      "text": "Subjudul pertama saya adalah \"Dampak letusan Sinabung\".",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "39ebb95bb974a3dd9a0611af62ac85ff6d6916018277c5c4c81417e65f59b792",
      "text": "Coba lihat. Hmm, butir kedua dan ketiga mending ditukar.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b16cbff5f9aedbc9ff3fbbd1d423c69ca3673939d2a869d22b294a2dc20af99",
      "text": "Sulit. Persepsi kita dibentuk sama keluarga, agama, dan ideologi.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c4b507c15263b58e07aa58ac3790f98dff244aa87fa7ff817781bb338018a8a",
      "text": "Kutipan langsung harus ditulis di antara tanda petik.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d1f8868812e7359f2283f4f34cde109488586f3467c91fc7a32f67f34b8b195",
      "text": "Kajian ini menganalisis bahasa iklan di Medan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d77482bbf8c0c1d0819134a810a5b157a63ab907986d478339996eec4b410c0",
      "text": "kutipan langsung",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d9d598cc51d52698d987beffa9bc0afa8f47cbb13b9df9f8facf4eb21dc712c",
      "text": "Baik, Pak. Saya akan menulisnya sendiri supaya tetap orisinal.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dadb6ece9cbf3876016983d8d5f0c3e02b0dd0bc962abb51447f72a900f0c2b",
      "text": "Ujian esai Mohamed berlangsung satu jam. Ketiga penguji sepakat bahwa jawaban Mohamed sangat meyakinkan. Mereka hanya meminta satu perbaikan kecil.",
      "voice": "id_gadis",
      "chars": 147,
      "mime": "audio/mpeg"
    },
    {
      "key": "40c0c42269913273ee05f0f805588cb579883a4ec1872cab67e1d6e797d4a5bd",
      "text": "Terus kita bisa apa?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "41de2852e5414ed365193d64f85c87bb59ca03cab873dc9bbb8ec7e4c602457b",
      "text": "Kampus memakai aplikasi untuk memeriksa plagiarisme, jadi mahasiswa harus menulis dengan kata-kata sendiri.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "421ead0b6d453169ca711a9d564228250d5611187435cd3172334cdf97513cd8",
      "text": "indikasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "424d5f8337d337867e9fedeabba7462fdf2759aad0571b05eeeec58f01fd847d",
      "text": "Warga desa mengungkapkan harapan mereka untuk pulang.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "42ba5ed0c6fd4a39df0ec771690f3662efb7641c2a6d34c43726e47cfed61cc9",
      "text": "Tesismu menarik. Tapi apakah warga benar-benar ingin terlibat?",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "4809a5e52a23a05acba2e59a53f06008df42b60ec3061a33d6d6200018d229e0",
      "text": "Penulis merujuk pada data BPS tahun 2020.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bc085ade35e23c4a75857becdbe831ac71bed8ed0bc1dc1a90418d7f9846bcb",
      "text": "Dua-duanya. Paragraf kedua perlu revisi, kalimatnya terlalu panjang.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e4469b74f04f6131159a61ed276336bc60cbedca0b6914ec788ccefcd37439a",
      "text": "Jawaban yang meyakinkan. Silakan lanjut.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e53633dc6bf131dffb61f723ff2de7e2f422037f314aefd1428bed7c6190950",
      "text": "Ya udah, kalimat itu nggak perlu. Terus tulis \"Di samping itu\" sebelum angka hujan.",
      "voice": "id_gadis",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "510f95e1f6993c75f0c7746bac605caa70290531636d0717ef81c768d7ec1134",
      "text": "Makasih. Malam ini aku menyunting lagi, terus membaca ulang keras-keras.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "51764385425cac1062340b6f8ab36cece797eaaa658f9e2a618045e7b117ce38",
      "text": "Penyunting koran menyunting berita itu dalam sepuluh menit, karena berita itu harus segera terbit.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "5198d9d834ac9cd5b9e4c533e915accd44e817b9d70b42e82588bfc3d30442c4",
      "text": "Paragraf ini membahas dampak letusan Sinabung. Ada contoh tentang sawah yang rusak dan data panen. Singkatnya, letusan itu merugikan petani, tetapi tanahnya kini lebih subur.",
      "voice": "id_gadis",
      "chars": 174,
      "mime": "audio/mpeg"
    },
    {
      "key": "539e77080a677abe7fc78f07f286c8fe304e594433a0c6c1447f1309cd50199b",
      "text": "bias",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "53ee7cd290dfab925300ba3c5324f95c7b36e439453b56ee52232168a3e18ac0",
      "text": "Belum nulis, tapi kerangkanya udah ada. Tiga subjudul.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "550d924275798b2438006dfeef060f507c8ecd3f42f5d989dee774e4f5e97f3d",
      "text": "Kamu mengutip Sitepu, tapi namanya tidak ada di daftar pustaka.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "55303d06f7f3269d75be86533d3d4efd85bbc7a62c98807b0d2b2c104bf164fb",
      "text": "Pertanyaan malam ini mendasar: bisa nggak kita berpikir tanpa bias?",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "5660733b34cebf57568dcb666e13a7a97046da345f4df677fe8fd326e58c814f",
      "text": "menekankan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "5771d4d0e0f8abb64bab8bfe27b96f70d93543bc7dd152321b8abbfbe1c4913b",
      "text": "Saya hanya memakai sumber yang terpercaya.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "57cc221de31e32823c2f7cb065f36b68371c0500606607521ce255b23d5a292c",
      "text": "kerangka",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "57cedc599d74dd9b19a1cd4c15b89f6d4012bb123c424666b797cab425f6050d",
      "text": "sampul",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c139913828d1ef63d03d336513c0c5416dc174b0282214579e3fbc1a39dc240",
      "text": "Singkatnya, kalimat utama memuat gagasan pokok paragraf.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c9d2f857434d68dd9ccc3c00e8757e6c1d84150afbcab79f0c6e7ef61f1c5c8",
      "text": "Penulis merujuk pada tiga sumber dan menekankan sumber pertama, karena sumber itu paling baru.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e16c627d95bf894ba7affbcff4e7b90cb6b632f12706415d7e0b137fcee0395",
      "text": "Kerangkamu bagus. Mungkin urutan butir kedua dan ketiga bisa ditukar.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef9cba548e967f5c30e9734e33e9d91590221a5314dc6ae8cd4a92f9e34e635",
      "text": "daftar pustaka",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f500d254520fe0cce2f8ff5a0eaf13a7da7cc75d8270fc1b717114b7d0e37de",
      "text": "ilustrasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6039741211555476457aa80e59a752c42bebea112ec3814f2ea29f9783ac232b",
      "text": "tesis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "611b925e0a413714a69b0eafe62fdd7a3d0732c82e15a46dedf665968fc99b7d",
      "text": "Tidak ada indikasi kuat; itu hanya spekulasi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "646ef0a1bac5df1a4813e324c13dc4cdce6dc1ffc6a549d3f3edaa2d529997bc",
      "text": "Membaca dengan cermat dan menambah wawasan. Ibnu Rusyd juga bilang begitu.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "6549b08b80dda674669520fc3e5c30227c92a69c22129146d76af7577a620a24",
      "text": "orisinal",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "659146790ceb310c2edddaafafe7244ca6b567fbe021f3b0ec05e31b55a07f47",
      "text": "terpercaya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6633621e9c668181f70d09b226def45e4577b89f13d1894c8873099375758ce3",
      "text": "Ujian hampir selesai ketika penguji ketiga bertanya. Penguji meminta Mohamed menanggapi kelemahan datanya. Mohamed menjawab dengan tenang dan memberi contoh.",
      "voice": "id_gadis",
      "chars": 157,
      "mime": "audio/mpeg"
    },
    {
      "key": "664b42e4e6457f4acf4995f08332aa01c13f2f6a0276a4dffdf0e68a2dacdf02",
      "text": "Pembahasan harus menganalisis data, bukan spekulasi.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6658a9d78d0257924aeb018d2cac4c6889319517d26d1f726027c3b29adc092d",
      "text": "Banyak warga bertanya kapan mereka boleh pulang. Peneliti itu menegaskan bahwa desa di zona merah tidak boleh dihuni lagi. Pemerintah akan membangun rumah baru di tempat lain.",
      "voice": "id_gadis",
      "chars": 175,
      "mime": "audio/mpeg"
    },
    {
      "key": "66ad59d79a53ab4dfc0a897fc792fd45b2b56e8507db5742af481b097ca00b41",
      "text": "Maaf, Pak. Saya rasa itu kutipan langsung.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac0a762f7c18aae8baeec4c4ce2d2ceca655a9abb95830bfc7686577c48bbe8",
      "text": "merujuk",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aef6ec301dba7bd257be2f346c6ff2e46209208441e46f1afb07d24fc4e2199",
      "text": "lebih lanjut",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b734f59f6c9118cdf64560cabf8291be0f736827453a9e4962e1ee4eaca7789",
      "text": "Makasih masukannya. Esaimu meyakinkan, tapi satu sumbernya anonim.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cf23b0d9f17d2d7c4f5ce436b48efebdf4a5b00f77ddc6f09787db6880773d9",
      "text": "anonim",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e0a3c17d616cc8c8674020837b80b10fe9f4ad39d30a00c10c08295a0bcb950",
      "text": "kriteria",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e31513f53a4626d0dd5aaa670db312800a2af2bd299a3b17ab9c00018a2fc0a",
      "text": "menyunting",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7027e3f15a5cf6417009ae8a55442b6ed809e8a5a0bfc905a1858dff2ae8e918",
      "text": "persepsi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "71bc522cf9fe2a1d14aa1ead61385d6c919249541a2fb43109bb4180a87753dc",
      "text": "menganalisis",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "7545542437fb196b01ded54582b35c2ab966aec04499e3d5fb27ee850ec7091b",
      "text": "mengutip",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "754f1a5b3dadcf10322e000a928c2aefadaed7c4126161cd49b8b3c5985b941d",
      "text": "Kalau begitu, pakai tanda petik. Atau buat parafrasa dengan bahasamu sendiri.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "75af8c07c4245c7673eef79e93f0ff36359bc2bb24061a68956ccd4c3e90098f",
      "text": "Ke timur, jauh sekali. Raja Ampat, Papua!",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "797a6e7d2667eb501b2d394ac6f73a18b204f575186661188037f4f284bc3710",
      "text": "Perbedaan antara keduanya sangat ___, bukan kecil.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "79e5791a15d4a5f6bc639ef3465fe9b9d1733264afe764d64cc82ac4f5471850",
      "text": "Nggak ada nama. Jadi aku harus memeriksa di sumber lain?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c0121b3bbebb75213bd826fbf77729309c86c4a1907a4097f720d50a3e2f369",
      "text": "Naskahnya selesai bulan Januari. Proses penerbitan buku ini memakan waktu enam bulan. Bukunya baru bisa dibeli bulan Juli.",
      "voice": "id_gadis",
      "chars": 122,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c24366470b6bbc350ccea5e2ecada1b7bfc84bfebfbd3ae918b110c4cdf84a2",
      "text": "Hmm, iya ya. Topiknya kan tanah yang subur.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c7f542c56b7cf0ab1013c7ef8b135021b5c7258107833880b78c352fc8e487f",
      "text": "Draf pertama saya kembali dengan banyak catatan merah. Dosen meminta revisi besar karena urutan paragrafnya tidak logis. Salah ketiknya hanya sedikit.",
      "voice": "id_gadis",
      "chars": 150,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cf7f48b65288282fdff3439897b84acba89bdcc8c7733b80a768f3d9118bea7",
      "text": "Setiap artikel ilmiah memiliki daftar pustaka, sehingga pembaca bisa memeriksa sumbernya.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d0d775b4b732df7744a3317883b53901049015efa10a9159ea89865536a2996",
      "text": "wawasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f881c852489fbdf9bd50ffabcadb2504bdd04eb9df3ced87e12544b7c46daee",
      "text": "jurnal ilmiah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "813c22fbbf64f791f66f94912c1c7d0b0901a1a825beb76f61464e73157f3733",
      "text": "Di internet banyak angka yang salah. Sebelum mengutip, saya selalu memeriksa angka itu di sumber lain. Kalau tidak sama, saya tidak memakainya.",
      "voice": "id_gadis",
      "chars": 143,
      "mime": "audio/mpeg"
    },
    {
      "key": "81a1f4ab039f8fe20698d3150f6d11417ed2ad5f80b091adeee768b58ecb4534",
      "text": "Kerangka esai saya punya tiga subjudul dan sembilan butir.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "82f4a098cd96239f0775f792f19277534c7417e3c58f5d37566f976951b065b2",
      "text": "Rani, aku menemukan angka korban Sinabung di grup WhatsApp.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "8417fb43576e2480000a10f2e768e3319fe48049e7bc8e3556cfe449ef8ce663",
      "text": "Ya. Tapi penulisan bab tiga perlu lebih banyak sumber primer.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e64401e91663cec03e06e7b630f906f51fdca21d3af31585da0efcf24f713d",
      "text": "Esai ini orisinal, dan semua sumbernya ada di daftar pustaka.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "888aa03c593b453e5e90e61b13bad616a2f1d33ce33c915a72dee52e2b683b31",
      "text": "draf",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8948c4f0ab8535b2ebfb606d454738837965dec21abfa443ed2712699df6a775",
      "text": "Filsafat mengajukan pertanyaan yang mendasar.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b6bc83d66ebbc0ddc11470b97a6ee2505a11b8e2347db0e7a42d21763043578",
      "text": "filsafat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d2a771620335e921a7325c998fe8a883de2b44b9ade16b5414f1677f1c356cc",
      "text": "menegaskan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8df45bbe330dd8844f87697c142154c3d8f0f882d5a2b04c8b6700d4630341ca",
      "text": "Penulis mengungkapkan harapannya, dan datanya cukup meyakinkan.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e50c58b5673da6683e89879ea90c3f64929cce8c85a9da5f71dd8ec8b4783e0",
      "text": "Hampir. Kajian pustakanya merujuk ke dua puluh sumber.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f9c77cdbb1d33018df5f32a57f6d644cf4c48dff074a84ee821f1c161f57e54",
      "text": "penguji",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9076f1b3525f7a35994348b44b3ae96b7162e47b5ca9fba0dd99cf20dbd0c6de",
      "text": "Oke. Tesismu jelas banget. Masukanku, paragraf nomor tiga terlalu panjang.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "90cda6f4caa6fb476078475f246d5159f97e5ea8880858983edae2db3e069539",
      "text": "Terus di bab pembahasan, jangan pakai spekulasi. Tulis 'ada indikasi', bukan 'pasti'.",
      "voice": "id_gadis",
      "chars": 105,
      "mime": "audio/mpeg"
    },
    {
      "key": "927bce7e3f4821849084837805aa435ace54dd9ef9ec97d7e64b82145e5dde40",
      "text": "Penguji kedua menanggapi esai itu dengan pertanyaan yang tajam.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "94f0515b33b67e60eb09a98fc4ea2d2c8948d9b36e1a8877c61e092b71d5f1e0",
      "text": "halaman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "950a1e9489570fb9e9380b35742a3ea19e40d251978742e5fda11cb9b1de4910",
      "text": "memeriksa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "999b9ceeef79613c673ac380dfc782f2c4b18d9a9834507ab247eab79cc1526b",
      "text": "Bagaimana kalau \"Relokasi warga Sinabung perlu melibatkan warga sendiri\"?",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "99bdc1d4d086debe70eeecf3be43a998733d7c081e171bdf14d21f02cb7b5814",
      "text": "ideologi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b5118bafd921fb27302878ea304e4ae99e0d4946fb5dfbcf97dfb32756318db",
      "text": "Paragrafmu bagus, tapi kalimat nomor tiga tentang kopi. Kenapa ada kopi?",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ba02f9c05a760dd99e639b9ddb9583bc9b866a3158624f8269e89f9123106fd",
      "text": "Aduh, lupa. Bukunya terbit tahun berapa, ya?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d90189ec88dba4c2502bd104dadd2203ebb5bd434d60422d6dbd1c966ef7a42",
      "text": "Mohamed, kamu baca esaiku, aku baca esaimu, ya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f1c21f5c42477ecaf98b7c793317b6347ebaa876f198a00ecb265312ddb1097",
      "text": "masukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a09ab5e71c1949e2ba2593dfd257a80d31606e701eb8a753200a515237403945",
      "text": "Tanpa data, tesis yang orisinal pun sulit dipercaya.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1f916dbf1689480cd853821215f4d7ea0b3040756753d3410a39961c8dabd6b",
      "text": "Cara berpikir yang konvensional sering penuh bias.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2339c1401c5513ba980dbafb33f4cd353747856622dc96b5411e7e9777a6c67",
      "text": "plagiarisme",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a61232d676f33d4780287120dcd8439bc18c4ba42cbbe4f34fd0536930ebf3a6",
      "text": "mengungkapkan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a67265e86244e64247ba1af4704dba42ca022730e92331a6605ee6585c5635d5",
      "text": "Saya ingin menanggapi pertanyaan Bapak dengan data terbaru.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6bec3d46a59f8e05b51745d60426f6f3691036ffef16076953c3caa844968a1",
      "text": "Minggu depan kita harus mengumpulkan esai. Pak Ginting meminta kami membuat kerangka sebelum menulis esai. Katanya, kerangka membuat tulisan lebih teratur.",
      "voice": "id_gadis",
      "chars": 155,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa31a138a6c8a1d0edb5c9b9d00cde0d89c59e48f619b410a2dedb312e34cacf",
      "text": "membaca ulang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "abdc10ac26c8d2bbb346e604e34ed228d8881377554288b2715c65802335eb3a",
      "text": "Aduh. Salah ketik, atau masalah yang lebih besar?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "acae68c5b38e7586f43abc283e5c441b671e2dabb1120f29a4458ed46d14508e",
      "text": "Jauh lebih baik. Sekarang cari data untuk mendukungnya.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "adcc6417717a9e28914a5a28a5cfe9a77c3a9ba261ea429849c7db7f3db3f470",
      "text": "Mohamed, aku udah baca drafmu. Banyak tinta merah, ya!",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b49b4cec22755a50cc3894cdaa1dc24dbb229ab937d6658fb8c6caae20a4b814",
      "text": "menanggapi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b562ac34b522de75c194f9fcad142cf33451e56e1b3391d8ce129a19a04cdad7",
      "text": "penerbit",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6ac7359b650ee9ba1dbd3a7d640831deed1aca3ad7cdded2cf2959c0628834d",
      "text": "Betul. Aku juga nulis kriteria buat memilih sumber.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8b0faf39066b91ea5260bc7b8bfa1bfb7c8908beaad2653f5a80db2e6a0907c",
      "text": "Betul juga. Urutannya jadi lebih logis.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab98129014acf74657e396ceb5b465e9bc6c9db45913557fa6c5f963ec5ef8a",
      "text": "Kenaikan harga beras adalah ___ bahwa panen gagal.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd10173a31d30db4d62e2f03a9eaaa9f77fa3e32e648e4ad76d298570f98732",
      "text": "Naskah Bapak tentang kata serapan Arab sudah kami baca.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd98840ed6bc4db3831628a2d33d5adb8756a20d7efbf62c6e9607a19a21696d",
      "text": "Mohamed, kalimat ini sama dengan tulisan Sitepu.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdceb2f44cc4852739e8233cd20349a69bbf18628fbfe596636ad033a86a3089",
      "text": "publikasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf72214a8086bc53f9b66e5d859ed800da34d5d43f8d4922a3d34c5a7dcb4304",
      "text": "Persepsi kita bisa dipengaruhi bias.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bff5a2b7fad8d492e1f69089202bc5b16a3ee5bd1cc3237c4982cd1b1141f371",
      "text": "Sampulnya memakai ilustrasi kapal Bugis.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c065f8e1614297d293bc4db3180879cd06ba4aad5d7fe15b33b7838bc639f1d6",
      "text": "Siapa penulisnya? Kalau anonim, itu nggak terpercaya.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "c08c0f6651c57201d112aa94b1c708774fd659e49979bb14ab2e818fcd1d5ad9",
      "text": "rujukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0e840e6b91bbbbb197c760d2d799a7164c220938fcd7bddfcea4945b194a5f1",
      "text": "penerbitan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2025252132666b5021fba0ff8c45765477a9bc345264c054162992a3920820b",
      "text": "salah ketik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3a82c464850e8770e274b2b74986c20767574a544a5414c2c12cd86339015c3",
      "text": "Ibnu Rusyd menulis tentang filsafat dan agama, sehingga namanya dikenal di Timur dan di Barat.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "c51e4eddf6c0663eb68e97362b871bc3be3efd08c8bb0d8f8c3b8d50136fed5e",
      "text": "Bagus. Tapi dosen menekankan: jangan cuma meringkas, harus menganalisis.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7f20ea090ebd7e0778c46e1bdb6d4f7a7b1c27155d9ffb8cc822f00539b42d5",
      "text": "Saya meminjam buku Sitepu dari perpustakaan. Buku ini terbit pertama kali pada tahun dua ribu dua puluh satu. Edisi keduanya keluar tahun lalu.",
      "voice": "id_gadis",
      "chars": 143,
      "mime": "audio/mpeg"
    },
    {
      "key": "c88696d6bfc1a18f2440e19dd9423313609358dcc435e01a36425752b5bf0974",
      "text": "Saya sudah membaca ulang tiga kali, tetapi masih ada salah ketik.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c953516d50c359d54ff9e23c025c3ea20f1a6fb1eec1d53cee47aef2f3f25d3d",
      "text": "Bagus. Untuk sampul, kami siapkan ilustrasi. Publikasinya tahun depan.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "c992b26e1d09920aee4ed331173517fe0a5e07cf22ade976010bd6f87b7727c3",
      "text": "terbit",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f67d358eb4d113c6b0bcf79548d093442f520e496f153f603c96b0f449bb39",
      "text": "Tahun 2021. Jangan lupa nomor halamannya di dalam teks juga.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb3b184b6cd4db818da163aab7d383f6771d7d77f17564185d525cc8d5509cf3",
      "text": "Terima kasih, Bu. Memang, data saya hanya dari dua desa. Itu kelemahannya.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd5a0853dfaa0b1ccb5ce1eff6eabb040b566c2adaeacc2a34652ae4aea6f765",
      "text": "kalimat utama",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6973d027293ce1816035cb92256ffd6d6fea891a3ccd9fc38a57fe66d443cc",
      "text": "Lebih lanjut, penelitian ini menunjukkan bahwa hasil panen meningkat.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "cea015acd9a1bb0e75633562c2afdcfc1a7ef81ddb1d50b08f22842a94458023",
      "text": "Esai saya membahas warga yang pindah dari zona merah. Menurut data tahun lalu, lebih dari dua ribu keluarga sudah pindah. Sebagian besar sekarang tinggal di rumah baru.",
      "voice": "id_gadis",
      "chars": 168,
      "mime": "audio/mpeg"
    },
    {
      "key": "cefc2a111bf6abfb7c659412a8e805b5265392b3d40204b0a3b414576ccde19d",
      "text": "Ia menegaskan bahwa parafrasa tetap memerlukan sumber, walaupun kata-katanya sudah berbeda.",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf78712c316d1d0fc5b5fb5a30a805f03bd05192059a2ece330a2072093b4507",
      "text": "Kerangka yang baik membuat urutan tulisan lebih jelas, jadi pembaca tidak bingung.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1aac84f4d6b88a33cb5cb55adb6cda793ca794e1d7144b6ec685b5d30b30e88",
      "text": "Terima kasih atas umpan baliknya. Saya setuju bahwa paragraf kedua kurang jelas. Saya akan merevisi paragraf kedua malam ini.",
      "voice": "id_gadis",
      "chars": 125,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20cb82f9cf2a1b85703969deb1208937e425db936e0e8212e0d9b8de2a2a668",
      "text": "Bener. Aku ganti pakai jurnal ilmiah. Umpan balik kamu ngebantu banget.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2faf266e2aa5067946d0af9ecc77bfd8c9ff59519de2c446548a8eb4996c4bb",
      "text": "Artikel itu terbit di jurnal ilmiah pada tahun 2016, tetapi datanya masih dipakai sampai sekarang.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "d44ec697842c39e0266c5a71ef63135e701158c03f7e7af999688479d0a2625b",
      "text": "Bab dua udah selesai?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6c2fec9d703c839b9a7352136ad50dbba08955150661dfc1987fe721088d285",
      "text": "Buku anak-anak biasanya penuh ___ berwarna.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7474843b5a290e1801921b4184933c7ffd35a2ac8a13187c6b6e70ae68676a4",
      "text": "Setelah membaca ulang draf pertama, saya menemukan lima salah ketik.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a29b5001b9df57895897308a3e7f15ef86fcadf383698376f20c1a1ff418a0",
      "text": "parafrasa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7ab7239805b47edaac3dc76e1985df28022d4f4a44aa8a97b641f29e800af1e",
      "text": "esai",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dab02967237e9ac813693b07e1f9c832e6c73b2a4fe807c3dc299ad0c166f7c8",
      "text": "Argumen yang meyakinkan tidak menyembunyikan kelemahannya, tetapi menjelaskannya dengan jujur.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd64703c37651de8f6ff871710f4cad63126080608548a7cfd8fb8a1dc37d0ce",
      "text": "Di samping itu, kalimat penjelas memberikan contoh dan data supaya kalimat utama lebih kuat.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "de056e8efe4ea7ee167157e590e7b77b97ac7e7ed78bc36df49d221d3a41e90c",
      "text": "Terima kasih, Pak. Apakah penerbit tertarik?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "de3e254330c7ee1a2112970c0fe05a366c48d1faefd0cdc7baee2b8618ede1be",
      "text": "Skripsi ini punya lima bab. Bab empat berisi hasil dan pembahasan. Bab lima berisi kesimpulan dan saran.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5ad2ee6a9ec05580645162d91e839154f6b4543ebeb30ab1b0f924cb03ff6f7",
      "text": "umpan balik",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e79fc524ff03efcedd6b4ad7aa9c27e3b3ac430a9356b295db10d57de0a3915b",
      "text": "Artikel ini memakai sumber sekunder saja, padahal sumber primernya mudah ditemukan di perpustakaan.",
      "voice": "id_gadis",
      "chars": 99,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9ae2c56b3258b0af70e2426fcb4defca9bf7d032f7376b5de6311a1daae40aa",
      "text": "Tesismu \"Gunung berapi itu berbahaya.\" Terlalu luas, Mohamed.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea9737cf44c3b08ae00526e5d9799c2ba676821ebdce4b3cbb8cbd5a45146db1",
      "text": "sekunder",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec44f331ad7ecd900a482f39547b1cdb3c3947772b32d17e0b722a8750fc67eb",
      "text": "subjudul",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecb759a034e4c8db8c003c1cfb14b5f42df184ed2541bfecf156b12d8ab0bdbd",
      "text": "memiliki",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "eecdf0660c357604293f8b22af5d34dbd9f843a5609db08299125db4c33f2c76",
      "text": "singkatnya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef31cb0283fb348c890d041fdfac6e64030208fc33e9dc3669d1273e54d6a066",
      "text": "primer",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3a193237d1b6e5688f3e830ab3382b4031a9d80e71197949484c8b0494b639c",
      "text": "Rani memeriksa semua rujukan di daftar pustaka saya.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f865f42fa92ffba35f25ed0cd7f1a623c7beed589c38ecf13678eda2875b49de",
      "text": "Kajian ini merujuk pada sumber primer dari penerbit kampus.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f92df5e1d465cc016b70e1b3f84966d26baee60d1ddc005804f6ff7eac0ae4c7",
      "text": "Baik. Saya bisa memakai manuskrip Melayu lama.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f934d98ebc01592f3a1efc68fa32b1b6acfa307578bffe7b8201f1396a3e194f",
      "text": "kelemahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffc61641818a4f2a30373ec5e234cb792b45a1613cbfa3da86a4799ca09ef12a",
      "text": "pembahasan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    }
  ],
