    },
    {
      "id": "bipa7.u04.l07",
      "sha256": "a66ae92744e7601aca0cf0cab62ae8b76625571e6e4afd1978d29836ce0693f3"
    },
    {
      "id": "bipa7.u04.l08",
      "sha256": "2d9cfc26fd428fbadf071113b4d98b67a0e5f8406e92ff9e189d7a5ac90157a8"
    },
    {
      "id": "bipa7.u04.l09",
      "sha256": "ed8d3db6aa425929d24faf28ed0ba640cf40292c26d30cdf25e122f7005b012b"
    },
    {
