    },
    {
      "id": "bipa7.u04.l12",
      "sha256": "76974ab96c83cf8566dbb552558e07eca1ac4120bde7d788049c9128de159341"
    },
    {
      "id": "bipa7.u04.l13",
      "sha256": "66e794f047d0fb6df15b755664bc8885eb692dedfb09d86f29524ac1862e9f7a"
    },
    {
      "id": "bipa7.u04.l14",
      "sha256": "9a070138e210133a956210350af4fb8d0f1bf69e6c0ba4cb70e61f4ee518a325"
    }
  ],
  "audio": [
    {
      "key": "01766282b5a53fc0cb77009997fd065a9de2c5050b207305736998ade4008690",
      "text": "rumpun bahasa",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "01b823bc33575081f66a0925444bbc68234f5bd0b7b71aa20b6845fa193cc43d",
      "text": "Baik, Om. Saya mengerti semuanya, tapi saya bicara pakai bahasa yang netral.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "0457e2952446578597784cabbc5682c5ab0a9e4bf3e08b3b726fce9e570abade",
      "text": "cadik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0491a25a521324a949b072435bde5088b715f752b0a2f0a7f48d17eaf6b2f2fe",
      "text": "Ale dari mana? Beta dari Ambon.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0514a24766a3002348cb98390c1456e8514824e0c1c70c8ce6ada30ecacde6bd",
      "text": "Ya. Pewarisannya putus. Generasi muda malu memakainya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "055cc29b39f9b313d158b7e445eb5f9db9d9398358fb092d275b4b842a318334",
      "text": "sengau",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "05748b7e59195f0fc24ba0bf3e5a39252213128efe356d25351f4022e40f2d1a",
      "text": "Dari aksennya, saya menebak daerah asalnya Sumatra Utara.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "05d50d826dc15b2ed8c213252dae5efb304651580fc0c32e259b3ea6904d0ee3",
      "text": "kreol",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "05e020006d166b9ec8eac9bd919e9d028f971604f5dd7793b7805bdb84b920aa",
      "text": "Sabar, perahu su dekat. Sebentar lagi kitong pi.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "066b7005b694487814a6551f5202d46b0168c0d29f12aba9cb75623d81f82eda",
      "text": "Itu tujuan program revitalisasi kami: bangga, bukan malu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "071aeaa33951c75e7accd4f329e8c91384a079c0e6a55f981068ad16c10069e0",
      "text": "Bahasa Indonesia dan bahasa Tagalog berkerabat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "08341a831f4f1a87a2a047770031d00f1760bd18acb8cc3e885f516ef64fc150",
      "text": "Itu terlalu mudah, Om. Dari cara Om bilang \"kitong\"!",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "08e71413fb083f8dc24f4f834f267add4d5faf84be0b6d0118ebf5d6d815c449",
      "text": "bahasa isyarat",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a8254b3c8a251b9879fb29a5e8d50430d8be373d3b0301b4dcc4cd2f86574e8",
      "text": "Korpus kami sudah berisi dua ratus cerita rakyat.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c2383fbe2041b2aab82cb38dce9fd77ac6e2252db945450418f3a116ee60d85",
      "text": "sebaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d0edabf8d2fc72b538ce613328b3b5a1e4a730feb0d72cc6b84e0884d1ee971",
      "text": "Betul! Dia juga bilang, \"Ale pung murid pintar.\" Murid itu ko.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f1f4f98c2078cc4f6f0215de868d433fd8e51639cf7481cfd4c4b98b83a70f3",
      "text": "ragam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "100e081b7693415f4ebb95d26f30d79d90fd9ac1fe23ec5dd9cb5592a567b598",
      "text": "Cengkok dan pelafalannya khas Manado.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "114863dd414a54350a7b011be841e17c5f858afe5126824e4b60bb8ebca6befe",
      "text": "Gimana dengan pelafalan saya? Masih ada cengkok Arab?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "12eb3376d14457dc5ddfa68ddd751496b537fd958ae222f853895bfd91be365a",
      "text": "Suaranya agak sengau karena ia sedang pilek.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "135ef98cf302e193febda6aa5c2f119c75244c1f7830963c18ccba9af77153c8",
      "text": "revitalisasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "14768f6929beec269f5befdfa949dc8d48e8097aa8abb8b7844dd0f77acef886",
      "text": "Di Mesir, banyak anak dwibahasa. Mereka bangga dengan dua bahasa.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "156a8b3bfeaa08fbbaacadba53ec48302650d3d8f6502910099af990a6babc9b",
      "text": "Di kampung saya, cuma orang tua yang masih pakai bahasa daerah.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1736cc5c48c8a379ba000322815346e295891fbfbcb594997faa332ae6770fe0",
      "text": "ale",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "174ae5664cc0f990b433d80dbedb683979d492d5580221c7537f6ca7c411b0ed",
      "text": "Katong samua basudara.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "19280d73d5ad1a28e9a02bfa78c48aeea0c4d01e8c4a4b545e0f65ad77bce16f",
      "text": "netral",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d363cdb25868dd9cb0385940f73bb8afab39373042865f341316e1ada5cd540",
      "text": "Bah! Pemandangannya bagus kali!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "205d096b3bdb73cf7cc31854a72be3864d83f505d4b5aff4db30b567b941f36a",
      "text": "Transkripsi satu jam rekaman butuh satu hari.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "23cac84aa6f2a98eb972e3f62874afa90ccad3df043986923b8e3820052e6e01",
      "text": "kata ganti",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2590cd9fe2a4ae5fa2a0b4f06e76f917b9cfa18da451f027c2f265670cad3ab3",
      "text": "Basudara… kedengarannya dari Ambon!",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "285d9ccc8173550f707ac32fdc9607215d74db1c0171fd0831bae03d68c6564a",
      "text": "terancam punah",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "29529923ddcf81d3f1cdcdc905528b5ae305bf88c614c27c6ecc0f00921fcb27",
      "text": "Dong su pi ke kampung sebelah.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2960ecbd646ae1248d6d9250e2bbe38e2d119a3c2298bef319a63fdefcb49b70",
      "text": "pewarisan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b81bdf31835c3f7129915613f2f3dcc8dd34d5d52f4d465579a97e11c673507",
      "text": "Variasi dialek membuat bahasa Indonesia makin kaya.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e15ff2d616adf5f955ac2bece1091b0dc50ef7f6ce3b62de9af2dbbc36724b0",
      "text": "Kedengarannya Ibu dari Manado. Petunjuknya kata \"nyanda\".",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e3f46582d5aeaa2c76d42b40a3e5aab6220153ecc8cf43b2735e22f30fa47a2",
      "text": "Ngana dari Mesir? Kita pernah lihat piramida di TV.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ed884b43898f222ec6afc0d9d68e2355680772f616dc6991f2041d3d27450f4",
      "text": "BISINDO",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f3b7c37f4e4b47174c25b02e429f7e38471946b3ff1a8dd9ebd0b8bc4f0a75b",
      "text": "katong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f3b9b4ada2f6481ed6924db53250ba1367ab0c42ee621120714f1878e01cd90",
      "text": "Petunjuk pertama saya adalah kata \"bah\" di awal kalimat.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fdb0fa6d9c301d5db4a440632e69cc458edd91f6eba39f89ff230486c6d565c",
      "text": "glosarium",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "343e2f570abea9f4d8fb973e8171a2e863036be72e00757d5c0097cf8835bfef",
      "text": "isoglos",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "34410d10821be7b11732d1ca4d2283f2a894e26f81e35574e4d4b04ca4651403",
      "text": "Ciri khas ragam ini adalah bentuk kata yang pendek.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "36b4b233f7a0d33f42ba1bac6d8bbcc9a4e9abf3be6c55e98964838313ffd024",
      "text": "kesantunan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "37c520658355328f2de926b3d330d95d243647c55b5d8441875e0d098a0a2bbe",
      "text": "Beta seng tahu, ale tanya dia saja.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "3803566997635760b2ae41cc7842a122dad2352605e7e7ad5b4470dd27b391c0",
      "text": "ngana",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aab6e917ee048cac725408f2dd69c14e00b44c15e224f0e353bfe4200f046b9",
      "text": "Om, Kaka Yohana minta saya nulis laporan soal dialek di sini.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b2335a00a24a49725890a1bb7fe01e5709bf06a9e585b9f7ba124425c5f5842",
      "text": "penutur asli",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b717bd79df14e678a93cdceb8620d97816583662fbc709cb4ee97deac461c11",
      "text": "Betul. Nenek moyang kitong berlayar dengan perahu bercadik.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c3386ed17c30296c61d6ee1e682b235848511d5ac336624e8a2cb4973ef093f",
      "text": "Betul. Sa itu saya, kitong itu kita. Tapi ko bicara biasa saja, sa mengerti.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d8e3081387544179d82804f5f5b87e664d751db4519a0046ff19f499da8608e",
      "text": "ko",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eab34487efa37fbc2ae520c73320b5191dc074a37299efb3c5f8fe644467bda",
      "text": "Juru bahasa isyarat itu membantu teman-teman Tuli mengikuti seminar.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f3e336b20f2ea18ff4e89fecebe80b86779c7ea57214f3280b81699ab9ef797",
      "text": "Dengan senang hati, Tante. Rekamannya dari mana?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "405b43f8ff4b877e82b791984144c5afa051909c97b8bb7f1b2c3b210d80e729",
      "text": "Mohamed, ini Tante Grace dari Manado. Dia mau tanya.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "40f46d5a1a90a76ff4d188d59870a516f74627171f04bb61aa90b8c0265daf58",
      "text": "Cengkok orang Makassar mudah dikenali.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "416b5b967a22239db9149169b2bf8ad8162e87dd4a44201a7398fb95d6563f9d",
      "text": "Saya baru tahu dua huruf, Om. Gimana kalau saya salah?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "42e9b5bca2ba3d6babf1f48a8623e075c2f761088a900cbc8ff085eed9931d9f",
      "text": "Beta seng tahu ale pung nama.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "43385aa011cc41e5975d07535ef9f1864faf76ef5b37abe699dd359ad95f803f",
      "text": "Belum semua, Om. Tapi sa tra takut lagi dengar logat yang beda.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "446afb9a81e799992678e7c57586afed7c369a58d3bff557926ef5edc8b692dc",
      "text": "pi",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f8dea44f0a4bff6806de47a02d485c93b0692293834a5ed34ec8cf60f23911",
      "text": "Baik. Dari Sorong sampai Jayapura, lalu ke pegunungan.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4558278983755a0c7b54c2a993e03c3373a6a1673551059afb7c8440eec29433",
      "text": "Baik, Kaka. Sapaan itu terdengar hangat.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "461418fdd89f832d46630366345213ec68717621b482303e1b2bf66e90f13819",
      "text": "Ngana so makan? Torang mau pigi ke pasar.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4742238b32d5320a0694a57cf7adf0e479b53e7a7c836b5d5189eb38725bbd4b",
      "text": "menebak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "47aea9031ac637ac4f0e1c61ddbc2d3119a7e649455dd9246ad006d6b14aaefa",
      "text": "Iya, Om. Di sana saya mau belajar sejarah Indonesia.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "49a27364af0ae38c5748ea345c94394db92e227e4030aa81f1f4745620198e8a",
      "text": "Bahasa apa yang dipakai pedagang dari banyak pulau untuk berdagang?",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ac3d36ea0582f434cda3f6b9301069925de1f7614d8599e36e8c13e1562e3d0",
      "text": "Leksikon bahasa Melayu Papua banyak menyerap kata dari bahasa daerah.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bb46956e65054ce30fb922812880322f9f4e2f9c30dbe05c0b778b0f9fc33ee",
      "text": "Sedikit, Om. Tadi Om bilang \"ko\", artinya \"kamu\", kan?",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "5200a201cd2f45db432bc59e6ddaa6c0f11889876924c51259399918ad3bcd44",
      "text": "su",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "52a3f63cc50cfc882bc02ef37c5716287022acd7c096000787d67cc079a67912",
      "text": "Ahli bahasa itu merekam tiga puluh penutur asli.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "52c3dce4928d477aa317efebb64e79da4667da69c70278e5e03dec84a25aaecd",
      "text": "berkerabat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "53882c8dce316759082373c1e2b816dfd2290ee062460a9b82f053e1976437b3",
      "text": "Penanda utama dialek ini adalah kata ganti dan partikelnya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "539d997d1dab8f56a288b0b8231f91bcacf3acddb65953c4c0672726946ecf8d",
      "text": "lema",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "553a3c239c95a3e168643dd0a9a9d4bb93e0d0edc1d97c63e57262fbd631e33a",
      "text": "transkripsi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5943a8b00e8136eae3b6061ebdb050aa571c40a5f475e08ac2bc2f2214ad1b4e",
      "text": "Terus bahasa Melayu Papua itu kreol atau bukan?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a234d271ffd38e4d6fce65bbc3f5e0fcf55a6a2de78160ca55b13a5481b21e5",
      "text": "Ale seng usah takut, beta di sini.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d52754cba5ac52990c2b02b3de7e9e4d6ce8d6546d82c77855262f19fd77a4e",
      "text": "torang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5da9359d73d3011d0326dc9577affcb3113d494fa4fb7c44bdabec3e8d9b577d",
      "text": "dorang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fa690f9992cb1d7f8aa350bad778b76453530114982edc784a8797eb7da2ef9",
      "text": "Dan bagaimana pendengar bisa membedakannya dari dialek Ambon?",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "60bc9e10657497d09c6f36795ba0f7fa6aa7205e9ad30c2bde43cc4e4b78e7a1",
      "text": "etimologi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "61d62dc4add90cea0dca65c30595e6fcde0c9d32a94a15ec8d94a3f324b35bca",
      "text": "Bahasa Melayu dulu menjadi lingua franca di pelabuhan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "63290c12cef4c1ce876f0c535370a677056cfa4f5324f35fed8d313132c2cc8a",
      "text": "Laporanmu bagus. Tapi tambahin sebarannya, di mana aja dialek itu dipakai.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "65de6b1b55d3be7b9c4b438cde282bd6e130fa82531f0c6d3d6c4130b0a80a14",
      "text": "Garis isoglos ini memisahkan desa yang bilang \"sa\" dan yang bilang \"sy\".",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "66cb93e49850be977203ac0fc4d4380e68534fb2126ae6bfc7cad541a08f4f91",
      "text": "Ahli bahasa itu meneliti etimologi nama-nama pulau.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "673b67db1d7b45b70ebeef112313a6cb717fc29bb1dcea6d94d83194dd6c4356",
      "text": "petunjuk",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "69bf550a0ed0b74d6285d677626471a8d787f0ac21cbed57a5a52fea48ebeba5",
      "text": "Ko su pintar, e. Sekarang ko bisa tebak orang dari mana saja.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "69eb098c16013b4344a5b87f83405c0aad1772c2f88b76e0023591262fd7b868",
      "text": "Dari penutur asli di Sorong dan Fakfak. Tolong bikin transkripsinya, ya.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a8e21b929e37caafe206ddcce206667e24bcbc394695918dfc49a792dac1a23",
      "text": "Keluarga dwibahasa membantu revitalisasi bahasa daerah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c96d624b424c572300d78360f1e79b4ec7fec631451a7c516b0afe55f599536",
      "text": "Bahasa Indonesia dan bahasa Tagalog serumpun dan berkerabat.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f50d35a082d19bd6304328fcd7b6621dccb0b1f5fa5297ac7070a76f6902407",
      "text": "Tidak apa-apa salah tebak. Logat itu mirip sekali.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fe1292c015cb5282d05c990aee9e1185874b8d78c28ccd13e958369885947f2",
      "text": "Dengan penanda yang jelas, kita mudah membedakan asal pembicara.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "737b61b1b4d6727950bda6042469245c04327b09e2d4ab0867c416de5b891782",
      "text": "sapaan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7507be25cf6b1a7dbe6cd42552f63f1af5ebc30dfc4402bbce14f41d2f3a23a4",
      "text": "Petunjuknya \"to\". Saya menebak dia dari Jawa Tengah.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "77c3631c97729c6132fa04ad9ed2abce4ef91c6c9fc3dccfd2263fa4d0f706d7",
      "text": "salah tebak",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b0542e8230209b963f4870cd61a2c83817a9f85e4a8118f1b48585b4ea8b37b",
      "text": "Hebat! Dan saya, daerah asal saya dari mana?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d54279f6f2e1b31888c4a93e8148f1f2b462798a2d091dcfafaea97a158c019",
      "text": "Saya bisa membedakan variasi dialek, tetapi saya tetap berbicara netral.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e412b6b66106c416927296a0d3931afeac888243404e3e67e1b14438ba63603",
      "text": "Menarik banget. Ini kerjaan ahli bahasa beneran!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e7778e47970606fe1f0d95a794ecea53e710a91eaa6a792e5307be4a72cb193",
      "text": "Om Nus bilang, kitong tra pernah lupa sama tamu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "80d300862305cfeac75bb36be40a445c58ded5f53d5831e014eee986cb832d3c",
      "text": "Gue dari Jakarta, tapi di sini saya pakai bahasa yang netral.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "8673cf8d89385d800bb18aad6bb2307f8033a812ef7c5e2313b3612d799a77cb",
      "text": "Ko su capek? Tangganya masih banyak, e!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "885fc4535336c229caa73fdbadb3cc97ead52b3f4d63f6dc80670971db7ced3c",
      "text": "Bahasa Malagasi termasuk rumpun bahasa Austronesia.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a5645213f0c967877e8776b18ebf8ba16d177c9349b700158b6bcbb109e05f0",
      "text": "Di kantor, ia berbicara netral, tetapi di rumah logat daerah asalnya kembali.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bccc580bd8b1926d402671245eb22cc486fbf85fadc8032831514e3c24d2e67",
      "text": "kedengarannya",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8deb620708c2c81f5517873411a7f18fbcbf842243165e3d24034c60b6e93e53",
      "text": "basudara",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e8c903d8f057861d7506242c49acc2d6a6de8d6ff17d35a5d209433a1bd1edc",
      "text": "Beta pung rumah dekat pantai. Ale mau datang?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e9c07bde4226a9f61559bcca21bae5dfc70ecaaa56b8da3d3a03aaf98b7613d",
      "text": "Iya. Tulis juga etimologinya: dari \"kita orang\".",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8edeb3f26cacaea3937407b21bff207732d40bf984c578f79b708ef5c5f02953",
      "text": "ciri khas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f58540c1149a059d827181707507550668da7c02ff6e3d8acc1064223e5c6f3",
      "text": "Dalam BISINDO, abjad jari memakai dua tangan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "914cfd810ba273761601bfbb7a2727a0eec9ae7a27b0cdecdfd392f36be636bc",
      "text": "Bilang terima kasih, Om. Katong samua basudara!",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "96fa48fa09e76d374ceee0be40d4b084214ced80610fb0a754d86504a5f2834a",
      "text": "Ragam pesisir dan ragam pegunungan memiliki variasi kosakata.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9842a9f23793421ba5d3e3f3838fd1c540b1638d2727fd1076305cffea533968",
      "text": "Ya, Om. Keduanya rumpun Austronesia, kan?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aac62db425f1f64487006437d1b9288fe905ec85954408018f4a1b95d269d3e",
      "text": "Dan jangan pakai prokem Jakarta. Pendengar kita bisa bingung.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bb073f7752f5de947ae47481b891c9677cfc85646bf4d1ca89be5c379a01032",
      "text": "Banyak bahasa di Papua tidak termasuk rumpun Austronesia.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c15368c0af3b3f24358edd463ba75e0cd88d0aaa7e571526b703afcd7b459f3",
      "text": "dialek",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cd09202cccdad9b79c6b89916338ecf05992a5cbdfe46f362678ae071c2028f",
      "text": "Jadi bahasanya terancam punah, Tante?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dc9e066ad11eff8bf2733711dc1e087cc3a10f2a83560655f1dd4df8fc7cce9",
      "text": "beta",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ddaa6c95318d126749dc5844e38e57fba0889b982ca101d18593da91fda1162",
      "text": "Di Papua, sapaan \"Mama\" dipakai untuk perempuan yang lebih tua.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "9deb6308141f0368fdeb8c4afe56ec44345921ca48a9ef3b9234f1e0f2572b89",
      "text": "Nggak apa-apa. Lince bilang, dia senang ada orang yang mau belajar BISINDO.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e67e3fbe94aa8ccc1c8c47891dd308ff75410fc056c7fea6307d4aee9e0ffab",
      "text": "wilayah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ea93417d8978d7fb3cfbb50a68efa200ce6ad69bd6ff340a6056e84ed8c8b1b",
      "text": "leksikon",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f61a63783a0e13b85a27f702b44262b1aef9b9228739e2c909eabe1008f1327",
      "text": "Laporan ini memetakan variasi bahasa di wilayah timur Indonesia.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a008286fcfdfb2b23af8c4683c0b4a0888697958a0f09857bebab1e6667dd174",
      "text": "Betul! Kalau kita berdua, torang. Ngana pintar, nyanda salah!",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1f4f60c9bccb0aac256c5aa3a30df1b932e06145f3c435a804b8cb663353197",
      "text": "Tuli",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a23bac3a74067b8751312094b099638e2cc7a292df2392935a351a90bd299cf2",
      "text": "tra",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a350cc472a2899349312c06b9c117683627685968d87a0bbdb8c9288fb4fd027",
      "text": "Dorang so pulang ke Manado.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a44acd70d4669887ccafa27aef3dec43a658e2b6e2c36a6bdb1e909f8b0cd266",
      "text": "Apa ciri khas yang paling penting?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4fe9dd29341c8e8e44ebdc3c235ec635d9520dbe6b1f906cf93f986f2e58e9a",
      "text": "Bah, ikan bakar ini enak kali!",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5a9da004228c380ec81d79a13ae6153dd83f0beda3ecb94e1d3b79450d5efbe",
      "text": "Itu aku belum tahu. Aku tanya Om Nus dulu, deh.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5cda3adbafb49dfd54daa94d8d833d821af836558f076c71d7f15fa09e321e8",
      "text": "Kalo gitu, besok saya ikut kelas bahasa isyarat bareng Lince.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6a9b5698cdd92ac0af4dbef0957be00c47130b5f8fc2b52743f3b906c699911",
      "text": "Mohamed, ini Lince, tetangga saya. Dia Tuli. Coba sapa dia dengan abjad jari.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "a86871264bf9b6f3dd33d4bb649b314683b40cf33f688dd5af049ba9f0dfa587",
      "text": "juru bahasa isyarat",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab0b92285d14685bd59342ac5cacbb40aa950bd72f916be1e42648b9fae4368e",
      "text": "kitong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac2df6cf0658c7694929817e9139e063ff7b453a547daac1bb975a999400772d",
      "text": "aksen",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "acda7728033958d26d9825c20c0594df2bead5434a0af33bc0b1e00520bb3c8f",
      "text": "Etimologi kata \"kursi\" berasal dari bahasa Arab.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae1d062d8e689ceaf474a44edf30ec26768c63b332b785a055a801b04194031a",
      "text": "Oke. Terus kata \"kitong\" kita jadiin lema sendiri?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9bb63cded7cdd913759d9d2eb1388474280e38bbec6fc372d6588608fb3e22",
      "text": "ahli bahasa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "aeb38225f588cd90a3e03e8f71136e8ba36b954a6ca309f293d093b8d789d6bd",
      "text": "bah",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "b03f00d31b80bda4ce3b93f5c2cab41c0bd7a724a5136b16bd8502e6adf0b81c",
      "text": "seng",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b10d4a5a65eaa7f8e9f015972a4f4701d8f1620bd1aa289320cfc5c9f36a9a72",
      "text": "Teman saya Tuli. Kami mengobrol dengan BISINDO.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b327f683a96219ccc9dd1875b0e54ff5068c6cef77f4c51deba02b347e42ea16",
      "text": "Kitong pi pantai sore ini, e?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "b801310cbb8eceb487cc9b0cd5d31515ba4c0f7f6d946e84f9954e17327b5cf0",
      "text": "\"Kita\" itu Tante sendiri, kan? Bukan kita berdua?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8256da3859aead1a6461c8eea7f21350ff3fa1c561b7b5d4bacb559d7744774",
      "text": "Bahasa nenek saya terancam punah.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8df850441adf2194924ca4bd717a4d923e4892236d5cc3ecdd71a2d17812a96",
      "text": "Anak-anak di desa ini dwibahasa sejak kecil.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b92e69c7dde26c782ce8c2ad9fad0010c853b7dfd5579faeb402a10779a5e850",
      "text": "Tiga kalimat, tiga aksen. Medan, Jawa, dan Papua!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1314c183a224bd15c9e4af4fe7e6c24ffeb89d1e24b859f43fffe47f25572f",
      "text": "\"Bokap\" adalah kata prokem untuk ayah.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "baff3119f940bb2087e5bcd044edbd3bbf5db286dc8c63ac6d7b5160a2ce0c01",
      "text": "honorifik",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc138d3eabe6b4c85defdd16e8352cfe5a5538680a1b9e07f81f6b2eadf52702",
      "text": "Program revitalisasi mengajak generasi muda bernyanyi dalam bahasa ibu.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcaf9d780d61afac99d0d48182e5488e6f080af513c24de68fc479e18244c66b",
      "text": "Sebaran dialek Betawi meluas lewat televisi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd3edc8d9ce22ecddcbfc723cfee6a83ca4807e0b23e8b7a74651503237a8e18",
      "text": "Aduh! Jadi dia dari Manado. Om, satu lagi, ya!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1909ff3483b6d7fb3af406252f161e3f76ea0c01e26dfb5fe0f7ee86a50efd5",
      "text": "sosiolinguistik",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1acf5e86dcca86694ddfa89068c6ef305555d8e440465085505408a36462d40",
      "text": "pelafalan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4b130df6363745917d49a583101ebefd0e064795e60453ef300fd5113b234cf",
      "text": "Ahli masih berdebat. Yang pasti, di pasar dia jadi lingua franca.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4feb96964da5aad43c8e200a32484f6bfcf95827289b6a2d5c7792c1c14373f",
      "text": "Dorang nyanda datang, jadi torang makan tinutuan berdua saja.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c669abb9fe6a67d0efa6602a1a3ba4386123037f15fb25fe4360a884bfb1d04d",
      "text": "daerah asal",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c68489b1ee392561db6d13054519733d9a5997f93b56d31dc6c2fdeae952cfe2",
      "text": "Sedikit, tapi justru enak didengar. Yang penting kesantunannya.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c79fd233040c56d6c20a05fc1b7e6ef575fe250402b18c858a92b132757bb98d",
      "text": "tingkat tutur",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "c84292259e61268ebde06e50a27c6d637d538ec8b47256907f816ec6e28853f3",
      "text": "Kata ganti adalah cara paling mudah untuk membedakan dialek.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c967a71dd5dd146b57e07716a13c3928cc032870545e01996f87290c5e697469",
      "text": "prokem",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb10b2509ad86b6f2de60cc47083d576f34240d4d4f8f8441317fa2917ad3000",
      "text": "Mohamed, ko tahu bahasa Biak dan bahasa Tagalog berkerabat?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb16570383a9ad95197310df3b8377b2d59afd775650f0f5b471bca25c064313",
      "text": "Sapaan yang salah bisa terdengar tidak sopan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbaa9e045b4eae5aa4d9a922233d48a9d2df1155bdccd2da861d59f1bf91d50d",
      "text": "Lho, kok perahunya belum datang? Sudah jam sepuluh, to?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbe756124d5f34cd917d60c733e78fa3fca8d655f3b84d7d6f83bec805bc185c",
      "text": "Mohamed, di radio kau panggil pendengar tua dengan \"Mama\" atau \"Bapa\", ya.",
      "voice": "id_gadis",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "cca6caed0dde5ff9d3e88b8d67d1b7f87bf05a429e2c1cd39d9d6828aab11302",
      "text": "Kata ganti, sa, ko, kitong. Itu yang orang dengar pertama kali.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccbf09411497d6d0d0573b6b74f9d8b03e7cb1d7b99f2c754a4bac426caa61bc",
      "text": "Apa langkah pertama setelah merekam penutur asli?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdb6198a8857bb56f8cef163c73d336d83e073727d628fb76a04f37ae13ee872",
      "text": "Mohamed, bantu saya dengan kamus Melayu Papua ini, ya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d131ff1b29f65c3fdc981c9ef390e28c47e5a641bb5baed19f7829ea8e9ea343",
      "text": "Ngana so makan? Kita nyanda lapar.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d135caf9eea5c9fde887113783cc61685896c44870f730ddf01f77102b97b63f",
      "text": "variasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1e59d0155633204b6aa9eeee21e4bee6cf79a6bd8bfb469b62ff2bace4e3a76",
      "text": "Bahasa itu terancam punah karena penuturnya tinggal sedikit.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2c6423c9f04e23d910f8e30611a135dbfc833d30c664658ea7069c387c17743",
      "text": "Dengar, Mohamed. Ini sepupu saya dari Ambon. Dia bilang, \"Beta seng bisa datang minggu ini.\"",
      "voice": "id_ardi",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3113ef11f1d05f04b7a545175835d66bf22b452229f6ab788599ba10a9a53bd",
      "text": "Austronesia",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d314bcd87c8dd41cb5777e3a009a229a0f39609868dd851b17d45ac4c861d9df",
      "text": "pijin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3331ed9119a4d5bc0a2371af128bf81446933f5affea92e8bdea5bd4cac5bc3",
      "text": "Coba ko tebak. Ibu di perahu itu bilang \"Enak, to?\" Dari mana dia?",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "d577eca740d092560c40bed8a9e94df2fbc9909c506ec2d5ff4f6649de7c6c78",
      "text": "gue",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5e0f32664b36f693889cc98ed934d435fdfd21ac9e32b51b3ba083ba931a54d",
      "text": "Ko mau ikut kitong ke Piaynemo?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d65fd47099b987adb3dca077057c70e977513009aebcf7fbb4fd29d024d7976b",
      "text": "Dari aksen dan intonasinya, saya tahu dia orang Jawa.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "dea263a9e310b5b39f20178a2bc9fb4af40cbe0edc1f451a3e952287049f710a",
      "text": "abjad jari",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfa802954689efd05c2df00a5bdd8737aad95e6d88cff0c961f865db66571312",
      "text": "Perahu bercadik bisa berlayar jauh tanpa terbalik.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e288a26d0b7426421b4298f304f08bc104e9a3f7139f24a907c78be0ee36b97e",
      "text": "lingua franca",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3579e284098279ec56b63eb3539ed83d4100ad7f1089c7b88c929a7e8c47e49",
      "text": "Bahasa isyarat bukan bahasa tubuh biasa. Bahasa isyarat punya tata bahasa sendiri.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3b11a7cbc0faba728806c54b70f0c3e5dd720de4616b0c441350e75c96780aa",
      "text": "Dia bilang \"sa tra tahu\". Kedengarannya dia dari Papua.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3bc79c5925242d854887b850dd610817c7692de1a24117a51f205d0707440be",
      "text": "Sa su bilang, ko harus coba ikan bakar di sini.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e58b576a5e524061dd1bd57009c22e1b592dabfec123d11c2558f087ba230b3d",
      "text": "cengkok",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5bb21e0741ce79e67fb05d622f3126fde4baa85536c7c66c767e84c537af5bb",
      "text": "penanda",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e690d66117dd95d0062b62a2249e79b92ae1662b0200c44f9b8ac7c237b295a9",
      "text": "Beta itu saya, seng itu tidak. Jadi dia tidak bisa datang minggu ini?",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6ab823a9ce246204230c979e2f556bd65fdc6313dbf71bd971d0e147978ef44",
      "text": "sa",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "e75bcced61fece562326430355cb0178b20103439943fea582eb87f75776b743",
      "text": "Torang samua basudara.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7a904346f043df733581e3e920ed029d5fd785e59f6a43dc95dd193927f860b",
      "text": "Apa yang paling membantu bahasa yang terancam punah?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8a28bafe8e4d607e7266efd0d35c2ce6e3985337f0f90d78abcaf1572dbdffa",
      "text": "generasi muda",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea33a0792e6c0403dbb7bd74728751e8ddfd26ebb0053a5b6a90c10d66978b8c",
      "text": "serumpun",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb30d90f9cf4eac4e6b0ceba3b4a587091b1b92592540f4059c4312fc1deaca9",
      "text": "Maaf, Ibu daerah asalnya dari mana?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecab79547c15a60a8ff102da6d32844a92f7a588573b71fd01700c91f5b563eb",
      "text": "Hahaha, ko pakai \"sa\" dan \"tra\"! Besok ko ke Wayag?",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee233b0b4cb0eae350b304ae354945b1bb073574f1f1640e8da171ec3c1c95a8",
      "text": "dwibahasa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f006c7691c0ec81f05310a1e4f29283752244ede2129feabc29eeabeca7d0994",
      "text": "intonasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f180eaa49d6ee991c5dc81a1db015b582cbe72fea19b397f03cef3cbf4420c36",
      "text": "Salah tebak! Petunjuknya \"torang\". Orang Ambon bilang \"katong\".",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "f558c90412bc3f2d8ff5431ca7de667149833c6845c9b97abcaa92bb5ee6d53b",
      "text": "Di pojok layar ada juru bahasa isyarat yang menerjemahkan berita.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5add34134ec01d492983f61f718685a25b64681e326831e859bd35146ecd922",
      "text": "nyanda",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5e0f296f094dad2c95c99c2e2b3b2f8e5650d3863cfa219499f03c58f468c32",
      "text": "dialektologi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f88863535a8769a375d612ea2fc3af6d277b53923cbdcab2868c6b7d3d90a90c",
      "text": "Tebak, Mohamed. Bapak itu bilang, \"Torang samua basudara.\" Dari mana dia?",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "f905f2827afdf39a8a2c148e52abfb70e3cb805a0f85a74e35ce383d5d1cf25d",
      "text": "korpus",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe3b9059c667ca0419559ed9146b3afe57e6da5c5c4d569f64c1ba44c6828e90",
      "text": "Daerah asal kakek saya adalah Sumatra Barat.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe9c2ec64ab6733b7e19f6c6a2996386ded480ebe34b36fc127ed198f643a3a0",
      "text": "Bagus. Tulis bahwa ragam di pantai dan di gunung berbeda sedikit.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe9dd47e62aaf468b746fef9e4ac1d89a846f16c60fd1e4c1278a0955d76897c",
      "text": "membedakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffb1f76f73121f0b20cc926241ff6b8a67150d446f127e2c0912fd228be63937",
      "text": "Kata \"nyokap\" berasal dari ragam apa?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 14,
    "clips": 201,
    "chars": 7680,
    "audio_bytes": 0,
    "missing": 201
  }
}
