      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5986e3b504f77d63bed3e553da9e15d6f2a40948f9d517bfd28786b1267533d",
      "text": "Mas Ardi di halte.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5d60afbaf7dccd73065b9581ba775703fe83364cad083a46fcadceeac3e0e81",
      "text": "Dekat sekali, Mas. Dari stasiun, jalan lurus ke depan.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a63ce4d73226b5ed810a6f01b873192503689e919704c52d8e343d2dae328c8a",
      "text": "Kursinya di depan meja.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a678c9a45ec57650ba86f897a3eb77880327d20914ae490d10d5f60c33c75ac2",
