      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12813fa3a5f7537e2c2d5322ef6cd6862776b108f951c6d1246bbbdffac3470",
      "text": "Tasnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b22aaf2653c899c79cd737e328398c46a218f3215f6e7c0e8033f75c8ddcce42",
      "text": "Mau naik bus ___ jalan kaki?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26963dab236a65338f33ef168ebee85aae4b5e5d47f53ddac26b230e7118cdd",
      "text": "tetapi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba4e9e307649122b6b5ab26903cbce9e5183051d49cae75b9002239554823d51",
      "text": "Bukunya di atas meja, dan tasnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc9ecbe2750ae1a208cae9f64ecb5832383ad8732a6027e5419bcca61399c620",
      "text": "Saya mau ke Monas. Sesudah itu, saya pulang ke rumah.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd5a5d6016dbd8148e77ccfcbfb4bef4f424264dd4646baa2b9d14d85b79c222",
