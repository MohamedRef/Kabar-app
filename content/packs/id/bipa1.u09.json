  "language": "id",
  "unit": "bipa1.u09",
  "version": 4,
  "content_hash": "b9b1f1b63c890fd91cdd1c8a4dd9d98852bd3d3094e413bb38bef629582ea170",
  "lessons": [
    {
      "id": "bipa1.u09.l01",
      "sha256": "ac0c30e534f9b801118f8aff17fdb933e3e64ed4f7fb83b93cb105467842390c"
    },
    {
      "id": "bipa1.u09.l02",
      "sha256": "921adff722103d56d6db684d4b87ad5700518a14d61cde7a6c68fefa0570cd7a"
    },
    {
      "id": "bipa1.u09.l03",
      "sha256": "6cc686856bef5609ce3c48b6d375489d30c529e098640cb7a230511d62f3dd23"
    },
    {
      "id": "bipa1.u09.l04",
      "sha256": "fe6ae6aac5f0859f76d1bb3a5f61162ebcf98702abc51f405b98d610a428dc8d"
    },
    {
      "id": "bipa1.u09.l05",
      "sha256": "cdf3d31feecd358c37607dfbebacab284b5dfff8f135d210114fd4ab016a44e7"
    },
    {
      "id": "bipa1.u09.l06",
      "sha256": "bd037c3660cdde55b29f6c93fca9489dd12d8f77f361bd9ea22e8d414f4da182"
    },
    {
      "id": "bipa1.u09.l07",
      "sha256": "d989fbe9a037a334226417dba333074c00cf8f78e2e18d0b83948aca1cd223f2"
    },
    {
      "id": "bipa1.u09.l08",
      "sha256": "01242d84642d4cb8e9d42098dda4e9bf4b127a47d7f8f0be3bf6b740131f07b0"
    }
  ],
  "audio": [
    {
      "key": "029873a2da995986cb5df616914c867ead7fc42b50f551a0d4513686c9463adf",
      "text": "Rina pulang ke rumah.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "07891c3b5260cbfa3e1fe7882431db4806302d4ebe4c80121c4246ee8be43819",
      "text": "Kamu mau ke mana? — Ke masjid.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "09a652c8cd653b3307afc786b0a32aec5e4dcb2721aeb85d433d723dcbfdede5",
      "text": "pintu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a50df8846e663bfdff356daae89f25b7ac9547479c8891dad0341087765f0d2",
      "text": "Jalan lurus, lalu belok kanan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0aa7bdfa4f2e7b52f4bc1b28d84123de70f8b28210aa41978884ebbdd605a408",
      "text": "depan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b2a0a9f0bf9af8993a221e4e3e0d206b8d92ffcec509b498b435ac5de9857fb",
      "text": "kemudian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bf19cd740bf7671aa4925f0676bf770ffc450cca691de0821e379321ebcadfb",
      "text": "Kamar saya di antara dapur dan kamar mandi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c98599c204b60710208ef700de85339bfa0dcbad7873205d7d8bad3d84160d3",
      "text": "Belok kiri di lampu merah, lalu?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f0ec7dc7426ce6b2b5499068914f2dadaf9c1f84a22fbed4537ac2b2e444a55",
      "text": "Dari rumahmu belok kiri di lampu merah?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f68eedffa0b378b34a368e20c2ef2fd63fc1c3df8b6483fe8472bed38e65b0f",
      "text": "Besok kami pergi ___ Kepulauan Seribu.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "10569815faab3e746b749aeccf665653fdce16b06572eb30f971f66bcade1b78",
      "text": "Kemudian jalan lurus. Masjidnya di sebelah kanan.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "109bcc660cb08d3f6780442657e6ee6ae4d6be97e4cc897c9695ef3e79e2af67",
      "text": "dekat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1174c2069da4bb2ed2557f4d2d01e652d20f0f40d538b60d17f42196c0a0031e",
      "text": "kanan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1657de3c0e2c05241afa48bdb6d2fdb977cf014db373a2fc2d15bdbb13eef1f0",
      "text": "Di sebelah kiri, Pak, di samping dapur.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "18c52861195cc9110364b96713794de34418c9c169d5d3f4ecffe699b8160eb5",
      "text": "Mau kopi atau teh?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "199c09a7a91070c719c2e18ce1fffee28ed7d089d7ef5940c45ea161b3d7c524",
      "text": "lampu merah",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1adc67ee6b2df6a38f3f2894aaa0dc89287dda5f051bb5faeefdf1a0a4db9689",
      "text": "kamar mandi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c70aed8dffa4c7429d0c166f01897b1aef8de3262db8d3870203cba0fe5b836",
      "text": "Loketnya di samping pintu masuk.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ecca6849b2b0a2a5446a4d8a2e0b5722f8105c9eafe65f19e500741f8ae0670",
      "text": "jauh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "21fc9d004f5ab11f4e2d4526da064ab131ba9cd615324eba8fa08fb6e16f20ed",
      "text": "belok",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f626fab333f8836bcd33e774ff1420f11f2fcb68ec3c10f48cf251358c9278",
      "text": "Anak-anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "23f2b335c2ec2548fdc72c0c2d24eb845be1e4798a323902cb6704eb51adc09d",
      "text": "atau",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2786920c3e2947df2746249e407ad0e3f8a421c1745ca65c8016ea5ae8e80eae",
      "text": "Tasmu di mana? Coba lihat di dalam tas.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a0b762d46589675c60db57aadb849eafdb6a7446164e70ef248b9f37c1f7b30",
      "text": "Terima kasih banyak, Pak!",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a5d9f6885bf79f1fb121adcd4db2326a4cb21e56d674416adce060a772b109e",
      "text": "jalan kaki",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "306563164b2944e807340df1a3dcdeb56ccb3ea7edb7305249b7e5d70e59abd1",
      "text": "Saya dari Mesir. Sekarang saya di Jakarta.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "319bcc379fbf3df4cecbea50333c314444294a8096556df4aadea25b602ff52e",
      "text": "Saya dari Masjid Istiqlal. Sekarang kamu mau ke mana?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "31ce7426db3292096456929903c3c4fe7b5b57976ecb88a97f76f35af6904666",
      "text": "Kamu dari mana?",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "383a2e80e81307ce379ac19c889e0279638f1f71e409daf111cec1034e04fdac",
      "text": "Jalan lurus, lalu?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "399417e9ed67ca5ed1d909d98d56471e945a3de5544f7be0680c78c54b938c3e",
      "text": "kursi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a745507aaf2adfc4bf9dcd1bad669c6d253bb346468ca8dc0aaace906cb444a",
      "text": "Belok kanan di lampu merah.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b0898a9055a2008b30151917b5162989eacba3921f01d357957b7a9320cda1c",
      "text": "Masjidnya di sebelah kanan.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b553115c9857bb8ce6e5e9876e0fc09398e736c3e41e3168ffad98e21fe16aa",
      "text": "pelan-pelan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf9018b13d6be3af018d6d7814ad3608674b5964e3e4c91f430b72e69831399",
      "text": "Tiketnya di mana? — Di dalam tas.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c175246e1c0df739bf8a35cf86b9eba9ce6904743e4095fc5c430581c9b1035",
      "text": "Monas di antara stasiun dan masjid.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c837b77d61bd422029a29911b31307cddf2b6f4d27cd524d413327219bbbd8b",
      "text": "Jauh atau dekat, Pak?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dd9d42c544496fb385fa1d859fddcda4fe3414231ab56fb1b2c45f9e3f927b4",
      "text": "Dekat. Jalan lurus, lalu belok kiri di lampu merah.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f6c675d5c79b068684d77e6dcc9ec7f8f9cde769ba6010eae5f1f42c3306b8b",
      "text": "Mohamed, kamu dari mana?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "45ce71247a2cbae7bbd1385b156d7cd480182eec73dee77bdf99229de09525a1",
      "text": "Kucingnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a83faf320b10439338b0ca2a87eb3b473147c89527b0b971c5fd33fa03ee4ad",
      "text": "Tasnya di samping kursi… Ah, ini dia tiketnya! Terima kasih, Bu.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "50c465694397bfa944ed8f91d323ba933c2cbf2da9e97ec44362500a8254308e",
      "text": "Tidak, saya jalan kaki. Dekat!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ca25134becb3d6811b6cde2cbc5446eeb06a581d57a6ffbf86cada94ba8488",
      "text": "Kursinya di antara meja dan pintu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5213eece3e0a82d1a82a10e1b47181cb95ff1b360539fd107fc27b704feaae06",
      "text": "Mohamed, kamu di mana?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "53fbc8d17cb37bc63343d5593dad724e77833400b5164f337b3ef09f15a7db80",
      "text": "atas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5522b2696cefc38de3bf04beef8ed2c5bdf5ee7b68efe8c5dd557396d077a5f0",
      "text": "Kamar mandinya di sebelah kanan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "57dbd50673ea34d16861a30d14a4a643c099313fc2514c4171010537c8eb2c98",
      "text": "bawa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "57efc5e8f3f52e872c5aa25c2237e80cead41377b7d9c78f49faa6eb126c161d",
      "text": "kamar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "59b137928332c4addc7901eafb46c02014d81c4d326d2e5f74e3de376fc5df31",
      "text": "halte",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a5471a9bb2189bc545d0752c25be625ef66abd8fb950a5335ae7ca670b386fd",
      "text": "Belok kanan di perempatan, kemudian jalan lurus.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b2b69fb31d5de5ff556a62f8ed3067db399a6a7dd2bfd1dbc605b5cfabf36c2",
      "text": "Museumnya dekat, ___ hari ini tutup.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6199f2af71c091ec6da4782c42acf03390ade13d85794ff61253e424febf2827",
      "text": "pintu masuk",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "631c3663f030a573b15aeb9690f42800c0eaba0729908790f61754c18edce604",
      "text": "Permisi, Bu. Saya mau ke Monas. Jalan lurus, lalu belok kanan, ya?",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "63464643a1b40777259240d280e840a10c75487aee7e4b1c59311a858b0c6300",
      "text": "Monas jauh, ___ kita naik bus.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "674f874d2ba81a427ad5e4b11c37aac79ddf1451f8175b6195b7737e802f8255",
      "text": "dalam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac485743fb85e2dd21e0f08c94fdfcf3623856c61a2fa336593e190fb252a3b",
      "text": "Sama-sama, Mas. Selamat jalan!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "712d8e62fde4451b360d79a124d1b178aa3d422d8ee9d1a11bf9fade53ea65d7",
      "text": "Dari Stasiun Gambir, Mas. Mas Rizal dari mana?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "73261ccf8a1ca831357808f7135b7fc28103d3be8943112d7d52bd7b83e24e64",
      "text": "satpam",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "761a154cf0190c844b4cbc00b301c016c62576bbdeef7c7d6b00f8042d2a4809",
      "text": "Sebelah kiri? Dan musala?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "76a4a84cc3f7be8d583928f8aaf83e0f9a9cdd2abacd458d74046aa58aec4bac",
      "text": "Dekat, Mas. Jalan lurus, lalu belok kiri di lampu merah.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "77872e67235a0a8477540defb0462371eb44290da96c8c9ef939ee4cde623386",
      "text": "Permisi, Pak. Saya mau ke Monas. Jauh atau dekat?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "77a559dd963595eb3ef955a4409717b8dee6ee1840d8fdb86c4090166d4915a8",
      "text": "Jalan lurus, lalu belok kiri di lampu merah. Monas di sebelah kanan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "78dde544c02a004b11efcec6838159174a8e962ac6cdfc223bf713733b95373a",
      "text": "meja",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d1a3ea28cf66bad6b829c657b82aa8de137da525b55aa6ce255ad53cc05dbdd",
      "text": "Di atas meja?",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d748bd029ce50e4e32b9f19b58ca952ef2d98e34e2f8010a7e5188030719cd5",
      "text": "Kamar mandinya di sebelah kiri.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "84253abd9a449853b63e6992716fb894052417fac530344f424595e7492a8955",
      "text": "Masjid Istiqlal dekat Monas.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "84698ae8aba1e1011e1b0b75b493d88a8219c881875704fead043ca624c13155",
      "text": "Permisi, Mbak. Kamar mandinya di mana?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e798466ef17f2fff8bb7b46a934c3d2eac866b505745758805e7fc1953af6f",
      "text": "museum",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "874f06b39e86c0bd86163183398114197a83b96873c706fcc08779af3b64a57a",
      "text": "belakang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab7196b1c79ea21c5240499d92f493e9251df0dbe7c2f3fea763b2b8eea26b9",
      "text": "Ah, kucingnya di atas meja!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bc21040c298ba9aba8a6eaaef0668cf874ceca75ad12c00398cdcffc2bc7755",
      "text": "naik",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cf21c8a00afce61ad3784aab19c0225387966c0b8156a51b5a155e8a2db1de1",
      "text": "Saya di halte, dekat stasiun. Ke sana jauh atau dekat?",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f0e29fe023789af354157eca67026c0db0d5ae0d4255c12f06771761f232059",
      "text": "Musala di sebelah kanan, Pak.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "924e9818e34b269394aec52ce927fb215f94952882709fd5dbd2e748f9b4eaa0",
      "text": "stasiun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "98c1f877ff5192b1baad86002a58b5480e6996a7c12a09b1f123b66301de6d02",
      "text": "Mohamed, kucing saya di mana?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "997857d99c22e1a55c4a8771e77f45fe5f31ea4d4e3dd17f201cd8c2a4975656",
      "text": "Mas Rizal di halte.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b4af008bed8279bfe5f99ea879f84c03c97c68c9565ee4fc2ee63f503c7d8db",
      "text": "lurus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3910d0007887bf0386a61c695fa5cf05b18733722e5a498652a65d1040b407c",
      "text": "bus",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ae4ab7a35969383910a5872cae686e478c56249e996efa357d79491687b066",
      "text": "sebelah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a50fa5121cc1a38ac8a5a9c2f816fa4e6d8e1f930174417a98c620e9223793ad",
      "text": "antara",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c3e9b1a2a97901b1c405793db20cd2ed1126c70354426616870f3ba23fa75e",
      "text": "Bu Yanti, tiket Monas saya di mana, ya?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5d60afbaf7dccd73065b9581ba775703fe83364cad083a46fcadceeac3e0e81",
      "text": "Dekat sekali, Mas. Dari stasiun, jalan lurus ke depan.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a63ce4d73226b5ed810a6f01b873192503689e919704c52d8e343d2dae328c8a",
      "text": "Kursinya di depan meja.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8aca55f2e539a7de8214d7e5593bd9e93c13e090d0a8cf6d86f004d2cc1e0ec",
      "text": "Di bawah kursi, Bu?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a95ba3d7f1f110aaeb2c963c09f7cb690089d449d8febac25fa57dcdc040be79",
      "text": "bawah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1bfdf719d84ba768200d689a87c4b70baa7060c6430c52bcb47a0c87c7f93d",
      "text": "Jalan lurus, lalu belok kiri di masjid.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "adcacd0fa6c5954a7ba1e4d1f3de417b4be99bd20db80937a258a15066f799b7",
      "text": "Tasnya di samping kursi.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae8ac95e61041df6fd239fac5620acf78502b5f92f95e43639944bc1e0546135",
      "text": "dapur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0e0b6cc20a3076bb9ac8aba2319cd4cc105d102eebffc9875ed29d7d8a1ca80",
      "text": "luar",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12813fa3a5f7537e2c2d5322ef6cd6862776b108f951c6d1246bbbdffac3470",
      "text": "Tasnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b22aaf2653c899c79cd737e328398c46a218f3215f6e7c0e8033f75c8ddcce42",
      "text": "Mau naik bus ___ jalan kaki?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26963dab236a65338f33ef168ebee85aae4b5e5d47f53ddac26b230e7118cdd",
      "text": "tetapi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba4e9e307649122b6b5ab26903cbce9e5183051d49cae75b9002239554823d51",
      "text": "Bukunya di atas meja, dan tasnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc9ecbe2750ae1a208cae9f64ecb5832383ad8732a6027e5419bcca61399c620",
      "text": "Saya mau ke Monas. Sesudah itu, saya pulang ke rumah.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdc07fbddb4c09ff01765887c1521a038b1bf4c478e8a34f93a4fbaed7871f47",
      "text": "Bukunya di atas meja.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c200378a678e32e16ef08ea54e040ac3ebba1a3d3a0b9528d73571bc151d4ecd",
      "text": "Besok saya ke Bandung.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c400ac9896ffb14c5d54a099ef1da0feecc8ee4bc84ccc7e3630970344e70f25",
      "text": "Masjidnya di sebelah kanan bank.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4519e62db9537bbb3e8390efea037e8f2c37157c0b552dda18f7fc5b433f5c2",
      "text": "Saya pergi ___ Monas.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "c54c005232aaa066d09e1cf6b5766b25a8325b3525dbb98dc495f1a1c7c0df42",
      "text": "Mas Rizal di Monas.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95f191ccb06b87097b3e8e014dac97cd8daa68796cf48fe959b7742e8243d52",
      "text": "Dari stasiun, jalan lurus, lalu belok kanan di lampu merah. Monas di sebelah kiri.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbd29cb04832f52fca446db3a53fc66a56e465f3a6e622cf9156e017f2c1f00f",
      "text": "Kereta dari Bogor sudah datang.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd9b5061914f44b318a5fb02a732746f31f017eb01e3c7bf810bc1ba3e826165",
      "text": "Kereta ___ Bandung sudah datang.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdcf3cc04bb9aeae3879b4d4efdf3aa937258272d27a13c9d4cbe2fdaf70406c",
      "text": "Mohamed, kamu naik bus ke kantor?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf21ea6e0f5f117878b12d89a78275bf5042bde705c8d27a960b76af46dbe582",
      "text": "Terima kasih banyak, Pak!",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d01249360f625e7c1b911dbac9c80850ccd5d4de29652383fa89dbb93fb27366",
      "text": "Lalu belok kanan di lampu merah. Monas di sebelah kiri.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3fe94a1c8e6e0c0b53cf4393c7a2d1acb87f285a10fc0383a30d8ef6d0e3915",
      "text": "samping",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4acb58f85d8ec86e3b1ca4c5a6f23656218525ef97d60d9b6338c0145fa0b13",
      "text": "Saya di depan pintu masuk Monas. Kamu?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbb8a1e76286806a96e26d3335fbf35b62f47bf1b0c7891b097b8550b8f3f25b",
      "text": "kereta",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e13df7dfeb9906baf5ac024da74f36032ec301afc4534cc946c1c9fabe614495",
      "text": "Tidak ada. Di luar?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d360c6df25d4a2e6977b9b5471f1ce08c603276557499d4f3be8ba88977183",
      "text": "Permisi, Pak. Masjid Istiqlal di mana, ya?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d9a62c953e9a7efd3bef273a1b83f85872034818f4cd19d0d6548942c0e39c",
      "text": "perempatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e30411b25d8d7f8546b9803c9410d7889298715dd74c032402432d2f4dbff3fc",
      "text": "Bagus! Monas dekat dari sini.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3f3c4971299bd50eff4cdb871bcbb5b5839de906978f5356c86051a9c02de19",
      "text": "Baik. Saya di samping loket, ya. Sampai jumpa!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4048758889f57b4c7c30bc7bd87b4ff7165eb3de92d95ed1b2f045c820e3748",
      "text": "Oke. Tapi panas sekali, jadi saya beli air dulu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea6b5a808613ec0905f5557d23a0cf09e825ea80c836eeaaf53ef34aef93b18a",
      "text": "Saya lapar, jadi saya makan dulu.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed56c6ad880fb2e33fe2d8a72b33c168c757bb04eb465f9c351f8b1e48fc7c38",
      "text": "Ya, lalu jalan lurus. Kemudian belok kanan di perempatan.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f339c25f5433d675f2a3e06f4117c3809ccf8d165d91a56313249ba16f38663e",
      "text": "kiri",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f470c9897b651c6cbcfee1c58fe621b9caad0c5426e62b9ad93d7bccd26a04e8",
      "text": "Dekat, tapi panas. Jadi pelan-pelan saja, ya!",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f498832a27e5b3ed734df7b123b502435b274f6adb4c6df0d74364ee0f825dce",
      "text": "Tidak ada, Bu. Di bawah meja juga tidak ada.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4f4c1deadc492b9aa6d2325e297699eeebc35da0b1994341950d5e0c5a7671a",
      "text": "Permisi, Pak. Saya mau ke Monas. Jauh atau dekat?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f62155fa0638af8330477de36141299536e944755069d07ac421ab0f77daca2b",
      "text": "Permisi, Pak. Masjid Istiqlal di mana, ya?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f76e5d5aa36866c68c246589ced76cfcc5c5bad039ad418b505f1c7c25c48f4d",
      "text": "kucing",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8947833800808644cbaa7fc909ae266f21c955e8ab5619972bdcaf0ae4039f2",
      "text": "peta",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    }
  ],
