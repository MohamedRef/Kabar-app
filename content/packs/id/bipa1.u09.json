      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4acb58f85d8ec86e3b1ca4c5a6f23656218525ef97d60d9b6338c0145fa0b13",
      "text": "Saya di depan pintu masuk Monas. Kamu?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbb8a1e76286806a96e26d3335fbf35b62f47bf1b0c7891b097b8550b8f3f25b",
      "text": "kereta",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "df93b493b9339d8f94909858aa38d29d338bad42f47e06ddacb99bda7bbecdb6",
