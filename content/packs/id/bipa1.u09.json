    },
    {
      "id": "bipa1.u09.l03",
      "sha256": "a3a550b41015268440b5bceacc41d70b89b83a43f00f1a08ce686ab7923a917e"
    },
    {
      "id": "bipa1.u09.l04",
      "sha256": "dfaf74a03bffc7892368a2dcecaaffc792afe7eb1f3d4947977883e5e003d07f"
    },
    {
      "id": "bipa1.u09.l05",
      "sha256": "bf9f38fcc54c84b639890c5ba12214971081e2123de5139058eefa1efb12b987"
    },
    {
      "id": "bipa1.u09.l06",
      "sha256": "fd4a5ac943247d865c10d9a750fc9ca37ea0dd346bee6b9bbe7833ee610ef054"
    },
    {
      "id": "bipa1.u09.l07",
      "sha256": "680a2d59cd23595714f0b9c9d7fbf96fd53bcc8b478981e4775d4067dd402133"
    },
    {
      "id": "bipa1.u09.l08",
      "sha256": "ff84cfcd793fd8c212f55da03448c146912c488d11d7cca57ebb2bba3aa0ff49"
    },
    {
      "id": "bipa1.u09.l09",
      "sha256": "df1b049ea6b9864a0ce76c9ad6bdafac56e2546a798dd434e772491ef2df3fb8"
    },
    {
      "id": "bipa1.u09.l10",
      "sha256": "d62d8e6a4585699a041918cefbab50a48a495c2bbe79e532dea3516ae4134933"
    },
    {
      "id": "bipa1.u09.l11",
      "sha256": "0c7cf059bbcbd2679f91e10503614a92cdee8af98e9c1345d94d1f53db683a60"
    }
  ],
  "audio": [
    {
      "key": "029873a2da995986cb5df616914c867ead7fc42b50f551a0d4513686c9463adf",
      "text": "Rina pulang ke rumah.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "0721a5be45152964b933f07a0619ca248ba13db1d8df5aa6c96cb3e382c4b516",
      "text": "tempat tidur",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "07891c3b5260cbfa3e1fe7882431db4806302d4ebe4c80121c4246ee8be43819",
      "text": "Kamu mau ke mana? — Ke masjid.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "09a652c8cd653b3307afc786b0a32aec5e4dcb2721aeb85d433d723dcbfdede5",
      "text": "pintu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0aa7bdfa4f2e7b52f4bc1b28d84123de70f8b28210aa41978884ebbdd605a408",
      "text": "depan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b2a0a9f0bf9af8993a221e4e3e0d206b8d92ffcec509b498b435ac5de9857fb",
      "text": "kemudian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bf19cd740bf7671aa4925f0676bf770ffc450cca691de0821e379321ebcadfb",
      "text": "Kamar saya di antara dapur dan kamar mandi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c98599c204b60710208ef700de85339bfa0dcbad7873205d7d8bad3d84160d3",
      "text": "Belok kiri di lampu merah, lalu?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d73c49e673e03fcd43b47851402be64929381288ab52f70290a1e415127b0a3",
      "text": "cermin",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f0ec7dc7426ce6b2b5499068914f2dadaf9c1f84a22fbed4537ac2b2e444a55",
      "text": "Dari rumahmu belok kiri di lampu merah?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f68eedffa0b378b34a368e20c2ef2fd63fc1c3df8b6483fe8472bed38e65b0f",
      "text": "Besok kami pergi ___ Kepulauan Seribu.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f862b36b30b02cd6fd19ba7d97b0421ec1b1324a2e1c58b5de0f88c0e747eb8",
      "text": "Dari lantai dua ke lantai satu, kita ___.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "10569815faab3e746b749aeccf665653fdce16b06572eb30f971f66bcade1b78",
      "text": "Kemudian jalan lurus. Masjidnya di sebelah kanan.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "109bcc660cb08d3f6780442657e6ee6ae4d6be97e4cc897c9695ef3e79e2af67",
      "text": "dekat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1174c2069da4bb2ed2557f4d2d01e652d20f0f40d538b60d17f42196c0a0031e",
      "text": "kanan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "13d87c83a174b2a4c08aaae82f8115c9fa98fb7e9aff90c88d1657d7d287c8e1",
      "text": "Taksi lambat, jalannya ramai. Kita naik motor saya!",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "155d93131e8367d2d83e9a6775edd3bf0e7cb34e9c00d4a8631b29ab97883a90",
      "text": "Tidak. Jaraknya seratus meter. Jalan lurus, lalu belok kanan.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "1657de3c0e2c05241afa48bdb6d2fdb977cf014db373a2fc2d15bdbb13eef1f0",
      "text": "Di sebelah kiri, Pak, di samping dapur.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "18c52861195cc9110364b96713794de34418c9c169d5d3f4ecffe699b8160eb5",
      "text": "Mau kopi atau teh?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "18e7fe3d6b3e812db7469da50e8c9021dbb97b0d44fa3c56f8aff28d548a1c3e",
      "text": "lampu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "19009dad1f3e72b049192d385ad5730f31d7d854e4125cc953f408b41d8e8988",
      "text": "handuk",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "199c09a7a91070c719c2e18ce1fffee28ed7d089d7ef5940c45ea161b3d7c524",
      "text": "lampu merah",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ad17f803309d3548ff257e543a9ba6455b14be8c9bd9aab8ffe340d94d294e6",
      "text": "Cerminnya di mana, Bu?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1adc67ee6b2df6a38f3f2894aaa0dc89287dda5f051bb5faeefdf1a0a4db9689",
      "text": "kamar mandi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bc75142e6334e190f39686160da38f42becad47f8682a669f847077a40d7eb6",
      "text": "Saya naik motor ke kantor.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c70aed8dffa4c7429d0c166f01897b1aef8de3262db8d3870203cba0fe5b836",
      "text": "Loketnya di samping pintu masuk.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ecca6849b2b0a2a5446a4d8a2e0b5722f8105c9eafe65f19e500741f8ae0670",
      "text": "jauh",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "21d96e3b4910207151f72d0cec88dcc06ff8f6511ef41c499a1cccc408115572",
      "text": "Saya lapar, jadi saya makan.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "21fc9d004f5ab11f4e2d4526da064ab131ba9cd615324eba8fa08fb6e16f20ed",
      "text": "belok",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f626fab333f8836bcd33e774ff1420f11f2fcb68ec3c10f48cf251358c9278",
      "text": "Anak-anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "23f2b335c2ec2548fdc72c0c2d24eb845be1e4798a323902cb6704eb51adc09d",
      "text": "atau",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "26e19289751cdefbd4b649769030395ba47d6d6533d62cb6ba4ba6fb9310798d",
      "text": "bank",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2786920c3e2947df2746249e407ad0e3f8a421c1745ca65c8016ea5ae8e80eae",
      "text": "Tasmu di mana? Coba lihat di dalam tas.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a5d9f6885bf79f1fb121adcd4db2326a4cb21e56d674416adce060a772b109e",
      "text": "jalan kaki",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e72a97a225ebc19e12a8ab8544a9580fe424ad28a1d2617773bcef5e9bb877a",
      "text": "taksi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fac633c0c516f24211163c78bb38bfa2cf9b64e2fa0de0d26df632dfec7ece2",
      "text": "Saya di luar, kucing saya di dalam.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "303355e7112307ff9ac42b9d056e011958e7fff710a12b68b4d0b3e4e20d878d",
      "text": "Banknya di gedung itu, di sebelah gereja.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "319bcc379fbf3df4cecbea50333c314444294a8096556df4aadea25b602ff52e",
      "text": "Saya dari Masjid Istiqlal. Sekarang kamu mau ke mana?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3298320e57feca7ef6270e62e3e1b93096aaa7a9d62c448c49a9eba7dbd51ffa",
      "text": "rapi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "36a5f58629c1eee0789fb511835b7b24d2120ea0889d08acd85628c85d5b2752",
      "text": "dinding",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "383a2e80e81307ce379ac19c889e0279638f1f71e409daf111cec1034e04fdac",
      "text": "Jalan lurus, lalu?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3911ebe9e8f498a497dd895e797ea91b8c1a79124fd01b6637c979dd5def6bfd",
      "text": "Taksi itu lambat, jalannya ramai.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "399417e9ed67ca5ed1d909d98d56471e945a3de5544f7be0680c78c54b938c3e",
      "text": "kursi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a745507aaf2adfc4bf9dcd1bad669c6d253bb346468ca8dc0aaace906cb444a",
      "text": "Belok kanan di lampu merah.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b0898a9055a2008b30151917b5162989eacba3921f01d357957b7a9320cda1c",
      "text": "Masjidnya di sebelah kanan.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b553115c9857bb8ce6e5e9876e0fc09398e736c3e41e3168ffad98e21fe16aa",
      "text": "pelan-pelan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bf9018b13d6be3af018d6d7814ad3608674b5964e3e4c91f430b72e69831399",
      "text": "Tiketnya di mana? — Di dalam tas.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c175246e1c0df739bf8a35cf86b9eba9ce6904743e4095fc5c430581c9b1035",
      "text": "Monas di antara stasiun dan masjid.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c837b77d61bd422029a29911b31307cddf2b6f4d27cd524d413327219bbbd8b",
      "text": "Jauh atau dekat, Pak?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dd9d42c544496fb385fa1d859fddcda4fe3414231ab56fb1b2c45f9e3f927b4",
      "text": "Dekat. Jalan lurus, lalu belok kiri di lampu merah.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ed0e96789c16e19611d435ec346a1c9a4b53e8230d779faccfd3f7ab7fbb419",
      "text": "Di kamar mandi, di dinding. Ada sabun dan handuk juga.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f6c675d5c79b068684d77e6dcc9ec7f8f9cde769ba6010eae5f1f42c3306b8b",
      "text": "Mohamed, kamu dari mana?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "4369b28a2132b51faefa8ad4fb1a03470b0f99ce82896d150c93a78372fe944c",
      "text": "gereja",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "43921ee49b05c43fded8969a3a64c70f3ad5257f134b12a98a39a33711cdb64f",
      "text": "Aman! Saya jalan pelan-pelan.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "452ba8fef485e2cf1214727255bb32f878fe2f4d5b1de1c2ccb038f939daddb4",
      "text": "Truk itu besar dan lambat.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "45ce71247a2cbae7bbd1385b156d7cd480182eec73dee77bdf99229de09525a1",
      "text": "Kucingnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "45f642b88c0c1e6942b773f486f7cab963a650a19ecbfe2c1c263645e4566d63",
      "text": "Saya pergi ___ museum.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a83faf320b10439338b0ca2a87eb3b473147c89527b0b971c5fd33fa03ee4ad",
      "text": "Tasnya di samping kursi… Ah, ini dia tiketnya! Terima kasih, Bu.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "50c465694397bfa944ed8f91d323ba933c2cbf2da9e97ec44362500a8254308e",
      "text": "Tidak, saya jalan kaki. Dekat!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ca25134becb3d6811b6cde2cbc5446eeb06a581d57a6ffbf86cada94ba8488",
      "text": "Kursinya di antara meja dan pintu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5213eece3e0a82d1a82a10e1b47181cb95ff1b360539fd107fc27b704feaae06",
      "text": "Mohamed, kamu di mana?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "53fbc8d17cb37bc63343d5593dad724e77833400b5164f337b3ef09f15a7db80",
      "text": "atas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "550ce007999628c762c18f7c772f78bde46d7551ef95c16c962e6bbad1721caa",
      "text": "Jalannya jauh. Pelan-pelan, ya!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5522b2696cefc38de3bf04beef8ed2c5bdf5ee7b68efe8c5dd557396d077a5f0",
      "text": "Kamar mandinya di sebelah kanan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "57dbd50673ea34d16861a30d14a4a643c099313fc2514c4171010537c8eb2c98",
      "text": "bawa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "57efc5e8f3f52e872c5aa25c2237e80cead41377b7d9c78f49faa6eb126c161d",
      "text": "kamar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "58d9c00794a96f40ca1cb09c0af66def7d9cd47926cf6ba9401fb548d4be9b64",
      "text": "Permisi, Pak. Bank di mana?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "59b137928332c4addc7901eafb46c02014d81c4d326d2e5f74e3de376fc5df31",
      "text": "halte",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a5471a9bb2189bc545d0752c25be625ef66abd8fb950a5335ae7ca670b386fd",
      "text": "Belok kanan di perempatan, kemudian jalan lurus.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b2b69fb31d5de5ff556a62f8ed3067db399a6a7dd2bfd1dbc605b5cfabf36c2",
      "text": "Museumnya dekat, ___ hari ini tutup.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bd7c09eab94676906560ac33a285b51c0a522fd161a7fac70eaf81333581afb",
      "text": "Terima kasih, Bu! Kamarnya rapi.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eba57589552ed3d26786feedd66e864b503bb1ddbb5350086d69f8fd650f2bb",
      "text": "gedung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6199f2af71c091ec6da4782c42acf03390ade13d85794ff61253e424febf2827",
      "text": "pintu masuk",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "620319d7b98d2f70e873cc0ee0e1f31659a32c671390e5b37394a45ca468e39c",
      "text": "Saya cari taksi ke stasiun.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "62ca24c4f4f50ee2bbb218edff271fbbb653504c62f51b8fc3022b5aee563b7d",
      "text": "Ada lampu kecil di samping tempat tidur.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "631c3663f030a573b15aeb9690f42800c0eaba0729908790f61754c18edce604",
      "text": "Permisi, Bu. Saya mau ke Monas. Jalan lurus, lalu belok kanan, ya?",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "63464643a1b40777259240d280e840a10c75487aee7e4b1c59311a858b0c6300",
      "text": "Monas jauh, ___ kita naik bus.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "674f874d2ba81a427ad5e4b11c37aac79ddf1451f8175b6195b7737e802f8255",
      "text": "dalam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "68137d31af72f616989d1762aff5056a2fac987f2662e7aef1017697553e4ebc",
      "text": "Gedung itu tinggi sekali.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "68b9a269746f1b7e7022caec977adbcd43ff4d301376161402ca9ac90346ab7a",
      "text": "Pasar di sebelah kanan jalan.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "69062aa2b703b5812a81dd1529765951dd5495e6dfe2302bb352b20416f0c9dd",
      "text": "turun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac485743fb85e2dd21e0f08c94fdfcf3623856c61a2fa336593e190fb252a3b",
      "text": "Sama-sama, Mas. Selamat jalan!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "70677f3301eefe56de1619a18861d263e4a838db73d1cde0ef2474cc251b03e6",
      "text": "Halte itu dekat sekali.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "712d8e62fde4451b360d79a124d1b178aa3d422d8ee9d1a11bf9fade53ea65d7",
      "text": "Dari Stasiun Gambir, Mas. Mas Rizal dari mana?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7158762382362b973b2b656b35bb75fbcd17f4755fc27b257939058e92ff0578",
      "text": "Ada, di bawah, dekat tangga.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "7283592b6abef385d6386cb10805792d78ba68615cce95730f0a6f20ea9215fd",
      "text": "warung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "73261ccf8a1ca831357808f7135b7fc28103d3be8943112d7d52bd7b83e24e64",
      "text": "satpam",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "761a154cf0190c844b4cbc00b301c016c62576bbdeef7c7d6b00f8042d2a4809",
      "text": "Sebelah kiri? Dan musala?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "76a4a84cc3f7be8d583928f8aaf83e0f9a9cdd2abacd458d74046aa58aec4bac",
      "text": "Dekat, Mas. Jalan lurus, lalu belok kiri di lampu merah.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "77872e67235a0a8477540defb0462371eb44290da96c8c9ef939ee4cde623386",
      "text": "Permisi, Pak. Saya mau ke Monas. Jauh atau dekat?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "78beb48aec7ddde052cd4a83628f541f5b7a45ca0533383868192393e28478e5",
      "text": "Jarak dari stasiun ke museum dua ratus meter.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "78dde544c02a004b11efcec6838159174a8e962ac6cdfc223bf713733b95373a",
      "text": "meja",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "79d42f969f9292eba2ce229586fb0ef0df5984a75c29a700bb061c5fb65b60b4",
      "text": "lambat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7aabbebd1c0e9e99f733496ef550fafcd645b16bba5c457196174f0e97ef868e",
      "text": "Saya cari taksi ke museum.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b5af35d5f9b024795d75317d9b7c66cf6679aebc7003f24ea4fe630d4191263",
      "text": "Jaraknya dua ratus meter dari sini.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d1a3ea28cf66bad6b829c657b82aa8de137da525b55aa6ce255ad53cc05dbdd",
      "text": "Di atas meja?",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d748bd029ce50e4e32b9f19b58ca952ef2d98e34e2f8010a7e5188030719cd5",
      "text": "Kamar mandinya di sebelah kiri.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "817d610b7c0ce4e8439d1ede062848a5aee9396f4045cc0f289a6972d04de0ec",
      "text": "Bank itu di sebelah kiri gedung besar.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "84253abd9a449853b63e6992716fb894052417fac530344f424595e7492a8955",
      "text": "Masjid Istiqlal dekat Monas.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "84698ae8aba1e1011e1b0b75b493d88a8219c881875704fead043ca624c13155",
      "text": "Permisi, Mbak. Kamar mandinya di mana?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "84e798466ef17f2fff8bb7b46a934c3d2eac866b505745758805e7fc1953af6f",
      "text": "museum",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "874f06b39e86c0bd86163183398114197a83b96873c706fcc08779af3b64a57a",
      "text": "belakang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "88da57ee63b742873c5a4ba94c04b09a5eecc6ea916789922f875242e150ac69",
      "text": "Satpam itu di pintu masuk.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "89be971f902e183fbc68327d76d945ac09301f37008d5f452276da871acb9210",
      "text": "Kamar saya kecil, tapi rapi.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab7196b1c79ea21c5240499d92f493e9251df0dbe7c2f3fea763b2b8eea26b9",
      "text": "Ah, kucingnya di atas meja!",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bc21040c298ba9aba8a6eaaef0668cf874ceca75ad12c00398cdcffc2bc7755",
      "text": "naik",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c0d2742e5360e7d20220bc3ebd4f2395da0ef29848251f7b42df64684994e39",
      "text": "motor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cf21c8a00afce61ad3784aab19c0225387966c0b8156a51b5a155e8a2db1de1",
      "text": "Saya di halte, dekat stasiun. Ke sana jauh atau dekat?",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f0e29fe023789af354157eca67026c0db0d5ae0d4255c12f06771761f232059",
      "text": "Musala di sebelah kanan, Pak.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "924e9818e34b269394aec52ce927fb215f94952882709fd5dbd2e748f9b4eaa0",
      "text": "stasiun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "940badbfff81dc1ef86786a19a281afa54058064542f94e019e4558543055d65",
      "text": "sepeda",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9583e0d8cebbfda86639a6d5e298cb2679245ffde7870ce0cef20040a7127000",
      "text": "sabun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "95d9b33e9f1be72379d4d118cb5c0f52dacbaea2b9754d60daf9b1171023ea52",
      "text": "Di kamar mandi ada sabun dan handuk.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "98c1f877ff5192b1baad86002a58b5480e6996a7c12a09b1f123b66301de6d02",
      "text": "Mohamed, kucing saya di mana?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b4af008bed8279bfe5f99ea879f84c03c97c68c9565ee4fc2ee63f503c7d8db",
      "text": "lurus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d4489fa7028774e4ce0247e7b3b99cf85392c71bb4ba01a7cb46601b63eaf04",
      "text": "Kita hampir sampai!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ee9ed71756715a1a930cba1f757401e1757aac4c14c2df8fa90ce9945f1c737",
      "text": "Ada warung di dekat bank?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3910d0007887bf0386a61c695fa5cf05b18733722e5a498652a65d1040b407c",
      "text": "bus",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3ae4ab7a35969383910a5872cae686e478c56249e996efa357d79491687b066",
      "text": "sebelah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4304fcfd4315cc366164bcf0a1969d6fc9c60575f3d890dcefcee2f07c83cb6",
      "text": "Warung itu di depan gereja.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a50fa5121cc1a38ac8a5a9c2f816fa4e6d8e1f930174417a98c620e9223793ad",
      "text": "antara",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5c3e9b1a2a97901b1c405793db20cd2ed1126c70354426616870f3ba23fa75e",
      "text": "Bu Yanti, tiket Monas saya di mana, ya?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5d60afbaf7dccd73065b9581ba775703fe83364cad083a46fcadceeac3e0e81",
      "text": "Dekat sekali, Mas. Dari stasiun, jalan lurus ke depan.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a635e5e9f49896cf7fd4a4d182bb06230920e3b6bb3fe5f602f433a8b16685c4",
      "text": "Pelan-pelan, Pak. Rumah saya tidak jauh.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a63ce4d73226b5ed810a6f01b873192503689e919704c52d8e343d2dae328c8a",
      "text": "Kursinya di depan meja.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a738cfb7154eef4aa59c5edefa38010f7fe35524a46347e808ddbd02696a0250",
      "text": "jalan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8aca55f2e539a7de8214d7e5593bd9e93c13e090d0a8cf6d86f004d2cc1e0ec",
      "text": "Di bawah kursi, Bu?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a95ba3d7f1f110aaeb2c963c09f7cb690089d449d8febac25fa57dcdc040be79",
      "text": "bawah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa1bfdf719d84ba768200d689a87c4b70baa7060c6430c52bcb47a0c87c7f93d",
      "text": "Jalan lurus, lalu belok kiri di masjid.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "adcacd0fa6c5954a7ba1e4d1f3de417b4be99bd20db80937a258a15066f799b7",
      "text": "Tasnya di samping kursi.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae8ac95e61041df6fd239fac5620acf78502b5f92f95e43639944bc1e0546135",
      "text": "dapur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0a45f16f3c3f89ae0c51f8ef3bfec91af43e9776f90d0445b68a6a4ae9f0145",
      "text": "Jalan lurus, kemudian belok kiri di lampu merah. Monas di sebelah kanan.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0b7f2a99fdeb287686f9de9135cf58e25d2a0d90b904204ef3228a198e03f9e",
      "text": "jarak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0e0b6cc20a3076bb9ac8aba2319cd4cc105d102eebffc9875ed29d7d8a1ca80",
      "text": "luar",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12813fa3a5f7537e2c2d5322ef6cd6862776b108f951c6d1246bbbdffac3470",
      "text": "Tasnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1eebe23454ccc78402635447eaa4a17cbe5d5bc905ccd1780d34959361fd73d",
      "text": "Bu, ada kucing di dalam kotak ini!",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b22aaf2653c899c79cd737e328398c46a218f3215f6e7c0e8033f75c8ddcce42",
      "text": "Mau naik bus ___ jalan kaki?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26963dab236a65338f33ef168ebee85aae4b5e5d47f53ddac26b230e7118cdd",
      "text": "tetapi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2cd8f344f3a740bf817ed1562a16fb50b8d6abd993a6575c73dee584357492d",
      "text": "Saya melihat wajah saya di ___.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b84092e33fe6a1609272cd4788ee14d2f0d9c5631cad0070dbbfefb6c7bf2c22",
      "text": "meter",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8994d2be92a05b9b5d2aee4832d3b99a07d1381c5eb81fefe2a722c6c397437",
      "text": "Mohamed, kamu cari apa?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90a87d70c2e341b6b4b9c7afd32e1ea918e2a83ecf723eb0283a0f7d8315688",
      "text": "Jauh, Pak?",
      "voice": "id_ardi",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba4e9e307649122b6b5ab26903cbce9e5183051d49cae75b9002239554823d51",
      "text": "Bukunya di atas meja, dan tasnya di bawah kursi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb26b61770d176536b33740e751b6e23bf7fa5169ae0826bbf8978ba91a370ae",
      "text": "truk",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc9ecbe2750ae1a208cae9f64ecb5832383ad8732a6027e5419bcca61399c620",
      "text": "Saya mau ke Monas. Sesudah itu, saya pulang ke rumah.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bda5a8d010aff8cb60ffdc1678d341e705a1e66e82093fef51f163b82bda4077",
      "text": "Kamar mandi di antara kamar dan dapur.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdc07fbddb4c09ff01765887c1521a038b1bf4c478e8a34f93a4fbaed7871f47",
      "text": "Bukunya di atas meja.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf2e7431e5aa37e0633a607651a1ab772e2e30fe5ee9ae825b413d614463528f",
      "text": "Jalan lurus, lalu belok kiri.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf861c2153a0c5b55dac127dc94c8513ed82fdc264ae80325961028d6bbe78ca",
      "text": "Mohamed, ini kamar kamu.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c200378a678e32e16ef08ea54e040ac3ebba1a3d3a0b9528d73571bc151d4ecd",
      "text": "Besok saya ke Bandung.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "c279c63a2608414ee11dd336beb461212d15214b86e3c92e88c7c89f98a78a00",
      "text": "Saya naik motor ke kampus.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c35575c87a45d000071cc8aa56f66693a5963a033a586a8803960be7879bfad0",
      "text": "kotak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c374bf453038a83c010833dcb1ce1063418d01b2ffdada9a172d1feb2815812f",
      "text": "Rumah saya di sebelah kanan jalan.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c400ac9896ffb14c5d54a099ef1da0feecc8ee4bc84ccc7e3630970344e70f25",
      "text": "Masjidnya di sebelah kanan bank.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c54c005232aaa066d09e1cf6b5766b25a8325b3525dbb98dc495f1a1c7c0df42",
      "text": "Mas Rizal di Monas.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "c690b1a4604a27dd0910ee9968e285873a89cfde55e8616b03946bb516d33378",
      "text": "cari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95f191ccb06b87097b3e8e014dac97cd8daa68796cf48fe959b7742e8243d52",
      "text": "Dari stasiun, jalan lurus, lalu belok kanan di lampu merah. Monas di sebelah kiri.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbd29cb04832f52fca446db3a53fc66a56e465f3a6e622cf9156e017f2c1f00f",
      "text": "Kereta dari Bogor sudah datang.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc56a7259c74b41fd52e7ea3ca1b084bd87c1db4a964e114aae275f3bfb583df",
      "text": "hampir",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd82fa39cd9479f907a5e68896fc9fb7368b526953c662e68255486872b8ba15",
      "text": "tangga",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd9b5061914f44b318a5fb02a732746f31f017eb01e3c7bf810bc1ba3e826165",
      "text": "Kereta ___ Bandung sudah datang.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdcf3cc04bb9aeae3879b4d4efdf3aa937258272d27a13c9d4cbe2fdaf70406c",
      "text": "Mohamed, kamu naik bus ke kantor?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf21ea6e0f5f117878b12d89a78275bf5042bde705c8d27a960b76af46dbe582",
      "text": "Terima kasih banyak, Pak!",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d01249360f625e7c1b911dbac9c80850ccd5d4de29652383fa89dbb93fb27366",
      "text": "Lalu belok kanan di lampu merah. Monas di sebelah kiri.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d316fb2bd10e6f8331b210b9271bb236f4c9497a492a9284be3e00b4e327451a",
      "text": "aman",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3fe94a1c8e6e0c0b53cf4393c7a2d1acb87f285a10fc0383a30d8ef6d0e3915",
      "text": "samping",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4acb58f85d8ec86e3b1ca4c5a6f23656218525ef97d60d9b6338c0145fa0b13",
      "text": "Saya di depan pintu masuk Monas. Kamu?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6518bba11fa245bd4f8ff2e198086d16fe8350961d44f6d337825292f417e71",
      "text": "Kucingnya di luar, di bawah kursi.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7d3d19c9d985a3310e261e3c84d6d979c33fd261680b3c42d0c45aef9f26628",
      "text": "Museum itu dekat stasiun kereta.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbb8a1e76286806a96e26d3335fbf35b62f47bf1b0c7891b097b8550b8f3f25b",
      "text": "kereta",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc639eee2bbc8981ac7e170ac585123d9646a6713fa0be713cfc47235bfbfb11",
      "text": "Turun dari bus di halte Monas.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "de5b6d2077d69787d6e9cc3ee6fcabc3cc0103c2f5a2c05d4db4691e8ba14eba",
      "text": "Dompet saya hilang! Saya ___ dompet saya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e13df7dfeb9906baf5ac024da74f36032ec301afc4534cc946c1c9fabe614495",
      "text": "Tidak ada. Di luar?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d360c6df25d4a2e6977b9b5471f1ce08c603276557499d4f3be8ba88977183",
      "text": "Permisi, Pak. Masjid Istiqlal di mana, ya?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d9a62c953e9a7efd3bef273a1b83f85872034818f4cd19d0d6548942c0e39c",
      "text": "perempatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e30411b25d8d7f8546b9803c9410d7889298715dd74c032402432d2f4dbff3fc",
      "text": "Bagus! Monas dekat dari sini.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e316d4e2a6b812d19ac586cee20fdf616238a2d3cd5ea1e89036a5f9481ef1d4",
      "text": "Ada tempat tidur, meja, dan lampu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3f3c4971299bd50eff4cdb871bcbb5b5839de906978f5356c86051a9c02de19",
      "text": "Baik. Saya di samping loket, ya. Sampai jumpa!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4048758889f57b4c7c30bc7bd87b4ff7165eb3de92d95ed1b2f045c820e3748",
      "text": "Oke. Tapi panas sekali, jadi saya beli air dulu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e78c1d47c20942cf743f5b5aa892cdd30e5c8d671bad195ece812b7c717f4c",
      "text": "Halte itu dekat stasiun.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7e2a35acc5b118a021cd1afd496dda24e220f432192324f644096cb984ebb79",
      "text": "Motor? Aman?",
      "voice": "id_ardi",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea6b5a808613ec0905f5557d23a0cf09e825ea80c836eeaaf53ef34aef93b18a",
      "text": "Saya lapar, jadi saya makan dulu.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed56c6ad880fb2e33fe2d8a72b33c168c757bb04eb465f9c351f8b1e48fc7c38",
      "text": "Ya, lalu jalan lurus. Kemudian belok kanan di perempatan.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed6108810a2f6e69d4647c8ccf119e65b95d30658f019786882d9e62759a019f",
      "text": "Cermin itu di dinding, di atas meja.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "edde7b1be3dcbfd2ead415d1661a303c66f69155517950adf85bff7dcc08c1bb",
      "text": "Kita hampir sampai!",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "f339c25f5433d675f2a3e06f4117c3809ccf8d165d91a56313249ba16f38663e",
      "text": "kiri",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f460cc633c1c30f7a11fb0e1446f46061a337ab1aadb71e064588985ebdb8bb7",
      "text": "Saya jalan kaki ke perempatan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f470c9897b651c6cbcfee1c58fe621b9caad0c5426e62b9ad93d7bccd26a04e8",
      "text": "Dekat, tapi panas. Jadi pelan-pelan saja, ya!",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f498832a27e5b3ed734df7b123b502435b274f6adb4c6df0d74364ee0f825dce",
      "text": "Tidak ada, Bu. Di bawah meja juga tidak ada.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4f4c1deadc492b9aa6d2325e297699eeebc35da0b1994341950d5e0c5a7671a",
      "text": "Permisi, Pak. Saya mau ke Monas. Jauh atau dekat?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f655aee7ac4c7c2b849835b891d7400a93fc32286f1fa25153aaca97d4f2b36c",
      "text": "Permisi, Pak Satpam. Boleh saya bawa peta ini?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f76e5d5aa36866c68c246589ced76cfcc5c5bad039ad418b505f1c7c25c48f4d",
      "text": "kucing",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8947833800808644cbaa7fc909ae266f21c955e8ab5619972bdcaf0ae4039f2",
      "text": "peta",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc777193307119d6c52fd782b6793d1e75adac2cbd851db5a853bbf3a6de5edf",
      "text": "Saya naik bus, kemudian jalan kaki.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    }
  ],
