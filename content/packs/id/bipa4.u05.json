  "content_hash": "584c7302b26d7289e7fedc0baa4da7c0259f8663e962d98a2c4779fa9b472037",
  "lessons": [
    {
      "id": "bipa4.u05.l01",
      "sha256": "0c80cfbc8a5e3560c90d22491cbfed81230b53b0cbe5579699021e6b2ab7a878"
    },
    {
      "id": "bipa4.u05.l02",
      "sha256": "0d725b1692e95b4118faaa582155649bfbe538b33aed56d2e36064b43b7d18e7"
    },
    {
      "id": "bipa4.u05.l03",
      "sha256": "f91f2fead4039a7666389de4309370ed92ef44ce40939521924ee28e60e42553"
    },
    {
      "id": "bipa4.u05.l04",
      "sha256": "65707200298466781c5d77527096fa151df35af4b1c25a9f013a1fcc54e0eaf7"
    },
    {
      "id": "bipa4.u05.l05",
      "sha256": "c593b3abec07e964fa9b9addb857a1386e47fc2057daa8224c0b7fa61e83f2b2"
    },
    {
      "id": "bipa4.u05.l06",
      "sha256": "bd20d1a68fd471bf48158bfeaf26c43d07ca8c432e3dcebb20ab47e12173742c"
    },
    {
      "id": "bipa4.u05.l07",
      "sha256": "68e26405c0a24d429349c939afb425437ce78938b6bad47f07dd778c6c909fcf"
    },
    {
      "id": "bipa4.u05.l08",
      "sha256": "82d8fc676f7b3a4e21703123a1564fca2a9034c9313992ad191c3e00a4a6bd78"
    }
  ],
  "audio": [
    {
      "key": "04e8993be7bdd58dfe6f9fe4c2d49cdcc9ba5e42b9fd6a3ef356c2abc4a5de27",
      "text": "Kenapa hari ini semua siswi memakai kebaya?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "050afa4831a8933034d85afc4ed114989e359a9cc84abf6999d3854693672b39",
      "text": "Mohamed, apakah di Mesir ada hari besar nasional seperti 17 Agustus?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e284d88cafe1813f6662d5a02ac7e962ef0a502d5b0da000b3422e914b6093",
      "text": "Habis gelap terbitlah terang.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a284b9d4587ec5766cf531a4e473b8b9288c74cb3a4c2747958bc47752fde25",
      "text": "Kartini menulis banyak surat kepada sahabatnya di Belanda. Dalam surat-suratnya, ia menceritakan mimpinya tentang pendidikan bagi kaum perempuan.",
      "voice": "id_gadis",
      "chars": 145,
      "mime": "audio/mpeg"
    },
    {
      "key": "0decd006864ac6cf1637f41f780a615c89723a8611e346fcf7f992ebfdedbec8",
      "text": "Setiap 21 April, kita memperingati Hari Kartini.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "106f68ff81a40740709c7df6160d4be423e80f9d163da61a2b0f9105802aa421",
      "text": "Dengar! Tapi panjat pinang itu sulit sekali, kan?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "109811cef808c7d1b8b90a292d06c8192afd4c90656a23cbc99c829fef942033",
      "text": "Mohamed, kamu dengar pengumumannya? Hadiah panjat pinang ada sepeda!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "110e96edbb0bd6e3628b7d9c8de9f5c63b305c18d1c3af15715489e26f677ebb",
      "text": "Pak Budi selalu membantu kepala sekolah. Dia adalah ___ kepala sekolah.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "12503511b4d3c21c9fb7150268619e23fe3c50bc5e75bbac70da41d7e79a81c2",
      "text": "Kami menghormati bendera Merah Putih dan jasa para pahlawan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "132ddb41430040260b02d05d683f274060b078f6a5af96f7b9661eb7203db6fd",
      "text": "Tanggal: 17 Agustus. Pukul: 07.00 WITA. Tempat: lapangan di jantung Kota Palopo.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "14779278638b5c7a15c07b846bcfabcec74205138fd999b72d1cebc3543ea435",
      "text": "Lomba balap karung untuk anak-anak dimulai pukul sembilan di depan masjid.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "163bca34e1ac5061dac99cdbf687d548dbcd8bc59f09e49aa195eee6ba0c616f",
      "text": "Peserta upacara diharapkan memakai baju putih dan datang tepat waktu.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c6127b84619824d9df945fb0562235d87dcaadd7c68e684d0e3b9a371d21d19",
      "text": "Kartini adalah pejuang emansipasi dari Jepara.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "228f7d79386261998f5a50ac660cf2ff7644f21f27b83416d545b31770fa735d",
      "text": "kaum perempuan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "245e988462ad9058f4e31f6b3d522485c79bada02e7f9b3730e731d1b0479243",
      "text": "Oh ya? Apa yang paling menarik?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "26130119b3c4d48c65cef21eaf16315e161d4d7a6ed39c52cec55bcf92b44a98",
      "text": "Guru adalah pahlawan tanpa tanda jasa.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bbb2b659687cd8222a11471ec0f9b5efca4f7851ce3103dc8a483863192afc4",
      "text": "Betul. Dalam rangka Hari Kemerdekaan, semua warga boleh hadir.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c4821865ddd98689ecff701ff1ec8b88130616cb49aa365bf5aac9a7a8a9ae7",
      "text": "Bagi Kartini, pendidikan adalah terang setelah gelap. Itulah arti emansipasi.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cd9ecb9a658e13ce24c9f08fe40513fc1a97281a72f87cbefb58d17abeba189",
      "text": "Bagus! Di sini orang bilang guru adalah pahlawan tanpa tanda jasa, kan?",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b7edbc340a3b03a1a903a4e48c1e1c5ad07130116e16c6af28623ae55dac15",
      "text": "Peserta panjat pinang harap berkumpul di lapangan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a5f2cf37a8f93608501cbfb8f2c873a0a238902603dddacbd1d4d6a6c13981c",
      "text": "upacara bendera",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a619fd2ebda9c382e32ecd0cc148d7c01c5083c9d3c8b19b7bab8b434aad0e6",
      "text": "tanda jasa",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "400a89d322e324a71447fb1e5b2e2e60e8a5e16e49ad94d1aa760a3eaa6205b3",
      "text": "Anak adalah buah hati orang tua.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "4147c8d661a26afbf5bce4caab36c5e1a1c1494b831196b80d69ebf5e94f03f6",
      "text": "pejuang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4426236169d3afe3e9e5fb70022a827b58add18f478c7c8336e3b973b1a1b7dc",
      "text": "menghormati",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "45a35c13a214ce967d9b4f59acac5156d8f3e56724993bd9d15a502c9191f9d3",
      "text": "tangan kanan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "49d8a0c3057502158d71a6a040d21639e320843346d544ea9ceaef075ed8922a",
      "text": "Mau! Kita memperingati Hari Kemerdekaan, kan?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ab8094fbef1372b8ae072bfcdb8a8d75102969b6d40b910a59d275789edacff",
      "text": "jasa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b53d1eff75d798c926ae5652ee00a4dc183686a5ebd81057dce407549ad8d8e",
      "text": "Orang Mesir dan orang Indonesia sama-sama menghormati jasa para pahlawan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b77f989fe9a78633a04924768af117fd8845751006a1a47f863cd9949c6947b",
      "text": "Merah Putih",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "504e2c41036fa1966b98233310ba15acc2013e1fc1ec0cad1a2d7bb46fd0de24",
      "text": "Suasana lomba tujuh belasan selalu ___.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "515307617f609c7038f14ec477fb09d884b2c876126456aacc8d6bb39989e0ea",
      "text": "Lomba balap karung dimulai pukul sembilan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "54375c5952881c92fe5372c44579418e122fc76160c842df703ec03ce66356e0",
      "text": "Dan murid-muridnya adalah buah hatinya!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "58582e13077b43d1c6306c22e7ef2321136d0d20bc7f76ac790f5d8b6c883dad",
      "text": "Hari ini 21 April. Kita memperingati Hari Kartini.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c0d2cfdbd72e04cd8be2174dbff9e31225386f6eac4391037e886d499494922",
      "text": "Warga menyemangati peserta panjat pinang.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d71242fb0354a87099c9d344970187f432686c8237f2fe371bb42166c90f989",
      "text": "Peserta upacara diharapkan datang tepat waktu.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dc59c70ba876361f2f66467fa6126c726d5436831c826e62512aab075814e7b",
      "text": "Guru adalah pahlawan tanpa tanda jasa. Kita harus menghormati mereka.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df264e55c33a012e6587e68c0f8c1c3c3220d5c3f75cde81f3e5e279b5269ed",
      "text": "jantung kota",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df2bdbefb69059fa43aea709d87c055125c6556848f85343b71d8e859eb25ee",
      "text": "Di undangan tertulis peserta memakai baju putih.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "628009d56e3d4a31946110802b3d5bddb31ee5faecbe57f3442d75e5141497cd",
      "text": "Lihat, itu panjat pinang! Hadiahnya banyak sekali.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "629ea0a11d0b1c5bdc595171630d8a38b23b444d8b3b79cc1bdcdbc0e06663f0",
      "text": "peserta",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "645f68718ad63708e0a7a22db60deeb9ae9d089f5a879cbfb93b40b7630cfc1f",
      "text": "buah hati",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "65eb31289673c0bedbd8b602d5807550a6d5fe79dbea71978fdd0c6b0d3a98a3",
      "text": "Saya? Saya belum pernah! Saya menyemangati saja, ya.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6642c31344439c443fb318a5dc8d717f4174238b4e4bf437d918d382713920cb",
      "text": "Metafora yang indah! Gelap adalah kebodohan, terang adalah pendidikan.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "67c30e458a56cc37db10e30eb82f4b68eb37546af1c0c3698aea15888e2eb85a",
      "text": "Kita harus ___ jasa para pahlawan.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b14cd849c58ff21e80320a64a69fe775fdce30d866eee0d66fc40cf48aa2618",
      "text": "dalam rangka",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ed4133223bb864dc64b57c3eb378ec8a5d4d1f0b17d123c609209542c7a918d",
      "text": "Setelah Kartini meninggal, surat-surat itu dijadikan sebuah buku: Habis Gelap Terbitlah Terang.",
      "voice": "id_gadis",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "7075c0cf8b00cb9cf84e377b8c8ee7ad704578668107b79f879f0794f6267d75",
      "text": "Dalam rangka memperingati Hari Kemerdekaan, kami mengundang Bapak/Ibu menghadiri upacara bendera.",
      "voice": "id_gadis",
      "chars": 97,
      "mime": "audio/mpeg"
    },
    {
      "key": "70887f8f4eeb3ac2b68a72b5b57cbe4c81718ae316fd7d2b7066c7266084aebc",
      "text": "Ayo, Bapak-Ibu, kita menyemangati para peserta. Semoga lomba tahun ini meriah!",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "70e7b96e6fb2dbc78f3298bd0ddb9fa6c1e1fdad2e9967fddc93cf32c0502138",
      "text": "Hadiahnya sepeda, kipas angin, dan tas sekolah!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "7144f13e057229390652789a3c9a312d0ce6c6447e1b240c1c0b4343edcbb789",
      "text": "menyemangati",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "71b42b993329fc3ffe0d1506f2cc88b89e8922dddeeeb2412df8930037f87d7f",
      "text": "Suasana lomba sangat meriah.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "74c34742cfbbe62f1580946dbe5c4d25c97d288750eb16faeff16bdc44848541",
      "text": "Apakah ada lomba seperti panjat pinang?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7891bac89b90849a8905780fe6d6dece613bf99b430ccf8f42e078c662780a1c",
      "text": "Mohamed, ayo ikut lomba balap karung!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8275a4a6d0bf93003d7b56e4d1f4df48ac7ce6905843c0cdd793963c9632a274",
      "text": "Suasananya meriah sekali! Hadiah panjat pinang ada di atas tiang.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "82c9e51148432c5bf0606cd4ac7924699d3d68d4e3e71a0dbf8207b30e4b3201",
      "text": "panjat pinang",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "862a4a7b11de5542390bb6cbbfff78a66a026fe4fe2bb3309ae67449c7b2850f",
      "text": "memperingati",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8700efbb2e0dc450b775a0c999948745d27b9d99a2693ffc0c00f24d9b9f64a3",
      "text": "hadiah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dfd16675799dafec2e06de8055eba7a4800512dcf9588476d4a81c3a1e5fb3a",
      "text": "Siap! Saya akan berdiri tegak saat Merah Putih naik.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fff4dc6e2fb3307785707a5a1205a551f008a77d321d615737fe5e8f93d4f28",
      "text": "Kalau begitu, saya menyemangati dari bawah saja.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "91f748278012db490ce80894906a48b25cf1daedd3b77bfcf12049d5e7a36754",
      "text": "Kita menghormati jasa para pahlawan.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "92ec115c5df0ec10deca5ba59f7ebeeae7f9d1d100fb74c8dcaff45067d736f7",
      "text": "Dia menulis banyak surat kepada sahabatnya di Belanda.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "939cae36da33b6992e2dcc47097950b34ccd7728ba1145bd50f4bede1960a9ae",
      "text": "Boleh. Suasananya pasti meriah!",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "9554a452f0aac63f595aa38486dccb8236ec13d541386f920bc068985ac70cf3",
      "text": "Peserta panjat pinang harap berkumpul di lapangan. Hadiahnya sepeda, kipas angin, dan tas sekolah!",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "975789b66966ab4bf60daa27f77c61b31603d191fb60fac6d35744c66003ee30",
      "text": "Iya, ha-ha. Para peserta harus bekerja sama.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "977bba3555380c0bbf27081d1fe94ee603eb7445bdc66965bdd9c0955c592060",
      "text": "Sama seperti di sini! Hari besar adalah jantung kehidupan masyarakat.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "99492b69fabb04f241284ee6c03aaa577b3f092e5d36e7f1e6e1dff6f73949a1",
      "text": "Iya. Suasana tujuh belasan memang selalu meriah.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c9ff5be3b3e2bd3d837528ea552ebf93ca43ae0107d045edd1ed80c6d83bff7",
      "text": "Betul. Upacaranya mulai jam tujuh, jangan terlambat, ya.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a05ed0d9e8c8871eb94432dc5ce0ac71bdd7a99fcd9626e825333dd128b7378f",
      "text": "Perhatian, perhatian! Lomba balap karung untuk anak-anak dimulai pukul sembilan di depan masjid.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9c28f4583ca51bd67824139aa5bd1553b6d93c842e1cf1d7935f0b44dd0d749",
      "text": "Tidak ada. Biasanya ada acara resmi dan lagu nasional di televisi. Tapi Lebaran di Mesir sangat meriah!",
      "voice": "id_ardi",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "aacb3a50648f2552788a95b1795745269b7573619088dee45e8ac4b21fe96c27",
      "text": "Betul. Bu Ratna juga tangan kanan kepala sekolah kami.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab56a0c70536499a2b4a5b5b355a4cc178292dc8a84af897c5f32cb467850fae",
      "text": "Besok Hari Guru Nasional. Di sekolah kami di jantung kota, kami akan memberi bunga kepada Bu Ratna.",
      "voice": "id_ardi",
      "chars": 99,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac8b54406c17c424d08c42692f6c415fdb9207be5a5eda4e8e313066d48919e2",
      "text": "Tenri, saya baru baca artikel tentang Kartini.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4720142b5cb971525b7e667fd7bb715419b6b3a36aa26a56ed7ffd6f1ff725d",
      "text": "Ada. Setiap 23 Juli kami memperingati Hari Revolusi.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b628deb7f14349b340d63e0030cae6c7e4a99c6cb590b6b88829d912d9b0782d",
      "text": "Raden Ajeng Kartini lahir di Jepara pada 21 April 1879. Pada zaman itu, banyak anak perempuan tidak boleh sekolah.",
      "voice": "id_gadis",
      "chars": 114,
      "mime": "audio/mpeg"
    },
    {
      "key": "b735ef6bb676285d4146ab960705ebad9d0a744ac21d689d0628e5d973b611a3",
      "text": "Setiap 17 Agustus, kita memperingati Hari Kemerdekaan.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbd3b69cca450526a2678b779685589a8a2e3a8eacbff9b86850c5dafd991588",
      "text": "Berdiri tegak dan diam. Dengan begitu, kita menghormati jasa para pahlawan.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "be11987575a60a7ff115a2e38d4e4ab7e8fb48f52ea9434b79ddcadbf7960a46",
      "text": "Pejuang emansipasi. Dia ingin kaum perempuan bisa sekolah. Kumpulan suratnya berjudul Habis Gelap Terbitlah Terang.",
      "voice": "id_ardi",
      "chars": 115,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2f7d8287af17d901b57df75d339f50319f3fbb5a46e65382c1c74baa893ca40",
      "text": "kebaya",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c61c9942542805daa2375dfc6c9409859f64b23ddeeb2738028a74cf9c80634a",
      "text": "balap karung",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "cda062d7b094b866372dc639453c0fcb75cbd968f4e7eeb2645c7dc95e9c5a8a",
      "text": "meriah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce8566c81ae7d38e069e9029e13ee7930b00e984e05808b8697a15e98520d537",
      "text": "Ya. Dan jangan kesiangan, upacara tidak menunggu!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2a501f78dbbd72be46afbecef1ce3af0bef7cfd81768f8cd5157c9b08d3436a",
      "text": "Anak-anak mengikuti lomba balap karung.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d435eeec909aea5632ad58de46f819a48c455a5ccfe92b29a3d56bfb5ec88c76",
      "text": "Mohamed, besok pagi kamu mau menghadiri upacara bendera di lapangan?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4bfad7861c1a3bd253cf34f7ccaa41fb01879248f714820b40a333ddaba37fb",
      "text": "Judulnya metafora yang indah. Setelah gelap, datang terang.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d953e0e656a7cb48d414b6f605fbcdad5f65be5f3bb1aa7fb450f7aa81080146",
      "text": "emansipasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd558ffb19c5e946d79b69cd16552cb6336223abaacd8df3492df541253744a3",
      "text": "Upacara bendera di Palopo sangat meriah.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd70369477f26480b8742d44077d0104589e574c05dfab926fca287ce104652c",
      "text": "Pada Hari Kartini, para siswi memakai kebaya.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e07adc73b7589d8c1a23353cd79662b314fea85dd125f36d96350dc799e9e1f9",
      "text": "Kartini menulis banyak surat kepada sahabatnya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "eadbb63d2367c38379be2c9e286bdabf03af813f1ca475b5c2e649ee8ec20e07",
      "text": "Lapangan upacara terletak di jantung Kota Palopo.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaea3b2ba4c3591af1871d6f7f244c0b956e0164dcd1ba026c2c196007f2c2c9",
      "text": "Tenri, saya dapat undangan dari kantor wali kota. Upacaranya pukul tujuh, ya?",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb365d3205cf4d2f6c63b257bc4b0976c72d305c61690335e82c7ba3faa6b146",
      "text": "Semua siswa menghadiri upacara bendera.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "edce7bf5fa7b6f4f6e50f0637d835a13806555c2758dc3b2134e5a82610014d3",
      "text": "Tidak apa-apa. Semua peserta pasti jatuh, ha-ha!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "efa42f7cf230f14b34151933fee526c191f776ff5e289f4d2a4b719a255b25bd",
      "text": "Warga menghadiri upacara bendera di jantung kota.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f069df089f2748fec413f9de303e1b2abe44fa6351d3cd4afbe8f65b97091038",
      "text": "Betul. Surat-surat itu kemudian dijadikan buku.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1e932dc93ca0c565b275041d2560c69c9e50193b7cee64b4b58b5e913d0183f",
      "text": "Kartini itu siapa?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbaa9261633ba89858bca9fa9682dc5cb6daeec6ca935591a681c28309747a18",
      "text": "menghadiri",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd83802f4459c5e40179b797592fc6e1c0ef5d4436074765229379b114156e73",
      "text": "Apa yang harus saya lakukan saat bendera Merah Putih naik?",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
