  "lessons": [
    {
      "id": "bipa5.u09.l01",
      "sha256": "67ef3b40de0b5fb21a67aa2b01048560e80adbe2a4b93e5a7cfed4929a37e104"
    },
    {
      "id": "bipa5.u09.l02",
