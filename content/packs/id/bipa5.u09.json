    },
    {
      "id": "bipa5.u09.l03",
      "sha256": "72819edb3d1a15cb4d0e498a6a52c291ce0815508bf1626d5f1801721c28fb86"
    },
    {
      "id": "bipa5.u09.l04",
      "sha256": "2a3c3a294d5d27b3a247740ef2d45272f56dd5f053769c34325cd5e67b6cc7ec"
    },
    {
      "id": "bipa5.u09.l05",
      "sha256": "5898442145aff582ebf50d670916d9032fd9f399e0ed31e45bcade82a8efdcbb"
    },
    {
      "id": "bipa5.u09.l06",
      "sha256": "01a103e15fc20cf73728b0e3eabffc00b3667c5fa4d123f617e3f2c2ab711d2e"
    },
    {
      "id": "bipa5.u09.l07",
      "sha256": "f160f4b1e38ce6b021c217069d2f067d616a8a52177f5d86205d73a3f9239e35"
    },
    {
      "id": "bipa5.u09.l08",
      "sha256": "734f3433529f524a2a4c7a18adddfa9b80328df2bd996afdb96471c18fe6e5c3"
    },
    {
      "id": "bipa5.u09.l09",
      "sha256": "875b46e0c9d472adaed85004f32548696c7c4420b52d5a5226467d8235dbd130"
    },
    {
      "id": "bipa5.u09.l10",
      "sha256": "03f6a031384dceb151b679bda8fa13375ffbaded4f6c5eb78385a61566199ab9"
    },
    {
      "id": "bipa5.u09.l11",
      "sha256": "6265ace87d1a0010bec7af930405fb59cc9d9fcd9db37195fb316b5b02778b4f"
    },
    {
      "id": "bipa5.u09.l12",
      "sha256": "b2ebfc6aebb8411fc38a39962fb13d708d83c669443311a4a9fdd84a8dcd18b9"
    }
  ],
  "audio": [
    {
      "key": "0104ec3aad851532bccaa91e5af8f1c47e06f6214f7e2f7132bebdd51e3f9955",
      "text": "Umumnya, ya. Pertemanan dan pernikahan campur biasa. Menantu tetangga saya orang Dayak.",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "02b965c81910ebe321068a820b643d75528b9b2b694d380da22c4d5ea4faf34e",
      "text": "karangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "03c015571e16d0cfb763e73b420f3d988520bff17b4b89bf594596a895f452ed",
      "text": "Dia suka menyelipkan kata bahasa Inggris supaya terdengar keren.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "06af65e25877fa506c520d9d17d7c59fc77214712b85a2da938a77d5ad31a52c",
      "text": "Pontianak adalah kota yang beragam.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "07df54de1b094fec5f1525aada823f9200318ad15df4be9176229f32fa36f094",
      "text": "Mungkin kita perlu membuat anak muda merasa bahasa daerah itu kebanggaan, bukan hal kuno.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "080875100efd24761420f2add32da008a27bfd0efcb6f698645695e284391f68",
      "text": "Salah satu ___ bahasa Melayu Pontianak adalah bunyi \"e\" di akhir kata.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "08cf8d94f8033b2026b2a4300a927506ab280f172adb930c0fa9b4e207c55a85",
      "text": "Di kota ini, bahasa Melayu paling dominan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c7bb429e36458a2b0a091ebfe9f28606b758356b952fa9aaa47e19e919bbe22",
      "text": "Dulu banyak kitab Melayu ditulis dengan huruf Jawi.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cba17d90483f73707bd64a5caa7920d89387eb6216962cccc4d9447dc0bb3e1",
      "text": "menantu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dd96e5b3bedc0c77a9a0baadaece748fa882c09cd0132bb7b60cf3617f72a1d",
      "text": "Logat Pak Hendra seperti orang Banjar.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fadc2440ce19f30f8017ae62805e59bef0654d605a0d4fadd620cd9d646aee6",
      "text": "Elo ngerti nggak maksud gue?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1574930e44c18ed6b4420dc229fb92dade47278e4517857b8109452138a3577e",
      "text": "penutur",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "20352eb2d3c239bf1e3181f20f4bf5c7bb27353ce02032026fa2b4323c4177bc",
      "text": "Maaf, boleh saya mengubah kesalahan kecil di surat ini?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "207c5da570f2d551762583481a4d443c2171f49253c2aef68a31a829df9c8b1e",
      "text": "bahasa gaul",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "23803fb9b12ac9b916ad94266ed9f0362faeb931fe12e9e1f2e5407866e9c20b",
      "text": "Rina, apakah keluargamu masih berbicara bahasa Melayu Pontianak?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2443cb4762840d1670f67972be1794c037400b7abbf7b03dd549a3a099334296",
      "text": "bahasa baku",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2466952bd9e596071902128a7765f56f0b146953eca2cbfdabcce079070b4a12",
      "text": "Saya akan menulis karangan tentang ini: deskripsi ungkapan dan dialog contohnya.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "25222020368786e2fb7efad0b7251f69542f8cff0d9dea18124cec831d319ec6",
      "text": "gini",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c400c7d9ac77b7e1ad8eeaee4e49aee74a73a7564ed78f6ab5bbc84b6f08a4",
      "text": "Mohamed, ini chat adik saya. Kamu ngerti?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "25f1992166ee8d2d7588106f68c4e901313cd70bd64917f37dc4848796dc36c3",
      "text": "Dengan teman saya santai, tetapi dengan ahli bahasa saya memakai bahasa baku.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "26537324e202a2d47b0c719ddc55e1d108ce29027c3e8251360e94042d17c998",
      "text": "Ini Istana Kadriah. Pendiri Pontianak keturunan Arab dari Hadramaut.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "2800c87b56d7c94f492fe758369c1ff8d87238c9f89e913201c82d02372a9132",
      "text": "pertemanan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "28eccb2ea83b0a03f735471880cb8872e944e34b408da6278f830a197181428f",
      "text": "berasal dari",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2addddc4952611e718241d25213a92f3337dcbcd30428de7c5852a97f90565bc",
      "text": "Selamat datang di Pontianak, kota di garis khatulistiwa.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b7fa01b302168efe548660ed14d41f5bbfaa84d8c621fb89dcd02787589bc79",
      "text": "dialog",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ba8dbd583d7c3b05e13c4022ab684eb0e9693a8c5027983e4e369aaac3d4926",
      "text": "Kata \"kalimat\" mirip dengan bahasa Arab, tetapi maknanya berbeda.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e1dd0f70ef61a72effd41f071fa624ec1ea5536817c9d44df243fc57dd9ddd8",
      "text": "\"Begini saja\" dan \"lagi pula\". Kayaknya kamu siap jadi anak Jakarta!",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "319c0ac37ab059f37eb120948a068f8c9d327d55dddb7784a2add6fcbc1d6bc1",
      "text": "campur kode",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "341a037fb192bfc212a0035e0d6376b972714796cbf8eeac388289721b82e4ed",
      "text": "Lebaran dan Imlek di Pontianak adalah waktu ___ semua warga.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "383322f7cba10a781b72a93d9de3a2d942112a12e1bd1048042d1904318cd7ac",
      "text": "asing",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "38f043b415d74d855064fb74083741fd2f7f43a04ea76fde4be9d046b3967439",
      "text": "cuman",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa0503d26abdb9ac6f44fbe469f6f1ac682100aed2322f073474ff26b970fc0",
      "text": "kepo",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c363786f44b458e85900f42dc9da123350fe0c87bf392af3151e5bdb2b8455f",
      "text": "Ahli bahasa itu menjelaskan bunyi bahasa Arab.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c55468f1595707e1e1da1c574db959e42666d5da700756c199ce640c389dfe4",
      "text": "Lafal orang Mesir dan orang Indonesia berbeda, tetapi katanya mirip.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ca15b2af61c096a2d08112a1adc0a5b687d2e475c3d0ac17efd38e6b52fdb5e",
      "text": "Jadi huruf Arab ikut menyebar bersama bahasa Melayu. Menarik sekali!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea7ae2a54ff0f5d637ef5d6d89024794248271008717c0f386037b6c17bbee9",
      "text": "Pertemanan kami sudah dua puluh tahun.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "40aaceb5f764640d73c557aded06732d544ca22f9abfd149d8970a43d6c07621",
      "text": "___ mau ikut nonton nggak?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4336fb60655443a3a623e2c0353483b1af9196d9acdcf041e0bd109d1176eeee",
      "text": "Itu terjemahan harfiah. Ungkapan itu artinya pencuri.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "449ef21995142d30d1ab3abd6af66e0f06c0cf5bb0f2ce5a82e4a3de019d506f",
      "text": "kayaknya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d68995092fedff2da4c17c115425b42be6a9d4356a4cab8c01195351bd06f0",
      "text": "Mas, saya menerjemahkan \"panjang tangan\" sebagai \"إيده طويلة\". Salah, ya?",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "44d68cebeccd784fdacd21dc2c258dfdabcc3df8e68b9baeaa309849d3c44324",
      "text": "Sedikit, tetapi saya suka. Kopi susu satu, Pak.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4937eb2337a75bbbc2ab613930dff36d43084ec36111d9c683bade6532f256f8",
      "text": "elo",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "498ca196c82b64eecadfcde4f915ef328c117ab0b894aed44321fcc9d684d8bb",
      "text": "Adik saya kepo sekali tentang kehidupan saya di Mesir.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aab46e92fafc281a736f5e2906078e721ec07f76e84614472c0b7cdca68ee34",
      "text": "Persaudaraan seperti itu sangat manusiawi.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4af79834d5f8947ed559df83ec9367c6248122b0dbf359496ecd8b95ce8c5970",
      "text": "Bahasa Indonesia adalah bahasa resmi, tetapi akarnya bahasa Melayu.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "4df94554d25db54f98b2202aa321ff40b3af6ba2b4508e8ed9771c1f46e0c508",
      "text": "menyelipkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e19d3580a0c50e3da282e3df79c62071e5d5e0e5602988062e3b1c853a6934b",
      "text": "Gue mager banget hari ini.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f758677229c37395abfc7de8cca953d10a245cd31d78f433cec665e06f8a83f",
      "text": "Itu huruf Jawi. Bahasanya bahasa Melayu, bukan bahasa Arab.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ff7e0095482c28f365bf39dae950e7f4ba6279222022a79a501f45ae4bf3d8a",
      "text": "Lalu \"gini aja\" dan \"lagian\"?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "501358562d10d4bf339b500daac8d70e1a9c828c2d9719cfdf0b6c3ea110ce57",
      "text": "Betul. Saya juga bangga pada bahasa Arab Mesir saya!",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "509c2dc97b32daf836afabec4c86e6fe8a23db571997d28f0cec92e0e1941060",
      "text": "kosakata",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5327d6c18988af78cb3e951b199755a9be5d4686334641ca20b3a6844a8c3fc8",
      "text": "mirip",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "543440d41d259b567beca799bd9f27b9f093a086f8c085b4f9db6901048bb45f",
      "text": "Bagus! Elo = kamu, cuman = hanya. Temennya selalu telat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5525a65ce2e16fcba5680673d2ea76d59ce2d96a9b69ffd55e5ba97a9e2f7e85",
      "text": "Khatulistiwa, itu kata serapan dari bahasa Arab, kan? Khaṭṭ al-istiwā'.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "557f7da28708d714bd23a3fc802162e9a67f69b09436c5ad662332e8a99e250f",
      "text": "Betul. Tetapi kosakata kita juga dari bahasa Tionghoa, Belanda dan Portugis.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "566d13f2665ea5f4542acb3ea7b0872351c9ac64b0a418b16a276d0a2238fe2d",
      "text": "Lucu! Dalam bahasa Arab Mesir juga ada ungkapan yang mirip.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "56a787726b6859046fdea5a118ce52f025e4c2c2bced30b5f00126c026f8d1e6",
      "text": "singkatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "57aa1f8e3695815dac6cd5978ec75c9e89a4687689898539b0ae4edfa1a80f0e",
      "text": "karakteristik",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "57c51b59add8405310fe16961de7f94dbaa18e138a73179f2b9790beb00bbb35",
      "text": "identik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "589463098c6f13e782c900c645de30ec508e44b59440b567a955e101ecc9f475",
      "text": "Betul, tetapi hati-hati! \"Ahli\" di sini bukan keluarga, melainkan orang yang pandai.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aa9cb3c7a930bcadc2b35320b513621430c9fdb6f077e503f97000726b0bf43",
      "text": "Bunyi \"f\" dalam bahasa Arab sering berubah menjadi \"p\".",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c84c3e884073c93a6bc4dcf7c0073c6764296d74193e8da8ca0d07580ddc0bc",
      "text": "harfiah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dd98b8561def606fad6c744503972c2218adc522aa9db3640222456c8aa0cf7",
      "text": "tingkatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eb09df54c1a82cf6b4e74e53ccd20d7932e46bc55e311a1cf0a94f939ff73fc",
      "text": "salah kaprah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f8b9c90d720ca1ad866ee6bbc4b5a6e3b2923385a3d658d40540751a2c13bfb",
      "text": "Dalam chat yang penuh campur kode, \"cuman\" adalah bentuk gaul dari ___.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "60c8edd95b6067e6a59067fb97a025c69712a4a81b1f845445f822938b72df05",
      "text": "ejaan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6392014a94e1beac66a5afc21828cbd9c8f2fbc1b72b3048bd16dd58b6e1dd79",
      "text": "Di rumah dia berbahasa Jawa, tetapi di kantor dia melakukan alih kode ke bahasa Indonesia.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "665dca481c964418daf77a911646100216f19d44f76ce47e11befcaee339da5e",
      "text": "Kayaknya hujan, sob. Kita naik ojek aja.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "68b67f74a68aaf5cd12c9c31b04e4dbd613c3cb1460c16b96f4c2c7a4e4597be",
      "text": "Bahasa campur kode terdengar santai, tetapi kurang baku.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac68b61881e49d5429843717256243e554b13d1758d931a6f0c1a1cc1ad8cf7",
      "text": "Betul! Bunyinya berubah, tetapi maknanya sama.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d574bb1d5757983d969fffe3d7cc47c916a3bec07615f208d87db01f863a40e",
      "text": "persaudaraan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "70b8da84b6ba1ae90d6fee93f4a4b6445f07254184ab7c296601c3c4da11bbbb",
      "text": "Penutur bahasa daerah perlu bangga dan melestarikan bahasanya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "7254c20431a42a9ca0e4d6831258cb47cc9b23ad35dde9007e4f81a564a2f968",
      "text": "Kata \"waktu\" berasal dari bahasa Arab.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "72634c218285986c9f36241f9f5862bc36a03c2936d7ed079fa0a1fdfec3698b",
      "text": "manusiawi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "726a1be34f5c5fa28a9c9df10f71c715ee9e668a9b719f4f29846e2923c333f9",
      "text": "kesalahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "733d383b0b9bca5e7da8d7da1a2cfa5c0dc91fd248fb16777ee324c545d1979f",
      "text": "Dalam rapat resmi, sebaiknya kita tidak menyelipkan terlalu banyak kata asing.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "752bc0edc2fa862fae0d4ae027b6fe91c14e6c8127934d992ec71d2902a01500",
      "text": "Mohamed, lu ikut nongkrong nanti malam nggak?",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "7577987019f21331867b2ebe1033523942a80e214e4d60e44cdee91fd765783f",
      "text": "Sepupu saya dari Jaksel. Dia bilang, \"Aku tuh literally nggak ngerti, which is aneh banget.\"",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "7597ce2e46111840231b39786f1afb227d01471e45b47b46fe2e4dd1036c9c4d",
      "text": "Orang tua saya iya. Tetapi adik-adik saya lebih sering campur kode dengan bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "763030f7c53bfde75aec6e882fdbcc27a58aed64b836f21f896ccf3323f512cd",
      "text": "bahasa ibu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "791884725e28c65d74d2754f179d6905f170c65adfbd0c0852fcfadaa239f359",
      "text": "Banyak penutur muda tidak lagi memakai bahasa ibu mereka.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "79a6f2dd3581de968b2f830659bb8960668c8fa30c450400398a589401a69d4c",
      "text": "Kata \"meja\" berasal dari bahasa Portugis.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a36607479c81d678f0f1e40cbc2f34f0a70969855580c4cca0d93e55b68c9f4",
      "text": "sob",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a7fb43bbfc8bc752aeebbea241655b72179bd3df9650bbd41d13b2138b8bbd3",
      "text": "Gini aja, sob: kita ketemu besok.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b944168c0f03b56fec3f465309259ace5e851d9ff3f3d07544730f701824604",
      "text": "deskripsi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cba2cdfa10c7be3f9719e0ead60ee63c07e7b7f865256f3029ef2d314ad0d21",
      "text": "kebanggaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d59771d7153f2c731156fbcb83eb03fac326a81a2e8970c9968d4e7fa90e45f",
      "text": "bahasa Melayu",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eae66b7283e50ed503392933b5483c9a295ea44be7dce986efe26fd576f2f87",
      "text": "lafal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "82a444bbe41a48b0f5cd665c9bb1348a023c210f4c3b223fe34237db081ffb78",
      "text": "Jadi kamu cepat belajar karena sudah kenal kosakatanya?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "8468d36278818964c4f706d1b578a91971938a13b74facdd6348f1fcfcd63332",
      "text": "Ungkapan \"panjang tangan\" tidak boleh diterjemahkan secara harfiah.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "86cb0e3206db6b12a0e7ea85f95317182cc4bb6bfc98edc1b7a251ecb89630f7",
      "text": "Kayaknya elo cuman capek. Lagian ini udah malam.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a6010ea5bc2546ccad245890775888ebd67acfaf07308e9fee4a0165e7f3cb9",
      "text": "Pada zaman dulu, nasihat orang tua sangat dihormati.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c3db52e82b442e0f53363818fc216a40985757b2d91f3a5370ca99d6a4288b1",
      "text": "Saya minta izin pulang lebih awal hari ini.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cafa93782d974c93eb1a5eb947c8bf663d249bfee349f624078e8a27be65010",
      "text": "\"Elo di mana, sob? Gue cuman nunggu sepuluh menit lagi.\" Hmm, lumayan ngerti.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dec0603923a3bb0072646665c7562dd4c157e55d9218c2d040962e57e0d6466",
      "text": "dominan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e17fdbb490d92fb3723cb9badf4aee45a1a8e34587b1b4af7665f13f8cf8914",
      "text": "Kenapa, ya? Apakah karena gengsi?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "9137937747903f99c41382419a08973a8b02333d44506b941ac8acbd97bb92a6",
      "text": "Bahasa gaul itu santai, tetapi surat lamaran harus memakai bahasa baku.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "9580a291793a9663e38948c01eaea1b544849459d5189ec3cb00ed33a0d73c67",
      "text": "Tapi di kantor tetap bahasa baku, ya.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9651899ae9320536858c0a42aba92ec2966fba7fc2504aec7b85dba1fbe71295",
      "text": "Setuju. Pelestarian bahasa daerah harus dimulai dari rumah.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7aaf6238f6628c2e5ccc1652c7f56487e52b825b8a6c132b531e64bc12bbbd",
      "text": "Maaf, gue mager banget. Eh, benar nggak bahasa gaul saya?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b552cf773a96f0a31b6d516dd4ddd9a14d9be24517d165c3647410f7543480a",
      "text": "Hampir! Tapi jangan campur \"gue\" dan \"saya\". Pilih satu.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c426d5849111972a52f85470562b9a7cdc7f7d050ab4974d1b766c7b8a95301",
      "text": "Saya ingin menambah kosakata saya setiap hari.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9df7d40b76a742af84b75eaea4076d354549009a670af422d65c419e72c71193",
      "text": "Tiongkok",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f702100abecb58e0270565bc15fb8004b4ce7efd17a38fa828d7d710b5d8e6",
      "text": "Terjemahan harfiah ungkapan itu tidak identik dengan artinya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a582980460fb1c8e898ae67568f4f69304f7402e80c27e95e81f83102371ffe5",
      "text": "Kata serapan dari bahasa Arab terdengar akrab bagi saya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a62a8b672a139dae34557b5f55187388bd36f5654f0316c971ac14a737f7319c",
      "text": "Pelestarian bahasa daerah dimulai dari rumah.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9b7d57ef8c8f00435bb5ac68f9ed0c7d668a2a937c73e52e1cccd8105789e1f",
      "text": "Oh, maaf! Mau minum apa? Logat saya kental, ya?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "af26d39dadd55b4a36e6d16d28ebf3e416613fd815830d45f1c1408e01677cab",
      "text": "Lihat, Mas! Tulisan di naskah ini huruf Arab, tetapi saya tidak paham artinya.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "b038fa9299ffb46216a1c9248f13d67db3a0e3ad4b2187d854c12ccf6bd005ce",
      "text": "Leluhur keluarga Pak Liong datang dari Tiongkok selatan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3b0b7c13ae47cbfc6fc91d137d7f7f0cc681425bfd27e45161ad6fea0a32422",
      "text": "Menantu Pak Liong orang Dayak; keluarganya merayakan kebersamaan.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4d19d1695856e84b594b581894035343db3bd0dbc844de047dc3ba4e34900b6",
      "text": "Terjemahan harfiahnya lucu sekali.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c93bc93cdafb12934e74d4b8923028a7befc3c504c21415779b974af00ce17",
      "text": "Bahasa Melayu menyebar ke seluruh Nusantara lewat perdagangan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "b91fafb0e94a22402c76f4fec4ee50f404d2eb5f28511c5e7e709a8d7a23f652",
      "text": "terdengar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb622ae1f84689492184df35c1f8287939aeb259d87e064d35c8184c26458a0f",
      "text": "bahasa pengantar",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbff8dcf1141e6900eee99c9ffa283ff3be22ba102bad42118c4bd501d7a90d8",
      "text": "santai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf4e50188d37aa581151c4311984f18177da9d7ce00740a903d0431977dcf0a",
      "text": "Ya. Melayu dominan, tapi ada juga bahasa Dayak dan bahasa Tionghoa yang leluhurnya dari Tiongkok selatan.",
      "voice": "id_ardi",
      "chars": 105,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfd8bc1b95ec12eb6d33def2739836e1335d2509594012e5f78843b36811e105",
      "text": "Mirip, tapi tidak identik. Setiap bahasa punya karakteristik sendiri.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2127c0f208eef94bf5943d8a575623000610ae94e04e22a44951a9b80a8c71b",
      "text": "Kata \"bahasa\" berasal dari bahasa Sanskerta, zaman kerajaan Hindu.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3bea58af3545668d417dd9883e733cdc512e4b01226c492cc58e569a3e01c81",
      "text": "Itulah salah kaprah. Tetapi \"izin\" dan \"zaman\" kamu sudah sempurna.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4084caa9ed97d2fcf7850453e27439b60d38a7333948af58e0096c185a3340f",
      "text": "Jangan kepo, itu urusan pribadi dia.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c42f83a85d4b040c9b281360be333fc04c72ff709aa307b940dfea596301de1a",
      "text": "gengsi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7d274bbd18c242e7ddc7b744901d0751200887b3c53d268a3ff82600f2282b4",
      "text": "logat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8399d2a43019e0bc954885e3198c0e03f6929faf21f712d05239289a7000468",
      "text": "Masjid ini didirikan pada masa Sultan Syarif Abdurrahman. Keluarganya berasal dari Hadramaut.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95809c11e87cd70c8672b2ed7e62cd5103db9874bdefbb5791e24cca4ebd402",
      "text": "Karangannya berisi deskripsi pasar dan dialog dengan penjual.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9ac71028b05f0e79103dacda163fd4deb931bb044b2ed0cd91e631d532eb4ca",
      "text": "Bahasa asing memberi banyak kata baru.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd35a31bd4dffb17d76248bfa82bdd130b33241caa60b77be2de40bb5419616d",
      "text": "Oke, paham. Di sini \"gue\", di kantor \"saya\" dan bahasa baku.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceebf2dd3068a694266b9187be992d2dda9fe0a1a6a18041a4b5401913ef22be",
      "text": "Kayaknya temen gue telat lagi.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d15172d731e1c819f47e2603cbf895af76d1d157bab1630ee9e4b52098c2c3b9",
      "text": "alih kode",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1f5e9652ab47488b924009e65ebff109992f2851846fce00bbc59365a46435e",
      "text": "Di Pontianak, bahasa Melayu dominan, tapi bahasa Tiochiu juga sering terdengar.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "d60622303279791d4d7ad93c9553bacc1ffe955dd25dad5c5b70d7127197e872",
      "text": "Bahasa ibu saya bahasa Arab Mesir.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d656899bd8f1befde4349a0e89078a31ea8e2374cc5a9ae1afcf56bbc0a5e9eb",
      "text": "Dengan teman, saya lebih santai dan memakai bahasa gaul.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7b77ca22e84259dcdbe6dc845d51c305ba4702232aefd3a5b1661be6ea830f2",
      "text": "Banyak kata Indonesia mirip bahasa Arab, tetapi bunyinya berubah. Misalnya, \"fikr\" menjadi \"pikir\".",
      "voice": "id_ardi",
      "chars": 99,
      "mime": "audio/mpeg"
    },
    {
      "key": "da08ff9a2d728b2b977ddf34b6ce2327d2be7de7980a3445813f7a51e07cf4e6",
      "text": "Mohamed, silakan jelaskan Jembatan Arab kepada teman-teman.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "da8429cf3b8a5b2c3bf203f8eb9a31a72fe0a24ebbfc3e836c4a4c17061fd4c1",
      "text": "Apakah mereka hidup rukun?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "db7c920fe9ea21099103df601e3b26ad481d268f360fe417e20fba1156fb3430",
      "text": "bahasa resmi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddace668f241d037f0d552fa999a2ba91265092bbdafc5b95ba3cb0843f8d7e1",
      "text": "Pantas banyak kata serapan dari bahasa Arab di sini!",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "de603f816fa2b01c7827656feb5108a5a7a9cd32e866ecb829be8ab518b85b1c",
      "text": "huruf Jawi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "df6d3c2edfc6d662624788cc99b40ee1bfff7994f9fee47306124a73d1bc022b",
      "text": "Jadi bahasa Indonesia tidak takut pada kata asing, ya.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "dff1bce5b2d30cf2ca2a37c8128b993826866b4e01dd7319512585d04785144e",
      "text": "kata serapan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e183075a79479f39e26f90c011fe175e26f7e060fdd4ff2fdb5cea4b3bcef888",
      "text": "Bahasa Indonesia sangat beragam dan tidak takut pada kata asing.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27724652ddd5b4432b516256723bb074b3ceef751bf573b4f3885c4855cdfb3",
      "text": "pelestarian",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4603a8b3931d24db91ca374f53c426c2dd5d46f33152f1cf33882bec1cd9ddf",
      "text": "Hindu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e63c43c1e7e6517545c5cbe72963033b09ed29012c5ac678bbef54f2abf44a05",
      "text": "Gini aja, sob: kita ketemu jam tujuh.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8f4467e7fbe9d4095cbaa2ecd9951654a9c18dc7c437a748d36c463a033f4f0",
      "text": "bunyi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e97edc304aef8c4d3acadafefe33f7f833eea31a82404f1743d805176016146d",
      "text": "bahasa daerah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaef02ae46fea8c401785d242b357b4cb36375d0956af6ac52f975ae1a8ff493",
      "text": "Menurut saya, campur kode itu wajar. Yang penting bahasa ibu tidak hilang.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec5bb6fb2661cdb28549f859acaac11906452b0fe11873255c22d4be4ccacc52",
      "text": "Bagus sekali. Hanya ada satu kesalahan, \"silahkan\" seharusnya \"silakan\".",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "edc405ba979f67ffec2b805f48f496ee05cdb509922869d9e63cd5f1d2c8660a",
      "text": "lagian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee9f0036ac5dcf114ddd0e7be857beaaa9c7ad2799de6d96614d1459e8110474",
      "text": "Mohamed, sekarang kamu berdiri tepat di garis khatulistiwa!",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f12328f2911778a0d67e025faf41186df1744001a58c6ecdc919129485909982",
      "text": "ungkapan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f30f1eead85b9edfc77b76b08c9f41535cc75904f27fafb251ef583b67c49b3e",
      "text": "beragam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39c2d3ef676d06a59f5e38805a7be00463534d03404d747fdf7c1ad0c9523f7",
      "text": "Bahasa Jawa punya tingkatan; bahasa Indonesia tidak.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f50d345a155914714e2c41c5452e9988b86cd7d9f360bd9f32d67283095404ea",
      "text": "Kadang-kadang. Tetapi kadang mereka hanya ingin terdengar santai.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "f664314ce2003dc93ae9a542157bd6aa112db35257aa7500344259f8329924c7",
      "text": "menyebar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f719e93da29768aa1b3ccf78e9e967e56500ec7d7c80f456f52edd2c99319a18",
      "text": "Kitak mau minum ape?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7246d85daabd715795301220b7a45ed1ee5d2d14385f56aad64e04f949abda2",
      "text": "berubah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7300ccaa13563cedce933cd5435f598bd2d8d36120bd2c68f50e8b8bd04570e",
      "text": "mengubah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f79e982cdef2f4e779cf9d863e8009733f06c3d6e49beec88702210ac65a2bc3",
      "text": "Saya dengar banyak bahasa di pasar tadi.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7ff2c689a99fd361066e290229c0569bd3bdd9315cb7862cc669d12c62c4684",
      "text": "Ha! Itu campur kode. Di Kairo juga banyak orang menyelipkan kata bahasa Inggris.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9e0070752b049d75bfe081980760b392ac02bd58833bd5a68dd6d458d808c11",
      "text": "Bahasa pengantar di kampus ini adalah bahasa Indonesia.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa238249935360958e9b062493fc3e7831fbde1509cd24770dd5edae883881d3",
      "text": "ngerti",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa5a8f9f8dc5ef8e6306c5e0b22c140dc5e433fd2b6150233fead35b5de45971",
      "text": "temen",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fba901f192817e2da56fcaafdddd4c0776860e37be49410c1e34b729e638c1ac",
      "text": "Bahasa Arab adalah kebanggaan saya, dan bahasa Indonesia adalah jembatan saya.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc49600ccb555d9aff7e2d09f185ab366dfe8b07e9cd23424345d7f36523db86",
      "text": "Wah, saya kira itu benar. Banyak orang menulis begitu!",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcf8f296392afe4e3cec5d8992f39e92b8228e6b9a84fb66c2c81b113bd4b20a",
      "text": "Bahasa Indonesia memang jembatan antara Mesir dan Pontianak.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdbe10cafe764a13118f672e992d87aa8592c9ba88beec2d102decfd3c69434d",
      "text": "Dua kata ini hampir identik, tapi tingkatannya berbeda.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdfedad8a57f25b7307eb05970907c4d679a96cb4faf9eba90cea3c2df55dbd8",
      "text": "Mas Rizal, bisa cek surat saya? Saya minta izin tinggal lebih lama.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff2294fa541ff07d6810239716a49268f24cac0fdd8374075b0ade4f31b381e3",
      "text": "kebersamaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff2e909c19893ad81af5df8f8dcb7454368325a1dc80dbe342cac49aa262f920",
      "text": "Maaf, Pak, saya belum paham bahasa daerah di sini.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    }
  ],
