{
  "format": 1,
  "id": "id/bipa2.u05",
  "language": "id",
  "unit": "bipa2.u05",
  "version": 7,
  "content_hash": "b5ed20995037915fca6e9eff93c204f2eb31ac0792fffbd575f1796f421d5c44",
  "lessons": [
    {
      "id": "bipa2.u05.l01",
      "sha256": "f9f10d793e11743e5896b02b356f51aacb12585288eaa4406ca7c7b1dc6940f7"
    },
    {
      "id": "bipa2.u05.l02",
      "sha256": "6bb30207bfeac068b8a2ab6252085975767fc8dae021d9347cd2d83f1e13198d"
    },
    {
      "id": "bipa2.u05.l03",
      "sha256": "d463c5aacaf66fd7fcc017675d1d5aff67079d487f22c5ab2ef935835658b89d"
    },
    {
      "id": "bipa2.u05.l04",
      "sha256": "3da22cba53d210641e15d1d14aa7a4a2533435d01b959db9d09ce035c2389da3"
    },
    {
      "id": "bipa2.u05.l05",
      "sha256": "b272797eec094d1c2e5d228940ea6f56228034e07a4b2d08a24ffed17007eb8b"
    },
    {
      "id": "bipa2.u05.l06",
      "sha256": "629f3952f80d7f5e1674d2fb5e1f6c436855a47bf608fb45ffbe5879e6f1a9ab"
    },
    {
      "id": "bipa2.u05.l07",
      "sha256": "66f40658903a2cedfe579184e2ec1a7ada114ca81f0a4884340fcb7d49c49b03"
    },
    {
      "id": "bipa2.u05.l08",
      "sha256": "89b913ae640fda1fdd5084c6fc2f0c8b0f62d4a3fa9ff3dd7871a9bbf97f676f"
    }
  ],
  "audio": [
    {
      "key": "00e40502d75f190e1bb83ba9611dc3044bdeb9a2093e22721807b2e34f2b0b40",
      "text": "Pedas sekali, tetapi lezat!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "066b8ea2dce2a0f11566032b1a3bce6ded3c6c95fb5cdf16c2bfe91db5695177",
      "text": "Potong ayam, lalu goreng sampai harum.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "083f77fc86863753842eb3a062d8820bcdb9fbab24a097d759080d1f375c2e45",
      "text": "Halal, Pak. Ini warung Muslim. Ada ayam dan ikan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c229a2226f4c4be86558ddd4adbd04f04a78424f98f0189ac98546a23ad2a48",
      "text": "Saya mau mi ayam. Ada sayurnya?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d718511f64cc292ee6ac72907f835b29c5dfe74c5c97f9912fa8be2bec79831",
      "text": "Nasi goreng di warung itu enak, ya?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e385ca7f533055651ef2dd6023e1bc2c8f31921c0aa68d0adaa4f840435466a",
      "text": "Tidak. Coba rasanya... enak!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "12ff362df13891a48212bbae945c6b0f8fd0acb3b3b4bc4f4bc2b6e6a8f124f6",
      "text": "jus",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "13797c4dfd66ad4d365bfdeb45a5e2e431c17684dfd7feafdd3427c3d9c78c7b",
      "text": "Ramai sekali! Itu Raka dan Ni Luh. Mereka bersalaman.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "1476fdfca21734ca3b0fd938147e370fa78e7891443a8ba9d3cd857bdd850d87",
      "text": "Untuk orang Muslim, babi ___.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "14e25b39959e90486da6cd8bf4d202aa00632f995076ef6c3c17b8701f0306da",
      "text": "Lezat sekali! Ibu itu memasak berdasarkan resep neneknya.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "15027561472cf205f9c779a909cad57c24b899cab6f29d4d072fe871abe1bbd9",
      "text": "Ini caranya: tambahkan garam, lalu cicipi. Nasi goreng siap!",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "16dcf201c1c343cdd172c4f3a1031bb6219ace78bcf5114c4a9d2f5d5692c47f",
      "text": "Saya mau pesan nasi campur, tidak pakai sambal.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1731afdf61bed06b8d2ee40090dd129f94e39cc01e4c455990c4eec6b1015edb",
      "text": "kecap manis",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a8078166f0c0434f15122b29fd862a16721b06da4c1ce5dfd64ef29de56cbf6",
      "text": "Tamu-tamu berdatangan dan bersalaman.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bfcf01e360f012abe9395c2184810b30cbc4024530619c646306850209c922a",
      "text": "tambahkan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1eb88ce29ecbe86265344a431dc5c43261af4226dd0a180e1c7e72000a1de396",
      "text": "halal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f5501d6631fdc6331992a5486610266d7060f2790c86f66c02069badc9d2805",
      "text": "Sambalnya pedas, tetapi lezat.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd7d6277a99a8e21fabd69316886619effc000b059f5b2c5989e369823e077e",
      "text": "Tambahkan sedikit garam.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "20e1e2f09b506da546c504ce509275bd24024dc9f3d7df8a2728c8bae010eb4a",
      "text": "berkenalan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2103768946a2812c40218ac39e877af4605048d4a476a1366f01509d8b738ffc",
      "text": "Goreng telur dengan sedikit minyak.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "238f05aec9b81007e8eba2094b389e88b89bdf307e6c951a4870eeb7f119828c",
      "text": "wajan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "25f308d8de05b4f5274ee7512e3f728ea1c9ba9e94f8fe63acd3caaf0cbedec0",
      "text": "Saya mau sup sayur dan nasi, ya.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "272d215d496259724c0325cfb8011822972696796d1e9d884beb5cc38fb5c952",
      "text": "Lezat! Tapi tambahkan sedikit garam, ya.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "28d99725f485d6047b59a1ca06ed7f974da5ca2feee0a101432571f5d8a94c7d",
      "text": "Mudah! Pertama, cuci dan potong bawang dan cabai.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "2964e4133c48c061311657a6a91714e94b7e108e9928de82d6b1cf0a22e6bd26",
      "text": "Lalu goreng bawang dan cabainya?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bb9971d2070679b483f8f71ea4d509ed3acb06d0ec818eec5c749a84c102fe7",
      "text": "berdekatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bc743a5c23423bbe2e547cc1c387011a6327277c82f992122757c2c466208d8",
      "text": "Bu, makanan di sini halal? Saya mau pesan sate ayam satu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "3047824b074bc587bdaf1d4a38d5f290ec1a74b932bf8b5be90ac34b7510ac3a",
      "text": "sayur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "30d10dd7000841a824037f7dbd2817c3c070033e431d279d550f928b65c9006b",
      "text": "Setelah salat Id, semua orang bersalaman.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3136a2a0ddd27e560b7af56b921c05c80d281e2053cfd67b9826892d4fdd5757",
      "text": "Mau pesan apa, Pak?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "3386ecaa5e800bdd27eabc27517b121f1fb0b1cb872c5246b5b27bbbd5d7a6c4",
      "text": "Rasanya enak sekali!",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "33938307bc8945d99082eea28aab9df3f847a9d715beb8775b41b7de9b0c7000",
      "text": "Lihat, orang-orang mulai berdatangan ke pasar malam.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "33bdae89115dbed3a6e963ce0dc51e051e9d917a2ded524a6cce35cb2d27ec90",
      "text": "Saya pesan mi ayam dan jus jeruk.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "370445ef6749bee9846c08191ff5221a1e1ddff4ce1025b3e6224005c806f218",
      "text": "Panci di atas kompor masih panas.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "38b3115f87020474b3571b4fdc2438d7aca1449f6cdf86841dde8a7dac6542bf",
      "text": "gula",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b8e1b11eee1657771e91a8cab5baf2227027cefd8b60ce5f09f9859bbaf762e",
      "text": "berpelukan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bbf5fbe769fd5c04c9918b506989a8c088b47d083397ab356828fc2937541e4",
      "text": "cuci",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ca54eba767cb92de47da915e977e50f13fb46e26638cb12f00a82f9385c169e",
      "text": "gurih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d08c6ff46ace1eced1ac331e87c94115491b50776bb2e1fb6bd9d88ec3d8857",
      "text": "berhenti",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d6da213e4073a136d22077b5db090f73247716f3b0ce3e85f0d9f122a686160",
      "text": "Kami berkenalan di Bali.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f125e03163d67a85fbde1b1900c7c0a88ed1744389a28f085659bd4a28ff04b",
      "text": "Cuci bawang putih, lalu potong.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "40861633da35e2cde02dba6b25825862b688068e335f910f4ed404c031a8b479",
      "text": "Sudah, Bu. Lalu?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "42414a15cd09ff0fb7efd1092ca7534db948de9e3a47aa4f22c12ba8356092dc",
      "text": "Berhenti! Jangan tambahkan garam lagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "45d40b18cbcf1c8f7923034e0869386cfaba010d24d4c508f15bc2afbaa38a88",
      "text": "Teh dengan madu enak sekali.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "4667dd15ae0e0b8916d704596d2bbecacdddfb41a53f7cc0670550aa33b8efe3",
      "text": "panaskan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "48494f2dd24d0764c471cc8e76d283feee9290dad4099104f5abd8368bec5328",
      "text": "berdasarkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "48c248b1a374165a39a34172318cfc14318a773befb759b465f0a5d6a61f7e61",
      "text": "Ini, Bu. Mau masak apa?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "48eed67f8107afcec6b9151fe72ded28fd8c787fb889d5e6c53754c81b04d5d5",
      "text": "Saya mau pesan es teh, tidak pakai gula.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4953119c0c8c3823423333d748de55f0bd8b1d9ddd062550414b987f0941f53a",
      "text": "kulkas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "496cb1c7b3b477e2bd466cbaec7f7b327afe40dc6175403b52005cb9890bddd9",
      "text": "berdatangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a9e9a34ff628633fb26c05cd99e0be2555b57718f9d046db625a34f751bf7a4",
      "text": "Mohamed, mau makan apa? Di warung ini ada mi dan sup.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b3ecd185fa51625264f09e16f2289952706e3d26b3b01f4e7c3c8bdfbc45538",
      "text": "Ayo ke warung Muslim itu. Semua makanannya halal.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f070e9a8f949b6823fc52545dd1afdc525ae9c3688a1f23c2a7657c4f8b00a1",
      "text": "cicipi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "506db85f9d2c099783a52f568635a0fa9cea546652ddfa06749e2a03101749f5",
      "text": "Nasi kemarin tidak basi, Bu?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "58901fa1570844c797fac23bba6d2619a95e33701f0c972e20bb632b8af0e7df",
      "text": "Setelah salat Id, tamu-tamu berdatangan. Kami bersalaman dan berpelukan.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b3f1a3e08aa6b846a27de2932fac9086c6a877c9b9e89b46fa0916672026625",
      "text": "kompor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "61e757359ebc1dbbfa9b8d4316c4bfe1950fb1ac021b81b95ac7438123b4e23a",
      "text": "Tiga saja. Jangan terlalu pedas! Lalu panaskan minyak di wajan.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "628dd33c1b68b17b4dd78442f4dfffedfa4c2f693100dd60a83d63d30682fdf5",
      "text": "Mohamed, cuci bawang putih, ya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "64e59d75ade3ccef4b24d2dc071366a75db9abd7b0637354d6a8573b98ba00ef",
      "text": "bawang putih",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a51285eecfc4cf64f8ea03d3bc15a193f4860d2a95ac3a01315849a65186697",
      "text": "Rebus telur, lalu goreng bawang putih.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ac1da0de45d6fcbade399fcf6b0ac633c60703c2785d92a878c9dce88711946",
      "text": "lezat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ad4eed11f49ef5738896ac24925f690dc27760b1d2bb1fac982f8f0684b6190",
      "text": "masukkan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b63bdf3540dbec085f594d0688c3cc1967bcb72c150b2f061bcbe546181a470",
      "text": "Ada. Minumnya apa? Jus atau teh?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c6cf5a7ac7b943ef89500da196ac1a88c7c62709c916ee8c11d2bdec61e2122",
      "text": "Dagingnya masih mentah, belum matang.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d8ed97922d2fb40f18ee8fa925c4fa34113e5e5009788e112367c1d2a520008",
      "text": "Mohamed, nasi gorengmu enak sekali! Bagaimana cara membuatnya?",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "728b812ccd8b8647b8f3273f21ddadccd85e39820d556b764f3f5a41a89a2814",
      "text": "Bu, makanan di sini halal?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7416792bb5e774aecee714819666a56e216bbc634d1cff693438db6673ea7522",
      "text": "Cabainya berapa?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "74598c69239d11267f3354e84870bf042b4bff4440384bc2900d7f41857ab692",
      "text": "Coba cicipi sambalnya!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "747bcadb2328d08ee1bfad173124970ef6e24309ddd0bfb7da3450a9bb4076eb",
      "text": "matang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "74df50e423258215700865dc4054496dda6effdb90bd9b5c05e8f187558ebd04",
      "text": "Jus jeruk, tidak pakai gula. Kamu?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7648c7d13537b48aa8a0645a84f8e83e60fec0d9855cb219f86cc6682a70a7dc",
      "text": "Mi ayam dan sup sayur, ya.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "77e312ea2ea586734557f11202f6bbc10613c976ccadde6a16b35caa803fc265",
      "text": "Sambal ini pedas sekali!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "78826953d9bfdc2deb7e00b8df867f7cd60074a85ae4cf5de61fe794c118c5f4",
      "text": "Panaskan minyak di wajan.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "7900cae530af96bcbccc693e4fb84d91788a92066287babfe1c59a5e8f49b5d3",
      "text": "berlarian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7943422878ae9188bfec6bf72dde471df33e485e26450a5ec959c91c5990cafe",
      "text": "goreng",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bf62902b83b30295ec5bd8c48aedaecae41061a8d0beb574a0fd196ef80ea13",
      "text": "aduk",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d80782f287ac2a69712a3a63c66b4765f19c1ff53475b69d41c2b923d3562dc",
      "text": "Potong bawang merah, lalu goreng sampai harum.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fa634dbbb8059bc977cfcfedce1d97c42d5fc7c246cc3eed32db0f4c9fcc6ee",
      "text": "basi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "80592fff220fa0c25f46a2e06bcef9d81027fc56dfea237cc4c4bc6507837538",
      "text": "Sedikit saja, Bu. Jangan terlalu pedas, ya.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "85826302b1198bb905475d6f04cc633a82942b6f0a850af95a74e1652cf86528",
      "text": "minyak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "861c46361015824ede6edb295dc8c9421f8503fe8d0102aec6fbe2a0e0c9ef30",
      "text": "Anak-anak suka es krim dan permen.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "86859c1ced63647a6660d76b9b231d710d77bcd90b65fbb3d44c134be5a75f5d",
      "text": "Makanannya halal, tidak pakai gula.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8889fe24cdcf4799623e5aee7416a6755a7fb9b5e59411a1f0dafc14db1c69ff",
      "text": "Saya suka sayur mentah. Rasanya segar.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b625364992790ac0a4b18bd261afff40495c5e3e8b506071cd170e2756de607",
      "text": "madu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b645a437118f30ee828d7e31c6386319e369036c7d20b6a28abaf6c87f74524",
      "text": "Sate ini halal dan lezat.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cc0554463171c2ceb8201c9dcee243b2ba7bcae8bb66f3bf741e77eee851243",
      "text": "Tamu-tamu mulai berdatangan.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d5aabaaaa442d08bb7f59aa64078a7c143dc7392f53bfc4b20a5c121bf4b712",
      "text": "siap",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e8418ae778dfce484a330c0e70d35c8b0d370f19b87cf9c80e18244ebe93d38",
      "text": "rata",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "934b674c9b8c2a8d7a8aa280d86ee374fdec7996f2cd4d3b37c816ed4ed6d697",
      "text": "Rumah kami berdekatan, tidak berjauhan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "97b37d8e725d3b315499f7d2de6fc4c026182ca22bcfbc6d69c43e63b20ee222",
      "text": "bawang merah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "99e60660efa449c89a0aca23ab4885a045774a62e0be232934d2a811693fa7a1",
      "text": "Sate lilit ini lezat sekali.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "9acb2181ab968bf1f81d7f273ca4a99f92bb2ab49c6479503058d86ef20a8e50",
      "text": "Anak-anak berlarian di taman.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e3bd44a3dafca84f524e5d25f12b1bfc720133c1eb61c8a38be8a6a408f7674",
      "text": "Potong bawangnya, lalu goreng dengan sedikit minyak.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fb17274b84b15b0e51ead231e948548761c06ae32280cc0a8bcda635569b76b",
      "text": "Teh ini manis karena ada ___.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1eaac52ad35fbe311f581cbfd0f606fbaa6f744cda81a0eb3d15da76d10c064",
      "text": "Potong cabai, lalu masukkan ke wajan.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "a22570f2fe5af41b41698fc16beb9e66db54d96c8efe990617c53c81c1fbdfd4",
      "text": "mi",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3e4e2f42a8be8dd9cc4e1468a5df945835875db41d5e144b2024116b2e9c5f9",
      "text": "panci",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a766faca1d159f8a1a7de08b53f515424115ff943ec58b6cbf028311da04027e",
      "text": "Rebus air, lalu aduk.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa4ef5fc7c887054e2b373da3b293a3cf4703de7b8b0139ff670ca0b18492243",
      "text": "Mohamed, kamu mau makan apa?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "abdbfabcc9a43a87b5f4c1f4da76c7fbae7f882488a441f3a77000f9415c7e6c",
      "text": "Nasi goreng. Pancinya di atas kompor.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad443a320bd0907fb7e430f4a74fa99bd45a3bb355fd5705f44e5928b4c5ad32",
      "text": "Ya, goreng sampai harum. Lalu masukkan telur dan aduk.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad526017e48da2f99ff378f277a7b30fa7dddd09a4ded5cd21846002a37f29e2",
      "text": "Saya mau pesan nasi goreng satu dan es teh manis. Jangan terlalu pedas, ya, Bu.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad667271cd44e1f71d8f30eabe4139e281bd5d305c1f0fb6544534af1949970e",
      "text": "Tambahkan sedikit garam, lalu aduk.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae2f340532cfb0957a313eecad2b9375620ffc93dca70da9d17bd9f60e5b1c4e",
      "text": "Ini warung Muslim. Semua makanannya halal.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7d528ca9e222faf897480a08fb5bc998512e86959d992180c0ccfe23db92dd9",
      "text": "cara",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b99dbd3ce4a903c6639b62ca0f63ce00cb01aadefca682bede77cdf57b9e2147",
      "text": "asin",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba8c92354f4eb69bed8bbcd591107802af09a45b16dba59dd7cedbafcd0e125b",
      "text": "Wah, harum sekali, Bu!",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc6e17bce8295733a8ccffcb92702cd0812ece8e8684389a17aefb1f074ac1a0",
      "text": "Nasinya sudah basi. Kenapa tidak di kulkas?",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "bced365e78cf328ef58df104b429080decd5a29218439490dcf00d1ea4d01920",
      "text": "Saya memasak nasi goreng ini berdasarkan resep nenek saya.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf5b9712f34b034b3f63b37a93774fd8f213f0757381a5077417f97c65370c4a",
      "text": "Ya, mereka berkenalan di sini tahun lalu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c12e19441f4ae76a953293da4bece413444555833a24e4223240e1eee30ea7f3",
      "text": "Bu, ini halal?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c99c3045b61170876d361e9df7a0ca8fbe1c3dd609c9901fbebb84cbe8c3b0e2",
      "text": "es krim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd5d0499ae17a965f0a169103cf73509aaa07daf328be03bc8ed8002bd2768c1",
      "text": "Sekarang masukkan nasi dan aduk rata. Coba cicipi!",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce9a0d808e639ba8fcc8871ad1d43635e5b6cb9b737a8b56b61e811c5e6febf0",
      "text": "pahit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cefb9fb6791a006f2aaa9ad7e7839852ca98f40e3c2fe547202494e66e6c7c6f",
      "text": "cabai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d01e18b68b04a3d0c6456ab1b31ec427edc87662538c5f9c0174e7a42d1677e1",
      "text": "Teh panas dengan madu. Nanti kita beli es krim, ya!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "d04d55767c04a4808a6e22275554a505122acf50991774d5eb7af2bad7ee52c1",
      "text": "Saya ambil mangkuk, ya.",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d32df71109b6a714f37f6614416e4924824809c787450e8f6d3bf6970781b76b",
      "text": "keju",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d37c6b741c5d6dc36f2c1ab9081faa2849b0e4f8ff09e44913ae6abcc7d82209",
      "text": "Kopinya pahit, tetapi tehnya manis.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "d59086440059fd915d867fca6f3582889470c4326e1f0c2dc796b42ecdb66253",
      "text": "rebus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b74f9ef3c406a15ce9bd374a7ed31c43e082602831490e02c85cc82dedb263",
      "text": "Kopinya pahit sekali.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddc0fe191085bf00eb119a2581c43c2181fc5acb270e6a197f91da0049c24960",
      "text": "sambal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "def8e8cf6f34b2c52c319ba654079808ab2e9db1d78c10785b96569a8412092a",
      "text": "permen",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d3195a5f1460f9a5bd730c3fadced08fc17af97312b1bc548d4aa41268e101",
      "text": "mentah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e31d3a11d59ed069b160678abea81d7fd9e8997ea66970ec0b6361c5aaad357b",
      "text": "asam",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4e4b01758be06c0f4adcda2c411e15cc3f81031c145e5e9c43b8ba181f1622e",
      "text": "Saya mau pesan nasi campur satu, tidak pakai sambal.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e59e8c2ec757300c910a78ad1786fee891b93824a3360731eb446472dc308471",
      "text": "Duduklah, Bu. Coba cicipi nasi gorengnya!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e657088dddee2f32c44a2ac58cf6dbebbca0e85a24f8caa87c1dbf3d42273b8d",
      "text": "Kamu bisa memasak nasi goreng?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7af968a6b4d99ddd2ed30a10e6c75eade60e376b16278effe6661ff33f7746f",
      "text": "Masukkan nasi dan kecap manis, lalu aduk rata.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "e83a6cb2ad02861f5035cbe32e4c75db96a577daf4b1cbcb39f69a4552b06ad4",
      "text": "Mohamed, tolong ambil telur di kulkas.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e83e5b21fbb156640ab944eea4fd08badfa0265cf6eed59b5c612d15e43ec478",
      "text": "Masukkan nasi dan aduk rata.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8b8bd9841f6dfa9eb1023f16149885f1ca07ad5059df1cc1a12285c708a7244",
      "text": "Berhenti! Minyaknya terlalu panas.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e93d765407d62eabc8f05ab2bf6fe09a81fa8a6a66b6831218471791785753d4",
      "text": "rasa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb4aea5d834895af27b3fae3224560b83f612cbb6db442d04706a79593ce2d2a",
      "text": "mangkuk",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee258207ad46ba73b8e352cfdf95ac85148c07cd23b8de40a9214db7ca847948",
      "text": "harum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eed2269ca84f4b479109e47305cdf8472fd8fc3b35fbc1c7de9b8fa4856f7825",
      "text": "Bisa! Goreng bawang sampai harum, lalu masukkan nasi dan kecap manis, lalu aduk rata.",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2bc89ea375a519bdb12f15e08785c990395788427b5ef823f8d2304cca8df46",
      "text": "Wah, ide bagus!",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4c4ee6481cd79d40876d5c82a807cfc286d6e7eba1c8aab5daf2747655d919f",
      "text": "berjauhan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4ee3bf3032d07ce597694920c9b91dbcf50324f70fea104a9a40204174618b1",
      "text": "Sudah. Lalu?",
      "voice": "id_ardi",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5c9efa630a9492328c1968d4f44ba31e509e6b3014dcd8c3a4bf41e8be52868",
      "text": "Potong, lalu goreng dengan sedikit minyak.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7313ed393cadc6d6e5b88155d05dd2bcc90cf99c059db4034903ee06177704d",
      "text": "bersalaman",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9adcd7b9a7c8b716b697a3774ef5a02049f7ebbbb6af670825fbaf690c996cd",
      "text": "Mau pesan apa, Mas?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa0402e18737eff0d1d3977728cdd287440ca4ef0776849dbd4a8eb4e173278c",
      "text": "Ayo, kita masak! Cuci bawang merah dan bawang putih dulu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa2f31c55929bb8c26164e7e54d750c5febf6e676d69acc647ad5a9e34aff5eb",
      "text": "Saya mau pesan sate lilit ikan satu. Sambalnya pedas?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "faaddcca028ee1ce5cc755a6d4d8a668bd3156fa51f615546d9c51083314f30a",
      "text": "Mangga ini kuning dan manis. Sudah ___.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc625f82925ae4a3a793fc6c70b0d8bbe15c42239b9f9401ea6ca087c99c762c",
      "text": "sup",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffeb5225ba8cc0d5a8bb821c48117440dbfd96496b40ed470d5e67cd25e586aa",
      "text": "Wah, harum sekali!",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    }
  ],
