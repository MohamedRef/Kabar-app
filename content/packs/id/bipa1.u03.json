  "version": 11,
  "content_hash": "ba5806f04b9be5b13fa5d265b0d249bd7451e5bdc6046cdeaf1d99cdf7d2c824",
  "lessons": [
    {
      "id": "bipa1.u03.l01",
      "sha256": "fcf26f719d7f6ebc71f587e68f37accdca56b4a5e554af8120102f1d3b34a2b2"
    },
    {
      "id": "bipa1.u03.l02",
      "sha256": "cf927d6595a889b39aa0ed6215176da59ae82d3b40656e2e3503712ca9a6d7ae"
    },
    {
      "id": "bipa1.u03.l03",
      "sha256": "92874b32e9e9c0faa9478905b8aa979e5614d62c445a378c82c88d4608a1282c"
    },
    {
      "id": "bipa1.u03.l04",
      "sha256": "52a2f06d0d29b9d0426d2e3497343e1684e98f8b59c19364badb2b201524dd25"
    },
    {
      "id": "bipa1.u03.l05",
      "sha256": "899d0adc6939a77d31f82ddf6ea0570aeab36e71ff4b68c04fcaa374022793d0"
    },
    {
      "id": "bipa1.u03.l06",
      "sha256": "e801547cc10c6d708e1ea0642f4de537cf5fd89072827b2a7b0ce277e84daa8d"
    },
    {
      "id": "bipa1.u03.l07",
      "sha256": "c983c7fd4b2bdba2d108918ab5e442fd7dc3c1093a89110a224f7114fe303ae8"
    },
    {
      "id": "bipa1.u03.l08",
      "sha256": "770e03a5b64620bee2a5220b9e42fd3f45c4e03e5bd3a26669b621e798c63dac"
    },
    {
      "id": "bipa1.u03.l09",
      "sha256": "ab482578d6e8c3dd420095d3918836169007b0c15ff2df3b23ae55f9d480c1a9"
    },
    {
      "id": "bipa1.u03.l10",
      "sha256": "0f55960146219e1584155fe02ddbf947fdeae99fd0cd709bb5cee96404d8c13a"
    }
  ],
  "audio": [
    {
      "key": "006be9feea554d48876600ee74b77f52eb3d64880daeb05285a29910318d49d8",
      "text": "remaja",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "01370f595326720b088737788e1744e1c0ba45a778ca4ff0c3b5d39e730776d3",
      "text": "Ini rumah baru saya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0343d96399836dcbdeebc433cfc55916b01649e7c6ba26b4fe10f8774d009a3c",
      "text": "Sama-sama. Rumah Mas di mana?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "053233a8e458e10ffe32ba7ee62feadfbe9e943a28e3a9436d114594279dcc6a",
      "text": "Selamat pagi, sayang!",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "05552961754d57b1312bab31a915b01f6ab9f74f45fdefaa792f2cb87fc144b0",
      "text": "Papa sayang Mama.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "074c07199657586a12f852f898a06e03b8dd2b941ad374f611d4d73976155869",
      "text": "kakak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "08671c206712687109ceaa26648d0020060466105f58e099e9a970676f6b33cd",
      "text": "Ini adik saya.",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "09eee2777c4696fd2e25456e7616d89379f73280c2264195bc8d83793417307b",
      "text": "Selamat datang! Kamu kerja di mana, Mohamed?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a3593b9efb22674621f293000f5c95ef1879660e301de95af3ce36e0f31c704",
      "text": "anak",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c00b7dfd7302e3ef0914d3352118d5191204c0aec2651c30cdf5608a49aead9",
      "text": "perempuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e68060c9a748dbdde91447c04884bb4bb890e1e42458da5726504e7094b2661",
      "text": "Adik saya belum menikah.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f6888ea456b02d4d38f698b01090a25d35624f2be643ebe0774587e4a94b362",
      "text": "Dan anak-anak itu?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1089c9081dab35eda5fc2bdc69c9f8729c0b8e91eeceb235767cfb6f934d9ab2",
      "text": "Wanita itu nenek saya.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "1478e6a245c84e76c7a7ca0c18810a3b05ef5c9f8764b6ac7df61c59abe3436e",
      "text": "Mohamed, ini keluarga saya.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "149044b7fc8fbf2854718886e0cfb415f48d4934d94e144cad154ddff80d358f",
      "text": "paman",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "149084e7b5c4be3b6e8bfe24708206c1faee5a4301f0aa8bbdc2cd9061d1d841",
      "text": "pria",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1524e5ebe1652a34889c2cb493ae553ca29dabcdbf1e5c8ca68979dbc4ad705b",
      "text": "bos",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "1725ec12561c42f2d347a3c02b04e5f5a809f3ce1ce3d4a637cd6ba89d962476",
      "text": "Rumahnya di Menteng.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b2f581f35f24f4d51fca9711c735e906aac1d1c064fcb176e8d4ac8792b604b",
      "text": "Selamat siang, Pak. Salam kenal.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c04de823df20b42cf363dca64a098816360de4bc50593e0af7a3a84cd7d725f",
      "text": "Ayah Tono adalah ayah Tuti juga. Tono dan Tuti …",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f659d0d6bf53b7cf22f51bc8c4ac7e008982833204f25792a83253ac4944937",
      "text": "Itu adik saya, Fadil. Dia mahasiswa.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "2297a61aa466742659e38679da94861ff9cc95f5203bea12107034c6e025b949",
      "text": "Mas Mohamed, ini tas Mas?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f626fab333f8836bcd33e774ff1420f11f2fcb68ec3c10f48cf251358c9278",
      "text": "Anak-anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2403948a2b9308227217e16119cad1619b0e008e55735292da89218febe65639",
      "text": "Ini rumahku. Itu punya Rina.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "24bb797e3438042db403c38f75f0662c12df2d883ea8713d79897c83181697dc",
      "text": "Ini rumah Ibu?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b71c6d06da23cb94ecf3b62a57ea4644c6023b8816732cb777f9e29b346a76",
      "text": "dua",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b8e871a26cbf0e8f93e84b744b9076f6500ccc9bce893183bf3a53c86cdcfc",
      "text": "bibi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "29b40cc030d2527106279e4e3380b30030e7dcc28aaf7ed22b2f816e0637dab5",
      "text": "nenek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b95e04d640e8d856a72490c9e5174731b1ea96f0620da6aa946c33af2bc8399",
      "text": "Ya, ini Dika dan Doni. Mereka kembar.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bbcb1d253dc8cea6b30611a0b4773123069a94ab5b3a7d44a3363e3d04c1ce4",
      "text": "Paman saya polisi di Jakarta.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ce50082440bbf036993c4a106837fb934ba2cb7f1a93a726b9ccb0b95e2de6b",
      "text": "Rina, ini rumah baru kamu?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f0a0a5d40f28b78d2897467ac9f1b2a0f50ce78028a228f6700cbc827fe18d0",
      "text": "Orang itu kakak saya.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "30d9a230e95c9e9c9219097e28fdb67c4f63d59bc40aaecfe270b2413459659f",
      "text": "Rumahmu di mana?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "32ab83b0eea9b9402c504a73113476dce7b20342194a9ff3c197e0222e4a6945",
      "text": "-ku",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "34e26cceb0c5a2f7051050e9882f21b6f71c55d1778483d3a0ae340ad9eff56b",
      "text": "Kakakku yang tinggi itu. Namanya Ayu.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "37cc77df226bda0396125cdba6343b7cd99a28f8e46757dd701e4ba0013f1e26",
      "text": "belum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "37db600cc4307317f6674a7a9165928117d37c7d8b6c9746657ef1a4910126e7",
      "text": "semua",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "387c8ea2f138f22bcb391de481ad9411f3c07e828c7ec46f95a4123d99996ed6",
      "text": "Semua anak di rumah.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6d74ffcfac9ad8ea3b9dfb715c155ed5bd60e6efd63e870933f77174852a73",
      "text": "Itu kakakku, Ahmed. Dia dokter.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "3db9917fc094a7eda011f7dba9a8111bacee877ded2b7325bf33d94bdc2680ec",
      "text": "Kakak saya yang mana?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "45833cc46620f30a59e3187167e222d5032c9fa47ed5dd2a9aff7ee6d3c82a0d",
      "text": "sayang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "471c4bf1690f552a392b480d6240604b0fffb09d2bdc2a44ad57a8d670b4b570",
      "text": "Kakak saya yang tinggi itu dokter.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "485e2e40a9d2e6657c9b6326e98f026936e108b25843358cce4354757124ecab",
      "text": "banyak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "48fa21f62cb79092b1360813ffbd7cb1db2d00874613d586be34e77fac13f0ce",
      "text": "Ini ayah saya, dan ini ibu saya.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "49f864e318e45e064b3cd277396ad6e6f5eef99ca4cb6e881cdae97d21906f2f",
      "text": "Kakakmu sudah menikah?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b0803f0c3d8afd0f553de1b7ed0dddb26113ad2de5f30d183ebc7353ea86779",
      "text": "siswa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b62a180ba0fec3906c031e721bc06b087dc801fc03a515dbc6ff685675945de",
      "text": "taman",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c3bd5fc6a22329a70e123ed86e315b7ee010aa85ca24bdeb5b2f024752ef478",
      "text": "buku",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e7a20d23b0581b49d8bd02409f40a84158d71cff1f9676c06ca25f69cb3932f",
      "text": "Ini foto keluarga saya.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f518231dac310d1d96093c2a517789bf93ba96e47b548e6f1c951ab6f4a0ca2",
      "text": "sudah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "509aa00340bfba1f52a726b7423a76c41bdd5356e85b41887c74c977f011eae9",
      "text": "Saya punya dua adik.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "51894155bc6a147763a150a8c1c8b76a7d097bfef2c9ddce7aff56e3a4560ef2",
      "text": "Salam kenal, Mohamed. Ini anak-anak kami.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "541107dbe8ba203815951c2d8b52b223771c7c5de245128ef3534184b64e8c2b",
      "text": "Ya, keluarga kami besar, tapi rumah kami kecil!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "567647934291f3d7b4127cdf5f9a52629a4d10f6f21cc5845f646b7332b7c4d8",
      "text": "suami",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5915bd99f9c55d0e624a66ea1505e41beedb63cece428b169d4963abe13d1eb6",
      "text": "Terima kasih, Bu. Rina, itu siapa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a9480f65b27cdd42e536c4b250055a70b2066535ffd0917ad6156856e625915",
      "text": "Ini foto keluarga saya. Ini orang tua saya, dan adik saya lucu!",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c5bab04d703213c9111fe6b8ea882080421821bb777adc6d77edce4d6f4c9bb",
      "text": "Keluargamu besar!",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d3367f7e65dbdec37ed792197d26f9de45914c00a012f00712af285be66997f",
      "text": "Ini foto keluarga saya di Kairo.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "63b0598dfdf45aedf92de75ac4ee57515b6a6af64b8d1fff929de7bb7b9780c0",
      "text": "Hai, Dik Sinta!",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "653bcc9b40d24ccef3382089c10460e06a1b7b39a1346bf5592e2894cbc61f03",
      "text": "polisi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae1b254e65d5ba95006f2ed6a59e5ded97a3304ca651482083fba4592da7f70",
      "text": "Ini foto keluargaku di Kairo.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c174825cd6c2a47a1ac7169a15246de3a0273ac34d7bdafff32d47ceb619781",
      "text": "gadis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c889f64e0669886e3a53e4f790359bcd806c8b2dc5d1156db43a597bbdbabc9",
      "text": "Kakakmu udah menikah? — Udah!",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d5dceb8cf5f6173c590f5738a3fc543bb46197d4aa00aecd3b7dc4ba12c42b3",
      "text": "kerja",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d79ed56b4dd2b37d8eec94659b98b2d99c086c26fb5dfb21d66240db18d4c20",
      "text": "Ya! Rumahku kecil, tapi baru.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d7fc31cb8b22a4257ca920a0108b1daf8b579b07add767ead083ed7792c685c",
      "text": "Banyak orang di Cikini.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "73b21c9ba329d35b487b012c275a04fc33efb9abadb9a11acd6241bf87c223cb",
      "text": "Ini keluarga saya.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "7512d6d7408509782a4c92995488f5d039a0a564f1f92b9fd94ad816a1a4b176",
      "text": "Saya mahasiswa, Om. Om kerja di mana?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "754bdd19687a1188731de369fff0ac8db80ede32c0e277b56337dc89e5ee8b94",
      "text": "Pria di foto ini kakek saya.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "75d4dc3a76838aa7ae7535b6de8fb5d4728fa9f1a82567908bd566ab17a54179",
      "text": "Itu kakak perempuan saya.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "794a0c3b326e31e4d427af30d45f96a1a0b7d23f9adf4a649fe324d35a03d33e",
      "text": "Sudah. Dia punya tiga anak. Anak-anaknya lucu!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "795f41f4fea3b5397455eff3d9623ca3392aa6f75d769df139db97defc5e257d",
      "text": "bermain",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a128b7bf7e23e5b7196c6a66dba8471b94c94be3b3bb2ad0f5e675a192d70c1",
      "text": "Itu adik laki-laki saya.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a73bc12810aa240dbad158714ade526112c88ef44465997cf98dda42a87a6dd",
      "text": "punya",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b7cd376466678c979ad06adb5764b4551777603c521753ef9af8ba9257945bf",
      "text": "Kakakku yang tinggi itu.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bc52d2a913c7e3ffa4ae4abad70748ed6faa5d4888e201f04ea5b72ecbfeb40",
      "text": "foto",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e3352c50f3d1c696ffd58119bc4399a200924d735cee19608296ecee81f3a7c",
      "text": "Pria ini siapa? Kakek kamu?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e951898cded8f68893bd2e41fa852700d696ef70878ee29ef5f2f4d2d0ea9e2",
      "text": "keluarga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fb64cc6093bb2de1893e50c6caeac1195788ed5e39ff70051a5e767305421aa",
      "text": "Kakakmu yang mana?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "848a97e1924572457856782a885af96c5e38ae00ef32ad39bf8264153591d839",
      "text": "tinggi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "84b04b8901a749089129a6f2ff981f1f440b9b80fc8dd334b58a7857ae3edb57",
      "text": "tas",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "84b7e8bcdb2fe32c6e6e4a048383fe19740919731645221de482782ec95d3db8",
      "text": "Mohamed! Ini istri saya, Bu Lina.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "86350520ed85082ef09263038611a5c16d7f3a2e5b3e1a710022c49d1526862d",
      "text": "Ini rumah saya.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "869e46b6f9ff6954e32bc30904c5d366c8fc29acd6ca05dd5e4b7f201c16d841",
      "text": "Rumah saya kecil, tapi baru.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "86f6c90d223711730a2ccda313d8130d836083816b3bbcf94c5cfee00af48d71",
      "text": "Mohamed, ini foto di rumah nenekku.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "87e9e15c56cc98002c1e9d787c770b20f2773a6ac4d7c4922316bd5b1da2f9e6",
      "text": "orang tua",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a4d0e9d68d6356a110ab15bfac940bb047f7fb704c8265eb95ec6bfcd8ccf92",
      "text": "Mohamed, ini suami saya, Pak Haris.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d065d8ef7115399bf5419c5513f6890525aff727f39ffba6892d47c16aaffc8",
      "text": "Ya, itu tas saya. Makasih, Fadil!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d25bd5f1097fdd4153b5133244ab11c8fb6a63a059dd4e4b62eef0715275aee",
      "text": "Salam kenal. Itu anak kami, Putri.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "924667143622f457f625eefce136e9319ef2262e891aadc0d35b4f6eca33483d",
      "text": "Anak-anak Bapak lucu! Yang kecil itu namanya siapa?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "97cbdfd0afa5dab29a50948f5a7dde7ceb81d92709d097339e41d03704844ab5",
      "text": "Itu kakak perempuan saya. Dia dokter.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "99bca6ac1a8e9fe82f8ee46115d435f7cd85cae7d484327415460f5d0207258a",
      "text": "Mohamed, itu foto apa?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a72f64125d06dc960813511faca90b538cebb04f941a0c5f79b3fb31b8cad2a",
      "text": "rumah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aee1cfb40522f82df31a1077234bc9a2d94ffa69cb849280d28d530a4459f90",
      "text": "Selamat sore, Pak, Bu!",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b60ebfc75d8047443e4c66893f3a0935c7bbe65ca0f2bb96ab0db4f66dbd778",
      "text": "baru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c6d8d97cfb419a19e6053af3eaddb65c394003c4439be860633c0551438c3cd",
      "text": "Kak Rina, tas ini punya siapa?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d1d5692be7ca97f8ebf577be2296408a7917789f3fd874c6ea1b53415946ec4",
      "text": "Itu anak-anak Kak Ayu. Dia punya dua anak.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d303a53ec7743698b13e42cf5327b3af5f7dde6a448e8f42a7a89e86d9086e6",
      "text": "menikah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d9ed868863c3610eec80e9dadbb6c85e5cdcafe95a10ff2ef817395104b55fe",
      "text": "Mereka udah remaja!",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "a07ce53212b04abdecc323f7f6cd0983606b994f7076a7d65249a9be7afdef70",
      "text": "Mohamed, ini Tante Wati dan Om Hadi.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0e98d5b1b8aaba6e9b7b0aade493ab431019b1c59c9e2bbe004e0a121b8c2f7",
      "text": "Gadis ini cucu Nenek. Dia siswa.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1cf157cdd55bd959077ffa09427306f62dc0de5c8ebb5c9ab6db111d99d9422",
      "text": "Paman saya polisi. Dia kerja di Bandung.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1dcbb2d467150d5187348d8cdbc1df6c72672bf9a62652bf9693058934f72b1",
      "text": "Itu suami Bu Sari, dan itu anak laki-laki mereka.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51a25e73b35babba5cd956341daf571d3e1eb2eb0272cf10b637de2a09dd6cf",
      "text": "Anak perempuan saya dokter.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a65af6f38a8310973ecfec27211f4e778ee9af52bb5cf3bef5198fc13c29374f",
      "text": "Mama, ini Fajar, pacar saya.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "abe5e153c3c56a0b10725a23298b60f0f2e4f8872da168ce7f36cd5bfa3d4583",
      "text": "om",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "ada78009435afca9ce48f2dd74c81845361fe3c1470273241cd48b133d9c7312",
      "text": "Paman saya polisi, dan bibi saya pegawai.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b26655f6284ca444191795c0a7184b3e2c2bd8e3f1c2d209226f1f2f5731be1b",
      "text": "Bibi saya pegawai. Bosnya baik.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2989187659713cbddd9ac2caf40712184f9f5e6eb3d202b62bfee5ef1b1b68b",
      "text": "Tiga anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3addc18564eb019abdfb89a21a3a4367f9ef065a74b4df8c7e87256529a0ccf",
      "text": "yang",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4ae5fa7eddccf77861947cd46516fd07fa0ec123f58bcd944b796d034035170",
      "text": "tiga",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b506ceb173ccecd7ec003ba22806c2bb2cddd881bf00435e6112b2313fbee243",
      "text": "Gadis ini cucu Bu Yanti. Dia siswa.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52adde311a3c64a9097ad54782c5b87dfb87237a2423cc6395461c59011ffaa",
      "text": "Buku-buku itu punya Rina.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "b650ea516bc9f8c962354e4b66deb9d93e486185adea7b3bd7d987941c2ccd0a",
      "text": "Ya, Tante. Ini anak-anak Tante?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7e71cf3a1644c6ceb33381fef844730d82c94b5b6f0f7f1d87f1c824ce4f490",
      "text": "Selamat sore, Bu. Salam kenal.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b866922a9cd1aea42220949a0991cf820fe5915be94ae1d6665fe26247fd60e0",
      "text": "pegawai",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b879848f3d072c8fb566ec8ba17e5ff5b0fc81f10974b2c59ce2d5518c94a9fc",
      "text": "sepupu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8ce1ddfcdf2eb5ca7ec57b4ec6cfd0c45d9eb244e9cb430b15f5c032d749959",
      "text": "Kakak kamu yang mana?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba2cc8162f1b4c0381baca689f8420b1d51a08d024bfbd7244a301dce8662b48",
      "text": "pacar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc461e1580c1cea126201e35d8f7a032b13019d330c4394568694894d23649a1",
      "text": "Itu punya Mohamed.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "be23105da4b66992d3ca77b5d562a4508eb6ccd173dc7aca54330869c207613a",
      "text": "Ini suami saya.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "bea5d52ce1a641e694ee39731ef8afc0a748509d05abcee65051fef6b40e841c",
      "text": "Mereka anak Om Hasan, sepupu saya.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "bef702da0ce998ee53e31952c6a7b3f2e14c2108b1c8112c4555912d0aae6ccb",
      "text": "Anak-anak Tante Wati kembar.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf9e42bd941d1ad1370268143c187170a8a55e9636f7c1198e4bb5075ef28f94",
      "text": "istri",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c062b4a7a7d3a30b780fc01c08d5287242c6e9f4d4ed77a5f245d6a59d48bc38",
      "text": "Tas ini punya saya.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0b873d58c7cc015f87bb9d7b138a9ed5999bfe8c49c8c3a8cc48134cad4473e",
      "text": "Ya. Dan wanita ini nenekku.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c272264597de8c17039086dc46d24ab69a5d094410ad7d52ccb1dea6a5355f31",
      "text": "-mu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5ee9a874824951d20375aee38e0d6f7be9046969d2cdc4c69dcf84a8cf4be94",
      "text": "Ini rumahku. Rumahmu di mana?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c75c0ec09fdb7306b8b733c694541857e234b3624a8bf15474b4b748476988e4",
      "text": "kakek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c84cbcdf6ed0e38b5526d0b8a9fda4c8533be7e905f7bc34a9e2e40e428fb2cc",
      "text": "Ini nenek dan kakek saya.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c86505923d9dc6267014671e0a7081374903bc880d4bf2b4f734ac3f927f5d38",
      "text": "besar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "caaaab3a0fee49b8748a7e4d519a470cd2eb3b05072675687edbe5cecaa37b26",
      "text": "wanita",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdf53f9eb50c6fb9d2ee6d3aed52dfebdba57fe3a2db3951175c809e9e4ed218",
      "text": "Ini adik saya, Fadil.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "d010a12b5e6a0df1d86f323dffbba6888843dac411eb5be930ab0d3f2d0d4d5c",
      "text": "Kakak saya sudah menikah. Dia punya tiga anak.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1b19c19f2b62ad6c469e570911671ae12343cdc4c03bd1d01bcc3079e5d6664",
      "text": "cucu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d46fc1839251a3d9787e8ef3e5b9a06533ea85d7fe9095bdde65f3e5ed3e7dbe",
      "text": "ayah",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d47e3d0e4debf070c4418fe63ebb0d1d2b5ad693d5c599ba40f54299d4f39fdb",
      "text": "Ini ayah dan ibu saya, dan itu adik saya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4de5f88214049a35d236a2a1e99ce279605997d03abf5244a26d5f564c6d7b6",
      "text": "Itu aku! Aku bayi di foto ini.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d75e189016dfd0c2dbaf6179e52bde1240b6ca6b6ec12b7f75da2efd64f63de1",
      "text": "Tas ini punya siapa? — Punya saya.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8aeed3ea8b98cf44da21cd4106bdd55b6f0092f509a1001175ddeb0062910ca",
      "text": "Ini keluarga saya. Kakak saya sudah menikah, adik saya belum.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b0c5aae444b3e7dd62a74b3c793a583c9e96bdfa7834e279dd3681b692cac3",
      "text": "yang mana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8dfd07b4fed251668311eb9f489d1508b023d93ce4f2e2951e3f2d1d47b22ef",
      "text": "Selamat sore, Tante! Selamat sore, Om!",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d953002c75c35a6e382d4259608b41eece792e9804f207bca5f0df269a9b9b3f",
      "text": "laki-laki",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d97e573419fff1721c545df3f6066bf51e3eabd101cad2653f15a95b8a6c2ea9",
      "text": "Raka dan adiknya.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d99b66e16f9cf70b86141049b75bb5d9adaeb748a2c9099d31b8a6dd045a47ef",
      "text": "anak-anak",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "da0e62bcf5cf3f550a444c44b756718407d6e173257a24fd510d5c4cb00eda60",
      "text": "adik",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "da4d6c8d1fe288ee18d833ad1adf2c69c7f188feb435043b040fbf227d4ef75f",
      "text": "bayi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcf8b322dedb8a0dc0d074ec92528947329053eacd539459110e44bb8b157b8d",
      "text": "Bayi kecil ini siapa?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd58cfaa3c7e6916bad833661e93f491efb3c69e85960ab0ce09148cff7cea11",
      "text": "Rafi sepupu saya. Dia anak paman saya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "de84db96c795fb868230ddd5f68537be70e76f075fc570ec7f37d0789364e081",
      "text": "Lucu! Nenek kamu punya banyak cucu?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1440b62bb0220403cf7d6c1e0feafd3f90d68a85dbd21224e84aaaad5c40557",
      "text": "Buku Rina di mana?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e15c7e4629f1c8f65a69032a609d42e82cb67a98d38560a416b22787d822ed2f",
      "text": "saudara",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2956ef95759a42691f381cff70585c5e7f0178b9ccb8fa417b7d5992d10646f",
      "text": "Rumah saya di Menteng.",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e579ee313255b3eb9dbf5806c7c1d8748e56c0162363d9579c5d3c100e70fbb2",
      "text": "Selamat datang, Mohamed!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e939616ffa491f7793a98bfe70cda00cdd121e45e87f957b51df6c6ab8ca3346",
      "text": "Yang tinggi itu siapa?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb193f416eeec6c0666d7afc1d249ec409a5712029368846aa5cff0dc5bde1a0",
      "text": "Saya polisi. Itu bibi Rina, istri saya. Dia pegawai.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb7852973382c3ba40a489aae9ae65be79753b913466a6a9158150195cc8f040",
      "text": "Om Hadi dan Tante Wati adik Mama.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed19578f93038789fabc3c5589ffee2792ba5e87940849dd88f39e0a872af237",
      "text": "mama",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee763f4b5632a60963b5989b31cf0940727fed395c1cbfed8de08a8f3bc55f8f",
      "text": "tante",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eefdc4855a9679717bf866b3400dd42473f2d55ffd4241a1c2bff4e8da15eda0",
      "text": "Mohamed, ini paman saya, Om Hasan.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef3c75b72fcaa6f75770df608a31df99d5b5ca9d391de6742602083eaadb973e",
      "text": "kembar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5f18b253dd4662de7255e76c48dcb12ae17138276fb5e41b9cd3d0a50aac59",
      "text": "itu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a8251e0504e22da3bbcec801ee5c946c68ebae429afce176455ce86b0cbc40",
      "text": "Anak perempuan Bapak? Hai, Putri!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1fb0bbdc6981af232805ee0963ccaef3e1cdaa0da21a5993722ec56db2b72da",
      "text": "Nenek saya punya tiga cucu.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "f336ca635f37d32e2a5277d506308579a4ed6858b96d7268cb6ab05515e17560",
      "text": "Itu Pak Irwan.",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3c0177e2d1d4708464f7f53ea47e6fc229522a1337b0379e209679f385240e8",
      "text": "Ibu ini guru saya.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5571d6356f9b328fe9c424c9a11d9c7ab5d0e3e8e8ba4b232ab4e8e88b70ea6",
      "text": "Adik saya kecil.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f55de49585369df0c47abeb79057862c84ed996942799642f12ef146c428c84b",
      "text": "lucu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f61bcebb0e762876fdf56765d66ba40788926d9a327c24d7d4cc6d6d4f3430f5",
      "text": "Namanya Sinta. Dia adik Rafi.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8c3ca97b185db80e293d9851a52af9f71efcd6cf2c5d298c7dc2340338fef3b",
      "text": "-nya",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8cba76a8ff08431117058f02e8cae23b924b6a51f0571fa36a19805e49f3c4d",
