      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fefb9077aea59df589595709bcf579c15fc8070693589323aceadccb708c7daf",
      "text": "Sore! Kamu dari Mesir, ya?",
      "voice": "id_gadis",
      "chars": 26,
