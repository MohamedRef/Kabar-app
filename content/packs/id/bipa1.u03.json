{
  "format": 1,
  "id": "id/bipa1.u03",
  "language": "id",
  "unit": "bipa1.u03",
  "version": 2,
  "content_hash": "97331051f780348a6038c49abfb9f9d4a5efa4a7d821949bac718cd82a6547d5",
  "lessons": [
    {
      "id": "bipa1.u03.l01",
      "sha256": "391eea48f95f3e91021a00336feb4ffa31df6ee553cfb799f58180fe9d64c8fa"
    },
    {
      "id": "bipa1.u03.l02",
      "sha256": "920cbd646c936242dc7f738c9a97ef5b98ed7332d56b534015a511fb08701935"
    },
    {
      "id": "bipa1.u03.l03",
      "sha256": "f6508d378b319f7c4f745865bb8d6a1fa51c0bb1e1e1a9e64dd65ab042a5894e"
    },
    {
      "id": "bipa1.u03.l04",
      "sha256": "91f9e76e5900f43a6636ec89f0cb09909bbc02ea612e5971ac6d85311571ef17"
    },
    {
      "id": "bipa1.u03.l05",
      "sha256": "4c711e43e44ba393a2b1fdce96cd70031590b965030e188803c8cbd5b9899b0b"
    },
    {
      "id": "bipa1.u03.l06",
      "sha256": "e98922ffb1975dc7bfb03a93e1a733bc6f9e683b30538f1796356cb05271e964"
    },
    {
      "id": "bipa1.u03.l07",
      "sha256": "3b5bbb1bfd67f32ff87e847c92463e1058712ae5aa8f961c10619d2f8d6e0570"
    }
  ],
  "audio": [
    {
      "key": "01370f595326720b088737788e1744e1c0ba45a778ca4ff0c3b5d39e730776d3",
      "text": "Ini rumah baru saya.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "0343d96399836dcbdeebc433cfc55916b01649e7c6ba26b4fe10f8774d009a3c",
      "text": "Sama-sama. Rumah Mas di mana?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "074c07199657586a12f852f898a06e03b8dd2b941ad374f611d4d73976155869",
      "text": "kakak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "08671c206712687109ceaa26648d0020060466105f58e099e9a970676f6b33cd",
      "text": "Ini adik saya.",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a3593b9efb22674621f293000f5c95ef1879660e301de95af3ce36e0f31c704",
      "text": "anak",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c00b7dfd7302e3ef0914d3352118d5191204c0aec2651c30cdf5608a49aead9",
      "text": "perempuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e68060c9a748dbdde91447c04884bb4bb890e1e42458da5726504e7094b2661",
      "text": "Adik saya belum menikah.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f6888ea456b02d4d38f698b01090a25d35624f2be643ebe0774587e4a94b362",
      "text": "Dan anak-anak itu?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "1478e6a245c84e76c7a7ca0c18810a3b05ef5c9f8764b6ac7df61c59abe3436e",
      "text": "Mohamed, ini keluarga saya.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b2f581f35f24f4d51fca9711c735e906aac1d1c064fcb176e8d4ac8792b604b",
      "text": "Selamat siang, Pak. Salam kenal.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2297a61aa466742659e38679da94861ff9cc95f5203bea12107034c6e025b949",
      "text": "Mas Mohamed, ini tas Mas?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f626fab333f8836bcd33e774ff1420f11f2fcb68ec3c10f48cf251358c9278",
      "text": "Anak-anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "236e7e7350771acc3945480466bddd949bcf83679189ecc9bf422e470cbd6610",
      "text": "Ini istri saya, dan itu anak kami.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "24bb797e3438042db403c38f75f0662c12df2d883ea8713d79897c83181697dc",
      "text": "Ini rumah Ibu?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "250beb8fd589c92291a1b589955615075530c14f28235f4343c0e58480c76009",
      "text": "Itu adik saya, Bayu. Dia mahasiswa.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b71c6d06da23cb94ecf3b62a57ea4644c6023b8816732cb777f9e29b346a76",
      "text": "dua",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ce50082440bbf036993c4a106837fb934ba2cb7f1a93a726b9ccb0b95e2de6b",
      "text": "Rina, ini rumah baru kamu?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d63db91f93e2d321bdb68da9131547f8cdf4d56c910262584e2b8643c0b95ad",
      "text": "Dimas dan adiknya.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f0a0a5d40f28b78d2897467ac9f1b2a0f50ce78028a228f6700cbc827fe18d0",
      "text": "Orang itu kakak saya.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "307bd152ba6e501b3357c0c6565792598547b7cf2413af71f352d9b95451087f",
      "text": "Ini foto keluarga saya. Ini orang tua saya, dan ini adik saya.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "30d9a230e95c9e9c9219097e28fdb67c4f63d59bc40aaecfe270b2413459659f",
      "text": "Rumahmu di mana?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "32ab83b0eea9b9402c504a73113476dce7b20342194a9ff3c197e0222e4a6945",
      "text": "-ku",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "368588e63cc9cc6d1ec586c591469c4927585452c3f74896414280e21053ebd5",
      "text": "Ya! Rumah saya kecil, tapi baru.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "37cc77df226bda0396125cdba6343b7cd99a28f8e46757dd701e4ba0013f1e26",
      "text": "belum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "37db600cc4307317f6674a7a9165928117d37c7d8b6c9746657ef1a4910126e7",
      "text": "semua",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6d74ffcfac9ad8ea3b9dfb715c155ed5bd60e6efd63e870933f77174852a73",
      "text": "Itu kakakku, Ahmed. Dia dokter.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "3db9917fc094a7eda011f7dba9a8111bacee877ded2b7325bf33d94bdc2680ec",
      "text": "Kakak saya yang mana?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f050124070c82ec3560e2be1818c1d46864255087a41ec886f3eeae979f16e1",
      "text": "Kakak saya yang tinggi itu.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "471c4bf1690f552a392b480d6240604b0fffb09d2bdc2a44ad57a8d670b4b570",
      "text": "Kakak saya yang tinggi itu dokter.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "485e2e40a9d2e6657c9b6326e98f026936e108b25843358cce4354757124ecab",
      "text": "banyak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "48fa21f62cb79092b1360813ffbd7cb1db2d00874613d586be34e77fac13f0ce",
      "text": "Ini ayah saya, dan ini ibu saya.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "49f864e318e45e064b3cd277396ad6e6f5eef99ca4cb6e881cdae97d21906f2f",
      "text": "Kakakmu sudah menikah?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b62a180ba0fec3906c031e721bc06b087dc801fc03a515dbc6ff685675945de",
      "text": "taman",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c3bd5fc6a22329a70e123ed86e315b7ee010aa85ca24bdeb5b2f024752ef478",
      "text": "buku",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e7a20d23b0581b49d8bd02409f40a84158d71cff1f9676c06ca25f69cb3932f",
      "text": "Ini foto keluarga saya.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f518231dac310d1d96093c2a517789bf93ba96e47b548e6f1c951ab6f4a0ca2",
      "text": "sudah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "509aa00340bfba1f52a726b7423a76c41bdd5356e85b41887c74c977f011eae9",
      "text": "Saya punya dua adik.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "51894155bc6a147763a150a8c1c8b76a7d097bfef2c9ddce7aff56e3a4560ef2",
      "text": "Salam kenal, Mohamed. Ini anak-anak kami.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "541107dbe8ba203815951c2d8b52b223771c7c5de245128ef3534184b64e8c2b",
      "text": "Ya, keluarga kami besar, tapi rumah kami kecil!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "55b7b199f2a606dd582b6bc69cc6c405335566b034fb518e24735bc059f5b201",
      "text": "Ya, itu tas saya. Terima kasih, Bayu!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "567647934291f3d7b4127cdf5f9a52629a4d10f6f21cc5845f646b7332b7c4d8",
      "text": "suami",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5915bd99f9c55d0e624a66ea1505e41beedb63cece428b169d4963abe13d1eb6",
      "text": "Terima kasih, Bu. Rina, itu siapa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c5bab04d703213c9111fe6b8ea882080421821bb777adc6d77edce4d6f4c9bb",
      "text": "Keluargamu besar!",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d3367f7e65dbdec37ed792197d26f9de45914c00a012f00712af285be66997f",
      "text": "Ini foto keluarga saya di Kairo.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "63b0598dfdf45aedf92de75ac4ee57515b6a6af64b8d1fff929de7bb7b9780c0",
      "text": "Hai, Dik Sinta!",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae1b254e65d5ba95006f2ed6a59e5ded97a3304ca651482083fba4592da7f70",
      "text": "Ini foto keluargaku di Kairo.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d7fc31cb8b22a4257ca920a0108b1daf8b579b07add767ead083ed7792c685c",
      "text": "Banyak orang di Cikini.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "73b21c9ba329d35b487b012c275a04fc33efb9abadb9a11acd6241bf87c223cb",
      "text": "Ini keluarga saya.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "75d4dc3a76838aa7ae7535b6de8fb5d4728fa9f1a82567908bd566ab17a54179",
      "text": "Itu kakak perempuan saya.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "794a0c3b326e31e4d427af30d45f96a1a0b7d23f9adf4a649fe324d35a03d33e",
      "text": "Sudah. Dia punya tiga anak. Anak-anaknya lucu!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "795f41f4fea3b5397455eff3d9623ca3392aa6f75d769df139db97defc5e257d",
      "text": "bermain",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a128b7bf7e23e5b7196c6a66dba8471b94c94be3b3bb2ad0f5e675a192d70c1",
      "text": "Itu adik laki-laki saya.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a73bc12810aa240dbad158714ade526112c88ef44465997cf98dda42a87a6dd",
      "text": "punya",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bc52d2a913c7e3ffa4ae4abad70748ed6faa5d4888e201f04ea5b72ecbfeb40",
      "text": "foto",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e951898cded8f68893bd2e41fa852700d696ef70878ee29ef5f2f4d2d0ea9e2",
      "text": "keluarga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fb64cc6093bb2de1893e50c6caeac1195788ed5e39ff70051a5e767305421aa",
      "text": "Kakakmu yang mana?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "826c4b83f865c8796acd2fb775d34902d9707f0dedd66c11d41f7bd4373682cf",
      "text": "Ini buku saya, dan itu bukumu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "848a97e1924572457856782a885af96c5e38ae00ef32ad39bf8264153591d839",
      "text": "tinggi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "84b04b8901a749089129a6f2ff981f1f440b9b80fc8dd334b58a7857ae3edb57",
      "text": "tas",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "84b7e8bcdb2fe32c6e6e4a048383fe19740919731645221de482782ec95d3db8",
      "text": "Mohamed! Ini istri saya, Bu Lina.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "86350520ed85082ef09263038611a5c16d7f3a2e5b3e1a710022c49d1526862d",
      "text": "Ini rumah saya.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "87e9e15c56cc98002c1e9d787c770b20f2773a6ac4d7c4922316bd5b1da2f9e6",
      "text": "orang tua",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d25bd5f1097fdd4153b5133244ab11c8fb6a63a059dd4e4b62eef0715275aee",
      "text": "Salam kenal. Itu anak kami, Putri.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d62d005a6f963da8f3e5fa05816b3501499c936b55482c9e904ad806dca7468",
      "text": "Itu Pak Budi.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "924667143622f457f625eefce136e9319ef2262e891aadc0d35b4f6eca33483d",
      "text": "Anak-anak Bapak lucu! Yang kecil itu namanya siapa?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "95c1486c64d8a3880d62f0aef27152b342f787aaf32c1218ac7e84fee9b9b9f9",
      "text": "Kakak saya yang tinggi itu. Namanya Ayu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "97cbdfd0afa5dab29a50948f5a7dde7ceb81d92709d097339e41d03704844ab5",
      "text": "Itu kakak perempuan saya. Dia dokter.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "99bca6ac1a8e9fe82f8ee46115d435f7cd85cae7d484327415460f5d0207258a",
      "text": "Mohamed, itu foto apa?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a72f64125d06dc960813511faca90b538cebb04f941a0c5f79b3fb31b8cad2a",
      "text": "rumah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aee1cfb40522f82df31a1077234bc9a2d94ffa69cb849280d28d530a4459f90",
      "text": "Selamat sore, Pak, Bu!",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b60ebfc75d8047443e4c66893f3a0935c7bbe65ca0f2bb96ab0db4f66dbd778",
      "text": "baru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c6d8d97cfb419a19e6053af3eaddb65c394003c4439be860633c0551438c3cd",
      "text": "Kak Rina, tas ini punya siapa?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d1d5692be7ca97f8ebf577be2296408a7917789f3fd874c6ea1b53415946ec4",
      "text": "Itu anak-anak Kak Ayu. Dia punya dua anak.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d303a53ec7743698b13e42cf5327b3af5f7dde6a448e8f42a7a89e86d9086e6",
