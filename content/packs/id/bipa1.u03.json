      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4ae5fa7eddccf77861947cd46516fd07fa0ec123f58bcd944b796d034035170",
      "text": "tiga",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52adde311a3c64a9097ad54782c5b87dfb87237a2423cc6395461c59011ffaa",
      "text": "Buku-buku itu punya Rina.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7e71cf3a1644c6ceb33381fef844730d82c94b5b6f0f7f1d87f1c824ce4f490",
      "text": "Selamat sore, Bu. Salam kenal.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8ce1ddfcdf2eb5ca7ec57b4ec6cfd0c45d9eb244e9cb430b15f5c032d749959",
      "text": "Kakak kamu yang mana?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc461e1580c1cea126201e35d8f7a032b13019d330c4394568694894d23649a1",
      "text": "Itu punya Mohamed.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "be23105da4b66992d3ca77b5d562a4508eb6ccd173dc7aca54330869c207613a",
      "text": "Ini suami saya.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf9e42bd941d1ad1370268143c187170a8a55e9636f7c1198e4bb5075ef28f94",
      "text": "istri",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c272264597de8c17039086dc46d24ab69a5d094410ad7d52ccb1dea6a5355f31",
      "text": "-mu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c86505923d9dc6267014671e0a7081374903bc880d4bf2b4f734ac3f927f5d38",
      "text": "besar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d010a12b5e6a0df1d86f323dffbba6888843dac411eb5be930ab0d3f2d0d4d5c",
      "text": "Kakak saya sudah menikah. Dia punya tiga anak.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2e625996e357b0509763d9e0b798d1dbf0d169b8b73b64796c6b87f318b4d91",
      "text": "Ini adik saya, Bayu.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "d406c3ee6a0c44101c7d1df9535a89792bd32055e51c5615c41b4c72492e2378",
      "text": "Rumah saya di Menteng.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d46fc1839251a3d9787e8ef3e5b9a06533ea85d7fe9095bdde65f3e5ed3e7dbe",
      "text": "ayah",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d75e189016dfd0c2dbaf6179e52bde1240b6ca6b6ec12b7f75da2efd64f63de1",
      "text": "Tas ini punya siapa? — Punya saya.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8aeed3ea8b98cf44da21cd4106bdd55b6f0092f509a1001175ddeb0062910ca",
      "text": "Ini keluarga saya. Kakak saya sudah menikah, adik saya belum.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b0c5aae444b3e7dd62a74b3c793a583c9e96bdfa7834e279dd3681b692cac3",
      "text": "yang mana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d953002c75c35a6e382d4259608b41eece792e9804f207bca5f0df269a9b9b3f",
      "text": "laki-laki",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d99b66e16f9cf70b86141049b75bb5d9adaeb748a2c9099d31b8a6dd045a47ef",
      "text": "anak-anak",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "da0e62bcf5cf3f550a444c44b756718407d6e173257a24fd510d5c4cb00eda60",
      "text": "adik",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc3e571e086c47ff289b34399e6d5d5100691ff713240d7587fc51384b858936",
      "text": "Ini punya saya.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1440b62bb0220403cf7d6c1e0feafd3f90d68a85dbd21224e84aaaad5c40557",
      "text": "Buku Rina di mana?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2956ef95759a42691f381cff70585c5e7f0178b9ccb8fa417b7d5992d10646f",
      "text": "Rumah saya di Menteng.",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "e579ee313255b3eb9dbf5806c7c1d8748e56c0162363d9579c5d3c100e70fbb2",
      "text": "Selamat datang, Mohamed!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "e939616ffa491f7793a98bfe70cda00cdd121e45e87f957b51df6c6ab8ca3346",
      "text": "Yang tinggi itu siapa?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "eda8e148ea4fb5d3a05918b6226aefd3e18e087d44b628ce04da2c88a87a524a",
      "text": "Mohamed, ini suami saya, Pak Hendra.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5f18b253dd4662de7255e76c48dcb12ae17138276fb5e41b9cd3d0a50aac59",
      "text": "itu",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1a8251e0504e22da3bbcec801ee5c946c68ebae429afce176455ce86b0cbc40",
      "text": "Anak perempuan Bapak? Hai, Putri!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3c0177e2d1d4708464f7f53ea47e6fc229522a1337b0379e209679f385240e8",
      "text": "Ibu ini guru saya.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3c6a8eebe835c2e6b1d7d5325ec2047592161c2fc16355c423a1f1f9146fa7a",
      "text": "Ini ayah saya, dan itu ibu saya.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5571d6356f9b328fe9c424c9a11d9c7ab5d0e3e8e8ba4b232ab4e8e88b70ea6",
      "text": "Adik saya kecil.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f55de49585369df0c47abeb79057862c84ed996942799642f12ef146c428c84b",
      "text": "lucu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f61bcebb0e762876fdf56765d66ba40788926d9a327c24d7d4cc6d6d4f3430f5",
      "text": "Namanya Sinta. Dia adik Rafi.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8c3ca97b185db80e293d9851a52af9f71efcd6cf2c5d298c7dc2340338fef3b",
      "text": "-nya",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8cba76a8ff08431117058f02e8cae23b924b6a51f0571fa36a19805e49f3c4d",
      "text": "ini",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa472b3c3cee66f02db5f4488a09e2a52253e83f0b8c38925318b413babb60db",
      "text": "kecil",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb9253b34cc1d903761388fc4a375fd567984010bef4299d221ed4f50fb278dc",
