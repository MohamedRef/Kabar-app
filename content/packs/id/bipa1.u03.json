      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb9253b34cc1d903761388fc4a375fd567984010bef4299d221ed4f50fb278dc",
      "text": "Rina, kakakmu yang mana?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe1e6746290c0feff92b10c157d5de47c87bdac7d0ccd9472681e6b087fb4410",
