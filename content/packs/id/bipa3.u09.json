  "version": 6,
  "content_hash": "92ea1c9239f8b2841898bfea709d01f12ab383340d3cddc176ec45ea0f1ba7c7",
  "lessons": [
    {
      "id": "bipa3.u09.l01",
      "sha256": "06134b038cc4d122d1d4935555e08db638b3ce2e5390b8c37abac62b73cb6925"
    },
    {
      "id": "bipa3.u09.l02",
      "sha256": "3ca49a29221b9afbdd2070354ea4bb0dd96345a3d5f75204d5a0abfde4eb3b89"
    },
    {
      "id": "bipa3.u09.l03",
      "sha256": "6db982119798f955d1ae201169de076f1724871a27db54827ac1664d0cb5865f"
    },
    {
      "id": "bipa3.u09.l04",
      "sha256": "32ee7cf3871f2e55e2a05a32691a34711872c81e91d9f7f307eb29c75c80e57b"
    },
    {
      "id": "bipa3.u09.l05",
      "sha256": "321a099974e0c96cfe010e4756932d96b9d5d0b51616a3daf105142330066818"
    },
    {
      "id": "bipa3.u09.l06",
      "sha256": "c33d78d0a85f297503623dcd7814267a6837140c16176456ea99a35ac2ebc8e2"
    },
    {
      "id": "bipa3.u09.l07",
      "sha256": "72558ec7ed8b091ecf9134477417aeaf98536e95818b3a25fbe6d361b7fc2b95"
    },
    {
      "id": "bipa3.u09.l08",
      "sha256": "e327cbec18077d93a0d23550991088f7b9c7448effafa8e4de57bcbf3332021c"
    },
    {
      "id": "bipa3.u09.l09",
      "sha256": "ceb5066378b1c39dbe9ff42d4d6928d1314874f7eb06bba862989da5d98d89ec"
    }
  ],
  "audio": [
    {
      "key": "06a3d3f61781b6faf0de98a83c7fdc38facce714ddfb9f04cd883b7266be7361",
      "text": "Dia melompat dari punggung ke punggung buaya!",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a52dd5872933a75c1c8c32fe3f4a4035a4db092ec401556e43356705fb8f2e1",
      "text": "Si Kancil sangat ___. Dia selalu punya ide.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b4f63da98f43d330c8283e6015bab0741cda481669e74240e92e91f1dd53862",
      "text": "sihir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c2e4b10f7b8142acf8f9b7b5fae6d07c2105a1e0e75dad8e7156361525695d0",
      "text": "rakyat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f7bf2279291b4fd0ca00f34a5f38ad4e19803fa77ad806544d7c947e4a69e47",
      "text": "menuntun",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f7e2c19384110bd2c7e49e2149afaac3655cec42af770e4e52dd014e9c0efc6",
      "text": "Legenda itu tentang seorang putri dan seekor naga.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "102833fd2682dea14fa5ebe673322941bf0d17488baf4d0897c3c73fc0566477",
      "text": "buaya",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "10a34de152820e85ef8185fe024827e5be6b668e8b141b227c8f458ea84e3766",
      "text": "menunggang",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "117f2f17b26f5ff1916dd2e18aa770dd29ecc3661e8314cc8eb12eae3ccf3829",
      "text": "zaman",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "13211863a8e24ff5fce962c9ebd0699e62582d872465ef7b8bb1f6f378eeada1",
      "text": "Iya! Ceritanya penuh keajaiban. Aku suka banget.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "14d35da191b801bea26d69f15484cd831db79de485f2df7ce8cd4b8436447940",
      "text": "punggung",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "17898e1f1bd385bdf29be94822440806678bab7ebbf3a33fae901d0439becb52",
      "text": "istana",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1919d092c2c80ffe117b5f540d0f5aa9611fd5f8fa79f7490da31ac2cc0c6068",
      "text": "si",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "24888ffe6753625740d795fd2eba8b9219220b1e303f70c4c2ae7b54b9fb8afa",
      "text": "Tikusnya datang dan memotong talinya. Singanya bebas!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2568b0ed1c27b5d91cb4252d99c40a27da44c8eec30187afb0df7275a8848c19",
      "text": "Suatu hari, putri itu pergi ke pantai.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "26b78fb9dee1eb5063b9a8f5ac7fb41380163846bae413cfce85f3901647291f",
      "text": "Putri Mandalika berpikir berhari-hari, lalu terjun ke laut.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bb89e3c9795bb412b53d2c9f257636ffecc070a2338208aada0a75e5a34d424",
      "text": "Raja ingin menghitung semua buaya.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2beabbd36881151c64e9b956b9034e01e21651af82d68d166c5eea645d181c72",
      "text": "berbondong-bondong",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d6639d81322dfc4cdc3f18d04848818190290af4191d704ca827471dab44ea8",
      "text": "Pada hari Lebaran, kami ___.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "32af30a91004789a00fef83c82011664ee1280c3ebb791439e86749aa76da143",
      "text": "kancil",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "33a74f2f0bd34c3db6b0cab1b52b4621004dd580c747b1738e94f08e7f379d64",
      "text": "Menurutmu, amanatnya apa?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "3455eac2ca2ff8b7eaf2c5daa0a0b209cf3de356a1e37e8a15b71dc4ef1b7db0",
      "text": "Setelah salat Id, semua orang bersalam-salaman.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "36d878458eaa6692a617313c5367058710dae1349e2d829102e728e6fd0cb214",
      "text": "Kalau nulis, mulai pakai “Pada zaman dahulu, hiduplah …”.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "38cff3e56baae0a3ced36ec4b92128dbc2f30140b923e01462018a5b4735254a",
      "text": "___, hiduplah seorang raja yang sombong.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "393d1bc3d6764170e7c55329bc7e3f01312ebec15ad4c52ea965805f477c2b2f",
      "text": "berlari-larian",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "39792e0cfa83201b4e4c69645f45e840d21a9f1974079bea0b10eb3cd86886ce",
      "text": "Putri Mandalika terjun ke laut.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b2ef36a63e209a67c89bf090848a53ade17e2a42767cb93455dd8e51f1af54d",
      "text": "kandang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d01c057be13ad804c66b00d714cc683598c50674336fb9265eb13a1243656d5",
      "text": "makhluk",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e021914611f9ba70ed7c3d25f5244624960e517718977a6a2da9d6d360e3eb5",
      "text": "berkejar-kejaran",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "40590f189486ed6cc58e1d4349ac152e22d2684040e935f36dec4ed1632d6ed3",
      "text": "Aduh, sedih banget!",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "435612e0c0d7073dfeb5927d31941693d63a50bb3656f9a96e00136a4ff911db",
      "text": "tikus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "44827cc0040c6585842c4c435408f28cbfdf90926a7c8c3d59be9a351a04454d",
      "text": "Putri Mandalika berpikir berhari-hari.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "45c1523940b86d7a2e1ac850a5009e057ae8d5270a08cf1c9c6c795d9250bb05",
      "text": "keledai",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "488df6f1c4aaeb45c50da9dab36e8f31074c3dc12f6066a3ba29b30ebdf036d5",
      "text": "Terus?",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "49019ef6f93ee2997b7d6ffba434227c0ef97fd8173c9c10f61cf32a26a11bed",
      "text": "Anak-anak berlari-larian di pantai.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4946fef27bc9ceac028283fb466815d710888f75fa8865c5214565c8a2a4a1b6",
      "text": "Wah, terus nasib singanya gimana?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "49d1958bc3454f51ace32a18cc67ec0003402813dc6aea51d8f886473273d941",
      "text": "Kancil itu kecil, tapi cerdik. Dia lebih pinter daripada buaya!",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b00237c388a2dcf615dfb0d12bd92a03c2d562144ca926476e69a11e6f7a4d3",
      "text": "Mas, aku mau nulis dongeng. Mulainya gimana?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5062b62b0209ba75efd1c42a88a6c80f1e0a3302a601e2792c9b86233d77e4be",
      "text": "Mas Rizal, di Lombok ada legenda tentang naga nggak?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "511c907f75dfdc14417aa45684ac8c0c5c8a03cfcc7f546d721be98cc38cd272",
      "text": "hiduplah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "51d1b8ab12bbdab6ea0ff914149356d582c9f2136ac440ddf75246803ed266a5",
      "text": "Pada zaman dahulu, hiduplah seekor kancil yang cerdik. Suatu hari, dia ingin menyeberang sungai, tetapi di sungai ada banyak buaya.",
      "voice": "id_gadis",
      "chars": 131,
      "mime": "audio/mpeg"
    },
    {
      "key": "525df0328cbc95b57e7d4977196a8b37f8d3d6dd01a606b5c0f57b377bf9add6",
      "text": "Mas, ceritain tentang Putri Mandalika, dong!",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "539dbb6059c94bc2e53fec0a50c69dc512ee6e30484b82a83023044155fe5177",
      "text": "Amanat cerita ini adalah jangan sombong.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "5595f2638e628da99bbbb2fdb8ad99e6e9046aecb95077297585a548056ec45c",
      "text": "Setiap tahun, warga datang berbondong-bondong ke pantai untuk mencari nyale.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "5617b157727a224e12f9bd68e87fbd24a761f6944ad42af0477dec6da1b51a0d",
      "text": "suatu hari",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "56a8997df4501ffeb74170345747176cc59d265bf771de990cdecca192b86e8f",
      "text": "naga",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5866a39fc32d090d2fcc800c79a4919cac01da762a00dc3e80ea6b5cf48a3d81",
      "text": "Wah! Terus putrinya milih siapa?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "594db031698ef3adb8839a138de7e96b3624a4ca130bb380edf28f31f20b5c38",
      "text": "berbaris",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a731d716ba39736e53145311c239deb370baed3add53b834704b84748989346",
      "text": "Si Kancil berkejar-kejaran dengan buaya di sungai.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b50314819fbc167b3e3fe081d42233d66478461812cf5a4c09e643a94448ad8",
      "text": "Dulu, banyak pangeran datang ke istana. Mereka nunggu berhari-hari, soalnya semua pengin menikah sama putri itu.",
      "voice": "id_ardi",
      "chars": 112,
      "mime": "audio/mpeg"
    },
    {
      "key": "60199e12f744a5f855fa5bbb95b2473b41035823c4bb5ab5b9747934db04ce8a",
      "text": "Lihat deh, anak-anak berlari-larian di Pantai Pink!",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "60d024b9068e43f12016dd44e37fdc5060ef7b6f7406731785445211266915b7",
      "text": "Pangeran itu berpikir berjam-jam, lalu dia pergi ke istana.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6144c71d9a391a77a3cffb01897e3451a67149ef9c2b0bfe4044ce8c1f700111",
      "text": "Udah! Para pangeran nunggu berhari-hari, tapi putrinya nggak milih.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "655d1805a4a9b24be8842c6c3e541d19ec517c57b05c965a20e898cad8c70106",
      "text": "Mas, di Mesir ada dongeng tentang Juha. Mau dengar nggak?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "65f805ffcca1ec9c39d4916466d0fd6fa14b369b092827b5a8e106890ec2aeda",
      "text": "amanat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6715f8f06840f6db864d558abd5d462c35ea314063a02ef1b57ca8e595e2c4ff",
      "text": "Setiap tahun, rakyat mencari nyale di pantai.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "67838f1e3e9f3ff490df05b8dc123be576f7992e62c9866334a2f463a937d37a",
      "text": "Ratu itu sangat baik kepada orang miskin.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "688c1e394de4adf03e624068a330fe4dafd214e30d348153c88eb0316e17ad34",
      "text": "Betul. Jadi, amanat cerita ini apa?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "69ea75cde357a4e8e5681621a8b4652ab9e0e5d636750764b5f16df50073f0f4",
      "text": "Jangan lupa amanatnya. Misalnya, jangan sombong!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c13fc51369b8eb9adc40c5b95eb2d60900d4b3da1c66d08104cdfb4a1da4719",
      "text": "Anak-anak berkejar-kejaran di Pantai Pink.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d611320b0f4e86804dfaa0ce195c642a4ac8491ab77930006621e226b52d3ed",
      "text": "cerdik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "71e59ca5036974611c4ce8e2fe53611c9da94fd6394985b8f5aa56a2b02715b9",
      "text": "nasib",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "72704331964f0272712f2c6dd53b3ee4df0404d92927792aded66188b588dea2",
      "text": "Legenda Putri Mandalika terkenal di Lombok.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "7358bd5602940671e13d173899c545b302deb16c96d9ab40ecb416817a6ed52b",
      "text": "Suatu hari, Kancil ingin menyeberang sungai, tetapi di sungai ada banyak buaya.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "7378f384a596961cd6240cac23a875da460a5045de21c042ec5b388f8862c405",
      "text": "terjun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "744aef0571ecdcb258167557facd1b5a6eaf170970f175765687a5a84795798d",
      "text": "Kami menunggu kapal ___ di pelabuhan. Lama sekali!",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "74a6dd66702612f5f9eb30668c3a84254cbc4b8e2d02121634fdc0ed3ef3c3ba",
      "text": "Juha ___ keledai, dan anaknya berjalan kaki.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "74d94f7b8390cbe8796b1005260cadfdbb3ebf7db519a9410813d58ede018a3b",
      "text": "Buaya-buaya datang berbondong-bondong.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "758890b9619cf757621f966b8faf0cb8d07950425d99af0961c59776402de922",
      "text": "berhari-hari",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "75931b15c32965b0800099378709ae589739eabf3cb5cc67d3eb69877b6016dd",
      "text": "Pada zaman dahulu, hiduplah seorang laki-laki bernama Juha.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "76ee54d212a2cffb9b3501d710c7d11f4c4db100fa69cb8136a99b0bb819bd4d",
      "text": "Tikus kecil itu menolong singa.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "77c3fead0641db49bedc2391c63cccf180f95a4b2d0aa0ec7bbfd2e216871544",
      "text": "Orang-orang itu berburu di hutan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "79aded4682439d5cdf74df3b1b16a159a2f4c384c4e93449612450e7d60160c5",
      "text": "Si Kancil kecil, tetapi cerdik.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a0737d8576477af4d47966f1de1d535a008c8aec543de9008e710d21e00bbb3",
      "text": "Orang-orang di pasar menertawakan Juha.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a2fa302bc8ea0eed687c6fe713e179377e8e023895b5ca1f3fa3aa25840cf5d",
      "text": "pangeran",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a34a649a89edc765fefc70749e0f392dce9a064ab196e5c3c48a24f421fc6b2",
      "text": "Setelah salat Id, semua orang ___.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a4c587ff065c4840e462c8433d0770a996957d9dd6903386289fa2f5913a403",
      "text": "Terus “Suatu hari …”, ada masalah. Akhirnya, masalahnya selesai.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b00614ef251495f9f071b9fc849aa296287b4198d06e36213f53369c42ae1ba",
      "text": "Terus dia bilang raja pengin menghitung semua buaya. Cerdik banget!",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d59755d3f332dc93a9f664f70e99d6f7459d43e18e3342a7a70269f3f77f976",
      "text": "Terus banyak nyale datang ke pantai. Rakyat percaya nyale itu Putri Mandalika.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "804ceb1e293ed386b05ef05d42eedff5f2fa37d77033951d15fba6b05dd0ff13",
      "text": "berjam-jam",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "828d0c841008e56e4d4aae58c26ee90c9038027cfc4b9059ed79c0259746c7b9",
      "text": "menertawakan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "83a34fcbd864a99a6cc584f583f3681c5629813925569662d9bbd49a57b301ca",
      "text": "Seribu Satu Malam, kan?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "8504318f4f4e423b6e5405d79ead2bcd8eb53fae0301af2589935e44fc5580a3",
      "text": "keajaiban",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a7d4540bf42309ca948a4eba5f0ae243fda520b844990d574c29e003969df91",
      "text": "ratu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ae71ea95a99f09e4fec9f07ba7f0824e301f967a2169634eb8556cf1b61ef1a",
      "text": "Akhirnya, mereka berdua menuntun keledai itu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b184a97574ebb4a1d191f29d5a241f679959a2179801862c59e48e175c5f087",
      "text": "Si Kancil ___, jadi buaya tidak bisa menangkapnya.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c979893586fe4f15b3cedba61f63ca2fc310b9789af8ce85cf9b4d098a88153",
      "text": "Juha dan anaknya menunggang keledai berdua.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cdb28510454245f6774f11047fc8d6817a0a97dda597abed9aa876f0b304b91",
      "text": "Kancil melompat dari punggung ke punggung sambil menghitung, \"Satu, dua, tiga…\" Akhirnya, dia sampai di seberang sungai.",
      "voice": "id_gadis",
      "chars": 130,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d7533e95138c9f6213eabda836d1dd2c54d4c6723aec9712cb9a709f643c6fe",
      "text": "Dengan sihir, penyihir itu menjadi seekor burung.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f88d86c04118c08283af0d1cec12cd01b72492a41156457bba706488b712a07",
      "text": "menolong",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "928b4a41925024277773340350d74e17fd906e2974e4b2f92844c086309a96ee",
      "text": "Itu cerita buat besok!",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "942f891b1d668d5c4b1e5fd6d02d842d70d5b29d96624b7beb1724b16c48db7b",
      "text": "Terus?",
      "voice": "id_ardi",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95491eba657910bcfaac1e79cb502b483d8ee56603f56f66d75c24201879f506",
      "text": "Pada hari Lebaran, kami bermaaf-maafan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b773136f1a427d6830f1327b0408c290acc474f6eeb4a758296f9a6faf93658",
      "text": "Iya. Nanti malam aku mau cerita tentang Si Kancil buat mereka.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8a4d42828f0ff6c5a8c5b275f6c5bda563a9bb0e5d68238377bc3f76c32e70",
      "text": "Akhirnya, mereka berdua menuntun keledai itu. Orang-orang menertawakan mereka!",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bd7763da2adad553e779bd212612de169be9dac6f8eaae1f32c78d28e5c6a04",
      "text": "Terus mereka berdua menunggang keledai. Orang-orang bilang, “Kasihan keledainya!”",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d93b2776594fd5203d66bebf8f69a505ef2e96ae03e0d4ef0665ac20164e44a",
      "text": "Kami bertemu di Kairo, lalu menikah. Itu bukan keajaiban, itu ___.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "9df556ae672206f4d6bf5a7ea5e924845a86531617b5455057e2ba734587ac0d",
      "text": "Jangan gampang percaya, kayak buaya-buaya itu!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ed8ef052b85514c5b8f4f2143350b4243ed0e1383f5001ffe86f9a422791aa8",
      "text": "Terima kasih sudah ___ saya!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1e4705777194e9a3c693685e7da1a2208d8cf3227413e42a9a1fe967fee01f7",
      "text": "Kancil yang cerdik ingin menyeberang sungai.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a317a18293feeb18d929a969501b59f676e8ae03f33597e003f5537a2092418c",
      "text": "Akhirnya, raja itu tidak sombong lagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a539ae3ee2b973e31fb2cd6b7395aba45f286cc86ed3c4ce6e75b7b815edfdd9",
      "text": "berburu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8aa4a5e460169b545af00b91b59d81b4853fe0a107487d290fe1c69493804ef",
      "text": "Para pangeran menunggu berjam-jam di istana.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9c3ed29c56f459e7f68896694938d3edd9968646bb6c5a9ff799d0bbfaa4b9c",
      "text": "Jadi gini, terus kancilnya lompat!",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9d445e43beb6c5a828279f9195faf09ac94cdca320945217adbd15494d78a04",
      "text": "Mau! Di Indonesia kita punya cerita Abu Nawas.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa36d05569785b78fb50afcf3a8a578294beac731add7921151b3ccd363a9f38",
      "text": "berpikir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa58c4243bee6a78c426b8d62387e3c920ce6fc6fe1ee0b9176e6efb22dd2072",
      "text": "Dia nggak milih. Kalau dia milih satu pangeran, yang lain bakal marah.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "afb179e3cdfc67521655b4d6ce72c62b1c5b50f7488153c1216773084d9e8c6b",
      "text": "Putri yang baik sayang sama rakyatnya.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b145d857d54edb487053fb511ff0edd9611c54a385c38c50c8f1d895db028776",
      "text": "Pada zaman dahulu, ada naga yang menjaga harta raja.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3272567eff20b28f6da3689de7b229044bfae8dfdb5960e93c119ea616508ae",
      "text": "percaya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7c83a5e52d0563a9ccea7d34c47e6fb18f47f6bd8a876954181b19d22747610",
      "text": "Raja itu ___. Dia merasa paling hebat.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b984bc1991adee9a2724f5058c2967a4d82ece8a3ac82c3dcddc1396ee77adf2",
      "text": "Mohamed, kamu tahu cerita singa dan tikus?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9b3919dd98c02cb85bb0080ca652288da771b6c4d22d87ca9976706ed31e022",
      "text": "sombong",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba364e2cb9c1cd2b0ce3535891240b3fa425f7e64f91a4a8a65b9f624886970b",
      "text": "Jadi, dia pergi ke pantai terus terjun ke laut.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd81f37a8657398175c1dfd070700c8c88f538d863e39da526400b90ce15e740",
      "text": "Rakyat percaya nyale adalah Putri Mandalika.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "befbd6d9db9a74e32c2c2a5dc7be7961b2bfa40fac02ebfc4896164099ab46b4",
      "text": "Kancil melompat dari punggung ke punggung sambil menghitung.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf3434e12d28f8815dd47f5118854adb5f3b4134af70d686d449d7406732da57",
      "text": "Di Mesir juga ada cerita tentang sihir dan penyihir.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c152fd354c1dfc6a4bfb62e67c529591994f34a71e2ff1ab8c7a112521edbe15",
      "text": "Mohamed, kamu udah dengar legenda Putri Mandalika?",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4dcb2c0ffa2f62fd3653077fb6ea22c59c24c1c39bda68a5e2517328221c716",
      "text": "Seekor singa tidur di bawah pohon.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "c51a3ffa6eaa0182407021e5b00627b41368e8c333599c6743d55adca6d64e36",
      "text": "mencari",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8107ff554639e3c55657841deb37e34794e04edd12c883dc18776a3e67b3e53",
      "text": "raja",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8cc1f93bec272b8cdc2ad8dd4c57e0ea4e537b9af9dc875394538bf6e6a09e4",
      "text": "mahkota",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa598cbd0251707d7d8dccd1952306e8bad45f1df4e820f4638dc73db7b4854",
      "text": "Suatu hari, datang seorang anak yang cerdik.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "caef40d0f0b4697dd23fd50975f95d55bb46d276804233350592963bc34b881b",
      "text": "Penyihir itu memakai sihir untuk membuat pangeran tidur.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc5f5d3da25eb6edbf10d0a121511a2ac139630fadfe4d4a86a5414bc73d8012",
      "text": "nyale",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf61f9a3159f579a51530e9afae83f9e2c8ecffb2fbc0dc33ab834d0ffcb639f",
      "text": "Dua anak berkejar-kejaran di Pantai Pink.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1ad986fefde31bd4c34a39e1205fd98cb7786154e9e08eb0037e865edc2140c",
      "text": "Ha-ha! Amanatnya, kita nggak bisa nyenengin semua orang.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2d8aa198778fdde9308be6c009178356d5df33ee63c97e9810306f368eb53b9",
      "text": "Suatu hari, Juha menunggang keledai, dan anaknya berjalan kaki. Orang-orang bilang, “Kasihan anaknya!”",
      "voice": "id_ardi",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2e1d356b494e72637c83586dc282b78bb67d1d8cec7e5f401234c9ffc1717e8",
      "text": "Sekarang, tiap tahun warga datang berbondong-bondong buat mencari nyale.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2f6c3e497c0eca435f532c6d41802da6c55e99e27bc829a180d4b9e091da317",
      "text": "Pada zaman dahulu, hiduplah seorang raja yang sombong.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d37980e3d669f4867616c9d7eb4c415ae559e19844b1f187421d01d8463ffaa9",
      "text": "Dia terjun ke laut. Sekarang warga datang berbondong-bondong buat mencari nyale.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "d667e30fa9ce7832712f2aaf9a4fd4bb69570421e20f163707259aaba07cb900",
      "text": "Ada cerita tentang makhluk di Danau Segara Anak. Katanya dia menjaga harta.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9f879e8c45295a4f05b6c501e2109357cd2cf22c54049060fbe7ea2ae14cbc3",
      "text": "Belum. Ceritanya gimana?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc2642cb5780a59da6aea6d326325fb1c335cf93b6feb6526e0eaf12447f5cc8",
      "text": "Mas, sekarang ceritain akhirnya! Putri Mandalika milih siapa?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd7d0b3b33ba3daa2b77c0dec50d5f38d2e25ab18873d77d8c13639bda1c1bc4",
      "text": "Seekor tikus kecil berlari di dekat singa.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "dda976334cb12edb00bc946b5f560cb1f0c2082e9007b6704b61c60da42bb0a6",
      "text": "Ratu memakai mahkota emas.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfc8f69c17d29b1e6ba9872a52a5c15d3c4a2d8c1f235a4c7be55587cd8419b8",
      "text": "Pada zaman dahulu, para pangeran menunggu berhari-hari di istana.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "e22ae60451fcd605993e5c9f7fe6085eb71e4bc94a7c46082acb40bf5c1587ed",
      "text": "bertahun-tahun",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e775365c983010708429ffa3fb2fc6bdd900ffaaa0bfcbc87dc9cfedc317a619",
      "text": "Para pangeran datang ke istana untuk ___ Putri Mandalika.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea15b701fda667edd88aa1acfc4cba01f528a289c2506bf772348b2c759a1d38",
      "text": "menghitung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "eebc8999175cc8cd05068bac8d39709217d407d8b61a624b73a26050c1633a2f",
      "text": "Di dalam gua itu ada harta emas, tapi naga menjaganya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "efb355732793327036497316669b0b3c3c0be640bfe34256583e209606979c12",
      "text": "legenda",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1e21b62ba68f073651c00c5b57766bc5eb360006b5c4f9fa75fecd1c8544aea",
      "text": "Jadi gini. Seekor singa melepaskan tikus kecil. Terus orang-orang yang berburu menangkap singa itu.",
      "voice": "id_ardi",
      "chars": 99,
      "mime": "audio/mpeg"
    },
