    }
  ],
  "audio": [
    {
      "key": "01edb727533b8165e4b5175b5c992ecdb8f77a8365d09efdc67e4c4c3d23f4ff",
      "text": "medali",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0210201e63ff9b9fbb84a6376f44c5c6d787670313a8a1cfea592cbcea5475c1",
      "text": "Atlet Sorong Raih Emas di PON",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "02e0fba8b56951631a200d5770a3c87ce45c0d83cdef25ffcaacef56d14ccec8",
      "text": "kabar terkini",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "03b3622a648b36e1c8bb0a881438b089323f8ac3431d2a1047e18d0855a94de7",
      "text": "Keren! Lomba apa, Kak?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0467b086731bb3da4d695c088fe2f4540d9a7eec675e125eccff2e1c7bc73045",
      "text": "berdaya saing",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "04f81552857c3acdb139203397ced91160eaa5bb0dbf17ca08aa03e8cfe4cc9f",
      "text": "purwarupa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0696256a9e2bd50944498d1245e82a912d129fce1c56979258fabbe6396dec3e",
      "text": "Dua kali cedera, tapi dia tetap pantang menyerah.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "06ccbbdb908d5f7bef972a12031353a92989b044f0e7cbd58c8e04eb15ae1425",
      "text": "unjuk gigi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "083a0548297b54f8fe43ecb93595aff739375d15112f9fde800c5a0676cf5208",
      "text": "Perusahaan rintisan itu mendapat modal ventura.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "085ce54046c9ff45fd39597a5023764c8a68c89210730fbe46934cbb412512ca",
      "text": "Aku mulai dari sejarah sanggar itu, sejak tahun 2010.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "085f09769e0a34a4d6e2ef584c8d8a14708eb283e505b324cec8349aa6cc7959",
      "text": "pendengar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a3561b5a4755801b1def48f4ec5da91cb912c61b4a6a2ab2766bc10815891d3",
      "text": "Selamat sore, pendengar. Berikut kabar terkini dari Sorong.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b1b8ce830db36df05693c1880cf2fc07b9e17ac95b9ec7ab223198f461a0977",
      "text": "cabang olahraga",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "0be08019e9d84f3dec988b2a37eb3189395b49ecfc8bcceb74deff2663245822",
      "text": "Makasih, Kaka. Aku hampir lupa bilang \"ujarnya\" habis kutipan.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c6101ff35946d13db778cdd111bae5f10d7c1f6495c4bb6bef31cca1d33c3fb",
      "text": "Ini liputan khusus dari Sorong tentang lomba tari remaja.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ceaea5db53c7b730c1950f4603517af544e0d00398a605c0c013a3bfcfa1cc2",
      "text": "reporter",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "10cbe08c8d04a413963e7bf50b700cc4526075ef7ef3a87872ec3a18e9ba0a5d",
      "text": "Hari ini kita wawancara Steven, penggagas aplikasi Ikan Segar.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "11a2e178a734cbbe86f4165fdd72f4a218b7b0a4e55bcf2521ea8deed59319db",
      "text": "wirausaha",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "12df3e26dcd7c1793a7af1be067e2ef96700b0f10641299fa8ce51380e205a79",
      "text": "Mama itu menjual anyaman dan noken di pasar Wamena.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "178c407b5deac8df45af89609c58374fad9de2f88a469ca657fee1fbc87942c2",
      "text": "Senang, tentu. Tetapi lebih senang lagi kalau ada wirausaha muda lain yang ikut mulai.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b5a9856c4edd99b0d191675c9f8a0cb50fa927ae0d7c4f15dae5fa7471136f1",
      "text": "peraih",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b898eae603a3e4b552ed1266d8fa9f02142775e7301eb409b7ab73fbf80ece0",
      "text": "tuan rumah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cce77417f49c6f7f1bd6aa12e4ffc1b21873c39b51511f5e6d1e759120a00f5",
      "text": "rintisan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e3078388a5b354cffef32c375e2a24083d74d7c3359040c3aaf8898d4ab3ca3",
      "text": "Mau banget. Judulnya \"Pelajar Sorong meraih medali emas\"?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ffd96a37747cb3969f641247f42056dcb52a95aa2b517a6cdc92c1bc3888851",
      "text": "Wirausahawan yang hati-hati. Aku suka itu.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ffe6c66ba486052ec888f80212bf1ef8cc821057476370f4364511aacd606e0",
      "text": "Gubernur Resmikan Pasar Ikan di Biak",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "206d9a3334d30bb7faa08f8541d4f626ce42870b8548a1b78ae37a954d36c4c6",
      "text": "Dia perintis klub renang untuk penyandang disabilitas.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "21f7a448d4f2b1b6a9a40bf3677802eef0a20ce8aab5939553802baab936804a",
      "text": "Siap. \"Selamat malam, Pendengar. Inilah kabar terkini dari Sorong.\"",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "222f2d2380c168c41a14841405e6a028467f4e4af4ae7b8b59e83a2b77d416c2",
      "text": "modal ventura",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2364650d5da799e4f13f2da065541b09fd11321fe2a323f89aaf0f5fa525b7af",
      "text": "Kongres itu dihadiri pemuda dari berbagai daerah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "23adf13d1b6b23425584ae2c952569ab8ba9bf950aff94468684eee5b79ca110",
      "text": "Aku tulis judulnya sekarang: \"Siswa Sorong Menyabet Trofi Juara Umum\".",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "23c2fc420df1c9e19b0f4df1e5d1ed0d4b64bd36faaa36fd72f356011c771a05",
      "text": "Mohamed, tiga detik lagi kita siaran. Kamu jadi pembawa acara malam ini.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "23e94a45ee013dfada5ef868bfb0fc695eb4db080dc0c1d37b1c9900392c9c35",
      "text": "Siap, Kaka. Ada atlet dari Papua juga, kan?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "24fa5748f49d7d5ef31c47bb6f84b1ad73959c8ff8b2b4e65dc6814024b2d7cb",
      "text": "kancah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2536bef8a2e0afca3c866e92482fd267e7eb791eaf630c61431281d40febb9d7",
      "text": "Penghargaan ini untuk dua puluh warga yang bekerja bersama saya.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "2549f59a5f4488fea7130391425bf36b1020a3268dc46a7c2100cd0956517f82",
      "text": "Kami putra dan putri Indonesia mengaku bertumpah darah yang satu, tanah air Indonesia.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "25a2bd82ff5d5d5006cda178fbc95b465f8f80702c23a573c08e7436132d8197",
      "text": "Sekarang dia jadi panutan anak-anak perempuan di kampungnya.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "26fcfa621485d94c59b69d89a1d2d9216d7c18818511a3d79be696c707b9391e",
      "text": "PON XX diadakan di Jayapura, Mimika, dan Merauke.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "29009993be7012323c7ce105539f9c9dca962cf1ceec86b728b026cc7345771f",
      "text": "PON",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "29c5a422450a4a5ad89eb5c9e753c00d7d5dc665dffcd05dcba4b8960c9c7165",
      "text": "tanah air",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b86b5a5c1172d3b472c5701902bb21b766b0c00f2fb796ea4252ed80d599a74",
      "text": "berbangsa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bbfc0a89556be11a5fd59e754d15d46ff8f482c32c7ad5e1fb7ff79b11d21a4",
      "text": "Kebakaran di pasar itu diduga karena korsleting listrik.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2efae1425b2c12a21d2a58275e5af5d071c17148b91a4bb68908636b8803ec1c",
      "text": "Dalam judul berita, setiap kata diawali huruf kapital.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "35912c825b4a50dd9b58268ecb2acc710088901057c3ec2f54d3ccde8cba8bad",
      "text": "Kontingen Papua pulang membawa tiga trofi.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "367d078b0e80f4a999a48d74ec0f92d01b102ec34d27f3cdd2209a700053ffda",
      "text": "pantang menyerah",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "3916bb7ffe5006715bad7e375f8464a6002eef3aade4b17b59be5cb7ee718e5f",
      "text": "Penggagasnya mengajar kewirausahaan kepada wirausahawan muda.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b3e4df8cc07160f4e149c4cf3c1359a2a3067254c8cebba918471f1d5a74ed7",
      "text": "Penyandang disabilitas berhak berolahraga seperti orang lain.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b81266e0944a7a1b5fdf405ddc2f5b3508ce0939b97e976eded9804415c7627",
      "text": "Maria, apa yang membuat Anda memulai usaha ini?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d9616ad803997fcced896f28ee1550d01386b7abb9981cd08be687e122ca2a3",
      "text": "prestasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fb15a25971e053d896adc3bd7af5163521d3d6b972fa2e06db2d225f335c9d2",
      "text": "dedikasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "40b8aa66d6093e502ddf2846c86e49d59243ed1a7854a8cf37675e6069a36d32",
      "text": "Kami mengaku berbangsa yang satu, bangsa Indonesia.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "437e2613fc757eab83b2432aafeaf8c339d4a36eef31e79144e36245f890b1b7",
      "text": "Iya. Sebagai tuan rumah, Papua pengen juara di cabang olahraga ini.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "449df1e4dfb3f64d52bba08d36f883d96ff420114fe511eff65aee713ddd05fc",
      "text": "Dua orang dilaporkan hilang setelah banjir.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "470c84a86491a5b7336b4eac8807939b3319e253cd0b7e3218221b6834464756",
      "text": "Selamat malam, Pendengar. Inilah kabar terkini dari Sorong dan sekitarnya.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "47449a966058fc13035c3346e1b89c8b71940ba58f0fe20bc4c941cc19902dc0",
      "text": "Dari kulit kayu. Anyaman kayak gini butuh waktu berminggu-minggu.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "48763f2672ddf7626d2bc16ac54b5453b6078ae6a0cabb7207483ac667c751cf",
      "text": "Judul yang ringkas lebih mudah diingat pembaca.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b0148ac63820144d3fc7347ede0a7999ec55a7cabcd904f7ad45482fb09c2cc",
      "text": "liputan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d5aa920edb0aa391a8b043cf346774eba51b46169ea3cbc5e4303d4e09329b1",
      "text": "kongres",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e4328f948e15dd80d8aca0bbbb341db8e771e50124ae0774ec1c69629fdd899",
      "text": "mengharumkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ee6062ed9129111c2f9879b1565aa07e5568f801a24eeae7598143f0be2759d",
      "text": "Jadi beritanya soal regenerasi.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5316a408fe7391650c6391615e4e617968ea6ce89181ee4c33bd93101c1fbeb8",
      "text": "Guru itu menjadi panutan bagi murid-muridnya.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "53eb0b4836cfdf444968a33a0f73bb7a2f409297ed1103d4f2e587662d5efed4",
      "text": "Mama di Wamena merajut noken dari serat kulit kayu.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "547fee049f0c9f819c6cab5c72b7072a1807b0a9dfe2ed1d37e92ae2051b7c6f",
      "text": "difabel",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5526d7bbd57228cd6f683fdf7b0efc519e9b0cbbfc6afdfe6d110f9bfbbcc3ca",
      "text": "Prestasi terbesarnya bukan penghargaan, melainkan lapangan kerja bagi warga.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "56ace21ffb30b428ae9d0f34a703d8c1d6fe10c7585aa7befe21457c0bfd1770",
      "text": "Tepat. Itu liputan yang rapi.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "58c573e8f836cb909fc1ee918d3863f5d08f4e2a4d238dacbd2ca5049d835d81",
      "text": "trofi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "59963f736c1749ec2140197ad9cb737098354a267dd1bb8f67332766fe8d7d60",
      "text": "Atlet Sorong meraih emas. Demikian kabar terkini. Sampai jumpa besok.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "5abd70fd4c4c1a1ba50a0b1f272648f54c81ae4a409dcf33634df3816ccf306a",
      "text": "panutan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ad7e0bce7c01a30479cea9ee242b13f35e31e88e64c74f1f2f4ad9e01118660",
      "text": "Kontingen sekolah kami menjadi juara umum.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c2afc296f3d1497cbf8b751c906844419b9c09561670165ef0a1259cf4981cc",
      "text": "regenerasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d09bad61ea901a5aa12fcacba398bfad9813548fb08010bab7a4d2008362761",
      "text": "Saya ingin menginspirasi anak muda Papua untuk berani mulai.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e9b74f1486c9077e1157d14f10d54c1c079ce6a9bc94945c107a8ef0f3e0ead",
      "text": "inovasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f16e368ffff63a5c228e285b5b7063f7852137aef32b9c7e5c7bc6aa54e3f0e",
      "text": "Lampu merah udah nyala. Kamu siap baca siaran?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f217921e23d7668fc5a295a764beab5bf8a60f9fd29f0e9039c86bbdc1e1da2",
      "text": "Investor memberi modal ventura kepada siapa?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fc6b956f9c41dcc6c2f2f71496067c8ad4dca0884c02cd63d891c6b2a63da17",
      "text": "berprestasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6221d62be9abc3b37d8148ad6dc2edd8a863a2180a7c055ebf0a8847dc3bfed6",
      "text": "Pelajar itu meraih medali emas dan dilaporkan akan mendapat beasiswa.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "639ba8d25c4b91954166fd98c3f9d10125e6fdb1c8023fec0ed54feed35acb15",
      "text": "Ribuan atlet dari seluruh provinsi bertanding di PON XX Papua.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "64f5a408d34445cb403ecdc56c8275caec5d34cd806f6e07ba05a0faba184332",
      "text": "Selamat malam, Pendengar. Sekian siaran berita dari Sorong.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6531d0ea5df469233cf0f3515cf0d30cfaa20c0b97c3da705208b5527cda3046",
      "text": "judul berita",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "6544893a02e1cd53da3531170c21cf57d663cf4f44c9f51fd47da5561fe27ba7",
      "text": "Kemenangan dalam lomba itu mengharumkan nama sekolah mereka.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "65985fa1d5f68bff5a84a8ac58b23e45a5fd42800c67ad0d2ad1de6040019719",
      "text": "\"Presiden Resmikan Jembatan di Sorong.\" Terus titiknya juga dihapus?",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "6633652f41a294195982ebd6cffe71ed11b1d3c25eb552a029c6fe9c89b905ae",
      "text": "hak cipta",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "68ca8bb1795baada6df20f478120db8fe186abba1f8d8bebeee09117816302af",
      "text": "perintis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "68d66eaf65b3a5141b628cc83dde513b3129fb00abcb242aa6dd5ead2bab327f",
      "text": "dilaporkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "698418e912d17c021ecc977a42560e1586268731ea24cc8bcb5fdb0f1aedd487",
      "text": "Nelayan muda itu tekun dan ulet.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b085db22ea3183fc7af264e7ed9e099a1c0311da4137d1ddd68936312d2ce60",
      "text": "Belum. Dia mau hak cipta kodenya aman dulu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c1cbef6ee4a7c5107c5cd422dd7e06d12609a5a7db8a2647dffe93c50e0c99d",
      "text": "Iya. Purwarupanya dibikin di inkubator kampus di Manokwari.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e55159a2652debe982eb3e585542405bc9d93021c9005b38d2133ff8b4d89f2",
      "text": "Wirausaha muda itu menerima penghargaan karena inovasinya yang menginspirasi.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f245ee67987bbc736b6f04945187debb2225c5d81eecc85126635b617778acc",
      "text": "Setelah juara, dia kembali ke almamaternya untuk melatih adik kelas.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f2c01d7ef215974777ca5600e415de5c6ae5ca50a3471b35a90cb3c2c6d47bd",
      "text": "Mereka bersaing dengan dua puluh negara di kancah internasional.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f81912ff2ce232e620f699e30fdfb2b8ecbb84d4983868ee1df0a8113365716",
      "text": "Selamat malam, pendengar. Saya akan membacakan kabar terkini dari Sorong.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fc93aa16dddbb0db4351ca9e9ea45a3f54a3b3967159c46db3fafc891ae9a35",
      "text": "menginspirasi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "703f93d58f3c815211c36142097959b538e209c29028f14075b4aed65d885d6e",
      "text": "Siaranmu tadi bagus banget. Banyak pendengar kirim pesan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "72377d9459b38441e2634a3aae7f6f89ac29f940922a8b7d693c869c35103859",
      "text": "meresmikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "754e84b7415548199b94eeeb317d4dd880e0b8f2094644b03c76e0c8cf968134",
      "text": "Mohamed, berita penting sore ini: kontingen siswa Sorong jadi juara umum!",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7673bfdcf79f9610334f6f5d910ad76e4a1f0e5ed4924402c18ce9a71663dd93",
      "text": "noken",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7760fe15e72ce0c3b0aeb45efc212cdf09433b361d9532b40d6b638b4074f7b1",
      "text": "Purwarupanya dibuat di inkubator kampus.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "78146cc0622deb090ecf2ff27c23a4101703e161dd31e2c30cb9e39ae0191c69",
      "text": "merajut",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b33518e7bae02f4a36dd0e93dabdac4006b218f9e398f9f4cf48420369f171d",
      "text": "finalis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c4d160c8aa5a4c628c9de957c759e1c1697a617290ff7634ecbd733227e5daa",
      "text": "tekun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "85fe9944604ac6218af6dcb50b183e94e7a6abfe237d0ffef5a4a09cd3e77055",
      "text": "Aku mau nulis berita soal noken buat radio kita.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "86d8543beca0810fa54436f04aeb703d0de7ffdd88ced4533b6fa0bea6f56dc6",
      "text": "siaran",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "87fe9735f958f491b283735ebbc8febb4f9df2f7e66585b871974ad6061edec1",
      "text": "Tujuh emas. Mereka naik podium tujuh kali!",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "899d8815f87adb5c1c2b0befbd0e26db0fc72067306471b1077dffd47bccc6a3",
      "text": "Atlet difabel itu bertanding di Paralimpiade.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e99316222770b1b1c63613dad432e1749255a120cb52875228276f97a5038d3",
      "text": "ketangguhan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f473ade756d01eac4be2478c814b32b04f802af5b84993657376c12592ebcf7",
      "text": "Peraih medali emas itu baru berumur enam belas tahun.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "920b32287923674315a7a77d34c17dde156fd69834c583b6c817ff9cf9cab6ae",
      "text": "Hampir. Di judul, pake \"Raih\", bukan \"meraih\". Lebih pendek dan kuat.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "92255ba3715721de6268abea8fc3f8c6ce4b7832656cb10b7af240ca4f2ec61e",
      "text": "Noken ini dirajut dari serat kulit kayu selama dua minggu.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "9282e164a1fb895213264b5f9bdf6d3320561aa9c3c38eaeb5cc3dab8fee4a5f",
      "text": "penghargaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9286e79236104623833ce913887248b45e0b712bf7ecb47dbe0fe8772ca79162",
      "text": "bergengsi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "94b30998f029f4bcb2eefa463bc2e7851035b798421f897dc05e3f01c4f3c834",
      "text": "Bagus banget! Ini dari benang apa, Kaka?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "94b4f2829f6b307cb79f6ae05a6091a0c85ecceb8eeb4167c2f2b333a3b595ad",
      "text": "Dua hari lagi tanggal 28 Oktober, Hari Sumpah Pemuda. Radio kami bakal siaran khusus.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "94efc9e5ec0c7c98584ce5626b9f84f94185bf9cea7f1fab64e1e1e288e4776f",
      "text": "Dia udah dapat modal ventura?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "950c67cff88af293098b931a845387557496b6305e2be9a33f6ad33dfa14b6fc",
      "text": "Bagaimana rasanya menerima penghargaan nasional?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "9555d049889e8c72d7b1f42aa78a57a8217704b34b9920d0b80ddc68f61aee06",
      "text": "Pantai kami penuh plastik. Saya pikir, sampah ini bisa jadi bahan bangunan.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "9629fe4e246723b9fb71f33d1098fdcb67459e2281220892a0408465febdca10",
      "text": "Pembawa acara itu membacakan berita dengan suara yang jelas.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "964c96311d0310ae77131bc2a571c966f08d94a47f08432b920e9bd7a17fd3f1",
      "text": "Dedikasinya kepada anak-anak kampung membuat semua orang kagum.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "96f2e6d78b6f2de57341a7f4d21e91e0f25f496ce20516becf89ab55b18e510a",
      "text": "Kata mana yang sopan di berita?",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "9884e3a19d0b99170e02f330024e691c8d8e467929cda6c511c44aee74fe2ae3",
      "text": "\"Medali ini untuk Papua,\" ujarnya sambil tersenyum.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "98c4a328166529d23aca3da49b3b36a34cb9ce2f6c393077a6dc262e8b7e9669",
      "text": "menyabet",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "98c55a3a379db5afab2c5528af5abbaa7b3bad3c2c64749cdb4504046b057c05",
      "text": "kewirausahaan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "98f0b3bff6e10fd45d0aae82c0a43da144ee2d328d9a27e814687d33ef2e5e9e",
      "text": "Atlet Papua bertanding di depan keluarga mereka sendiri.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eae328a49d16882c922f106b0ba2e2010e6348dab3c6d5d123211ffd77cf012",
      "text": "Jadi sejarahnya di akhir. Terus kutipan dari pelatihnya di tengah?",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0f0ac66695f9f3e98d44274f7f4bb409ce5dfbe1a876ef16374bf776ea1e530",
      "text": "Oke. Terus aku serahkan ke reporter di pelabuhan, ya?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a130d48b25f84fc9e03a82e646562a0809c99f31c0bd8c2069cd07a8e41a80b5",
      "text": "Noken digantung di kepala, lalu jatuh ke punggung.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a24759c7ccb7874f01b15dbc10450e41de372dc700fa0649b299668bda530a9c",
      "text": "Penggagas aplikasi ini masih kuliah.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ac78a1cb09c98eb0a850c5fa290a43ee9cb97308d043f7b9595ff4cf4f27fb",
      "text": "disabilitas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4bd39cf2f1da1ba4c683968b31fdd8b8e9850422fed89de224cf56ea823cf2a",
      "text": "Kabar terkini dari reporter kami, kapal cepat ke Waisai sudah berangkat.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac83357484fcf51111adbf0136f75e98de0ef51215b4ff8b1e4c056ed6ad302d",
      "text": "Kaka, judulku \"Presiden sudah meresmikan jembatan baru yang panjang di Sorong.\"",
      "voice": "id_ardi",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac961ad2d5f8f64f5ece2ae8a0013913997cd21668f810dce9feeb71a0506be8",
      "text": "Iya. Sama soal gimana atlet kita tetap berdaya saing lawan atlet mancanegara.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad0d50fde52a98c840d75648d75014936daf4e151b7bc57f979ac9e89c07fa30",
      "text": "Emang sumpah itu artinya semua orang harus berhenti pake bahasa daerah?",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "afbd0b3e8c7565d3f743b2f3e838ee4b2cc1f6facc00d0f560e125afbc3d50e9",
      "text": "paralimpiade",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b04db37a6d2d9dfba9cc5050fbbf9c999f9158f0fdaeee586100753c2c45434e",
      "text": "Siapa yang mendapat trofi juara umum?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1324c78637f90baa06cc9d01ee57883fad61b295024396d6da0155d08ed024e",
      "text": "Iya. Aku mau lihat terumbu karang Raja Ampat.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b15b8eb5f3134c29600903d34ee0c64f90e1e827db89b0d94c5a15b46aba3d05",
      "text": "Mohamed, ini noken buat kamu. Mamaku merajutnya sendiri.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24e6eab2d353131f5f73c2f9f40c914577802fa4a1ab60b72ddab09def600c3",
      "text": "Dia panutan saya karena dia pantang menyerah.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2eea951e99d2d2aeb7464f9c1e7900fea8f30d2c802f1f8b3f1b1462c9c0f08",
      "text": "Atlet muda itu ulet dan pantang menyerah.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3231edc7fe007eb05a13fe9a1d4a3a5cfa0b75b627dec08692b6b3fc6ce4ac2",
      "text": "Kata mana yang paling cocok untuk orang yang bangun lagi setelah jatuh?",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "b50985c28ee1b21676dfc6bc76e80677c3074bff20c29472ac3eb70b9d5b1f3e",
      "text": "Kami masih menguji purwarupa alat ini di pasar ikan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6a1ebf1e32e1e074b7bf149efcf5b9836f623912b363a47b8a7d26d8b9f8510",
      "text": "Terlalu panjang. Judul berita harus ringkas. Hapus \"sudah\" dan awalan \"meN-\".",
      "voice": "id_gadis",
      "chars": 97,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba525b9bab02bddbe0921cb1a0d81eb78ebdcc5ffa0bd8fb8a987bad2927195c",
      "text": "Betul. Sekarang dia ngelatih atlet difabel muda di almamaternya.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "beda8a7fc94a06d43579f8cf115aa1e8bdd954bf5b4f8ee5fb16a16548c8b3df",
      "text": "sumpah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfa3d986ad228262fc2f6368fd4bf91ef3d27e1d5f3947d38ca1e3f196d8e3cf",
      "text": "membacakan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0bb1d2a2634aea7d4d21ae8fb7205c2232d9b9e236c47aa3ddf4ead648d765d",
      "text": "Ketangguhan kayak gitu jarang. Tahun ini dia unjuk gigi di Jakarta.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "c21d0f489f584e0e55fe1d9f05cc32b7a44cd190e87608fc32585b64bd497ee7",
      "text": "Saya pembawa acara Anda, Mohamed, dari Radio Sorong.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3e1813309c288a347bd5e949eeebc57815597a7e2f25ee3195c95b058346ee1",
      "text": "Untuk pertama kalinya, Papua menjadi tuan rumah PON pada tahun 2021.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4c0e894d4d91c3691abab23d527698cd46a1a4fdcdd65e31b3d1268d66ebbee",
      "text": "penggagas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c54f2707e912d182e8953819748aba17a936a568ff5d163add0fdbb2ddcade8b",
      "text": "Reporter kami melaporkan langsung dari pelabuhan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c75bfb76a4369a1fda6dc588edff3f2ccc25aa89c13d0b094fbb2765e8c48250",
      "text": "juara umum",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c846a1b79d32c4111cec4598e3741b66096e3c68c313863dc223b73aca013f84",
      "text": "Dia tekun belajar setiap malam.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "c88cfeeecb82afec67231b25f35dbf83c4751bc2fc8f34290ebc3ad50d2c378f",
      "text": "inkubator",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c91ff9fbe784ba5ad7ace87ceb5dabcb7629ee5a48d6873fddda5941a05debc5",
      "text": "Mohamed, hari ini kita liput final tinju di PON. Siap?",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f328dd8e034efd3ee38ea0d17575f2145d2438008c5782f1c12520d5cb92e0",
      "text": "Bagi orang Papua, noken adalah simbol kehidupan dan kesuburan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "cad596c774084f5a2083415c0cb6df5d12d02ba70c046e5a0c16c9dbf6442ce2",
      "text": "Regenerasi atlet penting supaya kita tetap berdaya saing.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb0c5211f100c0d47e0e7112091e3ef367bcc03740bec5353e5bac33b46a74bb",
      "text": "Naik podium di lomba yang bergengsi itu mimpi saya.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce17b722107b1b962c9db765e4e080a58d625cd24ba30ace3400ddad79cb2943",
      "text": "Mohamed, besok kita liput Om Markus. Dia perintis klub para-renang di Sorong.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "cffd4a6ac23e09550b75d8726f9ba5aabeacafb4f3be51f2053c4c778412492d",
      "text": "Kalau dia menang, judul berita kita \"Atlet Tuan Rumah Raih Emas\"!",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d14a5e1dc5e2c122f1a8a66d00982d89366575b063c28a436e68a05612787133",
      "text": "Jadi satu tanah air, satu bangsa, dan banyak bahasa yang bersatu.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1a87ddb241a8089b0c838f5135f16e5b3aa9d3cec414321e8afe383c3fc14ec",
      "text": "Kita berbangsa satu dan bangga tampil di kancah internasional.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "d30d0400521d8cf0cf1760a8e62bc70a16543165983b8fdde80ca6cdaf7f768e",
      "text": "Wirausaha muda itu terkenal karena inovasinya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3659725f698e3b2f3b89cbd9332af15b78b8f98d0a4adabe3fbddb633239fcc",
      "text": "Berapa medali yang mereka sabet?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "d569b8afbc15e734f21c91f8500a0da932c274aae2ab492b7fde5c1aeb8bfb5c",
      "text": "ringkas",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6b27599e69f8dfb98636df1f75ceb08370e1f83b8d9fafce2864ab9c06313eb",
      "text": "Atlet Sorong meraih emas di PON. \"Ini untuk Papua,\" ujarnya.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7a80b2f8f9f32fc4e035db228c0bc45a29a9d8e801e7b7cc1007745459678d9",
      "text": "Rina menyabet medali emas dalam lomba bergengsi itu.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d818c9a5b69b43833baedea8e2ace90da354937e71f4ee7bef4eecbe6f9c8e64",
      "text": "Tiga finalis terbaik naik ke podium.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9b144208609d73d18991f5ee9e07e227970b558c1b6bd7812db6eb4ceef5f48",
      "text": "huruf kapital",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9d18bb1f34c4aba706a7e60c56b9dd43c89e67e89413c7e3b28c1179214a41b",
      "text": "Bagus, tapi pelan dikit. Banyak pendengar kita yang dengar sambil nyetir.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddd58e8f35ed2f0c35b3d8b5847156c86e37bfb8643488dc2e7afe4679a76334",
      "text": "meraih",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "de2c67273c428d2424644030f1dc533d8dc3ecc362950e7771f47d9c3c4f4fbf",
      "text": "mancanegara",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "de76756c7d930f8c35bd9b32506bead0bee05f17cc562a758f5ebdeebb7bd03d",
      "text": "Kebalik, Mohamed. Pendengar mau tahu dulu siapa menang lomba apa, di mana, kapan.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0069a86c7d62ce01994723ae4805145a1a61715de6eb6ce608108db989e5366",
      "text": "Muridnya pernah ikut Paralimpiade, kan?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0797ff7577928190f95e8e8d25943f82bd5293be041301626cb2f1711d2f819",
      "text": "Perusahaan rintisannya baru satu tahun, kan?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2aa92cf2eb4c16b960bf211fb68e3bc8bbac71018ada4d58784d2e7f2bb9842",
      "text": "almamater",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e368ba2422d5fcfeec04d52046934210ebb282fe0591753d271a98bd795b063b",
      "text": "Wali kota meresmikan rumah sakit baru di Jayapura pagi ini.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "e54f3e43712fcb4e02f32150429fe71b893d36b07652f1c58a05e897bc50ffd8",
      "text": "Kita berbangsa satu, tetapi berbahasa daerah yang berbeda-beda.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "e59c08d9cf6656454b009c4a824a82b2da9e2103ea198bb3af6eef02af90489c",
      "text": "atlet",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6bacf892d46835ad11bc3cdcbcfbd9f30a4a371a2dc411ba9159f2575a70b60",
      "text": "Lalu kutipannya, '\"Saya ingin anak Papua percaya diri,\" ujarnya.'",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "e75a8bd736c42eac9bb777a7f33290d492bf68d561452e5ffd188210d221a0bb",
      "text": "persatuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e939d7d0adf576f1a87d20039f1e0b0149f88537b4ef82f0c2b48951cb3f5dd7",
      "text": "diduga",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e96aca077efa35505c2f6b429e2b3449c7f0a89bcd6256e62abf4dd596ca347b",
      "text": "Olimpiade sains tingkat provinsi. Lombanya bergengsi, lho.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec179b3dce96758d38c8d513ad1e973803b8bc748ebf076a7529ea563f618fae",
      "text": "Bagus. Pelan dikit, ya. Terus kabar PON.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee325963344ff206b731cf18c8041599f55f9872a8f571717dca10a61154ba46",
      "text": "Liputan lengkap tentang lomba itu bisa Anda dengar pukul tujuh malam.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f053584a7c4f128638c82eef4e9a42b5fb0267a628aebf485863055214db444d",
      "text": "Selamat datang di Sorong, Mohamed! Aku wartawan di radio lokal. Mau bantu nulis berita?",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1bf271cb21c464e3985fd297f8c2b970436138dbaee097b8476f6ee57ace354",
      "text": "Iya, tanpa titik. Jangan lupa huruf kapital di tiap kata, tapi \"di\" tidak.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1ce2a693852253153e22cccb544b4f805eafbc335587882dfc22f9f4343199f",
      "text": "anyaman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1e27ac30d0212d9f989563cf2d2104f01dd8be9fe0c295e31cc867bd79b4c1c",
      "text": "wirausahawan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "f317d84da809a7766bf3a3dd479894b8f1ade32a2dcf6bf0d6ccfb6412bbe345",
      "text": "Udah. Dia tekun latihan dari umur sepuluh tahun.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f369e5a3f10e50c7d605924a9568755b86bf4e94a2e4f0daebb3670d880e4cfa",
      "text": "Atlet difabel kita berdaya saing di Paralimpiade.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "f43c0896b53882292f140a263f5844e603afeeed39c1d09d51505386d0dd186e",
      "text": "podium",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5f36efa42cc9cc4a3adddfa04609f37afd282407af1f6a983f4b9e0fe8c0280",
      "text": "Kamu udah baca profil Maria, pemanjat tebing dari Wamena?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7224ef686b82809aca7ba45469ff44a3a8f9e568e548946283e0dc3d741b6d2",
      "text": "Nggak. Bahasa Indonesia itu bahasa persatuan. Di Papua aja ada lebih dari dua ratus lima puluh bahasa daerah.",
      "voice": "id_gadis",
      "chars": 109,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8f80386d56cdb40702989f824a4dfba7f094b0f31fe034df7a02a1ece349ac0",
      "text": "kulit kayu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc09617fee721a3e5a91214fbc5157a95806eb47431c7ad2e2cd07f0fdf4bec4",
      "text": "kontingen",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc6d0f93113a8fc93e6c993d68be6780f07f6dccc2fc888007443554bf8b39e3",
      "text": "ujarnya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fccbe5d39fba6523d44defb134d8e77db98d8db97444fa5ed6678cd237e38b9e",
      "text": "pembawa acara",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcd635b1f2f2c99b4776d443c1a59457baa8ba8bca7ef20bee00e407e370629b",
      "text": "ulet",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe01724915e079c7064d546a7c944b638f233d0c003ac1c772e5683bae08cd3d",
      "text": "Besok kamu naik kapal cepat ke Waisai, kan? Dua jam aja.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff0becdbd25912e4fd7e42d5027e9b280e8d3ea0613fd65e42f0ce63be329a0e",
      "text": "Inkubator itu membantu perusahaan rintisan mencari modal ventura.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 14,
    "clips": 198,
    "chars": 8124,
    "audio_bytes": 0,
    "missing": 198
  }
}
