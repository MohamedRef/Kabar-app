    },
    {
      "id": "bipa7.u01.l06",
      "sha256": "f5a715d2c47a478d8e227dc8d5f93b69f97e1f8e4f501579043b0de32a3aba9f"
    },
    {
      "id": "bipa7.u01.l07",
      "sha256": "7b8d67fe1f5f72d07e61b4c1ef5d9bd4de4b6ecb9403d8d35ce7c03a88af2442"
    },
    {
      "id": "bipa7.u01.l08",
