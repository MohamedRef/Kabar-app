    },
    {
      "id": "bipa7.u02.l02",
      "sha256": "c0084f1afd50d178ce959ff32220e127f05bb620541a7461adf2bce4a71682b1"
    },
    {
      "id": "bipa7.u02.l03",
      "sha256": "30a56cb4cf89bae2a5193843954079ca9c83c1e6219617d41bd62aedf82a4809"
    },
    {
      "id": "bipa7.u02.l04",
      "sha256": "bbb5dffa96f2a80fad91e5a187da8fa406dc60a5a504786c2710125d86f4ae52"
    },
    {
      "id": "bipa7.u02.l05",
      "sha256": "5792bd402b087d8b0050f9322c4ec75e0dbabe31859c27adb8be6fba9d1693bc"
    },
    {
      "id": "bipa7.u02.l06",
      "sha256": "a6920f09b954acfb8534a13c3abb8a2b099d7e76d4301ade22a69c69e64d3d47"
    },
    {
      "id": "bipa7.u02.l07",
      "sha256": "a5b3ba09ce982a3d3b0c6ede7f66366e2cd80499f026ad7af05a68a00ad3492f"
    },
    {
      "id": "bipa7.u02.l08",
      "sha256": "94a03cdb0415a5361c9079701a5202f2263e87ef80a562441924be39d4c88c2d"
    },
    {
      "id": "bipa7.u02.l09",
      "sha256": "405082e291b96644f6a03f3c0fa611627741c32bfdb3fe4d23cb846e2872891e"
    },
    {
      "id": "bipa7.u02.l10",
      "sha256": "4d2820e4dee0e241f45989bcf2b7e4d876728c6133cbd61cf983fe745506ce7a"
    }
  ],
  "audio": [
    {
      "key": "01833c9fca6233f35af62d9ee1016375054eb728d5b1c3c456b387d0a56236b7",
      "text": "teks eksplanasi",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "04dc08e3b504c7f5c16c5b5e4f6fc1a4af1f0db32e84f5441324c05c101eb178",
      "text": "Baik. \"Selanjutnya, rekan saya, Sinta, akan memaparkan penyebabnya.\"",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "0675e8746bb3cf7c6c78f9a61d5df037f4fa938d8aff4e0367eea62e40661325",
      "text": "Perlu digarisbawahi bahwa karang adalah hewan, bukan tumbuhan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e17355582a8431cfa25ad70dff354763049d6a9a114b9237e86a9e318cf461",
      "text": "bibit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b558b30ba20e07efa6e858e881b0911cc6fed5711ca975b738c2ad1952fc3c7",
      "text": "Bisa. Saya mulai dari definisinya, lalu tahapan bagaimana terumbu terbentuk.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b618aba2a8e55bfd6964d52821da813b4f830d0d35558c076cee7159dddbac2",
      "text": "buka sasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "11291037549bced2a56279a7379035cd81cd0daf6f47b07dd1dd91efd51f7680",
      "text": "Arus yang kuat menjaga ekosistem karang tetap sehat.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "115217046d01a7e23d843db0b9dfd79d9b0533ecb23ae2670a9312767937c723",
      "text": "alga",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "12774717202d3b84adf0a39e10294aa74e8e27fea26af39802b7d9a42ce924f9",
      "text": "Benar. Hiu berjalan itu endemik. Dia berjalan dengan siripnya di air dangkal.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "1307f625fa8a77f4c6c0f5525a985b7f82a8d7504c1bcfec1bda6e0f75c2b1fd",
      "text": "Pesona bawah laut Raja Ampat membuat banyak orang ingin menyelam di sana.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "13587954cce82a7c8fd413e097c992913a181474817290e04119004108f1fd04",
      "text": "Besok kamu presentasi di depan para penyelam dan kepala dinas. Sudah siap?",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "135fe40132025e43abd3915ee71c3cb3ddbf8acb86e4efa7898bd4c2f1d1b510",
      "text": "Bagus. Jangan lupa menyebut nama rekanmu saat beralih.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "144f2ea8b16fbc654de974dbfc1f868f96b6422ea5a539a7f934659d03bcc07b",
      "text": "beralih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1470f78ad99c0adb6d94910c9685d39392d8fa809690038bb17ef8099ee519a8",
      "text": "Arus membawa nutrisi, sehingga keanekaragaman hayati di sini sangat tinggi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "1692af83883a8d24a85a9fd49471ed67f6a7cd5fcb5f7820f54d50dfe1bd8b48",
      "text": "Pada 2020, persentase karang hidup menurun drastis dari 40 menjadi 15 persen.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "17e97b0fc22e69a533056e3311b105aacc0c3b925411819d7bb73509246632ee",
      "text": "Kalau begitu, saya menanam sepuluh lagi!",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "18c390e9364508a1a5585258dcc3a62a46e0b7d668224a3803d45997e05bf781",
      "text": "Sejak tahun 2022, jumlah ikan di teluk ini meningkat tajam.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e0040c7c768ce3ba12939b44e103cde2ea6342863aace24e944ded9322f0ce8",
      "text": "Dan semua ini kawasan konservasi?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd32d685692c6f9575d9c926f248cb14031de77be10feece3223e0592189daf",
      "text": "Akar bakau menahan lumpur, sehingga abrasi berkurang.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2024a0bdc2f4c27de9e838b5d686f11e0cddaaaaa1b81651acd1d1c3a50de0a7",
      "text": "yang saya hormati",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "213bf2cbe5e0b44efdf4acf704cd5f5c380b9623a852b4366f42177a79b4fe1b",
      "text": "Warga pesisir menanam bakau untuk melindungi kampung mereka.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "22ba813c2d6eb6701ab73083f1a7d848b7ba6bedb60897d1818ce2391d05979b",
      "text": "tutup sasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "22e593dfab56741125a6686412cd0d985ccd2ca66ea4bc78f922568876e87a00",
      "text": "persentase",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a7214e0bb518ee95142bfd75169f28cc480ebfbd0347ccea82e6f664728053e",
      "text": "Tidak terlihat. Besok kita ke Arborek, desa kecil di atas pasir putih.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a976f2ecc454891670fe9b25d1b80bd350f3d611fefd5f835e8b4979371375d",
      "text": "terbagi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dcc0b6ec492484eddee2501d89463e6f1594b923fb96aebf100aa964b9d48bf",
      "text": "rekan satu tim",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e42c0eba50920459a7b83e25f773a6116ac4658005041a79442c24c43653ab6",
      "text": "Arus kuat itu berbahaya, tetapi juga membawa makanan untuk karang, kan?",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ef23fc58d99e1c0ae3c9953f016a2329da747880182db6f90d7b7bf45462f4d",
      "text": "Belum tentu. Itu pemutihan. Penyebabnya air yang terlalu panas tahun lalu.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f464dcedb5021265a820afd534c54246b77058567e204b0a58ac33d0af553c1",
      "text": "Pak Yance, kenapa ada daun kelapa diikat di tiang itu?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f9bf7d0155f728817da984e633f6ad7e2a01ba25917dd8b2b3939b2ad1fa556",
      "text": "Hati-hati, arus di selat ini kuat sekali hari ini.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3697a0ea66cbad43216d93d985138909003fa269f32fb69fc1df4421377e6743",
      "text": "Persentase karang hidup relatif stabil selama lima tahun.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a9d7797bb622c49c72a0beca9b553025e268bd28b1e896c9c4a915605bf2fa7",
      "text": "endemik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa1fd1d60171087ee145cf799c259f30fb41230b1b2384e97efca6c24bba730",
      "text": "lestari",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c2bcd73a0311199ce90423ed397be2dbc22f3334ac9225bddcb907c1ba60e1a",
      "text": "Sasi adalah aturan adat untuk menjaga hasil laut.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fbf1d97dfd4b9cc83e947653bfa0d71f4ff97bd6db0070584b9b2eaa0b64dd9",
      "text": "Kalau laut kita lestari, anak cucu kita juga bisa menikmati hasil laut.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "403c1c97ce93586070e3b5acc190c11e5ff0e05fdb2775e456abd5ccf8cc9f64",
      "text": "Baik. Dan saya tutup dengan pesan agar mereka tidak menyentuh karang.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "4183bc92915381d82e9ce9cc8d7219e6212fcb4dc770a6ddcd18d53832026a89",
      "text": "pemanasan global",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "467270cfb303b6305f8272da4e19c21dbaa4242435f60aea64be9e53ecd5a609",
      "text": "Yang saya hormati Bapak Yance dan teman-teman, kami akan memaparkan tentang hutan bakau.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "48068070663f9d7faa852c086932fcda3c35e31cc11202b024a176250dc3b755",
      "text": "Kawasan konservasi melindungi keanekaragaman hayati laut.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "4951a75286680503a07f8103ca113c634838c0f9d89c85b46cefd90ea0ee317a",
      "text": "memulihkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a30f4e9af0cc963ceb8bb20efe5b46c71df5a7ebd79e90260e87058ad244691",
      "text": "Presentasi ini terbagi menjadi tiga tahapan, dari penyebab sampai pemulihan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1a2f5fd5e26ee55cf4923e76b59887a458b1bb219bb6567a0e30049f3bf6bd",
      "text": "Hampir. Saya buka dengan \"Yang saya hormati Bapak Kepala Dinas\", lalu memaparkan tiga bagian.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c4b9e7a5633316d25fa548135ad6f5b2fbf03b7139980a4a03c6f9aec165296",
      "text": "Hiu berjalan adalah ikan endemik di perairan Raja Ampat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "51b2c545ee7a8c5107112854c9f2ba21eb452cfc11b7eb1231db3143c9368aba",
      "text": "segitiga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "53fc468f4f49a96315666aa1c9255b65b81a0922089cb0d66e61d48042e6fccd",
      "text": "Yang saya hormati hadirin, teks eksplanasi ini menjelaskan bagaimana terumbu terbentuk.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "564eeb21da7fc11263e9c9d0ed5026059e096d8b18c0f1c3b63289e696156e45",
      "text": "Raja Ampat adalah gugusan lebih dari seribu lima ratus pulau.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5771999be42ecefee3954a78e4973df703c801914d4abc4fa10b04b579181ed6",
      "text": "Jika air cepat mendingin, karang dapat memulihkan diri.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a47d53c27c9bdcfbee948fba195b5ce9a56b970abdb57310b52b6cb0444343",
      "text": "menanam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "59f1ec345d781f13c4eac8c83b52f9ae323bb3ce8709da03c5775df419a80916",
      "text": "Penyebab utama pemutihan karang adalah air laut yang terlalu panas.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a77f46c1b6766739345b60cc159389b58f264f5f4ed7f07a338899d2b98e10e",
      "text": "Jadi kapan buka sasi?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bfcd5afa35516108063bfbe6b8c30a5ac44f9fd6e0208c231cc59c06b634521",
      "text": "Untuk buku panduan pengunjung, bisa kamu tulis teks eksplanasi tentang terumbu karang?",
      "voice": "id_ardi",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "627cbb509a25d538e6ed815f784dd9cf46502c67e48a5ff4de0da9b60cb53e0c",
      "text": "Sebagian besar. Penyelam membayar tiket untuk ikut menjaganya.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "664581da605313426489200f9e7eb5327671fb785f32e6c844facb29c92d80ce",
      "text": "Segitiga Terumbu Karang adalah ekosistem laut yang sangat kaya.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a16dfb00365dfea99a74c39330f4c782db23dae5f807484515f97d6d52a7b9c",
      "text": "Sebelum beralih ke bagian terakhir, saya akan memaparkan satu contoh.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c8ed346e30f072d5226d3bf54f2da02636b6c38a8ebd7a44cce76dd31f0c140",
      "text": "meningkat tajam",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ddd8d9653ce2fb77940c87bb58a3672bb097d115ee2ae9112beae6ee31f197e",
      "text": "Itu tanda tutup sasi. Karang di depan kampung sedang istirahat.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "700cc4c99487d4b2a7a3645a10ebb0770b1bcb2d3cde94d3b5b53cd938871c71",
      "text": "Saat buka sasi, kami hanya mengambil teripang yang sudah besar supaya tetap lestari.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "743fc7d91fe5863278d0c176c52dd76065d55f6af9b84662e9d344db45837a3a",
      "text": "Pulau karang kecil itu terbentuk ribuan tahun yang lalu.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "77720c6396605dc95595fe3221971988bbd9a03476e57e5ff6c296e69cb6e0fa",
      "text": "Mulai hari ini tutup sasi. Tidak ada yang boleh mengambil teripang sampai bulan Desember.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "7835b8bef7709d425360d5f48005741ca53c9c92473c0e507f4102539b3e24f2",
      "text": "Seperti yang terlihat pada grafik ini, angkanya turun banyak sekali.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c873224192bbbb4c142e9846e13405298aff16f39564a4b6995dccd11b5f7cb",
      "text": "Kelompok kalian ada tiga pembicara, ya. Siapa yang mulai?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d23750ae981689c7a2f62612ec3ad55c32b410ffcf12300e864b44af63b107c",
      "text": "Keanekaragaman hayati laut di Raja Ampat tercatat paling tinggi di dunia.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dd21b5d1b8efcfe682549a70820ffbe0aa40212a365768cc0184267df21348f",
      "text": "Saya, Pak. Saya memaparkan fenomenanya, lalu rekan satu tim saya, Sinta, menjelaskan penyebabnya.",
      "voice": "id_ardi",
      "chars": 97,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eb12177a5bc54f76d35aca92b0583be733c7cbf4f37d6e3935836bea7310c4b",
      "text": "Kata orang, di sana banyak cerita rakyat. Saya tidak sabar.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "8009eb4f9b338f5704e091e5f73cc9d14f8f6e9858dfba06ecb3c424bff06f45",
      "text": "Jangan lupa peran arus dan nutrisi. Pengunjung sering tidak tahu itu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "844e4b212772948a22a3d10da90fb7ca54516d4b23e0cb384107112506737af3",
      "text": "Wah! Apa benar ada hiu yang berjalan di sini, Pak?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "850c1c70280bc151ef9e07936eda5fa4c2f6ed834d1867bfa7e7629ef5bd188c",
      "text": "Terima kasih. Saya gugup waktu beralih ke bagian pemutihan.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "86afb144e6db0a05d53381996d386817766ee4ad185c906ffaa47045ca82230c",
      "text": "terbentuk",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "87bfc0d84f6b2ae5dccc1a957ea4d4b9556cf4b298a7c6bcfd98bb6133e8c621",
      "text": "kawasan konservasi",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f661de1f31a1bd5005d36e6064b6fcf674afa8e7291c3e2bd18b6ccbbc6ad9",
      "text": "Bagus. Bagian mana yang paling penting?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bc0119bb844ed74404e5b2534f2b1ca3fb931728910f6a6c83c89ecd44c8230",
      "text": "pari manta",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f32d87580d26f2f4c013676ffa627336d4f1c066d4352edf85460ca562c98f8",
      "text": "nutrisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "91d0e77df23a7e1269963c2dce57bf345fd18c4d1908d4e872aaa6d37a0365bd",
      "text": "pesisir",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9393fd89dff63756d1e72a589fc00cda98815af9d8c48c0fcfca97fd2663c5ab",
      "text": "Arus membawa nutrisi, sehingga koloni karang tumbuh lebih cepat.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ec00da0a2e92be27a75aee1d3bb49ad81dad4bc9ce7ef0de6e3b23613d4aff",
      "text": "Betul. Karena itu keanekaragaman hayati di sini luar biasa.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "985c96381e467f85793e52a1af0b10b262e4de0630a904c746d3c7900eaf04fa",
      "text": "Seperti yang terlihat pada grafik ini, persentase karang hidup meningkat tajam.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d04b9fa7c3f2a8d9bff2dab66a43e6b1685233e3063b08229bcdaea90c83b6d",
      "text": "Ikan endemik itu hanya hidup di gugusan pulau ini.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a16d7110360a7b06ce0438bb7e006e045a748e9ffabd8b9fe031348a93c94fb7",
      "text": "Terima kasih kepada rekan satu tim saya. Sekarang saya beralih ke kesimpulan.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6aa04f33e1d7b8b9ad4cd8989b2bffefda33db1244ba16a6f2bcd9b5f1be1ad",
      "text": "Saya pernah melihat pari manta saat menyelam di dekat Waigeo.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7b8c45ef4c9c384546cba2e5262ca14bca263d93157187ef9951e6bd3287a23",
      "text": "ekosistem",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9918b721d2d163f1e469a70123347cb494707e329f1dacdb03ca130a1bdcbe5",
      "text": "hasil laut",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac492ad892bc15890ee17e69e40c12ab54b83dcfd7ecaa0cbe14068a02cf55ca",
      "text": "Alga memberi karang makanan, sehingga tanpa alga karang kelaparan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7f1d829274cd2ae8753970703dd64954ad7eb133562cdb08bbc58ce3f85246",
      "text": "Yang kedua. Di situ saya bilang, \"Perlu digarisbawahi bahwa karang itu hewan.\"",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac8a044520a07b9c3daa3a6e61c128858a51816e807ed0149335e3061cdcc60b",
      "text": "penyebab",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad81a38c3fc9d021ad6cf4d326b1be147909d3fe4bd49c5a50bf81da700a2783",
      "text": "sasi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad8b397cd69b20b09b1262a691555386fd619dc78653e479d58cd39bd055cb61",
      "text": "Mohamed, ambil bibit itu. Kita menanam di sini sebelum air pasang.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae44fafda10a3c0af150ac4169f624bdb1600ecce0b83e42cb1ee5d05052ed73",
      "text": "Presentasimu jelas sekali. Kepala dinas minta salinan grafiknya.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9a2733fe37f03681811b86153448162aa40bbb363299c2c8045343f90d06ba",
      "text": "abrasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0d19bafaa758600b3dafc614ac509cc9e33f4bd7cb2849d837917d864df58a6",
      "text": "Nah, itu baru presentasi ilmiah.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b222a3e9dbbc3169d591c1ac43e7a263973983aecb947ec9a516ea20381a4ac7",
      "text": "Pak, karang di sebelah sana putih semua. Apakah sudah mati?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb15413de961423a2a2ffde9118eb78ff15743a3d6feec4fa9e1a0ebe627dbe5",
      "text": "perlu digarisbawahi",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb9fa12cf5a31da22e971ca3a01ef6ffab84a042cde853aed33cb07797f4f3c5",
      "text": "tahapan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd8db0be0158b971aa7b87b26febee7b9973bd8e95f410ff2df2d540587f1669",
      "text": "pemutihan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdf86d11eee3d0e538c79a9e042306e83e8d5602b02a3932b86825ec308a272a",
      "text": "Terlalu santai. Pakai \"menurun drastis\". Dan sebutkan persentasenya.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "be28222c4cd1dc37936df9afd8371d08af0fba8dcb1953e1c2274ea3af37fe61",
      "text": "pembicara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "be64651c643659449e2f7b77b428e51ea16ccbfb2ac273f3de2e8cc5057fbec4",
      "text": "bakau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf0daf9fb374d41afc7e4ebbc2691a7c63e6c3ee1d67e831f1246231b311e312",
      "text": "Bisa, kalau alganya kembali dan airnya tetap sejuk. Kita tunggu dan pantau.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0984c0cb633411ac091d5f96904b14608286308c0e9c7c3f7f2323605998b00",
      "text": "Teks eksplanasi menjelaskan bagaimana sebuah fenomena terjadi, tahap demi tahap.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9791edeab087aa043699d2f8116d5dfbfbf155ff5cbe19d5fb42785a3ad82ed",
      "text": "Setelah menurun drastis, jumlah karang hidup kini meningkat tajam.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccc4e1dd7703a095c7af2e01b8440a0b6d891c630214bd988b60b1d234c6f95b",
      "text": "pesona",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccf8303915d2d8937e7ad5a320c41fab08d4717f06786770f912490faab6857f",
      "text": "Setelah enam bulan tutup sasi, teripang di karang itu bertambah banyak.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdd97c2678a0e5bd5158ff91ffd49916c0eea02c5e7f6826c1065c4fa7771699",
      "text": "memaparkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce3d8b552ec48e7e064dbebbf8004fd2afa9861de02ba11171d7975b050f0965",
      "text": "Segitiga Terumbu Karang meliputi enam negara.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d085a055debb0fdcc2f7b8e9b0e194a4e30f67f0ee4d32ef29507715614f6228",
      "text": "Bibit bakau ditanam di lumpur saat air laut surut.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d139f963bdf5efd1ecdf9589b48c3768510e523dd1e15ad0d76cbabc42ef790a",
      "text": "arus",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d19c7de756d8b7604482dfb0dbecc05b600095061e26f2c0ff2d74d5e34ac7d9",
      "text": "Yang saya hormati para peneliti, hadirin yang berbahagia, selamat pagi.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1f3323d39cacd30be586a03ed652291248bd649d65e2bad069b18658a3c0e41",
      "text": "relatif stabil",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3501f605f3ec32aeae46133102483e4b980d525b3e4e09bceca2b2f6fdfc97a",
      "text": "Pembicara kedua menjelaskan penyebab abrasi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d35b627307a803240480b5fb6068696bea41149cb08d1bff2bbb5a6d6906f8b8",
      "text": "Terima kasih, Sinta. Sekarang saya akan beralih ke bagian solusi.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f85483123630fc2d4faeebfff69315083363992eec589244c7435050bae332",
      "text": "Perlu digarisbawahi bahwa data ini terbagi per pulau.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "d77733b0adf70628b43e57a4fa3d5108eca4f70ea7cc3fdb8a5d0d5c7f86c7a2",
      "text": "menyelam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8332f74fbce0599e636637ffb2568aecf30131481121f7a4310996ddf069587",
      "text": "Bakau suka lumpur. Lima tahun lagi, akarnya akan menahan abrasi di pesisir ini.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9aad4d8b116b1f9b3d7d44176bd40c14fe9f2689a042dc4dba077cb722a5570",
      "text": "Di kampung ini, kelompok mama-mama yang mengatur tutup sasi dan buka sasi.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9ec11e96b5e3cfedb618792b4a3db2f6ae3f089e06a17bb32944d44dc3f6b0d",
      "text": "Para ilmuwan berusaha memulihkan terumbu karang yang rusak.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfdfa7901c612aa983d6e3e0e600cec29dc1a75708a2349393d0f6de605b4efa",
      "text": "Pantas pesona gugusan pulau ini terkenal di seluruh dunia.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e24dd576dff7c8de5d912e923b1bb9f45ae96355391199ef0bd9cddd17a8f75c",
      "text": "Tanpa hutan bakau, abrasi bisa menelan rumah di pesisir.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e694c74e5a5d5416eab85c5c1eec35833b43d34a55dda4271d4b57ce156a16b3",
      "text": "menurun drastis",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6f3aebe23d284d8eae0a3948dba7940c4b18bb0931fc11cab0fc6ccc367f205",
      "text": "gugusan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "edd7659941e3d23caf9e5fb6c6ec14aad57ae95572456433754f908ed4fcccf8",
      "text": "Besok pagi kita menyelam di Manta Sandy. Di sana pari manta datang untuk dibersihkan ikan kecil.",
      "voice": "id_ardi",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee40dd15bf4935f6b8721e8859fbfee947c2829728c4e7316a434a59d10c13dd",
      "text": "Teks eksplanasi yang baik menyusun tahapan secara berurutan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "efb9a64df064b05f52a49dbd628263d9b8edd511034ccf8fd6e4a243e690d921",
      "text": "Bulan depan. Hasil lautnya akan dibagi untuk seluruh kampung dan gereja.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "f44e2c69d16ccd976ef274208d41980d49486d63582c0d84d4dda79ed9387171",
      "text": "Kakiku tenggelam di lumpur, Pak! Kenapa harus di tempat seperti ini?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "fee2125604957f450133d62cbf55ab38ea255e88f3f9a2316ddb950be8d68711",
      "text": "keanekaragaman hayati",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff0034a736d3b2bed270372cb0f363772a19e4e86809ffc2851862dd773ce29a",
      "text": "Bisakah karang itu memulihkan diri?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 10,
    "clips": 124,
    "chars": 5792,
    "audio_bytes": 0,
    "missing": 124
  }
}
