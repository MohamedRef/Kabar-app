    }
  ],
  "audio": [
    {
      "key": "0016ac0dc568df2e091c0d8250f6a950043b788e442bd904bf25e547f2bbe866",
      "text": "kaldera",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "01833c9fca6233f35af62d9ee1016375054eb728d5b1c3c456b387d0a56236b7",
      "text": "teks eksplanasi",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "02297dfc1dd1e16f9971c68c2e2b2b3e40e984b97bccdd6a066e98634646c7bc",
      "text": "tektonik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "02d144908cbbec10f34f0abc4dddfd4857982695f303d364ae4ccc078e0c58e1",
      "text": "Kata BMKG, gempa tektonik di laut, deket zona subduksi.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "04dc08e3b504c7f5c16c5b5e4f6fc1a4af1f0db32e84f5441324c05c101eb178",
      "text": "Baik. \"Selanjutnya, rekan saya, Sinta, akan memaparkan penyebabnya.\"",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "057f320c9cff23c8fdfdd1e8c71e6392f2b339484bf117d860a9cda5337ae0a4",
      "text": "Danau Toba berada di dalam kaldera raksasa.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0675e8746bb3cf7c6c78f9a61d5df037f4fa938d8aff4e0367eea62e40661325",
      "text": "Perlu digarisbawahi bahwa karang adalah hewan, bukan tumbuhan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "06f620e8933714d9b093c85e4d0819d53a2c24ed43dc8f644dbc84e504b8d4ae",
      "text": "Malam ini ada hujan meteor di langit timur.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0983971a80496fa993ee5502b9d918fe2853bbb0b72e87b473831f9377f1c026",
      "text": "Terus kapan buka sasi?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "09bff5b6c46a47309d0a2d710ea202babeecfd63229b4a3af6bdd2270814bf4b",
      "text": "gerhana total",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e17355582a8431cfa25ad70dff354763049d6a9a114b9237e86a9e318cf461",
      "text": "bibit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a1240ce47c06ad739aab50d401ceb8cc94acb5b823c4bcbfa2ad5091c563f7f",
      "text": "Kemarau panjang dan rob sama-sama berbahaya bagi petani.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b558b30ba20e07efa6e858e881b0911cc6fed5711ca975b738c2ad1952fc3c7",
      "text": "Bisa. Saya mulai dari definisinya, lalu tahapan bagaimana terumbu terbentuk.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b618aba2a8e55bfd6964d52821da813b4f830d0d35558c076cee7159dddbac2",
      "text": "buka sasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c37d28d56373c9b18763dbb1ce269ca29aa512d91cae4aa15644d40d7610a1f",
      "text": "erupsi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "10614151e732a4892e21f14418ec519db6d3aee83e4174a53d3470a56ef11730",
      "text": "belerang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "11291037549bced2a56279a7379035cd81cd0daf6f47b07dd1dd91efd51f7680",
      "text": "Arus yang kuat menjaga ekosistem karang tetap sehat.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "115217046d01a7e23d843db0b9dfd79d9b0533ecb23ae2670a9312767937c723",
      "text": "alga",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1307f625fa8a77f4c6c0f5525a985b7f82a8d7504c1bcfec1bda6e0f75c2b1fd",
      "text": "Pesona bawah laut Raja Ampat membuat banyak orang ingin menyelam di sana.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "144f2ea8b16fbc654de974dbfc1f868f96b6422ea5a539a7f934659d03bcc07b",
      "text": "beralih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1656b0e2a9dee1c4636302321fb8f78fe16370c2ff0b2aa84a3cf63bfb9f4e9c",
      "text": "Oke. Ada bibit siklon di selatan, curah hujan tinggi tiga hari.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1692af83883a8d24a85a9fd49471ed67f6a7cd5fcb5f7820f54d50dfe1bd8b48",
      "text": "Pada 2020, persentase karang hidup menurun drastis dari 40 menjadi 15 persen.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "17fa234121c9dd6a147988ddaedb1f94aa8c196fbe6da6f99319cd206c966a67",
      "text": "pasang surut",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "18b71a9ff8af5bef71fa0b520a23022e2884a546908b25ca8033d29b3b4779a2",
      "text": "Petani dulu menanam padi ketika rasi bintang Waluku muncul.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "18c390e9364508a1a5585258dcc3a62a46e0b7d668224a3803d45997e05bf781",
      "text": "Sejak tahun 2022, jumlah ikan di teluk ini meningkat tajam.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ae16e8ae9cc556ebdad4c294d7b549c5d0824acdc112058e7d7f5052d55472e",
      "text": "mitigasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e0040c7c768ce3ba12939b44e103cde2ea6342863aace24e944ded9322f0ce8",
      "text": "Dan semua ini kawasan konservasi?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fd32d685692c6f9575d9c926f248cb14031de77be10feece3223e0592189daf",
      "text": "Akar bakau menahan lumpur, sehingga abrasi berkurang.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2019cb64ac482ec7021099138493c3b4947f66300230f8444405f92c4b1b4898",
      "text": "Status gunung api ini naik ke Siaga sejak pagi.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2024a0bdc2f4c27de9e838b5d686f11e0cddaaaaa1b81651acd1d1c3a50de0a7",
      "text": "yang saya hormati",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "20d17a97f77688c709e1e02b84375a3e8043febda5f3aa07bd664e6585c9eae7",
      "text": "Seismograf mereka mencatat berapa?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "213bf2cbe5e0b44efdf4acf704cd5f5c380b9623a852b4366f42177a79b4fe1b",
      "text": "Warga pesisir menanam bakau untuk melindungi kampung mereka.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "22a9cbc0f190245f3d99775837d5948939af0ba8402f50f7c912e85bd1c79fcf",
      "text": "kemarau panjang",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "22ba813c2d6eb6701ab73083f1a7d848b7ba6bedb60897d1818ce2391d05979b",
      "text": "tutup sasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "22e593dfab56741125a6686412cd0d985ccd2ca66ea4bc78f922568876e87a00",
      "text": "persentase",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2455cc32f7363363c09abe338734a8e85bdd06dd1807467e7b9ba9b543946fda",
      "text": "seismograf",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "25fd4dc239b9032135c43c13f14c58ff43ebb6a5bb94e732b008c1cc73ef02a4",
      "text": "hari tanpa bayangan",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "2647dc92407414eedb16982e87f15ee2f4cbe2e1ae1d5d61fb83dca1e649cb86",
      "text": "Gempa itu disebabkan oleh subduksi lempeng.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "269297eb82d6a51bfd7ddd313340609e1e5b05918eda504fe2b28a065219b6ce",
      "text": "Fenomena mana yang bisa dilihat di siang hari?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a89a4f08310fd48b55da444b3109a76eb70b4a9018e2409a6889bd623d1d511",
      "text": "Awan panas turun dari puncak gunung api itu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a976f2ecc454891670fe9b25d1b80bd350f3d611fefd5f835e8b4979371375d",
      "text": "terbagi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dbde633f6304444311b397c8769d9d7beaf75c7157cd70741fa3cc55fcaa314",
      "text": "Kami menonton hujan meteor dan mencari rasi bintang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dcc0b6ec492484eddee2501d89463e6f1594b923fb96aebf100aa964b9d48bf",
      "text": "rekan satu tim",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e4ecbf2643203b2a54d80ab6710132423057599993d1df0431a80b3244fd970",
      "text": "Wah, airnya jadi biru! Ini bioluminesensi?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ef23fc58d99e1c0ae3c9953f016a2329da747880182db6f90d7b7bf45462f4d",
      "text": "Belum tentu. Itu pemutihan. Penyebabnya air yang terlalu panas tahun lalu.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "31fd5946c82f1210a624f3a64a678f96e3a5434e958d24014b84c4a1248eca87",
      "text": "Pak, karang di sebelah sana putih semua. Udah mati, ya?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "3697a0ea66cbad43216d93d985138909003fa269f32fb69fc1df4421377e6743",
      "text": "Persentase karang hidup relatif stabil selama lima tahun.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "36c64fffd311a688c1e2fd6b53cd3ec3e4e315558aa145b8e4464ad453a15372",
      "text": "vulkanik",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "37d531ffcec84372d0326481c46ccb54910742b3c96e0c6025a0a9ea3ccfc6fe",
      "text": "sesar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3807bd74d5ffb803b1ca0d3a3f008f84051a53e540d1de8a5232927f4f3674b2",
      "text": "Rob masuk ke rumah warga setiap bulan purnama.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a9d7797bb622c49c72a0beca9b553025e268bd28b1e896c9c4a915605bf2fa7",
      "text": "endemik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa1fd1d60171087ee145cf799c259f30fb41230b1b2384e97efca6c24bba730",
      "text": "lestari",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bfd465e7f31e8c0fc8e5cfbc53737f14b6d7d52ddc2d8519a6cdcf4a360d012",
      "text": "Besok kamu presentasi di depan para penyelam dan kepala dinas. Udah siap?",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c2bcd73a0311199ce90423ed397be2dbc22f3334ac9225bddcb907c1ba60e1a",
      "text": "Sasi adalah aturan adat untuk menjaga hasil laut.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d1ad3e6b0ca472c413627655c11ae341a782382f19093c4c64c0e498eed89a1",
      "text": "Kalo gitu, saya menanam sepuluh lagi!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "3efc628821d5d24b51be47036420cf45687e16e6ace8b49cb62b049ac154b542",
      "text": "bioluminesensi",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f2e0a676d65ca69614d1687a240bdc1b3b1e97f60e26e6e5ab1707d4e5009b8",
      "text": "palung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fbf1d97dfd4b9cc83e947653bfa0d71f4ff97bd6db0070584b9b2eaa0b64dd9",
      "text": "Kalau laut kita lestari, anak cucu kita juga bisa menikmati hasil laut.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "40bc6c34c7d81090868fd4027101384cb2c2064f69b1e04c2c9becab8dc35db3",
      "text": "gerhana matahari",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4183bc92915381d82e9ce9cc8d7219e6212fcb4dc770a6ddcd18d53832026a89",
      "text": "pemanasan global",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "42d54dcdf7137b8acf98ea6066145ab61832df99451db0952076c908e5ad725a",
      "text": "Penambang di Kawah Ijen memikul belerang setiap pagi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f1e525cb33ae54e66ad64397955750cc5fbade6e46c6bea45cebc651f889c5",
      "text": "Bagus. Jangan lupa bilang nama rekan satu timmu waktu beralih.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "467270cfb303b6305f8272da4e19c21dbaa4242435f60aea64be9e53ecd5a609",
      "text": "Yang saya hormati Bapak Yance dan teman-teman, kami akan memaparkan tentang hutan bakau.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "48068070663f9d7faa852c086932fcda3c35e31cc11202b024a176250dc3b755",
      "text": "Kawasan konservasi melindungi keanekaragaman hayati laut.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "4951a75286680503a07f8103ca113c634838c0f9d89c85b46cefd90ea0ee317a",
      "text": "memulihkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aed690e68011ebdd6b3b0419afcdb09beef6118cc09fcec406f5d022afa7857",
      "text": "likuefaksi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b1a2f5fd5e26ee55cf4923e76b59887a458b1bb219bb6567a0e30049f3bf6bd",
      "text": "Hampir. Saya buka dengan \"Yang saya hormati Bapak Kepala Dinas\", lalu memaparkan tiga bagian.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c4b9e7a5633316d25fa548135ad6f5b2fbf03b7139980a4a03c6f9aec165296",
      "text": "Hiu berjalan adalah ikan endemik di perairan Raja Ampat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "51b2c545ee7a8c5107112854c9f2ba21eb452cfc11b7eb1231db3143c9368aba",
      "text": "segitiga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "52a8de2546f2a16ca6bb6c23b915738096b354958756f8b499cfa9922da61724",
      "text": "Itu yang kami takutkan. Warga di dekat sungai harus mengungsi.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "53fc468f4f49a96315666aa1c9255b65b81a0922089cb0d66e61d48042e6fccd",
      "text": "Yang saya hormati hadirin, teks eksplanasi ini menjelaskan bagaimana terumbu terbentuk.",
      "voice": "id_gadis",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "54dab250d88b9f21871162c344971f7864160f7f7d2c254536b5804d204fe17d",
      "text": "Kakiku tenggelam di lumpur, Pak! Kenapa harus di tempat kayak gini?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "55293926181ac9821993e037b4ac1bcf3661209848d6055f43abc804d39a9425",
      "text": "Betul. Plankton kecil banget yang bikin warna biru itu.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "55902e3bcedbdb244975fc6a465cb64f7fab00328d8c0ac702df2d548f6574d2",
      "text": "Belum. Tetapi awan panas sudah turun dua kilometer ke arah selatan.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "564eeb21da7fc11263e9c9d0ed5026059e096d8b18c0f1c3b63289e696156e45",
      "text": "Raja Ampat adalah gugusan lebih dari seribu lima ratus pulau.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "5771999be42ecefee3954a78e4973df703c801914d4abc4fa10b04b579181ed6",
      "text": "Jika air cepat mendingin, karang dapat memulihkan diri.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "57a47d53c27c9bdcfbee948fba195b5ce9a56b970abdb57310b52b6cb0444343",
      "text": "menanam",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "57ae1364154138a46974182baa87bf10ac62a8a61b442fba74a48cb584038d48",
      "text": "vulkanologi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5842d708b6e0faf6de4abc2b0d484aeecdfe5fb0e8471d737cd36577793f1533",
      "text": "awan panas",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "59f1ec345d781f13c4eac8c83b52f9ae323bb3ce8709da03c5775df419a80916",
      "text": "Penyebab utama pemutihan karang adalah air laut yang terlalu panas.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "689e59633da665f1339538f392ae72773a070dea65b01203e3afb72994ca20cc",
      "text": "Iya, sebut juga risiko rob di Klademak. Pendengar kita banyak di sana.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "69263a7d59af4bf2bc3ef3634de6576caf8a430c0183f37149440105414b7a1a",
      "text": "rob",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c9ce9eab9606c61de3de9c7557586c1a7dd21c9aa5b11c29a92ccbce2e4cc8",
      "text": "Pada hari tanpa bayangan, tiang bendera tidak punya bayangan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a16dfb00365dfea99a74c39330f4c782db23dae5f807484515f97d6d52a7b9c",
      "text": "Sebelum beralih ke bagian terakhir, saya akan memaparkan satu contoh.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c8ed346e30f072d5226d3bf54f2da02636b6c38a8ebd7a44cce76dd31f0c140",
      "text": "meningkat tajam",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cde8241cd5df7502434ac331edf87c3af7db405ef406cedefb43902deaacccd",
      "text": "Bisa, kalau alganya balik dan airnya tetap sejuk. Kita tunggu dan pantau aja.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ddd8d9653ce2fb77940c87bb58a3672bb097d115ee2ae9112beae6ee31f197e",
      "text": "Itu tanda tutup sasi. Karang di depan kampung sedang istirahat.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f015a04daf2207222d63260962e973459ba2b9697b799e7ca6b7ec7bcee843e",
      "text": "Hati-hati, arus di selat ini kuat banget hari ini.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "700cc4c99487d4b2a7a3645a10ebb0770b1bcb2d3cde94d3b5b53cd938871c71",
      "text": "Saat buka sasi, kami hanya mengambil teripang yang sudah besar supaya tetap lestari.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "743fc7d91fe5863278d0c176c52dd76065d55f6af9b84662e9d344db45837a3a",
      "text": "Pulau karang kecil itu terbentuk ribuan tahun yang lalu.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "74e936ade2379aab0f482eecc1d7865af1eac4b9d0a01791a51685a53993d1b7",
      "text": "Pak Yance, kok ada daun kelapa diikat di tiang itu?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7509a788724a8348d81b8bc688430880052567fc06936be7d62a2ff930e3ece8",
      "text": "Kemarau panjang membuat sumur-sumur kering.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "77720c6396605dc95595fe3221971988bbd9a03476e57e5ff6c296e69cb6e0fa",
      "text": "Mulai hari ini tutup sasi. Tidak ada yang boleh mengambil teripang sampai bulan Desember.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "77e3778c43f9467a7f4b68f7226d470b81ae939cd978a39bc91cb51156a293b6",
      "text": "Ombak bercahaya biru karena plankton.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "7835b8bef7709d425360d5f48005741ca53c9c92473c0e507f4102539b3e24f2",
      "text": "Seperti yang terlihat pada grafik ini, angkanya turun banyak sekali.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c873224192bbbb4c142e9846e13405298aff16f39564a4b6995dccd11b5f7cb",
      "text": "Kelompok kalian ada tiga pembicara, ya. Siapa yang mulai?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d23750ae981689c7a2f62612ec3ad55c32b410ffcf12300e864b44af63b107c",
      "text": "Keanekaragaman hayati laut di Raja Ampat tercatat paling tinggi di dunia.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d9fcf44c45f94c1d2f24e650cbe0aa511bc48b356ec89324c460e28b9eda519",
      "text": "Mitigasi bencana harus dimulai di sekolah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dd21b5d1b8efcfe682549a70820ffbe0aa40212a365768cc0184267df21348f",
      "text": "Saya, Pak. Saya memaparkan fenomenanya, lalu rekan satu tim saya, Sinta, menjelaskan penyebabnya.",
      "voice": "id_ardi",
      "chars": 97,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fb3e6fa22a4edd72b8b5cacc4fe192ebf0230e81b7527e81585992d16865946",
      "text": "Apa yang paling berbahaya bagi desa di lembah sungai saat musim hujan?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "802eae7e91514a506b4d38da765bdb52978f1782aa8a641fb7b6e4f44a45085e",
      "text": "Kata orang, di sana banyak cerita rakyat. Saya nggak sabar.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "80ff7251b1286ba7f9b079ba3f62bfdb02b78b3ea3b9c8aadf6098be61ee3874",
      "text": "kulminasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "827c4c4d081c3ee1851ce4d5150bdcf5912fae3ae1032c3a7ae3891cf9aea575",
      "text": "Di Petobo, likuefaksi membuat rumah-rumah tenggelam ke dalam tanah.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "844ff52e7bff54cdc8754c90cef466798abfb47a8833e2a0e47f837655e26295",
      "text": "Dan di pesisir? Malam ini pasang tinggi.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "86afb144e6db0a05d53381996d386817766ee4ad185c906ffaa47045ca82230c",
      "text": "terbentuk",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "87bfc0d84f6b2ae5dccc1a957ea4d4b9556cf4b298a7c6bcfd98bb6133e8c621",
      "text": "kawasan konservasi",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f661de1f31a1bd5005d36e6064b6fcf674afa8e7291c3e2bd18b6ccbbc6ad9",
      "text": "Bagus. Bagian mana yang paling penting?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b976d135b3257bd790d71b663fe0de45a971cacfb5ef34ee08ea783cbb1fbc8",
      "text": "Mohamed, gempa tadi malam terasa sampai Sorong. Kamu bangun?",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bc0119bb844ed74404e5b2534f2b1ca3fb931728910f6a6c83c89ecd44c8230",
      "text": "pari manta",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bd87f05c9bdc50544e3bd0d4f16893183b32c016f40440883ea9e1fce9c6dfb",
      "text": "Hari tanpa bayangan terjadi dua kali setahun di Indonesia.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf67a260958272cf9ece04939609557c66d9429eadf81018f682c3c7b467b17",
      "text": "Lima koma dua. Untung nggak ada likuefaksi kayak di Palu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c4ee20050ea123796d4db9e6f76f82a59cd64492808e51b7e17965a8b285612",
      "text": "Kaldera itu terbentuk dari gunung api yang runtuh.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e3d3bc6ef0327afb50eac980cbda375052fc76d046031dae2703db1b26cb40a",
      "text": "gunung api",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ec705c67b52b70def21e35def3af85a320916ba9fc4592f305520dd85344c54",
      "text": "Siklon itu membawa curah hujan yang sangat tinggi ke Kupang.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f32d87580d26f2f4c013676ffa627336d4f1c066d4352edf85460ca562c98f8",
      "text": "nutrisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "91d0e77df23a7e1269963c2dce57bf345fd18c4d1908d4e872aaa6d37a0365bd",
      "text": "pesisir",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9393fd89dff63756d1e72a589fc00cda98815af9d8c48c0fcfca97fd2663c5ab",
      "text": "Arus membawa nutrisi, sehingga koloni karang tumbuh lebih cepat.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "93ec00da0a2e92be27a75aee1d3bb49ad81dad4bc9ce7ef0de6e3b23613d4aff",
      "text": "Betul. Karena itu keanekaragaman hayati di sini luar biasa.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "964b3207c19419998b4cc8294c135b839863ee6f0ffcba0f38975cad5f33b31b",
      "text": "Apa, Pak? Hujan meteor?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "97ed83fce6bc011fcd9381d11aa9ea18eb44102468401251d7bd5995f9ee10b2",
      "text": "Puting beliung merusak dua puluh atap rumah di Sidoarjo.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "985c96381e467f85793e52a1af0b10b262e4de0630a904c746d3c7900eaf04fa",
      "text": "Seperti yang terlihat pada grafik ini, persentase karang hidup meningkat tajam.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c3d3de5015285b8bc829fb7b7e7d0538501926bceae4fd812938c821690aa4",
      "text": "Buat buku panduan pengunjung, bisa kamu tulis teks eksplanasi soal terumbu karang?",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "99f8d4bcbf8414d76e42c4b11d7a07f71f0d52222ccbfad7f8bb57c3e9881ac4",
      "text": "Siaran jam enam dibuka pake peringatan cuaca. Kamu yang baca, ya.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b01558efef1289b0a89e09d82b095246d81bb1fb41f28d63dd8b95b425548c6",
      "text": "Wah! Emang bener ada hiu yang jalan di sini, Pak?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cd0b6d93643c6c051ece813e0bba768500971b8290ce372ab31fef22238a1ca",
      "text": "lahar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d04b9fa7c3f2a8d9bff2dab66a43e6b1685233e3063b08229bcdaea90c83b6d",
      "text": "Ikan endemik itu hanya hidup di gugusan pulau ini.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "a16d7110360a7b06ce0438bb7e006e045a748e9ffabd8b9fe031348a93c94fb7",
      "text": "Terima kasih kepada rekan satu tim saya. Sekarang saya beralih ke kesimpulan.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "a35549ea5530acdb88df0974be71b3904a173aa227fa17fb54257c93fb59b205",
      "text": "tanah longsor",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6aa04f33e1d7b8b9ad4cd8989b2bffefda33db1244ba16a6f2bcd9b5f1be1ad",
      "text": "Saya pernah melihat pari manta saat menyelam di dekat Waigeo.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7b8c45ef4c9c384546cba2e5262ca14bca263d93157187ef9951e6bd3287a23",
      "text": "ekosistem",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a80a26be923dde054bd506da8ce24febda13d700f938b8cfb15ef5f54f58e144",
      "text": "curah hujan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9918b721d2d163f1e469a70123347cb494707e329f1dacdb03ca130a1bdcbe5",
      "text": "hasil laut",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab123afa43c138e21ee7d2f8f61bb6f82d9a072534d32abb609a1543f54497e5",
      "text": "Lahar dingin bisa datang berhari-hari setelah erupsi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac492ad892bc15890ee17e69e40c12ab54b83dcfd7ecaa0cbe14068a02cf55ca",
      "text": "Alga memberi karang makanan, sehingga tanpa alga karang kelaparan.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7f1d829274cd2ae8753970703dd64954ad7eb133562cdb08bbc58ce3f85246",
      "text": "Yang kedua. Di situ saya bilang, \"Perlu digarisbawahi bahwa karang itu hewan.\"",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac8a044520a07b9c3daa3a6e61c128858a51816e807ed0149335e3061cdcc60b",
      "text": "penyebab",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad81a38c3fc9d021ad6cf4d326b1be147909d3fe4bd49c5a50bf81da700a2783",
      "text": "sasi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad8b397cd69b20b09b1262a691555386fd619dc78653e479d58cd39bd055cb61",
      "text": "Mohamed, ambil bibit itu. Kita menanam di sini sebelum air pasang.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9784ad4c8a50d9e5fbbf50a869ae2aef51b9a0869e76a58d4f2b1b6f52970d",
      "text": "Setelah hujan deras, warga waspada terhadap lahar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae9a2733fe37f03681811b86153448162aa40bbb363299c2c8045343f90d06ba",
      "text": "abrasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "af71aef5ed9d5fe42aea85f1e20c9255669496017beffb88ca7442535780bb37",
      "text": "Jangan lupa peran arus dan nutrisi. Pengunjung sering nggak tahu itu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0d19bafaa758600b3dafc614ac509cc9e33f4bd7cb2849d837917d864df58a6",
      "text": "Nah, itu baru presentasi ilmiah.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2773f9792bbe456d934482437da63f87f626153a987029e562628471754b09c",
      "text": "plankton",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7ef3c2d3c2ea83d427ecf3f7c25cc73a5c47d6c0241e77f3689e2a4d73257a8",
      "text": "Kalau nanti hujan, bagaimana dengan lahar?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8f5046bc57bd0976ab7c1a02b6e078425a243d99e2ee4741f036e1bd9c47852",
      "text": "Presentasimu jelas banget. Kepala dinas minta salinan grafiknya.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb15413de961423a2a2ffde9118eb78ff15743a3d6feec4fa9e1a0ebe627dbe5",
      "text": "perlu digarisbawahi",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb9fa12cf5a31da22e971ca3a01ef6ffab84a042cde853aed33cb07797f4f3c5",
      "text": "tahapan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc4e00bafb364b0a9bf2e1ca0f0f82985b517be36ce7e43a97ffa07f3b16bc9c",
      "text": "Curah hujan minggu ini sangat tinggi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcda9e553516d93bdf252a0753dfcd86d05a8e9d40f46132d370351b190455ec",
      "text": "Sebagian besar. Penyelam bayar tiket buat ikut jagain.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd8db0be0158b971aa7b87b26febee7b9973bd8e95f410ff2df2d540587f1669",
      "text": "pemutihan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdf86d11eee3d0e538c79a9e042306e83e8d5602b02a3932b86825ec308a272a",
      "text": "Terlalu santai. Pakai \"menurun drastis\". Dan sebutkan persentasenya.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "be28222c4cd1dc37936df9afd8371d08af0fba8dcb1953e1c2274ea3af37fe61",
      "text": "pembicara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "be64651c643659449e2f7b77b428e51ea16ccbfb2ac273f3de2e8cc5057fbec4",
      "text": "bakau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0984c0cb633411ac091d5f96904b14608286308c0e9c7c3f7f2323605998b00",
      "text": "Teks eksplanasi menjelaskan bagaimana sebuah fenomena terjadi, tahap demi tahap.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "c261fbe773765bed8369295183597c44479261249545200e82a7e5ab9d56aa49",
      "text": "Tambahkan: warga di lereng waspada tanah longsor.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c34abce5f6207843e9ea6a56239ca3ee2287f08ce07bbd078fad10d4109ead3e",
      "text": "Malam ini kita naik perahu sebentar. Ada sesuatu yang harus kamu lihat.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4418a6498b0bab176d35a17bbb04d262e2f74c138e5c11da3a22e95e1933c5f",
      "text": "hujan meteor",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "c471d6eb29c5ce4996bc61d6f2309b3b5c610427748f18a3e6e347db0a606819",
      "text": "Seismograf mencatat getaran sejak subuh.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c62daa9c211d944a42e4a1e843ee667ce53b83ece778f1f3bed5320c8d54a82e",
      "text": "Tiga lempeng tektonik bertemu di bawah Indonesia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c655c2fa5c5436109cc81ab54b711987fcf39570dc0f3e6188ad77a9ca2ca30d",
      "text": "Iya, lampunya goyang. Penyebabnya apa?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c886173f694291ecca9e7d6c27af7fe485130826a2d090960b2eb95759367878",
      "text": "Setelah curah hujan tinggi di lereng gundul, apa yang paling mungkin terjadi?",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9791edeab087aa043699d2f8116d5dfbfbf155ff5cbe19d5fb42785a3ad82ed",
      "text": "Setelah menurun drastis, jumlah karang hidup kini meningkat tajam.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "caa6fd346b0e0a70796e1a487b54930ecbd4ac1d2d2a5a92ad3bc1ebaaa92d08",
      "text": "Jadi mitigasi di sekolah harus terus dilatih.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccc4e1dd7703a095c7af2e01b8440a0b6d891c630214bd988b60b1d234c6f95b",
      "text": "pesona",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccf8303915d2d8937e7ad5a320c41fab08d4717f06786770f912490faab6857f",
      "text": "Setelah enam bulan tutup sasi, teripang di karang itu bertambah banyak.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdd97c2678a0e5bd5158ff91ffd49916c0eea02c5e7f6826c1065c4fa7771699",
      "text": "memaparkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce3d8b552ec48e7e064dbebbf8004fd2afa9861de02ba11171d7975b050f0965",
      "text": "Segitiga Terumbu Karang meliputi enam negara.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "d085a055debb0fdcc2f7b8e9b0e194a4e30f67f0ee4d32ef29507715614f6228",
      "text": "Bibit bakau ditanam di lumpur saat air laut surut.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "d139f963bdf5efd1ecdf9589b48c3768510e523dd1e15ad0d76cbabc42ef790a",
      "text": "arus",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d19c7de756d8b7604482dfb0dbecc05b600095061e26f2c0ff2d74d5e34ac7d9",
      "text": "Yang saya hormati para peneliti, hadirin yang berbahagia, selamat pagi.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1f3323d39cacd30be586a03ed652291248bd649d65e2bad069b18658a3c0e41",
      "text": "relatif stabil",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d22524191d88f7fc7f617af3353247d4437aa68158f93c4f0d0780ecd9a57a92",
      "text": "Apakah erupsinya besar, Pak?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2a1f0509d4c2310f81380a7a3bf067e07992e607f75e949805208a79ae8f667",
      "text": "lempeng",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3501f605f3ec32aeae46133102483e4b980d525b3e4e09bceca2b2f6fdfc97a",
      "text": "Pembicara kedua menjelaskan penyebab abrasi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "d35b627307a803240480b5fb6068696bea41149cb08d1bff2bbb5a6d6906f8b8",
      "text": "Terima kasih, Sinta. Sekarang saya akan beralih ke bagian solusi.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6f85483123630fc2d4faeebfff69315083363992eec589244c7435050bae332",
      "text": "Perlu digarisbawahi bahwa data ini terbagi per pulau.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "d73545143c157447fa70495ee09c217b436a4fc5b5a1f1f0e0eef714f8a4f54e",
      "text": "Bukan. Coba masukkan tanganmu ke air.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d77733b0adf70628b43e57a4fa3d5108eca4f70ea7cc3fdb8a5d0d5c7f86c7a2",
      "text": "menyelam",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8332f74fbce0599e636637ffb2568aecf30131481121f7a4310996ddf069587",
      "text": "Bakau suka lumpur. Lima tahun lagi, akarnya akan menahan abrasi di pesisir ini.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9aad4d8b116b1f9b3d7d44176bd40c14fe9f2689a042dc4dba077cb722a5570",
      "text": "Di kampung ini, kelompok mama-mama yang mengatur tutup sasi dan buka sasi.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9ec11e96b5e3cfedb618792b4a3db2f6ae3f089e06a17bb32944d44dc3f6b0d",
      "text": "Para ilmuwan berusaha memulihkan terumbu karang yang rusak.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "da367dd90821ffc335490ac59d9aa1151f5011d94752e5fe9c848974bc4c88c5",
      "text": "puting beliung",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "dca9e5934d88dde4e69484b4226d16a12ce7157ad49e70bc6d90494deed0f6ca",
      "text": "Nggak kelihatan, kok. Besok kita ke Arborek, desa kecil di atas pasir putih.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcfdba5c8105c03361d5f0b47846759e69357740bff85a3fe53186dc34f27baa",
      "text": "Oke. Saya tutup dengan pesan supaya mereka nggak nyentuh karang.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "df2e76bb028d9236646aacb41d30f43ddb2c8249dcce5e8560ed8fdd1ad42f9b",
      "text": "siklon",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfdfa7901c612aa983d6e3e0e600cec29dc1a75708a2349393d0f6de605b4efa",
      "text": "Pantas pesona gugusan pulau ini terkenal di seluruh dunia.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1af2dbd138bd62aca294b6f12d43361424722216d51c2ba1225e41e75362553",
      "text": "subduksi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e24dd576dff7c8de5d912e923b1bb9f45ae96355391199ef0bd9cddd17a8f75c",
      "text": "Tanpa hutan bakau, abrasi bisa menelan rumah di pesisir.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e694c74e5a5d5416eab85c5c1eec35833b43d34a55dda4271d4b57ce156a16b3",
      "text": "menurun drastis",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6f3aebe23d284d8eae0a3948dba7940c4b18bb0931fc11cab0fc6ccc367f205",
      "text": "gugusan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7a8b4cd41ba626438587a78538953252f41445189a625c52a623a7e1a7458c3",
      "text": "Makasih. Saya gugup waktu beralih ke bagian pemutihan.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec1951c51c86bda62b62f8d13a9e6b63361f247396bf7fd38c0b0e77008d3747",
      "text": "Bener. Hiu berjalan itu endemik. Dia jalan pake siripnya di air dangkal.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "edd7659941e3d23caf9e5fb6c6ec14aad57ae95572456433754f908ed4fcccf8",
      "text": "Besok pagi kita menyelam di Manta Sandy. Di sana pari manta datang untuk dibersihkan ikan kecil.",
      "voice": "id_ardi",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee40dd15bf4935f6b8721e8859fbfee947c2829728c4e7316a434a59d10c13dd",
      "text": "Teks eksplanasi yang baik menyusun tahapan secara berurutan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "efb9a64df064b05f52a49dbd628263d9b8edd511034ccf8fd6e4a243e690d921",
      "text": "Bulan depan. Hasil lautnya akan dibagi untuk seluruh kampung dan gereja.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "f13891f7caa24f0f8bc519ae18cc0270cd72586e64bf3dc89a673cb1feb5a30a",
      "text": "banjir bandang",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2955bdf862e645510724cac50472c6790a88d9df742e2fc7a1cdc8b668708fe",
      "text": "Mitigasi lebih murah daripada membangun kembali.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f547a0f0ef738e00e5cf6e84b56b27a163883a0510e0e875182233b072a10aaa",
      "text": "Alat apa yang dipakai BMKG untuk mencatat gempa?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8dd2a65bd6f71c2cbd9f17142398b71b9a9a82b2d8abfa0bc42eed8454c8f58",
      "text": "Di atas ada rasi bintang, di bawah ada laut yang biru. Luar biasa.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "faf05e274255babb47f21fbc609498fb98e0bb154a04b67fc395a6dad0c324ed",
      "text": "rasi bintang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe40fb0a238ff64233443fe44f50e4b6e793c0ee853727f4af5abd55b798fb59",
      "text": "Arus kuat itu bahaya, tapi juga bawa makanan buat karang, kan?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "fee2125604957f450133d62cbf55ab38ea255e88f3f9a2316ddb950be8d68711",
      "text": "keanekaragaman hayati",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff0034a736d3b2bed270372cb0f363772a19e4e86809ffc2851862dd773ce29a",
      "text": "Bisakah karang itu memulihkan diri?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
