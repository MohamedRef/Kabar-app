  "version": 6,
  "content_hash": "c0a6aca8ef82f9b25b972ac121aa1e8de769ca9f96c228c030f24addad8464e9",
  "lessons": [
    {
      "id": "bipa4.u03.l01",
      "sha256": "845f88ac89a7762daf88ed52f12c1f0c7287aa9bf55c2f497fff94682f640fac"
    },
    {
      "id": "bipa4.u03.l02",
      "sha256": "2363cf0d37a42fa52efdf1c084d79ae802e3aa3c1521fb66c1e235bac90cb8e5"
    },
    {
      "id": "bipa4.u03.l03",
      "sha256": "d373852147133e2753b0a2a5188e9e128042273c238e4d3e3c8954fab9a9571c"
    },
    {
      "id": "bipa4.u03.l04",
      "sha256": "c22c1bf23ab0675e84030893686254a109971ae74e25d2e1b2ac5fb03e1dc768"
    },
    {
      "id": "bipa4.u03.l05",
      "sha256": "8fdddd73f49a1e2d582ed21e418095c2d4b5ac144f8f1b9d0fde0eecff0a4d99"
    },
    {
      "id": "bipa4.u03.l06",
      "sha256": "0cf22ab8ef9e83f24fb052e4176ad65d1ef4ed9cc8309c14d6136785f8546c50"
    },
    {
      "id": "bipa4.u03.l07",
      "sha256": "075b4e5219540bafadfd277e556cef9d401d1979a7c964d7826b8320e49f4c3b"
    },
    {
      "id": "bipa4.u03.l08",
      "sha256": "5236ed0838f77c6e4e30c699a4bc07722f4c4c802629ab552bbef43d66a20827"
    },
    {
      "id": "bipa4.u03.l09",
      "sha256": "d0bea9309448060c2f3da731b643010b03bc97efe579bd8b6c4ddf274945c5ca"
    },
    {
      "id": "bipa4.u03.l10",
      "sha256": "991b7499dfc515b8c2c934adde2b361111d1b24bb3e9c4bec3424fd4bb9bce75"
    },
    {
      "id": "bipa4.u03.l11",
      "sha256": "c929c95913a9b76dc5dcac95a5cb5f07fcd9117d1ec2a4b29979fa137345bc05"
    }
  ],
  "audio": [
    {
      "key": "02f126c78baf938909ace11ac63f21644d3801ca0bc93baa8d8a4fd5a5e545e3",
      "text": "Di ujung lorong ada kuburan tua.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "03a547e3445ee83087caeee24697ad32d768068f61f90d9be7be5f10f90551cd",
      "text": "Luar biasa! Rumah tongkonan megah sekali, atapnya melengkung bagaikan perahu.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "0442ff0dd98dd91902b93aa23411fdeba367a0c6a7918d75d10832dd73ac868c",
      "text": "menggali",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "046d72f8ac68b23edd1d4a9b327ec21a4076f190c0194d854959c46c549a43fd",
      "text": "peradaban",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "04e6797fe68745d791247479ac1f1f5b2d892193932d33cbc49f8e2f69fb1875",
      "text": "Tapi dermaga Paotere masih ramai seperti dulu.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "06100788effe271bc1e9e6105ef76d88b88580fe63f0cc42f574ee7c3106b050",
      "text": "Ya! Saya juga mau melihat atap yang melengkung seperti perahu itu.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "0711a641352174ab7af6c6be539586a14eed34a7f8d3810814121b32e07aa021",
      "text": "Para ahli menggali tanah di dekat benteng.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d9ffe6bf33ceb92e6d054adc0158234d265b09d10354174dad96e787fb25ecf",
      "text": "arsip",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e057bb82502eb01075b58754cc22ac6f192df5e4afcd12dcbdb1bbb2ada6e4a",
      "text": "Benteng tertua ini didirikan oleh seorang sultan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "120f22dfc8388b22d471339ab4740aa0e1b66aa6a2c5d0ecd56bd00c0f7957a3",
      "text": "Tolong ambilkan saya kain tenun itu.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "123b4276758262cfce021ca2332b53a42bf07e26525f76dba391f7fa8163ba10",
      "text": "makam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "15cda3645f8b77627da1b7b39009109de169a904dfd942dc1f22fc7823b9bf1e",
      "text": "Peradaban Mesir dan Romawi bertemu di Aleksandria.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "15d08d4f8dcf62c26a77c7166781bba5c986647298ba1bfc8b06156965b2e5bd",
      "text": "permulaan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "166663f8a2fc66fbbbfeede10a887fbaf022d75f58a2b772cbdaeeb2954b6c80",
      "text": "membuatkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "177c069f62398975d4c68812f456a1dbc68334352d2004e7ad5ec52a21ceb47d",
      "text": "Pemandu menceritakan sejarah setiap koleksi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "18b76835224c3114024c211c40a98f8c9fb191a35359a872ea0cbb96d2749765",
      "text": "membicarakan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1985a231f7295c7440639dafb8938387bced7fa614033c5b909b59ba7b3cf0e4",
      "text": "Ada yang bilang leluhur orang Toraja datang dengan perahu.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ac95ca64b5e69ea76a64f06be263575421fef3a73c90a3720b7bbe984dcf415",
      "text": "Di dalamnya gelap seperti malam.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e00cdc19f5bdcfaca2845888f7fe4b2a0138a7284e106b0dd2c7725b9bf2df1",
      "text": "Hutan ini ___ oleh pemerintah. Orang tidak boleh menebang pohon.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e90fbb99f1b60aceaba11856d01b349b48ddd728c5add38d7fe67b11b4aacd3",
      "text": "Atapnya melengkung bagaikan perahu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fe11ac27542f081ecad377ee1ce577085fb5e66df6f514438f49fc8cdea14f6",
      "text": "Dan makamnya ada di dalam gua?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "20a164bfbb8782b0b47c4cf253a6fdf6bdb68a0a7585f30ca9e21ff373e1020a",
      "text": "Bagus untuk oleh-oleh ibumu di Kairo.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2145cf95f409a2683636631065c86748cbd87fc86bcf71b73c27547f25b7a0fc",
      "text": "Siapa yang mendirikannya?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "21c263d1bc668cc07a2b2ffda44ecff2939681b31cd27e20db39941ced62f776",
      "text": "Atap rumah tongkonan di sana melengkung seperti perahu, dan di depan rumah ada banyak tanduk kerbau.",
      "voice": "id_gadis",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "21f4960a8a416b99cc8f7bd4f6508bfc5d9e2f546cd4d0f7a0d549098b065d76",
      "text": "Pada ___ cerita, tokohnya masih kecil.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "22d90bbe9319a343b4673364e346786fa4609c92cacce202816e759c981a5edb",
      "text": "Romawi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2308f4b81115d1531f6cf0b9c6f2afb5ba1f27f71bae942fdd7239fc06b46ded",
      "text": "dekade",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "23961c067aa901fc5ef33c8425386ddf25655c0d2ad399622b79120f33d52f90",
      "text": "Betul, kita bisa naik ojek ke sana.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "23a590005c5d3b36c42d116cfaf13acf9f23e734b03b5db87ac969b00b2772f4",
      "text": "Saya sudah seribu kali bilang, hati-hati di tebing!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "23e18765da1d7fb86f38cc7a72ee332563f682f29f157b0942e67312f124c5f2",
      "text": "Pemandu menceritakan sejarah tongkonan kepada kami.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "255e195ab542b86a5227a133952c72277ed3367a3097afc92ca0d4ab39b834b5",
      "text": "terowongan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "257006eaddee55f739b17ccf4de1626caa212dfc0542a45682c7a768448f8f32",
      "text": "seperti",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "26d64c3687764fd34161cb8f320751fff0a2b64dd61074fe6718748ea845405a",
      "text": "Betul. Tapi dua-duanya kota pelabuhan. Ada benteng Romawi di Kairo, ada benteng Gowa di sini.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "298e5939efb7cfb33459ae51638167436643123f9b4e7ff726dd0981d4722efa",
      "text": "membelikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a16010341fef26a5def008ef9963c6cedc058942ac2b98acf248dcfcd442c55",
      "text": "Kenapa? Peradaban Mesir jauh lebih tua.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e703e63fe96bc8626fb9fe943e3637bd87e4316ee4d56810b39c12a0b186db0",
      "text": "tertua",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "312bd0457fd02d98524fe12bbb2dea4120e9f61661026e5c8dba76a38558037d",
      "text": "Penguasa itu berkuasa selama dua puluh tahun.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "3296440fd9177a5ece820c4788ae3763ae40c9cd946fc5189a9a3b2248e5ac14",
      "text": "Indah sekali! Pak, tolong ambilkan saya kain tenun itu. Saya mau membelikan ibu saya oleh-oleh.",
      "voice": "id_ardi",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "348abc783e9fe75218827766749c64536697ff97988e5ed2427091b41775916f",
      "text": "Tau-tau adalah patung kayu seperti manusia.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "35357a80461059136e3217b7445adb4bb057b137355adabd18a44b9edb975d0d",
      "text": "gua",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "362ad09f1fb626c194e8d5ca04deee0ca6ddb5e6043d4d364b3db5640db14b47",
      "text": "Pemandu itu menceritakan sejarah rumah tongkonan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "36908066516040f238e8df90166c95d98aa9725570625aed5f4fb4b6429441d9",
      "text": "Betul. Sayang, Benteng Somba Opu dihancurkan pada pertengahan tahun 1600-an.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "38665560f5f691e1f3c7fbf8b8b65de1ff7e7e332d2a20dad5d9ed97c3dea374",
      "text": "didirikan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "38feddccdcca5799e265bd91aa52602382d23a31b9bc395e1cb37604fbc116e8",
      "text": "Ha-ha! Lihat ke atas. Itu patung tau-tau, wajah leluhur yang sudah meninggal.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b7d1703a615661bf5dad48e69d07ee5b248ff41b415ba3704fcf9aeb814f6c",
      "text": "pameran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cec7cc807ca6e1c43e9956d74d0941bfa9a1851f537da7efa9c9eae09e7d61c",
      "text": "Dari sini, desa ini terlihat bagaikan lukisan.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ef0c053545ef972421aeb2b358dfbacaa51454ac93a1867a26d32d0c542e1e3",
      "text": "dilindungi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4127515eb2bfe6d0cc1a2feb97c324e060b25f82977e27ea940521035d70dc20",
      "text": "Jumlah tamu di upacara itu tak terhitung.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "43080dc817814353daeef09c1ff52861138ace0e5aeb47389cb0aef3e427c08b",
      "text": "Kapal pinisi masih bersandar di dermaga Paotere.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "43a7021b5b1366160639c1668bbaeedca67c59658bcb784a71fa86c77c9d503d",
      "text": "benteng",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "446801c0c3878e4d94f4252c6bcf12e022cb43cd7ce6e54ad26ef6e5ae46ada6",
      "text": "Benteng ini dilindungi karena keindahan dan sejarahnya.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4897a64344aa8daff45e11c08b3d817cf9b82613ffa2ddf03b07c65dd4328c4b",
      "text": "Atap rumah tongkonan melengkung seperti perahu.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "499d3dab823c79ecfbaa2d0bb2086db3dd1128adc4281c1d18e15171387cd63e",
      "text": "kuburan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a91834239142c64753795a5127f38f54e41ebf2ad23d1656436109b83c467bd",
      "text": "Koleksi museum ini indah bagaikan harta karun.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c6cf3bedcde05befaecdb7ab74c50fc00e33471af0762cba412ca268c58235a",
      "text": "Atap rumah tongkonan di sana melengkung seperti perahu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cf75a67065d00417e16821e6bb19af52f1fc3206697fe69e06e14356fed8daf",
      "text": "terlihat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ea3b97e0979b3b978a8cc5b6d02c12a428dc6add789a928e9d1de219674f7bb",
      "text": "Makam leluhur terletak di tebing batu.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f1871b2121484e9f0d2344cbb1be50520eec6e1ab1615d5ae69ffee95b81d92",
      "text": "Mas Rizal membelikan saya kopi Toraja.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ba2c67d25a766a01191bb7492e63b8961cbc4f6a6961f9d930fb3e9af8c01d",
      "text": "bagaikan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "541f9e6c15ea9abb5cf94757f0621df177b6f96083a46f4283bc275646c87948",
      "text": "Wah! Jangan lupa membelikan saya kopi Toraja, ya!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "573853119eb185d79f0bb448c75eedccc8c9e2f52412e34f77f140cf725404d6",
      "text": "Tentu. Rumah ini warisan leluhur kami, dibangun ratusan tahun yang lalu.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "57f9cf1be8ee0f7740c63bd00017f444bfe008ad1d3a89755d7beed419af75c0",
      "text": "lorong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dbc0b8132034810d01098ff52f7d5233218aaf65b19236af192ad34623a64fb",
      "text": "Tolong sampaikan salam saya kepada Pak Yohanis.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "63fb90c8b00b8f6c87c36cf2c17a9420620aa4aa4c2558c1451f57b937295d90",
      "text": "Selamat datang! Koleksi museum kami sangat kuno.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "640049bfe8d769c5e51f5234dd87aa615e1f66127764978458f611e12aa30431",
      "text": "Benteng ini salah satu yang tertua di Sulawesi.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "660be4a3e805f1910259a48df8ab0e9df4d47ba09191eae05b83fa83e918caf2",
      "text": "atap",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "66f694345b10a025834fc9eb3bbd5bc834c6219376f2eefdf22d4b68bb9400f8",
      "text": "Benteng ini dilindungi oleh pemerintah.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c14f8aa57f414792bed568547fe96939311f55f804510f57db22677264cfc3e",
      "text": "Tentu. Surat-surat lama juga disimpan di arsip museum.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d7228d8e68d99f83a489f82ac1ceb90c46521aa53d3d5696e1f166962d42597",
      "text": "dibakar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7041fe63afcda3932d5b38c72fd629f3a4b6920cf5708367747f01f3d5cdfbdd",
      "text": "Dulu Gowa dipimpin oleh penguasa yang berani.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "72afa438b34dcbbf7f2682b63020be5cf8b140fafb2491ea2b4e4f9124f29acb",
      "text": "Dari jauh, tongkonan terlihat seperti perahu.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "74154aba5ace59a6a66a21dedc9ca6e73ef58ba6a7e64450e5dfe1c3c7cda0da",
      "text": "Di museum ini dipamerkan kain tenun kuno dari Toraja.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "756df4b83ecba13e86b4cf8f07f958e5cffb1287315eeb32969e679fcc7a29ec",
      "text": "Para pengrajin bisa membuatkan Anda ukiran kayu kecil sebagai oleh-oleh.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "770d06a6aa82a46de099d5ae4fe6bf1709d63334c7e412c0311e8cd7bedac676",
      "text": "Wah, boleh! Berapa lama, Pak?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "772a735ff59b803dc3c68480142fd6ecb91cd81a284c6630af98ce921dba672d",
      "text": "Museum ini menyimpan koleksi kain kuno.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a836518fb5b068116b96a86df1e61212685ccf5026002777b908be9f93dc8d6",
      "text": "adat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a8c12d6128b1c7122f671d0a9a21800a376fe5f2a56c5a0b8057d89ffe49073",
      "text": "Ada pameran foto Makassar tempo dulu minggu ini.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ad2142b98727876858e2b7226b8f5b94602eba729da2b916ad5c6f9db8ca1a0",
      "text": "Kain yang dipamerkan di sana indah sekali, warnanya seperti matahari terbenam.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c72524e7196de86fbf20b57fe530c719018a91b7a8675d01e55beb4770cab38",
      "text": "kuno",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7da89bf3437971ee414d0e4633808e3370e90abc4653d576c70ad5d4af46b79f",
      "text": "berkuasa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fc4a79ee68719a0a4dc0f8223a013d2cfcaae2f64827f6dda1546b2660b4bc7",
      "text": "ukiran",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "804fa10125029c256b242eab02d54bf51984b7391ac2634f0ed30c2997827e51",
      "text": "Ke'te' Kesu' terletak tidak jauh dari Rantepao. Desa adat ini adalah warisan leluhur orang Toraja.",
      "voice": "id_gadis",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "80eedc64eb8ced67d75e0fb3ce6cce03b3937630f438e4becc6275171499778d",
      "text": "Tolong ___ saya kain tenun itu.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "81e22bafac644f466b13e0d9e2aa4d3fa0e82747998d124e5a3391555705a346",
      "text": "Raja Gowa, pada tahun 1545. Ini salah satu benteng tertua di Sulawesi.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "88d3ef8dda9fd80ba9982e07637fcad9a9b968bdbc0449991bf8a952deb7a20a",
      "text": "pertengahan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c55fb90623b36b265cf68655b2d99bbdf5bb31fe2e0a23168a504d7efc72309",
      "text": "Mas, suara pemandu tadi tidak terlalu jelas. Tau-tau itu apa?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f8da54bf09ddc444bb31a240f1f590e0cdd96b5480f4f99cadf4f5971ecffb4",
      "text": "Pameran barang-barang yang digali para ahli di Sulawesi Selatan.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "90a3ff2710ac702a99457728bbc2a90e1456c8b34de6b99f8c129a43072e3fd7",
      "text": "sultan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "91acf7257e961122d9a663358120a0f14d9a41dfb75a39326e3e3838cdfebc8c",
      "text": "Pak Yohanis menyampaikan pesan leluhur, yaitu menjaga warisan ini.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "925c726eb8f6d98defde2be26b0a75a1709766ea3fd579b7fde96677e3be0877",
      "text": "Harga kerbau belang itu selangit!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "9558d75581ed3381c0167d05c345b1283e93127e5250d4cb84af6db4fc7de58c",
      "text": "tanduk",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "95bfc6790e1f3739c761503ed3c52c331321eff35138ffa2f1cb8b67766654f7",
      "text": "Dari jauh, desa itu terlihat bagaikan lukisan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "96ea2c85c2a7e1417bcc873429d1a56c8e7c1bb5fdca1487a547bef791b8b601",
      "text": "Ada pameran apa sekarang?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "98e1b1487be61d09c50fcd8d85ea20652162f237b9f6b24d1408ad1fa50867f6",
      "text": "Selamat datang di Londa. Di tebing batu ini ada gua, tempat makam para leluhur Toraja.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c2f8965b6186ab72d5e0127de9db36feb92a9fca1db1c3023f40f79564e000",
      "text": "warisan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "99e4d1562b7c58671864805cd804f180f126b9ef79f2322114eaeeb829f4fa13",
      "text": "Di tebing batu ini ada gua, tempat makam para leluhur Toraja.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a35437c8084ea8cefb3d1fac2e4ebee30e46384a7351ccca1c7f5a4da88b2e6",
      "text": "Terima kasih, Pak. Saya akan menceritakan ini kepada keluarga saya di Mesir.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c8643160f41c022e7276d53a39f360e4afbd7833b567717db0c661911c8686e",
      "text": "Mohamed, bagaimana Toraja? Ceritakan, dong!",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f9f3f3fdc625d3baee04e332fe133792024f097d54689c39a4dc8c591c0460b",
      "text": "Kamu sudah ke Londa?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "a088e642feebf9397a8a58a78fbfff1bb46dfab8e0e8713666bd5b37ed1cc139",
      "text": "Di depan tongkonan ada banyak tanduk kerbau.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0e8809d6e1a1a00a54161a4a721f47e35782fec8b81043f944f824f4cef508f",
      "text": "Museum itu megah bagaikan istana raja.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a19623046a6e76aa526da4ed3e77df906a0deaf6564408b0c9e14759b6e8002b",
      "text": "Mas, tebing ini tinggi sekali! Keringat saya sebesar biji jagung.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b5bbac8222d9b115877a123f5ef1d5d66ae899b16ce20f2dc156e88fde77d0",
      "text": "Seperti malam, kata pemandu. Saya masuk pelan-pelan saja.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3255fc3daf404a5264fe8e45fb90dc04f413e6e3d9bc923b81144ba6710bd3e",
      "text": "Raja muda itu naik ___ pada umur dua puluh tahun.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3bfae94177e3b954e8f5432fe250940cb56568c02c6463e541bfb3cec5bfca9",
      "text": "Tamu di upacara itu tak terhitung, dan harga kerbaunya selangit!",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7e53eb4b3d564b100980ef0fc3f2290f2527cd52c482efd47a217ee25d52486",
      "text": "pengrajin",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a924ba54426a65a4fe65f83a16422c47a6feaf519c87d9afb0296a8e53cf7cc5",
      "text": "Betul. Untuk upacara Rambu Solo', keluarga membeli kerbau yang harganya selangit.",
      "voice": "id_ardi",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa32ae734be5e86a5ceb113aeb49e97c3182f762544c2b645508e9f899fa7584",
      "text": "Wah! Lalu tanduk-tanduk di depan rumah itu apa?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa76d6229e0c0123ab9a39e8f14ea28ae7057b5af1894d7455fafff81abbf7a3",
      "text": "Di dalam benteng ini ada Museum La Galigo. Ayo masuk lewat lorong ini.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab761f6161223c3e03f038d35b1f8e6378da7aacee34c4668966f6c3fa250205",
      "text": "Kedua rumah itu sama persis, ___.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "b12bf9f9a110e7170cda47e66802b9f60bd1ffa9d6845168cc5cf5bedc917dcd",
      "text": "Benteng Babilonia di Kairo dibangun pada zaman Romawi.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1ca9e010d6037bc76c119928bbf54fcb0f899fe4d99a0f11dccdc45be540936",
      "text": "Mesir punya peradaban yang sangat tua.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4253bb5fc1ab3387883e09e94bb74b465b36e4a6338acc454ac3cac4cc722f1",
      "text": "Satu jam saja. Sambil menunggu, Mas Rizal bisa membelikan Anda kopi Toraja.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "b49eed6941141e986b8a7424df4ac55b9747fe1a9c27b93efca437c83ba1b154",
      "text": "tahta",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b77b023a10b90307b08f634acb15ba44d042ab60f2c0be13794dde3d208c0310",
      "text": "tak terhitung",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb13871f04841746d82aad70e7e702c4cb5379acfc81898bc9ba26fb75ed9fac",
      "text": "Kain itu berumur ratusan tahun, warisan para bangsawan Toraja.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd25354907abd577b7c31a2f8a3adaf9cd9e7d9858ee95c737dbe9505b63ff5",
      "text": "Pemandu itu menceritakan sejarah leluhur orang Toraja.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdad66f9705ff1f6789baa298a6ce59a8a472e71b48fbde4ce5f59c503400408",
      "text": "Ya, di gua di tebing batu itu. Gelap sekali di dalam.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdefc59b29d911a35f3cce9f63f90321ddef5fcbf894e49c8cae8033e6043cb7",
      "text": "Jadi makam mereka ada di dalam tebing?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "be00507b5d151cc781103e741140064c7dcd15d87120d5375e1d66ed912f18b9",
      "text": "menceritakan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "bed0c5c2a9f505f8efb03d5d82df490cdd541ba3b62c44c177d72c67eb1bf37b",
      "text": "Di Ke'te' Kesu' ini banyak pengrajin ukiran.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c100a99a74324fc2f3ff909c96697e5b390dc47f6226a31020c6d931f9197e9f",
      "text": "Pengrajin itu membuatkan kami ukiran kecil.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c495ff957c453deed67d7c7a98c23dc3a1e5b892b670d8ebc59a1f81b5f577d2",
      "text": "Mas, tolong ambilkan saya ukiran kecil itu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8402fff0713673328483d5254268ae59718b54a27afe075f8642543ba9a3cf4",
      "text": "Mas, menurut brosur ini, Ke'te' Kesu' tidak jauh dari Rantepao.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9444bdbb902e3022cd0ea1c6f62885da28d91cfab4d32a90376c71a247727ef",
      "text": "mengambilkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc3c6bff6c04fea29c1854dd2d3972c245951ee5426a2b7cd0a7e0c6d8ec4be2",
      "text": "Tau-tau dibuat mirip manusia yang sudah meninggal.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccbff5183f2737080abf46c800b05b542b4d22f75cb001494a2a98843e350d67",
      "text": "Benteng ini didirikan oleh raja Gowa pada tahun 1545.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd064669951a54bc5b17d359ee012c86a4d4e5e79ff816c12c0fd0c8c58011fb",
      "text": "Mohamed, ini Fort Rotterdam. Dulu namanya Benteng Ujung Pandang.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd2b3316be108e6df89a6dd96d06d2bb7e73462d25b104dee5ef3f9719549c98",
      "text": "melengkung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd6f08a2d4bb4b15fd068b86470cf76c5f83f9be3c672925551a94e6111701c7",
      "text": "Tongkonan adalah warisan leluhur orang Toraja.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceeb3defaf1fca39fa66582e1bc2f0df01145ac901e1d6c10cbcfcab368fb208",
      "text": "dihancurkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d06e244712061ea9c934728b4c9e02e2447707569a930352718c6577a5fc516f",
      "text": "Itu tanduk kerbau. Makin banyak tanduknya, makin tinggi status keluarganya.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0ad9059a3df29d86e1672ba58ce8b6c000f22fc4692acb2a2a5cf1b0dfe138d",
      "text": "Lorong museum ini panjang dan sempit.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "d19782e9f1f9e1c87405dfe7c9b31570c5a15ef34db550a37536caaeeceab38a",
      "text": "Kedua tongkonan itu seperti pinang dibelah dua.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5bbe3982f3c535a3f8d16b7939c5441585ee24d75c173dc5ffb55f9e58cdfac",
      "text": "Di sini keluarga besar berkumpul dan membicarakan adat.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d854016371a124ec30ad0277038839ddc642e0a0952a9fb459f02376fa604485",
      "text": "Keluarga besar berkumpul dan membicarakan adat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9454b293cdcfb6d348e6af1ca183f35220a67a6ff448e1e61899eda0968a2c1",
      "text": "Desa di lembah itu terlihat bagaikan lukisan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "da1cefd3c7374f867145fa98344795d0093f72de94322b6ea91829137753010b",
      "text": "Patung-patung kayu ini disebut tau-tau.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc39e0a0416959dcb932cbd85a3e94a0ad454bf69b58f303057ec9ecef84d735",
      "text": "Masuklah ke gua ini pelan-pelan. Di dalamnya gelap seperti malam.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcbf1d13bf16ffc28ace9af7d9970fb706713588a06121c27254e0852fb39993",
      "text": "Patung kayu. Wajahnya seperti wajah leluhur yang sudah meninggal.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "df34fc80c3b35b31692538eee5a22a5c7b6a06fa5aceca6a70e589cdc32521fd",
      "text": "selangit",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd1e39c8569691d2bf1f3df104f0998c941182252de0f6de3b8192a92905145",
      "text": "dipimpin",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e10b27de4a38eac6256c03f804fe6079d7a9f7e1f40ef22d0c34fb53d7480759",
      "text": "Patung-patung kayu ini disebut tau-tau. Wajahnya dibuat seperti wajah orang yang sudah meninggal.",
      "voice": "id_gadis",
      "chars": 97,
      "mime": "audio/mpeg"
    },
    {
      "key": "e273a4dc3efb11d9bc05e244edf6108337b33d5155a5f6e8d9aa733f7c6d7e22",
      "text": "tebing",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2881ff669c2c6d931ee94dcac147b37ad115120ef8e2b57055518ecd5d6a110",
      "text": "kerbau",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e32b0dba292d085f863c27cf111de5a3dcedca2c5ae50ef6a6ddadb2cb6da022",
      "text": "dermaga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3f76d7228b7f6bf164bba8114bb917d3ab14103f3c1f8c17d16a26afe3bb915",
      "text": "Mas, sejarah Makassar mengingatkan saya pada Mesir.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e61ffec7086ea5fc48456690505586590234dba7d9bc9ebfca7018fd659abbf8",
      "text": "Sampaikan salam kami untuk mereka!",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e808b1f62b549a32243fb0af00bb1bdaeca673fa808f051188469987fe510312",
      "text": "Tongkonan adalah warisan leluhur yang megah. Atapnya melengkung bagaikan perahu.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea7145d08ad9e8014b96d29765f107f6d93c01e7610fb63a858f0dafae9464c6",
      "text": "Tongkonan adalah ___ leluhur yang harus dijaga.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea7b7a26f361201653de4837dc9ec3341bae9dff15ce6daea976e0af096f240d",
      "text": "dipamerkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed72562f93c34b157f7f4ecef74d52fd71c2ca2ec525a63cf925a0fe43a46b56",
      "text": "penguasa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ede8d7be092e886eda17ed1e692351993d60598b8f471befde3b6e78c5ce92e3",
      "text": "Boleh Kakak menceritakan sejarahnya?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee97b152ec7a3fc495e4afdb581a1c2bc4851cd30803de6a6694a42986b4b32c",
      "text": "Di Londa, makam leluhur terletak di tebing batu.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef2bf0737256a49eb32af3ef55aedc8d75150ed030915fcda5ea4d203966ec51",
      "text": "Benteng Somba Opu dihancurkan pada tahun 1669.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f096470af883802161c71d5a9e188667df12e76249ff205d852ace9ae06a9979",
      "text": "manusia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1560eb6a9a59aad287551bd99b3fe981a1e8ad9e8f151291dddae22daee1b44",
      "text": "Sultan Hasanuddin naik tahta pada tahun 1653.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2021ae5edff38f47acb5cd7516ee25d2a856af8c9c6c0fb8aad55f056cd92f7",
      "text": "koleksi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2851ce8fb01c8915db16e3f3de8aed9ffb6a0b3171db79af74d65a970568404",
      "text": "Di sana ada pengrajin yang bisa membuatkan ukiran kecil.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4ae74f594d5805cc9a30fa3528c49373ba0dcba66b70b8c6aa8f0d9ae6f4676",
      "text": "Sultan Hasanuddin juga berkuasa di sini?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4e3d75db3bc4d565098ca0abfca7b6c5d96cd924c3ad4367ec98b878710c29e",
      "text": "megah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f55a0e365a7d296bd70d1402ba27cda40157621142d03bc8bfe9afe000272ddc",
      "text": "keindahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f590fb6d737e68fec8823858cfaced0276a14ef3c7d449a15e5eedded2dc72f5",
      "text": "leluhur",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5cf80563dd660d1b68d912fb19269cdb011b642568345491c6205ad805c8a2f",
      "text": "Ya. Dia naik tahta pada tahun 1653 dan memimpin Gowa melawan Belanda.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5fa0e2d40bc7c17a5a9c0bdfc1d2d5fccc5e4f613be83b891c3dab84870055f",
      "text": "Dalam satu dekade, dermaga ini dibangun lagi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "f68a964c4c311cbcd33fbadea61b3c122ce0d3f144599f635c7a2cc59a0a8985",
      "text": "Mas, kenapa atap tongkonan melengkung seperti perahu?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6b0116f987020506dd8d7e06bef5168bf639f2bd1b5d660c21e6cf4c7ebd9f2",
      "text": "Tentu. Mari, saya tunjukkan juga ukiran yang paling megah.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "f831d06f13c089951fb8e3b044e7050dcf4f5348e7173821efacc1031d07414a",
      "text": "Barang-barang itu dilindungi, ya?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f95f384e1e818dfed8c06b13af7b491985cfe854c0feb3c9f5246e0df5552cbc",
      "text": "Mau saya buatkan ukiran dengan nama ibu Anda?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbc56d427c80c2723210206609ebf98fddc91c4849321c9d7232edc0f574f4d5",
      "text": "Pak, bisa Bapak menceritakan sejarah tongkonan ini?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd8740d3c81abef304cb047983b874151e67349ebb41ae23a7e49f7e0bf960e2",
      "text": "Pantas tamunya tak terhitung!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe888910038d39e3f3bf19eb7c49f3bcd221444b87b7f249c57287024d8b9cae",
      "text": "Sudah. Makam leluhur ada di tebing batu, dan patung tau-tau seperti menjaga mereka.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    }
  ],
