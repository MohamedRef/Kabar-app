{
  "format": 1,
  "id": "id/bipa3.u03",
  "language": "id",
  "unit": "bipa3.u03",
  "version": 5,
  "content_hash": "e2d85d40f96ed52643862443ae33d619322ea5f6811d2e09213a0893d4eff5df",
  "lessons": [
    {
      "id": "bipa3.u03.l01",
      "sha256": "9835de37d3f9cd1a78ca7fed00351ddd45f0874a576a0843d536ca6d236264eb"
    },
    {
      "id": "bipa3.u03.l02",
      "sha256": "1dbb4b2b1206ce4a201b2c59a42b7d55665975376e037929cd1bd116d93fbd95"
    },
    {
      "id": "bipa3.u03.l03",
      "sha256": "519a7befa497d14df79ac485ef3164a2e566a103f80ec30b3040df7204b30987"
    },
    {
      "id": "bipa3.u03.l04",
      "sha256": "fb363e8c582c1181839be8ca7a195ff0bd2f017ff5fb8030002403d9f60a69e4"
    },
    {
      "id": "bipa3.u03.l05",
      "sha256": "67c04f1a32c042548023ca570a30d0e12d9b05a7bd9aacd1d2eec9a25f6f0508"
    },
    {
      "id": "bipa3.u03.l06",
      "sha256": "cc58bd676ce49d1ecc7f6c4d454a5dbe42ecbfc10002fc05dc95aa38a6bde39f"
    },
    {
      "id": "bipa3.u03.l07",
      "sha256": "bde08e4fd27f70f8d64e324a2b1cb76f0c41260fcab0a756e5cb355d20a5e78a"
    }
  ],
  "audio": [
    {
      "key": "02645efacaf17453775c1f48a8d24858f803c8f62ea77ba1638bb524979a94cc",
      "text": "Baiklah, saya ikut. Tapi saya duduk di belakang, ya!",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "0952200eec5dab34ee7157a252625ec4080298fc8832b768eb93249d3ddd7dc8",
      "text": "Menarik! Tokoh utamanya seorang nelayan muda di Gili.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a36415fce4a0704ce4611f99b0db986c4acdda4d6c3214d7585e888e3f361bc",
      "text": "ulasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cad7cb06bed50ea41952d4e3cc19815bc2a35c495b71b54dfd8fa540bced3d4",
      "text": "Bagus. Siapa sutradaranya?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0da93bcc8be8e8b404bb05eebf62b63d651de5f427f7efe453646b9b64e0462b",
      "text": "Pada akhirnya, dia kembali ke rumah ayahnya.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f43890ed37b105964dc0fa652779bfa4ace698735d23ebeafaa6c321f5d93b2",
      "text": "tokoh utama",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fa5aeb1c18e26790ff75f1d316ff601db29342809bbc002632f6fce9f87a393",
      "text": "Tokoh utama belajar menghormati ayahnya.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1473a7aadc44105d1ce94926ed6f38e7dd97d15fb108806c035f13b3c7994910",
      "text": "Bukan, film keluarga. Ceritanya mengharukan dan latarnya indah.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "15058a7488b99f48a2ae9d48a014c7ce425523a010be45fdef44d3be9596e707",
      "text": "Tokoh utamanya seorang nelayan muda.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "18fc2a092d0a2b9b633ab556be44009e1bb2a25a5b470f5c020504961576d032",
      "text": "penonton",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1929614014d1522120179dc28b5531982ec949337ec1b4274613d2f850b89a60",
      "text": "mengharukan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f1f3c4aff7bb49fb779bea16c1eb0b5b86fa7d13f891c01aada8e6afe804261",
      "text": "Kami menghadiri pemutaran film di pantai.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "213b50cd6641479048adc7700ef800d4481472f54be13efc2abefe65b5776385",
      "text": "Mohamed, malam ini ada pemutaran film di pantai. Mau ikut?",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "239884ff0ffef42362222ee2747cc9b7239dd98a289f4a83504e08148160353e",
      "text": "menemui",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "23fe321bba909c9b6505a2ca2b5e69c5e9bf569659d66d00412bf3e1ad7a3538",
      "text": "Ulasannya bagaimana?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "26f16a9dd331755ffd4ca14f2d2405e714ff83e2c1b7d1d03b79a60134a44850",
      "text": "Alurnya agak pelan, tetapi kisahnya berakhir bahagia.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "27299d5f73f24c4c7aa7237bf000c1988ef6c9ce3c3267cd5e089e61c013d9fe",
      "text": "wajib",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "274a71c17a53466a9aebb78587e6d5670205248b319ae2fb1927e410057e986c",
      "text": "Rina menemui Pak Irwan di kafe.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2980f4fa23fb1cd8339737b8b2aff088f995030a1a4f8f13e4188e5f9ea62887",
      "text": "Latar film ini Gili Trawangan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d472bcc9da25cdf488fe9389fbb7cf3849dd7052d42d339e77737d265ef9ca",
      "text": "kisah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cb171e83832570270c76b9651701a2a73bdfff418d18ead1e19527933303ceb",
      "text": "Saya sangat menyukai latar dan tokoh utamanya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eb60afc4565419c1835699d131230929aac35dffd2f409a215d868acc197c30",
      "text": "Sutradara itu mengakhiri filmnya di pantai.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f3e6c9d2b274118e8e4f3c88fb7850d4dbc15e0b67c366ebd735f6cbf54eee5",
      "text": "Para penonton duduk di pasir di depan layar.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "35db223e28962b94a04759b14a879d221e8a77fde380c402494b7a42e5a14715",
      "text": "menakuti",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "35ded32a4751c2aae635101202c00a010ba4ceb46999bf5be92719868fc12f2b",
      "text": "Saya sangat menyukai film itu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3806b4e98f8408eb5ddd4e3cbcd6763815ad3552ebbd75764a48f0ab8824f02e",
      "text": "Sutradara ___ filmnya dengan sebuah lagu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "39e1599716abc5c83afa2da1cee76a152d87d638d04f156c7e8a29d500e55d77",
      "text": "Latarnya Gili Trawangan, alurnya menarik, dan kisahnya berakhir bahagia.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e3867874c810043b270345ab70b0ce44252481fcc7ff1b4d3c9701b0f47ce7c",
      "text": "Mohamed, tolong tulis sinopsis film tadi malam untuk blog saya.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ec9e32713b58523de8004c33005da17313f09ef9da47560aad9f56bd9bc6869",
      "text": "mendatangi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4426236169d3afe3e9e5fb70022a827b58add18f478c7c8336e3b973b1a1b7dc",
      "text": "menghormati",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "442fd7127c270170b228d5212fa7238d6ad48a8e1dedadd6c2d5a5306ac08e53",
      "text": "kota",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "484fc382c55b9dbd3998a9d832901b9378b441b8e88c8394f3fd6ffa1c503081",
      "text": "Alurnya cepat dan konfliknya menarik.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "48fbba62b3d027aebfc4b856e9ca0efa8e24976a057df3f686d410c4d19eef21",
      "text": "Film ini bercerita tentang seorang nelayan muda di Gili.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "52448d6cf061c9a7421867415b423dd61b596f3d921eb9ba330ae6d359a7d981",
      "text": "Tentang Ari, anak nelayan yang sangat menyukai laut. Ayahnya ingin dia sekolah di Mataram.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "540b6285ebfe0a3233115174e9e4dca258cc0b6cc4f5bc203d3912f31f521b83",
      "text": "Film horor ini seram sekali!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "576b2c321a77cbbf305d409f24abd98ce9f7ffabe93c4c44fdb0e59b52c1b77b",
      "text": "Kamu wajib membaca ulasannya dulu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c12d94221b04c3ff21e22d368aa496598a0c086d2c542b22b3489eac2e80bd4",
      "text": "alur",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f1e2e4c08d8850a1924b342634a54a938f46cf2d5ec2aed41dda5333de21bbf",
      "text": "Layarnya di mana?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "6112eda46a8dced92d8672bb6b0d57ff4ad8fe11a367f246c294540f6fd0faaf",
      "text": "Banyak orang Indonesia mencintai sinetron. Ibu saya juga!",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "61212ea23ac874f5c94a72610297a3cbd7c5ccee552664c215f0d2feabf49a47",
      "text": "Katanya, di internet film ini dapat empat bintang. Ayo, kita tonton!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "66935964f22d4555ffea1b58d20875c3b856c637dd22439d4ae8cdbeefbccc42",
      "text": "Di depan kafe. Para penonton duduk di pasir. Saya tunggu di sana jam delapan, ya!",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "694be97bce05ff2369474e9841dc83c3519a1cc073a70398aeacf64416eadc63",
      "text": "Saya mau ___ Pak Irwan di kantornya.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a08699060f4133adbbfa9ec315e42e896b7d8021b1490ebf4bfe880894bd3d1",
      "text": "Banyak turis ___ Gili setiap tahun.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e05b6c7bf512c4dcc1192298bba45ba39cc68325a65ba4df3d707ef5789374e",
      "text": "Hantu di film itu menakuti semua penonton.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "709bdbc4c4ec29cf7d65e20668abda9071bb1c6914688979a516c0be44ec52f5",
      "text": "Ada! Kamu wajib menonton film nelayan Gili itu.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "709cd2dfb941ab3e2897adeff5aaff7c83637f49e601cae75099dd223b2d694f",
      "text": "Komedi keluarga. Katanya, alurnya lucu dan akhir ceritanya mengharukan.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "7166cc1d542061c94ccaec130746e0e3802f611f0a45c6ae98d7da3e7aaebf7a",
      "text": "konflik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "723f9fda1553ddb4468bd974dd52237ee47ac06d070d9fa59767131a444cec10",
      "text": "Saya menyukai film itu. Alurnya cepat dan akhir ceritanya mengharukan. Empat bintang!",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "7257e35f2fe980993ec8938fbf1d451dfd37309eac09f159dbae4ba2c19fa249",
      "text": "sekolah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7669c41bb1d87c0b1cf04ef8f1452c1fd75f293a6494aacceb448bedf341f5ec",
      "text": "Saya juga. Saya lebih menyukai komedi.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "777ad1a97e824c57f9e24aafd1ff714f5043c0a2276540c8b3d31984129e3884",
      "text": "Kami ___ acara itu.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "78847046f640f255e60d9397944d9880f086b7ba71909f1b03d80d1b462c8a2b",
      "text": "bintang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "790768cb37a57647e22377627d3e9827414ea3bb54eee1fb6b3cc0cf6f72ad64",
      "text": "Besok kamu pulang ke Mataram, ya? Mau menonton film lagi malam ini?",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b87f9effdfea363c7d51cd30bef2cacf19bd2aeb04b59526d768a8155443381",
      "text": "Malam ini filmnya film horor. Kamu suka?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d23e60997245633ad027ec26efa1b9b543e8708e2f5d52a125d9553fda70a18",
      "text": "sutradara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "81228cdedb4e633c3b6e4de6c474841355d16ab87053efa9fd47a870a41082ac",
      "text": "dapat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "82c4fd1188415b7c172831400c25424bce8a4cd67b7859a47937bfd358e4bcde",
      "text": "Ya, dan konfliknya antara dia dan ayahnya.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "837a03c06358058957cc53a9dd94f8f2cc3b3289143be9698aabc0a74efcff5e",
      "text": "sinopsis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8501b73862c9efb3112000a3ba15683761629149fb968fea03f19660ca541a6e",
      "text": "Kamu wajib menonton film ini. Kisahnya sangat menarik!",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bcf2969a95ddca33f5b750cebba13c479e879ca7da516c2784c7682585d27e8",
      "text": "mencintai",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "92a491b3d4f3c34be114a65ddbc0267485d6827107edddc0e8c1f47e133ba87c",
      "text": "Kami ___ pemutaran film itu.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "933cde07f7270085a35e5c6b8f352f8eb51bdacca2356d61a696f9fe16f059e3",
      "text": "Dari saya, film ini dapat empat bintang. Ceritanya mengharukan, tetapi alurnya agak pelan.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "952fec26dca365cf309ed21a245af269e338a4132fe1d90ff425afb49d4fd64d",
      "text": "Hmm, saya kurang menyukai film horor. Terlalu seram!",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "95ba59cae610dc850718515b39f7742c4126f57ad5e3a4ae3080213223e2a321",
      "text": "Empat bintang. Alurnya agak pelan, tetapi akhirnya mengharukan. Ayo, kita tonton malam ini!",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "9768bb7d3edf84fe1bec16c7f0e4a4c3c5a81e004ad2df6ca08bc7ee27c5cac2",
      "text": "komedi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a5b4b27e2ae3eb5613ffb1c0338d77ba1f3be9e9f1db60fe9c2c724b5009010",
      "text": "Bagaimana filmnya, Mohamed?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b20888ecc604ff140e53bdf287595a307614f9a05ed054ffc6982d5ddf234bc",
      "text": "Ya, setiap malam banyak turis mendatangi bioskop pantai itu.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a06b1381cf2c06e3127698b5f49e4045bfb718e8a4ff2c02ab95bd6709d6ac98",
      "text": "Oh ya? Film itu bercerita tentang apa?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a19044217f6a91e5a6aa4165a79df27c0b8f837853587b5debea0003e8de77c6",
      "text": "layar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1e8cb55dd6079d0d61105e931a81c4b7739856f1a932e2422291d5a25b43437",
      "text": "mengakhiri",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1fa806020c139133d7e7bb17ca605e8814d01818b8867c9ba153056f2d9227b",
      "text": "Latarnya juga indah sekali, kan?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "a25660d1b7b9517fabb23ebe0caf1642a65e7abcb0a72302c2f4d435b07b197b",
      "text": "Film ini bercerita tentang seorang penari dari Lombok.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3b2c7229e92f034fa44360e8dfb77cdac70f9184c0abc07d8dc550d38aab35e",
      "text": "Kenapa? Film horor, ya?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a56f051e74c2084732840216a8c9178ce81d161c6bc69789708c8eff5d5541b6",
      "text": "Saya menulis sinopsis tentang film yang mengharukan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7dc8b7066678b1816d433d2621128bd30435aa936aa9974fbca7742c9d058a8",
      "text": "Mohamed, ada rekomendasi film Indonesia?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8761eb98c94f9175bdc4d735e1492176e962a3a2b3ba58b35e8cab22e322dc7",
      "text": "Oke. \"Film ini bercerita tentang seorang nelayan muda di Gili.\"",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad15c270d3bd76b23bf50358c6e42c5204c2638e649f87b4a5b40a92a778ddda",
      "text": "Banyak turis mendatangi Gili Trawangan setiap tahun.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0cc7428fd80455f7c029e454a46f035a1067667e128056ddaf9ad328e6e8866",
      "text": "Film ini bercerita tentang Ari. Ari adalah ___ film ini.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1bdcc54c736af4654831cc04e06194ba1aad0741458991078a7886732e4b789",
      "text": "Raka lebih menyukai komedi.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b53f5b24890c92ba5fa8846e03ee49ad1a53b6d0027810faf9ad531f9b59b5b7",
      "text": "Alurnya agak pelan, tetapi akhir ceritanya sangat mengharukan. Dari saya, empat bintang!",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5be59b76009afd4543764e618c914523f57197599863b9cb5af7df3c4f2256d",
      "text": "berakhir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bae7d7e16230804afd02c781fa1838a513f14f623f2efb48f28464e68d75e6c5",
      "text": "Menarik! Ulasannya bagus?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbd78f13fb0543e60e78db50f275ef546aaf78c9fc6b665ec3cde5e96fed80cf",
      "text": "Ayah Ari ingin Ari sekolah di kota.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "bca791dc28dcfe566922ea9998bad910d7fb7ca1a4079b4d1c3ee20f60f8583a",
      "text": "Pada akhirnya, tokoh utama belajar menghormati ayahnya. Sangat mengharukan!",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "c26e37ff4408f2552dcbb080b1d29735f41fc85576cd0e293b9616ed6ce361ab",
      "text": "Sutradara dan pemain film ini orang Lombok.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9109bfacb2d9d5f08fc11957c2a1781195c1b79b4763d116654aa052b3b5fb8",
      "text": "pemutaran film",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb33b1389c0d29229f42efd7d1f2e955729ff6175fae9ba4327873063057f017",
      "text": "Malam ini banyak penonton mendatangi pantai.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef79ce06e704dc6b3eb079961c631c3abdc2c78bef21748f51fc5e53b5e2168",
      "text": "latar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf1acc724ff92fe02526c59496dd501308096be5a282102447c079d900cbcaaa",
      "text": "Ari sangat menyukai laut.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d54dc9b2472b9411cbe885801cf242e0e43cfe95cb40416e883a2d524a88f022",
      "text": "menarik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d78d1fbd7a2b47d52fd015026d42ef35dddd16ae353a9133c982aaa56091dfe0",
      "text": "film horor",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd786ea2464238275e7de3cf9b39bd4896fa2c960c5454ea1f40fe80d6e49d1c",
      "text": "Mohamed, saya membaca ulasan film Anak Laut di internet.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddc861cb4331d4cf4590b0c1f57d6e74f28f4bcd31af1fde966684fa67bb113a",
      "text": "Saya ___ film itu.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e05671bcb154b682247c0992704d4a29e61b2066e07e932fd46a98450807bd30",
      "text": "Kisah ini berakhir bahagia.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "e20f6488e1df390341bca2379aba0b6ee1b2bd9c726e65b08b220198a5677be8",
      "text": "Film horor Indonesia sangat seram.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e314f6a6d216b8686bf6e192a00453bf98b22f86f1732e026bde0d08f09340e7",
      "text": "Mau! Apakah banyak orang datang?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e31645cae3dd53b3644462a88045484b3a347f994e2d9ccb2ec27a1ff8fdd945",
      "text": "Dari saya, lima bintang! Akhir ceritanya sangat mengharukan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3820c3d1cf770445018c0d14757888aab2c10c34446ec11c97c2064509c37b8",
      "text": "Konfliknya antara Ari dan ayahnya, karena ayahnya ingin Ari sekolah di Mataram.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "e41242a5cb9b8e4eb4a55a5aedc71a1828a1046e4ddc0fa3b7510a2a9fa11eb8",
      "text": "Anak-anak mencintai film itu, tapi hantunya menakuti mereka.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e903cd204352a4b99a84c02d224284e9cff0d599cd72920dc3b70e24571c6cb3",
      "text": "Film ini dapat lima bintang dari saya!",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b357e24dda456c34e3a7d8620b4d21bca157505cc0fe8cb424250b01fdae36",
      "text": "seram",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eddeb75d93c2f8dbc1201df1ffe339ce2285fd0f649f222064eb6d086513d741",
      "text": "Sutradaranya orang Lombok, dan para pemainnya juga.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "eecf5662a1067882bb56c321b2259864b4ca93eb266de51636be1141cfbb9a55",
      "text": "Bagus. Di Mataram, Bu Yanti menonton sinetron setiap malam!",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f12f668dcdee37f1b3de1bd2489e0921cbe471fb2292e7bb3cb1e2d8ee1d1c51",
      "text": "Film Anak Laut bercerita tentang Ari, seorang anak nelayan di Gili Trawangan. Ari sangat menyukai laut.",
      "voice": "id_gadis",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "f38fdf34bd4d3d53d57acee5e1931909893409cd2ac38649e6de646825a7d330",
      "text": "Tapi film horor Indonesia sangat terkenal. Hantunya tidak menakuti saya!",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39cf088ea74a7028de160f12fc09e826ff3e721ad52ab82b8e8c4ec356b5ad6",
      "text": "Mau! Film apa?",
      "voice": "id_ardi",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "f87579b21b8100956023956b7ec8c4302e64ef9bbd3d7166375a5960e462a6d1",
      "text": "pemain",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbaa9261633ba89858bca9fa9682dc5cb6daeec6ca935591a681c28309747a18",
      "text": "menghadiri",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc560e5ae71c7557d935d3362dba3ed17b980a90d85832d8686a9b2cdbaac39b",
      "text": "menyukai",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fee6c715dcea384511b20fc313802192d207e518beb6bc0a8927cd2ae5b4df62",
      "text": "hantu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    }
  ],
