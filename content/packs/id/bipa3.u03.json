{
  "format": 1,
  "id": "id/bipa3.u03",
  "language": "id",
  "unit": "bipa3.u03",
  "version": 7,
  "content_hash": "5d317f6a98ed9f901b87894d1b0fa6084fbeebfa3f629364cff9cab40842c4c3",
  "lessons": [
    {
      "id": "bipa3.u03.l01",
      "sha256": "4b6c95526f2eb68b1e243d62d9fb1c1e0afba5e52282dc677b11a7be50f912ea"
    },
    {
      "id": "bipa3.u03.l02",
      "sha256": "21e409cf4a084546670b90a8bf6ddc501c9beebabe92a136ed92bc02f934d8f3"
    },
    {
      "id": "bipa3.u03.l03",
      "sha256": "faa7c74246bb86278628255e3546552d48fa5acb28b05b94350e14655e95ce63"
    },
    {
      "id": "bipa3.u03.l04",
      "sha256": "006b7deaa755a74ee1bed0785c32fd7a8988abfc7d969ca6d32f2c2a27c11865"
    },
    {
      "id": "bipa3.u03.l05",
      "sha256": "4293d70710efb4b82b7bc0df63f253141e96db7608b4493ee32e7287234cd46e"
    },
    {
      "id": "bipa3.u03.l06",
      "sha256": "2c70d8bd621f8bf1321380d46e61c575d82e319fd26166a4d7d5c51dc2388232"
    },
    {
      "id": "bipa3.u03.l07",
      "sha256": "776e4be02af497cbc6013786f666d3bd947c7593c20b15da413d64910daad700"
    },
    {
      "id": "bipa3.u03.l08",
      "sha256": "c9a579f1106262282092c47fec7ae9f9ed2b4727600868c5bdff5bd814bf564f"
    },
    {
      "id": "bipa3.u03.l09",
      "sha256": "ff23dd2d4a45aaae126086bf551a39a56b907bca10a2e09d799b62bb23f0565c"
    },
    {
      "id": "bipa3.u03.l10",
      "sha256": "7f7ce9431130e119654fd67604eda02db60768cb997243c2b0e499189cb0132a"
    }
  ],
  "audio": [
    {
      "key": "03931baacd9daa4525653bb53e5323f3d4919f3f8025cd8e7953566406389355",
      "text": "Wah, filmnya payah! Ceritanya tidak menarik.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "07dd8a10ab5892e189fb99fd0cc771c6dc45ff8a38f116f67432b734b13b63c8",
      "text": "Besok kita nonton film drama aja, ya.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "08b26370792f3b138003a5fcda12b23d56473cbbe678670903bc2faa4b951af1",
      "text": "Pemandangannya menakjubkan sih, tapi ceritanya agak payah.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "09b4f62459de80efd2290f1512457eb2e47ca6f27c7ed2e220232e50a32885ae",
      "text": "Film Indonesia. Pemainnya terkenal banget, penggemarnya banyak.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a29303ea698e674f8c552bcaed43a745b47b125c2cd3b631d5b2530359e6e62",
      "text": "Mohamed, gimana film kemarin? Keren nggak?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a36415fce4a0704ce4611f99b0db986c4acdda4d6c3214d7585e888e3f361bc",
      "text": "ulasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b6a5d4ba10bd41aa899a4d98d25234c614e0e7c446dd511dc8e9e6b5baaf22e",
      "text": "Asyik. Di Mataram, Bu Yanti nonton sinetron tiap malam, lho!",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bdb4be0db6da45b54a07a11befca7b485a494c3c483c8b6961fccbe8818f237",
      "text": "menakjubkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0da93bcc8be8e8b404bb05eebf62b63d651de5f427f7efe453646b9b64e0462b",
      "text": "Pada akhirnya, dia kembali ke rumah ayahnya.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e21c1faa13d57f09df0f03089c90f470c6abd0cb59dfa59f8b647e6c9283eed",
      "text": "Gimana filmnya, Mohamed?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ed06106c45109357a7f4b2ebbd601588312fbd67898fb0e81db9bc59ab53e0e",
      "text": "Wah, aku pengin lihat penampilannya!",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ee0e902ec730cf5168fdd86822814b6047b8456b8e4898fb2dba2b53732e66a",
      "text": "menyedihkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f43890ed37b105964dc0fa652779bfa4ace698735d23ebeafaa6c321f5d93b2",
      "text": "tokoh utama",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fa5aeb1c18e26790ff75f1d316ff601db29342809bbc002632f6fce9f87a393",
      "text": "Tokoh utama belajar menghormati ayahnya.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "13751d11208fb6db919e28afa7c9c9826eb8dcf180933274db2061e2a97004ad",
      "text": "tampil",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "15058a7488b99f48a2ae9d48a014c7ce425523a010be45fdef44d3be9596e707",
      "text": "Tokoh utamanya seorang nelayan muda.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "18fc2a092d0a2b9b633ab556be44009e1bb2a25a5b470f5c020504961576d032",
      "text": "penonton",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1929614014d1522120179dc28b5531982ec949337ec1b4274613d2f850b89a60",
      "text": "mengharukan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e6934addc9d9a3d92c5af44b538ef324b2f1280f4bcd91049642df7565991b3",
      "text": "Ya, dan akhirnya mengejutkan! Penjahatnya teman detektif itu.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ebff7dc15c587d997f680940f049bfadbed37ea2981b4b1ff9eb87fc7d60a3e",
      "text": "Filmnya bagus sih, tapi panjang banget.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ef96079cb73b4282265628ffd3bf25ccd6908530c573924abd35be157306b8e",
      "text": "Banyak orang Indonesia cinta sinetron. Ibuku juga!",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f1f3c4aff7bb49fb779bea16c1eb0b5b86fa7d13f891c01aada8e6afe804261",
      "text": "Kami menghadiri pemutaran film di pantai.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "213b50cd6641479048adc7700ef800d4481472f54be13efc2abefe65b5776385",
      "text": "Mohamed, malam ini ada pemutaran film di pantai. Mau ikut?",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "221bbca1ce50a108c5d6dc5c049d3e920063d9380989ea93dd68aeba6eafae94",
      "text": "Oh ya? Film itu cerita tentang apa?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "239884ff0ffef42362222ee2747cc9b7239dd98a289f4a83504e08148160353e",
      "text": "menemui",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "26309691c22dc35af26336ab8153541793cd2ab62c9b8c8e2b7fe42893610516",
      "text": "detektif",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "27299d5f73f24c4c7aa7237bf000c1988ef6c9ce3c3267cd5e089e61c013d9fe",
      "text": "wajib",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "274a71c17a53466a9aebb78587e6d5670205248b319ae2fb1927e410057e986c",
      "text": "Rina menemui Pak Irwan di kafe.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "2980f4fa23fb1cd8339737b8b2aff088f995030a1a4f8f13e4188e5f9ea62887",
      "text": "Latar film ini Gili Trawangan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "29d472bcc9da25cdf488fe9389fbb7cf3849dd7052d42d339e77737d265ef9ca",
      "text": "kisah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cb171e83832570270c76b9651701a2a73bdfff418d18ead1e19527933303ceb",
      "text": "Saya sangat menyukai latar dan tokoh utamanya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d67bf91a3f8b2aaae77b49a069c9adef8607fd4168159d05d4d304744864a3b",
      "text": "Menarik! Tokoh utamanya nelayan muda di Gili.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eb60afc4565419c1835699d131230929aac35dffd2f409a215d868acc197c30",
      "text": "Sutradara itu mengakhiri filmnya di pantai.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f3e6c9d2b274118e8e4f3c88fb7850d4dbc15e0b67c366ebd735f6cbf54eee5",
      "text": "Para penonton duduk di pasir di depan layar.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f764f9571ae1fbecc621ac179acc8e575276b90279035de054ef04abe94d5c1",
      "text": "Akhir film misteri ini sangat mengejutkan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f9ee08ed770c03224b4cf9764824ee31351f93ec5dd22f9e7aef279f166aa98",
      "text": "Karakter utamanya lucu sekali.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "31c83c7dda9e7468396b4bfb2fe42cd55f69d9c39d89f3d773768f5acf6d3002",
      "text": "Film ini keren! Musiknya sempurna.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "328a0037cfb004dab9f8f234c938e7dc2029b4cef5df66112a17111a64cdb676",
      "text": "penampilan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "35db223e28962b94a04759b14a879d221e8a77fde380c402494b7a42e5a14715",
      "text": "menakuti",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "35ded32a4751c2aae635101202c00a010ba4ceb46999bf5be92719868fc12f2b",
      "text": "Saya sangat menyukai film itu.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3806b4e98f8408eb5ddd4e3cbcd6763815ad3552ebbd75764a48f0ab8824f02e",
      "text": "Sutradara ___ filmnya dengan sebuah lagu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "39e1599716abc5c83afa2da1cee76a152d87d638d04f156c7e8a29d500e55d77",
      "text": "Latarnya Gili Trawangan, alurnya menarik, dan kisahnya berakhir bahagia.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b2a5766a9eda396b147781cb36486aca10e5b2b10f02b89baefafb23a4aa9ef",
      "text": "Aktor itu memainkan peran seorang nelayan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ec9e32713b58523de8004c33005da17313f09ef9da47560aad9f56bd9bc6869",
      "text": "mendatangi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "422434cf0440df9f1b37bc938cf8ca5a6786fc3b4932a2dfca900dde6417dbec",
      "text": "aksi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4426236169d3afe3e9e5fb70022a827b58add18f478c7c8336e3b973b1a1b7dc",
      "text": "menghormati",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "442fd7127c270170b228d5212fa7238d6ad48a8e1dedadd6c2d5a5306ac08e53",
      "text": "kota",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "446be8f230f7649f403912a655727d6a93d1a7cc910420d8969d212cab7d71fa",
      "text": "Bintang lima! Filmnya ___!",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "484fc382c55b9dbd3998a9d832901b9378b441b8e88c8394f3fd6ffa1c503081",
      "text": "Alurnya cepat dan konfliknya menarik.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "48fbba62b3d027aebfc4b856e9ca0efa8e24976a057df3f686d410c4d19eef21",
      "text": "Film ini bercerita tentang seorang nelayan muda di Gili.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c38812cc0f05d634473cfd14e3d70ee5357651c999977579886b1497896e0b0",
      "text": "Detektif itu tahu siapa penjahatnya.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f0f30d254bb3b538d40f3df638d7f474d2bd47985be7b6095f6339172022865",
      "text": "Pemandangan di film itu menakjubkan.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f1ee0e3bbe158ed7536db0ba30c9654a185cbf5dd350452a7913922efec17a1",
      "text": "Dia pemenang untuk aktor terbaik tahun ini.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5085d9f8094632a4e66c431b4521fef5011351dec173534fdf38c5166c8cc591",
      "text": "Oke. Aku tulis resmi, ya: \"Film ini bercerita tentang seorang nelayan muda di Gili.\"",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "530a4d7d25b9e7ffb6745c5bc741edbd0bdc72f5dfb37d2fc2ac347144e610be",
      "text": "misteri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "540b6285ebfe0a3233115174e9e4dca258cc0b6cc4f5bc203d3912f31f521b83",
      "text": "Film horor ini seram sekali!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "576b2c321a77cbbf305d409f24abd98ce9f7ffabe93c4c44fdb0e59b52c1b77b",
      "text": "Kamu wajib membaca ulasannya dulu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "579b81851340b190776d5b0abe426f396fe4d4a8502a43dbb834ec0aec366e08",
      "text": "Iya, terus konfliknya antara dia sama ayahnya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "58824c2e9736cfb43c81feb4d6896fdf494323a8ffcda3346650fe1cf3d4f1e6",
      "text": "Aku juga. Aku lebih suka komedi.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "58c0115ce28ac0d535ea3958f273213202e55482eb70a39bedf62861dff3ce11",
      "text": "adegan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "58dffb66182a5b926a6fb22032fc231ce30e85484eb63a933647694ea78f9adf",
      "text": "Adegan terakhir sangat mengharukan.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a5ff0fe8f754282bbc5fce880bde85977effd6a7b5943f9d1ea72eb5ad79066",
      "text": "Malam ini filmnya film horor. Kamu suka nggak?",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c12d94221b04c3ff21e22d368aa496598a0c086d2c542b22b3489eac2e80bd4",
      "text": "alur",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f1e2e4c08d8850a1924b342634a54a938f46cf2d5ec2aed41dda5333de21bbf",
      "text": "Layarnya di mana?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "602604fe32c10532664c7fe6eba7335d963329ceb60d2bdb355033cdaa99b2eb",
      "text": "Saya suka film aksi, tapi Rina suka drama.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "679e4c3b18bfcbca71b2c4467f168d2ff41f7c8eaf6aaf7626097834d6268b52",
      "text": "Mohamed, aku baca ulasan film Anak Laut di internet.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "68d0d75144491bc77f2dc95ae6102a057fa7e462eb4233d7c3c81f9addfb5659",
      "text": "Kok gitu? Itu film romantis, kan?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "68f62c7d02a0173a05d251a22a0d0e709b20aac71833186a37cf53b9a6d886be",
      "text": "klasik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "694be97bce05ff2369474e9841dc83c3519a1cc073a70398aeacf64416eadc63",
      "text": "Saya mau ___ Pak Irwan di kantornya.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a08699060f4133adbbfa9ec315e42e896b7d8021b1490ebf4bfe880894bd3d1",
      "text": "Banyak turis ___ Gili setiap tahun.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae62fae68a9d4d9c9de1bb33add3f7e2527e74caafaf2ee5212bf042cab40be",
      "text": "berlebihan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e05b6c7bf512c4dcc1192298bba45ba39cc68325a65ba4df3d707ef5789374e",
      "text": "Hantu di film itu menakuti semua penonton.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6eca53313c2f011518e7067dea45ae0bf3affd24631e01d9c13db0a8ee8f494b",
      "text": "Ulasannya gimana?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7166cc1d542061c94ccaec130746e0e3802f611f0a45c6ae98d7da3e7aaebf7a",
      "text": "konflik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "723f9fda1553ddb4468bd974dd52237ee47ac06d070d9fa59767131a444cec10",
      "text": "Saya menyukai film itu. Alurnya cepat dan akhir ceritanya mengharukan. Empat bintang!",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "7257e35f2fe980993ec8938fbf1d451dfd37309eac09f159dbae4ba2c19fa249",
      "text": "sekolah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "73e5e88e680cbc40a35b190f8432764321614fd2deb228e5a0d4edb58e3e7cf0",
      "text": "mengerikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "748d5b6d45d526ab75514d1067beebb3d41d164273bce576205305e074f04ed3",
      "text": "Banyak! Tiap malam banyak turis mendatangi bioskop pantai itu.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "777ad1a97e824c57f9e24aafd1ff714f5043c0a2276540c8b3d31984129e3884",
      "text": "Kami ___ acara itu.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "7794f2383a8cd9e376cfa5c805e0f1982ce889905f5b79eede650aede249ebce",
      "text": "Jadi nelayan. Ada adegan di laut yang mengharukan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "78847046f640f255e60d9397944d9880f086b7ba71909f1b03d80d1b462c8a2b",
      "text": "bintang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "790768cb37a57647e22377627d3e9827414ea3bb54eee1fb6b3cc0cf6f72ad64",
      "text": "Besok kamu pulang ke Mataram, ya? Mau menonton film lagi malam ini?",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a9f07ea83024f3fdcfeac61aed5b0f3850be5d1b37e327a56f1d865dde03729",
      "text": "Saya suka film misteri dengan detektif yang pintar.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d23e60997245633ad027ec26efa1b9b543e8708e2f5d52a125d9553fda70a18",
      "text": "sutradara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f0edab5f9d35857fb74ebc1c02362a570e671edc94c5df959235cedbf1fc20c",
      "text": "drama",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "81228cdedb4e633c3b6e4de6c474841355d16ab87053efa9fd47a870a41082ac",
      "text": "dapat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "837a03c06358058957cc53a9dd94f8f2cc3b3289143be9698aabc0a74efcff5e",
      "text": "sinopsis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "84edf86534cf04404ed7495f66fd271322949ec3edffa87d2dd5536988776c04",
      "text": "payah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8501b73862c9efb3112000a3ba15683761629149fb968fea03f19660ca541a6e",
      "text": "Kamu wajib menonton film ini. Kisahnya sangat menarik!",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "85db94c8dc74366f02878afa8e29f9ce9cc3fc1e6317d23289e154ac25e0ef5e",
      "text": "penjahat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "88980523092b936e29fa6b2883be0b3d0fa7a0ef27955fee2d02ff72d7e890a5",
      "text": "Aku juga. Detektifnya pinter banget.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a99f5145a1584bd9163b4213c23c6000b760c9176b29f688b650f7ab9a21a1b",
      "text": "Alurnya agak pelan sih, tapi kisahnya berakhir bahagia.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bcf2969a95ddca33f5b750cebba13c479e879ca7da516c2784c7682585d27e8",
      "text": "mencintai",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "90cfc5edcce00bc8edb44cd17b4d05ea145ae369768dfb1e222e716ffaa74450",
      "text": "Mohamed, malam ini ada film di pantai. Nonton, yuk!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "92a491b3d4f3c34be114a65ddbc0267485d6827107edddc0e8c1f47e133ba87c",
      "text": "Kami ___ pemutaran film itu.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "933cde07f7270085a35e5c6b8f352f8eb51bdacca2356d61a696f9fe16f059e3",
      "text": "Dari saya, film ini dapat empat bintang. Ceritanya mengharukan, tetapi alurnya agak pelan.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "9381dcc0ad735e4156431e6612544ba4d1c0b9398122cb943e59a4d60795a0eb",
      "text": "Penampilan pemenang itu bagus sekali.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "964b3608ab2cf70f22ce8a4b0e27e3c18e58f1fcee8907e7b1bc513ebb65697b",
      "text": "Latarnya juga indah banget, kan?",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "9768bb7d3edf84fe1bec16c7f0e4a4c3c5a81e004ad2df6ca08bc7ee27c5cac2",
      "text": "komedi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "99c8cadc40882850cefcb45fe7cc41c6237faef53de86c02205d199d97e38d99",
      "text": "Bagus. Sutradaranya siapa?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c73cdc1160b0c713deba048b563b16513de77676699b928cbac34e8cad4e088",
      "text": "Mohamed, tolong tulisin sinopsis film tadi malam buat blogku, dong.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "9de177d39809418396ffeae110cc11182d72e2062ad9fa3f9443d2eaf732a98d",
      "text": "Di depan kafe. Penontonnya duduk di pasir. Aku tungguin di sana jam delapan, ya!",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ea4ccbe5b5777819253da16ddcdbe7bc8ec37961ccba02d7eb657c194184432",
      "text": "romantis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a15e06745f0e46dbe374eb05b847156d43302d4f1e41563b4248dc407eb33db1",
      "text": "Kalau gitu, nonton film klasik aja deh. Ceritanya keren!",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a19044217f6a91e5a6aa4165a79df27c0b8f837853587b5debea0003e8de77c6",
      "text": "layar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1e8cb55dd6079d0d61105e931a81c4b7739856f1a932e2422291d5a25b43437",
      "text": "mengakhiri",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a367f864c487c4e2aa711fdda31292b65ebf5d26679df124a59990652239d476",
      "text": "Mohamed, ada rekomendasi film Indonesia nggak?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a39ad3faf03e0a6565165f992abfd5653cd7c7e3ec2d02a052f2fc3de0513a41",
      "text": "mengejutkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3b2c7229e92f034fa44360e8dfb77cdac70f9184c0abc07d8dc550d38aab35e",
      "text": "Kenapa? Film horor, ya?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "a56f051e74c2084732840216a8c9178ce81d161c6bc69789708c8eff5d5541b6",
      "text": "Saya menulis sinopsis tentang film yang mengharukan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "a62d3566b514a8c23da9407e49c106bec8e02b623390cb200b8a51e85ac7712e",
      "text": "Tapi film horor Indonesia terkenal banget, lho. Hantunya nggak menakuti aku!",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "a78a7707d66c986cba333b7dcc46ac41480e03d6ed97e4062b9d0ef6ec0386ca",
      "text": "Dia akan memainkan peran raja malam ini.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "acd0428debc043e8a167d6f88ab1d69a59de50e0922ac01476d4e652020d8e39",
      "text": "Rina, film tadi bagus banget! Aku suka misterinya.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad15c270d3bd76b23bf50358c6e42c5204c2638e649f87b4a5b40a92a778ddda",
      "text": "Banyak turis mendatangi Gili Trawangan setiap tahun.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0cc7428fd80455f7c029e454a46f035a1067667e128056ddaf9ad328e6e8866",
      "text": "Film ini bercerita tentang Ari. Ari adalah ___ film ini.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b15e16cb1e92d9cda8722fd88bf331c19b8f14e388b94e4d57ef61a2521b73c1",
      "text": "Empat bintang. Alurnya agak pelan, tapi akhirnya mengharukan. Nanti malam kita tonton, yuk!",
      "voice": "id_gadis",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1bdcc54c736af4654831cc04e06194ba1aad0741458991078a7886732e4b789",
      "text": "Raka lebih menyukai komedi.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2beb286d4ad713aa5fc819c807a9d33b064319b0dfc394f0d2392d73238c55b",
      "text": "Dia memainkan peran apa?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "b53f5b24890c92ba5fa8846e03ee49ad1a53b6d0027810faf9ad531f9b59b5b7",
      "text": "Alurnya agak pelan, tetapi akhir ceritanya sangat mengharukan. Dari saya, empat bintang!",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5be59b76009afd4543764e618c914523f57197599863b9cb5af7df3c4f2256d",
      "text": "berakhir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b68e3a43c90fef7f326d37853659394b1360dc512649dccc595988b49699c742",
      "text": "kejutan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9b0ee518af880057d67c0a51ad6e86664e3a6135b3297a592964084a89ac19a",
      "text": "Ada! Kamu wajib nonton film nelayan Gili itu.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "bae7d7e16230804afd02c781fa1838a513f14f623f2efb48f28464e68d75e6c5",
      "text": "Menarik! Ulasannya bagus?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "bbd78f13fb0543e60e78db50f275ef546aaf78c9fc6b665ec3cde5e96fed80cf",
      "text": "Ayah Ari ingin Ari sekolah di kota.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "bca791dc28dcfe566922ea9998bad910d7fb7ca1a4079b4d1c3ee20f60f8583a",
      "text": "Pada akhirnya, tokoh utama belajar menghormati ayahnya. Sangat mengharukan!",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf7d23405d13f1a9a3c30f5ae10f3e8fd13818f82b15b26cadf05b9b987e1d1",
      "text": "Bukan, film keluarga. Ceritanya mengharukan, latarnya indah.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdf3b943186cdc8f461f94df4027165f813939487424126b56ff90163d5892fa",
      "text": "Tentang Ari, anak nelayan yang suka banget sama laut. Ayahnya pengin dia sekolah di Mataram.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "c26e37ff4408f2552dcbb080b1d29735f41fc85576cd0e293b9616ed6ce361ab",
      "text": "Sutradara dan pemain film ini orang Lombok.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5949baa46e3d9c95862e7c3b57edc2939b7a2d02accba0680d49cad24c03ad7",
      "text": "Film romantis ini keren, tapi akhirnya menyedihkan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9109bfacb2d9d5f08fc11957c2a1781195c1b79b4763d116654aa052b3b5fb8",
      "text": "pemutaran film",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "c99e76f56a72d19700b32f845b598e20898bdfededcc7ffbead2acd30c00e63a",
      "text": "Ya udah, aku ikut. Tapi aku duduk di belakang, ya!",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca56e9d37104b8c2452014eec593326daea5950fbe0a7c51ea2fb4adbe71b859",
      "text": "Film apa? Siapa yang main?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb05fd992b181b469542aa753966abd1fd379cab42e48afebf86dbaf7768c1e0",
      "text": "keren",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb33b1389c0d29229f42efd7d1f2e955729ff6175fae9ba4327873063057f017",
      "text": "Malam ini banyak penonton mendatangi pantai.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd67150968fd009de0fc565e145aefeb2248529ca2304d031159f49f2251c14c",
      "text": "Film aksi ini mengerikan, tapi menarik.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "cef79ce06e704dc6b3eb079961c631c3abdc2c78bef21748f51fc5e53b5e2168",
      "text": "latar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf1acc724ff92fe02526c59496dd501308096be5a282102447c079d900cbcaaa",
      "text": "Ari sangat menyukai laut.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3153418dc80325b7bf17fa72da0a0bd87ea416820d798320e7044ede461fd09",
      "text": "Polisi ingin menghentikan ___ di Mataram.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "d54dc9b2472b9411cbe885801cf242e0e43cfe95cb40416e883a2d524a88f022",
      "text": "menarik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d78d1fbd7a2b47d52fd015026d42ef35dddd16ae353a9133c982aaa56091dfe0",
      "text": "film horor",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7deb9045ccf0feeeb674947b2c2a4c3a13790cb794d2c84f49e94ae62c85c5f",
      "text": "memainkan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d97cde208614e857e731a5574d7b95f333888806f457daba3755d455c6dce959",
      "text": "Komedi keluarga. Katanya alurnya lucu, terus akhir ceritanya mengharukan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "daf52df1ad3153f392339575d0c7a0e2bcfb25a2906b5cf861317a8855b6bde0",
      "text": "Kejahatan di film itu mengerikan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc38fd15fd1786a09ad97b4ffd980c70dbe43083ad3c95bddb875557621ef762",
      "text": "Hmm, aku kurang menyukai film horor. Serem banget!",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc8751710d5c563779ce70ef3522b607868917a85d8516c03b3fe9f5c53bbfa0",
      "text": "Mau! Yang datang banyak nggak?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddc861cb4331d4cf4590b0c1f57d6e74f28f4bcd31af1fde966684fa67bb113a",
      "text": "Saya ___ film itu.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "e05671bcb154b682247c0992704d4a29e61b2066e07e932fd46a98450807bd30",
      "text": "Kisah ini berakhir bahagia.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "e06f5c349af3f4ddf13144203c2f2d4a83e0d286215e318f443a9069f25b61f2",
      "text": "Akhirnya payah, dan aktingnya berlebihan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "e20f6488e1df390341bca2379aba0b6ee1b2bd9c726e65b08b220198a5677be8",
      "text": "Film horor Indonesia sangat seram.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e31645cae3dd53b3644462a88045484b3a347f994e2d9ccb2ec27a1ff8fdd945",
      "text": "Dari saya, lima bintang! Akhir ceritanya sangat mengharukan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3820c3d1cf770445018c0d14757888aab2c10c34446ec11c97c2064509c37b8",
      "text": "Konfliknya antara Ari dan ayahnya, karena ayahnya ingin Ari sekolah di Mataram.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "e41242a5cb9b8e4eb4a55a5aedc71a1828a1046e4ddc0fa3b7510a2a9fa11eb8",
      "text": "Anak-anak mencintai film itu, tapi hantunya menakuti mereka.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "e42fbb11feebf8630598c5fcac8003e6c79e630f8582aa84d9d9e2bbca1e6909",
      "text": "peran",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e56509e1b238e77b12f926901dcd1ced96632a3125ae2832c1fa267f9ff00ffe",
      "text": "Katanya, di internet film ini dapat empat bintang. Yuk, kita tonton!",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6fd1dd39d5ecb5f6d8495b721fea5709dad1afab91e409521bf926a0e928fba",
      "text": "penggemar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e903cd204352a4b99a84c02d224284e9cff0d599cd72920dc3b70e24571c6cb3",
      "text": "Film ini dapat lima bintang dari saya!",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b357e24dda456c34e3a7d8620b4d21bca157505cc0fe8cb424250b01fdae36",
      "text": "seram",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eddeb75d93c2f8dbc1201df1ffe339ce2285fd0f649f222064eb6d086513d741",
      "text": "Sutradaranya orang Lombok, dan para pemainnya juga.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeed896b58a1277d27d7668891c8590a89674a505147e6f419878963312910c2",
      "text": "pemenang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f12f668dcdee37f1b3de1bd2489e0921cbe471fb2292e7bb3cb1e2d8ee1d1c51",
      "text": "Film Anak Laut bercerita tentang Ari, seorang anak nelayan di Gili Trawangan. Ari sangat menyukai laut.",
      "voice": "id_gadis",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1ee33f29bbbfb234114639db286f38e2f90eedf86b3306d719ba07ddc24c7ac",
      "text": "Tapi adegan kejahatannya mengerikan.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39cf088ea74a7028de160f12fc09e826ff3e721ad52ab82b8e8c4ec356b5ad6",
      "text": "Mau! Film apa?",
      "voice": "id_ardi",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "f69d42b042a606b808be510c8fc8bfde8b2a534d68900f276e27c2c05ce60600",
      "text": "Siapa yang ___ peran ayah di film itu?",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6f2e7c495c12223f6eb532e9f480bb8fccc0ac71f7e2d1fb9ebfa31eeeb08e3",
      "text": "kejahatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f721f1f89c6e3877640632bf7063918ddc64e04274d2b3077cce5d0a2c4f3096",
      "text": "karakter",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f87579b21b8100956023956b7ec8c4302e64ef9bbd3d7166375a5960e462a6d1",
      "text": "pemain",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbaa9261633ba89858bca9fa9682dc5cb6daeec6ca935591a681c28309747a18",
      "text": "menghadiri",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc223111c03fdaefb949a67e031d063868edde020f055d0d4aaad1d331e391ad",
      "text": "Iya, tapi aktingnya berlebihan. Nggak ada kejutan.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc560e5ae71c7557d935d3362dba3ed17b980a90d85832d8686a9b2cdbaac39b",
      "text": "menyukai",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcb2371b7cca64e27f8202267e1c003819e020ce0c3dd3fcba27708262864955",
      "text": "Temenin aku nonton, dong!",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "fee6c715dcea384511b20fc313802192d207e518beb6bc0a8927cd2ae5b4df62",
      "text": "hantu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    }
  ],
