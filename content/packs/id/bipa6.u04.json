    },
    {
      "id": "bipa6.u04.l04",
      "sha256": "c9d29577ff417a506de7bdf292d0535a75cdfee9cb7be8a726feccc4952db145"
    },
    {
      "id": "bipa6.u04.l05",
      "sha256": "50c6e8a7c648e202f382f2985da368f6328c7393a9294b39625b45e071eedee8"
    },
    {
      "id": "bipa6.u04.l06",
      "sha256": "04b71dcb55d42e208ff57605f5d481ddb59028bf9ab0cfa2fffce27ec3e168e0"
    },
    {
      "id": "bipa6.u04.l07",
      "sha256": "cf86cbd17f96c7b0b54b728b7a879681ab7efbe5019fa8030f271b59b913b0cc"
    },
    {
      "id": "bipa6.u04.l08",
      "sha256": "0cd8aca62d457424a890e2ab56c25bc8bc0bed05e11f71596e86fd214d085714"
    },
    {
      "id": "bipa6.u04.l09",
      "sha256": "0b1afc2bcea3a44baeb8336b7bbb5fec37f9869bcd10db6f9c3fe25d5c9aeaf4"
    },
    {
      "id": "bipa6.u04.l10",
      "sha256": "ea7d2b8dd924aeb149ad57f1e82238be94ad5712d484c9a3a291d57ac49ee76a"
    },
    {
      "id": "bipa6.u04.l11",
      "sha256": "71ac17e269cd904e02ba70f855a3377c2c0c5fd7f3b4c27fdf4e7ef50be113d3"
    },
    {
      "id": "bipa6.u04.l12",
      "sha256": "63c0ab2ecf04640a5ce9769c39d060b2975fcbef89d7e0a42baba79ab8c054c5"
    }
  ],
  "audio": [
    {
      "key": "057589bf5d0d3bcccf2e9e64614ccb99484306a59fcf1fbe18e6e3f089f2ede8",
      "text": "berlayar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "069c9bce2af083aceb9a906a85760d59adcdc406645200d4f454b7743deba236",
      "text": "Sriwijaya menjaga selat supaya kapal dagang aman. Karena itu, kerajaannya kuat.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "07514a8b209d57714a0b184f9d851c9360cd06ebb87fa7d40db1fd57fc6e3fe9",
      "text": "Persis. Biksu dari Tiongkok pun datang belajar di sini.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "07ff89b1223cc4bbce22e935fd2daf4d1d1eb0dc2990b17d264b5a0df98aa223",
      "text": "Konon, pada abad ketujuh, berdirilah sebuah kerajaan besar.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "08c66be8d0bf126de475b263b19bc5d8c7a6e14b9b9084a1b85fcab7f0f118c8",
      "text": "Kak, ringkasanku kepanjangan. Tiga halaman tentang Sriwijaya!",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "09397692b44ac0006d51ce868d2429b16b11fd28cfa9563f2c73d40f16723ff0",
      "text": "Batu bertulis itu ditemukan pada tahun 1920.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "093d1bb5c4b97a101ab1060b47a7574cd89e6048ccaa5151aa0b55facbacc7a7",
      "text": "peninggalan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a5ebe83ab604a5a35fda574f39b47c30c5ec2bb6179305382ab5e2f0ef02018",
      "text": "Pada abad pertengahan, berlayarlah para pedagang Arab ke Nusantara.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b26c449e68fa6f8086501587358ccc16dc6e1a253c567fcdd6fa6b2e21ff2d7",
      "text": "Sekarang datanglah seorang pelajar dari Mesir. Sejarahnya belum selesai!",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c99d9e81396934914a028da4d3989faf9d43be0ffe0b8820bf527a2c1762c35",
      "text": "awak kapal",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cd43f424b14918adcb467aee6fb063c97e89558c7fe1dc1f16294f730cb9395",
      "text": "pusat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e6d98cdb695551b1ec1715c9c79d0432d2b76e79338dcd8912c426dcc997372",
      "text": "Jadi ekspedisinya membawa perdagangan dan persahabatan, bukan perang.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "10cb1d346a8ba03892c5f895a38090a7101eabc77e002d36e1cff598e5dfa555",
      "text": "Laksamana Cheng Ho datang dengan damai, bukan untuk menjajah.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "1275d89d596f8f59fa20f1db8d60d0287debc6a6eb701bb16c8ad6af7da01b52",
      "text": "Armada Cheng Ho menunggu angin muson sebelum singgah di Palembang.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "129515044afa0b88e30de29d10e932cd8a3328405537d7166cf12995184f8d0e",
      "text": "Kapal itu berlabuh, lalu awaknya menurunkan jangkar.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "12c4eafa506984fb049f9fb1feb506643e95b482815b425652a2d61b558f8138",
      "text": "Di situs ini, orang menggali dan dapat manik-manik dan keramik Tiongkok.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "15a3f70b528725a8a4cd9787e3d637535a9ff34565a90201288298b1236377af",
      "text": "Dalam perjalanan ke Afrika, armada itu singgah di Sumatra.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "1660cee3f9dc51c78f695c13de832f7b9e2f702581dea037fba30a20cdbe5c9e",
      "text": "Pada masa jayanya, Sriwijaya menjadi pusat ilmu agama Buddha.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "1748f004864007656c908dc221e64288f6b96574a651105a84fb4e500d733184",
      "text": "laksamana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a3f6ddcd8550c18f4bde52679ef43c3958e03834bb487e22797dd2157151db4",
      "text": "Mereka berdagang apa?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "1af1a9dfca36a022a4bd6ef9cbabdd10c7ef9ed3f62b5d9bade196094ca15ef3",
      "text": "Bahasa di prasasti itu adalah bahasa Melayu Kuno.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b2e6db7c7858126c6ef661d650dc3e3c6914ddc929976a952a474dfa72946fd",
      "text": "Adapun ratu itu, ia sangat bijaksana.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b91aea9f95daba73c040c0bde8aa47d6f5204b8aa298ab88fe3000295135cf6",
      "text": "Lewat jalur itu, cengkih dan pala dari Maluku akhirnya sampai di pelabuhan Iskandariah.",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cdc058d3804e8480d058eeeb0b17caf08f9c6599da8cef3ee7368d8108b3da8",
      "text": "Awak kapal menurunkan muatan di pelabuhan Palembang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e80294b9c174fa515894ed8596cd53f1d1e84d3c2084a94bfe176abf6cb38b4",
      "text": "di batu itu, para arkeolog melihat aksara kuno.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f550cbe43a6567ede592f4989453c9ecbdfd4c7558d3e25047bfbacf2e9e3e3",
      "text": "Mereka berdagang emas, kapur barus, dan rempah.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "21218f09ad21ec29f9892ea176382462aba75ef683a4849a68406fd11d70008a",
      "text": "Lihat relief ini, Mohamed. Ini kapal dari abad ke-8.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "21f71a70d19b8e143611dcb559e123bfb6177ed0e19a01e22970cfa40d96ea16",
      "text": "arkeolog",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "229ae67deb53e7b2bfe5f3ffac337bfdde99e345abd42f034b35c020e8a39c38",
      "text": "Penggalian itu mengangkat jangkar kapal dari abad kesembilan Masehi.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "22d5de447ef52826b0413b64057c73192d7b29a5789a479aadde4ed8ebe19d2e",
      "text": "Wah. Benda bersejarah di lemari itu apa?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2415867e93297a9320a471429cc94e9668532c868197f62ed8aa4b38415f1fcc",
      "text": "Dari abad berapa artefaknya?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "25bff41f8249ca6e7311b121499198ebf8f16ebb56d3b52e238b41eb833b19da",
      "text": "Ekspedisi pertama berangkat dari Tiongkok pada tahun 1405.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "26dd4aaccb43cf17df3b86f446998e19949abfee559a6ea6bf675b874e6ad119",
      "text": "Terus gimana dengan perompak di selat?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2787f35764dd8cb32e43cde4faeaba2a15cffd6f854290a74eba20a7691444d0",
      "text": "Mungkin lima puluh orang. Nakhodanya harus tahu kapan angin muson datang.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "303270bcb565d12b8e5036b2bad29f44148f68694815cefc243c995e1e53d208",
      "text": "Penumpang berdiri di ___ kapal, melihat ke depan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3370eb45dcad585519ebfb6517d64553598225cd01dafe11d1fdc20dfa98ac5e",
      "text": "pala",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3806d24ed432f88a9df5d64c207709ec9cf142366363ca0caee2fd82141c85b3",
      "text": "Navigasi di samudra lepas memakai bintang.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "38fb966293600c33a4167c1a4370d0420be167d1312e782f93705e070e8844dc",
      "text": "silam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cd10c80ea30d99ce26acd5b528b4e7162000fb8063827e558403208decf7871",
      "text": "Selat Malaka menjadi pusat perdagangan dunia.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cdf10534b1554e9b6abf3e5b5f7059251471bf327aef0feb9cd96ed2e041ca2",
      "text": "samudra",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d269580f450c0b11ba8b897b6b720cd9ff9a0825767d33ee7a29f7c36e253f0",
      "text": "Dalam penggalian itu ditemukan artefak dari abad ketujuh Masehi.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d8641557ba99f8e3cd4a439e375f609093d103b320444603e9653f8500a4936",
      "text": "musafir",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "40c3318f7bcf1a7ff8c3432bf5beebb6dd0a3e712247f9be31619b429acd3373",
      "text": "abad",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "41fec359094380e395158260d7ab717ecc352153c56944e692d625166e0ab5c1",
      "text": "Selamat datang, Bapak dan Ibu. Saya pemandu Anda hari ini.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "446785312332869e773d8dc53c9c90c2265fce7901efc1a3501dc9f2c26392bf",
      "text": "Peninggalan kerajaan itu tersimpan di Museum Nasional.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "462f628be440ed99872ea58442eb8011d500bbee69e3d4bdb1902499b6716ff4",
      "text": "Sempurna. Tambahin satu kalimat tentang peninggalannya.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4651fac0785b6e4999c057289b934cd512f2a641ec6f94c6c79dc86cddc00ea1",
      "text": "Kapal dari India berlabuh di Sungai Musi.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b7f7186450cdb4ea6bfce44cc53541e32fbd5ccaa69524c4a8a1eaffa61851a",
      "text": "kesultanan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fb68c25751797ce9baf72cb026054d3bbdb01f5e02609a679d20a2fe449a0c8",
      "text": "pelayaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5035aa30de01904a25ebc42057bbd0ef7cfe496b0ec0f1d81dffa26332d7ff40",
      "text": "konon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5154142b73588fc402f5c912ac1c71d3fd8946f4d6ff184ff47466892d3a2d6e",
      "text": "armada",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "581706d1bfcb197c7741d61b086695c0218ef949d231d1cbf7b58c4b420b7cd1",
      "text": "Mohamed, masjid di Palembang ini namanya Masjid Cheng Ho.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "59ac098ae1aae19c72d58e753bc19a1f3dd154d7b0ef7eb9615011f6c8dfab97",
      "text": "Cheng Ho memimpin tujuh ekspedisi besar antara tahun 1405 dan 1433.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b0c3a12c134160b17ead502da94c43d89561b61c9e95ec490c3bc1a28de7df6",
      "text": "Mohamed, kamu tahu nggak, Ibnu Battutah pernah datang ke Aceh?",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cad4ed5804b7eeaf18c2d8564e815a11d4672c024df5d18fa8f0e3fc6c383a8",
      "text": "Sulit dibayangkan. Dulu di sini berdiri pusat salah satu kerajaan maritim terbesar.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eb13996bf55189f6c89cab575a5c959abbdafd82c6c07b581670e563b427e0b",
      "text": "Kak, aksara Pallawa ini sulit banget dibaca.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fb871c3a32e73359f83e2fb119c5801ead2cd63b523d82a96aa63adf6f3f5fb",
      "text": "Selamat datang di Palembang, Mohamed. Konon, di sungai inilah dulu berdiri Sriwijaya.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "62b07b4df50abd0123e6b1adea111e4ba924dec1d6395fcfdc8c703b03b4efe6",
      "text": "Sebagian. Takhtanya sudah hilang, tapi jejak kemakmurannya masih ada.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "6533f5c10b37466d5e9fdd31d6257a0f627914b456e4448ebc147933b478d1eb",
      "text": "Benda bersejarah ini dibawa oleh saudagar dari India.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "69b261941f3027e7ccb5bcea6ea28e78ea43ba7f9c5099c3bb170cc8eb983d76",
      "text": "perompak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a699eacc779c48ca670510d7d2e326cfe16c72b3a0fe25a1baf6354f408b6af",
      "text": "Raja Samudera Pasai memeluk Islam setelah bertemu saudagar dari seberang laut.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cc6e291df4a342aba29a02e91409213afae7a0793646efde4416a901ac907e4",
      "text": "Musafir dari Maroko itu? Aku pernah baca bukunya dalam bahasa Arab.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d0cf63ffb83bed3f6ed2394dc80eead18106e3fe561e375684dc907b602d416",
      "text": "Komoditas mahal: emas, kapur barus, gading, dan rempah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ed58380832f65ac2ddebf138f45d42d30458e0065cc46518be32454adf52662",
      "text": "Jalur laut itu ramai oleh kapal dari berbagai bangsa.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "70535c5c4dd9761c376a2c91f3d61115191fbc016c5087f2f54f5e4157be72ce",
      "text": "haluan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "72fff287f38d7e2fb748e6df62572a7062d4c72d6867e8dec7b0ab50e6ae3545",
      "text": "Betul. Karena itu ada kata \"kabar\" di bahasa Indonesia.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "741b29ae36e21c4cf5739434b025ba64743f15dc2acd6c31f1457c43bef0f18b",
      "text": "benda bersejarah",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7663972ada321fc1df6a94799bc4830b24f766ea6985b2fffc0ce03503e2b905",
      "text": "Masehi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "78e13ce709287effa22c1bef8cba476c5cb9337b51b0034e8c38259d30caed15",
      "text": "Di sebelah kiri Anda, ada replika prasasti dari abad ketujuh.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "7982b0a16cff36b886709b61281d56c32170c6646b6be1f18c7f7e8707dd1495",
      "text": "Angin muson membawa kapal dagang dari India ke Sumatra.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "799120f1265b3cdbda8e452ed43d7da68b6bd811aee8081b0c00eddca168ed44",
      "text": "komoditas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b0eb3b826530f7e01964208b9bf5f97f821360fd3834541a3eb77510563234e",
      "text": "saudagar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7bd488c8cbc057c44b6daa38ae5b7144997a8a13febe3ba2089342a663cd8e4b",
      "text": "garis besar",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c8044fc39f2a35aa85e370f5b90da7af65d606439b43e3d2f2633b78d3a201e",
      "text": "Banyak dari abad ke-7 sampai ke-11 Masehi.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f676c42cc176e7b8451f59f424ba7100bf4bc9e4292e5412f7eab58c26f00e3",
      "text": "menguasai",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f7564c372f0f3adbc4853b1518c1eea4faf23ab386c121c8f6387be2d34bd58",
      "text": "Dia singgah di Kesultanan Samudera Pasai dalam perjalanan ke Tiongkok.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "804b745c27246cdbf93f1037d0a3d53803d18be214944d8d65d5020e8016ec08",
      "text": "kemakmuran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "80986c92fba0faa858920b01ae8f0f803c0fe28a99657e5fea7f2f02f55a2523",
      "text": "ia",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "835229811fb8b1d23f788f4b2ce60c6b1137146a020e6d7814f1fcd8c6de5af2",
      "text": "Lihat peta ini. Sriwijaya menguasai jalur dari India sampai Tiongkok.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "84018ec9da00ec315b6e6dc8ef01ce5aad3ab038330e1212e7527e61448d0bc2",
      "text": "jangkar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "856bf8b3bc843fb501676c64666d9c87c137643b5a15f4c7779046a530d78a3d",
      "text": "Garis besarnya, Sriwijaya berdiri, berjaya, lalu runtuh.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "8616a85388468d6d858f5d86b74d05148370d376bb44604ec75685e6f7edc1b8",
      "text": "Jadi Palembang dulu kayak Iskandariah, pusat ilmu dan dagang.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "874ac10be68f452a40c3e8d99fd8af75e9c1b8723d01ce9bf2445166f93eb71f",
      "text": "navigasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "89a92b2ccbb0da7630cb93b790d9f83f83521b4ca81845c088640159f68637ba",
      "text": "nakhoda",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c872b5fe3aa94f78c770016cd808aff45f514b9f144cd2b7419d3079606f2df",
      "text": "memeluk Islam",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d51f0a6866fd97c911c608e09936e271bf872091589044d4b6bf15eaa64e34d",
      "text": "Pala dari Banda dulu dibawa sampai ke pasar di Kairo.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e4e4c0f207a237dc0e35a89ad7c5df1d5f093030060de9be481a42b74cf2850",
      "text": "Dulu, tahun 700-an, kapal dari India dan Tiongkok berlabuh di sungai ini.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ecfc7385a8e3c90ebacf2df1f2bf51dbf1cc1fe8d13eb5c4442bbd10045d303",
      "text": "Batu nisan Sultan Malik as-Saleh bertuliskan tahun 696 Hijriah.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f3532c20a5d6027178766e0dc828ed3c2b97ab12e8e73554e262d1d82957824",
      "text": "Dan biksu, pedagang, juga pelaut dari seluruh dunia datang ke sini.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "90edb3d466b43cb52e5b6c603de6cc737496a7237adc6f02e7ac6765c1304744",
      "text": "Nakhoda menunggu angin muson sebelum memulai pelayaran ke Tiongkok.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "91948a07851518e520807d9349ffae8c0e1b40ce7f0614e7ee5ce065561f9f58",
      "text": "Cheng Ho itu laksamana Tiongkok, kan? Kok ada masjidnya?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "91f8a44495023f0c56f34dc1ca7b3ba877af3ae6244df739383e8385c68e71d2",
      "text": "Jalur rempah menghubungkan Maluku dengan Kairo dan Venesia.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "95c1a0e2bd1af4a51f50bf9d3dae33458acd7c9a6d24d9759bc7f632e0c458f0",
      "text": "Ceritakan garis besarnya saja, tidak perlu semua detail.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9858b39cc6a745478abb352ecb269682aab3565a27c035ed835eb6a444c88429",
      "text": "selat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9865a1ce2cecb4187afe0c3b9e21200fdeb6db8138c7b5d1d861b52186231652",
      "text": "Muatan kapal itu adalah lada, kain sutra, dan piring dari Tiongkok.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a81564654e41b75f09a52aa11af829d3f30385f4de56e4cf90884f0e73ca765",
      "text": "kerajaan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c02ad5353b9ddb5385fc462c00745dc54d0b026db5e6685c06a3f58a8224b48",
      "text": "peristiwa",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c1f41a6aa9764c80c5107960fe7ffd33190efeba1bbf1c43a47df45823c2276",
      "text": "Kalau gitu, datanglah dua piring pempek!",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ce0e273d94aa1bf22b16ed462189ef6258a286af7097d88b0ebd6b01c3615a1",
      "text": "runtuh",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d4e905f4bcb1cd002fa5238c339803d56ad4f1bbe882decb713010edd439b7a",
      "text": "Kata pemandu, ini muatan kapal dagang kuno dari Tiongkok.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fe3310f17015d78bae560e418b7d9f4828da25be9ea473f42e8f99147bd88e9",
      "text": "Masa jaya kerajaan itu berlangsung beberapa abad.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a05a0bfe89314641426952e7fa1d15f81af082adb0469325aac1d94b1be47ea5",
      "text": "pemandu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1d74320092a227ba6e105029e43cafb6830629cc3cbdd4fe0fc0e64334707f5",
      "text": "Pada masa silam, pedagang dari seberang samudra berlabuh di Palembang.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "a22a80edc2938c27a81f7da288339e9d1d4d3ed3eb5aa1a6c320a4274a1aa989",
      "text": "Tanpa navigasi yang baik, kapal bisa tersesat di samudra.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a31b19051ea3e480f41bb1bb66335ca297b7ea85d5a0ac569bb1f7678e66b5ae",
      "text": "artefak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a41be14e868095c9c5b46de98a7c0391f992bdb360ccd73d9310fc21a07d7fed",
      "text": "Prasasti Kedukan Bukit berasal dari abad ketujuh Masehi.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a42b4de9da783d04738562d82e8db949e7c7f8c3f907ac4ae427f59eac7bfa32",
      "text": "kronologis",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5e60e01ff9465c7e1a940717f6698a1ad65f7d365ac5867ba7488cfdb2b564e",
      "text": "Ha! Adapun pempek, makanan khas kami, itu cerita lain.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "a74baa9feb397508a000a614df671e9e248d2b9ebdc15361b20e11931a62a4da",
      "text": "Pada abad ketujuh, berdirilah sebuah kerajaan di tepi Sungai Musi.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "a877589a38e4b6be433c4d6ba5d8abd76beb32568d12aff9daaba6b81d79bb01",
      "text": "ditemukan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a970ddf511a6180a1ff4b559bb7e738aac68fb8ff6d41a72a32c65d0075bdda1",
      "text": "Sayang banget kerajaan sebesar itu runtuh.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab387c9a8df6c8e47479ee9d1646a79d1379b1179d03c185d7ed509fd1dd92e9",
      "text": "Pada masa jayanya, kerajaan itu menguasai banyak pelabuhan.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae08ba7f170b7b568b51ffb87be8a8ff6581efe4d393d1f5096084d752f019c5",
      "text": "Konon, raja pertama datang dari seberang lautan. Ia membangun kerajaan ini.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae52483afc24f9eeec4520ab78736c4d24eaced8a423a37aa378c2de4a6aceb0",
      "text": "Saya ingin menjadi arkeolog dan meneliti aksara kuno.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "aee51a530f9827dda2daacc225ad5884508388a2a9b24b9a0971c872ecf0327b",
      "text": "aksara",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "aef23a9a63f138495e1503ced6336d2020625b68315a84b669285c3010c960d8",
      "text": "Menurut musafir itu, banyak penduduk pesisir sudah memeluk Islam.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b06bebc427fae2f85703b79012d6a8e0517821b8dcb9eb561668891bbce400b2",
      "text": "Bagus! Jadi jalur rempah juga jalur bahasa dan agama, ya?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b36256a614ffa1a7c641b098a2fd3a995d32066fb6a9ead46a3418c018993ab3",
      "text": "Dia seorang Muslim. Armadanya beberapa kali singgah di sini.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b59c7a2c7ff5fe3437e1dff25bc26a74e5e736ed1b03fac97a0c26933c033006",
      "text": "Kerajaan yang kuat pun akhirnya bisa runtuh.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7098d95375c60a1a4782c3e7888853b9b3efb6836646bfc95d1f732db2a72fc",
      "text": "Tulis garis besar aja. Tiga peristiwa, secara kronologis.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b81917f83e51bf30607956c59a8d91ede242556e94f31aeba8a899cabca84a5a",
      "text": "berdagang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bab8624014aa1c8668b9deb61e0ddb90d4beeb55da038475325c53d49de7d436",
      "text": "prasasti",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc8b95cc63cf0905736ca963a04b6e80e161f2c021ab91779a49cd635a866b73",
      "text": "Kalimat Kak Dewi kayak buku sejarah! \"Berdirilah sebuah kerajaan …\"",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcc422150d00b27a1f70e4702ca7f7734a5026743f38759e890102b70261ffe5",
      "text": "cengkih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcd4c857a0738e0481b728e0fccca0c689788eefe3777d9bb5e175fccd402887",
      "text": "berlabuh",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcf355b5c98b3dccceebbbfa3c22c8bef5210b4ee5c64503ddbe11b024dcec81",
      "text": "Putra mahkota naik ___ setelah ayahnya wafat.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "c13bb60adc71d43a7c069fbbbf5081333ce33bc1961214437bd4e03370ffd274",
      "text": "Di museum itu ada artefak manusia purba.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c16885bb4640f66738c59f13ed5842884144c948a1c9a0f5df490662961127da",
      "text": "Batu nisan itu ditulis dengan huruf Arab yang indah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1a01bc478e8434886bec19018de0555c874879e9d45e6dd49cbb1c77d4e907c",
      "text": "biksu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2d592c7618edd55573e76f9be0cb10e92f1dc9788d5ca5982dbbd352b8e457d",
      "text": "Jadi kota sebesar itu terkubur di bawah Palembang?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c78a5b9e9b1a64bd6b0c3c385394211f007cfc09c2f860c1f0480ac47803a08f",
      "text": "Dari jembatan ini, kita bisa melihat seluruh Sungai Musi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c85971fa4baae293c3de3f2e0c600f05f49ae450b23ef11beaac8e2e4af9b0dc",
      "text": "Kata nakhoda mirip kata Arab Teluk, \"nokhidha\". Pelayaran emang menghubungkan kita.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "c88b962d9d756e45088e75ca07cda52a77033f1d0560440f48b2bb4a3399f72b",
      "text": "takhta",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c91822d3bb442a8f69ade379e9d46686d5ab310f853f1b1af50852e0eebc0ac0",
      "text": "Itu batu nisan dari Pasai. Konon, pemahatnya datang dari Gujarat.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9ccf6ec72f6a71fd816bec9d883242883f0ef40a85ba993dcefe536c20714cf",
      "text": "Perompak menyerang kapal itu di Selat Malaka.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbd0c2a9c240f633d7c59627651abc7eeea4df43fd5440a4c229ac22383aeb8c",
      "text": "terkubur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc02c1455ccd2ea9cc810e1368ed0f59db07121c186c82e6e944536c6ef83f0c",
      "text": "muatan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdbc71cb1212006b7680ccec85ceaa87a512478aaaf49ea7fc7a92e74027bf0f",
      "text": "Para arkeolog meneliti batu kuno itu selama bertahun-tahun.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d02dbe0b0ae93337f32adddbd6d97a7b693481321a20755fae0eb85827235bc7",
      "text": "Pada masa silam, raja Sriwijaya duduk di atas takhta emas.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d10619d2a2e5e9b4baa55483da7680f5ff7401a15dbe213eafd4506e84a76e7c",
      "text": "penggalian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2103aca88f6e125a7b623ccb6a7a82301273894e12f65fc3fa341e3bbd0191e",
      "text": "Armada Laksamana Cheng Ho singgah di Palembang dan Semarang.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d309c033e661c26bc4ee931016afae0fed462e83606f17a7758a7dd4d92fe9eb",
      "text": "Hari ini kamu jadi pemandu, Mohamed. Aku pengunjungnya.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4b2dbfc8d7b0a7377318c639ee69aa305ae70973a6087e2f839f099fcdd6f63",
      "text": "Berdiri pada abad ke-7, menguasai selat, lalu runtuh pada abad ke-13.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5753b87920f8b423cb8df5f688c560776120757604f21ee86ff7a38c979e8c9",
      "text": "Hurufnya bisa, tapi bahasanya Melayu. Coba nanti di museum.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "d648e97ca8b83d80a111cf14c5afaa10565f515fcb73ef0123de896ddfc2f3f7",
      "text": "Emang. Setelah Islam datang, orang Melayu nulis pakai aksara Jawi.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7acbce35a6a628e1a6cc8c7e28c3a418982a8aaf80bb61e1399e719cf8d645e",
      "text": "bajak laut",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dffe35128b8c85c02e6a028dbeb436d053bbb7d723ab8fc4a0639119a012c12b",
      "text": "singgah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1521a740f19f61dd143c95c8840254d0ec9a2c1f6d76d1dc3f3a37fd26f6045",
      "text": "Selamat datang, Ibu. Di sebelah kiri Anda, ada replika kapal Borobudur.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "e15646b3ab54859d49eb2c35a87d4056d1fd90a87ca3ec7a384371a803460a00",
      "text": "Pusat kerajaan itu terletak di tepi Sungai Musi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e39bea5b9c2b48e8d55f5ebf403cd0c10f52fb70018ec2d3c5be5c5ea1780e6b",
      "text": "Jawi? Itu huruf Arab, kan? Kalau itu, aku bisa baca!",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4a9836c516ab3c081d4639ce225d929d8ae13798927bd28bdb45652d220c967",
      "text": "ekspedisi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4ad6d38733832e2e52b6b62351e9fe39b218258404727bf0904605e76fbc231",
      "text": "Besar banget! Berapa jumlah awak kapal, Kak?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea08e662b588edcd09b438389787e10a83cf2f009475e87c85768aa7db1df7a4",
      "text": "Kemakmuran abad ketujuh Masehi kini terkubur di bawah kota.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb3b9de23abf662f5aad2fe37bea332469ac945a1f5b2f5278e51fa817ecdec0",
      "text": "Perdagangan membawa kemakmuran.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "eca6b962943094b73e572f09f7c5fc31e82987c517b7df05514bab41e5179eaf",
      "text": "angin muson",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed08580afa437802cebf505b3cc048b990d1aa5029d7ebbc4c4f9e738147fe40",
      "text": "masa jaya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f38f698b6a426ca50ec76255e3d544d11740661cd295cb7f897109d01c79219c",
      "text": "batu nisan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4c0e7f9bcfdc6512a01d447297fcf492d7712ed5f92e09857fd3a1b76d64ad3",
      "text": "purba",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f62dd9f1e33960f41d8e4c01e9f2c9b19ba65c36f689f9e0d08f3711df2a66dc",
      "text": "Luar biasa. Dari Tangier sampai Sumatra, semuanya naik kapal saudagar.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "f986a1c0d36145023a11844d46a3b4e6ac1798c97ee743d47803447f635bcc3d",
      "text": "adapun",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    }
