  "language": "id",
  "unit": "bipa5.u10",
  "version": 6,
  "content_hash": "0be97d9cfa4ad2891188b882f4b49c02b6e0cc2db293c71acf84850cb806e612",
  "lessons": [
    {
      "id": "bipa5.u10.l01",
      "sha256": "cb77751377046790e13b2dbe1367ad7a59b78294fdc6973a3aa3423c73bc0321"
    },
    {
      "id": "bipa5.u10.l02",
      "sha256": "e634d10436e3b7d6b0886f8fc264c0ab4d771865162091df5a4ac0ad2a9a7d5c"
    },
    {
      "id": "bipa5.u10.l03",
      "sha256": "3934e089da3644d63c42d1c8b2c1e7af1148d6771eb4dc1453c8fe62b114e5c2"
    },
    {
      "id": "bipa5.u10.l04",
      "sha256": "a161bebf48d66d4a0b9792c9aad552126fdff1499ee735aa06a0871d29fe0ce8"
    },
    {
      "id": "bipa5.u10.l05",
      "sha256": "d41476586abeceec6dc86e70d39e8599b0b0d0bb548b34bba0d92f5c25e38c14"
    },
    {
      "id": "bipa5.u10.l06",
      "sha256": "e80b3562a0ea670f1f8349e82cce9352551e469f9a4bf320379d271826def6fa"
    },
    {
      "id": "bipa5.u10.l07",
      "sha256": "4d7f5e73da85b012182ead6d7bc73576cdcd5fcae00441169be8bc649f259080"
    },
    {
      "id": "bipa5.u10.l08",
      "sha256": "363bf883452b80151f72f2ffa468fda338e6d8bcd0536893e47694e2b4702205"
    },
    {
      "id": "bipa5.u10.l09",
      "sha256": "00f7019760422750d15e1c50a2ca89af0b130f76f4ed46f8957d2036998a773a"
    }
  ],
  "audio": [
    {
      "key": "010e63cde0773d11cf73ac1c50f54458ed1508effc997f0f3d8d54fde5a8d5ab",
      "text": "Jangan menulis terlalu banyak teks di satu tayangan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "0429ab289b14418cf3d655074e930c17ed9bb0f5d850cce6b8d76dc882bf7848",
      "text": "menurun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "05e8665d1f1ed26476b8dae2da4fa208ed104dffda7fa7f2f602205da06c721b",
      "text": "Menurut saya, Singkawang adalah contoh toleransi yang indah.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "07cb298068cd3e58c5fea87bdc9f34396005e529735dfb12cd7f43ae9133bb82",
      "text": "Mas, ini draf laporan saya. Saya menyajikan data dulu, lalu pendapat saya.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a0d0cfb00b938ec6b28cd029cfac4213ca7af1d9b401acd9c4cdfb3e2455c68",
      "text": "menyimpulkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e8ddb0553d70758f2e5dba4635092ae241fdd83e2db95fa1fc76b03fca9f0f5",
      "text": "simpan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "10955836b0de9216befbebd5c0c3ed04235f975878155eccb87e9dbe22dd988d",
      "text": "Betul. Topiknya kunjungan wisatawan saat Cap Go Meh.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "12b4e1d98e3cb7ef1da2488e0d3873ef688c16d5fd9d877dd06ebe87d8eb25d6",
      "text": "Apakah ada pertanyaan tentang kenaikan harga ini?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "12b68b92ebbd370669ed0409852054fa900c29e2a51de97bf6fb722cddf88c87",
      "text": "Saya menyaksikan sendiri kabut asap dan warga yang digusur. Itu juga bagian dari cerita.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "21080faf718ecda2ecf17fb78fc1dfbe071da213d3d6165527eb5c918620a8cf",
      "text": "Hadirin yang saya hormati, silakan simpan pertanyaan Anda sampai akhir presentasi.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "236d4a44474b710eebe2a4abd85f303f1a7b7d9888befc5cc348983f1a47fd6d",
      "text": "jeda",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2437a9a5de369c1273934a82cfa0b68458f6dfd48fc6ad141562544c7c84b433",
      "text": "Saran kami adalah menambah papan petunjuk dalam bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "2486a5777f49116c0b6ba58ab55fbe17663d6c221f4d589986f8d03eb4231166",
      "text": "pertama-tama",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2612d3a92e34784c6001200ab0ccc8da7eb70b46e9e0aa9eb67660627f61b923",
      "text": "Jumlah kunjungan ke Singkawang naik saat Cap Go Meh.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "284a08214da3e1c65a3c908e798a458e691edb99474b020a68a1b2068845908d",
      "text": "Kesimpulan yang berimbang. Terima kasih, Mohamed.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "28aa17280781b66109ece8320768e7276dff7bb3b6b4f5ccc563a364a534eac8",
      "text": "Harga cabai meningkat tajam pada bulan Desember.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "28dc0b2afcbd3d97fcdd3633e168b681c3f4d6aaa51db69b773e0bf7a7de485f",
      "text": "Laporan ini menyajikan data tentang keberagaman agama di Singkawang.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "29506e77986ce2f19843dc2281bb78a71e570f40fcb8619b2f8c8d363efdd738",
      "text": "jumlah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2add73c5186d81b092ada6c02bbd26ad24da0e006587da864615006b3cf9bcf9",
      "text": "Selanjutnya, saya akan menjelaskan festival Cap Go Meh. Oleh karena itu … hmm, belum ada hasilnya.",
      "voice": "id_ardi",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d1b995db95e3bd5dadb0bc9f6c81a45e1654849d2bda8ea49176ca7f6691d10",
      "text": "Dengan demikian, kesimpulanmu jelas. Toleransi bukan sekadar kata di sana.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd3ecf4b051a56b3794940fb85a1793011144c9246a32fadfb1a18c5602a16c",
      "text": "Ide bagus. Tapi warna latarnya jangan terlalu mencolok, ya.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3065e9b7d9c376745ea767ea99218edde4c67000b7f88f4e35eb3d4904e809d0",
      "text": "rata-rata",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "337ed9ba1d9054e705057c37c7601f4cce501f9939d0b6bba003d108ba131e56",
      "text": "penurunan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "361255a05de953350dbc143d80de42bbce68ee295cec417f10dbfc334bef11fe",
      "text": "Foto Cap Go Meh di tayangan pertama langsung menarik perhatian hadirin.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "3684ba30d76cbefed97fe0396d7cc5a9d8679b015968248f0f40e0b87de6db53",
      "text": "Menurun lagi. Rata-rata hanya separuhnya.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b1051dd73e34b33e234e9812022408cc2051e7baa0090bdefee4b04e3c36a2a",
      "text": "Saya gugup, tetapi saya menjaga kontak mata dengan hadirin.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c70c91c58be422a04c8a6890d5843933ab748fbe15bea42c3ed13b3d478000a",
      "text": "Bagaimana dengan penurunan setelah festival?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3caa5756c4b314afa63f11110f07613308f9ce914c8221eeee2e692e4feeae5f",
      "text": "pertanyaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eed9f491e01c1e7c7d8f2edbc4401f5770a2064692979f0f6de1bf97f694156",
      "text": "Penjualan kue keranjang menurun sedikit setelah Imlek.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "433d0a00cd03f6babfcfc47c8b9bde5af6fea7c8b2da52fc7d48f5ac1fe45aab",
      "text": "Hadirin yang saya hormati, pertama-tama saya akan membahas sejarah Singkawang.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "43e3ed1caf90d8250e4db42d203b8d0a1b5f7d37692c84b7ba89c39f3024982b",
      "text": "Hadirin yang saya hormati, saya menyimpulkan bahwa toleransi adalah kekuatan Singkawang.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "45a4d3008e379a1f2ff047d0e1732d2daa2654fe3d8a88f4ab5490d1f15266de",
      "text": "menarik perhatian",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f293d48213f494f845bc36302da69594d25f76a3b9ac57112949c4cdb6e74ce",
      "text": "Keberagaman di Singkawang membuat warganya hidup rukun.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ffb93d6e46310b8b2365a2557c4852e7d5647fa4a5f67f3a64a90401b0956cf",
      "text": "Jangan gugup. Jaga kontak mata dan beri jeda.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "506eab801f9e372ddb4cf2c15445299b1736396611729c8e55338bce81fd6e71",
      "text": "Rata-rata, setiap keluarga punya dua sepeda motor.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "51f69f91b00dd4b07f6febf3b6da3f767edac388916886aa88b5f227abf9265b",
      "text": "Pertama-tama, rumah panjang Pak Lawing dan suara sapenya yang merdu.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a5b4574199c5ccd224bf56fb0507c1cd034a4bed60a092c57e95105691b7aad",
      "text": "Perjalanan ini tak terlupakan karena saya bertemu banyak orang baik.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cae1f2c133160f481ebb6a33a3cc3329bd573b305e7b3f058008b9e9ff3f085",
      "text": "poin penting",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5da28f1be04cda8a594919b5faabc2c4224e62863767c81abc4a8f2f3afe552a",
      "text": "Mohamed, tayanganmu penuh teks. Hadirin akan bosan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "61a5da4dc5dd00f6c5647e6d7a1e1925ee7507faef7d45bc082af779e55764c3",
      "text": "Berdiri tegak, jaga kontak mata, dan beri jeda setelah setiap poin penting.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "6431299bfa7901d5e6fac2f802a4688f19020f2fcd70e0df208cf5aa1561082b",
      "text": "Selama perjalanan di Kalimantan, saya menyaksikan Cap Go Meh di Singkawang.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "67e3fd5fc7c5fd3c6a9c56c202e7478610d3fa950446d2b8dee0d585727bc615",
      "text": "Pertama-tama, saya akan membahas sejarah Singkawang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "68798432f1d140e129c6ac7e73060a8d934928eb25183495f4f1c4f1e0cb59b2",
      "text": "Tarik napas panjang. Kamu sudah latihan tiga kali, jadi kamu bisa percaya diri.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "689a17bbb4661d850760c6c3cfd6991f1e8cb7fa0be54f389c7278966c424d8f",
      "text": "Simpan untuk kesimpulan, ya.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6933109b4f78582eedc10d66d1005f0b8959ff63f7dea7578c75dee041db323c",
      "text": "Kami menyajikan data dari tiga kelurahan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b3c9277608ef741dfdd4b69bfc32c06418cd4a6144c7d05ab7815a08c40939f",
      "text": "Pertanyaan yang bagus, Bu. Tampaknya pedagang perlu acara lain di luar musim festival.",
      "voice": "id_ardi",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d31e6cacc8ab42ab49d2b1d82efeb7f531fba56716fcc07891095c162844b8e",
      "text": "Terima kasih. Apakah ada pertanyaan dari hadirin?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d7fc11a9ef1ecc81ade3249aa641288eade840ef6c90635b063fd9a15f25489",
      "text": "percaya diri",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a4d14f2666eb734a56a00fe90588115036c0933b649c36954741d506c9ed82",
      "text": "Datamu jelas. Tampaknya festival sangat penting bagi pedagang.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "717f84345bf15543d66d77d9c16cf1ed4cccd7d58908e99c96d7a9df09fb029d",
      "text": "Saya menyimpulkan bahwa penurunan harga terjadi setelah musim hujan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "718306369cd6e9920ae3375eb2a1770d302801640d8c45311d32f341b87fb8a1",
      "text": "meningkat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7861c38327331b3ed2527f5d097d85148207e29c03f172ba748e5f350642edc0",
      "text": "Laporan ini membahas kunjungan wisatawan ke Singkawang.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d717cdcabf0f19c7fea57de31ab3435172c6e1b562e6ca33250861e239f4b92",
      "text": "Menarik! Saya akan bertanya kepada wisatawan dan pedagang di sana.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e29ca1cb62c59b34d9cfb1f47be0dbd1e8e89cbd9ba6dbc14ffb5e630053e93",
      "text": "Oleh karena itu, saya menyimpulkan bahwa Cap Go Meh membantu ekonomi Singkawang. Apakah ada pertanyaan?",
      "voice": "id_ardi",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef1a66d66f77cde91db8cb3164fcbad64cb1a8cfebba5e2db8e53760f6aee1f",
      "text": "mencolok",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "84f553bb419a4af174a5e3e3189e8538c779140e4af75f52b3ee2e4f043482a5",
      "text": "Bagaimana dengan hal yang sulit?",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "8622da15fc4eb20ef16e23924786f2ff3d13ae954b0757ee8ed65d9068024b3a",
      "text": "Mohamed, perjalanan kita di Kalimantan hampir selesai. Apa yang paling kamu ingat?",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "86d710482868957e7f21742d8c5b00c9a3be955f955b295cc202500813d06722",
      "text": "laporan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "870cfe73d474393016678a716a99d729e4cb7a652d74a24d1cb4656ba15efbc3",
      "text": "grafik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8850069b44aab3b3e0b41873abfe5413ed7cabe4682d528642c97c19943642bc",
      "text": "Hadirin yang saya hormati, pertama-tama saya akan menunjukkan sebuah grafik.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "8aee24299b70d6966afaf52f092b7c9f886cb34d26f97a7dbc17f36f27009acd",
      "text": "Grafik ini menunjukkan bahwa rata-rata harga beras naik.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d58b52338be7d860254edb8119cf9ad6e9fd2f4b7849acb6c3a6a4a0a7fdc11",
      "text": "Jadi apa kesimpulanmu?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e38bf269ba703aecd75035328c875fa2faae1312dc25992a7f55c9f729e6a4e",
      "text": "Warna merah ini terlalu mencolok, jadi saya memakai warna biru.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f6b134073c1816b40cdd35dc672544a830eb54f868dda87f9679bdb63a9b1aa",
      "text": "Sebagai penutup laporan saya, Kalimantan tak terlupakan.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "936c15720cdfe886e38c59eaea1b26999e5d141c476086e2d3ff6d147a11bcf6",
      "text": "presentasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "941c0591da23c3ea7dd998e1d2f2c563af0ed1b1fe2f866ca3cfa4834f078858",
      "text": "tak terlupakan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d6904b51b3b86c8a922a8bd081858630dffe18f70c7af884cb94c2feaba0e0",
      "text": "saran",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "986ee409a44963b31700e29dfc14303099485c6fa64e83bf8248f5b580ab1e68",
      "text": "Betul, \"oleh karena itu\" untuk akibat. Simpan untuk kesimpulan, ya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dc426f2e5c27a01def1952d816d2d9663544387c11c9212f649d19c70d6847a",
      "text": "Di Singkawang ada vihara, masjid dan gereja yang berdekatan. Warganya hidup rukun.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e48f9fbdcb0b03ec8a9518533bbaf7de2a77358e7d67793c17caaf12dd481d7",
      "text": "bahasa tubuh",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5ffb9f877538dbec951a1e600552275eb59c95535207fe0918acc1abab410ac",
      "text": "Dan malam ini, Cap Go Meh. Tionghoa, Dayak, dan Melayu merayakan bersama.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab13b8f44ded643a2b66e0326818ac5abb192df146c1b3e6721d379d3eadd6e1",
      "text": "Pakai foto Cap Go Meh di Singkawang. Itu pasti menarik perhatian.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2e0cd9e8d61e8e79ae58dda43be6692c21e57092d73793317187446eadf0b59",
      "text": "Sebagai penutup, Kalimantan mengajarkan saya arti toleransi.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b48e2fcd0a2cd9e74831d5a92200b8bb6e1f79423d261b858a4c863231800bdc",
      "text": "keberagaman",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b56bcbc40f514860536229c9b0de64b3af91eda7ce94283dbd266354671114fd",
      "text": "Dengan demikian, toleransi membuat warga hidup rukun.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc4329f251b1a2e1b20bd3b353a196cc02fd48419433a84d52a52cc7406d03eb",
      "text": "menyajikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd6b2d35f502b7030931a96828d7c097196d6bf99ea3414bea11137f442edfca",
      "text": "penelitian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c26f045d1ed0141a941b841fd09749af9af03f7071a046d3bdc9e2cf73a5ac7a",
      "text": "kontak mata",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2728336826c2d5b2cadb8a6803af2b45682c39598e3e804df5bd5b8dfa9ad75",
      "text": "Bagus! Lalu bagaimana kamu pindah ke bagian kedua?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3325dd4c16b8ae11019c846e18e142a533236e0ab45f6b653b34d497443a7f5",
      "text": "Mohamed, lihat lampion dan naganya! Semua orang ikut merayakan.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c38218914cbd20f1ae3e50649260bdef41c9b51f1d2c45908592e9a2afeec0cc",
      "text": "kunjungan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5d3dd7a3f5ee3de57abcaa4e64687a3db0e8af7cc7b195a15c924c0084c9eee",
      "text": "alat bantu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5d44530d3912eb61532560539d708e62ebdbce41ce2400dc9234603d87ac61b",
      "text": "Mas, saya gugup sekali. Hadirinnya banyak!",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "c74a4a51dc5ad803a92ce1f7a8c38619e0a2db237976d693f7d9065187be75df",
      "text": "Bagus. Bagian tentang keberagaman sangat menarik.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c78ee5fa4705f62aba778bf967023d2e971615c17e3cfef546e0a044ac49c108",
      "text": "Penelitian ini membahas kunjungan wisatawan ke Singkawang.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7e5574f7e0fb303a861bf3c2502f91ed95a94a412ace206cd971534891825d8",
      "text": "toleransi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c92a4ea93cbca463bf1325750c7915cec4f4d5257f8042253acf98826c39d84d",
      "text": "menyaksikan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d145e225763852780c8fd0b05b439453e40e7b376923181530e420d310055402",
      "text": "Bahasa tubuh yang terbuka membuat pembicara terlihat percaya diri.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "d43e4b3ed6d88843a55332a7daa1765675ae56c499ea36ceb6d1eb11c1004b29",
      "text": "Bagaimana dengan bahasa tubuh saya? Apa yang harus saya lakukan dengan tangan saya?",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "d62b337dbd54f6148c7dbfd2ad35c058bcbac0516cb2099aac81819dbf852ac8",
      "text": "Pertama-tama, presentasi saya terdiri atas tiga bagian.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d64c54b32a8f9c6eb9b8bc30936b731f1daae5fe6d6ad05759b07b2345e97ecc",
      "text": "Ada tatung Tionghoa dan juga tatung Dayak. Ini data terbaik untuk laporan saya.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8bf9c0f08833f63678ed158d548dc8c4351e3f5ebaafe25b51bec0e999c2898",
      "text": "Saya menyaksikan sendiri dampak kabut asap di Tanjung Puting.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "db6253759428896ccc24f9b72c4f6fecc65db268ae6eb1e85516c6b96138a7ee",
      "text": "Sebagai penutup, saya menyarankan festival kecil setiap bulan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "db65d7ab76785658e759fafa0f4fdbd504c7f434f4e7024110e20bb9bdec8380",
      "text": "Pertanyaan Ibu sangat bagus. Saya akan menjawabnya dengan data.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc0bc27e50000fee719034df1ce045aa755714123ec05e79544c825ecc7ec305",
      "text": "Ada tiga poin penting yang ingin saya sampaikan hari ini.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd93f9869314769f62a2488b7547e5b26f799cdeb647ef4c2ba58ece01774f13",
      "text": "Grafik yang sederhana lebih menarik perhatian daripada tabel panjang.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "e39502409bf1584a24a92b5d2ab6d1881fa76179e4c00620dc8df6222a6651f4",
      "text": "gugup",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6617fbc591b19cf6e9823a28dacc245d6f45ac953d79e543cf1fc66a182823d",
      "text": "Rina, lihat grafik saya. Jumlah pengunjung meningkat menjelang Cap Go Meh.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7f0e37b61f09b41d5e1f425a9eb46ed248682fb7db8d6bcd9d2688eccd42a97",
      "text": "tayangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e93dcb73af7b59d0cbc5574a2d0a9089526db1e2eaa95bbd75062d7fe5a696f6",
      "text": "Baik. Pendahuluan, hasil penelitian, kesimpulan, lalu saran, kan?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9c08d7d3868b235911b10efed5ebd18ebbb117a9c6c38423d56572e6bc3e2f4",
      "text": "Keberagaman bukan masalah. Di sini, keberagaman adalah perayaan.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea6ad149900a17ba60e836957fa250b5cde651b5604288905ab3b4822c8a93fb",
      "text": "Jadi saya tulis poin penting saja? Lalu alat bantunya apa?",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "eed70d29c22d7380d81c0b801aacbb79c153b279c3a378f5bd171d726c435c34",
      "text": "Sebagai penutup, saya ingin mengucapkan terima kasih kepada Mas Rizal.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa3b6c8776607aa80e7c5d86434b9a9d982bc26ebb825ce49c43b8ba1e4c47e7",
      "text": "Mohamed, tugas terakhir kita adalah laporan tentang Singkawang.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa84488d5309e6a690a57096f204fb827628111e7ebd1a77259807ef7629bbd3",
      "text": "Sebelum presentasi saya selalu gugup, jadi saya menarik napas panjang.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "fceec7dc08bebfcf973f8c2f175bdd73beb8238092193d87d7adf594f5741697",
      "text": "rukun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe223c72f6a6d6c4184f23015f5fcf9667dad1e932cc4b25ed67dda67bb85883",
      "text": "Lalu setelah festival?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 9,
