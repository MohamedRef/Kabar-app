    },
    {
      "id": "bipa5.u10.l04",
      "sha256": "6c225c290047831fe8dafdc5c434aa01d4ecd047294c52690285993ba9df7edf"
    },
    {
      "id": "bipa5.u10.l05",
      "sha256": "29db37c22134c520461d720e40a1ab624b2d7aeec06e237beb97558f6f5d8f83"
    },
    {
      "id": "bipa5.u10.l06",
      "sha256": "783b0eea845b46c6a8d16328dfd7f1079f037d05181679ffd25de5ba439318c5"
    },
    {
      "id": "bipa5.u10.l07",
      "sha256": "6b10ac9133f67ae21c2043f62977288c6450cbbdcbdfa111d65d86a6ee4a25fc"
    },
    {
      "id": "bipa5.u10.l08",
      "sha256": "c21c81b40ace23c229e5578474810056b8f5d51e10327b9a5de27e92d16b5f6e"
    },
    {
      "id": "bipa5.u10.l09",
      "sha256": "99206fb592a0b5d79e041a468c95a2106dbd93bb4f947f38b83b44f6c248becc"
    },
    {
      "id": "bipa5.u10.l10",
      "sha256": "e4943dcca7479ecb8854ca5a880f83dd1cc31165c10f02ae4ed4a5e41ce446c9"
    },
    {
      "id": "bipa5.u10.l11",
      "sha256": "ea03b02539cba232cd3df82ebd324f692811cfc290ea73cd52a1c927f3763477"
    },
    {
      "id": "bipa5.u10.l12",
      "sha256": "1dbb8733b5cd6c4e4a8cd56be74f1d45503e944b4aae2c68cc9b2fcd3b70088b"
    },
    {
      "id": "bipa5.u10.l13",
      "sha256": "dc6dc8e76da4bb77157f5999155971378e658f7d7cba742d870c0ba1959389ca"
    }
  ],
  "audio": [
    {
      "key": "010e63cde0773d11cf73ac1c50f54458ed1508effc997f0f3d8d54fde5a8d5ab",
      "text": "Jangan menulis terlalu banyak teks di satu tayangan.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "01b7df87fb95946c8f08c0181fdd1f1df71f7db2fbbb472670c6723c8511e3a1",
      "text": "Kami menjelajahi hutan dengan kompas karena tidak ada sinyal.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "0429ab289b14418cf3d655074e930c17ed9bb0f5d850cce6b8d76dc882bf7848",
      "text": "menurun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "05cf6ec4f283c1cfb1dd15460285230072ea724c27caa1e21df6b85ae4723534",
      "text": "Menarik! Aku mau nanya-nanya ke wisatawan sama pedagang di sana.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "05e8665d1f1ed26476b8dae2da4fa208ed104dffda7fa7f2f602205da06c721b",
      "text": "Menurut saya, Singkawang adalah contoh toleransi yang indah.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a0d0cfb00b938ec6b28cd029cfac4213ca7af1d9b401acd9c4cdfb3e2455c68",
      "text": "menyimpulkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d3f0c70c928eff1273984a9c81b0b412ed27f6485e3a5a10be6d774c41dc87e",
      "text": "kembang api",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e0aea4e9cb19fd86d3265316a00502202c5a80f308eed00429f7bff2cddd5cf",
      "text": "Iya. Topiknya kunjungan wisatawan pas Cap Go Meh.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e72cb3b72332e01eb15fce14c5513a4342214a049bc94e9e79f2466d0b7df02",
      "text": "Warna merah sangat ___ di kota itu saat Imlek.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e8ddb0553d70758f2e5dba4635092ae241fdd83e2db95fa1fc76b03fca9f0f5",
      "text": "simpan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "10f7d91ffabc6dbeb3502b5ca4db9ace8610d1b1ffb84ef246fc0cdaaf2ef3a0",
      "text": "menonjol",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "12b4e1d98e3cb7ef1da2488e0d3873ef688c16d5fd9d877dd06ebe87d8eb25d6",
      "text": "Apakah ada pertanyaan tentang kenaikan harga ini?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "12ed58340f4f12d6d0673d577e052307fc91f33ad796c65b0d70ccb95fc997ea",
      "text": "Dari segi biaya, rencana kedua lebih murah.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b8de0e1bba4a70f7bd594748563e274d147f1d593fc6a2b17e2c9dda1b3583",
      "text": "Penjualan terendah terjadi pada bulan Februari.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "15d66f9570d8a8a173879cd98bfd82f28a9cd72f2e6aaf71c6eb28950c2d742b",
      "text": "Tatung: orang Tionghoa dan Dayak berjalan bersama. Fotografer dari luar negeri datang khusus untuk itu.",
      "voice": "id_gadis",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "15e0357b620b30eb00d4dcf4ff4a5ec8f19fefc5b233d3d9783ef9c8c4b0f4e4",
      "text": "Di Singkawang ada vihara, masjid sama gereja yang deketan. Warganya hidup rukun.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "16b898e44db881ee78e714080eafcb8f4a5a597aa8a267b643e480eefced4cd4",
      "text": "Kami merekomendasikan demo produk lewat Zoom.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c1b0397fa7933d0d09845e999b42aeb1def5eb2afc1003e43f74e1fc377cc01",
      "text": "Bau dupa keluar dari setiap kelenteng.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c7c8e6445b8b127c9e1514f8b5db819837f499176fdedc50c43f614a695c00d",
      "text": "transisi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "21080faf718ecda2ecf17fb78fc1dfbe071da213d3d6165527eb5c918620a8cf",
      "text": "Hadirin yang saya hormati, silakan simpan pertanyaan Anda sampai akhir presentasi.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "236d4a44474b710eebe2a4abd85f303f1a7b7d9888befc5cc348983f1a47fd6d",
      "text": "jeda",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2437a9a5de369c1273934a82cfa0b68458f6dfd48fc6ad141562544c7c84b433",
      "text": "Saran kami adalah menambah papan petunjuk dalam bahasa Inggris.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "2486a5777f49116c0b6ba58ab55fbe17663d6c221f4d589986f8d03eb4231166",
      "text": "pertama-tama",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2610a64ddd269d1d52bc96a8d7592a3d8b2a65cff35c570e2e779ec922315da3",
      "text": "samudera",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2612d3a92e34784c6001200ab0ccc8da7eb70b46e9e0aa9eb67660627f61b923",
      "text": "Jumlah kunjungan ke Singkawang naik saat Cap Go Meh.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "284a08214da3e1c65a3c908e798a458e691edb99474b020a68a1b2068845908d",
      "text": "Kesimpulan yang berimbang. Terima kasih, Mohamed.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "286c1c84685df0c2f85a4705faa29900ea82b0bb28bc298560b1864402173bd0",
      "text": "Tarik napas panjang. Kamu udah latihan tiga kali, jadi santai aja, percaya diri.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "28aa17280781b66109ece8320768e7276dff7bb3b6b4f5ccc563a364a534eac8",
      "text": "Harga cabai meningkat tajam pada bulan Desember.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "28b14ef29bd4de1daab8c65e0e3ad96b6f85253311e18ff5c82f1420dd237a8f",
      "text": "Terus malam ini, Cap Go Meh. Tionghoa, Dayak, sama Melayu ngerayain bareng.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "28dc0b2afcbd3d97fcdd3633e168b681c3f4d6aaa51db69b773e0bf7a7de485f",
      "text": "Laporan ini menyajikan data tentang keberagaman agama di Singkawang.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "28f332f282e83923422f08ab98b42cf5e987ec8454027aa28412a57c8e8c8f4a",
      "text": "Turun lagi. Rata-rata cuma separuhnya.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "29506e77986ce2f19843dc2281bb78a71e570f40fcb8619b2f8c8d363efdd738",
      "text": "jumlah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a3d2a42be33166d8eb24b13c533c415425d5cc5f86716a705e19ce158c9cf93",
      "text": "Mohamed, perjalanan kita di Kalimantan udah mau selesai. Yang paling kamu inget apa?",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "2add73c5186d81b092ada6c02bbd26ad24da0e006587da864615006b3cf9bcf9",
      "text": "Selanjutnya, saya akan menjelaskan festival Cap Go Meh. Oleh karena itu … hmm, belum ada hasilnya.",
      "voice": "id_ardi",
      "chars": 98,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ba98930982cc0744692f2685e40392b82f6e9fd3a58abcffcf3883fde67a515",
      "text": "Survei toko dalam radius sepuluh kilo dari kantor.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e6f6fa45887fdd35b5cbba53ad9d0b0e36f5e11ed9a6ecaec9bb6ed50648d4b",
      "text": "Bagus. Bagian soal keberagaman menarik banget.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fc0ec9e150e47f2ba2382a41bc96000528ae21453fff5dd59168e7a70478342",
      "text": "Baik, Pak. Susunannya: pembukaan, data, lalu rekomendasi.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd3ecf4b051a56b3794940fb85a1793011144c9246a32fadfb1a18c5602a16c",
      "text": "Ide bagus. Tapi warna latarnya jangan terlalu mencolok, ya.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3065e9b7d9c376745ea767ea99218edde4c67000b7f88f4e35eb3d4904e809d0",
      "text": "rata-rata",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3108a23ce53cb7c62f0c232504b54c4cd7414e3899ce7b04cf3b2bfbd1d662dc",
      "text": "Datanya saya jelaskan sekilas atau secara rinci?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "31d9e07a1e5ac3788437779ac7a901544c1df294f33a316198ff467611a4cc68",
      "text": "Saya udah kecium bau dupa dari kelenteng di ujung jalan, Bu.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "3259f7e841ab4896ae8dbe374a04edd0925bb00ab83a98b87090e41c31f19fc0",
      "text": "Nah, \"oleh karena itu\" buat akibat. Simpen aja buat kesimpulan, ya.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "337ed9ba1d9054e705057c37c7601f4cce501f9939d0b6bba003d108ba131e56",
      "text": "penurunan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "361255a05de953350dbc143d80de42bbce68ee295cec417f10dbfc334bef11fe",
      "text": "Foto Cap Go Meh di tayangan pertama langsung menarik perhatian hadirin.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "397c3e7f964dd8f2cb609ba37c8d651e5815146dcd1c20fcfdd4735c13247db8",
      "text": "Rapat hari ini lewat Zoom, bukan di kantor.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b1051dd73e34b33e234e9812022408cc2051e7baa0090bdefee4b04e3c36a2a",
      "text": "Saya gugup, tetapi saya menjaga kontak mata dengan hadirin.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c70c91c58be422a04c8a6890d5843933ab748fbe15bea42c3ed13b3d478000a",
      "text": "Bagaimana dengan penurunan setelah festival?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3caa5756c4b314afa63f11110f07613308f9ce914c8221eeee2e692e4feeae5f",
      "text": "pertanyaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dbf844736b82a09073fa0eab45bf420fe8bbe4f1b4e6f2c38ef6a2140a6433e",
      "text": "Pake foto Cap Go Meh di Singkawang aja. Itu pasti menarik perhatian.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e624e0b7f8a1cf614d88db597d41b1d16695f47056e704f9eb2b68288655587",
      "text": "dupa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3eed9f491e01c1e7c7d8f2edbc4401f5770a2064692979f0f6de1bf97f694156",
      "text": "Penjualan kue keranjang menurun sedikit setelah Imlek.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f2dcc3fd7df5cc577ceaa6fd6234ca44471ce354827d27c8e95264b3a63dc30",
      "text": "Hampir. Aku nulis soal menjelajahi hutan pakai kompas sama trek di Tanjung Puting.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f58720881066741963ca4b475784eefbe914a03f46edbddfa2a160f9d0836ac",
      "text": "sekilas",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "433d0a00cd03f6babfcfc47c8b9bde5af6fea7c8b2da52fc7d48f5ac1fe45aab",
      "text": "Hadirin yang saya hormati, pertama-tama saya akan membahas sejarah Singkawang.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "43423c702393d8f43981f516c7d272cc29bd22a77cc1e259d7e02937d117f8d4",
      "text": "Mohamed, tugas terakhir kita laporan soal Singkawang, nih.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "43e3ed1caf90d8250e4db42d203b8d0a1b5f7d37692c84b7ba89c39f3024982b",
      "text": "Hadirin yang saya hormati, saya menyimpulkan bahwa toleransi adalah kekuatan Singkawang.",
      "voice": "id_gadis",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "45a4d3008e379a1f2ff047d0e1732d2daa2654fe3d8a88f4ab5490d1f15266de",
      "text": "menarik perhatian",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "46cdc50814481240f3a8887128ecfe7643a9facc0655338bf474dd3058b05931",
      "text": "Mohamed, perjalananmu di Kalimantan udah selesai. Laporanmu udah jadi?",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "492a0d306fc677b36db9ff8904a957eb45685fbfe07c2357d2a8daa0f0bd058b",
      "text": "Terus abis festival?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "49759febcc5585b4ade7f75858995443b1db272f8a7160c33b946b221933a645",
      "text": "Kalimantan tuh kayak satu benua kecil: hutan, sungai, sama samudera budaya.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c8a43958b39d0e841b1e6c644082cb31b874898320a1d6ae3bb1e1685fb1677",
      "text": "Parade Cap Go Meh dimulai jam delapan pagi.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e3fc3fc872bcdc9d89940f1ad5601f258ab9ac9d9c52977fc7e0953e2dd2618",
      "text": "Volume penjualan terbanyak terjadi pada bulan Desember.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ffb93d6e46310b8b2365a2557c4852e7d5647fa4a5f67f3a64a90401b0956cf",
      "text": "Jangan gugup. Jaga kontak mata dan beri jeda.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "506eab801f9e372ddb4cf2c15445299b1736396611729c8e55338bce81fd6e71",
      "text": "Rata-rata, setiap keluarga punya dua sepeda motor.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "50dc695d08a1048a219c6f300a7dedb1065524dc312d86db8ef0f77d19f2bb39",
      "text": "Keberagaman bukan masalah. Di sini, keberagaman itu perayaan.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "53133880e4fdfc9025d0a161b73c615a66b67d9982f0dfe164ca0680fa761c81",
      "text": "Kami menjelajahi hutan selama tiga hari.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "55035aaae3dd7bb67cb91bb256debac4628493a6ab6e4fc2f8d66a974defc5bb",
      "text": "hiasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5760c170ee87ea6cff58b4a30143527ee6059025bb36d35c315e1546c9346b26",
      "text": "Fotografer dari seluruh dunia datang untuk memotret barongsai.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "588ca16cd752ac1a18b6d617f0be8fea20ebe9daa9245008f68fe6414cc019c4",
      "text": "Sekilas saja: susunan presentasi saya ada tiga bagian.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "59f543ddd47c8e284541bc93ace73d738482468e8f56f834604fe04ecd401d13",
      "text": "perbandingan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a5b4574199c5ccd224bf56fb0507c1cd034a4bed60a092c57e95105691b7aad",
      "text": "Perjalanan ini tak terlupakan karena saya bertemu banyak orang baik.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a702c273c5be8b1fee5ad2c33b3f25ec75682b41a20f113d3fb216630a7580a",
      "text": "benua",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cae1f2c133160f481ebb6a33a3cc3329bd573b305e7b3f058008b9e9ff3f085",
      "text": "poin penting",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d0aa61162bfe81fdc12275e0ca75143d59fd29f80dfdaec25e202246e0abddb",
      "text": "Hati-hati, suara petasannya keras sekali!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d6340ff576d02969d979ea5a0cffb3f827c777e7b7382bc8c50aeba2eea8f8d",
      "text": "demo",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df98eed876dcee1b2eeaad564e64fd1fd3d5c47ffdee86691c91fd1c98589dd",
      "text": "Pak Mohamed, besok Anda presentasi untuk mitra dari Kairo lewat Zoom.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ebe98282c9582b0868924343cbe4d34026f20df58071189f2f79ca6a4039523",
      "text": "Ada. Hiasan lampion, kembang api, sama villa kecil deket pantai. Aku rekomendasiin tempat itu.",
      "voice": "id_ardi",
      "chars": 94,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f08b97a16d9572980b6a7484590a53a5eea62b9c8ce951f61ee686db408efe1",
      "text": "Berdiri tegak, jaga kontak mata, terus kasih jeda tiap abis poin penting.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "62aff659e4f4de726614fa0bf5b8da0c9846125d929b93a2dfab74ba5d7e06a3",
      "text": "Zoom",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "636dedfd8981b580186e9496dac6645849dd99d15843c93adcfbd765f10abcfb",
      "text": "Dari ___ keamanan, sistem baru ini lebih baik.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6431299bfa7901d5e6fac2f802a4688f19020f2fcd70e0df208cf5aa1561082b",
      "text": "Selama perjalanan di Kalimantan, saya menyaksikan Cap Go Meh di Singkawang.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "650c1f93458d7415d660a76ac06874c3a469a72bfe5c665ad0b12f44dea42f9c",
      "text": "terendah",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "66277551e9454fbca7125271aca7b06d95944464d389fe6e65cf7212ee059977",
      "text": "fotografer",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "67e3fd5fc7c5fd3c6a9c56c202e7478610d3fa950446d2b8dee0d585727bc615",
      "text": "Pertama-tama, saya akan membahas sejarah Singkawang.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "680cd0e68a4f9f20f8deb6b30404eea96488fa4c1272df1b1e2e057af478608b",
      "text": "merekomendasikan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "689a17bbb4661d850760c6c3cfd6991f1e8cb7fa0be54f389c7278966c424d8f",
      "text": "Simpan untuk kesimpulan, ya.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "6933109b4f78582eedc10d66d1005f0b8959ff63f7dea7578c75dee041db323c",
      "text": "Kami menyajikan data dari tiga kelurahan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b3c9277608ef741dfdd4b69bfc32c06418cd4a6144c7d05ab7815a08c40939f",
      "text": "Pertanyaan yang bagus, Bu. Tampaknya pedagang perlu acara lain di luar musim festival.",
      "voice": "id_ardi",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d31e6cacc8ab42ab49d2b1d82efeb7f531fba56716fcc07891095c162844b8e",
      "text": "Terima kasih. Apakah ada pertanyaan dari hadirin?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d7fc11a9ef1ecc81ade3249aa641288eade840ef6c90635b063fd9a15f25489",
      "text": "percaya diri",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "717f84345bf15543d66d77d9c16cf1ed4cccd7d58908e99c96d7a9df09fb029d",
      "text": "Saya menyimpulkan bahwa penurunan harga terjadi setelah musim hujan.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "718306369cd6e9920ae3375eb2a1770d302801640d8c45311d32f341b87fb8a1",
      "text": "meningkat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "723ab86ed9164a591091ac5b088a99001909665161c70cb616a9c9f83dbd1754",
      "text": "Saya merekomendasikan parade Cap Go Meh; barongsainya paling menarik perhatian.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "7861c38327331b3ed2527f5d097d85148207e29c03f172ba748e5f350642edc0",
      "text": "Laporan ini membahas kunjungan wisatawan ke Singkawang.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e29ca1cb62c59b34d9cfb1f47be0dbd1e8e89cbd9ba6dbc14ffb5e630053e93",
      "text": "Oleh karena itu, saya menyimpulkan bahwa Cap Go Meh membantu ekonomi Singkawang. Apakah ada pertanyaan?",
      "voice": "id_ardi",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef1a66d66f77cde91db8cb3164fcbad64cb1a8cfebba5e2db8e53760f6aee1f",
      "text": "mencolok",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7efece67d154a1bde63926a9d157b5c49606bd946490abb257afb57b375ffde6",
      "text": "Terus bahasa tubuhku gimana? Tanganku harus diapain?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ff513866211a8fbe3d24dcb23c6499a6efc23e72ca755bd653b8367551831d6",
      "text": "Mas, aku gugup banget. Hadirinnya banyak!",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8304405ab497f2c68bb84ee3b1e9e01de58034bc242fe0ce4808d9e3199defda",
      "text": "terbanyak",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "84f8b4b0d434f40bdaa1b2513bf98fc252ebcfec65b3c82e7311e5dac164f8c9",
      "text": "Mas, ini draf laporanku. Aku sajiin data dulu, terus pendapatku.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "86d710482868957e7f21742d8c5b00c9a3be955f955b295cc202500813d06722",
      "text": "laporan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "870cfe73d474393016678a716a99d729e4cb7a652d74a24d1cb4656ba15efbc3",
      "text": "grafik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8850069b44aab3b3e0b41873abfe5413ed7cabe4682d528642c97c19943642bc",
      "text": "Hadirin yang saya hormati, pertama-tama saya akan menunjukkan sebuah grafik.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "8aee24299b70d6966afaf52f092b7c9f886cb34d26f97a7dbc17f36f27009acd",
      "text": "Grafik ini menunjukkan bahwa rata-rata harga beras naik.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c002372f073861e50046f47749111cc668877bcd95fb6cdb882ad2732a7dd18",
      "text": "Oke. Pendahuluan, hasil penelitian, kesimpulan, terus saran, kan?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c8c6f1b6ddf7e5a9ef26cda34b952e6b21caf829f87911edb90fa1e25f36b2d",
      "text": "Dengan demikian, kesimpulanmu jelas. Toleransi di sana bukan sekadar kata, ya.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dbc7f15468895f0640300f4af8adfb69c862f73f94720e0cceba556cf29c5c3",
      "text": "Saya merekomendasikan villa ini dan trek di belakangnya.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e38bf269ba703aecd75035328c875fa2faae1312dc25992a7f55c9f729e6a4e",
      "text": "Warna merah ini terlalu mencolok, jadi saya memakai warna biru.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fe33ca38c282572d773b8cbf92bb72401960be81f832dd6ba1e969a3e21c7f8",
      "text": "segi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "91b44332ab40b862e8a5d337d0a5e3da5d4c1c578849f1949920267fc83ab19f",
      "text": "susunan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "936c15720cdfe886e38c59eaea1b26999e5d141c476086e2d3ff6d147a11bcf6",
      "text": "presentasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "93b7503aef69c5a6e6a927bb88f80212607518c5d1b7dfe191df8a81ed2fd309",
      "text": "Malam tahun baru ada kembang api di atas sungai.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "941c0591da23c3ea7dd998e1d2f2c563af0ed1b1fe2f866ca3cfa4834f078858",
      "text": "tak terlupakan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d6904b51b3b86c8a922a8bd081858630dffe18f70c7af884cb94c2feaba0e0",
      "text": "saran",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9698e220a462da3b706d534f4f931ec112e9a61a444c1763bd15aa9973f08b35",
      "text": "Ojek ini hanya melayani pesanan dalam ___ tiga kilometer.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "96d06b4ad0440d5364a9db3583f4fd86591dbaf309186011a58d1cc7d950d819",
      "text": "Sekilas saya jelaskan susunan presentasi ini.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "96e1cef95b5ccadb6fd546defac13d93bf755f25c2c46a7458546ab00315852e",
      "text": "kutub",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "970c5b21b9bd1b0af47d43aa3581d17d8ea20181f883f6032898686c4e6dc23d",
      "text": "Siap. Saya akan merekomendasikan rencana kedua.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "98faaf0646ada8ad8c142462d940e76b9daa4bc96541bb0cf974aeb1489eec64",
      "text": "Kecenderungan harga naik sejak awal tahun.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9975ffe8f76bdebf4482128492f8cb081ed37f3248e610bb54c405682d0b9004",
      "text": "Ada tatung Tionghoa, ada tatung Dayak juga. Ini data terbaik buat laporanku.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e48f9fbdcb0b03ec8a9518533bbaf7de2a77358e7d67793c17caaf12dd481d7",
      "text": "bahasa tubuh",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6b9efe6d1d5d4369879c40758c2df555294d552ea6c325a8d70d8e3bcda171d",
      "text": "Kalimantan adalah pulau terbesar ketiga di dunia, di Benua Asia.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6e37bcb29442ee3db0b0a336da2a9158523bb8f655ee844e63e1798e33123da",
      "text": "Iya. Yang terendah bulan puasa. Tapi kecenderungannya tetep naik.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8334ab8421fd777029aa1c86dd047e6abecaf7834116ef8f23c992a2aa783a6",
      "text": "Barongsai dan arak-arakan tatung paling menonjol tahun ini.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a90b6ffa1e224710383a6d3d464b69c75f02ef5271f779fe87898f167dfdb771",
      "text": "Arak-arakan tatung adalah bagian paling menonjol dari Cap Go Meh di Singkawang.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab4e90182e310a84809dba648411b83c50734306c83062778058f3cf4e053978",
      "text": "volume",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae8315c4539e02e76500b19c3345c4b7674c524cd32db7a086655f792e82eb5f",
      "text": "Ada bagian soal Singkawang nggak?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "aec276646f2fe843350785c15bcbbbb3effbac01abe3039fe2cbef55fa4d98a0",
      "text": "mengacu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "af8fb0080886df451707888b6d37420945e1c8133af6dd3cf82bc890886c8e67",
      "text": "sebanding",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b014003ae5b100253e64b01d99c1f786a09435934262df959e18a0a817cdbadf",
      "text": "Volume terbanyak di bulan Desember, ya? Mungkin gara-gara liburan.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2970173f72c02485ae985000475a80f2638d31618323127797b4e5c726fba09",
      "text": "Nih, grafik penjualan kopi kita selama setahun.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2e0cd9e8d61e8e79ae58dda43be6692c21e57092d73793317187446eadf0b59",
      "text": "Sebagai penutup, Kalimantan mengajarkan saya arti toleransi.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b48e2fcd0a2cd9e74831d5a92200b8bb6e1f79423d261b858a4c863231800bdc",
      "text": "keberagaman",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b56bcbc40f514860536229c9b0de64b3af91eda7ce94283dbd266354671114fd",
      "text": "Dengan demikian, toleransi membuat warga hidup rukun.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9c877397884b6b3b0dba60f7a795cebcb147ff73be3de3a2aa7a17439a78783",
      "text": "rinci",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1a3f4bf5961038fff9431d5b5afc090b1831a608501541fbc31b872d9f8dad",
      "text": "barongsai",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb588d04f0f2b423b01788eda6e1ea8a02533cd733589da65d613edd99ca926d",
      "text": "kecenderungan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc4329f251b1a2e1b20bd3b353a196cc02fd48419433a84d52a52cc7406d03eb",
      "text": "menyajikan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "bca2af0066411bf32fefdc6f8433586751af21b99f819a3104bd5f01b1b40528",
      "text": "Sebagai penutup laporan saya... eh, kok jadi resmi! Pokoknya Kalimantan nggak bakal terlupakan.",
      "voice": "id_ardi",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd6b2d35f502b7030931a96828d7c097196d6bf99ea3414bea11137f442edfca",
      "text": "penelitian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "be067968264bff2299fd24c82d239d11bca7331c1a67edf2eff1afe1f1319eb8",
      "text": "Besok ada parade, barongsai, dan arak-arakan tatung. Jangan kaget dengan petasan!",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "be423f4a9e6ce295c86d40774d118120fc8406702b835a5277a7a621d968fd9c",
      "text": "Aku lihat sendiri kabut asap sama warga yang digusur. Itu juga bagian dari cerita.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "c227eaeb2dd40a000fedfe9305804f63b5deeecccaf259ed1129209557352c00",
      "text": "Angka ini mengacu pada survei di radius lima kilometer.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c26f045d1ed0141a941b841fd09749af9af03f7071a046d3bdc9e2cf73a5ac7a",
      "text": "kontak mata",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "c38218914cbd20f1ae3e50649260bdef41c9b51f1d2c45908592e9a2afeec0cc",
      "text": "kunjungan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c38b9d31c324505ea9f7610b97a3411aa4422e912d9b57ce50ab0a6396a0287a",
      "text": "parade",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c57173e3a0876770d4939e4f035d8584747d0dba3f33f9056f142c27cec9da8c",
      "text": "radius",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5d3dd7a3f5ee3de57abcaa4e64687a3db0e8af7cc7b195a15c924c0084c9eee",
      "text": "alat bantu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c78ee5fa4705f62aba778bf967023d2e971615c17e3cfef546e0a044ac49c108",
      "text": "Penelitian ini membahas kunjungan wisatawan ke Singkawang.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7903ab0effe64e3e864c6f5083487e7c6a0b5df7777408d35b9afefa6b53a90",
      "text": "kelenteng",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7e5574f7e0fb303a861bf3c2502f91ed95a94a412ace206cd971534891825d8",
      "text": "toleransi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c87653de0e00497727dc5cb0bb8f41d1fe1e7ce78173832316311847ec27da36",
      "text": "Yang paling menonjol apa, Bu?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "c92a4ea93cbca463bf1325750c7915cec4f4d5257f8042253acf98826c39d84d",
      "text": "menyaksikan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca1033219b0a14dd25ebb5502fe28a62d67c5f2c3d91faa571f6817952800a31",
      "text": "Bagus. Jangan lupa kalimat transisi di antara bagian-bagiannya.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "d145e225763852780c8fd0b05b439453e40e7b376923181530e420d310055402",
      "text": "Bahasa tubuh yang terbuka membuat pembicara terlihat percaya diri.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2209ab24356d5bf6669c4f1643df12fe8a5d31654d24ff12dedff4377941e2e",
      "text": "Kalau gitu, perbandingan sama kota lain belum adil, dong.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2cfe33bb0be79a9ae7f53a6bdab0ba1c5d68654be05ccb27623b6d97d4b815a",
      "text": "Dalam presentasi itu, penjualan ___ terjadi pada bulan Desember, yang terendah pada bulan puasa.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3773f092d8b4fa5a08df3d5dd0a9a03bd5e1b7888daa9bb66908143f5d4c42a",
      "text": "Saya merekomendasikan villa di Singkawang, apalagi saat ada kembang api.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3820816c96729a7970a27cdc952d7bad60f6b6437fef9ea04f0255c94c77850",
      "text": "arak-arakan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d444185b5364730f5ae25bfcf3b108245a810f2d4ba78bcf22963854ec1c09ae",
      "text": "Datamu jelas. Kayaknya festival penting banget buat pedagang.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "d53087c26e848f4215f6349a2ceb12e21f6cc8ae069bf6f0a83627ad4213b9bd",
      "text": "Mohamed, lihat lampion sama naganya! Semua orang ikut ngerayain.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5cb15a5e7c05cc7ba08d4b1b5c3fe53946cbcf9c416be542cee489b202192c2",
      "text": "Jadi kesimpulanmu apa?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "d62b337dbd54f6148c7dbfd2ad35c058bcbac0516cb2099aac81819dbf852ac8",
      "text": "Pertama-tama, presentasi saya terdiri atas tiga bagian.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7fb4f35058eebbc026ba6643bccfa87009d0933d1beeafd4f9bdf17dcf48422",
      "text": "Mohamed, tayanganmu kok penuh teks? Hadirin bisa bosen, lho.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8bf9c0f08833f63678ed158d548dc8c4351e3f5ebaafe25b51bec0e999c2898",
      "text": "Saya menyaksikan sendiri dampak kabut asap di Tanjung Puting.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "db6253759428896ccc24f9b72c4f6fecc65db268ae6eb1e85516c6b96138a7ee",
      "text": "Sebagai penutup, saya menyarankan festival kecil setiap bulan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "db65d7ab76785658e759fafa0f4fdbd504c7f434f4e7024110e20bb9bdec8380",
      "text": "Pertanyaan Ibu sangat bagus. Saya akan menjawabnya dengan data.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc0bc27e50000fee719034df1ce045aa755714123ec05e79544c825ecc7ec305",
      "text": "Ada tiga poin penting yang ingin saya sampaikan hari ini.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd93f9869314769f62a2488b7547e5b26f799cdeb647ef4c2ba58ece01774f13",
      "text": "Grafik yang sederhana lebih menarik perhatian daripada tabel panjang.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "dde865ce6de4371ebd2dc407205d320a07718e85a7560382adb79313d5f7d8a7",
      "text": "Bagus! Terus gimana caranya kamu pindah ke bagian kedua?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0b6bcf6fc72f6798b25d59e1d67722e77d607ec6dd1e6f170a56f991eb30d48",
      "text": "Pertama-tama, rumah panjang Pak Lawing sama suara sapenya yang merdu.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "e181cf7791fa6567cd19a04d3faa8547d16b7d619e364b67ab5403adeede1b0f",
      "text": "Sekilas saja, tapi tunjukkan segi biaya dengan jelas. Lalu kita buat demo alatnya.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2a2190760af8f9df5dd04f1e2e64cd11326caf3a11ec9a91886143c5a5826ee",
      "text": "trek",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "e39502409bf1584a24a92b5d2ab6d1881fa76179e4c00620dc8df6222a6651f4",
      "text": "gugup",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e45879a8202ccf9576c84f1b559a78b0dfcd80aac81df0178f74b1b3d04fb13f",
      "text": "menjelajahi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6066cf73395e57e75ca7074ffcd635835dc220017e914b16a7ce75a5cc96c77",
      "text": "Kesimpulannya?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e784a6011b11a32442bd7fe85853125ed80b2de78ddfd8392afaf9adf5a49fd1",
      "text": "Jadi aku tulis poin penting aja? Terus alat bantunya apa?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7f0e37b61f09b41d5e1f425a9eb46ed248682fb7db8d6bcd9d2688eccd42a97",
      "text": "tayangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee6cdd75c4481e94b45b57d888983ed209a20c0b487863969d9a255bef928776",
      "text": "Kecenderungannya naik, dan datanya mengacu pada survei toko.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "eed70d29c22d7380d81c0b801aacbb79c153b279c3a378f5bd171d726c435c34",
      "text": "Sebagai penutup, saya ingin mengucapkan terima kasih kepada Mas Rizal.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "f274cf032e6c4112bfc12444802b9cebc9b6e6d53014a4f9478a15d44896f65a",
      "text": "Rina, lihat deh grafikku. Jumlah pengunjung meningkat menjelang Cap Go Meh.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2b1ee7bd7cac80bea2271890c9b1f15ac9e32bde98915330980486a47c5d6f4",
      "text": "Indonesia terletak di antara Samudera Hindia dan ___ Pasifik.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8d94c0d1795fa49206e4db96802273f0efa2c0189905eda20279b42a5dd6955",
      "text": "petasan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa84488d5309e6a690a57096f204fb827628111e7ebd1a77259807ef7629bbd3",
      "text": "Sebelum presentasi saya selalu gugup, jadi saya menarik napas panjang.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb233bacdeca5ebd90c24686862e66532396f28c45fa7623d1226efcee81132a",
      "text": "Terus yang susah apa?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb9ea6b008598d415f9c4532e873a6cde67252acb85f611e23893a091cb60711",
      "text": "Selamat datang di Singkawang, Pak Mohamed! Besok puncak Cap Go Meh.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "fceec7dc08bebfcf973f8c2f175bdd73beb8238092193d87d7adf594f5741697",
      "text": "rukun",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdad158cbfc4b80147c23777084e3916931991be59dd14a8d138fe7a39513f15",
      "text": "villa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff5fdf6fd8530d178538877464260a0ba94d35470ae836fcb0f95f580f84fb62",
      "text": "Data pelanggannya mengacu ke survei apa?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
