      "id": "bipa4.u07.l03",
      "sha256": "0e4eab4141232bcd98e97ed044a9d906ee850912058ab77a9dc00fbd12f7b866"
    },
    {
      "id": "bipa4.u07.l04",
      "sha256": "ecec747b347425eac93e17f88cdfaac5a6da67e84ee128a0923ed2f8f58d1caa"
    },
    {
      "id": "bipa4.u07.l05",
      "sha256": "dbde6e4f96c85715c7b1a106dc2fd24ee6ab07263d08fd75ea928adebe35f6c3"
    },
    {
      "id": "bipa4.u07.l06",
      "sha256": "d4a0030942841a3534cc9f493362f86e24887154cc6a1b213d65e46db3f4d89f"
    },
    {
      "id": "bipa4.u07.l07",
      "sha256": "2b1289a7a56975334ee27780bfd961e33ffc3da96c525f9999b727b6533943d8"
    },
    {
      "id": "bipa4.u07.l08",
      "sha256": "6f2b9f282bdef912cb9790f3d864d52390f8f6de107794d2336d891d7a33ec43"
    },
    {
      "id": "bipa4.u07.l09",
      "sha256": "48a03c8e25a5d14ae2f8de201ea0d9b491c05253f3a8b953e91329f7206356f2"
    },
    {
      "id": "bipa4.u07.l10",
      "sha256": "50e8cdef700103f420a5400747c8d8437db934f72e84093ad3c7515d64f18aa8"
    },
    {
      "id": "bipa4.u07.l11",
      "sha256": "048b239dd864bed1a93c90cd5b69bca806d8e88201a2f5f646f1e214b72db26e"
    },
    {
      "id": "bipa4.u07.l12",
      "sha256": "1f2f09aa920a7c1781428e31603981e76111fdfc0ede4656f2275dcdff0d0cf9"
    }
  ],
  "audio": [
    {
      "key": "028d9780a5ed2ac60dadebe79680d5cd137efdee0e5c439ad6dbc055e4b6a810",
      "text": "Iya. Menurut brosur ini, pemeriksaannya gratis setiap Kamis.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "040bd34b44539385be075748abffc01b2c818985fc873a65c4e02574cc0da511",
      "text": "Pemeriksaan jantung sebaiknya dilakukan secara rutin.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "09cc869bed045d33c5365722cbab6d3ba0c0e6ef180b950a24f88083e0ef6460",
      "text": "asuransi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a176e4193b85d1795e60b5e761f45fefb5f039393c651c112be747e0de05ff8",
      "text": "Mohamed, batukmu sudah berapa hari?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ad4db84f3940463434414be59c1f0446fc3fcf0c82ac377d8a11735aa5db6bf",
      "text": "imunisasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b25b1e70a74c7dcbab488f612111683153ab81b5fe28b5129f160e8df8dd6ba",
      "text": "Mohamed, kamu mau periksa tekanan darah, kan?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0de31f5817d683df762b5e9abb20e4810b876bad3d98e828b2f923eb699b13f7",
      "text": "suster",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e77d292877cec9c24843841ed492082148c1d7e4a910121247bf4cee850fe88",
      "text": "cairan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fad2be579ec1ab9350ae0b42e54fb829dafc657867be92e7b523fe508688059",
      "text": "gelisah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "102a05719ed2216e012ed8ef9b57b67e7c0092d31d7b98094c60ec0dcc36f2f3",
      "text": "Banyak orang kena flu minggu ini. Hati-hati, flu itu menular.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "11f9f4126912f0994bb46a4756e6f5f620bfc486d54cf44c62d96491d2b16e07",
      "text": "Saya mulai besok, tiga puluh menit jalan kaki setiap pagi.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "12e359b570c899a1ac8ed21a59980f660ff9ddb8a534d6b0f0c557c89e7769a4",
      "text": "Gejala darah tinggi sering tidak terasa.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1362307848b6bc9e6ac108adeb52d0f5a49b10c29024898097cfd93e72493738",
      "text": "Ketiga, lakukan pemeriksaan rutin, karena gejala darah tinggi sering tidak terasa.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "1535f07ba5dc08fafcb8d062ffcb90425654c4da76b626b49f335c9a20610a83",
      "text": "kelelahan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1887596522fbd47e4b92d9856798e31ae6fac676bf276e740965005753d23703",
      "text": "Kelelahan dan trauma bisa diobati dengan terapi.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b668b9fce24ccf6feb96704b4bd37f3f662f2a1851c9c9ba5a82a523f9e3ae6",
      "text": "terapi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cea718a91d3faeab28c07761056d744bdbfdd28b09d7fe3d08f7fecbc3999c3",
      "text": "suplemen",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d4701b5586a4db57e2257f83332758d63bc00ed87f0fc70dfa413290dfb2a72",
      "text": "Wah, otot kaki saya sakit, Mas!",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dc183f748a733d47643c03bfb4274cd3d17676572d3df73ec19b81ed02176f1",
      "text": "Betul, Dok. Kesehatan itu mahal harganya.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f4e299433f62359a3796b26880f9a8e0af291c22f987fbecfeb45ca539599af",
      "text": "Tangannya terasa mati karena ada masalah ___.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fe54fa1d816850922e1ff6881b38826a6093770b0a84668544244bd82ca8046",
      "text": "Pil diet itu bisa merusak organ tubuh.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fe89513f42dd822d919de31fd2a791ce16115584c418f5483c6f42335b3bdcb",
      "text": "Apakah pemeriksaannya mahal?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "20ed2c5c4ebc727fa5e14833b68e71ac96bd5b8681ef949c181db80ec3c89fd9",
      "text": "Tidak. Antibiotik hanya untuk bakteri. Pakai masker saja supaya tidak terinfeksi flu.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "2191383469584d1b3500ba74cab768818a7a4cbc792d51f1ad7f50137b8995d2",
      "text": "Kalau gejalanya parah, segera periksa ke puskesmas.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "220b68e36fb4ce9882368c6a17b393e659da165900a5792ba492ea8ef1f4ec05",
      "text": "Ya, lutut saya. Saya dirawat di sini sejak Senin.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "224a68efd1f6640f135d30513a3cdbf6d20a83c9bcc60ff2abc9afd97259502f",
      "text": "Sejak gempa itu, dia sering gelisah di malam hari.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "24991a5f8046b5f6a45e472c1faff2bc1a6e83b8a72bb82ef2b48804ee720a0b",
      "text": "Keadaannya makin membaik.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "2aa9be193b1f98d36bd5acfdff67d105cea5ecc9231c30272e881986d4da3dab",
      "text": "Tarik napas, lalu bernapas pelan-pelan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b6825c28a96db4e748d3a934ef07c8276b89e417e441ee33cca63a8fb78efb3",
      "text": "intinya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bd42be5a7002d018cd204e162ee2b447e460b858d2af588db26ea3cf02a9cce",
      "text": "Dia sedih setiap hari selama berbulan-bulan. Mungkin dia ___.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc687c803a62d7c451997090d015018eeac8f6ae861bde9ab4e600fa3e92924",
      "text": "Benarkah? Teman saya minum pil ini, lalu kuku dan rambutnya rusak.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "2da4f123b08c2befe4c3b58f568263349d1c193b7b530cbc28f71c8f45b87539",
      "text": "rutin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e4adce7b3c1e0622dbd196613713197c6940e7d64c51085b141e623a7da78c2",
      "text": "Olahraga dan makanan bergizi meningkatkan daya tahan tubuh.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f706c49820cfab5483e5ba837d5cd4e00bf3591d99fe1f09dc4daa1f664731b",
      "text": "Perlu antibiotik?",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "3084c25d61a1c136b247362a6c37791e684045131df2566a0352b919ab4ea357",
      "text": "Silakan ke loket pendaftaran dulu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "310dd965111f1bd2835a3ca109b177c241c7d70242a68965bb5efe4b0b46e83b",
      "text": "Sudah, kemarin. Untung sarafnya tidak kena. Sekarang sudah membaik.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "33024a0e7c28bbf45204208ea82e08233e7cca85e28d09f6718bfb86865ecd4d",
      "text": "Intinya, banyak penderita tidak merasakan gejala, jadi pemeriksaan rutin itu penting.",
      "voice": "id_ardi",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "334bf62a944e9a696e16bf9118ece209211c91cc4d4f8a404a6185bd6eef0a1f",
      "text": "Dia pingsan karena kelelahan dan tidak makan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "33694da9ca4cde8bd903a23f87d5fc5f345e91ae53c0d3fb57ff8f56c1dee707",
      "text": "otot",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "340e941f45530e9cba342aa7d11718d92370d52f386a417e04ccbc8fe951c4dd",
      "text": "organ",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "346bbf8da01ddc31d18e175f37b73c1ef345053470f3d468c293243245de8536",
      "text": "Bagaimana ceramah kesehatan tadi?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "36ef5c91564c7899ba4ccd2e6676330fec117113ef9fb4c0380ead1bfe4e1a05",
      "text": "Andi! Saya dengar kamu cedera waktu main bola.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "378463b8ac9ab0cde763e6a11be581ece9cead7842e453d7df9182e27f869122",
      "text": "Tidur cukup, makan sayur, dan kurangi penggunaan gula.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "383b35ada7fd577a12170ae230b818ddec002adde3450a47a97ba40bb6ef5eb3",
      "text": "Penyakit ini menular, jadi anak-anak perlu imunisasi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "3979e687988bc96c03555fd66ed3be16f9d5886aebfd3f06f51479b0f47a0eab",
      "text": "Setiap Kamis ada pemeriksaan tekanan darah gratis dan imunisasi untuk anak-anak.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ccfc49810ad84958235c06fab2ee87ea6b63e451b9260fa192bf43860c5a1f0",
      "text": "Kalau gelisah, duduk dan bernapas pelan-pelan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e61bc27825132b00834f2ba18a2bc4db66505f5287fd98fa46f46f6eb8d5d78",
      "text": "protein",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "402f4e3eb259f87941bdc87915b4baeb79e59ff83c04c3957ecc90d21581af22",
      "text": "Pemeriksaan kesehatan sebaiknya dilakukan setiap tahun.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d288068eb67d797ba7f0df4f825f35d572e7a006bfa4270fe9e751f50fba3c",
      "text": "Ayo naik tangga ke Benteng Otanaha! Bagus untuk jantung.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "46059eeb5689ec2f87c8843a846e04239fee3045c7732409749e2830b8d617a2",
      "text": "Oke, saya buang pil ini saja.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "4715485f9b4a65248538824e5db42b6d4e03b08d49b1018b0de5a302a7a1ae55",
      "text": "Selamat pagi, Pak. Mau pemeriksaan rutin?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "49d53f59d7ca947ab5fd74bb41317b44212b0ceaf8594d594ec4b18d7547d93e",
      "text": "risiko",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ac1190cc338fb8a43deda7f0a1a75fe579da84d56bbaccd9a4d2f3b07558224",
      "text": "teratur",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ad7c400969b3bd40b761555749f0a9fc8ea48736f9aadaa9c716bf4539bd298",
      "text": "Menurut dokter, banyak penderita tidak tahu bahwa mereka sakit.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b13e8107c03d2a871b28b8d51d50b5bda74bd538fa603b2fbbface9ce9b5958",
      "text": "gejala",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d0628615ac670f784449c62cc0aef9f676a460817bd5ddb3be651389ee15afb",
      "text": "Puskesmas kami buka hari Senin sampai Sabtu, pukul 08.00 sampai 14.00.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de3bc9a19f9f623a6a1280e9a1239a1031df2811038deb46ff6504596c8b699",
      "text": "Ide bagus! Tapi naik dulu, baru menulis.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "501d1e194bb63432433a5ba13c4e4278c893c05813752b6d6a7d9b9e08443e69",
      "text": "Saya punya. Wah, pelayanan di sini cepat sekali, ya.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5042edb83ae3c8ce2db20d180dec151cb266771716b679b77aa5047a878ab31b",
      "text": "Jangan lupa membawa kartu BPJS ke loket pendaftaran. Biaya pengobatan ditanggung asuransi.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "52d35d249b490acf5aaae3f23cde0b67626db8b1f07d32593c17ba6fff01d67d",
      "text": "pil",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "534fd7ba058d3aab4a4d4aed745fa6b9b7222649e2d11de83c6d69182a96eaa1",
      "text": "Bisa, Pak, kalau Bapak punya kartu BPJS.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "53b014c343dc691953c33a56557fc421d6ce08d97d62db059b9db306b685a734",
      "text": "Banyak mahasiswa kena flu minggu ini.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "541a47f6999b02e5073389ce8b45c279ea03d776751ebe58bef0a15404c1ecb1",
      "text": "pemeriksaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5745e5f082857321a55c5293bd30a89d425eb5d7083406fa7e8dd0a34925ef88",
      "text": "Kesehatan itu penting, jadi saya memeriksa tekanan darah secara rutin.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "580962d67696b62b0414db15c8ccae3edca735bd065b98176f279bb078f7df0f",
      "text": "Sudah. Apakah pengobatan di sini ditanggung asuransi?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "59e38776a13886b1cbcddc6892b7223c736c4d5337b08c5b97d244ee96d04bde",
      "text": "Pelayanan di puskesmas Gorontalo cepat dan ramah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a7f5cd7e7d568845d0650ed34bfda6ac08790baf6bb6c202a49d709db9fd7ee",
      "text": "darah tinggi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bed4f8144925035fddf6502a39f8cd56d8067eaa0feec35c889784e8df768e3",
      "text": "Dia dirawat di rumah sakit selama tiga hari.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "60de3f6fcf572f21146a179f07aa193990fbe0692cebd6546fb58263ccbf8d96",
      "text": "Tidak. Dengan kartu BPJS, biayanya ditanggung.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "628bcc10c5164110fc6c2291ca3da014c56e2a076fb174f7c2de8e8e38585434",
      "text": "puskesmas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "629b8bfac34e51f7c4af9dc94ed56eb49ce1ecdbbcb7f380ae1643955b5f17b3",
      "text": "bernapas / bernafas",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "646b1baf21d470b1f3de216a08f73b63335ad753723f39df4973ed8cb007f127",
      "text": "Saya kelelahan. Sudah seminggu saya tidak tidur nyenyak.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "678ca311b876c3adb59c51b62d4d62cd9043bf244a73811404a9a6e2112df12d",
      "text": "Bagus. Jangan lupa bawa kartu BPJS.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "67df72262b55d58298378a72349300f3ba911d9e9fc2a1070baf060e6b117196",
      "text": "Pakai masker kalau kamu batuk.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "69311bde832ee3a934fc8cbf88d624316f4f7f26747a6ee8c2556fe0a846438b",
      "text": "Biaya pengobatan saya ditanggung BPJS.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "69a4c62467f0c8bf6197c9940ad2b235ae0b8c891347438c21c5c2c70a24a749",
      "text": "Pemeriksaan rutin penting bagi penderita darah tinggi.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "69f84fd41c83b2d3754b7b1aeeb0bbcadcad9ed77080b14011caa8e35befae9d",
      "text": "Tadi pagi kamu dengar Dokter Fitri di radio?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a856f90ba209bf3217cdda510eb281d713a441997382e03f54f1caeea0d7a0a",
      "text": "vaksin",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c4bdc88d30a94a7bcdf286e42abbf8cbfa1df35b6e9aabbcccc77e9bbbdd825",
      "text": "ditanggung",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e379f71c9b4e5dc9bbc3f2154aeb75c27b8c43f356f7864867dfe860e3a42fe",
      "text": "Kenapa? Ada masalah di kantor?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "703ec7e6ea8eb74fe0c479f83e58219bd07ef942b132bd942d8c7e001ab82551",
      "text": "Kalau terinfeksi flu, pakai masker dan istirahat.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "709d9fc8946ecec4b4ca967e4b88618a30d315afddf61b846c11c72a637aa8f6",
      "text": "Kurangi penggunaan garam dan gula.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7450e36bc31652f99201cdecd81230368102ff4e57071f6123106bba871a887a",
      "text": "terinfeksi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "77728b9194a08341bf38365ebdbe998521907d08c3ecac37c9a8c03297dc1ff3",
      "text": "kuku",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b37463db844142865a06d2e8e3114cf9df730cc33fe2d24233385e5812b1007",
      "text": "Dengar. Intinya, kurangi garam, olahraga teratur, dan periksa rutin.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d0af5696182f1c4c3575bd5a00d426fee89297ce1f0a07e27dde53330711361",
      "text": "Daging dan ikan banyak mengandung protein.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e14ab1b68be1fc4d84a43f3ea7efcca153a78906942f1a46fc69f4135a1a2e0",
      "text": "Akhir-akhir ini saya sering pusing.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e6b4cdda3c9a760f72cdb66f6ecfb7cbe410cee4bd656297ff05abec66c47ed",
      "text": "bakteri",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fd5c996bd586a1dac8375ef68508c9f4bcdeb2026ec8b6b0623c014b96a7952",
      "text": "pengobatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "82dc33841682bae5f88d5da2106418b42be4de9d206ef81122a6a085fafb1696",
      "text": "Kamu tidak demam. Mungkin ini alergi debu, bukan infeksi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "830b77aa862e1de52247517ee0d35da047901b5a65b7695e5593824c8d11edf2",
      "text": "Pertama, kurangi penggunaan garam dan gula. Kedua, berolahraga secara teratur, minimal tiga puluh menit sehari.",
      "voice": "id_gadis",
      "chars": 111,
      "mime": "audio/mpeg"
    },
    {
      "key": "8528b616f630c3479d9aaa74841a9a9307d0204c810ec94e55c2e2c4c7dee4bf",
      "text": "Bagus. Pencegahan lebih baik daripada pengobatan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "855d520ede198011c118655096a7ef15fec33cca9888b2e3ad6833fdbb10ac45",
      "text": "Tiga hari, Dok. Di kampus sedang musim flu.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "8653bc0bf9c8b7fc36e509993ee00629b1b671719bae179e13d3764fe61cdad6",
      "text": "Mungkin tekanan darahmu tinggi. Sebaiknya kamu periksa ke puskesmas.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "86a4ddfeb18ceb35df8de18c2e9d1c6f66557a4beafb940e0c007a3d5876f9b6",
      "text": "Biaya pengobatan saya ditanggung asuransi.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "87c86ea830535ff40561b7e3b71153d9fbc2e1a8992068b7250d9f4a594f91b5",
      "text": "Keadaan pasien itu membaik setelah operasi bedah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bd36b45a57c16ece8112ec0e7c8bbbced4a923dac0fd83714684d134159e886",
      "text": "Jadi kebiasaan sehat adalah pencegahan terbaik, ya.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ef0d61ce7fffb4edf691c1db1b3ccc99b52101ef4a892c7d7d47d09500fb3c0",
      "text": "Penggunaan gula dan garam harus dibatasi.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "915cc9c425f45071496e2cac53a9e047fc97b9739dd7d1d954e5ddac7af9962f",
      "text": "Tahun itu ada ___ kolera di banyak kota.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9322eae4e92275a93f1658bfd03c7b9c8ad2d4dbbccf5c6c37d6ca9108e14c1f",
      "text": "Olahraga teratur menguatkan otot dan jantung.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9579e2040c79ef9b10b83e56b9699a1754d10ff74a70199ee9cbd980cdb99a30",
      "text": "penderita",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "96d435c38ce06ae2218ba9c1a9787b81a92d22769d771d415c52c241a97c575f",
      "text": "Selamat siang, Pak. Sudah ke loket pendaftaran?",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "96e75412b5c64d01385f1639dcb3a9a88b5d22f7996b5aa1b5f27529c88315ad",
      "text": "Banyak. Malam hari saya gelisah, kadang sulit bernapas.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "988eea79a341147b0ec051af10f828ab6a6751b832f58beb704fc63c74e88e90",
      "text": "Makanan manis meningkatkan risiko kencing manis.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "99e04d675f9baa587bcee1eca4733cb7b72e7f1c1f339e8167ac3c2abf1c7063",
      "text": "perawatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "99f8e552ecb3ba60d28e5b5a992b2f67e0fe9dc7ab34454868cc59eecaf2c1c0",
      "text": "Ya, Dok. Saya ingin memeriksa tekanan darah saya.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bd37f55df3236b28ac3032d997c23171f77de459245e433e69f9fbda6c71b29",
      "text": "Wah, ringkasanmu bagus sekali!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ce6f39a2418da7d4540a2e869bb1646f85726d4ecc9d3b8fcc7133bf7483edb",
      "text": "Andi mengalami cedera lutut saat bermain bola.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d5f69043c4deb935d4c59343ecde0320756d80d995601ca099cabba5872e3a2",
      "text": "Suplemen dan pil diet ini beracun untuk organ tubuh.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d8ffba9006e14fc40f121673b82aad774a0fd6c0e322a92b807a7dcb0e8f76d",
      "text": "pendaftaran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2711fb69cdb7ef213164509c045033b88633b81e0235ac1e4ba79c9f4a4b585",
      "text": "Suster datang setiap pagi untuk melihat pasien.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4afc6dac6da46ffc2d27fa218028fcc3f68b44fc24a8218df1f99c1ee348f82",
      "text": "trauma",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f2ec77a822131ed4a3506cb98ca22e73a1ee6c0cf9e978c55bfd85489cdf9b",
      "text": "Pemain bola perlu banyak protein dan cairan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a53d70d8110456a09ef295f83dc33f797e95b9572ef6c53fe89c5c8ea1addd7a",
      "text": "dirawat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5ae061fcd6707392c8d3c65a2f76a7489a9b983761887b62f074213fd40e93e",
      "text": "Antibiotik untuk bakteri, bukan untuk flu.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a65be8a7f7f3dfb43cac0627f6e52bea530e2ca52b94c5d2f410340127933d17",
      "text": "Intinya, olahraga teratur menurunkan risiko penyakit jantung.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "a71779ea490b6a0fa378339d28d0eba6f85e108ac7fbcf33b1f039f9be638179",
      "text": "Latihan ini baik untuk ___ otot kaki.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "a925520899a2a9a9d46c626c5bc3095f92eb2cc1a5c0d6ea8091410abb82bed3",
      "text": "menenangkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9470188ec4b8a7835bcb7c565ac21793706d6601a608c31fb8ad2928cc376c8",
      "text": "kesehatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a98b7ed50a98037d6d44341020b13a70e0039e479450b65102a143812951dd0a",
      "text": "infeksi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "aafc0508029bd7e2d11ccaafbd09620b8550f6398af3c8c4df56115f6280ecc6",
      "text": "Biaya pengobatan ditanggung asuransi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab3ca2f4ee3b4024bdc169f6a1c3b739c98c2e01832050a2d3b873b12842ee10",
      "text": "Pertama, kurangi penggunaan garam dan gula.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac0fd1a6241d18165ff0c60278a0d3461c24bbee450438cdd78ebb52cbc49d32",
      "text": "Apa intinya?",
      "voice": "id_ardi",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "aea0d9de77f0548a6cc8dd73e49b11a359e1789149a6a96b20714317fc7fdf6a",
      "text": "pulih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "af9d7e5f676c8ba93e86c06e80b551acdb7a36de183a00559a151e27c1c8de3e",
      "text": "Menarik. Dokter Fitri berbicara tentang darah tinggi dan kencing manis.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa031aef827d7f6d1bf1c37d34b9f4fb21265011c604566c4ed97fe4206cc0e",
      "text": "wabah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa036a94d2d78b9f7b4d9b46473e5e37102e282de3424d62d9ec579e102af5f",
      "text": "pencegahan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b02106f73ad1fbc593260a7d14a7fd8786fc0a07abaa6e6a2cf3ee305d8cafb0",
      "text": "Perlu operasi bedah?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "b054da073c0f8e296a44fc1cd70cb60aa0a00e8d0dbf90a49bc77fc59bfd42bb",
      "text": "nyenyak",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1e62c4094e9db8b96f9d2eb56593fdc3aea56eeb381c8114f679af6db416344",
      "text": "Dokter melakukan pemeriksaan kesehatan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2df4c1e72dd45974640eac06f31d46f3d8ee6be59257bbeab5ee99a64cf16d3",
      "text": "Itu karena kamu tidak berolahraga secara teratur.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3df41f0eebd26288cf06a6b8bcc8a69ab0598cbb89944a519c18c2ffdc79152",
      "text": "jantung",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3e294d22f344355016310a92e3339ac2a3bc4ff76b84f9a3d3fa3f3dc5897a7",
      "text": "Minum satu ___ setelah makan malam.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3fd191fde47549ada5fabeca6497aa900b0905c752dedfb7ceb503d80322ceb",
      "text": "Syukurlah. Semoga cepat pulih! Suster di sini baik?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b44b133af92a3f9b62f460e0be739826aff9615c9b18997bf8cb6e035559c7d6",
      "text": "lidah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc233f2e27cb7c4757f3889adc490a4f342db838c4d2b3405c53cfe84cc51f5f",
      "text": "Pengguna internet di Gorontalo makin banyak.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "bde1defb5dd90b0c8e04c87c43b094146269dc60bdc60fcf9e1121f49f57636d",
      "text": "kencing manis",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf10aac8676bc823c9b851373b46610181079288230dc323a2fd918ecbfe93e7",
      "text": "Saya berpendapat bahwa olahraga teratur adalah pencegahan terbaik.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf19d5fd099ff4b965da613ccc1461e588f5e6154ed5886a47b10463e346b852",
      "text": "Hati-hati, Andi. Ada pil diet yang beracun dan merusak organ.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf4aa3a04adfc5a6d8c27319f025e04cf44e8c83fbd2e3ca55ade63700226fbb",
      "text": "Adik saya kuliah di fakultas kedokteran.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "c07bc72a023a76c8e80513afc809fd862486dfdd73afbfbbf30189592fd4572d",
      "text": "Dokter memeriksa tekanan darah saya secara rutin.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "c170a2392348cae6fcdf98f856053287fc7fb3257ab13871de36963e27f346f1",
      "text": "Halo, pendengar! Hari ini saya membagikan tiga tips sehat.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c18d05570fb9adef637965fff0a13538cc9bd8ccb4317e0d00e318bcb218c6ac",
      "text": "Nah, itu tanda bahaya. Diet sehat lebih baik: protein, sayur, dan banyak cairan.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1b3668e18b73dd70457b2a404873f403b71b243849e46de0f38353839dab132",
      "text": "penggunaan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4bfc74cf74c0f5118337576b2c02d5a0d2ea8a2d869b967d7f22f721080b51b",
      "text": "Jam delapan. Datang pagi-pagi supaya tidak antre lama.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c93e1e9467f1b863d7e48e0da9456d5ac14a4c1632006a7bbc43fa31c7be0737",
      "text": "jarum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9f871f1533dc3de07512b5eebf383bb2e759f416f67f182bed26c3477268ba9",
      "text": "Iya. Bagaimana cara meningkatkan daya tahan tubuh?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca81a5f2b9976cedbbcbdea88b2dc4e47bea10bf8ac26bddc2b5c7c5acb338d4",
      "text": "memburuk",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccc3563450e1a65facb2077185e7562846133cf9f805d9dc4d9f989e30138358",
      "text": "melakukan / lakukan",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceb10800260d6fcc3bec39646d50dca392834ec84d59cba83b7a4dab121f5199",
      "text": "Baik, besok saya ke sana. Terima kasih sarannya.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d18b50d19de027985baee548732ab567565f9c039449c3d391adfed0897a6561",
      "text": "Mohamed, lihat! Pil diet ini bisa menurunkan berat lima kilo seminggu.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20ca2189a2a5b907c90478d1766d2d8658592038dda45bbb3d8832c0673c77e",
      "text": "saraf",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2f5727662b0a2e935e2bc8050d0ff4b8041ed4799e07ff705ceda234b739e42",
      "text": "Kedua, berolahraga secara teratur, minimal tiga puluh menit sehari.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d74c578bbf41c49c3a0ec07905101bc33cc13f70d758e321c1a1a5564af42c5a",
      "text": "cedera",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7f0062d6b2fb1689589134caf97bb0227a38eca5d0838e2fb1b753cd2ca26a2",
      "text": "Pencegahan lebih baik daripada pengobatan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "d97f38b352dc2a6fdfe14aaee293a63b488b9a980495d8aa4247e5cb292be714",
      "text": "Benar. Nanti saya menulis esai tentang manfaat olahraga teratur.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddcd57e84ff5726370175a3115a6be3001cc7f03ef2850ea7ba1aa66c133695f",
      "text": "membaik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "deaea2571db4cf501e87218ee882a51a897feb1bc7594f11a15bd08ebf6fab68",
      "text": "beracun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e06621703db3dc0cef12d21ee205de2f032846ac71edc58c0dcfe0cda1c804b4",
      "text": "Pemeriksaan kesehatan dilakukan setiap tahun.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e08d2ff9e059536be241a9d0b30b1017f59b877fb1f0b39b32e00f85833dbf68",
      "text": "Penggunaan garam harus dikurangi.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0e9517821103c416c9d10dc1ebfb59704b7da4f6743315a91d0fd61c294a33b",
      "text": "Jangan makan buah itu. Buahnya beracun!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d77d34a06d3f59ea9a2e926c1f17256363aab73a583be2d1b240f0411fcf97",
      "text": "Semoga cederamu cepat pulih dan tidak memburuk.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2f3c23b5b97f60219c18fb2253d0f6f7b5e19bcb804dd55497458389435c2ab",
      "text": "depresi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2fce0016787e69f590417c553641b0f6f53dfbc67b7104d5f5d8492762d8cca",
      "text": "Pelayanan dan perawatan di puskesmas ini sangat baik.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e54ddb4470c5c7a94c44f6c4490f5b3cc15b8d6e0e1159e55c51d48b8b32135c",
      "text": "Kebiasaan tidur cukup meningkatkan daya tahan tubuh.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e849c3103d84b73b9a1b62e00dc2b1162a166cb7fe06de8849e1446e01304f60",
      "text": "menular",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea14905bb69538a32ba807f0dfa392213f1c419af196fd9808a7bdbf4362a98b",
      "text": "Hari ini saya membagikan tiga tips sehat.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea14c9d397360efbebb8b8dccd1f125575842445026808b9dfcf67f2cbbcc606",
      "text": "Intinya, pencegahan lebih baik daripada pengobatan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab46040e1a75f6a0cea48ca4925362c2ba2aa828141eff50795c2aa77daf4a4",
      "text": "Kak Nurul, wajahmu pucat. Kamu sakit?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed4169d0e0ccdd426c624f6b83e091981787c96e5a8464f7ee40782a0f698363",
      "text": "Sudah saya siapkan. Puskesmasnya buka jam berapa?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "edcd99fb022ecc614b369d40be0817a49c7c4f6fb2b669c180929d6050554390",
      "text": "Dengan demikian, olahraga adalah bagian penting dari pencegahan penyakit.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee187980d2f6ef712cc1c29966a915be3dde6b8f59d54bb3a8c775d8eaa416dd",
      "text": "Saya ikut! Kita jalan bersama di taman kota.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee6b182b1285234da1160bd34cfb0a6dbe788e55d0da4e71e0ffaa8eee23fef5",
      "text": "Olahraga teratur menjaga kesehatan jantung.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef7dcedaab2ab579b8bf0b2af7a74f8b3543e359842df20a6715edd3255e0ac8",
      "text": "Flu disebabkan virus, bukan bakteri.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0041b84df662b7cbda0e8a40a0afc16007ca43479fed43de6a4ce35c3f85870",
      "text": "Imunisasi melindungi anak dari penyakit menular.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "f395a8c202eeef750a90c4ef58840cb5171dfff26fd2b245e24bf1cdd8d594f3",
      "text": "kedokteran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f72f2d07d04f49358d749b4350ff688c42854769e539c88b933460bc06830e70",
      "text": "Kalau diare, minum banyak cairan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f84bd6745302a9733c7c57be4b2a238be21be93c352b2a49ffd10f8f6a85b32d",
      "text": "Intinya, gula dan garam meningkatkan risiko kencing manis dan darah tinggi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8aac85986dfd2741a836d077285175d32263645e7e37aea9747607d4b980994",
      "text": "masker",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa52646713d5b75ea9207e3b1d8419f7829d42298738effa34bf8a3e893f59c1",
      "text": "Terapi bisa membantu orang dengan depresi.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fad4bf44f7ec324c35f1a5f56fade54f030ec309aa23d8ad4d32dffbfde399e8",
      "text": "bedah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fada8b33fe44c68b918fa0b0964189a4131d27254c04e85874b480c4fd6a5253",
      "text": "Jangan tunggu sampai pingsan. Coba datang ke ahli terapi, ya.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "feda72778d66eb4a415c62b0d8211dce9c4243c0a4bb6340fd83eb79a8133004",
      "text": "daya tahan tubuh",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    }
  ],
