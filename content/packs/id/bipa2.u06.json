{
  "format": 1,
  "id": "id/bipa2.u06",
  "language": "id",
  "unit": "bipa2.u06",
  "version": 8,
  "content_hash": "9b8e3abfd15408c29f1427d79ae617c59040652c72ec2488f1e1114e58f59207",
  "lessons": [
    {
      "id": "bipa2.u06.l01",
      "sha256": "5c5e727c0543e368cfceb3407fd02522520602156698b4cd0fab7ee6bb3825c6"
    },
    {
      "id": "bipa2.u06.l02",
      "sha256": "4c3af1327165a6983ac9e78232dfe62e74f526b4ff8f7161f67e43d0ba5c742d"
    },
    {
      "id": "bipa2.u06.l03",
      "sha256": "4527255d7496bd16560e3a86b0df88dc628bb47b75ae9f2a2d77515a1da130a0"
    },
    {
      "id": "bipa2.u06.l04",
      "sha256": "422a6e7185a3485e32f430dbc59a6cccfc184d46ce15a25017ee5877e9a316b8"
    },
    {
      "id": "bipa2.u06.l05",
      "sha256": "4e089906c7863f32908f39b54a3c893c6b19d7e5755ffb56432f1dccefbcbc8e"
    },
    {
      "id": "bipa2.u06.l06",
      "sha256": "744e422965cadb13bd7fb5ee630598949672af0b23841dd4b28f841c5ba34a8b"
    }
  ],
  "audio": [
    {
      "key": "00fe2a70b31cd3f6e0a4944ddd479c517b9a0cb3c855c0ca51db8568beeda67b",
      "text": "Di sana, di sebelah dapur.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "024a8e973224df39b144cfa14dc8b98bbd03c60f5124e9dd9f18115fb4934271",
      "text": "seberang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0520b8780c749e058bb77dd2c9cabe40a0f5d8c1d51f219d4a20372a0e25d619",
      "text": "Boleh. Ini airnya. Silakan minum.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "060536d047cbe5e00d2b1087b7e5c830cc64b6159310cba314d7ce738cce7f36",
      "text": "Permisi, Bu Yanti.",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c185ee9d268adcc73c0ce443c9db034551f7c7b14e521b8f77b338982bf90e1",
      "text": "Kos Bu Yanti, Sanur: ada dua kamar kosong di lantai dua.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c91ff9dd5c39303af13635ff5ea9ebcda455ee087518df1a74c79f87905e9d8",
      "text": "Rumah makan itu dekat stasiun kereta api.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ced4ae1f4d10cdacbb703766457b959e7818679c87cb3bf29944a106a4529a6",
      "text": "gang",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e27772f894045b3d745fc102c3bdda029e596a57d51bf36d01a6a8074106175",
      "text": "Di kamar ada kasur dan lemari?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1092512189ba2b7ba85d4d134cdd9dec21e67870239e75d8d36395e378f14a5d",
      "text": "Warung terakhir di ujung gang itu lengkap.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "164fed4f9dbe4f133b435415160ae15dca74aedc0a80f85c3992c05845cd2372",
      "text": "Permisi, Bu Yanti. Masih ada kamar kosong?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "19ea67cc932df218e16e922679f93f4b628a6ebb6e5ec396b267e8d2b95d7c6f",
      "text": "mata air",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7df30e78bf78be0f2108a549657ee066c6990b29c99b71851f988588b0d1da",
      "text": "Ada apa di dekat kosmu?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dc377eb06efb4dc3492870e4e9248c3c1e8976de0b8f0fb87b3cf73363c958d",
      "text": "Ada. Ada jendela besar juga, jadi kamarnya tidak panas.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e05bb28dee9fdf8eefa68e9364c310b8db8c3ab234dcd72d010b51dc26b85b1",
      "text": "Ada lemari, tapi listriknya belum termasuk.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f665533f6bd1ed8165a41869b2bc976a99750fdcda7ad9366838e7fae3a7e1e",
      "text": "Ramah sekali! Setiap sore Bu Yanti bilang, \"Silakan makan, Pak!\"",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "20351b6814626950935f56c3fe1945476b90c80e74bc5849539d04982745ff1e",
      "text": "Rumah sakit itu dekat dengan kos saya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "223e593785b6ef394536d0259b94995949ba90d04950ae64b3a9b8e21ccb537f",
      "text": "Di depan pura ada seekor anjing.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f626fab333f8836bcd33e774ff1420f11f2fcb68ec3c10f48cf251358c9278",
      "text": "Anak-anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2330ff6440b8904d02a3ed9f6e99a9f864e62bb1d3849080ee6b86b1083a091c",
      "text": "kereta api",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b0c029cf728be5b43e4b22217524c1b043117b3fa263bf756a99aa0ae54af0",
      "text": "Di jalan saya ada sebuah pura, sebuah warung, dan sebuah apotek.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d7297379e844dcffd56f62bc7e33e9c0050331c817957396f5a7a4f40f0511",
      "text": "Tetanggamu ramah?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "28e79f2e05baf185b456f0de849bca0e8f459ca764b9e61aa956791ebb315230",
      "text": "Kos ini ada di ujung gang, di seberang masjid.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "292706d96a422511e87d9c27e73b76ce84f54866bfef5044f2ee96b1b7eddea7",
      "text": "rumah makan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a0f795ac4e40cfcc4ba37434704327f0d715610d3a22f353e14df570600ceb9",
      "text": "Di ujung gang ada sebuah pura.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd70c74b0c8df617a4ca343115d570207bd46781fdc97ab4498826c0e90e39e",
      "text": "Masih, Pak. Ada dua kamar di lantai dua.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3187adcefc32a6f4383734d970156648e9e022e66246350d8f9ab613b9a78d13",
      "text": "Silakan masuk. Kamar mandinya di sebelah dapur.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "3345ef0c332c2b69c6c90046e889ac961c163b808660a37603f8d7f295ada76f",
      "text": "Ada, Pak. Ada sebuah kamar di lantai dua.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d5c81f440fbc15fec96142209102dbe5dd7a4ed8d21343c5508148ada48cdf0",
      "text": "kasur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ddfafe5110453d4e00f93fc58d85fcff25000c90c386f0800d384685dfe782e",
      "text": "Berapa sewanya sebulan?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4078034107338d6e20a1836187fd71bb8eb76defbd7d34d0cee8c96a1c718564",
      "text": "Permisi, Bu. Masih ada kamar kosong?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "422287b1ef986a0e0357193033954a593b10274d5f2e1a999ceae40fb2be4fa5",
      "text": "meja makan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "42759a69caa16831a4b64af99e4888abcba6c4cb9365363090ebd87da77af936",
      "text": "Mohon tunggu sebentar.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "45f412f94e21a9b64821587384c9e94c75970b35914949cfc2d410553b0a43e1",
      "text": "Kamar mandinya di mana?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4683ec5f5278294297ce1550e89fd2bb67969c1d063eeb3a49175f4ef07854bf",
      "text": "Selamat datang, Pak Mohamed. Ini ruang tamu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a399604805dc18f98f5c3a537192f7beb3563fcc14a2b9dc807d20d1526c8c",
      "text": "Rumah sakitnya di seberang rumah makan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b94e2047874986ce81cb74b9c3f324e004870ac00a8f5994900a865434523dc",
      "text": "Boleh minta air putih, Bu?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e8698fbbe96f471227fbdbba148f5eab4e54c987f56305b0418fb0f6fdcfb3c",
      "text": "Kamar tidur saya kecil, tetapi bersih.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f201722ce12faacfb984a1de5a196f16f475fff196d90b1736f194ec2901600",
      "text": "Tentu, Pak. Mohon tunggu sebentar, ya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f7c8786b7f2d95f34418ec8c15344ee612d43d328389d0410e366ae52bbc41d",
      "text": "Mohamed, bagaimana kos barumu di Sanur?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5269dcfc70598d61e01503b33a757d2e0b29b4fe469f9441c0ba86f639129596",
      "text": "Di setiap kamar ada kasur, lemari, dan jendela besar. Kamar mandinya di dalam.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "5381cd757172a83a1dc3dcc4dda09d33af71bbe5472b8c9ca6a2103a8167c601",
      "text": "Besar sekali, Bu! Kamar tidur saya di mana?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "543bf0a2ffc18788fef7ad1616210d302b8ae963573575f0db96d4346d553667",
      "text": "Sewanya Rp1.500.000 sebulan, sudah termasuk listrik dan air. Kos ini ada di ujung gang, di seberang masjid.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e95c5db8bf9bac026771b05e6ac64a5aec333e0ecd95cc1a9fc921aea1c1550",
      "text": "Di jalan saya ada sebuah masjid dan dua buah warung.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f937919a30d87fda0468441252ac381aedb9f3e79b78ca22bace2fa800e687f",
      "text": "Ada, dekat sekali. Tapi di depan pura ada seekor anjing besar. Hati-hati, ya!",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "61258216f835160d595a4cd96a6a3d332298efbb082659005f2c3b7d339321d5",
      "text": "Apotek itu di seberang warung.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "61da7394bb1d21cb0753808737c4be544dd6c15706c1d978cf97a73ba8c6e732",
      "text": "Di depan rumah tetangga ada ___ anjing.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "633d1dafbba8396435b0a82e96b795b17555a2bc2eef9d780cac839fa4d2e317",
      "text": "Kamar tidur saya di sebelah ruang tamu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "65bf704376710bd54ee0bb7bef37977f9e8c2489efffc02403d5893d20d4a8bc",
      "text": "Mbak, minta segelas teh manis.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a281a368aaba9cbfa39ff0ef9f4d2f24efda3905e0163d765b7b556a63472cb",
      "text": "Bu, tolong bantu saya. Saya mencari kos di Sanur.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae64f265fa314d7b7bf59ca7a41557a4d730d308eda0c03fa1adee24521208d",
      "text": "Masjidnya di mana, Bu?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f312e55e606df5311253d05c4efa742475bc26f5a00c2f88ef1b4484642b74c",
      "text": "Di dalam kamar tidur. Meja makan di dapur, ya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7314905506b1035ae254becf287bac8de58d6d9ec4ad7a442f71ee8b2151ce0f",
      "text": "Rumah saya rumah terakhir di gang ini.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "777532809e5f98558b492dfdbc598a5d1a98db2db162fb748bd64b0ba87e985f",
      "text": "Dekat sekali, di seberang kos. Silakan lihat kamarnya dulu, Pak.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "77cd8753ef80df5c580758f2be810b6f4caa1e4e519bb1d890e7d9d72b101943",
      "text": "lemari",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7894f41aa7c6e9b67ea83c743cd78d4fa8d743942e4478293b7294f40a5a963e",
      "text": "Mohamed, kosmu di mana?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a87309574b4f69bfc1b5d57af9577a2fb4ca93c0eeff47353b116d815683d94",
      "text": "bantu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c61773c4355f6de154cb3ac3379b5f54585a8df2a3ee38bfe87e575d2443f4e",
      "text": "Oh, Pak Mohamed! Silakan masuk. Silakan duduk.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e6e1327c454acd267218ab7ec5e654c1ba659c6ac36fbbf9ad556e31ebeb467",
      "text": "jendela",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "80c494ff796b872859e23f780ded3b7e4844efd2cf0da1b577f33dcde012f419",
      "text": "sebulan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "81168537cca49a4efce4ab72313844c7bd4042c5235527c870a4f6d4f9f046e7",
      "text": "Tetangga saya punya seekor anjing.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "85d9475f69f4db08a707b06c6fd9ba0160a33d02b087d933835113ffae90f4b3",
      "text": "Jalannya bagaimana? Ramai?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "892a5fe064bc31563a289564f22bd772b67cd0b08f63a5cec6a2bc5e0e13a8c7",
      "text": "Ada sebuah warung. Di sebelah warung ada apotek, dan masjidnya di seberang apotek.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "894c3e165ada02b1873f9acb5d3a007e48d4f073aa13b67e34de53c67ff5da0f",
      "text": "Silakan duduk, Bu.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b887f29f350e01e63979a5c24095126dc1f9ba36236f767e20f31a3844c5b8b",
      "text": "Di Jalan Danau Tamblingan, di ujung gang.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9178d1b99d57c229855114a028557ca420a34a15eea8936efefbe4fb22b41805",
      "text": "Bagus! Kamar tidur saya besar, dan kamar mandinya di dalam.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "929c4e84bd452c6f4827ec68ef6a8669800211b48a6bbec372ea8c07a2940ab7",
      "text": "Di setiap kamar ada kasur dan jendela besar.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "93f18792c17ae3e3850691089888861c972e444567c911f50e5e0daa696d05c7",
      "text": "Kamar mandinya di mana?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "94693f3e545aae71430288838f12c0a12b63fc38b340ef6e70fef17976342f07",
      "text": "terakhir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "95cb731ce69f712a883a49a8bfc1998e6ca5908a1310cd54426b02e80703d3ca",
      "text": "Tidak terlalu ramai. Di ujung gang ada sebuah pura, dan di seberang pura ada warung.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b55fe4c31dd3cf3f5f7b0dc273b040661a223f10083ca2e28b71ec08cab3ba",
      "text": "listrik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2f2c05cec2bfdb82c59f2ed1876b2a33c77f8e8c51f71de5ee6045a60740535",
      "text": "Permisi, Bu. Di sini ada kamar kosong?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a81ce186bb978f977929c87ec79c05b886b5010202e60299b8a9f29b70dbaf7c",
      "text": "Sudah termasuk listrik dan air.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a914f5bc3db70a12531746618f77d563689863502567e61b422bbea5023c7e86",
      "text": "Ada sebuah kamar kosong di lantai dua.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab37758b1378803997b1e79c30376f7facc6517ff0f16f437d987c3e1ecb8bdd",
      "text": "tetangga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b44c718b57be653aadf14f6d85076bc2c18d1e54338df8322fc06bb69a5c630d",
      "text": "Tentu! Tunggu sebentar, ya.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9b59bd43bfe58c4f1f03fabc04e5fcdc7ee38e14eba76d21b611e6fd55c51f4",
      "text": "Berapa sewanya sebulan? Ada lemari?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba9ae2c668090bdd82f72335fe763b881363c7ce1147dff8591a2a061394c8a3",
      "text": "sewa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb161b272b533b2f1e61de04eac63b6c6da3d52659748c474904e22d3c5139d0",
      "text": "Kos saya di ujung gang.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0e04f971afd2f1a4d72e72d5777ff205a1c405f8f368c6d1cda83ed8c6da35d",
      "text": "Wah, lengkap! Ada pantai juga?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b677e05d0be151065cfb0c87f89be0f3d2029589c22ab3e9a3bffe2883a04d",
      "text": "Terima kasih, Bu. Boleh minta air putih? Hari ini panas sekali.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6b530b372f2f1a5a4254bbc2c54b90cdfc9951bc37166868c8b094c3c9cfe6b",
      "text": "kos",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8f2a02d37327156785dd4af6747cda535d5aa5c7c50f7d30cb7f1f76c9fc292",
      "text": "kosong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c98ce8378e2353e9b7c0a4b961e1165c1ca2ce4ca2845d2a730b0f3add0c6c74",
      "text": "rumah sakit",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdff9d71083b8ddd82252ebefb045d56f1ce8827f6b9075bfada636cc622c5b6",
      "text": "Mohon isi formulir ini.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d02137295867fd260b976362511ba75d2570e902d001fed794d76f61bebeff7f",
      "text": "Tolong bantu saya, Pak.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3e99634b79631e74fbe0c17f9c42d62438e2a1e5622b2f42e01a791a1f2edc9",
      "text": "ruang tamu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5db9e4b2546d0fcbbae9cbab37f847e7568655a40aae5781572a9916d6ddb09",
      "text": "anjing",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b60a62ce020c3fd3c50f4e91eac32b60bdaeeb18c8b3623a62c1203df6f18a",
      "text": "sebentar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd7a69b365dcec05f00fe72d64636ecb8faa2f4f7bd3c257b16066682af8c82c",
      "text": "termasuk",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "df826bc737ef578e360f73c7876cb40918d5397b3045722e51c223a54ee0a84c",
      "text": "Di Bali tidak ada kereta api.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0da6776fa5902a667234ae4980df5d9a7ca4a83f79760e57d6cdb261f5e625d",
      "text": "Bagus sekali. Terima kasih, Bu!",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "e157f6a3b2c64c447020502ffadb295ccf87c0c6995596f712144d7effa60feb",
      "text": "Silakan lihat kamarnya, Pak.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1a980cbb10eb695158905a0e0130581fdece1df306edfc69efcdfa663ff17c2",
      "text": "lengkap",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d2ddcae16bb83d485e056934825295f933b6229ee5b6a06fa30fd2841e7f59",
      "text": "Satu juta lima ratus ribu rupiah, sudah termasuk listrik dan air.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27143d344de63c9e17b4313fad0531e3605a0890c5383fd61c7b8f98749e265",
      "text": "Boleh saya lihat kamarnya?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea66916b96d8be41cb683cd89858207c96d08292d628308fba6845735e2bd5bc",
      "text": "Ruang tamu Bu Yanti besar sekali.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaeb4876cc4f77d8e7503a0fffbec27d556365980c61296d2d40ddb0b8a1e688",
      "text": "Pak Wayan punya tiga ___ ayam.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed20fa91a94833d524f58b8a6b5f204a7f6583cc79d101aaef9efb62e1011e4a",
      "text": "tunggu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eec4100be23571a0c84f06903599e1a5524aab4e90c903bd26ba6b0920bcd1e5",
      "text": "Silakan, Pak. Mari ke atas. Di kamar ada lemari dan meja.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f00862f369ad47bf7c13dd3d48316ff1b12887b21f75fd94f61fc598ed2c7662",
      "text": "tentu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1e0373a40a0e49f2771592a0660642f6029bca0bec13391ed4c6feb9d78d0aa",
      "text": "ujung",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f214e90e4989f35acaa92173404084da158361457a3599b90b439be217ef72dc",
      "text": "Boleh minta air putih?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f813059ad6d49cb634522ad26d2fb8cfc0bdc8f3660268c2dc332e8551e3077b",
      "text": "Di sebelah kos saya ada seorang tetangga yang ramah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8bfccfda6ef0e1f22a533faed063c6c4e8e46205b5af3d176801410671a69ba",
      "text": "Meja makan kami di dapur.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8e12586241171409f4eed8047cac7f54eb7b338c7bec64e6a8e6d4dcd32341a",
      "text": "Kos saya di seberang warung. Warungnya lengkap!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa518a7ea802e1ccc1748cfd69a599d2ead1272cc7d72af64e5d3883a7372363",
      "text": "tolong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "feb459c6a998b57d012ee62f94d601acc9f5c0334905480d84f85a9e9f9506c1",
      "text": "kamar tidur",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    }
