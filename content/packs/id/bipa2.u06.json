{
  "format": 1,
  "id": "id/bipa2.u06",
  "language": "id",
  "unit": "bipa2.u06",
  "version": 12,
  "content_hash": "bbdace05afd3db0714a2dcf8e6dbc98e44654c943964afdb7103af485490b41d",
  "lessons": [
    {
      "id": "bipa2.u06.l01",
      "sha256": "cbe06e9361e2af564eb8746a699ab750bcc188361d27f64314d32241c02d32b5"
    },
    {
      "id": "bipa2.u06.l02",
      "sha256": "2a83e285382e00c15dc9cb543d563b430fd1b52da6c9f416d1b6b9d0739eeb41"
    },
    {
      "id": "bipa2.u06.l03",
      "sha256": "610402c8ddc62b2ff056ebb4d3bb34895ee289133376a42d9fb7343f7ada40b8"
    },
    {
      "id": "bipa2.u06.l04",
      "sha256": "dcd442dbb892ef777f59eb79a4688f1f5c0f7e8ef4a85f4f7d3208e45210c12c"
    },
    {
      "id": "bipa2.u06.l05",
      "sha256": "7155a20bf2228391228c457c97098e330956118aba5e3dd107964db0fb100728"
    },
    {
      "id": "bipa2.u06.l06",
      "sha256": "5d03fdae7a01b340a1cc47471eb4afbbd8f8480bd5eb07f6bd66e04c66d6f26a"
    },
    {
      "id": "bipa2.u06.l07",
      "sha256": "68fc2c547978fb97a2c1876b6204bd2b5e9b5767a4e98b8b030f5b3e489f3bc0"
    },
    {
      "id": "bipa2.u06.l08",
      "sha256": "a50e045330e6535521388ed0f7dab5ba9c467df0cf704760463c320e41b0be51"
    }
  ],
  "audio": [
    {
      "key": "00fe2a70b31cd3f6e0a4944ddd479c517b9a0cb3c855c0ca51db8568beeda67b",
      "text": "Di sana, di sebelah dapur.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "024a8e973224df39b144cfa14dc8b98bbd03c60f5124e9dd9f18115fb4934271",
      "text": "seberang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0479eee0a6bdfc081ea2208b7c725e9eec785c6ef4dc9112986ad92b6be81551",
      "text": "garasi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0520b8780c749e058bb77dd2c9cabe40a0f5d8c1d51f219d4a20372a0e25d619",
      "text": "Boleh. Ini airnya. Silakan minum.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "060536d047cbe5e00d2b1087b7e5c830cc64b6159310cba314d7ce738cce7f36",
      "text": "Permisi, Bu Yanti.",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "08c287e46e9caf7d49d96f349fa83d3c3888036bf3f0a15f453fdc164ad96a8e",
      "text": "kantor pos",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "09fc5ffdb96c89357fa503de48bc0a79c2875893b97ed1db63cb8d1743072664",
      "text": "Kucing Bu Yanti tidur di sofa, di atas bantal.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c185ee9d268adcc73c0ce443c9db034551f7c7b14e521b8f77b338982bf90e1",
      "text": "Kos Bu Yanti, Sanur: ada dua kamar kosong di lantai dua.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c91ff9dd5c39303af13635ff5ea9ebcda455ee087518df1a74c79f87905e9d8",
      "text": "Rumah makan itu dekat stasiun kereta api.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ced4ae1f4d10cdacbb703766457b959e7818679c87cb3bf29944a106a4529a6",
      "text": "gang",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e27772f894045b3d745fc102c3bdda029e596a57d51bf36d01a6a8074106175",
      "text": "Di kamar ada kasur dan lemari?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "1092512189ba2b7ba85d4d134cdd9dec21e67870239e75d8d36395e378f14a5d",
      "text": "Warung terakhir di ujung gang itu lengkap.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "123268869970aaa54caf203e23314dda75aa06cda0d8e54c385c566d95bb6f5e",
      "text": "apartemen",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "164fed4f9dbe4f133b435415160ae15dca74aedc0a80f85c3992c05845cd2372",
      "text": "Permisi, Bu Yanti. Masih ada kamar kosong?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "19ea67cc932df218e16e922679f93f4b628a6ebb6e5ec396b267e8d2b95d7c6f",
      "text": "mata air",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cbe729879e13c1ce8cc03aad8f8dacf66f57e0a8fcbfcb521f527e5bbb62f98",
      "text": "ruangan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7df30e78bf78be0f2108a549657ee066c6990b29c99b71851f988588b0d1da",
      "text": "Ada apa di dekat kosmu?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e05bb28dee9fdf8eefa68e9364c310b8db8c3ab234dcd72d010b51dc26b85b1",
      "text": "Ada lemari, tapi listriknya belum termasuk.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "20351b6814626950935f56c3fe1945476b90c80e74bc5849539d04982745ff1e",
      "text": "Rumah sakit itu dekat dengan kos saya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "213c2f91788cde019d422c61ac25217b7fc3a0e30aa4f8eca954a1ac92d91f2b",
      "text": "Malam ini dingin. Mana selimut saya?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "223e593785b6ef394536d0259b94995949ba90d04950ae64b3a9b8e21ccb537f",
      "text": "Di depan pura ada seekor anjing.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f626fab333f8836bcd33e774ff1420f11f2fcb68ec3c10f48cf251358c9278",
      "text": "Anak-anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2330ff6440b8904d02a3ed9f6e99a9f864e62bb1d3849080ee6b86b1083a091c",
      "text": "kereta api",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "25b0c029cf728be5b43e4b22217524c1b043117b3fa263bf756a99aa0ae54af0",
      "text": "Di jalan saya ada sebuah pura, sebuah warung, dan sebuah apotek.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d7297379e844dcffd56f62bc7e33e9c0050331c817957396f5a7a4f40f0511",
      "text": "Tetanggamu ramah?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "260a22788039d98baa2cc8614703caed487b7d959587b75f0e85772f4388f67f",
      "text": "Ada. Ada jendela besar juga, jadi kamarnya nggak panas.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "28e79f2e05baf185b456f0de849bca0e8f459ca764b9e61aa956791ebb315230",
      "text": "Kos ini ada di ujung gang, di seberang masjid.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "292706d96a422511e87d9c27e73b76ce84f54866bfef5044f2ee96b1b7eddea7",
      "text": "rumah makan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a0f795ac4e40cfcc4ba37434704327f0d715610d3a22f353e14df570600ceb9",
      "text": "Di ujung gang ada sebuah pura.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2aba90ae7e79afbc94d7b3fa9efed8461792029cbc03ab2210043ee526b74732",
      "text": "Apartemen saya kecil, tapi ada garasi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f85ab5ed334981edde3b9541f16d53684dfd2fdcbc92d7ce3e9786bd58d8b56",
      "text": "Ini kampungku. Sepi, ya?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fd70c74b0c8df617a4ca343115d570207bd46781fdc97ab4498826c0e90e39e",
      "text": "Masih, Pak. Ada dua kamar di lantai dua.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3187adcefc32a6f4383734d970156648e9e022e66246350d8f9ab613b9a78d13",
      "text": "Silakan masuk. Kamar mandinya di sebelah dapur.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "31da4c3183b1956575f4d78317366c17970752a155aa3e74e99fa85ef6f946d3",
      "text": "Ada kebakaran! Telepon pemadam kebakaran!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3345ef0c332c2b69c6c90046e889ac961c163b808660a37603f8d7f295ada76f",
      "text": "Ada, Pak. Ada sebuah kamar di lantai dua.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d5c81f440fbc15fec96142209102dbe5dd7a4ed8d21343c5508148ada48cdf0",
      "text": "kasur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ddfafe5110453d4e00f93fc58d85fcff25000c90c386f0800d384685dfe782e",
      "text": "Berapa sewanya sebulan?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4078034107338d6e20a1836187fd71bb8eb76defbd7d34d0cee8c96a1c718564",
      "text": "Permisi, Bu. Masih ada kamar kosong?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "422287b1ef986a0e0357193033954a593b10274d5f2e1a999ceae40fb2be4fa5",
      "text": "meja makan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "42759a69caa16831a4b64af99e4888abcba6c4cb9365363090ebd87da77af936",
      "text": "Mohon tunggu sebentar.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "44573b22f100a4427f137a363d02f70960b4fdb17e03b4da43b4ed0d3ca1a809",
      "text": "Nggak terlalu ramai. Di ujung gang ada sebuah pura, dan di seberang pura ada warung.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "45f412f94e21a9b64821587384c9e94c75970b35914949cfc2d410553b0a43e1",
      "text": "Kamar mandinya di mana?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4683ec5f5278294297ce1550e89fd2bb67969c1d063eeb3a49175f4ef07854bf",
      "text": "Selamat datang, Pak Mohamed. Ini ruang tamu.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "48a399604805dc18f98f5c3a537192f7beb3563fcc14a2b9dc807d20d1526c8c",
      "text": "Rumah sakitnya di seberang rumah makan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b94e2047874986ce81cb74b9c3f324e004870ac00a8f5994900a865434523dc",
      "text": "Boleh minta air putih, Bu?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bace489a42cfed36d25d2f9f6736281ac066b2008e62c599132b16d82b152b7",
      "text": "Wah, bagus banget!",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e8698fbbe96f471227fbdbba148f5eab4e54c987f56305b0418fb0f6fdcfb3c",
      "text": "Kamar tidur saya kecil, tetapi bersih.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f201722ce12faacfb984a1de5a196f16f475fff196d90b1736f194ec2901600",
      "text": "Tentu, Pak. Mohon tunggu sebentar, ya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "514c47efc451a38850915d57d60f46c866b3fe5df426e6db39ed9a57814112b4",
      "text": "kampung",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5269dcfc70598d61e01503b33a757d2e0b29b4fe469f9441c0ba86f639129596",
      "text": "Di setiap kamar ada kasur, lemari, dan jendela besar. Kamar mandinya di dalam.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "543bf0a2ffc18788fef7ad1616210d302b8ae963573575f0db96d4346d553667",
      "text": "Sewanya Rp1.500.000 sebulan, sudah termasuk listrik dan air. Kos ini ada di ujung gang, di seberang masjid.",
      "voice": "id_gadis",
      "chars": 107,
      "mime": "audio/mpeg"
    },
    {
      "key": "5604f3755a7971fd0cfeb3fca3e7c6ad5647eda8d2d141b8751e3b53679481fd",
      "text": "Kantor pos ada di jalan raya.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e95c5db8bf9bac026771b05e6ac64a5aec333e0ecd95cc1a9fc921aea1c1550",
      "text": "Di jalan saya ada sebuah masjid dan dua buah warung.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "609e6842b3297cdded2e73d9824433b94389de0719ae7ff05441557a14da6185",
      "text": "Jalannya gimana? Ramai?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "61258216f835160d595a4cd96a6a3d332298efbb082659005f2c3b7d339321d5",
      "text": "Apotek itu di seberang warung.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "61581e2f7ac04a440d8d99389710fef9eb9be257d45778b4f9cd834538e187f6",
      "text": "Apartemen saya punya garasi.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "61da7394bb1d21cb0753808737c4be544dd6c15706c1d978cf97a73ba8c6e732",
      "text": "Di depan rumah tetangga ada ___ anjing.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "633d1dafbba8396435b0a82e96b795b17555a2bc2eef9d780cac839fa4d2e317",
      "text": "Kamar tidur saya di sebelah ruang tamu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "65bf704376710bd54ee0bb7bef37977f9e8c2489efffc02403d5893d20d4a8bc",
      "text": "Mbak, minta segelas teh manis.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a281a368aaba9cbfa39ff0ef9f4d2f24efda3905e0163d765b7b556a63472cb",
      "text": "Bu, tolong bantu saya. Saya mencari kos di Sanur.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae64f265fa314d7b7bf59ca7a41557a4d730d308eda0c03fa1adee24521208d",
      "text": "Masjidnya di mana, Bu?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f312e55e606df5311253d05c4efa742475bc26f5a00c2f88ef1b4484642b74c",
      "text": "Di dalam kamar tidur. Meja makan di dapur, ya.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f81c1181d3f64d779b5cc7338043c094596f7251c2488b965ac4c39aefd4f9b",
      "text": "kebakaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "71f4b9b3b6a1c3b4ca10ad576829e6373b6b5ff879d38112f80c63b5ee86fd4b",
      "text": "ronda",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7314905506b1035ae254becf287bac8de58d6d9ec4ad7a442f71ee8b2151ce0f",
      "text": "Rumah saya rumah terakhir di gang ini.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "77cd8753ef80df5c580758f2be810b6f4caa1e4e519bb1d890e7d9d72b101943",
      "text": "lemari",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7894f41aa7c6e9b67ea83c743cd78d4fa8d743942e4478293b7294f40a5a963e",
      "text": "Mohamed, kosmu di mana?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a87309574b4f69bfc1b5d57af9577a2fb4ca93c0eeff47353b116d815683d94",
      "text": "bantu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c61773c4355f6de154cb3ac3379b5f54585a8df2a3ee38bfe87e575d2443f4e",
      "text": "Oh, Pak Mohamed! Silakan masuk. Silakan duduk.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dcd6c29a3b9bf7d34b1ce8231c25e7c3e31d34892e8f20fa127de3550261ce5",
      "text": "Di tembok itu ada foto siapa?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e6e1327c454acd267218ab7ec5e654c1ba659c6ac36fbbf9ad556e31ebeb467",
      "text": "jendela",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "80c494ff796b872859e23f780ded3b7e4844efd2cf0da1b577f33dcde012f419",
      "text": "sebulan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "80d55ecc87890afc75af50d13d3405dc24d1f392f008d7bcb10dbd11a7f697de",
      "text": "Ada api besar di rumah itu. Ini ___.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "81168537cca49a4efce4ab72313844c7bd4042c5235527c870a4f6d4f9f046e7",
      "text": "Tetangga saya punya seekor anjing.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "86babcba462d8e310196efe1edfee604d938f18c8ee31f96ea0a26915c9696d9",
      "text": "Kampung saya sepi dan damai.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "892a5fe064bc31563a289564f22bd772b67cd0b08f63a5cec6a2bc5e0e13a8c7",
      "text": "Ada sebuah warung. Di sebelah warung ada apotek, dan masjidnya di seberang apotek.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "894c3e165ada02b1873f9acb5d3a007e48d4f073aa13b67e34de53c67ff5da0f",
      "text": "Silakan duduk, Bu.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8abb35d190f0ea89f528a68809651ed31567a8dfc66960be8f63626d1c69ad20",
      "text": "Dekat banget, di seberang kos. Silakan lihat kamarnya dulu, Pak.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b887f29f350e01e63979a5c24095126dc1f9ba36236f767e20f31a3844c5b8b",
      "text": "Di Jalan Danau Tamblingan, di ujung gang.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e7c1e64d50d31b05c52b5c028d6818b5d55e80f56128138901654576e8862a2",
      "text": "Dari pasar di Ubud. Murah!",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f887008771adf0e993f93ecdd3113eb50b2297c28b5da99a432bd5225009245",
      "text": "sofa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "90d5a8580ad3d0db5020817308cb3357f4764e8c8f9b6cb858a95cec1da83117",
      "text": "damai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "929c4e84bd452c6f4827ec68ef6a8669800211b48a6bbec372ea8c07a2940ab7",
      "text": "Di setiap kamar ada kasur dan jendela besar.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "93f18792c17ae3e3850691089888861c972e444567c911f50e5e0daa696d05c7",
      "text": "Kamar mandinya di mana?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "94693f3e545aae71430288838f12c0a12b63fc38b340ef6e70fef17976342f07",
      "text": "terakhir",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9701d8469304f2149be92108d45fc2b845458625dba96a60d6c7dc8b77c1b578",
      "text": "Kalau malam, aman?",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b7b021d394b2438de9f3c371b13813eec34e8ee92262f2d8549c95102f999a7",
      "text": "bantal",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c3fe7ae73cad9692737efa979ca3dbaa9795c393233141dfab8c39d7bd7bcbb",
      "text": "Keluargaku di Kairo.",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e3b033292851484aacfd2dedb4fbd170a09c5ca5bac50ddcfeada8e90041c4c",
      "text": "Ada foto keluarga di tembok.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f4a21c05fce31138f3c13eda63b994124c8dfcca55dd3dc05ed09a1447c7679",
      "text": "sepi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1b55fe4c31dd3cf3f5f7b0dc273b040661a223f10083ca2e28b71ec08cab3ba",
      "text": "listrik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2f2c05cec2bfdb82c59f2ed1876b2a33c77f8e8c51f71de5ee6045a60740535",
      "text": "Permisi, Bu. Di sini ada kamar kosong?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a712d8898b54fcccd5f517a46a46873b631211debc7758cd077dd68afaccb528",
      "text": "Bagus! Kamar tidurku besar, dan kamar mandinya di dalam.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a81ce186bb978f977929c87ec79c05b886b5010202e60299b8a9f29b70dbaf7c",
      "text": "Sudah termasuk listrik dan air.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a86df39a9013e2fa24d03941ff87d4e00cc5c77d327951daa215ba6f0baffb06",
      "text": "Makasih. Duduk di sofa, Raka.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "a914f5bc3db70a12531746618f77d563689863502567e61b422bbea5023c7e86",
      "text": "Ada sebuah kamar kosong di lantai dua.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab37758b1378803997b1e79c30376f7facc6517ff0f16f437d987c3e1ecb8bdd",
      "text": "tetangga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac7afcad45c5615ac2df3e1ca240b718033ed6d9a565f2ff958c03565a67fb90",
      "text": "Bagus banget. Terima kasih, Bu!",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1ebdb1bdc8684abd8ee643bb50e21a865f5cd3d77a7040dd185abc075355c1c",
      "text": "Besar banget, Bu! Kamar tidur saya di mana?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "b353b43e5adb95fd657074c378922431ed7a9ea2babc42bdd22368e52ef7675f",
      "text": "jalan raya",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4173e75f92ea7b526a3bdcf1d7ff2f2b47cc01d2140572b93b23b42212aab33",
      "text": "tembok",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b44c718b57be653aadf14f6d85076bc2c18d1e54338df8322fc06bb69a5c630d",
      "text": "Tentu! Tunggu sebentar, ya.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4fbcda399ba90d3c469c45d61cfdf8fe4464f6719caa38a0e55e529d15b8a60",
      "text": "Ada kebakaran di pasar! Panggil pemadam kebakaran!",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9b59bd43bfe58c4f1f03fabc04e5fcdc7ee38e14eba76d21b611e6fd55c51f4",
      "text": "Berapa sewanya sebulan? Ada lemari?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba9ae2c668090bdd82f72335fe763b881363c7ce1147dff8591a2a061394c8a3",
      "text": "sewa",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb161b272b533b2f1e61de04eac63b6c6da3d52659748c474904e22d3c5139d0",
      "text": "Kos saya di ujung gang.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0e04f971afd2f1a4d72e72d5777ff205a1c405f8f368c6d1cda83ed8c6da35d",
      "text": "Wah, lengkap! Ada pantai juga?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "c16a9fea74f7d29bc0f4beae786fd2c5d7a613c0f1564e571dddee7fac0419fd",
      "text": "Ada, dekat banget. Tapi di depan pura ada seekor anjing besar. Hati-hati, ya!",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6b530b372f2f1a5a4254bbc2c54b90cdfc9951bc37166868c8b094c3c9cfe6b",
      "text": "kos",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "c85a87e7e4f5c2b1f9f8de48416013b270b03db33181ff506e6d8891a09cedd4",
      "text": "karpet",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8f2a02d37327156785dd4af6747cda535d5aa5c7c50f7d30cb7f1f76c9fc292",
      "text": "kosong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9124cc52f92482c8f740695a2ca0cd8fa5da03d8872cd433a83b944a9d671c4",
      "text": "Kantor pos dan pasar ada di jalan raya.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9532758600eac2dad0510a8db042d5a9df78ae1f3b0b745606d7005a7a6a78e",
      "text": "Pemadam kebakaran datang cepat sekali.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "c98ce8378e2353e9b7c0a4b961e1165c1ca2ce4ca2845d2a730b0f3add0c6c74",
      "text": "rumah sakit",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdff9d71083b8ddd82252ebefb045d56f1ce8827f6b9075bfada636cc622c5b6",
      "text": "Mohon isi formulir ini.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d02137295867fd260b976362511ba75d2570e902d001fed794d76f61bebeff7f",
      "text": "Tolong bantu saya, Pak.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d35ffbf176d9616e4de4b2a3f3709f5d824c9c88ee9c30662adc45c550bdbe23",
      "text": "Ramah banget! Setiap sore Bu Yanti bilang, \"Silakan makan, Pak!\"",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3e99634b79631e74fbe0c17f9c42d62438e2a1e5622b2f42e01a791a1f2edc9",
      "text": "ruang tamu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5db9e4b2546d0fcbbae9cbab37f847e7568655a40aae5781572a9916d6ddb09",
      "text": "anjing",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8b60a62ce020c3fd3c50f4e91eac32b60bdaeeb18c8b3623a62c1203df6f18a",
      "text": "sebentar",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d955e50bb7ced28d9762467ffdfcf46b950d16d2e6ef402c64e45f0caf264572",
      "text": "Wah, apartemenmu bagus! Ruangannya besar.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "daebbe3e67239185eb2e80246a224c21242b7a87296cde785289fdea17d5a5cf",
      "text": "Tamu duduk di ___.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc2044af6720c0b43d921c51a6f4630aba8161768e13d5b994682c4e9ed25178",
      "text": "Satu juta lima ratus ribu rupiah, udah termasuk listrik dan air.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd7a69b365dcec05f00fe72d64636ecb8faa2f4f7bd3c257b16066682af8c82c",
      "text": "termasuk",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "df826bc737ef578e360f73c7876cb40918d5397b3045722e51c223a54ee0a84c",
      "text": "Di Bali tidak ada kereta api.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "df9c41d5a1cb2eccaedc07608e54425f445eb1012ea5e1eab1a38bc54219df45",
      "text": "selimut",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0c89ebb3e140d62d4045034a90793cdccc2ee26bd44c3c1208613f4dd5a4da2",
      "text": "pemadam kebakaran",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "e157f6a3b2c64c447020502ffadb295ccf87c0c6995596f712144d7effa60feb",
      "text": "Silakan lihat kamarnya, Pak.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1a980cbb10eb695158905a0e0130581fdece1df306edfc69efcdfa663ff17c2",
      "text": "lengkap",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e27143d344de63c9e17b4313fad0531e3605a0890c5383fd61c7b8f98749e265",
      "text": "Boleh saya lihat kamarnya?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "e585ba4a3fd176b2c37588544dae4d5aff6a233d66b7646887c646b7ffbaf3bd",
      "text": "Terima kasih, Bu. Boleh minta air putih? Hari ini panas banget.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea66916b96d8be41cb683cd89858207c96d08292d628308fba6845735e2bd5bc",
      "text": "Ruang tamu Bu Yanti besar sekali.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "eaeb4876cc4f77d8e7503a0fffbec27d556365980c61296d2d40ddb0b8a1e688",
      "text": "Pak Wayan punya tiga ___ ayam.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed20fa91a94833d524f58b8a6b5f204a7f6583cc79d101aaef9efb62e1011e4a",
      "text": "tunggu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eec4100be23571a0c84f06903599e1a5524aab4e90c903bd26ba6b0920bcd1e5",
      "text": "Silakan, Pak. Mari ke atas. Di kamar ada lemari dan meja.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef49686c852264e085a256c0c4493df8a1656e80908aa460ea682196b5090e74",
      "text": "Karpetnya dari mana? Bagus banget.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "f00862f369ad47bf7c13dd3d48316ff1b12887b21f75fd94f61fc598ed2c7662",
      "text": "tentu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1e0373a40a0e49f2771592a0660642f6029bca0bec13391ed4c6feb9d78d0aa",
      "text": "ujung",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f214e90e4989f35acaa92173404084da158361457a3599b90b439be217ef72dc",
      "text": "Boleh minta air putih?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2751a10cc1744cf028495ecb6e57fabd93b32663cf2371333f3177da18880c1",
      "text": "Aman. Ada ronda setiap malam.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f813059ad6d49cb634522ad26d2fb8cfc0bdc8f3660268c2dc332e8551e3077b",
      "text": "Di sebelah kos saya ada seorang tetangga yang ramah.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "f81f760b100dcfe8e05e638e7af16baef23b7a3feb220e548763c1d1bee573b8",
      "text": "Mohamed, gimana kos barumu di Sanur?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8a424bc2df5be617f1583258995e21b0fa67f1ee177e6362486e4d167dd9060",
      "text": "Iya, damai banget. Beda sama Jakarta!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8bfccfda6ef0e1f22a533faed063c6c4e8e46205b5af3d176801410671a69ba",
      "text": "Meja makan kami di dapur.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8e12586241171409f4eed8047cac7f54eb7b338c7bec64e6a8e6d4dcd32341a",
      "text": "Kos saya di seberang warung. Warungnya lengkap!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa518a7ea802e1ccc1748cfd69a599d2ead1272cc7d72af64e5d3883a7372363",
      "text": "tolong",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "feb459c6a998b57d012ee62f94d601acc9f5c0334905480d84f85a9e9f9506c1",
      "text": "kamar tidur",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    }
  ],
