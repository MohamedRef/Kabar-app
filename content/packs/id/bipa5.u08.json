    },
    {
      "id": "bipa5.u08.l02",
      "sha256": "842740e8753e78f0633a948f3d5fa28c2f94215abf4c1e9f9a70522a3a4842a5"
    },
    {
      "id": "bipa5.u08.l03",
      "sha256": "a7449371180dc6c7b4a0ad49bb78748f2dd846d2437d0726b746f9bdbde7464f"
    },
    {
      "id": "bipa5.u08.l04",
      "sha256": "e32b4ab7a14e84d1b514253cdbfdc116f616649feae9ed212d89d3fb721304a7"
    },
    {
      "id": "bipa5.u08.l05",
      "sha256": "feef8c0b1ae48895a5d0b93969307746d82d8d7555bc4cd43514f833ff38227c"
    },
    {
      "id": "bipa5.u08.l06",
      "sha256": "4f2e360e4b9f5dfb036f957eea504bdfbb2afb8563211a76455892b2fcf3da55"
    },
    {
      "id": "bipa5.u08.l07",
      "sha256": "ad631f7b66d1f2b2ccf3ec06a658af615252a474e185e647895b75a5929e2031"
    },
    {
      "id": "bipa5.u08.l08",
      "sha256": "045288c2f4a9c8bf57043922bff8195938c585a97eb3ca9caff4d887bbda72e2"
    },
    {
      "id": "bipa5.u08.l09",
      "sha256": "29ebee7f745ce68b70f95851160e54e2c431fcc597362ba3aadd4b01c9f842bc"
    },
    {
      "id": "bipa5.u08.l10",
      "sha256": "377899a761b4c2b82ed4d511c69da133685c7cfb8900846932c0375fcdb1d5a9"
    },
    {
      "id": "bipa5.u08.l11",
      "sha256": "0c9e88c156c051a71ee5bc61cc50e3f825ccd8bc3576ca6b50101496b8193d5c"
    },
    {
      "id": "bipa5.u08.l12",
      "sha256": "84e00355e6db87d94d5e847231221bfba0d3b5c0dec44b3e9b50f333dd9ad8e9"
    }
  ],
  "audio": [
    {
      "key": "0306091dfeeeacbd75b640d42f03fb61f6a5dd9340edca607cb0992d61c3d2c6",
      "text": "Menteri itu mundur karena ___ korupsi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "058dccebf05599d66f153776d7cb775f43b7c4b66ac4d25a207a96e38c67c0b1",
      "text": "Mohamed, lihat deh. Mayoritas anak muda baca berita di TikTok!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "06a5fc1ce45d5693d1b9558d7669d588cedafd5289a888ece705a8930796cfeb",
      "text": "Jajak pendapat ini melibatkan seribu responden.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "072b06ce23c18a8c8cd624403ceba2c348a1c7ad02e582b33c22544988aa9bdf",
      "text": "pemberitahuan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "07a0054ebfa47d71c8c5356d0a71c79ff7312b7ff14df314647b535ae2084bbd",
      "text": "Katanya, sih, gitu. Tapi pemiliknya enggan jelasin siapa sponsornya.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b352baa3371d6b23ae08a3798eea605480d5ea44140ccc2888b2a105ed61401",
      "text": "Pemerintah optimis banget, ya.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bad64f0e38b4ce440b7e9d8df43e6ac364828cbccc7d6ce7875751f7acbb833",
      "text": "Saya bersikap kritis, tetapi saya tidak mau menjadi sinis.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c0c7ece3a0b967e52bd9523b366e2020272c9c50b48446f1407ae90f34bbb78",
      "text": "Pak, batu ini asli nggak?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "0caac9d1d7010a4888f535d122809c856e2718da68363f3f94354d07e25d148a",
      "text": "enggan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0eb4bf17a95a0e524f598bb65a464e2d50ddc3defdd25eb1feab86f1b315af50",
      "text": "Mau, Pak! Saya ingin menulis kolom tentang pasar intan.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f3a79d248ce578c813f4e1838547dceadb5f336e128e988004292f931077b3b",
      "text": "Klaimnya kuat, tetapi buktinya hanya satu contoh, Pak.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "1082b9562c01b7c97cdd46f3558bb64442c30c60927d818b1c5f0b28205b6b79",
      "text": "Forum ini membahas penyebaran hoaks.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "121562c5d78d4ecbd4cb1260edcd2fd9db1e6339528f4c734b359bdf6356c806",
      "text": "Film dokumenter itu tayang hari Jumat jam delapan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1258c8f010d0f0f0765052e7e2b3798b69e37be28fda33b307086db992886df2",
      "text": "Dari perspektif warga desa, rencana itu terlalu radikal.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "139d6620c19873f213927303939b293f74610cb1c645b119fb6076cf88a4054a",
      "text": "Itu fakta, tetapi pada umumnya debat seperti ini tidak ada pemenangnya.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "14b5813b1fa4ef6f7639aea249bd49354c9d00bd2e101081168e7fc36fb2bcd0",
      "text": "berjumlah",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "15e934041926033729f4538f0b7d45db44109e718c94058dab195b9f37530a60",
      "text": "klaim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "16ac7208e1f7d6287f912fcbc30c27185f7f34bd21c9efb246de580ae6719e87",
      "text": "Udah. Kayaknya penulisnya agak naif. Dia cuma lihat dari perspektif perusahaan.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "19d42d32e4f2b6d86aa6974367dd2ac5c48c9c4cb4f53f2abe564b8654596456",
      "text": "kritis",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "19feeeb813be707cd32cfcdb1c2c50ac425a173c5802d79933260652e6bd8aea",
      "text": "Debat itu panas, tetapi semua orang tetap sopan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c69de8c00cac82e86e98f1d0fd9280a52ba3f041b4a23636a3ad4a5828c1432",
      "text": "Media itu independen, kan?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c7da9716dc2aff8895dfdf0d614a346ce4f889df5b7cb493ec23c06fa30e67d",
      "text": "Hasil ini tampaknya menunjukkan bahwa mayoritas warga puas.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d9c4c0e486de6545a0ed5d4adefc4080f378fff2251099b9d680561b2a37e4f",
      "text": "statistik",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1dffe54f18fa908e32f8fe9c2dc21e71df75490ec511f2f05b100ba342b93153",
      "text": "minimum",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2784388dad2023dcce8b4331cc0349f3656f1e0491bb120efeef70eb264f62e3",
      "text": "bahan pokok",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "279c2a0dcabf99e2a1cdf2147450d4a301b882f93d935f4ebe4676f09f90763b",
      "text": "Barangkali editor itu enggan memuat skandal tanpa bukti.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "284bb2ae77fd83396e0e4354d531a040317316e99a9c1b5159faf45cf67bf1fc",
      "text": "Penulis itu tidak naif dan tidak ekstrim.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "288ee551fbfadbf6fcb1efccc983421a7cb0a11c9f2b7cb21cc2410b77b60c65",
      "text": "Setiap kebijakan punya plus-minusnya.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "28b4aa82e97d03b63fc9b58f0dfab8bb18f1ed4cbde84814ffb83ec3e021f540",
      "text": "Saya optimis, tapi tetap realistis.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a58757af6f3ecebb0ecdb2d119a5b8d1d31403bbc896ed1f4800ff357439be8",
      "text": "Hasil survei menunjukkan bahwa sepertiga warga belanja daring.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b3050da80bae0c5e4576ce497ce489cf2222ee2b71c4cb22e033243515cf720",
      "text": "Kita sepakat bahwa harga beras naik, tetapi penyebabnya belum jelas.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bda02b607ca27c5c3f9b9d5238293c1a101c31bd277f2484b57ab7d0951fea4",
      "text": "Wawancara dengan jurnalis itu tayang malam ini.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c369effa8a0cb456c67290bafd24b969f14cf479af0f86fbb59c29fd15f896e",
      "text": "radikal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ed00cabd751dc073192802eccdc058a4edaa64bccf87e5ea6c9c8035774402b",
      "text": "Cuma dua ratus orang, terus separuhnya dari Jakarta.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f19be3d6676dec93c19934acdf917b733fd32b3dc9ab8a13ea24c1e421f23f6",
      "text": "milyar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f9d67e51087a01dc29469fd71dae8dfc882af06efbd8ca746f0afda04dbe16b",
      "text": "Barangkali penulis itu berpihak, karena buktinya kurang.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "30497eb7c595657e6f5e821340d14a2d860876ca4184caf5cd9b6f1365640757",
      "text": "Baik. Saya akan memakai data jajak pendapat dan kata \"barangkali\" seperlunya.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "33bde721e977b2803c79b8b083031a46dee8b4582be884c2f90d34b198b0e0c9",
      "text": "responden",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "35d051118625806bcbf23eb2751ee4192405c0a077d7ebcdb893769931f55bb3",
      "text": "Justru itu. Penyebaran cepat bukan bukti. Kami tidak mau mencari sensasi.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "373790fe21d6f41a69250ebb54ad667d88de97f5ab6f4f552c220947b3f4c190",
      "text": "Lembaga survei mencatat anggaran kampanye berjumlah dua ___ rupiah, bukan dua juta.",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "375de5522c241b4def9307f984afff2881d6c1db18d0c7865d7f8e6d7ee76859",
      "text": "sepakat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "37a2bf2233f9812fa6cf2acf29bc71e4da073e08cedab14ffd15277e8c4b72b1",
      "text": "Artikel itu berpihak pada satu kelompok saja.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cf1d4322595bba923fba9dfae034a130a084ad214f644eeb8788814d7ace186",
      "text": "Mohamed, koran Banjarmasin nerima surat pembaca, lho. Mau nulis tanggapan?",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "3debd09078bd411a223703ff55fca94ed25cccc7c4f8477c75a92b9f8353061a",
      "text": "Harganya agak mahal, Pak. Kurang cocok saya sama harga segitu.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fa079f887c70330c3e283cf8b8b7a7122d75e9b41f2b86b058641ee99cf12f3",
      "text": "Penulis tidak menyertakan bukti yang cukup.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "44634e68791e0738429ffbc23d1c6b3e032a7680b60dd81f694e09be23a6daee",
      "text": "mayoritas",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "450aa286db245148b362fe3700a0b121fcf72621aef40a6e0e6a23664975ff55",
      "text": "Itu baru kolumnis yang baik!",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "459af6b3de661eaa912a3e4d0e88570ed1694d5b019435d57c9dcb2acf748968",
      "text": "Berapa sampelnya, Pak? Dan siapa lembaga surveinya?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "45da1140c547917a39237d7478e5a9bf7e2b05450c99d70022bda17129bf713d",
      "text": "Hasil survei itu tampaknya kurang berimbang.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "46874101596b4e2602fca9d2c857f7e1ebf43343ab39ba1f8fcbfb5a4c22d6b0",
      "text": "Betul. Dan bagian tentang keluarganya terasa subjektif, karena tidak ada data.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "48dd2323cc980d3f37a7a1f1c8b11a37f5959457ad4cae87e768ef2a62676ba3",
      "text": "Tulisan ini subjektif karena penulis hanya menceritakan pengalamannya sendiri.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "49ff2f568c25c2ac43a9dee830470deeb572a17876e8d5526cd1ae589acb8a11",
      "text": "kurang tepat",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "4abaf51126c46d7cd778050ce8171b82474f3bcc58d37b0d13f1f6bd4830140b",
      "text": "perspektif",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aec691c607cb60ee3acdb6d6de44e9edfc52cf9067a15d009bb70c3eb501ddd",
      "text": "Saya ingin menulis tanggapan terhadap opini kemarin.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ba369f3265490d154455f78384f1d8b747baad068f86e9ad1a1a63574de264e",
      "text": "Lembaga survei lokal, sampelnya lima ratus orang. Margin kesalahannya empat persen.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bbf4ac2bb9d974f665fb05a221fbaa39801d6e38a2a0683849e6a182f639279",
      "text": "Saya sependapat sebagian, namun tampaknya penulis kurang berimbang.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dc0864c5caed9d99f645932cc1f36b126d1c90e3f3033427d1aeff07feb30d6",
      "text": "sikap",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fab9febeca83eb81078bd0979a9b3a9247a9e424c8dd6ef15cf0047b819e0d0",
      "text": "pada umumnya",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "50e94ff69378abafc9775f402c76b01fae02351f2ff681d0a56fbd3eb0de1f10",
      "text": "Hasil survei ini menarik, tetapi respondennya hanya seratus orang.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "533a42f6208e2c63341405763c5d2875e89231935c883d9a6ee18a60656ce8df",
      "text": "Tetapi di akhir tulisan dia agak sinis, ya?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "53db6a819bdf780523105e4d9e6a2e2b69612f59cbc95a432edd8e96832d4739",
      "text": "Bagus. Jangan lupa sebutin sumber, biar tanggapanmu berimbang.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "582366411269ab363d3e3c81c879001adae41dfdec2245cd40814e6632c651ec",
      "text": "Menurut jajak pendapat terbaru, tingkat kepuasan warga cenderung naik.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a1455983432e88c9d081a409245d28e96b76778d9dbdca4135d22c4e3ebda7a",
      "text": "berpihak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c8b969b23a1f879f70315d4983245284c99ac435893db674271830c33680838",
      "text": "Opini itu subjektif, tetapi harus didukung bukti.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "5dcf7034101768899ebd973f09f270f438cc156beebb073ddf80aa758fe60b6e",
      "text": "Kalau gitu, hasilnya barangkali kurang mewakili seluruh Indonesia, dong.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "68eab738e704b21506016c2f387f6622ab2e5e5c757b703037241e4d0c700c06",
      "text": "barangkali",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "69bb1ba0288234fbe82463f81d2669d8c6ef05da8787e76889bb8858e4d2e93c",
      "text": "Target itu terlalu tinggi. Mari kita buat rencana yang lebih ___.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "6aaf29094ef8de100263e978eff48c840ccb1c8411f0579ddb7a0a0de6a85327",
      "text": "debat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6afba2202f65dffd450c19e5b7d1cfe6e2f0523cb0d17a93e809a409ccef0e9e",
      "text": "mengkritik",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b735aca354f41b4ab5e19a565919a68eefcf4480b1cde9f1b62b47fd1b0bd6e",
      "text": "Anggarannya berjumlah dua triliun, bukan dua milyar.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c347a9bb31353ac442db41452cc3cd60cfdc52ee59fb3c4d27ba59f0e9e0ec3",
      "text": "jajak pendapat",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "6effd4e2c7b893202a047e15b34ed3bd6c24603331b40bcdc4b3325732c019b0",
      "text": "Menurutku, media sosial ngerusak bahasa anak muda.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fc675022718e25c14756562661119a02def3a9cfce623370be3b05a323fe678",
      "text": "Pejabat itu enggan menjawab pertanyaan wartawan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "72477a94a500c9fafdfbc939c5cd1019097d4404dfcc7c68423dcdd23ddd87b4",
      "text": "tampaknya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "74cfe9cbe3f3994a3f051925827a12210ead6784ebd9ab0eb67e0eb85288975d",
      "text": "Kolumnis yang baik bersikap kritis tetapi tidak sinis.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "75335ec0523ce9f3fd0b8ce51d1253bb9176b5d239b5fe99ce02b13b813537df",
      "text": "Separuh responden mengeluh tentang harga bahan pokok.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "777097cf193fbf8ae8396af2c7f6ce1ed94626a63c7283b48bae03a891467b2b",
      "text": "mengeluh",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "77e3bf8a600c02faa16508419690dfcbc3e161351562ef818ffd0bfb4845346b",
      "text": "Ada skandal di pasar permata. Tapi jurnalis kami belum punya bukti.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "783d256d6cfb5643cf6766a1607c2184dc1837a8e758fe1dfc0f5861e5b9f53c",
      "text": "Respondennya berapa?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "78bfdb19b35cba027e20bdc57b27f87a1663db0a8c958a7629326a556ad29cf0",
      "text": "subjektif",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a930208b72f8ef14f62df256c7ea6fc786769ec205fa1bac652417f95443ae0",
      "text": "Pak Mohamed, koran lokal mencari kolumnis tamu. Anda mau menulis?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e54b88932f2e72a370cfa2c501fc46ddfef66c507740127fe3d52e25b42bf0a",
      "text": "Setiap pilihan punya plus dan minus.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "815bf478054c918956c092c94006ea875e986e274fa929b7c4cba618e81b3a18",
      "text": "margin kesalahan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "8200afc31e23b57382bb39a57def7b8190133f31df97c282d3c6fbe979e99a63",
      "text": "Lihat, Pak Mohamed. Tingkat kepuasan warga terhadap pemerintah kota 62 persen.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "8288e2dbcd452cfa47e8bfe5372d48ba3a60c0fe524f31c2bc8d602def10f734",
      "text": "Sepertiga responden membaca berita setiap hari.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "8402831b98091c0506fa978810389ece4df110cfa0c271f0a1cfb8ed10451aa1",
      "text": "Iya. Tanggapanku nggak ekstrim: aku bakal nulis plus minusnya.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "89230176e856814d2cfc72360f5278a7e4dbe47468fe36b3f0dd4fc5d4a5a498",
      "text": "jurnalis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8942653594827c12f78fdf0dc5805a272a41f5c3b31da1cb0e0b8d783b24ce0b",
      "text": "separuh",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a0d2d6ff117f211450af2a58702c995b4e68d9fd0167f7e6182cb848154df22",
      "text": "naif",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d0dc7dc72c14c2e29877d2afeed695eaa39a8c9cb190dac32cd94815f7201a2",
      "text": "Milyar? Kayaknya salah ketik, deh. Di statistik resmi angkanya triliun.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "8da7d9f3057f01b6a7151c28d16f772c1268a3712e6c0bc15d1ab5d0f9e07156",
      "text": "Barangkali kita perlu membaca opini lain juga.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "907b89f9c176133e195f5040df464931f71ce43771cf90410732733a0a3024a0",
      "text": "fakta",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "918210e6b91f046cbc502bf0d8764a609c53304bc1c709489a08b6cbaeec191a",
      "text": "Lembaga survei itu mewawancarai sampel 1.200 orang di seluruh Indonesia.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "9349e0d0b8fa93b6d49539e95fb6c6b814ec2de247776586576a6db5d12502c5",
      "text": "Penulis bersikap kritis, tetapi tetap menghargai usaha pemerintah.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "94ea6044b055b955593031114a9075954b2e1809426c63c0aeb9663d866cc651",
      "text": "bukti",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9545f8e8a89c909ec65d250a8ec8209e52f0372592c927168db62a0bb2a47499",
      "text": "Pada umumnya, pedagang di pasar Martapura menjual batu permata.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "962a34308c7d5231772316434548031eeec00aab14d45bb7bc941b5eb28b6454",
      "text": "realistis",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "96eab745c1e46c59e6ef7b5a09a68f4e18db32c9e190b4b2a38ffeadb0b8f161",
      "text": "Betul. Barangkali harga di sini malah lebih murah daripada di Jakarta.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "9765f2b7e25e292aa743730ee11a5a0515789bec53fa236774340b9a2792f249",
      "text": "Boleh, Mas. Aku sependapat sebagian sama opini soal harga beras.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cbcb4f2f284c55f35d762c020b31e6de9b469f6f73cbef1504babb261887eeb",
      "text": "Harga bahan pokok menjadi keluhan utama warga.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cfc2bb31437bad1f8ef2d2157a7ddd913f8c1c4dd67f03ba3515d6a07afe47a",
      "text": "sebagian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cff0ac7f1610a0f5c97bf1b9f85523ec9e9f715b5e2c35d4799798468bad5e8",
      "text": "Cuaca ___: suhu mencapai empat puluh lima derajat.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e4d3614b243681765cfd7838da2eb559adef83c7cc13a7b48c726ff73bb7266",
      "text": "penyebaran",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a10dbcf0934e9865b1a710606f27c02b6a22eef2393d07386a5fd90ac61a5ef7",
      "text": "Kita sepakat bahwa bahasa gaul makin populer. Itu fakta.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2ad33983308f7e3fe1cb7fdd753d3115482d97d8f37805797a8fef5d7ad542d",
      "text": "Mohamed, berita ini bilang anggaran ibu kota baru tiga ratus milyar, lho.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "a44a0128d9f2d78b89ab404437de76eecc65069884ded442f2fb0058ab020a20",
      "text": "Menurut statistik, harga beras naik maksimum lima persen.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ef37411af6d8e3108ba2af2f7298b81c46ba2a8d2a56db6fbb8e0f17a0580d",
      "text": "sensasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a624e9b343b5c84db701fd60957cd8474da617f52acac065ee3cc4865eae32fa",
      "text": "sinis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7a9b743a0611813d1a3191ca9962190229047cce6195b83bca4b977960c749a",
      "text": "Apakah Anda sudah membaca opini tentang pasar intan Martapura?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa7c1cb093a97b99bd61805ad541cc7ac89a1f2ab29b3c8b8001ed20cd55f2b4",
      "text": "Jadi, Mohamed, menurut koran, harga permata Martapura terlalu mahal. Bagaimana pendapatmu?",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae1413462a84a436ad5b7181afc6c8b0d38e2a16a371736ed366542a69a30b41",
      "text": "Kalau begitu, saya beli batu ini saja, sebagai kenang-kenangan.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "af15b4c26e67aeec76413538f96cf54cb67566bb7c6379b7a027863faf49e299",
      "text": "Barangkali hasil survei itu belum lengkap.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "b01f53a8fd98d17ebdeed2a35753d09246a18dc09f9087ce9471d2f1ec2215b8",
      "text": "optimis",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b04bffc5e220768007820422d0bf544cc5afaf246e3ce0725f98d6630b189332",
      "text": "minus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b04caae26820a3033a305ff163281e64f37bafd26e782d5a5b631aaefe07fb1f",
      "text": "triliun",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b080a73650ba63c1b305b02361253e2fa2a0cd527a8f5960b7cd4e9ac369aaed",
      "text": "maksimum",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b23fca7b5152d930c37bd781b3233414761e37d0e3204a94f53527d8ef55d55d",
      "text": "Sudah, Pak. Sikap penulisnya kritis. Dia mengkritik penambangan liar.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4488e739a688f595ccefa8ec1f311d661f6372cd0ddaa77413b8bf56328cd05",
      "text": "berimbang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4a91fd267f512055f8363fea3b8de19ba5eb33c859ccb21c2805ff7f44e75f7",
      "text": "Penyebaran hoaks lebih cepat daripada berita yang benar.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b66847b6ee995813b6157e9eed17ce0c3582276d140c5b64285a9e1fb7600642",
      "text": "Hmm, sudut pandang yang menarik, sih. Debat kita belum selesai, nih!",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6c314070d82fa123fa52757f05cc6ec8102819eeb5a8310e8e9ca8f307ce7f0",
      "text": "kolom",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b910efd09feff7b184839e1729e5c4fa39d07a96c35f6b56c27a3a737f72919d",
      "text": "cenderung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc3bc6ce06426423f39736915fafd0a9b1315755d62d36a66bae75b238510844",
      "text": "hasil",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd4802981de1b59d6e03065d07016421b67d98c1c8390b878d0132196c12296a",
      "text": "Oleh karena itu, saya mengusulkan agar pasar intan dikelola lebih adil.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "bdcaef47b3e70088869acd53753601c093e20a37511455922b3cb419086fc953",
      "text": "ekstrim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "beb4cef1123eb3e0f5ef81413b9a7f38361ab3a2e02d9d0ac705f5a33a964447",
      "text": "tayang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c23e6306a5dd6a658f5a84b80188af060e5e14aaa2e65d3279e20ee72b7d5e9f",
      "text": "independen",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "c28f5cb5cc0530cc3168b822f327136db8521e46b4ac2b792c20a9e3368c8a3e",
      "text": "Sepertiga responden tidak menjawab pertanyaan itu.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3b4b1fa26f41dc4c3fe5f00637df784af6a55ddff39159022ad3a86a0cdce58",
      "text": "Sampelnya terlalu kecil, jadi hasilnya kurang mewakili.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6ac2c7b041dee374349143e3ef6538e9c291912c61f78dc9a9a1b9b0706f187",
      "text": "Pak Mohamed, terima kasih sudah membantu terjemahan kami.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6fb29d37346342531ac4ea97caac969ddaf157626f48014d1c157df88502fc6",
      "text": "Siap. Aku bakal nulis yang sopan, nggak nyerang.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9e5d73c503ad427cb65eeb29e17364f4f75944b122a5d07e9b62b1722f04844",
      "text": "Saya menghargai pendapat Bapak, meskipun saya kurang sepakat.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "cacbc75fab9034e6458eaa05ff88b10ad9d58cce5e40115470e242945c85c143",
      "text": "Judul itu hanya mencari sensasi.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc99d84fd7491c3b62d522fa8882ca19593ce0220c3b92ddb4ae662ad98cbc17",
      "text": "kadar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce13e661dc8751f6c4a1fe859d4d1d1140ffb940a91f4d0b8e5c2fdcda19799f",
      "text": "forum",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfc12081715ab622bef8dad7967cc42c82d16c3dd52b380e8bc11b9cb3801eab",
      "text": "tingkat kepuasan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0de87b6e16601128b4de1530347af179c5c420bddbbdfbe622c995a2acf0e96",
      "text": "sepertiga",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20343acd21f75c4f18c9e518c5a28088282e40ec0e2fbaa2344a8bf5771a6be",
      "text": "lembaga survei",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d296207dce74ca35a5e6070b64e75eebffe4df03736d310447c8203e338c668f",
      "text": "Editor itu menolak judul yang hanya mencari sensasi.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d61c583e1564e39de5d4ff0428495a874083067e848f0f5b24b004facf47a5b0",
      "text": "Benar, harga intan naik. Namun, barangkali penambang kecil tidak ikut untung.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6bdf85a2e6c2f5d53715706c9e853b5ae857a8b52298ce99dba1ff61bce3c9a",
      "text": "Pada umumnya, anak muda cenderung percaya pada media sosial.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7b0d1cc0cecdea714b1d0efe2dd65c0c8b262277a7cbef44a2843a32c13d36f",
      "text": "Jadi beritanya tayang kapan?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "dab8c66c9ecb630449c0d3074fa7c8dc908c207530ecd7364873a2b5b14ccdb5",
      "text": "Margin kesalahan jajak pendapat ini sekitar tiga persen.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "db9eb63ccd4ed7fe18df716b978226b84893e4a319372d3f83f75925b6bb7d5a",
      "text": "Kamu udah baca kolom opini soal tambang itu?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "dea2327fd2b8b1cc774c537238607c6bdc5542dcee92b07f569c8decf8204e15",
      "text": "Meskipun begitu, saya ada sedikit keberatan. Barangkali bahasa hanya berubah, tidak rusak.",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "dec96a5235820b3d9f30935624a36d0b6bd35b0f0cabae01c222dc95fbfc8236",
      "text": "Jadi kadar kebenarannya perlu dicek, dong.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e22b630b1ca7e04d65c241fb27177a99c237df1250a2e5b1995483b4f0febd6b",
      "text": "keberatan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e28600cdd28f999a8e4f027ace9a95f108dc631143667aee2398ab37a33e748b",
      "text": "editor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d16ebe4b930a33722ecba8c56b431ce39ad364e006e148c8b5738a658d8767",
      "text": "Pesertanya berjumlah lima ratus orang.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2e29347ea3218b41ec0765350eb6f3b65f26d8caa55b4974ae976740d6c09af",
      "text": "Anggaran proyek itu berjumlah dua triliun rupiah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4068d3aa05a98897d622bfcb0dc1afb318d9bb33992c9601833f23f845d6fbf",
      "text": "Bagus. Ingat, sikap Anda harus jelas, tetapi bahasanya santun.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "e41837c18f324cc5c9a605266739c18eda8c06c3b6b5a5add7a0989e93d67b70",
      "text": "Penduduknya ditargetin maksimum dua juta, tapi barangkali lebih lambat.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "e55a2db8db4d019d75ca44d57e628f7e13b2b7f7f2638fd30ebfc6c8e26a399a",
      "text": "Saya sependapat sebagian, Pak. Tetapi penulisnya hanya bertanya kepada dua puluh responden.",
      "voice": "id_ardi",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "e774f274279850aad5530aa84f26649f8f2688d0031e21afa2cae5163d0d1af7",
      "text": "Tanggapan Anda sangat berimbang dan sopan.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8058eb27fcdf467e8151f89f29a866cb1e0071a7b39c714abf5b0d1fe11e3b9",
      "text": "Lihat opini ini, Mohamed. Penulisnya marah sekali kepada pemerintah.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "e85a739820468dc65c7617ffa09055c54c6c81821e65ee56b0fcc0f83c238b68",
      "text": "Barangkali penulis itu agak naif tentang politik.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9a6a6b6626af5c24ed5eb8e80b21f3236a65557fb5593fc16f1911ec27ed386",
      "text": "Di forum online beritanya sudah menyebar.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebdaa63d12db96ef19f3629bb9fa7eaa39957c049ac4beb7c1109a77e374a4eb",
      "text": "Anak muda cenderung membaca berita di media sosial.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebdeb830374a116f444682a5364dfc89a4ea41c44c93a3a5d20f5c3de7de5422",
      "text": "skandal",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec334c4d4760e9f9e47cae5c88d04842ac73853eccd64d4c10f8ef00c59610b8",
      "text": "Tampaknya pemerintah terlalu optimis. Kita harus realistis.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f12ee7dba4372727cfd92f1c16964184f09bb0bd8c961f8daca9ab4847999949",
      "text": "Jadi angka sebenarnya barangkali antara 58 dan 66 persen.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "f16cfd045b444b6e3f174a2321a4fbafe0038ad40dfe2823e9bb7defdc82a44f",
      "text": "Betul. Tampaknya dia berpihak.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f75bebbb2123a553681db21d0887483738cd442f47a895d071602dc18446ce09",
      "text": "kolumnis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f81611a5a92c3c9e91579d0008f9921db823a320c9f69178a99fb7fc3840fe8e",
      "text": "Sama-sama. Berita besar hari ini apa?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "f89c11ec7583a290fbb47bce321dd533718b8e310c762da4eaf3f30f8eb1802b",
      "text": "Tampaknya asli. Tetapi barangkali lebih baik dicek dulu di toko resmi.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa1f2dbd02e6470312e2bf6172aeb736955db01ade0b536e45fba9740a2dd059",
      "text": "sampel",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "fab1a50d621c53928b8b432d7a11aae1e4576cf6420679e92d0467b5af6a8b52",
      "text": "Pada umumnya pembeli menawar di sini. Silakan, berapa tawaran Bapak?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "fafbc7577a7523d40c5a1082bec86cef504a19359e4063e8aaac35e05190b9d9",
      "text": "Terus targetnya berapa?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb79138497dbee1dd4573014af5cb0e75da78917f57d749eda3cf1207e9dba32",
      "text": "Optimis boleh aja, tapi harus realistis.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd1b278f4908d1dabe36ec6d1c0fe924f79b425586c6d65f409253c47ea0f963",
      "text": "Kolumnis itu menulis kolom setiap hari Senin di koran lokal.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    }
  ],
