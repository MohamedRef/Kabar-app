    },
    {
      "id": "bipa1.u07.l02",
      "sha256": "7e5f0cd67f43c97f70eeb8663d006e3e9c5a887b9a43fa009e79c6cc706d7019"
    },
    {
      "id": "bipa1.u07.l03",
      "sha256": "8f4a12341f4bfa184bff1a204b178bbb8a2f52addf9ee8fd202467792ec39f08"
    },
    {
      "id": "bipa1.u07.l04",
      "sha256": "068e531bbd0bd23d2631df420710838f05a1fc49baebe921e0376dabcdba5a0b"
    },
    {
      "id": "bipa1.u07.l05",
      "sha256": "4740afffa30073f7d0a708b49fb0e08b13bfc4c5e3bbc21fce5cb02cbe6ca7eb"
    },
    {
      "id": "bipa1.u07.l06",
      "sha256": "ff2a18054820e2db3135abbe9074ef49e33c35fb9e84bba23b16720100ca9834"
    },
    {
      "id": "bipa1.u07.l07",
      "sha256": "6ab45d14e9693eb40d5e43014274633059913fa1fa47f5d1f303fc0161b9139f"
    },
    {
      "id": "bipa1.u07.l08",
      "sha256": "b93c13ce7edd84a01a725b4c97ebd653195b81c31808e28d9d716fbc40f80c67"
    },
    {
      "id": "bipa1.u07.l09",
      "sha256": "f3bfe1cd3722f4c87f0f912290b9bd2750ce171674409718b6f22a7569cd8c3e"
    },
    {
      "id": "bipa1.u07.l10",
      "sha256": "40aa55fabb63547f28035d7f74f253427e3c2c6c50dba1300d7a5459c089b8b1"
    }
  ],
  "audio": [
    {
      "key": "003f8c5b1cdd3737cbef1f40ba2916d5a0cf128dd165638cd3ef87eb857e3313",
      "text": "Mau minuman apa?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "01f0adc6c00578c887eb1b6f980237e9d591a531a8ef775514c2b152a36801c2",
      "text": "Kakek suka memancing di sungai.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "063affe2e4d8e9c452c0dbe0968a3be3dc88754d5bbfa4cc805d03f3d6cc1f20",
      "text": "Olahraga favorit saya main bola.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "0857b195a6e9b16b8c757021af2f6de4625c068b752fa60ba1e4e9fabb85831a",
      "text": "Ya, kafe di Kemang mahal banget. Tapi tempatnya bagus.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a98b8372fe010c3fe7c58083331edbeeac4229cf20cde7e48d4b276a6a2e34b",
      "text": "Nenek suka berkebun. Tanamannya banyak.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b8af056079948253c75ef4654fb78525899b35e4f439ad59deb3997d65dfbee",
      "text": "Kami main bola di taman setiap Sabtu.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "103e6a4bdce66a7f5263381eafe37ab4449e8ba9393363dae29d220b3703fc32",
      "text": "Teh manis, Mbak. Ada makanan Mesir?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1498a79b90aac32429a98024a262953d95584a5e7c6fd99effe1cf7c01b71dd6",
      "text": "capek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "19e4e67a72d11b3d392704e750cc9b5996cdb3b92dd7b7f0d93110e7cd8324ce",
      "text": "tanaman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a35692e735940ceb4e018b291e040272a9aca6926b1e92ed46170f911112daf",
      "text": "lari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ffc7c20cedc04fc638b856a3f29785baf435cd7e39fa70857e1b030ea97ca8b",
      "text": "Mainan favorit anak saya ___.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "207c68d00c4b5d7edf925d11d96e062c7408dfe6df957ee6034ad7c4e817da5a",
      "text": "Saya bisa menari tari Bali!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2087434c7e7983b585e160eb124061cfe6afe926c7145af7d6af49feb958eeec",
      "text": "nongkrong",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "218571c02fe64c7e3f4973f854bbaf24e5acf18156bb37cde5c793edbac8ec88",
      "text": "Pemandangannya indah sekali.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "22902b954ec989244510198e619c306a00b50149912b398d25eda9da36ed77dc",
      "text": "Kamu tidak perlu datang.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "232ce57156fddbb992ff5e873a37747a50343a514737b1cbc99f6854c12839a8",
      "text": "Kamu harus coba rendang!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "23992d7a7cde4cc2cf7df4e653093d61fcc8f623ed8b51a036497a6d05e8f275",
      "text": "Mohamed, gimana kopinya?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "23e85e45a41c397dc24067d7903e8039642a931bece158b502ee19365d508494",
      "text": "menyanyi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "24ab4931bc75de2454ee83d837d587211a4f8939ff679674c9cee397dd508b68",
      "text": "Bali sangat terkenal.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "25da1442c9698dbe6bd1a73a333e9a89ca5b664e90e8cfe17e52a90da049cb52",
      "text": "Ada ikan emas juga?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "26d91cdbe2f9ccfbd161adea8f0a0708785897e41ac3db9f2fe2f30c42090e5b",
      "text": "Seru! Siapa menang, ya?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ef4bd4e257a3b6a6f6fe98c3bb9ca830e2cced9fcc1ece21c3ab94fc3e2e0b",
      "text": "Oke! Hari Sabtu kita main, ya!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ec0e0a29c04e3d414562511fd1906cbe82cdd842a575fe0093c76c5a4364e1b",
      "text": "betul",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f1734ca4f3db7d8daffe9ec414f6206cd8d5765aa156c1edb4138361a609777",
      "text": "Wah, hebat! Aku nggak bisa menari.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f5dfd3179655e1b0c8748535af9eee37859269c901fd9d75f4825251c1f4e6f",
      "text": "sibuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3293f7d7d665f86ee45e4eabe7001e5b0818ac9f621cb058dbc948fd57f08bed",
      "text": "Kemang ramai sekali.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "32b54e13bda27f0b92363e6fa29774c8d67cfb7f77b0a609539f0b24a60f89c1",
      "text": "Ayahku suka berkebun. Di rumah kami ada banyak tanaman.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "32ea9c6dc3cc1fc166b81abc0e09640ad4ca186f888b5484998a3634cd011a5a",
      "text": "Klub saya menang!",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "33c33a20e9e0e09055aa386c5d7e37b684a96952b2893dbf2a4fc90640f4f41a",
      "text": "Saya suka menari.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "35c4991023ccf55aa9208ed81368893e1b76c1ce64ffe4e583feab2389d2f3a2",
      "text": "Hobi saya membaca dan bermain sepak bola.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b29404a3aacc9d662f301658106e57aa325aae01f23b8da536af0545c36fea",
      "text": "suka",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa62f094994766719bde3897fde6e35567f04f44924f79768586a5091073b70",
      "text": "Saya suka makanan Indonesia. Enak sekali!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c8926af291badaf4b80676b99161cd04f2cba1f8b4c45205f04b137f332e2bf",
      "text": "kafe",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d658fbe5ef2ebab1b35ec2d28f52791bdfe75df82af3b682d51ece1ffadfc44",
      "text": "Ya, hari ini aku sangat sibuk.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d78594062ac42636d16b5de63a731fd2d33bf9da9ac10ab986af2b74ef14da1",
      "text": "Baik. Mau pedas?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4232c2564705b679536451d3e67807591c5defa43425bd4bed559faa7a0a19ee",
      "text": "Setiap Minggu kami main bola di taman.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4288def8866a4af8d5431baae3c06a5ebfcf5bfba356280ad8c6ce86ed10498a",
      "text": "Saya ingin minum teh manis.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4333f2df73a9c21ebaff1963d1f5a48e3baccf8ea2c4d731fbcca9a3ec90231a",
      "text": "Raka suka bermain bulu tangkis.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4369916fc9a49b3d49401a005724349c47a0e94f6a7fbdeaec2f7518277ee205",
      "text": "Kopinya enak banget!",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "43e441619feee19994ebb3e5862914bff2385a6d9a4e9db86de29f4107f51d21",
      "text": "Ada! Lima ikan emas.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "452ff4b66f9b0ffa133df16f2d9bb9895768672393d6638c391b9d17f083d490",
      "text": "Di masjid tidak boleh pakai sepatu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "462e70d9238090970d0736f2b88ff468039ec4145d617492742d5955686fd30a",
      "text": "ngobrol",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a2d7ddbd61b147b160c5a686cb5d672ba1c199f9dd24101874a0da783193ae1",
      "text": "Saya suka makanan Indonesia.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a71971fbe27f0583fb2f8138a7474479897026cbb8bde18465e8c13f568bbb8",
      "text": "Tulisanmu bagus.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ae33627b6117a3ce7db326d8a00532420327758c3d968059efc749e7faa8a34",
      "text": "Hobi saya berkebun dan memancing.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b8b733a1e89debd8a830cf3283d8c3f9263425d79ca83f20d22d493d647e989",
      "text": "Hebat! Temanku Raka suka memancing.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bb7c72bafc70e0cebf64a38f2f951f3ebc5c69291d8f8b389e4bb0c09e2363b",
      "text": "Boleh. Silakan!",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "4da11d8e0709f139124148e4a25ff5ef647582155be1d7af4d5115192332e4cd",
      "text": "sepatu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4dd37e743def753d467748a1f4b4cebb20719ee2a0c73839018381a96d44fa1e",
      "text": "Ya, dan dia suka menggambar juga.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de1e101582bc1c3b92a4d3fbfadb0ec16bc3bfb0b54463ac0f11d33e0087cf1",
      "text": "coba",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e6f4033fc22b8d23faa8ff32af8d85c64e1fcabb85b3f7194b4bf83f5de4ff2",
      "text": "ingin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f96999bf447ee0cd50da95d430516ce6bb387e1e20d3c3e3ebe1d88dc2da715",
      "text": "Minuman favorit saya teh manis.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fe8f971fe6de24b659a1b1a364f27c0b43be25c8d6b6f0d995554d5a4e2e2f2",
      "text": "Musik di kafe itu bagus banget.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "50e81609de7e65061fca24836477a2826b653827f4cb57180f45e43eeaf8ac61",
      "text": "Saya ingin ke Mekkah.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5183a7730551732060081f15417b6aadd8e75d086ed0120aec0c1b9ec50e80db",
      "text": "Hebat! Raka bisa bermain gitar, ya?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "52aa051d98018b820aeb8ee453b1aa512b72a7a1dc5042f8e5e316abebccf88a",
      "text": "favorit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5536f5f1b0e9944e164bb89bc6286b5857d17da35323f28ca58728aa7d439169",
      "text": "Klub Rina menang, klub Raka ___.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "55fddda79658c8a314218c39c23fe51d42ee51b97543d6fd57a6501138379ce6",
      "text": "Boleh! Tapi aku belum bisa main.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5997237c3c2f29368d45da36872a4fb6684954be52c4d6320b66196f314f6695",
      "text": "Kopi di sini enak banget!",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ae7dc28554b0608e991bfdd47d6535f5c2bb94ce628060745f54cafbf5b0ca6",
      "text": "Teman saya bisa bermain drum.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bcdf7cc11d075561ff54def265b0fa49cde41b588a231ad41a0f7df7492d1a5",
      "text": "film",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bd1d2d43287d85c1f4ec098c1ffc456d85901c5f3eb72d17e6c1520364f4871",
      "text": "Mohamed, besok kamu harus datang jam tujuh.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "60a048414e48fedb7ca43375dd22972d8be322c6027309f69621e3a1f1844ff8",
      "text": "Aku mau teh manis. Tadi aku udah minum kopi.",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "611192553b85fbe0d94927271b8898b542568a11fcabce4a6cd87fa48d021aec",
      "text": "sepak bola",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "61f1c2f9db6b0ed40c1b3c53063c5eef81c0e46cebc9e8a674c438d7f6fca517",
      "text": "memancing",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6540ccdc984939287d3d8891fa2251e2b46dba14c2966c55339e3eb10fd7c767",
      "text": "Ya. Aku suka menjahit dan menggambar.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "670f39e4eb16bb1f50ed6506184086cd3546629bfa1ea7bb08f0c580201e476a",
      "text": "Tidak usah pulang sekarang.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "69ed89e782918b8bc83a2827b2ee961e5c10fe9a7fb0c837212394d46c59fe9d",
      "text": "hebat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c961105336a5e6dfcf1a07b8d40748c77582b892c20f0d10cf7a90566c52be2",
      "text": "Mohamed, hobimu apa?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7227396fa44555b9edfea3ee8dda8ce9eb8eaee0bb5f4993462a597e68d6873e",
      "text": "Aku ingin ke Bali!",
      "voice": "id_ardi",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "7471bd934df15a9b1a4b351fffdec50ca60141eaee92cffca77cb3f7a581a181",
      "text": "Hebat! Bagaimana kalau kita nongkrong dan ngobrol hari Sabtu?",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "75b53603336161ab3eacf69f7688eaece6dafb6d032091611ff4e321e8deeedf",
      "text": "Mohamed, hobi kamu apa?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "77894e6984eb3080bbb6440691a6b32859dbd61cd3147e8682948451be57edd6",
      "text": "gitar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7879a970c44f14ffa1b3ebc24c3c5fe608a9c6cc46134bffc9f7383136185bae",
      "text": "Tidak usah pedas, Mbak. Terima kasih.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "78ee8146a57769b5492d8909fbb19ffc98b9fc6bd851e834936dc9f485ef7939",
      "text": "sangat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b38be33fc296281d213ac74a3ab3357fcffb491742a4132200ae093effd5dea",
      "text": "Boleh saya coba sepatu ini?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "7baef38d6017c91df4e3f3dbab3d42e97d95c931b716c7191f7ea050633d9f9f",
      "text": "Maaf, tidak ada. Ada makanan Indonesia, nasi goreng dan sate.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e15546c890b35064592e1d857c439a009c8fc0bd1b3a150e7660089f3de675e",
      "text": "Ini permainan favorit anak-anak.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e56185d0c7362d96b7377a88f334f84dde99570538aab2843e206ca070a268c",
      "text": "Malam ini kita bermain musik di rumah Raka!",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f13249b88096eb3eae082576ba7c4642aa0b5cbfec7e709f7831af7ec1f1520",
      "text": "Enak banget! Tapi mahal.",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f49d76dac9ee77dfafce223ac515763f2548f94e96b43eb9f4bbd9b89f90dd0",
      "text": "menggambar",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "80c69bd8df2877c70abab850fa03e04317d537ab8a9844bc3683734090c8faf3",
      "text": "Saya suka bermain bulu tangkis. Kamu bisa main bulu tangkis?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "80fd3ca0c1dad5fcdf94a0479a425f58663d216dc83fbcb40ce87e891b3fd8f1",
      "text": "pelayan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8232f6d112a5cf3d51219901471013618b2bb548de522fcd53be3e86ef89a7f4",
      "text": "indah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "836b809b57b02c93e83de1ce4cebc0db73b4bf69d975358e51f5d6e3f7949f0e",
      "text": "Bali sangat terkenal, ya?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8380ab3449c353f1dca76afbe4d94f3a4888a7981274f00b9ef393088d57db51",
      "text": "Aku ingin melihat tari Bali! Kamu sering menari?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "83946fad3ab7d2331a59dfe443b7b13cdfd084984c0f74f578972daecbbc822b",
      "text": "benar / bener",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "843fe31f9ddd610093ce0e541f3278285513df31fdbb59d8af3d89c0f70272e7",
      "text": "tidak usah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "861adb6af0640035765766f32e4ba47f2727b80c5fc3175b32f4c307c0e3bfd9",
      "text": "Aku suka menonton film. Kamu?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "889b6fb9173dbaed1b0b3c13ae7ad7cb3102fc9d8e867a5e770ee99f87cd6257",
      "text": "gambar",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "895bdf4d3b8b20644b4b7e1cb43e0ea179ae103fc11b89756f848ddc8b0a074d",
      "text": "tv",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b9e81bacab6b58b3d25c7f538aca04475d1f2e87be1aa4e9d0fe817aa22c48a",
      "text": "Saya suka membaca dan berenang. Kamu?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d1be950d4b87b4ff5eb5d7f4f6b22bd2746e345cbbc9a6d01799bb974e2e1bd",
      "text": "Rina bisa bermain piano dan gitar.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d64cd1bc0302be088b21c2eb963ab9a4741e237cf1006b67d32e60a0fbfb1ca",
      "text": "mobil",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8def60970bcf55c663dad031ad3f670df8708e25fa76bf7797a5c3f0390f1ad6",
      "text": "harus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fc0a0827915c9b4c50c3d246a36a4c951b5704ea6f580ec27b98b0f1f4a51ee",
      "text": "Saya sibuk dan capek. Saya mau ke kafe.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9017f4776e3dd8ee283bfc8c80b2b6aeff7eaf9ad05bf7500dafc6ff10fb00b7",
      "text": "bulu tangkis",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "95ebcf458537549ecf3f4c23699c4fb387b4514a688e504f1d379870d9c0cb01",
      "text": "tari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "95ed178108124baaf52e1dcc5204b1f6d9462ef08853b840e80d84153e14d62b",
      "text": "musik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "962148b6edd51f318d5e77b6cee69f96dcd623f845c652d8346d5910f5643566",
      "text": "Saya mau pulang.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "9622ff4dfc354ee1bab1cd019b45c8d252bb7ca3339fe62328c6243d9111a035",
      "text": "Aku suka menari. Tari Bali indah banget!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "99066f79d6b000b281f1c9e17587a2ad0cde93daaa2275b9ec15ab63a60b48a4",
      "text": "pemandangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "99e77d33c1ee1e56116c9eb55ca09fa0ab3d57e8f2f57af262a7cf73a4d21ae5",
      "text": "Suka! Aku suka main bola dan lari.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a1b3469d23739a41ecb0d150276550548143f14990939ce670740ebe7da2f0c",
      "text": "Saya punya ikan emas di rumah.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8c2c91257f4688d9f2c7396f9d9244498ca513661d4c6513d6ab4b60ce9991",
      "text": "perlu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cd32a56a3bf1746d5448bc013db99a94b8c0b20267b53749fe39800ca439349",
      "text": "Aku suka menyanyi. Aku juga bermain piano.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "9df33507a671cd68dc05176ab19cfabd63697e2ab040ed2250a3e598a2dab22c",
      "text": "piano",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eb7d58328f6f88e06390ee1ad9e76aa1361f6cf792e65d1f1a0e70f2af76869",
      "text": "Oke! Sesudah ini, kita main bulu tangkis?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f6c88912cd23a692eb9db128ca57c5a497fc3e636aa14f2c5968bbef23a1e91",
      "text": "pakaian",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fe6e710cba564b45a3237e311eb671e69216ba4249cc9f0b7715bdc57f0d605",
      "text": "Ini gambar ikan emas.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1a6307c8df97c0120c8a18f8aca1773dcee94692c6d5e7a5e22fadaaa6fb9b5",
      "text": "Saya suka menonton film di tv.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a51da71f0a0b5a0d793491d9dbb20197512990b84e0641daa5065a6a33efd9e3",
      "text": "Aku suka membaca dan bermain sepak bola. Kamu?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a52fd764af6cc7bb65726fd70397f6167f0cda3a9e86cf279aa1603aa3002ce1",
      "text": "Belum bisa. Tapi saya mau belajar!",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a581ec16597aeae09f0bb3b2e66b43df01a02acf6029233f6fd244e6687acf6a",
      "text": "Olahraga favorit saya lari.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a742e5f2c235d89f41395edc97a93533d646873369aa452e19452eaf39aa4bd7",
      "text": "kalah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ba494f8454392dc88da91593f98846d7662b67742aea857d5e20396de23acb",
      "text": "sekali",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7c8a6732f37ffa39d321bad31beb0ef1b15e74999f8c226379d3acaeae60c3c",
      "text": "klub",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a89c484053f33aba50b003ac899f3d6a9a05c9d9038f56590dca106a0d435aca",
      "text": "menang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a905889c792bd066461a6973fbd66045bd13cf45ab5cbad37d15edfe2fa5ebd5",
      "text": "Maaf, saya tidak bisa datang besok.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a90a9a92d1586c4cd3fad3e66184f0b90c8d660a5e220e0134feb2eefe4d9421",
      "text": "radio",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "aae60f29c959880d6b775422aa2873f42defba8082a7b24c34fa3dff911572d5",
      "text": "Hobi saya bermain sepak bola.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab2caf0f2348c3272b799570332e5f53615586c311a0d81a92193dda15c1cdcb",
      "text": "Saya suka minum teh manis.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab9dbfe8ddca42f0b4ea16303aa1c834c76597e19b8415edee4b56a7f0034a22",
      "text": "Raka suka bermain gitar dan menyanyi.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa9864185b3da72cd0da7ca88ab86a7264134f42c29f82905bdc97aeabed2d1",
      "text": "makanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "afe86fa57ef0daa5df78f1cb86ffe4b8efab833e6389e3c7c8bd6d668586972c",
      "text": "pulang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0392b7a88a7ada2ccffe1c2cc15c06b42715e4a95926bc453409cf87b474389",
      "text": "Kamu capek?",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1f34e86ab2c74bb84b63386cd3185e155f0d7ab9ae47dff1aac72ccbdaeca50",
      "text": "masuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6f67eda732a99f9fa049ca676f86335b7e1c80dfd75fc4e04a3f9fbe6bed813",
      "text": "Saya tidak bisa datang besok.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "b79491830a6b4bf2f855430f8270e9018dc0b63fcecd5752ebf687577729f398",
      "text": "drum",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "b831a81b7eba9233d2cf0a8782499108ca4f14b96dbbc1787adc2f9edfbb4913",
      "text": "emas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba199bb6e9b115828bbbb7b2e4d346c0040d2aa70c9ca4e1be10d6c100e1c34b",
      "text": "Selamat sore! Mau minuman apa?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb2dc643aedaf374baa51beefb51f7595ced5b85dd5116f888b326eee6755ef0",
      "text": "Maaf, Pak, saya tidak bisa. Saya perlu ke kantor imigrasi.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc5efa68f8a1c99c7f98026fa17ee8bb1dc0c2cfd2ac2340330e797c73a0e00c",
      "text": "bola",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "be76bc10623def0320b6cd2951867f015c270b1f0e59ca723e0cd3ea9d3414c8",
      "text": "Mohamed, ini foto Bali.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "be7ef13412ba188abb03cd1fce2e8a37eba751e5952061979d3522d16f23ad63",
      "text": "Anak saya suka mainan mobil.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf17bc1bcb97af29b297d029c752a70cadd98ffeea26f9b9702f0574d13b60e9",
      "text": "Adik saya suka menggambar.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c01ac20958f6a933707059d851995cb01e21b1f674aa6e1805e33c85901d9704",
      "text": "Ni Luh, kamu punya hobi?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0ef829197fdedfab9f1d0e1594d1f17863444b5c9714c050b916bf360ec657c",
      "text": "Saya menonton film di ___.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "c70ab580e84a37df12cddf6ca71bbaa228442202a01cc4425cd81c137460e0a6",
      "text": "mainan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c80321467d9146dccaa02a1a3c80b1ba683191dd36fa36d7016393195a8a9a44",
      "text": "berkebun",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8385b157844b6fb4a9aa184d1862cbe4fe92f74e077d6f0a6b66f1418bf3079",
      "text": "Makanan Indonesia enak.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8a24102c3258654d988f0870213ef9b98050335ef9dcba0b6f75a65370d32e9",
      "text": "tidak apa-apa",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca77920252b0ae93564510ac46189aabc362428e2f8d50099a8544ff87ef5886",
      "text": "Suka banget! Di Kemang ada banyak kafe.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "caaba579b28b38a9d4511d5411e4859a75cd1fa46fa47315cb2289acfe3576b7",
      "text": "ramai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccdcf4b012104d8ce72cafd90126df7d0c1b0fd27b2dea88478e957afacf86e5",
      "text": "Kamu mau minuman apa? Kopi di sini enak banget.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cda2d2b81d5cdfb9bcc7993474bdbb20e8daeb001e6dc909eb5821e8e9455b96",
      "text": "Tari Bali indah sekali!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce81c1df76288ad00b2121ca561ba7bc8afa2ff55c8f798956b54700c3e7d162",
      "text": "Ya, setiap hari Minggu. Lalu kami nongkrong dan ngobrol.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1b51aa7c9cb59fc97dfbfbee761adfcaae448c7d04765bb04239d0f68ae17e1",
      "text": "menjahit",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d20ed083d95bfbc7526cb04621c9a56e2f87c2d0cada1414da16515d32f092d4",
      "text": "Mohamed, kamu suka olahraga?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
