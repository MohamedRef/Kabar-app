    },
    {
      "key": "dc4532867d885fc932e553c4051d507819582a024450afe44cfb2ccf2261c55d",
      "text": "Betul. Musiknya juga bagus.",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd242d57fa67fef8205cbe9b6517db4509a5e647073e2d8752875ef19cd114ef",
      "text": "Hebat! Kamu bisa menari tari Bali?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "df0edca140886c110c5c12b33c8a6e10fa12930cf38c24e9918ba039a256a8ec",
      "text": "Betul. Pantai Kuta sangat terkenal.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfb0ef68f76e75966e0cee84e9a477cab1eaccd848303cf64397a3f3b38206dd",
      "text": "Nasi goreng satu, ya. Saya suka makanan Indonesia!",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e137daf44422f8d33f7d2219160784d13fb2e249fea7b9d33f14e4adff96220c",
      "text": "Saya suka menyanyi dan menggambar.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1614336e0e1698e992fe8a2c1413977a7c5021dd322ad6f84075eefcc9ee012",
      "text": "Salam kenal! Apa hobimu, Mohamed?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e16a22cb023bd2df6e3ddaf7d55616f0421a2c9dd9bb9fc74c2b68c02d98943f",
