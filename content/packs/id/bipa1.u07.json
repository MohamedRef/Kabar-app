{
  "format": 1,
  "id": "id/bipa1.u07",
  "language": "id",
  "unit": "bipa1.u07",
  "version": 5,
  "content_hash": "2824fbf1f2f960a763cef9da99e50e5c40dcaa11210bc1859af3f3f7acf5fe03",
  "lessons": [
    {
      "id": "bipa1.u07.l01",
      "sha256": "d7bef34b167d7e62b733e13e2db36f896443c6f4637b9ec07cf68212b875efc4"
    },
    {
      "id": "bipa1.u07.l02",
      "sha256": "a6086793380c239eb6c5000083fce2af29ebcfc32d59d242b00c0ac1cd59388e"
    },
    {
      "id": "bipa1.u07.l03",
      "sha256": "6cf570112b5002a66102f0baa3d8f7d365b8d6d61cbac57c70dfff8757b19910"
    },
    {
      "id": "bipa1.u07.l04",
      "sha256": "0d0d0dff7e99e806a7f7e27324a5e0ca7560752c08eb2a2d56c3dae9ed05e375"
    },
    {
      "id": "bipa1.u07.l05",
      "sha256": "63de0f22eaa04979d601c7725c23ba54f572273ede6676c41467167c3f5b1c24"
    },
    {
      "id": "bipa1.u07.l06",
      "sha256": "a48ed8b5ad75e4c05b54ff670d9800463c1c081a9ca2b50526e1620810057c73"
    },
    {
      "id": "bipa1.u07.l07",
      "sha256": "dd7d2210bdbab57fa956a56ad116f8353f6350d07dd357c7cf1c473aafb0340e"
    }
  ],
  "audio": [
    {
      "key": "003f8c5b1cdd3737cbef1f40ba2916d5a0cf128dd165638cd3ef87eb857e3313",
      "text": "Mau minuman apa?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "0134cce29e652ac75ed7b560b718fa0689f1724adc5fcf15015443c36e836273",
      "text": "Betul, pemandangannya sangat indah.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0857b195a6e9b16b8c757021af2f6de4625c068b752fa60ba1e4e9fabb85831a",
      "text": "Ya, kafe di Kemang mahal banget. Tapi tempatnya bagus.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c10708230b0e4ebe024e9aa5224c37098b58fcec38bffc1b09dc6769e01aac2",
      "text": "Ya, setiap hari Minggu.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "103e6a4bdce66a7f5263381eafe37ab4449e8ba9393363dae29d220b3703fc32",
      "text": "Teh manis, Mbak. Ada makanan Mesir?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "12899ee65ccad690a633f32ba6b53fb803e1c36fb368993b32c3865a45832b8f",
      "text": "Hebat! Bagaimana kalau kita nongkrong hari Sabtu?",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "130a9616ea85f8df5af2a8e5c2fda485e93ac22d6916d97dcb493b2cd5103345",
      "text": "Saya ingin melihat tari Bali! Kamu sering menari?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1498a79b90aac32429a98024a262953d95584a5e7c6fd99effe1cf7c01b71dd6",
      "text": "capek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ffc7c20cedc04fc638b856a3f29785baf435cd7e39fa70857e1b030ea97ca8b",
      "text": "Mainan favorit anak saya ___.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "207c68d00c4b5d7edf925d11d96e062c7408dfe6df957ee6034ad7c4e817da5a",
      "text": "Saya bisa menari tari Bali!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2087434c7e7983b585e160eb124061cfe6afe926c7145af7d6af49feb958eeec",
      "text": "nongkrong",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "218571c02fe64c7e3f4973f854bbaf24e5acf18156bb37cde5c793edbac8ec88",
      "text": "Pemandangannya indah sekali.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "22902b954ec989244510198e619c306a00b50149912b398d25eda9da36ed77dc",
      "text": "Kamu tidak perlu datang.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "232ce57156fddbb992ff5e873a37747a50343a514737b1cbc99f6854c12839a8",
      "text": "Kamu harus coba rendang!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "24ab4931bc75de2454ee83d837d587211a4f8939ff679674c9cee397dd508b68",
      "text": "Bali sangat terkenal.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "252288be137985ab1464dbe385886c81f23c4ef855658015967f00579afef57b",
      "text": "Enak sekali! Tapi mahal.",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "26a9daaec290a74285fc9aa5b5052a0b19ada5d83ceaa04a9b3be687064c1487",
      "text": "Ya, hari ini saya sangat sibuk.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ef4bd4e257a3b6a6f6fe98c3bb9ca830e2cced9fcc1ece21c3ab94fc3e2e0b",
      "text": "Oke! Hari Sabtu kita main, ya!",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ec0e0a29c04e3d414562511fd1906cbe82cdd842a575fe0093c76c5a4364e1b",
      "text": "betul",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f5dfd3179655e1b0c8748535af9eee37859269c901fd9d75f4825251c1f4e6f",
      "text": "sibuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3293f7d7d665f86ee45e4eabe7001e5b0818ac9f621cb058dbc948fd57f08bed",
      "text": "Kemang ramai sekali.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "33c33a20e9e0e09055aa386c5d7e37b684a96952b2893dbf2a4fc90640f4f41a",
      "text": "Saya suka menari.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "35c4991023ccf55aa9208ed81368893e1b76c1ce64ffe4e583feab2389d2f3a2",
      "text": "Hobi saya membaca dan bermain sepak bola.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b29404a3aacc9d662f301658106e57aa325aae01f23b8da536af0545c36fea",
      "text": "suka",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa62f094994766719bde3897fde6e35567f04f44924f79768586a5091073b70",
      "text": "Saya suka makanan Indonesia. Enak sekali!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c8926af291badaf4b80676b99161cd04f2cba1f8b4c45205f04b137f332e2bf",
      "text": "kafe",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d20dbf266636839c71801ae123df28873b4be9d42fa8f46c25a0e12324959dc",
      "text": "Saya suka menari. Tari Bali indah sekali!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d78594062ac42636d16b5de63a731fd2d33bf9da9ac10ab986af2b74ef14da1",
      "text": "Baik. Mau pedas?",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4288def8866a4af8d5431baae3c06a5ebfcf5bfba356280ad8c6ce86ed10498a",
      "text": "Saya ingin minum teh manis.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4333f2df73a9c21ebaff1963d1f5a48e3baccf8ea2c4d731fbcca9a3ec90231a",
      "text": "Raka suka bermain bulu tangkis.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4369916fc9a49b3d49401a005724349c47a0e94f6a7fbdeaec2f7518277ee205",
      "text": "Kopinya enak banget!",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "452ff4b66f9b0ffa133df16f2d9bb9895768672393d6638c391b9d17f083d490",
      "text": "Di masjid tidak boleh pakai sepatu.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "49faf4c4c75a0109b733fba0487f23d6641a3bc0906a74db04b6bb24b0eb9233",
      "text": "Bali sangat terkenal, kan?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a2d7ddbd61b147b160c5a686cb5d672ba1c199f9dd24101874a0da783193ae1",
      "text": "Saya suka makanan Indonesia.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a71971fbe27f0583fb2f8138a7474479897026cbb8bde18465e8c13f568bbb8",
      "text": "Tulisanmu bagus.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bb7c72bafc70e0cebf64a38f2f951f3ebc5c69291d8f8b389e4bb0c09e2363b",
      "text": "Boleh. Silakan!",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "4da11d8e0709f139124148e4a25ff5ef647582155be1d7af4d5115192332e4cd",
      "text": "sepatu",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4de1e101582bc1c3b92a4d3fbfadb0ec16bc3bfb0b54463ac0f11d33e0087cf1",
      "text": "coba",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e6f4033fc22b8d23faa8ff32af8d85c64e1fcabb85b3f7194b4bf83f5de4ff2",
      "text": "ingin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f96999bf447ee0cd50da95d430516ce6bb387e1e20d3c3e3ebe1d88dc2da715",
      "text": "Minuman favorit saya teh manis.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fe8f971fe6de24b659a1b1a364f27c0b43be25c8d6b6f0d995554d5a4e2e2f2",
      "text": "Musik di kafe itu bagus banget.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "50e81609de7e65061fca24836477a2826b653827f4cb57180f45e43eeaf8ac61",
      "text": "Saya ingin ke Mekkah.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "52aa051d98018b820aeb8ee453b1aa512b72a7a1dc5042f8e5e316abebccf88a",
      "text": "favorit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "531e5cda6a4f74b0a0310333a2c73dc4cacc7033d05f166d6664b485f32c6e64",
      "text": "Saya suka membaca dan bermain sepak bola. Kamu?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "5997237c3c2f29368d45da36872a4fb6684954be52c4d6320b66196f314f6695",
      "text": "Kopi di sini enak banget!",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bd1d2d43287d85c1f4ec098c1ffc456d85901c5f3eb72d17e6c1520364f4871",
      "text": "Mohamed, besok kamu harus datang jam tujuh.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e6bcb14ceffd127577791ebfa71f9e6a3aa6b0427394bb8144031ae3aa0b09b",
      "text": "Saya mau teh manis. Tadi saya sudah minum kopi.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "611192553b85fbe0d94927271b8898b542568a11fcabce4a6cd87fa48d021aec",
      "text": "sepak bola",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "670f39e4eb16bb1f50ed6506184086cd3546629bfa1ea7bb08f0c580201e476a",
      "text": "Tidak usah pulang sekarang.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "69ed89e782918b8bc83a2827b2ee961e5c10fe9a7fb0c837212394d46c59fe9d",
      "text": "hebat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c961105336a5e6dfcf1a07b8d40748c77582b892c20f0d10cf7a90566c52be2",
      "text": "Mohamed, hobimu apa?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7879a970c44f14ffa1b3ebc24c3c5fe608a9c6cc46134bffc9f7383136185bae",
      "text": "Tidak usah pedas, Mbak. Terima kasih.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "78ee8146a57769b5492d8909fbb19ffc98b9fc6bd851e834936dc9f485ef7939",
      "text": "sangat",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b38be33fc296281d213ac74a3ab3357fcffb491742a4132200ae093effd5dea",
      "text": "Boleh saya coba sepatu ini?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "7baef38d6017c91df4e3f3dbab3d42e97d95c931b716c7191f7ea050633d9f9f",
      "text": "Maaf, tidak ada. Ada makanan Indonesia, nasi goreng dan sate.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "80c69bd8df2877c70abab850fa03e04317d537ab8a9844bc3683734090c8faf3",
      "text": "Saya suka bermain bulu tangkis. Kamu bisa main bulu tangkis?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "80fd3ca0c1dad5fcdf94a0479a425f58663d216dc83fbcb40ce87e891b3fd8f1",
      "text": "pelayan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "8232f6d112a5cf3d51219901471013618b2bb548de522fcd53be3e86ef89a7f4",
      "text": "indah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "843fe31f9ddd610093ce0e541f3278285513df31fdbb59d8af3d89c0f70272e7",
      "text": "tidak usah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b9e81bacab6b58b3d25c7f538aca04475d1f2e87be1aa4e9d0fe817aa22c48a",
      "text": "Saya suka membaca dan berenang. Kamu?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d64cd1bc0302be088b21c2eb963ab9a4741e237cf1006b67d32e60a0fbfb1ca",
      "text": "mobil",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8def60970bcf55c663dad031ad3f670df8708e25fa76bf7797a5c3f0390f1ad6",
      "text": "harus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fc0a0827915c9b4c50c3d246a36a4c951b5704ea6f580ec27b98b0f1f4a51ee",
      "text": "Saya sibuk dan capek. Saya mau ke kafe.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9017f4776e3dd8ee283bfc8c80b2b6aeff7eaf9ad05bf7500dafc6ff10fb00b7",
      "text": "bulu tangkis",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "95ebcf458537549ecf3f4c23699c4fb387b4514a688e504f1d379870d9c0cb01",
      "text": "tari",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "95ed178108124baaf52e1dcc5204b1f6d9462ef08853b840e80d84153e14d62b",
      "text": "musik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "962148b6edd51f318d5e77b6cee69f96dcd623f845c652d8346d5910f5643566",
      "text": "Saya mau pulang.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "99066f79d6b000b281f1c9e17587a2ad0cde93daaa2275b9ec15ab63a60b48a4",
      "text": "pemandangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8c2c91257f4688d9f2c7396f9d9244498ca513661d4c6513d6ab4b60ce9991",
      "text": "perlu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9eb7d58328f6f88e06390ee1ad9e76aa1361f6cf792e65d1f1a0e70f2af76869",
      "text": "Oke! Sesudah ini, kita main bulu tangkis?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f6c88912cd23a692eb9db128ca57c5a497fc3e636aa14f2c5968bbef23a1e91",
      "text": "pakaian",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a52fd764af6cc7bb65726fd70397f6167f0cda3a9e86cf279aa1603aa3002ce1",
      "text": "Belum bisa. Tapi saya mau belajar!",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ba494f8454392dc88da91593f98846d7662b67742aea857d5e20396de23acb",
      "text": "sekali",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a905889c792bd066461a6973fbd66045bd13cf45ab5cbad37d15edfe2fa5ebd5",
      "text": "Maaf, saya tidak bisa datang besok.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "aae60f29c959880d6b775422aa2873f42defba8082a7b24c34fa3dff911572d5",
      "text": "Hobi saya bermain sepak bola.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab2caf0f2348c3272b799570332e5f53615586c311a0d81a92193dda15c1cdcb",
      "text": "Saya suka minum teh manis.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "afa9864185b3da72cd0da7ca88ab86a7264134f42c29f82905bdc97aeabed2d1",
      "text": "makanan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "afe86fa57ef0daa5df78f1cb86ffe4b8efab833e6389e3c7c8bd6d668586972c",
      "text": "pulang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0392b7a88a7ada2ccffe1c2cc15c06b42715e4a95926bc453409cf87b474389",
      "text": "Kamu capek?",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1f34e86ab2c74bb84b63386cd3185e155f0d7ab9ae47dff1aac72ccbdaeca50",
      "text": "masuk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6f67eda732a99f9fa049ca676f86335b7e1c80dfd75fc4e04a3f9fbe6bed813",
      "text": "Saya tidak bisa datang besok.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba199bb6e9b115828bbbb7b2e4d346c0040d2aa70c9ca4e1be10d6c100e1c34b",
      "text": "Selamat sore! Mau minuman apa?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb2dc643aedaf374baa51beefb51f7595ced5b85dd5116f888b326eee6755ef0",
      "text": "Maaf, Pak, saya tidak bisa. Saya perlu ke kantor imigrasi.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "be76bc10623def0320b6cd2951867f015c270b1f0e59ca723e0cd3ea9d3414c8",
      "text": "Mohamed, ini foto Bali.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "be7ef13412ba188abb03cd1fce2e8a37eba751e5952061979d3522d16f23ad63",
      "text": "Anak saya suka mainan mobil.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "c70ab580e84a37df12cddf6ca71bbaa228442202a01cc4425cd81c137460e0a6",
      "text": "mainan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8385b157844b6fb4a9aa184d1862cbe4fe92f74e077d6f0a6b66f1418bf3079",
      "text": "Makanan Indonesia enak.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8a24102c3258654d988f0870213ef9b98050335ef9dcba0b6f75a65370d32e9",
      "text": "tidak apa-apa",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "caaba579b28b38a9d4511d5411e4859a75cd1fa46fa47315cb2289acfe3576b7",
      "text": "ramai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccdcf4b012104d8ce72cafd90126df7d0c1b0fd27b2dea88478e957afacf86e5",
      "text": "Kamu mau minuman apa? Kopi di sini enak banget.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "cda2d2b81d5cdfb9bcc7993474bdbb20e8daeb001e6dc909eb5821e8e9455b96",
      "text": "Tari Bali indah sekali!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "d292bc8906df86f72837fb7f43c13ce86d65ca475e3f71aa09dd5e1f375c0b44",
      "text": "Silakan masuk. Tidak usah buka sepatu.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d54499ed95b17d4b074c3231c873d385a61c1e1a55b2aa0edcdc02c46d369ef8",
      "text": "manis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d94ca18ca6ed0d71cc703590c52bc0802290b6b2708919b2868dba8eff4ed9b2",
      "text": "mahal bgt sih",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d95f630a8af5f4a95f6b3f1a44562faacc57770d6083ce3d7628535d67393b2f",
      "text": "Pemandangannya indah sekali!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e046b2a9c3c9dd8988ec97009c706a6e88f2adaba9580c0e03fb5cf443ab4e",
      "text": "Wah, pemandangannya indah sekali!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "db73739dcfcebd3b1f4f616547ba67d9d705e0eb615d063a76a94c100cb8acc3",
      "text": "terkenal",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc4532867d885fc932e553c4051d507819582a024450afe44cfb2ccf2261c55d",
      "text": "Betul. Musiknya juga bagus.",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd242d57fa67fef8205cbe9b6517db4509a5e647073e2d8752875ef19cd114ef",
      "text": "Hebat! Kamu bisa menari tari Bali?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "df0edca140886c110c5c12b33c8a6e10fa12930cf38c24e9918ba039a256a8ec",
      "text": "Betul. Pantai Kuta sangat terkenal.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "df8f5734facd6d72bd5cbcb944894267b49451dcf73f206ede5bd2d4b2653683",
      "text": "Wah, hebat! Saya tidak bisa menari.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfb0ef68f76e75966e0cee84e9a477cab1eaccd848303cf64397a3f3b38206dd",
      "text": "Nasi goreng satu, ya. Saya suka makanan Indonesia!",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1015db29ca0a62d0fcc0a52996ed40ac558c80012fcdcb019b607f7a4fa7d09",
      "text": "Boleh! Tapi saya belum bisa main.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1614336e0e1698e992fe8a2c1413977a7c5021dd322ad6f84075eefcc9ee012",
      "text": "Salam kenal! Apa hobimu, Mohamed?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e28d65fa607d2c993844d53f78da18e0fe40fc38cc9149ebfca9959f41a646c0",
      "text": "tulisan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e48abd06c353eae7924b6bd9b5d8c378cdc96629197c8b23afd91e13316f03d6",
      "text": "minuman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5864b6f2819fc60055c34a10d3e1440dbbba1fc8b645256e3ed6cf57e94ba5e",
      "text": "Saya ingin ke Bali!",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5e782513c9f703dabead8f04b6075e7f4283aecfcb292b991681c5b2a63d9ee",
      "text": "Mohamed, kamu suka nongkrong?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6da7288b591f0f355aeb3691ee7545c4a2f263fcfc88065004eb76dc970e75f",
      "text": "Suka sekali! Di Kemang ada banyak kafe.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7780c6f355c933d657f5ce3699508a40f2a24ac4e940d7d62e78d2c9101bcfc",
      "text": "Mohamed, bagaimana kopinya?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea1952a90732ecea81d57d00571cc8f8050795a1e96e307a165d99f5fb9ed6d2",
      "text": "menari",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef5f4a43f83ec3526a17598202ffc0af5ba1680235c582311de1bb6b3bb111d0",
      "text": "banget",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef7f044db46a321c62ec82489bde15b1bf0a99d950deb40e0d918485119b0a48",
      "text": "Minuman favorit saya kopi.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f161dac758234040860a7661e35bfedb135d22990bf73f6029f10f80e68f5197",
      "text": "Tidak apa-apa. Kamu boleh datang jam sembilan.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5d5aa0a1b96c9a5fabc5ff3fb8d088030329726e111630ef7bb49864c8c2940",
      "text": "hobi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "f72760cf9ed97abc4bfd0c59d95f155f4c1da9d48190f5e4fa1af24444be6cea",
      "text": "Terima kasih, Pak. Boleh saya pulang sekarang?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "facf25108d2b0aacd48c59a66abf119e65046b877f0c513bfe316b333b4acef9",
      "text": "Hobi saya bermain bulu tangkis.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb1f53fcccf7995a00c52d27151195f32e946e5e68861b77af879dc107e7135e",
      "text": "Pelayan, tulisan ini makanan apa?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    }
  ],
