      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef7f044db46a321c62ec82489bde15b1bf0a99d950deb40e0d918485119b0a48",
      "text": "Minuman favorit saya kopi.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f161dac758234040860a7661e35bfedb135d22990bf73f6029f10f80e68f5197",
      "text": "Tidak apa-apa. Kamu boleh datang jam sembilan.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f24093719d61819dbcbd733c430258e7396b4eb3d9f349f6500c476482b4a436",
      "text": "Mesir kalah… Nggak apa-apa. Permainannya seru!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5d5aa0a1b96c9a5fabc5ff3fb8d088030329726e111630ef7bb49864c8c2940",
      "text": "hobi",
      "voice": "id_gadis",
      "chars": 4,
