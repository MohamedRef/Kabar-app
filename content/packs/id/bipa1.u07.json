    },
    {
      "key": "d95f630a8af5f4a95f6b3f1a44562faacc57770d6083ce3d7628535d67393b2f",
      "text": "Pemandangannya indah sekali!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9e046b2a9c3c9dd8988ec97009c706a6e88f2adaba9580c0e03fb5cf443ab4e",
      "text": "Wah, pemandangannya indah sekali!",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "da1d8c1b522a706510285a22fab7c9059b595f9548812d94374d5a43b1ea6c7b",
      "text": "Malam ini ada sepak bola di tv: Indonesia dan Mesir!",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "db73739dcfcebd3b1f4f616547ba67d9d705e0eb615d063a76a94c100cb8acc3",
