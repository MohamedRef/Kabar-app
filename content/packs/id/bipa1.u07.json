      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3b4741018d903a766d6e20c3cab7fe3461cd960f9eb2335abd30d28c4c4cce2",
      "text": "Indonesia menang, dua — satu!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e48abd06c353eae7924b6bd9b5d8c378cdc96629197c8b23afd91e13316f03d6",
      "text": "minuman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5e782513c9f703dabead8f04b6075e7f4283aecfcb292b991681c5b2a63d9ee",
      "text": "Mohamed, kamu suka nongkrong?",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9bdf9977449ca84ac07661264a261161b5f56e6feadc23c6e702c60f7861618",
      "text": "Bener banget, pemandangannya sangat indah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea1952a90732ecea81d57d00571cc8f8050795a1e96e307a165d99f5fb9ed6d2",
      "text": "menari",
      "voice": "id_gadis",
      "chars": 6,
