  "unit": "bipa2.u01",
  "version": 10,
  "content_hash": "88969a09c1dec1011f0cab1897afb3667d2e8627c0cd1f0fbf91f01dc34b2733",
  "lessons": [
    {
      "id": "bipa2.u01.l01",
      "sha256": "8b0c2f2bbea1e88e836166fee11dc496d223ebecbdc05ab958f177d6c5f39c9c"
    },
    {
      "id": "bipa2.u01.l02",
      "sha256": "84b3b59d0ea87f90f95fa9427ea399d6c9e5ee9eaccda079ea0466be0da7e570"
    },
    {
      "id": "bipa2.u01.l03",
      "sha256": "b36326e258fbbc8832246127dc41ca18f07f4b1aa88ac3233cf149528514ccdd"
    },
    {
      "id": "bipa2.u01.l04",
      "sha256": "211ae86a01569f9e280ce7909bfb309b9db3e917f1016f32383aa0119b928291"
    },
    {
      "id": "bipa2.u01.l05",
      "sha256": "62f21ec4d3d103c7a4005f861ff13dbb1d88738f6e00e4a7e40dc21b196b5589"
    },
    {
      "id": "bipa2.u01.l06",
      "sha256": "1108c01f4cb986f1bf770658e0100770e43147ff2b609d69ae91337459b493b3"
    },
    {
      "id": "bipa2.u01.l07",
      "sha256": "523c56647eae260370b0831f9a53bfff5eb6c1e66e4e3c2c5971aa9b2668c740"
    },
    {
      "id": "bipa2.u01.l08",
      "sha256": "8c43d7db663f0b110f56819b9bc6ab677fb0e55ce6925a94f08e284c18e43b98"
    }
  ],
  "audio": [
    {
      "key": "01b4a601d0e94735d94c244eabaabe1c54eaa853a6d7531f2d84f43dbfdadd7e",
      "text": "Sayurnya kurang garam.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "037a56f6afd04be7a4a642ea4eaaa9453fa6d22394e5464b63fe69b674c8ad05",
      "text": "kuat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "03aa6ea8d040941b6361c79179fbea60c76cbd4cb17509685fc08959583676c8",
      "text": "terlalu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "05114e03ff08b477a659d62f048079495fe84e6572b1793e1ab2637ef5813301",
      "text": "Gamelan adalah musik tradisional dari Bali.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0551c64a2b1775e19bcec910a251fdeb607645c261d7219e5e90a62926133adb",
      "text": "suara",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "05a4e55ceeb41d9b738e97063f3dea1cab82eebee867e6bc2577f6c3ce73f0a8",
      "text": "gendang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "065e33234d4fed3e3d45e714c2825052ba1b593b489f8c74c36b8eb91d5033d4",
      "text": "Suling ini agak kecil, tapi lebih murah daripada biola.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "06bbfde8b3fd32e42ab3c699768ef4ff262fad683eea23ce85442259a10b5adc",
      "text": "Gamelan Bali terkenal di dunia.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0aefc199982592e6d081ccf839cb13f7af14c758483f2c65af196e2a882d219f",
      "text": "Ada. Yang ini seratus lima puluh ribu. Agak kecil, tapi suaranya lumayan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d0956577015474540da5fff1489690f8d0bc2893a0c46fe95d20e043bbe52cc",
      "text": "pura",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e5618983109156ef3b1ca8b94ac716f678739489f64668257c1a8275446f1b0",
      "text": "cukup",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e7f884fd753b10fef77b5c3c9af45d77ad4b186db43bed76f9c3677c06258ed",
      "text": "Gendang ini lebih besar daripada gendang itu.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec96d27f2f0910d9221679f2802adb254480672e0f42dcf7f59768cb5ebd42c",
      "text": "sempit",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fc9d12c3b5adbced09e73e80c8c5d278a8ad741d6611d52b15c2a0ad1e9d5aa",
      "text": "Gitar ini paling murah dari semua.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "12b603b8ac594e59f9d78e748dd9d927dd31b5a35182c1e685f67d1fffd1e664",
      "text": "Malam ini ada tari Bali yang istimewa di pura.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "15228e6832e0bc130c74ccee0722f23f78766a2d8846217dae88e3de60f72bd7",
      "text": "Gong lebih besar daripada gendang.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "1587a1b400b3066e76706bb90e7c8a50ff985e0e8f2d656bb786abfaecf562ad",
      "text": "tipis",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "16a01af1eaf16e6a2d9710ba5462bccf40fdf715749fbc797f4a3e84edb88b94",
      "text": "Suaranya terlalu keras.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "17a2f4064c17dfd3247307fea481ccf507ed1dd540cfe35e9ebfd34cd3adb5ef",
      "text": "Suling lebih ringan daripada gendang.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "17f6aace103ebb3c3406e30e8b0deef169ccf45542e971205bed644363c38d93",
      "text": "Bagaimana gamelannya, Mohamed?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "18a026ccb40164886feb22a08c901b8324b408b00f27f2a87925d8ad44cf5e3e",
      "text": "Banyak alat musik gamelan dari logam, tapi gendang dari kayu.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "19e203f8a7ace02e7a65bf870c7b13798c42e48c970f74f6c5d85176b96d0172",
      "text": "Mungkin! Tapi musik Mesir juga terkenal di dunia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b28fe94e35ff502a66056c9b1f82283e2ccb60250d0cbe359acf00abe6cdfea",
      "text": "daripada",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba1b3ea552469e5a6a5e3b8f63432067c880ea12142b9ba82b588567d9f5741",
      "text": "suling",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "1c4d67a768c06ea8b48afc8a1cf338394089dab9fdf83f8be700b3d99e9eec3d",
      "text": "Biola ini antik dan asli dari Italia.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cdf44ab49f5128c14c382765f9950a0faf2af5a9eb6213576dd67bc68cbab85",
      "text": "Biola ini lumayan, tapi suaranya terlalu pelan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "22286b8f759877db7fed0e9b5ffeb4ae2c3ce362ae92ec829853780aa6e175cd",
      "text": "Jalan ini sempit, tapi jalan itu lebar.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "24478e86db88c08f25561bd3c6ac24f9ed289913f2010fd8cdd34dda30e108c9",
      "text": "Saya bermain gamelan dengan teman.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "257930dd5c341dbe75f04202e7ec9ee47a6c2f4e493b582ac16f52f1a3dc2c14",
      "text": "Wah, terlalu mahal untuk saya. Ada yang lebih murah?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "2637015f5f0191b64c334e33c511b93c84c00aae7215a8c4f1ee3746f7f21ec9",
      "text": "Kue ini istimewa. Sempurna!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b1c640aa0c73c7552a647a32020e713d583690bfd241280f546a274a16d870d",
      "text": "logam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2c0ec0613d5e4b04208773ed22f371e62f91f23a50266458dd179364f0b513bd",
      "text": "Banyak alat musik gamelan dari logam.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "2de81a59b7c44815c648198cdd040b4c64b0fc9ff7142a4bb63950f7bbe2ec3b",
      "text": "Gamelan adalah musik tradisional dari Jawa dan Bali.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "3012c115c3c886ede6254290744eea58e1b47fc82454dd62687786fa21acdaaf",
      "text": "Kalau begitu, lebih baik saya belajar suling dulu.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "30183e01192fca1e33fbbd8972b60b2e6d78914cfb95a39bd8410ab2d733c51e",
      "text": "sempurna",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3095f44b8cb69d7f40dcbd9abd76c615b9a538a9d1b079fdf1150a3cfedb01d1",
      "text": "Suaranya sempurna. Di Mesir ada musik tradisional juga.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "32aa1411b5fef1aa0bbbdcafb54fac0d0d832aa831f65d13244549f99e39e1c4",
      "text": "Betul! Gamelan Bali lebih cepat daripada gamelan Jawa.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "33c035ad07760f6b17552eace62c95814e4d39d654d711a9c8fd81efe52495c3",
      "text": "Gamelan Bali paling cepat, ya?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3500e57db5f0cc60d6bcf43431625bba2f2771355b801d34ddc3938091bf4495",
      "text": "modern",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3696867e6caef73340ef8df23dbf7f692689aa5b28d1c92f391b81c58a5f0578",
      "text": "Yang kecil lebih ringan. Saya beli yang ini saja.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "370ed1dad6dfb39b6c3502de0285c1614ab2b1c907707ef0d74b160684a676c2",
      "text": "Indah sekali! Pura mana yang paling terkenal di Ubud?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "375e7f3e808e1ff5e8e8c0423f0677982744e4db6f0c0d56b5cce86c8658d2e4",
      "text": "Gamelan ini cukup mahal, tapi bagus.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "38278f026caa37d3244506cebaedab2f4b1b56d493a3305110d21a33005f2685",
      "text": "Tiga ratus ribu.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "3de05d075127b5cbc9a1949b9134667d10acf6313b4187841d3f911faa46bcbf",
      "text": "Gitar ini kurang bagus.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "435804578264214671b3add88236a40c87b6b4a39aa1ef5cfb73cb5ef191c300",
      "text": "Gong adalah alat musik paling besar dalam gamelan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "45979dee24a0d616c0d9a2f56a67b0baa2a3f663c222d66490a7390c03656d03",
      "text": "Wah, terlalu mahal untuk saya. Ada pilihan yang lebih murah?",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "46d7255cce9795f904a0d45e01bdf43eec0883b47e7b03c3c3054e22ad1ec678",
      "text": "Bagus! Suling juga lebih murah.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "486dbd2a5a5dda2d62d4481bf811efbc38b32e4a83675647c86eaada40a0b71b",
      "text": "plastik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a8bf485b08b0c2f458100374f73dc0f909997b46f8c3baef4e682e925b54a03",
      "text": "luas",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c1d9d45d167cd0943a31babb460e324cc2b410e0333eaaf8c2d8c7cb87d691f",
      "text": "Rumah Ni Luh agak jauh.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c44b9a6d22715b652fc9052ac04fcf91a5b72be9911235c01b5650119322348",
      "text": "Ni Luh, ini alat musik apa?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ca93a9d12b454210ee775af46fa6bc60177036c7bfe52939d79f04eb3818bcd",
      "text": "lebar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc6c0f8c1ecf914d8d819626c5ed2497d279c38c21731d7c8c1c8c8e8ca1e8c",
      "text": "Mana yang lebih murah, ini atau itu?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "52ced22dbbaa788791a8fb9eaf452a8e4f1b784c244db4fad35d6870c448d36e",
      "text": "Ada yang lebih murah?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c8a02a0bfe376b1509b4a85ed98f01ef987ae7d6bacdb76db783affa4c316cc",
      "text": "Pura Taman Saraswati. Di sana ada gamelan setiap malam.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "657a861305f51df25c7adeca96485178a2c140035bcb2a5972e856b6696b2455",
      "text": "besi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "65d3e751199f648e28053908f99252788e721bccc953ead383dd780a12c6d5df",
      "text": "Suling lebih ringan dari gendang.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "664ca321d9a9033e46628bc8dcd3da8ed4e043c9fd322a60ff1aed226ce37177",
      "text": "Ya, asli dari tahun 1920. Unik sekali!",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "673f465d29c8258af0d82b67549afcf430377c9f2e3338c2c115bfe6c980b9b3",
      "text": "pilihan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "697d8c9186a3105dbee973be8109f8499efb4ed6d6418500b975edd973b306c4",
      "text": "biola",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6df3650fcdab6fc4b59242f9b5ebef3d3d95ceff76fcd4734972c7b44f11da64",
      "text": "ringan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fdce3b35f5684fb2993b65d97f3a1f8a17953d92ddb0b38beb592bf0eeb82a3",
      "text": "Betul, suaranya indah sekali.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fe07dc276f68a8cb109c5b410430a831b77f4157cc578b27acec8ae70d21192",
      "text": "Gendang. Suling lebih kecil dan lebih ringan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "73552ccc5bec64898b0ffe94235cd9ce441f63653b778e82b3b014b7fce8f95b",
      "text": "Pura ini paling indah di Ubud.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "747f600b1eb600582a88453e85986cdbe48dfddda9e121692af35381cc54cf12",
      "text": "Ya, Pak. Yang ini dari kayu, tidak dari plastik.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "75b0bcbcfd0651d623d2f8241c93d9f23fb13164196a6832ff645d3479d734d9",
      "text": "Ya, gong paling besar dan paling keras.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "78ed9d3b2bba098c1d2868fbccaec34d9f0c1d61a9a6e0fc4666cd1ad63e8a6b",
      "text": "Ni Luh, gendang ini dari logam?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d2c2dc09bcfcff1784b951e188e631df905e28b1b633de810194abc2f7051c3",
      "text": "istimewa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f4f939bfb989810e53efe6c037efe6b62e4fc15fcdf1f2a7a276f8e70f88cb3",
      "text": "kayu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "83142ac6a59257ffe830abed895dc8e04a5672fe00b044dfe5a3522a33e79fc0",
      "text": "Terlalu mahal untuk saya.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "83266a54809d68e58a0eb277af9b3ab7943324fa6b41cd77059e6b155b41c245",
      "text": "Gamelan Bali lebih cepat daripada gamelan Jawa, ya?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "8445cea361cd34992fa0ebc712f8f41d96c39df336884b61d64de364f73ef7e4",
      "text": "Wah, sekarang terlalu keras!",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "882cd12924f4321ae7552148ceaedee74f40db2bfdb59afb4c9947e7280d56db",
      "text": "Suara biolanya terlalu pelan.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8933eccca122f099ef9d2bc949fcf52dc6cd4e0ff983d54e74cc91f1f89fbc2e",
      "text": "Cukup, terima kasih!",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "89375836ef9af5281e3773f70df9a4b1ab5bf01c66e7ffc869b266779a26bac4",
      "text": "unik",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf633cb941545afc734fbdc8b97a0989bf982e864803ca09062437789c46fb9",
      "text": "Suling lebih murah daripada gitar.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c1d1cace4c99a9ef1f17bacf27ec6f21f675983425209229d45bbe65ef4d0d7",
      "text": "Ini restoran terbaik di Ubud.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fc2c557c68ef8d82dfa085650e2db22e6c82071f72b3f5d95f9ab17cb7e4878",
      "text": "Hari ini hari yang istimewa untuk saya.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9085bfdddf3e01b968baf6898c705c5be5b2290c581f1860adb5fce65346ad06",
      "text": "Yang plastik lebih murah?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "911233b583f05a30d6dad3f882b1f05bf999967423056c3f16696077f2fc3cb5",
      "text": "tebal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "93dc8fa1446c9063a56f7285e2e8c0258efbf7b0e0dfd07f3900e1c3275c9bf2",
      "text": "dengan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "94d0bc9b2b86d04d70a738280e10a1b9e4cb503f82797c52ee9ca5dfeff2a85a",
      "text": "mewah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aa700a7b7fb9e887f00710f983b137834095db9d26104282547a640be562b83",
      "text": "Buku ini lebih tebal daripada buku itu.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b417a6ca74b89d36d2b45ce2f3a0a5ed665abd0d6f330a24b9015b99ab1235e",
      "text": "bambu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b8e95645f78fded6234957267ff38fd8c0fba92f9069959ecac73367477939f",
      "text": "Hotel itu mewah dan modern.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dff30e2bd0bceab91a65e79ef403174da6246e3b8006c337508f334bb8cfaef",
      "text": "Bagaimana suaranya? — Lumayan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4e01923794169bdde2c7718bab57caf57d43a48fc73e085ae0e086078840a78",
      "text": "Ini gamelan Bali. Musiknya tradisional.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a56409fca8c731f0652364d08cd2e49b4f544adb0a6a2308694e5a0595e237d9",
      "text": "Bagus! Saya mau menonton.",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85e67fb83ce29b11d6dcb6b71fd23b28d94ce35936c08a5d562cb6abd25d7ff",
      "text": "Pilihan yang bagus! Terima kasih, Pak.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8c730835beaf1547dcdd18a42187eb9dc6205797536b6bdd06cf216acf5075b",
      "text": "Berapa harganya?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a91f01b1459ed055acf07dd0572a18348cfb59119f241de07be8c26024c82cfa",
      "text": "lumayan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac84de5eaccaac055a4e5bb34b30929081d6352990cdf2b26f3947d9e7ebb5a0",
      "text": "Tokonya luas sekali!",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08c0fc05906f410b46e49b799b2d6e9bf3c13438fc607e8e4831fd0f5b7ec14",
      "text": "Itu gendang. Suaranya lebih keras daripada suling.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b117a5d0540fea181979df49f56e9e71afdbd7bcefe6b01d427ef26c41d50bb9",
      "text": "Gamelan Bali lebih cepat daripada musik Mesir, ya?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b227ab9eccb1f4d3a046eaedbd48cc70cd3a782ec04409af67ec9a08a168d2db",
      "text": "Suara gong lebih keras daripada suara suling.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2621fd2ae6cfa5fcb17eb0aec53d43a0180a42f43bde5c5ec589be60f83e2ac",
      "text": "Kopinya kurang manis.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5f480b0eb516f823347008f32f6fce68580a3c2556c5a0475cf746e4e7c505e",
      "text": "Harga termurah!",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b635c34efb3bd07c720b938599505c6560de0c6ca9b0dbf3235eea0c5f38cee6",
      "text": "berat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd13a8069eef39bdf8bd2186c26317831c180a99fc79e42e78f1697287ddc334",
      "text": "Wah, gongnya besar sekali! Berat, ya?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "be102df475bce47c63cc17df851d0a14715ba95b72e7e2052f61a4d7cc4f5db0",
      "text": "Ya, gong paling berat. Suling paling ringan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "c03d5a2bb58380068da3c02df14348fa449e76190525c830522a9e0d57b7daa8",
      "text": "Mana yang lebih berat, gendang atau suling?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c04d21aba3d1c1b9fd44f11c622e7d1700d201b277c88420d8033aa385b71cb6",
      "text": "dunia",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0a5f4467abedc3e57ca0cb725d125f5abf2e9438bfb60ed5fa1c5f92f9e53ee",
      "text": "asli",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6f5aaf3e0e015e083860e90b13fd2c2f92584cb357a144b6f07c6ec892398a2",
      "text": "Nasi gorengnya enak sekali!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8944bd9e3ac5284d56bc0cac95606553da5da8681a61178f841fa690bcd2576",
      "text": "Betul! Malam ini ada gamelan di pura. Mau menonton?",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca750c539cc1c89a592b5215028e78e16c881118760b34d0ca45e1d4b2dadb69",
      "text": "Lumayan! Tapi agak pelan.",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd2edd1840cde52df1860ddc3ca4fd653ca7bc0ae695e94fb1a80b393490f01c",
      "text": "pelan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1f39b2a3af59ce7bb84b78db19394d68d9dc457f6dcda8ac0ae78374c64cab9",
      "text": "Kalau sekarang?",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "dba19e07f7bfbd435b3574e68b172d89b640a822c92ab3f0ed082035c78cd422",
      "text": "Gong ini antik?",
      "voice": "id_ardi",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd6a0315794bdbd8dcc126f34dd1f28a7924e9b87c5dcadca60417f2603f918c",
      "text": "terbaik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ddfa0feef545d7e0579e6572c9372fbb014bfc81aae198b82de58c84a9be1a01",
      "text": "Kain ini kasar, tidak lembut.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "de67f7cb71b59b0f641220c4d5ed2a187796934f255279be9edb32f720962b38",
      "text": "Kursi kakek dari tahun 1900. Kursi itu ___.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "df16bce50335a5085b62219541d0c539512f28d79a86db0576e20fbe71ac6dc2",
      "text": "Biola ini cukup tua, tapi suaranya masih bagus.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "dfd562bc6a087266429a87a43f33b3d6f155bc0f4c4ce1b6151dc0d95e01cf03",
      "text": "Bukan, gendang dari kayu. Gong dari logam.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e020d2dd7db7f0896c7c07d5cfd1e6ed45fdd699fe16e03a21313536b76da684",
      "text": "garam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e360a8ff83a4a908d11fef267a2000adb706a37eb24104b3fc3e5a94a7c029b3",
      "text": "keras",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4efcd75a2f607698c4eb65bff83b4a06c0e60903a7bca918ab1ee62ab3fa5f1",
      "text": "Lebih murah, tapi suaranya kurang bagus.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e94df3586bde74c73987e4bee8c743a7611b1c580b6a7018c11912f254d5cb18",
      "text": "Suling ini dari plastik, bukan dari bambu.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed14014d0bf0a97190ca40cbc6ba95221978ba905006a2043caa6189b89951ff",
      "text": "lebih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed246bb445e6d9f4480f36bfa9666ebfccf13bd32e4c1b4d717dc8519e92a438",
      "text": "Pintunya sempit, tapi di dalam luas!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee772ec2a07498de6e0a959918986f75bfde91b0179999396444f3cd58e83fc4",
      "text": "antik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eeb1050845c81ac8c562b2f2c513022541a836ca27f554068f7d1502b9b65e6c",
      "text": "Gamelan Bali lebih cepat dan lebih keras daripada gamelan Jawa.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef07d5513324f4fb9240bbb89129c3ef7da7869f63d402e5004834251c874513",
      "text": "Pintu itu dari besi, jadi berat.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "efb492bc20ab2e326ac8085f064359acf288a9016a1d95e4e367b645bfab6535",
      "text": "Bagaimana suara biola saya?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "efec5af38f606f2e1f8e5e14258f83097ed40a5c79025cdc95f2b5ded35b2122",
      "text": "Gong paling besar dan paling berat. Suling dari bambu dan paling ringan.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "f198b9b7d1134eb64df5495f21a2fcf40a61276eac9337a2eb9831ce338df3fc",
      "text": "kasar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2b4a10d1b8967ffc4967fee29b0807bb981a5b52efbb44b0e6e6fcbf5b4ee11",
      "text": "Pilihannya banyak sekali!",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "f32434bbffcc13a4be353c0a34ecae10f89e8fbc76324dff9168a9ac0c90de76",
      "text": "paling",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6941ecd474ee37aeaa40437294694ac0f0ef2b874eb663c167cade7e8d03506",
      "text": "tradisional",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7c92f7ce27b4bd233e4202efdda79d3be9e507fc2745204dcc2ec268ec76e71",
      "text": "cepat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f97b85107702dfe54fc54b21df0fbb370a8740ec7b9593322aa2b4bd04dac0cb",
      "text": "Selamat datang di Ubud! Ini pura paling tua di desa ini.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "facd9ecefc6b5e26195f2d41d7b11efc018cdd5eb51885702b41a35674ef0d7f",
      "text": "Mana yang paling enak?",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd4e303dd287bcd1e77437893f99b4947a96ea1830649d91ad3446cd25bb9825",
      "text": "Pintu itu dari ___, jadi berat sekali.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff12903fd4f43843db6f7484591c2ab44861832bcdf8e19bddd7c6bfe734f96e",
      "text": "Mana yang paling ringan?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff16e777ce163ebeed6c06bb6222e71b5d79b432deb75e4fa0bb21ac55981df2",
      "text": "Indah sekali! Tapi gongnya agak keras.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 8,
