{
  "format": 1,
  "id": "id/bipa2.u01",
  "language": "id",
  "unit": "bipa2.u01",
  "version": 4,
  "content_hash": "575feee2e9c90232a3d45aa8ff960b896b382038679c431b9183aa39e5dac096",
  "lessons": [
    {
      "id": "bipa2.u01.l01",
      "sha256": "cf19032ba252b98f7072afbcbae8232e839527e1cde02c4d48ebb550651b6311"
    },
    {
      "id": "bipa2.u01.l02",
      "sha256": "b72af6a2f0613f21b00acaa52eebbd70fa5ac75b9413355e9c37bb869199d9e0"
    },
    {
      "id": "bipa2.u01.l03",
      "sha256": "a94bb6fd139fb8442088c1b486e5944fe977f682841f8643677c72116cb70419"
    },
    {
      "id": "bipa2.u01.l04",
      "sha256": "3b2cc3edb8573f6404b2808a7263946a43af2583f460a0e346ccce643b5ead0f"
    },
    {
      "id": "bipa2.u01.l05",
      "sha256": "65abc4247112e167fc54aefaed80c0932bd3d7a0c251977ba8cf63434d39a2a6"
    }
  ],
  "audio": [
    {
      "key": "01b4a601d0e94735d94c244eabaabe1c54eaa853a6d7531f2d84f43dbfdadd7e",
      "text": "Sayurnya kurang garam.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "037a56f6afd04be7a4a642ea4eaaa9453fa6d22394e5464b63fe69b674c8ad05",
      "text": "kuat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "03aa6ea8d040941b6361c79179fbea60c76cbd4cb17509685fc08959583676c8",
      "text": "terlalu",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0551c64a2b1775e19bcec910a251fdeb607645c261d7219e5e90a62926133adb",
      "text": "suara",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "05a4e55ceeb41d9b738e97063f3dea1cab82eebee867e6bc2577f6c3ce73f0a8",
      "text": "gendang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "065e33234d4fed3e3d45e714c2825052ba1b593b489f8c74c36b8eb91d5033d4",
      "text": "Suling ini agak kecil, tapi lebih murah daripada biola.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "06bbfde8b3fd32e42ab3c699768ef4ff262fad683eea23ce85442259a10b5adc",
      "text": "Gamelan Bali terkenal di dunia.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0aefc199982592e6d081ccf839cb13f7af14c758483f2c65af196e2a882d219f",
      "text": "Ada. Yang ini seratus lima puluh ribu. Agak kecil, tapi suaranya lumayan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d0956577015474540da5fff1489690f8d0bc2893a0c46fe95d20e043bbe52cc",
      "text": "pura",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e5618983109156ef3b1ca8b94ac716f678739489f64668257c1a8275446f1b0",
      "text": "cukup",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fc9d12c3b5adbced09e73e80c8c5d278a8ad741d6611d52b15c2a0ad1e9d5aa",
      "text": "Gitar ini paling murah dari semua.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "15228e6832e0bc130c74ccee0722f23f78766a2d8846217dae88e3de60f72bd7",
      "text": "Gong lebih besar daripada gendang.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "16a01af1eaf16e6a2d9710ba5462bccf40fdf715749fbc797f4a3e84edb88b94",
      "text": "Suaranya terlalu keras.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "17a2f4064c17dfd3247307fea481ccf507ed1dd540cfe35e9ebfd34cd3adb5ef",
      "text": "Suling lebih ringan daripada gendang.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "17f6aace103ebb3c3406e30e8b0deef169ccf45542e971205bed644363c38d93",
      "text": "Bagaimana gamelannya, Mohamed?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "19e203f8a7ace02e7a65bf870c7b13798c42e48c970f74f6c5d85176b96d0172",
      "text": "Mungkin! Tapi musik Mesir juga terkenal di dunia.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b28fe94e35ff502a66056c9b1f82283e2ccb60250d0cbe359acf00abe6cdfea",
      "text": "daripada",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba1b3ea552469e5a6a5e3b8f63432067c880ea12142b9ba82b588567d9f5741",
      "text": "suling",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "257930dd5c341dbe75f04202e7ec9ee47a6c2f4e493b582ac16f52f1a3dc2c14",
      "text": "Wah, terlalu mahal untuk saya. Ada yang lebih murah?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "3012c115c3c886ede6254290744eea58e1b47fc82454dd62687786fa21acdaaf",
      "text": "Kalau begitu, lebih baik saya belajar suling dulu.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "32aa1411b5fef1aa0bbbdcafb54fac0d0d832aa831f65d13244549f99e39e1c4",
      "text": "Betul! Gamelan Bali lebih cepat daripada gamelan Jawa.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3358503cbbc879fdc1dfb535e10fa0f90af3966c0ee8519bee469edeed4ef5bb",
      "text": "Harganya cukup mahal, tapi suaranya indah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "33c035ad07760f6b17552eace62c95814e4d39d654d711a9c8fd81efe52495c3",
      "text": "Gamelan Bali paling cepat, ya?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3696867e6caef73340ef8df23dbf7f692689aa5b28d1c92f391b81c58a5f0578",
      "text": "Yang kecil lebih ringan. Saya beli yang ini saja.",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "370ed1dad6dfb39b6c3502de0285c1614ab2b1c907707ef0d74b160684a676c2",
      "text": "Indah sekali! Pura mana yang paling terkenal di Ubud?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "375e7f3e808e1ff5e8e8c0423f0677982744e4db6f0c0d56b5cce86c8658d2e4",
      "text": "Gamelan ini cukup mahal, tapi bagus.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "38278f026caa37d3244506cebaedab2f4b1b56d493a3305110d21a33005f2685",
      "text": "Tiga ratus ribu.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "3de05d075127b5cbc9a1949b9134667d10acf6313b4187841d3f911faa46bcbf",
      "text": "Gitar ini kurang bagus.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "435804578264214671b3add88236a40c87b6b4a39aa1ef5cfb73cb5ef191c300",
      "text": "Gong adalah alat musik paling besar dalam gamelan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "46d7255cce9795f904a0d45e01bdf43eec0883b47e7b03c3c3054e22ad1ec678",
      "text": "Bagus! Suling juga lebih murah.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c1d9d45d167cd0943a31babb460e324cc2b410e0333eaaf8c2d8c7cb87d691f",
      "text": "Rumah Ni Luh agak jauh.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c44b9a6d22715b652fc9052ac04fcf91a5b72be9911235c01b5650119322348",
      "text": "Ni Luh, ini alat musik apa?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc6c0f8c1ecf914d8d819626c5ed2497d279c38c21731d7c8c1c8c8e8ca1e8c",
      "text": "Mana yang lebih murah, ini atau itu?",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "52ced22dbbaa788791a8fb9eaf452a8e4f1b784c244db4fad35d6870c448d36e",
      "text": "Ada yang lebih murah?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c8a02a0bfe376b1509b4a85ed98f01ef987ae7d6bacdb76db783affa4c316cc",
      "text": "Pura Taman Saraswati. Di sana ada gamelan setiap malam.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "622076c8445ddcc6a768d2bcecff1405774b125d21959e78fd95808aa9150315",
      "text": "Wah, terlalu mahal untuk saya. Ada yang lebih murah?",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "65d3e751199f648e28053908f99252788e721bccc953ead383dd780a12c6d5df",
      "text": "Suling lebih ringan dari gendang.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "673f465d29c8258af0d82b67549afcf430377c9f2e3338c2c115bfe6c980b9b3",
      "text": "pilihan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "697d8c9186a3105dbee973be8109f8499efb4ed6d6418500b975edd973b306c4",
      "text": "biola",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6df3650fcdab6fc4b59242f9b5ebef3d3d95ceff76fcd4734972c7b44f11da64",
      "text": "ringan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e47d7ce09bfd2b14a5692d7d11b82326fa4d62de23424fa1d3d365ccaf0b142",
      "text": "Saya beli yang ini saja.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fdce3b35f5684fb2993b65d97f3a1f8a17953d92ddb0b38beb592bf0eeb82a3",
      "text": "Betul, suaranya indah sekali.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fe07dc276f68a8cb109c5b410430a831b77f4157cc578b27acec8ae70d21192",
      "text": "Gendang. Suling lebih kecil dan lebih ringan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "73552ccc5bec64898b0ffe94235cd9ce441f63653b778e82b3b014b7fce8f95b",
      "text": "Pura ini paling indah di Ubud.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "75b0bcbcfd0651d623d2f8241c93d9f23fb13164196a6832ff645d3479d734d9",
      "text": "Ya, gong paling besar dan paling keras.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "83142ac6a59257ffe830abed895dc8e04a5672fe00b044dfe5a3522a33e79fc0",
      "text": "Terlalu mahal untuk saya.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "8445cea361cd34992fa0ebc712f8f41d96c39df336884b61d64de364f73ef7e4",
      "text": "Wah, sekarang terlalu keras!",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "8933eccca122f099ef9d2bc949fcf52dc6cd4e0ff983d54e74cc91f1f89fbc2e",
      "text": "Cukup, terima kasih!",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf633cb941545afc734fbdc8b97a0989bf982e864803ca09062437789c46fb9",
      "text": "Suling lebih murah daripada gitar.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c1d1cace4c99a9ef1f17bacf27ec6f21f675983425209229d45bbe65ef4d0d7",
      "text": "Ini restoran terbaik di Ubud.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b417a6ca74b89d36d2b45ce2f3a0a5ed665abd0d6f330a24b9015b99ab1235e",
      "text": "bambu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dff30e2bd0bceab91a65e79ef403174da6246e3b8006c337508f334bb8cfaef",
      "text": "Bagaimana suaranya? — Lumayan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a85e67fb83ce29b11d6dcb6b71fd23b28d94ce35936c08a5d562cb6abd25d7ff",
      "text": "Pilihan yang bagus! Terima kasih, Pak.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8c730835beaf1547dcdd18a42187eb9dc6205797536b6bdd06cf216acf5075b",
      "text": "Berapa harganya?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "a91f01b1459ed055acf07dd0572a18348cfb59119f241de07be8c26024c82cfa",
      "text": "lumayan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b08c0fc05906f410b46e49b799b2d6e9bf3c13438fc607e8e4831fd0f5b7ec14",
      "text": "Itu gendang. Suaranya lebih keras daripada suling.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b117a5d0540fea181979df49f56e9e71afdbd7bcefe6b01d427ef26c41d50bb9",
      "text": "Gamelan Bali lebih cepat daripada musik Mesir, ya?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "b227ab9eccb1f4d3a046eaedbd48cc70cd3a782ec04409af67ec9a08a168d2db",
      "text": "Suara gong lebih keras daripada suara suling.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2621fd2ae6cfa5fcb17eb0aec53d43a0180a42f43bde5c5ec589be60f83e2ac",
      "text": "Kopinya kurang manis.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5f480b0eb516f823347008f32f6fce68580a3c2556c5a0475cf746e4e7c505e",
      "text": "Harga termurah!",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b635c34efb3bd07c720b938599505c6560de0c6ca9b0dbf3235eea0c5f38cee6",
      "text": "berat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c03d5a2bb58380068da3c02df14348fa449e76190525c830522a9e0d57b7daa8",
      "text": "Mana yang lebih berat, gendang atau suling?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c04d21aba3d1c1b9fd44f11c622e7d1700d201b277c88420d8033aa385b71cb6",
      "text": "dunia",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6f5aaf3e0e015e083860e90b13fd2c2f92584cb357a144b6f07c6ec892398a2",
      "text": "Nasi gorengnya enak sekali!",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca750c539cc1c89a592b5215028e78e16c881118760b34d0ca45e1d4b2dadb69",
      "text": "Lumayan! Tapi agak pelan.",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd2edd1840cde52df1860ddc3ca4fd653ca7bc0ae695e94fb1a80b393490f01c",
      "text": "pelan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1f39b2a3af59ce7bb84b78db19394d68d9dc457f6dcda8ac0ae78374c64cab9",
      "text": "Kalau sekarang?",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd6a0315794bdbd8dcc126f34dd1f28a7924e9b87c5dcadca60417f2603f918c",
      "text": "terbaik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "df16bce50335a5085b62219541d0c539512f28d79a86db0576e20fbe71ac6dc2",
      "text": "Biola ini cukup tua, tapi suaranya masih bagus.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e020d2dd7db7f0896c7c07d5cfd1e6ed45fdd699fe16e03a21313536b76da684",
      "text": "garam",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e360a8ff83a4a908d11fef267a2000adb706a37eb24104b3fc3e5a94a7c029b3",
      "text": "keras",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed14014d0bf0a97190ca40cbc6ba95221978ba905006a2043caa6189b89951ff",
      "text": "lebih",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "efb492bc20ab2e326ac8085f064359acf288a9016a1d95e4e367b645bfab6535",
      "text": "Bagaimana suara biola saya?",
      "voice": "id_gadis",
      "chars": 27,
