{
  "format": 1,
  "id": "id/bipa1.u10",
  "language": "id",
  "unit": "bipa1.u10",
  "version": 2,
  "content_hash": "e80e91434ce39a40e0f1a84880eece0f7809cebf14a15c8959360c44ab024789",
  "lessons": [
    {
      "id": "bipa1.u10.l01",
      "sha256": "47901e55fd40e0de83327b87435539b0d5d96bda7e8bdb06e2716bfc6f6f82f7"
    },
    {
      "id": "bipa1.u10.l02",
      "sha256": "4bbb1e62846dbfd002c8d1a91461fd9c1f4587a6445cb2fefda3cc0024231870"
    },
    {
      "id": "bipa1.u10.l03",
      "sha256": "d33839bfc42c43f963cfdf49c4fd68122a7caa95ebc7ab4eb02f0881007cde82"
    },
    {
      "id": "bipa1.u10.l04",
      "sha256": "711b555fe5b9bc1f0ac3ec9030c7a7d52e572c49859902c2f9243c65dc8b7a8f"
    },
    {
      "id": "bipa1.u10.l05",
      "sha256": "7a2cd1a7fd8057f17e9cad679ad399d28ec7b73ae57af0e4863c7400258eab2e"
    }
  ],
  "audio": [
    {
      "key": "0275b3cb4699228f266d18dd68a967850d31b632ed2cf95e04a2372e7229b24e",
      "text": "kalimat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "04bdca945a11d5e6dd90113717b5b0dbaf157327adeb4afb116292e49cce4e04",
      "text": "pernah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "07e1ef3e8ad5642275676601224e21e3e981b4d44582d6037c76dda2e74356e5",
      "text": "Rina memotret laut di pantai.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c2a4118ff5ebd053af34c1e13c44ffada2c4f3e822478e6ac671394856670a1",
      "text": "Kamu pernah mencoba snorkeling?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e3aea69a73f5b011c6e61207efc3233af34360f7d2b71a2742ce931a2118ab2",
      "text": "Setelah itu, kami berenang di laut. Ikannya banyak sekali!",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ee1fd39df47293a1b0efb9c5997db8c5abc60c5958048f30319da4e057105d1",
      "text": "laut",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1079d2c4be3036852d9320993a6b2167a3d7c4a87485c22f7839bf8a350d5556",
      "text": "Saya membeli tiket di pelabuhan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1118fc527253a3d022c079afd1b395c483b082d467506e3f90599f4e9ed6d8ae",
      "text": "Di pantai, Rina memotret laut.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b19d968a4ef60e5d5de849c3b70e5db3f3eccbca874e8e31b20c0a9bc57558",
      "text": "Wah, bagus! Kamu berenang?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "16cf4a54e4b2ce19e21f1c246468245fb7f373407797d09d869b610823b6b96e",
      "text": "Ini pertama kali saya ke Kepulauan Seribu.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "18710d4cc4187345e36b25d9f804414588f16f4e620d3980bc20a4f756330c9d",
      "text": "Dimas membeli tiket di pelabuhan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "1be750485f96319cfb52d7f8d1c47e018fea6f18cbaa2613d1e6a83233c5959b",
      "text": "Belum pernah, Mas. Ini pertama kali.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ce59df801456367668fc5f4a04dea8b0716e45e4bd2be6033f3885f66c43979",
      "text": "Lautnya bagus sekali, Bu. Bu Sari harus mencoba!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "252ca1d208a6abcf142c71eded61a6b144c1573cd481cdcf719afeef3d57654b",
      "text": "pertama kali",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "271b975d18295d3e45b30d9dfba81580b8a2ec70ce6ce8b8b04d48091b1f7dcd",
      "text": "Wah, saya tidak pernah berenang di laut!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b1ac5e9b99a76c9fdda166132a315982d4a2aabe96b454368b5457fcae4e670",
      "text": "cerita",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d694368ed55983f42d5f3da8e4b005ae5ce5dc4cbc2afe3506747dd8c81e25d",
      "text": "kapal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d86956ca9794e25c4a44fbdeba3cc866a023c3dc2369a706b448db45725c730",
      "text": "subjek",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dc2d9057a5afadef8a7454a6566cd1b00d7093bf35d70d2f9916f7c30cb9bc4",
      "text": "mencoba",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e0b7b831e604ab740b6fc1e14695e4ed8c2cefd6e84d134779f66cfaf211c00",
      "text": "tahun lalu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "346855bec6a8467137b72b25d22ccdcd750a12e017156e0ccc2539039fa88eb0",
      "text": "Kami makan ikan bakar. Setelah itu, kami berenang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a8edac49587c60c4dab023f19b683629c0d256c596b5daddfa42a3891e72a59",
      "text": "objek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b5c342beab473756ebb882bda52534b590ffebddeda8e834fe2d20c3e5e1928",
      "text": "Tadi pagi saya bangun jam lima. Lalu saya naik kapal dari Marina Ancol.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "42cf5c5e3d21783668c9879ca6e07d68a0926d6faa781afbd907e9137c4cc7c0",
      "text": "Kemarin kami naik kapal ke Pulau Seribu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc3375ab48d6de0ddb04e4ff39084fb541e11ef7f1b9787558d3083b215aee0",
      "text": "Tahun lalu saya di Kairo. Sekarang saya di Jakarta.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "55f5f58ebec7b3b3ece8c588d955a692953432939661070081e12fb93e4e044f",
      "text": "Mohamed, kamu pernah ke Kepulauan Seribu?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5697714d8d299a8e9d13c659a4ff88227b11d9ea8a0f1348181e4b043ac75b29",
      "text": "senang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "57175e14b5ebcaa32bb9874c945530fbe27ccf37df3d98179dccefc9c49a0d16",
      "text": "Tadi pagi saya naik kapal. Setelah itu, saya berenang. Saya capek, tapi senang.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "5765310e8c4e8a32bceb6a23ea32618805dee6bfba807a56e5b30d3b887a7ac6",
      "text": "Ini pertama kali saya ke pulau.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "59ba8b8b7e2c97b8ef2bca72825f39153e6f46d605bdec74263e5d7c644e4862",
      "text": "durian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "63e05163c89cdfe7224bc01919aef2022f2c11ac28b6670ab9d7c6b0036d0a92",
      "text": "minggu lalu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "684baada5ee146ab883eaa325bd80e285c0bc287a741b66b05951a1e1cb15242",
      "text": "predikat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b2854625d5c69aa183a33fa0f4bb96cfefb3c03883c3e4133ce177afdcf4244",
      "text": "snorkeling",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c3f7e196e0eff7270112d2028292ef50d026cdbdf1cf4de3f082f9a7fcb8eaf",
      "text": "Dia tidak pernah makan pedas.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c898fba6c8fdf6841466573742c96292a1c18f6adb1008a6e00dbc01857c412",
      "text": "pelabuhan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dc1a3804345dd044a2d40b752677b4c8d88b05b7824c6d367b8865534757a41",
      "text": "Ibu memasak nasi di dapur setiap pagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e2092eb5628da779e9b1c01ea220c4fead14f016b3eed2a50b8c941722d9188",
      "text": "Ikannya banyak sekali!",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "74bb5cdfc170627dc7863667f9ee41c31d687172884240f5084b92662555219e",
      "text": "Pernah! Di Laut Merah, di Mesir. Ikannya cantik sekali.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "778c35402dad4f0f58bee0cc4d703e6ac964202c5386c075f801217112ca9c74",
      "text": "Setelah itu, kami makan ikan bakar.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "779a8f3b9d283dd41cc687abc31ac111d18c27482338f2317cd8fa39c1c51928",
      "text": "Saya pernah belajar di Al-Azhar.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7cb1b9e9327acc864caffe711153c479782e070c642cee3dcf754f1ece6b3cd7",
      "text": "Mohamed, bagaimana hari ini? Coba cerita!",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ddd7416ce75944a80f428fb70926e4567f8947973f12f09540f8e90a4d4cbb4",
      "text": "Wah, seru sekali!",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "80240def7d40c04f80805de6b99a950f72f1011fa69cb4bde705bcff3566b2c1",
      "text": "buat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "85a58897dab76e3dc655c94ad6ab3742f58093af4e3f5031b5ac28ef60c68081",
      "text": "Ya. Setelah makan siang, kami berenang di laut.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "8826d60eecd84e1abb864614793476b45260313554e329df80139b543e217f61",
      "text": "Wah! Saya belum pernah ke Mesir. Saya mau ke sana!",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "94336997460e60bbb850de768cf6e1ed4eac38623bf913325764bf3bc3a612a9",
      "text": "Hampir betul! Objek setelah predikat.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "95bb23fa3fa2fb48391dbc47720e89fd72c24787023890261985c9e1f5130b6e",
      "text": "Kemarin saya ke Kepulauan Seribu. Saya belum pernah naik kapal, jadi ini pertama kali. Saya capek, tapi senang!",
      "voice": "id_gadis",
      "chars": 111,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d1f35edb0400b470e43deb0f8c5cd9469a28c8e2ca56c3134770198af4a865e",
      "text": "Kemarin saya naik kapal ke Pulau Seribu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d652c2e44736445dda0b62e7311ddd2a0bbc56a834821e17ad2e68306eeff73",
      "text": "Kemarin saya membeli tiket di pelabuhan.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ff99a7cf72583b0e214a7e6122a977246a61ca5a61f067b1a13a22a0c2eca54",
      "text": "Selamat pagi, Mohamed! Kemarin kamu ke mana?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0012923d935728355f97ba4668c68387f9d9e4751dbd41f98183b9b57c00f3c",
      "text": "Mohamed, kemarin kamu ke mana?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a05714d1ad2b57a703c3c304fc6f79d708233865756f079a8274c83062616b0a",
      "text": "Saya belum pernah naik kapal.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "a32b0544b1775a00d6cc6386585d69d89ead4d166f817592dc7ad0c8cbc093a2",
      "text": "Tadi pagi saya bangun jam lima. Lalu saya naik kapal.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a95977d554b77cc2857a1744a5d85724c43a84c91458c2f671381d795d3422a5",
      "text": "ikan bakar",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab821014cc3422b34d789e985e6b9e163959a5bf76b28372e189b93daf3ce119",
      "text": "Kami naik kapal dari Marina Ancol.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1db0d12e1ed6f852472f54f96649ecd29115c0a3e65da3b033c7e559e1cc105",
      "text": "bulan lalu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3742aaf66042d5c34b7f52c92e8db0cd37a20bb9288eef5e998fb61a07d6ff3",
      "text": "Kemarin saya ke Pulau Pramuka, Bu. Saya naik kapal dari Marina Ancol.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "b590e1ec107cdeda92397bca00ca1c6df5dd71e717a6d8ac8542fdd9117d486b",
      "text": "Kamu pernah ke Mesir?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "bade83ed39c5f0478d5efa27620cad9d38e0a500db3a717d1e6d2a3a1a541401",
      "text": "Kemarin saya naik kapal. Setelah itu, saya berenang di laut.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb06364576c149e5c05f63ab92e9341d5d217e85b7c2a37db86278585426f4af",
      "text": "Belum pernah, tapi saya mau mencoba!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf133c6626d4155376fee023a5417fa86e251c5418321b6471b716d78660449f",
      "text": "Setelah sampai di pulau, kami makan ikan bakar.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1188376f3dec61814bd3bd31012e8c4b44d4169f60fb257430e60b942aedeb7",
      "text": "Mohamed, coba buat kalimat tentang kemarin.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5457b522fd4c6aaf7078582e932100e7e83d68770a43295e28d484520431312",
      "text": "Wah! Kamu pernah ke sana?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca366fee79a96380976c644a9b32747f9a8d4709e68bcf846acc1a185ae18add",
      "text": "belum pernah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb9b19095f8edfdef1521cca3769405fbd3530d4c2c43daf578e82eeb95a1633",
      "text": "Kami naik kapal kemarin.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd205a189caa54511f43377e1c0ba3c0afeaefa1f78b00422b62e2b5247d73f7",
      "text": "Sekarang kamu capek, ya?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdbacf781e37987b2aba7bf54476b9c976daeb8645db55567de9876534e3a5e3",
      "text": "Sedikit, Pak. Tadi pagi saya bangun jam sembilan!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d29be9ad376e359235e05c060117b060731ab15ead2a5978c4964a586fc4d863",
      "text": "Betul sekali! Kalimatmu bagus.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d31daa2b3b55ff0f599db310d4686f6bd4de06ba36b0342191bc749c1964d387",
      "text": "Kamu pernah makan durian?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d789a4c480382cb80eca23ea0015ed4e21192fb4bae5a1f9f0ebd7ed20233919",
      "text": "kemarin dulu",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd5a6958213988a6ad96c6683acaa8a0eba0aa8e6548ce019d4c42d8b7a22d2c",
      "text": "Setelah salat Jumat, kami makan siang.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "dee6c458fc8a14bd2ad2e3f35f18c00eafd7999f4aa9cbc465f652db5634a704",
      "text": "Kemarin saya membeli tiket di pelabuhan.",
      "voice": "id_gadis",
      "chars": 40,
