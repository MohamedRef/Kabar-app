      "id": "bipa1.u10.l06",
      "sha256": "83fb8e48a53da8df7954df414212147df325d287d814660591cf5c65f025cbdd"
    },
    {
      "id": "bipa1.u10.l07",
      "sha256": "cf7c285b6d0b6c5fd0bec68dea9b59f590ead7f0abc7f2324b140ed8184960ca"
    }
  ],
  "audio": [
    {
      "key": "00a6542f5e42e6592d4b45367cef6c53a7dc9bc49aa97ab02f6b346ff12fec4a",
      "text": "nyata",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "015b54f261a1a722144d044fb4ed0513bf212ff78db92ee57d49b13646df83c0",
      "text": "bangga",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0275b3cb4699228f266d18dd68a967850d31b632ed2cf95e04a2372e7229b24e",
      "text": "kalimat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "04bdca945a11d5e6dd90113717b5b0dbaf157327adeb4afb116292e49cce4e04",
      "text": "pernah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "07e1ef3e8ad5642275676601224e21e3e981b4d44582d6037c76dda2e74356e5",
      "text": "Rina memotret laut di pantai.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "084feffbd3bdaba012323437b768357f44f69d3c0a6c594cbc34ffac58a01ec8",
      "text": "cita-cita",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c2a2469b624759a70978581dad30f597485fff5439b2021aaea97dd0e4dc23a",
      "text": "Lautnya bagus banget, Bu. Bu Yanti harus mencoba!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c2a4118ff5ebd053af34c1e13c44ffada2c4f3e822478e6ac671394856670a1",
      "text": "Kamu pernah mencoba snorkeling?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e0fc200e1caee5397f2ba4a24d9624204f81792c7c6fa8429e8a63780fc7c06",
      "text": "mimpi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ee1fd39df47293a1b0efb9c5997db8c5abc60c5958048f30319da4e057105d1",
      "text": "laut",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1079d2c4be3036852d9320993a6b2167a3d7c4a87485c22f7839bf8a350d5556",
      "text": "Saya membeli tiket di pelabuhan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "1118fc527253a3d022c079afd1b395c483b082d467506e3f90599f4e9ed6d8ae",
      "text": "Di pantai, Rina memotret laut.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "15b19d968a4ef60e5d5de849c3b70e5db3f3eccbca874e8e31b20c0a9bc57558",
      "text": "Wah, bagus! Kamu berenang?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "16cf4a54e4b2ce19e21f1c246468245fb7f373407797d09d869b610823b6b96e",
      "text": "Ini pertama kali saya ke Kepulauan Seribu.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b0b8e73cc886dd17e8c2e1b78383cf99990cd82e970741cffe58ca029d0b70d",
      "text": "Kemarin saya memotret kapal di pelabuhan.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "1be750485f96319cfb52d7f8d1c47e018fea6f18cbaa2613d1e6a83233c5959b",
      "text": "Belum pernah, Mas. Ini pertama kali.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f9e4417599334791b1cb22b45876e561403bbde386b8545f666bf83be9cc356",
      "text": "Saya yakin kamu sukses!",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "20b895bd4ed2d242f4308f1fd06e5d723c020d5f974988c48f923d9e78547cfa",
      "text": "Kapal kita tiba jam berapa?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2412abf1c6b99eec848f7d848c02db1032c6e670e8be02f135db5ded1aa3730b",
      "text": "Foto ini kenangan liburan saya.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "252ca1d208a6abcf142c71eded61a6b144c1573cd481cdcf719afeef3d57654b",
      "text": "pertama kali",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a90c9d6cd1d558ad8fa09afb54576e4cc04579c342ce6b9193d06962d50876e",
      "text": "Kemarin dulu saya ke pulau.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b1ac5e9b99a76c9fdda166132a315982d4a2aabe96b454368b5457fcae4e670",
      "text": "cerita",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d694368ed55983f42d5f3da8e4b005ae5ce5dc4cbc2afe3506747dd8c81e25d",
      "text": "kapal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d86956ca9794e25c4a44fbdeba3cc866a023c3dc2369a706b448db45725c730",
      "text": "subjek",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dc2d9057a5afadef8a7454a6566cd1b00d7093bf35d70d2f9916f7c30cb9bc4",
      "text": "mencoba",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e0b7b831e604ab740b6fc1e14695e4ed8c2cefd6e84d134779f66cfaf211c00",
      "text": "tahun lalu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f9d8c7d8f472c1ffc5685ffc3885a2fecbe3b213926c2047fd28b69da27a0e3",
      "text": "berharap",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fdd7b20b8ae4b109f743d184762b3a070654e72f5555b2d33975b4e3a0a9144",
      "text": "Berani! Ini pertama kali aku snorkeling.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3349fb87986d95b7c8e913aec4f6f9a9d4b7d5491e6d2840c43bf4d245851b2e",
      "text": "Ikan bakarnya enak sekali!",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "346855bec6a8467137b72b25d22ccdcd750a12e017156e0ccc2539039fa88eb0",
      "text": "Kami makan ikan bakar. Setelah itu, kami berenang.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "38554c63e7c9ff53d5e7af1d8d636f7f5bd1991d2c7e36b1b742cb581773279e",
      "text": "Dia bukan anak-anak lagi. Dia sudah ___.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a8edac49587c60c4dab023f19b683629c0d256c596b5daddfa42a3891e72a59",
      "text": "objek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "419a18b4ce8d3bc84f8b3656a41de9588f935224b641ecfa39c898d8b9322a0b",
      "text": "gagal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "42cf5c5e3d21783668c9879ca6e07d68a0926d6faa781afbd907e9137c4cc7c0",
      "text": "Kemarin kami naik kapal ke Pulau Seribu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "44631f1951679e1b4083570626ef14e2aa2447aa34fcc0191c9e94d7f9f804df",
      "text": "Rina memotret laut.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "459e8c24009ffea9d4337bd1e222de303b28f57436994fb6341e5c0ed4bf03e5",
      "text": "Saya memotret kapal di pelabuhan.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "486017873f1cc0258f530c2b157495baa0d29565e1dce72f347e0b91365972aa",
      "text": "Ini mimpi atau nyata?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "4862fe05c9d2db8a6803b9739ae06b22c4be7a1ea0e6e2e09f45e9064cf56e61",
      "text": "Wah! Aku belum pernah ke Mesir. Aku mau ke sana!",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "48ee8d76937bb91b1971d566ec894c164d9aa8cf7f2a50470e144467b92267a9",
      "text": "Jam sepuluh. Setelah itu kita snorkeling! Kamu berani?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b43946955e6d990d15c3c31ae0f6df2de7e59cbf4936e6a244df769636d235c",
      "text": "Tidak apa-apa gagal. Coba lagi!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc3375ab48d6de0ddb04e4ff39084fb541e11ef7f1b9787558d3083b215aee0",
      "text": "Tahun lalu saya di Kairo. Sekarang saya di Jakarta.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f082aedca6c5d261b9ac5c3909535c5ae84f033ab759f5a2a159281cafa8ba4",
      "text": "Raka membeli tiket di pelabuhan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "5096c3575e47d31271dfbcb1db5cc69f5395f95386306847418cf02d5bf10fbc",
      "text": "Ini cerita saya. Tadi pagi saya naik kapal. Setelah itu, saya berenang. Saya capek, tapi senang.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "55f5f58ebec7b3b3ece8c588d955a692953432939661070081e12fb93e4e044f",
      "text": "Mohamed, kamu pernah ke Kepulauan Seribu?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5697714d8d299a8e9d13c659a4ff88227b11d9ea8a0f1348181e4b043ac75b29",
      "text": "senang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "5765310e8c4e8a32bceb6a23ea32618805dee6bfba807a56e5b30d3b887a7ac6",
      "text": "Ini pertama kali saya ke pulau.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "5937f4c7a731e004f5572e27a258cf3043d92046a98908978c8571de589c2e57",
      "text": "Wah, seru banget!",
      "voice": "id_ardi",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "59ba8b8b7e2c97b8ef2bca72825f39153e6f46d605bdec74263e5d7c644e4862",
      "text": "durian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "63e05163c89cdfe7224bc01919aef2022f2c11ac28b6670ab9d7c6b0036d0a92",
      "text": "minggu lalu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "655673a6e2824cf69ecf5a0c364292ee5efdd46b63c2aba642029e2b9b03a063",
      "text": "ide",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "684baada5ee146ab883eaa325bd80e285c0bc287a741b66b05951a1e1cb15242",
      "text": "predikat",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b2854625d5c69aa183a33fa0f4bb96cfefb3c03883c3e4133ce177afdcf4244",
      "text": "snorkeling",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c3f7e196e0eff7270112d2028292ef50d026cdbdf1cf4de3f082f9a7fcb8eaf",
      "text": "Dia tidak pernah makan pedas.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c898fba6c8fdf6841466573742c96292a1c18f6adb1008a6e00dbc01857c412",
      "text": "pelabuhan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dc1a3804345dd044a2d40b752677b4c8d88b05b7824c6d367b8865534757a41",
      "text": "Ibu memasak nasi di dapur setiap pagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e414f1fc419525655c00565f3dcfdc7d5ad14872885f3481005a4124d9416fa",
      "text": "Kapal kami tiba di pelabuhan jam tujuh pagi.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ed3f8f8f3f1a699e82dd6c9fde9f5435ff26f92b0a86309a871a0b51aa30acf",
      "text": "Ide bagus: kita memotret ikan di laut!",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f0dfd56949e06a4f7741ff673ef4cb912093f80bf11e9ab802874f2fa6ffed8",
      "text": "Setelah itu, kami berenang di laut. Ikannya banyak banget!",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "74be09fc337ff11fb662d76031b8464cbb321b22e16a8fdb3a0d6880fcbd2948",
      "text": "kenangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "778c35402dad4f0f58bee0cc4d703e6ac964202c5386c075f801217112ca9c74",
      "text": "Setelah itu, kami makan ikan bakar.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "779a8f3b9d283dd41cc687abc31ac111d18c27482338f2317cd8fa39c1c51928",
      "text": "Saya pernah belajar di Al-Azhar.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "795e1e4e69b44be3705222e6df4fbbd663c2130dba0bf700af8c6be2b5a40c6f",
      "text": "Mohamed, coba buat kalimat. Kemarin kamu beli apa?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "80240def7d40c04f80805de6b99a950f72f1011fa69cb4bde705bcff3566b2c1",
      "text": "buat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "8068f288abf7817a0b547fb72cde6e5ea69b6fb9014172366af702c491a13091",
      "text": "Tadi pagi aku bangun jam lima. Lalu aku naik kapal dari Marina Ancol.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "84c8caf743ea0096ac8bf3eebd8d903fee65ea23e3f48d3ba9fd0d272650214f",
      "text": "Ya. Sekarang aku capek, tapi senang.",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "85a511801426b24e3e2949b962eecdfe0ea1d9b9021da178a29b64408c8538f9",
      "text": "Nyata! Kita beruntung. Ini kenangan yang indah.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "85a58897dab76e3dc655c94ad6ab3742f58093af4e3f5031b5ac28ef60c68081",
      "text": "Ya. Setelah makan siang, kami berenang di laut.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "86391d82f5441f9f8dccd0a09ed845e9e916262e41e811078d6495732c4cb64d",
      "text": "Wah, saya nggak pernah berenang di laut!",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "886d8a86deaa5a0626d2b886729724ac3aa689a01da5b63fee3001eebb9b08ad",
      "text": "Aku juga berdoa setiap hari.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "88f4298326562b65f4bd70698c9bb240e67d7a6f9632cd423d610ed3cc70c1b3",
      "text": "dewasa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8dbcd39458e16fc21512c1ac5c193ad377f68c299d918febef1fa015af229aff",
      "text": "Saya mau mencoba durian.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "94336997460e60bbb850de768cf6e1ed4eac38623bf913325764bf3bc3a612a9",
      "text": "Hampir betul! Objek setelah predikat.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "95bb23fa3fa2fb48391dbc47720e89fd72c24787023890261985c9e1f5130b6e",
      "text": "Kemarin saya ke Kepulauan Seribu. Saya belum pernah naik kapal, jadi ini pertama kali. Saya capek, tapi senang!",
      "voice": "id_gadis",
      "chars": 111,
      "mime": "audio/mpeg"
    },
    {
      "key": "965d23ceeba3d08af98716ff02efd35ee8fb0ae57208c5e39ce74cd36ddca96a",
      "text": "Sebelum ujian, saya berdoa.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "973e9eb7c48bbf3967723e591bf8e114d03a3c78e156fe8abda64ae6321607c9",
      "text": "Mohamed, apa cita-cita kamu?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d06a125f064a91d76371ca09e261252355ff9b9e9c7efdf0574ebfb8d95e24e",
      "text": "Nggak apa-apa. Aku bangga, kamu udah banyak belajar!",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d1f35edb0400b470e43deb0f8c5cd9469a28c8e2ca56c3134770198af4a865e",
      "text": "Kemarin saya naik kapal ke Pulau Seribu.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d652c2e44736445dda0b62e7311ddd2a0bbc56a834821e17ad2e68306eeff73",
      "text": "Kemarin saya membeli tiket di pelabuhan.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ff99a7cf72583b0e214a7e6122a977246a61ca5a61f067b1a13a22a0c2eca54",
      "text": "Selamat pagi, Mohamed! Kemarin kamu ke mana?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0012923d935728355f97ba4668c68387f9d9e4751dbd41f98183b9b57c00f3c",
      "text": "Mohamed, kemarin kamu ke mana?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a03952cd547db6b2d803e03d3ce9c371f2b99941345dd1eb83ad535eb2e70ecf",
      "text": "Cita-cita saya jadi dokter.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "a05714d1ad2b57a703c3c304fc6f79d708233865756f079a8274c83062616b0a",
      "text": "Saya belum pernah naik kapal.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "a32b0544b1775a00d6cc6386585d69d89ead4d166f817592dc7ad0c8cbc093a2",
      "text": "Tadi pagi saya bangun jam lima. Lalu saya naik kapal.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4f7ed54d65ab45f0f9a21b6760956904243c1076106de2723df51935f8f823c",
      "text": "Ini pertama kali saya snorkeling.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6b938251baa295bf7e8f724014c32a6b7bb38b704b3363e140a7d95772e8fe7",
      "text": "berdoa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a95977d554b77cc2857a1744a5d85724c43a84c91458c2f671381d795d3422a5",
      "text": "ikan bakar",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "aacf8ad56881b643b75fec3b1adbcad3b1d34b739345f405b9a7d2110871e84f",
      "text": "Tadi malam saya mimpi pergi ke Bali.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1db0d12e1ed6f852472f54f96649ecd29115c0a3e65da3b033c7e559e1cc105",
      "text": "bulan lalu",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3742aaf66042d5c34b7f52c92e8db0cd37a20bb9288eef5e998fb61a07d6ff3",
      "text": "Kemarin saya ke Pulau Pramuka, Bu. Saya naik kapal dari Marina Ancol.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "b590e1ec107cdeda92397bca00ca1c6df5dd71e717a6d8ac8542fdd9117d486b",
      "text": "Kamu pernah ke Mesir?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "b84d02ac0cea0a9ce469cdffe1fb146062049d5edf7a63622870ffe685488041",
      "text": "beruntung",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b87ab008d5ee02cd5f6595d7d3037d33d9cfa70d3c54825c658c11fd73eed04b",
      "text": "berani",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8ea6566dae66b406a97244be2c481eabe160b91f9c925e095deeaac316e0da2",
      "text": "tiba",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb06364576c149e5c05f63ab92e9341d5d217e85b7c2a37db86278585426f4af",
      "text": "Belum pernah, tapi saya mau mencoba!",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf133c6626d4155376fee023a5417fa86e251c5418321b6471b716d78660449f",
      "text": "Setelah sampai di pulau, kami makan ikan bakar.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c273675fd8c4952840cbaba2456a709ac3c6182425dc179c7ef48f0d9cbf38fe",
      "text": "Bulan lalu kami naik kapal ke pulau.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2d6318b67c45449c311231f7b68d71fa5a24c17a1ff43e79815a8732291fcad",
      "text": "Kemarin saya naik kapal ke pulau. Setelah itu, saya berenang di laut.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5457b522fd4c6aaf7078582e932100e7e83d68770a43295e28d484520431312",
      "text": "Wah! Kamu pernah ke sana?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c665595338abaa74615fb3355619d948f31bfb8c0eab56efdc21b1a8cdb146ae",
      "text": "Makasih. Kadang-kadang aku gagal…",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c999cee494bbdf548771e27c409dad667cad60641b890a79c120206c065e7092",
      "text": "Aku berharap bisa berbicara bahasa Indonesia setiap hari.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca366fee79a96380976c644a9b32747f9a8d4709e68bcf846acc1a185ae18add",
      "text": "belum pernah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd205a189caa54511f43377e1c0ba3c0afeaefa1f78b00422b62e2b5247d73f7",
      "text": "Sekarang kamu capek, ya?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "cdbacf781e37987b2aba7bf54476b9c976daeb8645db55567de9876534e3a5e3",
      "text": "Sedikit, Pak. Tadi pagi saya bangun jam sembilan!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "d29be9ad376e359235e05c060117b060731ab15ead2a5978c4964a586fc4d863",
      "text": "Betul sekali! Kalimatmu bagus.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d31daa2b3b55ff0f599db310d4686f6bd4de06ba36b0342191bc749c1964d387",
      "text": "Kamu pernah makan durian?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "d789a4c480382cb80eca23ea0015ed4e21192fb4bae5a1f9f0ebd7ed20233919",
      "text": "kemarin dulu",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "d843e4d3247c29a4a920c34a7527264cf961ce2b3f068990a7edf1913181971a",
      "text": "Setiap malam, sebelum tidur, saya ___.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "db3ea4857a326f77802cb515cc4717ed78474c82cb9ecadcf4f133be84128eb2",
      "text": "Pernah! Di Laut Merah, di Mesir. Ikannya cantik banget.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "e09fabca3263417aa7b6af48e035e7df7f10631a9a86d8bc549a496f49db3cd0",
      "text": "sukses",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e20bb94baee5a0b9f4c508dd0974b5b0c892a6931489484674ef7e5ec15d4fea",
      "text": "Kamu berani snorkeling? — Berani!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e36d72d9496471a38bfa84bd7ae082fd350d3e947f058093bfb3ab7101d658d6",
      "text": "Cita-cita saya jadi guru. Saya berharap sukses.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5d5573cfc316c89ef1a3ad8917594fc434d8a0a1d1db688b2e840453e62d36d",
      "text": "yakin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e60abb261f0f6006c68148c458b12de43e1882a7d0312bfcc8eff375b5b2cd58",
      "text": "Minggu lalu saya ke Bandung.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e668338768ba3a46884de0515e0f43ef38e3266f8066597aa118f63f2768222f",
      "text": "Setelah itu, kami senang sekali.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "e89e5ff2bbdcdd53c23f2c54428c32733181be7634ad675f7fd924fb8a98346d",
      "text": "keterangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8b2b807a21149136e78b006410b25585bc2647945f6162451f4055ccccec2e2",
      "text": "Kemarin saya tiket membeli di pelabuhan.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea957e1509c86567c9422c2405e1c46ce9520eb547ebb573f6f7e7c79a4aba0e",
      "text": "Mohamed, gimana hari ini? Coba cerita!",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb07d5ff334f39ced42a0adf9c46dc1e7f6bf2dd0304fb21861402b3b7d186ee",
      "text": "Kemarin saya ke Kepulauan Seribu, Pak. Saya naik kapal.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ebe33861b93073b5619359f5cb2a545608d747deaa31e90ac5c99c1fa9d75bb0",
      "text": "Aku yakin kamu sukses! Kamu rajin.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec3f1956cfb09c42779b196233df6fa4a0682bc9531e7d9418d4793b6fc3a48a",
      "text": "setelah itu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee77b3944f18b624f8fe92e7a8274dc05d4089e138e642b7bc81497c16676b48",
      "text": "Lautnya indah banget. Ini mimpi atau nyata?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "f05df0531fa59b2f1cf053af79621540b81ff7f9fe89cb2ce8dc79373704f4b0",
      "text": "memotret",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3adc42399693f9102dcb0aa9bf1daf8b012372f5ca4b724601b3c4afed1b1eb",
      "text": "Saya pernah tinggal di Jakarta.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3dc298786f7a56dbfa343b50562239a72d1898f4b6e813e4c6539c0c60da531",
      "text": "Belum pernah. Ini pertama kali. Setelah makan, kami berenang di laut.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4be73d8d3b58f2c6b0794ffe747bab50716b95eb3d8f66e8ef85881a5d73a91",
      "text": "kepulauan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa687e2a6b73010d64bdfe5b1dcc958c8c3e6ed9fa3438d0cb8a08fec0d589c4",
      "text": "Saya beruntung, saya punya banyak kenangan indah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe555d1e3eca6f9fb1555d931955d2d2eda21a16f0ed8e89a4cc66183b905626",
      "text": "pulau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 7,
