    },
    {
      "key": "e60abb261f0f6006c68148c458b12de43e1882a7d0312bfcc8eff375b5b2cd58",
      "text": "Minggu lalu saya ke Bandung.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "e89e5ff2bbdcdd53c23f2c54428c32733181be7634ad675f7fd924fb8a98346d",
      "text": "keterangan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8b2b807a21149136e78b006410b25585bc2647945f6162451f4055ccccec2e2",
      "text": "Kemarin saya tiket membeli di pelabuhan.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9ed49f36d12871379546296c426ba75141d6862efa337736c97cb0d774b5e67",
      "text": "Kamu pernah naik kapal?",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb07d5ff334f39ced42a0adf9c46dc1e7f6bf2dd0304fb21861402b3b7d186ee",
      "text": "Kemarin saya ke Kepulauan Seribu, Pak. Saya naik kapal.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec3f1956cfb09c42779b196233df6fa4a0682bc9531e7d9418d4793b6fc3a48a",
      "text": "setelah itu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "efd969c7d1e2d1d0a4bbb20c68b32539a9c42e86cf527f1d2a19aac55f722183",
      "text": "Tadi pagi saya makan nasi goreng.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "f05df0531fa59b2f1cf053af79621540b81ff7f9fe89cb2ce8dc79373704f4b0",
      "text": "memotret",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3adc42399693f9102dcb0aa9bf1daf8b012372f5ca4b724601b3c4afed1b1eb",
      "text": "Saya pernah tinggal di Jakarta.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3dc298786f7a56dbfa343b50562239a72d1898f4b6e813e4c6539c0c60da531",
      "text": "Belum pernah. Ini pertama kali. Setelah makan, kami berenang di laut.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f459fa29e610fd24ccefb7b7f371cfe9b299eb300d73229875c73a6816d1b810",
      "text": "Kemarin saya ke pulau.",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4be73d8d3b58f2c6b0794ffe747bab50716b95eb3d8f66e8ef85881a5d73a91",
      "text": "kepulauan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe555d1e3eca6f9fb1555d931955d2d2eda21a16f0ed8e89a4cc66183b905626",
      "text": "pulau",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "fff6b09eee7ef6a2693d1cd9cfa2b1de0334e86e17a46f570f8f813f5341c1e8",
      "text": "Ya. Sekarang saya capek, tapi senang.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    }
