      "sha256": "350be0d07e234542b023145ca59535ae763bf6ea0a2af7b963f40731fc1d28e5"
    },
    {
      "id": "bipa4.u01.l03",
      "sha256": "9faa3b352b4138019546249c1bab9b8727cc9f5fa7a700d9ab748f2b3409b9ef"
    },
    {
      "id": "bipa4.u01.l04",
      "sha256": "0b813f9775716c31757f0c851690fa894854eef015cc03625aac13d028106d41"
    },
    {
      "id": "bipa4.u01.l05",
      "sha256": "6dfd74b0b8582c07d4c320a290081112f514d2464cf7f2c0595cb09e7be26156"
    },
    {
      "id": "bipa4.u01.l06",
      "sha256": "0fc93d1df26a9b6d1067e08e1a3e822ebc0928065dcf098d5128134259b95833"
    },
    {
      "id": "bipa4.u01.l07",
      "sha256": "824d0f91e0aeea01a18d3f41fa0580dd166f4f0922444474b1c02cb4babd72a3"
    },
    {
      "id": "bipa4.u01.l08",
      "sha256": "d4888b5a1e463021aba6e37981ac905d1e398ee63befbe8b7c5fbd975cc5ef72"
    },
    {
      "id": "bipa4.u01.l09",
      "sha256": "2614f8d70073544d0c2ff4f74a356cd1a21ca12e9dfa50dae209a1fc40adc6ba"
    },
    {
      "id": "bipa4.u01.l10",
      "sha256": "1d4ce154f4a1729594592f169ea0528ee3c9fc849263042c0771c40ab2878edd"
    },
    {
      "id": "bipa4.u01.l11",
      "sha256": "f64196bcffb1dbb6faf65a51eb4426d806e37c39525169e8bcfb545aeecf0441"
    },
    {
      "id": "bipa4.u01.l12",
      "sha256": "0baad8af66509f399306ad6c2474c5fd168b64070760b535fb9a1eb1ede9360a"
    }
  ],
  "audio": [
    {
      "key": "00c8030ad449dbfbbd1ba067220ff7b245bf98b19b721cca3eded59891b1b336",
      "text": "pengawas",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "031e41b1344f329f4b4580a1d02110bd4694a4ae954e7b87928e0c4223a36870",
      "text": "Susah sih. Profesi itu butuh keahlian dan kesabaran. Kadang guru juga harus lembur.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "049c55bd8853739ead5be6e41e6ccced68d0252bb43f809b0fa41adf9a0d21ec",
      "text": "Tadi kamu dengar profil Daeng Basri di Kabar Radio?",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "04f7acdf7fb361d331345bf9f04197c29991e0424c5b2cd78e826d0fbe444590",
      "text": "Menarik! Argumenmu apa?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "05eec8ea8c01c57800f76fa26fb751542359d9016b9ab14877d695afbf585f2c",
      "text": "tanggung jawab",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0909cfa676407392d35455bd77f0d8f130a9a0de0702cdc938f91f76cf42118c",
      "text": "Saya bangun kesiangan, jadi ketinggalan pete-pete.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b119f46416d500781ad4db49652ed375811dd0c7043ed3ff610ef990080ab42",
      "text": "Tempat kerjanya terletak di Bulukumba, dekat pantai. Satu kapal pinisi terbuat dari kayu dan dibuat selama berbulan-bulan.",
      "voice": "id_gadis",
      "chars": 122,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b2d6af18a6369fc00918045ea1186642ed647ca5f42093e4956a1499f5eaeae",
      "text": "izin",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c630f760a9096803e70f30b34c54ba263619369cfc818b706229415d5eab29c",
      "text": "Operator mesin harus datang jam enam pagi.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ca75a8637e83cfcff88e93ef36e2ddf8710953de441cebc8d2f0c670c9e7977",
      "text": "Bu Lina mengundurkan diri karena mau pindah ke Jakarta.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d46f2a73dbf6ff480ed694744f221c6f1b938a7a12d9859803bc1d299aae881",
      "text": "Laptop saya tertinggal di kantor.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dea6243157016d9547a8fb57db7154a2ce5744421714b0ed2a4430701008fe7",
      "text": "Wah! Barang-barangmu aman?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e2c4073f1b41518401002cd806b677ed9546c9ffac33b1dcbc8169a988dfbcd",
      "text": "Jabatan saya eksekutif dan perwakilan perusahaan di Makassar.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f81194587135d79a8db981cd78024cf401705d61ff686db9ab9a154dd11b938",
      "text": "tukang kayu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "10b60c59ad69d4d87ed9facc4d557e19df8ccf0b5e73b1db4c9629d73d63a35c",
      "text": "Syuting dimulai jam enam pagi.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "10ea44330d253ef953924548a9c32c744248290d99d987ec207a715d5b9242fc",
      "text": "Mas Rizal, akhirnya datang juga! Kenapa, Mas?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "115fcb50dce40e8b59709d2731662b2441c274245c25d250f88c0562d7b2d642",
      "text": "Saya tertidur di pete-pete dan baru bangun di terminal.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "1166936ddf65897287d606d62c2f6efbedae8733e5bdf572f552aaa579f3f2e0",
      "text": "buruh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "11c9c651e238799a651bb7468846a2f2adc0680a2a7f68bdc6afbb017bf438d2",
      "text": "___ untuk teknisi baru empat juta rupiah sebulan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1273b9e9b0c78803aff47ba537da0c22f271c8d6b514f56b0f7c60d84b296a79",
      "text": "Mohamed, ada syuting film di Pantai Losari besok!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "13068c6b36a199edc97f0126041ec3f755537a1e5afffb7b6ef60dbe3ce4abca",
      "text": "Semalam aku lembur di rumah sakit. Tadi aku sampai tertidur di pete-pete!",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "14edde55571a065f33177e7d1483c6cda6791e6cf365a7fb354ce48cc7925dcf",
      "text": "studio",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "158e7ea0048dd6027f8a846ff7b940dcca0b9389b671091aa0ab53eebc4ec706",
      "text": "Tempat pembuatannya terletak di mana?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1763f43579d30a64783768fbdd9401a03160303508a3e99b21723e06f516d5a8",
      "text": "Masih. Penilaian orang-orang tentang dia selalu baik.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d25158988d075e5ead48998df65e2729585cbd486a6794f383df98ce1d1a603",
      "text": "Saya tertidur di pete-pete dan baru bangun di terminal. Payung saya tertinggal, jadi saya kehujanan.",
      "voice": "id_gadis",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e9c50adedce096c714277792ca56080a2e3ff09ca13ec64eee571e49bf33284",
      "text": "Bener. Dompetku masih aman kok.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ecda153b63af54355844d61d29ce766f603b6c2ccd8ad9159ff10cbb12084ad",
      "text": "Mohamed, selamat datang di kantor kami!",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ef0b14f23c71251e3276f7551714bbb5f666969923415020fd1999fe185d614",
      "text": "Dia dipecat dari bank, terus jadi pemadam kebakaran. Karirnya sekarang bagus.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f7029337859144d7c2fbb70256dd0207c37514db22f7e06ca24ba69693e6a3a",
      "text": "Syukurlah. Jadi besok sore kita jadi ke Losari?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fab664b77effba25dcefdc0d8d8805a1a0bdc1fefb110be65ffce4e9175f64b",
      "text": "Profesi perawat membutuhkan kesabaran.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fc16b43bb7358266daeda9c386018cb97d1153ada396818ec0f78f0e6300777",
      "text": "Jadi perawat emang berat, ya.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "2071e3f66f975b0208f332daab3ec42ba639071372c70436bea5399df2f1228a",
      "text": "Keselamatan pelaut adalah tanggung jawab pembuat kapal.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "20cae3000ee79f0036487dee2c0b5456fc8f0adb0976ecc034a31739dac36206",
      "text": "Karir paman saya dimulai dari buruh.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "24cc444f8b5cc3a419ac5299b1e0078df87a80f85978d84260634e0ef7dd8e7d",
      "text": "Dengan demikian, profesi nelayan sulit tetapi sangat penting bagi Makassar.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "24f9efb0d1d30301f78a983c079e519a1ed7947ed8b56c46b16ecc6276c6de58",
      "text": "ahli",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2abcce38fcf2ad29a9a2008cdb9c2a298ab65ea629868dd7a683d9ee52734441",
      "text": "tertutup",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cc1e745b5ad352fca3715e01db571c37c7d248147eac3a80acafa8cbe940d5c",
      "text": "Kakek saya dulu buruh pelabuhan.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ccdfbcf219c6ee4a94db032d9beb69267d849c5da67c1dfad921b848e8e7535",
      "text": "Kalau gitu, kamu pasti cocok. Kesabaranmu luar biasa!",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d88e25038906a5cf40c27fecf4d0709074d2dba8a28895667d6152c39e210f1",
      "text": "skenario",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f6556e52ad6a0133a67138a58f0c4a7c65a575032282819038379ff1950ea79",
      "text": "Kemarin saya kehujanan di jalan ke kantor.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "316288b70579e5a03317522e43e693957071f65c88401dbb9c9c3e8d8c28f934",
      "text": "Bu Lina naik ___. Sekarang dia manajer.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "345adec49b430e427e6b71ba2e9ef1d02bf1035c76c65b22f5116415e5829705",
      "text": "berpengalaman",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "3afd3dbbe869c5b282dce40ce4858dee22a862bf6f09601d0b5c6ecab8fdac42",
      "text": "jabatan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bbcb33a5b3eb014bff072cd65b47b5d8d1a0e9b15d6f332877f155c8ea39e11",
      "text": "Mungkin perawat. Profesi itu butuh kesabaran.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bc1eabcc963eab3dd7af6bd49caea19b8c2037380f99cd6f27b3e981ec20060",
      "text": "atasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bca41f3baeefb0c11ed0258cba84b8df82bba8956fec5f4ede844304bdd5e2f",
      "text": "teknisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ebd700ea1900ce2bb66de5d4ec90fbafdab5cd68ba6065caeeca7c332875ebe",
      "text": "Kak Nurul, aku udah baca pesanmu. Kakak nggak apa-apa?",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f6d005ee587b1710f153b10f38e525d51ac428071ca4a111d3ddebdc581b0c3",
      "text": "Kapal pinisi terbuat dari kayu.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f9007c1e2784f54234df0fab6d7349a92d7de896227c7643d2e45ec312b66de",
      "text": "Pengawas datang ke pabrik setiap pagi.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "4024c80c232a53991ef82c6c341bad6f984c4ad4696d0531ee4cdde65f973715",
      "text": "perawat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "436d19eec286e8b844205afebe0a72666602e30451bf5f6e4abc0762f5468721",
      "text": "Pembuat kapal, kayak Daeng Basri. Keahliannya luar biasa!",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "4445841cff3c163a801cee48524f88921af6e4b3dada349b15d3dc09dc17a10a",
      "text": "Mohamed, menurutmu profesi apa yang paling susah?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "44ccac34599a8447788ed5b48b96323cefb3eada7122c29b22dd222925890ba7",
      "text": "Dia eksekutif dan perwakilan perusahaan di Jakarta. Kinerjanya bagus banget.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c34cb45e95f6fcaf50efcad65d076e7360290abff9f6891de12a7548f3c6086",
      "text": "Urusan administrasi sekarang lebih cepat karena manajemen baru.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c6c5efc60b94154e6e76d506e32742c0b82c6ef79dbeef07a1a1be229f8a9da",
      "text": "Mohamed, kalau tinggal di Makassar, kamu mau kerja jadi apa?",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eb431aeb13f313f6cea5617fafff630e4b1fc34f5570f005fc9c02ef8dbaf66",
      "text": "berpendapat",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5004e302a062ce39540ee4a7db782ebd9febda9a86fd5b6c71752ac1a740757c",
      "text": "mahir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "51953178d0760665193129ef63b7c60b4eeb4905742b6c3a96427892e8350923",
      "text": "Mohamed, maaf, tadi pagi saya tidak datang ke Pantai Losari. Semalam saya lembur di rumah sakit.",
      "voice": "id_gadis",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "51e867bf72fd04a20186df2a810d24042fcfa1e56360d2e6a810a82563aa9d1a",
      "text": "Maaf, tasmu ___ ke rumah saya.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5207020616a8211916645ccf6d5c4bbdc9eb6cc5a1c94eabbd89b2a81d3badcf",
      "text": "Di Bulukumba, kira-kira empat jam dari sini. Tapi hari Minggu tempatnya tertutup untuk tamu.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "531b1e891b7776c6f65d4c08628057e1e5401c052287f795d48a9552a08b5b83",
      "text": "Koki itu memasak untuk semua kru.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "541906925ddaa1343bbb4b7e6250d4aa7605a624e60d2b17dd5608dc4019d399",
      "text": "Perusahaan itu akan mempekerjakan sepuluh operator baru.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "548db62c6d1d8a70d9d3c8561876ec3089706274194a0d4a98936a23d0b2eb7d",
      "text": "Keren! Jangan lupa keselamatan pelaut, ya.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "54be67516b52060039779655c3802598e4e44268b8ad1fc3c4e8a18ba852f968",
      "text": "Iya. Makanya beliau bilang profesi itu butuh kesabaran.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "54c9c7645180b2eceeb1361e52b59adbef3914cb1b83f4e1b85957362e3ffdce",
      "text": "Pelatih itu suka melatih pemula.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "54dd4c9feac9b670bf1e722706f4bfcbb55f4fa2d845d73cfb016e534b09446c",
      "text": "Kamu mau nulis teks eksposisi tentang profesi apa?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "5733fd15ba7380e168f4433252555800ca3499800f071693888b9dd822e2f105",
      "text": "Administrasi. Pak Halim pengawas kami, dan Bu Lina dari manajemen.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "57e7a1fb9ad54cbf37c770e92e2f0a3158b295321edb175b32de6ba3a029e081",
      "text": "Keselamatan kapal sangat penting, jadi pelaut punya tanggung jawab besar.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "581c0b3137ed587cd36d81c4b8800493ccf4ff8b125e9e57a34268c0b95c4f87",
      "text": "Untung masih ada di ruang perawat. Temanku yang nyimpen.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a15954c18639d87248786cf10b8c45f0f182f2f55d5b13c19b9103bac92a78a",
      "text": "Perawat itu lembur lagi, jadi dia tertidur di pete-pete.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c16c464e88e192f5c05a45d327bea14c795ef555cd0c913c86e61238b9f93fb",
      "text": "Insinyur, teknisi, operator mesin, dan pengemudi truk.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c452a20b947bca0e6cb3262ce6351ec477ba59c902db115542a6eda2cc32bd7",
      "text": "argumen",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d0749de014493a41336ad9c42132f8fa4781a3f6b2d3e89ad656a3457417345",
      "text": "Daeng Basri dulu pelaut. Sekarang beliau tukang kayu yang ahli membuat kapal pinisi.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "5e902b70ec193a0ddadc2bc65f4be0d466b34b1adfda0a7ed216665e82cd3273",
      "text": "Mereka butuh penerjemah bahasa Arab nggak?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6041e4e01d02d63f76eabc0cc432f9f28ca502e8ab98766ce3d05bde239de62b",
      "text": "pengemudi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6489e9a082fcdde59405634edec67acbf9dac029072fed70a894eed8a841240c",
      "text": "kru",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "655c534050cc40289efbb0b6105579fc2a603ead3afcfff19e3954cb19fc335a",
      "text": "Kenapa dia ___? Karena dia mencuri uang kantor.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "6609f3e0d7e28b97b9fd0d21c38dc128d1b7ba916b428c1c5befb8a173f76835",
      "text": "Makasih. Kak Nurul di divisi apa?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "67bdba5400b9a30bbb6876df97c89bd5be123470bc2f167ae266b5d287bde7a2",
      "text": "terbuat dari",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "68bbf860dfb63d9e90954d97dfa60743e052a1d10d815a51714a4bd296ada0ef",
      "text": "Profesi guru membutuhkan kesabaran.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "68f2fb1f79398afd2ad245d611bafa871127c1f69c9f412d4b29a637f5ecb2dc",
      "text": "syuting",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c5225adb2a611da8898939b2a1f54600c008208b78886e44598525f8bfad22f",
      "text": "divisi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c799d23978b2c344411bca1683df28bc41e5322bc57f61e8b91e8d9c1daa00e",
      "text": "keselamatan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ca0b626b22579c4ecc1434c2ccc3668897195d4782092b49b73ed732f2441d6",
      "text": "kejujuran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccf63198b2e52a43e064557bd6df8e40beaf1bf5799b05cf2d5dbd4326c091d",
      "text": "Kesimpulannya, keselamatan pelaut adalah tanggung jawab kita semua.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dc2baf81239d1b8199d3a283dada15efeb0d87d8fcddb63e5f98108f6185b97",
      "text": "Kalau Pak Daud? Jabatannya apa?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ea820430d547e519f413c07c8049dd158bcf8ca78f90c1481e954b1dd001f5e",
      "text": "Kapal sebesar ini terbuat dari apa, Daeng?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f812f03a8475b619890fb3ecb7d8366cd79c8a67362714a33c52d8d54e650bb",
      "text": "Dari sini, pulau itu tidak terlihat.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "70688885e63262e4e97ca78e451d649167ece063c6e6fdb2bcdbcf47adfbcf79",
      "text": "konstruksi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d4297a86b3937fd7beacaae51c69a1786fad88d5716e17937c432131fdc5c1",
      "text": "Iya. Eh, maaf, pulpenmu terbawa ke rumahku. Aku nggak sengaja!",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "71fa37df27e41c2e265eac842ea396db4b692da50780239d0d317f1ce72515cb",
      "text": "melatih",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "72a80d15e16776fa700d60bc18e49952d772aef7496b545608d2ce88efac99d3",
      "text": "Aku pengin lihat tempat kerjanya di Bulukumba.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "738b6bf2b73aa2ed66da4408c5cdfcdaf71b181c24371055bf59cb0539a5a7de",
      "text": "Wah! Aktor dan aktrisnya terkenal?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "74415b6caa4a4aebd172b5f51311e35ef6cacea44ea3b5ba50e2d9ee8666a8c3",
      "text": "Mohamed, lihat iklan ini deh. Pabrik semen di Maros lagi cari pekerja.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "7474ba6257e224e2ca16526169e64a0693e36b1170c680e5cba5c82edfa4b0b7",
      "text": "Wah, bajumu basah. Kehujanan juga?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7669f09b6edf01e3870bb5d3cecd608c9570fd320138271209f1ccc115731a3a",
      "text": "Perusahaan konstruksi itu mau mempekerjakan dua insinyur.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "77d65135e4496db934b248fcbedb205c94a006a184d839b1f5e2c1d6541c640a",
      "text": "Hebat! Kalau pamanmu?",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a9e7bc71b17848a5168a0dba57f8449521dc0aa5825e4b394c8e726594aaa2c",
      "text": "Kalau kamu, mau jadi apa?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f899cb713aeb2cbe104753656b5707ad4ef0bd53ad903ef9748dcd8f448f2d3",
      "text": "Profesi perawat memang membutuhkan kesabaran. Besok sore kita ke Losari, ya?",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "802ddd0a5c004f3199a6bbecd038b8f0557e50d4bda8db32dacd7e6f567ec399",
      "text": "kesabaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "803488442e4d3379427919f16df949c31519dad9040523ced45b73d0d4d56cfd",
      "text": "Kak Nurul bekerja di divisi administrasi.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "80fac4428dceee424fbe229b722109eaa5d0eace28bd644e75645e2bbfde4ca3",
      "text": "Apa jabatan Anda di perusahaan ini?",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "82ccb55626c23f59f178a952da53875beed3d109e6c7d79ef4c07b65b0942015",
      "text": "terletak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "83873a6e114df79eac9a7a91b462f97cb7a87ef0b3d1e28a374aeae7460210ae",
      "text": "Ha-ha, bener! Terus kesimpulannya?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "8732764b842ca8f17a491999af3cc03f3ff6b7e018196c1f1f4f4d6f47f4e0bc",
      "text": "Boleh, tapi jangan hari Minggu. Tempatnya tertutup buat tamu.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "87720c046bfc47246187ea35dd6d5d38a2862f3ac999507948ad634f4c87f5ff",
      "text": "Argumen kedua, perawat bekerja siang dan malam.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "87dbb978320162abf5cad0c58e666c10b584e9b74269a0d3e8243dc6114523fb",
      "text": "mempekerjakan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c7e2c12a8503acdb53fcae288c53f16c5d45bd3967f3b73382b612fdf15e9bd",
      "text": "pembantu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c8fd43156b41fd01a162de4bc5808105233a99433ce4d71a0ca0cb662607d7c",
      "text": "Besok sore kita ke Losari, ya?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "904ecbab343a8bd7be57992c546674063a5e456568e3a08805c8a08ecb3cb734",
      "text": "tertidur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "927cbcec66dacb5dfb2ff320610a431a9db6f4419365f6c3371ed66174dc30b7",
      "text": "eksekutif",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9370d5374a5b6dff62c8e075e24782cb90cb4831f55cbd22b1a54d62fef4ebd3",
      "text": "Aman, tapi payungku tertinggal di rumah sakit.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "944f9dcb1c7baa619404395077601e9b007f9baa164df5af1c34257d2d74b1f1",
      "text": "Minimal dua tahun. Bayarannya lumayan. Aku mau mendaftar besok!",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "970f1b704216620e216ea908dafcc28054aca4e82d86afef0cc7721e09354dbe",
      "text": "Terus HP-mu gimana?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "97a959f6f3f5dc30893e6a439a7011c94712b1f4cd0418e47bf4a175bde77079",
      "text": "Tempat kerjanya terletak di Bulukumba, dekat pantai.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "98ad330e224defc183aaaf716ec30e296e4a7af0d52a31e8957f4f5dad4a45cb",
      "text": "Emang kerjanya nggak susah?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "993a91e6de15b32f09470df5b8305cd9ff0a4a81b5698924601e30a7595b57fe",
      "text": "keahlian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "99da3c4e9f24618eac029b92a2bc3c4619026c9bd31803c8ede814c454a1f964",
      "text": "bahwa",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c8b9770441af49f7287103cc5b48520601e31640fd60692a69c46401ed46a39",
      "text": "Pak Ilham ___ anak-anak bermain sepak bola setiap Sabtu.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9dc85d32c141e1aa883080905d91eee0924b5a09ff9e26c89bef6ac9289473d6",
      "text": "dosen",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e6d199cfdaaaff1704c3dc35b2a5b51a4dcd0c3562d11741eefa0b38a79d482",
      "text": "kehujanan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e96660317530ae1bc2c467148908ea682c7cdd36505430479cd9415f8303538",
      "text": "Hampir semuanya terbuat dari kayu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9efe1f9ed98e7e8e49560e2f2e97d3155481d787bdd670a2c5938dc96cd1e2fc",
      "text": "Maaf, kunci kantor terbawa ke rumah saya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f1240f8d66a43094240398d302b5d0ade4a75dfdc3f634bc941754d4a5b6da9",
      "text": "Nurul ikut audisi untuk film baru.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f99b4cba8fbb3d01a7b04c572a1b5a0fe998bc9adede06af7ad0f4c73a0da70",
      "text": "sulit",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1dde071388342c910448c42dd5e939ec3a60bde8b0b16e4ef24cfa6ed64d515",
      "text": "kecopetan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a22b940b408288db495d3361e8d92d9472a1094458155c1b76459e33519d2cda",
      "text": "dipecat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a24fe14ef2071931b947f5972af594773f2b2584d16971173b4bce14bfc1149a",
      "text": "Dengan demikian, kita harus lebih menghargai nelayan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a383dfdfcf5bd66760598ff68d399c8cd2537764dbf4d340b93a7ff4349579e9",
      "text": "operator",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ebd9883dc4241d5c0ea9c5ecb160624176426e9b6a7ba7b3b8a9a6c6822ae3",
      "text": "Karena terlalu lelah, perawat itu tertidur di kursinya.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6029d968a728e84adf6e066bd81f3b5e3007f3d2e4c48d9c0a9d6d0ad3c3054",
      "text": "Nelayan. Di teksku aku tulis: \"Saya berpendapat bahwa profesi nelayan kurang dihargai.\"",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "a65320b5576eb06d9ec0be62fde2bdd9a542779c53216c155242c885dedd892a",
      "text": "Kami mencari teknisi yang berpengalaman.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "a70f226e0da4af987afa6220387472fad79fba52cff9e3ab9de54d4a548af4e6",
      "text": "tertinggal",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ae7874b9a59fca2f47970b99c65b05012adb562f32aa4f7223e24d98058347",
      "text": "Pak, boleh saya minta ___ pulang lebih awal?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9773334bd936989cd5938d6ac85fb4d9893cc10af552b1d79855c310c289bd9",
      "text": "Saya mendaftar lewat internet.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9bfb35ebed1eb5c08cce8e3ea87c19d93a7415138ba5106bcd419db7b43ada5",
      "text": "Semalam saya lembur di rumah sakit.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9d754118800385fdf93f4f06c1dedce78a786841be5653aed70c0933f8d092e",
      "text": "Yang penting kamu nggak kecopetan, Mas!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa8a23bddb990ef9a1d5892cf5185921047d65ad05efad26b1cd23d12de00fbe",
      "text": "Dia dipecat, lalu memulai karir baru.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "acc7c86aa753881ad09f030b81a1ebd34dd346720f0ebec7831ce50bc4e00590",
      "text": "Keluargaku lucu, Mohamed. Kakekku dulu buruh, sekarang ayahku dosen.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad4176d3892924473db7e58709fba0470c3da0bbed8939285dffae2a49984bd4",
      "text": "kesiangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "aee47c571b994ebeccb651f36497298e954d3a6149ff5cdea96deddef55d834e",
      "text": "Saya berpendapat bahwa profesi nelayan kurang dihargai.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b063ef728ad8d99a80b94872b8497c0300760846c2539d2d3e0d049906565be7",
      "text": "perwakilan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b19c7201eba13ffc0486782d36abf451c16dd20aa200637b81728fb93694ddab",
      "text": "Aku mau jadi guru bahasa Arab. Menurutku profesi itu penting banget.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "b411516962c3c83e10ef870d927c6887373dd0dcd417ccda1ffdc588b62818f3",
      "text": "administrasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4acaa04a19591844af9047a7899a1b7663cd742afb17e5e36b10b8fba2a7305",
      "text": "Nggak apa-apa, cuma capek. Aku tertidur sampai terminal!",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b52137e7e373b185f587d5d0e2d64d9fd9981334ef5da92a1ed271a577b06cb7",
      "text": "audisi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b586a398a0072bbefae045a0da4f48066b8f4137144e3a4fde0556a854f5dccc",
      "text": "kinerja",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7277273c36768f1e29439ccdebaf53461f21cdd42e9f4180220cfa98ef85abf",
      "text": "mengundurkan diri",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf70b72a27a7213770348d99215fbf57e7d5e738ff9c7ab5ae39a45c6ec3856c",
      "text": "Maaf, Bu, saya minta izin datang terlambat. Tadi saya kecopetan.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfa1679eed55ec7707dd01d2c7c7d2dc5845bb602cc6a118f10e03e8d9f4333e",
      "text": "penilaian",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c10a04df7dffe5f7d268015bc1e6fe5ec9490a5b4aa0a2739bd31ea98b622ac9",
      "text": "Paman saya pemadam kebakaran di Makassar.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c248d74d7886cdbb0f81f1ae2cef4e4ee0d6742dd0925c584f4661344d9df2f0",
      "text": "pelaut",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a742e79695f2b0092cb268793cbd80b74d6653b74d4d892fa08c11b2cf83ca",
      "text": "Maaf, kunci kantor terbawa ke rumah saya. Saya tidak sengaja.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63c26c109435cf0bb7feb13d7da42f54f55df5b124e3cc5c4c6aa016808e417",
      "text": "Aktrisnya pemula, tapi krunya berpengalaman. Sepupuku kokinya.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "c69f3cf2e21b25a34c11ce522834874f0950e9649c9050971084dc47ed3779b2",
      "text": "pemula",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca25d9889981dfb92bfd27dddbb785627a7ca81f1913aa9fb2cd3c5a1a34683c",
      "text": "Ibu saya dulu pembantu, sekarang dosen.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb40e66302b92a5e55afeb375fa207a2a521c8b69073ed92ee653ed506da1ff3",
      "text": "Terus ibumu masih pengurus masjid?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbbd84d696f059d6a9970eef32e19faada7f09de14df2c803d640338ec794483",
      "text": "dengan demikian",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd46b958c2a0baf4f3eb0580a525cb60f7e54fc136835730ec5e1f43b9774d69",
      "text": "Bisa jadi! Bahasa Indonesiamu udah mahir. Ikut audisi aja!",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd8eeae95c062c722f257235f74984910395cbe506b02c01cd6dce9fd3c3fd93",
      "text": "Bagi pedagang, kejujuran sangat penting.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "cda3041b1620578cffc75ffa126b56d7d661c0416cca8f6ba114f76dbcd2ee92",
      "text": "Kejujuran sangat penting bagi pedagang.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce67c113067713682370870b83fcbf230ad28fa6a3804883756e02a0ee206599",
      "text": "Mereka mau mempekerjakan siapa aja?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0529d1e088fc8fc92e4fcc60a006863bbd18a769dd384da95133a1dd0ab1c47",
      "text": "Tadi pagi saya kecopetan di pete-pete.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d194abbec72c894a039ee07b2f90e01eb9f3744accc8771a0daeeba1f2ffe8f4",
      "text": "Saya teknisi yang berpengalaman. Saya mau mendaftar.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "d34cafe2c9bffda1bc00ad67891e47ee65bec3f312ce902e6880d51dd27e4660",
      "text": "Setuju. Perawat juga butuh kejujuran, dan tanggung jawab mereka gede banget.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5bf0128afb7bc81f8ec924ad7c9455e3551458bc4202f14727ad025670d9820",
      "text": "Saya bangun kesiangan, jadi ketinggalan pesawat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6b2639ac353281411fe1825bcae699a7b538f962b78a1765ade2f500328e102",
      "text": "Menurut Daeng Basri, profesi ini membutuhkan keahlian, kesabaran, dan tanggung jawab, karena keselamatan pelaut sangat penting.",
      "voice": "id_gadis",
      "chars": 127,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6d90918e32e6d0ba9f3bbd8cd637166931b42a318855502d5f8c90ba00fb563",
      "text": "membutuhkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7f4ca41cd0a969aa6537a19fcd8cbcf58e44295fd86f7f176be6e1655b53c00",
      "text": "Kinerjanya bagus, jadi dia naik jabatan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d7f6407eccac3109ab7a30ccd55edc6b7d74a309c9afea72a07eefba336b81cb",
      "text": "Pekerjaan perawat sulit, tetapi penting.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd01e13027d4bf8f038be50180fb0149d07c6f9efa1fb89ded87ad6719b06109",
      "text": "Aktrisnya masih pemula, tapi belajar cepat.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "de9e9163f3ac547793a175ac91d6e378a4be8eb6645b3784bedac686ef0734b5",
      "text": "Perawat punya tanggung jawab yang besar.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2e28ae38f93f4fdefd3926d21ea13090b9caa240b054a732038915481ba4f82",
      "text": "Pertama, kerja mereka bahaya. Kedua, kalau nggak ada nelayan, nggak ada ikan bakar di Losari!",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2ed09715beb2d80ec6e873a9f5226cc858ced6141107fb5f6ca4c8c940bbc50",
      "text": "Keselamatan pekerja harus dijaga.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4ec172b534822adf74a6ffd93ba98acb0265fd6f40cf03589c975b32f1a9b78",
      "text": "Daeng Basri sudah empat puluh tahun membuat kapal. Dia ___ membuat pinisi.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7bc379b8a2624150aa5569e7f40011b254b64621aa5a668c89be08a1aa82035",
      "text": "Dengar! Ternyata satu kapal dibikin berbulan-bulan.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9836168c2e96f9f677af3ded704c3ce87dea9c588f804573096b5ea64ffea20",
      "text": "kesimpulan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b4331958f9ce3b46923aac3ce7d8e5aa4ce9652031fd1780d4d797fbf7d7c0",
      "text": "Dulu Daeng Basri pelaut. Sekarang dia tukang kayu yang ahli membuat pinisi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea15796ba6a72caa216e996329042bdf328a7470db51bc82df0b6a3ee6e5e9c2",
      "text": "karir",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "eae734e3e93b3b06b62c9283c1f32c60b094838128e26ccf86a6606131ec588b",
      "text": "Saya berpendapat bahwa perawat adalah profesi terpenting. Dengan demikian, kita harus menghargai mereka.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb18f90b5a2f1b671a4f31c504636d8ae44d0d5b7a78e576a08fd1162ab5ba56",
      "text": "Harus berpengalaman? Bayarannya berapa?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef203458887fba349be90ca1de99d14f1d698df5eb3638b85296af376da58b6a",
      "text": "sengaja",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef4a9837eb70bada347be507b32244c6d4178ef55ccb175420c5b0dd0042682b",
      "text": "mendaftar",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef59fcab9fd8481c021782d34ef9653ff1a4403e4734c40d510e24becc436be2",
      "text": "Dengan demikian, kita harus lebih menghargai nelayan.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1c24286ccf68852558cc8aeb133fd66bca6714614afafd0b5746b9d2e91bbf9",
      "text": "Hari ini kantor pelabuhan tertutup untuk umum.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f25c46cd823ec9991a38b86c32ff4995f8db9f249ebce9c17b812b41332388e2",
      "text": "manajemen",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3d0d98f576c26649bf1545180424691de9ce28a34e38daaebc7892070b87932",
      "text": "pengurus",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f422a89c57891df04e953af4a36c2fda878d7f1d9d3b3709cfb17cf98d01759a",
      "text": "Satu kapal pinisi terbuat dari kayu dan dibuat selama berbulan-bulan.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4bdd191753f8f5a5dcda9bd234afeae04692827f415cddc0373e70dbac412dd",
      "text": "terbawa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4c9c46f79f39200accc4760d5e9b6ffa41afda5ccebf2d1476990fbb37373d7",
      "text": "Saya tertidur, lalu ketinggalan bus.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6a5cff4e76897521f3e099bc6a6a90c1598931e0ec77e4575c56852c89bbe4c",
      "text": "Kak Nurul, kok kelihatan capek banget?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f70fe8a42b37520534b0a8a316dbf438cb4fb9a7f8ae940a868e8f702e3e70e3",
      "text": "Mohamed, ini Daeng Basri. Dulu beliau pelaut, sekarang tukang kayu.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9e317c1e874d55f9edf78695fd05f9ee0424da66cde47be71f6ec9e32aa9634",
      "text": "bayaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb1f30a00526b588386e6bbc59769f18f3ccaf61e48c2d45f9508a27bace2b2c",
      "text": "Maaf, aku bangun kesiangan, terus ketinggalan pete-pete.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc9b2f425f3d52c497564f800aa1e6b53f7ec025fea92384ff2684cf0d723f51",
      "text": "Aktor itu mahir, tapi kokinya masih pemula.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcccc70e805a8bdb7e24d3890f8eaa0e0623c3fb100a8e3736ecca9308b6aca4",
      "text": "Benteng Rotterdam terletak di pusat Kota Makassar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd545c2facfbcc81941789cd246956d6242b2008dc3a857a9503475352fd423c",
      "text": "Selamat datang! Saya ahli membuat kapal pinisi.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdb9e20709d8a1f55ee9c7e9f2133a89955b0e833e08cd1329ae1695046f599b",
      "text": "penting",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdd7d486f215db89b9cf65ab1ef4bf735d8dabe4a9306384f370a5584f90bf00",
      "text": "Iya! Untung aku udah minta izin ke atasan.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fde87f33c7c769e7d1cd2824531630239c800e00e74f0a55511e1c8c2f82a27c",
      "text": "Aku nggak sengaja.",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa1ab1a4dd973094eab78079070d803cdd612900ded9604683b756f39e98de8",
      "text": "Maaf, Pak, tadi saya kesiangan dan ketinggalan pete-pete.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 12,
