{
  "format": 1,
  "id": "id/bipa4.u01",
  "language": "id",
  "unit": "bipa4.u01",
  "version": 1,
  "content_hash": "6432400f1dcd978c4e7841993e1b5da1abd3a334b1d31d17562abfedfcbf1551",
  "lessons": [
    {
      "id": "bipa4.u01.l01",
      "sha256": "0fe5f126d68e0bb24ae02df1fc3ca6d4ab3a9686c81b7f471b395de1e4a83790"
    },
    {
      "id": "bipa4.u01.l02",
      "sha256": "2d5d7cf98af4b9b1fef9e944ca09d4a4de066bbeb1f04632482f4d6d8d53e0b3"
    },
    {
      "id": "bipa4.u01.l03",
      "sha256": "a9a62e7bd9e325b0c0bbe9df02e4826e786e6ad8c178c8624cee11db44418568"
    },
    {
      "id": "bipa4.u01.l04",
      "sha256": "7cb08117874c16d8797687e253222e2649f28f1ce59f859845478c159f24640c"
    },
    {
      "id": "bipa4.u01.l05",
      "sha256": "811ff3066560ea82f1b35b194a0d7d66bea2be67c0fcd0c0d82055c8fd568a62"
    },
    {
      "id": "bipa4.u01.l06",
      "sha256": "bcf07dbe651c240a0e21f879c4132c077cef8302099c45543a85cc1f8263a29d"
    }
  ],
  "audio": [
    {
      "key": "00042419b57ca57905aaf3641beccc2b6dba0e9f78d1944164d6eb2295c239a0",
      "text": "Menarik! Apa argumenmu?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "05b738a88594bb29eefcd02d10910e6938d4fd505c0914c968cbc8037c6ec34c",
      "text": "Mohamed, menurutmu profesi apa yang paling sulit?",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "05eec8ea8c01c57800f76fa26fb751542359d9016b9ab14877d695afbf585f2c",
      "text": "tanggung jawab",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "07def387512e712956c04298e58d3812b3f93754c30945243c748d4a62f8696c",
      "text": "Dengan demikian, profesi nelayan sangat penting bagi Makassar.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "0896716dedea27c03877db2705b5ae59b086c7d3885b0d132d4bf41fe1a70e95",
      "text": "Semalam saya lembur di rumah sakit. Tadi saya tertidur di pete-pete!",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "0909cfa676407392d35455bd77f0d8f130a9a0de0702cdc938f91f76cf42118c",
      "text": "Saya bangun kesiangan, jadi ketinggalan pete-pete.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b2d6af18a6369fc00918045ea1186642ed647ca5f42093e4956a1499f5eaeae",
      "text": "izin",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d46f2a73dbf6ff480ed694744f221c6f1b938a7a12d9859803bc1d299aae881",
      "text": "Laptop saya tertinggal di kantor.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "0dea6243157016d9547a8fb57db7154a2ce5744421714b0ed2a4430701008fe7",
      "text": "Wah! Barang-barangmu aman?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f81194587135d79a8db981cd78024cf401705d61ff686db9ab9a154dd11b938",
      "text": "tukang kayu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "158e7ea0048dd6027f8a846ff7b940dcca0b9389b671091aa0ab53eebc4ec706",
      "text": "Tempat pembuatannya terletak di mana?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1769982b30d0c2279ebac43be9d4f7b10d9aacd42986286c865dbad84977b5e0",
      "text": "Pertama, pekerjaan mereka berbahaya. Kedua, tanpa nelayan, tidak ada ikan bakar di Losari!",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "19c07b9845dfdb8a478d4ed141de332c4a7e186f8cbe462418bce6a02f4cf2be",
      "text": "Yang penting kamu tidak kecopetan, Mas!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ea83d5c3851a41ee814e21c04da7b486be24e052ad52d481db4b3f697a8d230",
      "text": "Kesimpulannya, keselamatan pelaut adalah tanggung jawab kita bersama.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "1fab664b77effba25dcefdc0d8d8805a1a0bdc1fefb110be65ffce4e9175f64b",
      "text": "Profesi perawat membutuhkan kesabaran.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "24f9efb0d1d30301f78a983c079e519a1ed7947ed8b56c46b16ecc6276c6de58",
      "text": "ahli",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "2abcce38fcf2ad29a9a2008cdb9c2a298ab65ea629868dd7a683d9ee52734441",
      "text": "tertutup",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d461cd5b42b97056dd6d363f75c127ac155dde475581b8ad6aeb95422404e2f",
      "text": "Pelaut punya tanggung jawab besar untuk keselamatan kapalnya.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f6556e52ad6a0133a67138a58f0c4a7c65a575032282819038379ff1950ea79",
      "text": "Kemarin saya kehujanan di jalan ke kantor.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "387f21d5aa804f5597c7b028cb4dc4384d3d888f99d039bc19d37bb14eadce5a",
      "text": "Mas Rizal, akhirnya datang! Ada apa?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bc1eabcc963eab3dd7af6bd49caea19b8c2037380f99cd6f27b3e981ec20060",
      "text": "atasan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f44b7f3ff09d2522648fbc79f7e06e01b0c7789e08372c0fc4b1fe9f7487f78",
      "text": "ketinggalan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f522f00e807c6ac5cb3ac0f769892526e1f5ed309494ee84fa8b34de2bf542d",
      "text": "Memang. Profesi itu membutuhkan keahlian dan kesabaran. Kadang-kadang guru juga harus lembur.",
      "voice": "id_ardi",
      "chars": 93,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f6d005ee587b1710f153b10f38e525d51ac428071ca4a111d3ddebdc581b0c3",
      "text": "Kapal pinisi terbuat dari kayu.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "4024c80c232a53991ef82c6c341bad6f984c4ad4696d0531ee4cdde65f973715",
      "text": "perawat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "434ad3414e976a34af9afb53d009e808ede47e2e9bdca2aa4696c88cc6ae5dc7",
      "text": "Saya mau jadi guru bahasa Arab. Saya berpendapat bahwa profesi itu sangat penting.",
      "voice": "id_ardi",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "45527cce610e0c6abe264982a13ffd4aa133b272c5fb98f707d4633d8e47f4f4",
      "text": "Iya. Oh, maaf, pulpenmu terbawa ke rumah saya. Saya tidak sengaja!",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "472e99e821ce72f88e99d56887757aa32ff1bf6fe20090ccf7518ed1ab972b92",
      "text": "Mohamed, kalau tinggal di Makassar, kamu mau bekerja sebagai apa?",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bc454d3b3d56d3df21923ee3179faee8638e5cd815ba0583688db2257a2a9f9",
      "text": "Bagus! Jangan lupa keselamatan pelaut, ya.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "4eb431aeb13f313f6cea5617fafff630e4b1fc34f5570f005fc9c02ef8dbaf66",
      "text": "berpendapat",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "519f6e051c2fa4cf5b4ab7a77e9fa94c272d193b299f1367c1ce9ec7b10fda92",
      "text": "Kamu mau menulis teks eksposisi tentang profesi apa?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "51e867bf72fd04a20186df2a810d24042fcfa1e56360d2e6a810a82563aa9d1a",
      "text": "Maaf, tasmu ___ ke rumah saya.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "5207020616a8211916645ccf6d5c4bbdc9eb6cc5a1c94eabbd89b2a81d3badcf",
      "text": "Di Bulukumba, kira-kira empat jam dari sini. Tapi hari Minggu tempatnya tertutup untuk tamu.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "544768e5de3ae5f6826c2a9832e6ea2c673b8b881efa5c67f24b819ca6c095ba",
      "text": "Keselamatan pelaut adalah tanggung jawab kita.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a15954c18639d87248786cf10b8c45f0f182f2f55d5b13c19b9103bac92a78a",
      "text": "Perawat itu lembur lagi, jadi dia tertidur di pete-pete.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c452a20b947bca0e6cb3262ce6351ec477ba59c902db115542a6eda2cc32bd7",
      "text": "argumen",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5cdc3d58fa3f733b993354f5e06031642f1674d9e09c45b5e9d72c72a5aa105d",
      "text": "Iya! Untung saya sudah minta izin kepada atasan.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "5fd96b9324b87f79d8215b54645f9def9bae9e3057cbc73d3b93d4761ceb6b6c",
      "text": "Bukankah pekerjaannya sulit?",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "67bdba5400b9a30bbb6876df97c89bd5be123470bc2f167ae266b5d287bde7a2",
      "text": "terbuat dari",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "68a6ee32a93b17eb210e64d8ff3714651b0758aee1812c797415d85cdde6d493",
      "text": "Betul. Dompet saya masih aman.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "68bbf860dfb63d9e90954d97dfa60743e052a1d10d815a51714a4bd296ada0ef",
      "text": "Profesi guru membutuhkan kesabaran.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "68bf91570de3c1608744d18cc8ab611561a9c7420ce9935c712611b9ca757ce3",
      "text": "Pembuat kapal, seperti Daeng Basri. Keahliannya luar biasa!",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c799d23978b2c344411bca1683df28bc41e5322bc57f61e8b91e8d9c1daa00e",
      "text": "keselamatan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ca0b626b22579c4ecc1434c2ccc3668897195d4782092b49b73ed732f2441d6",
      "text": "kejujuran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ea820430d547e519f413c07c8049dd158bcf8ca78f90c1481e954b1dd001f5e",
      "text": "Kapal sebesar ini terbuat dari apa, Daeng?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f812f03a8475b619890fb3ecb7d8366cd79c8a67362714a33c52d8d54e650bb",
      "text": "Dari sini, pulau itu tidak terlihat.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7474ba6257e224e2ca16526169e64a0693e36b1170c680e5cba5c82edfa4b0b7",
      "text": "Wah, bajumu basah. Kehujanan juga?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a9e7bc71b17848a5168a0dba57f8449521dc0aa5825e4b394c8e726594aaa2c",
      "text": "Kalau kamu, mau jadi apa?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "802ddd0a5c004f3199a6bbecd038b8f0557e50d4bda8db32dacd7e6f567ec399",
      "text": "kesabaran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "82ccb55626c23f59f178a952da53875beed3d109e6c7d79ef4c07b65b0942015",
      "text": "terletak",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "855c58863d2f8b43262689976054081eca343b839e3704c036bbe7ac83351028",
      "text": "Kalau begitu, kamu pasti cocok. Kesabaranmu luar biasa!",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "87720c046bfc47246187ea35dd6d5d38a2862f3ac999507948ad634f4c87f5ff",
      "text": "Argumen kedua, perawat bekerja siang dan malam.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "904ecbab343a8bd7be57992c546674063a5e456568e3a08805c8a08ecb3cb734",
      "text": "tertidur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "993a91e6de15b32f09470df5b8305cd9ff0a4a81b5698924601e30a7595b57fe",
      "text": "keahlian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e6d199cfdaaaff1704c3dc35b2a5b51a4dcd0c3562d11741eefa0b38a79d482",
      "text": "kehujanan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e96660317530ae1bc2c467148908ea682c7cdd36505430479cd9415f8303538",
      "text": "Hampir semuanya terbuat dari kayu.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9efe1f9ed98e7e8e49560e2f2e97d3155481d787bdd670a2c5938dc96cd1e2fc",
      "text": "Maaf, kunci kantor terbawa ke rumah saya.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1dde071388342c910448c42dd5e939ec3a60bde8b0b16e4ef24cfa6ed64d515",
      "text": "kecopetan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a24fe14ef2071931b947f5972af594773f2b2584d16971173b4bce14bfc1149a",
      "text": "Dengan demikian, kita harus lebih menghargai nelayan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "a405b851c69dc24772f778a2d5c98f1be6f5993530df6d048904513aef538ec1",
      "text": "Maaf, saya bangun kesiangan, lalu ketinggalan pete-pete.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4ebd9883dc4241d5c0ea9c5ecb160624176426e9b6a7ba7b3b8a9a6c6822ae3",
      "text": "Karena terlalu lelah, perawat itu tertidur di kursinya.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a70f226e0da4af987afa6220387472fad79fba52cff9e3ab9de54d4a548af4e6",
      "text": "tertinggal",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7ae7874b9a59fca2f47970b99c65b05012adb562f32aa4f7223e24d98058347",
      "text": "Pak, boleh saya minta ___ pulang lebih awal?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "abc486a92c03b7ac9c4425fe217e4589792cf0bf2b7f78f609f9072e9c58fdca",
      "text": "Mungkin perawat. Profesi itu membutuhkan kesabaran.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad4176d3892924473db7e58709fba0470c3da0bbed8939285dffae2a49984bd4",
      "text": "kesiangan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "aee47c571b994ebeccb651f36497298e954d3a6149ff5cdea96deddef55d834e",
      "text": "Saya berpendapat bahwa profesi nelayan kurang dihargai.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7dc6e0e596021264aea8f4e6ac0265e8155e63a1885dbf12a3acad3035ae2ce",
      "text": "Kak Nurul, kenapa kelihatan capek sekali?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "be8a335013ee8510d017aaff5ef78e7a64f07ffb1f0d5f2aaeb5f9f6a89ec6d0",
      "text": "Nelayan. Saya berpendapat bahwa profesi nelayan kurang dihargai.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf70b72a27a7213770348d99215fbf57e7d5e738ff9c7ab5ae39a45c6ec3856c",
      "text": "Maaf, Bu, saya minta izin datang terlambat. Tadi saya kecopetan.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0b472071b228d697f7b408ed0d5e252d14d385f6172864a43a3426d5fd578a9",
      "text": "Setuju. Perawat juga butuh kejujuran, dan tanggung jawab mereka besar sekali.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "c248d74d7886cdbb0f81f1ae2cef4e4ee0d6742dd0925c584f4661344d9df2f0",
      "text": "pelaut",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a742e79695f2b0092cb268793cbd80b74d6653b74d4d892fa08c11b2cf83ca",
      "text": "Maaf, kunci kantor terbawa ke rumah saya. Saya tidak sengaja.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6747dde2efb87416b328be21f52fec6e92a12a4c8d483ce9eeed1d3ce15c3b4",
      "text": "Ha-ha, betul! Lalu kesimpulannya?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbbd84d696f059d6a9970eef32e19faada7f09de14df2c803d640338ec794483",
      "text": "dengan demikian",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "cda3041b1620578cffc75ffa126b56d7d661c0416cca8f6ba114f76dbcd2ee92",
      "text": "Kejujuran sangat penting bagi pedagang.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0529d1e088fc8fc92e4fcc60a006863bbd18a769dd384da95133a1dd0ab1c47",
      "text": "Tadi pagi saya kecopetan di pete-pete.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1fd13594bd88d38ff9c0de700fc83c8fbdc71403033f3c0f73b27d24079db69",
      "text": "lembur",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5bf0128afb7bc81f8ec924ad7c9455e3551458bc4202f14727ad025670d9820",
      "text": "Saya bangun kesiangan, jadi ketinggalan pesawat.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6d90918e32e6d0ba9f3bbd8cd637166931b42a318855502d5f8c90ba00fb563",
      "text": "membutuhkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "de9e9163f3ac547793a175ac91d6e378a4be8eb6645b3784bedac686ef0734b5",
      "text": "Perawat punya tanggung jawab yang besar.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2ed09715beb2d80ec6e873a9f5226cc858ced6141107fb5f6ca4c8c940bbc50",
      "text": "Keselamatan pekerja harus dijaga.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4ec172b534822adf74a6ffd93ba98acb0265fd6f40cf03589c975b32f1a9b78",
      "text": "Daeng Basri sudah empat puluh tahun membuat kapal. Dia ___ membuat pinisi.",
      "voice": "id_gadis",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "e671324bc17cfe0ada509654aa5608ab2e8ee751111da1e1d8a0a6d02bafda70",
      "text": "Jadi perawat memang berat, ya.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "e70791af542a52527ed32b2957e3bef916b95171c28086a1b4f795b752e3093d",
      "text": "Aman, tapi payung saya tertinggal di rumah sakit.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9836168c2e96f9f677af3ded704c3ce87dea9c588f804573096b5ea64ffea20",
      "text": "kesimpulan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9b4331958f9ce3b46923aac3ce7d8e5aa4ce9652031fd1780d4d797fbf7d7c0",
      "text": "Dulu Daeng Basri pelaut. Sekarang dia tukang kayu yang ahli membuat pinisi.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "eae734e3e93b3b06b62c9283c1f32c60b094838128e26ccf86a6606131ec588b",
      "text": "Saya berpendapat bahwa perawat adalah profesi terpenting. Dengan demikian, kita harus menghargai mereka.",
      "voice": "id_gadis",
      "chars": 104,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef203458887fba349be90ca1de99d14f1d698df5eb3638b85296af376da58b6a",
      "text": "sengaja",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef59fcab9fd8481c021782d34ef9653ff1a4403e4734c40d510e24becc436be2",
      "text": "Dengan demikian, kita harus lebih menghargai nelayan.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1c24286ccf68852558cc8aeb133fd66bca6714614afafd0b5746b9d2e91bbf9",
      "text": "Hari ini kantor pelabuhan tertutup untuk umum.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4bdd191753f8f5a5dcda9bd234afeae04692827f415cddc0373e70dbac412dd",
      "text": "terbawa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4c9c46f79f39200accc4760d5e9b6ffa41afda5ccebf2d1476990fbb37373d7",
      "text": "Saya tertidur, lalu ketinggalan bus.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "f70fe8a42b37520534b0a8a316dbf438cb4fb9a7f8ae940a868e8f702e3e70e3",
      "text": "Mohamed, ini Daeng Basri. Dulu beliau pelaut, sekarang tukang kayu.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "fcccc70e805a8bdb7e24d3890f8eaa0e0623c3fb100a8e3736ecca9308b6aca4",
      "text": "Benteng Rotterdam terletak di pusat Kota Makassar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd545c2facfbcc81941789cd246956d6242b2008dc3a857a9503475352fd423c",
      "text": "Selamat datang! Saya ahli membuat kapal pinisi.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa1ab1a4dd973094eab78079070d803cdd612900ded9604683b756f39e98de8",
      "text": "Maaf, Pak, tadi saya kesiangan dan ketinggalan pete-pete.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    }
  ],
