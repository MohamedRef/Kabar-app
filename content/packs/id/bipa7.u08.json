    },
    {
      "id": "bipa7.u08.l08",
      "sha256": "e605d07fc6d29445530deffb5a963a1af4527ffe5f255c2a5ec98e0083825fc7"
    },
    {
      "id": "bipa7.u08.l09",
      "sha256": "6f70c2b8426b5d507d585993c24c50c6d14d00711db76a3caea4a326c16095ee"
    },
    {
      "id": "bipa7.u08.l10",
      "sha256": "b176e9c2b49742c7c551908a52738b1255c2490cb63f103a4c58ee9373ed6def"
    },
    {
      "id": "bipa7.u08.l11",
      "sha256": "a08be4b0a4994f0262aa97fbdee7a7c7f8aa95dadf2dae96688a7c436572cf07"
    },
    {
      "id": "bipa7.u08.l12",
      "sha256": "df45fb55079f8abbc74c15c1a73cf2ffe8159e19dd284dc59fbb5072ce3d69ec"
    },
    {
      "id": "bipa7.u08.l13",
      "sha256": "343ef19d89f811491c9361d001ff22f04fc9cce3e654e5a18ccc41ff670610d3"
    },
    {
      "id": "bipa7.u08.l14",
      "sha256": "e3e2387ff4ad93a5efa84493fca046d2106de8951f8974ac1feeb46a9b43ae78"
    }
  ],
  "audio": [
    {
      "key": "00fc8b500e718b938a0d3f09a05ee03cf7b1b5c24b6954e47c1a2517524ca106",
      "text": "Smelter itu mengolah bijih nikel menjadi bahan baterai.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "03de078a7b438cdd3c4e712a21d4c6dbcf8272dddc55c2e27696ef6167f21ec3",
      "text": "oleh sebab itu",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "05b7659df1b80664a5376f67f9a0e412d450daf790f391c71276bcce2d60c325",
      "text": "nilai tambah",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "08274917c4dce8218f91b87c047e307eb48df23bc721a11563b4998e64690b28",
      "text": "simpanan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "086e4f6c9513cc921bf8884b0a31ced365d33a5892675fc44f6e148221c97c01",
      "text": "Banyak toko tutup. Meskipun demikian, toko Mama Ester bahkan menambah karyawan.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "099b2114c83c2f4a71b86b3144dc63fc2e2dff41ee7316d55166a34de30aeaf9",
      "text": "Mama Ester menaruh uangnya di deposito selama satu tahun.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "09bf210a974d80696f96b1e720ee6152430693ec1941fc5738f56083cf845e2d",
      "text": "angkatan kerja",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a16827c924044eae86e5c40128c80e4b751743e1cee4432e5215e58e99d3ff7",
      "text": "Olahan rumput laut ini kami jual sendiri lewat pemasaran daring.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a5430bf386d7f10dedddd437e486271a64b763592efa117e5273fc14fd97e6b",
      "text": "pinjaman",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b3f5467683122dbd3ffde355c723e741d51c638afa043562f3ccc5eaf137ae0",
      "text": "Jadi semua anggota dapat uang yang sama, Bu?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d6151dd1fdf42210d984e41b22059682647c2306200ee71236b115ddf67996a",
      "text": "Setiap anggota koperasi membayar simpanan wajib sepuluh ribu rupiah sebulan.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "0db3d10cc21ef94c7c7d9d7057d7eed9bcab96c4ce9b25f2289675dc648f1bd7",
      "text": "pertumbuhan ekonomi",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "122f8dc4fe6ef1dda8809482920ddf0dc5e65be7f0d710de8ef30aa645ad56f0",
      "text": "Betul. Meskipun demikian, investasi di pelabuhan bisa menurunkan ongkos itu nanti.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "12de2d55c2d3075d7fb4615ca4a787b804fa879f233a67120a3fbdc7c3cd3b41",
      "text": "resesi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "157327d7e563e0a44714257fd0eda433d1cc2102ef0575ada1030c117b25bd13",
      "text": "Budidaya rumput laut tidak butuh pupuk atau air tawar.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "16a1bdcf127fcf398358dd50b600506053614e25cafd9eb2bb72cc96118fdd23",
      "text": "Untung ada bantuan tunai. Itu yang membantu kami.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1701f3545d164d341ce12e39c51dba6321b7de3269159b8f0fb3cfbbf0d9270f",
      "text": "Bagus. Dan garis hijau ini?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "19fcb0bf4c5efe96155d7a9ffb06c0f70cf7e60ec1bb2deed9d9c3bd51ab780e",
      "text": "Investasi di Papua terus bertambah.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a55b4d82e547daa0f4f5b7ca56d3029eaa4b9692084e81b2c029caae8020cab",
      "text": "Dulu iya. Sekarang kami bikin olahan sendiri. Harga jualnya tiga kali lipat.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f016361fa552ab1b7b74dcd57f3a68fb39d95899864392e6a7b78ab66522f2e",
      "text": "Anggota yang aktif mendapat sisa hasil usaha lebih besar.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ff6a084ebe5bdd1d0cb0f848da1aaea2947dc31767c613685033c329fe4d4eb",
      "text": "Kaka Benny, omzet bulan ini enam juta. Itu laba Kaka?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "206f382d3b644cc25b19c2c59f259fe42dd9c072b13a7742de0dca1da0f9cce2",
      "text": "upah minimum",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "22eaffbadf2049d611a3848689487d1c78f13d1c7651bd1a34664e7689c9136f",
      "text": "Di Jayapura harga ikan turun. Sementara itu, di Wamena harganya naik.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "231c5f23e6ee2b23ca231411e6c0b16918d64fec4f718495f263e57baf324aab",
      "text": "Saya sudah memindai kodenya, tetapi transaksinya belum masuk.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "25c1f002b010a5bfae2911495fd202da1a679477fea81f865f02481589e4f719",
      "text": "Nggak. Tergantung simpanan dan seberapa sering mereka jual ikan lewat koperasi.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "25f14e25fa955b07c84f6d5e96c8d59ac577537435251369883ed2017cd6e714",
      "text": "ekspor",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "28b4ef558788bff31e425d0e18997af20b135075c91febacd8ba79e3f3987c72",
      "text": "Akan tetapi, usaha kecil itu tetap bertahan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "28d5fa85da69b7516e97e91ca400cef8ce846fd29eda10fcc04317f1f507f46e",
      "text": "Upah minimum di provinsi ini naik tahun depan.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2934a418ada38c15c85c9788eb4e97361921cf076b8a025ec5a811f9db7b3443",
      "text": "hilirisasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b1d5de33f042b70e4f74dc6d02a45ba6d6ed9599a2f8ac08501fbc18545341e",
      "text": "deposito",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d7d20af3172a957e68e2b86cb14d50224c49116e14a53e016cc36312b8cc7ea",
      "text": "neraca perdagangan",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "2da57f04733f880885656f66030f03a239d8e4c3142954754fa77e2234a035da",
      "text": "Itu pinjol ilegal, Mama? Terdaftar di OJK atau nggak?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2edc14bbb97fb3fa9b25ff1ed9587571f6ce5db59a53ef252acd66fb4d253286",
      "text": "Simpanan wajib saya sepuluh ribu rupiah setiap bulan.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f3f189cfff4c4c7ff50ea052f37c80a9c8477e07704c47d424444ef0b1828e3",
      "text": "Bukan. Itu pemasukan. Pengeluarannya belum dihitung, benang sama ongkos kapal.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fc72772599498574365f8930de1fc2cbf59cf7ef84caeb28544584c2120830a",
      "text": "Neraca perdagangan Indonesia mencatat surplus bulan ini.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "31b749cccfcf55e7d821b3c37e8eace77236dd79167fa740cd6fdf924596f5c9",
      "text": "Inflasi menurun. Sementara itu, pertumbuhan ekonomi relatif stabil.",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "31caa207fd50e6f25f863589467b031ee55a49c1e2e014dad39dbe960e35a8b2",
      "text": "bantuan sosial",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3235643d114d383b9bf3b015a4802d9e5c915447be398b717a924ea584343495",
      "text": "Betul. Kalau sakit, kami nggak dapat apa-apa. Itu kesenjangan yang nyata.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "33403d67e24ae18687fe698a1ff09eced73f8565e64436ae848d4f15131b9ec5",
      "text": "Pelabuhannya sibuk banget. Kapal-kapal itu bawa beras dan semen, ya?",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "340115c21d5dd330aafe9f5c787c00f23de62af89b3f80d641193d79bd618997",
      "text": "Ketika impor lebih besar daripada ekspor, neraca perdagangan menjadi defisit.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "34e3e6ad317905ad69fbcab705448e761a7d7fe76804ccbe5edd48c7531dd65e",
      "text": "Rumput laut dipanen sekitar empat puluh lima hari setelah ditanam.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "34ebf2bf354381b7e5ab79b775758222353b239464103993108f8a8e4eb40236",
      "text": "pengeluaran",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "352d9d5ee90dcd539cfc69ebd7f4f53066cfcac023527738e039d86b2c366cc9",
      "text": "Banyak angkatan kerja di Sorong bekerja di sektor informal, kan?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "3794fcd02ebad676953a7ad7542e1b42d80d618940a4f75fec7e6c38b8d86232",
      "text": "Catat semua pemasukan dan pengeluaran setiap hari.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "38a9d3afb883652e1acb8ec6154b91fb3ffd4ec355e996a49c2c2d6c32a78c8f",
      "text": "Ketika daya beli turun, toko-toko kecil kehilangan pembeli.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a21563edafb68621f061696956eb62f2ca5fa1cccba972c3f0359f34035ee1a",
      "text": "QRIS",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aa2adea2c27c6bf4266997723a18a8c60629fd67b0baa5832352c86179bbf7d",
      "text": "Betul. Salah satu sebabnya hilirisasi nikel.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3aaad0eb9ca916a5fdc820ce2d6cfcea9dcbcec92efb59b5494449510c8c2f54",
      "text": "impor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b3aa4b553b60670c35f8cac327de349f744ec60b41e459bc93d63e1975cf1e0",
      "text": "Mama Ester, boleh saya rekam wawancara ini untuk kelas Bu Frida?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "3bcfd022a444851e1be971a8f12d010a9e8382265d94f6d0c1dac7757f7b6f3b",
      "text": "Pinjaman kecil itu sudah lunas.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c2fcd84b7cf9272bb04a397ed752bd686890c4273d678795ee5ebb5e9ac678e",
      "text": "kemiskinan ekstrem",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d3a4af1a23389222f5bba1f6c1b654f6f28f31a4c55f28fc3949c243c3b027d",
      "text": "Insentif dan subsidi harus tepat sasaran.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dbc464674026ad8b56a1014db0b0fd3f6d8afc9371a5a311f8216889886fa07",
      "text": "Dulu aku jual noken di pinggir jalan aja. Modalnya dari tabungan.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e2502ef3bbf937a888d5efcda3580dd42f137bd84823a1ca897cf693da7aefb",
      "text": "Sekarang kiosnya ramai. Apa rahasianya, Kaka?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "43a3364b9ccb357ecc5213f3b52c480cccf4a534dead0e8bef22f87247f47a3c",
      "text": "Seorang penjual bakso keliling tanpa kontrak bekerja di ...",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "43ae70f733dccb2cadae4c3d0ab877face66e9ed68aa3336006b14d6bc8caeba",
      "text": "Dengan bunga majemuk, utang kecil bisa menjadi besar.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "43d6cebc819dca57491dd1bf5139ea6d6ad89c56a33deacd019fc38eada5c0a7",
      "text": "Koperasi ini dimiliki oleh dua ratus anggota, semuanya nelayan.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "44f2ec4450c73c99f4595968c4d7102388605e3e7c1f509d04b366dabebae96f",
      "text": "Tapi Kaka Yohana bilang ada masalah lingkungan di sekitar smelter.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "4617603bafdca6b354d9c3e6dc26a21cb9439180621fc4f17cdcee4090d5fb2f",
      "text": "premi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "4698c634af8a5dd5fe0f485b3849b6a840d27ec174e2b5a4eded12c80d11708a",
      "text": "Modal. Akan tetapi, mama-mama di gereja membantu. Sekarang labanya kami bagi bersama.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "48f2533ad0b574de949ab94b9acfcfe1b4e92ae6135b180b236831dd8024adbf",
      "text": "bahkan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "4929846011917656e9df9e60202c7b45cb2b4cac997183c48f5b8ffaa7585b37",
      "text": "Betul! Kamu bisa jadi bendahara koperasi kami.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b133406dc6a1912f8800feb51d8daba84534687a37c6c433a4f5efd22bd9b74",
      "text": "Kami butuh literasi keuangan di kampung ini.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cb0d1f58dff85f73c4082886a51dd7f8d748ca6b3292c511aff260e02a8a028",
      "text": "pekerja lepas",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e70fe94198eb580e21101d0f287dea012df34ef34383628a7fbb2678802346e",
      "text": "koperasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "500bca3cccde465f1f9f54a109e27c3c8fd4b1d222d558aeb632d28c10cf8086",
      "text": "Jembatannya. Tambahkan \"akan tetapi\" di awal kalimat kedua.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "50136114a05a5d29bacee98a38deccc115e1b75f4c5df05294e6546a8483717f",
      "text": "Waktu itu Indonesia masuk resesi, Mama.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "501e1b5d20c5dd3f9702c6cebb512e3fa20105b9013a5eccf9e93d5d216eb937",
      "text": "Kesenjangan bisa dikurangi dengan pendidikan dan bantuan sosial.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "51cd16371ae4d0166f43c75336f5cc71a551971af2ceeab8ff3e6e4f32fe6cb2",
      "text": "merintis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "568e79ba9e4f9a004435d73265dd3883552110efc20f97391b6220bfd1385340",
      "text": "Pengeluarannya empat setengah juta. Jadi labanya satu setengah juta.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "56b9e4bbb7dce5d9ad7791f6ea5f3e8fc646da845c58103ca94761e029b8787b",
      "text": "stagnasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "588d7bffa419881fc134509528e5745bbaa94ec812be0e6a13711d67161876d4",
      "text": "Indonesia masuk resesi pada tahun 2020.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "5954f65c20585804c3848ec221a0cef6c46629b03abb0867c0b5af12228d1130",
      "text": "Apa yang dicatat oleh neraca perdagangan?",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b8e6d740a8a9d7bc1f969c25fb960b185b4bcc4fb377bee9ee465be154402c7",
      "text": "Sekarang pasar ramai lagi. Pemulihan ekonomi udah terasa.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d58be94eb7a51119822fb9c197790733dedb70741a0f5ad956a6e799af14725",
      "text": "Berkat pemasaran daring, pembeli dari Jakarta bisa memesan noken.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ef3dfbeb7264de8cecf62fb2fb40772e8925ed3f6fdaa230efcbc49d71f109b",
      "text": "memindai",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f6f5195bdd4b8ba62fcd05164644cce395ffb755d81c5b276a833a60bfd96d9",
      "text": "bunga majemuk",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "60b909ae4ca0df6d96e6633b686fcd0a66a51384f0e29cb75bd05dc16ca7bb42",
      "text": "investasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "625841edae902ec9ea622ac2ccfe09e3c8c2d6dd4b93b6a073f3b79ce336fcbf",
      "text": "Itu budidaya rumput laut. Bulan depan kami panen.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "62dbd8400831fa60add9b4b23292cd5b1d14ad27523e4fa858bc6b45ae4deffd",
      "text": "Kesenjangan antara kota dan desa masih lebar.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "63681cbb8e93ccca23838916eb7c93132b99a30387b41c216c1c0bb02a00166c",
      "text": "Artinya ekspor lebih besar daripada impor, Bu.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6414731491d3c4fe5bd54e927341b82515884e23c5d8219973d1c80265107101",
      "text": "Pemerintah melarang ekspor bijih nikel sejak 2020.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "642eaa7cee94b298c664c246fd91583a7e7dfcc7d45f2056d9878cad493c4656",
      "text": "harga jual",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "64368864e7df63f5c338f34fcb48468112fabf06ee26416fb9e62bb7f46bfe28",
      "text": "deflasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "64c6516f261ea4247b4f4b727839b184a3970bd9006ecb59876013e5523f4f0d",
      "text": "pemasukan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6883f3748672fde39088191a3f48cbd026ea4861c09ff3c69e5e1bb274a914d6",
      "text": "Banyak anak muda menjadi pekerja lepas.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "69c1ff6aac8a747c58240c789ae96fb088fcae16135c4329646398628a2e6598",
      "text": "Bisa! Kodenya di sana, di samping keranjang pinang. Silakan pindai.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "69f26d17ca25b19093a8224066c4ae64adbe143984461534ca724a519cb8cd70",
      "text": "pemulihan ekonomi",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a31bb5c42fc5d370031cc3de3c3f77a4174ed4ff8754131dbf80c324275d5b6",
      "text": "Penjualan noken naik. Bahkan, ada pesanan dari luar negeri.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bca01902ac6f69f980235bdf60bcc885067bfa81384ecbe871ccb73b5564a9a",
      "text": "sektor informal",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ce462befaf44ed075ba24e8b166f1a2bb8ca581ea69ba654066d5b52bc2d527",
      "text": "agunan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e9d9cf199c037393b9acaef5cffe693ee8a995354aeb8cdcba3d0a161e89659",
      "text": "nontunai",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f4d6ea0d627b12cc3f37b357e751459fcb8a615f8fb4d6eaa3b0bec52365f61",
      "text": "garis kemiskinan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "71b366ca97c316543c38e9203e4c0459af8195927a2be528d86092ae1cfa9f25",
      "text": "Nggak tahu. Mereka juga kirim pesan ke semua temannya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "7241ebec4c13b4337c29683d6cb886f49839289aff649ef43dd08b3d283f190d",
      "text": "olahan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "752d9e4a76348a46f7ba1e47d72792d9bba3a3912f42e19b87742c0e0d24b716",
      "text": "Harga sagu naik. Akan tetapi, orang tetap datang. Bahkan, jumlahnya bertambah.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "7583a94417916849a1418ed6531876157bdfa22048eed276273b4af56381365b",
      "text": "subsidi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "75d449221d90fc312fc2719258a6aa75ecc6a7772ade0f3d31e4e82613084e0a",
      "text": "akan tetapi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "78509d99dce17f91e221dddb98ca634081f0768eb65cf07195f68062dfdf6c3a",
      "text": "pemasaran daring",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "7e447b25df7ce06e068319764fe5212f23e7224599dce68a3e80cdbd36220453",
      "text": "kesenjangan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fa01576b668a1f89b1bccb389b7332fecb5e4936bbf942bef39bdf820bfd0fd",
      "text": "Ekspor nikel olahan membawa devisa yang besar.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "7fdc74f7d9ee0fb3b29524b688dfb40a8c80f30cec8eb861b46da1b4db29e9fd",
      "text": "Pemasukan kami bulan ini enam juta rupiah dari penjualan noken.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "827a7df656ed347102b08a49e2c4c186a55bbfaf5c39ad31d82dc77387ac4572",
      "text": "Nilai tambah harus dinikmati juga oleh warga sekitar tambang.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "88d0a2d75f39362d9aecb92b83a423d508ab74e7183a27fa6177d3b02a707c86",
      "text": "modal",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a9b820b53bdc713fad8e92ecfea362d17e19441376ae77a6ba576310590ed5d",
      "text": "suku bunga",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ab31aeaf642b51b6b702f3ffc04670142e6bae592a018da0d0daf97b7173573",
      "text": "Iya. Nggak ada upah minimum buat kami.",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "8abaa3b328c9bfea8364e85ea23de58b2393f80f77d89200ce5cc711400c01e3",
      "text": "Mana yang paling cepat membantu warga miskin saat resesi?",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b31f097f99088f20ec7a27d2163974042f2957a3ec54c3c42eed1141f4f3865",
      "text": "Bank sentral menurunkan suku bunga. Akan tetapi, investasi belum naik.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e0c1b015df65baf6766110091fcae50555f4b345e0d4f9c8f67bb064228ecfa",
      "text": "Dari bukit ini kita bisa melihat seluruh teluk dan kota Jayapura.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "9685856ba10f1126f3175aa6a16291f12be2e4080a44e3541cce928e02e9dca1",
      "text": "Itu benar juga. Nilai tambah ekonomi harus ditimbang dengan biaya lingkungan.",
      "voice": "id_gadis",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "992e3e40f121d4feb2052ecab925b2632f99be03d8bc2166154fe854ecff4846",
      "text": "Jangan pakai pinjol ilegal, apalagi tanpa literasi keuangan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "9aef26bda5badc09e96b22c1ae905c2253b702e4e0698ba6919d0679ab4b3a1c",
      "text": "pinjol",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d44515a1693f561bdcf94439d6a8ed73e98780f18648eedc7b27b42ed5d52d4",
      "text": "Pinjol ilegal itu mengancam akan menyebar data peminjam.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f5a1a8b4f63d5ddf0314b5572e61956681cc2aae51d83488985ab67e93f2882",
      "text": "smelter",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ffcab9928931fd4c426d546406c391cb12d61f8f1f7c0c9d027e03628ab3a0a",
      "text": "transaksi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a01261e90f88d26dd7d8910c3fc0a99de0d5d8fa7c8262ee42a74b1078df82d4",
      "text": "Saldo saya tidak cukup, jadi transaksinya gagal.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0545ed86503926feddd9774f75675a10ac1efe6655ff28a95e2892382a6772d",
      "text": "produk domestik bruto",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a09490d789c1affdf78ade3329fb478260141fe8e70430ba5b8842ac24f94f83",
      "text": "Paragrafmu bagus, tetapi kalimatnya terputus-putus.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0b7833bdb3bda71bbab8c3b9caca3d9d4f8901fa8f0f32dc1f186271a30f468",
      "text": "budidaya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1641164b8619506c6d6acffb8c86abc41c0df329c401ec80c07c8f963912430",
      "text": "Harga sayur turun tiga bulan berturut-turut. Para ahli bicara tentang deflasi.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "a405f49208042c31cccf55240f2573e0004d44a55c0c3544d42f4a334e3d2b7c",
      "text": "Apa kendala terbesar waktu itu?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5abbabe99388c8845c97a3bf4902fd8c2b6db5bea1d1bce70c2a30fb53707b0",
      "text": "saldo",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "a6f0f47228eb79f4ab165b87714a19962be1182f8ac9c8cc5bc462f046a4bf4c",
      "text": "UMKM",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a71dbddad3c888cbd20480835141aa52d1c1483373861dabfbabd5cd214e1d69",
      "text": "surplus",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a94a335e325dab7f800cfafd9388b2f5b5affb8b0c045574d487cb13792dbff7",
      "text": "Mama Ester, tali-tali panjang di laut itu untuk apa?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa7057ade6f3f42587025788cdb87b250dcad9a09575580325d609e594b199cf",
      "text": "Mama jual ke siapa? Ke tengkulak?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "add2d9fd0827f375956fa89b10b4206d48b16785e44ef949bd3146421190e4f8",
      "text": "literasi keuangan",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae2716886fa4c0d7d9286484a4eb07b5b3635b51033979d9c084a03c960a303f",
      "text": "Bank meminta sertifikat tanah sebagai agunan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae41c718ba95a6d75b9ca778e3eb96a8d9f8c0cb69b4ce401f3bcc36e8eed511",
      "text": "anggota",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b09a3468f5a0581b673ff6bbea68ba701598d9d335bdc979837a91e48341b6b4",
      "text": "pengusaha",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b124fcb569c45a2342b14a48b190e29892b6a724a5176e6d5b6dc2450e5499fe",
      "text": "nilai tukar",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b162dbbfe57924c7d3c0fa71f056f2f8316a2ad778cf0b0d702e1f692e33baaa",
      "text": "Laba usaha ini dipakai untuk membayar sekolah keponakan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2ffdf68cc53da1b1251a25dcfdcaa7157f06af855008ed5acd56c0fdfb21db6",
      "text": "jaring pengaman",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "b3b2997f2ebabdbbfca242c2515f689ded3b9c5958593699382b7a229cfaa3db",
      "text": "Itu bagian dari jaring pengaman sosial dalam paket stimulus.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b795c38348e0cb4dc36d66b55cdd0e8fcb3bbad2790244beaf0b2cb2d41ad919",
      "text": "Jadi omzetnya naik. Oleh sebab itu, Kaka bisa melunasi pinjaman?",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "b96c32321013b5f22b8f48f08069fbf9648a8d95fa940817d5d8fe603ae0f27e",
      "text": "nikel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb1969d84a2f009fc810307b5dd9251f6072577be7b52822d036e91557e93dbd",
      "text": "rumput laut",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc7a071910bdcc81d5e5c73994081be59d530231a4fd98a7b3372c6dfe1ca326",
      "text": "sisa hasil usaha",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd58f8e1810d3a1f32be4fa43c369358c21c21f5ad779e9c85d8a4d687e2513d",
      "text": "daya beli",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "bef43a7c964b6a747e915a32890e41751b01ec746b21d695f4296cd1e34b35f8",
      "text": "Itu ekspor. Ekspor meningkat tajam, bahkan lebih cepat daripada impor.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfc94b15b0a3ac8c648ec3f2ef9783b0bd032af9a87a9c15b0d29ab37f793918",
      "text": "defisit",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0cca1a78bd2cf75fa3c5a79eae546983b88535d3c8ccfb96a856e6ec959c8d8",
      "text": "Pengusaha kecil itu merintis usahanya tanpa pinjaman.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1cd8411742f12957d4164982304a0b81218ae26506b93a0eac297af5c2eb844",
      "text": "Hilirisasi bertujuan meningkatkan nilai tambah.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c2a94c1a6208e9f21d9a4e4c402fa1c0e9cdf4123084d766e460adecf98fb3fa",
      "text": "Kami tidak mau menjual ke tengkulak lagi. Harga jualnya terlalu rendah.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3127062a287baeb76ebecb8cb5fe2c650bf6544713753038851bd5f6d9d9450",
      "text": "Produk domestik bruto Indonesia lebih dari satu triliun dolar.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3f105d8946adcb052414470a916b0e75920b8da732b94151153354d0fdbb552",
      "text": "Jadi Kaka termasuk pekerja lepas, ya?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "c440c76b2f927190c3fab92c867117fe95789c8753a028e3292357dd121d0c9f",
      "text": "inflasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5abcd6d6d7992c3c7d7b23fee5a793ef4eeb02acfebf32765506043fac8ec7f",
      "text": "Pemasaran daring. Satu video di Instagram, terus pesanan datang dari Jakarta.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "c65b874131284b288b7e1c1e1664f92deac5dab1a71a8fa4a919e5486c631dc6",
      "text": "Mama Ester, saya nggak bawa uang tunai. Bisa bayar pake QRIS?",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7dc6bb40c41d5289051b8e37c6ca478c0e9c1d1fb88d4dae59ff793af4210be",
      "text": "Pemasukan dari QRIS langsung masuk ke saldo koperasi.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8233185e62b97e2e3cf06ff1bba1ab5f7d4758173ca438d7fba88a18a3a22b0",
      "text": "Pemerintah memberi insentif pajak untuk usaha kecil.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "c95f23b3c440b2b9fb0afcecdd5d6bb3a0e1b5e127c7bc10fd7b1127fed0cdb1",
      "text": "devisa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c963087dc2263470d5f056cc90e3c349556897fd7b7af0ff7b6b29c9c2bb070b",
      "text": "Betul. Akan tetapi, dari sini juga keluar hasil bumi Papua.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce1724f6a15b522e3f2f98a1c0d60408e516e4ab9c531c07b5a6332f21cfb047",
      "text": "Udah, Mama. Dua puluh ribu. Transaksinya berhasil?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce4b6f56e58487d1561d9c2aecb1990c2e0542804d936f902976963080fa84ca",
      "text": "sementara itu",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2a63e70d53220bf2d6d83f8f16b762fd5d0987aa3c3437eb925eb7238598f9b",
      "text": "meskipun demikian",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d34c58c2e53cb0bb1c65e522c65ca33cb8fd70b933da6f58fb00330cc27c42c1",
      "text": "Ia merintis usahanya dari dapur kecil. Bahkan, kini labanya cukup untuk membuka toko.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3f87105d7fc9c998b3329ea1541b509acd23b542c451c60783b55e004776646",
      "text": "Lihat grafik ini. Apa yang terjadi pada inflasi?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d461aa078f7102fc4fb62c26a9a8f838ab1608b8d0838bc1f0e9841b81d59b6e",
      "text": "inklusi keuangan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d52a77865aea63fe2c7a5d2c6e311842406437ba64529b400207c41af571fb0b",
      "text": "Mohamed, aku ojek online. Tiap hari dapatnya beda-beda.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8031ed2c725baed9f1a41ab7288f895b50e71c3c284bb456d9600e4c6319a06",
      "text": "Apa tanda pinjol ilegal?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9029bb5a03414490e9dea491d0b0c214bd8cc92f35ff19bb43f2b4a03915bc7",
      "text": "Mohamed, hari ini koperasi nelayan di Hamadi membagi sisa hasil usaha. Ayo kita lihat.",
      "voice": "id_gadis",
      "chars": 86,
      "mime": "audio/mpeg"
    },
    {
      "key": "d91e4ff83422e840ce1af5c94a70b8a21de00bd21441c92623bf2a0a5ff39e6d",
      "text": "Mama-mama membuat dodol dan sabun dari olahan rumput laut.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d970d1504ec8476a98c33fa0f4ea5ca1edd0529efcbd8e20f8bb2b9d7f640f9d",
      "text": "Anak, dulu waktu korona toko saya hampir tutup.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9932346bc1ba12ea01846dfffeaddb9176f7415714e92d666db1d3b3854e08f",
      "text": "Boleh. Saya merintis usaha ini dengan satu kompor dan satu panci.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d99ca9a506ba868a52809017485879d7b2edb3b7570000217f0c64e74adc0bf2",
      "text": "Omzet UMKM itu naik berkat pemasaran daring.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "da0e4a4a4f3723832c15035bec0bfe54ee7a02e20549f2eb7b539fbeac7b2bc1",
      "text": "Makasih, Bu. Besok saya ke Danau Sentani buat festival.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "daa0f29755b89cb41ce0fb3d25526407df841651efb9054fa20ab8e9549424ad",
      "text": "Pedagang kaki lima dan tukang ojek bekerja di sektor informal.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc4d7129a2eda7a03e8ebb4d165469890c3f288c0cceb01da80d5d83b4825e75",
      "text": "Harga sagu naik. Orang tetap datang. Apa yang kurang, Bu?",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "df8cb59631bc40bf6f36e800975b2f5bff1b4aa104e84d7ceb7cc49e7b907ae9",
      "text": "Masuk. Sekarang saya jarang pegang uang tunai. Semua nontunai.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "dff1d86bff1775b998c735950c7d88b1ae428b92f5bfd9acedae64edb19e5a1e",
      "text": "Pembayaran nontunai membuat saldo mudah dipantau.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0220cbdbc48fe807e073ea973dada0cb4e89af468d8b335765fadcb8102be0d",
      "text": "Tengkulak membeli rumput laut kering dengan harga jual yang rendah.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0d014d8a7835910b9a96e9d77d5fc0c5a9d7b57ec5278448bd93fc6bdaa64a2",
      "text": "Ekspor batu bara dan nikel mendorong pertumbuhan ekonomi.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0d80c1c998ea8dfdb3f336e2b1fe86c5b340535cee874bfb5ceeb1035cbbb07",
      "text": "Oleh sebab itu, daya beli warga turun, ya?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "e140986aaafe0af23bd78f698df42a7bdf45d9bcf263ca0e5f7caa0d86435a5c",
      "text": "tengkulak",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2759e73825824c01752c7bcc03ea27cd6474561e3cb25e093bd933f422e218f",
      "text": "Mohamed, coba jelaskan berita ini: \"Neraca perdagangan surplus lagi.\"",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2d72ac7ea07de64c6d330d1b3a559db5eb3c23ae11a553a520c316ef4fc849c",
      "text": "Dengan modal kecil dan pemasaran daring, banyak UMKM bisa berkembang.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "e344f2f467858c4af0fd340fd526522a4a7baed72ab477107b7207af9e3417f5",
      "text": "Nilai tukar rupiah memengaruhi daya beli masyarakat.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4c4bd9e668c451bc3ab72b9a5bf5c2ffcf12f06d559873a649510596d00ed4b",
      "text": "Dengan inklusi keuangan, semua warga bisa memakai layanan bank.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "e601004a75a2f31a1eaa61a84b975d20c91953272624630245181e45a8b75691",
      "text": "omzet",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7059e979e661b78211031ed14bcd626f2afb9d8872fb55d0bb68784c4410e34",
      "text": "Sebagian beras didatangkan dari luar Papua. Ongkos kirimnya naik.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "e8fd877af1c9165d8a8372fe8474f9d128424c5ea8a759666687fe5bb1cea0bb",
      "text": "Setiap transaksi QRIS tercatat di aplikasi, jadi Mama tidak perlu menghitung uang kembalian.",
      "voice": "id_gadis",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea892274526b69b8cb1bf13b3d8eb83d16d2a854f517f6552e34bb993ba75249",
      "text": "laba",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ecb26caaec43c8fd9258e2bc319226a4ff5e245c9044607aec8042b354c74838",
      "text": "stimulus",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee23b8d92a69c2e275e9ddd4395cb2b635b5c91fa8d35ee75e3c1119b9d9ea16",
      "text": "Mohamed, keponakan saya pinjam uang di aplikasi. Sekarang utangnya tiga kali lipat!",
      "voice": "id_gadis",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "efdbc8d3fa652ee18e481a7b810ab63e5e8fbd55afcd35354db4dc284026f12f",
      "text": "Pertumbuhan ekonomi Indonesia sekitar lima persen per tahun.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "f24df417376558c0d8f9be0d847fcf129e6e524e95dac783f0f536af3b777444",
      "text": "kendala",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "f2676ab98b7d14a06ef19b77fbfb88087c3f93cf55ccf6dfb8bf63960a395c09",
      "text": "Itu ciri pinjol ilegal. Bunga majemuknya juga nggak jelas. Dia harus lapor.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4dbe84d4c5104fd85a87533a8d0b2fa5ff075f849f1040343010009517c6b82",
      "text": "Kendala utama kami adalah ongkos kirim.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f567d1a124058ed7d274a0cbaa9d9d4f9c3971ac162f0ccc4b6cf9d057c14cbf",
      "text": "Silakan pindai kode QRIS di meja kasir.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "f6c6903ecc98d5da6c1b256e1b5b262027ae36e2bebce91bc13f140f2c1103ea",
      "text": "Pekerja lepas tidak mendapat upah minimum atau asuransi.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f75c621cbf3503ec359260e724b2af2690569bced8827714b3158f67bc39a873",
      "text": "Adil banget. Yang lebih aktif, dapat lebih banyak.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7dee8dcff594739e7a7fbe4d346798848aa5873a8e31ef95c02592a447e1986",
      "text": "Bank sentral menaikkan suku bunga untuk menahan inflasi.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7ebf4a667205b31689f0ec22821b1c51b76d4fb7577ae77dc14bcc16b24643f",
      "text": "Uang simpanan anggota dipakai untuk membeli perahu bersama.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "f86cd472b4e2dc0bfc2577960ba2f069e071afa8e6d07087bd8813aa2aac0802",
      "text": "Subsidi listrik membantu keluarga miskin.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9e1691ea564d8b02c0e6227b77b26c6e32de9a7db08571df69e9cfcf9935789",
      "text": "insentif",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc084838e60594c676175cb16e342975560424af9f09f61b21c337cc32be5ca4",
      "text": "Setiap pengusaha pasti menghadapi kendala.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd002981f0b7d70ed35e2332148b29daa1d31d7312d031f1fa6c61db7b5db0c7",
      "text": "pembukuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe6ce28be3d36cc8659dce793e382136e194311fbbdb3309da162e27ffcce57f",
      "text": "Pemulihan ekonomi berjalan lebih cepat di kota besar.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fe85610b337a69268c0466088418f7764c5c9ef994e3bd4dacbc520d5ec15feb",
      "text": "Bu Frida, mengapa harga beras di Hamadi naik bulan ini?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "fea717480f17c5fa54427744b5d8edf5fcfcdc8623084d2068243a72148cea3b",
      "text": "Omzet kami naik, tetapi pengeluaran juga naik. Jadi laba kami tetap.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff77ac17661d5be73f7925c50966dd59a609e5a56257bb95445e88c03d5e06e5",
      "text": "Dengan koperasi, nelayan tidak perlu menjual ikan ke tengkulak lagi.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 14,
    "clips": 202,
    "chars": 8218,
