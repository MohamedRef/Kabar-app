    },
    {
      "id": "bipa7.u09.l13",
      "sha256": "14bce7dd9956fda2aba03a07ec650206a326ffd1420b754294cbdc0d34bf3754"
    },
    {
      "id": "bipa7.u09.l14",
      "sha256": "fdb7e3630802fc9f0c8a7b058d9fc466aad0ce8312facd18807526324a3d801c"
    }
  ],
  "audio": [
    {
      "key": "00274e3f93e645cbce1402d9a8e43cc98c953a518f924b4159e4f1568953fea1",
      "text": "Program moderasi beragama diadakan di sekolah dan pesantren.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "0073ec68864fa152ed569d8ee4045f251825430b651e1695d1925a0ae6ef6b2d",
      "text": "sila",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0266e599342bedad03b027f315e292ecc1f3b7834869cf66fbf2fdcd68683883",
      "text": "klenteng",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "03eaee5cefd1fbe1d4c1d14e79625ce1853a16e3dab88d4eb6ed0f7c5b798954",
      "text": "Kemajemukan adalah kekuatan bangsa ini.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "03ee777e5c5a2ef4cf9434665ce33158dce435ff2edfbf36c6a1811d83492c59",
      "text": "moderasi beragama",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "08dc62f175d8f809ba716c9a7f72f20c457c70ed60363a610ca0f05f1d3476dd",
      "text": "Ikatan pela gandong menjaga kerukunan di Maluku.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "09d6c386509b61dfb6a149ec3adeab7e6d67d871497a47149a85dc041a27f804",
      "text": "Kakak hebat. Aku kirimin buku cerita buat murid-murid Kakak, ya.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a37dd9bdce693ebd6aaf9a89e2eb371365ecab8206e452638f239362a9c7cbe",
      "text": "Nyepi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "0adb4a9ebbe979aa359d376f409de64af5f1a176007107be1cc906b0ab2db57d",
      "text": "mengucapkan selamat",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "0af0ec70cd4dc64a8ead31ace311a2e08e08650360bf84ecf9e7c363b58252c5",
      "text": "guru honorer",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bba67f81bcbbea77c8cb9fe5fd32fb7e395cc50bdcced506de10b3bd91be4ae",
      "text": "Mama saya orang Passo. Waktu kecil, saya ikut membangun masjid di Batu Merah.",
      "voice": "id_ardi",
      "chars": 77,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c0710b7c33f234eae2fad9c45fab1dc55bea43795d0954f17b6362436e0e648",
      "text": "Jangan besar kepala, dan jangan juga bermuka dua.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e9a2cdc3901e522dc71ae29bc84655d4bb4f28af085fbe6d52c30887525b123",
      "text": "Mediasi para juru damai menghentikan kekerasan.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f5411661a930d4a62547a7973cfb6f32d1655ad50a93ff38fe232655d99cce1",
      "text": "Tenggang rasa dan saling menghargai adalah kunci kerukunan.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "11e6696b882d90140440b8312502b11f4b1a3c2c2ed4b61f21ffa435bd679369",
      "text": "Kalau begitu saya bilang, \"Saudara-saudara yang saya cintai\". Lalu saya cerita tentang pela gandong.",
      "voice": "id_ardi",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "13ec66c03df571ccd417bfaf949109eb912d1fb8e5dd8174822a638bc50be9ab",
      "text": "Bapak sudah tiga puluh tahun tinggal di sini. Bagaimana rasanya hidup berdampingan?",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "171e8c9b9f0d1619580051de174bb02249a671461ca73581472fbb60b9c47d99",
      "text": "empati",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "176c9fa083c80038a810280533c89678aad47fc1766850cd1b02c89412f33d18",
      "text": "ujaran kebencian",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "1839da44ac1ae8473bb2a30016a3d4dbee7f53f452420687c201c81c30422401",
      "text": "Itulah kerukunan. Kamu sudah melihatnya sendiri, bukan hanya membacanya.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "188fb3712a6995e02fc752a2dc117bd7526b412915b1617a628d53c5d3e64b86",
      "text": "Anak-anak di daerah terpencil berhak mendapat akses pendidikan yang sama.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "196e8a6770d324f393986cba9d815040fef89a9e8dc57da06938baab7da85a8f",
      "text": "Upacara panas pela memperkuat ikatan dua negeri.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a3d93964287e38ba195b67b9f26f18fbc04a98370ae4640f9c9b0bf7b55fdcf",
      "text": "buta huruf",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ab751ac239ee7bee309fc134eddd121ce0bd25759e6bef5f3ffadf2ced5916f",
      "text": "Dasar negara Indonesia adalah Pancasila.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "1adab7902a351aa5861c3207127fe18bcf009e55f6c5b43cf6b7ced2a9ec79ea",
      "text": "mediator",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b6d7b720aca378af39ab8d3abd49bb66bb696f1e8c3747fd17975ddd7ed01bd",
      "text": "Warga melaporkan diskriminasi itu kepada ketua RT.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b86c61aadc32199104454e272b942f46fb337342efc5f09f5bd148e241fa849",
      "text": "ekstremisme",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f217d92e4fcbb373dfad6215da7c284455c5f41e2f7a56aca431b0e9a050f5d",
      "text": "Pada hari Nyepi, tidak ada yang boleh menyalakan lampu atau bepergian.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "205517ecebbdb158896dd04f32ba119c51953271bd1a999a1deac987daa0ecbf",
      "text": "prasangka",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "22ff9402cfbd9f74c3079695a1b291e42cdb7987aaa4daf689fbe2dfe9d3e7fb",
      "text": "Penari perahu dari Kampung Asei lagi naik daun. Semua orang mau nonton.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "23c5930e7736430ddbc351fa5ced0260225b1700462ebcab216b9a818eacf3fb",
      "text": "Saat Nyepi, Bandara Ngurah Rai di Bali tutup selama dua puluh empat jam.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "24dffb1e517490468252b5d7f816ee81c4a6ac6925208ed523820631c1c06adc",
      "text": "Guru honorer itu digaji sangat kecil.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "26056792d1997ba8285433e056463585dd3f8fe4746adb584e4f83cb45f16884",
      "text": "Apakah hukum adat membantu rekonsiliasi?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "2632290d99572614de1eed7847382405404028c636563816c72283c453188968",
      "text": "Mana sikap yang sesuai dengan moderasi beragama?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "26bf05d440f4fdb1fd4198219db97c759fa709fb9046f353095de2f315e79a16",
      "text": "Selamat Hari Waisak! Semoga damai selalu.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a24e5ae428b6d7ce4b0db94e86dca5dea37a22fd07cbaf871e7cc96201c6d6d",
      "text": "Siapa yang biasanya duduk bersama dalam dialog antaragama?",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ec4bc5384d9e2283649feddefd95e4f806c0c3b4313e34856b7f30d001d37ca",
      "text": "Para pemuka agama memimpin kegiatan lintas iman.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f1b333c98a2f6674f3b6415cd8674d86ae76103c11e8e3c6634c74d6019f72f",
      "text": "Tentu. Yang paling aku suka sila kelima, keadilan sosial.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "2fae221ebd17e2f952fe69768273a69348fa7a6e67b205c54145c275e3011bbd",
      "text": "inklusif",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "3146ec102e43c2c6c061687ee0610d14a2cca24cebd41bc00cad014d89623dad",
      "text": "ketuhanan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "3607d9036ab84996eb22220c86cd37caaa2da18d7da7250d7632027b99bac370",
      "text": "Banyak korban konflik masih menunggu bantuan rumah.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "37f575ee32a802ef97e67b55b8dca5228e92b47494c06cfc3a3df7631a5116b0",
      "text": "Pancasila",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "382623c11ce317c2b707bb34aa50b898c6fc02aef9ff0301046a09edf25cd368",
      "text": "pesantren",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "391cb4b6213eb375cbd65c4ec70aa5cd4ffbedc14509bbf4ed43d3af9740d555",
      "text": "saling menghargai",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "393195dd670efc91b991f18c1a73950369ab91ff284e4ae6c74b34de2eb64c1c",
      "text": "keadilan sosial",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "395ddd9fbb140e2836fbb1e9577c308ac29a328e1a52ecae4ed3aceadd4680e3",
      "text": "kesetaraan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "397b2bc80ad7b27ac9a3a4e37b2a3c12ae46ae2c80eeac454471b33f2df2b8a7",
      "text": "stereotip",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "39bfdbd78d55d41eb1f6947b3661009d5bfaeedce32c9fcc67acaf8de7c44eea",
      "text": "Itu termasuk daerah 3T, kan? Sekolahnya gimana?",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "39cb9301430a50f7ff3059aa6f5c3ead48743ee78f7eebfe032d984db948a4f6",
      "text": "Para pemuka agama bertemu dalam dialog antaragama.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a8ff0f931b9d3198c27191478b47c4e3ec8f525e3fa1159ecf22a9495b306d4",
      "text": "Indonesia memiliki lebih dari seribu tiga ratus suku bangsa.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d9ed0c2dd883f6e1f71397da81e4f4868888a1bfd8611eece4bce5282ae28ba",
      "text": "Indonesia punya banyak hari libur nasional dari berbagai agama.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "3df91c1ce8fda752d744635301a9bcc23f2aee4a0e8706ee308114020828f868",
      "text": "terluar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f353aea6b119e61b1eacb2cbaf65d59c3251a507543320aed7290df0c0a9868",
      "text": "Banyak. Ibu-ibu dari dua pihak, pemuda, juga tokoh adat yang memimpin mediasi.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "444152a54759d3d10770f2a709641e6ae74a8a86d77195b58a1d62cd86d11df0",
      "text": "pela gandong",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "4526fe17ba9f1405407dfe3fc8f2cc8d7003e587e83043f669689eca06412d05",
      "text": "Ukhuwah tidak hanya untuk sesama Muslim, tetapi juga sesama manusia.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "4746eea68b99ab39cb0a63b416968241fd5b7a716b00e00ffcee3b16c619f182",
      "text": "Sekolah yang inklusif menciptakan masyarakat yang harmonis.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "47f63d1c7254797d6103962bd1f1f35674b1aeb2a5f9cf07847547d3431faaf7",
      "text": "pemuka agama",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "493c3349dcfddc24652c86fb2497a98306bc59f621dbb2231c2bd5a9bb8f9ac9",
      "text": "radikalisme",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "49982ff5ac6e9ca9cc13b36895fe5bc2bd2a4367175ef866a850a44280d2d9e2",
      "text": "Festival tahun ini ramai banget. Penari perahu datang dari banyak kampung.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "4afd2c17bfa346d1746fec5e28ae003e51d33716b149d5b723fb48748f1f9203",
      "text": "Sangat. Orang ingat sumpah adat leluhur: kita basudara.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "4b91026fdef9c6a8928076bd0275308dbb90eb36f98ca226202a05e2415ab3ff",
      "text": "angkat tangan",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "4f00f6cef0fa5653a57bbc01968dc4143a681eb38ab113cbbd638d2240d42b64",
      "text": "Imlek",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "504e77829b39ee404b7a88ddb6ffc96a9d0f9fe2e61220a9b35ad79703b70e88",
      "text": "Bhinneka Tunggal Ika! Kita sebangsa dan setanah air. Terima kasih.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "50709316afd538654e053b93e6b84a38f1501d133bf3ab6d0500728c0943494b",
      "text": "ukhuwah",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "50ae22f6090a5e2057804f80490be83a63af3caf2f28473e2ea7875473ab7a2b",
      "text": "terpencil",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "50e9675762f4e09c06763eb217b00003ab6edb772c61326d85ff52ab4526fcbc",
      "text": "Pemuda masjid ikut jaga keamanan. Waktu Idulfitri, pemuda gereja yang bantu.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "52dd5288623bd2b9def019f98cc5c68ce31f801743875fe6b24732a0f29388fd",
      "text": "Stereotip tentang orang Papua harus dilawan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "541139c57aaac8808ecfc87c96ea1e37f135b30a292ad9082274fe56308926ed",
      "text": "Apa yang terjadi setelah kekerasan berhenti?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "555b816c3afda9c71205ad81c4d9c929be293fa0f86ffee816069d3030232f61",
      "text": "rekonsiliasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "55b4187626d0314a67ea06f637f58caeb3f9248883633de017b15d7d96a02d8d",
      "text": "dasar negara",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "55f2042b99806fc9f36561ebe66a3a60f9edf90cc38f6df6924b3ebcbfd1cfaf",
      "text": "Menarik. Jadi Pancasila bukan agama, tapi dasar negara buat semua agama.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "563b469c99ca5d1a68dd1662698f51d980f05a189fb18b9e851f20004e25c20a",
      "text": "suku bangsa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "567541d28158048e8f92ec1a03367c3456b29efc04b785017123acc310df8487",
      "text": "Karena pela gandong. Leluhur kami bersumpah kalau kedua negeri itu bersaudara.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "56b655c3311f2c7a3b3dc4e53b763c6f910359837722a788ea056403b7d67d1a",
      "text": "rohaniwan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5d00ce6e4623d39e7e4bf1f4abbd9d2c1514cc0771998bc6fcead7b98c450a34",
      "text": "Negeri Batu Merah dan Negeri Passo punya ikatan pela sejak dulu.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "5df57d4ef347b3da52ca71e3414ee2c2f95b8cc9f014ff688b1b25906c45118a",
      "text": "kiai",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5f5fc8c89a3cd13a40a8f3b41dcbb8460540675a15ac2093472aa3eb5ae48a78",
      "text": "Di sekolah dulu, tiap Senin kami baca Pancasila waktu upacara.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "617cbf1f078bf41fc47e08e6b7f7876069b8a44f718f36ef5453f436a7282add",
      "text": "kepala batu",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "618db0b24f5b21731a1dd76c2e0b7cd3fbae3bb1ed7a0b98f4e503d1061ddf0b",
      "text": "Prasangka lahir dari jarak. Sekolah yang inklusif menghapus jarak itu.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "62b77d7e6e2650aa6fe301810f8f935aa8696ae36d9d994eb5d08d905a4cc869",
      "text": "Bagus. Tapi kamu kan bukan orang Indonesia. Nggak aneh?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "62c416ef69b62fabfffa0a199ee7e15e78d126854f83cfbc36a33c0aca897500",
      "text": "Yang saya hormati Bapak Kepala Kampung, dan saudara-saudara sebangsa dan setanah air.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "63c85d5cf22acf68250e3aac84355ba09e304804f172272188a342c662d41a59",
      "text": "Mohamed, tahun depan aku mau mengabdi jadi guru di pedalaman Pegunungan Bintang.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "64337f60d48387a903a510f7cd0f4ef745037d2b4eb82bf2dfe304cf1aa63a63",
      "text": "Dia tegas, bukan besar kepala. Dia cuma mau tarian adat dijaga.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "64fb1b70e2d16101b2c0647a99f067cc30b8d2bb5fd619c4ed3cdb1674ef937a",
      "text": "intoleransi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "67fd6635d8311d569de298c2441c52bae8d678db2d9007d9710e8397045eafd7",
      "text": "Berita itu tidak boleh memancing isu SARA.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ae93df2631a254d4c01ad7a8a8435cb72a3eb53abe1c60f0fa2e8c1c63ef3c8",
      "text": "Setelah juara, dia jadi besar kepala dan tidak menyapa teman lamanya.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b331386c57aba5eef1c3e8795236d74de660161fd78133a1131f9448c4f943c",
      "text": "juru damai",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b5e363b540ab8384eefc6efa39d4de3af0ece0ec4dbaae5e9764b5339c2672d",
      "text": "Radikalisme sering tumbuh dari rasa tidak adil, jadi deradikalisasi juga harus adil.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c697dc79fab4bc410691188ed4bb33c43857bdbfd0e68fd4837688061a623bd",
      "text": "Prasangka hilang ketika kita saling mengenal.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c8a1b0edc790c99b3ec9591d7e8d7023364011fde59f20be16f1aee1be04c9c",
      "text": "Waktu konflik di Ambon, saya jadi relawan di posko pengungsian.",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "6cef50b2f72b815d0030686b80d5830bbd7b05ad3b1fc1680dee075ca58a80d9",
      "text": "bermuka dua",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "701d3968d2f056963e0f758c9f553445a7c12a1802876ebc23dc2023368c63b9",
      "text": "korban konflik",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "7039d4a3b17bf4585b8190cdf9560ada7760c0d8890eb06c87a7dc08b0183479",
      "text": "Itulah Bhinneka Tunggal Ika yang hidup, bukan hanya semboyan.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "70a06806ef6404515b80792f4aad61b3cd5877c423c0aaf588fc672f3c268d4a",
      "text": "Aku pengen nanya ke kiai di masjid soal pesantren di Papua.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "70c380bd89a62af22b72ddc3b5c911793caa62f3c7450b5de47a3616839b112e",
      "text": "Dia pasti punya empati yang besar.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "71896a1781be30593f09d66879643c140354ae603d0aefc8e2d68b6808c84cb4",
      "text": "Lihat, gereja dan masjid itu berdiri bersebelahan.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "71bf5c4fe490eb4d084fd69b0123f1349720fc65d823d76ab489fd4ab5d722bf",
      "text": "Kakak orang Kristen, tapi bangun masjid? Kenapa?",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "741020ab99a14a80ac3a346f8afe6571d24998515840f142a56762a850f11a49",
      "text": "Kita ke mana aja, Kak?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "7686689426f1e0c4b18c20c37531a7eae51c1f44661fe143603234a538675987",
      "text": "Saat Imlek, klenteng itu penuh lampion merah.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "777a84ab1f4dd9575ef70a5231f4c6d65b757d206085780e425d4f08200fd0ef",
      "text": "Tapi kata panitia, ketua kelompoknya agak kepala batu, ya?",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "78d619e4801742da1bc0d2fe0130012ae3b541458955522f4f0ed03872f0f90f",
      "text": "setanah air",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "79028050f30887fd54ed16f5597bc52ae58c1050c2db37bde1cdaf1925344ed3",
      "text": "Bagus banget. Tambahin satu contoh dari Sentani biar lebih hidup.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "79525b07dde44c5f6d09e6abaca5a8e4be24945ccd6338c3e0a384868fcb9a55",
      "text": "negeri",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a0fac4a920b525c25bf0dc4140ea2bbe02dc740e0c0971a39f44c62cc69e82d",
      "text": "hari libur nasional",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a7ff56658fa2de4f515556f5ab26dbbf9374900cfba29f5a4bfae8254830d32",
      "text": "Ya. Dia bilang, kesetaraan bukan slogan. Anak Arfak juga berhak bermimpi.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b4c80fbf98f7be776f54dc893e188cccadfb21ba79b8a7cdb3828bbaead9e0e",
      "text": "pluralisme",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c0673ef5838f0b9b80737b4aa68204f84821389b4ee7e11574790f06c8cb6b9",
      "text": "kerukunan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7eb753f09e9cd461a3ba8c7f094d90f0390665756a0d875036e63bbb57af2560",
      "text": "Bhinneka Tunggal Ika",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f0378cc52e138e9943035c28d517bc7a692fd0e633e1e1d4d56481c1208ef79",
      "text": "Di Mesir, kami juga mengucapkan selamat Natal ke tetangga Kristen.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "7f3ed13e15bbf0fd38c8ac87d5c37b443177091ea1801896040933d7c51efeb9",
      "text": "hukum adat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "809e7b5486ff8b0fb93cc2ba5533bc553c1770a0b5dbbc72101878d1f730d0e7",
      "text": "Kami saling menghargai. Saya orang Bugis, tetapi anak saya fasih bahasa Sentani.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "80a649626eaf8113686715725d85d61742f584b41530adb1e20c77b8e747377e",
      "text": "Mediasi berlangsung selama tiga hari.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "81fc3f29d43e2fe2b16d069aa5cfd2a5247db4530eae84c3608f80899694097f",
      "text": "Apa yang dibahas, Pak?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "83f0ff316164a1ee8be7f6a2eff6d65fbac6626c9e8462fd29ddc8e84a0a0a71",
      "text": "Dialog antaragama membuat orang saling mengenal.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "84bf69145808f0d6e0e7d6eec37e48e04151de2d9ffa9b34c1b986f088961cc9",
      "text": "Pernah, soal diskriminasi sewa rumah. Tetapi dengan tenggang rasa, kami selesaikan bersama.",
      "voice": "id_ardi",
      "chars": 91,
      "mime": "audio/mpeg"
    },
    {
      "key": "86134915702b1a01da2221cc98cfc4194e5b3aa78c7ed67d66dcc748789b0df0",
      "text": "Masjid, gereja, klenteng, lalu vihara. Ada rohaniwan yang menjelaskan di setiap tempat.",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "86eb8a16907af3176024e8b66164326a400095d41f5f71697a3a3ee5c9d2c521",
      "text": "Dan penontonnya juga beragam. Ada turis, ada warga Bugis, ada mama-mama Sentani.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "8907fd69bc2233fa450ca01e8d6a647f324686a3b2fd2481e314c399c3fd97b6",
      "text": "angka melek huruf",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "89114a3139af9b2986a8214a78d622b3c25bec5b921e831d664fb5704b54a2df",
      "text": "Biksu menyambut kami di vihara.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b0a84226747a16db0868c565f6ddf6eac35c23c91b3d5409b7753fb9912c495",
      "text": "mengabdi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8cbe961f87b9c07d6fa710acb8ad204da26cc203a1bbee1d4ae2ada21d8e2e86",
      "text": "tenggang rasa",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8d1c9aa92af09f566ea9e6570709ac143155a282bed49614cd3ea7078a0c1d0a",
      "text": "Panitia hampir angkat tangan, tetapi warga datang membantu.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e30593f98890320737d66c98229186c6366c9d228b6d9299f38a4ebf9544ce9",
      "text": "Satu ruang, tiga kelas. Beberapa orang tua murid masih buta huruf.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f0e089f1d432105593b8b2b4e5ce3e0da1c1043bb7c1b0000d3320355d54da7",
      "text": "besar kepala",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fa368d6f32cb5742c5e1fe8473ad6f7e7cca8729a7313d91d8e0b25c45fdf42",
      "text": "Moderasi beragama dan pluralisme menjaga persatuan.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fda55f651734ed5b99bd9ff5aab22b60a9916de117186c9fed7744aaf09be2b",
      "text": "lambang negara",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "9095177c256950c5007e4d478d5b4ca1ca403da1ae697c074f133891d907bf41",
      "text": "Pulau itu termasuk wilayah terluar Indonesia.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "91440a3e473ff50cb600e4c2cce8c3924dd7b6eb0cede8286f0c86d92723476e",
      "text": "Mohamed, minggu depan ada kelas moderasi beragama untuk guru.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "91bbd45359cbb718dc43288131640338c8617082b99892fc26251759c1f1e34b",
      "text": "naik daun",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "9463d1470893ea6e089cc77be97a5cac4fdbc332f8379dea11c6b37d681f7910",
      "text": "hidup berdampingan",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "94b1e12d08649edaabf26388083de30a23c23772dadddccc14e0cb2be5d7f1cc",
      "text": "semboyan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "94ceb27aeb6a7791c2a4dcaa7947eb2ec1aafc1cead333aeb9c233e87a841044",
      "text": "Orang dari negeri pela harus diperlakukan seperti saudara sendiri.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "974f5feed3ee1b2c665583d579ba5893ed442a82fa45ba218e9b1a73c6dbefde",
      "text": "Waisak",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9af97d4de4805232c45d88ac68aea0243c7aa8c8f640fd277a2f4edb9f4c0fcb",
      "text": "Saudara-saudara sebangsa dan setanah air, malam ini kita berkumpul sebagai satu keluarga.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bafd9b7b8d6ad552d3cee2ec337db94066f5db8c6595f45684df0ad728706cd",
      "text": "Mohamed, kakak saya guru honorer di Pegunungan Arfak.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "9f794cb7cd599f4df78579a0e8cc8eedfb594b6900ea6569433f734daf018237",
      "text": "Itu hari libur nasional. Ada Idulfitri, Natal, Nyepi, Waisak, dan Imlek.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "a022e46cbbed942eb0cb5f8cdc17d965aa7a3ab42c07979c090255bed547fa1f",
      "text": "Saya berjalan kaki dua hari untuk sampai ke sekolah di pedalaman.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "a05a83f8225f9d2354309ca63898031906ba2495e81a04388fb657deddf92bfb",
      "text": "lintas iman",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "a06f39df0e221fb7bd0fe8c3827f14ab1fc3c97a30cd1ba95a2446e4ea9fd34d",
      "text": "Angka melek huruf di kabupaten itu naik setelah ada sekolah malam.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "a291c833308a2beb21d17180586e947731127d0b1b4f213055e0115fe42a53cc",
      "text": "Bhinneka Tunggal Ika artinya berbeda-beda tetapi tetap satu.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "a367a8fc25db56f29fcfa3e543a1cabe885bec8d645bdd29fedebd5261bc21b2",
      "text": "Boleh. Di akhir tur ada dialog antaragama. Semua boleh bertanya.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3e7b821f8d84a562a766a7d7916c078a53bc40b653f7c6e5efa44f87ca19686",
      "text": "Ibu-ibu itu menjadi juru damai di kampung mereka.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3fc3dc8c8bf92dd99dfd4b180035bd55ab7db28bb0c34bd95cadb9e9d311e5a",
      "text": "sebangsa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab1949a073ad16a66c7f3a84ce9b14d981d22a62689dc39e9f2256c655f6aef9",
      "text": "Ikatan yang indah banget. Lebih kuat dari tembok mana pun.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "abefd1100e66d0774234acc4fc258a86f9da3ed4464e50cb77a2a375de15041c",
      "text": "vihara",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "aea999aecdf4d26f25d25f68759c3e8fa70223b230c3c3fada2d4e8106e141f3",
      "text": "daerah 3T",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "afb0b2d3a4a80c40a857151e9b431b8a32baa0ec193c0ce1522a46a863640e86",
      "text": "bersumpah",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1608edd71715dd9ecd24fd1ae85e68994f758dc3ffb9c00c08cae46c210dc5a",
      "text": "Sila ketuhanan menjamin setiap warga bebas beribadah menurut agamanya.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b24cf7399863cf8a8de91af944f9c4976e3ad7a67e59e1f43a623c3763b2b043",
      "text": "harmonis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "b28c9a6d33901c9643f4abda32334049d8e9b54f2deb32bd5b5a79ce48481e1e",
      "text": "Kita sebangsa, walaupun bahasa ibu kita berbeda.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "b341569c78540b24f770bfed0b1b1044e9f0be8ba93ca9068531ad0961068123",
      "text": "Presentasimu besok di aula festival. Coba bagian penutupnya.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b76605ca6c11b9af380de45250ffba2e075da962ef15093e07b5f47aa5dc844a",
      "text": "mediasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7a46989b2072ca21c5e5874b686398b0e838782a550f15128d86dfec0fcd424",
      "text": "Guru itu mengabdi di kampung terpencil selama lima tahun.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b85cdb75c6ce4eaa83d79485857c62103da6528c3cf4fd9b87e07e992380c7cf",
      "text": "Laporkan ujaran kebencian, jangan ikut menyebarkannya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9fe9702811acfbd5aa757ab55f4c58c1e4a4e15e506198202b27a7f99519bbb",
      "text": "Setiap beberapa tahun, kedua negeri bertemu untuk mengulang sumpah pela.",
      "voice": "id_gadis",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "bb4c28253fe767cbb065469af042b44f421e77ef3f0e0430cfebe41fc60c276a",
      "text": "Waktu Natal, gimana?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc2424ab8482c85469941f0c9a11fa8e2f6773cecf190bdbb8787f455e2bb028",
      "text": "Empati lebih kuat daripada stereotip.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd0bab39856fef4490ecc47947642b5bbfa75a685fbfb01e6c6532470a6412ab",
      "text": "Semboyan itu mengingatkan kita bahwa kerukunan lebih penting daripada perbedaan.",
      "voice": "id_gadis",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf0f2522c7a62b9208c37d8624b29ce24e3d12f055cdc1525edd5c9a55646d26",
      "text": "Di Sentani, warga dari berbagai suku bangsa hidup berdampingan dengan harmonis.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0af107b7ccf2cb3bbe23df686dfb569b92426508d6ebf9c1c8522bbb1396139",
      "text": "Gereja dan masjid yang bersebelahan. Itu bukti masyarakat yang harmonis.",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "c285c9d0ee328d52039257d6f99e20db94ff921478c098c3eda5dd002fe4818b",
      "text": "Kalo gitu, aku salah paham. Maaf, aku nggak mau bermuka dua.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "c421505fb7625231e810b8ada55ad0b3ffabc30c03263ecbabb05147ee7c2306",
      "text": "Sekolah yang inklusif menerima semua anak tanpa melihat agama atau sukunya.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "c64725018461940ae500e8121167d6d08f9527cc4efe4b1fe7694328b29267ab",
      "text": "Bagus. Kamu bisa cerita soal ukhuwah dari pengalamanmu.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6cd705785a2509e1a7ff6f3f38b61ec65dbc13413cffd9f5000af430afec866",
      "text": "Bu Guru Rina mengabdi dua tahun di sebuah kampung terpencil di pedalaman Papua.",
      "voice": "id_gadis",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9203634d935c06c4b2ffd7745c3d7462b7cd841ef29499a176aaef33bde2e8d",
      "text": "panas pela",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca31d77ab894ebb213e8caa7ed1aceed78ed6044b1868cb8b4b34fc84642ff11",
      "text": "Waktu Imlek, kota Singkawang penuh lampion merah.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb93e50b6de0adb1352f4c2eca0d762caa3bcddcf1afecb8581d85a1050791f4",
      "text": "Tempat itu terpencil banget, kan? Listriknya gimana?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbeecd5cc1e07445ec0b398adb4a94549219ef6f0c9f8d653dbcb538842c779b",
      "text": "Kampung itu terpencil. Hanya pesawat kecil yang bisa mendarat di sana.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "cf15f75ce792a8d830f54983a363ccfd9e7edf6c3039addf78da41aac34ccfe2",
      "text": "pedalaman",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfa295fdc8eb891acaf78bcf69fffaddcf549d666fb94cbf89a434bbd643b3a8",
      "text": "akses",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfcb17ab3d3a0edf7ba041ab0f40e2dc20de3e41a359d2993ca89009d8297178",
      "text": "Kakak masih hafal kelima sila?",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0e68bfc5e90bac1e0ec2720a0b9c46e0d75d5853ebe14cad39b40b5122dbd8c",
      "text": "Pela gandong mengajarkan bahwa beda agama tidak memutus persaudaraan.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "d26a32dd73297163c57f17250e50eb08b2624bee1cf88ed3b2c824697a7dbe86",
      "text": "sumpah adat",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d286430dd7a4a599f830f451c7dec4249c3eccdd5b8364130ae42f31f9e0bdc0",
      "text": "Apa arti \"kesetaraan pendidikan\"?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2e5f846641868dc90660d4ff9068907887f9145c911503fa91b41e0e6f1adf8",
      "text": "Cara mengenali radikalisme di internet dan cara mencegah intoleransi.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "d32b9f460a37491ba43b3318c4207a14a89607b5f524dbe7ec48ce3c82c054d7",
      "text": "Tanpa akses jalan, buku pelajaran datang dengan pesawat kecil.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "d453679ef43f7d0c60b601ca391b6e780de772ecb6037eebbddf3a7e2f4fd8a1",
      "text": "Panitia festival minta kamu pidato lima menit soal persatuan. Bisa?",
      "voice": "id_ardi",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d516f3f9bc8bea1ef6bd77b466f7eb0f92feede75db77236b01afd413d5a38cb",
      "text": "Di kampung ini, warga saling menghargai walaupun bahasa ibu mereka berbeda.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5b9bf613598717bb943ebae61d2e504b38ea2b067fb35190245eda92879f26b",
      "text": "Empat suku hidup berdampingan di kompleks itu sejak tahun sembilan puluhan.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "d76b53d89704c6e822d5e193e3f407c277d7e10ff20d04ee431f1208661471a0",
      "text": "dialog antaragama",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8beac4c8a4c8d7ea2ec9dce420da1d8e3c5b3d49dc61c7cc7612e192ebc0f26",
      "text": "Walaupun berbeda suku bangsa, kami hidup dalam kerukunan.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8f9d4196a0e512957bf9268ac2eeb54b153f3fdb814a91574a575dc313975e3",
      "text": "Di Al-Azhar juga sering dibicarakan wasatiyah, jalan tengah.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "dabc1683e65feb15f5a4cae144fdd3c9083ccaef4a99d5f0884f1f02cd5842f2",
      "text": "Ikatan pela gandong itu lebih tua daripada negara Indonesia.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "db08284c9ad266145af77a9bfc8fbf6137dacd71af465514be90e0caec8cfab7",
      "text": "Sama! Terus waktu Idulfitri, aku yang datang ke rumah Pak Daeng.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcdd6b5fcf451b4e20b3d3b2dd12c314eeb61380787571aa558a3a458fd67fd8",
      "text": "Sumpah adat leluhur melarang dua negeri itu saling menyakiti.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd38c30724d8b2b2882bd855ba6abf36160748f9c01681490c159a4d779d427a",
      "text": "Sila pertama Pancasila adalah Ketuhanan Yang Maha Esa.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "dded6c72191c1c3f8f9ac466734f5796259b7f3945948c56014ea8e61b596f91",
      "text": "ikatan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e01617b2134fa61b4e112af0a0a072fabd44592b7813d988440a77650f8fd6d8",
      "text": "Siapa yang menjadi juru damai saat itu, Pak?",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e23f1c0bd7cfca1274ed22037c8901b58f086bd9dc5be606ebfced973eb5f421",
      "text": "Bisa. Saya buka dengan \"Saudara-saudara sebangsa dan setanah air\".",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2a7f25fa8e27261b8a0a0e1955c73dce30ac8bf92a7620ff4df9effaa04a101",
      "text": "Makasih, Kak. Perhentian terakhirku Lembah Baliem, di Wamena.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "e459492baa696742339b70854204567a0b35a7d1e25c49942046a32c7d900755",
      "text": "Keadilan sosial artinya tidak ada diskriminasi bagi siapa pun.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5a0db0d8fa89b2d732b83edcc732f4c7e277505e48d241165436097201b9320",
      "text": "deradikalisasi",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e69a6304bb679bbf08c6363f352e1e524c23d6010a23e0e8d97406e812e64179",
      "text": "diskriminasi",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6f905e107628abbe03a20d9f12499af0982e77ff11c884450e3906ed9b89b71",
      "text": "Pernah ada masalah?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed94df8797fe712af075517bcd8575d2fb96c6288696c50e318fe769e3d0c544",
      "text": "Kakakku kepala batu, tetapi hatinya baik.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef4f6fbfb1e0299ce598273e55e2b0f631e658c23622cd585f763ccea3e00ba2",
      "text": "Akses listrik hanya dari panel surya, beberapa jam sehari. Tapi anak-anak di sana menunggu guru.",
      "voice": "id_ardi",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "f08980927fba35e1f718dff999fcf7f64b8b641aea74a87d3ffa5d864c8b4af3",
      "text": "Banyak guru honorer di daerah 3T mengajar tiga kelas sekaligus.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "f7adcc8f00d183537566a39d6a514573d1530159f8d7b434635f4a7231b1406b",
      "text": "Mohamed, Sabtu ini komunitas kami bikin tur lintas iman di Sorong.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9d16179899c889ea01104fe5dce46262567df0c3247b6ae0b028d7cb2bc9e8f",
      "text": "Kak Yosua, kok banyak tanggal merah di kalender ini?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbc3a33a162ac18131e7537e6adb1010754dc69af5f3f6bd9d18b986449d69eb",
      "text": "kemajemukan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "fdb9166ca34d5b7644ffd186237a6b84e67905662358b231f50e34f697f976c7",
      "text": "Kiai itu mengajak santrinya mengunjungi klenteng.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff7ef67864f9447921ba670d6b19bc041d1246cd4dfe9edcbed6ea2a95ab331f",
      "text": "Keadilan sosial adalah cita-cita sila kelima.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 14,
