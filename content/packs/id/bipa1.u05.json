    },
    {
      "id": "bipa1.u05.l02",
      "sha256": "9bee328fab8acd9a0574cda6ada66a0703312286c7fffead3078bd37fad29441"
    },
    {
      "id": "bipa1.u05.l03",
      "sha256": "9352f0ee70d43cc2f96b78eeac452da78a4dd71d28f095e962ebb30b07b1c8c0"
    },
    {
      "id": "bipa1.u05.l04",
      "sha256": "8ef4459ff266743ed2799009ce1f739a6696fff4ed9105701f5b0bc010c525db"
    },
    {
      "id": "bipa1.u05.l05",
      "sha256": "25f0be4c44d553ec0238a6361de89750eb7bba7bdc0c0f6357e538d7f9699e75"
    },
    {
      "id": "bipa1.u05.l06",
      "sha256": "dc83abb801c4d05bde1cd3d87a65f754c488177b8de272e8c197e1e229595045"
    },
    {
      "id": "bipa1.u05.l07",
      "sha256": "badd941a4d8ce0dc7294892a35b553110374f4eb2f59016cc661ad6e11e0f560"
    },
    {
      "id": "bipa1.u05.l08",
      "sha256": "0f60990f19b1917ea1d0e5db5be6f1ec565c3ffec7994c6bf14c64590c1d4a1f"
    },
    {
      "id": "bipa1.u05.l09",
      "sha256": "1298e267f6f29573fb14429932c834f8cb77cf0379c288869c4f4c099f5cc74f"
    }
  ],
  "audio": [
    {
      "key": "00887bddbd85430447bff06e509de95c56051a1a983b25d362e0a7406940c2cd",
      "text": "dompet",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "0197052f4553bd7352e29484023fabfe2786b6a52eb42b2483adc97afebb515e",
      "text": "langit",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "06f3d18e672b94e5c4e3820745f5b1276dd30c1c7a913eb763b5f07ca134192e",
      "text": "Gimana, seru?",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "073f5a64e5fd10ea9d1e5f7f20f4f5877bb78369aec71828fc10f508688d446a",
      "text": "Selamat pagi, Mohamed. Bagaimana liburanmu?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0c957b9762068e7fadcf3a02e68ea05de356621bfef5f2011af2e3cba221e46d",
      "text": "berbicara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec8c06e2078225cceccad9552ec9e138faf4e964c1f7c6b52759595ef187fb3",
      "text": "Maaf, saya terlambat. Sekarang musim hujan.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "0faa94471cb7f3faea6f8611bd84dcb8a66cdc278ed9892b3c02bf6f6a722d77",
      "text": "Dompet saya hilang di hotel!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "103f745b127cb216944fd9a0059ba1850fb240b42b763d92b727da0ea1447b90",
      "text": "sungai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "10b81e73984124bd83818a9f4304264f4c84d897b3a9cd3c8f3590efa375ffc3",
      "text": "Mohamed, gimana cuaca di Jakarta?",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "1125f417f6ce869b4bc8f67134aedc2e2d0133036593fcba5d81fb72fdcd5ba7",
      "text": "Halo, Mohamed! Bagaimana liburanmu di Ancol?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "163c12fce8ac2e3661aa3db99d17c8b23f6e59f5b68405e1f6edc59d9249e997",
      "text": "Pagi cerah, tapi sore hujan.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "16bfc2a006671e7fcf79e4c40e87ad47950670750ecc4bd06592820255224470",
      "text": "Tidak, kecil. Ada foto keluarga saya juga.",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "179980ea16e189805f5a26501bd17af5326aa7a61eb6d1c318f9e46bd4fb5da0",
      "text": "kamera",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "186e51659c8c29c077b640325d01a53e6d78a2e2abcb043aa812979104391dfe",
      "text": "Liburannya seru! Pantainya bagus.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "19c5ffb3cbbe01a8b78e0cc9eba5159eb1e2928f1ec4a5ccb904f2a11ea2fff5",
      "text": "restoran",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1ba68a0df09d0e602f8c8cbb342d2b0d1f6363e3095389c0c0fd870bd9639ad9",
      "text": "Saya bekerja di Jakarta, tapi berlibur di pantai.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "1cfd2ee2dd111e5ed628703fdc00fcc8f6fc268e5ffdf90f1a91fab8cb24f369",
      "text": "terlambat",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d0f1c7e3065f1d44052969c1931e922f9dcb633d8e7e23bc60d2bfd4c9b9a51",
      "text": "Hari Minggu kami jalan-jalan ke pantai.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "1e02b274ba770d991207f89cee50deeb0f650180b3365e66955f194e19e311d2",
      "text": "Cerah dan panas. Saya berenang di pantai.",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "200cbff9c48ae72ad3584147065b7b7b5150f98de94ec4b93928c76d8bb9633c",
      "text": "Wah, asyik! Selamat berlibur!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "20d94cc1ffe897b19983d88c23f21e0a3b6d15dcbe262c38e82d1a262a1600b7",
      "text": "hujan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "211e42c96b21eb6aa7ca960dd487aff10ef845eee0cdb94f29deaf08962d25e3",
      "text": "seru",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "221e8bd3ef66ce3a9efd384ceae78bbc104be6cb409370e995470adfd3fbb3b8",
      "text": "Di tas saya ada kaos, celana, dan kamera.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "22d9b2585ffc441f382360c57f4748acb082a2c5e08de857eb4ffe3e7a8dca78",
      "text": "Kami berlibur di Ancol.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "22f626fab333f8836bcd33e774ff1420f11f2fcb68ec3c10f48cf251358c9278",
      "text": "Anak-anak bermain di taman.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "26867adcf42df8ca3fbf6e5d6c0e4a503e188c3fef102352d0cc70a6c47e6391",
      "text": "video",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "26e1369fdfe7d5176d88a902b0b8d3cef8f9d97af5f2c9db1536dbcd3acf93da",
      "text": "Di kolam renang hotel. Ada kartu dan tiket di dompet itu.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a74098b9e0bbd65b84ea286890f22a07c18f04eb999aefefaacf0ac1227c318",
      "text": "berjalan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ac89772e758bffe48ac3383f549e59bf6e79b087ae15f1a5d47e1c10d5a19b0",
      "text": "Dompet saya hilang! Ada kartu dan tiket di dompet itu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "2b4f5e9fd3792c3006774fcc9c6bc46dd3fcfdf1ec4666b84aadfba2839ca641",
      "text": "Boleh, Pak. Silakan.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2be7936b9def3fe58da8a6e4a4b5d018f449d2bdbdd9761a62b05278b76de3b2",
      "text": "toilet",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "31326bc4e4e537ef3eff55dd58331522cee358d175266f18f7d02468e2fbd7fe",
      "text": "Cerah dan panas. Tidak ada hujan.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "33b38e41f8f6ae558e9c9fa160f774322eb05b8bc25f918a93a33873e8d3775f",
      "text": "boleh",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d7174c64878d77ac3ed57bc1939101a1f9465c7479aefc782c31d83a4bfe8f9",
      "text": "Di rumah ini ada ayam, sapi, dan kuda. Udaranya bagus!",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f25a3a3f74766eab6ed0049f5e3da59a99389dbc29490473389f3e10387c734",
      "text": "sapi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "40ee94f4a45d7c2fd85c243325a34bbfdb01de64b60330a93544c31f73ac2f24",
      "text": "udara",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "482791c57d69e71c6a25d9b638ace8d9108ac88688472b091bd12a85b1fcb706",
      "text": "Permisi, Mbak. Berapa harga tiket masuk?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c7ea0d98acde96eece7a0e2ca28d258b67b6529a0717c830bc090dc498bf92a",
      "text": "Ada restoran Mesir?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c9371d40e98c0008e86cb64cdae9f234a0d102d07604fbada663424d673132e",
      "text": "berlibur",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4fd4a8ebe96fc029f054595a27a3784ce2ce6a35a584ecef61dd535d5df47d22",
      "text": "Tiga puluh lima ribu rupiah",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5063cc6084cd056d706d06fa9e3b31abebfb2c8c70ee0ce00ab4af4d97461106",
      "text": "Ada angin di pantai.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "51687857af90b8b19fcf33291ac3abf1dca5d161d4ec26265a8512e1464ec6cf",
      "text": "Saya bekerja di Jakarta.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "51ba8469843dc514bd54fef4d8dcc53f9b35f173c2c6a14455d5944576a244d9",
      "text": "bekerja",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5458c926f0fdfa021d1fba7a4f8b0fa2564c55fabf64f407be04f1a0c6d70b10",
      "text": "Langitnya cerah. Mataharinya panas.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "54e7b754e6aff7e2721884c8f72cfef945a095a4944cd60f0e777c46d2a398dc",
      "text": "Dua tiket, Mbak.",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "569bc6eaed0241d600432c61df2c88f7e708ff2192c9f8db6f21f3284519f2a1",
      "text": "belajar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a51e37a3d37009effdc2ede5e41732ab40f4a286b428077312fa695e928049a",
      "text": "Di Ubud ada banyak monyet di pohon.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a7d258e8963c90472b808cec2ec0c0758fcb8ae3bd164170de63114c9cec9d3",
      "text": "Rina beli rok batik untuk liburan.",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aba4caef0df59389fd848edbb7b3c28e3c6770e03da6f88c0c2d386ff0b4240",
      "text": "Dompetnya besar, Pak?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b1f5ceaa768aa9228bd6349f5c31799a50dd157be9f4fc6f9cae97977dcc7b4",
      "text": "Terima kasih banyak! — Sama-sama.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "5b4560fef7a2d7d92e5cd8dbd6ad5dfcb72a3c62f97f574d7967d22d2d00caca",
      "text": "Jadi tujuh puluh ribu, Pak.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "5be03a0a1fccec4f0a92b311a148fd703db81d1984fb98e1d547a1f511f91774",
      "text": "kaos",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "617b83e25d7894c36c4bc6660745d5b280b002586b05cd1ce93f12541f564aa0",
      "text": "Ada monyet dan ular di pohon itu! Bahaya!",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "619259355fd7acb1f25eab40b89de4a5064d21922f0eb9c8e50298d057b1e409",
      "text": "Ada apa, Rina?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "61dc3cac1f2ca570c05e6a5556775275e43a6ac2ebac15ad10677a664e924407",
      "text": "pantai",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "62559887729c11649178995aa3916cb700a2144333ebd7b6cc06eb08e111c333",
      "text": "Kami jalan-jalan ke Ancol.",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "636b2306b5d51bd15833eb1d8b872c62a7f4c88959014e85cc6acd9ecbd15ee2",
      "text": "salju",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "63f1ec5c6f2e01a5aa7f0b67756199db7222758e0778af5f171ff1209d72b841",
      "text": "bahaya",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "641a7167d1146aaef45e989e7659f3cdbc161a0b000b35412015c11fd64e52a6",
      "text": "jadi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "64ee94d5e569ea1074daf0c19aefedd763e6fc097aec1b94cecad2638200e6ac",
      "text": "bagaimana",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "64fd05a38f129c00d14c3fe15c8e310bb416ad6750be401f80310b98a1319f7f",
      "text": "angin",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "656ea60515914759188ad8096e90584c3375c3799dfa1981735fbeebfd52c958",
      "text": "bagaimana kalau / gimana kalau",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "661c657bba0a7f78767d8906ab722ff6893198e01e5090fe796ea4580f704656",
      "text": "Boleh saya foto? — Silakan.",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "6696ddefe445c4b7e1d2bff8a82ac01623369a21174587652123c009ccffdd91",
      "text": "Raka berjalan ke pantai.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "670ca0878ab3ea5c5be8b40ffc757749db2d6634c8cb17859c197a10f2243b3f",
      "text": "Ya, Raka! Hari ini hari Minggu.",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a1588a0f9d8f734f2406a6563d2c6a58bc7b551a808ede1e62964193de0ac51",
      "text": "Permisi, Mbak. Berapa harga tiket masuk?",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "6eefbc05d2e610bc6d85aca5d94bc0e5f8cbff1132e4e7d58376f9fb467fd7f8",
      "text": "Ya, saya berenang. Anak-anak bermain di pantai juga.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fe787074edc8fefd7e25085470a7ee86a6a9dfe4612ce4d1983e11c1d943a50",
      "text": "Bagaimana kalau saya liburan di Bali?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "72051db27a670d3a6a31122c17df88991d06458450285071d0087e73fd3b0dcc",
      "text": "Ada! Ada pantai dan taman.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "7205fa972af28126c23d9dca8816111e42f91165896e387198921e6492d06d79",
      "text": "uang",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "729d0beaa31b8bde7155ce4bba5b72b825aa931f66e1815a9f146192ae580e72",
      "text": "liburan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "765c6431cce4a10c33c7659b45355b0fe8bec129ae5917834e6af663515fe054",
      "text": "Seru, Pak! Saya berlibur ke Ancol.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "7864028c5d9ecf7e84a5106f1955f4f7cbf19d585778cfd63ad2217ae8901b18",
      "text": "Di Mesir ada salju?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b85621dfa7e201e2d8a57e06f81d54a65bebffc046295d99a1dba33a56bcacc",
      "text": "Di Ancol ada pantai.",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "7df69ddb332c0474cefe6238d5053929ebe4a4b792d7d809e247e3c2801f8bf5",
      "text": "Di Indonesia tidak ada salju.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "80e7ccaee7520b291918511978b234573d4aea4ff3a644e123b4cb5b2b08643a",
      "text": "cuaca",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "82a3277807ed490dd2e5fc18902f246b44494ef38aae86ae443b8c81dfc8988e",
      "text": "Ada. Ada kolam renang juga.",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "82cdf78a418653f8b8a7d955166e0ae42c0b53929bd4ac62aff71e06b78d6774",
      "text": "Petugas loket: ___ tujuh puluh ribu, Pak.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "844afbc580e05008a36f1b1b8e69a782f1dbfb029db5953ca2484ab70ef4fdc8",
      "text": "Bagaimana cuacanya?",
      "voice": "id_ardi",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "84ae792b2462e526855805f707cb52c101ab406198264e607049e5c373726f50",
      "text": "Di Ancol ada masjid?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "85e12613c59706d72520bacc76840cc07470270d4f91892f3fc00001c919a840",
      "text": "loket",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "86064c7e0933d30989ff3f8cb2833b778878a0772d4606add3aceb8e337da66e",
      "text": "Mas Rizal, di Ancol ada pantai?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "8646ea7929529714801135541eb29895ce02e94535d0ac0b57814245e2161a8a",
      "text": "monyet",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "86d0ec819c1cf55e95f8bbe17410be6a130442ae803942c81286880749a78361",
      "text": "ada",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "8717417efaed844e7bd6a5f058e579aa18b37fe4d161eb540673757b7559d6dd",
      "text": "silakan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "883c3eb6b545c17a45d562c9b2c18fb5d862d2fccfc8162b89b49fc308f52cfa",
      "text": "Maaf, Bu, ada air? Ada toilet?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "89204c213a49bd7762875ec7fb5aaf8cf8e72d6fdbd58f6286e754e88f77c514",
      "text": "Selamat berlibur!",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "897cadb9831047b6b496a53bd00279b079e415a21ab09cbd66fb168de741d365",
      "text": "Bagaimana kalau kita ke pantai besok?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "89b32522092accb6510d7e9102052c6af6a5da7ad7468ac72175205c1ad2f7e4",
      "text": "Kolam renang buka jam delapan.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "8b91a39aa003d18b6183feff4ed13156e6525d70c3257ae040238dcc0c7b45b9",
      "text": "tiket",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bf23452f1f47c6281f3468edafdb8e2716578ee0ffc9607178cbbc26396e47b",
      "text": "burung",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e5c57b28f5d965b4b01d89d1dc49a5d344bf69d5861568f1d2b36eb2de4ed9c",
      "text": "Monyet, ular, dan burung adalah ___.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ea2ce2cfda94ad3da24c16734feedeb053333cad7d7d444ba3b33ddc208dda4",
      "text": "Gimana kalau kita berenang? Hari ini panas, tidak hujan.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f4cdcd4f13f6ce140416e5d2bf971e9459162870b6906bfe8f5ad3e0a699643",
      "text": "Permisi, Pak.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fb7d35f9af607139e17dca6f591a623d89f3c33c5b377a3e358fd25f3c1b521",
      "text": "duduk",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fe7a27fe0a35031639b88947a489ea474e633a70478dfa3a54c9bfe1ca52d53",
      "text": "Bagaimana cuacanya? — Cerah dan panas.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "923f38e0374d8695381983372cbe510d9717aa202b6eb8d2e9c85ecf3b0917c9",
      "text": "Langitnya cerah, mataharinya panas.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "927f9e16a15bd3d42649b91dd9dca146901d083fe4bbced03bcb86c6a418dea3",
      "text": "Monyetnya lucu! Boleh foto?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "92acd7cb480105d93dc13beae625b0f90abf1b79a69bb992475ef87d8fae70e5",
      "text": "Permisi, Mbak. Dompet saya hilang!",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "93e412cc47c731a684901b9028921c7c9bfd8efd5379439eee710060a60ccfa7",
      "text": "Udaranya bagus! Langitnya cerah.",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "96dac330b2b69c02e5462415792ff56905635739ce4433093ccaec40a5103603",
      "text": "Di Mesir ada sapi juga. Tapi mataharinya panas!",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "9827dcb1dc69f39f981652ed024f0f522578fca779c753d8ade1790ced4a17ef",
      "text": "kolam renang",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a3e0f0ac6a652efa1ba2a3a2f7cd4295c52d76330f37d91c5c99b6fbe181d10",
      "text": "Di Ubud ada banyak monyet. Monyet binatang yang lucu.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a5076ba34efe102ae3a7dad86c71a28f4913a4dc43f55da41cd37fbec1db507",
      "text": "Di Ancol ada masjid dan restoran.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "9b95b241404315ffa569c5ce967747d8889485fe6222a70f681811d79e8b3faa",
      "text": "hotel",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9bddecbde774757ae681f3336acb4593ebda514a448f508646c4582832c100a4",
      "text": "Permisi, Mbak. Dua tiket masuk. Jadi berapa?",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "a01b0a27963babc93f025da00549fcdd8e0f4020afbaa7865456ea15d9a1887d",
      "text": "binatang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2253ca717b03d1301196f6924e14799a88f1e6a87abd4bf14c83a3bb1a31f0c",
      "text": "terbang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a31c4476662ce84c5aae2762f9ee3eff60e3ddeeafe995f2157119913d7fa827",
      "text": "Boleh. Tapi monyet di Ubud bahaya untuk tas kamu!",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3da690058f0567832b2ca93661384d1f64431ebdaad6fc0981e27def75f65bb",
      "text": "Bagaimana kalau kita ke Ancol hari Minggu?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "a678c9a45ec57650ba86f897a3eb77880327d20914ae490d10d5f60c33c75ac2",
      "text": "masjid",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "a7afd9d5ab355dc98fbeaa22974bc1afdd43a0201c79dac1188ac0f58a13d777",
      "text": "Maaf, saya terlambat.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9d038a225ace95719539db0fed7409548d3e5110f10ea4fc0e7061bea0ede7e",
      "text": "kuda",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "a9dc1118295ea35b9408cd848e165fab320567b6c548796dc6d1643522b1de79",
      "text": "berenang",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "aa2398bced371591738363cfe756e410f6fe6025fc3d800d70618f7d4ccb9412",
      "text": "air",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "aac2a1e99fbdb03b8970fc6d141d0c8ff7d4d2882b1f75abda3ed981336e2bff",
      "text": "Rina berenang di pantai.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab2a710c5cd17104a4b68959fbe5c54b9e224985821958a3e22997241dfee4b7",
      "text": "jalan-jalan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac9affc616d51b06a87589ee00c578a2424f873c52929adb339b6e026f1198fc",
      "text": "Kamu berenang di pantai?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad8978e65bf9d2827e866412e733bdf508e0f4396c87c143b1acf2b909817b5e",
      "text": "Bagaimana cuacanya?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae12511a316210fc15bb03c1a9a2052ff25cd97e48441117d68f31ecd43bd300",
      "text": "Maaf, saya terlambat. Boleh saya duduk?",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "b2fdacfb3139a808b8d955a5678e5087024ea334913c5bdee9560c16c2e9abdd",
      "text": "pohon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b379f124ea681acfb1eb5621760cb7cc125cfd88b9c58702234ee4fcabd11558",
      "text": "musim",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4113b71e460ba6b5bc170c97b7ba26c8a2870b74c2c367615a9c398c7f9551c",
      "text": "Selamat pagi, Mohamed! Ini rumah saya.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4e3549bf0ea73c54898fe2704cef61cfa0b2f18b7800400f8c138da14a2c7c3",
      "text": "Di rumah Ni Luh ada ayam, sapi, dan kuda.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "b50acbe288f926851bf20dd81d41baf4925ecdd1543a9cab3a9983185a9851c2",
      "text": "Ya. Di rumah saya ada ayam, sapi, dan kuda.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "b53b1738ede31a24e7d500f48f7956c052534e5aa199545c19576a1519fdf9cb",
      "text": "rok",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "b663c7da06bf7add325dddd1dc1aef9c0c3e742a021739bbffb59d1e91c308c1",
      "text": "gimana",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6fcfc1756df530686f197dae7ece7facd62a9a0fd433c206c4afb992a6ee442",
      "text": "Permisi, boleh saya duduk?",
      "voice": "id_gadis",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "b90247bc2d9ff2e9f90954a26955126ab4e0142ea7c14566b9937c8c7a09f1d3",
      "text": "matahari",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bad8d63bd63d338f271484a456f3853a9d74e623d883710bac5ac9862b662886",
      "text": "Di Ancol ada masjid?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0d604ca2d22fe8486910743a4bf8068435896ee04ce1962e66155e82ec756f6",
      "text": "Ada masjid juga?",
      "voice": "id_ardi",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1d0ed04fefe53f3c4c7fb92300280d6eacd52004aec98e3f4d54297e418884c",
      "text": "tidak ada",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3f6fc13c0d67175902976df403c9aa1590e7a7531cda6af7dc264f31c4fae55",
      "text": "Di tas saya ada kaos dan celana.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "c48941ec7584f3ab108ef99915227d2c2fc311a557c9a746ee9d37962babe981",
      "text": "Bahaya! Ada ular.",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6ecc1144679888a47ecc2b50f87c85d651a523f2e729e59f27ce30aee75e87d",
      "text": "Ada kolam renang?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "c72a7f002332d652ebe2eda7243ef6fda6ab45eaf506d780dbba362c4283f02d",
      "text": "Burung terbang di langit.",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7e7a0cdaa30be50df721d8378b7c1240e320fdbed8c2dc67cb390222c6aeb04",
      "text": "Ada apa? Tidak ada air di toilet!",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "c939b8c55f9277e1df78c90a76c328ad9a5e3a2205a59982b226a274fba73ebb",
      "text": "Boleh saya foto di pantai?",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca032218472f6117538dc141b6b29a3c12782b39536a4a24111a107833949415",
      "text": "Di Bali hari ini cerah.",
      "voice": "id_gadis",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccb5bb7df2b716a72a2dcab6f73f7583dfdbcafe5ef13ab66afc90446dc35675",
      "text": "celana",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccf11b9e720b367fca1032683225e3ebcb92c775c5339ddb81675c64a5df33fc",
      "text": "Di pohon itu! Ada monyet dan tas kamu.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "cec1e4a768eaf6a87a292c81f1648878d2bde6ea9bb376de0a11594124f19a2f",
      "text": "Wah, maaf, tidak ada!",
      "voice": "id_ardi",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "cecc5f66f0fe8269dbe3947b6a5725dda80da43914196575166a9f14d729d69e",
      "text": "petugas",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0f829632d4febd441fdaba3a49e457e049d1d4e964f21f269077847d6d19d7c",
      "text": "ular",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1b984601e78cdd862a2f4121d53b3aef037352292ef992a9d3af235b6b9a1f4",
      "text": "Bagaimana liburanmu? — Seru!",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d26839f32df792d263d0442b8928ab6982a6ed82f17c727bf0afd5c4ea3cf0d7",
      "text": "Burung bisa terbang, monyet tidak bisa.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "d27e8feb8cbb0b8d710746946cd0889f6dd85190555d60a458f30216fe90b70f",
      "text": "tiket masuk",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d2d9af323fff49694d1dab7ab51a161f61203af79db1507e210a277c6c55c232",
      "text": "ayam",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "d335007aeb335d4e67a72784069446c742a86bb097945c399c614a803df6702e",
      "text": "Ini dompetnya, Pak? Ada di loket kami.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "d39afbe2183f0804cc0c71ddbbb08e917e3f7af4c8ed63a4db94c7a1d3a4dfb5",
      "text": "Kamera saya hilang di hotel.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6cc204384dcc3c96a3c3d3a3dca07554934e822eba6676d0c601997802c38f9",
      "text": "Ini uangnya, Mbak. Dua tiket masuk.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "d8da6094b4a2d9b9c27181789becac9accf01946f6975a471bd38293654f8ef7",
      "text": "bagus",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd6d7100f0b35eb7aecdfc2b5167de9f155062afca8f04ea1179da3bed8adda0",
      "text": "hilang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "de0992f61d01e3fa662451e6b7ecaff19a1c1641f043a986a174d3a29479beda",
      "text": "Hari Minggu kami jalan-jalan ke Ancol.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "de25c9af498b752b3b8b2ed6569744d441da2d16810ababa4fa5bd990044d773",
      "text": "Saya mahasiswa.",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "df93b493b9339d8f94909858aa38d29d338bad42f47e06ddacb99bda7bbecdb6",
      "text": "panas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e1d13684ada30604620ee554cf6e2c52f6d85e3c61307e60e8fcc5d0e74bc201",
      "text": "Tiga puluh lima ribu rupiah, Pak.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "e223b82b6dd769c9dfc2c29d44a1de0dda278ebf1a698cf9ca0752bca697800f",
      "text": "Hilang di mana, Pak?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e249610121db6d521e9bf1ba4f600749ee7b8eb650740c6f707f9191bc9acd14",
      "text": "Monyet itu lucu, tapi bahaya!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "e272e66b9905ac12a3e22ad3be094539c8cadc588350b4cb0ae097c0b271a715",
      "text": "Bagaimana liburanmu?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "e35b95869aed021bd9c16d442da8790b0f9faecf6764126049e90cc37f1fbed9",
      "text": "Tidak ada! Ada angin, tapi tidak ada salju.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3de29d5865701662adebb8ee9425d34ceeebcfa51fe9a3b12d87c490913f96a",
      "text": "Ada apa?",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e83bc96ca74bc118acc753859ac8eb8d137b4806cb6301f65a2ee5b49c40441a",
      "text": "cerah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "e95c6b928d4979287ea9f0c30d496592526070e012dfa9cb9fb1e807f6c3ad9b",
      "text": "Maaf, tidak ada.",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "eadc177db555b56191f33090f8b43d946bdb2c4dd3da69dccffb434cc21beb26",
      "text": "Selamat datang di Ubud! Ada banyak monyet di Ubud.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "f052e24ecda41bafe7f8074aec8e675ead77e8cef41ff5101fef224ba3aa8780",
      "text": "Ada toilet?",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0be4a9f5fa4f3932d68b07a6f7f2c960f1210c54914b5e8e62a4401650bf75e",
      "text": "Boleh! Terima kasih, Rina.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0c66289a2dff62f335be2a77e4cff9b67f88520f914b1056c52f10258809e93",
      "text": "Panas! Tapi kemarin hujan.",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1f8f9cbc365f4dce77b060a73f769fb9104f3cca36f4c1e21295411cdbec624",
      "text": "Kami belajar bahasa Indonesia.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f45c1350218e9f46e17d49a9758c22dd35dd4f720f6cfc3876bd416ca272610b",
      "text": "Seru! Saya berenang di pantai.",
      "voice": "id_ardi",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8d4a1769be856877535e2b3b5e98c3367a627ba73fffdeff61103131a25b8ed",
      "text": "Ada, Pak. Ada restoran juga.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "f9c81ddafe3ed74e5f03f3d17c634822d43c2738264a5e4871d798858f9a7d9d",
      "text": "Oh! Tas saya hilang!",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "fae385e3b72abfc96a0c9355a476f42a810a66138af4a35e299623d25740f9a0",
      "text": "Hari Minggu kami berlibur ke Ancol.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "fead86a9a7b4e3f7f96cc1eff38bef889ca61a61554f74540fb55c5aa6cbda7c",
      "text": "Halo, Mohamed! Kamu berlibur di Ancol?",
      "voice": "id_ardi",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ff581a7d4a3f09655e57588649091439947660e42666b31b46052b4d75b11a65",
      "text": "Ibu ada di rumah?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    }
  ],
