    },
    {
      "id": "bipa5.u06.l03",
      "sha256": "69c0a1524dd202c9590ae9165b8d080e627dd9f0b7c6e47bdb1701aabaca9d50"
    },
    {
      "id": "bipa5.u06.l04",
      "sha256": "3ff976a7f857a9e0fa8693560a6c155fa3b18492aaeae3cc2897504b6efbeadb"
    },
    {
      "id": "bipa5.u06.l05",
      "sha256": "5f12402c007850befc6a9b2304232be034779599a3eb215ba8c7c591ff7ca898"
    },
    {
      "id": "bipa5.u06.l06",
      "sha256": "ec064882e89de77807e611212fde816ac2c3fee2fe1c1c008e28f973bf17ed89"
    },
    {
      "id": "bipa5.u06.l07",
      "sha256": "cebbc0508d0e75c42f19e11f7d380e1058f89cb088993665179a41ddfea5b8d3"
    },
    {
      "id": "bipa5.u06.l08",
      "sha256": "4fcb914fa88011d553acc9a89a9e19f35c403f5b7314273a2786c8295920b677"
    },
    {
      "id": "bipa5.u06.l09",
      "sha256": "de2b0d6e8b3048ad5a4ae4537ec8dc58ec4e4e47aae3c1ed77ce728af238c7ff"
    },
    {
      "id": "bipa5.u06.l10",
      "sha256": "3dea657505dcca6c9e9e1787bc9d8c84324c1d8cf28835c4af0d38185016d198"
    },
    {
      "id": "bipa5.u06.l11",
      "sha256": "18ca92c5317548f7fc04bdf5f5a416ebc95071c89803c82b2dfa209641b70abf"
    },
    {
      "id": "bipa5.u06.l12",
      "sha256": "94e60da6206a07f783cf70b6fef0dddbc0865384a4b49cb6840abe1460cc72db"
    },
    {
      "id": "bipa5.u06.l13",
      "sha256": "5fac13ec1e299bb315f95cbf28d182d5a536c00b12bb7a724c0e40f33bceab19"
    }
  ],
  "audio": [
    {
      "key": "007a09d8a2dc757776792d809c68021f6dae34661c2bee4e2ca427acef912948",
      "text": "Secara keseluruhan, pertunjukan ini layak ditonton.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "01693f506934699cc6f9695ee25c45ea8368d4ed372a0a98023c9256f0b7c090",
      "text": "Karena tarian ini meniru burung enggang. Bagi orang Dayak, burung ini suci.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "02d9f5b002c5e4818d92c80abad3f619c26cfdab8586f61beba16f18b5db1554",
      "text": "Tarian itu elegan dan musiknya brilian.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "03e926419712d3f198e2bc75c0d7eadf8c669811cbc0886b80b126901e76b61a",
      "text": "Para seniman muda mempertunjukkan tari enggang di Museum Balanga.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "07bfaa336305f214b159733a408715043a38580debd0cebc29c697498238414e",
      "text": "Nah, gitu sopan. Penonton juga pasti setuju.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "085bb61426554f1e62637ec5def907c7972e09d40341514b380973b07116b635",
      "text": "Gimana sandiwara semalem? Kamu harus nulis ulasan, kan?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0883cbf076f2fd6173a9d2dc7359d21a09ae1d743eb88b3a8311b80e674d33f8",
      "text": "Suara sape yang merdu mengiringi tari enggang.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "090a77ad9c446e6db1780f202985400430fdd35f8d4bb139286a01d2c5ece687",
      "text": "sketsa",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "092f1cf979ba259bd4e432a60ec40a3c4c5f4736f08af9e3f7afa288d8ad11c5",
      "text": "Rina, tolong bacain kalimat pertama ulasanku, dong.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "09e21c7da747268e09eed36c0463a10644e192879a7b25bcbe67fdc1ecb4c166",
      "text": "Kostum penari yang rusak sudah ___.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a353d279aad41051149aa2a2a7b64f137a138e1dfb4d6281a969fe934cd5883",
      "text": "Merdu banget! Suaranya mirip oud, tapi lebih lembut.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e51651f1df7f68d9bf417994efd7d47f37675e88cc019bfb232089323d4a91f",
      "text": "Aktingnya bagus, tapi suaranya terlalu pelan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec1f22923630b1d2f7fffcaef54064f42490576cc307eaf66843aeedd221aa6",
      "text": "melambangkan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "0fc7132d4cccdb09fcd5a35ae8be67eed021e7e3b77090ec438dd1ebd0425714",
      "text": "Wah, hebat! Dia pemeran utamanya, Bu?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "1191f9f99a7662e4a0baa1f3ba05017ac7899229cdf26befd67a3b6c2e60a94e",
      "text": "Adegan terakhirnya sangat dramatis.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "126923dced8ac8114df1b176bfa1a1bd023bdf02d2f37f8745dfa5fca90e0e29",
      "text": "Sanggar itu mempertunjukkan sandiwara dengan musik brilian, tapi akhirnya terlalu tragis.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "13fa440086049bc985d811f917d7f156eb3d00d7b8f934996a67493270733a35",
      "text": "bulu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "141782b8630dd3f9e71af4bb259073cd24a7d34074699c1491c6f13f20b43b13",
      "text": "Gimana menurutmu, Mohamed? Seru, kan?",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "15e3eb9b2c1b5677bde6fdd6afffea5c44e76444d86a798e3f7d73d0c9cd768f",
      "text": "Desainer membuat sketsa busana adat Dayak.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "18bda6dcf761c4180d4c88ddba7b19ae130db2aff69faa2f6679da19b174604e",
      "text": "memperkuat",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a8aca4f4857362c6c8140292c5ff3a71b4f9d058a80efd14fcdc1c98003a9cf",
      "text": "seniman",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "1b65a40aea5c4d188cfdaf7a08c1e69a6f3ee0113a25c2b1a4e1035a076c8d2f",
      "text": "sayangnya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d55fd6afbf003ab16fea75c6c2daed8e9753c805bd6dd50366d4fd4d891e998",
      "text": "Kami latihan tiga kali seminggu sebelum pentas.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d5e3594d7a2dfe0ce982fddd6f5a6edd929e4c9e695576ea6b09606f995563f",
      "text": "panggung",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "1f41cfe4d052d7bc7cd0d147320ea2e3342e9253ed2c860ef43f22efe155d7f7",
      "text": "Betul, umurnya hampir seratus tahun. Yang tembaga di sebelahnya baru.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "21b0bbe627e85a36a87e8cea218f946cb74ceb4ea5f44689cfa64879f0ea47e7",
      "text": "Irama gitar ___ membuat lagu itu terasa berat dan dalam.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2322eac749e07c27369f736d3a7855a4b5424cce4da53cb3b0973464201769ca",
      "text": "Jadi kritikmu positif semua, dong?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "25a4cb4a64127b840e7b44676e612eeeaf19a02b0e33b6c1ced1387ba8137e08",
      "text": "Bagian yang paling berkesan adalah musik sape.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "29a0a348dd765076378c43373855bf60f03c1264c11073397f062b49298078b4",
      "text": "mempertunjukkan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a8c0a742ffa97616427b25c7703cef6c2675afa0531777f362940e388fa9bab",
      "text": "pemeran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ba3775111258184c58c508fd38cf52bab5338aca8bf712b74c633cfa2978694",
      "text": "Kalau lonceng kuningan itu? Kayaknya antik, ya.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ba88c1d184c7ed5920ddb3a2727838a27490a838ea5ae28933695cd0bc6f2e9",
      "text": "Komposisi barunya menggabungkan nyanyian Dayak dan jazz.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "2dc3f3492dd21ad6641a3205554d0c5dacd7d5897ffdb8a5a234769f399c3234",
      "text": "kerajinan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2eb03c50eae27ee9ce9a82bfb186180ea63269ca1ba6d17e49b50555d456e09c",
      "text": "antusias",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f617acc0ede0a88530863b9e27526f05d2fcbdd3574a4587e147f570e51e55c",
      "text": "Pertunjukan malam ini memperkenalkan budaya Dayak kepada turis.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "31491fab0792396e8f9090de5d7aceb1a23e74f7dfa0365c617ef6c1811c2c90",
      "text": "naskah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "33275a55e622e242d3fcee8d41df1a2aba9a4c9d61a5aedc0e6b609e5a0327b3",
      "text": "Kerajinan kuningan dari desa ini terkenal.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "342ad1be2c10962983b3e7af6721addce490e26f9ae922867abe92e36e6cdc12",
      "text": "Galeri ini menjual kerajinan manik-manik Dayak.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "36146e3acc3b421a42a3462859be14860a494009b3687a9ab1e8eb79aa1f1b20",
      "text": "Sayangnya, suaranya kurang jelas. Tetapi secara keseluruhan, layak ditonton.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "368b751a769a4f488a536eceb3017c65fb94b3ad353b8b1255f5bbcb5fe76588",
      "text": "Dari nyanyian nenekku. Sisanya imajinasi aja.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "373a6d13415bfcd82c90896d387f99ba62fea676600defeb1f8ba97e2bab16f4",
      "text": "instrumen",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "380557dff7ba2d56e07cc610a25220cc042cdc5ce029d24291841046c00ecea3",
      "text": "makna",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "381f9df1d185c582704196e78fc4c93f6f941c1cd3fcdb4963059e791d98fcba",
      "text": "gerakan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "382d34ccf3c35f526c6f809f24f861f437cf4ffd58fc57a7ddb047913ce2218d",
      "text": "Lonceng gereja berbunyi setiap hari Minggu.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "39595df6fbbd439aeeeb918c3ccdb4206805b257ed4652261b9502c485fca4d8",
      "text": "Ada humornya nggak?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "39b6ce722a1798b70eb2d4ac5544309a55bbec4ea6307dc5a99a989c0778c36c",
      "text": "Saya bisa merasakan getaran bass di dada.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b5d0c66b675d5504ded1ee793838aa8639ec9268b3c5342916bbd0415e14e53",
      "text": "Seru banget! Bagian yang paling berkesan buatku tari enggang.",
      "voice": "id_ardi",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "3c8a33ff66aa66ec9df4014428ed0dcf44588c0c94bc9e5a7dd86e56ab8adb26",
      "text": "Gedung pertunjukan itu akan ___ tahun depan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d7f03cede8686326e1cb1128728628238d99801fad59b0afd445d94976c5c43",
      "text": "Pemusik itu cuma memetik tiga dawai, tapi iramanya kaya banget.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e1ff1b0c5eadee3ae9185d824f0d9ff8d89f4231851c2b7662bc31173f6aa52",
      "text": "Sejak kecil dia terobsesi dengan nyanyian neneknya.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f7b453658626e4c0e54376a98ad05f9274f1e82ef96864e621d4ab001c65010",
      "text": "Kritiknya tajam, seperti tinta merah guru.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "41b4b52882a627e90976c0cc5c2630b43c7a4c22cd2fef94f11f27e71c8cab66",
      "text": "Seniman itu sudah berkarya selama tiga puluh tahun.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "41ceaaef30eadf8173be029481e1c213bdec3c5b59a0deff0bca3768acadb03a",
      "text": "Banyak! Terus tarian enggangnya elegan banget. Musiknya brilian.",
      "voice": "id_ardi",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "43153fecb5f1713bb67f36d2820ec60552b7c408ffdee26403dd6ae85a781600",
      "text": "Louis Armstrong adalah legenda musik ___.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "43214217e4858bb12796fc2779d3cbee7201a193d0afd4513226323d1f99c742",
      "text": "Kalau boleh, saya ingin datang ke latihannya dan menulis ulasan untuk pentasnya.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "44081a1037938bbc41efc8cceeb06b1f50171f137ca529ce8da8206e7a8c7efa",
      "text": "brilian",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4546c03853bdca5d7a28c8545301beabb6259f57afb112a2d436b985f8a8c765",
      "text": "Lalu apa makna bulu di kepala mereka?",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "461b7eeac2bed0326f2eb43b742c1d286ea05d90e54bc794590ef235728e9929",
      "text": "Apa tujuan sanggar ini, Bu?",
      "voice": "id_ardi",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "4bbac746a64078205c52494c57e90da4a13e2525c8e529d6fd26d93b392b38fc",
      "text": "Mohamed, kamu udah baca ulasan di koran soal tari tadi malem?",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c10654eacbec42c122e6f77f66df8a99d2548458fc88e90e8318aa298db6a76",
      "text": "Saya menulis ulasan untuk koran kampus.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c5236b26ac70fc86cb087c00e193c80e0e9368c6e0b650cb8d98190348fc6cc",
      "text": "Produser itu terobsesi dengan getaran sape.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "516ec36728d265363f404351e5c0f02d458a04fd621879178cd7ab3b43f450f9",
      "text": "Para penari ___ burung enggang yang sedang terbang.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "5418850c8f08870d4312756c3e219e58fd05958bf4011d49582129f0e366561a",
      "text": "Iya. Dia latihan tiap sore dan udah hafal seluruh naskahnya.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "57bed18044a9ae9d2b7fa4e18d94ff79824e1761d6e412588491b3ff648dc8ed",
      "text": "Kalung manik-manik ini jimat, katanya membawa keberuntungan.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "581d898a21ed9ea91ec7a1d20985f7eaa98b14f1949c855f447b6a77dcf7ed8e",
      "text": "Dengerin deh, Mohamed. Itu suara sape, alat musik Dayak.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "585d85781dc72210f475e4747b569c715bccfd1bdc1e3207b759c4ea0a505622",
      "text": "bass",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a06991f28392fb1890622fb383edfdc8e2ef82e9d4fa9e41432adb09d388d0f",
      "text": "Ya, benangnya kapas asli, ditenun tangan. Motifnya burung enggang.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a899d42fb9616fb5faf0636a880b4014df57dc7d3d68e6476ce02ad376a4a40",
      "text": "Latihan untuk pentas hari Sabtu dimulai pukul tujuh malam.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "623a7dc6a139c05cbd10a930ee92a4502db5d1ca6a4d4d597fa24759c550a6e9",
      "text": "Kain ini halus banget. Dari kapas, Mbak?",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "64e1b92fef7cc70bb4bdc433a277706c6d917f034d69dd5dc34afffcf101dc74",
      "text": "Akhir ceritanya tragis, tapi ada banyak humor di tengahnya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6545903b1e926380c51f327355291c40b076d531214f791bc14d8c2d2d946ae3",
      "text": "Selamat datang di galeri kami. Semua kerajinan ini buatan tangan.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "65e6e31c8b1bab7813a58199626dac10e60036f01dd4257ee14e0d52146b6c5f",
      "text": "Pemusik itu memetik dawai sape dengan lembut.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "680ea3a8ee72747e383afe39395abf29efe6a469c2594efe061b13b677e127a6",
      "text": "Musikmu unik banget. Itu sape campur jazz, ya?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "69f16577a580b094cbdf0eaddf39a7a2572e4bd4b452e3424e54e568d6eb839d",
      "text": "memperkenalkan",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bb5d0e9c48dac084d56ed2c44691d53a581c5ee6786b08d03be7472ed854304",
      "text": "imajinasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "6be40bc2eea785c3824c1ea043b77ff3f6f58bdb78dc80159e1a5cb3552e726d",
      "text": "debut",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6ccc85ace8a5609293477ec9714a6521b70fbd2f0eeb9f6075cc1f13b320ee3d",
      "text": "Para pemeran berlatih setiap hari selama sebulan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d1b7009c5efe113294602bf68fbfa20c5fb43950c3dc156fb11ad41318bb7db",
      "text": "meniru",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d6af2221c57117fca0283e32991fa72925d088bd6e124ca4eb60580b775e510",
      "text": "kapas",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dd222238595a033678ac5445555ea00c1c3522363c232202b78dcd6818313e4",
      "text": "Narator nggak perlu banyak akting. Cukup baca yang jelas aja.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "6f70f07fba19971a30be7044b143020611506c735b8d90e650e921d755584ff6",
      "text": "Para pemeran membaca naskah sebelum latihan.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "70c07218d5ad832233210a25a9e9ea9ba70924bd8373584e7d908546b885b69d",
      "text": "Iya. Ceritanya fantasi, tapi akhirnya tragis.",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d3e31c49957e0782816f4afd6bf531796f1f3422abbe3cf1c53fb83432c20c",
      "text": "dramatis",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "73ecd2fe51beccef93d1c232c258146acd2a43bf50b4e66472eff0b79232d3b1",
      "text": "fantasi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "751bd467f00a8e6cc4a372d05e7a4396bad107a1b4445947cdaefa00abbefd23",
      "text": "Kain ini ditenun dari benang kapas.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "7597953584503963363aef0791b052127e089d41318b6993addad9aa5adc2808",
      "text": "Ide sutradara itu ___! Belum pernah ada yang seperti itu.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "769f70418ad700f62cadbad921062c39038109a371a7fb062363d4c60a356919",
      "text": "Kesanku, mereka bukan cuma nari, tapi juga cerita.",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "77de1992e1718307baba009c5b2ed7d0f5c3ba27c0718c43dd5c6e840c0599cf",
      "text": "pentas",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "789ab93096b501a442eed44a641e2e8a8deb53d8b5f2f4506cb15b0cf3a3cf51",
      "text": "Pak Mohamed, sanggar saya butuh narator untuk sandiwara minggu depan.",
      "voice": "id_gadis",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "796aa0274532e1147ec29b0e81c7f9bcf5cd988586398d65c7851c77049d9433",
      "text": "Selamat malam. Mohamed, Anda baru menonton tari enggang. Bagaimana kesan Anda?",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a29e5f49ec75bc1a40cccaae15e4936a3c2721f071296f6ad32c76156ea0b49",
      "text": "Akhir ceritanya tragis sekali.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ab43433ba61487c62b17e857fc7715025e94ad34ee6a9364d2ddc377cb7d256",
      "text": "Kalimat yang indah. Boleh saya kutip dalam ulasan saya?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ad4a2de99075e464f74fd84fa63b690b74188c17c556093b4b42d02de0c9648",
      "text": "jimat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ff435c3ac56e544cfd690ce6e3def9ea9473614d510d62a1777b62405542a9d",
      "text": "nyanyian",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "857e0c2f0df0f95ea035667adb71d5f75bd160d11dc0a582dfc24d81e0233a6f",
      "text": "Produser kami dari Jakarta datang besok.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "86eabdae36ffd4a7505e483c3063bc3d47091b669234c7bb46001a6c9e46cab4",
      "text": "Pameran lukisan itu diadakan di sebuah ___ di pusat kota.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "88393b72c18d68fdefc164ad75edb569d9b38865b0fba457f97c94c81afae892",
      "text": "Pertunjukannya memukau, tetapi sayangnya terlalu singkat.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "8aeb937d20d4b5d6ca7d5ea9f4c233847a1423b35ce811f4b8edecfd6805ccb6",
      "text": "Sayangnya, tata suaranya kurang baik dan sebaiknya diperbaiki.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "8c04e5af8dfb92facd4ed19915f5dda0dde2ded38b19dc8d896d31267fda1f0c",
      "text": "Komposisi barunya menggabungkan sape dan jazz.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e92abb0e23b8e183fce780153f2426679c4c680a9679d585fde318778989723",
      "text": "kritik",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "8eb6db7f760393b6042aff4abb1f5e8fb2d357889adfbeeaf48ed329bf943531",
      "text": "Kami ingin memperkuat budaya Dayak supaya anak muda tetap mengenalnya.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "937c45b1523f348dba4e126894b28d7f5f1cb1e15eb7c8d68840554ac99f3e12",
      "text": "yang paling saya sukai",
      "voice": "id_gadis",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "955b106f26afba6f711f9a4b1a131ab3b09be1d3e4ae4e6b304e8b5945667767",
      "text": "Sanggar kami mementaskan sandiwara tentang Tjilik Riwut.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "95c58496e35a4e8994ccd368a56165688e6ad50a41655c7f90d6684312798d3a",
      "text": "irama",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9629022d0f6ddb93acf8d60fb1322516e64359cb8941e18e283c0d12c84d27ca",
      "text": "Ya udah, deh. Ini debut saya! Saya pakai busana apa, Bu?",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "98b89faf7d6da012d02663dad3958846d8df0c1b72a3729b490b5043f6d88a44",
      "text": "Para penari mempertunjukkan tari enggang di depan tamu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7fdaf4e1f310b2c2f5d7f32df7dd1b9f34b2be3cb78d39bc2da4594eca6844",
      "text": "Lonceng tembaga itu antik dan mahal.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c849eca76064c4b4f83ca00b489be18314d0cbf8883f4e6c1e6e153b547e333",
      "text": "Bagian yang paling berkesan buatku adalah tarian anak-anak.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e0002acd1e6293d6c900edbb9fcc477f5698c22733ac3db6b5a918e69f3b257",
      "text": "memukau",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "9e0b0b2059e8faaab19b767638ea597668e8922265869b8a21df61a1dc8bdd3d",
      "text": "berkarya",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "a350be1b35c424583d6ef0be4ddae7aecba138a338141b6d241cbffaf2aa2590",
      "text": "Secara keseluruhan, ulasan itu sangat positif.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a379954f489157034409ebe20fffd9bf7086c2f184348ec4a6c7082ad39b890f",
      "text": "Saya? Akting saya jelek banget, Bu!",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a46402021441e12cda4619aa37f7247f87f7ea100865abe1aba49076898c566e",
      "text": "apalagi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a5cc32ea86ee5cd81cf0ac66d5289e999ad252d6f4c0ecf18a19b6530ccb424a",
      "text": "narator",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "a600d82802dc75d18cb5d1a2e0e2989115e1ab6d0b8799dd7519bb227d4e4213",
      "text": "Gerakannya meniru burung yang terbang tinggi.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f2884b0dadcee051d1c8938e58ea8ea9d37238857b862630d6610e0c65dd55",
      "text": "Bu Lestari, kenapa gerakan tangan penari seperti sayap?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab58bd48d697d78b73ac182e2d354de565dcc7336d1472ddceee844172a21d7f",
      "text": "sandiwara",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "aba3cae3710125c397a87dbc4f605d13667433bc4cd2b14c226c6cd6bdda8b7b",
      "text": "Musiknya brilian dan tariannya elegan.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "ac6662f5cf74c170497d1a2119c99c1590fc53a08f2acd88fe9a96f26e2a42b3",
      "text": "Gerakan tarian ini pelan dan anggun.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "ace9420acfa5a4406e7b0c146da2220522601d886578af4cb86c54e6bcaa2ad5",
      "text": "komposisi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad0eea4c720dac9f8d1b9041f005fba61751134330b0290524c02176b85bd628",
      "text": "Getaran bass-nya kerasa banget di dada!",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae0cb45c478d494e2a7c2c933a50d29bd46ba71f14724c922051d436cef9ea5d",
      "text": "alat musik",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae25d156b842cfcb9a6edd7ce6790f15f1512567e67281d81da8747d45986d59",
      "text": "Mohamed, aku mau memperkenalkan kamu ke Bu Lestari. Beliau yang ngelatih penari di sini.",
      "voice": "id_ardi",
      "chars": 88,
      "mime": "audio/mpeg"
    },
    {
      "key": "aeb952650b437d1e103145191eb76fb72b1c4c9cd8ecae466008e4da1dedf68b",
      "text": "Sangat memukau. Gerakannya meniru burung enggang dengan indah.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "af747fa59b2142de047c45b0a189dd443e6ee1d56dd805fd9300fc98337d42d5",
      "text": "galeri",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b00aa2a05a335c8237ae16d6755417d1387191606e27bc4c5516c4f573c8b7be",
      "text": "Tarian itu sangat memukau, semua penonton berdiri dan bertepuk tangan.",
      "voice": "id_gadis",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "b14ea7d728c47851f3e63dbcd4481013e446cae1a805f92c5a79155214ea5c1f",
      "text": "Kesanku, pertunjukan ini memperkenalkan budaya Dayak dengan baik.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b34f93c04b7f342f3d874958479221fe2099d1799fa51c29cf20297175bab186",
      "text": "tembaga",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "b47cdf4e3a5d995743eb789d7715e5967257a780dd32485d34454b5827019f0f",
      "text": "layak",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4b8bac528ad25e2c50d15261ad61ce80b1b5685995de51c875cc651fa301fec",
      "text": "Tarian enggang melambangkan hubungan manusia dengan alam.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "b67dc4b5be4b9f4473edf2d1725b0cde10f974daa5b1f56962d8dd25941264a1",
      "text": "Terima kasih atas waktunya, Pak. Sejak kapan Bapak berkarya dengan sape?",
      "voice": "id_ardi",
      "chars": 72,
      "mime": "audio/mpeg"
    },
    {
      "key": "b777d9150f7b3db0b4e083279540f805d582632d1d59119cd3c736371295303e",
      "text": "Pak Mohamed, anak saya ikut sanggar tari. Mereka akan pentas bulan depan.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7ca44eb94d9784dfe76a789db7e6afd525e97bdd2099a8f85ea377a1408ced9",
      "text": "Kami perlu memperkuat dan memperbaiki panggung ini.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8ffb71bca9985b1064a7ec5e3bec29db3e101c0b08f2a462b11ffdd12359cd6",
      "text": "Selamat datang. Malam ini kami mempertunjukkan tari enggang.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9243399c2aba37223d65c0da771585d08b327c121e11e2022be5722c445d0bf",
      "text": "Desainer kami sudah membuat sketsanya. Para pemain instrumen juga sangat antusias.",
      "voice": "id_gadis",
      "chars": 82,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba485fc8fbfe2c9604922109e03c37ea45b29f0ac53746c47ef746d151b28cf5",
      "text": "Bulu itu melambangkan keberanian dan kehormatan.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "bc4a044a761a2e6615bb59e686afffcf3bb5f19f6690d0117ed0fe00695b4b16",
      "text": "lonceng",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "bf85bd5960e7a8fcc7ccf30a4a5e7e4caba54ce932cdb82f61e3da305630831d",
      "text": "Aktingnya bagus dan penontonnya antusias.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "c08ceed0195338773bc790e58c66b55f29926022d28fc93dec93bd123c52768e",
      "text": "sanggar",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "c15ec7fb4c87565866790239832ab53ee4bbdc50ebdd95d52c860f201c3a4979",
      "text": "Sejak umur dua belas tahun. Kakek saya juga seniman sape.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c1eba8621eac39b6922c4760e5f8997034c3e9635e2f17cf7e8ae61d14e757d1",
      "text": "merdu",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c38b036cf63b5c709ba03691defea35fb4953624d359f8fdbbdde312d6519792",
      "text": "Hampir. Adegan perangnya terlalu dramatis, terus kelamaan.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3f8eba29f7bc65ba2bc8a491d94c7d020d74920410a05bca04c7bd5f248ffb7",
      "text": "kesan",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5b6812af60829180eebddc1055d90695cc2bdc16fc13584e81a7406a13a0604",
      "text": "Yang paling saya sukai adalah gerakan penari yang kompak.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "c61ab974f62c873ca05103853c2406ed159c13a1afd127362175b431fd53d23c",
      "text": "Udah. Penulisnya bilang pertunjukannya memukau.",
      "voice": "id_ardi",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7135de022a688016324b08f1781e7db0f0471008df4edad03a6827fc6c189ef",
      "text": "tragis",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c7dd2e03b232366c3c9c07c01b1cea98735cf71422bb2ceeef0857ece8277d06",
      "text": "Aku pengin belajar sape. Siapa tahu aku bisa mainin lagu Mesir pakai sape!",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9a450323ccde0ca58c7002808e5291254c21f2580962e8536d6d422530b2071",
      "text": "Aku setuju, apalagi waktu musik sape mulai.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca64190f433c38a3e9f9faaa881650a24deedfbc4c62787c2421da1d7cb59f79",
      "text": "Apakah ada kekurangannya?",
      "voice": "id_ardi",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "cade713d3015c0b191e9559b4bf017c34797cfec13a83866f3523d0ba3072e8f",
      "text": "kuningan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccabdede6a01cbab4d20fd393a3dcd0ff9bbe2af61e8fe5a775a735db3c2044c",
      "text": "Bener. Aku terobsesi sama sape dari kecil, tapi aku juga main bass.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd0a89ffcb89d2f3814efc522dd7faed33a2de172ae7409888be11dcf5e70a9c",
      "text": "Ide komposisi ini dari mana, sih?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce2a0aeb86900e9c0bdf27511c819f24dc60bd5c019959327cfff1e89b36fdb7",
      "text": "jazz",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "ceb674e0112c0eadccc988a860aa9a04ac60a5986317ab8b4b6aca3e46ef4ee3",
      "text": "Gong, kendang, dan sape adalah ___ musik tradisional.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "d1fb0654809408ec755e404084cb0cc2efaf7379d874ec069f65cf8d9ad3448c",
      "text": "Naskah drama ini ditulis oleh anak-anak sanggar.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "d422f7782a60f69f246b5d25bc7a34c71107187333fdb1994d6d2335c3d732f6",
      "text": "bagian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5a1e98f7060810106749638d80c2d6f1abe0e456858e8a8fea179f492fbd385",
      "text": "Sape adalah alat musik Dayak yang dipetik, seperti gitar.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "d678d5e9367685b1200f356490adb98f4673c8f0df96b437cf47ab548af91862",
      "text": "terobsesi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6c0f7d496abc763ea9c2ca18a9767340286c2f51e2fd7943332e60c6e769f14",
      "text": "Oke. Sayangnya, panggungnya kecil, jadi sebaiknya diperluas. Gitu?",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6cfb4b60475596a312198fec306e81b13e0b0de139417e173c7aa307151af34",
      "text": "Ini debut saya sebagai narator.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "d841c844540b899907e141e5f87fcc37f655612e95fa5e1e88ef863c58ef42d9",
      "text": "tinta",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "da8eabe56b5388cf4e99f6b339f1674ade126002c246ce5c9647506f3d8e3baf",
      "text": "secara keseluruhan",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "de13986ca660f0022f160347fb1314cd25b5e7dd32f78d322fa218d5200d79a9",
      "text": "benang",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e02628caa43d13e80adaba2eafca70002b36eb91bce391032b4325af27f71239",
      "text": "Sejak kapan Bapak berkarya sebagai seniman?",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "e317123b18a7deb1632d4a8b391030b49f4fd7e44c9ccbdecafc9fda31c4e928",
      "text": "Yang paling saya sukai adalah musik sape yang lembut.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "e3236539b72b901574de4f882aad965aaa2ff48d530b390828acd686315f04bf",
      "text": "Setuju. Tapi sayangnya suaranya kurang jelas, sih.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e68a01894838b15138cc6e4826bd02383930b17405d3fc233e2f5b74758543a4",
      "text": "busana",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "e818cae7503b4d84ea81d420f3afd3352053bc31cd23c25e2ce5c31a0999f96b",
      "text": "Penonton memenuhi gedung sampai tidak ada kursi kosong.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "ea9e03d3312546a5c4d79a56441c0148470e42724d3c29b88366ebd9caab27c8",
      "text": "memetik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "eb343c380f107b6107b3775853685fdfac17f6540faeafc5ed78db9d90dcc68f",
      "text": "elegan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec31f87325f9a66331e6ce8a6d5fb803a45faa83c9145fccae15ab729d7e54e7",
      "text": "akting",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "eca162dc741e5191425efae242e069c7ffc4fac9f0f8f8482ea419bbf936f621",
      "text": "humor",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed02f397e03ced1208e586806ee67a2d36f57a5151b552c6456e73e88ab470eb",
      "text": "Bahwa sape bukan musik kuno. Kami memperbarui iramanya, tetapi maknanya tetap.",
      "voice": "id_ardi",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "ed93390dbee35162167ad3ccd042f999e5b60ee24cfd5d32998c0eba7dbf45b0",
      "text": "Iya, tapi secara keseluruhan, layak ditonton lagi, kok.",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "eede6c9d0b722ffdda2ed03fad27a544f880183eaae917ff968d574ad53fa2a0",
      "text": "getaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "efd19d7b0ab3c79f50706ca923c8bdf5fefd7da32c6df40fbe8390765dd5ff2a",
      "text": "Aku setuju, apalagi kostumnya sangat indah.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0481bd15637d36ce7d7764a560120e642e4bbe6b48a307f27e72c03d824a13e",
      "text": "Kesanku, tarian ini memukau, apalagi kostumnya.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1d9570dce27b61366a4a33122b9f49d63b0b41e0800c4e8e168922e5c81f3a2",
      "text": "dawai",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "f5acb5ec5dd89468270527ad027e3d254a0a0790b753d6bff7e93487829a6ef2",
      "text": "Tarian ini melambangkan hubungan manusia dengan alam.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "f8d3147788d8c43c23ca94a6587b69fafaec393847f2d53c0122f873e74b9327",
      "text": "Sayangnya, panggungnya terlalu kecil untuk tarian itu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa09c3a8c21c2ffc820d8e5f6c00785a757766b45f6aedfab51c5a183e573cf3",
      "text": "produser",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "fa8f7e9ac482d489ea43bef884202a5c3e0330b7be8eff66856c6e0f7e194c3d",
      "text": "Kesanku, pertunjukan itu memperkenalkan budaya Dayak dengan indah.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "fad9914f52cebb09c4e6b7843245684d9d49658e526153ae880b6ec841f7a7a4",
      "text": "Emang itu tujuannya. Produserku pengin orang ngerasain sungai.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "faf8915ee9367e6e10f7a6aa27f2db8fd7d21793e52af386eb7f0abe0a142c60",
      "text": "Apa yang ingin Bapak perkenalkan kepada anak muda sekarang?",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "fbfd558eee4ac0ac32fdec6d09417c74f7c71c39e0da67a8fee1f0420e30a05f",
      "text": "Pertunjukan tari Dayak dimulai jam tujuh malam.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "fccb4da15cc521fc3f1aed2b65d9a0d3a79ff584b532345fd122e5c15999bb93",
      "text": "latihan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffbab373fe150f2f635e5fd2158b87f4f24e8fa7388eac076377c93638f85709",
      "text": "Bagus. Tapi kritiknya terlalu keras. Pakai sebaiknya aja.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 13,
