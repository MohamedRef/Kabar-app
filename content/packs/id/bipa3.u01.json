  "version": 10,
  "content_hash": "af5084d655c68c43c4dd8c34daadad6aad0185b9f287d66d90d45f5325602798",
  "lessons": [
    {
      "id": "bipa3.u01.l01",
      "sha256": "dc06ad44dd7dedbec549708a0c3e30fd4f0a0f36ecbd8742cd8acce54879b0a6"
    },
    {
      "id": "bipa3.u01.l02",
      "sha256": "98a7175b308d4ff1bdb013fcd6f4fe22519ca520c09a5721bff67c08ecabd635"
    },
    {
      "id": "bipa3.u01.l03",
      "sha256": "1f4f515ce8af2ae1760d196bc227863addd82bc3947c9e3244741e072696761d"
    },
    {
      "id": "bipa3.u01.l04",
      "sha256": "d4626b31c6788f88ad1949ff1f4f7295a3d01073d1477087ffde17574cd1926a"
    },
    {
      "id": "bipa3.u01.l05",
      "sha256": "caab3f14deddaa5b493abd4a7634ced67a9b9bc9918fef1e694b20ad54f25fca"
    },
    {
      "id": "bipa3.u01.l06",
      "sha256": "6edbb8327d7ebd35b63608331c05772c3eef4fa8bc5f1a49cddb94dd118f5999"
    },
    {
      "id": "bipa3.u01.l07",
      "sha256": "d6361ca98522d36075fb2c7f2e14cb76b34b86dd10edafef42fc243def7288d5"
    },
    {
      "id": "bipa3.u01.l08",
      "sha256": "c06d1c77eb7b14624d03e4f6854b0de420cbe67b6385cc895798029c15f308c0"
    },
    {
      "id": "bipa3.u01.l09",
      "sha256": "be18d0602e4e6a3749ad921abfede05b9e45b3278dd1b01254fce92a43e68dbb"
    },
    {
      "id": "bipa3.u01.l10",
      "sha256": "0594ec7cef9119033a6eae6e6cc573bd8b4b729fbd535c54d87d37817ddd49fa"
    }
  ],
  "audio": [
    {
      "key": "0077bc777b7454fd030ee0ab0c51009caafde445cb0db28ca881dcd07a46f365",
      "text": "Selamat atas kelahiran putra Anda. Semoga sehat selalu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "0116c909ea66271c231aac97da8b8caa8bd118ea1da8eb773d0a846b7dd79593",
      "text": "Rina, tolong baca kartu Lebaranku, dong.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "014667b58afea6c7044e9739cf1116bbf5380259d09391de31b2920238f15695",
      "text": "Wah, rame banget! Aku harus bilang apa?",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "0167969f0f29785e1084a80abc9009e5724d1d72523058861de429247d52130d",
      "text": "bersyukur",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "01a8e5f817cf6f7d15f1aaa6a32eb68a8c7130d012280fe2b2f314ec8ef2505c",
      "text": "Selamat atas kelahiran anak Ibu. Semoga membawa berkah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "01dadeda457e0e3a6cd961a33d5471e61d71cabe6c6b7878896ccd859cb69a40",
      "text": "menurut",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "09d5f4b3c7c85e164c222578f2e9d3db4d4bff7a4dffa8d038861e22b3965394",
      "text": "melahirkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "0a589bc1d994588c9c6caf0aa6d6858cadc2186270a72d9eec2b3619952b9e46",
      "text": "selamanya",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b8414e6ae3185a5b02b0db0d929e6a56e89d4d19b4a235fef2856954b20b3ca",
      "text": "Semoga pengantin baru langgeng sampai tua!",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bd3aafd99aaf2152f35cd15a9583e72ab7839a563d4ec37e12a2a0bc680efdd",
      "text": "bahagia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0cb8a986b95adfca5d39925236ca339e66017c8676b1cc03ff857e119775474d",
      "text": "Semoga cinta dan iman kalian selalu kuat.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec5b3b6222b6b86fe61f609ed92ba002bb22e477db05d299efc880d3fa51ebe",
      "text": "Selamat wisuda, Rina!",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f5533150df59f617edc2f5e6f7b07935fdc1b01b32ede8da0858cd8c4bdf07e",
      "text": "bagi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1136a10ff1749ecb598a01fff730238813faeb95ac4a1a0074e2e50040b81867",
      "text": "___ saya, Mataram tempat yang sangat indah.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "129cd75453ad980ed1ffb46e19dfd828f1a077b18ad3896db857f5e384939a6e",
      "text": "merayakan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2096981d497ad6f9f0c38335a925c64667958c3dd322798911aa575aa45d8f4c",
      "text": "Mohamed, ayahnya Pak Hamdi meninggal dunia hari Jumat.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "26ef9d73e05996ae174e59db50f415a726aaede464b3802258b02587c695d70f",
      "text": "doa",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "28c57c021a0718b729f97a0f3972e57437009769e31b79a48bde6b2f3770b1e7",
      "text": "Terus aku tulis, \"Selamat Idulfitri, mohon maaf lahir dan batin.\"",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ba99d8ec9a16d4ad3bcaa8127fe29e9cfb19c5f4df3f92972ae4a85699a37de",
      "text": "Innalillahi. Sakit apa?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cd98d25f80b40018377ed7ccc161a820587cdf28b9d23cc20b20e54fdba1986",
      "text": "mudik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2de1e3a4a438721596dae5e105d8b8657b30e519586fae949b7e82bd65e28a3e",
      "text": "salam hangat",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "325b094227fee084f0fade281419b57bc45ec8bf3ba512fca053808dad9646b2",
      "text": "Iya. Kartu ini untuk Pak Irwan dan keluarga. Aku juga nulis tentang Lombok.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "33273f41f870f7eca01ac5bd0b25bc78a1cdc63dd1c4d7fd175103b0b6ed5cd2",
      "text": "Nggak apa-apa, minggu depan dia bawa hadiah kok. Dari aku, selamat wisuda! Semoga sukses selalu.",
      "voice": "id_ardi",
      "chars": 96,
      "mime": "audio/mpeg"
    },
    {
      "key": "33d1735c17934c72289ff7146c2c1d4fb603dd598154f17c1a4508ca40ca5701",
      "text": "pada",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "33fefab83212a0a430ea427773d78cc884d6b6818bad399a8791760198f7efc2",
      "text": "Bagi umat Islam, Lebaran adalah hari besar.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "3510b4e32ec2d5b5ffefd5591ca34558dfad91a87fa89eddfa2b8e3f38d184e6",
      "text": "Putri mereka tinggal di Mataram.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "357d59591f28fbe7b5e2c52d403e54658fa38a4b8e3ec625b09de843cd95b01b",
      "text": "lahir dan batin",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "36b43e974139bed8383972e24b53338965230ee4a4acc25dc87d3501bf987048",
      "text": "Kami makan ketupat dan saling memaafkan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "37199f0d702d2fa3346e93b0689e3111ce2bee24230e81b56c7371e0a08df498",
      "text": "Calon suaminya membeli cincin emas.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "374ac9def41865261457a8dd4517fc0ed846b5e6464945b0bf31cd70dee35046",
      "text": "wisuda",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "376e26d2681c7c9b6438ea65d9763293add35ed5e7b2fd2932240033994a4576",
      "text": "menikahi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "383096d641fe9ab89a3c4a308d33e79752ca4faa1c1285c20165db50074a7209",
      "text": "tabah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "390309df9bc0a58b0f53d9730a1d756a90b6a3c6b8c7c5397787118a40934c79",
      "text": "Pak Hamdi, saya turut berduka cita. Semoga Bapak dan keluarga tabah.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6123f6938e47e58b346ca5a750e04b4f89b2e9f85ca06dd0d8f391006ccd66",
      "text": "ketupat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3dd9c8d1e75325fcc24dde8d14c2cf345a587edeca150fd701751bbac91bb806",
      "text": "Perayaannya di mana?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e8200c58eb809c850d65dd26471fd60d271e92e10f716b1c349e32288f6ecdc",
      "text": "Lebaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4107f23a1cb7efa1823bc78ad55eb226ee02d304ac9b910ac55185a3632101ed",
      "text": "langgeng",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "42c6d90e0001c6a01bb7e4e9fce107ade153c73162738da0c15e066605297321",
      "text": "Bayi itu baru ___ dua bulan.",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "4316bf9eb6de3b2276b7018834cf1bb300221e0d64412893c0fe8f27d108e186",
      "text": "Saya berjanji akan selalu ada untuk keluarga kita.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "440a25139b10e4800c9d5e0acd7cf899c4b5324e71377daa5d17114fe2c4f768",
      "text": "mati",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "477ac8441fbde57151b6d58968dbcff78c29f30ce407e2d4591e40306dfc8862",
      "text": "\"Kalian berdua orang yang mulia. Teman yang baik sangat berharga.\"",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "47a1c097c811933435d4d98c1551aaec413879036c8653d74e59b9dc1f8cfa1d",
      "text": "Amin! Makasih banyak, Mohamed.",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "49ccf06d32ae499dcd1ad912d4f0f84d0f44f1d02c5475d6ea1dfd7ff73ce7d6",
      "text": "Kakak saya melahirkan seorang putri kemarin.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a6be3c6588c1c43343ed16266262554183e93b0b69b0ee439d00efaebac5708",
      "text": "Amin. Menurutku, orang Lombok selalu datang buat keluarga dan teman.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c1eef65325557e0d62bd0ddef4125bbc8418cd36d85382883507849e619c67f",
      "text": "berharga",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d21b257480ef510eae5bc735da1805879b995a4490b44e2447bb6360d616e31",
      "text": "Buku ini bercerita tentang Mataram.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d8e3d62be907aae1a69275c1a8d434fbe8e02a89b5b9094d50de873b12288e9",
      "text": "Saya berjanji akan cinta kamu selamanya.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e734bd16b5f0008452552a3b1bd41ea6c33c9b70c78d1761a6b9a7a35493294",
      "text": "tua",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "52e29bdb22dff59d88947ed2ae4b465e98798b477e4d9bb1243ca0fb398cf161",
      "text": "Bagus banget! Pak Irwan bakal seneng.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "539671b38afebec8e9626076a94567cef81713eb74a421c06fd9cf98d780782c",
      "text": "Boleh. \"Kepada Pak Irwan dan keluarga besar.\" Bagus!",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "5459ad6bb004f45fc095bbc7728ec8c6983c637f07a58865da299e2ae63ef37f",
      "text": "Saya turut berduka cita, Bu. Semoga Ibu dan keluarga tabah.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "54ffc7e8a659758b0dea1da8c6010a59db6c9a9e4f1e42fe27a8065a8e13252a",
      "text": "Mohamed, kakakku mau nikah. Aku mengundang kamu, ya!",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "552939809425e0666012468b42ca8eaad1105459ce9ddac44be85aa7b2879620",
      "text": "Wah! Pak Irwan bilang kamu murid yang sangat rajin.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "576de1a66405acd5468cb3b97225120384409ee4738c7d3456a03dc273b63d9a",
      "text": "iman",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "58511e1c1de64773c337b3fed8730c11cc10218266aa9619adf65e933208af98",
      "text": "mulia",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "5925fb83d8112ac830a403abdd9bd7bb5af1d6a42c08dead7291fd49e3914d9c",
      "text": "Menurut Bu Yanti, almarhum orang yang sangat baik.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "5a00156adadf96b355527266938149ed760c95d3ebd2fa07c286158cdb66cb9e",
      "text": "Aku datang, dong! Semoga mereka bahagia terus!",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ba451313503e043760a248670b7f24425ea3fd41f2ef7d0aa4b7138731f2ef2",
      "text": "Tambahin doa juga, \"Semoga kita bisa bersilaturahmi lagi.\"",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bdf9c4a1f36bc3514ca718662fd79b9ad09e14af00d33563ba195770cb20570",
      "text": "Idulfitri",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5faa08cee30464a91e545a8473808396589390a91e83f9d99fdd6c30af9b30cb",
      "text": "Semoga langgeng dan bahagia selalu!",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "6007d7ed867e98f1c3c81728d2e0da96e0e5fbacf36dda97ba363c81e0302c93",
      "text": "Raka: Selamat, Rina! Maaf, saya tidak bisa datang karena saya masih di Surabaya. Minggu depan saya akan membawa hadiah untukmu.",
      "voice": "id_gadis",
      "chars": 127,
      "mime": "audio/mpeg"
    },
    {
      "key": "626975da168138c5ca1297facbe895bbe817e57586a43e7c5829d98cfb8c9347",
      "text": "Sama-sama, Bu. Saya juga mohon maaf lahir dan batin.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "6324ae74455110568f37762ba6366d2a18324f75de7697ba5116e2f3add77d1d",
      "text": "Oke. Di akhir aku tulis, \"Salam hangat dari Mataram.\"",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "6483907930cbd66fb371c4b3ce4ddb42aa52373ba3f52ed06c61aadc05505d09",
      "text": "Rina bercerita tentang Lebaran di Lombok.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "64bb4c3c3308fcf0ac4608c3d25c518aa479f181c202d9d848ced5d321161fea",
      "text": "Selamat Idulfitri! Mohon maaf lahir dan batin.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "64d5e88f83fb6e0bc7c1ffb557f0306fa7bac878c50c5f6ed2c64ea950ed2973",
      "text": "Selamat wisuda, Rina! Semoga sukses dan bahagia selalu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "6baeea3aa17206274ff511ee8232866980da66e7e58d45fd6561606e553d55c8",
      "text": "tentang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "6be2853a56fdd3f5b33a6ba6ec6a292b6641f94869c43673b4dbf0b2961becc9",
      "text": "Mohamed, ada kabar baik nih! Istriku hamil.",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "6c7940d4ef0ca0210d684faa8773561569f3dc8b32b6c034fe2461bbfc5fe06f",
      "text": "Pak Irwan: Selamat wisuda, Rina! Bagi saya, kamu murid yang sangat rajin. Semoga sukses selalu.",
      "voice": "id_gadis",
      "chars": 95,
      "mime": "audio/mpeg"
    },
    {
      "key": "6d0ad59477cb4cbfc80cf817ea4337aa3323e021ac836cfacb2ef69dad17fbb2",
      "text": "putri",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "6fbe456e8f29834338b584bbb56626c2aee4f15a17a9406584526644777e808d",
      "text": "Selamat atas wisudamu, Rina! Semoga membawa berkah untuk keluargamu.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "703ac525b595e99c49beacee19302e76a5c5c0df6d279174ea66e1b80aa2a644",
      "text": "Istri Pak Irwan sedang hamil.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "72066710ff58bd958c70a93384b56c013c7212a842356a943d4a03be43a32c74",
      "text": "mengundang",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "7516ed7bf44c50c04bf5003a27b090f96d25db1f9a3d0e46605d8a13828a4b10",
      "text": "membawa",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "762190bdf96a6188ac93e91b414f19738cd91585ed48608df8067a960f47799f",
      "text": "umat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "762995325eddd8a9ecf829fa8f1c8714d1428c7bad6e1da838972fec640537b7",
      "text": "berumur",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "771be8c845ea0638fef2187195318988a51a2d29bd283c96c9e449ea440a3626",
      "text": "Wah, selamat! Siapa calon suaminya?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "77c861376fe184271e166898af5dc27f112aaebafba6551cdc83bf343f96aeef",
      "text": "Sayang, Raka nggak bisa datang. Dia masih di Surabaya.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "7937370762597c0c9f65817e6ca233768fd98005afea2ca44d9ed1c787e0b76b",
      "text": "Bulan Maret. Kami bersyukur banget.",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "79fd8ec61ec601866926ad9bbd085af8ed29ad9f99828bec2360c652232db488",
      "text": "Selamat atas kelahiran anak Ibu!",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b3f0f0294059a9f0af4c94eb1167f7a282500764e4892cff2739e8968eac48a",
      "text": "Kepada Pak Irwan dan keluarga besar.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c000b70e4fd4bfe9402146cd84ed22d22068fc1648ad8f60729ce2b35f6ab02",
      "text": "pasangan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ca3152c1adbecab4c7a1279f294878110b39ba18baea83db17cc75ca5066351",
      "text": "abadi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d07b40177ecb547b463b507d48f42faa8eb497a0d77416a129ad4338da591f3",
      "text": "Bagus. Terus apa?",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7db3d2e82eff4a839441f6036a035d8149cbaac774e578ecf91b05e9a8eaf96a",
      "text": "almarhum",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "840b75a24baaf43265f4ab7659cea3ed37aa6e54d31e6a0ea0aa2b60bd8495a7",
      "text": "Selamat Idulfitri untuk Bu Yanti dan keluarga besar. Semoga kita bisa bersilaturahmi lagi.",
      "voice": "id_gadis",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "87ca991eb83a78abde82a0a565e9dd46a6bf0b8ec068cc7add50ad958da18090",
      "text": "Kami merayakan pernikahan Kak Wulan di rumah keluarga.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8888e658843b495ffa80798b7903f98c2d8eaadf20f7e71c38c0ca1b4448ef9c",
      "text": "kelahiran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8896feff5c64c551beb20a7a64a1d3cf6cbc965afe1347f75583e28602f5fab1",
      "text": "Amin! Taqabbalallahu minna wa minkum.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "89370d602b1cdc4f48c198c4163c6ef7e55d059ed6a5f8c38ea9c65a3b7a9948",
      "text": "pengantin",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "89a471b58e8b8d90d06d9ddf112690f9b0bf435dc4313b7935287956e512ca90",
      "text": "Menurut Pak Hamdi, ayahnya sakit sejak bulan Maret.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "89f7dfeba0c5e67c1836fecad1880c6bd167293e9187e9504a12439021d8b062",
      "text": "Sama-sama, saya juga mohon maaf lahir dan batin.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a2f0f60f64bc93525aca402ef36e0374d3772f5b60590875f2347537d6372cf",
      "text": "Iya! Hari Sabtu Raka nikah. Aku bilang, \"Semoga langgeng!\"",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e41f138e03084299b9a2b1323f4715b97a39deb25157e6b308ae53d54e4e43d",
      "text": "Terus hari Minggu kita ke rumah Pak Hamdi. Semoga keluarganya tabah.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "929213927330c80a6589ea07af7bcae92ec7d52be7e4f119111a7cab5c6f3e82",
      "text": "berjanji",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "94056a052b3b3f888c6a0b7535141ac394c2b0cc876dde694136efbbc055aeaa",
      "text": "kepada",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9422022aa9d8c8a21f383d0d76fe7fbbdd521721ad5eb8483daa397f913e20b3",
      "text": "Bu Endah sudah melahirkan. Putranya sehat.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "97089a549ffdeac0c69fc58d852979073b27481418978b65021644a5bb6d79c1",
      "text": "calon",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9779f5af78b05770569e3b007a3b1d0d54364f1fa802f765b065a2744ad16113",
      "text": "putra",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cc56a493f9abf7154b0d7d107ed0d7b6782cb5fea8b31a54187730e6f4009bd",
      "text": "Saya ___ terima kasih kepada Ibu dan Bapak.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a008f78ed60ecebe6df8fb4dc2ad40804095f29dd9ae2cd01a0d219d7e7af198",
      "text": "Maaf, saya tidak bisa datang karena saya masih di Surabaya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0a0580cb157716b4c7d13ef4565efd5238484104ea66b3430f2a9c88042f900",
      "text": "Kami mudik ke rumah keluarga besar.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a1834ec6f96f721353aa40fa5fa0c821bfdd67510243f5d9714358f9891ad683",
      "text": "kehidupan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2a9f760faed8bd5dc4794a8f5144cd90514b05ee20379aa1caa7fc8869b524a",
      "text": "Alhamdulillah! Selamat, Mas! Kapan melahirkan?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "a349e3ca5e255e711c9861eba04f51bee2eaa9df64716179ce98d55521f978ec",
      "text": "Terus aku berjanji bakal selalu datang bawa makanan enak!",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4174622efae0d094254270ebf5c11adb39b59a050b7166f43be2ef0b0864b2e",
      "text": "Minggu ini acaranya banyak banget, ya, Mohamed!",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "a44ae2c012398ef32e21a11996d60044a7cd39411bba2380087fc0e89437bbcb",
      "text": "Bagus! Kartu Lebaran, ya? Di kartunya tulis \"Kepada Pak Irwan\", lho.",
      "voice": "id_gadis",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "a58ce5cd78393be808e4af9d8ff2f8e0b556224a4df12cc510a2f048ebf9c9d2",
      "text": "Terima kasih sudah mengundang kami ke perayaan ini.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "a92fe67d89025ec76252c0a99963b0e13f5a8780a5e597dc7900b3704f6179e2",
      "text": "Kami mau bayinya sehat aja. Kehidupan kami bakal sibuk banget!",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "aaccedda17999242e63ca4c9426aaf9d75e9a5d6a00666fe71bccadd0565debd",
      "text": "Rina mengundang kami ke pernikahan kakaknya.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "ab75c156281d309ffb2d0b71668cf697fde6a055edaee3dbac511f73b90acd46",
      "text": "hamil",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad421ae60ba397fe5a0727d93854d363f6e431dca27d31876d79305db5849eec",
      "text": "silaturahmi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ae436ff6c74591cc76501d1947b19a0959198283263ab54c538bc7e4b5adc4ae",
      "text": "Mohamed, bantuin aku nulis kartu buat pengantin, dong.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4164d9c0da431f6c13b8a80e628b2b9531eefe5653b81bee897904119872956",
      "text": "Mohamed, lihat deh! Itu pengantin baru. Ini namanya nyongkolan.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6d2d5cd9caea45bb37b79dadc7f36aba462527e026ca0d3c3ad934e761dfd1e",
      "text": "Semoga kita bisa bersilaturahmi lagi. Salam hangat, Mohamed.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7b453063897d1e23a7dc8e19cbf20b3092d27129d004db8fce6f7b5bb9b8f44",
      "text": "Dia ___ suami saya. Kami menikah bulan depan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8619c9e4423216c89bed311f60880bbe8cbc46d6cf2a0c046d58f27c1021efd",
      "text": "Semoga kita bisa bersilaturahmi lagi tahun depan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8f9875fc27af1f8e8a930087fc8cecd8b6755452e7ef906ef13e9ab064b2cf4",
      "text": "berkah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "b9b44f21c7c70e01a391a1d74e93e54bbb770871f19ea7a544cee0c94e176f5b",
      "text": "Semoga rumah baru membawa berkah.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba00c5cc093d41d29c0f161678426284143296cbb3aab38b0c2b49f6a7a00197",
      "text": "Di rumah keluarga. Semua orang merayakan sambil makan enak.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "ba1592df3c75963f495164b97f2615025ada85060df3c6a19816f29acc48047a",
      "text": "Pengin putra atau putri?",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "c39ab46b9545270d91498548904c559e523890e74732389a081924517c74228e",
      "text": "Selamat Idulfitri, Mohamed! Mohon maaf lahir dan batin, ya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c6c55d0c6b541b4323cf1c70360e38cd62ae96a68e9503dd0d43b8dacd53a1c3",
      "text": "cincin",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "c843a0ee23c213134f45ab076cea2d9010209492d53106d042aa1e2ac4463830",
      "text": "Semoga kalian selalu dalam kebahagiaan.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8797b8221d33f874ac32658633850bbf026615675288d4e48781425a7ab90f3",
      "text": "Enak banget, Bu! Semoga tahun depan saya bisa Lebaran di Lombok lagi.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8c67b1330408adf3165ca91d9e3caf672cc38cdc1347623d53719f456d71448",
      "text": "Tulis doa dulu: \"Semoga cinta kalian abadi.\"",
      "voice": "id_ardi",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbe80827a81ac0e3e65745f14172359fa1e489d1448d5c129dc920c5ca126b28",
      "text": "meninggal dunia",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd77daa6adfe640e0274763e178a22e138ff86f4d3629bdb33d9784068f7f75b",
      "text": "ucapan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce9ebbd09ffc04ef5ed989161e0e903469e055ed5ae3bfd5ddcc559756870aa0",
      "text": "Selamat atas kelahiran anak Ibu. Semoga membawa berkah!",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d061b45dcb814367f2612132b6dbed85d67787b535223005310872b5e1fc66e8",
      "text": "cinta",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3d0bed283a860edc09b6e7bdd9abb3155738d00e878014aba0acd64c2c445ee",
      "text": "Mohamed, lihat deh! Banyak banget pesan buat wisudaku.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4a9f657ab114b50a6a4e32865be7fa65646043ab9df2adeea08c0dd39a3994a",
      "text": "keluarga besar",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d5a7b3a7b62456402c3d4930db64693d882ab5ac8bb3c3ea9f645527bb247a7a",
      "text": "Itu namanya silaturahmi! Minggu depan ada Lebaran Topat. Ikut, yuk!",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6ecb562b7b9c494cc60c612d42858b59ca8938dc6f797b944b5303f3cd2374e",
      "text": "mengucapkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "d752887928c57ebb1be31bc211e44351572e55e97c93cf256acff96a0a3ddbb1",
      "text": "Pak Irwan bakal seneng banget. Bagi guru, kartu dari murid itu hadiah yang indah.",
      "voice": "id_gadis",
      "chars": 81,
      "mime": "audio/mpeg"
    },
    {
      "key": "d9b395e192d694195ba9e6dfff83f523f5108d4591940c77ea8b81ae1e886940",
      "text": "Kartu ucapan ini untuk Bu Yanti.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "db4c7c993c70d59c6583997d9028fe7dd3aa2d04396cd0f7427b1eea38aba377",
      "text": "Kartu ini ___ Bu Yanti. Ini hadiah dari kami.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "dba8f86acbe422a93476e2512e12ad6e595f776aeb03c348cf001ca442f48c5d",
      "text": "Amin, terima kasih banyak!",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbaa85402cc45e47fe8d450ed6f88470451ad7ab1bb5434020251c6edf74f2d1",
      "text": "Ibu saya selalu ___ untuk saya setiap malam.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "dbc14f3af346b7c0a121a322da31594d8d50c201291e47caea71276ca73f7d90",
      "text": "Bu Yanti: Selamat atas wisudamu, Rina! Semoga membawa berkah untuk keluargamu.",
      "voice": "id_gadis",
      "chars": 78,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcb246b143da117731bf084c47bfcf16f9b7680c36aebdb3829986b211e6f656",
      "text": "Selamat menikah! Semoga langgeng dan bahagia selalu.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0a5273f55d3858770f4330494c052b9ed2b536d70b80c5e0105c837893f82b3",
      "text": "Kami bersyukur, ibu dan bayinya sehat.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0c82057328591276bebe98f2c15d630f2b98fcf56d27344b65c169b5137937b",
      "text": "pernikahan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f285ed8909873e067ce0a0f08f88b0cf00a077b3645d60428fba5bb512ba70",
      "text": "Kami mengucapkan selamat kepada Rina.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e17ec7d4dc22b3a808d26878272938985302b882e3e487ada6a528ad8df173cb",
      "text": "Selamat Lebaran! Ayo makan ketupat.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2b81148c4cd58fa5fcdb07d1dd68e14366bf12144c006d5cb5dcda6c21d6b14",
      "text": "Rina, aku mau kirim kartu ucapan buat Pak Irwan.",
      "voice": "id_ardi",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2ede4639f80a73d0fe1cd0c0e261f8e6fbd6406341cc06cd7bf338de0a10d7d",
      "text": "Saya turut berduka cita. Semoga Bapak tabah.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e33cf6fa1813da699354881e3923e2702cdf0fdceba268e99aa459d98d69108f",
      "text": "Menurut Bu Yanti, almarhum udah sakit dari bulan lalu.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "e49672ee7fb6e4273f08582a5adf5f39495422246bc94f93a8f8ec4a30bf9f24",
      "text": "Semoga pasangan ini selalu dalam kebahagiaan.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "e89c403af197649ea19e95f738b54b0114e2cb80ff5b2ca11cd5d5c351e207ce",
      "text": "Menurut Bu Yanti, almarhum sakit sejak bulan lalu.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9073397a5c5ad9c43755ffa7850806e95abafd9fee45fcad273e7d23dc5a73a",
      "text": "Bilang aja, \"Selamat menikah, semoga langgeng!\"",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e918412e5e1492ff13665e15534bc7b6f081a78cbb244fa8bfc906f11447a58b",
      "text": "Keluarga adalah yang paling berharga.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec0e735fbff43901b83e6898dc0b7f5c4264dacc73f12ea75d9b04149ae6ebee",
      "text": "Almarhum orang yang sangat baik.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f0731771f6bfb93f1de98c9719a09568dd7bd8116e520f54480d05b66b44800f",
      "text": "Doa kami untuk kalian berdua.",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f105f6e06fbc9ee4a3235b0076420c5c96b65b3c7869086e9817dd296a44edd2",
      "text": "Ayo, makan ketupat dulu! Raka nggak datang, dia mudik ke Surabaya.",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "f1ffe73280e6c77d6271ad10a2966f7b94f3e6239219129652adda927e8c1d81",
      "text": "Waktu dengan keluarga sangat berharga.",
      "voice": "id_gadis",
      "chars": 38,
      "mime": "audio/mpeg"
    },
    {
      "key": "f230153ed9baec0803f57739acdf4c07c0c51ddb299b2a03694b023d02f3e836",
      "text": "Terima kasih banyak, Mohamed.",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "f243866e22d07c2d613092647da42227d0af5ab6b33233d813ee4b29d91633ab",
      "text": "perayaan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "f4e328032a0d8a0594c5e2e1424d5f23c6d86d7cd012497e84b03efdb23d820d",
      "text": "Orang Lombok, temen kuliahnya. Mereka pasangan yang lucu banget.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "f73ce741973671cae10819fe1f2dde0c8e35ba7dafa96b7443e17415895d340d",
      "text": "Semoga rumah baru Bu Yanti membawa berkah.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "f87304b4adaf4ab5ca109e9cc3a0cf1415ad706beda8ec65570fd9a669408887",
      "text": "saling memaafkan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f930b895058ed74861d3c21b6b8556f1a95f7587d73019ddc64f5ebb338c1ead",
      "text": "Ayah Pak Hamdi meninggal dunia pada hari Jumat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "faf33be08af5d22c061bd15f62f522807b0196c6aaeed332598526d92a68ed85",
      "text": "Saya mengucapkan selamat Idulfitri kepada keluarga Pak Irwan.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb4ca1cadc3497376cf106f1dacaffd7ed558c33eda6020f43e8c30087d25c26",
      "text": "kebahagiaan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb790b99cc2e9c963e53b461be12a7c19534c07f7059bb6258f41a5162dc5182",
      "text": "turut berduka cita",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "fededbec7903fd229162069599695c7db94751c24207ddb8734c666718271a35",
      "text": "Semoga tahun depan kita bisa mudik lagi.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffd60b4d7f8ffadb997b191cd5e0598bd83be2778a912ac7f5b68b2385eceeba",
      "text": "Saya mengucapkan selamat Lebaran kepada Pak Irwan.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    }
  ],
