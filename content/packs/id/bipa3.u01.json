{
  "format": 1,
  "id": "id/bipa3.u01",
  "language": "id",
  "unit": "bipa3.u01",
  "version": 3,
  "content_hash": "0b88c5f6d04ae140fd141cbcf248ca0429d359b0b00a21b376362283eb096423",
  "lessons": [
    {
      "id": "bipa3.u01.l01",
      "sha256": "5edd623d2318c9604719ed9d7a5f44ead52b10c2da685172ee1e99cd24efeb8b"
    },
    {
      "id": "bipa3.u01.l02",
      "sha256": "2c81c26c2f792a9d0697718b4ac0cc67805c02295df7e07c23199e92cabdc041"
    },
    {
      "id": "bipa3.u01.l03",
      "sha256": "6cb0d690632ff9d3e26d7e2db5bb7ce55aa4313677b9873b864ce3c6fdf2cef4"
    },
    {
      "id": "bipa3.u01.l04",
      "sha256": "e87b162e02269eed38fe2fc3b82dfbeb94d80d9761a71de9cad77db8affb4165"
    },
    {
      "id": "bipa3.u01.l05",
      "sha256": "fe2eca0b4d4724a4790304dbd62360a79277010231e36279539f2c80a6b10c0f"
    },
    {
      "id": "bipa3.u01.l06",
      "sha256": "d9e5dcd91eb28c920bc6cceff656fc3697dd7f092d98157980d8d768547170ae"
    }
  ],
  "audio": [
    {
      "key": "01a8e5f817cf6f7d15f1aaa6a32eb68a8c7130d012280fe2b2f314ec8ef2505c",
      "text": "Selamat atas kelahiran anak Ibu. Semoga membawa berkah.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "01dadeda457e0e3a6cd961a33d5471e61d71cabe6c6b7878896ccd859cb69a40",
      "text": "menurut",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0bd3aafd99aaf2152f35cd15a9583e72ab7839a563d4ec37e12a2a0bc680efdd",
      "text": "bahagia",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0ec5b3b6222b6b86fe61f609ed92ba002bb22e477db05d299efc880d3fa51ebe",
      "text": "Selamat wisuda, Rina!",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "0f5533150df59f617edc2f5e6f7b07935fdc1b01b32ede8da0858cd8c4bdf07e",
      "text": "bagi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "21e7609d47a9385e5c54812663c31c68357d91368f7185b746048eb4e77bf0ce",
      "text": "Enak sekali, Bu! Semoga tahun depan saya bisa Lebaran di Lombok lagi.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "23bdb51b3172f5923babe96d395ed91f90d9d38b77f6f0f88e4ed2497fc007a2",
      "text": "Ya. Kartu ini untuk Pak Budi dan keluarga. Saya juga menulis tentang Lombok.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "23c5ab8850b0f6892bcff3bc20d602061a8e7401c5af96b15c39c655bce01a03",
      "text": "Kartu ucapan ini untuk Bu Sari.",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "27d38bd0a06a937966e095f3b22fb4e2bc0f179902cf8f425161bc1c37dcdfa7",
      "text": "Mohamed, lihat! Itu pengantin baru. Ini namanya nyongkolan.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "28b75ff41aea7d6a8e28d6c75906243965ea41f447b2e86dc50fa39ff363b23b",
      "text": "Itu namanya silaturahmi! Minggu depan ada Lebaran Topat. Ayo ikut!",
      "voice": "id_gadis",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "292d3d69e1d30fcd876dafb170effafe958607c2c05ca962aee1b5c776b17091",
      "text": "Amin. Bagi saya, orang Lombok selalu datang untuk keluarga dan teman.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "2cd98d25f80b40018377ed7ccc161a820587cdf28b9d23cc20b20e54fdba1986",
      "text": "mudik",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2de1e3a4a438721596dae5e105d8b8657b30e519586fae949b7e82bd65e28a3e",
      "text": "salam hangat",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "2f80e02b571694e8ce7857960d2cbae8cdeb9f374f321a8d67661c036413c795",
      "text": "Semoga pengantin baru langgeng!",
      "voice": "id_gadis",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "33d1735c17934c72289ff7146c2c1d4fb603dd598154f17c1a4508ca40ca5701",
      "text": "pada",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "33fefab83212a0a430ea427773d78cc884d6b6818bad399a8791760198f7efc2",
      "text": "Bagi umat Islam, Lebaran adalah hari besar.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "357d59591f28fbe7b5e2c52d403e54658fa38a4b8e3ec625b09de843cd95b01b",
      "text": "lahir dan batin",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "36b43e974139bed8383972e24b53338965230ee4a4acc25dc87d3501bf987048",
      "text": "Kami makan ketupat dan saling memaafkan.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "374ac9def41865261457a8dd4517fc0ed846b5e6464945b0bf31cd70dee35046",
      "text": "wisuda",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "383096d641fe9ab89a3c4a308d33e79752ca4faa1c1285c20165db50074a7209",
      "text": "tabah",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "390309df9bc0a58b0f53d9730a1d756a90b6a3c6b8c7c5397787118a40934c79",
      "text": "Pak Hamdi, saya turut berduka cita. Semoga Bapak dan keluarga tabah.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "398719064916bce0ad8d373ab2824ae7315ee109f460b8cf99ca757245d57760",
      "text": "Menurut Bu Sari, almarhum sakit sejak bulan lalu.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "3b6123f6938e47e58b346ca5a750e04b4f89b2e9f85ca06dd0d8f391006ccd66",
      "text": "ketupat",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e8200c58eb809c850d65dd26471fd60d271e92e10f716b1c349e32288f6ecdc",
      "text": "Lebaran",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "4107f23a1cb7efa1823bc78ad55eb226ee02d304ac9b910ac55185a3632101ed",
      "text": "langgeng",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d21b257480ef510eae5bc735da1805879b995a4490b44e2447bb6360d616e31",
      "text": "Buku ini bercerita tentang Mataram.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e865069940d3063a7fede4d9f1b949b3ad14444d7e3f0fa754638613797f99a",
      "text": "Semoga rumah baru Bu Sari membawa berkah.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5459ad6bb004f45fc095bbc7728ec8c6983c637f07a58865da299e2ae63ef37f",
      "text": "Saya turut berduka cita, Bu. Semoga Ibu dan keluarga tabah.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "5bdf9c4a1f36bc3514ca718662fd79b9ad09e14af00d33563ba195770cb20570",
      "text": "Idulfitri",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ed90ff7c5dd05e0264d0132c7fb0fa927b4d0c47e879a36fab048353cd2455d",
      "text": "Bagus sekali! Pak Budi pasti senang.",
      "voice": "id_gadis",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "5faa08cee30464a91e545a8473808396589390a91e83f9d99fdd6c30af9b30cb",
      "text": "Semoga langgeng dan bahagia selalu!",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "626975da168138c5ca1297facbe895bbe817e57586a43e7c5829d98cfb8c9347",
      "text": "Sama-sama, Bu. Saya juga mohon maaf lahir dan batin.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "63ed439782c42dac20857f464831245625633564c9408631c2e85ee1fa03b58d",
      "text": "Saya mengucapkan selamat Idulfitri kepada keluarga Pak Budi.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "6483907930cbd66fb371c4b3ce4ddb42aa52373ba3f52ed06c61aadc05505d09",
      "text": "Rina bercerita tentang Lebaran di Lombok.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "64bb4c3c3308fcf0ac4608c3d25c518aa479f181c202d9d848ced5d321161fea",
      "text": "Selamat Idulfitri! Mohon maaf lahir dan batin.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "64d5e88f83fb6e0bc7c1ffb557f0306fa7bac878c50c5f6ed2c64ea950ed2973",
      "text": "Selamat wisuda, Rina! Semoga sukses dan bahagia selalu.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "65867bc095d12615c187ac5b8017b38eaf461a0723408b9de7c6d9c189954857",
      "text": "Rina, saya mau mengirim kartu ucapan kepada Pak Budi.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "6baeea3aa17206274ff511ee8232866980da66e7e58d45fd6561606e553d55c8",
      "text": "tentang",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "762190bdf96a6188ac93e91b414f19738cd91585ed48608df8067a960f47799f",
      "text": "umat",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "79fd8ec61ec601866926ad9bbd085af8ed29ad9f99828bec2360c652232db488",
      "text": "Selamat atas kelahiran anak Ibu!",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c9cca1489b3e482923cff7b44fcfb188bf720985defef4a8b27dbef68be5fb2",
      "text": "Menurut Bu Sari, almarhum orang yang sangat baik.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "7d3371695c201347aee05ccabab7e6771e50b50aea3371ccf949928ccfd7dd42",
      "text": "Ayo, makan ketupat dulu! Dimas tidak datang, dia mudik ke Surabaya.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "7da92ffa151fbc27ad57e6ea202f2748b57d96b7c976757d427c13a65d2b6c9b",
      "text": "Lalu saya tulis, \"Selamat Idulfitri, mohon maaf lahir dan batin.\"",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "7db3d2e82eff4a839441f6036a035d8149cbaac774e578ecf91b05e9a8eaf96a",
      "text": "almarhum",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "82409390d6e2b890dc76d6a526d9dbe7db99b5a13d4371679b11376453065007",
      "text": "Lalu hari Minggu kita ke rumah Pak Hamdi. Semoga keluarganya tabah.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "8888e658843b495ffa80798b7903f98c2d8eaadf20f7e71c38c0ca1b4448ef9c",
      "text": "kelahiran",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "8896feff5c64c551beb20a7a64a1d3cf6cbc965afe1347f75583e28602f5fab1",
      "text": "Amin! Taqabbalallahu minna wa minkum.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "89370d602b1cdc4f48c198c4163c6ef7e55d059ed6a5f8c38ea9c65a3b7a9948",
      "text": "pengantin",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "89a471b58e8b8d90d06d9ddf112690f9b0bf435dc4313b7935287956e512ca90",
      "text": "Menurut Pak Hamdi, ayahnya sakit sejak bulan Maret.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "89f7dfeba0c5e67c1836fecad1880c6bd167293e9187e9504a12439021d8b062",
      "text": "Sama-sama, saya juga mohon maaf lahir dan batin.",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bde86ca05e02caa42442fe161d51ae6036e624e3f68fd88cdc19dd42889a22d",
      "text": "Wah, ramai sekali! Saya harus bilang apa?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "93027aceb9ba349daded4a7c55b7dbd931ba0aed913b75b14941a1b56a1f6b3e",
      "text": "Bagus! Kartu Lebaran, ya?",
      "voice": "id_gadis",
      "chars": 25,
      "mime": "audio/mpeg"
    },
    {
      "key": "94056a052b3b3f888c6a0b7535141ac394c2b0cc876dde694136efbbc055aeaa",
      "text": "kepada",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "94c09e489aa39dedd437d7364fd8a758aaae4ce062add5c2b141e0f0e287e629",
      "text": "Kepada Pak Budi dan keluarga besar.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "998ed748d5ed09f2087b3ff735e0200af637a7f0d7005f49504c75f8edcd485a",
      "text": "Rina, tolong baca kartu Lebaran saya.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "9cc56a493f9abf7154b0d7d107ed0d7b6782cb5fea8b31a54187730e6f4009bd",
      "text": "Saya ___ terima kasih kepada Ibu dan Bapak.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "a0a0580cb157716b4c7d13ef4565efd5238484104ea66b3430f2a9c88042f900",
      "text": "Kami mudik ke rumah keluarga besar.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "a2f16454724b617c862fa974b686f3b45cc40024594479b0b17de856f7a8b4b5",
      "text": "Bilang saja, \"Selamat menikah, semoga langgeng!\"",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "ad421ae60ba397fe5a0727d93854d363f6e431dca27d31876d79305db5849eec",
      "text": "silaturahmi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "b6d2d5cd9caea45bb37b79dadc7f36aba462527e026ca0d3c3ad934e761dfd1e",
      "text": "Semoga kita bisa bersilaturahmi lagi. Salam hangat, Mohamed.",
      "voice": "id_gadis",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8619c9e4423216c89bed311f60880bbe8cbc46d6cf2a0c046d58f27c1021efd",
      "text": "Semoga kita bisa bersilaturahmi lagi tahun depan.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "b8f9875fc27af1f8e8a930087fc8cecd8b6755452e7ef906ef13e9ab064b2cf4",
      "text": "berkah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "be99b9c5a7f407415da87206b990cea67e2d767bfbe2e2a81c419d3ca6f1a7d8",
      "text": "Mohamed, ayah Pak Hamdi meninggal dunia pada hari Jumat.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "bea7a996b7931a04dc0b48d4f3fd940049828ce4236426357aa32731429c9d57",
      "text": "Innalillahi wa inna ilaihi raji'un. Sakit apa?",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "c39ab46b9545270d91498548904c559e523890e74732389a081924517c74228e",
      "text": "Selamat Idulfitri, Mohamed! Mohon maaf lahir dan batin, ya.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4113ad55aaad34dfc01ac2948b733e4ac1a196649be15a6c4d5bed68ce06b69",
      "text": "Boleh. \"Kepada Pak Budi dan keluarga besar.\" Bagus!",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "c487954f7570921bd11ebfd1f799c793bf2a887fff67c1364678033ed851785d",
      "text": "Oke. Di akhir saya tulis, \"Salam hangat dari Mataram.\"",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5861e79e39bd1e9cf1890d0aa16a186539c0d08af91370e30fd170af7ea0edd",
      "text": "Tambahkan doa juga, \"Semoga kita bisa bersilaturahmi lagi.\"",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "c9cd197288b83cb7c578bdc1cfff9b1fd52bfdaec9849811dc3e3c9278a6c59f",
      "text": "Betul! Pada hari Sabtu Dimas menikah. Saya bilang, \"Semoga langgeng!\"",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbe80827a81ac0e3e65745f14172359fa1e489d1448d5c129dc920c5ca126b28",
      "text": "meninggal dunia",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "cd77daa6adfe640e0274763e178a22e138ff86f4d3629bdb33d9784068f7f75b",
      "text": "ucapan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ce9ebbd09ffc04ef5ed989161e0e903469e055ed5ae3bfd5ddcc559756870aa0",
      "text": "Selamat atas kelahiran anak Ibu. Semoga membawa berkah!",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "d08883c657dbd55a65186e65c9781a2e5b4f9d4a1610af20adba8858b988e01b",
      "text": "Terima kasih, Mohamed. Mohon doanya, ya.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "d4a9f657ab114b50a6a4e32865be7fa65646043ab9df2adeea08c0dd39a3994a",
      "text": "keluarga besar",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "d6ecb562b7b9c494cc60c612d42858b59ca8938dc6f797b944b5303f3cd2374e",
      "text": "mengucapkan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "dba8f86acbe422a93476e2512e12ad6e595f776aeb03c348cf001ca442f48c5d",
      "text": "Amin, terima kasih banyak!",
      "voice": "id_ardi",
      "chars": 26,
      "mime": "audio/mpeg"
    },
    {
      "key": "dcb246b143da117731bf084c47bfcf16f9b7680c36aebdb3829986b211e6f656",
      "text": "Selamat menikah! Semoga langgeng dan bahagia selalu.",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "e0f285ed8909873e067ce0a0f08f88b0cf00a077b3645d60428fba5bb512ba70",
      "text": "Kami mengucapkan selamat kepada Rina.",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "e17ec7d4dc22b3a808d26878272938985302b882e3e487ada6a528ad8df173cb",
      "text": "Selamat Lebaran! Ayo makan ketupat.",
      "voice": "id_gadis",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "e2ede4639f80a73d0fe1cd0c0e261f8e6fbd6406341cc06cd7bf338de0a10d7d",
      "text": "Saya turut berduka cita. Semoga Bapak tabah.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e4a66c134ba9e8bd7478259462c90017b64617e9fdcf6fa718ba92b50a332ef7",
      "text": "Kartu ini ___ Bu Sari. Ini hadiah dari kami.",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "e7627b2793680c14e28b798c25c5d124bc058c812098b4dcaaf427560823b337",
      "text": "Saya mengucapkan selamat Lebaran kepada Pak Budi.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "e936e7b79c2aefc3a2461514c359f99af7e58c61bde0c212f44c2c1675313bf4",
      "text": "___ saya, Mataram kota yang sangat indah.",
      "voice": "id_gadis",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "eab28ca7436280667f8cea83178827031acbd3fba8ad65f42ec56790494797c1",
      "text": "Selamat Idulfitri untuk Bu Sari dan keluarga besar. Semoga kita bisa bersilaturahmi lagi.",
      "voice": "id_gadis",
      "chars": 89,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec0e735fbff43901b83e6898dc0b7f5c4264dacc73f12ea75d9b04149ae6ebee",
      "text": "Almarhum orang yang sangat baik.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3a8bcf838eb54503f6bfdf897e087306e14005770b3ac3abc39dde7c79d51d3",
      "text": "Minggu ini banyak sekali acara, ya, Mohamed!",
      "voice": "id_gadis",
      "chars": 44,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3e1afb58dc55091e94b022ae44529b6cdda780f2c15d160d65964079f865c5d",
      "text": "Pak Budi pasti senang. Bagi guru, kartu dari murid adalah hadiah yang indah.",
      "voice": "id_gadis",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "f87304b4adaf4ab5ca109e9cc3a0cf1415ad706beda8ec65570fd9a669408887",
      "text": "saling memaafkan",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "f930b895058ed74861d3c21b6b8556f1a95f7587d73019ddc64f5ebb338c1ead",
      "text": "Ayah Pak Hamdi meninggal dunia pada hari Jumat.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb790b99cc2e9c963e53b461be12a7c19534c07f7059bb6258f41a5162dc5182",
      "text": "turut berduka cita",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "fededbec7903fd229162069599695c7db94751c24207ddb8734c666718271a35",
      "text": "Semoga tahun depan kita bisa mudik lagi.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    }
  ],
