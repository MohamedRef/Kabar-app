    },
    {
      "id": "bipa7.u05.l13",
      "sha256": "4776dd8927375fdeeccf310e0804d3fed8de2cfb4b8872ea7a012270a9715d43"
    },
    {
      "id": "bipa7.u05.l14",
      "sha256": "e5d6f7259221fed792a98c22403b4b3c9ea37459a21dbc30c5102321a24edfe5"
    }
  ],
  "audio": [
    {
      "key": "003373fdf48569db8c35a577a9d222401fb4f021f5794ff8b31cebcaaacbe7b4",
      "text": "Pak, kakek teman saya dari Bone bilang Arung Palakka itu pahlawan.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "009c5d2b47cd457f7e012c655fc7ed0af1f13f9f2ec4f594013d5f179e63a739",
      "text": "Relief Borobudur adalah peninggalan purbakala yang otentik.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "02c7b813339ba3cec2f0abf1865b167fcc0ecab44741f42a9564ebe8d1d87d8c",
      "text": "demonstrasi",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "0398e35cb4482f14ec80c3b4892db4314ac16ddf3504a0b06c1f61f9f0e048dc",
      "text": "gerilya",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "04011de2c93f7142600d79ccce6be3df318d0d7d78ce4f16d020ac86d531ce40",
      "text": "Tepat. Lalu biarkan pembaca menilai apakah zaman itu otoriter.",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "05d4798bfe380825619bba07f9afe27599f0898875dc72a24feac11467ffc936",
      "text": "Konferensi Asia Afrika diadakan di Bandung pada bulan April 1955. Wakil dari dua puluh sembilan negara datang, kebanyakan dari negara yang baru merdeka. Gedung Merdeka sekarang menjadi museum konferensi itu.",
      "voice": "id_gadis",
      "chars": 207,
      "mime": "audio/mpeg"
    },
    {
      "key": "0738f5ae92107686391b61f14496935d3838f9d23579a62423f0cc3de769490f",
      "text": "Kamu tahu nggak? Orang Indonesia nggak lupa kalau Mesir termasuk yang pertama mengakui kita.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "07c6564462311cf8a5eb53e6a2acaa3fd548f93aa2a71ad6905d047cf895c634",
      "text": "perlawanan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "08860a9d6f884de50936410606dd4a747d2d246593120f07a8073900041ea40e",
      "text": "Sultan Hasanuddin! Yang julukannya Ayam Jantan dari Timur, kan?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "096dd884e8e0cdd3a0d34e00cd251899556bbd2def400608353653fc715a2dc9",
      "text": "tuntutan",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "0d41117c673e728ca1831dd827a4f636b7753163f449763fe7e45d94cd77daf9",
      "text": "Pada tahun 1669, Arung Palakka dari Bone membantu VOC mengalahkan Gowa. Menurut versi Bone, Arung Palakka adalah pahlawan yang membebaskan rakyatnya. Namun, orang Gowa melihatnya sebagai pengkhianat.",
      "voice": "id_gadis",
      "chars": 199,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e1e4e0666685116900a52da24f638e82e737f84848375286cbda0d0c3d1c530",
      "text": "Kamu udah jadi sejarawan kecil. Habis ini ke mana?",
      "voice": "id_ardi",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "11fa25007dfb1491c79877bbd9bba08455b19bed9c9797966cddba31f90a5a16",
      "text": "Itu versi Bone. Kakek saya dari Gowa punya versi lain.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "1347e19b1229006ac977f15a68f12919ee9a9a139dc6ec0495275c309ee0163e",
      "text": "Martha Christina Tiahahu gugur pada usia tujuh belas tahun.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "148c1e5d12c613884fe1f337021e967f3d83020ccee0231672ed77114bc73b6b",
      "text": "Siapa yang membuatnya, Pak? Manusia purba?",
      "voice": "id_ardi",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "15c7b02d2e14f2577a2f053c3572cebbd3ec226a98c16c7a5d1abaadea4875d2",
      "text": "kedaulatan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "16659326a9e21b0fb06277dd0c8f9d43de506224b563275cb725cd52bbe675e6",
      "text": "delegasi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "17a28cfad043e13fda7a6253c8f201ecab508cc8d4b5aefb169f72f23f0be2d5",
      "text": "kolonialisme",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "17abd7b97ef8bc2cde7a037f3b19c7b873faa948a3c6c6588517904127b3a010",
      "text": "Jadi lebih netral menulis \"masa demokrasi terpimpin\"?",
      "voice": "id_ardi",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "1a7ecb373bec74be4267b55618a0384ba42189ef40c5ad71a20c13ab919eb7ef",
      "text": "Istilah \"Orde Lama\" lahir dari historiografi Orde Baru.",
      "voice": "id_gadis",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "1badc4a5d964d061fedf25252ce1ce4abd476b7737c396990a72e7bb549f4514",
      "text": "nasionalisme",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d799cdf01506ef0964d23b9c4282a6ec538df5b2b550bdb80b11c5876faadd0",
      "text": "Sukarno lahir di Surabaya. Beliau belajar di Bandung, kemudian menjadi presiden.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7af793d9621d490c1ed29b9b0a2db80495daacd2835ed64672e1e538dbcb98",
      "text": "Saya pernah membaca tentang Haji Agus Salim di Kairo.",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d7f0d3a40ab30b124071f7c78627f2a5531b0e2139e89502105c934c8078f85",
      "text": "ayam jantan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "21caa80e928b0d6d81517fb57a56b5d61a896ee252f099e35a3dcaae72d41304",
      "text": "Pada era penjajahan, rempah-rempah menjadi rebutan bangsa Eropa.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "21eef13f77ef02b37d43b8731af8844d148682d8f37c905e96e81807a2a4adc3",
      "text": "manusia purba",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "23509845142dfb7a7f6752570148f65bd061403f17763dc40f78e753fc61c18d",
      "text": "Rapi. Tapi antara 1966 dan 1998, tulis apa yang berubah.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "23dbb04a37d9f17c42a1a76ab7ca721b5b8bb00c7bfb243e9871589e0c5ff8bf",
      "text": "mundur",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "258cb33d7c5afb9515ad2125b66351baad386739b5e931a7c50e8c0c95c3e628",
      "text": "Gara-gara rempah-rempah, Pak. Pala dan cengkih mahal banget di Eropa.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "26d38cbc9828f838110c6c18c261029bce0a0501b7d0bcfe7b5845c94ea87997",
      "text": "Demokrasi terpimpin dimulai pada tahun 1959, setelah presiden mengeluarkan dekrit untuk kembali ke UUD 1945.",
      "voice": "id_gadis",
      "chars": 108,
      "mime": "audio/mpeg"
    },
    {
      "key": "28a14d4afe468fdff8a37bc39e5f4930e186838db90ddf9c68f2c61073adaabd",
      "text": "kohesi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "2a0f6d63c3218510c29d360e79dfc9e0d3b1bce4aea244071be3929d27106fda",
      "text": "Dengan substitusi dan pelesapan, kita tidak perlu mengulang kata yang sama, sehingga teks sejarah lebih enak dibaca.",
      "voice": "id_gadis",
      "chars": 116,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ad0f797c07bf726c6b3e88596ca7784191a4b74340fc7f909a0e8b636a59471",
      "text": "serangan umum",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bd53cea610ae69b7cbd684d670931c1236b16926b0ce8a496fa4cd8ae96a50c",
      "text": "niaga",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "2ce0743eebd231e43fe3c79e20f15204ac6b8cc4cba50e37cfe6daad46207f14",
      "text": "kerja rodi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d560ee8e39773f2f267782d24055f7f6cc2173107be45464acf2a7d9181342c",
      "text": "berperang",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e425ddfc5b6778c153baa8983b6efbdc3b41650bbe17dade430ab70da73d432",
      "text": "VOC",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "2e97a763401ebddc1c808fd4f6f25655b1badb698278979c76a9b0f463ff68b3",
      "text": "Ya, Pak. Masih ada empat tahun revolusi.",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "313fbe4cb42283f6ea28a29135d5775f45da6dc575c174d6e74a0eba505052da",
      "text": "arca",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "36f9473c1e6c4e22b1eaa0f5648d3b4f648e5105f51d11943f520113cc4a1c2c",
      "text": "proklamasi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "3a4fcf521b5da44e5b94c2a26b382b12788bc3df6f37270e367133485e39d600",
      "text": "Betul. VOC lalu memaksakan monopoli. Pedagang lain dilarang.",
      "voice": "id_ardi",
      "chars": 60,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cb6b51cd10d07dec256da2af9d2c6c0620d0f6d21f9240c36d1d19d7b9dd36d",
      "text": "Di sini dulu benteng Kerajaan Gowa, Mohamed. Nama saya dari sultan itu.",
      "voice": "id_ardi",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "3cd4b1c18fafdf25ab76f4a99b3f9050198ef7af8d08ae709c2bc85c6e767d7e",
      "text": "Masa Orde Baru berakhir pada tahun 1998.",
      "voice": "id_gadis",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d434cada587357f11a0505eff0fd972261c2bcac8fd228f7f986f2b251f9bd4",
      "text": "Monopoli VOC membuat harga cengkih di Maluku jatuh, padahal di Eropa cengkih masih dijual sangat mahal.",
      "voice": "id_gadis",
      "chars": 103,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d5e84c9fec3ffc66e05161d3908305eb6df758f8aee3c4f0989a18490fc7211",
      "text": "Dasasila Bandung lahir dari solidaritas bangsa Asia dan Afrika.",
      "voice": "id_gadis",
      "chars": 63,
      "mime": "audio/mpeg"
    },
    {
      "key": "3d971ba5162095dbc87545353f1371b34961fc19036608d21cba1c1070af8fbe",
      "text": "Pak, ini linimasa saya. Empat tonggak sejarah, dari proklamasi sampai 2004.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f046e9f9f4e31136ee52f393b6a7baa30bd23373145f12a66d5a87b938a9682",
      "text": "Coba lihat gambar di buku sejarah ini. Siapa perempuan berikat kepala merah itu?",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "3fd5ec37a42afb46f236d8e3b1caf5b351baa53aded0359ab6cdf33fbd8e0747",
      "text": "Pada tahun 1947, Indonesia masih berjuang melawan Belanda. Utusan Liga Arab itu bertemu Presiden Sukarno di Yogyakarta, karena Jakarta saat itu dikuasai Belanda. Ia membawa kabar pengakuan dari Mesir.",
      "voice": "id_gadis",
      "chars": 200,
      "mime": "audio/mpeg"
    },
    {
      "key": "41ad21f7c17fc43738e6a27ef70fa1a778ba2a051429085c069336c75252d6f3",
      "text": "Dan sekarang ribuan mahasiswa Indonesia belajar di Al-Azhar. Persahabatan itu masih hidup.",
      "voice": "id_ardi",
      "chars": 90,
      "mime": "audio/mpeg"
    },
    {
      "key": "42a363c9996c0c6f9741e66c5c4fdebd8923c2208c1ce7bc1400d514a49585a3",
      "text": "imperialisme",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "439efc6bffdc76a79e71cc65db9e8de07e9d05c06f950238122aac89abb533b8",
      "text": "Orde Lama",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4970ad5b20fdd8694db25b8b7003785ccbe5cbf59dc2c29ded9a4490afd18401",
      "text": "Ke Misool. Saya mau belajar tentang hoaks di internet.",
      "voice": "id_ardi",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a00ff1a6985cea7990e823ced1e6a2a493a661798a1582ac8b17f82c4bbe49d",
      "text": "kebangkitan nasional",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "4a7b3089bb049b37e229b64f029da8580b19d4486e4c6bf12831fe2b5bf06fdc",
      "text": "Banyak petani menderita karena tanam paksa.",
      "voice": "id_gadis",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "4aca516a33c1b35591cf77ea261c735682d8e028947feabcb9b4910dbc25d4c6",
      "text": "negara berkembang",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "4ba7f80a955c8765650270b01755c4d85aa648b6182f44d20cc893b32affed73",
      "text": "Perlawanan Gowa dan versi Bone sama-sama bagian dari linimasa Sulawesi.",
      "voice": "id_gadis",
      "chars": 71,
      "mime": "audio/mpeg"
    },
    {
      "key": "4be599bf5a72ca088912b70e0249f843c9ba7f33f565478f2951420002ff0944",
      "text": "penjajahan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c5f0e5af4a99b45410e86faab3c40248360cb700dfe26c0a732bde952e892fa",
      "text": "Dekrit Presiden 1959 mengakhiri Konstituante.",
      "voice": "id_gadis",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc42753ef0d202ace7e3b96cdd07cb69bfdeaa9620a5f1ce8c9aaf92f199598",
      "text": "linimasa",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "4d9c254973e23a37bcd6a0731a2c23fa31fc0862de51202c00a518f32f9517e3",
      "text": "pemerintahan",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "4e92433894be5e8c6c3622068d32bd98a7a64d32398accf3ea12fc6ef8e8efa5",
      "text": "monopoli",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "5134aafe0daac61237e498c53a06d7ef4e26b764d92b76e3ad305d28ba074c28",
      "text": "otentik",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "5204aae3f664cb39d755c8e547e6c191be65861ffcc3ffa0ea93f153663981d9",
      "text": "Ya. Syahbandar di Makassar dulu menerima kapal dari Arab, Cina, dan Gujarat.",
      "voice": "id_ardi",
      "chars": 76,
      "mime": "audio/mpeg"
    },
    {
      "key": "521dc80024106e674c5a311c7d3072d34ee3ceb3f9f5a824b091252ed439ba02",
      "text": "Sukarno lahir di Surabaya. Sukarno belajar di Bandung. Sukarno menjadi presiden.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "527cff827d0fe9980efe7c3ba190cb9acca3e67e962529abdee8c60bdcba6c3e",
      "text": "Julukan \"Ayam Jantan dari Timur\" diberikan oleh musuhnya sendiri.",
      "voice": "id_gadis",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "54d19a91f30dbb9d1ab72ddd5fc06ad43ad02a4f235b7283645bb1df6477d2b7",
      "text": "diplomasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "5606ca91c5134ed17f5cc6d1eac5555f89834dadc444097e3ef995ad1f43da15",
      "text": "Lalu periode Jepang, singkat tetapi berat, sampai merdeka tahun 1945.",
      "voice": "id_ardi",
      "chars": 69,
      "mime": "audio/mpeg"
    },
    {
      "key": "5c59777c01a452f8952c7cc7f962293f3f7ab683a437fa647deaa6d1f0ba0382",
      "text": "Maksud Bapak seperti \"Orde Lama\"?",
      "voice": "id_ardi",
      "chars": 43,
      "mime": "audio/mpeg"
    },
    {
      "key": "62fcac437e5740702448ddeb76286b4d0d3d5210c799b63ab7b21b1c4797e168",
      "text": "Martha Christina Tiahahu lahir di Pulau Nusa Laut, Maluku. Pada usia tujuh belas tahun, Martha ikut berperang bersama ayahnya melawan Belanda. Ia terkenal karena keberaniannya di medan perang.",
      "voice": "id_gadis",
      "chars": 192,
      "mime": "audio/mpeg"
    },
    {
      "key": "63849061f0fc37f28b8d1431e7ce6d00e9a07f48635be6f1017f9bd7773474ca",
      "text": "Setiap tanggal dua Januari, orang Maluku mengenang pahlawan nasional ini.",
      "voice": "id_gadis",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "647ac0d49359d8b2ffcadf209a81b26a8ef8825e8335ed9b6b92c929c7d4da0b",
      "text": "naskah kuno",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "64fc2472199bb11b9e35cff72ce9c5968e9642ad86de01e68153138c73ca5267",
      "text": "Setahun kemudian, Mesir menasionalisasi Terusan Suez. Semangat Bandung sampai ke Kairo!",
      "voice": "id_ardi",
      "chars": 87,
      "mime": "audio/mpeg"
    },
    {
      "key": "6768f53dacc1c5dbb3467187a16c3250d697d8ffea4b8d897571f23aba645539",
      "text": "Bagus, kamu pakai \"tersebut\" dan \"-nya\". Tidak ada pengulangan.",
      "voice": "id_ardi",
      "chars": 83,
      "mime": "audio/mpeg"
    },
    {
      "key": "679d609dd63e5fb1f5f8fa4ca4cb915db5aeef935d74ce83eb8a31753d2cb9f0",
      "text": "Perundingan itu berakhir dengan gencatan senjata.",
      "voice": "id_gadis",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "68b2997388cbceaddbbf1db0f65b4de5bce2b1f9f599ed0dd4f358eb3bf40cb0",
      "text": "Banyak tokoh perempuan Indonesia menjadi pahlawan nasional karena keberanian mereka.",
      "voice": "id_gadis",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "68e3b1f067cc1be58a5faac2975bc9214cdafc9e1b652f9e8c67f0d4c685111c",
      "text": "Krisis moneter tahun 1997 membuat harga-harga naik tajam.",
      "voice": "id_gadis",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "6990f112f23f8c070910a145d308c3ddad515f79d14a167d0c28e42161d1a3c2",
      "text": "Kedua tokoh tersebut masing-masing menulis memoar.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "6a6ad259787eedf92bb666b5736f7f94f5848f33343c926579ed6ddd5465d50d",
      "text": "krisis moneter",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "6b746253dcd25159c4a6eb502aedf887d3931b6e9ce36a17cbe2ce9a2e18fe6d",
      "text": "tonggak sejarah",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "6bd9d83e908ef3ba63ffe6145a3e50fd7f754ae824a551b2761d94c20ca280b6",
      "text": "masing-masing",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "6db2a499497609b72eb380cfc738b6c96e5cba32b1be053bd5d7fde35c8422bf",
      "text": "Gerilya dan diplomasi berjalan bersama.",
      "voice": "id_gadis",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "6dfa894909d01d6eeb38ef76795475bc31bdddb03f069deea19a07153d1560ba",
      "text": "Ya. Itu nama dari lawan politiknya. Itu soal historiografi.",
      "voice": "id_ardi",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e57dff5448fcb7a683d9c65e1e064f881d02011fa865dfa5316d4b3426230b9",
      "text": "reformasi",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "710626acecbf4a79441b64a1e566eb99d97095e7da34dc3612ee68f5a9831043",
      "text": "sejarawan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "7165687af06bee5633acbba1127f4a0020a8dbe11050b57fafad2dddfc100fb6",
      "text": "maritim",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "71b8ad3d4f59ff41fd58f37d547d6823c122b914238633f0a89134468e424b6a",
      "text": "Belanda datang ke Nusantara untuk berdagang rempah. Era VOC dimulai pada tahun seribu enam ratus dua, ketika beberapa perusahaan dagang Belanda bergabung menjadi satu.",
      "voice": "id_gadis",
      "chars": 167,
      "mime": "audio/mpeg"
    },
    {
      "key": "735f296436757c414777266196b96f2a5d355c7fd7403853abc6c3ae0ccafeb6",
      "text": "Beliau memimpin delegasi kecil, tapi hasilnya besar. Sebuah perjanjian persahabatan.",
      "voice": "id_ardi",
      "chars": 84,
      "mime": "audio/mpeg"
    },
    {
      "key": "738b5a68c2ba731fc45579ec43e45053068cbb0918432314a02febd02b870854",
      "text": "Setelah tahun 1966, Soeharto memimpin pemerintahan baru yang disebut Orde Baru. Orde Baru berlangsung lebih dari tiga puluh tahun, sampai Reformasi pada tahun 1998.",
      "voice": "id_gadis",
      "chars": 164,
      "mime": "audio/mpeg"
    },
    {
      "key": "73c366d9de327324caa7f5ac862804817940b5ef43df6f9eef1df0f62aa5958b",
      "text": "Pengakuan dari Mesir sangat penting bagi bangsa Indonesia.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "7534d0e89fde234b980896439472efd1ee05b168c0e6530b2b2fa9075120530c",
      "text": "Saya nggak tahu, Pak. Dia tokoh perempuan dari Jawa?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "769c6fbd2eeb0b5d5083025ff5d64a79009cab2cdddf2ad0c782758a5939a383",
      "text": "Betul. Pengakuan itu penting sebelum kedaulatan penuh tahun 1949.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "77b8f17b2fa4fcf5bc747bc2c545a68484bcf9028da808779b3b6f43b86a694d",
      "text": "Dari sini kita lihat banyak pulau karst. Indah, kan?",
      "voice": "id_ardi",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "77ec8b05a9d4775f57c5b203a56ddd3e6a47b11327cdd5c03582942d146e1058",
      "text": "Jenderal Sudirman memimpin perang gerilya dari hutan ke hutan.",
      "voice": "id_gadis",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "7a0823ae45f58fe8e3710f771b55ec4158bd8a0bc40d41f66631bc1cf5bc3f8c",
      "text": "pahlawan nasional",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
    {
      "key": "7c40e69d28731ccecb5bb04a4a287119113ef6213f5df326a9dd75bcc7dca4fd",
      "text": "Gimana kita tahu lukisannya otentik?",
      "voice": "id_ardi",
      "chars": 36,
      "mime": "audio/mpeg"
    },
    {
      "key": "7ef60ce22a186dd41e621f859fc05d8b36ff7bed2cae07015d7b301d3fd34d94",
      "text": "Tuntutan mahasiswa akhirnya didengar, dan presiden mundur.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "80e2e6cd22f1458158a9284e8d82d31bec39c1b271733168b304363c7c958e5b",
      "text": "Era Reformasi dimulai setelah demonstrasi besar tahun 1998, dan sejak itu rakyat bisa memilih presiden secara langsung.",
      "voice": "id_gadis",
      "chars": 119,
      "mime": "audio/mpeg"
    },
    {
      "key": "80e9c55fc965d8bb011e51e520fe3a3f781ab681dd5b9bb9c0f891c522b4fbbc",
      "text": "Musuh pun memberinya julukan. Itu tanda hormat yang besar.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "8373051acaf3cd9ea20745edcb136f9ced7f5b966f6ed823763ef073cf2de7e5",
      "text": "Coba baca paragrafmu tentang Sukarno.",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "842233d86dc2b87a2e2bb928b1cc02a06e0c351f2f05e34ed9c5970fa702a246",
      "text": "pelesapan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "84f36adaa8d7213643456c1a922358746a7447654eba90c832660a5a097bf3cc",
      "text": "purbakala",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "85ce543a58625f347313f269e22573ef2c39b39b77360bfe073a65e98b8defd5",
      "text": "pengakuan",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "86e9cd18b2134b5f9d8da2ba971bb00af96ecdb147d0fbea9118b77a3186e6b2",
      "text": "Setelah berminggu-minggu demonstrasi, ribuan mahasiswa menduduki gedung DPR. Pada 21 Mei 1998, Presiden Soeharto mundur dari jabatannya, dan wakilnya, B.J. Habibie, menggantikannya.",
      "voice": "id_gadis",
      "chars": 181,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a490246f3dd5dbee243d25e8c2d333bea216bbedd46309d15ccf8b29f16b483",
      "text": "tanam paksa",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "8bb94e64f0c97c4787880b4674f9364d7225f520cad63ef5f6a8d852b4a3bc87",
      "text": "Belanda mengakui kedaulatan Indonesia pada tahun 1949.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "8e13db6c653989d7a6c530dedac5b9a43fded04a14633c538125bef41fee33eb",
      "text": "otoriter",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f34ea74d7980d938ec2a9e572b3e3b545031667aeca1e6cb68b1f54fdafafeb",
      "text": "Presiden Nasser dari Mesir hadir di Konferensi Asia Afrika.",
      "voice": "id_gadis",
      "chars": 59,
      "mime": "audio/mpeg"
    },
    {
      "key": "90428afd86c0827f4c87a809d8fbb3857c26bb0c918561e47bf77c0b6b2d9a67",
      "text": "Betul. VOC punya kapal dan sekutu, tapi perlawanan Gowa bertahan bertahun-tahun.",
      "voice": "id_ardi",
      "chars": 80,
      "mime": "audio/mpeg"
    },
    {
      "key": "90bfabdcf34cca2d942975ba97990568b6a6fbc3167ac0a109d4f0d388669713",
      "text": "Soal solidaritas negara berkembang dan cara mengakhiri kolonialisme.",
      "voice": "id_ardi",
      "chars": 68,
      "mime": "audio/mpeg"
    },
    {
      "key": "9513eccc88620d5aa48d40ee9e5ffd549b913822cf8dfca180ba099240b19e84",
      "text": "Era Orde Baru tersebut berlangsung lebih dari tiga puluh tahun, tetapi berakhir dalam beberapa bulan saja.",
      "voice": "id_gadis",
      "chars": 106,
      "mime": "audio/mpeg"
    },
    {
      "key": "959f8860e59312779b6ce6745dc3d036baf78fca427c9fbef25f891c41e38a55",
      "text": "historiografi",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "960174f2bf55c8409aa529f51979acced5f0685ebe3dec6438f356c40ff3677e",
      "text": "Kebanyakan \"Sukarno\". Pakai \"ia\" atau \"beliau\". Itulah kohesi.",
      "voice": "id_ardi",
      "chars": 92,
      "mime": "audio/mpeg"
    },
    {
      "key": "96ab4bccf9732a56009887dd437119ceeb0c3c588219918d37ad66eddd379013",
      "text": "Sebagai sejarawan, saya membaca sumber dari Gowa, Bone, dan VOC.",
      "voice": "id_gadis",
      "chars": 64,
      "mime": "audio/mpeg"
    },
    {
      "key": "96fce78377e91970ff2840b6edea85b370275e3bd9f3725a751e7ac9122e7c2a",
      "text": "Hari Kebangkitan Nasional diperingati setiap 20 Mei.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    },
    {
      "key": "9756e182b1bfaf9540eac3e7deb267e290c06d6046843a69ecb9311aca712d9a",
      "text": "gugur",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "989b7c008885f16df17896fba7ba782a264a05d3de28d6d6443413f804111b94",
      "text": "Utusan dan delegasi itu membuka hubungan diplomatik kedua negara, sehingga Mesir menjadi negara pertama yang mengakui Indonesia.",
      "voice": "id_gadis",
      "chars": 128,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a445380890d7e22fcfaaca32f3e0c655564f94caa792397ec2129e3e164188f",
      "text": "Apa hasil akhir tahun 1949?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "9ad4657fe39beec7ad0d76cc855c0460532cb6f791270ec77d2fbf2caed99866",
      "text": "dekrit",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "9c657166f128a3d0c5dfa8fdd534226d695b80a776c79b90397cc25dc6296d7f",
      "text": "Apa tuntutan Bapak dan teman-teman waktu itu?",
      "voice": "id_ardi",
      "chars": 45,
      "mime": "audio/mpeg"
    },
    {
      "key": "9fcfed0da54920b41a151be37b4b9cea3ae2cdb127ec64367caae569dd809487",
      "text": "Tahun 1998 saya masih mahasiswa di Makassar. Kami ikut demonstrasi setiap hari.",
      "voice": "id_ardi",
      "chars": 79,
      "mime": "audio/mpeg"
    },
    {
      "key": "a07a4c5b1d72e46bdef8e1f240727faec7bf81b33a6e5e213720fd310075ac7f",
      "text": "Mohamed, kenapa orang Eropa datang jauh-jauh ke Maluku?",
      "voice": "id_ardi",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "a3fc7a4dff1d1d070eb2b577c440e424d20f97c3916dcea45912024a7c89d2d0",
      "text": "Liga Arab mendorong anggotanya untuk mengakui Indonesia.",
      "voice": "id_gadis",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "a410a177b836aa9142c5c64b0d6396096ae0288834274e4868ba64503d0462ce",
      "text": "substitusi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "a4b71081c6e8ce59a7ef7c6c99a834fc1247673935e380a5ef9c649ba254d643",
      "text": "Orde Baru",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "a8f2bf1fa55dc5de0b2632b4140064dbc56e5ef440b005eff4ac2b1e47f99e27",
      "text": "Relief di dinding candi menceritakan kehidupan Buddha.",
      "voice": "id_gadis",
      "chars": 54,
      "mime": "audio/mpeg"
    },
    {
      "key": "aeb6f4c9e41fe1921651ba10a90b9be970ba8d7a0bb95f3724ac809201dada0c",
      "text": "Lihat foto ini, Mohamed. Ini Bung Karno, dan di sebelahnya Presiden Nasser.",
      "voice": "id_ardi",
      "chars": 75,
      "mime": "audio/mpeg"
    },
    {
      "key": "afc81065a864453d502b8b06e9c8d6b0cd0d2c27a8957ae3d8061dbc88d45bb6",
      "text": "Siapa yang mempopulerkan istilah \"Orde Lama\"?",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "b077356dff627c0f495ec32f8ba888d9a5d179fe817e513e89876f134c9ef761",
      "text": "Di hutan ada gerilya, di meja ada perundingan.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "b0aa93fc47c140009f9f80a61bd4808007d69c4708f0f9fafb317ada16f81580",
      "text": "Apa itu tanam paksa?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1db4b21a663fb41dab76b6c2ae52639aa0d42437e949b9920bcdec44eb79c1e",
      "text": "Setiap periode dalam sejarah meninggalkan jejak yang berbeda, jadi kita perlu membaca sumber dari banyak pihak.",
      "voice": "id_gadis",
      "chars": 111,
      "mime": "audio/mpeg"
    },
    {
      "key": "b1f99672295918443b0f934c9ef1bc771b19c85df584e903cc083ed5f96ece5f",
      "text": "diasingkan",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "b33915bdeccac75ab42c6526c22f5cc5d9aa60154f292bc3a720b5d99712b20b",
      "text": "Manusia purba hidup di Jawa jauh sebelum zaman sejarah, karena itu kita mengenal mereka dari fosil, bukan dari tulisan.",
      "voice": "id_gadis",
      "chars": 119,
      "mime": "audio/mpeg"
    },
    {
      "key": "b44fad66a184fb6653479c6dabefceb56d5b57735d8b7f000be0bbdaad3d81cc",
      "text": "Dalam linimasa saya, Orde Baru ditandai dengan warna kuning, supaya periode itu mudah dibedakan dari era Reformasi.",
      "voice": "id_gadis",
      "chars": 115,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4ba17bec1a0677b58e0c903de1c3e50a9ab59dbc3e64ef7871e0c5601f70976",
      "text": "Reformasi. Harga beras naik berlipat-lipat karena krisis moneter.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "b4bc1771709ea08a24830da3ca36ee05297a4daa700a751d881796963d4cff84",
      "text": "Pemerintahan Jepang di Indonesia berlangsung dari 1942 sampai 1945.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5bd3d4426ba356551d39b2a5191bc2b3f3f6e606e37c0fc253ab63b5d064961",
      "text": "Niaga rempah-rempah membawa kekayaan sekaligus penjajahan.",
      "voice": "id_gadis",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "b5fbf8da9bc35e65e82442738530415055daa0e572847ce3c1e3e337e209910a",
      "text": "Gencatan senjata tidak selalu dihormati kedua pihak, sehingga perundingan harus diulang beberapa kali.",
      "voice": "id_gadis",
      "chars": 102,
      "mime": "audio/mpeg"
    },
    {
      "key": "b616636983075e5388915f0cfad5bdec977fc11f6ea3c44f37f6a0e679f6f926",
      "text": "Bandara di Makassar memakai nama Sultan Hasanuddin, pahlawan perlawanan terhadap VOC.",
      "voice": "id_gadis",
      "chars": 85,
      "mime": "audio/mpeg"
    },
    {
      "key": "b7ed528d6191bf519fb1d3e7c024482976c5e467a1eec53e35c6479af7c33448",
      "text": "demokrasi terpimpin",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "bcc4535cebedaa44ae085cfe0cda7a040662adb8ebbb8b68f4763591ae9fa4d3",
      "text": "Dan Mesir bantu lewat diplomasi, kan? Termasuk yang pertama mengakui kita.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "bd93ad7b6553e450455dc53e614f995e36f80d3d8885759f56c5deb3d1db2dcd",
      "text": "tersebut",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "bfde228f2861c5f3a4945e822ae908baeb26d1c2b80f7c59cfa7cd5defcc1aa2",
      "text": "Pada Desember 1948, Belanda melanggar perjanjian. Pada Agresi Militer Kedua, Yogyakarta diduduki Belanda, dan Sukarno serta Hatta ditangkap lalu diasingkan ke Bangka.",
      "voice": "id_gadis",
      "chars": 166,
      "mime": "audio/mpeg"
    },
    {
      "key": "c0349ce49ae71001a3897707b602c76d6aca307d85af3a1d2886925b89fa7af3",
      "text": "Coba ceritakan periode penjajahan dalam satu menit.",
      "voice": "id_ardi",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "c167c4b8620677d5ad7f3d02adbdb61e8f54e02ef0a06ad7739aaac8a45c0ab7",
      "text": "Manusia modern awal, puluhan ribu tahun lalu. Ada gambar tangan dan babi.",
      "voice": "id_ardi",
      "chars": 73,
      "mime": "audio/mpeg"
    },
    {
      "key": "c3a000ed1410c4d4471db4bc6b32e7027f468fde178ae39633de4d8d13d83eef",
      "text": "Masa Orde Baru panjang. Sejak Reformasi, pers menjadi lebih bebas.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "c48d957e694ac561bc7f4e98e35b783cfe547518fd7e138b7b2da12065ac706d",
      "text": "Terus siapa yang bener?",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "c4cf3710fe1eb2e03d6baf6634af34f934d5a525a027472cbfa1a6104d530bce",
      "text": "versi",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "c53b1452f7fc3126a0f32528d0a324869280ff0a486a05f7c8f384416b78b6fc",
      "text": "Liga Arab",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "c59f583a63486f86285cc0168abf573b46e601a78fd7ca255576d939253840a2",
      "text": "Masih remaja! Keberaniannya luar biasa.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "c5a4a9801c4c2be5680d510ff6739cf0f03b71ca84f42184ebfd67f587fa42bc",
      "text": "Dasasila",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "c63e6eb35b60999dac2f5bf33d17b475e2cb5ed3189c01f834988a75d0993234",
      "text": "Di perpustakaan keraton, saya melihat sebuah buku yang aneh. Naskah kuno ini ditulis di atas daun lontar, karena kertas belum dikenal di Bali pada masa itu.",
      "voice": "id_gadis",
      "chars": 156,
      "mime": "audio/mpeg"
    },
    {
      "key": "c8e6201e83374b92522980b71d2ffc4ffe2e993ac3b290563fdce4eefc344b3a",
      "text": "tokoh perempuan",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "c92844aacdb710cb4a10bab6b03312e2e6fa4e89a091e53ef1d0529e6dac8f71",
      "text": "kongsi",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "ca41cd7ac0a5126b3342f068554dc3580019ced8f0d2e8aa3b256f2443706c6f",
      "text": "Dia gugur di atas kapal dan dimakamkan di Laut Banda.",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "caeb5457ea3b301635828c60b1bea104d50fdb0fa8082610ab0171876c687503",
      "text": "rempah-rempah",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb19f3b07b15475f1c083d9152816071f9c35a3ccd2e4cba9770c18b02cd48f1",
      "text": "Dua puluh sembilan negara berkembang datang ke Bandung.",
      "voice": "id_gadis",
      "chars": 55,
      "mime": "audio/mpeg"
    },
    {
      "key": "cb98642890a1cc7188b3b8ae68facd3fa622ec831b141a45027b01dc5b8ef15e",
      "text": "Kemerdekaan tidak selesai pada 17 Agustus 1945, Mohamed.",
      "voice": "id_ardi",
      "chars": 56,
      "mime": "audio/mpeg"
    },
    {
      "key": "cbf093fc28e359da0c647f31a833f9a4e4c4d7e9f160c7ca494994f23f7f6730",
      "text": "Cut Nyak Dhien juga berperang melawan Belanda di Aceh, walaupun usianya sudah tua dan matanya rabun.",
      "voice": "id_gadis",
      "chars": 100,
      "mime": "audio/mpeg"
    },
    {
      "key": "cc02fb87297fa360ce72fcf7a5fcaa8fc42513298be826b19f563907811186ae",
      "text": "Para ahli purbakala mengukur usia lapisan batu di atasnya.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccba2d28d6b8fe3e1ddcf98660f7a19e071daca672eb2d42395781e81bce055b",
      "text": "Apa yang ditemukan di Trinil dan Sangiran?",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ccdfb263c4b0c76bf7ab8d99f13cd78d794f1d9dd52364cb15a76ed844d83d06",
      "text": "Proklamasi adalah tonggak sejarah bangsa Indonesia.",
      "voice": "id_gadis",
      "chars": 51,
      "mime": "audio/mpeg"
    },
    {
      "key": "cfb2bffa4c2355197d751f85873590cde9574936ac49de224ed6702fd7194485",
      "text": "relief",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "cff0722e737153fc95fafee561d35d144914232768ad728f328900c849bc3395",
      "text": "Nah, sekarang linimasamu bercerita, bukan hanya berhitung.",
      "voice": "id_ardi",
      "chars": 58,
      "mime": "audio/mpeg"
    },
    {
      "key": "d0e7efdc0c2639b7160750fd29ddc98e0d91ef2f4a0e50c0d3596101cff33967",
      "text": "epigrafi",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "d11c845db27e4d79e3dd74bc9615f9e9125c890268bc270704c4543e66af6186",
      "text": "Pada abad ketujuh belas, VOC ingin menguasai perdagangan rempah di Makassar. Sultan Hasanuddin memimpin perlawanan rakyat Gowa melawan VOC selama bertahun-tahun, walaupun akhirnya ia harus menandatangani perjanjian damai.",
      "voice": "id_gadis",
      "chars": 221,
      "mime": "audio/mpeg"
    },
    {
      "key": "d199dac4fdce50273a1ae8a0826013be9aa1eba22827f3fa2a57ca8252146e03",
      "text": "Indah banget. Kayak linimasa, tiap pulau punya ceritanya sendiri.",
      "voice": "id_ardi",
      "chars": 65,
      "mime": "audio/mpeg"
    },
    {
      "key": "d3bccea4685967e416693faabde576c4ab96e5b844a0b1580fd0d614c6c4fe73",
      "text": "era",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "d546ac781d968f0c7ec41979e42a875f09b884581cd4527fc9ad264f37d8aa18",
      "text": "gencatan senjata",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "d88faca839ae53568ca47b68c2ee81dbdc02d814431520b206bbf5d03dc4dfb2",
      "text": "Sejarawan yang baik mendengar kedua versi, lalu membaca sumbernya.",
      "voice": "id_ardi",
      "chars": 66,
      "mime": "audio/mpeg"
    },
    {
      "key": "da234a5753ddfb41e195c37a6f3dd8bf5accc249197b6d031490e2b1a9a65375",
      "text": "periode",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "dab8fc4b06514cc01ccbc7970554453ea66c4a759c43bb2da3ae08f5668a34d0",
      "text": "Kohesi membuat sebuah teks sejarah enak dibaca.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc190485816b3ce3da00152296595a6fca8f7bd8333ca9d018ff080f7f21ff26",
      "text": "prasejarah",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "dc641ef856b5455fe90b19d338b843800bec0bef26c8d9c1578d28b283e809a6",
      "text": "Pada awal abad kesembilan belas, Belanda membangun jalan raya sepanjang seribu kilometer di Jawa. Jalan Anyer sampai Panarukan dibangun dengan kerja rodi, dan ribuan pekerja meninggal.",
      "voice": "id_gadis",
      "chars": 184,
      "mime": "audio/mpeg"
    },
    {
      "key": "dd9f8b0444823a7b1739a320df23b1864aab0230bc63480918ef12de198f519a",
      "text": "solidaritas",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "de59c6dba28ecb8eecd2f5b51f4fae8c2048d63dfc9369bbc7c6ce7251cf26b0",
      "text": "Setiap versi sejarah punya sudut pandangnya sendiri, jadi sejarawan harus membandingkan sumber dari Gowa dan Bone.",
      "voice": "id_gadis",
      "chars": 114,
      "mime": "audio/mpeg"
    },
    {
      "key": "e037293d0bc11f362e84c243bb4e1b9cd4e53c5378265e8294584d6b16911b53",
      "text": "julukan",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "e528c037f40715699d6dece39e1c070babe7820c638b5644deffb42e09f582de",
      "text": "VOC ingin memonopoli perdagangan rempah-rempah.",
      "voice": "id_gadis",
      "chars": 47,
      "mime": "audio/mpeg"
    },
    {
      "key": "e5fd75bf1cd3d2ae2c80acd0772aae0bf884c6535048fc3e7de84317b5d47f06",
      "text": "agresi militer",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "e6426f7ba30c86a766630ab2743c423a7e11b033a5cf03688abf38830d93eafc",
      "text": "Padahal sebelumnya pelabuhan kita terbuka buat niaga dengan siapa aja.",
      "voice": "id_ardi",
      "chars": 70,
      "mime": "audio/mpeg"
    },
    {
      "key": "e67249483f2fe83868578927860bd4ae202d12efb7302f609b9ab839e2e41e9f",
      "text": "Era VOC dimulai 1602. Kongsi tersebut menguasai rempah, lalu pemerintahan kolonial menggantikannya.",
      "voice": "id_ardi",
      "chars": 99,
      "mime": "audio/mpeg"
    },
    {
      "key": "e992d73ca28d0df5a9b64d0ca3a5e63f50114fca796d8aba255ebdda835ae085",
      "text": "Ayam jantan itu lambang keberanian orang Gowa, sehingga Belanda memakainya untuk menyebut Sultan Hasanuddin.",
      "voice": "id_gadis",
      "chars": 108,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9acadeea28785f45d608baf1dd89aa2a72611fc63a10b9185eda818c624af7d",
      "text": "mengakui",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "e9c34c2705b784a527f4f0725ea846994a9610834a7a133ae7553f35f657337e",
      "text": "Fosil manusia purba ditemukan di Sangiran.",
      "voice": "id_gadis",
      "chars": 42,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec61820af15844bb050b39797ffbe5ef8376e8522446f94983294cbe124c7535",
      "text": "Wah, Mesir juga ada di konferensi ini! Mereka bicara soal apa?",
      "voice": "id_ardi",
      "chars": 62,
      "mime": "audio/mpeg"
    },
    {
      "key": "ec92724edb99f119b082d33caa9e099ff23c509805aa74a5f4242c4df2b40028",
      "text": "Konferensi ini menolak kolonialisme dalam segala bentuknya, karena banyak negara peserta baru saja lepas dari penjajahan.",
      "voice": "id_gadis",
      "chars": 121,
      "mime": "audio/mpeg"
    },
    {
      "key": "ee0a99d30a445041d71448eeec038b0f26b8862da2ab766555c0ff189232e3eb",
      "text": "perundingan",
      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "ef53a293ef8a5d403c28867af6751c9ae8253033ca43f8e65d4ca4a07df11d95",
      "text": "Pada tanggal 18 Agustus 1945, Sukarno menjadi presiden, Hatta wakil presiden. Keduanya memimpin negara yang baru merdeka itu dalam masa yang sangat sulit.",
      "voice": "id_gadis",
      "chars": 154,
      "mime": "audio/mpeg"
    },
    {
      "key": "f39eab0236b947f39ffe8d20a243df5e5673cdf8ca680d38810c383f286c82d9",
      "text": "utusan",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "f3fbbbe7785414bb047d0f326ae0b6821cf8439c58e6b59487943bc621000cc9",
      "text": "Bukan. Itu pahlawan nasional dari Maluku, Martha Christina Tiahahu. Dia berperang waktu masih remaja.",
      "voice": "id_ardi",
      "chars": 101,
      "mime": "audio/mpeg"
    },
    {
      "key": "f64539ba2841fb5ce5583530a127be1f09939a9105947a40056096832c948cf9",
      "text": "keberanian",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "f76872d420ecdbec09b584d16dd0359e896ccf7772d9a56c1b79eea76a6fb1c6",
      "text": "Pada masa Demokrasi Terpimpin, presiden memegang hampir semua kekuasaan. Partai yang berbeda pendapat dibubarkan dan surat kabar ditutup. Banyak sejarawan menilai pemerintahan itu otoriter.",
      "voice": "id_gadis",
      "chars": 189,
      "mime": "audio/mpeg"
    },
    {
      "key": "f976eeb24c5e2dc489f8b3f181a0fd70b252d71a895a3207061fa6e9ce2d50b4",
      "text": "syahbandar",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "faaf19b021689988a09d4e748dcca730bc12d013270e35d1bd89edf045f954ef",
      "text": "konferensi",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "fb31e1939018b159a698700c9a3f0bd8c8d2712da6e152a32fe4a3ad3281d044",
      "text": "Minggu depan kita ke Leang-Leang di Maros. Ada lukisan prasejarah di sana.",
      "voice": "id_ardi",
      "chars": 74,
      "mime": "audio/mpeg"
    },
    {
      "key": "fc0e85eea2b9e4b68b9a617b0e85762b94dffc8048e0d56a592fb899e768d703",
      "text": "Kalau menulis sejarah, hati-hati dengan istilah, Mohamed.",
      "voice": "id_ardi",
      "chars": 57,
      "mime": "audio/mpeg"
    },
    {
      "key": "fca0c13dbd979ea55c2b306cf50fc4d69d7497af02dea74bff1d1aa22c800627",
      "text": "Dan ketika Soeharto mundur, bagaimana perasaan Bapak?",
      "voice": "id_ardi",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd0e5cead701a042a20734a1f0f856d6433f39c09bf84f70078e19acbe699fb2",
      "text": "Pala dan cengkih adalah rempah-rempah dari Maluku.",
      "voice": "id_gadis",
      "chars": 50,
      "mime": "audio/mpeg"
    },
    {
      "key": "fd30610d7a11a86513e7207d47be25a7e038c033c836e0e6dc452aac672eee1f",
      "text": "Nasionalisme Indonesia lahir dari perlawanan terhadap imperialisme.",
      "voice": "id_gadis",
      "chars": 67,
      "mime": "audio/mpeg"
    },
    {
      "key": "ffa620ebddddbfe9701857733bb7e8414043b9aa537e63ad450f1eabae52a313",
      "text": "Ahli epigrafi membaca prasasti itu huruf demi huruf.",
      "voice": "id_gadis",
      "chars": 52,
      "mime": "audio/mpeg"
    }
  ],
  "totals": {
    "lessons": 14,
    "clips": 199,
    "chars": 10766,
    "audio_bytes": 0,
    "missing": 199
  }
}
