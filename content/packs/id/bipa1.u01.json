      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "85b68418b473ade84cb7d5be88c5ccd6fe11ce042f5ad5dd296449547b654a76",
      "text": "Kurang baik, Mohamed. Dan Mohamed?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "890b7a7afd1e5176f3bfad8d758e217714e0353286f5731bb5a7d229f6ac9613",
      "text": "Maaf, apa artinya?",
      "voice": "id_gadis",
      "chars": 18,
      "mime": "audio/mpeg"
    },
    {
      "key": "8a999ff2956e3edcd62b695f1d591182f024413e5f0adb279a8c0c9f183af297",
      "text": "Maaf, Anda Pak Budi?",
      "voice": "id_gadis",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "8ae5b16292197e78a899bfa9c9b89315a9081d7c35e1d3734f67b0b8d80fc6a6",
      "text": "Selamat pagi, Bu Sari! Apa kabar?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f4cdcd4f13f6ce140416e5d2bf971e9459162870b6906bfe8f5ad3e0a699643",
      "text": "Permisi, Pak.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "904ae15f0a4e7a2e2ca60a712207832dcebf5a5b56be6e264978936818369777",
      "text": "Baik juga, Bu. Terima kasih.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "985e423f858deba0c24fc52500e6508c4927c71c640e556f82c862a4096bd879",
      "text": "Selamat pagi, Bu!",
      "voice": "id_gadis",
      "chars": 17,
      "mime": "audio/mpeg"
    },
