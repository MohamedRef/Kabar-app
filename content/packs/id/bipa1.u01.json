    },
    {
      "key": "0e3073ee3548db67d6db9ee50129938d66d0cf7b1f6fd05f26f04d9add790a9a",
      "text": "Selamat malam!",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e7de7bdeaa109add0cfad8d6fb539213ac73701e9afe2433798412d204f2acc",
      "text": "Selamat siang, Pak.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "13c987adbe63f06a5e03bc0027093d94396fec6cc0d0dd8ccaa6a467e0059e59",
      "text": "Kabar baik",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "13d0f6c5755d3ee544198de52dedac03072a589b4a22489751a24fa1e1311b33",
      "text": "Salam kenal, Mohamed. Selamat datang di Kota Tua!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "16c0dd63e0823a3ecd142af77a8b89cc721a17da317906a88528b97f9cea8999",
      "text": "saya",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "1781679f112b3daad678ca1d6e23ee613118ef5076dd55cf44694ceff69e5cda",
      "text": "Permisi, Pak. Maaf, Anda Pak Budi?",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c5bf5bd5e2a9d06cc048b7a1f596cf9bb82622dee1a37e1a901413b0317e68",
      "text": "hai",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "186e79ac087ba3190ae138da0c3b7641cecdcae5a5b08014c29df9a0f36f06c2",
      "text": "Baik juga.",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "18d0ea63c090a940523300b5d6d3e367ee0b840c58572821b70b8e03f9623a77",
      "text": "Ya, saya Mohamed. Selamat malam!",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "198491d4f41d1bb872fc5c7055075e6b3d58050a7eec18ebed6e2486d3117619",
