      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "38a8366c31140ac5e56bd6e055f73915b29d74c797042a81ae16e120e3c843d4",
      "text": "siang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e95bbab467df8c51ae9d0a2a242ae33a9a142e2b216c8b849098090007c1bb0",
      "text": "Sama-sama. Sampai jumpa besok!",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea4d05a4c8fce68b13442528ed4eb3b8e1b5feb89c5b5ed25a0dc43662951fd",
      "text": "baik-baik saja",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f733d0f88cf8c6a78b586b299ebb7fa08827d32749f0c6841e139a709c03add",
      "text": "Baik, terima kasih. Selamat datang di Jakarta!",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "410c5fe6c811e877731f8f08a3f0002c40ef3fc8a362b7e4d9653aafb58fa0d6",
      "text": "Kita di Jakarta!",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "43970ace3ffff4ac40804388cd93ead7f06e33db9d2500c04c46cd7ad8c5255f",
      "text": "Terima kasih, Pak. Sampai jumpa!",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "43ff0aa3e03b9055a777f5a5047112a7b066ed80161236abf0ebeb016752b6b9",
