      "voice": "id_gadis",
      "chars": 11,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ae00acfedb95ce6a68f0862a23877eea8797dd8698cc569fe95a3f27d7d509e",
      "text": "Apa kabar, Pak?",
