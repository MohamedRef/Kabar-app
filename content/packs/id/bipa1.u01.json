      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c3cc7db71bd34b17a91830020a6b67a41c506db8e5d11281a1929b83956141a",
      "text": "Dia Rina.",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cc4bf5dd6f5989679cc4d27738d34ab231f519afcd93e4655bfda90cd1af1cd",
      "text": "Hai, Dimas! Aku Mohamed. Salam kenal!",
      "voice": "id_ardi",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cf3aee6b8b2098629dd873f805ee703c21eda0e7fc41d77a08733ccaa6776ad",
      "text": "Selamat sore, Rina! Apa kabar?",
