      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "08cf1fe6b5507221eb76390f0adc6fe3834362769052038f6abc4e9878db33f2",
      "text": "Ya, saya Budi. Selamat siang!",
      "voice": "id_ardi",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b22fda113989404a474a085bac8e9d976fd7c3909a212e373c0e230e9c9ab06",
