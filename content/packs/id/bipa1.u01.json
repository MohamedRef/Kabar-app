  "audio": [
    {
      "key": "02face950f7a6c7cba0f3378e99abf643051ad49c7ba6be1a1c66dd136e09bba",
      "text": "Sore, Rina! Apa kabar?",
      "voice": "id_ardi",
      "chars": 22,
      "mime": "audio/mpeg"
    },
    {
      "key": "0490d871a4dce695e9869a4f9cb5ec217ec45a171fca29606d978540cac4bf2c",
      "text": "permisi",
      "voice": "id_gadis",
      "chars": 7,
      "mime": "audio/mpeg"
    },
    {
      "key": "0b22fda113989404a474a085bac8e9d976fd7c3909a212e373c0e230e9c9ab06",
      "text": "kamu",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e11b819b834eef7efbac8fc4f7057051c622ef431082cc44ec827bc827f0d42",
      "text": "Permisi, Pak. Maaf, Anda Pak Irwan?",
      "voice": "id_ardi",
      "chars": 35,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e3073ee3548db67d6db9ee50129938d66d0cf7b1f6fd05f26f04d9add790a9a",
      "text": "Selamat malam!",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "0e7de7bdeaa109add0cfad8d6fb539213ac73701e9afe2433798412d204f2acc",
      "text": "Selamat siang, Pak.",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "10583e385fb66008398cfd1c1c4f113b5c14fee5eb2788d67ebf2fd7f707343b",
      "text": "selamat datang",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "13d0f6c5755d3ee544198de52dedac03072a589b4a22489751a24fa1e1311b33",
      "text": "Salam kenal, Mohamed. Selamat datang di Kota Tua!",
      "voice": "id_ardi",
      "chars": 49,
      "mime": "audio/mpeg"
    },
    {
      "key": "16c0dd63e0823a3ecd142af77a8b89cc721a17da317906a88528b97f9cea8999",
      "text": "saya",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "17c5bf5bd5e2a9d06cc048b7a1f596cf9bb82622dee1a37e1a901413b0317e68",
      "text": "hai",
      "voice": "id_gadis",
      "chars": 3,
      "mime": "audio/mpeg"
    },
    {
      "key": "186e79ac087ba3190ae138da0c3b7641cecdcae5a5b08014c29df9a0f36f06c2",
      "text": "Baik juga.",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "18d0ea63c090a940523300b5d6d3e367ee0b840c58572821b70b8e03f9623a77",
      "text": "Ya, saya Mohamed. Selamat malam!",
      "voice": "id_ardi",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "198491d4f41d1bb872fc5c7055075e6b3d58050a7eec18ebed6e2486d3117619",
      "text": "kabar",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "1bf794d0624abb65d7ff55cf844a40091736a7d14884f38fa8a5caf02efe876f",
      "text": "Hai, aku Raka! Kamu Mohamed?",
      "voice": "id_gadis",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "1d31fc638c37d0d2d41d39fdccec7bebeb91398ff73670dc72a9567d3324cb13",
      "text": "Hai, Mohamed! Aku Raka.",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "25d42f49ef33ff089c4e7581820f878e0b196d0ec7447f0402032e7e029f4838",
      "text": "Asalamualaikum! Hai, Rina! Hai, Mohamed!",
      "voice": "id_ardi",
      "chars": 40,
      "mime": "audio/mpeg"
    },
    {
      "key": "273396db7b765a09894bac7ac11b1192576510b1afc9ba43f3f5cb3f3b1f0fb4",
      "text": "apakah",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "278761c5e535afae941ec872494c28e90ce299d2724e638e841bda2a567a607d",
      "text": "Baik-baik saja, Bu. Terima kasih.",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "27fda9b2179235a9839e4d8c2e74755dfbcd74484dd76f61b3199a09dd297ca4",
      "text": "Selamat siang, Pak. Saya Mohamed. Salam kenal.",
      "voice": "id_ardi",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "2832e055dfc5d1670e2defe8710d7ea9f12faeff1adfac18c7849fab91c802ab",
      "text": "di",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "288c52cc8c761019a1f7345e1b439495bad21c62a1bd75c1f62334b47fab25c5",
      "text": "Selamat pagi, Pak. Saya Mohamed.",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "29603e33c2f10b696cf41cf154dad44fdba11a9219271e931ca51f7bba8e6652",
      "text": "Ya, sehat. Terima kasih.",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "2bb1ee6b8ed5de32b7dfaef972425e3f5b85d3f6517d22a6789b0c17c38c7793",
      "text": "Hai! Aku Raka. Kamu?",
      "voice": "id_ardi",
      "chars": 20,
      "mime": "audio/mpeg"
    },
    {
      "key": "2d2fa9110ccc7e7b1b5107cf3b153df3dbbc225eb2e6a61b92d44e6a6dcdd729",
      "text": "Aku Ni Luh. Salam kenal!",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "31340f20f46e9dd1c7dbf80db15d27b1ebb05f6a6647dfa7830014e42e19eeeb",
      "text": "Waalaikumsalam! Selamat datang, Raka. Apa kabar?",
      "voice": "id_gadis",
      "chars": 48,
      "mime": "audio/mpeg"
    },
    {
      "key": "34d0d129db144858ea50f7a51a19bd86db711d4db78a8713c8eb65a819062628",
      "text": "pagi",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "3713e4d50ac37a1206c727432f3a6cae7ae24c2653df81617522d09024ae1a68",
      "text": "Baik-baik saja",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3774f656ffa7ec7bc8293869b04c5921eb88ede7f1fd26e4ca6b589ed70e62eb",
      "text": "maaf",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "38a8366c31140ac5e56bd6e055f73915b29d74c797042a81ae16e120e3c843d4",
      "text": "siang",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "3e95bbab467df8c51ae9d0a2a242ae33a9a142e2b216c8b849098090007c1bb0",
      "text": "Sama-sama. Sampai jumpa besok!",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "3ea4d05a4c8fce68b13442528ed4eb3b8e1b5feb89c5b5ed25a0dc43662951fd",
      "text": "baik-baik saja",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "3f733d0f88cf8c6a78b586b299ebb7fa08827d32749f0c6841e139a709c03add",
      "text": "Baik, terima kasih. Selamat datang di Jakarta!",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "410c5fe6c811e877731f8f08a3f0002c40ef3fc8a362b7e4d9653aafb58fa0d6",
      "text": "Kita di Jakarta!",
      "voice": "id_gadis",
      "chars": 16,
      "mime": "audio/mpeg"
    },
    {
      "key": "43970ace3ffff4ac40804388cd93ead7f06e33db9d2500c04c46cd7ad8c5255f",
      "text": "Terima kasih, Pak. Sampai jumpa!",
      "voice": "id_gadis",
      "chars": 32,
      "mime": "audio/mpeg"
    },
    {
      "key": "43ff0aa3e03b9055a777f5a5047112a7b066ed80161236abf0ebeb016752b6b9",
      "text": "baik",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "45b1a251cbe4ea8679389c4cc0028251a6a4d718ce6992c94c04d412d1f9190f",
      "text": "Ya, baik-baik saja, terima kasih.",
      "voice": "id_gadis",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "4be74d7d286bff70fbe82ff65ffceadbb07a9515daefbb870973db9bdcaf250d",
      "text": "Selamat sore",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "4c3cc7db71bd34b17a91830020a6b67a41c506db8e5d11281a1929b83956141a",
      "text": "Dia Rina.",
      "voice": "id_gadis",
      "chars": 9,
      "mime": "audio/mpeg"
    },
    {
      "key": "4cf3aee6b8b2098629dd873f805ee703c21eda0e7fc41d77a08733ccaa6776ad",
      "text": "Selamat sore, Rina! Apa kabar?",
      "voice": "id_gadis",
      "chars": 30,
      "mime": "audio/mpeg"
    },
    {
      "key": "4daa26d52cd9943549b798dc88391193ddcb6f8cd09010f7b9d4458742f6bca7",
      "text": "Pak / Bu",
      "voice": "id_gadis",
      "chars": 8,
      "mime": "audio/mpeg"
    },
    {
      "key": "53d5d1f62e940b78d528a59954b098c15f5d340500f28d1f827e5cffbd4ec3b6",
      "text": "Selamat pagi. Anda Mohamed?",
      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "541a112f1a78588688439eb11a5bea6865bda8d77f47c3e60a89240e880b21a7",
      "text": "Kami di Kota Tua, Bu.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "54725a01dc3ba36bb4e3279399adb3d676e27b0c9dd6c393329a8d134298abe8",
      "text": "kalian",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "55d0d8b2961ad792f46b8fdd3580cc792402a6365bac08c551c1d8bcb3f28ec9",
      "text": "Salam kenal, Ni Luh. Apa kabar?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "57791fecd77c8285db3e52e309248b365be453765c03b861de9cbeac58b2db5e",
      "text": "kita",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "5aaabc9b11c961bab09a13fb0bf9be069e526609401d59094fd6602c49dafe12",
      "text": "Selamat pagi, Bu Yanti! Apakah Ibu sehat?",
      "voice": "id_ardi",
      "chars": 41,
      "mime": "audio/mpeg"
    },
    {
      "key": "5ae00acfedb95ce6a68f0862a23877eea8797dd8698cc569fe95a3f27d7d509e",
      "text": "Apa kabar, Pak?",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eb395dad9a68214d9c0785d6d0d1b4d7440def2d69b82d863efd7a6781066de",
      "text": "Selamat malam, Pak. Saya Mohamed. Salam kenal.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6029e39e7a1ae78e0f18ee1b3ceaffb8b6d0cb096fe85c3829701ee7118385bd",
      "text": "Baik, terima kasih. Dan kamu?",
      "voice": "id_gadis",
      "chars": 29,
      "mime": "audio/mpeg"
    },
    {
      "key": "6287317e68880c593819b9b9d62e0226aed10e4643c872f0112ef5c3395b79dc",
      "text": "ya",
      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "6862f890f7416591698362c8f7f87b09c50c3648288281f29335623ae162f2b2",
      "text": "Baik juga. Dan Bu Yanti?",
      "voice": "id_gadis",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "686a45bac97384c00a9cf4e2e697bcedbedbc4e5d69dd15b56b5b82910114b9f",
      "text": "Apa kabar, Bu?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e3b9d4ad8813b7d6225ac34ac0fd67d0eff71455237a148ad9371561afe28d6",
      "text": "Selamat pagi!",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d4d7e134b0b5a5970b0d360a5c4a4759e71ebba58892a468b2b91daf4eeb82",
      "text": "Asalamualaikum, Bu! — Waalaikumsalam!",
      "voice": "id_gadis",
      "chars": 37,
      "mime": "audio/mpeg"
    },
    {
      "key": "727bd3e3f778f8d2b2bf5b859cbbc9f0760be8a37550a31e0a99c8be6ae3369c",
      "text": "Hai! Kami di Jakarta. Kalian juga?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "72c37e9b156c8394f3aadd10f52c7f4097ff9d81914b620b7dee0aa98d0f1565",
      "text": "Pagi, Mohamed! Kabar baik, terima kasih. Dan Mohamed?",
      "voice": "id_gadis",
      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "753e95eb92f0699f7071cf155a5cb796cd2c7ccee43ab6c2452bf8a5e398ecbf",
      "text": "Hai, Raka! Salam kenal.",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b3900330f0d67cc580efa327e68073e40ecfc7bd0905be5a06c2665487d0ef1",
      "text": "Apakah Bapak sehat?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "80b7ba336493f738817e7ff6762223aee800177979282ff584329f1699a9ebec",
      "text": "sehat",
      "voice": "id_gadis",
      "chars": 5,
      "mime": "audio/mpeg"
    },
    {
      "key": "8228c8f05fd30adfb4ff9b69f72fe4d56e9b1406fe63567df540015bae2d0e29",
      "text": "Baik juga, terima kasih.",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "8229bafdfc89a8e8c14a36232fdd29bf6628ddb7fa228cef1a13d8ddbf83f687",
      "text": "Kamu Raka?",
      "voice": "id_gadis",
      "chars": 10,
      "mime": "audio/mpeg"
    },
    {
      "key": "8284e1f91d91a139d98a35fe6218c740f9a71c85c3c513f355580f8207c4ad46",
      "text": "Selamat pagi, Pak. Anda Pak Irwan? Saya Mohamed, salam kenal.",
      "voice": "id_gadis",
      "chars": 61,
      "mime": "audio/mpeg"
    },
    {
      "key": "82d313e5b25267d5b180a6d9c844ed377603d0b825613d33129e1bbea308c7ec",
      "text": "juga",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "836f47549d311517a8c87ba3736e6b7e8a9ef12c02661b6038bd96db52e5ca8e",
      "text": "waalaikumsalam",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "85b68418b473ade84cb7d5be88c5ccd6fe11ce042f5ad5dd296449547b654a76",
      "text": "Kurang baik, Mohamed. Dan Mohamed?",
      "voice": "id_gadis",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "88191709b5ba92564dca60ae874de1d0a978b0f4e905296736b59234b88f46e4",
      "text": "Maaf, Anda Pak Irwan?",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "8f4cdcd4f13f6ce140416e5d2bf971e9459162870b6906bfe8f5ad3e0a699643",
      "text": "Permisi, Pak.",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "8fc155853b958b82174849de4d42c762c04aba571a595e7bb6b0ca6706dfbde0",
      "text": "mereka",
      "voice": "id_gadis",
      "chars": 6,
      "mime": "audio/mpeg"
    },
    {
      "key": "904ae15f0a4e7a2e2ca60a712207832dcebf5a5b56be6e264978936818369777",
      "text": "Baik juga, Bu. Terima kasih.",
      "voice": "id_ardi",
      "chars": 28,
      "mime": "audio/mpeg"
    },
    {
      "key": "94610ae40c6fda795bace6e36d2aa365f92554fb59d204b5ad0589cf23225e80",
      "text": "selamat tinggal",
      "voice": "id_gadis",
      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "98927f7e33fe1f978da5b682eeac5f9c0d2734ab3ef5dda10eb24d9cc93e357b",
      "text": "sore",
      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "99def3f3e033cab8dfc50cf860af46a75bb9b39373870c3d70127756291a6fd6",
      "text": "Ya, Bu. Saya Mohamed. Salam kenal.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7b861c1f1a432391e63f0eae56fb974d697d84d79328591c65b83e2c3c4282",
