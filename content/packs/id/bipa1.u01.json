      "voice": "id_gadis",
      "chars": 4,
      "mime": "audio/mpeg"
    },
    {
      "key": "99def3f3e033cab8dfc50cf860af46a75bb9b39373870c3d70127756291a6fd6",
      "text": "Ya, Bu. Saya Mohamed. Salam kenal.",
      "voice": "id_ardi",
      "chars": 34,
      "mime": "audio/mpeg"
    },
    {
      "key": "9a7b861c1f1a432391e63f0eae56fb974d697d84d79328591c65b83e2c3c4282",
      "text": "Apa artinya?",
      "voice": "id_gadis",
      "chars": 12,
      "mime": "audio/mpeg"
    },
    {
      "key": "9d033f7c70a6bcbcc5b508339de0fd719a3a488329b6c84317b1d0378b45e11a",
      "text": "Sampai jumpa besok!",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
