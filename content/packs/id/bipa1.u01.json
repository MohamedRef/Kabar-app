      "chars": 53,
      "mime": "audio/mpeg"
    },
    {
      "key": "7b3900330f0d67cc580efa327e68073e40ecfc7bd0905be5a06c2665487d0ef1",
      "text": "Apakah Bapak sehat?",
      "voice": "id_gadis",
      "chars": 19,
      "mime": "audio/mpeg"
    },
    {
      "key": "7dcfe17365bdcb29bee9451d57d2ca5ab48ad5fe4f2f0a90675a87d4a211d815",
