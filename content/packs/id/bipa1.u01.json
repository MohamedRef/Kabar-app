      "text": "Pagi, Rina! Selamat datang di Kota Tua.",
      "voice": "id_ardi",
      "chars": 39,
      "mime": "audio/mpeg"
    },
    {
      "key": "a35e6cff1759b01e1cce534d50733218a7d1609dad85ca9270e6cbccb90f910b",
      "text": "Sampai jumpa besok, Bu!",
      "voice": "id_ardi",
      "chars": 23,
      "mime": "audio/mpeg"
    },
