      "chars": 15,
      "mime": "audio/mpeg"
    },
    {
      "key": "5eb395dad9a68214d9c0785d6d0d1b4d7440def2d69b82d863efd7a6781066de",
      "text": "Selamat malam, Pak. Saya Mohamed. Salam kenal.",
      "voice": "id_gadis",
      "chars": 46,
      "mime": "audio/mpeg"
    },
    {
      "key": "6029e39e7a1ae78e0f18ee1b3ceaffb8b6d0cb096fe85c3829701ee7118385bd",
