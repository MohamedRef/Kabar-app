      "voice": "id_gadis",
      "chars": 27,
      "mime": "audio/mpeg"
    },
    {
      "key": "541a112f1a78588688439eb11a5bea6865bda8d77f47c3e60a89240e880b21a7",
      "text": "Kami di Kota Tua, Bu.",
      "voice": "id_gadis",
      "chars": 21,
      "mime": "audio/mpeg"
    },
    {
      "key": "55d0d8b2961ad792f46b8fdd3580cc792402a6365bac08c551c1d8bcb3f28ec9",
      "text": "Salam kenal, Ni Luh. Apa kabar?",
      "voice": "id_ardi",
      "chars": 31,
      "mime": "audio/mpeg"
    },
    {
      "key": "576c1ca3beb2f1cce1fcd6e802e83eb34005b5ef96815e2da2ad00d25a4430e8",
      "text": "Hai, Mohamed! Aku Dimas.",
      "voice": "id_ardi",
      "chars": 24,
      "mime": "audio/mpeg"
    },
    {
      "key": "57791fecd77c8285db3e52e309248b365be453765c03b861de9cbeac58b2db5e",
