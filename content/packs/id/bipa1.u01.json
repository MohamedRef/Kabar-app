      "voice": "id_gadis",
      "chars": 2,
      "mime": "audio/mpeg"
    },
    {
      "key": "686a45bac97384c00a9cf4e2e697bcedbedbc4e5d69dd15b56b5b82910114b9f",
      "text": "Apa kabar, Bu?",
      "voice": "id_gadis",
      "chars": 14,
      "mime": "audio/mpeg"
    },
    {
      "key": "6e3b9d4ad8813b7d6225ac34ac0fd67d0eff71455237a148ad9371561afe28d6",
      "text": "Selamat pagi!",
      "voice": "id_gadis",
      "chars": 13,
      "mime": "audio/mpeg"
    },
    {
      "key": "70ca3376c8a030737afa8514e50e0179b86c6e6d8180aaa91d162fef64cb58ae",
      "text": "Waalaikumsalam! Apa kabar, Dimas?",
      "voice": "id_ardi",
      "chars": 33,
      "mime": "audio/mpeg"
    },
    {
      "key": "70d4d7e134b0b5a5970b0d360a5c4a4759e71ebba58892a468b2b91daf4eeb82",
      "text": "Asalamualaikum, Bu! — Waalaikumsalam!",
