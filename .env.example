# Copy to `.env` (git-ignored) and fill in. `just` reads it, and the app reads
# these at build time (`just run-mac`, `just apk`). Nothing here is committed.

# Your deployed Worker (docs/CLOUD.md §3.4)
KABAR_CLOUD_URL=https://kabar-cloud.YOUR-SUBDOMAIN.workers.dev
# Google Cloud → Clients → "Kabar Mac" (Desktop app). Also used on Android until
# the Credential Manager bridge lands.
KABAR_GOOGLE_CLIENT_ID=1234-desktop.apps.googleusercontent.com
# The same Desktop client's secret. Google treats installed-app secrets as
# non-confidential, but it still stays out of the repo.
KABAR_GOOGLE_CLIENT_SECRET=GOCSPX-...

# Offline packs (docs/RUN.md §11). Only `just packs-audio` reads the Azure key,
# on the Mac; the app never reads it. Same Azure Speech resource (F0) as Kabar Cloud.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Where clips are cached between runs (default ~/.kabar/audio). Keep it: it's quota you spent.
# KABAR_AUDIO_CACHE=/Users/you/.kabar/audio
# Where the app downloads packs (default: this repo's `packs` release). Set it empty to turn downloads off.
# KABAR_PACKS_URL=https://github.com/MohamedRef/Kabar-app/releases/download/packs

# AI bake-off (docs/BAKEOFF.md "Running it"). Only `just bakeoff*` reads these, on the Mac.
# Cloudflare → AI → Workers AI → "Use REST API": account id + a token with Workers AI read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Google AI Studio free key (free tier trains on inputs: personal tasks are never sent).
GEMINI_API_KEY=
# Ollama on the Mac (default http://localhost:11434).
# OLLAMA_URL=http://localhost:11434
