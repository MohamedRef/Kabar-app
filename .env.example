# Copy to `.env` (git-ignored) and fill in. `just` reads it, and the app reads
# these at build time (`just run-mac`, `just apk`). Nothing here is committed.

# Your deployed Worker (docs/CLOUD.md §3.4)
KABAR_CLOUD_URL=https://kabar-cloud.YOUR-SUBDOMAIN.workers.dev
# Google Cloud → Clients → "Kabar Mac" (Desktop app). Also used on Android until
# the Credential Manager bridge lands.
KABAR_GOOGLE_CLIENT_ID=1234-desktop.apps.googleusercontent.com
# The same Desktop client's secret. Google treats installed-app secrets as
# non-confidential, but it still stays out of the repo.
KABAR_GOOGLE_CLIENT_SECRET=GOCSPX-...
