<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the manifest that dx generates for the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background playback of downloaded episodes (PlaybackService). Media-session
         notifications don't need POST_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application>
        <service
            android:name="app.kabar.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Share-to-Kabar: text and images from any app, plus "Kabar" in the
             text-selection menu. Invisible; it hands the item over and opens Kabar. -->
        <activity
            android:name="app.kabar.ShareActivity"
            android:exported="true"
            android:label="Kabar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The Reader's "Open a screenshot": shows the system photo picker and
             hands the image over like a share. Not exported, and no noHistory:
             it must stay alive under the picker to get the result. -->
        <activity
            android:name="app.kabar.ImagePickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
