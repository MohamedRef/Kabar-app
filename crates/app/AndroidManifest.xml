<?xml version="1.0" encoding="utf-8"?>
<!--
  Kabar's Android manifest, used by dx instead of its built-in template
  (Dioxus.toml: [application] android_manifest). It is that template from
  dx 0.7.10, rendered for Kabar, with two changes:

  - The launcher icon is Kabar's (`ic_kabar_launcher`, shipped by the android/
    module and exported by scripts/assets/export_icons.py). dx always writes
    its own `ic_launcher` into the app module, and app resources beat library
    ones, so the icon needs its own name.
  - The text-to-speech <queries> block that used to live in [android.raw].
  - MainActivity handles every configuration change itself. Recreating it
    would drop the WebView that holds the running app: dark mode (Samsung's
    sunset switch), split screen and pop-up view on the Tab S11, display
    size, font size, language and keyboards all reach the page as CSS
    media queries and resize events instead.
  - adjustResize: the on-screen keyboard shrinks the window instead of
    covering it, so the Lesson Player's Check button and chat compose stay
    above the keyboard.

  dx no longer adds permissions, features or deep links from Dioxus.toml to
  this file: add them here. Re-check it against dx's template when dx is
  upgraded.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: Kak Nur's reminders are notifications. Declared so
         Settings › Android can send the learner to Kabar's notification page,
         where the switch then works. (PlaybackService's media notification
         is exempt and works either way.) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms the local reminder schedule after a reboot (Reminders.kt). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Settings › About › Updates: Kabar installs its own signed updates
         (app.kabar.UpdateInstaller). Android still asks the learner to allow
         "Install unknown apps" for Kabar once, and checks the signing key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: once Kabar installed itself, later updates need no
         confirmation (only honoured with this normal permission). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- A light tap of vibration on answers and at a lesson's end
         (app.kabar.Haptics; Settings › Learning can turn it off). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Automatic update downloads wait for Wi-Fi (isActiveNetworkMetered). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ package visibility: the app must be allowed to see installed
         text-to-speech engines (Samsung, Google) or TextToSpeech can't bind to one. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application android:hasCode="true"
        android:icon="@mipmap/ic_kabar_launcher"
        android:roundIcon="@mipmap/ic_kabar_launcher_round"
        android:extractNativeLibs="false"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection|colorMode"
            android:windowSoftInputMode="adjustResize" android:exported="true"
            android:label="@string/app_name" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
